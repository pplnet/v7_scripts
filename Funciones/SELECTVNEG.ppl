   SQL.ADD("         O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("         O.TipoOp IN ('TIPA','TIPP', 'TIBCRA') ")
   SQL.ADD("       )) ")
   SQL.ADD(" UNION  ALL")
   SQL.ADD("SELECT O.TipoOp, O.ContraEspecie ContraEspecie, O.Cantidad, O.CanPosOSoc as Cant1, ((O.TotalNetoCli1+O.TotalAux3+O.TotalIVA)*O.CanPosOSoc)/O.Cantidad as  TotalNetoCli1, ")
   SQL.ADD("       (O.TotalBrutoCli1*O.CanPosOSoc)/O.Cantidad as TotalBrutoCli1, (O.TotalDerechos*O.CanPosOSoc)/O.Cantidad as TotalDerechos, O.FechaVto  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("       B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("       O.Especie = '"~FBN['Codigo']~"' AND ")
   SQL.ADD("       O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("       (O.Cartera = 3 or (O.Cartera=-1 AND O.CanPosOSoc>0)) AND ") 
   SQL.ADD("       O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("       O.TipoOp IN ('CTC','VTC','CTP','VTP') AND ")
   SQL.ADD("       (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD("SELECT T.TipoTr2 TipoOp, '"~Val(cz5)~"' ContraEspecie, 0 Cantidad, T.Cantidad1  Cant1, T.Cambio1 TotalNetoCli1, 0 TotalBrutoCli1, ")
SQL.ADD("       0 TotalDerechos, '' FechaVto ")
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
SQL.ADD("       B.Valor=0 and B.NrBit In ('30') and ")
SQL.ADD("       T.Especie = '"~FBN['Codigo']~"' AND ")
SQL.ADD("       T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
IF Dialogo.Radio1<>0
   SQL.ADD("    T.RB4 = '"~Fstr(Dialogo.Radio1-1,0,0)~"' AND ") 
ELSE
   SQL.ADD("    T.RB4 >= 0 AND ") 
ENDIF
SQL.ADD("       T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("       T.TipoTr2 IN ('DTP','RTP') ")
