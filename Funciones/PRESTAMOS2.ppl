*-- Prestamos Sindicados
SQL.ADD("SELECT O.Especie, O.NrOperacion, Cantidad ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPSC') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   SQL.ADD("   and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD("UNION ALL")

SQL.ADD("SELECT O.Especie, O.NrOperacion, C.Cantidad1 as Cantidad ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMSCMV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   SQL.ADD("   and  C.Fecha2  <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   SQL.ADD("   and  C.Fecha2  > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
*-- Para que me traiga los intereses devengados a esa fecha 
*-- por mas que la operacion sea de largo plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, O.NrOperacion, 0 Cantidad ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ") 
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPSC') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

   SQL.ADD("UNION ALL")

   SQL.ADD("SELECT O.Especie, O.NrOperacion, 0 Cantidad  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMSCMV') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
Endif

SQL.ADD("ORDER BY 2, 1 ")

ACT(no1,'')
ACT(es1,'')
ACN(fo2,0)

Recorrer SQL

   If Not EqStr(val(no1),FBN['NrOperacion'])
      ACT(no1, FBN['NrOperacion']) 
      ACT(li1, FBN['NrOperacion']~'|' )
      SQL.ADD(" SELECT NrOperacion ")
      SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
      SQL.ADD(" WHERE O.OperacionRef = '"~Val(no1)~"' ")
      SQL.ADD("  and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("  and O.TipoOp in ('MMPSI','MMSIMV') ")
          
      Recorrer SQL
         ACT(li1, Val(li1)~FBN['NrOperacion']~'|' )
      Proximo
        
      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))

      If Dialogo.Radio2<>1
         LinkearHoja('POONSI', 1, Fecha1=Dialogo.Fecha1, Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1='',Lista1=Dialogo.Lista1 ,Lista2='', Lista3=Val(li1), Radio3=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)
          
         IF Not EqStr(val(es1),FBN['Especie'])
            *-- fo2: Imp.Endeudamiento en moneda Original + WHT en moneda original + interes en moneda original
            ACN(fo2,LinkH(1,fu1)+LinkH(1,fu2)+LinkH(1,fu3))
         else
            SCN(fo2,LinkH(1,fu1)+LinkH(1,fu2)+LinkH(1,fu3))
         endif

        ACN(on1, 0) 
        ACN(on2, 0)
        ACN(on3, 0)
           
        ACN(fo3, 0) 
        ACN(fo4, 0)
        ACN(fo5, 0) 
        ACN(fo6, 0)
        ACN(fo7, 0)
           
        If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
           *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
           *- Tasa y plazo promedio solo para corto+largo
*           SCN(fo5,LinkH(1,fo5)) 
*           SCN(fo6,LinkH(1,fo6))
*           SCN(fo7,LinkH(1,fo7))

           *- fo3: capital*tasa           fo4: capital * plazo
           SCN(fo3,LinkH(1,on2)) 
           SCN(fo4,LinkH(1,on3))


           SCN(on1,LinkH(1,on1)) 
           SCN(on2,LinkH(1,on2))
           SCN(on3,LinkH(1,on3))
        EndIf
               
         CerrarLink(1)
*         CerrarHoja('POONSI', 1, Fecha1=Dialogo.Fecha1, Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1='',Lista1=Dialogo.Lista1 ,Lista2='', Lista3=Val(li1) )
      Endif
      ACT(no1, FBN['NrOperacion'])
   Endif
 
   *- Impresion de totales por especie
   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
      (.'TOTALRESU6'.)
      ACN(fo1,0)
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['Especie'])
      ACT(es1,FBN['Especie'])
  
      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf
      If Dialogo.Radio2<>1
         *- fo2: Interes fo5:Tasa Promedio fo6:Plazo Promedio 
         ACN(fo2,Val(fo2)*Val(pr1))

         If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
            *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
            *- Tasa y plazo promedio solo para corto+largo
            ACT(fn5, 'FO5')
  
*            ACN(fo5,Val(fo5)*Val(pr1)) 
*            ACN(fo6,Val(fo6)*Val(pr1))
*            ACN(fo7,Val(fo7)*Val(pr1))

            ACN(fo3,Val(fo3)*Val(pr1)) 
            ACN(fo4,Val(fo4)*Val(pr1))
   
            ACN(on1,Val(on1)*Val(pr1)) 
            ACN(on2,Val(on2)*Val(pr1))
            ACN(on3,Val(on3)*Val(pr1))
         Endif
      Endif
   EndIf

   SCN(fo1,FBN['Cantidad']*Val(pr1))
Proximo

If NoVacio(val(es1))
   (.'TOTALRESU6'.)
   ACN(fo1,0)

   (.'TOTALRESU7'.)
EndIf

FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))

