*-- Prestamos Terceros OFF SHORE
SQL.ADD("SELECT O.Especie, Sum(C.Cantidad1) as Cantidad ")
SQL.ADD("       FROM "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPOSM') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   SQL.ADD("   and C.Fecha2 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   SQL.ADD("   and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Group By O.Especie ")

SQL.ADD(" Union All ")

SQL.ADD("SELECT O.Especie,Sum(O.Cantidad) as Cantidad ")
SQL.ADD("       FROM "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCOS') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   SQL.ADD("   and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Group By O.Especie ")

*-- Para que me traiga los intereses devengados a esa fecha 
*-- por mas que la operacion sea de largo plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, 0 as Cantidad ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPOSM') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD(" Group By O.Especie ")

   SQL.ADD(" Union All ")

   SQL.ADD("SELECT O.Especie, 0 as Cantidad ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPCOS') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD(" Group By O.Especie ")
Endif
SQL.ADD(" ORDER BY 1 ")

*- Posiciones de los prestamos offshore
ACN(fa1, Val(fi6)+1)
ACN(fa2, Val(fi8))
ACN(fo1,0)
ACN(fo3,0)
ACN(fo2,0)
ACN(fo4,0)
ACN(fo5,0)
ACN(fo6,0)
ACN(fo7,0)
ACT(es1,'')

Recorrer SQL
   *- Impresion de totales por especie
   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
      (.'TOTALRESU6'.)
      ACN(fo1,0)
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['Especie'])
      ACT(es1,FBN['Especie'])

      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      IF Dialogo.Radio2 <> 1
          LinkearHoja('PRESTF', 1, Fecha1=Dialogo.Fecha1,Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=Dialogo.Radio1,NrOperacion1='',Lista1= Dialogo.Lista1,Lista2='MMPCOS|MMPOSM|', Radio3=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)

          *- fo2: Interes fo3: WH devengado fo4: comisiones devengadas fo5:Tasa Promedio fo6:Plazo Promedio 
          ACN(fo2,LinkH(1,fo2)+LinkH(1,fo3)+LinkH(1,fo4))
*          ACN(fo5,0)
*          ACN(fo6,0)
*          ACN(fo7,0)
          ACN(fo3,0)
          ACN(fo4,0)
      ENDIF

      If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
         *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
         *- Tasa y plazo promedio solo para corto+largo
*         ACN(fo5,LinkH(1,fo1)*LinkH(1,fo5)*LinkH(1,fo6)) 
*         ACN(fo6,LinkH(1,fo1)*LinkH(1,fo5))
*         ACN(fo7,LinkH(1,fo1)*LinkH(1,fo6))
         ACN(fo4,LinkH(1,fo1)*LinkH(1,fo6))
         ACN(fo3,LinkH(1,fo1)*LinkH(1,fo5))
      EndIf

*      CerrarLink(1)
*      CerrarHoja('PRESTF', 1, Fecha1=Dialogo.Fecha1,Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=Dialogo.Radio1,NrOperacion1='',Lista1= Dialogo.Lista1,Lista2='MMPCOS|MMPOSM|', Radio3=Dialogo.Radio3, Vehiculo1=Dialogo.Vehiculo1)
   EndIf

   SCN(fo1,FBN['Cantidad']*Val(pr1))
Proximo

If NoVacio(val(es1))
   (.'TOTALRESU6'.)
   ACN(fo1,0)

   (.'TOTALRESU7'.)
EndIf

FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
