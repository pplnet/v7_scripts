ACT(TO:1, 'MMPCLM|MMPCL|MMPLME|')


*- Posicion de Prestamos Terceros locales
ACN(fa1, Val(fi6))
ACN(fa2, Val(fi8))

ACN(fo1, 0)
ACN(fo2, 0)
ACN(fo3, 0)
ACN(fo4, 0)
ACN(fo5, 0)
ACN(fo6, 0)
ACN(fo7, 0)

*-- Prestamos Terceros Locales
SQL.ADD(" SELECT O.Especie, Sum(C.Cantidad1) as Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCLM') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   SQL.ADD("   and C.Fecha2  <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   SQL.ADD("   and C.Fecha2  > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Group By O.Especie ")

SQL.ADD("UNION ALL")

SQL.ADD(" SELECT O.Especie, Sum(O.Cantidad) as Cantidad ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCL','MMPLME') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2 = 0
   SQL.ADD("   and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
If Dialogo.Radio2 = 1
   SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Group By O.Especie ")

*-- Para que me traiga los intereses devengados a esa fecha 
*-- por mas que la operacion sea de largo plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, Sum(0) as Cantidad ")
   SQL.ADD(" FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPCLM') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD(" Group By O.Especie ")
   
   SQL.ADD("UNION ALL")

   SQL.ADD(" SELECT O.Especie, Sum(0) as Cantidad ")
   SQL.ADD(" FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMPCL','MMPLME') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD(" Group By O.Especie ")
Endif
SQL.ADD(" ORDER BY 1 ")

ACN(BZ:1, 0)

Recorrer SQL
   *- Impresion de totales por especie
   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
*      ACN(fo5,0)
*      ACN(fo6,0)
*      ACN(fo7,0)
      ACN(fo3,0)
      ACN(fo4,0)

      If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
         *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
         *- Tasa y plazo promedio solo para corto+largo
*         ACN(fo5,Val(fo1)*Val(fo3)*Val(fo4)) 
*         ACN(fo6,Val(fo1)*Val(fo4))
*         ACN(fo7,Val(fo1)*Val(fo3))
         *- PARA LINKEAR EN RESUMEN: fo3: Capital*Tasa fo4: Capital*Plazo 
         ACN(fo3,Val(fo1)*Val(fa3))
         ACN(fo4,Val(fo1)*Val(fa4))
      EndIf
      (.'TOTALRESU6'.)
      ACN(fo1,0)
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['Especie'])
      ACT(es1,FBN['Especie'])
      
      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)
       
      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      ACN(fo2, 0)

      If Dialogo.Radio2<>1      
         LinkearHoja('TOMFO1', 1, Fecha1=Dialogo.Fecha1, Especie1=FBN['Especie'], Radio2=val(ra2), Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Lista1=Dialogo.Lista1, Lista2=VAL(TO1))
             
         *- fo2: Interes fo3: Dias Transcurridos fo4: Tasa Promedio
         ACN(fo2,LinkH(1,fo2))         
         ACN(fa4,LinkH(1,fo3))
         ACN(fa3,LinkH(1,fo4))
         CerrarLink(1)
*         CerrarHoja('TOMFO1', 1, Fecha1=Dialogo.Fecha1, Especie1=FBN['Especie'], Radio2=val(ra2), Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Lista1=Dialogo.Lista1, Lista2=VAL(TO1))
      Endif
   EndIf
   SCN(fo1,FBN['Cantidad']*Val(pr1))
Proximo
If NoVacio(val(es1))
*   ACN(fo5,0)
*   ACN(fo6,0)
*   ACN(fo7,0)
   ACN(fo3,0)
   ACN(fo4,0)

   If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
      *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
      *- Tasa y plazo promedio solo para corto+largo
*      ACN(fo5,Val(fo1)*Val(fo3)*Val(fo4)) 
*      ACN(fo6,Val(fo1)*Val(fo4))
*      ACN(fo7,Val(fo1)*Val(fo3))
      ACN(fo3,Val(fo1)*Val(fa3))
      ACN(fo4,Val(fo1)*Val(fa4))
   EndIf
   (.'TOTALRESU6'.)
   ACN(fo1,0)

   (.'TOTALRESU7'.)
EndIf

FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))

