****Busco si para esa especie y book ya se controló la cotizacion de esa fecha
****se que estoy en la misma especie y book por el corte de control
***cuando cambio blanqueo las fechas controladas y arranco desde 0.
If Not ESHABIL(Fecha(&fechaControlar))
    let &fechaControlar HABILES(Fecha(&fechaControlar),-1)
EndIf
**Inicializo la variable
let &yaSeControlo 0

If &cantidadPorCorteControl=0
    let &cantidadPorCorteControl 1
    let &yaSeControlo 0
    ACD(ZZ:&cantidadPorCorteControl,Fecha(&fechaControlar))
Else
    Recorrer&i 1, &cantidadPorCorteControl
        If Val(ZZ:&i)=Fecha(&fechaControlar)
            let &yaSeControlo 1
        EndIf
    Proximo
    If &yaSeControlo=0
        let &cantidadPorCorteControl &cantidadPorCorteControl+1
        ACD(ZZ:&cantidadPorCorteControl,Fecha(&fechaControlar))
    EndIf
EndIf