SQL.ADD("Select MP.NrOperacion, MP.Cliente, MP.FechaMov, MP.FechaMov as FechaOp, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre, MP.Mercado, ")
SQL.ADD("          CASE  WHEN O.Especie=MP.Especie THEN Cuenta2 Else (CASE  WHEN O.ContraEspecie=MP.Especie THEN Cuenta3 Else (CASE  WHEN O.ContraEspecie=MP.Especie THEN Cuenta3 Else Cuenta1 END ) END ) END AS Cuenta ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E,  "~DBO~".MERCADOS M ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                                                         ")
SQL.ADD(" and   MP.Cliente   = C.Codigo                                                                ")
SQL.ADD(" and   O.Especie    = E.Codigo                                                                ")
SQL.ADD(" AND   O.Mercado4 = M.Codigo                 ")
SQL.ADD(" and   MP.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"'                                           ")
SQL.ADD(" and   MP.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"'                                           ")
SQL.ADD(" and   MP.Especie   = '"~Dialogo.Especie1~"'                                                  ")
SQL.ADD(" and   (                                                                                      ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta2 IN ("~val(li1)~"))                            ")
SQL.ADD("        or  (O.ContraEspecie=MP.Especie and O.Cuenta3 IN ("~val(li1)~"))                      ")
SQL.ADD("        or  (O.TasaEspecie=MP.Especie and O.Cuenta3 IN ("~val(li1)~")) ")
SQL.ADD("        )                                                                                     ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                                    ")
SQL.ADD(" and MP.NrSaldo = 1                                                                           ")
*SQL.ADD(" and O.TipoOp in ('FXCTC','FXVTC')                                                            ")
SQL.ADD(" and O.TipoOp in ('FXCF','FXVF') ")
*SQL.ADD(" and O.Mercado4='"~VAR('MERROFEX')~"' ")
SQL.ADD(" and M.TipoNegocio like '%FM|%' ")

SQL.ADD(" Union ")

SQL.ADD("Select MP.NrOperacion, MP.Cliente, MP.FechaMov, MP.FechaMov as FechaOp, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre, MP.Mercado, MP.Cuenta ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E,  "~DBO~".MERCADOS M ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                                                         ")
SQL.ADD(" and   MP.Cliente=C.Codigo                                                                ")
SQL.ADD(" and   O.Especie=E.Codigo                                                                 ")
SQL.ADD(" AND   O.Mercado4 = M.Codigo                 ")
SQL.ADD(" and   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'                                         ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'                                         ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'                                                ")
SQL.ADD(" and   (                                                                                      ")
SQL.ADD("            (O.Especie=MP.Especie and O.Cuenta2 IN ("~val(li1)~"))                            ")
SQL.ADD("        or  (O.ContraEspecie=MP.Especie and O.Cuenta3 IN ("~val(li1)~"))                      ")
SQL.ADD("        or  (O.TasaEspecie=MP.Especie and O.Cuenta3 IN ("~val(li1)~")) ")
SQL.ADD("        )                                                                                     ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                                    ")
SQL.ADD(" and MP.NrSaldo = 1                                                                           ")
*SQL.ADD(" and O.TipoOp in ('FXCTC','FXVTC')                                                            ")
SQL.ADD(" and O.TipoOp in ('FXCF','FXVF') ")
*SQL.ADD(" and O.Mercado4='"~VAR('MERROFEX')~"' ")
SQL.ADD(" and M.TipoNegocio like '%FM|%' ")
watch(SQL.BATCH())
