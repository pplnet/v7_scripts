*** Toma todas las operaciones vencidas y pendientes y los contados, pases y cauciones ***
*** Marca las operaciones, cambia la especie en los movimientos y agrega los cupones ***
*** SQL.ADD("and O.Vehiculo1 = '"~Val(j2)~"' ")

SQL.ADD("SELECT Distinct O.* ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrOperacion = O.NrOperacion ")
SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("and O.Cupon1='"~Fstr(Dialogo.Entero1,0,0)~"' ")
SQL.ADD("and O.TipoOp In ('SECS','SECSV','SEVS','SEVSV','SECT','SECTV','SEVT','SEVTV') ")
SQL.ADD("and (O.PaseCB = '1' or (CB8='0' or CB8 is Null)) ")
SQL.ADD("and O.FechaVto <= '"~IdxDate(Val(g2))~"' ")
SQL.ADD("and (O.RB4 = '0' or O.RB4 is Null) ") 
SQL.ADD("order by O.TipoOp, O.Especie ")

SetFilaActual(10)

Recorrer SQL
   Message('Procesando Operacion Vencida Nro. '~FBN['NrOperacion']~' ...')
   act(a:fac,fbn['NrOperacion'])

   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set Mercado3 = '"~Dialogo.ContraEspecie2~"', RB4 = '1' ")
   SQL.ADD("Cupon1='"~Fstr(Dialogo.Entero1+1)~"' ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.NEW


   SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
   SQL.ADD("(Especie, Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia )")
   SQL.ADD(" Select '"~Dialogo.ContraEspecie2~"', Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia ")
   SQL.ADD(" from "~DBO~".MOVPENDIENTES where nrOperacion = '"~Val(a:fac)~"' ")
   SQL.ADD(" and  Especie = '"~Dialogo.Especie1~"' ")
   SQL.NEW

   SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
   SQL.ADD("(Especie, Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia )")
   SQL.ADD(" Select '"~Dialogo.ContraEspecie2~"', Cliente, Cantidad, ")
   SQL.ADD(" FechaMov, NrOperacion, Cuenta, Leyenda, NrSaldo, Mercado, ")
   SQL.ADD(" Bits, NrGrupo, FechaEje, NrGrupo2, NrMov, NrInstan, EnteCustodia ")
   SQL.ADD(" from "~DBO~".MOVEJECUTADOS where nrOperacion = '"~Val(a:fac)~"' ")
   SQL.ADD(" and  Especie = '"~Dialogo.Especie1~"' ")
   SQL.NEW

   SQL.ADD("INSERT INTO "~DBO~".MOVLIMITES ")
   SQL.ADD("(Especie, Cliente, Limite, FechaLim, Monto, ")
   SQL.ADD(" FechaMov, NrOperacion, Bits) ")
   SQL.ADD(" Select '"~Dialogo.ContraEspecie2~"', Cliente, Limite, FechaLim, Monto, ")
   SQL.ADD(" FechaMov, NrOperacion, Bits ")
   SQL.ADD(" from "~DBO~".MOVLIMITES where nrOperacion = '"~Val(a:fac)~"' and Especie = '"~Dialogo.Especie1~"' ")
