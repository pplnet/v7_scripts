    SQL.ADD(" '"~val(p1)~"', ")
  endif
  SQL.ADD(" "~val(ss1)~", ")
  SQL.ADD(" '"~val(bo8)~"', ")


  SQL.ADD(" "~val(ss4)~", ")
  SQL.ADD(" 0, ")
