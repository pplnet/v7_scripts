if Dialogo.Check1=1
  SQL.ADD("Insert into "~DBO~".MOVPENDIENTES ( ")
  SQL.ADD("  NrOperacion, Cliente,  Especie,      Mercado, ")
  SQL.ADD("  NrSaldo,     FechaMov, Leyenda,      Bits,    ")
  SQL.ADD("  NrMov,       Cantidad, EnteCustodia, NrGrupo, Cuenta, ")
  SQL.ADD("  NrGrupo2,    NrInstan, Concepto,     Status   ")
  SQL.ADD("  ) values ( ")

  SQL.ADD(" '"~val(z1)~"', ")
  SQL.ADD(" '"~val(b1)~"', ")
  SQL.ADD(" '"~val(ss5)~"', ")
  SQL.ADD(" '"~val(ss6)~"', ")

  SQL.ADD(" 1, ")
  SQL.ADD(" '"~IdxDate(val(z2))~"', ")
  SQL.ADD(" '"~val(ss3)~"', ")
