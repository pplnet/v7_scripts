*** Orden para la Cancelacion Parcial de la deuda: IVAPERC,IVAADIC,IVANOR, ***
*** Intereses Punitorios,Intereses Compensatorios,Intereses Normales,Comision,Capital ***

ACN(x4,0)
ACN(x5,val(x3))

* Si bonifico punitorios
if Val(x6)=0
  SCN(x5, val(y6)+val(y7))
endif

* Cotizacion de la Especie a Fecha Vto.
if EqStr(val(a1),'ARP')
  ACN(z10,1)
else
*  ACN(z10,COTIZACIONC(val(a1),,,,val(cw:val(x1))-1,1,SI,'USD')*COTIZACIONC('USN',,,,val(cw:val(x1))-1,1,SI,'ARP'))    
*  Cambia por la cotizacion de USD del CierreBNA  
   ACN(z10,COTIZACIONBNA('USD',val(cw:val(x1))-1,2,NO,NO) )
endif


Recorrer&i 1,val(x1)
  ACN(ss4,1)
  (.'CANPRE8'.)
  recorrer&j 1,25
    ACN(ad:&j, val(ac:&j))
  proximo
*------ Aplico los pagos----------------------
  recorrer&j 1,25
    if val(x5)>0
      if round(val(ac:&j)-val(x5),2)<=0
        ACN(ad:&j, 0)
      else
        ACN(ad:&j, round(val(ac:&j)-val(x5),2))
      endif
      ******************************************
      * Atento a la condicion para ver si es ARP
      ******************************************
      if EqStr(Copy(Val(ab:&j),1,3),'IVA')

        * Si pago IVA de Interes o Comisiones Normales despues del vto
        * uso el tipo de cambio de la Fecha Vto

        if Incluido(FStr(val(aa:&j),1),'41|81|42|82|43|83') y val(z2)>val(cw:val(x1))
          ACN(ae:&j, (val(ac:&j)-val(ad:&j))*Val(z10))
          else
          ACN(ae:&j, (val(ac:&j)-val(ad:&j))*Val(z6))
        endif

        ACT(af:&j, 'ARP')
*        ACT(ag:&j, 'BCRA')
        ACT(ag:&j, Val(me2))
      else
        ACN(ae:&j, val(ac:&j)-val(ad:&j))
        ACT(af:&j, Val(a1))
*        ACT(ag:&j, Val(q1))
        ACT(ag:&j, Val(me1))
      endif
      ACN(x5,round(val(x5)-val(ac:&j),2))
    else
      break
    endif
  proximo

  if Dialogo.Check1=1
*----------- MARCA DE CANCELACION Y DEVENGADOS -----------------
    if val(z2) < val(cw:val(x1)) 
      *----------- PRECANCELACION

      *** Si existe algun registro en GENDEVENGADOS lo elimino
      SQL.ADD("DELETE FROM "~DBO~".GENDEVENGADOS ")
      SQL.ADD("WHERE NrOperacion='"~val(z1)~"' ")
      SQL.NEW
      SQL.EXEC

      ACN(zz3, 140)
      ACT(zz4, 'INTLEN')
      ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo="~Fstr(Val(zz3),3,0)~" and Fecha<"~IdxDate2(val(z2)-1)))
      ACN(zz7, Val(gg:val(x1))-Val(zz5))
            
      SQL.ADD("Update "~DBO~".OPERACIONES set ")
*      SQL.ADD("TotalIntereses    = "~FStr(Val(gg:(val(x1))),1,2)~", ")
      SQL.ADD("TotalBrutoCli1    = "~FStr(val(ca:val(x1)) + Val(gg:val(x1)),1,2)~", ")
      SQL.ADD("TotalComisiones   = "~FStr(Val(na:val(x1)),1,2)~" ")
      SQL.ADD("where NrOperacion = '"~val(z1)~"'")
      SQL.NEW
      SQL.EXEC

      ** Al no generar los movimientos en la carga de la minuta
      ** No tiene sentido recalcular los movimientos  
*      SQL.ActualizarMovimientos3(val(z1),SI,NO,NO,NO,NO,0)
*      SQL.NEW
      message('Borro los devengados que sobran - hasta hoy ')
      SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and Fecha >='"~IdxDate(val(z2)-1)~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo="~Fstr(Val(zz3),3,0)~" ")
      SQL.NEW
      message('Borro los devengados que sobran -  el resto ')
      SQL.ADD("INSERT "~DBO~".DELDEVENGADOS (NrOperacion, Fecha) VALUES ('"~val(z1)~"','"~IdxDate(FSYS)~"')")
      SQL.NEW
            
      if Val(zz7)>0.01 o Val(zz7)<-0.01
        message('Genero devengado de Ayer')
        (.'CANPRE11'.)
      endif
            
      *** Traigo el codigo de DEVENG (Actualizart resultados por devengados)
      *** por el mismo motivo
            
      *** Esto es lo mismo que restar un dia a la fecha del dialogo, pero 
      *** dejo el codigo de DEVENG.
      *** ALVW Genero resultados entre DialogoFecha1 y Ayer. Respeto el codigo inentendible
      *** alvw ACD(d1,Habiles(Dialogo.Fecha1-1,1,'ARG')-1)
            
      *-- Buscar tambien dias hacia atras no habiles ---
      ****alvw Recorrer&i Dialogo.Fecha1-1,Val(d1)
      Recorrer&i Dialogo.Fecha4,Dialogo.Fecha5
        Message("Actualizo Resultados por Devengados "~IdxDate(&i))
        SQL.ADD("EXEC "~DBO~".ActualizaDevengados ")
        SQL.ADD( IdxDate2(&i) )
        SQL.NEW
      Proximo
*** FIN DEVENG

      ACN(zz3, 180)
      ACT(zz4, 'COMIS')
      ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo="~Fstr(Val(zz3),3,0)~" and Fecha<"~IdxDate2(val(z2)-1)))
      ACN(zz7, Val(na:val(x1))-Val(zz5))

      message('Borro los devengados que sobran - hasta hoy ')
      SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and Fecha >='"~IdxDate(val(z2)-1)~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo="~Fstr(Val(zz3),3,0)~" ")
      SQL.NEW
      message('Borro los devengados que sobran -  el resto ')
*      SQL.ADD("INSERT "~DBO~".DELDEVENGADOS (NrOperacion, Fecha) VALUES ('"~val(z1)~"','"~IdxDate(FSYS)~"')")
*      SQL.NEW
            
      if Val(zz7)>0.01 o Val(zz7)<-0.01
        message('Genero devengado de Ayer (Comisiones)')
        (.'CANPRE11'.)
      endif

    endif
  endif

*------ Genero Movimientos ---------------------
  recorrer&j 1,25
    if Val(ac:&j)<>Val(ad:&j)
      * Genero Mov. Ejecutados
      * Si los punitorios estßn bonificados, cambio el Nr.saldo
      if [val(x6)=0 y val(aa:&j)>=60 y val(aa:&j)<=63]
        ACN(ss1, val(aa:&j)+140)
      else
        ACN(ss1, val(aa:&j))
      endif
      ACN(ss2, val(ac:&j)-val(ad:&j))
      ACT(ss3, val(ab:&j))
      (.'CANPME4'.)
        
      * Genero Mov. Pendientes
      * Tienen signo (-) porque son vistos del lado del cliente
      if not [val(x6)=0 y val(aa:&j)>=60 y val(aa:&j)<=63]
        ACN(ss1, val(aa:&j))
*        ACN(ss2, -(val(ac:&j)-val(ad:&j)))
        ACN(ss2, -val(ae:&j))
        ACT(ss3, val(ab:&j))
        ACT(ss5, val(af:&j))
        ACT(ss6, val(ag:&j))
        (.'CANPME6'.)
      endif
            
      * Genero Mov. Saldo Anterior
      if val(ba:&j)>0 y not [val(x6)=0 y val(aa:&j)>=60 y val(aa:&j)<=63]
        ACN(ss1,val(ba:&j))
        ACN(ss2,val(bc:&j))
        ACT(ss3,val(bb:&j))
        (.'CANPME4'.)
      endif  
    endif
  proximo
            
  *--- Movimientos de WHT y PISE ----------------------------------------
  if Eqstr(val(p1),'INGCURA')
    * Grabo siempre WHT
    * WHT / INTERESES
    if val(cm:val(x1))>0
      ACN(ss1,73)
      ACN(ss2,val(cm:val(x1)))
      ACT(ss3,'WHT sobre Intereses')
      (.'CANPME4'.)

      * Genero Mov. Pendientes
      * Tienen signo (-) porque son vistos del lado del cliente
      if val(z4)=0       
        ACN(ss2, -val(cm:val(x1))*val(z6))
        ACT(ss5, 'ARP')
        ACT(ss6, val(me2))
        (.'CANPME6'.)
      endif

    endif
    * WHT / COMISIONES
    if val(co:val(x1))>0
      ACN(ss1,74)
      ACN(ss2,val(co:val(x1)))
      ACT(ss3,'WHT sobre Comisiones')
      (.'CANPME4'.)

      * Genero Mov. Pendientes
      * Tienen signo (-) porque son vistos del lado del cliente
      if val(z4)=0
        ACN(ss2, -val(co:val(x1))*val(z6))
        ACT(ss5, 'ARP')
        ACT(ss6, val(me2))
        (.'CANPME6'.)
      endif

    endif
    * WHT / BREAKFUNDING
    if val(kf:val(x1))>0
      ACN(ss1,77)
      ACN(ss2,val(kf:val(x1)))
      ACT(ss3,'WHT sobre Breakfunding')
      (.'CANPME4'.)

      if val(z4)=0
        ACN(ss2, -val(kf:val(x1))*val(z6))
        ACT(ss5, 'ARP')
        ACT(ss6, val(me2))
        (.'CANPME6'.)
      endif
    endif

    if EQSTR(val(r1),'SI')
      * PISE / INTERESES
      if val(cn:val(x1))>0
        ACN(ss1,75)
        ACN(ss2,val(cn:val(x1)))
        ACT(ss3,'PISE sobre Intereses')
        (.'CANPME4'.)  

        if val(z4)=0
          ACN(ss2, -val(cn:val(x1))*val(z6))
          ACT(ss5, 'ARP')
          ACT(ss6, val(me2))
          (.'CANPME6'.)
        endif
      endif
      * PISE / COMISIONES
      if val(cp:val(x1))>0
        ACN(ss1,76)
        ACN(ss2,val(cp:val(x1)))
        ACT(ss3,'PISE sobre Comisiones')
        (.'CANPME4'.)

        if val(z4)=0
          ACN(ss2, -val(cp:val(x1))*val(z6))
          ACT(ss5, 'ARP')
          ACT(ss6, val(me2))
          (.'CANPME6'.)
        endif
      endif
      * PISE / BREAKFUNDING
      if val(ke:val(x1))>0
        ACN(ss1,78)
        ACN(ss2,val(ke:val(x1)))
        ACT(ss3,'PISE sobre Breakfunding')
        (.'CANPME4'.)

        if val(z4)=0
          ACN(ss2, -val(ke:val(x1))*val(z6))
          ACT(ss5, 'ARP')
          ACT(ss6, val(me2))
          (.'CANPME6'.)
        endif
      endif
    endif
  endif
            
  *** Actualizo los saldos y Fecha de Cobro
  if Dialogo.Check1=1
    SQL.ADD("Update "~DBO~".OPERACIONES set ")
    SQL.ADD("  TotalAux5   = "~FStr(Val(ad:13),1,2)~",  ")
    SQL.ADD("  TotalAux6   = "~FStr(Val(ad:7),1,2)~" ,  ")
    SQL.ADD("  TotalAux7   = "~FStr(Val(ad:1),1,2)~" ,  ")
    SQL.ADD("  TotalIVA    = "~FStr(Val(ad:16),1,2)~",  ")
    SQL.ADD("  TotalIVAADI = "~FStr(Val(ad:10),1,2)~",  ")
    SQL.ADD("  TotalIVAPER = "~FStr(Val(ad:4),1,2)~" ,  ")
    if not val(x6)=0
      SQL.ADD("  TotalAux4 = "~FStr(Val(ad:19),1,2)~", ")
    endif
    SQL.ADD("  TotalAux3   = "~FStr(Val(ad:20),1,2)~", ")
    SQL.ADD("  TotalAux2   = "~FStr(Val(ad:21),1,2)~", ")
    SQL.ADD("  TotalAux8   = "~FStr(Val(ad:23),1,2)~", ")
    SQL.ADD("  TotalAux9   = "~FStr(Val(ad:22),1,2)~", ")
    * Si es 2412 no actualizo el saldo de Capital porque lo hace otro evento
    if not Eqstr(val(bo4),'1')
      SQL.ADD("  TotalAux1   = "~FStr(Val(ad:25),1,2)~", ")
    endif       

    * Si cancelo el Capital marco el prestamo como cancelado

    if [not Eqstr(val(bo4),'1') y Val(ad:25)=0]
      SQL.ADD("CB6         = '1', ")
      SQL.ADD("FechaPrecan = '"~IdxDate(val(z2))~"', ")
    endif
    SQL.ADD("FechaEj       = '"~Idxdate(val(z2))~"' ")
    SQL.ADD("where NrOperacion = '"~val(z1)~"'")
    SQL.NEW
            
    SQL.EXEC
  endif
            
  if Val(ad:25)=0
    Messagebox('El prestamo fue cancelado totalmente')
  else
    Messagebox('El prestamo fue cancelado')
  endif


************ Si FechaValor < FechaSistema, se generan los MOVDEVENGADOS de COMPENSATORIOS con signo contrario ******************
***** SEGUN RICARDO NO DEBE REVERSAR DEVENGADOS
if NO


if val(z2)<val(z22)
  ACD(z23,val(z2))
    if val(cw:&i) < val(z22)

       ACN(ss4, Num(val(cz:&i)))

       *** COMPENSATORIOS ***
       SQL.ADD("Select TipoDevengado,Fecha,Monto ")
       SQL.ADD("from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=150 ")
       SQL.ADD("and Fecha>="~IdxDate2(val(cw:&i))~" and Fecha<="~IdxDate2(val(z22))~" and Cupon='"~Fstr(val(ss4),0,0)~"' ")
       SQL.ADD("and Monto > 0 ")
       Recorrer SQL
         ACD(z2,val(z22))
         ACN(zz7,FBN['Monto']*-1)
         ACT(zz4,FBN['TipoDevengado'])
         ACN(zz3,150)
         (.'CANPRE11'.)
         SQL.EXEC
       Proximo    
   
       *** PUNITORIOS ***
       SQL.ADD("Select TipoDevengado,Fecha,Monto ")
       SQL.ADD("from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=160 ")
       SQL.ADD("and Fecha>="~IdxDate2(val(cw:&i))~" and Fecha<="~IdxDate2(val(z22))~" and Cupon='"~Fstr(val(ss4),0,0)~"' ")
       SQL.ADD("and Monto > 0 ")
       Recorrer SQL
         ACD(z2,val(z22))
         ACN(zz7,FBN['Monto']*-1)
         ACT(zz4,FBN['TipoDevengado'])
         ACN(zz3,160)
         (.'CANPRE11'.)
         SQL.EXEC
       Proximo       

    endif
  ACD(z2,val(z23))
endif


ENDIF

Proximo

