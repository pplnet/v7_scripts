IF Val(ww:1)=1
   ACT(c:fac+12,'El Agente/Sociedad de Bolsa '~Val(ww:3)~' c#digo Nro.'~Val(ww:2)~' detalla a continuaci#n')
   ACT(c:fac+13,'las operaciones de CONTADO concertadas en el S.I.N.A.C.,  en  el d#a de la')
   ACT(c:fac+14,'fecha, para una A.F.J.P.')
ELSE
   ACT(c:fac+12,'El Agente/Sociedad de Bolsa '~Val(ww:3)~' c#digo Nro.'~Val(ww:2)~' detalla a continuaci#n')
   ACT(c:fac+13,'las operaciones de CONTADO concertadas en la SESION CONTINUA DE NEGOCIACION,  en  el d#a')
   ACT(c:fac+14,'de la fecha, para una A.F.J.P.')
ENDIF

