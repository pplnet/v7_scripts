ACT(f:FAC,   "ANEXO CIRCULAR N# 3339")
ACT(f:FAC+4, 'Buenos Aires, '~FStr(Dia(Dialogo.Fecha1),1,0)~' de '~Meses(Mes(Dialogo.Fecha1))~' de '~FStr(Anio(Dialogo.Fecha1),1,0))
