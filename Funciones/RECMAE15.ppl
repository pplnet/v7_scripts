***********************************************************************************************
* Recibi un Registro 9903 y Completo la tabla TASASSIOPEL                                     *
***********************************************************************************************

if EqStr(Var('LOGEAMAE'),'SI')
  AbrirASCII(Val(z2)~'\REC-9903.txt',0)
  EscribirASCII(Val(a:FAC))
  CerrarASCII
endif

Message('Recibido Reg. Tasas e Indices (9903)')
BorrarCeldas(s:1..t:25)
*/Completo la Tabla
ACT(s:1, 'Fecha')
ACT(s:2, 'Longitud')
ACT(s:3, 'Mercado')
ACT(s:4, 'Agente')
ACT(s:5, 'Operador')
ACT(s:6, 'Fecha_aa')
ACT(s:7, 'Fecha_mm')
ACT(s:8, 'Fecha_dd')
ACT(s:9, 'Hora_hh')
ACT(s:10, 'Hora_mm')
ACT(s:11, 'Hora_ss')
ACT(s:12, 'FechaCarga')
ACT(s:13, 'Secuencia')
ACT(s:14, 'Secuencia2') 
ACT(s:15, 'CodigoReg')
ACT(s:16, 'CodigoMovi')
ACT(s:17, 'CodigoTasa')
ACT(s:18, 'CantOcurr')
ACT(s:19, '# Ocurr')
ACT(s:20, 'Fechatasa')
ACT(s:21, 'Periodo')
ACT(s:22, 'Valor')
ACT(s:23, 'Fecha(FechaTasa)')
ACT(s:24, 'Num(Valor)')
ACT(s:25, 'Cuantos')

ACN(x2, 1)
ACT(t:2, Copy(Val(a:FAC),Val(x2),4))
SCN(x2, 4)
ACT(t:3, Copy(Val(a:FAC),Val(x2),1))
SCN(x2, 1)
ACT(t:4, Copy(Val(a:FAC),Val(x2),3))
SCN(x2, 3)
ACT(t:5, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:6, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:7, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:8, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:9, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:10, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:11, Copy(Val(a:FAC),Val(x2),2))
SCN(x2, 2)
ACT(t:13, Copy(Val(a:FAC),Val(x2),5))
SCN(x2, 5)
ACT(t:15, Copy(Val(a:FAC),Val(x2),4))
SCN(x2, 4)
ACT(t:16, Copy(Val(a:FAC),Val(x2),1))
SCN(x2, 1)
ACT(t:17, Copy(Val(a:FAC),Val(x2),3))
SCN(x2, 3)
ACT(t:18, Copy(Val(a:FAC),Val(x2),3))
SCN(x2, 3)

*** Fecha
ACD(t:1, Fecha(Val(t:8)~'/'~Val(t:7)~'/'~'20'~Val(t:6)))
*** Fecha de Carga en SIOPEL
ACT(t:12, Val(t:7)~'/'~Val(t:8)~'/'~Val(t:6)~' '~Val(t:9)~':'~Val(t:10)~':'~Val(t:11))  
*** Secuencia2
ACT(t:14, Val(t:6)~Val(t:7)~Val(t:8)~Val(t:13))
*** # Ocurrencias
ACN(t:19, Num(Val(t:18)))

if Val(t:19)>0
  Recorrer&i 1,Val(t:19)
    BorrarCeldas(t:20..t:25)
    ACT(t:20, Copy(Val(a:FAC),Val(x2),8))
    if EqStr(Val(t:20),'99999999')
      Break
    else
      SCN(x2, 8)
      ACT(t:21, Copy(Val(a:FAC),Val(x2),7))
      SCN(x2, 7)
      ACT(t:22, Copy(Val(a:FAC),Val(x2),18))
      SCN(x2, 18)
      ACD(t:23, Fecha(Copy(Val(t:20),7,2)~'/'~Copy(Val(t:20),5,2)~'/'~Copy(Val(t:20),1,4)))
      ACN(t:24, Round(Num(Val(t:22))/100000000,8))

      SQL.ADD("Select 1 Cuantos from  "~DBO~".TASASSIOPEL ")
      SQL.ADD(" where CodigoTasa  = '"~Val(t:17)~"' ")
      SQL.ADD("   and FechaTasa   = '"~IdxDate(Val(t:23))~"' ")
      SQL.ADD("   and Periodo     = '"~Val(t:21)~"' ")
      SQL.ADD("   and Fecha       = '"~IdxDate(Val(t:1))~"' ")
      Recorrer SQL
        DFA
        ACN(t:25, fbn('Cuantos'))
      Proximo
      if Incluido(Val(t:16),'A|M')
        */Actualizo la Tabla
        if Val(t:25) <> 0
          Message('Update TASASSIOPEL Secuencia2 = '~Val(c:81))
          SQL.ADD("Update "~DBO~".TASASSIOPEL ")
          SQL.ADD("   Set Longitud        = '"~Val(t:2)~"', ")
          SQL.ADD("       Mercado         = '"~Val(t:3)~"', ")
          SQL.ADD("       Agente          = '"~Val(t:4)~"', ")
          SQL.ADD("       Operador        = '"~Val(t:5)~"', ")
          SQL.ADD("       Fecha_aa        = '"~Val(t:6)~"', ")
          SQL.ADD("       Fecha_mm        = '"~Val(t:7)~"', ")
          SQL.ADD("       Fecha_dd        = '"~Val(t:8)~"', ")
          SQL.ADD("       Hora_hh         = '"~Val(t:9)~"', ")
          SQL.ADD("       Hora_mm         = '"~Val(t:10)~"', ")
          SQL.ADD("       Hora_ss         = '"~Val(t:11)~"', ")
          SQL.ADD("       FechaCarga      = Convert(datetime,'"~Val(t:12)~"'), ")
          SQL.ADD("       Secuencia       = '"~Val(t:13)~"', ")
          SQL.ADD("       Secuencia2      = '"~Val(t:14)~"', ")
          SQL.ADD("       CodigoMovi      = '"~Val(t:16)~"', ")
          SQL.ADD("       CantOcurrencias = '"~Val(t:18)~"', ")
          SQL.ADD("       Valor           = "~FStr(Val(t:24),1,8)~" ")
          SQL.ADD(" Where CodigoTasa = '"~Val(t:17)~"' ")
          SQL.ADD("   and FechaTasa  = '"~IdxDate(Val(t:23))~"' ")
          SQL.ADD("   and Periodo    = '"~Val(t:21)~"' ")
          SQL.ADD("   and Fecha      = '"~IdxDate(Val(t:1))~"' ")
          SQL.NEW
        else
          Message('Insert TASASSIOPEL Secuencia2 = '~Val(c:81))
          SQL.ADD("Insert into "~DBO~".TASASSIOPEL ( ")
          SQL.ADD("Fecha,      Longitud,        Mercado,        Agente,     ")
          SQL.ADD("Operador,   Fecha_aa,        Fecha_mm,       Fecha_dd,   ")
          SQL.ADD("Hora_hh,    Hora_mm,         Hora_ss,        FechaCarga, ")
          SQL.ADD("Secuencia,  Secuencia2,      CodigoRegistro, CodigoMovi, ")
          SQL.ADD("CodigoTasa, CantOcurrencias, FechaTasa,      Periodo,    ")
          SQL.ADD("Valor                ")
          SQL.ADD(" ) Values ( ")
          SQL.ADD(" '"~IdxDate(Val(t:1))~"', ")
          SQL.ADD(" '"~Val(t:2)~"', ")
          SQL.ADD(" '"~Val(t:3)~"', ")
          SQL.ADD(" '"~Val(t:4)~"', ")

          SQL.ADD(" '"~Val(t:5)~"', ")
          SQL.ADD(" '"~Val(t:6)~"', ")
          SQL.ADD(" '"~Val(t:7)~"', ")
          SQL.ADD(" '"~Val(t:8)~"', ")

          SQL.ADD(" '"~Val(t:9)~"', ")
          SQL.ADD(" '"~Val(t:10)~"', ")
          SQL.ADD(" '"~Val(t:11)~"', ")
          SQL.ADD(" Convert(datetime,'"~Val(t:12)~"'), ")

          SQL.ADD(" '"~Val(t:13)~"', ")
          SQL.ADD(" '"~Val(t:14)~"', ")
          SQL.ADD(" '"~Val(t:15)~"', ")
          * Comienza Bloque de datos
          SQL.ADD(" '"~Val(t:16)~"', ")

          SQL.ADD(" '"~Val(t:17)~"', ")
          SQL.ADD(" '"~Val(t:18)~"', ")
          SQL.ADD(" '"~IdxDate(Val(t:23))~"', ")
          SQL.ADD(" '"~Val(t:21)~"', ")

          SQL.ADD(" "~FStr(Val(t:24),1,8)~" ")
          SQL.ADD(" ) ")
          SQL.NEW
        endif
        SQL.EXEC
      else
        if EqStr(Val(t:16),'B')
        else
          if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('CodigoMovi incorrecto RECMAE15',30)~'-'~Val(A:FAC))
            CerrarASCII
          endif
        endif
      endif
    endif
  Proximo
endif
