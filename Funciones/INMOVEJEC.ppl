SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ")
SQL.ADD("SELECT * FROM "~DBO~".MOVPENDIENTES ")
SQL.ADD("WHERE NrOperacion = '"~val(pa1)~"' AND ")
SQL.ADD("      Cliente = '"~val(pa2)~"' AND ")
SQL.ADD("      Concepto = '"~val(pa3)~"' AND ")
SQL.ADD("      Mercado = '"~Val(pa4)~"' AND ")
SQL.ADD("      CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) = "~FStr(Val(pa5),0,0)~" ")
SQL.NEW

SQL.ADD("DELETE "~DBO~".MOVPENDIENTES ")
SQL.ADD("WHERE NrOperacion = '"~val(pa1)~"' AND ")
SQL.ADD("      Cliente = '"~val(pa2)~"' AND ")
SQL.ADD("      Concepto = '"~val(pa3)~"' AND ")
SQL.ADD("      Mercado = '"~Val(pa4)~"' AND ")
SQL.ADD("      CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) = "~FStr(Val(pa5),0,0)~" ")
SQL.NEW
