**
***--- Se le agrego la Modificacion de la cuenta (Moneda y Especie)
*

SQL.ADD("UPDATE "~DBO~".MOVPENDIENTES Set FechaEje='"~IdxDate(IIf(Dialogo.Radio1=0,Dialogo.Fecha2,Fsys))~"', Cuenta = '"~val(pa6)~"' ")
SQL.ADD("WHERE NrOperacion = '"~val(pa1)~"' AND ")
SQL.ADD("      Cliente  = '"~val(pa2)~"' AND ")
SQL.ADD("      Concepto = '"~val(pa3)~"' AND ")
SQL.ADD("      Mercado  = '"~Val(pa4)~"' AND ")
SQL.ADD("      Especie IN (Select Codigo FROM "~DBO~".ESPECIES WHERE Jerarquia LIKE '"~Var('JERMONEDA')~"%' )   AND ")
SQL.ADD("      CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) = "~FStr(Val(pa5),0,0)~" ")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".MOVPENDIENTES Set FechaEje='"~IdxDate(IIf(Dialogo.Radio1=0,Dialogo.Fecha2,Fsys))~"', Cuenta = '"~val(pa7)~"' ")
SQL.ADD("WHERE NrOperacion = '"~val(pa1)~"' AND ")
SQL.ADD("      Cliente  = '"~val(pa2)~"' AND ")
SQL.ADD("      Concepto = '"~val(pa3)~"' AND ")
SQL.ADD("      Mercado  = '"~Val(pa4)~"' AND ")
SQL.ADD("      Especie IN (Select Codigo FROM "~DBO~".ESPECIES WHERE Jerarquia NOT LIKE '"~Var('JERMONEDA')~"%' )   AND ")
SQL.ADD("      CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) = "~FStr(Val(pa5),0,0)~" ")
SQL.NEW

