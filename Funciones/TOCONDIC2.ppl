*VCAN18    : 'SaldoFechaHoy'         ;7 ;1;2;NO;  ;VCAN18>=CANTIDADTOTALORDEN;'Saldo a Fecha de Hoy insuficiente';NO;;SaldoC(CLIENTE,ESPECIE,,,,MERCADO,VEHICULO,,VCAN9,FSys,VTXT8)+Query("SELECT SUM(Cantidad) FROM "~DBO~".MOVPENDIENTES WHERE Mercado='"~MERCADO~"' AND Cantidad<0 AND Cliente='"~CLIENTE~"' AND Especie='"~ESPECIE~"' AND EnteCustodia='"~VEHICULO~"' AND "~IF(NoVacio(VTXT8),"Cupon='"~VTXT8~"' AND","")~" NrSaldo="~FStr(VCAN9,3,0)~" AND NrOperacion In (SELECT NrTrans FROM "~DBO~".TRANSACCIONES2 WITH (NOLOCK)  WHERE CB6=0 AND NrTrans=NrOperacion)")+Query("SELECT Cantidad FROM "~DBO~".MOVEJECUTADOS with (NOLOCK) WHERE Mercado='"~MERCADO~"' AND NrOperacion='"~NROPERACION~"' AND Cliente='"~CLIENTE~"' AND Especie='"~ESPECIE~"' AND EnteCustodia='"~VEHICULO~"' AND "~IF(NoVacio(VTXT8),"Cupon='"~VTXT8~"' AND","")~" NrSaldo="~FStr(VCAN8,3,0)~" ");;;;;'#########.####'

EqStr(AfectaLS,'Limites') o [EqStr(AfectaLS,'Saldos') y CANTIDADTOTALORDEN<=SaldoC(CLIENTE,ESPECIE,,,,MERCADO,VEHICULO,,VCAN9,FSys,VTXT8)];'Saldo Insuficiente';NO 

