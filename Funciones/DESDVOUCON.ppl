      SQL.ADD(" Modulo, Sucursal, Transaccion, FechaCont, Relacion,                         ")
      SQL.ADD(" Fecha, FechaValor, Especie, Mercado,                                        ")             
      SQL.ADD(" Accion, Estado, Referencia, Tipo,                                           ")
      SQL.ADD(" MontoABloquear, MontoADebCred, MontoBloqueado, MontoDebCred,                ")
      SQL.ADD(" Capital, Comisiones, Derechos, Iva, Intereses, CodEvento,                   ")
      SQL.ADD(" CapCupon, ComCupon, DerCupon, IvaCupon, IntCupon,                           ")
      SQL.ADD(" CapAccion, ComAccion, DerAccion, IvaAccion, IntAccion,                      ")
      SQL.ADD(" CapCamest, ComCamest, DerCamest, IvaCamest, IntCamest                       ")
      SQL.ADD(" ) VALUES (  ")
      SQL.ADD("'"~Val(rr:19)~"','"~Val(rr:20)~"','"~Val(rr:2)~"','"~val(rr:3)~"','"~val(rr:34)~"', '"~val(rr:35)~"', '"~val(rr:36)~"',")
      SQL.ADD("'"~Val(rr:4)~"','"~Val(rr:5)~"', '"~Val(rr:6)~"', '','"~Val(rr:8)~"',")
      SQL.ADD(IdxDate2(FSys)~", "~IdxDate2(Dialogo.Fecha1)~", '"~Val(rr:21)~"',   '"~Val(rr:25)~"', ")
      * Resta las Liquidaciones
      if Val(rr:40)=1
         If Num(Val(rr:57))+Num(Val(rr:58))+Num(Val(rr:59))+Num(Val(rr:60))+Num(Val(rr:61))>0
            act(rr:26,'CUP')
         else
            If Num(Val(rr:47))+Num(Val(rr:48))+Num(Val(rr:49))+Num(Val(rr:50))+Num(Val(rr:51))>0
               act(rr:26,'STOCKS')
            else
               If Num(Val(rr:67))+Num(Val(rr:68))+Num(Val(rr:69))+Num(Val(rr:70))+Num(Val(rr:71))>0
                  act(rr:26,'CAMEST')
               else
                  act(rr:26,'DEANU')
               endif   
            endif   
         endif   
      
         SQL.ADD("'CR','NOK','','"~Val(rr:26)~"',")
         SQL.ADD(Fstr(0,0,2)~", "~Fstr(Num(Val(rr:47))+Num(Val(rr:57))+Num(Val(rr:67))+Num(Val(rr:48))+Num(Val(rr:58))+Num(Val(rr:68))+Num(Val(rr:49))+Num(Val(rr:59))+Num(Val(rr:69))+Num(Val(rr:50))+Num(Val(rr:60))+Num(Val(rr:70))+Num(Val(rr:51))+Num(Val(rr:61))+Num(Val(rr:71)),0,2)~", "~Fstr(0,0,2)~", "~Fstr(0,0,2)~",")
         SQL.ADD(Fstr(Num(Val(rr:47))+Num(Val(rr:57))+Num(Val(rr:67)),0,2)~", "~Fstr(Num(Val(rr:48))+Num(Val(rr:58))+Num(Val(rr:68)),0,2)~", "~Fstr(Num(Val(rr:49))+Num(Val(rr:59))+Num(Val(rr:69)),0,2)~", "~Fstr(Num(Val(rr:50))+Num(Val(rr:60))+Num(Val(rr:70)),0,2)~","~Fstr(Num(Val(rr:51))+Num(Val(rr:61))+Num(Val(rr:71)),0,2)~",'"~Val(rr:32)~"',")
      else
         SQL.ADD("'"~Val(rr:24)~"','"~Val(rr:1)~"','"~Val(rr:10)~"',")
         SQL.ADD(Fstr(Val(rr:17),0,2)~", "~Fstr(Val(rr:18),0,2)~", "~Fstr(Val(rr:22),0,2)~", "~Fstr(Val(rr:23),0,2)~",")
         SQL.ADD(Fstr(Val(rr:27),0,2)~", "~Fstr(Val(rr:28),0,2)~", "~Fstr(Val(rr:29),0,2)~", "~Fstr(Val(rr:30),0,2)~","~Fstr(Val(rr:31),0,2)~",'"~Val(rr:32)~"',")
      endif   
      SQL.ADD(Fstr(Val(rr:57),0,2)~", "~Fstr(Val(rr:58),0,2)~", "~Fstr(Val(rr:59),0,2)~", "~Fstr(Val(rr:60),0,2)~","~Fstr(Val(rr:61),0,2)~",")
      SQL.ADD(Fstr(Val(rr:47),0,2)~", "~Fstr(Val(rr:48),0,2)~", "~Fstr(Val(rr:49),0,2)~", "~Fstr(Val(rr:50),0,2)~","~Fstr(Val(rr:51),0,2)~",")
      SQL.ADD(Fstr(Val(rr:67),0,2)~", "~Fstr(Val(rr:68),0,2)~", "~Fstr(Val(rr:69),0,2)~", "~Fstr(Val(rr:70),0,2)~","~Fstr(Val(rr:71),0,2)~"")
