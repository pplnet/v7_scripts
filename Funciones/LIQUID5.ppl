*******************************************************************************
***--- Marco las Operaciones para la afectacion de LIMITES y POSICIONES2 ---***
*******************************************************************************

IF EqStr(Val(TP:&i),'TRANTI')
    **//Actualizo movimientos para TRANTI
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" SET CB15 = 1 ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos 
      Message(' Actualizando Movimientos ')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,NO,NO,NO)
      SQL.EXEC    
EndIf

IF Not Incluido(Val(TP:&i),'SERA|SERAV|SERP|SERPV|SEPVMV|')
   **// Afecta POSICIONES2 
   If Val(aa:&i)=500
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" SET CB15 = 1 ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones
      **//MessageBox('Actualizo POSICIONES2 para '~Val(a:&i))
      Message(' Actualizando movimientos de POSICIONES2')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,NO,NO,SI)
      SQL.EXEC
   Endif
   **// Afecta LIMITES
   If Val(aa:&i)=600
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" SET RB15 = 1 ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de limites
      **//MessageBox('Actualizo LIMITES para '~Val(a:&i))
      Message(' Actualizando movimientos de LIMITES')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,SI,NO,NO)
      SQL.EXEC
   Endif
   **// Afecta LIMITES y POSICIONES2
   If Val(aa:&i)=700
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" SET CB15 = 1 , RB15 = 1 ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones y limites
      **//MessageBox('Actualizo POSICIONES2 Y LIMITES para '~Val(a:&i))
      Message(' Actualizando movimientos de POSICIONES2 y LIMITES')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,SI,NO,SI)
      SQL.EXEC
   Endif
ENDIF

IF Incluido(Val(TP:&i),'SERA|SERAV|SERP|SERPV|')
   ***/// Las REPOS tienen tratamiento especial segun se liquide mov de SPOT o FUTURO
   **// Afecta POSICIONES2 SPOT
   If Val(aa:&i)=500
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set CB15 = CASE ")
      SQL.ADD("            WHEN CB15=1 OR CB15=2 OR CB15=3 THEN 3 ")
      SQL.ADD("            ELSE 1 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones
      Message(' Actualizando movimientos de POSICIONES2')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,NO,NO,SI)
      SQL.EXEC
   Endif
   **// Afecta LIMITES SPOT
   If Val(aa:&i)=600
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set RB15 = CASE ")
      SQL.ADD("            WHEN RB15=1 OR RB15=2 OR RB15=3 THEN 3 ")
      SQL.ADD("            ELSE 1 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de limites
      Message(' Actualizando movimientos de LIMITES')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,SI,NO,NO)
      SQL.EXEC
   Endif
   **// Afecta LIMITES y POSICIONES2 SPOT
   If Val(aa:&i)=700
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set CB15 = CASE ")
      SQL.ADD("            WHEN CB15=1 OR CB15=2 OR CB15=3 THEN 3 ")
      SQL.ADD("            ELSE 1 END, ")
      SQL.ADD("     RB15 = CASE ")
      SQL.ADD("            WHEN RB15=1 OR RB15=2 OR RB15=3 THEN 3 ")
      SQL.ADD("            ELSE 1 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones y limites
      Message(' Actualizando movimientos de POSICIONES2 y LIMITES')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,SI,NO,SI)
      SQL.EXEC
   Endif
   **// Afecta POSICIONES2 FUTURO
   If Val(aa:&i)=550
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set CB15 = CASE ")
      SQL.ADD("            WHEN CB15=1 OR CB15=2 OR CB15=3 THEN 3 ")
      SQL.ADD("            ELSE 2 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones
      Message(' Actualizando movimientos de POSICIONES2')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,NO,NO,SI)
      SQL.EXEC
   Endif
   **// Afecta LIMITES FUTURO
   If Val(aa:&i)=650
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set RB15 = CASE ")
      SQL.ADD("            WHEN RB15=1 OR RB15=2 OR RB15=3 THEN 3 ")
      SQL.ADD("            ELSE 2 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de limites
      Message(' Actualizando movimientos de LIMITES')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,SI,NO,NO)
      SQL.EXEC
   Endif
   **// Afecta LIMITES y POSICIONES2 FUTURO
   If Val(aa:&i)=750
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set CB15 = CASE ")
      SQL.ADD("            WHEN CB15=1 OR CB15=2 OR CB15=3 THEN 3 ")
      SQL.ADD("            ELSE 2 END, ")
      SQL.ADD("     RB15 = CASE ")
      SQL.ADD("            WHEN RB15=1 OR RB15=2 OR RB15=3 THEN 3 ")
      SQL.ADD("            ELSE 2 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones y limites
      Message(' Actualizando movimientos de POSICIONES2 y LIMITES')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,SI,NO,SI)
      SQL.EXEC
   Endif
ENDIF

IF Incluido(Val(TP:&i),'SEPVMV|')
   ***/// Las SEPVMV tiene tratamiento especial ya que afecta posiciones al inicio y al vto por separado
   **// Afecta POSICIONES2 INICIO
   If Val(aa:&i)=550
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set CB15 = CASE ")
      SQL.ADD("            WHEN CB15=1 OR CB15=3 THEN 1 ")
      SQL.ADD("            ELSE 2 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones
      Message(' Actualizando movimientos de POSICIONES2')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,NO,NO,SI)
      SQL.EXEC
   Endif
   **// Afecta POSICIONES2 VTO
   If Val(aa:&i)=500
      SQL.ADD(" UPDATE "~DBO~".OPERACIONES ")
      SQL.ADD(" Set CB15 = CASE ")
      SQL.ADD("            WHEN CB15=1 OR CB15=2 THEN 1 ")
      SQL.ADD("            ELSE 3 END ")
      SQL.ADD(" Where NrOperacion = '"~Val(a:&i)~"' ")
      SQL.NEW
      SQL.EXEC
      ***Actualizo Movimientos de posiciones
      Message(' Actualizando movimientos de POSICIONES2')
      Esperar(3)
      SQL.ActualizarMovimientos2(Val(a:&i),SI,NO,NO,SI)
      SQL.EXEC
   Endif
ENDIF