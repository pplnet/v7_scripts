            ACN(BD:1, 0)
            ***---Busco si tiene Integraciones
            SQL.ADD(" Select T.NrTrans, T.Fecha1, T.Especie, C.Cantidad1, C.Especie1, C.Precio1, C.Precio2, C.Precio3, C.Cantidad2 ")
            SQL.ADD(" From "~DBO~".TRANSACCIONES2 T, "~DBO~".CUOTAS C ")
            SQL.ADD(" Where T.NrTrans = C.NrOperacion ")
            SQL.ADD(" AND T.TipoTr2 = 'INTGAR' ")
            SQL.ADD(" AND T.NrOperacionRef1 = '"~Val(OP:1)~"' ")
            SQL.ADD(" Order By NrTrans ")
            Recorrer SQL
                IF Val(BD:1) = 0
                    DFA
                ENDIF
                IF Not Eqstr(fbn('NrTrans'), Val(TR:1))
                    ACT(C:fac, 'Integracion')
                    ACT(D:fac, fbn('NrTrans'))
                    ACLT(D:fac, fbn('NrTrans'))
                    ACD(E:fac, fbn('Fecha1'))
                ENDIF
                ACT(F:fac, fbn('Especie1'))
                ACN(G:fac, fbn('Cantidad1'))
                IF Not Eqstr(fbn('Especie'), Val(MN:1))
                    ACN(H:fac, fbn('Precio1') * CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
                    ACN(J:fac, fbn('Precio3') * CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
                    ACN(K:fac, fbn('Cantidad2') * CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
                ELSE
                    ACN(H:fac, fbn('Precio1'))
                    ACN(J:fac, fbn('Precio3'))
                    ACN(K:fac, fbn('Cantidad2'))
                ENDIF
                ACN(I:fac, fbn('Precio2'))
                ACN(L:fac, CotizacionC(fbn('Especie1'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
                ACN(M:fac, Val(L:fac) * Val(I:fac) / 100)
                ACN(N:fac, Val(G:fac) * Val(M:fac))
                ACN(O:fac, Val(TO:1) - Val(N:fac))
                ACN(TO:1, Val(O:fac))
                ACT(TR:1, fbn('NrTrans'))
                ACN(BD:1, 1)
            Proximo
            IF Val(BD:1) = 1
                ifa
            ENDIF
            SCN(TC:1, Val(TO:1))
            SCN(TV:1, Val(TO:1))