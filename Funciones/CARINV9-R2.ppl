IF Val(FE:50) > Dialogo.Fecha1
    ACD(FD:1, Val(FE:50))
ELSE
    ACD(FD:1, Dialogo.Fecha1)
ENDIF
IF Val(FE:60) < Dialogo.Fecha2
    ACD(FH:1, Val(FE:60))
ELSE
    ACD(FH:1, Dialogo.Fecha2)
ENDIF
IF Not Eqstr(Val(ES:99), Val(MU:1))
    IF Eqstr(Val(ES:99), Val(ML:1))
        ***---ARP a USD
        ACN(DC:88, (Val(MN:1) / CotizacionBNA(Val(MI:1),Val(FH:1),1,NO,NO)) - (Val(MN:1) / CotizacionBNA(Val(MI:1),Val(FD:1),1,NO,NO)))
*MessageBox(Fstr(CotizacionBNA(Val(MI:1),Val(FH:1),1,NO,NO), 0, 8))
*MessageBox(Fstr(CotizacionBNA(Val(MI:1),Val(FD:1),1,NO,NO), 0, 8))
*MessageBox(Val(DC:88))
    ELSE
        ***---USD a ARP
        ACN(DC:88, (Val(MN:1) * CotizacionBNA(Val(ES:99),Val(FH:1),1,NO,NO)) - (Val(MN:1) * CotizacionBNA(Val(ES:99),Val(FD:1),1,NO,NO)))
    ENDIF
ELSE
    ***---Uruguayo
    IF Eqstr(Val(MI:1), Val(ME:1))
        ***---UYU a USD
        ACN(DC:88, (Val(MN:1) / CotizacionBCU(Val(MI:1),Val(FH:1),1,NO,NO)) - (Val(MN:1) / CotizacionBCU(Val(MI:1),Val(FD:1),1,NO,NO)))
    ELSE
        ***---UYU a ARP
        ACN(DC:88, (Val(MN:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),1,NO,NO)) - (Val(MN:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),1,NO,NO)))
IF Val(DY:1) = 1
*MessageBox(Val(MN:1))
*MessageBox(Fstr(CotizacionBNABCU(Val(ME:1),Val(FH:1),1,NO,NO), 0, 8))
*MessageBox(Fstr(CotizacionBNABCU(Val(ME:1),Val(FD:1),1,NO,NO), 0, 8))
*MessageBox(Val(FD:1))
*MessageBox(Val(FH:1))
ENDIF
    ENDIF
ENDIF