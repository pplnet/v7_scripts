* * MessageBox('----- Posiciones Contado ') 
* Para Todos los Saldos
* Buscar la ultima posicion contado antes de la fecha de corte Para el Consolidado
* x3: Nro.Saldo
* MessageBox('EN DIVIPOSIC')
* MessageBox('1')
ACD(x1, SQL("Select Max(Fecha) From "~DBO~".POSICIONES Where Especie='"~Dialogo.Especie1~"' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and NrSaldo="~Fstr(VAL(x3),0,0)~" ") )

* MessageBox('2')

SQL.ADD("Select P.CantidadFin, P.PrecioFin, P.Cliente, P.NrSaldo, P.Book, P.Vehiculo ")
SQL.ADD("  From "~DBO~".POSICIONES P ")
SQL.ADD(" Where Especie     = '"~Dialogo.Especie1~"' ")
SQL.ADD("   and NrSaldo     = "~Fstr(VAL(x3),0,0)~" ") 
SQL.ADD("   and CantidadFin <> 0 ")
SQL.ADD("   and Fecha = (Select Max(Fecha) From "~DBO~".POSICIONES P1 ")
SQL.ADD("                 Where P1.Especie  = P.Especie ")
SQL.ADD("                   and P1.NrSaldo  = P.NrSaldo ")
SQL.ADD("                   and P1.Vehiculo = P.Vehiculo ")
SQL.ADD("                   and Book        = P.Book ")
SQL.ADD("                   and P1.Fecha   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("               ) ")
Recorrer SQL
     Message("Verificando Posiciones NrSaldo= "~Fstr(VAL(x3),0,0))

*     ACN(z1,FBN['CantidadFin'])
     ACN(z:fac,FBN['PrecioFin'])

     act(a:fac,fbn['Cliente'])
     act(b:fac,'POSICION')
     act(c:fac,fbn['Vehiculo'] )
     acn(d:fac,FBN['CantidadFin'])

     acn(n:fac,FBN['NrSaldo'])
     act(l:fac,fbn['Book'])

     *-- Calculo los Nuevos Montos en Efectivo y Acciones
  
     *-- e: Monto en Efectivo 
     *-- f: Monto en Acciones 
     *-- g: Precio Nuevo 
     *-- g: Precio 
     *-- h:TotalBrutoCli1

     acn(e:fac,val(d:fac)*(Dialogo.Precio1/100))    

     acn(m:fac,VAL(z:fac)-(Dialogo.Precio1/100))    

     acn(h:fac,val(d:fac)*VAL(m:fac))

     *-- Calculo el Dividendo en Acciones.
     acn(f:fac,val(d:fac)*(Dialogo.Precio2/100))

     *-- Calculo el Nuevo Precio
     acn(g:fac,VAL(h:fac)/(val(d:fac)+VAL(f:fac)))       

     *-- Precio Accion
     ACT(aa:fac, BuscarCampo('ESPECIES','Cotiza','Codigo',Dialogo.Especie1))
     if fbn('NrSaldo')=120 o fbn('NrSaldo')=130
       if fbn('NrSaldo')=120
         ACN(ab:FAC, Dialogo.Precio6*CotizacionC(Val(aa:FAC),,,,Dialogo.Fecha1-1,1,SI,'ARP'))
       else
         ACN(ab:FAC, Dialogo.Precio6*CotizacionC(Val(aa:FAC),,,,Dialogo.Fecha1-1,1,SI,'USD'))
       endif
     else
       ACN(ab:FAC, 0)
     endif
     if Val(x3)=110 o Val(x3)=210
       ACT(ac:FAC, '0')
     endif
     if Val(x3)=111 o Val(x3)=211
       ACT(ac:FAC, '1')
     endif
     if Val(x3)=112 o Val(x3)=212
       ACT(ac:FAC, '2')
     endif
     if Val(x3)=113 o Val(x3)=213
       ACT(ac:FAC, '3')
     endif

     *** Calcula importes de dividendos ***
     (.'CALCDIVI2'.)

     FormatoCeldas(g:fac..g:fac,Exe('F8'))
     FormatoCeldas(m:fac..m:fac,Exe('F8'))
     FormatoCeldas(z:fac..ab:fac,Exe('F8'))
     * Actualizo los Movimientos de Posicion (OJO FC. ACDIVIPOSI)
     if Dialogo.Check5=1
       (.'ACDIVIPOSI'.)
     endif
Proximo
