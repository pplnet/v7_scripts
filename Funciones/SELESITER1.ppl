****** toma las operaciones con Anulacion  en cero ******

acn(li1,Fac+1)
acn(li2,Fac)

SQL.ADD("Select M.Cliente, M.Cuenta, M.Especie, Sum(M.Cantidad) as Cant ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS C ")
SQL.ADD("where M.Cuenta = C.Codigo ")
SQL.ADD(" and  C.TipoCuenta IN ('CA','CC') ")
SQL.ADD(" and  M.Mercado = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and  M.FechaMov between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and  M.Cantidad > 0 ")
SQL.ADD("group by M.Cliente, M.Cuenta, M.Especie ")
SQL.ADD("order by M.Cliente  ")

act(u1,' ')
recorrer SQL

if Not DesciendeDeCliente(FBN['Cliente'],EXE('SITERDESC'))
   if FBN['Cant'] >= Dialogo.Cantidad1

       SCN(li2,1)  
       ACT(cx1,FBN['Cuenta'])

       SQL.ADD("Select * from "~DBO~".CLIENTES where Codigo = '"~fbn['Cliente']~"' ")

       Recorrer SQL
           
          if Eqstr(fbn['Codigo'],'ROU')
             act(aa:Val(li2),'13078')
          else
             if Eqstr(fbn['Codigo'],'BOLSA')
                act(aa:Val(li2),'935')
             else
                if Eqstr(fbn['Codigo'],'MBASA')
                   act(aa:Val(li2),'1671')
                else               
                   if Eqstr(fbn['Codigo'],'PEQ')
                      act(aa:Val(li2),'478')
                   else
                      if Eqstr(fbn['Codigo'],'ASSET')
                         act(aa:Val(li2),'787')
                      else
                         act(aa:Val(li2),fbn['Codigo'])
                      endif
                   endif
                endif
             endif
          endif
 
          act(ab:Val(li2),fbn['RazonSocial'])
          act(ac:Val(li2),fbn['TipoDocum'])
          act(ad:Val(li2),fbn['NrDocum'])
          act(ae:Val(li2),fbn['CUIT'])
          act(af:Val(li2),fbn['Direccion'])
          act(ag:Val(li2),fbn['Localidad'])
          act(ah:Val(li2),fbn['Provincia'])
          act(ai:Val(li2),fbn['CodigoPostal'])
          act(aj:Val(li2),fbn['Persona'])

          act(ao:Val(li2),fbn['TipoInscripcion'])

          act(ar:Val(li2),fbn['PaisDir'])
          act(as:Val(li2),fbn['Autonomo'])
          act(at:Val(li2),fbn['PresentaDoc'])
          acd(au:Val(li2),BuscarCampo('Cuentas','FechaApertura','Codigo',Val(cx1)) )

       Proximo


       SQL.ADD("Select Count(*) as CCli   from "~DBO~".INTEGRANTESCLI where Codigo = '"~fbn['Cliente']~"' ")

       Recorrer SQL
          Acn(ak:Val(li2),fbn['CCli']+1)
       Proximo
   
     ACT(u1, FBN['Cliente'])
     scn(al:Val(li2),fbn['Cant'])
     act(ap:Val(li2),fbn['Cuenta'])           

     act(av:Val(li2),BuscarCampo('Cuentas','TipoCuenta','Codigo',Val(cx1)) )

     if Eqstr(FBN['Especie'],'ARP')
        act(aq:Val(li2),'P')
     else
        act(aq:Val(li2),'D')
     endif

  endif
endif

proximo
