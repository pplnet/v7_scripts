acn(o:fac,val(j:fac)*((FBN['Spread']+val(l:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1) )

* IVA
acn(q:fac,IIF(FBN['RB6']=1,0,(val(j:fac)*(val(av:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)*FBN['ImpGastos2']/100))
* WTH
acn(p:fac,IIF(FBN['RB6']=0,0,(val(j:fac)*(val(aw:fac))/100)*FACTORDIAS(FBN['FechaOp'],FBN['FechaVto'],FBN['RB8']+1)*FBN['TotalAux1']/100))

acn(z:fac,(val(j:fac)+val(o:fac)))
acn(v:fac,val(o:fac)*FBN['TasaImp1']/100 )
acn(ab:fac,val(o:fac)+val(p:fac)+val(v:fac))
acn(aa:fac,val(j:fac)+val(ab:fac))

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio4')

