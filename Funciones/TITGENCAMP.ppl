let &valorResidual 0
let &valorContable 0
let &valorContadoValuado 0

let &cotiza Val(EC:1)
let &especie Val(ES:1)
let &fechaRevaluo val(FV:1)
let &book val(BK:1)

let &nrCupon NrCupon2(&especie,val(FV:1))
let &tipoCupon SQL("Select TipoCupon from "~DBO~".AGENDACUPONES where NrCupon = '"~Fstr(&nrCupon, 0, 0)~"' AND Especie = '"~&especie~"' ") 

**TipoCupon
**1=Amort, 2 = Renta, 3 = Amort e renta, 0= Otros
If EqStr(&tipoCupon,'AMO')
   let &tipoCupon 1
Else
   If EqStr(&tipoCupon,'REN')
      let &tipoCupon 2
   Else
       If EqStr(&tipoCupon,'RYA')
          let &tipoCupon 3
       Else
          let &tipoCupon 0
       EndIf  
   EndIf
EndIf

**Si es una cuenta de interes informo en 0
let &valorContable val(CA:1)  

let &valorResidual iif(Val(VT:1) <> 0, Val(VT:1),1) *&valorContable

let &cotiNiif CotizacionNIIF(&especie, val(FV:1), &book)

IF Vacio(&cotiNiif)
   let &precioNiif 0
ELSE
   let &precioNiif &cotiNiif.PrecioCotizacionDeterminada
ENDIF
**--Si no hay cotizacion NIIF hacemos lo mismo que POSICO
ACN(CO:1,COTIZACION(&especie,,,,val(FV:1),1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',&especie),,,,val(FV:1),25,SI,'ARP'))

if  &precioNiif=0
  let &precioNiif Val(CO:1)
endif

IF Not Eqstr(&cotiza, val(ML:1))
   let &monedaAConvertir &cotiza
   let &monedaExpresion val(ML:1)
   let &valorContableValuado  &valorContable * &precioNiif * #TCCONTABREVAL
ELSE
   let &valorContableValuado &valorContable * &precioNiif
ENDIF
**No sumamos mas los revaluos
**let &valorContadoValuado &valorContadoValuado + Val(RT:1)
*let &valorContadoValuado &valorContadoValuado
       
let &especieDeCorte val(ES:1)

let &informaFecInc 'SI'