
Message('Reseteando Precio Fin de Posicion por Rescate ... ')
SQL.ADD("SELECT R.* FROM "~DBO~".POSICIONES R      ")
SQL.ADD("WHERE R.CantidadFin<> 0                    ")
SQL.ADD("AND   R.Especie  = '"~Val(er:1)~"'  ")
SQL.ADD("AND   R.Cupon    = '"~FSTR(VAL(c2),1,0)~"' ")
SQL.ADD("AND   R.NrSaldo  IN (172,171)              ")
If Val(cr:2)=1
   * Es actualizacion
   SQL.ADD("AND ( (R.PrecioReset  IS NULL) OR ")
   SQL.ADD("      (R.PrecioReset  IS NOT NULL AND R.PrecioReset <> "~fstr(Val(cr:1),0,8)~")) ")
Else
   * Es anulacion de actualizacion
   SQL.ADD("AND R.PrecioReset IS NOT NULL AND R.PrecioReset <> 0  ")
Endif
SQL.ADD("AND   R.Fecha  <= '"~IdxDate(Val(fr:1))~"' ")
SQL.ADD(" AND R.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES ")
SQL.ADD("                   WHERE  Especie  = R.Especie  ")
SQL.ADD("                   AND    Vehiculo = R.Vehiculo ")
SQL.ADD("                   AND    NrSaldo  = R.NrSaldo  ")
SQL.ADD("                   AND    Cliente  = R.Cliente  ")
SQL.ADD("                   AND    Book     = R.Book     ")
SQL.ADD("                   AND   (R.Cupon    = Cupon    OR ((R.Cupon    IS NULL OR R.Cupon   ='' OR R.Cupon   =' ') AND (Cupon    IS NULL OR Cupon   ='' OR Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (R.Sector   = Sector   OR ((R.Sector   IS NULL OR R.Sector  ='' OR R.Sector  =' ') AND (Sector   IS NULL OR Sector  ='' OR Sector  =' ' )) )  ")
SQL.ADD("                   AND   (R.CallPut  = CallPut  OR ((R.CallPut  IS NULL OR R.CallPut ='' OR R.CallPut =' ') AND (CallPut  IS NULL OR CallPut ='' OR CallPut =' ' )) )  ")
SQL.ADD("                   AND   (R.FechaEj  = FechaEj  OR ((R.FechaEj  IS NULL OR R.FechaEj ='' OR R.FechaEj =' ') AND (FechaEj  IS NULL OR FechaEj ='' OR FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (R.PrecioEj = PrecioEj OR ((R.PrecioEj IS NULL OR R.PrecioEj='' OR R.PrecioEj=' ') AND (PrecioEj IS NULL OR PrecioEj='' OR PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   Fecha       <= "~idxdate2(Val(fr:1))~" ) ")
Recorrer SQL
   *** si Existe la posicion se modifica el campo de reseteo ***
   IF FBN['Fecha'] = Val(fr:1)
*messagebox('update')
      SQL.ADD("UPDATE "~DBO~".POSICIONES ")
      SQL.ADD("SET   PrecioReset = "~FStr(Val(cr:1),0,8)~" ")
      SQL.ADD("WHERE Vehiculo    = '"~FBN['Vehiculo']~"' AND ")
      SQL.ADD("      TipoNegocio = '"~FBN['TipoNegocio']~"' AND ")
      SQL.ADD("      Cliente     = '"~FBN['Cliente']~"' AND ")
      SQL.ADD("      Especie     = '"~FBN['Especie']~"' AND ")
      SQL.ADD("      Cupon       = '"~FBN['Cupon']~"' AND ")
*      IF NoVacio(FBN['FechaEj'])
*         SQL.ADD("   FechaEj     = "~IdxDate2(FBN['FechaEj'])~" AND ")
*      ENDIF
*      IF NoVacio(FBN['PrecioEj'])
*         SQL.ADD("   PrecioEj    = "~FBN['PrecioEj']~" AND ")
*      ENDIF
      SQL.ADD("      NrSaldo     = "~FStr(FBN['NrSaldo'],0,0)~"  AND ")
      SQL.ADD("      Book        = '"~FBN['Book']~"'             AND ")
      SQL.ADD("      Fecha       = '"~IdxDate(Val(fr:1))~"' AND ")
      SQL.ADD("      IsNull(Unidad,'') = '"~FBN['Unidad']~"'     AND ")
      SQL.ADD("      IsNull(Centro,'') = '"~FBN['Centro']~"'     AND ")
      SQL.ADD("      IsNull(Sector,'') = '"~FBN['Sector']~"'     AND ")
      SQL.ADD("      IsNull(Sucursal,'') = '"~FBN['Sucursal']~"' AND ")
      SQL.ADD("      IsNull(CallPut,'') = '"~FBN['CallPut']~"'   AND ")
      SQL.ADD("      IsNull(Estrategia,'') = '"~FBN['Estrategia']~"' AND ")
      SQL.ADD("      IsNull(Cartera,'') = '"~FBN['Cartera']~"'       AND ")
      SQL.ADD("      IsNull(Trader,'') = '"~FBN['Trader']~"'         AND ")
      SQL.ADD("      IsNull(Responsable,'') = '"~FBN['Responsable']~"'   AND ")
      SQL.ADD("      IsNull(TipoPosicion,'') = '"~FBN['TipoPosicion']~"' AND ")
      SQL.ADD("      IsNull(Producto,'') = '"~FBN['Producto']~"'         AND ")
      SQL.ADD("      IsNull(GrupoEspecie,'') = '"~FBN['GrupoEspecie']~"' AND ")
      SQL.ADD("      IsNull(CarteraBCRA,'') = '"~FBN['CarteraBCRA']~"' ")
      SQL.NEW
      SQL.EXEC
   ELSE
*messagebox('insert')
      SQL.ADD("INSERT "~DBO~".POSICIONES ( ")
      SQL.ADD("Fecha, Cliente, Vehiculo, Unidad, Centro, ")
      SQL.ADD("Sector, Sucursal, NrSaldo, Especie, PrecioEj, ")
      SQL.ADD("FechaEj, CallPut, Precio1, Precio2, ValorUSD, ")
      SQL.ADD("ValorARP, Estrategia, Cartera, Book, Trader, ")
      SQL.ADD("TipoNegocio, Cantidad1, Cantidad2, Cantidad3, Cantidad4, ")
      SQL.ADD("Cantidad5, Precio3, Precio4, Precio5, CantidadIni, ")
      SQL.ADD("PrecioIni, CantidadFin, PrecioFin, Cupon, Responsable, ")
      SQL.ADD("TipoPosicion, Producto, GrupoEspecie, CarteraBCRA, ")
      SQL.ADD("PrecioHist, PrecioReset) ")
      SQL.ADD("Values ( ") 
      SQL.ADD("'"~IdxDate(Val(fr:1))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', '"~FBN['Unidad']~"', '"~FBN['Centro']~"', ")
      SQL.ADD("   '"~FBN['Sector']~"', '"~FBN['Sucursal']~"', "~FStr(FBN['NrSaldo'],0,0)~", '"~FBN['Especie']~"', ")
*      IF NoVacio(FBN['PrecioEj'])
         SQL.ADD("NULL, ")
*      ELSE
*         SQL.ADD(""~FStr(FBN['PrecioEj'],15,8)~", ")
*      ENDIF
*      IF Vacio(FBN['FechaEj'])
         SQL.ADD("NULL, ")
*      ELSE
*         SQL.ADD("'"~IdxDate(FBN('FechaEj'))~"', ")
*      ENDIF
      SQL.ADD("   '"~FBN['CallPut']~"', 0, 0, 0, ")
      SQL.ADD("   0, '"~FBN['Estrategia']~"', '"~FBN['Cartera']~"', '"~FBN['Book']~"', '"~FBN['Trader']~"', ")
      SQL.ADD("   '"~FBN['TipoNegocio']~"', 0, 0, 0, 0, ")
      SQL.ADD("   0, 0, 0, 0, "~FStr(FBN['CantidadFin'],0,10)~", ")
      SQL.ADD("   "~FStr(FBN['PrecioFin'],0,10)~", "~FStr(FBN['CantidadFin'],0,10)~", "~FStr(FBN['PrecioFin'],0,10)~", '"~FBN['Cupon']~"', '"~FBN['Responsable']~"', ")
      SQL.ADD("   '"~FBN['TipoPosicion']~"', '"~FBN['Producto']~"', '"~FBN['GrupoEspecie']~"', '"~FBN['CarteraBCRA']~"', ")
      SQL.ADD("   "~FStr(FBN['PrecioHist'],0,10)~", "~FStr(Val(cr:1),0,10)~") ")
      SQL.NEW
      SQL.EXEC
   ENDIF    

   SQL.ADD("EXEC "~DBO~".RecalculaPosiciones ")
   SQL.ADD(IdxDate2(Val(fr:1))~", ")
   SQL.ADD(" '"~FBN['Cliente']~"', ")
   SQL.ADD(" '"~FBN['Vehiculo']~"', ")
   SQL.ADD(" '"~FBN['Unidad']~"', ")
   SQL.ADD(" '"~FBN['Centro']~"', ")
   SQL.ADD(" '"~FBN['Sector']~"', ")
   SQL.ADD(" '"~FBN['Sucursal']~"', ")
   SQL.ADD(" "~Fstr(FBN['NrSaldo'],3,0)~", ")
   SQL.ADD(" '"~FBN['Especie']~"', ")
*   If FBN['PrecioEj']=0
      SQL.ADD(" NULL,")
*   Else
*      SQL.ADD(" "~Fstr(FBN['PrecioEj'],15,8)~", ")
*   Endif
*   If Vacio(FBN['FechaEj'])
      SQL.ADD(" NULL,")
*   Else
*      SQL.ADD(" "~IdxDate2(FBN['FechaEj'])~", ")
*   Endif
   SQL.ADD(" '"~FBN['CallPut']~"', ")
   SQL.ADD(" '"~FBN['Cupon']~"', ")
   SQL.ADD(" '"~FBN['Estrategia']~"', ")
   SQL.ADD(" '"~FBN['Cartera']~"', ")
   SQL.ADD(" '"~FBN['Book']~"', ")
   SQL.ADD(" '"~FBN['Trader']~"', ")
   SQL.ADD(" '"~FBN['TipoNegocio']~"', ")
   SQL.ADD(" '"~FBN['Responsable']~"', ")
   SQL.ADD(" '"~FBN['TipoPosicion']~"', ")
   SQL.ADD(" '"~FBN['Producto']~"', ")
   SQL.ADD(" '"~FBN['GrupoEspecie']~"', ")
   SQL.ADD(" '"~FBN['CarteraBCRA']~"' ")
   SQL.NEW
   SQL.EXEC
Proximo
