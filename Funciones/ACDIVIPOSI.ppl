**- Se genera el Mov. Posicion por la Especie no por la Moneda
IF val(af:fac)>=0 

   Message('Generando Operacion de Dividendo por Posiciones '~VAL(b:fac)~' '~FStr(VAL(n:fac),0,0))

   ACT(Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Val(c:fac)) ) ) 

   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
   SQL.ADD("(TipoOp, MB3, NrOperacion, ")
   SQL.ADD(" Especie, ContraEspecie, Cliente1,")
   SQL.ADD(" Cantidad, TotalBrutoCli1, ")
   SQL.ADD(" FechaOp, FechaPago, FechaCargaSys, FechaCarga,")
   SQL.ADD(" Vehiculo1, ")
   SQL.ADD(" Precio1, Precio2, ")
   SQL.ADD(" Spread, MB4,TipoCambio3,")
   SQL.ADD(" RB1,RB2,Precio3,RB3, Book1,CB7, UsrInput, Operador) ")
   SQL.ADD("Values")
   SQL.ADD(" ('DIVIDE','0', '"~Val(Z3)~"', ")
   SQL.ADD(" '"~Dialogo.Especie1~"', '"~Dialogo.Especie2~"', '"~val(a:fac)~"', ")
   SQL.ADD(" "~FStr(Val(d:fac),0,4)~", "~FStr(Val(af:fac),0,4)~", ")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~IdxDate(FSYS)~"', "~SQLAhora~", ")
   SQL.ADD(" '"~VAL(c:fac)~"', ")
   SQL.ADD(" "~FStr(Dialogo.Precio1,0,7)~", "~FStr(Dialogo.Precio2,0,7)~", ")
   SQL.ADD(" "~FStr(val(g:fac),0,7)~",'1',"~FStr(VAL(n:fac),0,0)~", ")
   SQL.ADD(" '"~FStr(Dialogo.Check1,0,0)~"', '"~FStr(Dialogo.Check2,0,0)~"',"~FStr(VAL(z:fac),0,7)~",'1', '"~val(l:fac)~"','0', '"~UsuarioActivo~"', '"~UsuarioActivo~"')  ")
   SQL.NEW
   SQL.EXEC

