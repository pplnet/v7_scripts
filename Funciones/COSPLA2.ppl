Recorrer&j 2, Val(ZC:1)
    ***---Bajo la cotizacion cargada en el dialogo
    IF Eqstr(ItemLista(Val(LS:100), &i), Val(ZG:&j))
        ACN(CT:1, Val(ZB:&j))
    ENDIF
    IF Eqstr(ItemLista(Val(LS:100), &i), Var('MONEEXTR'))
        ACN(CT:1, 1)
    ENDIF
Proximo
