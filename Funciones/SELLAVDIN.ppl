*- Parametros de Entrada ca1: Campos or1: Order By
SQL.ADD("SELECT "~val(ca1)~" ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O INNER JOIN  "~DBO~".CLIENTES C ON O.Cliente1=C.Codigo ")
SQL.ADD("                             INNER JOIN  "~DBO~".ESPECIES E ON E.Codigo  =O.Especie ")
SQL.ADD("                             INNER JOIN  "~DBO~".OPERACIONESBITS B ON O.NrOperacion=B.NrOperacion  ")
SQL.ADD("WHERE  O.TipoOp in ('TIC','TIFC','TIV','TIFV') ")
SQL.ADD("       and (E.Tipo='PRI' or E.Tipo='PUB') ")
SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null) and C.CategDepositante='CLI' and C.Codigo<>'"~VAR('CLIGLOB')~"' ")
SQL.ADD("       and O.FechaOp >= "~IdxDate2(Dialogo.Fecha1)~" and O.FechaOp<="~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("       and B.Valor=0 and B.NrBit=30 ")
SQL.ADD("UNION")
SQL.ADD("SELECT "~val(ca1)~" ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O INNER JOIN  "~DBO~".CLIENTES C ON O.Cliente1=C.Codigo ")
SQL.ADD("                             INNER JOIN  "~DBO~".ESPECIES E ON E.Codigo  =O.Especie ")
SQL.ADD("                             INNER JOIN  "~DBO~".OPERACIONESBITS B ON O.NrOperacion=B.NrOperacion  ")
SQL.ADD("WHERE  O.TipoOp in ('CTP','CFTP','CTC','VTP','VFTP','VTC') ")
SQL.ADD("       and (E.Tipo='PRI' or E.Tipo='PUB') ")
SQL.ADD("       and (C.Alias1 <> 'CP' or C.Alias1 is Null) and C.CategDepositante='CLI' and C.Codigo<>'"~VAR('CLIGLOB')~"' ")
SQL.ADD("       and O.FechaOp >= "~IdxDate2(Dialogo.Fecha1)~" and O.FechaOp<="~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("       and B.Valor=0 and B.NrBit=30 ")
SQL.ADD("ORDER BY "~val(or1)~"  ")

