ACN(fa1, Val(fi2)+5)
ACN(fa2, Val(fi4))

*- Inicializo 
ACT(es1, '')
ACN(fo1, 0)
ACN(fo2, 0)
ACN(fo3, 0)
ACN(fo4, 0)
ACN(fo5, 0)
ACN(fo6, 0)
ACN(fo7, 0)

SQL.ADD("SELECT Distinct O.Especie, O.Cantidad  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMDCA') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT Distinct O.Especie, 0 Cantidad  ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMDCA') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD("ORDER BY  1 ")


Recorrer SQL   
   *- Impresion de totales por especie
   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
      (.'TOTALRESUA'.)
      ACN(fo1,0)
   EndIf

   *- Corte de Control Por Especie para invocar al Informe
   IF Not EqStr(val(es1),FBN['Especie'])
      ACT(es1,FBN['Especie'])

      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      *- Los intereses devengados los muestra solamente en el Corto
      If Dialogo.Radio2<>1      
         LinkearHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['Especie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=5, Lista2 = 'MMDCA')
            
         *- fo2: Interes  fo3:Tasa Promedio fo4:Plazo Promedio 
          
         ACN(fo2,LinkH(1,fo2))
           
         ACN(fo3,0)
         ACN(fo4,0)

         *- Solo debe mostrar la tasa y el plazo promedio en el Corto+Largo
         If Dialogo.Radio2 = 2   
            ACN(fo3,LinkH(1,fo1)*LinkH(1,fo3))
            ACN(fo4,LinkH(1,fo1)*LinkH(1,fo4))
         Endif
        
         CerrarHoja('INVFO1', 1, Fecha1=Dialogo.Fecha1, Lista1=Dialogo.Lista1, Especie1=FBN['Especie'], Radio2=val(ra2),Precio1=val(pr1), Especie2=IIF(val(ra2)=0,'ARP','USD'), Radio3=5, Lista2 = 'MMDCA')
      Endif

   EndIf

   SCN(fo1,FBN['Cantidad']*Val(pr1))
Proximo

If NoVacio(val(es1))
   (.'TOTALRESUA'.)
   ACN(fo1,0)

   (.'TOTALRES2A'.)
EndIf


