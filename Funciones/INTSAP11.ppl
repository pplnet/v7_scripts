***La primera vez que se llama a la funcion***
If Val(co:1) = 0
  ***Crear el archivo para guardar los datos, si ya existe borrarlo***
  If ExisteArchivo(Var('PATHINTCON')~'FPA-AP'~FStr(Anio(FSYS),0,0)~Pad0(FStr(Mes(FSYS),0,0),2)~Pad0(FStr(Dia(FSYS),0,0),2)~'.txt')
    MessageBox('Borrando')
    BorrarArchivo(Var('PATHINTCON')~'FPA-AP'~FStr(Anio(FSYS),0,0)~Pad0(FStr(Mes(FSYS),0,0),2)~Pad0(FStr(Dia(FSYS),0,0),2)~'.txt')
  Endif
Endif
***Se graba la linea en el archivo***
AbrirAscii(Var('PATHINTCON')~'FPA-AP'~FStr(Anio(FSYS),0,0)~Pad0(FStr(Mes(FSYS),0,0),2)~Pad0(FStr(Dia(FSYS),0,0),2)~'.txt',0,SI,1)
EscribirAscii(Val(li:1))
CerrarAscii