ACD(fz2,SQL("Select Max(FechaMov) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov<="~IdxDate2(val(z2))~" and NrSaldo = 140 and Cantidad>0 "))
