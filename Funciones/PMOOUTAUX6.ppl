*** IVANORCOM
ACD(fz10,SQL("Select Max(FechaMov) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov<="~IdxDate2(val(z2))~" and NrSaldo = 181 and Cantidad>0 "))
if val(fz10)>0
  ACN(cj:val(xx1),SQL("Select Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz10))~" and NrSaldo = 181 "))
  SCN(cj:val(xx1),SQL("Select -Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz10))~" and NrSaldo = 81 "))
else
*  ACN(cj:val(xx1),Round(FBN['Cantidad13'],2))
  ACN(cj:val(xx1),0)
endif
*** IVAADICOM
ACD(fz11,SQL("Select Max(FechaMov) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov<="~IdxDate2(val(z2))~" and NrSaldo = 182 and Cantidad>0 "))
if val(fz11)>0
  ACN(ck:val(xx1),SQL("Select Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz11))~" and NrSaldo = 182 "))
  SCN(ck:val(xx1),SQL("Select -Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz11))~" and NrSaldo = 82 "))
else
*  ACN(ck:val(xx1),Round(FBN['Cantidad14'],2))
  ACN(ck:val(xx1),0)
endif
*** IVAPERCOM
ACD(fz12,SQL("Select Max(FechaMov) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov<="~IdxDate2(val(z2))~" and NrSaldo = 183 and Cantidad>0 "))
if val(fz12)>0
  ACN(cl:val(xx1),SQL("Select Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz12))~" and NrSaldo = 183 "))
  SCN(cl:val(xx1),SQL("Select -Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz12))~" and NrSaldo = 83 "))
else
*  ACN(cl:val(xx1),Round(FBN['Cantidad15'],2))
  ACN(cl:val(xx1),0)
endif

if val(z2) < val(cw:val(xx1)) 
     *** INTERES NORMAL DEL PERIODO ***
     ACN(gg:val(xx1),Round(val(ct:val(xx1))*val(cu:val(xx1))*iif(val(z2)>val(cy:val(xx1)),val(z2)-val(cy:val(xx1)),0)/val(g1),2))     

     *** COMISION
     if val(t1)=2 y val(u1)=1
        ACN(na:val(xx1),Round(val(ct:val(xx1))*iif(val(z2)>val(cy:val(xx1)),val(z2)-val(cy:val(xx1)),0)*val(v1)/val(g1),2))
     else
        ACN(na:val(xx1),val(cq:val(xx1))) 
     endif

     *** IVA ****
     if Not[Eqstr(val(p1),'INGCURA')] 

       *--- IVA / INTERES NORMAL
       ACN(pm1,val(gg:val(xx1)))
       ACN(pf1,val(z2))
       ACT(pt1,'INT')
       (.'CANPREIVA'.)
       ACN(ga:val(xx1),val(pr1))
       ACN(gb:val(xx1),val(pr2))
       ACN(gc:val(xx1),val(pr3))

       *--- IVA / COMISION
       ACN(pm1,val(na:val(xx1)))
       ACN(pf1,val(z2))
       ACT(pt1,'COM')
       (.'CANPREIVA'.)
       ACN(nb:val(xx1),val(pr1))
       ACN(nc:val(xx1),val(pr2))
       ACN(nd:val(xx1),val(pr3))
  
     endif    
     *--- FIN IVA

   *** TOTAL IVANORINT
   ACN(ha:val(xx1),Round(val(ga:val(xx1))+val(nb:val(xx1)),2))
   
   *** TOTAL IVAADIINT
   ACN(hb:val(xx1),Round(val(gb:val(xx1))+val(nc:val(xx1)),2))

   *** TOTAL IVAPERINT
   ACN(hc:val(xx1),Round(val(gc:val(xx1))+val(nd:val(xx1)),2))

   ACN(mm:val(xx1),Round(val(ca:val(xx1))+val(gg:val(xx1))+val(da:val(xx1))+val(db:val(xx1))+val(na:val(xx1))+val(ha:val(xx1))+val(hb:val(xx1))+val(hc:val(xx1)),2))
 
   if Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')
      ACN(mm:val(xx1),Round(val(mm:val(xx1))-val(ca:val(xx1)),2))
   endif

   SCN(xx2,Round(val(mm:val(xx1)),2))

else

   *** INTERES NORMAL DEL PERIODO ***
   ACN(gg:val(xx1),Round(val(ch:val(xx1)),2))

   if val(cv:val(xx1)) > 0
     ACN(pp:val(xx1),val(z2)-val(cv:val(xx1)))
   else
     ACN(pp:val(xx1),val(z2)-val(cw:val(xx1)))
   endif

   *** INTERES COMPENSATORIO DEL PERIODO ***
   ACN(da:val(xx1),Round(val(ca:val(xx1))*val(cu:val(xx1))*val(pp:val(xx1))/val(g1),2))

   *** COMISION
   ACN(na:val(xx1),val(cq:val(xx1))) 

   *** COMISION COMPENSATORIA
   if val(t1)=2 y val(u1)=1 y Not[Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')]
     *04/03/2004 Se solicito no calcular la Comision Compensatoria
     *ACN(nh:val(xx1),Round(val(ca:val(xx1))*val(pp:val(xx1))*val(v1)/val(g1),2))
     ACN(nh:val(xx1),0)
   else
     ACN(nh:val(xx1),0)
   endif

   *** Si es el primer pago recalculo el IVA sobre los Int. Normales y las Comisiones
   *** usando la tasa a la Fecha Vto.

   *** IVA ****
   if Not[Eqstr(val(p1),'INGCURA')] 

     if val(cv:val(xx1)) > 0
         ACN(ga:val(xx1),val(ce:val(xx1)))
         ACN(gb:val(xx1),val(cf:val(xx1)))
         ACN(gc:val(xx1),val(cg:val(xx1)))

         ACN(nb:val(xx1),val(cj:val(xx1)))
         ACN(nc:val(xx1),val(ck:val(xx1)))
         ACN(nd:val(xx1),val(cl:val(xx1)))
     else
         *--- IVA / INTERES NORMAL
         ACN(pm1,val(gg:val(xx1)))
         ACN(pf1,val(cw:val(xx1)))
         ACT(pt1,'INT')
         (.'CANPREIVA'.)
         ACN(ga:val(xx1),val(pr1))
         ACN(gb:val(xx1),val(pr2))
         ACN(gc:val(xx1),val(pr3))

         *--- IVA / COMISION
         ACN(pm1,val(na:val(xx1)))
         ACN(pf1,val(cw:val(xx1)))
         ACT(pt1,'COM')
         (.'CANPREIVA'.)
         ACN(nb:val(xx1),val(pr1))
         ACN(nc:val(xx1),val(pr2))
         ACN(nd:val(xx1),val(pr3))
     endif
   endif

   *** INTERES PUNITORIO DEL PERIODO ***
   *** CAPITAL + INT.NORMAL + SALDO IMPUESTOS + SALDO COMISION + SALDO INT.PUNITORIO
   if Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')
     ACN(db:val(xx1),Round((val(nb:val(xx1))+val(nc:val(xx1))+val(nd:val(xx1))+val(na:val(xx1)))*val(h1)*val(pp:val(xx1))/val(g1),2))    
   else
     ACN(db:val(xx1),Round((val(ca:val(xx1))+val(gg:val(xx1))+val(ga:val(xx1))+val(gb:val(xx1))+val(gc:val(xx1))+val(nb:val(xx1))+val(nc:val(xx1))+val(nd:val(xx1))+val(na:val(xx1)))*val(h1)*val(pp:val(xx1))/val(g1),2))    
   endif
   SCN(db:val(xx1),val(cd:val(xx1)))

   if Not[Eqstr(val(p1),'INGCURA')] 
     *** IVA / INT.COMPENSATORIOS
     ACN(pm1,val(da:val(xx1)))
     ACN(pf1,val(z2))
     ACT(pt1,'INT')
     (.'CANPREIVA'.)
     ACN(ea:val(xx1),val(pr1))
     ACN(eb:val(xx1),val(pr2))
     ACN(ec:val(xx1),val(pr3))

     *** IVA / COM.COMPENSATORIA
     ACN(pm1,val(nh:val(xx1)))
     ACN(pf1,val(z2))
     ACT(pt1,'COM')
     (.'CANPREIVA'.)
     ACN(ne:val(xx1),val(pr1))
     ACN(nf:val(xx1),val(pr2))
     ACN(ng:val(xx1),val(pr3))

     *--- IVA / INTERES PUNITORIO
     ACN(pm1,val(db:val(xx1)))
     ACN(pf1,val(z2))
     ACT(pt1,'INT')
     (.'CANPREIVA'.)
     ACN(fa:val(xx1),val(pr1))
     ACN(fb:val(xx1),val(pr2))
     ACN(fc:val(xx1),val(pr3))
   endif

   *** TOTAL IVANORINT
   ACN(ha:val(xx1),Round(val(ga:val(xx1))+val(ea:val(xx1))+val(fa:val(xx1))+val(nb:val(xx1))+val(ne:val(xx1)),2))
   
   *** TOTAL IVAADIINT
   ACN(hb:val(xx1),Round(val(gb:val(xx1))+val(eb:val(xx1))+val(fb:val(xx1))+val(nc:val(xx1))+val(nf:val(xx1)),2))

   *** TOTAL IVAPERINT
   ACN(hc:val(xx1),Round(val(gc:val(xx1))+val(ec:val(xx1))+val(fc:val(xx1))+val(nd:val(xx1))+val(ng:val(xx1)),2))
   
   ACN(mm:val(xx1),Round(val(ca:val(xx1))+val(gg:val(xx1))+val(da:val(xx1))+val(db:val(xx1))+val(na:val(xx1))+val(nh:val(xx1))+val(ha:val(xx1))+val(hb:val(xx1))+val(hc:val(xx1)),2))

   if Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')
      ACN(mm:val(xx1),Round(val(mm:val(xx1))-val(ca:val(xx1)),2))
   else
      SCN(y3,val(ca:val(xx1)))
   endif

   *** TOTAL PUNITORIOS
   SCN(y6,Round(val(db:val(xx1)),2))
   SCN(y7,Round(val(fa:val(xx1))+val(fb:val(xx1))+val(fc:val(xx1)),2))

   SCN(y2,Round(val(mm:val(xx1)),2))

   SCN(xx2,Round(val(mm:val(xx1)),2))
   ACN(y1, val(xx1))
endif  

