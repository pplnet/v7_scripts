if val(fz9)>0
  ACN(cg:val(xx1),SQL("Select Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz9))~" and NrSaldo = 143 "))
  SCN(cg:val(xx1),SQL("Select -Cantidad from "~DBO~".MOVEJECUTADOS where NrOperacion='"~val(z1)~"' and NrGrupo2= "~val(cz:val(xx1))~" and FechaMov = "~IdxDate2(val(fz9))~" and NrSaldo = 43 "))
else
