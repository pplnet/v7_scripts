Recorrer&i val(xx1),val(xx1)
  ACN(ss4,1)
  (.'CANPRE8'.)
  recorrer&j 1,25
    ACN(ad:&j, val(ac:&j))
  proximo

*------ Aplico los pagos----------------------
  recorrer&j 1,25
    if val(x5)>0
      if round(val(ac:&j)-val(x5),2)<=0
        ACN(ad:&j, 0)
      else
        ACN(ad:&j, round(val(ac:&j)-val(x5),2))
      endif 
      
      ******************************************
      * Atento a la condicion para ver si es ARP
      ******************************************
      if EqStr(Copy(Val(ab:&j),1,3),'IVA')
        ACN(ae:&j, (val(ac:&j)-val(ad:&j))*Val(z6))
        ACT(af:&j, 'ARP')
        ACT(ag:&j, 'BCRA')
      else
        ACN(ae:&j, val(ac:&j)-val(ad:&j))
        ACT(af:&j, Val(a1))
        ACT(ag:&j, Val(q1))
      endif
      ACN(x5,round(val(x5)-val(ac:&j),2))
    else
      break
    endif
  proximo
Proximo