Eqstr(VAR('TESTINVCTL'),'NO') o [[DesciendedeCliente(CLIENTE1, 'CLIENTES') y [EqStr(BuscarCampo('Clientes','PerfilInv','Codigo',CLIENTE1), 'Calificado') o [eqStr(BuscarCampo('Clientes','TestInv','Codigo',CLIENTE1), "SI") y NumF(BuscarCampo('Clientes','FechaVtoTest','Codigo',CLIENTE1))+364 >= FECHAOP]]] o Not [DesciendedeCliente(CLIENTE1, 'CLIENTES')]]; "El perfil del inversor debe ser Calificado o tener un test vigente"; Not [VAR('PERFINVBLO')];SI;FSys;'TESTINV'

