Mercado         : 'Mercado Liq.'               ; 1;1;2;  ;  ;NOVACIO(MERCADO) O SI;'Debe indicar mercado';NO;'CV'
MercadoRB       : 'Ingresar|Porc.|Importe'     ; 1;2;2;  ;  ;;;;0
PorComMer1      : '% Comision'                 ; 2;1;2;NOT INCLUIDO(MERCADO,'OTC') Y MERCADORB=0;NOT INCLUIDO(MERCADO,'OTC') Y MERCADORB=0;INCLUIDO(MERCADO,'OTC') O PORCOMMER1>=0 O VACIO(MERCADO) O MERCADORB=1;'Debe INGRESAR  un % de COMISION DEL MERCADO';NO;;IF(Vacio(MERCADO) O MERCADORB=1,0,PORCOMMER1);;;;;'#####.########'
PrecioEj        : '% Merc IVA'                 ; 2;2;2;NO;NO;SI O INCLUIDO(Fstr(PRECIOEJ,2,2),VAR('IVA'));"El Valor de TASA IVA de Mercado es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,VAR('TASAIVA'));;;;'#####.#####'
ImpComMer1      : 'Imp.Comision'               ; 3;1;2;MERCADORB=1;NOT INCLUIDO(MERCADO,'OTC');;;;;(TOTALBRUTOCLI1)*(PORCOMMER1/100)
TotalGastos     : 'Importe IVA'                ; 3;2;2;NO;NO;;;;;(IMPCOMMER1)*(PRECIOEJ/100);;;;;;SI

TasaPrecan      : '% Com Aranc'                ; 5;1;2;NO;NO;;;;;;;;;;'#####.########'
TotalComisiones : 'Imp.Comision'               ; 6;1;2;NO;NO;;;;;(TOTALBRUTOCLI1)*(TASAPRECAN/100)

Corredor        : 'Corredor'                   ;5;1;2;;;SI O NOVACIO(CORREDOR);'Debe indicar un corredor';NO;
PorComCor1      : '% Comision'                 ;6;1;2;;SECTORRB=0;;;;;IF(Vacio(CORREDOR) O SECTORRB=1,0,IF(MODI O INSTANCIA=19,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR)));;;;;'#####.########';
ImpComCor1      : 'Imp.Comision'               ;7;1;2;SECTORRB=1;  ;;;;;(TOTALDERECHOS)*(PORCOMCOR1/100)

SectorRB        : 'Ingresar|Porc.|Importe'     ;5;2;2;  ;  ;;;;0
RB12            : 'U.Tiempo|360|365'           ;6;2;2;;;RB12>=0;'Unidad de Tiempo Tasa Interes INVALIDA';NO;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0);IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0)
TotalDerechos   :  'Int x Comision'            ;7;2;2;NO;;NOT EV o [TOTALINTERESES <= ROUND(VCAN7*(1+Var('PORVAR')/100),2) y TotalIntereses >= ROUND(VCAN7*(1-Var('PORVAR')/100),2)];'Interes Fuera de Rango: '~FSTR(ROUND(VCAN7*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(VCAN7*(1+Var('PORVAR')/100),2),0,2);NO;IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(TOTALBRUTOCLI1*(PRECIO1+SPREAD)*PLAZO/IF(RB12=1,36500,36000),0),TOTALBRUTOCLI1*(PRECIO1+SPREAD)*PLAZO/IF(RB12=1,36500,36000));IF(Incluido(CLIENTE1,Var('CLIRED')) Y EQSTR (ESPECIE,'USD'),ROUND(TOTALBRUTOCLI1*(PRECIO1+SPREAD)*PLAZO/IF(RB12=1,36500,36000),0),TOTALBRUTOCLI1*(PRECIO1+SPREAD)*PLAZO/IF(RB12=1,36500,36000));;;;;'###,###,###,###,###.##'
TasaImp1        : '%IVA '                      ;8;2;2;;;INCLUIDO(Fstr(TASAIMP1,2,2),VAR('IVA'));"El Valor de TASA IVA de Arancel es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA') ;IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,VAR('TASAIVA'));;;;'#####.#####'
TotalIVA        : 'Importe IVA'                ;9;2;2;NO;;;;;;(IMPCOMCOR1)*(TASAIMP1/100);;;;'#########.##';;SI
