SQL.ADD(" Select O.NrOperacion, O.Cantidad, O.Especie, O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp = 'MMCP' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~")  ")
SQL.ADD(" AND O.Especie = '"~Val(ES:5)~"' ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.NrOperacion, Sum(C.Cantidad1) Cantidad, O.Especie, O.FechaOp, O.FechaVto ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp = 'MMCPM' ")
SQL.ADD(" AND O.Especie = '"~Val(ES:5)~"' ")
SQL.ADD(" AND C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LV:4))~")  ")
SQL.ADD(" Group By O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto ")
***---SQL.ADD(" Order By 3 ")
ACN(M:fac,0)
Recorrer SQL
   DFA
   If FBN('FechaOp') >= Dialogo.Fecha1
   ***+++ Se calcula la cant de dias de vigencia que tiene la operacion dentro del periodo
      If FBN('FechaVto') >= Dialogo.Fecha2
          ACN(fh:1, Dialogo.Fecha2 - FBN('FechaOp'))
      Else
          ACN(fh:1, FBN('FechaVto') - FBN('FechaOp'))
      Endif
      IF Eqstr(Val(ES:5), Val(MI:1))
         SCN(M:fac, FBN('Cantidad') * Val(fh:1))
      Else
         SCN(M:fac, FBN('Cantidad') * Val(fh:1) * CotizacionC(Val(ES:5),,,,FBN('FechaOp'),1,SI,Val(MI:1)))
      Endif
   Else
   ***+++ Se multiplica por la cant de dias del periodo y se le suma los int. devengados de la Op hasta la fecha inicio del periodo
      SQL.ADD(" Select Sum(Monto) Monto ")
      SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
      SQL.ADD(" Where TipoDevengado = 'INTLEN' ")
      SQL.ADD(" AND NrSaldo = 140 ")
      SQL.ADD(" AND NrOperacion = '"~FBN('NrOperacion')~"'")
      SQL.ADD(" AND Fecha < '"~IdxDate(Dialogo.Fecha1)~"' ")
      ACN(DV:1,0)
      Recorrer SQL
         DFA
         ACN(DV:1, FBN('Monto'))
      Proximo
      If FBN('FechaVto') >= Dialogo.Fecha2
          ***---Tomo todos los dias del periodo
          IF Eqstr(Val(ES:5), Val(MI:1))
             ***---SCN(M:fac, (FBN('Cantidad') * Val(DS:1)) + Val(DV:1))
             SCN(M:fac, (FBN('Cantidad') + Val(DV:1)) * Val(DS:1))
          Else
             ***---SCN(M:fac, (FBN('Cantidad') * Val(DS:1)) + Val(DV:1) * CotizacionC(Val(ES:5),,,,FBN('FechaOp'),1,SI,Val(MI:1)))
             SCN(M:fac, (FBN('Cantidad') + Val(DV:1)) * Val(DS:1) * CotizacionC(Val(ES:5),,,,FBN('FechaOp'),1,SI,Val(MI:1)))
          Endif
      ELSE
          ***---Tomo solo los dias que estuvo vigente en el periodo
          ACN(FH:1, fbn('FechaVto') - Dialogo.Fecha1)
          IF Eqstr(Val(ES:5), Val(MI:1))
             ***---SCN(M:fac, (FBN('Cantidad') * Val(FH:1)) + Val(DV:1))
             SCN(M:fac, (FBN('Cantidad') + Val(DV:1)) * Val(FH:1))
          Else
             ***---SCN(M:fac, (FBN('Cantidad') * Val(FH:1)) + Val(DV:1) * CotizacionC(Val(ES:5),,,,FBN('FechaOp'),1,SI,Val(MI:1)))
             SCN(M:fac, (FBN('Cantidad') + Val(DV:1)) * Val(FH:1) * CotizacionC(Val(ES:5),,,,FBN('FechaOp'),1,SI,Val(MI:1)))
          Endif
      ENDIF
   Endif
Proximo


