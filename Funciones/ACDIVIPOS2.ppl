**- Se genera el Mov. Posicion por la Especie no por la Moneda
IF val(af:fac)>=0 
   Message('Generando Operacion de Dividendo por Posiciones '~VAL(b:fac)~' '~FStr(VAL(n:fac),0,0))

   ACT(Z3, GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Val(c:fac)) ) )

   SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ( ")
   SQL.ADD(" TipoOp,        MB3,         NrOperacion,   Especie, ")
   SQL.ADD(" ContraEspecie, Cliente1,    Cantidad,      TotalBrutoCli1, ")
   SQL.ADD(" FechaOp,       FechaPago,   FechaCargaSys, FechaCarga,")
   SQL.ADD(" Vehiculo1,     Precio1,     Precio2,       Spread, ")
   SQL.ADD(" MB4,           TipoCambio3, RB1,           RB2, ")
   SQL.ADD(" Precio3,       RB3,         Book1,         CB6, ")
   SQL.ADD(" PrecioMer,     Cupon1,      Cartera,       TotalNetoCli1 ")

   SQL.ADD(" ) Values ( ")

   * TipoOp
   SQL.ADD(" 'DIVIDE', ")
   * MB3
   SQL.ADD(" '0', ")
   * NrOperacion
   SQL.ADD(" '"~Val(Z3)~"', ")
   * Especie
   SQL.ADD(" '"~Dialogo.Especie1~"', ")

   * ContraEspecie
   SQL.ADD(" '"~Dialogo.Especie2~"', ")
   * Cliente1
   SQL.ADD(" '"~val(a:fac)~"', ")
   * Cantidad
   SQL.ADD(" "~FStr(Val(d:fac),0,4)~", ")
   * TotalBrutoCli1
   SQL.ADD(" "~FStr(Val(af:fac),0,4)~", ")

   * FechaOp
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
   * FechaPago
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"', ")
   * FechaCargaSys
   SQL.ADD(" '"~IdxDate(FSYS)~"', ")
   * FechaCarga
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")

   * Vehiculo1
   SQL.ADD(" '"~VAL(c:fac)~"', ")
   * Precio1
   SQL.ADD(" "~FStr(Dialogo.Precio1,0,7)~", ")
   * Precio2
   SQL.ADD(" "~FStr(Dialogo.Precio2,0,7)~", ")
   * Spread
   SQL.ADD(" "~FStr(val(g:fac),0,7)~", ")

   * MB4
   SQL.ADD(" '1', ")
   * Tipocambio3 (NrSaldo)
   SQL.ADD(" "~FStr(VAL(n:fac),0,0)~", ")
   * RB1 (En Efvo)
   SQL.ADD(" '"~FStr(Dialogo.Check1,0,0)~"', ")
   * RB2 (En Acciones)
   SQL.ADD(" '"~FStr(Dialogo.Check2,0,0)~"', ")

   * Precio3
   SQL.ADD(" "~FStr(VAL(z:fac),0,7)~", ")
   * RB3
   SQL.ADD(" '1', ")
   * Book1
   SQL.ADD(" '"~val(l:fac)~"', ")
   * CB6
   if Val(n:FAC)=120 o Val(n:FAC)=130
     * Posiciones Nuevas
     SQL.ADD(" '1', ")
   else
     SQL.ADD(" '0', ")
   endif

   * PrecioMer (Precio Accion)
   SQL.ADD(" "~FStr(Val(ab:fac),0,7)~", ")
   * Cupon1
   SQL.ADD(" 0, ")
   * Cartera
   if NoVacio(Val(ac:fac))
     SQL.ADD(" '"~Val(ac:fac)~"', ")
   else
     SQL.ADD(" Null, ")
   endif
   * TotalBrutoCli1
   SQL.ADD(" "~FStr(Val(al:fac),0,4)~" ")

   SQL.ADD(" ) ")
   SQL.NEW
   SQL.EXEC

   * Insert de Instancias: Recibe z3: Nro.Op.
   (.'ALTAINSTER'.)

   SQL.ActualizarMovimientos2(Val(Z3),SI,NO,NO,SI)
   SQL.EXEC

   if Val(n:FAC)=120 o Val(n:FAC)=130
     EjecutarEvento('RESDIV',Radio2=0,NrOperacion1=Val(Z3),Radio1=0,Fecha1=Dialogo.Fecha1,Check1=Dialogo.Check5)
   endif
EndIf
