ACN(m:fac,FBN['Precio4'])
acn(u:fac,IIF(FBN['RB6']=0,((val(j:fac)*FBN['OPrecio2']*FBN['Plazo1'])/IIF(FBN['RB5']=0,36000,36500)),0))
acn(t:fac,IIF(FBN['RB6']=0, FBN['Cantidad5']+val(u:fac), 0))

acn(p:fac,val(j:fac)*val(av:fac)/100*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)*(FBN['TotalAux1']/100))
acn(o:fac,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,val(j:fac)*((FBN['Precio4']+val(l:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
acn(q:fac,(val(o:fac)*(FBN['ImpGastos2']/100)))
acn(ad:fac,FBN['Cantidad7']^IIF(EqStr(FBN['Check1'],'1'),1,-1)*val(t:fac))

* Impto.Interes
acn(v:fac,IIF(FBN['RB6']=0,val(o:fac)*(FBN['TasaImp1']/100),0) )

* Iva Cen
acn(x:fac,val(t:fac)*(FBN['IntDevengados1']/100))
acn(ab:fac,val(p:fac)+val(o:fac)+val(t:fac)+val(v:fac))
acn(z:fac,val(k:fac)+val(o:fac))
acn(aa:fac,val(k:fac)+val(ab:fac))

*-- ta1: Atributo de TTN 
ACT(ta1,'Precio3')

