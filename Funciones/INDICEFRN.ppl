Indice         : 'Indice'                     ;8;2;2;;;Vacio(INDICE) o Incluido(ESPECIE,BuscarCampo('INDICES','Especie','Codigo',INDICE)) o Incluido(CONTRAESPECIE4,BuscarCampo('INDICES','Especie','Codigo',INDICE));'El Indice no esta Habilitado para la Especie '~ESPECIE;;IF(NOVACIO(OPERACIONREF),OPREF.INDICE);IF(NOVACIO(OPERACIONREF),OPREF.INDICE);;;;;;;;;;;
ContraEspecie4 : 'Esp_Ori'                    ;;2;2;NO;NoVacio(INDICE) y NoVacio(CONTRAESPECIE4) Y Not EqStr(ESPECIE,CONTRAESPECIE4);;;;ESPECIE;IF(VACIO(CONTRAESPECIE4),ESPECIE,CONTRAESPECIE4);;;;;;;;;;;
CantidadOri    : 'VN Original'                ;;2;2; ;NoVacio(INDICE) y CANTIDADORI<>0;;;;IF(COEFICIENTE=1,IF(INCLUIDO(TIPOOP,'MMFRN|MMPSC|MMSCMV|MMFCMV|'),PRECIOEJ,(TOTALBRUTOCLI2/OPREF.COEFICIENTE)),CANTIDADORI);Round(IF(Round(COEFICIENTE,8)=Round(OPREF.COEFICIENTE,8),IF(INCLUIDO(TIPOOP,'MMFRN|MMPSC|MMSCMV|MMFCMV|'),PRECIOEJ,(TOTALBRUTOCLI2/OPREF.COEFICIENTE)),CANTIDADORI),2);;;;;'###,###,###,###.##'
Coeficiente    : 'Coeficiente'                ;;2;2;NO;NoVacio(INDICE) y COEFICIENTE<>0;;;;IF(FECHAVTO>Fsys,IF(INCLUIDO(TIPOOP,'MMFRN|MMPSC|MMSCMV|MMFCMV|'),1,OPREF.COEFICIENTE),COEFICIENTE);IF(FECHAVTO>Fsys,IF(INCLUIDO(TIPOOP,'MMFRN|MMPSC|MMSCMV|MMFCMV|'),1,OPREF.COEFICIENTE),COEFICIENTE);;;;;'###.########';
ResultadoIndice: 'Resul Indice'               ;;2;2;NO;NoVacio(INDICE) y RESULTADOINDICE<>0;;;;IF(INCLUIDO(TIPOOP,'MMFRN|MMPSC|MMSCMV|MMFCMV|'),CANTIDAD-(CANTIDADORI*(1+VCAN10/100)),TOTALBRUTOCLI2-CANTIDADORI);IF(INCLUIDO(TIPOOP,'MMFRN|MMPSC|MMSCMV|MMFCMV|'),CANTIDAD-(CANTIDADORI*(1+VCAN10/100)),TOTALBRUTOCLI2-CANTIDADORI);;;;;'###,###,###,###.##'
