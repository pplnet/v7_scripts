** ZZ1=campo TipoCuenta a analizar   (entrada)
** ZZ2=Leyenda correspondiente a ZZ1 (salida)

If EqStr(Val(ZZ1),'CC')
   ACT(ZZ2, 'Cuenta Corriente')
Else
   If EqStr(Val(ZZ1),'CA')
      ACT(ZZ2, 'Caja de Ahorro')
   Else
      If EqStr(Val(ZZ1),'CUS')
         ACT(ZZ2, 'Cuenta Custodia')
      Else
         If EqStr(Val(ZZ1),'VIS')
            ACT(ZZ2, 'Cuenta a la Vista')
         Else
            If EqStr(Val(ZZ1),'CCO')
               ACT(ZZ2, 'Cuenta Propia')
            Else
               If EqStr(Val(ZZ1),'CAJ')
                  ACT(ZZ2, 'Caja')
               Else
                  If EqStr(Val(ZZ1),'INV')
                     ACT(ZZ2, 'Inversor')
                  Else
                     If EqStr(Val(ZZ1),'FCI')
                        ACT(ZZ2, 'Fondo Comun')
                     Else
                        ACT(ZZ2, 'Otros')
                     EndIf
                  EndIf
               EndIf
            EndIf
         EndIf
      EndIf
   EndIf
EndIf
