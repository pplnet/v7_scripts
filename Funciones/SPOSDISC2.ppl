SQL.ADD("SELECT E.Codigo, O.Cupon1 Cupon1, E.Nombre, Cartera = CASE O.Cartera WHEN -1 THEN 0 ELSE O.Cartera END, O.TipoOp, Cantidad = CASE O.Cartera WHEN -1 then O.CanPosTrad ELSE O.Cantidad  END, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, O.Precio1 ")
SQL.ADD("       ,O.CanPosTrad, O.CanPosInv1,O.CanPosInv2,O.CanPosOSoc, '' Inv,O.FechaOp ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      O.Especie = E.Codigo AND ")
SQL.ADD("      (O.Cartera=0 or (O.Cartera =-1 and O.CanPosTrad>0) ) AND ") 
SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      O.TipoOp IN ('CTC','VTC','CTP','VTP') AND ")
SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT E.Codigo, O.Cupon1 Cupon1, E.Nombre, Cartera = CASE O.Cartera WHEN -1 THEN 1 ELSE O.Cartera END, O.TipoOp, Cantidad = CASE O.Cartera WHEN -1 then O.CanPosInv1 ELSE O.Cantidad  END, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, ")
