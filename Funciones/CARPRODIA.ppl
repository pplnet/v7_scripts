SQL.ADD(" SELECT S1.Especie, E.Nombre, S1.Vehiculo1 Cliente, "~FSTR(val(z:9),1,0)~" NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, ")
SQL.ADD("        E.TasaIntVigente, CASE WHEN S1.TipoOp in ('TIV','TIFV') Then -(S1.Cantidad) ELSE (S1.Cantidad) END Saldo,              ")
SQL.ADD(" E.Alias5, E.InteresesC, '0' Tipo, S1.Cupon1 Cupon, S1.TipoOp                                                         ")
SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES MP                        ")
SQL.ADD(" WHERE S1.Vehiculo1 = C.Codigo                                                                                        ")
SQL.ADD(" AND   S1.Especie   = E.Codigo                                                                                        ")
SQL.ADD(" AND   MP.NrOperacion =  S1.NrOperacion                                                                               ")
SQL.ADD(" AND   S1.ESPECIE = MP.ESPECIE                                                                                        ")
SQL.ADD(" AND   S1.TipoOp IN ('TIC', 'TIFV', 'TIV', 'TIFC') and S1.PaseCB = 1                                                  ")
SQL.ADD(" AND   MP.FechaMov  = "~val(z:8)~"      and  S1.Especie =  '"~val(z:3)~"'                                             ")

SQL.ADD("UNION ALL ")

SQL.ADD(" SELECT S1.Especie, E.Nombre, S1.Vehiculo1 Cliente, "~FSTR(val(z:9),1,0)~" NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, ")
SQL.ADD("        E.TasaIntVigente, CASE WHEN S1.TipoOp in ('TIV','TIFV') Then -(S1.Cantidad) ELSE (S1.Cantidad) END Saldo,              ")
SQL.ADD(" E.Alias5, E.InteresesC, '0' Tipo, S1.Cupon1 Cupon, S1.TipoOp                                                         ")
SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".MOVEJECUTADOS ME                        ")
SQL.ADD(" WHERE S1.Vehiculo1 = C.Codigo                                                                                        ")
SQL.ADD(" AND   S1.Especie   = E.Codigo                                                                                        ")
SQL.ADD(" AND   ME.NrOperacion =  S1.NrOperacion                                                                               ")
SQL.ADD(" AND   S1.ESPECIE = ME.ESPECIE                                                                                        ")
SQL.ADD(" AND   S1.TipoOp IN ('TIC', 'TIFV', 'TIV', 'TIFC') and S1.PaseCB = 1                                                  ")
SQL.ADD(" AND   ME.FechaMov  = "~val(z:8)~"      and  S1.Especie =  '"~val(z:3)~"'                                             ")

watch(SQL.BATCH())

