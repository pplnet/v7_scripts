** Ingresos y Egresos
SQL.ADD("select  Especie, Cupon1, Case When TipoTr2 = 'DTP' then Cantidad1 when TipoTr2 = 'RTP' then -(Cantidad1) else Cantidad1 end Saldo, ")
SQL.ADD("   T.Fecha1 FechaVto, Cantidad1 Cantidad, NrTrans NrOperacion, T.Fecha1 FechaOp, T.Fecha1 FechaPago, 'ARP' ContraEspecie, cambio1 totalnetocli1,  '1' as Tipo, C.RazonSocial ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C where TipoTr2 in ('DTP','RTP','DRT') ")
SQL.ADD("    and (NrOperacionRef1 = '' or NrOperacionRef1 is Null) and (NrOperacionRef2 = '' or NrOperacionRef2 is Null) ")
SQL.ADD("    and Cliente1 = C.Codigo ")
SQL.ADD("    and Especie = '"~val(z:3)~"' ")
SQL.ADD("    and T.Fecha1 = "~val(z:8)~" ")
SQL.ADD("UNION ALL ")
SQL.ADD("select  T.Especie, T.Cupon1, M.Cantidad Saldo, M.FechaMov FechaVto,M.Cantidad Cantidad,M.NrOperacion, ")
SQL.ADD("    T.Fecha1 FechaOp, M.FechaMov FechaPago, M.Especie Contraespecie,Cantidad TotalnetoCli1,  '1' as Tipo, C.RazonSocial  ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C , "~DBO~".MOVEJECUTADOS M ")
SQL.ADD("where TipoTr2 in ('CANJE','STOCK','PDIVID') ")
SQL.ADD("    and M.NrOperacion = T.NrTrans ")
SQL.ADD("    and M.Especie  =  '"~val(z:3)~"' ")
SQL.ADD("    and T.Cambio5 = 101 ")
SQL.ADD("    and T.Cliente1 = C.Codigo ") 
SQL.ADD("    and T.Cliente1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    and M.FechaMov = "~val(z:8)~" ") 
watch(SQL.BATCH())

Recorrer SQL
    DFA
    SCN(z:22,fbn('Saldo'))
    if fbn('Saldo')>0
       SCN(z:44,fbn('Saldo'))
    else
       SCN(z:55,fbn('Saldo'))
    endif
Proximo

** prueba Bind consolidar movimientos cartera propia

*messagebox(val(z:3))
  recorrer&i 2,Val(y4)
     if  EqStr(Val(aa:&i),val(z:3))
         SCN(z:2,Val(af:&i))
         if not incluido(val(ah:&i),'TIPA|TIPP')
            if Val(ap:&i)<0
               SCN(z:4,Val(af:&i))
            else
               SCN(z:5,Val(af:&i))
            endif
         endif
     endif
  proximo

