*-------------- Calcula Intereses Devengados a la "Fecha hasta" del Informe -------------*

ACN(fa:1, fac)

IF Not Eqstr(fbn('TipoPosicion'), 'PF')
   SQL.ADD(" SELECT Codigo, FechaCambioTasa, TasaIntVigente, TasaIntAnterior, ")
   SQL.ADD(" Cupon, InteresesC, CuponFeriado FROM "~DBO~".ESPECIES WHERE Codigo = '"~Val(es:fac)~"'")
   Recorrer SQL
     IF Eqstr(fbn('InteresesC'),'CLE')
        ACN(cv:1, NrCupon2(fbn('Codigo'),Dialogo.Fecha1))

        ACD(fc:1, SQL(" SELECT FechaCambioTasa FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~fbn('Codigo')~"' AND NrCupon = '"~Val(cv:1)~"'"))
 
        *--- Fecha del ultimo Cupon
        ACD(uc:1, IIF(EsHabil(UltCupon2(fbn('Codigo'),Dialogo.Fecha1),'USA'),UltCupon2(fbn('Codigo'),Dialogo.Fecha1),Habiles(UltCupon2(fbn('Codigo'),Dialogo.Fecha1),IIF(EqStr(fbn('CuponFeriado'),'SIG'),1,IIF(EqStr(fbn('CuponFeriado'),'ANT'),-1,0)),'USA')))

        *--- Tasa Base
        ACN(tb:1, IIF(Val(fc:1)<=Val(uc:1),fbn('TasaIntVigente'),fbn('TasaIntAnterior')))

        *--- Tasa de Interes del Cupon
        ACN(ti:1, IIF(Val(fc:1)>Val(uc:1) y Val(fc:1) <= Dialogo.Fecha1,((fbn('TasaIntAnterior')*IIF(EspecieDiasAnio(fbn('Codigo'))=0 y EspecieDiasMes(fbn('Codigo'))=0,Dif360(Val(uc:1),Val(fc:1)-1,2), DifDias(Val(uc:1),Val(fc:1)-1,'USA',NO)))+(fbn('TasaIntVigente')*(IIF(EspecieDiasAnio(fbn('Codigo'))=0 y EspecieDiasMes(fbn('Codigo'))=0,Dif360(Val(fc:1)-1,Dialogo.Fecha1,2),DifDias(Val(fc:1)-1,Dialogo.Fecha1,'USA',NO)))))/(IIF(EspecieDiasAnio(fbn('Codigo'))=0 y EspecieDiasMes(fbn('Codigo'))=0,Dif360(VAl(uc:1),Dialogo.Fecha1,2),DifDias(Val(uc:1),Dialogo.Fecha1,'USA',NO))),Val(tb:1))*100)

        *--- Intereses Devengados
        ACN(o:val(fa:1), ValorTeorico2(fbn('Codigo'),Dialogo.Fecha1)*Val(c:Val(fa:1))*Val(ti:1)/DIASA(EspecieDiasAnio(fbn('Codigo')),FSYS)/100*IIF(EspecieDiasAnio(fbn('Codigo'))=0 y EspecieDiasMes(fbn('Codigo'))=0, Dif360(Val(uc:1),Dialogo.Fecha1,2), DifDias(Val(uc:1),Dialogo.Fecha1,'USA',NO)))
     ENDIF
   Proximo
ELSE
   IF [Dialogo.Fecha1 <> fbn('Fecha')] o [ fbn('NrSaldo')=1 ]
   ACN(o:val(fa:1), ROUND(Val(c:Val(fa:1))*Val(f:Val(fa:1))*((Dialogo.Fecha1-fbn('Fecha')) +1 )/(IIF(Eqstr(Val(es:fac),'USD'),360,365)*100),2))
   ENDIF
ENDIF


SetFilaActual(Val(fa:1))
