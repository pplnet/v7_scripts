*********************
*** PRESETTLEMENT ***
*********************
SQL.ADD("Select L.Commited,     L.Sublimite,      L.Especie,  L.PlazoDesde, ")
SQL.ADD("       L.PlazoHasta,   L.MontoOperativo, L.Tenor,    L.Vehiculo    ")
SQL.ADD("     , L.FAsignacion,  L.FVencimiento,   L.FRevision ")
SQL.ADD("from "~DBO~".LIMASIGNADOS L ")
SQL.ADD("where L.Cliente='"~Dialogo.Cliente1~"' ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and   L.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD("and L.Limite='PRESETTLEM' ")
SQL.ADD("and L.FAsignacion <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and (L.PlazoDesde in (1,31,91,181,366,731) and L.PlazoHasta in (30,90,180,365,730,10000)) ")
SQL.ADD("and  L.Monto > 0 ")
SQL.ADD("Union ")
SQL.ADD("Select LL.Commited  ,    LL.Sublimite,        LL.Especie,    LL.PlazoDesde, ")
SQL.ADD("       LL.PlazoHasta,    0 as MontoOperativo, 0 as Tenor,    LL.Vehiculo   ")
SQL.ADD("     , '"~IdxDate(Fecha('01/01/1900'))~"' as FAsignacion,  ")
SQL.ADD("       '"~IdxDate(Fecha('01/01/1900'))~"' as FVencimiento, ")
SQL.ADD("       '"~IdxDate(Fecha('01/01/1900'))~"' as FRevision     ")
SQL.ADD("from "~DBO~".LIMCONSUMIDOS LL ")
SQL.ADD("where LL.Cliente='"~Dialogo.Cliente1~"' ")
if NoVacio(Dialogo.Vehiculo1)
 SQL.ADD("and   LL.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
endif
if Dialogo.Fecha1 >= Fsys
 SQL.ADD("and   LL.Monto > 0 ")
endif
SQL.ADD("and   LL.Limite='PSVN' ")
SQL.ADD("and   LL.Commited in ('SI','NO') ")
SQL.ADD("and  (LL.PlazoDesde in (1,31,91,181,366,731) and LL.PlazoHasta in (30,90,180,365,730,10000)) ")
SQL.ADD("and   Not Exists (Select Monto from "~DBO~".LIMASIGNADOS M")
SQL.ADD("                where  M.Cliente   = '"~Dialogo.Cliente1~"' ")
if NoVacio(Dialogo.Vehiculo1)
 SQL.ADD("                and   M.Vehiculo  = '"~Dialogo.Vehiculo1~"'")
endif
SQL.ADD("                and  (M.PlazoDesde in (1,31,91,181,366,731) and M.PlazoHasta in (30,90,180,365,730,10000)) ")
SQL.ADD("                and   M.Limite    = 'PRESETTLEM' ")
SQL.ADD("                and   M.FAsignacion <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("                and   M.Especie   = 'USD' ")
SQL.ADD("                and   M.PlazoDesde= LL.PlazoDesde ")
SQL.ADD("                and   M.PlazoHasta= LL.PlazoHasta )")
SQL.ADD("order by 1,2,3,4,5")
Recorrer SQL
  DFA
  SCN(x11,1)
  ACT(ka:val(x11), FBN['Commited'])
  ACT(kb:val(x11), FBN['Sublimite'])
  ACT(kc:val(x11), FBN['Especie'])
  ACN(kd:val(x11), FBN['PlazoDesde'])
  ACN(ke:val(x11), FBN['PlazoHasta'])
  ACD(kf:val(x11), VtoLimite('PRESETTLEM',Dialogo.Cliente1,FBN['Especie'],Dialogo.Vehiculo1,,,,,,,,,,,,,FBN['Sublimite'],FBN['Commited']))
  ACN(kg:val(x11), FBN['MontoOperativo'])
  if Vacio(FBN['Sublimite'])
    ACN(kh:val(x11),LimConsumido(Dialogo.Cliente1,'PRESETTLEM',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,FBN['PlazoDesde'],,,,FBN['Commited']))
  else
    ACN(kh:val(x11),LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,FBN['PlazoDesde'],,,FBN['Sublimite'],FBN['Commited']))
  endif
  ACN(ki:val(x11), FBN['Tenor'])
  ACD(kj:val(x11), FBN['FAsignacion'])
  ACD(kk:val(x11), FBN['FRevision'])
  ACD(kl:val(x11), FBN['FVencimiento'])

  ACN(u1,0)
  ACN(u2,0)
  ACN(u3,0)
  if Not EqStr(FBN['Commited'],Val(v11))
    ACN(u1,1)
    ACN(u2,1)
    ACN(u3,1)
  endif
  if Not EqStr(FBN['Sublimite'],Val(v12))
    ACN(u2,1)
    ACN(u3,1)
  endif
  if Not EqStr(FBN['Especie'],Val(v13))
    ACN(u3,1)
  endif
  ACN(kn:val(x11), Val(u1))
  ACN(ko:val(x11), Val(u2))
  ACN(kp:val(x11), Val(u3))
  
  if Val(u1)=1
    * Es el Primero del Cross
    if Vacio(FBN['Sublimite'])
      * No existe Cross
      recorrer&i 1,6
        if Val(pd:&i)<=FBN['PlazoDesde']
          if EqStr(FBN['Commited'],'SI')
            SCN(x12,1)
            ACT(la:val(x12), FBN['Commited'])
            ACT(lc:val(x12), Var('ESPDEFLHO'))
            ACN(ld:val(x12), Val(pd:&i))
            ACN(le:val(x12), Val(ph:&i))
            ACN(lg:val(x12), FBN['MontoOperativo'])
            ACN(lh:val(x12), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
            ACN(li:val(x12), FBN['Tenor'])
            ACD(lj:val(x12), FBN['FAsignacion'])
            ACD(lk:val(x12), FBN['FRevision'])
            ACD(ll:val(x12), FBN['FVencimiento'])
            ACN(y12, Val(pd:&i))
          else
            SCN(x13,1)
            ACT(na:val(x13), FBN['Commited'])
            ACT(nc:val(x13), Var('ESPDEFLHO'))
            ACN(nd:val(x13), Val(pd:&i))
            ACN(ne:val(x13), Val(ph:&i))
            ACN(ng:val(x13), FBN['MontoOperativo'])
            ACN(nh:val(x13), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
            ACN(ni:val(x13), FBN['Tenor'])
            ACD(nj:val(x13), FBN['FAsignacion'])
            ACD(nk:val(x13), FBN['FRevision'])
            ACD(nl:val(x13), FBN['FVencimiento'])
            ACN(y13, Val(pd:&i))
          endif
        else
          Break
        endif
      proximo
    else
      * No existe Cross
      recorrer&i 1,6
        if Val(pd:&i)<=FBN['PlazoDesde']
          if EqStr(FBN['Commited'],'SI')
            SCN(x12,1)
            ACT(la:val(x12), FBN['Commited'])
            ACT(lc:val(x12), Var('ESPDEFLHO'))
            ACN(ld:val(x12), Val(pd:&i))
            ACN(le:val(x12), Val(ph:&i))
            ACN(lh:val(x12), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Diaogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
            ACN(li:val(x12), FBN['Tenor'])
            ACD(lj:val(x12), FBN['FAsignacion'])
            ACD(lk:val(x12), FBN['FRevision'])
            ACD(ll:val(x12), FBN['FVencimiento'])
            ACN(y12, Val(pd:&i))
          else
            SCN(x13,1)
            ACT(na:val(x13), FBN['Commited'])
            ACT(nc:val(x13), Var('ESPDEFLHO'))
            ACN(nd:val(x13), Val(pd:&i))
            ACN(ne:val(x13), Val(ph:&i))
            ACN(nh:val(x13), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
            ACN(ni:val(x13), FBN['Tenor'])
            ACD(nj:val(x13), FBN['FAsignacion'])
            ACD(nk:val(x13), FBN['FRevision'])
            ACD(nl:val(x13), FBN['FVencimiento'])
            ACN(y13, Val(pd:&i))
          endif
        else
          Break
        endif
      proximo
      recorrer&i 1,6
        if Val(pd:&i)<=FBN['PlazoDesde']
          if EqStr(FBN['Commited'],'SI')
            SCN(x14,1)
            ACT(ma:val(x14), FBN['Commited'])
            ACT(mb:val(x14), FBN['SubLimite'])
            ACT(mc:val(x14), FBN['Especie'])
            ACN(md:val(x14), Val(pd:&i))
            ACN(me:val(x14), Val(ph:&i))
            ACN(mg:val(x14), FBN['MontoOperativo'])
            ACN(mh:val(x14), LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,FBN['SubLimite'],FBN['Commited']))
            ACN(mi:val(x14), FBN['Tenor'])
            ACD(mj:val(x14), FBN['FAsignacion'])
            ACD(mk:val(x14), FBN['FRevision'])
            ACD(ml:val(x14), FBN['FVencimiento'])
            ACN(y14, Val(pd:&i))
          else
            SCN(x15,1)
            ACT(oa:val(x15), FBN['Commited'])
            ACT(ob:val(x15), FBN['SubLimite'])
            ACT(oc:val(x15), FBN['Especie'])
            ACN(od:val(x15), Val(pd:&i))
            ACN(oe:val(x15), Val(ph:&i))
            ACN(og:val(x15), FBN['MontoOperativo'])
            ACN(oh:val(x15), LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,FBN['SubLimite'],FBN['Commited']))
            ACN(oi:val(x15), FBN['Tenor'])
            ACD(oj:val(x15), FBN['FAsignacion'])
            ACD(401:val(x15), FBN['FRevision'])
            ACD(ol:val(x15), FBN['FVencimiento'])
            ACN(y15, Val(pd:&i))
          endif
        else
          Break
        endif
      proximo
    endif
  else
    if Val(u2)=1 o Val(u3)=1
      ACN(y14,0)
      ACN(y15,0)
      if Vacio(FBN['Sublimite'])
        *MessageBox('Error Vacio Sublimite - 1')
      else
        recorrer&i 1,6
          if Val(pd:&i)<=FBN['PlazoDesde']
            if EqStr(FBN['Commited'],'SI')
              SCN(x14,1)
              ACT(ma:val(x14), FBN['Commited'])
              ACT(mb:val(x14), FBN['SubLimite'])
              ACT(mc:val(x14), FBN['Especie'])
              ACN(md:val(x14), Val(pd:&i))
              ACN(me:val(x14), Val(ph:&i))
              ACN(mg:val(x14), FBN['MontoOperativo'])
              ACN(mh:val(x14), LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,FBN['SubLimite'],FBN['Commited']))
              ACN(mi:val(x14), FBN['Tenor'])
              ACD(mj:val(x14), FBN['FAsignacion'])
              ACD(mk:val(x14), FBN['FRevision'])
              ACD(ml:val(x14), FBN['FVencimiento'])
              ACN(y14, Val(pd:&i))
            else
              SCN(x15,1)
              ACT(oa:val(x15), FBN['Commited'])
              ACT(ob:val(x15), FBN['SubLimite'])
              ACT(oc:val(x15), FBN['Especie'])
              ACN(od:val(x15), Val(pd:&i))
              ACN(oe:val(x15), Val(ph:&i))
              ACN(og:val(x15), FBN['MontoOperativo'])
              ACN(oh:val(x15), LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,FBN['SubLimite'],FBN['Commited']))
              ACN(oi:val(x15), FBN['Tenor'])
              ACD(oj:val(x15), FBN['FAsignacion'])
              ACD(401:val(x15), FBN['FRevision'])
              ACD(ol:val(x15), FBN['FVencimiento'])
              ACN(y15, Val(pd:&i))
            endif
          endif
        proximo
      endif
    else
      ** Igual al Anterior
      if Vacio(FBN['Sublimite'])
        * No existe Cross
        recorrer&i 1,6
          if EqStr(FBN['Commited'],'SI')
            if Val(pd:&i)>Val(y12) y Val(pd:&i)<=FBN['PlazoDesde']
              SCN(x12,1)
              ACT(la:val(x12), FBN['Commited'])
              ACT(lc:val(x12), Var('ESPDEFLHO'))
              ACN(ld:val(x12), Val(pd:&i))
              ACN(le:val(x12), Val(ph:&i))
              if Val(pd:&i)=FBN['PlazoDesde']
                ACN(lg:val(x12), FBN['MontoOperativo'])
              endif
              ACN(lh:val(x12), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
              ACN(li:val(x12), FBN['Tenor'])
              ACD(lj:val(x12), FBN['FAsignacion'])
              ACD(lk:val(x12), FBN['FRevision'])
              ACD(ll:val(x12), FBN['FVencimiento'])
              ACN(y12, Val(pd:&i))
            endif
          else
            if Val(pd:&i)>Val(y13) y Val(pd:&i)<=FBN['PlazoDesde']
              SCN(x13,1)
              ACT(na:val(x13), FBN['Commited'])
              ACT(nc:val(x13), Var('ESPDEFLHO'))
              ACN(nd:val(x13), Val(pd:&i))
              ACN(ne:val(x13), Val(ph:&i))
              if Val(pd:&i)=FBN['PlazoDesde']
                ACN(ng:val(x13), FBN['MontoOperativo'])
              endif
              ACN(nh:val(x13), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
              ACN(ni:val(x13), FBN['Tenor'])
              ACD(nj:val(x13), FBN['FAsignacion'])
              ACD(nk:val(x13), FBN['FRevision'])
              ACD(nl:val(x13), FBN['FVencimiento'])
              ACN(y13, Val(pd:&i))
            endif
          endif
        proximo
      else
        recorrer&i 1,6
          if EqStr(FBN['Commited'],'SI')
            if Val(pd:&i)>Val(y14) y Val(pd:&i)<=FBN['PlazoDesde']
              SCN(x14,1)
              ACT(ma:val(x14), FBN['Commited'])
              ACT(mb:val(x14), FBN['Sublimite'])
              ACT(mc:val(x14), FBN['Especie'])
              ACN(md:val(x14), Val(pd:&i))
              ACN(me:val(x14), Val(ph:&i))
              if Val(pd:&i)=FBN['PlazoDesde']
                ACN(mg:val(x14), FBN['MontoOperativo'])
              endif
              ACN(mh:val(x14), LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,FBN['Sublimite'],FBN['Commited']))
              ACN(mi:val(x14), FBN['Tenor'])
              ACD(mj:val(x14), FBN['FAsignacion'])
              ACD(mk:val(x14), FBN['FRevision'])
              ACD(ml:val(x14), FBN['FVencimiento'])
              ACN(y14, Val(pd:&i))
            endif
          else
            if Val(pd:&i)>Val(y15) y Val(pd:&i)<=FBN['PlazoDesde']
              SCN(x15,1)
              ACT(oa:val(x15), FBN['Commited'])
              ACT(ob:val(x15), FBN['Sublimite'])
              ACT(oc:val(x15), FBN['Especie'])
              ACN(od:val(x15), Val(pd:&i))
              ACN(oe:val(x15), Val(ph:&i))
              if Val(pd:&i)=FBN['PlazoDesde']
                ACN(og:val(x15), FBN['MontoOperativo'])
              endif
              ACN(oh:val(x15), LimConsumido(Dialogo.Cliente1,'PSVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,FBN['Sublimite'],FBN['Commited']))
              ACN(oi:val(x15), FBN['Tenor'])
              ACD(oj:val(x15), FBN['FAsignacion'])
              ACD(401:val(x15), FBN['FRevision'])
              ACD(ol:val(x15), FBN['FVencimiento'])
              ACN(y15, Val(pd:&i))
            endif
          endif
        proximo
      endif
    endif
    if EqStr(FBN['Commited'],'SI')
      if FBN['PlazoDesde']>Val(y12)
        recorrer&i 1,6
          if Val(pd:&i)>Val(y12) y Val(pd:&i)<=FBN['PlazoDesde']
            SCN(x12,1)
            ACT(la:val(x12), FBN['Commited'])
            ACT(lc:val(x12), Var('ESPDEFLHO'))
            ACN(ld:val(x12), Val(pd:&i))
            ACN(le:val(x12), Val(ph:&i))
            ACN(lh:val(x12), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
            ACN(li:val(x12), FBN['Tenor'])
            ACD(lj:val(x12), FBN['FAsignacion'])
            ACD(lk:val(x12), FBN['FRevision'])
            ACD(ll:val(x12), FBN['FVencimiento'])
            ACN(y12, Val(pd:&i))
          endif
        proximo
      endif
    else
      if FBN['PlazoDesde']>Val(y13)
        recorrer&i 1,6
          if Val(pd:&i)>Val(y13) y Val(pd:&i)<=FBN['PlazoDesde']
            SCN(x13,1)
            ACT(na:val(x13), FBN['Commited'])
            ACT(nc:val(x13), Var('ESPDEFLHO'))
            ACN(nd:val(x13), Val(pd:&i))
            ACN(ne:val(x13), Val(ph:&i))
            ACN(nh:val(x13), LimConsumido(Dialogo.Cliente1,'PRESETTLEM',Var('ESPDEFLHO'),0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,Val(pd:&i),,,,FBN['Commited']))
            ACN(ni:val(x13), FBN['Tenor'])
            ACD(nj:val(x13), FBN['FAsignacion'])
            ACD(nk:val(x13), FBN['FRevision'])
            ACD(nl:val(x13), FBN['FVencimiento'])
            ACN(y13, Val(pd:&i))
          endif
        proximo
      endif
    endif
  endif

  ACT(v11, fbn('Commited'))
  ACT(v12, fbn('Sublimite'))
  ACT(v13, fbn('Especie'))
Proximo
if Val(x11)>0
  SetFont(ka:1..kq:Val(x11), 2)
endif

if Val(x12)>0
  SetFont(la:1..ll:val(x12), 2)
  Recorrer&i 1,Val(x12)
    if Val(lg:&i)<>0 o Val(lh:&i)<>0
      if &i=1
        SCN(sa:1, Val(lg:&i))
        SCN(sb:1, Val(lh:&i))
      endif
      SCN(z1,1)
      ACT(a:val(z1), 'Cross')
      ACT(b:val(z1), 'Commited')
      ACT(c:val(z1), Val(lc:&i))
      if Val(le:&i)=10000
        ACT(d:val(z1), FStr(Val(ld:&i),1,0)~' - S/Lim')
      else
        ACT(d:val(z1), FStr(Val(ld:&i),1,0)~' - '~FStr(Val(le:&i),1,0))
      endif
      if Val(lg:&i)>0
        ACN(e:val(z1), Val(li:&i))
      endif
      ACN(f:val(z1), Val(lg:&i))
      ACN(g:val(z1), Val(lg:&i)*CotizacionC(Val(lc:&i),,,,Dialogo.Fecha1-1,1,SI,'USD'))
      ACN(h:val(z1), Val(lh:&i))
      ACN(i:val(z1), Val(lh:&i)*CotizacionC(Val(lc:&i),,,,Dialogo.Fecha1-1,1,SI,'USD'))
      ACN(j:val(z1), Val(f:val(z1))-Val(h:val(z1)))
      ACN(k:val(z1), Val(g:val(z1))-Val(i:val(z1)))
      if Val(ff1)<Dialogo.Fecha1 y Val(ff1)>Fecha('01/01/1900')
        if Val(f:val(z1)) = 0
          ACT(l:val(z1), 'No Asignado')
          ColorCeldas(l:val(z1),clRED)
        else
          ACT(l:val(z1), 'Vencido')
          if Val(k:val(z1)) < 0
           ACT(l:val(z1), Val(l:val(z1))~' - Excedido')
         endif
         ColorCeldas(l:val(z1),clRED)
        endif
      else
        if Val(f:val(z1)) = 0
          ACT(l:val(z1), 'No Asignado')
          ColorCeldas(l:val(z1),clRED)
        else
          if Val(k:val(z1)) < 0
            ACT(l:val(z1), 'Excedido')
            ColorCeldas(l:val(z1),clRED)
          else
            ACT(l:val(z1), 'OK')
          endif
        endif
      endif
      SetFont(a:val(z1)..l:val(z1), 2)
      if Val(i:val(z1))>0
        ACL(i:val(z1), 'DETLCR', Cliente1=Dialogo.Cliente1, TipoLimite1='PRESETTLEM', Vehiculo1=Dialogo.Vehiculo1, Fecha1=Dialogo.Fecha1)
      endif
    endif
  proximo
endif
if Val(x14)>0
  SetFont(ma:1..ml:val(x14), 2)
  Recorrer&i 1,Val(x14)
    if Val(mg:&i)<>0 o Val(mh:&i)<>0
      SCN(z1,1)
      ACT(a:val(z1), 'Cte./Prod.')
      ACT(b:val(z1), 'Commited / '~Val(mb:&i))
      ACT(c:val(z1), Val(mc:&i))
      if Val(me:&i)=10000
        ACT(d:val(z1), FStr(Val(md:&i),1,0)~' - S/Lim')
      else
        ACT(d:val(z1), FStr(Val(md:&i),1,0)~' - '~FStr(Val(me:&i),1,0))
      endif
      if Val(mg:&i)>0
        ACN(e:val(z1), Val(mi:&i))
      endif
      ACN(f:val(z1), Val(mg:&i))
      ACN(g:val(z1), Val(mg:&i)*CotizacionC(Val(mc:&i),,,,Dialogo.Fecha1-1,1,SI,'USD'))
      ACN(h:val(z1), Val(mh:&i))
      ACN(i:val(z1), Val(mh:&i)*CotizacionC(Val(mc:&i),,,,Dialogo.Fecha1-1,1,SI,'USD'))
      ACN(j:val(z1), Val(f:val(z1))-Val(h:val(z1)))
      ACN(k:val(z1), Val(g:val(z1))-Val(i:val(z1)))
      if Val(ff1)<Dialogo.Fecha1 y Val(ff1)>Fecha('01/01/1900')
        if Val(f:val(z1)) = 0
          ACT(l:val(z1), 'No Asignado')
          ColorCeldas(l:val(z1),clRED)
        else
         ACT(l:val(z1), 'Vencido')
