        SQL.ADD("and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and Mercado      = '"~Val(b:&i)~"'")
        SQL.ADD("and NrSaldo      = 1 ")
        if Dialogo.Check5 = 0
            SQL.ADD("and NrOperacion        = '"~VAL(CA:&i)~"' ")
            SQL.ADD("and IsNull(NrGrupo2,0) = "~Val(w:&i)~" ")
            SQL.ADD("and IsNull(NrMov,0)    = "~Val(y:&i)~" ")
        endif

        if Dialogo.Check13=1
*            SQL.ADD("and NrGrupo in (15,16)   ") 
            SQL.ADD("and NrGrupo = "~FSTR(val(nr:&i),1,0)) 
        else
            SQL.ADD("and (NrGrupo not in (15,16) or NrGrupo is Null)  ") 
        endif

        SQL.ADD("and FechaMov     = '"~IdxDate(Val(cg:&i))~"' ")
        SQL.ADD("and Bits in ('MV','MI') ")
        SQL.ADD("and (")
        SQL.ADD("'"~FStr(Val(bk:&i),1,0)~"' = '0' ")
        SQL.ADD("or ('"~FStr(Val(bg:&i),1,0)~"' = '1' and Status = 'DVP') ")
        SQL.ADD("or ('"~FStr(Val(bh:&i),1,0)~"' = '1' and Status = 'RVP') ")
        SQL.ADD("or ('"~FStr(Val(bi:&i),1,0)~"' = '1' and Status = 'CONF') ")
        SQL.ADD("or ('"~FStr(Val(bj:&i),1,0)~"' = '1' and Status = 'MATCH') ")
        SQL.ADD("or ('"~FStr(Val(bk:&i),1,0)~"' = '1' and isnull(Status,'') = '' )")
        SQL.ADD(")")
        SQL.ADD("and (")
        SQL.ADD("NrOperacion in (Select O.NrOperacion from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
        SQL.ADD("where O.NrOperacion = B.NrOperacion ")
        SQL.ADD("and O.Cliente1 = '"~Val(a:&i)~"' ")

        SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and O.Mercado   = '"~Val(m:&i)~"'")
        SQL.ADD("and B.NrBit IN ('10','70') and B.Valor = '1'                                                     ")

        SQL.ADD(")")
        SQL.ADD("or NrOperacion in (Select T.NrTrans from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
        SQL.ADD("where T.NrTrans = B.NrOperacion ")
        SQL.ADD("and T.Cliente1  = '"~Val(a:&i)~"' ")
        SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and T.Mercado1  = '"~Val(m:&i)~"'")
        SQL.ADD("and B.NrBit     = 5 ")
        SQL.ADD("and B.Valor     = '1' ")
        SQL.ADD(")")
        SQL.ADD(")")
        SQL.NEW
        watch(SQL.BATCH())
        Message('Pasando Operaciones a Terminal ...')
        EjecutarEvento('PPASE',NrOperacion=Val(ca:&i), Mercado1='')      
            
    Endif

  proximo
     * Fin Recorrer
  SQL.EXEC

* PZ 05/05/2026 se deja de generar  
* FO 25/04/2006
*     EjecutarEvento('LIQVT',NrTrans1=Val(n:fac))

     * --------------------------------------------------------------------- *
      * FO 21/02/2006 - Actualiza cuentas de la operacion
      SQL.ADD(" SELECT M.NrOperacion, M.Especie EspecieM, O.Especie, O.ContraEspecie, O.TipoOp ")
      SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
      SQL.ADD(" WHERE  M.NrTrans2    = '"~Val(n:fac)~"' ")
      SQL.ADD(" AND    O.NrOperacion = M.NrOperacion ")
      SQL.ADD(" AND    O.TipoOp IN  ('TIC','TIV','TIFC','TIFV','TICO','TIPO','TICT','TIDE','FXC','FXV','FXA','FXAT','FXCF','FXVF') ")
      * No modifico cuentas por comisiones MAE1
      SQL.ADD(" AND    M.NrGrupo not in (15,16) ")
      Recorrer SQL
         DFA
         SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET ")
         IF Incluido(fbn('TipoOp'), 'TIC|TIV|TIFC|TIFV|TICO|TIPO|TICT|TIDE')
            If EQSTR(fbn('EspecieM'),fbn('Especie'))
               SQL.ADD(" Cuenta1 =  '"~Val(r:fac)~"', ")
               SQL.ADD(" Cuenta2 =  '"~Val(s:fac)~"'  ")
            Else
               SQL.ADD(" Cuenta4 =  '"~Val(r:fac)~"', ")
               SQL.ADD(" Cuenta3 =  '"~Val(s:fac)~"'  ")
            Endif
         Else
            If EQSTR(fbn('EspecieM'),fbn('Especie'))
               SQL.ADD(" Cuenta3 =  '"~Val(r:fac)~"', ")
               SQL.ADD(" Cuenta1 =  '"~Val(s:fac)~"'  ")
            Else
               SQL.ADD(" Cuenta4 =  '"~Val(r:fac)~"', ")
               SQL.ADD(" Cuenta2 =  '"~Val(s:fac)~"'  ")
            Endif
         Endif

         SQL.ADD(" WHERE NrOperacion =  '"~fbn('NrOperacion')~"'  ")
         SQL.NEW
      Proximo
      SQL.EXEC  
     * --------------------------------------------------------------------- *

        if Val(k:FAC)=0
          EjecutarEvento('DESPRE',NrTrans1=Val(n:FAC),Fecha1=Habiles(Dialogo.Fecha1,1,'ARG'))
        endif
      else
        ACT(n:FAC, 'Liquida')
      endif
      * Fin Control Check8=1 (Procesa)
    endif
    * Fin Control Val(x3)>0
