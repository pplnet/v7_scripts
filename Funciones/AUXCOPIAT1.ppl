        ** poner titulos ROFEX
        ifa
        ACT(j:FAC+1, val(xx1))
        if Dialogo.Fecha2>Dialogo.Fecha1
           ACT(j:FAC+2, 'Registro de Operaciones Rueda desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
        else
           ACT(j:FAC+2, 'Registro de Operaciones Rueda del '~Dialogo.Fecha1)
        endif
        
        AlinearCeldas(j:FAC+1..j:FAC+2,'C')


        SetFilaActual(fac+4)

        ACT(a:FAC, 'Boleto')
        ACT(b:FAC, 'Nr.Boleta')
        ACT(c:FAC, 'Fecha Op.')
        ACT(d:FAC, 'Fecha Liq.')
        ACT(e:FAC, 'Tipo Op') 
        ACT(f:FAC, 'Hora')
        ACT(g:FAC, 'Mercado')
        ACT(h:FAC, 'Cuenta - CUIT/CUIL')
        ACT(i:fac, 'Instrumento')
        ACT(j:fac, 'Cantidad')
        ACT(k:fac, 'Precio')
        ACT(l:fac, 'Valor Efectivo')
        ACT(m:fac, 'Unidad')
        ACT(n:fac, 'Nr.Minuta')
        ACT(o:fac, 'Origen')
        ACT(p:fac, 'Contraparte')
        ACT(q:fac, 'Cartera')
        ACT(r:fac, 'Baja')

        AlinearCeldas(a:FAC..r:fac,'C')
        AgregarMarco(a:FAC..r:fac,2)
        SetFont(a:FAC..r:fac,2)
        ifa
