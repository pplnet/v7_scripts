VTXT26    : 'Country'         ;18;2;2;NO;NO;NOVACIO(VTXT26);'Falta Country en la Especie '~ESPECIE1;;;IF(NoVacio(BOOK1),BuscarCampo('ESPECIES', 'EntidadEmisora', 'Codigo', ESPECIE));;;;;'##########';
