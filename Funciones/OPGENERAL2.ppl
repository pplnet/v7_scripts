VCAN27    : 'Total Book'      ;18;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),LIMTOTALIZADO3(VEHICULO1,'BOOK',0,VEHICULO1,,BOOK1,NROPERACION,,,,,,,,,,'USD'))

VTXT14      : 'MONEDA EMISION'  ;1;1;2;NO;NO;;;;;IF(NoVacio(BOOK1),BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE))
VTXT3       : 'InteresClean'    ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE));
VCAN9       : 'EspDiasAnio'     ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),EspecieDiasAnio(ESPECIE));
VCAN10      : 'EspDiasMes'      ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),EspecieDiasMes(ESPECIE));
VPRE2       : 'cd'              ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),IF(VCAN9=0 y VCAN10=0,1,0));
VPRE3       : 'TasaIntVig'      ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE));
VFEC1       : 'FechaCambioTasa' ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE));
VFEC2       : 'UltCupon'        ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),UltCupon2(ESPECIE,FECHAVTO));
VFEC3       : 'cg'              ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),IF(VCAN10=0 o EsHabil(VFEC2,'USA'),VFEC2,Habiles(VFEC2,BuscarCampo('ESPECIES','Valor10','Codigo',ESPECIE),'USA')));
VPRE4       : 'ch1'             ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',ESPECIE)*IF(VPRE2=1,Dif360(VFEC3,VFEC1-1,2),DifDias(VFEC3,VFEC1-1,'USA',NO)))+(VPRE3*(IF(VPRE2=1,Dif360(VFEC1-1,FECHAVTO,2),DifDias(VFEC1-1,FECHAVTO,'USA',NO)))))/(IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))*100))
VPRE5       : 'ch2'             ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),VPRE3*100)
VPRE6       : 'ch'              ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),IF(VFEC1>VFEC3 y VFEC1<=FECHAVTO,VPRE4,VPRE5))
VPRE7       : 'Sucio1'          ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),VPRE6*IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))/(DiasAnio2(ESPECIE,UltCupon2(ESPECIE,FSYS),ProxCupon2(ESPECIE,FSYS))*100)*if(Not eqstr(VTXT14,CONTRAESPECIE),TOTALAUX8,1));;;;;'#,###,###,###,###.########'
VPRE8       : 'Sucio2'          ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),IF(EqStr(VTXT3,'CLE'),ValorTeorico2(ESPECIE,FECHAVTO)*(1+IntsCapitalizados2(ESPECIE,FECHAVTO)),1))
VPRE15      : 'SucioCap NUEVO'  ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),(Query("SELECT TasaCapInt FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~ESPECIE~"' AND NrCupon= '"~CUPON1~"' ")*IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))/(DiasAnio2(ESPECIE,UltCupon2(ESPECIE,FSYS),ProxCupon2(ESPECIE,FSYS))*100)));;;;;'#,###,###,###,###.########'
VPRE16      : 'InsCap'          ;;;;NO;NO;;;;;IF(NoVacio(BOOK1),IF(EqStr(VTXT3,'CLE'),IntsCapitalizados2(ESPECIE,FECHAVTO),0))

VPRE19  : 'NroSaldo'           ;1;1;2;NO;NO;;;;;IF(Incluido(TIPOOP,'TIC|TIV|CTC|CTP|VTC|VTP|TIBCRA'),CARTERA+2+101, CARTERA+2+101+10)
VFEC5   : 'MaxFecha'           ;1;2;2;NO;NO;;;;;IIF(TIPOTICKET=0 THEN QUERY("SELECT MAX(P2.Fecha) FROM "~DBO~".POSICIONES P2 WHERE P2.Cliente='"~VEHICULO1~"' AND P2.Especie = '"~ESPECIE~"' AND P2.NrSaldo ="~Fstr(VPRE19,0,0)~" AND P2.Fecha<='"~IdxDate(FECHAOP)~"'") ELSE FSYS ENDIF)
VPRE17  : 'Monto Posicion'     ;1;1;2;NO;NO;;;;;IIF(TIPOTICKET=0 THEN QUERY("SELECT Sum(P1.CantidadFin) FROM "~DBO~".POSICIONES P1 WHERE  P1.Cliente='"~VEHICULO1~"' AND P1.Especie = '"~ESPECIE~"' AND P1.NrSaldo="~Fstr(VPRE19,0,0)~" AND P1.Fecha='"~IdxDate(VFEC5)~"' ")-QUERY("SELECT Sum(Cantidad) FROM "~DBO~".MOVPOSEJE WHERE Cliente='"~VEHICULO1~"' AND Especie='"~ESPECIE~"' AND NrSaldo="~Fstr(VPRE19,0,0)~" AND NrOperacion='"~NROPERACION~"' ") ELSE 0 ENDIF)
VPRE20  : 'Pos. Actual'        ;1;2;2;NO;NO;;;;;IF(Incluido(TIPOOP,'TIC|TIFC|CFTC|CFTP|CTC|CTP|TIBCRA'), VPRE17+CANTIDAD, VPRE17-CANTIDAD)

PorArancel2: 'Pr ContraEspe'  ;11;2;2;NO;NO;;;EqStr(CONTRAESPECIE,BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE));;IF(not EqStr(CONTRAESPECIE,BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE)),PORARANCEL2)
VFEC4      :'F.CorteCupon'    ; 1;1;2;NO;NO;;;;;Query("SELECT FechaCorte FROM  "~DBO~".AGENDACUPONES WHERE Especie = '"~ESPECIE~"' and NrCupon = '"~CUPON1~"' ")
