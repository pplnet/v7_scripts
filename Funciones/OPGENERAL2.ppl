*Vcan3             :'% PRESSET'      ;15;2;2;NO;SI;;;;;IF([FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1] O PASECB=1,0,QUERY("Select Factor from "~DBO~".RISKWEIGHT where Especie='"~ESPECIE~"' or Especie In  "~VTXT15~" Order By Fecha Desc") / 100))  ;;;;;'###,###.######' 
Vcan3             :'% PRESSET'      ;15;2;2;NO;NO;;;;;IF([FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1] O PASECB=1,0,QUERY("Select Factor from "~DBO~".RISKWEIGHT where Especie='"~ESPECIE~"' or Especie In ("~Pipe2Comillas(Ascendientes('ESPECIES',ESPECIE))~") Order By Fecha Desc") / 100)  ;;;;;'###,###.######' 
VCAN5             :'% PRESSET'      ;12;2;2;NO;NO;;;;;IF([FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1] O PASECB=1,0,IF(VCAN3=0,VAR('PORPRESETT')/100,VCAN3));;;;;'###,###.######'   
TotalNetoCli3     :'Monto USD'      ;11;1;2;NO;NO;;;;;TOTALNETOCLI1*CotizacionC(CONTRAESPECIE,,,,FSYS,1,SI,VAR('MONEEXTR'));;;;;'###,###,###,###.######'    
VCAN7             :'Monto PRESSET'  ;12;2;2;NO;NO;;;;;TOTALNETOCLI3*VCAN5;;;;;'###,###,###,###.######'  
MinDerechoBolsa   :'Ex.Pres.'       ;12;1;2;NO;NO;;;;-CANTIDAD+CANTIDAD+IF(VCAN1=1 o PASECB=1 o [FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1],0,IF(Not[(LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION) +VCAN7))<0],0,(LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN7))));-CANTIDAD+CANTIDAD+IF(VCAN1=1 o PASECB=1 o [FORMALIQUIDACION1<>1 Y FORMALIQUIDACION2<>1],0,IF(Not[(LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION) +VCAN7))<0],0,(LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN7))));;;;;'###,###,###,###.######'
MinArancel       : 'Ex.Max.EU'      ;14;1;2;NO;NO;;;;-CANTIDAD+CANTIDAD+IF(NOT [VCAN1=0 ],0,IF(Not[(LimAsignado(VEHICULO1,'MAX'~MERCADO,'USD',VEHICULO1) -(LimConsumido(VEHICULO1,'MAX'~MERCADO,'USD',FECHAVTO,VEHICULO1,,,NROPERACION) + TOTALNETOCLI3))<0],0,(LimAsignado(VEHICULO1,'MAX'~MERCADO,'USD',VEHICULO1) -(LimConsumido(VEHICULO1,'MAX'~MERCADO,'USD',FECHAVTO,VEHICULO1,,,NROPERACION)+TOTALNETOCLI3))));-CANTIDAD+CANTIDAD+IF(NOT [VCAN1=0 ],0,IF(Not[(LimAsignado(VEHICULO1,'MAX'~MERCADO,'USD',VEHICULO1) -(LimConsumido(VEHICULO1,'MAX'~MERCADO,'USD',FECHAVTO,VEHICULO1,,,NROPERACION) + TOTALNETOCLI3))<0],0,(LimAsignado(VEHICULO1,'MAX'~MERCADO,'USD',VEHICULO1) -(LimConsumido(VEHICULO1,'MAX'~MERCADO,'USD',FECHAVTO,VEHICULO1,,,NROPERACION)+TOTALNETOCLI3))));;;;;'###,###,###,###.######'
VCAN28            :'Disp.Cli1 Pres.'; 7;3;1;NO;NO;;;;;(LimAsignado(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),VEHICULO1)) - ((LimConsumido(VTXT11,'PRESETTLEM',VAR('MONEEXTR'),0,VEHICULO1,,,NROPERACION)+VCAN7));;;;;'###,###,###,###.######'
VCAN12            :'LimCon Especie'          ; 1;1;2;NO;NO;;;;;LIMCONSUMIDO(VTXT11,'SETTLEMENT',ESPECIE,FECHAVTO,,,,NROPERACION)
VCAN13            :'LimCon C-Esp'            ;  ; ;2;NO;NO;;;;;LIMCONSUMIDO(VTXT11,'SETTLEMENT',CONTRAESPECIE,FECHAVTO,,,,NROPERACION)
VCAN14            :'Especie'                 ; 1;1;2;NO;NO;;;;IF(VCAN12+VCAN18>0,IF(VCAN12<0,VCAN12+VCAN18,VCAN18),0);IF(VCAN12+VCAN18>0,IF(VCAN12<0,VCAN12+VCAN18,VCAN18),0)
VCAN11            :'Total Settlement'        ; 1;2;2;NO;NO;;;;;LIMSUMADO(VTXT11,'SETTLEMENT',FECHAVTO,,,,NROPERACION)
VCAN24            :'Total Sett.GE'           ; 1;2;2;NO;NO;;;;;LIMSUMADO(VTXT10,'SETTLEMENT',FECHAVTO,,,,NROPERACION)
VCAN19            :'Total SetCre'            ;  ;2;2;NO;NO;;;;;LIMCONSUMIDO(VEHICULO1,'SETTCRE',VAR('MONEEXTR'),FECHAVTO,VEHICULO1,,,NROPERACION)+VCAN18
VCAN20            :'Total Sett.c/SetCre'     ;  ;2;2;NO;NO;;;;;LIMCONSUMIDO(VTXT11,'SETCRE',VAR('MONEEXTR'),0,,,,NROPERACION,FECHAVTO)+VCAN11
VCAN18            :'Equivalente USD'         ;  ;2;2;NO;NO;;;;;if(EqStr(CONTRAESPECIE,VAR('MONEEXTR')),TOTALNETOCLI1,TOTALNETOCLI1*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR')))
VTXT1             :'Cliente Grupo'           ; 1;2;2;NO;NO;;;;;QUERY("Select TipoCartera from "~DBO~".CLIENTES where Codigo='"~CLIENTE1~"' ")
RB10              :'Conf.Liq.'               ; 9;1;2;NO;NO;;;;;0
FechaPrecan       :'Conf.Liq.'               ; 9;1;2;NO;NO;;;;;
MinDerechoMercado :'Ex.Sett.'                ; 1;1;2;NO;NO;;;;0;IF(VCAN1=1 o FORMALIQUIDACION1=1 o FORMALIQUIDACION2=1 o LimAsignado(VTXT11,'SETTLEMENT',VAR('MONEEXTR')) >= VCAN11+TOTALNETOCLI3,0,-VCAN11-TOTALNETOCLI3+LimAsignado(VTXT11,'SETTLEMENT',VAR('MONEEXTR')));;;;;'###,###,###,###.######'

VTXT13            :'Mon.Emision :'           ;14;1;2;NO;NO;NOVACIO(VTXT13);'Falta Moneda de Emision en la Especie';;;BuscarCampo('ESPECIES', 'Cotiza', 'Codigo', ESPECIE)
TotalAux1        : 'C.Mon.Emis:'             ;14;2;2;NO;NO;;;;;IF(Eqstr(VTXT13,CONTRAESPECIE),1,CotizacionC(CONTRAESPECIE,,,,FECHAOP,1,SI,VTXT13));;;;;"##########.########"
NrOperacion2      :'CorteCup'                ;13;2;2;NO;NoVacio(NROPERACION2);
VPRE1             :'Cantidad VR.'            ; 7;2;2;NO;NO;;;;CANTIDAD*ValorTeorico2(ESPECIE,FECHAVTO)*(1+IntsCapitalizados2(ESPECIE,FECHAVTO));CANTIDAD*ValorTeorico2(ESPECIE,FECHAVTO)*(1+IntsCapitalizados2(ESPECIE,FECHAVTO));;;;;'###,###,###,###.######'
