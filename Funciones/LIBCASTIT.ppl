 ACN(aw1,Val(aw6)/VAR('LIBCASHOJA')/Val(aw4))
 if Val(aw1) >=1
     if Dialogo.Radio1=1
        setfilaactual(fac+3)
        ACT(e:fac, 'Folio: '~FStr(Val(aw3),1,0))
        ACN(ay2, Val(aw3))
        if val(ay1) = 0
           ACN(ay1, Val(aw3))
        endif
        SCN(aw3,1)   
     else
         setfilaactual(fac+3)
         ACT(e:fac, 'Provisorio - Pag. '~FStr(Val(aw4),1,0))
     endif
     
     SetFont(e:fac,2)
     
     SaltarHoja    
     SCN(aw4, 1)
