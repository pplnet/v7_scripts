 ACN(aw1,Val(aw6)/70/Val(aw4))
 if Val(aw1) >=1
     if Dialogo.Radio1=1
        if Val(aw5)<>0
           SCN(aw3,1)
        endif   
        ACN(aw5, SQL("Select Cantidad From "~DBO~".FLAGSMERCADO Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'NCAR' "))
        FormatoCeldas(aw3..aw5,Exe('F0'))
        if val(aw5)<>Val(aw3)
           Messagebox('El informe Original (Folio final '~Fstr(Val(aw5),0,0)~') difiere con las hojas a reimprimir (Folio final '~Fstr(val(aw3),0,0)~')')
        endif
        setfilaactual(fac+3)
        ACT(e:fac, 'Folio: '~FStr(Val(aw3),1,0))
        ACN(ay2, Val(aw3))
        if val(ay1) = 0
           ACN(ay1, Val(aw3))
        endif
     else
         setfilaactual(fac+3)
         ACT(e:fac, 'Provisorio - Pag. '~FStr(Val(aw4),1,0))
     endif
     
     SetFont(e:fac,2)
     
     SaltarHoja    
     SCN(aw4, 1)
     AgregarBMP(a:fac,Exe('LOGO'),EXE('ESCALOGO'))

     ACT(a:Fac+3,Val(st1)~' '~val(st2)~' - '~val(st3))
     SetFont(a:fac+3,2)

     SetFilaActual(fac+4)
     ACT(A:FAC+1, 'LIBRO CARTERA PROPIA')
     ACT(D:fac+1,'Del  '~Dialogo.Fecha1)
     **ACT(i:fac+1,'Hoja : ')

     *AlinearCeldas(a:FAC..y:fac+1,'C')
     SetFont(a:FAC..y:fac+1,6)

     SetFilaActual(Fac+2)

     ACT(a:FAC, 'Boleto')
     ACT(b:FAC, 'Codigo y Nombre Comitente')
     ACT(c:FAC, 'CUIT')
     ACT(f:FAC, 'Especie')
     ACT(h:FAC, 'Fec.Ope')
     ACT(i:FAC, 'Fec.Liq')
     ACT(j:FAC, 'Tipo Op.')
     ACT(a:FAC+1, 'Cont.')
     ACT(b:FAC+1, 'Precio')
     ACT(c:FAC+1, 'Cantidad')
     ACT(e:FAC+1, 'Importe')
     ACT(f:FAC+1, 'Arancel detalle de gastos')
     ACT(g:FAC+1, 'Importe')
     ACT(h:FAC+1, 'Importe Neto')
     ACT(a:FAC+2, 'Observaciones')

     AgregarMarco(a:FAC..j:fac+2,2)
     SetFont(a:FAC..j:FAC+2,2)

     SetFilaActual(fac+3)
     
     if  EqStr(Val(li:2),'SI')
     SetFilaActual(FAC+2)
ACT(b:FAC+3,'Especie')
ACT(c:FAC+3,'Saldo')
ACT(c:FAC+4,'Inicial')
ACT(d:FAC+3,'Compras')
ACT(d:FAC+4,'del día')
ACT(e:FAC+3,'Ingresos')
ACT(f:FAC+3,'Ventas')
ACT(f:FAC+4,'del día')
ACT(g:FAC+3,'Egresos')
ACT(h:FAC+3,'Saldo')
ACT(h:FAC+4,'Final')
AlinearCeldas(c:FAC+3..h:FAC+4,'D')
AgregarMarco(b:FAC+3..h:FAC+4,2,2)
SetFont(a:Fac+3..h:fac+4,2)

SetFilaActual(FAC+4)
Endif
     
 Endif       
