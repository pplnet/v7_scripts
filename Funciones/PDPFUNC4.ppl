*         Setear Funcion
*         Objeto a Buscar                  ACT(xz14,'INFORMES') 
*         Codigo del Objeto a Buscar       ACT(xz15,Val(t1))
*         Colunma Inicial para el detalle  ACN(xz16,4)

          ACT(aa14, BuscarLinkearHojas(Val(xz14), Val(xz15)))
          if NoVacio(Val(aa14))
             act(val(xz16):val(xy1)+1,'Incluye Informe')
             AlinearCeldas(val(xz16):val(xy1)+1,'D')
             SetFont(val(xz16):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa14)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa14), &k))))
                ACT(val(xz16)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz17,'INFORMES')
                ACT(xz18,Val(t10))
                ACN(xz19,Val(xz16)+1)
                (.'PDPFUNC5'.)
             proximo
          Endif

          ACT(aa24, BuscarEjecutarEventos(Val(xz14), Val(xz15)))
          if NoVacio(Val(aa24))
             act(Val(xz16):val(xy1)+1,'Incluye Evento')
             AlinearCeldas(val(xz16):val(xy1)+1,'D')
             SetFont(Val(xz16):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa24)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa24), &k))))
                ACT(Val(xz16)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz17,'EVENTOS')
                ACT(xz18,Val(t10))
                ACN(xz19,Val(xz16)+1)
                (.'PDPFUNC5'.)
             proximo
          Endif

          ACT(aa34, BuscarFunciones(Val(xz14), Val(xz16)))
          if NoVacio(Val(aa34))
             act(val(xz16):val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(val(xz16):val(xy1)+1,'D')
             SetFont(val(xz16):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa34)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa34), &k))))
                ACT(val(xz16)+1:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz17,'FUNCIONES')
                ACT(xz18,Val(t10))
                ACN(xz19,Val(xz16)+1)
                (.'PDPFUNC5'.)
             proximo
          Endif
           
