Recorrer&i 1,2
*----- Inclusion de Fecha de Liquidacion: 14 Nov 2007
  SQL.ADD(" Select FechaVto,FechaPago,Especie,ContraEspecie,MB1,Precio1,Cantidad,TotalBrutoCli1,Cuenta3,Cuenta4,CB5 ")
  SQL.ADD(" From "~DBO~".OPERACIONES ")
  SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  Recorrer SQL
    ACD(fV:1, fbn('FechaVto'))
    ACD(fP:1, fbn('FechaPago'))
    ACT(ES:1, FBN('Especie'))     
    ACT(CE:1, FBN('ContraEspecie'))
    ACt(MB:1, FBN('MB1'))           * Indica Tipo de Cambio en Arbitraje (0=Cra 1= Vta)
    ACt(CB:5, FBN('CB5'))           * Indica Relacion Directa o Inversa
    ACN(TC:1, FBN('Precio1'))       * Tipo de Cambio para Comprado/Compra o Vendido/Vta     
    ACN(TC:2, FBN('Cantidad') / FBN('TotalBrutoCli1'))    * Tipo de Cambio para Comprado/Venta o Vendido/Compra Relacion Directa (CB5=0)    
    ACN(TC:5, FBN('TotalBrutoCli1') / FBN('Cantidad'))        * Tipo de Cambio para Comprado/Venta o Vendido/Compra Relacion Inversa (CB5=1)    
    ACT(CT:3, FBN('Cuenta3'))  
    ACT(CT:4, FBN('Cuenta4'))  
  
  Proximo
  If NOT EqStr(VAL(fV:1),VAL(fP:1))
     act(f:fac,'Fecha Liquidacion: '~VAL(ES:1)~' '~VAL(fV:1)~' - '~VAL(CE:1)~' '~VAL(fP:1))
     SetFont(f:fac,2)
  ELSE
     act(f:fac,'Fecha Liquidacion: '~VAL(fV:1))
     SetFont(f:fac,2)
  ENDIF

*----- Toma Datos de la Venta para el Boleto de Arbitraje  (FXV)
  SQL.ADD("Select Cliente, Corresponsal, Precio, Cantidad from "~DBO~".CAMBIOSBCRA")
  SQL.ADD("Where NrOperacion = '"~Trim(Dialogo.NrOperacion1)~"' ")
  SQL.ADD("      and  (TipoOp='FXV'  or  TipoOp='FXVT')      ") 
  Recorrer SQL
  acn(PR:1, fbn('Precio'))             ** Campo usado para el Tipo de Cambio
  acn(CQ:1, fbn('Cantidad'))           ** Importe en Monex para INSTRUM VENDIDO
  act(RR:1, BuscarCampo('CORRESPONSALES','Nombre','Codigo',fbn('Corresponsal')))
  act(SW:1, BuscarCampo('CORRESPONSALES','SWIFTAddress','Codigo',fbn('Corresponsal')))
  Proximo 
*-------------------------------------------------------(A)------------------
  act(b:fac,'BANCO CENTRAL DE LA REPUBLICA ARGENTINA')
  act(e:fac,'MERCADO LIBRE DE CAMBIOS')
  SetFont(e:fac,3)
  act(g:fac,'FECHA')
  SetFont(g:fac,1)
  AgregarMarco(g:fac..g:fac,2,0,0)
  act(h:fac,'Nº DE BOLETO')
  SetFont(b:fac,1)
  SetFont(h:fac,1)
  AlinearCeldas(a:fac..h:fac,'C')
  IFA
  act(b:fac,'GERENCIA DE EXTERIOR Y CAMBIOS')
  SetFont(a:fac..h:fac,1)
  act(e:fac,Val(z10)~'Arbitraje')
  SetFont(e:fac,3)
  
  AlinearCeldas(a:fac..h:fac,'C')
  IFA
  act(g:fac,fbn('FechaOp'))
  act(h:fac,val(NB:1))    *** Nro de Boleto para Arbitrajes
  AgregarMarco(a:fac-2..c:fac,2,0,0)
  AgregarMarco(g:fac-1..g:fac,2,0,0)
  AgregarMarco(d:fac-2..f:fac,2,0,0)
  AgregarMarco(h:fac-2..h:fac,2,0,0)
  SetFont(a:fac..h:fac,2)
  AlinearCeldas(a:fac-2..h:fac,'C')
  IFA
*-------------------------------------------------------(B)------------------
  act(a:fac,' ENTIDAD')
  act(h:fac,'CODIGO ENTIDAD')
  AlinearCeldas(h:fac..h:fac,'C')
  SetFont(a:fac..h:fac,1)

  act(a:fac+1,BuscarCampo('VEHICULOS','Descripcion','Codigo',VAR('VEHICULODE')))
  act(e:fac  ,BuscarCampo('CLIENTES','RazonSocial','Codigo',VAR('VEHICULODE')))
  act(e:fac+1,'C.U.I.T. '~BuscarCampo('CLIENTES','CUIT','Codigo',VAR('VEHICULODE')))


  act(h:fac+1,'00322')
  AlinearCeldas(h:fac+1..h:fac+1,'C')
  AgregarMarco(a:fac..g:fac+1,2,0,0)
  AgregarMarco(h:fac..h:fac+1,2,0,0)
  IFA
  IFA
*------------------------------------------------------(C)-------------------
  act(a:fac,' SOLICITANTE')
  act(g:fac,'CUIT / CUIL')
  act(h:fac,'/ DNI (*)')
  AlinearCeldas(g:fac..g:fac,'D')
  AlinearCeldas(h:fac..h:fac,'I')
  SetFont(a:fac..h:fac,1)
  AgregarMarco(a:fac..f:fac+1,2,0,0)
  AgregarMarco(g:fac..h:fac+1,2,0,0)
  ACT(RZ:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente')))
  act(a:fac+1,iif(Vacio(fbn('RazonSocial')), Val(RZ:1),fbn('RazonSocial')))
  act(g:fac+1,fbn('NrDocum'))
  AlinearCeldas(g:fac+1,'D')
  IFA
  IFA
*------------------------------------------------------(D)------------------- 
  act(a:fac,' DOMICILIO')
  act(f:fac,'COD.POSTAL')
  act(g:fac,'COD.PAIS ORIG.(**)')
  act(h:fac,'F.DE INGRESO(**)')
  SetFont(a:fac..h:fac,1)
  AgregarMarco(a:fac..e:fac+1,2,0,0)
  AgregarMarco(f:fac..f:fac+1,2,0,0)
  AgregarMarco(g:fac..g:fac+1,2,0,0)
  AgregarMarco(h:fac..h:fac+1,2,0,0)
  if Vacio(fbn('Domicilio'))
     act(z11,Trim(BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Cliente')))~' '~Trim(BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Cliente'))))
     act(z12,Trim(BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Cliente'))))
  else
     act(z11,fbn('Domicilio'))
     act(z12,fbn('CodigoPostal'))
  endif
  act(a:fac+1,Val(z11))
  act(f:fac+1,Val(z12))
  act(g:fac+1,fbn('PaisOrigen'))

  If Not EqStr(fbn('FechaIngreso'),'01/01/1900')
     act(h:fac+1,fbn('FechaIngreso'))
  Endif

  AlinearCeldas(f:fac..h:fac+1,'C')
  IFA
  IFA
*------------------------------------------------------(E)-------------------
  act(a:fac,' CONCEPTO DE LA OPERACION')
  AgregarMarco(a:fac..h:fac+1,2,0,0)
  if Incluido(fbn('Arbitraje'),'V|C|')
     act(a:fac+1,'Arbitraje - '~Trim(BuscarCampo('CONCEPTOSBCRA','Descripcion','Codigo',fbn('Concepto'))))
  else
     act(a:fac+1,BuscarCampo('CONCEPTOSBCRA','Descripcion','Codigo',fbn('Concepto')))
  endif
  act(a:fac+1,VAL(A:FAC+1)~'   ('~BuscarCampo('OPERACIONES','Mercado','NrOperacion',fbn['NrOperacion'])~'/'~BuscarCampo('OPERACIONES','Mercado2','NrOperacion',fbn['NrOperacion'])~')')
  IFA
  IFA
*------------------------------------------------------(F)------------------- 
  act(a:fac,'COD.INSTRUM.COMPRADO')
  act(c:fac,' CODIGO MONEDA')
  act(E:fac,'IMPORTE EN MONEDA EXTRANJERA')
  act(h:fac,'TIPO DE CAMBIO')   AgregarMarco(a:fac..b:fac+1,2,0,0)
  AgregarMarco(c:fac..c:fac+1,2,0,0)                   
  AgregarMarco(d:fac..H:fac+1,2,0,0)
  AgregarMarco(d:fac+2..H:fac+3,2,0,0)
  AgregarMarco(h:fac..h:fac+1,2,0,0)
  AlinearCeldas(a:fac..C:fac,'i')
  AlinearCeldas(f:fac..f:fac+2,'D')
  AlinearCeldas(g:fac..g:fac,'I')
  AlinearCeldas(h:fac..h:fac,'C')
  SetFont(a:fac..h:fac,1)
  
  act(a:fac+1,fbn('InsComprado'))
  act(C:fac+1,BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Moneda')))
  acn(g:fac+1,fbn('Cantidad'))
                                    ***** Tratamiento del Tipo de Cambio  *****
  If EqStr(VAL(MB:1),'0')
     acn(h:fac+1,Val(TC:1)) * Tipo de cambio = Precio1 de Operaciones
  Else  
     If EqStr(VAL(CB:5),'1')
        acn(h:fac+1,Val(TC:2))   * Tipo de Cambio = Cantidad / TotalBrutoCli1 de Operaciones    
     Else     
        acn(h:fac+1,Val(TC:5))   * Tipo de Cambio = TotalBrutoCli1 / Cantidad de Operaciones
     Endif
  Endif
  
  FormatoCeldas(h:fac+1, Exe('F7'))
  AlinearCeldas(a:fac+1..d:fac+1,'C')
  AlinearCeldas(g:fac+1..g:fac+3,'I')
  IFA
  IFA
*-------------------------------------------------------(G)------------------ 
  act(a:fac,'COD.INSTRUMENTO VENDIDO')
  act(c:fac,' CODIGO MONEDA')
  act(E:fac,'IMPORTE EN MONEDA EXTRANJERA')
  act(h:fac,'TIPO DE CAMBIO')
  AlinearCeldas(h:fac,'C')  
  AlinearCeldas(E:fac+1,'C')
   
  AgregarMarco(a:fac..b:fac+1,2,0,0)
  AgregarMarco(c:fac..c:fac+1,2,0,0) 
  AgregarMarco(a:fac..g:fac+1,2,0,0)
  AgregarMarco(h:fac..h:fac+1,2,0,0) 

  act(a:fac+1,fbn('InsVendido'))
  act(C:fac+1,BuscarCampo('ESPECIES','Nombre','Codigo',Val(CE:1)))
  acn(g:fac+1,Val(CQ:1))         * Importe en Monex Vendido = Cantidad del FXV de CambiosBCRA  
                                   ***** Tratamiento del Tipo de Cambio  *****
  If EqStr(VAL(MB:1),'0')
    If EqStr(VAL(CB:5),'1')
       acn(h:fac+1,Val(TC:2))   * Tipo de Cambio = Cantidad / TotalBrutoCli1 de Operaciones    
    Else     
       acn(h:fac+1,Val(TC:5))   * Tipo de Cambio = TotalBrutoCli1 / Cantidad de Operaciones
    Endif  
  Else  
    acn(h:fac+1,Val(TC:1))       * Tipo de cambio = Precio1 de Operaciones   
  Endif

 
  AlinearCeldas(a:fac+1..c:fac+1,'C')
  AlinearCeldas(g:fac+1..g:fac+1,'I')
  AlinearCeldas(h:fac+1..h:fac+1,'D')
  FormatoCeldas(h:fac+1, Exe('F7'))
  SetFont(a:fac..h:fac,1)
  IFA
  IFA
*------------------------------------------------------(H)-------------------
  act(a:fac,' BANCO RECIBIDOR DEL EXTERIOR (**)')
  act(h:fac,'CODIGO SWIFT')
  AlinearCeldas(h:fac,'C')
  AgregarMarco(a:fac..g:fac+1,2,0,0)
  AgregarMarco(h:fac..h:fac+1,2,0,0)
*------- 
  act(CT:3,BuscarCampo('CUENTAS','Corresponsal','Codigo',Val(CT:3)))
  act(a:fac+1,BuscarCampo('CORRESPONSALES','Nombre','Codigo',Val(CT:3)))
  act(h:fac+1,BuscarCampo('CORRESPONSALES','SWIFTAddress','Codigo',Val(CT:3)))
*-------
  SetFont(a:fac..h:fac,1)
  AlinearCeldas(h:fac+1,'C')
  IFA
  IFA
*------------------------------------------------------(I)-------------------
  act(a:fac,' BANCO REMITIDO DEL EXTERIOR (**)')
  act(h:fac,'CODIGO SWIFT')
  AlinearCeldas(h:fac,'C')
  AgregarMarco(a:fac..g:fac+1,2,0,0)
  AgregarMarco(h:fac..h:fac+1,2,0,0)
*-------
  act(CT:4,BuscarCampo('CUENTAS','Corresponsal','Codigo',Val(CT:4)))
  act(a:fac+1,BuscarCampo('CORRESPONSALES','Nombre','Codigo',Val(CT:4)))
  act(h:fac+1,BuscarCampo('CORRESPONSALES','SWIFTAddress','Codigo',Val(CT:4)))
*-------
  AlinearCeldas(h:fac+1,'C')
  SetFont(a:fac..h:fac,1)
  IFA
  IFA
*------------------------------------------Corredores y Comisiones----(No Operativo)-----------
  if NO Y Not EqStr(BuscarCampo('OPERACIONES','Corredor','NrOperacion',fbn['NrOperacion']),Var('SINCORR')) y Not EqStr(Copy(fbn['NrOperacion'],1,2),'OF')
     act(a:fac,' COD.CORREDOR')
     act(b:fac,'NOMBRE CORREDOR')
     act(g:fac,'% COMIS.')
     act(h:fac,'COMISION')
     AlinearCeldas(a:fac..a:fac,'C')
     AlinearCeldas(e:fac..h:fac,'C')
     SetFont(a:fac..h:fac,1)
     AgregarMarco(a:fac..a:fac+1,2,0,0)
     AgregarMarco(g:fac..g:fac+1,2,0,0)
     AgregarMarco(h:fac..h:fac+1,2,0,0)
     act(a:fac+1,BuscarCampo('OPERACIONES','Corredor','NrOperacion',fbn['NrOperacion']))
     act(b:fac+1,BuscarCampo('CORREDORES','Nombre','Codigo',Val(a:fac+1)))
     acn(g:fac+1,BuscarCampo('OPERACIONES','Comision','NrOperacion',fbn['NrOperacion']))
     acn(h:fac+1,BuscarCampo('OPERACIONES','TotalComisiones','NrOperacion',fbn['NrOperacion']))
     AlinearCeldas(a:fac+1..a:fac+1,'C')
     AlinearCeldas(g:fac+1..g:fac+1,'C')
     IFA
     IFA
  endif
  acn(x10,fac)
*-------------------------------------------------------(J)------------------
*- Texto de venta de cambio de clientes fisicos
        act(a:fac   ,' Declaro bajo  juramento  que las  informaciones  consignadas  son  exactas y  verdadera, en los términos previstos en el Regimen Penal Cambiario, del cual tengo pleno ')
        act(a:fac+1 ,' conocimiento de sus normas y sanciones. ')
        act(a:fac+2 ,' Declaro bajo juramento que los fondos son propios y de origen licito. ')
        act(a:fac+3 ,' En cumplimiento a lo normado por la Comunicación "A" 4349 del Banco Central de la República Argentina, para personas físicas y jurídicas residentes en el país, declaro/mos ')
        act(a:fac+4 ,' bajo juramento que:  1. ,he/mos dado cumplimiento, de corresponder, a las presentaciones con vencimientos operados del regimen de declaración de deuda externa de la ')
        act(a:fac+5 ,' Comunicación "A" 3602 y complementarias, y, 2. no registro/mos deudas vencidas e impagas con el exterior por servicios de capital e interes de deudas de todo tipo. ')
        act(a:fac+6 ,' Asimismo declaro/mos tener previo conocimiento de las normas legales y reglamentarias que regulan el acceso al Mercado Unico y Libre de Cambios y la formación de activos ')
        act(a:fac+7 ,' externos. En cumplimiento a lo normado por la Comunicación "A" 3722 y complementarias del Banco Central de la República Argentina para personas físicas y jurídicas residentes')
        act(a:fac+8 ,' en el país, declaro/mos bajo juramento que, durante el presente mes calendario mis/nuestras compras de billetes y divisas en moneda extranjera, por la  suma de todos los ')
        act(a:fac+9 ,' conceptos indicados en la Comunicación "A" 3909 y complementarias y en el conjunto de las entidades autorizadas a operar en cambios, no han superado el equivalente en ')
        act(a:fac+10,' dólares estadounidenses de dos millones (U$S 2.000.000.-) ')

      * Texto alternativo
      *  act(a:fac   ,' Declaro bajo  juramento  que las  informaciones  consignadas  son  exactas y  verdadera, en los términos previstos en el Regimen Penal Cambiario, del cual tengo pleno ')
      *  act(a:fac+1 ,' conocimiento de sus normas y sanciones.  Declaro bajo juramento que los fondos son propios y de origen licito. ')
      *  act(a:fac+2 ,' En cumplimiento a lo normado por la Comunicación "A" 4359 y Comunicación "A" 4377 punto 1.b. del Banco Central de la República Argentina para personas físicas y ')
      *  act(a:fac+3 ,' jurídicas residentes en el país: declaro/mos bajo juramento que, durante el presente mes calendario mis/nuestras ventas de billetes y divisas en moneda extranjera, ')
      *  act(a:fac+4 ,' por la suma de activos externos y en el conjunto de entidades autorizadas a operar en cambios, no han superado el equivalente en dólares estadounidenses de ')
      *  act(a:fac+5 ,' dos millones (U$S 2.000.000.-).    ')

  act(b:fac+13,'_______________________')
  act(g:fac+13,'___________________________________')
  act(b:fac+14,'Firma')
  act(g:fac+14,'Aclaración y Nro. de documento')
  SetFont(a:fac..h:fac+14,1)
  AlinearCeldas(b:fac+7..g:fac+14,'C')
  AgregarMarco(a:fac..h:fac+14,2,0,0)

  SetFilaActual(fac+15)
  act(a:fac,' Certificamos que la/s firma/s que anteceden concuerdan con las registradas en nuestros libros (***)')
  act(b:fac+5,'_______________________')
  act(g:fac+5,'___________________________________')
  act(b:fac+6,'Fecha')
  act(g:fac+6,'Firma y Sello')
  SetFont(a:fac..h:fac+6,1)
  AlinearCeldas(b:fac+5..g:fac+6,'C')
  AgregarMarco(a:fac..h:fac+10,2,0,0)
  SetFilaActual(fac+6)
  act(a:fac+1,'  (*) - Cuando se trate de un turista debe registrarse fecha de ingreso al pais, codigo de pais de origen y numero de pasaporte o documento habilitante para ingresar al pais')
  act(a:fac+2,' (**) - Cuando corresponde de acuerdo a la operacion solicitada')
  act(a:fac+3,'(***) - Cuando el solicitante no tenga firma registrada en la entidad por tratarse de un particular, la certificacion se refiere a que la firma fue puesta en presencia del funcionario')
  act(a:fac+4,'        certificante y que se constato su identidad mediante verificacion del documento de identidad.')
  SetFont(a:fac+1..a:fac+4,1)

****** Inclusion de Sucursal y Nro de Operacion en el Pie del Boleto : 14 Nov 2007
  act(x:1,BuscarCampo('VARIABLES','Nombre','Codigo','SUCURSAL')) 
  act(g:fac+5,'                           '~fbn('NrOperacion'))
  act(a:fac+5,'Nro.Sucursal: '~VAR('SUCURSAL')~' '~val(x:1))
  
  SetFont(g:fac+5,3) 
  SetFont(a:fac+5,3)
  SetFilaActual(fac+6)

* ---------------- *
  SaltarHoja(fac)
* ---------------- *
  SetFilaActual(fac+1)
Proximo