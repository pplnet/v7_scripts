*- CALCCOMCTA
*- Calculo Comision Apertura/Mant.Cta
*- Recibe como parametro ca1: Tipo de Arancel y ca2: Nombre Transaccion a Grabar
*- Devuelve los totales en ta1: Total arancel; ti1: Total iva y tt1:Total total

act(a:fac,FBN['Cliente'])
act(b:fac,BuscarCampo('CLIENTES','RazonSocial','Codigo',val(a:fac)))
acn(c:fac,MontoArancelC(,FBN['Cliente'],,Dialogo.Vehiculo1,val(ca1),100,2,,BuscarCampo('Clientes','TipoCliente','Codigo',FBN['Cliente']),SI,,,,,SI))

*- primero toma las permanentes, sino elige las otras
act(g:Fac,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Cliente']~"' and Especies Like '%"~VAR('MONELOCA')~"%' and Estado='HAB'  and TipoCuenta In('CC','CA') and Permanente='SI' ") )

If Vacio(val(g:fac))
   act(g:Fac,SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~FBN['Cliente']~"' and Especies Like '%"~VAR('MONELOCA')~"%' and Estado='HAB'  and TipoCuenta In('CC','CA')") )
EndIf

If Val(c:fac) <> 0 
   If Vacio(Val(g:Fac))
      act(g:Fac,Val(dz3) ) 
   endif

   *- d: Calculo del % del Iva sobre comisiones
   acn(d:fac,IIF(Not EQSTR(BUSCARCAMPO('CLIENTES','CondicionGan','Codigo',FBN['Cliente']),'NOR'),Var('IVA')+IIF(EQSTR(BUSCARCAMPO('CLIENTES','CondicionIVA','Codigo',FBN['Cliente']),'NOI'),VAR('RNI'),IIF(EQSTR(BUSCARCAMPO('CLIENTES','Res3125','Codigo',FBN['Cliente']),'SI'),Var('RG3337'),0)),Var('IVA'))  )

   *- e: Monto de Iva
   acn(e:fac,ROUND(Abs(val(c:fac))*Val(d:fac) /100,2)  )

   *-h: Total a cobrar 
   acn(h:fac, Val(c:fac)+Val(e:fac))

   *- Sumo totales
   scn(ta1,val(c:fac))
   scn(ti1,val(e:fac))
   scn(tt1,val(h:fac))
   
Else 
   Message('Cliente  '~FBN['Cliente']~' sin arancel asignado ' )
EndIf

SetFont(a:fac..h:fac,1)