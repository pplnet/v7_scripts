if Dialogo.Radio4=0 o Dialogo.Radio4=1 o Dialogo.Radio4=2
  ******************
  * TITULOS Y FONDOS
  ******************
  if Dialogo.Radio4=0 o Dialogo.Radio4=1
    *********
    * TITULOS
    *********
    ACT(x:1, 'PUBLIC')
    ACT(x:2, 'EXTRAN')
    ACT(x:3, 'CORP B')
    ACT(x:4, 'ACCION')
    ACT(x:5, 'INDICE')

    recorrer&i 1,5
      if &i>1
        SQL.ADD(" Union All ")
      endif

      SQL.ADD("Select 'TITULOS' Familia, P.Especie, P.Cupon, P.Vehiculo, P.Book, ")
      SQL.ADD("       E.Cotiza, E.InteresesC, ")
      SQL.ADD("       P.Fecha, P.NrSaldo, ")
      SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
      SQL.ADD("       P.Cantidad1, P.Precio1, ")
      SQL.ADD("       P.Cantidad2, P.Precio2, ")
      SQL.ADD("       P.CantidadFin, P.PrecioFin ")
      SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".BOOKS B ")
      SQL.ADD(" where P.Especie              =  E.Codigo ")
      SQL.ADD("   and E.Codigo               in ("~Pipe2Comillas(Descendientes('ESPECIES', Val(x:&i)))~") ")
      SQL.ADD("   and P.Book                 =  B.Codigo ")
      SQL.ADD("   and P.NrSaldo              =  120 ")
      SQL.ADD("   and IsNull(E.EsCupon,'NO') = 'NO' ")
      SQL.ADD("   and P.TipoNegocio          =  'SEC' ")
      SQL.ADD("   and P.CantidadFin <> 0 ")
      If NoVacio(Dialogo.Lista1)
        SQL.ADD(" and P.Vehiculo             in ("~Pipe2Comillas(val(r:1))~") ")
      ELSE
        If NoVacio(Dialogo.Vehiculo2)
          SQL.ADD(" and P.Vehiculo            in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
        EndIf
      endif
*      if NoVacio(Val(r:3))
*        SQL.ADD(" and P.Book                 in ("~Pipe2Comillas(val(r:3))~") ")
*      endif
      If NoVacio(Dialogo.Lista2)
        SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
      endif
      If NoVacio(Dialogo.Lista3)
        SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
      endif
      SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
      SQL.ADD("                        from "~DBO~".POSICIONES P1 ")
      SQL.ADD("                       where P1.Especie          =  P.Especie ")
      SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
      SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
      SQL.ADD("                         and IsNull(P1.Book,'')  =  IsNull(P.Book,'') ")
      SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
      SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
      SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
    SQL.ADD("                       ) ")
    proximo
  endif
  if Dialogo.Radio4=0
    SQL.ADD(" Union All ")
  endif
  if Dialogo.Radio4=0 o Dialogo.Radio4=2
    ********
    * FONDOS
    ********
    SQL.ADD("Select 'FONDOS' Familia, P.Especie, P.Cupon, P.Vehiculo, P.Book, ")
    SQL.ADD("       E.Cotiza, E.InteresesC, ")
    SQL.ADD("       P.Fecha, P.NrSaldo, ")
    SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
    SQL.ADD("       P.Cantidad1, P.Precio1, ")
    SQL.ADD("       P.Cantidad2, P.Precio2, ")
    SQL.ADD("       P.CantidadFin, P.PrecioFin ")
    SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".BOOKS B ")
    SQL.ADD(" where P.Especie      =  E.Codigo ")
    SQL.ADD("   and P.Book         =  B.Codigo ")
    SQL.ADD("   and P.NrSaldo      =  121 ")
    SQL.ADD("   and P.TipoNegocio  =  'FC' ")
    If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
    ELSE
      If NoVacio(Dialogo.Vehiculo2)
        SQL.ADD(" and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
      EndIf
    endif
*    if NoVacio(Val(r:3))
*      SQL.ADD(" and P.Book                 in ("~Pipe2Comillas(val(r:3))~") ")
*    endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    endif
    If NoVacio(Dialogo.Lista3)
      SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
    endif
    SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
    SQL.ADD("                        from "~DBO~".POSICIONES P1 ")
    SQL.ADD("                       where P1.Especie          =  P.Especie ")
    SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
    SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
    SQL.ADD("                         and IsNull(P1.Book,'')  = IsNull(P.Book,'') ")
    SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
    SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
    SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
    SQL.ADD("                     ) ")
  endif

  SQL.ADD(" order by E.Cotiza, P.Especie, P.Vehiculo, P.Book, P.Cupon, P.NrSaldo ")

  Recorrer SQL
    DFA
    SCN(z:5, 1)
    ACT(ba:Val(z:5), fbn('Especie'))
    ACT(bb:Val(z:5), fbn('Cupon'))
    ACT(bc:Val(z:5), fbn('Vehiculo'))
    ACT(bd:Val(z:5), fbn('Book'))
    ACT(be:Val(z:5), fbn('Cotiza'))
    ACN(bf:Val(z:5), fbn('CantidadFin'))
    ACN(bg:Val(z:5), fbn('PrecioFin'))
    ACN(bh:Val(z:5), Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1-1,1))
    ACN(bq:Val(z:5), fbn('NrSaldo'))
    ACT(br:Val(z:5), fbn('Familia'))
    * Net Marcket Value
    ACN(bi:Val(z:5), fbn('CantidadFin')*Val(bh:Val(z:5))*iif(Eqstr(fbn('InteresesC'),'CLE'),ValorTeorico(fbn('Especie')),1))

    recorrer&i Val(w:2),Val(w:3)
      if EqStr(Val(aa:&i),fbn('Vehiculo'))
        ACN(bj:Val(z:5), &i)
        Break
      endif
    proximo
    if Val(bj:Val(z:5))<>0
      ACN(bk:Val(z:5), Val(ad:Val(bj:Val(z:5))))
    endif
    recorrer&i 2,Val(z:2)
      if EqStr(Val(ar:&i),fbn('Cotiza'))
        ACN(bl:Val(z:5), &i)
        Break
      endif
    proximo
    if Val(bl:Val(z:5))=0
      SCN(z:2, 1)
      ACT(ar:Val(z:2), fbn('Cotiza'))
      ACN(as:Val(z:2), CotizacionC(fbn('Cotiza'),,,,Dialogo.Fecha1-1,1,,'USD'))
      ACN(bl:Val(z:5), Val(z:2))
      ACN(bm:Val(z:5), 1)
    endif
    if Not Incluido(fbn('Cotiza'),'ARP')
      if Val(z:4)>1
        recorrer&i 2,Val(z:4)
          if EqStr(Val(ax:&i),fbn('Cotiza'))
            ACN(bn:Val(z:5), &i)
            Break
          endif
        proximo
      endif
      if Val(bn:Val(z:5))=0
        SCN(z:4, 1)
        ACT(ax:Val(z:4), fbn('Cotiza'))
        ACT(ay:Val(z:4), BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Cotiza')))
        ACN(az:Val(z:4), Cotizacion(fbn('Cotiza'),,,,Dialogo.Fecha1-1,1))
        ACN(bn:Val(z:5), Val(z:4))
        ACN(bo:Val(z:5), 1)
      endif
    endif
    if Val(bj:Val(z:5))<>0
      SCN(Val(bl:Val(z:5)):Val(bj:Val(z:5)), Val(bi:Val(z:5)))
      if Val(bk:Val(z:5))<>0
        SCN(Val(bl:Val(z:5)):Val(bk:Val(z:5)), Val(bi:Val(z:5)))
      endif
      SCN(at:Val(bl:Val(z:5)), Val(bi:Val(z:5)))
      ACT(bp:Val(z:5), 'OK')
    endif
  proximo
endif

if Dialogo.Radio4=0 o Dialogo.Radio4=3
  ************
  * MONEDAS
  ************
  ************************************
  * Posiciones Spot de Monedas
  ************************************
  SQL.ADD("Select 'MONEDAS' Familia, P.Especie, P.Cupon, P.Vehiculo, P.Book, P.Cliente, ")
  SQL.ADD("       '0' Tipo, ")
  SQL.ADD("       P.Fecha, P.NrSaldo, P.FechaEj, ")
  SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
  SQL.ADD("       P.Cantidad1, P.Precio1, ")
  SQL.ADD("       P.Cantidad2, P.Precio2, ")
  SQL.ADD("       P.CantidadFin, P.PrecioFin ")
  SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".BOOKS B ")
  SQL.ADD(" where P.NrSaldo      =  122 ")
  SQL.ADD("   and P.TipoNegocio  =  'FXS' ")
  SQL.ADD("   and P.Especie      Not in ('USD','ARP') ")
  SQL.ADD("   and P.Book         =  B.Codigo ")
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
  ELSE
    If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD(" and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
    EndIf
  endif
*  if NoVacio(Val(r:3))
*    SQL.ADD(" and P.Book                 in ("~Pipe2Comillas(val(r:3))~") ")
*  endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  endif
  If NoVacio(Dialogo.Lista3)
    SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  endif
  SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
  SQL.ADD("                        from  "~DBO~".POSICIONES P1 ")
  SQL.ADD("                       where P1.Especie          =  P.Especie ")
  SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
  SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
  SQL.ADD("                         and IsNull(P1.Book,'')  =  IsNull(P.Book,'') ")
  SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
  SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
  SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("                     ) ")

  if Dialogo.Check1=1

    SQL.ADD(" Union All ")
    ************************************
    * Saldos en Ctas Vista
    ************************************
    SQL.ADD("Select 'MONEDAS' Familia, P.Especie, P.Cupon, P.Vehiculo, P.Book, P.Cliente, ")
    SQL.ADD("       '1' Tipo, ")
    SQL.ADD("       P.Fecha, P.NrSaldo, P.FechaEj, ")
    SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
    SQL.ADD("       P.Cantidad1, P.Precio1, ")
    SQL.ADD("       P.Cantidad2, P.Precio2, ")
    SQL.ADD("       P.CantidadFin, P.PrecioFin ")
    SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".BOOKS B ")
    SQL.ADD(" where P.NrSaldo      = 150 ")
    SQL.ADD("   and P.TipoNegocio  = 'MCV' ")
    SQL.ADD("   and P.Book         = B.Codigo ")
    SQL.ADD("   and P.CantidadFin  > 0 ")
    If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
    ELSE
      If NoVacio(Dialogo.Vehiculo2)
        SQL.ADD(" and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
      EndIf
    endif
*    if NoVacio(Val(r:3))
*      SQL.ADD(" and P.Book                 in ("~Pipe2Comillas(val(r:3))~") ")
*    endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    endif
    If NoVacio(Dialogo.Lista3)
      SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
    endif
    SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
    SQL.ADD("                        from  "~DBO~".POSICIONES P1 ")
    SQL.ADD("                       where P1.Especie          =  P.Especie ")
    SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
    SQL.ADD("                         and P1.Cliente          =  P.Cliente ")
    SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
    SQL.ADD("                         and IsNull(P1.Book,'')  =  IsNull(P.Book,'') ")
    SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
    SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
    SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
    SQL.ADD("                     ) ")

  endif

IF NO
  ****************************************************************************
  ** FJL - Se sacaron las posiciones futuras por pedido de M.Salas el 23/01/09
  ****************************************************************************
  SQL.ADD(" Union All ")
  ************************************
  * Posiciones Futuras de Monedas
  ************************************
  SQL.ADD("Select 'MONEDAS' Familia, P.Especie, P.Cupon, P.Vehiculo, P.Book, P.Cliente, ")
  SQL.ADD("       '2' Tipo, ")
  SQL.ADD("       P.Fecha, P.NrSaldo, P.FechaEj, ")
  SQL.ADD("       P.CantidadIni, P.PrecioIni, ")
  SQL.ADD("       P.Cantidad1, P.Precio1, ")
  SQL.ADD("       P.Cantidad2, P.Precio2, ")
  SQL.ADD("       P.CantidadFin, P.PrecioFin ")
  SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".BOOKS B ")
  SQL.ADD(" where P.NrSaldo      =  123 ")
  SQL.ADD("   and P.FechaEj      >= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("   and P.TipoNegocio  =  'FXF' ")
  SQL.ADD("   and P.Especie      = 'USD' ")
  SQL.ADD("   and P.Book         =  B.Codigo ")
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" and P.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
  ELSE
    If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD("and P.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
    EndIf
  endif
*  if NoVacio(Val(r:3))
*    SQL.ADD(" and P.Book                 in ("~Pipe2Comillas(val(r:3))~") ")
*  endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  endif
  If NoVacio(Dialogo.Lista3)
    SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  endif
  SQL.ADD("   and P.Fecha     = (select Max(P1.Fecha) ")
  SQL.ADD("                        from  "~DBO~".POSICIONES P1 ")
  SQL.ADD("                       where P1.Especie          =  P.Especie ")
  SQL.ADD("                         and IsNull(P1.Cupon,'') =  IsNull(P.Cupon,'') ")
  SQL.ADD("                         and P1.Vehiculo         =  P.Vehiculo ")
  SQL.ADD("                         and P1.FechaEj          =  P.FechaEj ")
  SQL.ADD("                         and IsNull(P1.Book,'')  =  IsNull(P.Book,'') ")
  SQL.ADD("                         and P1.NrSaldo          =  P.NrSaldo ")
  SQL.ADD("                         and P1.TipoNegocio      =  P.TipoNegocio ")
  SQL.ADD("                         and P1.Fecha            <= "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD("                     ) ")
ENDIF

  SQL.ADD(" order by P.Especie, Tipo, P.Vehiculo, P.Book, P.NrSaldo ")
  Recorrer SQL
    DFA
    SCN(z:6, 1)
    ACT(ca:Val(z:6), fbn('Especie'))
    ACT(cb:Val(z:6), fbn('Cupon'))
    ACT(cc:Val(z:6), fbn('Vehiculo'))
    ACT(cd:Val(z:6), fbn('Book'))
    if Incluido(fbn('Tipo'),'1')
      ACT(ce:Val(z:6), fbn('Cliente'))
    endif
    ACN(cf:Val(z:6), fbn('CantidadFin'))
    ACN(cg:Val(z:6), fbn('PrecioFin'))
    ACN(ch:Val(z:6), Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1-1,1))
    ACN(cq:Val(z:6), fbn('NrSaldo'))
    ACT(cr:Val(z:6), fbn('Familia'))
    ACT(cs:Val(z:6), fbn('Tipo'))
    if Incluido(fbn('Tipo'),'0|1')
      ACN(ci:Val(z:6), fbn('CantidadFin'))
    endif
    if Incluido(fbn('Tipo'),'2')
      if Val(z:7)>1
        recorrer&i 2,Val(z:7)
          if EqStr(fbn('Especie'),Val(an:&i)) y EqStr(fbn('Vehiculo'),Val(ao:&i))
            ACN(ct:Val(z:6), &i)
          endif
        proximo
      endif
      if Val(ct:Val(z:6))=0
        SCN(z:7, 1)
        ACT(an:Val(z:7), fbn('Especie'))
        ACT(ao:Val(z:7), fbn('Vehiculo'))
        ACN(ct:Val(z:6), Val(z:7))
      endif
      if Vacio(Val(ap:Val(ct:Val(z:6))))
        LinkearHoja('RFXF01',1,Vehiculo2='',Lista1=fbn('Vehiculo'),Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1='USD',Radio3=1)
        ACN(cu:Val(z:6), LinkH(1,aw:1))
        * Net Market Value
        ACN(ci:Val(z:6), LinkH(1,d:Val(cu:Val(z:6))))
        CerrarHoja('RFXF01',1,Vehiculo2='',Lista1=fbn('Vehiculo'),Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1='USD',Radio3=1)
        ACT(ap:Val(ct:Val(z:6)), 'LISTO')
      endif
    endif

    recorrer&i Val(w:2),Val(w:3)
      if EqStr(Val(aa:&i),fbn('Vehiculo'))
        ACN(cj:Val(z:6), &i)
        Break
      endif
    proximo
    if Val(cj:Val(z:6))<>0
      ACN(ck:Val(z:6), Val(ad:Val(cj:Val(z:6))))
    endif
    recorrer&i 2,Val(z:2)
      if EqStr(Val(ar:&i),fbn('Especie'))
        ACN(cl:Val(z:6), &i)
        Break
      endif
    proximo
    if Val(cl:Val(z:6))=0
      SCN(z:2, 1)
      ACT(ar:Val(z:2), fbn('Especie'))
      ACN(as:Val(z:2), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,,'USD'))
      ACN(cl:Val(z:6), Val(z:2))
      ACN(cm:Val(z:6), 1)
    endif
    if Not Incluido(fbn('Especie'),'ARP')
      if Val(z:4)>1
        recorrer&i 2,Val(z:4)
          if EqStr(Val(ax:&i),fbn('Especie'))
            ACN(cn:Val(z:6), &i)
            Break
          endif
        proximo
      endif
      if Val(cn:Val(z:6))=0
        SCN(z:4, 1)
        ACT(ax:Val(z:4), fbn('Especie'))
        ACT(ay:Val(z:4), BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')))
        ACN(az:Val(z:4), Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1-1,1))
        ACN(cn:Val(z:6), Val(z:4))
        ACN(co:Val(z:6), 1)
      endif
    endif
    if Val(cj:Val(z:6))<>0
      SCN(Val(cl:Val(z:6)):Val(cj:Val(z:6)), Val(ci:Val(z:6)))
      if Val(ck:Val(z:6))<>0
        SCN(Val(cl:Val(z:6)):Val(ck:Val(z:6)), Val(ci:Val(z:6)))
      endif
      SCN(at:Val(cl:Val(z:6)), Val(ci:Val(z:6)))
      ACT(cp:Val(z:6), 'OK')
    endif
  proximo
endif

if Dialogo.Radio4=0 o Dialogo.Radio4=4
  ***************
  * TIME DEPOSITS
  ***************
  SQL.ADD("Select O.NrOperacion, O.TipoOp,   O.Especie,   O.FechaOp, ")
  SQL.ADD("       O.FechaVto,    O.Cantidad, O.Vehiculo1, O.Book1 ")
  SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".BOOKS B ")
  SQL.ADD(" where O.FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   and O.FechaVto  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   and O.TipoOp    In ('MMCPM','MMCCR') ")
  SQL.ADD("   and O.Especie   in ('ARP','USD') ")
  SQL.ADD("   and O.Book1     =  B.Codigo ")
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
  ELSE
    If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
    EndIf
  endif
*  if NoVacio(Val(r:3))
*    SQL.ADD(" and O.Book1                 in ("~Pipe2Comillas(val(r:3))~") ")
*  endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
  endif
  If NoVacio(Dialogo.Lista3)
    SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  endif

  SQL.ADD(" order by O.NrOperacion ")
  recorrer SQL
    DFA
    SCN(z:8, 1)
    ACT(da:Val(z:8), fbn('NrOperacion'))
    ACT(db:Val(z:8), fbn('TipoOp'))
    ACT(dc:Val(z:8), fbn('Especie'))
    ACT(dd:Val(z:8), fbn('Vehiculo1'))
    ACT(de:Val(z:8), fbn('Book1'))
    ACN(df:Val(z:8), fbn('Cantidad'))
    LinkearHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=0,Radio3=1)
    ACN(dg:Val(z:8), LinkH(1,az:6))
    * Net Market Value
    ACN(di:Val(z:8), LinkH(1,k:Val(dg:Val(z:8))))
    CerrarHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=0,Radio3=1)

    recorrer&i Val(w:2),Val(w:3)
      if EqStr(Val(aa:&i),fbn('Vehiculo1'))
        ACN(dj:Val(z:8), &i)
        Break
      endif
    proximo
    if Val(dj:Val(z:8))<>0
      ACN(dk:Val(z:8), Val(ad:Val(dj:Val(z:8))))
    endif
    recorrer&i 2,Val(z:2)
      if EqStr(Val(ar:&i),fbn('Especie'))
        ACN(dl:Val(z:8), &i)
        Break
      endif
    proximo
    if Val(dl:Val(z:8))=0
      SCN(z:2, 1)
      ACT(ar:Val(z:2), fbn('Especie'))
      ACN(as:Val(z:2), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,,'USD'))
      ACN(dl:Val(z:8), Val(z:2))
      ACN(dm:Val(z:8), 1)
    endif
    if Not Incluido(fbn('Especie'),'ARP')
      if Val(z:4)>1
        recorrer&i 2,Val(z:4)
          if EqStr(Val(ax:&i),fbn('Especie'))
            ACN(dn:Val(z:8), &i)
            Break
          endif
        proximo
      endif
      if Val(dn:Val(z:8))=0
        SCN(z:4, 1)
        ACT(ax:Val(z:4), fbn('Especie'))
        ACT(ay:Val(z:4), BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')))
        ACN(az:Val(z:4), Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1-1,1))
        ACN(dn:Val(z:8), Val(z:4))
        ACN(do:Val(z:8), 1)
      endif
    endif
    if Val(dj:Val(z:8))<>0
      SCN(Val(dl:Val(z:8)):Val(dj:Val(z:8)), Val(di:Val(z:8)))
      if Val(dk:Val(z:8))<>0
        SCN(Val(dl:Val(z:8)):Val(dk:Val(z:8)), Val(di:Val(z:8)))
      endif
      SCN(at:Val(dl:Val(z:8)), Val(di:Val(z:8)))
      ACT(dp:Val(z:8), 'OK')
    endif
  proximo
endif
