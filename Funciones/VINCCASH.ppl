SetFilaActual(9)
*** calcula vinculadas si es por vehiculo ****
If Dialogo.Radio1 = 1
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
   SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int,(O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and (O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, -O.TotalAux3/1000 Imp,1 Precio2, 0 NrCuota  from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0') ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
   SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp, C.Precio2,C.NrCuota  from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCCM') ")
   SQL.ADD(" and O.MB3 = '1' ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

   If Dialogo.Radio3 = 1
      *** toma los eventuales ***
      SQL.ADD(" Union All ")
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and (O.TipoOp In ('MMPCCV') and O.MB3 = '1') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" Union All ")
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and (O.TipoOp In ('VIMIND','VIMINM') and  O.MB3 = '0') ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" Union All ")
      SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
      SQL.ADD("where O.NrOperacion = C.NrOperacion ")
      SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('MMPCCM') ")
      SQL.ADD(" and O.MB3 = '1' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD("order by 1, 3 ")

   Recorrer SQL
      ACN(mt1, FBN['Cant'])
      ACN(mt2, FBN['Int'])
      ACN(mt3, FBN['Imp'])
      
      If FBN['Precio2']=0 y Dialogo.Radio10=1
          ACT(NT:1, fbn('NrOperacion'))
         *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
         (.'MONTOTOMV'.)
      EndIf
      
      ACN(mt11,0)
      
      If Dialogo.Check1=1
         SCN(mt11,Val(mt1))      
      EndIf
      If Dialogo.Check2=1
         SCN(mt11,Val(mt2))      
      EndIf
      If Dialogo.Check3=1
         SCN(mt11,Val(mt3))      
      EndIf

      *ACN(mt12,IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))  )
      ACN(mt12, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(mt50)))
      *messagebox('Especie: '~FBN['Especie']~' Cotizacion: '~Val(mt12))

      *** Diario o Mensual ***
      If Dialogo.Radio2 = 0
         *** Diario ***
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
      Else
         *** Mensual ***
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Val(o:200) > 0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(c:200),Val(mt11)*Val(mt12))
               SCN(Val(p:200)+1:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(c:200),Val(mt11)*Val(mt12))
            SCN(Val(g:200):Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Endif
   Proximo
    
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('VIMIND','VIMINM') ")
   SQL.ADD(" and  O.MB3 = '1' ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
   SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
   SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCCM')  ")
   SQL.ADD(" and O.MB3 = '0' ")
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   If Dialogo.Radio3 = 1
      SQL.ADD(" Union All ")
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('VIMIND','VIMINM') ")
      SQL.ADD(" and  O.MB3 = '1' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" Union All ")
      SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("O.Cantidad/1000 Cant,O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
      SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('MMPCCV')  and O.MB3 = '0' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
      SQL.ADD(" Union All ")
      SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, O.Vehiculo2, ")
      SQL.ADD("C.Cantidad1/1000 Cant, C.Cantidad3/1000 Int, (C.Total3-C.Cantidad3)/1000 Imp,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
      SQL.ADD("where O.NrOperacion = C.NrOperacion ")
      SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD(" and  O.TipoOp In ('MMPCCM')  ")
      SQL.ADD(" and  O.MB3 = '0' ")
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   SQL.ADD("order by 1, 2 ")
   
   Recorrer SQL
      ACN(mt1, FBN['Cant'])
      ACN(mt2, FBN['Int'])
      ACN(mt3, FBN['Imp'])
      
      If FBN['Precio2']=0 y Dialogo.Radio10=1
         ACT(NT:1, fbn('NrOperacion'))
         *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
         (.'MONTOTOMV'.)
      EndIf
            
      ACN(mt11,0)

      If Dialogo.Check1=1
         SCN(mt11,Val(mt1))      
      EndIf
      If Dialogo.Check2=1
         SCN(mt11,Val(mt2))      
      EndIf
      If Dialogo.Check3=1
         SCN(mt11,Val(mt3))      
      EndIf
      
      *ACN(mt12,IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))  )
      ACN(mt12, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(mt50)))
      *messagebox('Especie: '~FBN['Especie']~' Cotizacion: '~Val(mt12))
        
      *** Diario o Mensual ***
      If Dialogo.Radio2 = 0
         *** Diario ***
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
      Else
         *** Mensual ***
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Val(o:200) > 0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(f:200),Val(mt11)*Val(mt12))
               SCN(Val(p:200)+1:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(f:200),Val(mt11)*Val(mt12))
            SCN(Val(g:200):Val(i:200),Val(mt11)*Val(mt12))
         Endif
      Endif
   Proximo
   *-- If de Consolidado
Endif

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Cliente1, ")
SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2 from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.TipoOp In ('TEMIND','TEMINM') and  O.MB3 = '0') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
EndIf

Recorrer SQL
   ACN(mt1, FBN['Cant'])
   ACN(mt2, FBN['Int'])
   ACN(mt3, FBN['Imp']) 
   
   If FBN['Precio2']=0  y Dialogo.Radio10=1
      ACT(NT:1, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
      (.'MONTOTOMV'.)
   EndIf
    
   ACN(mt11,0) 
   
   If Dialogo.Check1=1
      SCN(mt11,Val(mt1))      
   EndIf
   If Dialogo.Check2=1
      SCN(mt11,Val(mt2))      
   EndIf
   If Dialogo.Check3=1
      SCN(mt11,Val(mt3))      
   EndIf
   
   *ACN(mt12,IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))  )
   ACN(mt12, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,,Val(mt50)))
   *messagebox('Especie: '~FBN['Especie']~' Cotizacion: '~Val(mt12))
   
   If DesciendeDeCliente(FBN['Cliente1'],'EMPRESAS') 
      *** Diario o Mensual ***
      If Dialogo.Radio2 = 0
         *** Diario ***
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
      Else
         *** Mensual ***
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Val(o:200) > 0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(c:200),Val(mt11)*Val(mt12))
               SCN(Val(p:200)+1:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(c:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(h:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(c:200),Val(mt11)*Val(mt12))
            SCN(Val(g:200):Val(h:200),Val(mt11)*Val(mt12))
         Endif
      Endif
   Endif
Proximo

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, O.Cliente1, ")
SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, O.TotalAux3/1000 Imp,1 Precio2 from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
