SQL.ADD("Select O.NrOperacion, -O.Cantidad as Cantidad, O.FechaOp, O.TipoOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre, O.Cliente1 as Cliente, O.FechaOp as FechaMov, O.Cuenta1 Cuenta, O.Mercado    ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"'                                              ")
SQL.ADD(" and   O.FechaOp  <= '"~IdxDate(Dialogo.Fecha2)~"'                                              ")
SQL.ADD(" and   O.Especie   = '"~Dialogo.Especie1~"'                                                     ")
SQL.ADD(" and   O.Cliente1  = C.Codigo                                                                   ")
SQL.ADD(" and   O.Especie=E.Codigo                                                                       ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion                                                          ")
SQL.ADD(" and   OB.Valor =  '1'                                                                          ")
SQL.ADD(" and   OB.NrBit <>  30                                                                          ")
SQL.ADD(" and   O.Cuenta1 IN ("~val(li1)~")                                                              ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                                    ")
SQL.ADD(" and   O.TipoOp in ('PMU','PME','MMPICO')                                                       ")






