*********************
* --- SEC Pase Pasivo
*********************
SQL.ADD("Select O.Vehiculo1,    O.Especie,             O.FechaOp,                O.TipoOp, O.NrOperacion, ")
SQL.ADD("       O.FechaEj Vto,  O.TotalBrutoCli1 Cant, O.TotalIntereses Interes, O.TotalBrutoCli2 Monto, ")
SQL.ADD("       O.Book1,        O.ContraEspecie Esp ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES L, "~DBO~".BOOKS B ")
SQL.ADD(" where O.TipoOp    In ('SERP') ")
SQL.ADD("   and L.Codigo    =  O.Cliente1 ")
SQL.ADD("   and L.Jerarquia NOT LIKE '"~VAR('JERVINCUL')~"%' ")
SQL.ADD("   and O.FechaEj   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("   and O.FechaEj   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("   and O.Book1     =  B.Codigo ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.Vehiculo1  in ("~Pipe2Comillas(val(r:1))~") ")
else
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and O.Book1 in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif

SQL.ADD(" order by O.Vehiculo1, Vto ")
recorrer SQL
  SCN(z:9, 1)
  ACT(ea:Val(z:9), fbn('NrOperacion'))
  ACT(eb:Val(z:9), fbn('TipoOp'))
  ACT(ec:Val(z:9), fbn('Especie'))
  ACT(ed:Val(z:9), fbn('Vehiculo1'))
  ACT(ee:Val(z:9), fbn('Book1'))
  ACD(ef:Val(z:9), fbn('FechaOp'))
  ACD(eg:Val(z:9), fbn('Vto'))

  ACN(ei:Val(z:9), fbn('Cant'))
  ACN(eq:Val(z:9), fbn('Cant'))
  ACN(er:Val(z:9), fbn('Interes'))
  ACN(es:Val(z:9), fbn('Monto'))

  recorrer&i Val(w:2),Val(w:3)
    if EqStr(Val(aa:&i),fbn('Vehiculo1'))
      ACN(ej:Val(z:9), &i)
      Break
    endif
  proximo
  if Val(ej:Val(z:9))<>0
    ACN(ek:Val(z:9), Val(ad:Val(ej:Val(z:9))))
  endif
  if EqStr(Val(z:10), 'REPPOS')
    recorrer&i 2,Val(z:3)
      if EqStr(Val(au:&i),fbn('Esp'))
        ACN(el:Val(z:9), &i+Val(z:2))
        Break
      endif
    proximo
    if Val(el:Val(z:9))=0
      SCN(z:3, 1)
      ACT(au:Val(z:3), fbn('Esp'))
      ACN(av:Val(z:3), CotizacionC(fbn('Esp'),,,,Dialogo.Fecha1-1,1,,'USD'))
      ACN(el:Val(z:9), Val(z:3)+Val(z:2))
      ACN(em:Val(z:9), 1)
    endif
  else
    recorrer&i 2,Val(z:2)
      if EqStr(Val(ar:&i),fbn('Esp'))
        ACN(el:Val(z:9), &i)
        Break
      endif
    proximo
    if Val(el:Val(z:9))=0
      SCN(z:2, 1)
      ACT(au:Val(z:2), fbn('Esp'))
      ACN(av:Val(z:2), CotizacionC(fbn('Esp'),,,,Dialogo.Fecha1-1,1,,'USD'))
      ACN(el:Val(z:9), Val(z:3))
      ACN(em:Val(z:9), 1)
    endif
  endif
  if Not Incluido(fbn('Esp'),'ARP')
    if Val(z:4)>1
      recorrer&i 2,Val(z:4)
        if EqStr(Val(ax:&i),fbn('Esp'))
          ACN(144:Val(z:9), &i)
          Break
        endif
      proximo
    endif
    if Val(144:Val(z:9))=0
      SCN(z:4, 1)
      ACT(ax:Val(z:4), fbn('Esp'))
      ACT(ay:Val(z:4), BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Esp')))
      ACN(az:Val(z:4), Cotizacion(fbn('Esp'),,,,Dialogo.Fecha1-1,1))
      ACN(144:Val(z:9), Val(z:4))
      ACN(eo:Val(z:9), 1)
    endif
  endif
  if Val(ej:Val(z:9))<>0
    SCN(Val(el:Val(z:9)):Val(ej:Val(z:9)), -Val(ei:Val(z:9)))
    if Val(ek:Val(z:9))<>0
      SCN(Val(el:Val(z:9)):Val(ek:Val(z:9)), -Val(ei:Val(z:9)))
    endif
    SCN(aw:Val(el:Val(z:9)), -Val(ei:Val(z:9)))
    ACT(ep:Val(z:9), 'OK')
  endif
proximo
