******************
* ---Multiple Vto
******************
SQL.ADD("Select O.Vehiculo1,  O.Especie,        O.FechaOp,           O.TipoOp, O.NrOperacion,  ")
*SQL.ADD("       C.Fecha2 Vto, C.Cantidad1 Cant, C.Cantidad3 Interes, C.Cantidad1+C.Cantidad3 Monto, ")
SQL.ADD("       C.Fecha2 Vto, ")
SQL.ADD("       CASE O.TipoOp WHEN 'MMONM' THEN C.Cantidad4 ELSE C.Cantidad1 END Cant, ")
SQL.ADD("       C.Cantidad3 Interes, ")
SQL.ADD("       CASE O.TipoOp WHEN 'MMONM' THEN C.Cantidad4+C.Cantidad3 ELSE C.Cantidad1+C.Cantidad3 END Monto, ")

SQL.ADD("       O.Book1,      O.Especie Esp ")
SQL.ADD("  from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES L, "~DBO~".BOOKS B ")
SQL.ADD(" where ( O.TipoOp In ('MMONM','MMPCLM','MMPEM','MMPIM','MMPOSM','MMSCMV','MMSIMV','MMFCMV','MMFIMV') or (O.TipoOp In ('MMSELN') and O.MB3 ='1'))   ")
SQL.ADD("   and L.Codigo      =  O.Cliente1 ")
SQL.ADD("   and L.Jerarquia   NOT LIKE '"~VAR('JERVINCUL')~"%' ")
SQL.ADD("   and O.NrOperacion =  C.NrOperacion ")
SQL.ADD("   and O.FechaOp     <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and C.Fecha2      >  '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" and  C.Fecha2       <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("   and O.Book1       =  B.Codigo ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.Vehiculo1  in ("~Pipe2Comillas(val(r:1))~") ")
else
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and O.Book1 in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif

SQL.ADD(" Union All")

******************
* ---Unico Vto.
******************
SQL.ADD("Select O.Vehiculo1,    O.Especie,            O.FechaOp,                O.TipoOp, O.NrOperacion, ")
SQL.ADD("       O.FechaVto Vto, O.Cantidad Cant,      O.TotalIntereses Interes, O.Cantidad+O.TotalIntereses Monto, ")
SQL.ADD("       O.Book1,        O.Especie Esp ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES L, "~DBO~".BOOKS B ")
SQL.ADD(" Where O.TipoOp    In ('MMDC','MMPLME','MMPCCV','MMDPAC') ")
SQL.ADD("   and L.Codigo    =  O.Cliente1 ")
SQL.ADD("   and L.Jerarquia NOT LIKE '"~VAR('JERVINCUL')~"%' ")
SQL.ADD("   and O.FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("   and O.FechaVto  <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("   and O.Book1     =  B.Codigo ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
else
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and O.Book1 in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif

SQL.ADD(" Union All")

