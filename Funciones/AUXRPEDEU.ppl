SQL.ADD("       O.FechaEj Vto,  O.TotalBrutoCli1 Cant, O.TotalIntereses Interes, O.TotalNetoCli1 Monto, ")
SQL.ADD("       O.Book1,        O.ContraEspecie Esp ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES L, "~DBO~".BOOKS B ")
SQL.ADD(" where O.TipoOp    In ('SECT','SEVT') ")
