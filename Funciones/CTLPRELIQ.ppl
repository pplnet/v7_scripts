SQL.ADD("SELECT SUM(Cantidad) as Cantidad ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M ")
SQL.ADD("where M.EnteCustodia = '"~Val(a:&i)~"' ")
SQL.ADD("  and M.Cliente      = '"~Val(b:&i)~"' ")
SQL.ADD("  and M.Concepto     = '"~Val(o:&i)~"' ")
SQL.ADD("  and M.Especie      = '"~Val(d:&i)~"' ")
If Dialogo.Radio8=1
   SQL.ADD("  and M.Book In ("~Pipe2Comillas(val(ck1))~") ")
EndIf
If Dialogo.Radio6=0 o Dialogo.Radio7=0 o Dialogo.Radio7=1
   SQL.ADD("  and M.NrSaldo = 1 ")
Else
   If Dialogo.Radio6=1 
      SQL.ADD("  and (M.NrSaldo = 1 or M.NrSaldo = 8) ")
   Else
      If Dialogo.Radio6=2 
         SQL.ADD("  and M.NrSaldo = 8 ")
      EndIf 
   EndIf
EndIf 
SQL.ADD("  and M.Transaccion  = '"~Val(a1)~"' ")
If Dialogo.Radio1 = 1
   SQL.ADD("and M.NrOperacion = '"~Val(i:&i)~"' ")
   SQL.ADD("and M.Cantidad    = "~Fstr(Val(f:&i),0,7)~" ")
   SQL.ADD("and M.FechaMov    = '"~IdxDate(Val(e:&i))~"' ")
   SQL.ADD("and M.NrMov       = "~Fstr(Val(y:&i),0,0)~" ")
Else
   If Dialogo.Radio1 = 2 y Dialogo.Radio7 <> 1
      SQL.ADD(" and NrOperacion = '"~Val(i:&i)~"'  ")
   EndIf
   IF [Dialogo.Radio1 = 2 y Dialogo.Radio7 = 1] o Dialogo.Radio1 = 0
      SQL.ADD(" AND NrOperacion IN ("~Pipe2Comillas(Val(i:&i))~") ")
   ENDIF
EndIf
ACN(ct1,0)
Recorrer SQL
  dfa
  ACN(ct1,Abs(FBN('Cantidad')))
Proximo