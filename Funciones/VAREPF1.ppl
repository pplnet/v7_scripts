ACN(RS:2, 0)
ACN(PP:1, 0)
ACN(PP:2, 0)
ACN(SA:99, 0)
SetFilaActual(fac+Val(FI:2)+1)
ACT(A:fac, 'Actividad del Periodo')
SetFont(A:fac..B:fac, 2)
ifa
ACT(A:fac, 'Fecha:')
ACT(B:fac, 'Movimiento')
ACT(C:fac, 'Operacion')
ACT(D:fac, 'VN/Cuotas')
ACT(E:fac, 'Precio')
ACT(F:fac, 'Valor')
ACT(G:fac, 'T.C.')
ACT(H:fac, 'Valor ARP')
ACT(I:fac, 'P.Costo ARP')
ACT(J:fac, 'V.N. Acum.')
ACT(K:fac, 'Resultado Historico')
ACT(L:fac, 'Estado')
ACT(M:fac, 'Saldo Operacion')
SetFont(A:fac..M:fac, 2)
AgregarMarco(A:fac..O:fac, 0, 0, Exe('COLOR6'))
ifa
ACN(FI:3, fac)
***---En HH1 acumulo valor ARP para fila de saldo Final = Saldo de la operacion * TC * Precio
ACN(HH:1, 0)
IF Val(FI:2) > 0
    Recorrer&k 1, Val(FI:2)
        ***---Operaciones del saldo
        ACD(A:fac+Val(FI:2)-&k, Val(AA:&k))
        ***---Fecha de la suscripcion
        ACD(FE:2, Val(AA:&k))
        ACT(B:fac+Val(FI:2)-&k, Val(AB:&k))
        ACT(C:fac+Val(FI:2)-&k, Val(AC:&k))
        ACLO(C:fac+Val(FI:2)-&k, Val(AC:&k))
        ACN(D:fac+Val(FI:2)-&k, Val(AD:&k))
        ACN(E:fac+Val(FI:2)-&k, Val(AE:&k))
        ACN(F:fac+Val(FI:2)-&k, Val(AF:&k))
        ACN(G:fac+Val(FI:2)-&k, Val(AG:&k))
        ACN(H:fac+Val(FI:2)-&k, Val(AH:&k))
        ACT(L:fac+Val(FI:2)-&k, Val(AL:&k))
        ACN(M:fac+Val(FI:2)-&k, Val(AD:&k))
        SCN(HH:1, (Val(M:fac+Val(FI:2)-&k) * Val(G:fac+Val(FI:2)-&k) * Val(E:fac+Val(FI:2)-&k)))
    Proximo
    Recorrer&k 0, Val(FI:2)-1
        ACN(J:fac+&k, Sum(D:fac..D:fac+&k))
        ***---Saldo Acumulado
        ACN(SA:99, Val(J:fac+&k))
    Proximo
    ***---Primer Fila PEPS
    ACN(FI:3, fac)
ENDIF
SetFont(A:Val(FI:3)..M:fac+Val(FI:2), 1)
FormatoCeldas(D:Val(FI:3)..D:fac+Val(FI:2), Exe('F2'))
FormatoCeldas(E:Val(FI:3)..E:fac+Val(FI:2), Exe('F8'))
FormatoCeldas(G:Val(FI:3)..G:fac+Val(FI:2), Exe('F8'))
SetFilaActual(fac+Val(FI:2)-1)
ACN(BD:1, 0)
***---Operaciones del periodo
SQL.ADD(" Select FechaOp, NrOperacion, Cantidad, Precio1, TipoOp, Especie, Cotizacion1, ContraEspecie ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" where TipoOp IN ('FCS', 'FCR') ")
SQL.ADD(" and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and Especie = '"~Val(ES:1)~"' ")
SQL.ADD(" Order by FechaOp, NrOperacion ")
Recorrer SQL
    Message('Operacion '~fbn('NrOperacion'))
    IF Val(FI:2) = 0 Y Val(BD:1) = 0 Y Eqstr(fbn('TipoOp'), 'FCS')
        ***---Primer Fila PEPS
        ACN(FI:3, fac)
        ACN(BD:1, 1)
    ENDIF
    ACD(A:fac, fbn('FechaOp'))
    ACT(C:fac, fbn('NrOperacion'))
    ACLO(C:fac, fbn('NrOperacion'))
    ACN(E:fac, fbn('Precio1'))
    ACN(F:fac, fbn('Cantidad')*fbn('Precio1'))
    ***---ACT(CT:99, CotizaEn(fbn('Especie')))
    ACT(CT:99, fbn('ContraEspecie'))
    IF Not Eqstr(Val(CT:99), Val(ML:1))
        IF fbn('Cotizacion1') > 0
            ACN(TC:1, fbn('Cotizacion1'))
        ELSE
            ***---ACN(TC:1, CotizacionC(Val(CT:99),,,,fbn('FechaOp'),1,SI,Val(ML:1)))
            ***---ACN(TC:1, Cotizacion(Val(ES:1),,,,fbn('FechaOp'),1,SI) * CotizacionBNA(Val(CT:99), fbn('FechaOp'),1,NO,NO))
            ACN(TC:1, CotizacionBNA(Val(CT:99), fbn('FechaOp')-1,1,NO,NO))
        ENDIF
    ELSE
        ACN(TC:1, 1)
    ENDIF
    ACN(G:fac, Val(TC:1))
    ACN(H:fac, Val(F:fac)*Val(TC:1))
    ACT(L:fac, 'Pendiente')
    IF Eqstr(fbn('TipoOp'), 'FCS')
        ACT(B:fac, 'Suscripcion')
        ACN(D:fac, fbn('Cantidad'))
        ACN(J:fac, Val(SA:99) + Val(D:fac))
        ACN(SA:99, Val(J:fac))
        ACN(M:fac, fbn('Cantidad'))
        SCN(HH:1, Val(M:fac) * Val(G:fac) * Val(E:fac))
        ***---Fecha de la suscripcion
        ACD(FE:2, Val(A:fac))
        SetFont(A:fac..M:fac, 1)
        FormatoCeldas(D:fac, Exe('F2'))
        FormatoCeldas(E:fac, Exe('F8'))
        FormatoCeldas(G:fac, Exe('F8'))
    ELSE
        ACN(VN:1, 0)
        ACT(B:fac, 'Rescate')
        ACN(D:fac, -fbn('Cantidad'))
        ACN(J:fac, Val(SA:99) + Val(D:fac))
        ACN(SA:99, Val(J:fac))
        SetFont(A:fac..K:fac, 1)
        FormatoCeldas(D:fac..D:fac+Val(FI:2), Exe('F2'))
        FormatoCeldas(E:fac..E:fac+Val(FI:2), Exe('F8'))
        FormatoCeldas(G:fac..G:fac+Val(FI:2), Exe('F8'))
        ACT(L:fac, 'Composicion')
        ACT(M:fac, 'Operacion')
        ACT(N:fac, 'VN/Cuotas')
        ACT(O:fac, 'Precio')
        ACT(P:fac, 'Costo Historico')
        ACT(Q:fac, 'Costo Actualizado')
        ACT(R:fac, 'Resultado Ajustado')
        SetFont(L:fac..R:fac, 2)
        FormatoCeldas(R:fac..R:fac, Exe('F2'))
        AgregarMarco(L:fac..R:fac, 0, 0, Exe('COLOR6'))
        ACN(RS:1, fbn('Cantidad'))
        ACN(FI:4, fac-1)
        ***---Fila del Rescate
        ACN(FI:5, fac)
        ***---Precio de costo
        ACN(PC:1, 0)
        ACN(CA:1, 0)
        ACN(IR:1, 0)
        ACN(IS:1, 0)
        ACN(CA:2, 0)
        ACN(TP:1, 0)
        ACN(TQ:1, 0)
        ***---Ontengo el CAI = Coeficiente de Actualizacion del Indice
        IF Val(FE:2) < Val(FE:1)
            ***---Suscripcion anterior al inicio del periodo fiscal
            ACN(CA:1, 1)
            ACN(CA:2, 1)
        ELSE
            ***---CAI = Indice IPC de fecha de rescate / Indice IPC fecha de suscripci?n.
            ***---IPC del rescate
            ACN(IR:1, Cotizacion(Val(ID:1),,,,FinDeMes(fbn('FechaOp'), SI),1,SI))
        ENDIF
        Recorrer&k Val(FI:3), Val(FI:4)
            ***---Recorro Operaciones para PEPS
            IF Val(M:&k) >= Val(RS:1)
                ifa
                ***---El Saldo cubre el rescate
                ACT(M:fac, Val(C:&k))
                ACLO(M:fac, Val(C:&k))
                ACD(FE:2, BuscarCampo('OPERACIONES','FechaOp','NrOperacion', Val(M:fac)))
                ACT(XD:87, Val(M:fac))
                ***---Saldo de la operacion >= al rescate
                ACN(N:fac, Val(RS:1))
                ***---Precio en ARP
                ACN(O:fac, Val(E:&k) * Val(G:&k))
                ACN(P:fac, Val(N:fac) * Val(O:fac))
                SCN(PC:1, Val(N:fac) * Val(O:fac))
                SCN(TP:1, Val(P:fac))
                ACN(M:&k, Val(M:&k) - Val(RS:1))
                ***---En el valor ARP resto lo rescatado.
                SCN(HH:1, (Val(RS:1) * Val(G:&k) * Val(E:&k)) * (-1))
                IF Round(Val(M:&k), 2) > 0
                    ACT(L:&k, 'Vendida Parcial')
                ELSE
                    ACT(L:&k, 'Vendida')
                    ACN(M:&k, 0)
                ENDIF
                SCN(VN:1, Val(N:fac))
                IF Val(FE:2) < Val(FE:1)
                    ***---Suscripcion anterior al inicio del periodo fiscal
                    ACN(CA:1, 1)
                    ACN(CA:2, 1)
                ELSE
                    ***---CAI
                    IF Val(CA:2) = 0
                        ***---Indice IPC de la Suscripcion
                        ACN(IS:1, Cotizacion(Val(ID:1),,,,FinDeMes(Val(A:&k), SI),1,SI))
                        ACN(CA:1, Val(IR:1) / Val(IS:1))
                    ENDIF
                ENDIF
                ***---Costo Actualizado
                ACN(Q:fac, Val(P:fac) * Val(CA:1))
                SCN(TQ:1, Val(Q:fac))
                ***---Resultado Ajustado = Valor ARP del Rescate - Costo Actualizado
                ***---ACN(R:fac, Val(H:Val(FI:5)) * Val(Q:fac))
                SetFont(L:fac..R:fac, 1)
                FormatoCeldas(O:fac, Exe('F8'))
                FormatoCeldas(R:fac, Exe('F2'))
                Break
            ELSE
                IF Val(M:&k) > 0
                    ifa
                    ***---Queda Saldo en la operacion pero no cubre el rescate
                    ACT(M:fac, Val(C:&k))
                    ACLO(M:fac, Val(C:&k))
                    ACN(N:fac, Val(M:&k))
                    ACN(O:fac, Val(E:&k) * Val(G:&k))
                    ACN(P:fac, Val(N:fac) * Val(O:fac))
                    SCN(PC:1, Val(N:fac) * Val(O:fac))
                    SCN(TP:1, Val(P:fac))
                    ACN(RS:1, Val(RS:1) - Val(N:fac))
                    ACN(M:&k, 0)
                    ACT(L:&k, 'Vendida')
                    ***---En el valor ARP el saldo de la operacion rescatada.
                    SCN(HH:1, (Val(N:fac) * Val(G:&k) * Val(E:&k)) * (-1))
                    SCN(VN:1, Val(N:fac))
                    IF Val(FE:2) < Val(FE:1)
                        ***---Suscripcion anterior al inicio del periodo fiscal
                        ACN(CA:1, 1)
                        ACN(CA:2, 1)
                    ELSE
                        ***---CAI
                        IF Val(CA:2) = 0
                            ***---Indice IPC de la Suscripcion
                            ACN(IS:1, Cotizacion(Val(ID:1),,,,FinDeMes(Val(A:&k), SI),1,SI))
                            ACN(CA:1, Val(IR:1) / Val(IS:1))
                        ENDIF
                    ENDIF
                    ***---Costo Actualizado
                    ACN(Q:fac, Val(P:fac) * Val(CA:1))
                    SCN(TQ:1, Val(Q:fac))
                    SetFont(L:fac..O:fac, 1)
                    FormatoCeldas(O:fac, Exe('F8'))
                    FormatoCeldas(R:fac, Exe('F2'))
                ENDIF
            ENDIF
        Proximo
        ifa
        ACT(L:fac, 'Total Comp.')
        ACN(N:fac, Val(VN:1))
        ACN(P:fac, Val(TP:1))
        ACN(Q:fac, Val(TQ:1))
        ***---Resultado Ajustado = Valor ARP del Rescate - Costo Actualizado
        ACN(R:fac, Val(H:Val(FI:5)) - Val(Q:fac))
        SetFont(L:fac..R:fac, 2)
        FormatoCeldas(R:fac, Exe('F2'))
        AgregarMarco(L:Val(FI:4)+1..R:fac-1, 0, 0)
        AgregarMarco(L:fac..R:fac, 0, 0, Exe('COLOR6'))
        ACN(I:Val(FI:4)+1, Val(PC:1) / Abs(Val(D:Val(FI:4)+1)))
        ACN(K:Val(FI:4)+1, ((Val(E:Val(FI:4)+1) * Val(G:Val(FI:4)+1)) - Val(I:Val(FI:4)+1)) * Abs(Val(D:Val(FI:4)+1)))
        SCN(RS:2, Val(K:Val(FI:4)+1))
        SetFont(I:Val(FI:4)+1, 1)
        SetFont(K:Val(FI:4)+1, 1)
        FormatoCeldas(I:Val(FI:4)+1, Exe('F8'))
        FormatoCeldas(K:Val(FI:4)+1, Exe('F2'))
        ACN(PC:1, 0)
        ifa
    ENDIF
Proximo
ifa
ACT(A:fac, 'Saldo Final Periodo')
ACN(D:fac, Val(SA:99))
***---Precio es el PPP de los saldosdosdos de cada compra
Recorrer&k Val(FI:3), fac-1
    SCN(PP:1, Val(M:&k) * Val(E:&k))
    SCN(PP:2, Val(M:&k) * Val(G:&k))
Proximo
ACN(E:fac, Val(PP:1) / Val(SA:99))
ACN(F:fac, Val(D:fac) * Val(E:fac))
ACN(G:fac, Val(PP:2) / Val(SA:99))
***---ACN(H:fac, Val(D:fac) * Val(G:fac))
***---ACN(H:fac, Val(F:fac) * Val(G:fac))
ACN(H:fac, Val(HH:1))
***---REVISAR   ACN(I:fac, Val(G:fac))
***---ACN(I:fac, Val(PC:1))
ACN(J:fac, Val(D:fac))
ACN(K:fac, Val(RS:2))
SetFont(A:fac..M:fac, 2)
FormatoCeldas(E:fac, Exe('F8'))
FormatoCeldas(I:fac, Exe('F8'))
FormatoCeldas(K:fac, Exe('F2'))
AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
ifa
ACT(F:fac, 'Valor Mercado')
ACN(G:fac, CotizacionC(Val(ES:1),,,,Dialogo.Fecha2,1,SI, Val(ML:1)))
*IF Eqstr(Val(CT:99), Val(ML:1))
*    ACN(G:fac, Cotizacion(Val(ES:1),,,,Dialogo.Fecha2,1,SI))
*ELSE
*    ACN(G:fac, Cotizacion(Val(ES:1),,,,Dialogo.Fecha2,1,SI) * CotizacionBNA(Val(CT:99), Dialogo.Fecha2,1,NO,NO))
*ENDIF
ACN(H:fac, Val(D:fac-1) * Val(G:fac))
FormatoCeldas(G:fac-1..G:fac, Exe('F8'))
FormatoCeldas(H:fac-1..H:fac, Exe('F2'))
ifa
ACT(F:fac, 'Resultado Revaluo')
ACN(H:fac, Val(H:fac-1) - Val(H:fac-2))
FormatoCeldas(H:fac, Exe('F2'))
SetFont(D:fac-1..H:fac, 2)
AgregarMarco(F:fac-1..H:fac, 0, 0, Exe('COLOR6'))