ACN(VH:1, 3)
IF Incluido(fbn('Vehiculo1'), Var('VSACEIF'))
    ACN(VH:1, 0)
ENDIF
IF Incluido(fbn('Vehiculo1'), Var('VURUGRAIN'))
    ACN(VH:1, 1)
ENDIF
IF Incluido(fbn('Vehiculo1'), Var('VURUINTER'))
    ACN(VH:1, 2)
ENDIF
IF Val(VH:1) = 3
    MessageBox('El Vehiculo '~fbn('Vehiculo1')~' NO CONTABILIZARA Por No Tener Definido A Que Grupo Contable Pertenence')
ENDIF