****************************************************************
* Esta funcion recibe los siguientes parametros en las celdas: *
* za0 Fila                                                     *
* zb0: Cliente                                                 *
* zc0: Especie                                                 *
* zd0: NrSaldo                                                 *
* ze0: Fecha                                                   *
* zf0: Cartera                                                 *
*                                                              *
* Devuelve el saldo en la celda:                               *
* zg0: Saldo                                                   *
* zh0: Precio                                                  *
****************************************************************


SQL.ADD("SELECT P1.CantidadFin Saldo, PrecioFinCon ")
SQL.ADD("FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("WHERE P1.Cliente = '"~Val(zb0)~"' AND ")
SQL.ADD("      P1.Especie = '"~Val(zc0)~"' AND ")
SQL.ADD("      P1.NrSaldo IN ("~Pipe2Comillas(Val(zd0))~") AND ")
SQL.ADD("      P1.Sector In ("~Pipe2Comillas(Val(zf0))~") AND ")
SQL.ADD("      P1.Fecha = (SELECT MAX(P2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".POSICIONES P2 ")
SQL.ADD("                  WHERE P2.Cliente = P1.Cliente AND ")
SQL.ADD("                        P2.Especie = P1.Especie AND ")
SQL.ADD("                        P2.NrSaldo = P1.NrSaldo AND ")
SQL.ADD("                        P2.Sector = P1.Sector AND ")
SQL.ADD("                        P2.TipoNegocio = P1.TipoNegocio AND ")
SQL.ADD("                        P2.Fecha <= '"~IdxDate(Val(ze0))~"') ")

ACN(zg0, 0)
Recorrer SQL
   dfa
   ACN(zg0, FBN['Saldo'])
   ACN(zh0, FBN['PrecioFinCon'])
Proximo

