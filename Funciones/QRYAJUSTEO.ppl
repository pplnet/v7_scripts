SQL.Add("SELECT M.NrOperacion, M.Cliente, M.FechaMov as FechaOp, Sum(M.Cantidad) as Cantidad, ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3 as FechaMov, T2.Fecha3 as FechaVto,  T2.Precio1, M.leyenda,                ")
SQL.ADD(" T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1 as CantOpe, M.Cuenta, M.Mercado              ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVEJECUTADOS M WITH (NOLOCK), "~DBO~".CLIENTES C, "~DBO~".ESPECIES E    ")
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.ADD(" AND   M.Cliente  = C.Codigo                                                 ")
SQL.ADD(" AND   T2.Especie = E.Codigo                                                 ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" AND   M.Mercado in ("~pipe2comillas(Dialogo.Lista1)~")                      ")
SQL.ADD(" Group By M.NrOperacion, M.Cliente, M.FechaMov, M.FechaMov,  T2.Precio1, M.leyenda,                ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3, T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1, M.Cuenta, M.Mercado    ")

SQL.ADD(" UNION                                                                       ")

SQL.Add("SELECT M.NrOperacion, M.Cliente, M.FechaMov as FechaOp, Sum(M.Cantidad) as Cantidad, ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3 as FechaMov, T2.Fecha3 as FechaVto,   T2.Precio1, M.leyenda,  ")
SQL.ADD(" T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1 as CantOpe, M.Cuenta, M.Mercado                        ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVPENDIENTES M WITH (NOLOCK), "~DBO~".CLIENTES C, "~DBO~".ESPECIES E    ")
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.ADD(" AND   M.Cliente  = C.Codigo                                                 ")
SQL.ADD(" AND   T2.Especie = E.Codigo                                                 ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" AND   M.Mercado in ("~pipe2comillas(Dialogo.Lista1)~")                      ")
SQL.ADD(" Group By M.NrOperacion, M.Cliente, M.FechaMov, M.FechaMov,   T2.Precio1, M.leyenda, ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3, T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1, M.Cuenta, M.Mercado    ")








