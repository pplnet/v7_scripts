*w6 - Val(a:&i) operacion
*t8 Val(b:&i) fechaop
*t3 Val(l:&i)  cliente
*t6 Val(s:&i) mercado

SQL.ADD(" DELETE FROM "~DBO~".EXCEPCIONES WHERE NrOperacion = '"~Val(a:&i)~"' AND Tipo IN ('PRESETNOAS','PRESETVENC','PRESETCANC', 'PRESETEXC', 'MAXEUNOAS', 'MAXEUVENC', 'MAXEUCANC', 'MAXEUEXC', 'VCNOAS', 'VCVENC', 'VCCANC', 'VCEXC') ")
sql.new
sql.exec


If not ExisteLimite('PRESETTLEM',Val(cl:2),'USD')
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'PRESETNOAS', "~IDXDATE2(FSYS)~", 'PreSettlement no asignado')  ")
   sql.new
Endif

If Not ExisteLimite('PRESETTLEM',Val(cl:2),'USD') o VtoLimite('PRESETTLEM',Val(cl:2),'USD')< Val(b:&i)
   ACT(ex:1, 'PreSettlement vencido el '~FECHA(VtoLimite('PRESETTLEM',Val(cl:2),'USD')))
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'PRESETVENC', "~IDXDATE2(FSYS)~", '"~Val(ex:1)~"')  ")
   sql.new
Endif

If LimCancelado('PRESETTLEM',Val(cl:2),'USD')
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'PRESETCANC', "~IDXDATE2(FSYS)~", 'PreSettlement cancelado')  ")
   sql.new
Endif

If Val(mb:1)<0
   ACT(ex:1, 'Excede el limite de Presettl. a '~Val(cl:2) ~' en '~PYC(Abs(Val(mb:1)),0,2))
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'PRESETEXC', "~IDXDATE2(Fsys)~", '"~Val(ex:1)~"')  ")
   sql.new
Endif

If not ExisteLimite('MAX'~Val(s:&i),VAR('VEHICULODE'),'USD')
   ACT(ex:1, 'Maximo Monto '~Val(s:&i)~' no Asignado' )
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'MAXEUNOAS', "~IDXDATE2(FSYS)~", '"~Val(ex:1)~"' )  ")
   sql.new
Endif

if Not ExisteLimite('MAX'~Val(s:&i),VAR('VEHICULODE'),'USD') o VtoLimite('MAX'~Val(s:&i),VAR('VEHICULODE'),'USD') < Val(b:&i)  
   ACT(ex:1, 'Maximo Monto '~Val(s:&i)~' vencido el '~FECHA(VtoLimite('MAX'~Val(s:&i),VAR('VEHICULODE'),'USD')))
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'MAXEUVENC', "~IDXDATE2(fsys)~", '"~Val(ex:1)~"')  ")
   sql.new
Endif

IF LimCancelado('MAX'~Val(s:&i),VAR('VEHICULODE'),'USD')
   ACT(ex:1, 'Maximo Monto '~Val(s:&i)~' Cancelado')
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'MAXEUCANC', "~IDXDATE2(fsys)~", '"~Val(ex:1)~"')  ")
   sql.new
Endif


IF Val(ma:1)<0
   ACT(ex:1, 'Excede el limite de Monto '~Val(s:&i)~' en '~PYC(Abs(Val(ma:1)),0,2))
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'MAXEUEXC', "~IDXDATE2(vAL(b:&i))~", '"~Val(ex:1)~"')  ")
   sql.new
Endif

IF NOT ExisteLimite('VOLUMENCON',Val(cl:2),'USD')
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'VCNOAS', "~IDXDATE2(FSYS)~", 'Volumen Concertado no Asignado')  ")
   sql.new
Endif

IF Not ExisteLimite('VOLUMENCON',Val(cl:2),'USD') o VtoLimite('VOLUMENCON',Val(cl:2),'USD') < Val(b:&i)
   ACT(ex:1, 'Volumen Concertado Vencido el '~FECHA(VtoLimite('VOLUMENCON',Val(cl:2),'USD')))
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'VCVENC', "~IDXDATE2(Fsys)~", '"~Val(ex:1)~"')  ")
   sql.new
Endif

IF Not ExisteLimite('VOLUMENCON',Val(cl:2),'USD') o LimCancelado('VOLUMENCON',Val(cl:2),'USD')
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'VCCANC', "~IDXDATE2(FSYS)~", 'Volumen Concertado Cancelado')  ")
   sql.new
Endif

IF Val(tx:3)<0
   ACT(ex:1, 'Excede el limite de Volumen Concertado. '~Val(cl:2)~' en '~PYC(Abs(Val(tx:3)),0,2))
   SQL.ADD(" INSERT INTO "~DBO~".EXCEPCIONES ( ")
   SQL.ADD(" NrOperacion, Tipo, Fecha, Descripcion ")
   SQL.ADD(" ) VALUES (")
   SQL.ADD(" '"~Val(a:&i)~"', 'VCEXC', "~IDXDATE2(Val(b:&i))~", '"~Val(ex:1)~"')  ")
   sql.new
Endif
sql.exec