***SQL.ADD("SELECT SUM(ABS(Cantidad)) Cantidad ")
SQL.ADD("SELECT SUM(Cantidad) Cantidad ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD("WHERE NrTrans2 = '"~Val(pa1)~"' AND ")
* Total
IF EqStr(Val(pa2),'T')
   SQL.ADD("      NrGrupo <> 1 AND ")
ENDIF
* Monto
IF EqStr(Val(pa2),'M')
   SQL.ADD("      NrGrupo = 2 AND ")
ENDIF
* Comision
IF EqStr(Val(pa2),'C')
   SQL.ADD("      NrGrupo = 3 AND ")
ENDIF
* Iva
IF EqStr(Val(pa2),'I')
   SQL.ADD("      NrGrupo = 4 AND ")
ENDIF
SQL.ADD("      NrSaldo = 1 ")

ACN(pb1, 0)
Recorrer SQL
   ACN(pb1, ABS(FBN['Cantidad']))
Proximo
