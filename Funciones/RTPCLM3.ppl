ACN(m:fac, FBN['Precio4'])

acn(o:fac,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,val(j:fac)*((val(m:fac)+val(l:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
acn(z:fac,(val(k:fac)+val(o:fac)))


acn(s:fac,IIF(FBN['RB6']=1,((val(j:fac)*FBN['Total5']*FBN['Plazo1'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['Precio3']/100),0))
acn(r:fac,IIF(FBN['RB6']=1, FBN['Cantidad5']+val(s:fac), 0))
*acn(q:fac,IIF(FBN['RB6']=1,((((val(j:fac)*(VAL(av:fac)/100))*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))+val(r:fac))*(FBN['ImpGastos2']/100)), ((val(j:fac)*((val(av:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))*(FBN['ImpGastos2']/100)))

ACN(m:fac,FBN['Precio4'])



* Impto.Interes
acn(v:fac,val(o:fac)*(FBN['TasaImp1']/100))

* Imp_Cs_Fin_CEC
acn(y:fac,IIF(FBN['RB6']=1,val(r:fac)*(FBN['DeltaTasa']/100),0))
     
acn(ab:fac, val(o:fac)+IIF(FBN['RB6']=1,val(r:fac)+val(y:fac),0)+val(v:fac))

acn(aa:fac,(val(k:fac)+val(ab:fac)))


*-- ta1: Atributo de TTN 
ACT(ta1,'Precio3')

acn(q:fac,IIF(FBN['RB6']=1,((((val(j:fac)*(VAL(av:fac)/100))*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))+val(r:fac))*(FBN['ImpGastos2']/100)), ((val(j:fac)*((val(av:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))*(FBN['ImpGastos2']/100)))
