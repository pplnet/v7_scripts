**** COREN - Prestamos Divisiones ****
* Buscar si hay algun ajuste Precio2=Precio2
ACN(v1,0)
BorrarCeldas(ww1..ww4)
SQL.ADD("Select Cantidad, Precio1, Precio2 from "~DBO~".OPERACIONES where ")
SQL.ADD("TipoOp = 'AJUCOR' and Vehiculo1= '"~fbn('Codigo')~"' ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and Especie = '"~Dialogo.Especie1~"' and RB7= '1' and RB6='1' and RB8='3' ")
Recorrer SQL
  dfa
  ACN(v1,1)
  * acumular capital
  SCN(ww1, fbn('Cantidad'))
  * acumular capital por tasa
  SCN(ww2, fbn('Cantidad')*fbn('Precio1') )
  * acumular capital por Precio2
  SCN(ww3, fbn('Cantidad')*fbn('Precio2') )
  * acumular capital por tasa por Precio2 
  SCN(ww4, fbn('Cantidad')*fbn('Precio1')*fbn('Precio2') )
Proximo
if Val(v1)=1
  * hay ajuste
  * Capital
  ACN(w1, Val(ww1)) 
  * tasa
  If Dialogo.Radio8 = 0 
    ACN(w11, Val(ww2)/Val(ww1))
  else
    ACN(w11, Val(ww4)/Val(ww3))
  endif
  * Precio2
  ACN(w12, Val(ww3)/Val(ww1))
  * poner el resto en cero
  ACN(w2, 0)
  ACN(w21,0)
  ACN(w22, 0)
else
  *-- Vto. Multiple ---
  If Dialogo.Radio14=0  o Dialogo.Radio14=2 
     * LinkearHoja('COREN6',37,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=2,Radio6=1,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=4,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     LinkearHoja('COREN6',37,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio3=2,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=4,Lista1='',Radio7=Dialogo.Radio7,Lista2=Dialogo.Lista2,Radio6=1,Lista3=Dialogo.Lista3)
    If Dialogo.Radio8 = 0 
      ACN(w1, LinkH(37, bv:1))
      ACN(w11, LinkH(37, bu:1))
      ACN(w12, LinkH(37, bw:1))
    Else
      ACN(w1, LinkH(37, by:1))
      ACN(w11, LinkH(37, bx:1))
      ACN(w12, LinkH(37, bz:1))
    Endif   
    *CerrarHoja('COREN6',37,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=2,Radio6=1,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=4,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    *CerrarLink(37)
  Else 
    ACN(w1, 0)
    ACN(w11,0)
    ACN(w12, 0)
  Endif
  *-- Vto. Simple --
  If Dialogo.Radio14=0  o Dialogo.Radio14=1     
     * LinkearHoja('COREN4',38,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=2,Radio6=1,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=4,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     LinkearHoja('COREN4',38,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio3=2,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=4,Lista1='',Radio7=Dialogo.Radio7,Lista2=Dialogo.Lista2,Radio6=1,Lista3=Dialogo.Lista3)
    If Dialogo.Radio8 = 0 
      ACN(w2, LinkH(38, bv:1))
      ACN(w21, LinkH(38, bu:1))
      ACN(w22, LinkH(38, bw:1))
    Else
      ACN(w2, LinkH(38, by:1))
      ACN(w21, LinkH(38, bx:1))
      ACN(w22, LinkH(38, bz:1))
    Endif   
    *CerrarHoja('COREN4',38,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=2,Radio6=1,Radio1=-1,Radio4=-1,Radio2=-1,Radio5=4,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    *CerrarLink(38)
  Else 
    ACN(w2, 0)
    ACN(w21,0)
    ACN(w22, 0)
  Endif  
Endif
