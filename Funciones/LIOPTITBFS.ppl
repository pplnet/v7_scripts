**Siempre levato los limites de books con Fidusiario='NO' porque es el caso en que controlo monto, porcentaje y demas
*-Para FCI, Plazo Fijo y Cauciones usamos la funcion LIMOPBFSA-*CotiOpLim       : 'Cotizacion Op Lim'  ;;;2;NO;;;;;;IF(VTXT25=CONTRAESPECIE, 1, IF(CONTRAESPECIE = Var('MONELOCA'), 1/CotiBNA, CotiBNA))
VTXT25          : 'Moneda Monto Lim'   ;9;3;2;NO;;;;;;QUERY("Select Moneda FROM "~DBO~".LIMASIGNADOSBOOK Where Codigo = '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%' ) ");SI
CB11          : 'Inst del Fiduciante'  ;;3;2;NO;SI;;;;;IF(RB4=0 Y NOVACIO(NRORDEN),BuscarCampo('ORDENES','CB2','NrOrden',NRORDEN),0)
CotiBNA         : 'Cotizacion BNA'     ;;;2;NO;;;;;;IF(Incluido(VEHICULO1, Var('VEHDOLBI')),CotizacionBNA(Var('DOLBILLETE'),FECHAOP-1,1,NO,NO),CotizacionBNA(Var('MONEEXTR'),FECHAOP-1,1,NO,NO))
CotiOpLim       : 'Cotizacion Op Lim'  ;;;2;NO;;;;;;IF(VTXT25=CONTRAESPECIE, 1, IF(CONTRAESPECIE = Var('MONELOCA'), 1/CotiBNA, CotiBNA))

**-Estos son valores propios de cada producto-**
**-Limites consumido global para Titulos-**
LimConsum       : 'Limite Consum Global'         ;;;2;;;;;;;LIMCONSUMIDO('','TI',VTXT25,0,'','',BOOK1,NROPERACION)
**-Monto que se va a usar en el limite-**
MontoOpLim      : 'Monto Op para Lim'            ;;;2;;;;;;;TOTALNETOCLI1   
**-Terminan los valores propios del porducto-**

MonCartera      : 'Monto de la Cartera'     ;;;2;NO;;;;;;IF(VTXT25=Var('MONELOCA'),QUERY("Select ValorCarteraML from "~DBO~".RENTABILIDAD WHERE Book= '"~BOOK1~"'AND Vehiculo= '"~Vehiculo1~"' and Fecha = "~IdxDate2(Habiles(FechaOp,-1,TablaFeriados1,'SI'))~""),QUERY("Select ValorCarteraME from "~DBO~".RENTABILIDAD WHERE Book= '"~BOOK1~"'AND Vehiculo= '"~Vehiculo1~"' and Fecha = "~IdxDate2(Habiles(FechaOp,-1,TablaFeriados1,'SI'))~""))
LimMontCartMon  : 'Monto Carte Mon Lim'     ;;;2;NO;;;;;;MonCartera*CotiOpLim+MontoOpLim*CotiOpLim
LimPorcConsum   : '% Consum Global'         ;;;2;NO;;;;;;(LimConsum+(MontoOpLim*CotiOpLim))/LimMontCartMon*100
LimPlazo        : 'Plazo Limite'            ;;;2;NO;;;;;;QUERY("Select Plazo FROM "~DBO~".LIMASIGNADOSBOOK Where Codigo = '"~BOOK1~"' AND (TiposOperacion LIKE '"~TIPOOP~"|%' OR TiposOperacion LIKE '%|"~TIPOOP~"|%') AND CB1='NO' and (Especies LIKE '"~VTXT21~"|%' OR Especies LIKE '%|"~VTXT21~"|%')")
VTXT21          : 'Jerarquia Sup Especie'   ;;;2;NO;;;;;;ItemLista(Ascendientes('ESPECIES',ESPECIE),2);SI
VTXT22          : 'Moneda Emision'          ;;;2;NO;;;;;;BuscarCampo('ESPECIES','MonedaEmision','Codigo',ESPECIE)
VFEC1           : 'Fecha Maduracion'        ;;;2;NO;;;;;;FechaMaduracion(ESPECIE)
VTXT23          : 'Cliente Emisor'          ;;;2;NO;;;;;;BuscarCampo('ESPECIES','Issuer','Codigo',ESPECIE)