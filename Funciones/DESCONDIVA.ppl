*-- w1: Condicion de IVA del Cliente
*-- w2: Devuelvo la descripcion

*-- Guardo Fila Actual ------
ACN(fi:1,fac)

SetFilaActual(1)

ACT(xx:fac,'INS')
ACT(xy:fac,'Inscripto')
ACT(xx:fac+1,'NOI')
ACT(xy:fac+1,'No Inscripto')
ACT(xx:fac+2,'NO5')
ACT(xy:fac+2,'No Inscripto Adic. 50%')
ACT(xx:fac+3,'NOR')
ACT(xy:fac+3,'No Responsable')
ACT(xx:fac+4,'EXE')
ACT(xy:fac+4,'Exento')
ACT(xx:fac+5,'GRA')
ACT(xy:fac+5,'Gran Consumidor')
ACT(xx:fac+6,'FIN')
ACT(xy:fac+6,'Consumidor Final')
ACT(xx:fac+7,'MON')
ACT(xy:fac+7,'Monotributista')
ACT(xx:fac+8,'NOC')
ACT(xy:fac+8,'No Categorizado')
ACT(xx:fac+9,'OTR')
ACT(xy:fac+9,'Otro')

recorrer&i fac,fac+9
if EQSTR(val(xx:&i),val(w1))
  ACT(w2,val(xy:&i))
  break
endif
proximo

*-- Vuelvo a Fila original -----
SetFilaActual(Val(fi:1))
