*- Recibe los datos en la celdas mp1 .. mp30
If EqStr(val(mp13),'AV') y val(mp2)<=Fsys
   SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS (")
Else
   SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES (")
EndIf
SQL.ADD("NrOperacion,FechaMov,")
SQL.ADD("Cliente,Especie,")
SQL.ADD("CallPut,")      
IF Incluido(val(mp5), 'CAL|PUT') 
   SQL.ADD("FechaEj,PrecioEj,")         
EndIf
SQL.ADD("Mercado,")
SQL.ADD("EnteCustodia,Cantidad,")
SQL.ADD("Formula,Leyenda,")
SQL.ADD("Bits,NrSaldo,")
SQL.ADD("NrGrupo,Concepto,")
SQL.ADD("FechaEje,UsuarioEje,")
SQL.ADD("Cuenta,NrGrupo2,")
SQL.ADD("Transaccion,NrMov,")
SQL.ADD("NrLiq,Status,")
SQL.ADD("NrComprob,NrInstan,")
SQL.ADD("Cupon,NrTrans2,")
SQL.ADD("Book,Vehiculo")
SQL.ADD(") Values (")
* NROPERACION
SQL.ADD(" '"~val(mp1)~"',")
* FechaMov
SQL.ADD(" '"~IdxDate(val(mp2))~"',")
*CLIENTE
SQL.ADD(" '"~val(mp3)~"', ")
* Especie
SQL.ADD(" '"~val(mp4)~"',")
*CALLPUT
SQL.ADD(" '"~val(mp5)~"',")
IF Incluido(val(mp5), 'CAL|PUT') 
   * FechaEj + PrcioEj
   SQL.ADD(" '"~IdxDate(val(mp6))~"',"~Fstr(val(mp7),0,6)~", ")
EndIf
* MERCADO
SQL.ADD(" '"~val(mp8)~"',")
* ENTECUSTODIA (Vehiculo)
SQL.ADD(" '"~val(mp9)~"',")
***********************
* Cantidad
***********************
** FJL 03/08/22
*SQL.ADD(" "~Fstr(val(mp10),0,6)~", ")
SQL.ADD(" "~Fstr(val(mp10),0,2)~", ")
* FORMULA
SQL.ADD(" '"~val(mp11)~"', ")
***********************
* Leyenda
***********************
** FJL 03/08/22
*SQL.ADD(" '"~val(mp12)~"', ")
SQL.ADD(" '"~Copy(val(mp12),1,50)~"', ")
* BITS
SQL.ADD(" '"~val(mp13)~"', ")
* NrSaldo
SQL.ADD(" "~Fstr(val(mp14),0,0)~", ")
***********************
* NRGRUPO
***********************
** FJL 03/08/22
*SQL.ADD(" "~Fstr(val(mp15),0,2)~",")
SQL.ADD(" "~Fstr(val(mp15),0,0)~",")
* Concepto
SQL.ADD(" '"~val(mp16)~"',")
*FECHAEJE
*** 17/09/04 SQL.ADD(" '"~IdxDate(val(mp17))~"','"~val(mp18)~"',")
SQL.ADD(" '"~IdxDate(FSYS)~"','"~val(mp18)~"',")
*CUENTA + NrGrupo2
** FJL 03/08/22
*SQL.ADD(" '"~val(mp19)~"',"~Fstr(val(mp20),0,2)~",")
SQL.ADD(" '"~val(mp19)~"',"~Fstr(val(mp20),0,0)~",")
*TRANSACCION + NrMov
SQL.ADD(" '"~val(mp21)~"',"~Fstr(val(mp22),0,0)~",")
* NrLiq + Status
*SQL.ADD(" "~Fstr(val(mp23),0,2)~",'"~Fstr(val(mp24),0,0)~"',")
If Vacio(Val(mp24))
   SQL.ADD(" "~Fstr(val(mp23),0,2)~",Null,")
Else   
   SQL.ADD(" "~Fstr(val(mp23),0,2)~",'"~val(mp24)~"',")
Endif
* NrComprob
SQL.ADD(" "~Fstr(val(mp25),0,0)~", ")
* NrInstan
IF Val(MP:26) <> 0
  SQL.ADD(" "~Fstr(val(mp26),0,6)~",")
ELSE
  SQL.ADD(" "~Fstr(val(mp26),0,6)~",")
ENDIF
* Cupon + NrTrans2
SQL.ADD(" '"~val(mp27)~"','"~val(mp28)~"',")
* Book + Vehiculo
SQL.ADD(" '"~val(mp29)~"','"~val(mp30)~"' ")
SQL.ADD(" )")
SQL.NEW
SQL.EXEC

*-------------------------------------------------------------------------------------
If DesciendeDeEspecie(Val(mp4),'MONEDA') y Eqstr(Val(mp8),VAR('MERCADOBT'))
   #ifdef BIND
     * Viene desde Cobro/Pago de Cupon
     if Val(aa:27)=1
     
       * Parámetros Salida
       * RR:1  'OK/NOK  
       * RR:2  'Mensaje'  

       * Parámetros entrada
       * RR:10  'Referencia'  
       * RR:11  'Sucursal'  
       * RR:12  'Cuenta(1a7)'    
       * RR:13  'SubOperacion-Cuenta (9a10)'
       * RR:14  'Moneda'
       * RR:15  'Importe'
       * RR:16  'Observaciones'
       * RR:17  'Importe a Bloquear'
       * RR:18  'Importe a Debitar / Acreditar'
       * RR:19  'Cliente'
       * RR:20  'Cuenta'
       * RR:21  'Especie'
       * RR:22  'Importe Bloqueado'
       * RR:23  'Importe Debitado / Acreditado'
       * RR:24  'Tipo operacion'
       * RR:25  'Mercado'
       * RR:26  'Tipo Transferencia'
       * RR:27  'Capital'
       * RR:28  'Comisiones'
       * RR:29  'Derechos'
       * RR:30  'Iva'
       * RR:31  'Intereses'
       * RR:32  'Cod Evento (producto)'
       * RR:33  'Fecha Valor'
       * RR:34  'Referencia Corte'
       * RR:35  'Referencia Accion'
       * RR:36  'Transaccion'
       * RR:37  'Fecha Cont'
       * RR:38  'Modulo' 
       * RR:39  'Relacion'
       * RR:40  'Tipo: 1 Resta_Liquidacion/'
       * RR:41  'Referencia CAMEST'
       * RR:47  'Capital Accion'
       * RR:48  'Comisiones Accion'
       * RR:49  'Derechos Accion'
       * RR:50  'Iva Accion'
       * RR:51  'Intereses Accion'
       * RR:57  'Capital Cupon'
       * RR:58  'Comisiones Cupon'
       * RR:59  'Derechos Cupon'
       * RR:60  'Iva Cupon'
       * RR:61  'Intereses Cupon'
       * RR:67  'Capital Camest'
       * RR:68  'Comisiones Camest'
       * RR:69  'Derechos Camest'
       * RR:70  'Iva Camest'
       * RR:71  'Intereses Camest'

       * Cliente / Especie / Cuenta / 
       *  Interfase Bantotal
       BorrarCeldas(rr:1..rr:50)
*       ACT(rr:10, val(mp1)~'|')
        ACT(rr:12, Copy(val(mp19),1,7))
       ACT(rr:13, Copy(val(mp19),9,2))
       ACN(rr:17, 0)
       ACN(rr:18, val(mp10))
       ACT(rr:19, val(mp3))
       ACT(rr:20, val(mp19))
       ACT(rr:21, val(mp4))
       ACT(rr:25, val(mp8))
       ACT(rr:26, 'CUP')
       * ver si desdoblar
       ACT(rr:27, '0')
       ACT(rr:28, '0')
       ACT(rr:29, '0')
       ACT(rr:30, '0')
       ACT(rr:31, '0')
       ACT(rr:32, '4')
       ACT(rr:33, Dialogo.Fecha1)
       ACT(rr:34, val(mp1)~'|')
       ACT(rr:47, '0')
       ACT(rr:48, '0')
       ACT(rr:49, '0')
       ACT(rr:50, '0')
       ACT(rr:51, '0')
       ACT(rr:57, '0')
       ACT(rr:58, '0')
       ACT(rr:59, '0')
       ACT(rr:60, '0')
       ACT(rr:61, '0')
       
       if val(rr:17)<>0
          * Desbloqueo de Saldo
          ACN(rr:15, ABS(0))
          IF val(aa:27)=1
             if val(aa:26)=1
                if val(aa:25)=1
                    (.'DESBSALCTA'.)
                    if Eqstr(Val(rr:1),'OK')
                       acn(rr:22, val(rr:17))
                    endif
                else    
                   act(rr:1,'NOK')
                endif    
             else
                act(rr:1,'OK')
                acn(rr:22, val(rr:17))
                Messagebox('Desbloqueo '~val(rr:34)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
             endif   
          endif   
       else
          act(rr:1,'OK')
       endif   
       * Amortizacion
       if val(mp15)=1
          ACT(rr:27, ABS(Val(rr:18)))
          ACT(rr:57, ABS(Val(rr:18)))
       else
          * Renta
          if val(mp15)=2
             ACT(rr:31, ABS(Val(rr:18)))
             ACT(rr:61, ABS(Val(rr:18)))
          else
             * Amort.int.Capitalizados
             if val(mp15)=3
                ACT(rr:27, ABS(Val(rr:18)))
                ACT(rr:57, ABS(Val(rr:18)))
             else
                * Comisiones
                if val(mp15)=41 o val(mp15)=51 
                   ACT(rr:28, ABS(Val(rr:18)))
                   ACT(rr:58, ABS(Val(rr:18)))
                else
                   * Iva
                   if val(mp15)=42 o val(mp15)=52
                      ACT(rr:30, ABS(Val(rr:18)))
                      ACT(rr:60, ABS(Val(rr:18)))
                   else
                      * No identificado
                      ACT(rr:31, ABS(Val(rr:18)))
                      ACT(rr:61, ABS(Val(rr:18)))
                   endif   
                endif   
             endif   
          endif   
       endif   
       (.'GRAVOUCONS'.)
       If Eqstr(val(rr:1),'OK')
          ACN(rr:15, ABS(Val(rr:18)))
          if Val(rr:18)<0
             * Debito de Saldo
             ACT(rr:24, 'DB')
             BorrarCeldas(rr:1..rr:2)
             IF val(aa:27)=1
                if val(aa:26)=1
                   if val(aa:25)=1
                      (.'DEBISALCTA'.)
                      if Eqstr(Val(rr:1),'OK')
                         acn(rr:23, val(rr:18))
                      endif
                   else    
                      act(rr:1,'NOK')
                   endif      
                else
                   act(rr:1,'OK')
                   acn(rr:23, val(rr:18))
                   Messagebox('Debito '~val(rr:34)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                endif   
             endif   
          else
             if Val(rr:18)>0
                * Credito de Saldo
                ACT(rr:24, 'CR')
                BorrarCeldas(rr:1..rr:2)
                IF val(aa:27)=1
                   if val(aa:26)=1
                      if val(aa:25)=1
                         (.'ACRESALCTA'.)
                         if Eqstr(Val(rr:1),'OK')
                            acn(rr:23, val(rr:18))
                         endif
                      else    
                         act(rr:1,'NOK')
                      endif      
                   else
                      act(rr:1,'OK')
                      acn(rr:23, val(rr:18))
                      Messagebox('Credito '~val(rr:34)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                   endif   
                endif                                
             endif
          endif   
       endif
       (.'VOUCONSSTA'.)                      
*       SCN(bz:2,1)   
*       ACN(bz:3,1)   
     endif
   #endif
endif