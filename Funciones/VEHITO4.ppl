Fecha1        : 'Fecha Aprobacion' ;20;1;2;NO;FECHA1 <> 0;;;;;;
Vehiculo1     : 'Vehiculo'         ;1;2;1;NOT EV y EqStr(ABM,'A') Y Not Incluido(TIPOOP, 'MMPRCO|MMPREC|MMONRE');;NOVACIO(VEHICULO1) Y  Incluido(VEHICULO1,SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Codigo = '"~Vehiculo1~"' and Status ='HAB' ")) y [Vacio(UsrVehiculos(UsuarioActivo)) o Incluido(VEHICULO1,SqlSet("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))];'El VEHICULO es INVALIDO';NO;;IIF(Incluido(TIPOOP, 'MMPRCO|MMPREC') THEN BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion', NROPERACION5) ELSE IF(Incluido(TIPOOP, 'MMONRE'), OPREF.VEHICULO1) ENDIF);;If(Vacio(UsrVehiculos(UsuarioActivo)),SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Status ='HAB' "),SqlSet("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"));NO
Book1         : 'Book'             ;2;2;1;Not Incluido(TIPOOP, 'MMPRCO|MMPREC|MMONRE');;BookValido(BOOK1, TIPOOP, ESPECIE, VEHICULO1, OPERADOR,'') y NoVacio(BOOK1);'El Book seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo';NO;;IIF(Incluido(TIPOOP, 'MMPRCO|MMPREC') THEN BuscarCampo('OPERACIONES','Book1','NrOperacion', NROPERACION5) ELSE IF(Incluido(TIPOOP, 'MMONRE'), OPREF.BOOK1) ENDIF);;;;;;" Vehiculo='"~VEHICULO1~"' AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
PrecioRef     : 'Ref_Val'          ;15;2;2;;NO;NOVACIO(PRECIOREF);'Indique Precio de Referencia';NO;VAR('TASADEFA');
PrecioRef4    : 'Ref_Val_Cont'     ;16;2;2;INCLUIDO(COPY(TIPOOP,1,2),'FX|DT');NO Y INCLUIDO(COPY(TIPOOP,1,2),'FX|DT');SI O [NOT INCLUIDO(COPY(TIPOOP,1,2),'FX|DT') O NOVACIO(PRECIOREF4)];'Indique Precio de Referencia para la ContraEspecie';NO;
VTXT40        : 'Moneda Loc. Veh.' ;0;0;1;NO;NO;NoVacio(VTXT40);'No se ha especificado moneda local para el vehiculo '~VEHICULO1;NO;;BuscarCampo('VEHICULOS', 'Alias4', 'Codigo', VEHICULO1);
Sector2       : 'Perfil'           ;16;2;3;NO;NO;;;;BuscarCampo('USUARIOS','Perfil','Codigo',USUARIOACTIVO);BuscarCampo('USUARIOS','Perfil','Codigo',USUARIOACTIVO);