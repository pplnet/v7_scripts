            ACT(a:fac, fbn('Especie'))
            ACT(B:fac, Dialogo.Especie4)

            If Not EqStr(fbn('Cliente'),val(cl1)) o Not EqStr(FBN['Mercado'],Val(me1))
               *- Recupero las cuentas de custodia y de efectivo
               ACT(cl1,fbn('Cliente'))
               ACT(me1,FBN['Mercado'])
               ACT(hl1,'') 
               ACT(jl1,'') 

               * Cuenta Custodia
               SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(cl1)~"' AND TipoCuenta IN ('CUS') AND Estado='HAB' AND Mercado = '"~Val(me1)~"' ")
               Recorrer SQL
                  dfa
                  If Vacio(val(jl1)) y [Dialogo.Check2=1 o Dialogo.Check3=1 o Dialogo.Check4=1] y [Incluido(Val(b:fac),FBN['Especies']) o Incluido('TITULO|',FBN['Especies']) o Incluido('PRIVA|',FBN['Especies']) ]
                     ACT(jl1,FBN['Codigo'])
                  EndIf       
               Proximo

               * Cuenta Moneda
               SQL.ADD("SELECT Codigo, Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(cl1)~"' AND TipoCuenta IN ('CC', 'CA') AND Estado='HAB' ")
               Recorrer SQL
                  dfa
                  If Vacio(val(hl1)) y Dialogo.Check1=1 y Incluido(Dialogo.Especie2,FBN['Especies']) 
                     ACT(hl1,FBN['Codigo'])
                  EndIf
               Proximo

               If Vacio(val(hl1)) y Dialogo.Check1=1
                  ACT(hl1,Val(dz3))
               EndIf
            EndIf

            Message(fbn('Cliente')~' '~Dialogo.Especie1~' '~fbn('CallPut')~' '~fbn('FechaEj')~' '~fbn('PrecioEj')~' '~FBN['Mercado']~' '~FBN['EnteCustodia']~' '~FBN['Cuenta']~' '~Fstr(fbn('NrSaldo'),0,2) )

            ACN(z:2,fbn('Saldo') )

            IF Val(z:2)<>0
               ACT(a:fac, fbn('Especie'))
               ACT(b:fac, Dialogo.Especie4)
               ACN(c:fac, fbn('NrSaldo'))
               ACT(d:fac, fbn('EnteCustodia'))
               ACT(e:fac, fbn('Mercado'))
               ACT(f:fac, fbn('RazonSocial'))
               ACT(g:fac, fbn('Cliente'))
               ACT(m:fac, FBN['RecibePreaviso'])

               ACT(bl:fac, FBN['TipoCliente'])
               ACT(bm:fac, FBN['CondicionGan'])
               ACT(bn:fac, FBN['CondicionIVA'])
               ACT(bo:fac, FBN['Res3125'])
               ACT(bp:fac, FBN['InteresesC'])
               ACT(bq:fac, FBN['Cotiza'])
               ACN(br:fac, FBN['TasaIntVigente'])
               ACD(bs:fac, FBN['FechaCambioTasa'])
               ACT(bt:fac, FBN['Valor10'])
               ACN(bu:fac, FBN['TasaIntAnterior'])
               ACT(bv:fac, FBN['Valor9'])
               ACT(bw:fac, FBN['DiasAnio'])
               ACT(bx:fac, FBN['DiasMes'])

               IF Dialogo.Check2=1 o Dialogo.Check3=1 o Dialogo.Check4 = 1
                  *- Cuenta de Custodia
                  ACT(j:fac, FBN['Cuenta'])

                  If Vacio(val(j:fac)) 
                     ACT(j:fac,val(jl1))
                  EndIf
               EndIf

               ACT(h:fac,val(hl1))

               ACN(i:fac, Val(z:2))

               *- k: % Efectivo l: Monto Efectivo n: % Acciones s: Monto Acciones
               If Dialogo.Check1 = 1 y val(c:fac)<>(val(sl1)+100)
                  *- Efectivo
                  ACN(k:fac, Dialogo.Precio1)
                  ACN(l:fac, Val(z:2)*Dialogo.Precio1/100)
               EndIf

               If Dialogo.Check2 = 1
                  *- Acciones 
                  ACN(n:fac, Dialogo.Precio2)        
                  ACN(s:fac, Val(z:2)*(Dialogo.Precio2/100))
                  ACT(CO:fac, BuscarCampo('ESPECIES','Cupon','Codigo', Dialogo.Especie4))
               Endif

               If Dialogo.Check3 = 1
                  *- Revaluo
                  ACN(n:fac, Dialogo.Precio9)        
                  ACN(w:fac, Val(z:2)*(Dialogo.Precio9/100))
               Endif

               *-- Saldo + Dividendo en Acciones + Revaluo
               ACN(ba:fac, Val(z:2)+val(s:fac)+val(w:fac))

               If Dialogo.Check4 = 1
                  *-- Canje 
                  ACT(B:fac, Dialogo.Especie3)
                  ACN(n:fac, Dialogo.Precio10)
**                  ACN(S:fac, Val(Z:2) * Dialogo.Precio10/100)
                  ACN(bb:fac, val(ba:fac)*(Dialogo.Precio10/100))
                  ACN(ba:fac, val(bb:fac))

                  ACT(CO:fac,fbn('Cupon'))
                  ACT(CN:fac, BuscarCampo('ESPECIES','Cupon','Codigo', Dialogo.Especie3))
               EndIf

               *-- Calcula la fraccion 
               ACN(bc:fac, val(ba:fac)/Dialogo.Precio3)
               ACN(bd:fac, Trunc2(val(ba:fac)/Dialogo.Precio3))
               ACN(be:fac, (Val(bc:fac)-Val(bd:fac))*Dialogo.Precio3)
               ACN(bf:fac, Round2(val(be:fac),2))
               ACN(bg:fac, Round(val(bf:fac)*Dialogo.Precio4/0.01)*0.01)

               *- Monto en Efectivo 
               If Dialogo.Check1 = 1 y val(c:fac)<>(val(sl1)+100)
                  *- Efectivo
                  ACN(l:fac, val(l:fac) + val(bg:fac) )
               EndIf

               IF Dialogo.Check2=1 o Dialogo.Check3=1 o Dialogo.Check4=1
                   *- Monto en Acciones w=revaluo s=saldo nuevo bb:div en acciones  be:fraccion
                   ACN(s:fac, (val(s:fac)+val(w:fac)+val(bb:fac))-val(be:fac))
               ENDIF

               *- Parte de los Div. Acciones en efectivo debibo a la fracion
               If Dialogo.Check1 = 0 y Dialogo.Check2 = 1 y Val(bg:fac)<>0
                  *- Cuenta Efectivo 
                  SQL.ADD("SELECT Codigo,Especies FROM "~DBO~".CUENTAS WHERE Cliente= '"~Val(cl1)~"' AND TipoCuenta IN ('CC', 'CA','CUS') AND Estado='HAB'")

                  Recorrer SQL
                     dfa
                     If Vacio(val(hl1)) y [Incluido(Dialogo.Especie2,FBN['Especies']) o Incluido(val(em1),FBN['Especies'])] 
                        ACT(hl1,FBN['Codigo'])
                     EndIf
                  Proximo

                  If Vacio(val(hl1)) y Dialogo.Check1=1
                     ACT(hl1,Val(dz3))
                  EndIf

                  ACT(h:fac,val(hl1))
                  ACN(l:fac,val(bg:fac) )
               EndIf

               ACT(o:fac, fbn('CallPut'))
               ACD(p:fac, fbn('FechaEj'))
               ACN(q:fac, fbn('PrecioEj'))

               IF Not Incluido(Val(o:fac), 'CAL|PUT')
                  ACN(r:fac, 1)
               ENDIF

               ACN(x:fac, 1)
               SCN(z:1, 1)
            ELSE
               DFA
            ENDIF

