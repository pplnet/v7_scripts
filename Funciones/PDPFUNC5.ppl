*         Setear Funcion
*         Objeto a Buscar                  ACT(xz17,'INFORMES') 
*         Codigo del Objeto a Buscar       ACT(xz18,Val(t1))
*         Colunma Inicial para el detalle  ACN(xz19,4)

          ACT(aa15, BuscarLinkearHojas(Val(xz17), Val(xz18)))
          if NoVacio(Val(aa15))
             act(val(xz19):val(xy1)+1,'Incluye Informe')
             AlinearCeldas(val(xz19):val(xy1)+1,'D')
             SetFont(val(xz19):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa15)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa15), &k))))
                ACT(val(xz19)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
             proximo
          Endif

          ACT(aa25, BuscarEjecutarEventos(Val(xz17), Val(xz18)))
          if NoVacio(Val(aa25))
             act(Val(xz19):val(xy1)+1,'Incluye Evento')
             AlinearCeldas(val(xz19):val(xy1)+1,'D')
             SetFont(Val(xz19):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa25)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa25), &k))))
                ACT(Val(xz19)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
             proximo
          Endif

          ACT(aa35, BuscarFunciones(Val(xz17), Val(xz18)))
          if NoVacio(Val(aa35))
             act(val(xz19):val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(val(xz19):val(xy1)+1,'D')
             SetFont(val(xz19):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa35)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa35), &k))))
                ACT(val(xz19)+1:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
             proximo
          Endif
           
