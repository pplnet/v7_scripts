SQL.ADD("UPDATE "~DBO~".VOUCONSOLIDADOS                ")
SQL.ADD("   Set       Estado='"~Val(rr:1)~"',          ")
SQL.ADD("             Accion='"~Val(rr:24)~"',         ")
SQL.ADD("     MontoBloqueado="~Fstr(Val(rr:22),0,2)~", ")
SQL.ADD("       MontoDebCred="~Fstr(Val(rr:23),0,2)~", ")
SQL.ADD("               Tipo='"~Val(rr:26)~"',         ")
SQL.ADD("       DetalleError='"~Val(rr:2)~"',          ")
SQL.ADD("             Modulo='"~val(rr:4)~"',          ")
SQL.ADD("           Sucursal='"~val(rr:5)~"',          ")
SQL.ADD("        Transaccion='"~val(rr:6)~"',          ")
SQL.ADD("           Relacion='"~val(rr:8)~"',          ")
SQL.ADD("           FechaCont='"~val(rr:101)~"',       ")
SQL.ADD("        IdRespuesta='"~Val(rr:3)~"'           ")
SQL.ADD(" WHERE Id="~FSTR(Val(rr:9),1,0) )
SQL.NEW

if Eqstr(Val(rr:1),'OK') 
   SQL.ADD("SELECT * FROM "~DBO~".VOUCONSOLIDADOS WHERE Id="~FSTR(Val(rr:9),1,0) )     
   Recorrer SQL
      SQL.ADD("INSERT INTO "~DBO~".MOVEJECUTADOS ( ")
      SQL.ADD(" NrOperacion, Especie, Cliente, Mercado, EnteCustodia, ")
      SQL.ADD(" Bits, NrSaldo, Cuenta, NrMov,  ")
      SQL.ADD(" Book,    ")
      SQL.ADD(" FechaMov, Cantidad, Leyenda,         ")
      SQL.ADD(" NrGrupo, Concepto,         ")     
      SQL.ADD( " NrGrupo2, Nrinstan                        ")   
      SQL.ADD(" ) values  ( ")
      SQL.ADD(" '"~FSTR(val(rr:9),1,0)~"', ")
      SQL.ADD(" '"~FBN['Especie']~"', ")
      SQL.ADD(" '"~FBN['Cliente']~"', ")
      SQL.ADD(" '"~FBN['Mercado']~"', ")
      SQL.ADD(" '"~VAR('VEHICULODE')~"', ")
      SQL.ADD(" 'MV', ")
      SQL.ADD(" 1, ")
      SQL.ADD(" '"~FBN['Cuenta']~"', ")
      SQL.ADD(" "~Fstr(5001)~", ")
      SQL.ADD(" '', ")
      SQL.ADD(" "~idxdate2(FBN['FechaValor'])~", ")
      SQL.ADD(" "~Fstr(-fbn['MontoADebCred'],0,2)~", ")
      If fbn['MontoADebCred']>0
         SQL.ADD(" 'Credito cuenta cliente', ")
      else
         SQL.ADD(" 'Debito cuenta cliente', ")
      endif
      SQL.ADD(" 0, ")
      SQL.ADD(" '', ")
      SQL.ADD(" "~Fstr(1)~" , ")
      SQL.ADD(" "~Fstr(0,0,0)~" ")
      SQL.ADD("         ) ")
      SQL.NEW
   Proximo
ENDIF      
SQL.EXEC
