
           ACT(z2,GetNumerador(1))

           ***Message('*- Elimino la transacciones CUSSAL Anterior ... ')
           SQL.ADD("DELETE "~DBO~".TRANSACCIONES2 Where TipoTr2='CUSSAL' ")
           SQL.ADD("and Precio1="~Fstr(Dialogo.Entero1,0,0)~" ")
           SQL.ADD("and Precio2="~Fstr(Dialogo.Entero2,0,0)~" ")
           SQL.ADD("and (Fecha1='"~IdxDate(Dialogo.Fecha2)~"' or (Fecha1<>'"~IdxDate(Dialogo.Fecha2)~"' and CB1='0') ) ") 
           SQL.ADD("and Cliente1='"~val(z7)~"' and Ley3='"~val(z21)~"' ")
           SQL.NEW          

           *- Genero la Transaccion CUSSAL por cobro de comision de Saldos
           SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
           SQL.ADD("(Vehiculo1,Fecha1,Cliente1,Cantidad6,Cuenta1,Especie, ")
           SQL.ADD(" NrTrans,TipoTr2,Precio1,Precio2,Ley1,Ley2,Cantidad2,Cambio5,Cantidad3,")
           SQL.ADD(" CB1,Ley3) Values ")
           SQL.ADD("('"~val(z6)~"','"~IdxDate(Dialogo.Fecha2)~"','"~val(z7)~"',"~Fstr(Abs(val(l:fac)),0,2)~",")
           SQL.ADD(" '"~val(z3)~"','"~VAR('MONELOCA')~"','"~val(z2)~"','CUSSAL',"~Fstr(Dialogo.Entero1,0,0)~","~Fstr(Dialogo.Entero2,0,0)~",'"~val(z9)~"','"~val(z10)~"',")
           SQL.ADD(" "~Fstr(Abs(val(l:fac)),0,2)~","~Fstr(Abs(val(p:fac)),0,2)~","~Fstr(Abs(val(q:fac)),0,2)~",")
           SQL.ADD(" '"~val(ft1)~"','"~val(z21)~"') ")
           SQL.NEW

           * Genero los movimientos de Comision e IVA
           SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
           SQL.ADD("(NrOperacion, FechaMov, Cliente, ")
           SQL.ADD("Especie, EnteCustodia, Cantidad, ")
           SQL.ADD("Leyenda, Bits, NrSaldo, NrGrupo, Cuenta, NrMov) ")
           SQL.ADD("Values ('"~val(z2)~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~val(z7)~"', ")
           SQL.ADD("'"~VAR('MONELOCA')~"', '"~val(z6)~"', "~Fstr(-Abs(val(l:fac)),0,2)~", ")
           SQL.ADD("'Comision CUSTODIA', 'Mv', 4, 41, '"~val(z3)~"', 5)")
           SQL.NEW

           SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES ")
           SQL.ADD("(NrOperacion, FechaMov, Cliente, ")
           SQL.ADD("Especie, EnteCustodia, Cantidad, ")
           SQL.ADD("Leyenda, Bits, NrSaldo, NrGrupo, Cuenta, NrMov) ")
           SQL.ADD("Values ('"~val(z2)~"', '"~IdxDate(Dialogo.Fecha2)~"', '"~val(z7)~"', ")
           SQL.ADD("'"~VAR('MONELOCA')~"', '"~val(z6)~"', "~Fstr(-Abs(val(q:fac)),0,2)~", ")
           SQL.ADD("'IVA Comision CUSTODIA', 'Mv', 4, 42, '"~val(z3)~"', 6)")
           SQL.NEW

           SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
           SQL.ADD("(NrOperacion,NrBit,Valor) ")
           SQL.ADD(" Values ")
           SQL.ADD("('"~val(z2)~"',"~Fstr(70,2,0)~",'1') ")
           SQL.NEW
           SQL.EXEC
