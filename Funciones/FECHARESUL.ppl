VFEC2 : 'FechaOpAnt'     ;;;;NO;NO;;;;FECHAOP;IIF(Eqstr(ABM, 'E') Y Eqstr(CAMPOEDITADO, 'FechaOp') THEN Query(" Select FechaOp From "~DBO~".OPERACIONES Where NrOperacion = '"~NROPERACION~"' ") ELSE FECHAOP ENDIF);
VFEC3 : 'FechaResultado' ;;;;NO;NO;;;;FECHAOP;IIF(VFEC2 < FECHAOP THEN VFEC2 ELSE FECHAOP ENDIF);
