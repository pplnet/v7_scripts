*** toma las operaciones y luego los vouchers ***
*** tipo 2= operaciones liquidadas, tipo = 3 transacciones, tipo = 1 operaciones no liquidadas ***

*** Nuevo query para traer las cantidades sumadas ****
SQL.ADD("SELECT O.Cliente1 Cliente, O.FechaOp Fecha, M.Especie, O.NrOperacion, ' ' Cuenta, TipoOp, ")
SQL.ADD("       O.Cliente1, ' ' TipoTr2, ' ' Cuenta1, C.CUIT, C.TipoDocum, C.NrDocum, C.PaisDir, ")
SQL.ADD("       C.RazonSocial, C.Direccion, C.CodigoPostal, C.ActividadBCRA, C.FIngreso, ")
SQL.ADD("       C.Alias3, C.Persona, C.Alias10, ")
SQL.ADD("       ' ' ConceptoCA, ' ' Ley3, ' ' Ley4, ' ' Ley5, 1 Tipo, O.Especie Esp, M.FechaMov, O.FechaVto, ")
SQL.ADD("       Sum(M.Cantidad) Cantidad ")
                
SQL.ADD("FROM   (SELECT Cantidad, Especie, FechaMov, NrOperacion FROM "~DBO~".MOVPENDIENTES ")
SQL.ADD("        WHERE  Cliente  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("               and   NrSaldo     = 1 ")
SQL.ADD("               and   EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("               and   Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
SQL.ADD("        UNION  ")
SQL.ADD("        SELECT Cantidad, Especie, FechaMov, NrOperacion FROM "~DBO~".MOVEJECUTADOS ")
SQL.ADD("        WHERE  Cliente     = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("               and   NrSaldo     = 1 ")
SQL.ADD("               and   EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("               and   Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
SQL.ADD("        ) M, ")
SQL.ADD("       "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
                
SQL.ADD("WHERE  O.NrOperacion = M.NrOperacion ")
SQL.ADD("       and   O.Vehiculo1   = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("       and   C.Codigo NOT LIKE '"~Var('JERBANCOS')~"%' ")
SQL.ADD("       and   O.Cliente1    = C.Codigo   ")

SQL.ADD("GROUP BY O.Cliente1, O.FechaOp, M.Especie, O.NrOperacion, ' ', TipoOp, ")
SQL.ADD("         O.Cliente1, ' ', ' ', C.CUIT, C.TipoDocum, C.NrDocum, C.PaisDir, ")
SQL.ADD("         C.RazonSocial, C.Direccion, C.CodigoPostal, C.ActividadBCRA, ")
SQL.ADD("         C.FIngreso, C.Alias3, C.Persona, C.Alias10, ")
SQL.ADD("         ' ', ' ', ' ', ' ', 1, O.Especie, M.FechaMov, O.FechaVto ")
SQL.ADD("HAVING   ROUND(ABS(Sum(M.Cantidad))*"~DBO~".CPrecioContable(O.FechaOp,M.Especie,Null,Null,Null)/1000,0)*1000 >= "~Fstr(Dialogo.Precio1,0,0)~" ")

SQL.ADD("UNION ALL ")

SQL.ADD("SELECT M.Cliente, O.FechaOp Fecha, M.Especie, M.NrOperacion, N.Cuenta, TipoOp, ")
SQL.ADD("       T.Cliente1, T.TipoTr2, T.Cuenta1, C.CUIT, C.TipoDocum, C.NrDocum, C.PaisDir, ")
SQL.ADD("       C.RazonSocial, C.Direccion, C.CodigoPostal, C.ActividadBCRA, C.FIngreso, ")
SQL.ADD("       C.Alias3, C.Persona, C.Alias10, ")
SQL.ADD("       T.ConceptoCA, T.Ley3, T.Ley4, T.Ley5, 2 Tipo, O.Especie Esp, M.FechaMov, O.FechaVto, ")
SQL.ADD("       M.Cantidad ")
SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS N, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E  ")
SQL.ADD("WHERE  M.NrOperacion = O.NrOperacion ")
*SQL.ADD("       and   M.Mercado = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'  ")
SQL.ADD("       and   M.NrSaldo     = 1 ")
SQL.ADD("       and   M.Cliente     = O.Cliente1 ")
SQL.ADD("       and   C.Jerarquia NOT LIKE '"~Var('JERBANCOS')~"%' ")
SQL.ADD("       and   E.Jerarquia LIKE '"~VAR('JERMONEDA')~"%' ")
SQL.ADD("       and   ((O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and O.TipoOp Not In ('POM')) ")
SQL.ADD("       or (M.FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and O.TipoOp In ('POM'))) ")
SQL.ADD("       and   ROUND(ABS(M.Cantidad)*"~DBO~".CPrecioContable(O.FechaOp,M.Especie,Null,Null,Null)/1000,0)*1000 >= "~Fstr(Dialogo.Precio1,0,0)~" ")
SQL.ADD("       and   M.Formula     = T.NrTrans  ")
SQL.ADD("       and   M.Cliente     = C.Codigo   ")
SQL.ADD("       and   M.Especie     = E.Codigo  ")
SQL.ADD("       and   T.NrTrans     = N.NrOperacion  ")
SQL.ADD("       and   N.EnteCustodia = '"~Dialogo.Vehiculo1~"'  ")

SQL.ADD("UNION ALL ")

SQL.ADD("SELECT M.Cliente, O.FechaOp Fecha, M.Especie, M.NrOperacion, M.Cuenta, TipoOp,  ")
SQL.ADD("       T.Cliente1, T.TipoTr2, T.Cuenta1, C.CUIT, C.TipoDocum, C.NrDocum, C.PaisDir, ")
SQL.ADD("       C.RazonSocial, C.Direccion, C.CodigoPostal, C.ActividadBCRA, C.FIngreso, ")
SQL.ADD("       C.Alias3, C.Persona, C.Alias10, ")
SQL.ADD("       T.ConceptoCA, T.Ley3, T.Ley4, T.Ley5, 2 Tipo, O.Especie Esp, M.FechaMov, O.FechaVto, ")
SQL.ADD("       M.Cantidad ")
SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  M.NrOperacion = O.NrOperacion ")
*SQL.ADD("and   M.Mercado     = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   M.NrSaldo = 1 ")
SQL.ADD("       and   M.Cliente = O.Cliente1 ")
SQL.ADD("       and   C.Jerarquia NOT LIKE '"~Var('JERBANCOS')~"%' ")
SQL.ADD("       and   E.Jerarquia LIKE '"~Var('JERMONEDA')~"%' ")
SQL.ADD("       and   ((O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and O.TipoOp Not In ('POM')) ")
SQL.ADD("       or (M.FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' and O.TipoOp In ('POM'))) ")
SQL.ADD("       and   ROUND(ABS(M.Cantidad)*"~DBO~".CPrecioContable(O.FechaOp,M.Especie,Null,Null,Null)/1000,0)*1000 >= "~Fstr(Dialogo.Precio1,0,0)~" ")
SQL.ADD("       and   M.Formula     = T.NrTrans  ")
SQL.ADD("       and   M.Cliente     = C.Codigo   ")
SQL.ADD("       and   M.Especie     = E.Codigo  ")
SQL.ADD("       and   T.TipoTr2     = 'COMP'     ")

SQL.ADD("UNION ALL ")

SQL.ADD("SELECT M.Cliente, M.FechaMov Fecha, M.Especie, M.NrOperacion, M.Cuenta, 'T' TipoOp,  ")
SQL.ADD("       T.Cliente1, T.TipoTr2, T.Cuenta1, C.CUIT, C.TipoDocum, C.NrDocum, C.PaisDir, ")
SQL.ADD("       C.RazonSocial, C.Direccion, C.CodigoPostal, C.ActividadBCRA, C.FIngreso, ")
SQL.ADD("       C.Alias3, C.Persona, C.Alias10, ")
SQL.ADD("       T.ConceptoCA, T.Ley3, T.Ley4, T.Ley5, 3 Tipo, ' ' Esp, M.FechaMov, M.FechaMov FechaVto,  ")
SQL.ADD("       M.Cantidad ")
SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  M.NrOperacion = T.NrTrans ")
SQL.ADD("       and   T.Cliente1 = C.Codigo ")
SQL.ADD("       and   M.Especie = E.Codigo ")
SQL.ADD("       and   T.Cliente1 <>  '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   M.NrSaldo = 5 ")
*SQL.ADD("       and   M.Mercado = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   ROUND(ABS(M.Cantidad)*"~DBO~".CPrecioContable(M.FechaMov,M.Especie,Null,Null,Null)/1000,0)*1000 >= "~Fstr(Dialogo.Precio1,0,0)~" ")
SQL.ADD("       and   M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("       and   M.FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("       and   C.Jerarquia NOT LIKE '"~Var('JERBANCOS')~"%' ")
SQL.ADD("       and   E.Codigo LIKE '"~Var('JERMONEDA')~"%' ")
SQL.ADD("       and   T.TipoTr2 Not In "~Var('NOLAVADO')~" ")
SQL.ADD("       and  ((T.TipoTr2 In ('CRCA','DECA','CRVM','DEVM','CRCC','DECC') and T.Cliente1 = M.Cliente and T.CB9=1 ) ")
SQL.ADD("       or (T.TipoTr2 In ('CRCA','DECA','CRVM','DEVM','CRCC','DECC') and T.Cliente1 <> M.Cliente and (T.CB9=0 or T.CB9 is Null)) ")
SQL.ADD("       or   ")
SQL.ADD("       (T.TipoTr2 Not In ('CRCA','DECA','CRVM','DEVM','CRCC','DECC') and T.TipoTr2 Not In "~Var('NOLAVADO')~")) ")

SQL.ADD("ORDER BY 24, 1, 2, 3, 4 ,")

ACN(u3,FAC)
ACN(u4,FAC)
Recorrer SQL
    ACN(ao1,0)
    If FBN['Tipo'] = 3
       ACN(ao1,1)
    Else
       If FBN['Tipo'] = 1
          *** tipo = 1 no liquidadas ***
          SQL.ADD("Select * from "~DBO~".CODOPBCRA ")
          SQL.ADD(" where (Liquidado = 'NO' or Liquidado = Null) ")
          SQL.ADD(" order by Codigo ")
            
          Recorrer SQL   
            dfa
            If [Incluido(Trim(FBN['TipoOp',0]),FBN['TipoOperacion'])] y [[EqStr(FBN['Movimiento'],'OPE')] o [EqStr(FBN['Movimiento'],'VTO') y FBN['FechaVto',0] = FBN['FechaMov',0]] o [EqStr(FBN['Movimiento'],'TOD')]]
               ACN(ao1,1)
               Break
            Endif
          Proximo
       Else
          *** tipo = 2 liquidadas ***
          SQL.ADD("Select * from "~DBO~".CODOPBCRA ")
          SQL.ADD(" where Liquidado = 'SI' ")
          SQL.ADD(" order by Codigo ")
            
          Recorrer SQL   
            dfa
            If [Incluido(Trim(FBN['TipoOp',0]),FBN['TipoOperacion'])] y [[EqStr(FBN['Movimiento'],'OPE') y FBN['Fecha',0] = FBN['FechaMov',0]] o [EqStr(FBN['Movimiento'],'VTO') y FBN['Fecha',0] <> FBN['FechaMov',0]] o [EqStr(FBN['Movimiento'],'TOD')]]
               ACN(ao1,1)
               Break
            Endif
          Proximo
      Endif
  Endif

  If val(ao1) = 1
     scn(u4,1)
     ACT(aa:FAC,FBN['Cliente1'])
     ACT(ab:FAC, iIf(NoVacio(FBN['CUIT']),'CUIT',FBN['TipoDocum']))
     ACT(ac:FAC, iIf(NoVacio(FBN['CUIT']),FBN['CUIT'],FBN['NrDocum']))
     ACT(ad:FAC,FBN['RazonSocial'])
     ACT(ae:FAC,FBN['Direccion'])
     ACT(af:FAC,FBN['ACTividadBCRA'])
     ACD(ah:FAC,FBN['FIngreso'])
     ACD(ai:FAC,FBN['Fecha'])
     ACT(ak:FAC,FBN['Especie'])
     ACN(al:FAC,ABS(FBN['Cantidad']))
     ACN(am:FAC,ABS(FBN['Cantidad'])*Cotizacion(FBN['Especie'],,,,FBN['Fecha'],25))

     ACT(an:FAC,FBN['Cuenta'])
     If Incluido(FBN['Cuenta'],Var('CTAEFEC'))
        ACT(bg:FAC,'CTAEFEC')
     Else
        If Incluido(FBN['Cuenta'],Var('CTAGIRO'))
           ACT(bg:FAC,'CTAGIRO')
        Endif
     Endif

     If Incluido(FBN['TipoTr2'],'EGR|RVM|RCA|RCC|RET|DECA|DEVM|DECC')
        ACN(al:FAC,Val(al:FAC) * -1) 
        ACN(am:FAC,Val(am:FAC) * -1)
     Endif

     ACT(ap:FAC,FBN['NrOperacion'])
     ACT(aq:FAC,FBN['CodigoPostal'])
     ACT(ar:FAC,FBN['PaisDir'])
     ACT(au:FAC,FBN['Alias3'])
     ACT(ca:FAC,FBN['Persona'])
     ACT(cb:FAC,FBN['Alias10'])

     ACT(az:FAC,FBN['ConceptoCA'])
     ACT(bt:FAC,FBN['Ley3'])
     ACT(bc:FAC,FBN['Ley4'])
     ACT(bd:FAC,FBN['Ley5'])

     If FBN['Tipo'] = 1 o FBN['Tipo'] = 2
        *** si son operaciones ***
        message('---'~FBN['NrOperacion'])
        If Incluido(FBN['TipoOp'],'ARM')
           If Incluido(Val(bp1),'DEP')
              ACT(ag:FAC,'VME')
           Else   
              ACT(ag:FAC,'CME')
           Endif     
        Else
           ACT(ag:FAC,FBN['TipoOp'])
        Endif
        ACT(aj:FAC,FBN['NrOperacion'])

        If DesciendeDeEspecie(FBN['Esp'],'MONEDA')
           If EqStr(FBN['Esp'],'ARP')
              ACT(av:FAC,'MONARP')
           Else
              ACT(av:FAC,'MONEXT')
           Endif
        Else
           ACT(ba:FAC,BuscarCampo('Especies','Tipo','Codigo',FBN['Esp']))
           ACT(av:FAC,IIf(EqStr(val(ba:FAC),'PUB'),'PUBLIC',IIf(EqStr(val(ba:FAC),'PRI'),'PRIVAD',iIf(EqStr(val(ba:FAC),'FON'),'FONDOS',iIf(EqStr(val(ba:FAC),'OTR'),'OTROS','PRIVAD')))))
        Endif

        ACT(as:FAC,FBN['NrOperacion'])
        ACT(at:FAC,FBN['Cuenta'])
     Else
        *** si son transacciones ***
        ACT(ag:FAC,FBN['TipoTr2'])
        If Vacio(FBN['Cuenta1'])
           ACT(aj:FAC,FBN['NrOperacion'])
        Else
           ACT(aj:FAC,FBN['Cuenta1'])
        Endif
        If EqStr(FBN['Especie'],'ARP')
           ACT(av:FAC,'MONARP')
        Else
           ACT(av:FAC,'MONEXT')
        Endif
     Endif
   Else
      dfa
   Endif
proximo   
