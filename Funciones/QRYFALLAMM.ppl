SQL.ADD(" Select   Case When TipoTr2 = 'COMP' then 0           ") 
SQL.ADD("               When TipoTr2 = 'MATCH' then Cantidad2  ")
SQL.ADD("               Else Cantidad1                         ")
SQL.ADD("          END as  Cantidad1,                          ")
SQL.ADD(" T2.Cantidad3 as Cantidad3, T2.TipoTr2, T2.NrTrans as NrOperacion, T2.Cliente1 as Cliente, T2.Fecha3 as FechaMov, T2.Precio1,")
SQL.ADD(" T2.Fecha3 as FechaOp, T2.Fecha3 as FechaVto, T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1 as CantOpe, T2.Mercado1, Cantidad1 as TotalBrutoCli1,  ")
SQL.ADD(" T2.Mercado1 Mercado, T2.Cuenta2 Cuenta ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E    ")
SQL.ADD(" where T2.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" and   T2.Cliente1=C.Codigo                                                ")
SQL.ADD(" and   T2.Especie=E.Codigo                                                 ")
SQL.ADD(" and   T2.TipoTr2 in ('DEP','RET','COMP', 'TRANSP')                        ")
SQL.ADD(" and  ((T2.Especie  = '"~Dialogo.Especie1~"' and T2.TipoTr2 != 'MATCH') or ")
SQL.ADD("       (T2.Especie1 = '"~Dialogo.Especie1~"' and T2.TipoTr2 = 'MATCH'))    ")
SQL.ADD(" and   T2.Mercado1 in ("~pipe2comillas(Dialogo.Lista1)~")                  ")
SQL.ADD(" and   (T2.CB9='0' or T2.CB9 is NUll OR T2.Mercado1 in ("~pipe2comillas(Dialogo.Lista1)~")  )      ")
SQL.ADD(" and   ( (T2.CB3 = '1' AND T2.Mercado1 not in("~Pipe2Comillas(Val(ac:1))~") ) OR (T2.RB6='2' AND T2.Mercado1 in("~Pipe2Comillas(Val(ac:1))~") ) ) ")
SQL.ADD(" and   ( (T2.Fecha3 = '"~IdxDate(Dialogo.Fecha1)~"' AND T2.Mercado1 not in ("~pipe2comillas(Dialogo.Lista1)~") )  OR    ")
SQL.ADD("       (T2.FechaTransp = '"~IdxDate(Dialogo.Fecha1)~"' AND T2.Mercado1 in ("~pipe2comillas(Dialogo.Lista1)~")  ) )  ")




