
       if Dialogo.Check3=1 y Dialogo.Check1=0
          ACT(cy:&i, GetNumerador(160))
       else
          ACT(cy:&i, SQL("select cvtransfer from "~DBO~".TRANSFCVA3 where NrTrans='"~Val(e:&i)~"' and MovementOfSecurities='"~Val(vv:&i)~"' "))
       endif
       
        ** verificar datos comitentes y cuentas segun tipo de trx
       
        * InstructingParty
        act(aa:1, TRIM(val(m:&i))~';')
        * SettlementParty 
        act(aa:1, val(aa:1)~TRIM(val(m:&i))~';')
        * SecuritiesAccount
        act(aa:1, val(aa:1)~TRIM(val(m:&i))~'/'~TRIM(val(s:&i))~';')
        * Instrument
        act(aa:1, val(aa:1)~TRIM(val(l:&i))~';')
        * InstrumentIdentifierType
        #ifdef MLASA
           act(aa:1, val(aa:1)~'ISIN;')
        #else
           act(aa:1, val(aa:1)~'LOCAL_CODE;')
        #endif
        * CSDOfCounterparty
        act(aa:1, val(aa:1)~'CVSA;')
        * SettlementCounterparty
        act(aa:1, val(aa:1)~TRIM(val(n:&i))~';')
        * SecuritiesAccountOfCounterparty
        act(aa:1, val(aa:1)~TRIM(val(n:&i))~'/'~TRIM(val(t:&i))~';')
        * InstructionReference
        act(aa:1, val(aa:1)~TRIM(val(cy:&i))~';')
        * Instrument(MovementOfSecurities)
        act(aa:1, val(aa:1)~TRIM(val(vv:&i))~';')
        * Quantity
        act(aa:1,val(aa:1)~FSTR(ABS(val(c:&i)),0,0)~';')
        * QuantityType
        ** AA 30-03-2026 vacio para Bofa
        #ifdef MLASA
           act(aa:1, val(aa:1)~';')
        #else
           act(aa:1, val(aa:1)~'Face Amount;')
        #endif
        * TransactionType
        act(aa:1, val(aa:1)~'TRAD;')
        * SettlementMethod
        act(aa:1, val(aa:1)~'RTGS;')
        * TradeDate
        act(aa:1, val(aa:1)~Fecha(val(d:&i),'YYYYMMDD')~';')
        * IntendedSettlementDate
        act(aa:1, val(aa:1)~Fecha(val(h:&i),'YYYYMMDD')~';')
        * PaymentType
        act(aa:1, val(aa:1)~'NOTHING')
        if Dialogo.Check3=1
           EscribirASCII(Val(aa:1))

         if Dialogo.Check1=1
           SQL.ADD(" UPDATE "~DBO~".TRANSFCVA3 ")
           SQL.ADD("    SET Status     = '2' ")
           SQL.ADD("  WHERE NrTrans    = '"~val(e:&i)~"' ")
           **SQL.ADD("    AND CVTransfer = '"~val(o:&i)~"' ")
           SQL.NEW
         else

         
         SQL.ADD(" INSERT INTO "~DBO~".TRANSFCVA3 ( ")
         SQL.ADD(" CvTransfer, Fecha, FechaMatch,  NrOperacion, Tipotr2, ")
         SQL.ADD(" Monto, QuantityType,  Especie,   Cupon,       Cliente, ")
         SQL.ADD(" InstructingParty,       SettlementParty, SecuritiesAccount, SettlementCounterparty, SecuritiesAccountOfCounterparty, ")
         SQL.ADD(" Instrument,  InstrumentIdentifierType,  CSDOfCounterparty, NrTrans,  Status,    ")
         SQL.ADD(" MovementOfSecurities,     TransactionType, SettlementMethod,    PaymentType,   Mercado ")
         SQL.ADD(" ) Values ( ")
          * CVTransfer
         SQL.ADD(" '"~val(cy:&i)~"', ")
         SQL.ADD(" '"~IdxDate(val(d:&i))~"', ")
         SQL.ADD(" '"~IdxDate(val(h:&i))~"', ")
         SQL.ADD(" '"~val(f:&i)~"', ")
         SQL.ADD(" '"~val(u:&i)~"', ")
          * Monto
         SQL.ADD(" "~Fstr(val(c:&i),0,0)~", ")
         #ifdef MLASA
         SQL.ADD(" '"~val(y:&i)~"', ")
         #else
           SQL.ADD(" 'Face Amout', ")
         #endif         
         SQL.ADD(" '"~val(a:&i)~"', ")
         SQL.ADD(" "~Fstr(val(j:&i),0,0)~", ")
         SQL.ADD(" '"~val(cg:&i)~"', ")
          * InstructingParty
         
          * if EqStr(val(v:&i),'Deliver')
           SQL.ADD(" '"~TRIM(val(m:&i))~"', ")
           SQL.ADD(" '"~TRIM(val(m:&i))~"', ")
           SQL.ADD(" '"~TRIM(val(m:&i))~"/"~TRIM(val(s:&i))~"', ")
           SQL.ADD(" '"~val(n:&i)~"', ")
           SQL.ADD(" '"~TRIM(val(n:&i))~'/'~TRIM(val(t:&i))~"', ")
           * else
           * SQL.ADD(" '"~TRIM(val(n:&i))~"', ")
           *SQL.ADD(" '"~TRIM(val(n:&i))~"', ")
           *SQL.ADD(" '"~TRIM(val(n:&i))~"/"~TRIM(val(t:&i))~"', ")
           *SQL.ADD(" '"~val(t:&i)~"', ")
           *SQL.ADD(" '"~val(s:&i)~"', ")
           *endif
          * Instrument
         SQL.ADD(" '"~TRIM(val(l:&i))~"', ")
         #ifdef MLASA
            SQL.ADD(" 'ISIN', ")
         #else
            SQL.ADD(" 'LOCAL_CODE', ")
         #endif
         SQL.ADD(" 'CVSA', ")
         SQL.ADD(" '"~val(e:&i)~"', ")
         SQL.ADD(" '1', ")
          * MovementOfSecurities
         SQL.ADD(" '"~val(vv:&i)~"', ")
         SQL.ADD(" 'TRAD', ")
         SQL.ADD(" 'RTGS', ")
         SQL.ADD(" 'NOTHING', ")
         SQL.ADD(" '"~val(g:&i)~"' ")
         
         SQL.ADD(" ) ")
         SQL.NEW
         endif
       Endif     
