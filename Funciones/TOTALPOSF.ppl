*** arma totales ***
Recorrer&i 2, val(b:200)
  if val(&i:val(h:200)) <> 0 o val(&i:val(i:200)) <> 0
     acn(&i:val(j:200),val(&i:val(h:200))-val(&i:val(i:200)))
  endif
  if val(&i:val(k:200)) <> 0 o val(&i:val(l:200)) <> 0
     acn(&i:val(m:200),val(&i:val(k:200))-val(&i:val(l:200)))
  endif
  if val(&i:val(j:200)) <> 0 o val(&i:val(m:200)) <> 0
     acn(&i:val(n:200),val(&i:val(j:200))+val(&i:val(m:200)))
  endif
  if val(&i:val(h:200)) <> 0 o val(&i:val(k:200)) <> 0
     acn(&i:val(o:200),val(&i:val(h:200))+val(&i:val(k:200)))
  endif
  if val(&i:val(i:200)) <> 0 o val(&i:val(l:200)) <> 0
     acn(&i:val(p:200),val(&i:val(i:200))+val(&i:val(l:200)))
  endif

  if val(&i:val(o:200)) <> 0 o val(&i:val(o:200)+1) <> 0
     acn(&i:val(q:200),val(&i:val(o:200))-val(&i:val(o:200)+1))
  endif
  if val(&i:val(p:200)) <> 0 o val(&i:val(p:200)+1) <> 0
     acn(&i:val(r:200),val(&i:val(p:200))-val(&i:val(p:200)+1))
  endif
  if val(&i:val(q:200)) <> 0 o val(&i:val(r:200)) <> 0
     acn(&i:val(s:200),val(&i:val(q:200))-val(&i:val(r:200)))
  endif
  if val(&i:val(ax:200)+1) <> 0 o val(&i:val(ax:200)+2) <> 0
     if val(&i:val(ax:200)+1) > val(&i:val(ax:200)+2)
        acn(&i:val(ax:200)+1,val(&i:val(ax:200)+1)-val(&i:val(ax:200)+2))
        acn(&i:val(ax:200)+2,0)
       else
        acn(&i:val(ax:200)+2,val(&i:val(ax:200)+2)-val(&i:val(ax:200)+1))
        acn(&i:val(ax:200)+1,0)
     endif  
     SetFont(&i:val(ax:200)+1..&i:val(ax:200)+2,3)
  endif
Proximo

