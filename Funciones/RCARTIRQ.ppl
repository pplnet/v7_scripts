***********************
* Saldo Inicial
***********************
SQL.ADD("Select '1' Tipo, "~IdxDate2(Val(r:7))~" FechaOrd, P2.Fecha FechaReal, ")
SQL.ADD("        '' NrOperacion, P2.Vehiculo Vehic, P2.Cliente, P2.Book, P2.Especie, P2.Cupon, P2.NrSaldo, ")
SQL.ADD("        P2.CantidadFin Cantidad, P2.PrecioFin Precio, -1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".POSICIONES P2, "~DBO~".BOOKS B ")
SQL.ADD(" where P2.Especie      in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("   and P2.Book         =  B.Codigo ")
SQL.ADD("   and P2.NrSaldo      =  "~Val(x:2)~" ")
SQL.ADD("   and P2.CantidadFin  <> 0 ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P2.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and P2.Vehiculo in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and P2.Book   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and P2.Fecha     = (select Max(P3.Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P3 ")
SQL.ADD("                       where P3.Especie     =  P2.Especie ")
SQL.ADD("                        and  (P3.Cupon      =  P2.Cupon or (P3.Cupon IS NULL and P2.Cupon IS NULL)) ")
SQL.ADD("                        and  P3.Vehiculo    =  P2.Vehiculo ")
SQL.ADD("                        and  (P3.Book       =  P2.Book or (P3.Book IS NULL and P2.Book IS NULL)) ")
SQL.ADD("                        and  P3.NrSaldo     =  P2.NrSaldo ")
SQL.ADD("                        and  P3.TipoNegocio =  P2.TipoNegocio ")
SQL.ADD("                        and  P3.Fecha        < "~IdxDate2(Val(r:7))~" ")
SQL.ADD("                   ) ")

SQL.ADD(" Union All ")

****************************
* Movimientos de Operaciones
****************************
SQL.ADD("Select '2' Tipo, M.FechaMov FechaOrd, M.FechaMov FechaReal, ")
SQL.ADD("        M.NrOperacion, M.Vehiculo Vehic, M.Cliente, M.Book, M.Especie, M.Cupon, M.NrSaldo, ")
SQL.ADD("        M.Cantidad, M.Precio, -1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".MOVPOSEJE M, "~DBO~".OPERACIONES O, "~DBO~".BOOKS B ")
SQL.ADD(" where (O.TipoOp      <> 'FCS' or (O.TipoOp = 'FCS' and O.CB7 = '0')) ")
SQL.ADD("   and O.TipoOp       <> 'DIVIDE' ")
SQL.ADD("   and O.NrOperacion  =  M.NrOperacion ")
SQL.ADD("   and M.Especie      in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("   and M.NrSaldo      =  "~Val(x:2)~" ")
SQL.ADD("   and M.Book        =  B.Codigo ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and M.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and M.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and M.Book   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and M.FechaMov    >= "~IdxDate2(Val(r:7))~" ")
SQL.ADD("   and M.FechaMov    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

******************************
* Movimientos de Transacciones
******************************
SQL.ADD("Select '2' Tipo, M.FechaMov FechaOrd, M.FechaMov FechaReal, ")
SQL.ADD("        M.NrOperacion, M.Vehiculo Vehic, M.Cliente, M.Book, M.Especie, M.Cupon, M.NrSaldo, ")
SQL.ADD("        M.Cantidad, M.Precio, -1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".MOVPOSEJE M, "~DBO~".TRANSACCIONES2 T, "~DBO~".BOOKS B ")
SQL.ADD(" where T.TipoTr2  <> 'CUPON' ")
SQL.ADD("   and T.NrTrans  =  M.NrOperacion ")
SQL.ADD("   and M.Especie  in ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("   and M.NrSaldo  =  "~Val(x:2)~" ")
SQL.ADD("   and M.Book     =  B.Codigo ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and M.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and M.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
if NoVacio(Val(r:3))
  SQL.ADD(" and M.Book   in ("~Pipe2Comillas(val(r:3))~") ")
endif
SQL.ADD("   and M.FechaMov    >= "~IdxDate2(Val(r:7))~" ")
SQL.ADD("   and M.FechaMov    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

***************************
* Movimientos de Ctas.Vista
***************************
SQL.ADD("Select '2' Tipo, M.FechaMov FechaOrd, M.FechaMov FechaReal, ")
SQL.ADD("        M.NrOperacion, M.Vehiculo Vehic, M.Cliente, M.Book, M.Especie, M.Cupon, M.NrSaldo, ")
SQL.ADD("        M.Cantidad, M.Precio, -1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".MOVPOSEJE M, "~DBO~".BOOKS B ")
SQL.ADD(" where M.Especie     in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("   and M.NrOperacion like 'CV%' ")
SQL.ADD("   and M.NrSaldo     =  "~Val(x:2)~" ")
SQL.ADD("   and M.Book        =  B.Codigo ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and M.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and M.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and M.Book   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and M.FechaMov    >= "~IdxDate2(Val(r:7))~" ")
SQL.ADD("   and M.FechaMov    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

***********************
