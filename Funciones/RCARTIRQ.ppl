*************************
* Pago Dividendos en Efvo
*************************
SQL.ADD("Select '5' Tipo, O.FechaPago FechaOrd, O.FechaPago FechaReal, ")
SQL.ADD("        O.NrOperacion NrOperacion, O.Vehiculo1 Vehic, O.Cliente1 Cliente, O.Book1 Book, O.Especie, O.Cupon1 Cupon, O.TipoCambio3 NrSaldo, ")
SQL.ADD("        O.TotalNetoCli1 Cantidad, O.Precio1 Precio, 1 Signo, O.ContraEspecie Moneda ")
SQL.ADD(" from  "~DBO~".OPERACIONES O, "~DBO~".BOOKS B ")
SQL.ADD(" where O.TipoOp       =  'DIVIDE' ")
SQL.ADD("   and O.Book1        =  B.Codigo ")
SQL.ADD("   and O.MB4          =  '1' ")
SQL.ADD("   and O.CB6          =  '1' ")
SQL.ADD("   and O.RB1          =  '1' ")
SQL.ADD("   and O.Especie      in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("   and O.TipoCambio3  =  "~Val(x:2)~" ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and O.Book1   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and O.FechaPago  >= "~IdxDate2(Val(r:7))~" ")
SQL.ADD("   and O.FechaPago  <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

***********************
* Saldo Final
***********************
SQL.ADD("Select '9' Tipo, "~IdxDate2(Dialogo.Fecha1)~" FechaOrd, P2.Fecha FechaReal, ")
SQL.ADD("        '' NrOperacion, P2.Vehiculo Vehic, P2.Cliente, P2.Book, P2.Especie, P2.Cupon, P2.NrSaldo, ")
SQL.ADD("        P2.CantidadFin Cantidad, P2.PrecioFin Precio, 1 Signo, '' Moneda ")
SQL.ADD(" from  "~DBO~".POSICIONES P2, "~DBO~".BOOKS B ")
SQL.ADD(" where P2.Especie      in  ("~Pipe2Comillas(Val(x:1))~") ")
SQL.ADD("   and P2.Book         =  B.Codigo ")
SQL.ADD("   and P2.NrSaldo      =  "~Val(x:2)~" ")
SQL.ADD("   and P2.CantidadFin  <> 0 ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P2.Vehiculo in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and P2.Vehiculo in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD(" and P2.Book   in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and P2.Fecha     = (select Max(P3.Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P3 ")
SQL.ADD("                       where P3.Especie     =  P2.Especie ")
SQL.ADD("                        and  (P3.Cupon      =  P2.Cupon or (P3.Cupon IS NULL and P2.Cupon IS NULL)) ")
SQL.ADD("                        and  P3.Vehiculo    =  P2.Vehiculo ")
SQL.ADD("                        and  (P3.Book       =  P2.Book or (P3.Book IS NULL and P2.Book IS NULL)) ")
SQL.ADD("                        and  P3.NrSaldo     =  P2.NrSaldo ")
SQL.ADD("                        and  P3.TipoNegocio =  P2.TipoNegocio ")
SQL.ADD("                        and  P3.Fecha       <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("                   ) ")

SQL.ADD(" order by FechaOrd,Tipo,Vehic,Especie ")
