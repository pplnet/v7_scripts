endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD("   and T.Cantidad6 > 0 ")
SQL.ADD("   and T.Fecha1    >= "~IdxDate2(Val(r:7))~" ")
SQL.ADD("   and T.Fecha1    <= "~IdxDate2(Dialogo.Fecha1)~" ")

SQL.ADD(" Union All ")

SQL.ADD("Select '3' Tipo, T.Fecha1 FechaOrd, T.Fecha1 FechaReal, ")
SQL.ADD("        T.NrTrans NrOperacion, T.Vehiculo1 Vehic, T.Cliente1 Cliente, M.Book Book, T.Especie, T.Cupon1 Cupon, 0 NrSaldo, ")
SQL.ADD("        T.Cantidad6 Cantidad, T.Precio3 Precio, -1 Signo, T.Especie1 Moneda ")
