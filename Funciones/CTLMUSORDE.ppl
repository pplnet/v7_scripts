* Verifico que otro usuario no la haya asignado
If EqStr(val(x:&i),'SOL')
   SQL.ADD("SELECT NrOrden2 FROM "~DBO~".SOLICITUDESORDENES WHERE NrOrden1='"~Val(s:&i)~"' ")
   Recorrer SQL
      dfa
      ACT(ae100,FBN['NrOrden2'])
   Proximo
 
   ACT(ae:3  ,'') 

   If Vacio(Val(ae100))
      ACT(ae:3, GetNumerador(Val(ae:4)))

      SQL.ADD("UPDATE  "~DBO~".SOLICITUDESORDENES ")
      SQL.ADD("SET NrOrden2='"~Val(ae:3)~"' ")
      SQL.ADD("WHERE NrOrden1='"~Val(s:&i)~"' and (NrOrden2 Is Null or NrOrden2 ='' ) ")
      SQL.NEW
      SQL.EXEC

      ACT(ae101, '')
      ACT(ae101, SQL("SELECT NrOrden2 FROM "~DBO~".SOLICITUDESORDENES WHERE NrOrden1='"~Val(s:&i)~"' "))

      If Not EqStr(Val(ae101),val(ae3))
         ACT(io1,'')
      EndIf
   Else
      ACT(io1,'')
   Endif
Else
   SQL.ADD("SELECT NrOperacion2 FROM "~DBO~".ORDENES WHERE NrOrden='"~Val(s:&i)~"' ")
   Recorrer SQL
      dfa
      ACT(ae100,FBN['NrOperacion2'])
   Proximo
   ACT(ae:3  ,'') 

   If Vacio(Val(ae100))
      *- Numerador para todos los tipos de ordenes
      ACT(ae:3, GetNumerador(Val(ae:4)))

      SQL.ADD("UPDATE "~DBO~".ORDENES ")
      SQL.ADD("SET NrOperacion2='"~Val(ae:3)~"' ")
      SQL.ADD("WHERE NrOrden='"~Val(s:&i)~"' and (NrOperacion2 Is Null or NrOperacion2 ='' ) ")
      SQL.NEW
      SQL.EXEC

      ACT(ae101, '')
      ACT(ae101, SQL("SELECT NrOperacion2 FROM "~DBO~".ORDENES WHERE NrOrden='"~Val(s:&i)~"' "))

      If Not EqStr(Val(ae101),val(ae3))
         ACT(io1,'')
      EndIf
   Else
      ACT(io1,'')
   Endif
EndIf


