*- Movimiento DTP - RTP por el Cliente Para Mercado Distinto a CV
SQL.ADD("SELECT  O.NrOperacion, O.TipoOp, ")
SQL.ADD("Case O.TipoOp When 'TCPCEM' then (select Cantidad1 from TRANSACCIONES2 OD where OD.NrTrans = '"~Val(g:&i)~"') else O.Cantidad End Cantidad, ")
SQL.ADD("O.Cuenta1, O.Cliente1, O.Mercado, O.Especie , IsNull(O.Corporate,0) CartProp,                      ")
SQL.ADD("(SELECT M.Cuenta FROM dbo.MOVEJECUTADOS M WHERE M.NrOperacion = '"~Val(g:&i)~"' ) CuentaVeh        ")
SQL.ADD("FROM "~DBO~".OPERACIONES O                                                                         ")
SQL.ADD("WHERE NrOperacion IN                                                                               ")
SQL.ADD(" (SELECT M.NrOperacion FROM "~DBO~".MOVEJECUTADOS M with (Index = INDME5)                          ")
SQL.ADD("         WHERE M.NrTrans2 = '"~Val(g:&i)~"')                                                       ")
SQL.ADD(" UNION ALL                                                                                         ")
SQL.ADD("SELECT  O.NrTrans as NrOperacion, O.TipoTr2 as TipoOp , ABS(O.Cantidad1) As Cantidad, O.Cuenta1, O.Cliente1, '"~val(am:&i)~"' as Mercado, O.Especie, 0 CartProp, ")
SQL.ADD("(SELECT M.Cuenta FROM dbo.MOVEJECUTADOS M WHERE M.NrOperacion = '"~Val(g:&i)~"' ) CuentaVeh        ")
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 O ")
SQL.ADD("WHERE O.TipoTr2 = 'TRANSP' AND O.NrTrans IN ")
SQL.ADD(" (SELECT M.NrOperacion FROM "~DBO~".MOVEJECUTADOS M with (Index = INDME5) ")
SQL.ADD("         WHERE M.NrTrans2 = '"~Val(g:&i)~"') ")
watch(SQL.BATCH())
Recorrer SQL
   dfa
   * Depositante de la cuenta es MERRILL 
*12/08/2005   ACT(dc1,BuscarCampo('CUENTAS','Comitente','Codigo',FBN['Cuenta1']))
   ACT(dc1, BuscarCampo('CUENTAS','Comitente','Codigo',BuscarCampo('TRANSACCIONES2','Cuenta1','NrTrans',Val(g:&i)))  )
   * Si no es TRANSP reprogramo los tipotr2 segun el tipoop original del operacion
   * de otra forma, mantengo lo tipotr2 del CONCUS (w:&i)

   if Not Incluido(FBN['TipoOp'],'TRANSP')
      If EqStr(val(dc1),Dialogo.Vehiculo1)
         * Si el Depositante de la cuenta es MERRILL
         *         I*f Incluido(FBN['TipoOp'],'TIC|TIFC|TCPCEM') o [Incluido(FBN['TipoOp'],'TCOPRI') y Incluido(FBN['Cliente1'],Dialogo.Vehiculo1) ]
         *         I*f Incluido(FBN['TipoOp'],'TIC|TIFC|TCPCEM') o [Incluido(FBN['TipoOp'],'TCOPRI') y Num(FBN['CartProp'])=0 ]
         * 07/03/2024 se invierte el signo de las TCOPRI con custodia CRYL
         If [Incluido(FBN['TipoOp'],'TCOPRI') y Num(FBN['CartProp'])=0 ]
            ACT(w:&i, 'DTP')
         else   
            If Incluido(FBN['TipoOp'],'TIC|TIFC|TCPCEM')
               ACT(w:&i, 'RTP')
            Else
               ACT(w:&i, 'DTP')
            Endif   
         Endif  
      Else
         * Si el Depositante de la cuenta es OTRO BANCO
         *         I*f Incluido(FBN['TipoOp'],'TIC|TIFC|TCPCEM') o [Incluido(FBN['TipoOp'],'TCOPRI') y Incluido(FBN['Cliente1'],Dialogo.Vehiculo1) ]
         If Incluido(FBN['TipoOp'],'TIC|TIFC|TCPCEM') o [Incluido(FBN['TipoOp'],'TCOPRI') y Num(FBN['CartProp'])=1 ]
            ACT(w:&i, 'DTP')
         Else
            ACT(w:&i, 'RTP')
         Endif  
      Endif
        
   Endif
 

*11/08/2005   IF Not Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',FBN['Cliente1']), VAR('NOCLIENTES'))
*06/03/2024   IF Not Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',FBN['Cliente1']), VAR('NOCLIENTES')) y Eqstr(FBN['Mercado'], VAR('CLHODEFA'))
   * Si lleva custodia
   IF NoVacio(val(dc1)) 
      * Transferencia
      ACT(ta50, '1')
      * Interna
      * 12/03/2024 para no hacer debito y credito en la misma transaccion
      if Eqstr(FBN['Cliente1'],VAR('VEHICULODE')) y Eqstr(FBN['TipoOp'],'TCOPRI')
         ACT(ta51, '0')
      else
         ACT(ta51, '1')
      endif   
      * Cliente Orig.
      ACT(ta5, Dialogo.Vehiculo1)
      * Deposit. Orig.
      ACT(ta6, Dialogo.Vehiculo1)
      IF Eqstr(FBN['Mercado'], VAR('CLHODEFA'))
         * Depositante
         ACT(ta7, BuscarCampo('CLIENTES','CodDepCajaValores','Codigo',Val(ta5)))
      endif   
      * Cuenta
      * 12/3/2024 Se respeta la cuenta elegida en la transaccion
      If Eqstr(FBN['TipoOp'],'TCOPRI')
         ACT(ta10, FBN['CuentaVeh'])
      else
         ACT(ta10, SQL("Select Codigo from "~DBO~".CUENTAS where Cliente='"~Val(ta5)~"' and (Especies Like '%TITULO%' or Especies='"~FBN['Especie']~"|') and Estado='HAB' and TipoCuenta In ('CUS','CCO') and Mercado='"~FBN['Mercado']~"' and Comitente='"~Val(ta6)~"' and (Transacciones Like '%DTP%' or Transacciones is NULL or Transacciones='')"))
      endif   
      * Mercado
      ACT(ta104, FBN['Mercado'])
   ELSE
      act(ta50 ,'0')
      act(ta51,'0') 
      act(ta5  ,'' )
      act(ta6  ,'' ) 
      act(ta7  ,'' ) 
      act(ta10 ,'' )
      act(ta104,'' )
   ENDIF

   act(ta92, FBN['NrOperacion'] )
   act(ta1  ,Val(d:&i) )
   act(ta2  ,Val(w:&i) )
   act(ta81 ,Val(a:&i) )
