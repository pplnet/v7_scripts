   act(ta201,BuscarCampo('ESPECIES','InteresesC','Codigo',val(ta1)) ) 
   acn(ta202,val(ta29) ) 

   *- Resolucion 1585
   ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', Val(ta1)))

   If Not EqStr(val(ta201),'DIR')
      *** calcula precio sucio ***
      act(ca:fac,val(ta1))
      acd(ck:fac,val(ta39))

      (."SUCIO".)

      IF Incluido(Val(al4), '1585')
         acn(ta202,(val(ta29)+(val(cj:fac)*Val(ta29)))*val(ci:fac) )
      Else
         acn(ta202,(val(ta29)+val(cj:fac))*val(ci:fac) )
      Endif
   EndIf

   *- ta34: Cambio1 ta35: Cambio2 ta36: Cambio3 ta37: Cambio4
   *- ta28: Cantidad5  ta30: Precio2 ta31: Precio3 ta32: Precio4 ta33: Precio5 ta11: Cuenta3
