*** Diario o Mensual ***
if Dialogo.Radio2 = 0
   *** Diario ***
   Recorrer&i 2, val(d:200)-1
     acn(&i:val(k:200),val(&i:val(j:200))+val(&i:val(h:200))-val(&i:val(i:200)))
   Proximo
   acn(2:val(l:200),val(2:val(k:200)))
   Recorrer&i 3, val(d:200)-1
     acn(&i:val(l:200),val(&i-1:val(l:200))+val(&i:val(k:200)))
   Proximo
   Recorrer&i val(d:200)+1, val(g:200)-1
     acn(&i:val(k:200),val(&i:val(j:200))+val(&i:val(h:200))-val(&i:val(i:200)))
   Proximo
   acn(val(d:200)+1:val(l:200),val(val(d:200)-1:val(l:200))+val(val(d:200)+1:val(k:200)))
   Recorrer&i val(d:200)+2, val(g:200)-1
     acn(&i:val(l:200),val(&i-1:val(l:200))+val(&i:val(k:200)))
   Proximo

   Recorrer&i 11, val(k:200)
      if Sum(2:&i..val(d:200)-1:&i) <> 0
         acn(val(d:200):&i,Sum(2:&i..val(d:200)-1:&i))
      endif  
   Proximo
   Recorrer&i 11, val(k:200)
      if Sum(val(d:200)+1:&i..val(g:200)-1:&i) <> 0
         acn(val(g:200):&i,Sum(val(d:200)+1:&i..val(g:200)-1:&i))
      endif  
   Proximo
   Recorrer&i 11, val(k:200)
     if val(val(d:200):&i)+val(val(g:200):&i) <> 0
        acn(val(g:200)+1:&i,val(val(d:200):&i)+val(val(g:200):&i))
     endif
   Proximo
  else
   *** Mensual ***
   Recorrer&i val(m:200), val(n:200)
     acn(&i:val(k:200),val(&i:val(j:200))+val(&i:val(h:200))-val(&i:val(i:200)))
   Proximo
   acn(2:val(l:200),val(2:val(k:200)))
   Recorrer&i val(m:200)+1, val(n:200)
     acn(&i:val(l:200),val(&i-1:val(l:200))+val(&i:val(k:200)))
   Proximo
   if NoVacio(val(o:200))
      Recorrer&i val(o:200), val(p:200)+1
        acn(&i:val(k:200),val(&i:val(j:200))+val(&i:val(h:200))-val(&i:val(i:200)))
      Proximo
      acn(val(o:200):val(l:200),val(val(n:200):val(l:200))+val(val(o:200):val(k:200)))
      Recorrer&i val(o:200)+1, val(p:200)+1
        acn(&i:val(l:200),val(&i-1:val(l:200))+val(&i:val(k:200)))
      Proximo
   endif
   Recorrer&i val(d:200), val(g:200)
     acn(&i:val(k:200),val(&i:val(j:200))+val(&i:val(h:200))-val(&i:val(i:200)))
   Proximo
   acn(val(d:200):val(l:200),val(val(p:200)+1:val(l:200))+val(val(d:200):val(k:200)))
   Recorrer&i val(d:200)+1, val(g:200)
     acn(&i:val(l:200),val(&i-1:val(l:200))+val(&i:val(k:200)))
   Proximo

   Recorrer&i 11, val(k:200)
      if Sum(val(m:200):&i..val(n:200):&i) <> 0
         acn(val(n:200)+1:&i,Sum(val(m:200):&i..val(n:200):&i))
      endif  
   Proximo
   if NoVacio(val(o:200))
      Recorrer&i 11, val(k:200)
        if Sum(val(o:200):&i..val(p:200)+1:&i) <> 0
           acn(val(p:200)+2:&i,Sum(val(o:200):&i..val(p:200)+1:&i))
        endif  
      Proximo
   endif
   Recorrer&i 11, val(k:200)
      if Sum(val(d:200):&i..val(g:200):&i)+val(val(n:200)+1:&i)+val(val(p:200)+2:&i) <> 0
         acn(val(g:200)+1:&i,Sum(val(d:200):&i..val(g:200):&i)+val(val(n:200)+1:&i)+iif(Vacio(val(p:200)),0,val(val(p:200)+2:&i)))
      endif  
   Proximo
endif
