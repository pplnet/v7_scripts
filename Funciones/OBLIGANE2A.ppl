ACN(fa1, Val(fi7))
ACN(fa2, Val(fi8))

***---AA:1 = Capital $
***---AA:2 = Intereses Devengados $
***---AA:3 = Total $
***---AA:4 = Capital U$S
***---AA:5 = Intereses Devengados U$S
***---AA:6 = Total U$S
***---AB:1 = Capital $ de cada Especie
***---AB:4 = Capital U$S de cada Especie

Recorrer&k 1, 6
    ACN(AA:&k, 0)
    ACN(sa:&k, 0)
    ACT(ea:&k, '')
Proximo

***---Para ONs con Swap, se toma la especie del ultimo swap
IF Dialogo.Radio2 < 3
    *- Selecciono los codigos de las distintas operaciones de antemano y ubico 
    SQL.ADD(" SELECT DISTINCT O.NrOperacion, O.Observac3 ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".OPERACIONES OT ")
    SQL.ADD(" WHERE O.NrOperacion = C.NrOperacion ")
    SQL.ADD(" AND O.NrOperacion *= OT.OperacionRef  ")
    SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
    SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
    SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
    SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
    SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
    SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" and  O.TipoOp In ('MMONM') ")
    SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    IF Dialogo.Radio2 = 0
        SQL.ADD(" AND C.Fecha2 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    IF Dialogo.Radio2 = 1
        SQL.ADD(" AND C.Fecha2 > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    SQL.ADD(" AND C.Cantidad4 <> 0 ")

    SQL.ADD("UNION ")

    SQL.ADD(" SELECT DISTINCT O.NrOperacion, O.Observac3 ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES OT ")
    SQL.ADD(" Where O.NrOperacion *= OT.OperacionRef  ")
    SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
    SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
    SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
    SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
    SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
    SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" and O.TipoOp In ('MMON') ")
    SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    IF Dialogo.Radio2 = 0
        SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    IF Dialogo.Radio2 = 1
        SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    SQL.ADD(" AND O.TotalNetoCli3 <> 0 ")

    SQL.ADD(" UNION ")

    SQL.ADD("SELECT DISTINCT O.NrOperacion, O.Observac3 ")
    SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
    SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
    SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    IF Dialogo.Radio2 = 0
        SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    IF Dialogo.Radio2 = 1
        SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND O.Cantidad <> 0 ")

    SQL.ADD("UNION ")

    SQL.ADD("SELECT DISTINCT O.NrOperacion, O.Observac3 ")
    SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
    SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
    SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
    SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    IF Dialogo.Radio2 = 0
       SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    IF Dialogo.Radio2 = 1
       SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
    ENDIF
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND C.Cantidad1 <> 0 ")

    *- Para que me traiga las especies de las operaciones de largo plazo
    If Dialogo.Radio2=0
       SQL.ADD("UNION ALL")
       SQL.ADD(" SELECT DISTINCT O.NrOperacion, O.Observac3 ")
       SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".OPERACIONES OT ")
       SQL.ADD(" WHERE O.NrOperacion = C.NrOperacion ")
       SQL.ADD(" AND O.NrOperacion *= OT.OperacionRef  ")
       SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
       SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
       SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
       SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
       SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
       SQL.ADD(" and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD(" and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD(" and O.TipoOp In ('MMONM') ")
       SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
       SQL.ADD(" AND C.Cantidad4 <> 0 ")

       SQL.ADD("UNION ")
       SQL.ADD(" SELECT DISTINCT O.NrOperacion, O.Observac3 ")
       SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES OT ")
       SQL.ADD(" Where O.NrOperacion *= OT.OperacionRef  ")
       SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
       SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
       SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
       SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
       SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
       SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD(" and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD(" and O.TipoOp In ('MMON') ")
       SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
       SQL.ADD(" AND O.TotalNetoCli3 <> 0 ")

       SQL.ADD(" UNION ")

       SQL.ADD("SELECT DISTINCT O.NrOperacion, O.Observac3 ")
       SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
       SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
       SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
       SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
       SQL.ADD(" AND O.Cantidad <> 0 ")

       SQL.ADD("UNION ")

       SQL.ADD("SELECT DISTINCT O.NrOperacion, O.Observac3 ")
       SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
       SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
       SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
       SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
       SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
       SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
       SQL.ADD(" AND C.Cantidad1 <> 0 ")
    Endif

    SQL.ADD(" ORDER BY 1 ")

    Recorrer SQL
        ACT(A:Val(FA:1), fbn('NrOperacion')~' - '~fbn('Observac3'))
        SetFont(a:Val(fa1), 2)
        SCN(fa1,1)
    Proximo
ELSE
    ***---Plazo
    (.'OBLIGANEG3'.)
ENDIF

*- fa11: Utima linea de especies
ACN(fa11,val(fa1))

ACN(fa1, Val(fi6)+10)

ACT(EA:2, '')

***---Variable para query de swaps
ACT(TO:1, 'MMONM|MMON|')


SQL.ADD(" SELECT O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       Sum(C.Cantidad4) Cant, '' OperacionRef, 'OPE' Tipo, O.Contrato MarcaSwap, ' ' ContraEspecie, ")
SQL.ADD("       C.Plazo1 Plazo, C.Precio2 Tasa, C.Precio4 Spread ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".OPERACIONES OT ")
SQL.ADD(" WHERE O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.NrOperacion *= OT.OperacionRef ")
SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.TipoOp In ('MMONM') ")
SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND C.Fecha2 <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND C.Fecha2 > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" AND C.Cantidad4 <> 0 ")

SQL.ADD("GROUP BY O.NrOperacion, O.Vehiculo1, O.Especie, O.FechaVto, O.TipoOp, O.Contrato, C.Plazo1, C.Precio2, C.Precio4 ")

SQL.ADD("UNION ALL ")


SQL.ADD(" SELECT O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("        O.TotalNetoCli3 Cant, '' OperacionRef, 'OPE' Tipo, '' MarcaSwap, ' ' ContraEspecie, ")
SQL.ADD("       O.Plazo, O.Precio1 Tasa, O.Spread ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES OT ")
SQL.ADD(" Where O.NrOperacion *= OT.OperacionRef ")
SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.TipoOp In ('MMON') ")
SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" AND O.TotalNetoCli3 <> 0 ")

*- Para que traiga todos los intereses en el Corto Plazo
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")

   SQL.ADD(" SELECT O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("       0 Cant, '' OperacionRef, 'OPE' Tipo, O.Contrato MarcaSwap, ' ' ContraEspecie, ")
   SQL.ADD("       0 Plazo, 0 Tasa, 0 Spread ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C, "~DBO~".OPERACIONES OT ")
   SQL.ADD(" WHERE O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" AND O.NrOperacion *= OT.OperacionRef  ")
   SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
   SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
   SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
   SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
   SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
   SQL.ADD(" and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.TipoOp In ('MMONM') ")
   SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND C.Cantidad4 <> 0 ")

   SQL.ADD("GROUP BY O.NrOperacion, O.Vehiculo1, O.Especie, O.FechaVto, O.TipoOp, O.Contrato, C.Plazo1, C.Precio2, C.Precio4 ")

   SQL.ADD("UNION ALL ")


   SQL.ADD(" SELECT O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
   SQL.ADD("       0 Cant, '' OperacionRef, 'OPE' Tipo, '' MarcaSwap, ' ' ContraEspecie, ")
   SQL.ADD("       0 Plazo, 0 Tasa, 0 Spread ")
   SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES OT ")
   SQL.ADD(" Where O.NrOperacion *= OT.OperacionRef ")
   SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
   SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
   SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
   SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
   SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
   SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.TipoOp In ('MMON') ")
   SQL.ADD(" and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.TotalNetoCli3 <> 0 ")
Endif

SQL.ADD("ORDER BY 4,2,8 ")


Recorrer SQL

   If Not EqStr(Val(ea2), fbn('NrOperacion')) Y Eqstr(fbn('Tipo'), 'OPE')
      ***---Cambio de Operacion y no es Swap
      If Val(ea6)>0

         *- Ubico la Linea a completar
         Recorrer&j Val(fi6)+10,val(fa11)
            IF Eqstr(Val(EA:2), Copy(Val(A:&j), 1, 8))
               ACN(fa1,&j)
               Break
            EndIf
         Proximo

         *- Recupero los valores de SWAP solamente para Capital
         (.'SWAPOPEFI2'.)

         If EqStr(Dialogo.Especie1,'ARP')
            *- Coloco el codigo de la especie en el encabezado y tambien los valores acumulados
            ACN(b:Val(fa1), Val(sa1))
            ACN(c:Val(fa1), Val(sa2))
            ACN(D:Val(FA:1), Val(SA:1)+Val(SA:2))

            *- Tasa Promedio
            SCN(e:Val(fa1), Val(aa11)/Val(aa10))
            *- Plazo Promedio
            SCN(f:Val(fa1), Val(aa12)/Val(aa10))
      
            SCN(L:Val(fa1), Val(sa1))
            SCN(M:Val(fa1), Val(sa2))
            SCN(O:Val(fa1), Val(sa1)/Dialogo.Precio1)
            SCN(P:Val(fa1), Val(sa2)/Dialogo.Precio1)
            SCN(N:Val(FA:1), Val(sa1)+Val(sa2))
            SCN(Q:Val(FA:1), (Val(sa1)/Dialogo.Precio1)+(Val(sa2)/Dialogo.Precio1))
   
            SetFont(a:Val(fa1), 2)
            SetFont(b:Val(fa1)..q:Val(fa1), 1)
            SCN(fa1, 1)
            SCN(fi12, 1)
         Else
            *- Coloco el codigo de la especie en el encabezado y tambien los valores acumulados
            ACN(g:Val(fa1), Val(sa1))
            ACN(h:Val(fa1), Val(sa2))
            ACN(I:Val(FA:1), Val(SA:1)+Val(SA:2))

            *- Tasa Promedio
            SCN(j:Val(fa1), Val(aa11)/Val(aa10))
            *- Plazo Promedio
            SCN(k:Val(fa1), Val(aa12)/Val(aa10))

            SCN(L:Val(fa1), Val(sa1)*Dialogo.Precio1)
            SCN(M:Val(fa1), Val(sa2)*Dialogo.Precio1)
            SCN(O:Val(fa1), Val(sa1))
            SCN(P:Val(fa1), Val(sa2))
            SCN(N:Val(FA:1), (Val(sa1)*Dialogo.Precio1)+ (Val(sa2)*Dialogo.Precio1))
            SCN(Q:Val(FA:1), Val(sa1)+ Val(sa2) )

            SetFont(a:Val(fa1), 2)
            SetFont(b:Val(fa1)..q:Val(fa1), 1)
            SCN(fa1, 1)
            SCN(fi12, 1)
         Endif
         ACN(AA:10, 0)
         ACN(AA:11, 0)
         ACN(AA:12, 0)
      Endif   
      ACT(EA:2, fbn('NrOperacion'))
      ACN(sa1, 0)
      ACN(sa2, 0)
      ACN(ea6, 1)
   Endif

   **-- Calculo de Intereses Devengados
   ACT(eb1, FBN['TipoOp'])
   ACT(eb2, FBN['NrOperacion'])

   ACT(WW:1, fbn('Especie'))

   IF Not Incluido(Val(WW:1), Var('MONELOCA')~'|'~Var('MONEEXTR')~'|')
      *- Cotizacion
      ACN(ea5, CotizacionC(Val(WW:1),,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   ELSE
      ACN(EA:5, 1)
   ENDIF

   IF Not Eqstr(fbn('NrOperacion'), Val(NR:1)) Y Eqstr(fbn('Tipo'), 'OPE')

      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['ContraEspecie']),1,0))
      
      *- Como los intereses son siempre a Corto Plazo ==> no los calculo en el Largo Plazo
      If Dialogo.Radio2<>1
         *- Recupero los impuestos devengandos de los informes correspondientes
         If Incluido(val(eb1),'MMONM|MMON|')
            LinkearHoja('POONSI', 1, Fecha1=Dialogo.Fecha1, Especie1='',Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1=FBN['NrOperacion'],Lista1= '',Lista2= '',Lista3= '', Radio3=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)
            *--- Valores para linkear en resumen fo1: Imp.Endeudamiento en moneda Original y fo2: WHT en moneda original
            ACN(fo1,LinkH(1,fo1))
            ACN(fo2,LinkH(1,fo2))

            *- Valores para TasaPromedio y Plazo Promedio
            If Dialogo.Radio2=2
               SCN(aa10, LinkH(1,on1))
               SCN(aa11, LinkH(1,on2))
               SCN(aa12, LinkH(1,on3))
            EndIf
            CerrarLink(1)
            *CerrarHoja('POONSI', 1, Fecha1=Dialogo.Fecha1, Especie1='',Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1=FBN['NrOperacion'],Lista1= '',Lista2= '',Lista3= '')
         EndIf
         
         (.'INTERESDEV'.)     
         
         *- Intereses mas impuestos devengados
         SCN(sa2, Val(eb10)+((val(fo1)+val(fo2))*val(ea5)) )
      Endif     
   ENDIF

   SCN(sa1, FBN['Cant']*Val(EA:5))
   ACT(NR:1, fbn('NrOperacion'))
   ACN(EB:10, 0)
Proximo

*- Ubico la Linea a completar
Recorrer&j Val(fi6)+10,val(fa11)
*   If EqStr(val(ea2),val(a:&j))
   IF Eqstr(Val(EA:2), Copy(Val(A:&j), 1, 8))
      ACN(fa1,&j)
      Break
   EndIf
Proximo

*- Recupero los valores de SWAP solamente para Capital
(.'SWAPOPEFI2'.)


***---Sumo ultimo registro
*IF Eqstr(Val(EA:2), Var('MONELOCA'))
IF Eqstr(Dialogo.Especie1, Var('MONELOCA'))
    ACN(b:Val(fa1), Val(sa1))
    ACN(c:Val(fa1), Val(sa2))
    ACN(D:Val(FA:1), Val(SA:1)+Val(SA:2))

    *- Tasa Promedio
    SCN(e:Val(fa1), Val(aa11)/Val(aa10))
    *- Plazo Promedio
    SCN(f:Val(fa1), Val(aa12)/Val(aa10))

    SCN(L:Val(fa1), Val(sa1))
    SCN(M:Val(fa1), Val(sa2))
    SCN(N:Val(FA:1), Val(sa1)+Val(sa2))
    SCN(O:Val(fa1), Val(sa1)/Dialogo.Precio1)

    SCN(P:Val(fa1), Val(sa2)/Dialogo.Precio1)
    SCN(Q:Val(FA:1), (Val(sa1)/Dialogo.Precio1)+(Val(sa2)/Dialogo.Precio1))
    SCN(fi12, 1)
ELSE
    ACN(g:Val(fa:1), Val(sa1))
    ACN(h:Val(fa:1), Val(sa2))
    ACN(I:Val(FA:1), Val(SA:1)+Val(SA:2))

    *- Tasa Promedio
    SCN(j:Val(fa1), Val(aa11)/Val(aa10))
    *- Plazo Promedio
    SCN(k:Val(fa1), Val(aa12)/Val(aa10))

    SCN(L:Val(fa1), Val(sa1)*Dialogo.Precio1)
    SCN(M:Val(fa1), Val(sa2)*Dialogo.Precio1)
    SCN(O:Val(fa1), Val(sa1))
    SCN(P:Val(fa1), Val(sa2))
    SCN(N:Val(FA:1), (Val(sa1)*Dialogo.Precio1)+(Val(sa2)*Dialogo.Precio1))
    SCN(Q:Val(FA:1), Val(sa1)+Val(sa2))

    SCN(fi12, 1)
ENDIF

ACN(AA:10, 0)
ACN(AA:11, 0)
ACN(AA:12, 0)

FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))

*----------------------------------------------------------------
ACN(fo1, 0)
ACN(fo2, 0)
ACN(fo3, 0)
ACN(fo4, 0)
ACN(fo5, 0)
ACN(fo6, 0)
ACN(fo7, 0)
ACT(es1, '')

*- FRN
SQL.ADD("SELECT O.Especie,Sum(O.Cantidad) as Cantidad, O.NrOperacion, O.Vehiculo1  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND O.Cantidad <> 0 ")
SQL.ADD("GROUP BY O.Especie, O.NrOperacion, O.Vehiculo1 ")

SQL.ADD("UNION ALL ")

SQL.ADD("SELECT O.Especie,Sum(C.Cantidad1) as Cantidad, O.NrOperacion, O.Vehiculo1  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND C.Cantidad1 <> 0 ")
SQL.ADD("GROUP BY O.Especie, O.NrOperacion, O.Vehiculo1 ")

*- Para que traiga todos los intereses en el Corto Plazo.
If Dialogo.Radio2=0
   SQL.ADD("UNION ALL")
   SQL.ADD("SELECT O.Especie, 0 as Cantidad, O.NrOperacion, O.Vehiculo1 ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
   SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD(" AND O.Cantidad <> 0 ")
   SQL.ADD("GROUP BY O.Especie, O.NrOperacion, O.Vehiculo1 ")

   SQL.ADD("UNION ALL ")

   SQL.ADD("SELECT O.Especie, 0 as Cantidad, O.NrOperacion, O.Vehiculo1 ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
   SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
   SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
   SQL.ADD(" AND C.Cantidad1 <> 0 ")
   SQL.ADD("GROUP BY O.Especie, O.NrOperacion, O.Vehiculo1 ")
Endif

SQL.ADD("ORDER BY 3 ")

Recorrer SQL

   Message(' FRN '~FBN['Especie'])

*   IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
   IF Not EqStr(val(es1), fbn('NrOperacion')) y NoVacio(val(es1))
      Recorrer&j Val(fi6)+10,val(fa11)
          IF Eqstr(Val(ES:1), Copy(Val(A:&j), 1, 8))
             ACN(fa1,&j)
             Break
          EndIf
      Proximo
      
      *- fo1: Capital fo2:Interes + Impuestos fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo
      (.'TOTALRESU3'.)

      *- Parte de TOTALRESU4
      ACN(e:val(fa1),val(e:val(fa1))/val(u:val(fa1)))
      ACN(f:val(fa1),val(f:val(fa1))/val(t:val(fa1)))

      ACN(j:val(fa1),val(j:val(fa1))/val(w:val(fa1)))
      ACN(k:val(fa1),val(k:val(fa1))/val(v:val(fa1)))

      *- Totales en Pesos (l,m,n) y Totales en USD (o,p,q).
      ACN(l:val(fa1),val(b:val(fa1))+(val(g:val(fa1))*Dialogo.Precio1))
      ACN(m:val(fa1),val(c:val(fa1))+(val(h:val(fa1))*Dialogo.Precio1))
      ACN(n:val(fa1),val(l:val(fa1))+val(m:val(fa1)))

      ACN(o:val(fa1),(val(b:val(fa1))/Dialogo.Precio1)+val(g:val(fa1)))
      ACN(p:val(fa1),(val(c:val(fa1))/Dialogo.Precio1)+val(h:val(fa1)))
      ACN(q:val(fa1),val(o:val(fa1))+val(p:val(fa1)))
      SetFont(b:Val(fa1)..q:Val(fa1), 1)

      ACN(fo1,0)
      FormatoCeldas(e:Val(fa1), Exe('F5'))
      FormatoCeldas(j:Val(fa1), Exe('F5'))
      FormatoCeldas(f:Val(fa1), Exe('F2'))
      FormatoCeldas(k:Val(fa1), Exe('F2'))
      FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
      FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
      FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))
   EndIf

   *- Corte de Control Por Operacion para invocar al Informe
*   IF Not EqStr(val(es1),FBN['Especie'])
   IF Not EqStr(val(es1), fbn('NrOperacion'))
      *- Ubico la Linea a completar
*      ACT(es1,FBN['Especie'])
      ACT(ES:1, fbn('NrOperacion'))
  
      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),FBN['Especie']),1,0))
      ACN(pr1,1)

      If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
         ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
      EndIf

      If Dialogo.Radio2<>1
         LinkearHoja('PRESTF', 1, Fecha1=Dialogo.Fecha1,Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1=fbn('NrOperacion'),Lista1= '',Lista2='MMFIMV|MMFRP|', Radio3=Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)

         *- fo2: Interes fo3: WH devengado fo4: comisiones devengadas fo5:Tasa Promedio fo6:Plazo Promedio 
         ACN(fo2,LinkH(1,fo2)+LinkH(1,fo3)+LinkH(1,fo4))

         ACN(fo5,0)
         ACN(fo6,0)
         ACN(fo7,0)

         If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
            *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
            *- Tasa y plazo promedio solo para corto+largo
            ACN(fo5,LinkH(1,fo5)) 
            ACN(fo6,LinkH(1,fo6))
            ACN(fo7,LinkH(1,fo7))
         EndIf
         CerrarLink(1)
*         CerrarHoja('PRESTF', 1, Fecha1=Dialogo.Fecha1,Especie1=FBN['Especie'],Cliente1='',Radio1=val(ra2),Radio4=0,NrOperacion1='',Lista1= '',Lista2='MMFIMV|MMFRP|')
      Endif
   EndIf

   SCN(fo1,FBN['Cantidad'])
Proximo

IF NoVacio(val(es1)) 
   *- Ubico la Linea a completar
   Recorrer&j Val(fi6)+10,val(fa11)
*         If EqStr(FBN['Especie'],val(a:&j))
      IF Eqstr(Val(ES:1), Copy(Val(A:&j), 1, 8))
         ACN(fa1,&j)
         Break
      EndIf
   Proximo
   *- fo1: Capital fo2:Interes + Impuestos fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo
   (.'TOTALRESU3'.)


   *- Parte de TOTALRESU4
   ACN(e:val(fa1),val(e:val(fa1))/val(u:val(fa1)))
   ACN(f:val(fa1),val(f:val(fa1))/val(t:val(fa1)))

   ACN(j:val(fa1),val(j:val(fa1))/val(w:val(fa1)))
   ACN(k:val(fa1),val(k:val(fa1))/val(v:val(fa1)))

   *- Totales en Pesos (l,m,n) y Totales en USD (o,p,q).
   ACN(l:val(fa1),val(b:val(fa1))+(val(g:val(fa1))*Dialogo.Precio1))
   ACN(m:val(fa1),val(c:val(fa1))+(val(h:val(fa1))*Dialogo.Precio1))
   ACN(n:val(fa1),val(l:val(fa1))+val(m:val(fa1)))

   ACN(o:val(fa1),(val(b:val(fa1))/Dialogo.Precio1)+val(g:val(fa1)))
   ACN(p:val(fa1),(val(c:val(fa1))/Dialogo.Precio1)+val(h:val(fa1)))
   ACN(q:val(fa1),val(o:val(fa1))+val(p:val(fa1)))
   SetFont(b:Val(fa1)..q:Val(fa1), 1)

   ACN(fo1,0)
EndIf

FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))

