SQL.ADD("  from "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("  where M.NrTrans2 = T.NrTrans                    ")
SQL.ADD("  and   T.NrTrans  = B.NrOperacion                ")
SQL.ADD("  and   B.NrBit In (1,11,3,6,70,8)                ")
SQL.ADD("  and   B.Valor = '1'                             ") 
SQL.ADD("  and   M.NrSaldo in (1,81)                       ")
SQL.ADD("  and   T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"'  ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and   T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
If Dialogo.Radio6=1
   SQL.ADD("  and T.Cliente1 In (SELECT C.Codigo FROM  "~DBO~".AGENTES Ag, "~DBO~".CLIENTES C WHERE Ag.Codigo = C.NrAgenteBolsa) ")
   SQL.ADD("  and M.Cliente = T.Cliente1 ")
Else 
   SQL.ADD("  and T.Cliente1 Not In (SELECT C.Codigo FROM  "~DBO~".AGENTES Ag, "~DBO~".CLIENTES C WHERE Ag.Codigo = C.NrAgenteBolsa) ")
   If Dialogo.Radio6<>2
      SQL.ADD("  and   M.Cliente = T.Cliente1 ")
   Else 
   SQL.ADD("  and T.Ley4 In ("~Pipe2Comillas(VAR('RUECPC1'))~")  ")
   EndIf
EndIf




