   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, 0 Imp from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMO','MMCCR') ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf
Endif

SQL.ADD("order by 1, 2 ")

Recorrer SQL
   If Val(bb:2010) = 0
      ACT(c:fac, "Depositos overnight")
      SetFont(c:fac, 2)
      ACN(bb:2010, 1)
      ***---SCN(c:2000, 1)
      ACN(c:2000, fac)
           
      *--> Seteo en cero la fila
      recorrer&i Val(VT:1), Val(cc:1990)
         ACN(&i:fac, 0)
      PROXIMO

      SCN(fl:2, 1)
   EndIf

   ACN(mt:1001, FBN['Cant'])
   ACN(mt:2002, FBN['Int'])
   ACN(mt:3003, FBN['Imp'])
    
   If FBN['Precio2']=0  y Dialogo.Radio10=0
      ACT(NT:1000, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
      (.'RMONTOTOMV'.)
   EndIf
   
   ACN(mt:1100, 0)
   SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )

   *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
   If Val(cz:2) = 0
      ACN(mt:1200, IIf(Incluido(FBN['TipoOp'],'FCS|FCR'),CotizacionC(FBN['Especie'],,,,HABILES(Dialogo.Fecha1,1,VAR('FERIADODEF'),SI),1,SI,Val(ML:1)),CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1))) )
   Else
      ACN(mt:1200, IIf(Incluido(FBN['TipoOp'],'FCS|FCR'),CotizacionC(FBN['Especie'],,,,HABILES(Dialogo.Fecha1,1,VAR('FERIADODEF'),SI),1,SI,Val(ME:1)),CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1))) )
   EndIf
   
   *--> Diario
   recorrer&i Val(VT:1), Val(lm:1)
      If FBN['Fecha'] = Val(&i:Val(xx:2000))
         ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      Endif
   Proximo

   Recorrer&i Val(lm:1)+1, Val(lm:2)-1
      If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
         ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      Endif
   Proximo

   *--> Para la ultima columna de meses
   If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
      ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
   EndIf
Proximo

SetFilaActual(Val(fl:2))
