************************************* D E P O S I T O S  A  P L A Z O ******************************************************
SetFilaActual(Val(fl:2))
ACN(bb:2010, 0)

*--> Monto de MMCPM E Intereses de MMCDIA
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("(CASE WHEN TipoOp='MMCDIA' THEN 0 ELSE C.Cantidad1 END)/1000 Cant, C.Cantidad3/1000 Int, ")
SQL.ADD("(CASE WHEN TipoOp='MMCDIA' THEN 0 ELSE C.Total3-C.Cantidad3 END)/1000 Imp, C.Precio2, C.NrCuota ")
*SQL.ADD("DECODE(TipoOp, 'MMCDIA', 0, C.Cantidad1)/1000 Cant,C.Cantidad3/1000 Int,DECODE(TipoOp, 'MMCDIA', 0, C.Total3-C.Cantidad3) /1000 Imp,C.Precio2,C.NrCuota ")
SQL.ADD("from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.TipoOp In ('MMCPM','MMCDIA') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD(" Union All ")

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
SQL.ADD("(CASE WHEN TipoOp='MMDCA' THEN O.TotalNetoCli1 WHEN TipoOp='MMD   ' THEN O.TotalBrutoCli1 ELSE O.Cantidad END) /1000 Cant, ")
SQL.ADD("(CASE WHEN TipoOp='MMCP  ' THEN O.TotalIntereses ELSE 0 END) /1000 Int, ")
SQL.ADD("(CASE WHEN TipoOp='MMCP  ' THEN O.TotalNetoCli2 - O.TotalIntereses ELSE 0 END) /1000 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
*SQL.ADD("DECODE(TipoOp, 'MMDCA ', O.TotalNetoCli1, 'MMD   ', O.TotalBrutoCli1, O.Cantidad) /1000 Cant, ")
*SQL.ADD("DECODE(TipoOp, 'MMCP  ', O.TotalIntereses, 0) /1000 Int, DECODE(TipoOp, 'MMCP  ', O.TotalNetoCli2 - O.TotalIntereses, 0) /1000 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.TipoOp In ('MMCDIA','MMCP','MMDCA','MMD') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD(" Union All ")

*SQL.ADD("Select O.Vehiculo1, O.Especie,DECODE(Plazo2, 0, O.FechaVto, O.FechaVto2) Fecha, O.NrOperacion, O.TipoOp,  ")
*SQL.ADD("O.Cantidad/1000 Cant, DECODE(Plazo2, 0, O.TotalIntereses, O.TotalAux1) /1000 Int,0 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")

SQL.ADD("Select O.Vehiculo1, O.Especie, (CASE WHEN Plazo2=0 THEN O.FechaVto ELSE O.FechaVto2 END) Fecha, O.NrOperacion, O.TipoOp,  ")
SQL.ADD("O.Cantidad/1000 Cant, (CASE WHEN Plazo2=0 THEN O.TotalIntereses ELSE O.TotalAux1 END) /1000 Int, 0 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and ((O.Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("       or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' )) ")
SQL.ADD("  and O.TipoOp In ('MMCDP') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

SQL.ADD(" Union All ")

SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("(CASE WHEN TipoOp='FCS   ' THEN O.Cantidad ELSE -O.Cantidad END) /1000 Cant, 0 Int, 0 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPERACIONES  O ")
*SQL.ADD("DECODE(TipoOp, 'FCS   ', O.Cantidad, -O.Cantidad) /1000 Cant,0 Int, 0 Imp,1 Precio2,0 NrCuota from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.TipoOp In ('FCS','FCR') ")

If Dialogo.Radio1 = 1
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.ContraEspecie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.ContraEspecie <> '"~Val(ML:1)~"' ")
EndIf

*--> Minutas reales o simuladas
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, ")
*   SQL.ADD("DECODE(TipoOp, 'MMCPM ', C.Total2, 0) /1000 Cant, DECODE(TipoOp, 'MMCDIA', C.Cantidad3, 0) /1000 Int,0 Imp,C.Precio2,C.NrCuota ")
   SQL.ADD("(CASE WHEN TipoOp='MMCPM ' THEN C.Total2 ELSE 0 END) /1000 Cant, (CASE WHEN TipoOp='MMCDIA' THEN C.Cantidad3 ELSE 0 END) /1000 Int, ")
   SQL.ADD("0 Imp,C.Precio2,C.NrCuota from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp In ('MMCPM','MMCDIA') ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
*   SQL.ADD("DECODE(TipoOp, 'MMDCA ', O.TotalNetoCli1, 'MMD   ', O.TotalBrutoCli1, O.Cantidad) /1000 Cant, ")
*   SQL.ADD("DECODE(TipoOp, 'MMCP  ', O.TotalIntereses, 0) /1000 Int, DECODE(TipoOp, 'MMCP  ', O.TotalNetoCli2 - O.TotalIntereses, 0) /1000 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("(CASE WHEN TipoOp='MMDCA ' THEN O.TotalNetoCli1 WHEN TipoOp='MMD   ' THEN O.TotalBrutoCli1 ELSE O.Cantidad END) /1000 Cant, ")
   SQL.ADD("(CASE WHEN TipoOp='MMCP  ' THEN O.TotalIntereses ELSE 0 END) /1000 Int, ")
   SQL.ADD("(CASE WHEN TipoOp='MMCP  ' THEN O.TotalNetoCli2 - O.TotalIntereses ELSE 0 END) /1000 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp In ('MMCDIA','MMCP','MMDCA','MMD') ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,  ")
*   SQL.ADD("O.Cantidad/1000 Cant, DECODE(Plazo2, 0, O.TotalIntereses, O.TotalAux1) /1000 Int,0 Imp,1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("O.Cantidad/1000 Cant, (CASE WHEN Plazo2=0 THEN O.TotalIntereses ELSE O.TotalAux1 END) /1000 Int, 0 Imp, 1 Precio2, ")
   SQL.ADD("0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and ((Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("       or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2<='"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD("  and O.TipoOp In ('MMCDP') ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf

   SQL.ADD(" Union All ")

   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
*   SQL.ADD("DECODE(TipoOp, 'FCS   ', O.Cantidad, -O.Cantidad) /1000 Cant,0 Int, 0 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("(CASE WHEN TipoOp='FCS   ' THEN O.Cantidad ELSE -O.Cantidad END) /1000 Cant, 0 Int, 0 Imp, 1 Precio2, 0 NrCuota from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and O.TipoOp In ('FCS','FCR') ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.ContraEspecie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.ContraEspecie <> '"~Val(ML:1)~"' ")
   EndIf
Endif

SQL.ADD("order by 1, 2 ")

Recorrer SQL
If FBN['Fecha'] >= Dialogo.Fecha1
   If Val(bb:2010) = 0
      SCN(fl:2, 1)
      SetFilaActual(Val(fl:2))
      ACT(c:fac, "Depositos a plazo")
      SetFont(c:fac, 2)
      ACN(bb:2010, 1)
      ***---SCN(c:2000, 2)
      ACN(c:2000, fac)

      *--> Seteo en cero la fila
      recorrer&i Val(VT:1), Val(cc:1990)
         ACN(&i:fac, 0)
      PROXIMO
   EndIf

   ACN(mt:1001, FBN['Cant'])
   ACN(mt:2002, FBN['Int'])
   ACN(mt:3003, FBN['Imp'])
   
   If FBN['Precio2']=0 y Dialogo.Radio10=0
      ACT(NT:1000, fbn('NrOperacion'))
      *--> Tasa en 0, llamo a la fc. para calcular el monto total mt1001: Monto Total/1000
      (.'RMONTOTOMV'.)
   EndIf
      
   ACN(mt:1100, 0)
   SCN(mt:1100, Val(mt:1001) + Val(mt:2002) + Val(mt:3003) )

   *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)

   If Val(cz:2) = 0
      ACN(mt:1200, IIf(Incluido(FBN['TipoOp'],'FCS|FCR'),CotizacionC(FBN['Especie'],,,,HABILES(Dialogo.Fecha1,1,VAR('FERIADODEF'),SI),1,SI,Val(ML:1)),CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1))))
   Else
      ACN(mt:1200, IIf(Incluido(FBN['TipoOp'],'FCS|FCR'),CotizacionC(FBN['Especie'],,,,HABILES(Dialogo.Fecha1,1,VAR('FERIADODEF'),SI),1,SI,Val(ME:1)),CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1))))
   EndIf

   *--> Diario
   recorrer&i Val(VT:1), Val(lm:1)
      If FBN['Fecha'] = Val(&i:Val(xx:2000))
         ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      Endif
   Proximo

   *--> Mensual
   Recorrer&i Val(lm:1)+1, Val(lm:2)-1
      If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
         ACN(&i:Val(c:2000), Round(Val(&i:Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
         ACN(&i:Val(h:2000), Round(Val(&i:Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      Endif
   Proximo

   *--> Para la ultima columna de meses
   If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
      ACN(Val(lm:2):Val(c:2000), Round(Val(Val(lm:2):Val(c:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
      ACN(Val(lm:2):Val(h:2000), Round(Val(Val(lm:2):Val(h:2000)), 2) + Round(Round(Val(mt:1100), 2) * Val(mt:1200), 2))
   EndIf
EndIf
Proximo


***** D E P O S I T O S  P O R  C O M P R A / V E N T A  D E  M O N E D A S  N O  P U E S T O *****

SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD(" O.Cantidad/1000 Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaPago <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto <> O.FechaPago ")

*--> Consolidado Vehiculo
If Dialogo.Radio1 = 1
   SQL.ADD(" and O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Else
   SQL.ADD(" and O.TipoOp In ('FXCS','FXVS') ")
Endif

If Val(cz:2) = 0
   SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
Else
   SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
EndIf

*--> Minutas reales o simuladas
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")

   SQL.ADD(" Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")   
   SQL.ADD(" O.Cantidad/1000 Cant ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD(" where O.FechaPago <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("   and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("   and O.FechaVto <> O.FechaPago ")

   If Dialogo.Radio1 = 1
      SQL.ADD(" and O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
      SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Else
      SQL.ADD(" and O.TipoOp In ('FXCS','FXVS') ")
   Endif

   If Val(cz:2) = 0
      SQL.ADD("  and O.Especie = '"~Val(ML:1)~"' ")
   Else
      SQL.ADD("  and O.Especie <> '"~Val(ML:1)~"' ")
   EndIf
Endif

SQL.ADD("order by 1, 2 ")

Recorrer SQL
   If FBN['Fecha'] >= Dialogo.Fecha1
      If Val(bb:2010) = 0
         ACT(c:fac, "Depositos a plazo")
         SetFont(c:fac, 2)
         ACN(bb:2010, 1)
         ***---SCN(c:2000, 2)
         ACN(c:2000, fac)

         *--> Seteo en cero la fila
         recorrer&i Val(VT:1), Val(cc:1990)
            ACN(&i:fac, 0)
         PROXIMO

         SCN(fl:2, 1)
      EndIf

      *--> ML:1 -> Cuadro en pesos MONELOCA (ML:1) / Cuadro en dolares -> MONEEXTR (ME:1)
      If Val(cz:2) = 0
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ML:1)) )
      Else
         ACN(mt:1200, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(ME:1)) )
      EndIf
   
      *--> Diario
      recorrer&i Val(VT:1), Val(lm:1)
         If FBN['Fecha'] = Val(&i:Val(xx:2000))
            If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
               ACN(&i:Val(C:2000), Round(Val(&i:Val(C:2000)), 2) + Round(Round(FBN['Cant'], 2) * Val(mt:1200), 2))
               ACN(&i:Val(H:2000), Round(Val(&i:Val(H:2000)), 2) + Round(Round(FBN['Cant'], 2) * Val(mt:1200), 2))
            Else
               ACN(&i:Val(C:2000), Round(Val(&i:Val(C:2000)), 2) + Round(Round(-FBN['Cant'], 2) * Val(mt:1200), 2))
               ACN(&i:Val(H:2000), Round(Val(&i:Val(H:2000)), 2) + Round(Round(-FBN['Cant'], 2) * Val(mt:1200), 2))
            Endif
         Endif
      Proximo
      Recorrer&i Val(lm:1)+1, Val(lm:2) -1
         If Anio(FBN['Fecha']) = Anio(Val(gg:&i)) y Mes(FBN['Fecha']) = Mes(Val(gg:&i))
            If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
               ACN(&i:Val(C:2000), Round(Val(&i:Val(C:2000)), 2) + Round(Round(FBN['Cant'], 2) * Val(mt:1200), 2))
               ACN(&i:Val(H:2000), Round(Val(&i:Val(H:2000)), 2) + Round(Round(FBN['Cant'], 2) * Val(mt:1200), 2))
            Else
               ACN(&i:Val(C:2000), Round(Val(&i:Val(C:2000)), 2) + Round(Round(-FBN['Cant'], 2) * Val(mt:1200), 2))
               ACN(&i:Val(H:2000), Round(Val(&i:Val(H:2000)), 2) + Round(Round(-FBN['Cant'], 2) * Val(mt:1200), 2))
            Endif
         Endif
      Proximo

      *--> Para la ultima columna de meses
      If Anio(FBN['Fecha']) >= Anio(Val(gg:Val(lm:2))) y Mes(FBN['Fecha']) >= Mes(Val(gg:Val(lm:2)))
         If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
            ACN(Val(lm:2):Val(C:2000), Round(Val(Val(lm:2):Val(C:2000)), 2) + Round(Round(FBN['Cant'], 2) * Val(mt:1200), 2))
            ACN(Val(lm:2):Val(H:2000), Round(Val(Val(lm:2):Val(H:2000)), 2) + Round(Round(FBN['Cant'], 2) * Val(mt:1200), 2))
         Else
            ACN(Val(lm:2):Val(C:2000), Round(Val(Val(lm:2):Val(C:2000)), 2) + Round(Round(-FBN['Cant'], 2) * Val(mt:1200), 2))
            ACN(Val(lm:2):Val(H:2000), Round(Val(Val(lm:2):Val(H:2000)), 2) + Round(Round(-FBN['Cant'], 2) * Val(mt:1200), 2))
         Endif
      EndIf
   EndIf
Proximo

SetFilaActual(Val(fl:2))

************************************* D E P O S I T O S  O V E R N I G H T *************************************************
