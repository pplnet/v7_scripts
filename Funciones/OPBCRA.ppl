Recorrer&i val(u3), val(u4)
  *** Borra renglones que no van ***
  if SQL("Select Count(*) from "~DBO~".CODOPBCRA where TipoOperacion Like '%"~Trim(val(ag:&i))~"%' ") <= 0
     BorrarCeldas(aa:&i..bz:&i)
  else
     SQL.ADD("Select * from "~DBO~".CODOPBCRA ")
     SQL.ADD("where TipoOperacion Like '%"~Trim(val(ag:&i))~"%'")     
     SQL.ADD("  and (Especie = '"~val(av:&i)~"' or Especie is Null) ")
     SQL.ADD("  and (ConceptoCA Like '%"~Trim(val(az:&i))~"%'  or ConceptoCA is Null) ")
     SQL.ADD(" order by Codigo ")

     acn(bz1,0)
     Recorrer SQL
       *** arreglo de error en la busqueda del tipo de operacion ***
       if Incluido(Trim(val(ag:&i)),FBN['TipoOperacion'])
          if Vacio(FBN['TipoCuenta'])
             acn(be:&i,FBN['Codigo'])
             acn(bz1,1)
            else          
             act(bf:&i,FBN['TipoCuenta'])
             if EqStr(val(bf:&i),val(bg:&i))
                acn(be:&i,FBN['Codigo'])
                acn(bz1,1)
             endif
          endif
       endif
       dfa
     Proximo

     if val(bz1) = 0
        BorrarCeldas(aa:&i..bz:&i)
     endif
  endif
Proximo
