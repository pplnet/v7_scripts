    IF Not Eqstr(fbn('ContraEspecie'), 'ARP')
        ACN(CT:1, Cotizacion(fbn('ContraEspecie'),,,,fbn('FechaOp'),5,SI))
    ELSE
        ACN(CT:1, 1)
    ENDIF

    IF Not Eqstr(Dialogo.Especie1, 'ARP')
        ACN(CT:2, CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
    ELSE
        ACN(CT:2, Val(CT:1))
    ENDIF
    
    if Val(aw1)>46
       ifa
       #ifdef MLASA
       #else
       if Dialogo.Radio1=1
          if Val(aw5)=0
             ACT(aw2, GetNumerador(990))
             ACN(aw3, Num(Val(aw2)))
          else
             SCN(aw3,1)
          endif
          setfilaactual(fac+3)
          IF EqStr(VAR('COPIATPAG'),'SI')
             ACT(l:fac, 'Folio: '~FStr(Val(aw4),1,0))       
          ENDIF
          if val(ay1) = 0
             ACN(ay1, Val(aw3))
          endif
       else
         setfilaactual(fac+3)
         IF EqStr(VAR('COPIATPAG'),'SI')
            ACT(l:fac, 'Provisorio - Pag. '~FStr(Val(aw4),1,0))
         ENDIF
       endif
       #endif
       SaltarHoja    
       SCN(aw4, 1)
       IFA
       ACT(j:FAC+1, val(xx1))
       if Dialogo.Fecha2>Dialogo.Fecha1
          ACT(j:FAC+2, 'Registro de Operaciones Cheques desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
       else
          ACT(j:FAC+2, 'Registro de Operaciones Cheques del '~Dialogo.Fecha1)
       endif
       AlinearCeldas(j:FAC+1..j:FAC+2,'C')
        
       SetFilaActual(fac+4)
       
       ACT(a:FAC, 'Boleto')
       ACT(b:FAC, 'Nro Minuta')
       ACT(c:FAC, 'Fecha Op.')
       ACT(d:FAC, 'Fecha Liq.')
       ACT(e:FAC, 'Tipo Op')
       ACT(f:FAC, 'Plazo')
       ACT(g:FAC, 'Especie')
       ACT(h:FAC, 'Cliente - Nro.CUIT/CUIL')
       ACT(i:fac, 'Moneda')
       ACT(j:fac, 'Compras')
       ACT(k:fac, 'P.Prom. Compras')
       ACT(l:fac, 'Monto Compras')
       ACT(m:fac, 'Ventas')
       ACT(n:fac, 'P.Prom. Ventas')
       ACT(o:fac, 'Monto Ventas')

       AlinearCeldas(a:FAC..k:fac,'C')
       AgregarMarco(a:FAC..o:fac,2)
       SetFont(a:FAC..o:fac,2)
       ifa 

       **ACN(aa:1,FAC+1)
       ACN(aw1, 5)
    endif
    
    SCN(aw1, 1)
    SCN(vi2,1)    

    ACT(a:FAC, IIF(longitud(fbn['NrBoleto'])<=6,fbn['NrBoleto'],Copy(fbn['NrBoleto'],longitud(fbn['NrBoleto'])-5,6)) )
    ACT(b:FAC, Copy(fbn['NrOperacion'],1,8))
    ACLO(b:FAC, Copy(fbn['NrOperacion'],1,8))
    ACD(c:FAC, fbn['FechaOp'])
    ACD(d:FAC, fbn['FechaOp2'])
    If Incluido(fbn['TipoOp'],'DDC')
       ACT(e:FAC, 'Compra')
    EndIf
    If Incluido(fbn['TipoOp'],'DDV')
       ACT(e:FAC, 'Venta')
    Endif    
    ACT(f:fac, FStr(difdias(fbn('FechaOp'),fbn('FechaOp2'),'ARG',Si),0,0))
    ACT(g:fac, 'CHEQUES')     
    ACT(h:fac, fbn('RazonSocial')~' - '~fbn('CUIT'))
    ACT(i:fac, fbn['Nombre'])
    if Incluido(fbn('TipoOp'),'DDC')
       ACN(j:fac, fbn('TotalBrutoCli1'))
       ACN(k:fac, fbn('Cantidad')/fbn('TotalBrutoCli1')*100)
       ACN(l:fac, fbn('Cantidad'))
    else
       ACN(m:fac, fbn('TotalBrutoCli1'))
       ACN(n:fac, fbn('Cantidad')/fbn('TotalBrutoCli1')*100)
       ACN(o:fac, fbn('Cantidad'))
    endif
    
    SetFont(a:FAC..y:fac,1)  
    FormatoCeldas(f:fac..k:fac, EXE('F2'))
    FormatoCeldas(g:fac, EXE('F9'))
    FormatoCeldas(j:fac, EXE('F9'))

    ACD(fo:1, fbn('FechaOp'))
    ACN(me:1, mes(fbn['FechaOp']))    
