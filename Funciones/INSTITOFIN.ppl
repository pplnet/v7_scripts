    **-inserto datos en DETITOFIN-**
    SQL.ADD("INSERT INTO "~DBO~".DETITOFIN ( ")
    SQL.ADD("Fecha, Especie, TipCupon, CuentaContable, ValorResidual, ")
    SQL.ADD("ValorContable, ValorContValuado) ")
    SQL.ADD("VALUES ( ")
    SQL.ADD("'"~Idxdate(&i)~"','"~&especieDeCorte~"', "~Fstr(&tipoCupon, 0, 0)~",'"~&cuentaContable~"',"~Fstr(&valorResidual, 0, 0)~", ")
    SQL.ADD(" "~Fstr(&valorContable, 0, 0)~", "~Fstr(&valorContadoValuado, 0, 2)~") ")
    SQL.NEW
    SQL.EXEC 
