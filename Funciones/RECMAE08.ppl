**************************
*** Resumen de Operaciones
**************************

BorrarCeldas(s:1..t:31)
ACT(s:1, 't:1 FechaSys')
ACT(s:2, 't:2 Fecha')
ACT(s:3, 't:3 Tipo Res.')
ACT(s:4, 't:4 Represent.')
ACT(s:5, 't:5 Tipo Neg.')
ACT(s:6, 't:6 Cupon') 
ACT(s:7, 't:7 Especie MAE')
ACT(s:8, 't:8 Especie')
ACT(s:9, 't:9 Moneda MAE')
ACT(s:10, 't:10 Mon.Cot.MAE')
ACT(s:11, 't:11 Mon.Cot.Esp.')
ACT(s:12, 't:12 Cupon MAE')
ACT(s:13, 't:13 Cupon Especie')
ACT(s:14, 't:14 Cant.Especies')
ACT(s:15, 't:15 Plazo')
ACT(s:16, 't:16 Tipo')
ACT(s:17, 't:17 FechaEj')
ACT(s:18, 't:18 Precio')
ACT(s:19, 't:19 Cant.Cot.')
ACT(s:20, 't:20 NrCupon2')
ACT(s:21, 't:21 NrCupon')
ACT(s:22, 't:22 CuponVig')
ACT(s:23, 't:23 CuponAnt')
ACT(s:24, 't:24 PlazoEsp')
ACT(s:25, 't:25 PlazoCot')
ACT(s:26, 't:26 Cant.Piz')
* FJL 28/12/20 - Nuevos campos NIIF
ACT(s:27, 't:27 PlazoLiq')
ACT(s:28, 't:28 Mercado')
ACT(s:29, 't:29 Fuente')
ACT(s:30, 't:30 Usa Precios No Rep')
ACT(s:31, 't:31 Baja todos los Plazos')

ACD(t:1, FSYS)
ACD(t:2, Fecha(Copy(Val(A:FAC),39,2)~'/'~Copy(Val(A:FAC),37,2)~'/'~Copy(Val(A:FAC),33,4)))
ACT(t:3, Copy(Val(A:FAC),32,1))
ACT(t:4, Copy(Val(A:FAC),193,1))
ACT(t:5, Copy(Val(A:FAC),45,1))
ACT(t:6, Copy(Val(A:FAC),51,1))
ACT(t:7, Copy(Val(A:FAC),46,5))
* FJL 28/12/20 - Nuevos campos NIIF
ACT(t:28, Var('AMBMAE'))
ACT(t:29, Var('AMBMAE'))
if EqStr(BuscarCampo('VARIABLES','Valor','Codigo','MAENOREPRE'),'SI')
  ACN(t:30, 1)
else
  ACN(t:30, 0)
endif
if EqStr(BuscarCampo('VARIABLES','Valor','Codigo','MAEPLACOMP'),'SI')
  ACN(t:31, 1)
else
  ACN(t:31, 0)
endif
ACN(x1, 0)
ACN(x2, 0)
ACN(x3, 0)
if Val(t:2)=Val(t:1) o SI
  ** Es de Hoy
  if EqStr(Val(t:3),'F')
    ** Es Final
* FJL 28/09/23 - Informaron de BIND que segun el MAE este campo debe descartarse - Ver mail de Noemi Campos.
*    if EqStr(Val(t:4),' ')
* FJL 22/11/23 - Toma  criterio dependiendo de Variable MAENOREPRE
*    if EqStr(Val(t:4),' ') o SI
    if EqStr(Val(t:4),' ') o Val(t:30)=1
      ** Es Representativo
      if EqStr(Val(t:5),'1')
        ** Es Titulo Publico
        if EqStr(Val(t:6),' ')
          ** No Es Cupon
          ACN(x1,1)
        endif
      endif
    endif
  endif
endif

* Buscar especie correspondiente
if Val(x1)=1
  SQL.ADD("Select Codigo, Cupon, Cotiza, PlazoLiq ")
  SQL.ADD("  from "~DBO~".ESPECIES ")
  SQL.ADD(" where CodMAEContado      =  '"~Val(t:7)~"' ")
  SQL.ADD("   and IsNull(EsCupon,'') <> '1' " )
  recorrer SQL
    DFA
    ACT(t:8, fbn('Codigo'))
    ACT(t:11, fbn('Cotiza'))
    ACT(t:13, Pad0(FStr(fbn('Cupon'),1,0),3))
* FJL 05/09/18
*    ACN(t:24, fbn('PlazoLiq'))
    ACN(t:24, fbn('PlazoLiq')/24)
    SCN(t:14, 1)
  proximo
  ** Moneda
  ACT(t:9, Copy(Val(A:FAC),58,1))
  if EqStr(Val(t:9),'$')
    ACT(t:10, 'ARP')
  endif
  if EqStr(Val(t:9),'D')
    ACT(t:10, 'USD')
  endif
  ** Nro Cupon
  ACT(t:12, Copy(Val(A:FAC),52,3))

  if NoVacio(Val(t:8))
    if NoVacio(Val(t:10))
      **controlo si estoy en periodo de ex cupon
      acn(t:23,0)
      acn(t:22,1)

** FJL 03-09-2018 - En STD no existe el campo FechaExCupon en AGNEDACUPONES      
*      SQL.ADD(" Select A.FechaExCupon, A.FechaCorte from "~DBO~".AGENDACUPONES A   ")
*      SQL.ADD(" where  A.Especie  = '"~Val(t:8)~"'            ")
*      SQL.ADD(" AND    A.NrCupon  = '"~Fstr(Num(Val(t:12)),0,0)~"'  ")
*      SQL.ADD(" AND '"~IdxDate(Val(t:2))~"' between A.FechaExCupon and DateAdd(dd,-1,A.FechaCorte)  ")
*      Recorrer SQL
*        dfa
*        acn(t:23,1)
*        acn(t:22,0)
*        Break
*      Proximo
      acn(x2,1)
    endif
  endif
endif

if Val(x2)=1
  * Plazo
  ACN(t:15, Num(Copy(Val(A:FAC),55,3)))
  * PlazoLiq
  ACT(t:27, FStr(Val(t:15)*24,1,0))
  * Precio de Cierre
  ACN(t:18, Num(Copy(Val(A:FAC),114,18))/100000000)
  * CallPut
  if EqStr(Val(t:5),'1')
    * Tipo Negosciones ""
* FJL 28/09/23 - No existe mas 72 horas
*    if Val(t:15)<=3
    if Val(t:15)<3
      ACT(t:16, 'CON')
      ACN(t:25, 0)
* FJL 28/09/23 - Por Pedido de BIND guardar todos los plazos
*      if Val(t:15)=Val(t:24) o Val(t:23)=1
* FJL 22/11/23 - Toma  criterio dependiendo de Variable MAEPLACOMP
*      if (Val(t:15)=Val(t:24) o SI)
      if (Val(t:15)=Val(t:24) o Val(t:31)=1)
        ACN(x3,1)
      endif
    else
      ACT(t:16, 'FUT')
      ACN(t:25, Val(t:15))
      ACD(t:17, Habiles(Val(t:2),Val(t:15),'ARG'))
      ACN(x3,1)
    endif
  else
    * Falta definir Cotizaciones de Pases
    * Se esta filtrando al principio que solo tenga en cuenta '1' Titulos Publicos
  endif
endif

* Buscar Cotizacion de Hoy
if Val(x3)=1
  Message('----- Actualizando Cotizacion MAE :'~Val(t:8))
  SQL.ADD("Select Codigo from "~DBO~".COTIZACIONES ")
  SQL.ADD(" where Fecha  = '"~IdxDate(Val(t:2))~"' ")
  SQL.ADD("   and Codigo = '"~Val(t:8)~"' ")
  SQL.ADD("   and Moneda = '"~Val(t:10)~"' ")
  SQL.ADD("   and IsNull(CallPut,'CON') = '"~Val(t:16)~"' ")
* FJL 28/12/20 - Nuevos campos NIIF
  SQL.ADD("   and PlazoLiq = '"~Val(t:27)~"' ")
  SQL.ADD("   and Mercado  = '"~Val(t:28)~"' ")
  SQL.ADD("   and Fuente   = '"~Val(t:29)~"' ")
  recorrer SQL
    DFA
    SCN(t:19, 1)
  proximo
  if Val(t:19)=1
    ACT(u:FAC, 'Update Cot')
    ACN(x6, 1)
    * Actualizar Precio MAE
    SQL.ADD("Select Codigo from "~DBO~".PIZARRACOTIZACIONES ")
    SQL.ADD(" where Fecha  = '"~IdxDate(Val(t:2))~"' ")
    SQL.ADD("   and Codigo = '"~Val(t:8)~"' ")
    SQL.ADD("   and Moneda = '"~Val(t:10)~"' ")
    SQL.ADD("   and IsNull(CallPut,'CON') = '"~Val(t:16)~"' ")
    recorrer SQL
       DFA
       SCN(t:26, 1)
    proximo
    if Val(t:26)=1
        SQL.ADD("Update "~DBO~".PIZARRACOTIZACIONES ")
        if Val(t:22)=1
          SQL.ADD("   set PrecioMAE          = "~FStr(Val(t:18),0,8)~", ")
          SQL.ADD("       Precio1            = "~FStr(Val(t:18),0,8)~", ")
        else
          SQL.ADD("   set Precio8            = "~FStr(Val(t:18),0,8)~", ")
        endif
        SQL.ADD("       FechaActualizacion = '"~IdxDate(Val(t:1))~"' ")
        SQL.ADD(" where Fecha  = '"~IdxDate(Val(t:2))~"' ")
        SQL.ADD("   and Codigo = '"~Val(t:8)~"' ")
        SQL.ADD("   and Moneda = '"~Val(t:10)~"' ")
        SQL.ADD("   and IsNull(CallPut,'CON') = '"~Val(t:16)~"' ")
        SQL.NEW
    else
        SQL.ADD("Insert into "~DBO~".PIZARRACOTIZACIONES ( ")
        SQL.ADD(" Fecha, Codigo, Moneda, CallPut, ")
        if Val(t:22)=1
          SQL.ADD(" PrecioMAE, Precio1, ")
        else
          SQL.ADD(" Precio8, ")
        endif
        SQL.ADD(" FechaActualizacion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~IdxDate(Val(t:2))~"', ")
        SQL.ADD(" '"~Val(t:8)~"', ")
        SQL.ADD(" '"~Val(t:10)~"', ")
        SQL.ADD(" '"~Val(t:16)~"', ")
        SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
        if Val(t:22)=1
          SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
        endif
        SQL.ADD(" '"~IdxDate(Val(t:1))~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
    endif
** FJL 01/03/21 - por BIND - Se actualiza aunque sea de otro Moneda
    if Eqstr(val(t:10),val(t:11)) o SI
        SQL.ADD("Update "~DBO~".COTIZACIONES ")
        if Val(t:22)=1
          SQL.ADD("   set PrecioMAE          = "~FStr(Val(t:18),0,8)~", ")
          SQL.ADD("       Precio1            = "~FStr(Val(t:18),0,8)~", ")
** FJL 01/03/21 - por BIND
          SQL.ADD("       PrecioContable            = "~FStr(Val(t:18),0,8)~", ")
        else
          SQL.ADD("   set Precio8            = "~FStr(Val(t:18),0,8)~", ")
        endif
*        SQL.ADD("       FechaActualizacion = '"~IdxDate(Val(t:1))~"' ")
        SQL.ADD("       FechaActualizacion = getdate() ")
        SQL.ADD(" where Fecha  = '"~IdxDate(Val(t:2))~"' ")
        SQL.ADD("   and Codigo = '"~Val(t:8)~"' ")
        SQL.ADD("   and Moneda = '"~Val(t:10)~"' ")
        SQL.ADD("   and IsNull(CallPut,'CON') = '"~Val(t:16)~"' ")
* FJL 28/12/20 - Nuevos campos NIIF
        SQL.ADD("   and PlazoLiq = '"~Val(t:27)~"' ")
        SQL.ADD("   and Mercado  = '"~Val(t:28)~"' ")
        SQL.ADD("   and Fuente   = '"~Val(t:29)~"' ")
        SQL.NEW
    endif    
    SQL.EXEC
  else
    if Val(t:19)=0
      ACT(u:FAC, 'Insert Cotizaciones')
      ACN(x6, 1)
      * Insertar registro
      SQL.ADD("Select Codigo from "~DBO~".PIZARRACOTIZACIONES ")
      SQL.ADD(" where Fecha  = '"~IdxDate(Val(t:2))~"' ")
      SQL.ADD("   and Codigo = '"~Val(t:8)~"' ")
      SQL.ADD("   and Moneda = '"~Val(t:10)~"' ")
      SQL.ADD("   and IsNull(CallPut,'CON') = '"~Val(t:16)~"' ")
      recorrer SQL
        DFA
        SCN(t:26, 1)
      proximo
      if Val(t:26)=1
        SQL.ADD("Update "~DBO~".PIZARRACOTIZACIONES ")
        if Val(t:22)=1
          SQL.ADD("   set PrecioMAE          = "~FStr(Val(t:18),0,8)~", ")
          SQL.ADD("       Precio1            = "~FStr(Val(t:18),0,8)~", ")
        else
          SQL.ADD("   set Precio8            = "~FStr(Val(t:18),0,8)~", ")
        endif
        SQL.ADD("       FechaActualizacion = '"~IdxDate(Val(t:1))~"' ")
        SQL.ADD(" where Fecha  = '"~IdxDate(Val(t:2))~"' ")
        SQL.ADD("   and Codigo = '"~Val(t:8)~"' ")
        SQL.ADD("   and Moneda = '"~Val(t:10)~"' ")
        SQL.ADD("   and IsNull(CallPut,'CON') = '"~Val(t:16)~"' ")
        SQL.NEW
      else
        SQL.ADD("Insert into "~DBO~".PIZARRACOTIZACIONES ( ")
        SQL.ADD(" Fecha, Codigo, Moneda, CallPut, ")
        if Val(t:22)=1
          SQL.ADD(" PrecioMAE, Precio1, ")
        else
          SQL.ADD(" Precio8, ")
        endif
        SQL.ADD(" FechaActualizacion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~IdxDate(Val(t:2))~"', ")
        SQL.ADD(" '"~Val(t:8)~"', ")
        SQL.ADD(" '"~Val(t:10)~"', ")
        SQL.ADD(" '"~Val(t:16)~"', ")
        SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
        if Val(t:22)=1
          SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
        endif
        SQL.ADD(" '"~IdxDate(Val(t:1))~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
      endif  
** FJL 01/03/21 - por BIND - Se inserta aunque sea de otro Moneda
      if EqStr(Val(t:10),Val(t:11)) o SI
        SQL.ADD("Insert into "~DBO~".COTIZACIONES ( ")
        SQL.ADD(" Fecha, Codigo, Moneda, CallPut, ")
        if Val(t:22)=1
          SQL.ADD(" PrecioMAE, Precio1, ")
** FJL 01/03/21 - por BIND
          SQL.ADD(" PrecioContable, ")
        else
          SQL.ADD(" Precio8, ")
        endif
* FJL 28/12/20 - Nuevos campos NIIF
        SQL.ADD(" PlazoLiq, ")
        SQL.ADD(" Mercado, ")
        SQL.ADD(" Fuente, ")
        ********
        SQL.ADD(" FechaActualizacion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~IdxDate(Val(t:2))~"', ")
        SQL.ADD(" '"~Val(t:8)~"', ")
        SQL.ADD(" '"~Val(t:10)~"', ")
        SQL.ADD(" '"~Val(t:16)~"', ")
        SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
        if Val(t:22)=1
          SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
** FJL 01/03/21 - por BIND
          SQL.ADD(" "~FStr(Val(t:18),0,8)~", ")
        endif
* FJL 28/12/20 - Nuevos campos NIIF
        * PlazoLiq
        SQL.ADD(" '"~Val(t:27)~"', ")
        * Mercado
        SQL.ADD(" '"~Val(t:28)~"', ")
        * Fuente
        SQL.ADD(" '"~Val(t:29)~"', ")
        ********
*        SQL.ADD(" '"~IdxDate(Val(t:1))~"' ")
        SQL.ADD(" getdate() ")
        SQL.ADD(" ) ")
        SQL.NEW
      endif    
      SQL.EXEC
    else
      ACT(u:FAC, 'Mas de una cotizacion para '~Val(t:8))
    endif
  endif
endif
ACO(19,15)
ACO(20,15)
