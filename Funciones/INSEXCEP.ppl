*- zz1:Tipo; 
*- zz2:Monto que vino del archivo; 
*- zz3:Monto que obtuve;

******************************************************************************
*-Armo el Numero de Minuta
SQL.ADD("Select CONVERT(int, Numerador) as Nume From "~DBO~".MINUTASBOLSA where TipoMinuta='"~Val(is5)~"' Group by Numerador") 
Recorrer SQL
   ACT(mc1, fbn['Nume'])
Proximo
              
SQL.ADD("Select Tipo, Numero From "~DBO~".NUMERADORES where Codigo='"~Val(mc1)~"'")
Recorrer SQL
   ACT(mc2, fbn['Tipo'])
   ACN(mc3, fbn['Numero'])
Proximo

ACT(is1,Val(mc2)~Pad0(Fstr(Val(mc3)+1,0,0),6))
******************************************************************************

SQL.ADD("INSERT INTO "~DBO~".EXCEPCIONES")
SQL.ADD("(NrOperacion,Tipo,Fecha,Descripcion) ")
SQL.ADD(" Values ")
SQL.ADD("('"~Val(is1)~"','"~Val(zz1)~"',")
SQL.ADD("'"~IdxDate(FSYS)~"','Los datos recibidos y obtenidos son distintos-->")
SQL.ADD(" Recibido= "~Val(zz2)~"; Obtenido= "~Val(zz3)~" ')")
SQL.NEW      
SQL.EXEC
