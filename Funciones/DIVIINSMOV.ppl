         *- mp1: Nro. Transaccion mp2: Fecha Movimiento mp3: Cliente 
         *- mp4: Especie mp5: CallPut mp6: FechaEj mp7: PrecioEj mp8: Mercado
         *- mp9: EnteCustodia mp10: Cantidad mp11: Formula mp12: Leyenda mp13: Bits mp14: NrSaldo  mp15: NrGrupo
         *- mp16: Concepto (NrSaldo Original)
         *- mp19: Cuenta mp22: Nro. de Movimiento mp20: NrGrupo2
         *- mp50: Leyenda PEND para dividendos provenientes de mov pendientes
         *- mp23: NrLiq para grabar en el mov. efectivo el monto de la fraccion
         *- mp24: Fraccion a Liquidar en efectivo
 
         *- Seteo el tipo de movimiento Automatico-Manual
         *- jo1=1 -> Algunos Bits AV y Otros MV ch1=2 Todos MV 
         ACT(mp13,'MV' )

         If val(jo1)=6 y [Not Incluido(Fstr(val(c:val(fi1)),0,0),VAL(dz6)) y Not Incluido(Fstr(val(c:val(fi1)),0,0),VAL(dz15))] 
            ACT(mp13,'AV')
            ACD(mp17,Dialogo.Fecha2)
         EndIf
         
         *- mp20: En Nro. de grupo2 grabo la tenencia 
         ACN(mp20,Val(i:val(fi1)) )

         ACT(mp16,Fstr(Val(c:val(fi1)),0,0))
         *--------------------------------------------------------------
         *- Movimiento por la Especie Si existe Divendo en Acciones o Revaluo          
         *- Si es Canje es Negativo el movimiento de acciones
         If Val(s:val(fi1))<>0
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            ACT(mp4,IIF(Dialogo.Precio10<>0,Val(a:val(fi1)),Val(b:val(fi1))) )
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )

            IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
               ACT(mp6,Val(p:val(fi1)) )
               ACN(mp7,Val(q:val(fi1)))
            EndIf

            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )

            If Dialogo.Precio10=0
               ACN(mp10,Val(s:val(fi1)) )
            Else
               ACN(mp10,Val(i:val(fi1))*-1 )
            EndIf

            ACT(mp11,Fstr(val(ci:2),0,2) )          
            IF Dialogo.Check4 = 0
                ACT(mp12,'Dividendos Acciones '~val(mp4)~' '~Val(mp50))          
                ACT(MP:27, Val(CO:Val(FI:1)))
            ELSE
                ACT(MP:12,'Canje de Acciones '~Val(MP:4)~' '~Val(MP:50))          
                ACT(MP:27, Val(CO:Val(FI:1)))
            ENDIF

            ACN(mp14,Val(c:val(fi1)) )
  
            *- mp15: Nro. Grupo 1 es el de las Acciones 
            ACN(mp15,1)
            ACT(mp19,Val(j:val(fi1)) )
            ACN(mp22,val(fi1) )
            ACN(MP:26, 0)
            ACN(MP:23, 0)
            ACT(MP:24, '')
            (."IMMOVPEND".)
         EndIf
         *--------------------------------------------------------------
         *- Movimiento por Canje para Subir la Especie Nueva
         If Val(s:val(fi1))<>0 y Dialogo.Precio10<>0
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            ACT(mp4,Dialogo.Especie3 )
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )

            IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
               ACT(mp6,Val(p:val(fi1)) )
               ACN(mp7,Val(q:val(fi1)))
            EndIf

            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )
            ACN(mp10,Val(s:val(fi1)))
            ACT(mp11,Fstr(val(ci:2),0,2) )          
            ACT(mp12,'Canje de Acciones '~val(mp4)~' '~Val(mp50))          

            ACN(mp14,Val(c:val(fi1)) )
  
            *- mp15: Nro. Grupo 1 es el de las Acciones 
            ACN(mp15,1)
            ACT(mp19,Val(j:val(fi1)) )
            ACN(mp22,val(fi1)+100000  )
            ACT(MP:27, Val(CN:Val(FI:1)))
            ACN(MP:26, 0)
            ACN(MP:23, 0)
            ACT(MP:24, '')
            (."IMMOVPEND".)
         EndIf
         *--------------------------------------------------------------
         *- Movimiento por la Especie Si existe Dividendo en Efectivo          
         If Val(l:val(fi1))<>0
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            ACT(mp4,Dialogo.Especie2)
            ACT(zz1, Val(a:val(fi1)) )
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )

            IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
               ACT(mp6,Val(p:val(fi1)) )
               ACN(mp7,Val(q:val(fi1)))
            EndIf

            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )
            ACN(mp10,Val(l:val(fi1)) )
            ACT(mp11,Fstr(val(ci:2),0,2) )
            ACT(mp12,'Dividendos Efectivo de '~val(zz1)~' en '~val(mp4)~' '~Val(mp50))          
  
            ACN(mp14,1 )
  
            *- mp15: Nro. Grupo 2 es el del Efectivo
            ACN(mp15,2)
            ACN(mp20,Val(i:val(fi1)) )
            ACT(mp19,Val(h:val(fi1)) )
            ACN(mp22,val(fi1)+100000 )
            ACN(MP:26, 0)
            ACN(MP:23, Val(bg:val(fi1)))
            ACT(MP:24, Fstr(Val(be:val(fi1)),0,4))
            (."IMMOVPEND".) 
         EndIf
         *--------------------------------------------------------------
         *- Movimiento por Comision
         If Val(sa3)<>0
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            IF Dialogo.Check1 = 1
               ACT(mp4, Dialogo.Especie2)
            ELSE
               ACT(mp4,Val(dz1))
            ENDIF
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )
            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )
            ACN(mp10,Val(sa3)  )
            ACT(mp11,Fstr(val(ci:2),0,2) )
            ACT(mp12,'Comision Dividendos '~val(mp4)~' '~Val(mp50))          
  
            ACN(mp14,4 )
  
            *- mp20: En Nro. de grupo2 grabo la tenencia 
            *- mp15: Nro. Grupo 2 es el del Efectivo
            ACN(mp15,41)
            ACT(mp19,val(ch:1) )
            ACN(mp22,val(fi1)+200000 )
            IF Val(SA:6) <> 0
                ***---Comision Bonificada
                ACN(MP:26, Val(SA:6))
            ELSE
                ACN(MP:26, 0)
            ENDIF
            ACN(MP:23, 0)
            ACT(MP:24, '')
            (."IMMOVPEND".) 

            *-----------------------------------------
            *- Movimiento por El Iva 
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            IF Dialogo.Check1 = 1
               ACT(mp4, Dialogo.Especie2)
            ELSE
               ACT(mp4,Val(dz1))
            ENDIF
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )
            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )
            ACN(mp10,Val(ci:1) )
            ACT(mp11,Fstr(val(ci:2),0,2) )
            ACT(mp12,'IVA Comision Dividendos '~val(mp4)~' '~Val(mp50))          
  
            ACN(mp14,4 )
  
            *- mp15: Nro. Grupo 2 es el del Efectivo
            ACN(mp15,42)
            ACT(mp19,val(ch:1) )
            ACN(mp22,val(fi1)+300000 )
            IF Val(SA:7) <> 0
                ***---IVA Comision Bonificada
                ACN(MP:26, Val(SA:7))
            ELSE
                ACN(MP:26, 0)
            ENDIF
            ACN(MP:23, 0)
            ACT(MP:24, '')
            (."IMMOVPEND".) 

         EndIf
         *--------------------------------------------------------------
         *--------------------------------------------------------------
         *- Movimiento Comision de Caja Valores
         If Val(sa8)<>0
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            IF Dialogo.Check1 = 1
               ACT(mp4, Dialogo.Especie2)
            ELSE
               ACT(mp4,Val(dz1))
            ENDIF
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )
            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )
            ACN(mp10,Val(sa8)  )
            ACT(mp11,Fstr(val(ci:12),0,2) )
            ACT(mp12,'Comision CV Dividendos '~val(mp4)~' '~Val(mp50))          
  
            ACN(mp14,4 )
  
            *- mp20: En Nro. de grupo2 grabo la tenencia 
            *- mp15: Nro. Grupo 2 es el del Efectivo
            ACN(mp15,51)
            ACT(mp19,val(ch:1) )
            ACN(mp22,val(fi1)+400000 )
            ACN(MP:26, Val(SA:8))
            ACN(MP:23, 0)
            ACT(MP:24, '')
            (."IMMOVPEND".) 

            *-----------------------------------------
            *- Movimiento por El Iva 
            ACT(mp1,val(y1))
            ACD(mp2,Dialogo.Fecha2)
            ACT(mp3,val(g:val(fi1)) )
            IF Dialogo.Check1 = 1
               ACT(mp4, Dialogo.Especie2)
            ELSE
               ACT(mp4,Val(dz1))
            ENDIF
            ACT(mp5,Val(y:3) )
            ACT(mp6,'' )
            ACN(mp7,0 )
            ACT(mp8 ,Val(e:val(fi1)) )
            ACT(mp9 ,Val(d:val(fi1)) )
            ACN(mp10,Val(ci:11) )
            ACT(mp11,Fstr(val(ci:12),0,2) )
            ACT(mp12,'IVA CV Comision Dividendos '~val(mp4)~' '~Val(mp50))          
  
            ACN(mp14,4 )
  
            *- mp15: Nro. Grupo 2 es el del Efectivo
            ACN(mp15,52)
            ACT(mp19,val(ch:1) )
            ACN(mp22,val(fi1)+500000 )
            ACN(MP:26, Val(ci:11))
            ACN(MP:23, 0)
            ACT(MP:24, '')
            (."IMMOVPEND".) 
         EndIf
         *--------------------------------------------------------------
