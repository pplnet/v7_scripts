      SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET ")
      SQL.ADD(" Cuenta2 = '"~Val(cu:2)~"', ")
      SQL.ADD(" Cuenta4 = '"~Val(cu:1)~"' ")
      SQL.ADD(" WHERE  NrOperacion IN ("~Pipe2Comillas(Val(lo:1))~") ")
      SQL.NEW

      *( No hago actualizarMovimientos porque pierdo la marca del campo "transaccion" )
      SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET ")
      SQL.ADD(" Cuenta = '"~Val(cu:1)~"' ")
      SQL.ADD(" WHERE Cliente = '"~Val(ca:1)~"' ")
      SQL.ADD(" AND   NrOperacion IN ("~Pipe2Comillas(Val(lo:1))~") ")
      SQL.ADD(" AND   Especie = '"~Val(ea:1)~"' ")
      SQL.ADD(" "~Val(lm:1)~" ")
      SQL.NEW
      SQL.EXEC
