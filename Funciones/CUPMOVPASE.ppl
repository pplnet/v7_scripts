*- Segun Corte Saldos o Movimientos las Fechas varian -> 
*- fv1: Fecha Valida para Movimiento del Corte fv2: Fecha Valida para Movimiento del Pago 

*- mp1: Nro. Transaccion mp2: Fecha Movimiento mp3: Cliente 
*- mp4: Especie mp5: CallPut mp6: FechaEj mp7: PrecioEj mp8: Mercado
*- mp9: EnteCustodia mp10: Cantidad mp11: Formula mp12: Leyenda mp13: Bits mp14: NrSaldo  mp15: NrGrupo
*- mp16: Concepto (NrSaldo Original)
*- mp19: Cuenta mp22: Nro. de Movimiento mp20: NrGrupo2
*- mp27: Cupon  mp23: Com.Renta mp25: Com.Amortizacion
*- mp50: Leyenda para ver si viene de movimientos pendientes
 
*- Movimiento por El Aumento del Cupon Cupon 
ACT(mp13,'AV' )

ACD(mp2, Dialogo.Fecha1)

ACT(mp1,val(y1))
ACT(mp3, Val(UE:&k))
ACT(mp4,Val(b4))

If Eqstr(Val(ps:&k), '1')
   ACT(mp5,'PAS')
Else
   ACT(mp5,'PEN')
Endif

*FO 11/08 ACT(mp8 , Val(UI:&k))
*FO 11/08 ACT(mp19, Val(UF:&k))

IF Not Incluido(Val(mc:&k), Val(MX:1))
   ACT(mp8 , Val(mc:&k))
   ACT(mp19, Val(mt:&k))
Else
   * Si la operacion es AC, los cupones van a CV
   ACT(mp8 , VAR('CLHODEFA'))
   ACT(mp19, SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~Val(mp3)~"' AND Mercado='"~Val(mp8)~"' AND Estado='HAB' AND TipoCuenta='CUS' "))
Endif

ACT(mp9 , Dialogo.Vehiculo1)
ACN(mp10, Val(UG:&k))
ACD(mp17,Dialogo.Fecha1)
ACN(mp20, Val(UG:&k))

*- % IVA
ACT(mp11,Fstr(val(ci:2),0,2) )         
 
ACT(mp12,'Corte de Cupon de '~val(mp4)~' Cup. '~Fstr(Dialogo.Entero1, 0, 0)~' por '~Val(UB:&k))

ACN(mp14, 101)
ACT(mp16, '101')

*- mp15: Nro. Grupo 1 es el de las Acciones 
ACN(mp15,1)
ACT(mp29, Val(UF:&k))
ACT(mp28, Val(UA:&k))
ACN(mp22, &k+300000 )
ACT(mp27, Fstr(Dialogo.Entero1, 0, 0))
(."IMMOVPEND".)
SQL.EXEC



IF Val(JO:1) = 6 y EqStr(val(ul:&k),'HAB')
   ACT(mp13,'AV' )
   ACD(mp2, Dialogo.Fecha1)

    *- mp20: En Nro. de grupo2 grabo la tenencia 
    ACN(mp20, Val(UG:&k))

    ACT(mp16, '101')

    *- Movimiento bajando el saldo de cupones
    ACT(mp1,val(y2))
    ACT(mp3,val(UE:&k))
    ACT(mp4, Val(B:4))
    If Eqstr(Val(ps:&k), '1')
       ACT(mp5,'PAS')
    Else
       ACT(mp5,'PEN')
    Endif

    ACT(mp6,'' )
    ACN(mp7,0 )

    ACT(mp8 ,Val(UI:&k))
    ACT(mp9 , Dialogo.Vehiculo1)

    ACN(mp10,  - Val(UG:&k))

    *- % IVA 
    ACT(mp11,Fstr(val(ci:2),0,2))

    ACT(mp12,'Liq. Cupon de '~val(mp4)~' Cup. '~Val(aa2)~'por '~Val(UB:&k))

    ACN(mp14, 101)

    ACN(mp15,1)
    ACT(mp19,Val(UF:&k))
    ACT(mp29,Val(UF:&k))
    ACN(mp22, &k)
    ACT(mp27, Fstr(Dialogo.Entero1, 0, 0))

    (."IMMOVPEND".)

    Message('*- Genero el Movimiento del efectivo asociado a la transaccion LCUPON ')
    ACT(mp1,val(y2))
    ACT(mp3,Val(UE:&k) )
    ACT(mp4,Val(le:val(fi1)) )
    If Eqstr(Val(ps:&k), '1')
       ACT(mp5,'PAS')
    Else
       ACT(mp5,'PEN')
    Endif

    ACT(mp6,'' )
    ACN(mp7,0 )

    ACT(mp8 , '')
    ACT(mp9 ,Dialogo.Vehiculo1)

    ACN(mp10,  Val(ld:val(fi1)) )

    *- % IVA 
    ACT(mp11,Fstr(val(ci:2),0,2) )          
    ACT(mp12,'Liq. Cupon de '~val(mp4)~' Oper:'~Val(mp50) )          
 
   ACN(mp14, 5)
   
    *- mp15: Nro. Grupo 1 es el de las Acciones 
    ACN(mp15,1)
    ACT(mp19,Val(lb:val(fi1)))
    ACT(mp29,Val(f:val(fi1))  )
    ACN(mp22,val(fi1) + 100000  )
    ACT(mp27,'')
    ACN(MP:26, 0)
   (."IMMOVPEND".)
ENDIF

SQL.EXEC
ACT(MP:30, '')