*         Setear Funcion
*         Objeto a Buscar                  ACT(xx1,'INFORMES') 
*         Codigo del Objeto a Buscar       ACT(xx2,Val(t1))
*         Colunma Inicial para el detalle  ACN(xx3,4)

          ACT(aa11, BuscarLinkearHojas(Val(xx1), Val(xx2)))
          if NoVacio(Val(aa11))
             act(val(xx3):val(xy1)+1,'Incluye Informe')
             AlinearCeldas(val(xx3):val(xy1)+1,'D')
             SetFont(val(xx3):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa11)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa11), &j))))
                ACT(val(xx3)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz1,'INFORMES')
                ACT(xz2,Val(t10))
                ACN(xz3,Val(xx3)+1)
                (.'PDPFUNC2'.)
             proximo
          Endif

          ACT(aa21, BuscarEjecutarEventos(Val(xx1), Val(xx2)))
          if NoVacio(Val(aa21))
             act(Val(xx3):val(xy1)+1,'Incluye Evento')
             AlinearCeldas(val(xx3):val(xy1)+1,'D')
             SetFont(Val(xx3):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa21)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa21), &j))))
                ACT(Val(xx3)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz1,'EVENTOS')
                ACT(xz2,Val(t10))
                ACN(xz3,Val(xx3)+1)
                (.'PDPFUNC2'.)
             proximo
          Endif

          ACT(aa31, BuscarFunciones(Val(xx1), Val(xx2)))
          if NoVacio(Val(aa31))
             act(val(xx3):val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(val(xx3):val(xy1)+1,'D')
             SetFont(val(xx3):val(xy1)+1, 5)
             ACN(xy99,Elementos(Val(aa31)))
             SCN(xz40,Val(xy99))
             ACN(xy50,0)
             
             Recorrer&j 1,Val(xy99)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa31), &j))))
                ACT(val(xx3)+1:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz1,'FUNCIONES')
                ACT(xz2,Val(t10))
                ACN(xz3,Val(xx3)+1)
                (.'PDPFUNC2'.)
             proximo
          Endif
           
