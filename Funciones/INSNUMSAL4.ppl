 ACT(z2,GetNumerador(1))
 
SQL.ADD("DECLARE @Cant integer ")
SQL.ADD("SELECT @Cant = 1 ")
SQL.ADD("WHILE (@Cant <= 1) ")
SQL.ADD("   BEGIN ")
SQL.ADD("      IF (@Cant = 1) ")
SQL.ADD("         BEGIN ")
SQL.ADD("            DELETE "~DBO~".TRANSACCIONES2 Where TipoTr2='NUMSAL' ")
SQL.ADD("            and Cuenta1='"~FBN['Cuenta']~"' and Especie='"~FBN['Especie']~"' ")
SQL.ADD("            and Mercado1='"~FBN['Mercado']~"' and Cambio4="~Fstr(FBN['NrSaldo'],0,0)~" ")
If Not Dialogo.Check3=1 
   SQL.ADD("            and (Fecha1='"~IdxDate(Dialogo.Fecha2)~"' or (Fecha1<'"~IdxDate(val(fv2))~"' and CB1='0')) ")
Else
   SQL.ADD("            and Fecha1<='"~IdxDate(Dialogo.Fecha2)~"' ")
EndIf
SQL.ADD("            and Cliente1='"~val(z7)~"' ")
SQL.ADD(" ")
SQL.ADD("            INSERT INTO "~DBO~".TRANSACCIONES2 ")
SQL.ADD("            (Vehiculo1,Fecha1,Cliente1,")
SQL.ADD("            Cuenta1,Especie,")
SQL.ADD("            NrTrans,TipoTr2,")
SQL.ADD("            Cantidad1, Mercado1,Cambio4,CB1,")
SQL.ADD("            Cantidad2, Cantidad3,Precio1,Cantidad4,Precio2) Values ")
SQL.ADD("            ('"~val(z6)~"','"~IdxDate(Dialogo.Fecha2)~"','"~val(z7)~"',")
SQL.ADD("            '"~FBN['Cuenta']~"','"~FBN['Especie']~"',")
SQL.ADD("            '"~val(z2)~"','NUMSAL',")
SQL.ADD("            "~Fstr(Abs(val(pp2)),0,2)~",'"~FBN['Mercado']~"',"~Fstr(FBN['NrSaldo'],0,0)~",'"~val(ft1)~"',")
SQL.ADD("            "~Fstr(Abs(val(g:fac)),0,2)~","~Fstr(Abs(val(j:fac)),0,2)~","~Fstr(val(i:fac),0,8)~","~Fstr(Abs(val(k:fac)),0,2)~","~Fstr(Abs(val(l:fac)),0,2)~") ")   
SQL.ADD(" ")
SQL.ADD("            INSERT INTO "~DBO~".OPERACIONESBITS ")
SQL.ADD("            (NrOperacion,NrBit,Valor) ")
SQL.ADD("            Values ")
SQL.ADD("            ('"~val(z2)~"',"~Fstr(70,2,0)~",'1') ")
SQL.ADD("         END ")
SQL.ADD("      SELECT @Cant = @Cant + 1 ")
SQL.ADD("   END ")
SQL.NEW
SQL.EXEC
