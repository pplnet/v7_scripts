**Cintia 22-2-23 Administracion de partidas - Issue 6089
**NrOperacion vacío para cuando es Valuación a Mercado, sino es Valuación a Partida
SQL.ADD(" Select R.Especie, R.Vehiculo Vehiculo1, R.Book, R.Cupon, R.NrSaldo, R.Day, E.MonedaEmision, E.Tipo TipoEspecie, R.Vehiculo Cliente, ")
SQL.ADD(" R.Estrategia as CuentaCustodia, R.TipoPosicion as Concepto, E.Issuer,'' NrOperacion")
SQL.ADD(" From "~DBO~".RESULTADOS R, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = R.Especie ")
SQL.ADD(" AND R.NrSaldo   =  "~Fstr(Val(SL:2), 0, 0)~" ")
SQL.ADD(" AND R.Fecha = '"~IdxDate(Val(FE:99))~"' ")
SQL.ADD(" AND R.TipoResultado IN ('REACON') ")
SQL.ADD(" AND Round(R.Day, 0, 2) <> 0 ")

SQL.ADD(" AND R.Book Not IN ("~Pipe2Comillas(&BValuaPartida)~") ")

SQL.ADD(" UNION ")

SQL.ADD(" Select E.Codigo Especie,O.Vehiculo1 Vehiculo1, O.Book1 Book, O.Cupon1 Cupon, '"~Var('SALDOPOCON')~"' NrSaldo, P.Cantidad1 Day, ")
SQL.ADD(" E.MonedaEmision, E.Tipo TipoEspecie, O.Vehiculo1 Cliente, '' CuentaCustodia, '' Concepto,E.Issuer, P.NrOperacion")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".PARTIDAS P")
SQL.ADD(" Where E.Codigo = O.Especie AND O.NrOperacion=P.NrPartida ")
SQL.ADD(" AND Round(P.Cantidad1, 0, 2) <> 0 ")
SQL.ADD(" AND P.TipoAct='TIV' ")
SQL.ADD(" AND P.FechaHasta= '"~IdxDate(Val(FE:99))~"'")
SQL.ADD(" AND O.TipoOp='PARTID' ")

SQL.ADD(" Order By 2, 1 ")
