    IF Not Eqstr(fbn('Cotiza'), Val(CZ:1))
        IF Not CeldaVacia(CZ:1)
            SetFont(A:Val(FI:1)..F:fac, 1)            
            ACT(A:fac, 'Total')
            ACN(D:fac, Sum(D:Val(FI:1)..D:fac-1))
            ACN(B:fac, Sum(B:Val(FI:1)..B:fac-1))
            ACN(F:fac, Sum(F:Val(FI:1)..F:fac-1))                  
            
            ***---Total Cartera
            SCN(TD:1, Val(D:fac))
            SCN(TB:1, Val(B:fac))
            SCN(TF:1, Val(F:fac))
           
            SetFont(A:fac..F:FAC, 2)
            FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
            FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
            FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
            FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
            FormatoCeldas(F:Val(FI:1)..F:fac, Exe('F2'))
            AgregarMarco(A:fac..F:fac, 0, 0, Exe('COLOR6'))
            ACN(BD:2, 1)
            ifa
            ifa
        ENDIF
        ACT(A:fac, Val(TT:1)~' en '~fbn('Cotiza'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..F:fac, 0, 0)
        ifa
        ACN(FI:1, fac)
    ENDIF

** Formateo campos para exposcion concertada     
    ACT(CZ:1, fbn('Cotiza'))
    *  Especie y Moneda de la Especie
    ACT(A:fac, fbn('Especie')~' - '~BuscarCampo('ESPECIES','Nombre','Codigo', fbn('Especie')))
    *  Posicion =  CantidadFin 
    ACN(B:fac, fbn('CantidadFin'))
    *  Precio  =  PrecioFin
    ACN(C:fac, fbn('PrecioFin'))
    * Posicion Valorizada = Posicion * Precio
    ACN(D:fac, fbn('CantidadFin') * fbn('PrecioFin'))
    * Precio Mercado = Cotizacion de la Especie
    ACN(E:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,Val(MI:1)))
    * Posicion Valorizada de Mercado = Posicion * Precio Mercado
    ACN(F:fac, fbn('CantidadFin') * Val(E:fac))

