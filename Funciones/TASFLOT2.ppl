*****************************************************************************************
***---Swaps Unico Vto.
***---Datos Vehiculo
SQL.ADD(" Select O.Vehiculo1, O.Especie, O.TotalIntereses Importe, O.NrOperacion, O.TipoOp, ")
SQL.ADD(" O.Cliente1, O.FechaOp2 Inicio, O.FechaEj Fin, 0 NrCuota, O.FechaPrecan Reset, O.Plazo, ")
SQL.ADD(" O.TipoTasa, O.Precio3 Tasa, O.Spread ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where O.OperacionRef = P.NrOperacion ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(LS:2))~") ")
SQL.ADD(" AND O.TipoOp IN ('DTSFV','DTSVV') ")
SQL.ADD(" AND O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaPrecan <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.TotalIntereses > 0 ")
SQL.ADD(" AND (P.TipoOp IN ('MMPE','MMPI','MMPEM','MMPIM','MMON','MMONM','MMFIMV','MMFRNP','MMSIMV','MMPSI','MMPCL','MMPCOS','MMPCLM','MMPOSM') ")
SQL.ADD("      OR (P.TipoOp = 'MMPLME' AND P.Especie <> '"~Var('MONEEXTR')~"')) ")
SQL.ADD(" AND ((O.TipoTasa Is Not Null AND O.TipoTasa<>'FIJA') OR (O.TipoTasa2 Is Not Null AND O.TipoTasa<>'FIJA')) ")
IF Dialogo.Radio1 = 1
    SQL.ADD(" AND (O.Precio3 = 0 OR O.Precio3 Is Null) ")
ENDIF

SQL.ADD(" UNION ")

***---Datos ContraParte
