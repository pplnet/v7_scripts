***/// FC:1 = Fecha Fin de mes anterior
***/// FC:2 = Fecha Fin de mes
***/// FC:9 = Inicio Cuota Vigente
***/// FC:10 = Inicio Cuota Vigente
***/// CP:1 = Capital correspondiente
***--- DI = DC Interes
***--- DK = DC Capital
***/// DN = DC Capital No Cte
***--- DI:1, DK:1 Y DN:1 Moneda Fuerte = ARP
***--- DI:2, DK:2 Y DN:2 Moneda Local
***--- DI:3, DK:3 Y DN:3 Moneda Grupo = USD
***/// IT:1 = Interes en Moneda Fuerte = ARP
***/// IT:2 = Interes en Moneda Local
***/// IT:3 = Interes en Moneda Grupo = USD
***/// IC:1 = Indice CER
***/// IX:1 = Interes Capitalizado para prestamos


****************************************************
** ------ Calculo de Diferencia de Cambio  ------ **
****************************************************

If Val(FC:1) < Val(FC:9)
   ACD(FC:1, Val(FC:9))
Endif

*        Messagebox('Fecha Inicial: '~Fecha(Val(FC:9)))
*        Messagebox('Fecha 1: '~Fecha(Val(FC:1)))
*        Messagebox('Fecha 2: '~Fecha(Val(FC:2)))


**// Si es prestamo o ON divido el capital en Cte y no Cte
IF Incluido(FBN('TipoOp'),'MMPEM|MMPIM|MMPCCM|SEPVMV|')
   **// Capital cte a la fecha
   ACN(CP:1, SQL(" Select Sum(Cantidad1) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 <= '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"' AND Fecha2 >= '"~IdxDate(Val(FV:1))~"' ") )
   **//Capital no cte a la fecha
   ACN(CP:2, SQL(" Select Sum(Cantidad1) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 >  '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"'  ") )
Else
   IF #OBLIGNEG
      **// Capital cte a la fecha
      ACN(CP:1, SQL(" Select Sum(Cantidad4) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 <= '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"' AND Fecha2 >= '"~IdxDate(Val(FV:1))~"' ") )
      **//Capital no cte a la fecha
      ACN(CP:2, SQL(" Select Sum(Cantidad4) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 >  '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"'  ") )
   Else
      **// Si es prestamo con int.cap. tengo que tener en cuenta el capital original + lo capitalizado a la fecha
      IF Incluido(FBN('TipoOp'),'MMPCLM|MMPOSM|')
         **// Interes Capitalizado a la fecha
         ACN(IX:1, SQL(" Select Sum(Cantidad9) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 < '"~IdxDate(Val(FV:1))~"' ") )
         **// Capital cte a la fecha + Int.Cap.
         ACN(CP:1, SQL(" Select Sum(Cantidad3Ori) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 <= '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"' AND Fecha2 >= '"~IdxDate(Val(FV:1))~"' ") + Val(IX:1))
         **//Capital no cte a la fecha
         ACN(CP:2, SQL(" Select Sum(Cantidad3Ori) From "~DBO~".CUOTAS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Fecha2 >  '"~IdxDate(Val(FV:1)+VAR('PLCAPCORR'))~"'  ") )
      Else
         ACN(CP:2, 0)
      Endif
   Endif
Endif

**// Si es prestamo en especie tengo que valorizar el importe obtenido anteriormente
***IF Incluido(fbn('TipoOp'), 'SEPVMV|SECS|SEVS|SECT|SEVT|SECSV|SEVSV|SECTV|SEVTV')
IF Incluido(fbn('TipoOp'), 'SEPVMV|')
   ACN(CP:1, Val(CP:1) * #PRECIOOP)
   ACN(CP:2, Val(CP:2) * #PRECIOOP)
Endif

**// Seteo en AP:1 si la Op. es Activa o Pasiva
If Incluido(FBN('TipoOp'),Var('OPEACT'))
   ACN(AP:1, 1)
Else
   ACN(AP:1, 2)
Endif

*  Messagebox('Capital: '~Fstr(Val(CP:1),0,2))
*  Messagebox('Interes: '~Fstr(Val(TI:1),0,2))

*  MessageBox(Val(FD:1))
*  MessageBox(Val(FH:1))

ACN(TI:1, 0)
SQL.ADD(" Select Sum(Monto) DEV ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN('NrOperacion')~"' ")
SQL.ADD(" and TipoDevengado = '"~FBN('TipoDevengado')~"' ")
SQL.ADD(" and Fecha > "~IdxDate2(Val(FC:9))~" ")
SQL.ADD(" and Fecha <= "~IdxDate2(Val(FD:1))~" ")
Recorrer SQL
   ACN(TI:1, ABS(FBN('DEV')))
Proximo

IF Eqstr(fbn('Moneda'), Val(ME:1))
   ACN(DI:1, (Val(TI:1) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
   ACN(DK:1, (Val(CP:1) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
   ACN(DN:1, (Val(CP:2) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
   IF Eqstr(fbn('Alias4'), Val(ML:1))
      ACN(DI:2, Val(DI:1))
      ACN(DK:2, Val(DK:1))
      ACN(DN:2, Val(DN:1))
   ELSE
      ACN(DI:2, (Val(TI:1) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
      ACN(DK:2, (Val(CP:1) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
      ACN(DN:2, (Val(CP:2) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
   ENDIF
   ACN(DI:3, 0)
   ACN(DK:3, 0)
   ACN(DN:3, 0)
ELSE
   IF Eqstr(fbn('Moneda'), Val(ML:1))
      ACN(DI:1, 0)
      ACN(DK:1, 0)
      ACN(DN:1, 0)
      IF Eqstr(fbn('Alias4'), Val(ML:1))
         ACN(DI:2, Val(DI:1))
         ACN(DK:2, Val(DK:1))
         ACN(DN:2, Val(DN:1))
      ELSE
         ACN(DI:2, (Val(TI:1) * CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) * CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DK:2, (Val(CP:1) * CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) * CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DN:2, (Val(CP:2) * CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) * CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
      ENDIF
      ACN(DI:3, (Val(TI:1) / CotizacionBNA(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) / CotizacionBNA(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
      ACN(DK:3, (Val(CP:1) / CotizacionBNA(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) / CotizacionBNA(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
      ACN(DN:3, (Val(CP:2) / CotizacionBNA(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) / CotizacionBNA(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
   ELSE
      IF Eqstr(fbn('Moneda'), Val(MU:1))
         ACN(DI:1, (Val(TI:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DK:1, (Val(CP:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DN:1, (Val(CP:2) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         IF Eqstr(fbn('Alias4'), Val(ML:1))
            ACN(DI:2, (Val(TI:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
            ACN(DK:2, (Val(CP:1) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
            ACN(DN:2, (Val(CP:2) / CotizacionBNABCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) / CotizacionBNABCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ELSE
            ACN(DI:2, 0)
            ACN(DK:2, 0)
            ACN(DN:2, 0)
         ENDIF
         ACN(DI:3, (Val(TI:1) / CotizacionBCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) / CotizacionBCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DK:3, (Val(CP:1) / CotizacionBCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) / CotizacionBCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DN:3, (Val(CP:2) / CotizacionBCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) / CotizacionBCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO)))
      ELSE
         **// Para el resto de las monedas. EJ: EUR
         ACN(DI:1, (Val(TI:1) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DK:1, (Val(CP:1) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
         ACN(DN:1, (Val(CP:2) * CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) * CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
         IF Eqstr(fbn('Alias4'), Val(ML:1))
            ACN(DI:2, Val(DI:1))
            ACN(DK:2, Val(DK:1))
            ACN(DN:2, Val(DN:1))
            ACN(CT:1, CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO) / CotizacionBNA(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO))
            ACN(CT:2, CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO) / CotizacionBNA(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO))
         ELSE
            ACN(DI:2, (Val(TI:1) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(TI:1) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
            ACN(DK:2, (Val(CP:1) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:1) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
            ACN(DN:2, (Val(CP:2) * CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO)) - (Val(CP:2) * CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO)))
            ***---ACN(CT:1, CotizacionBCU(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO) / CotizacionBCU(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO))
            ***---ACN(CT:2, CotizacionBCU(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO) / CotizacionBCU(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO))
            ACN(CT:1, CotizacionBNA(fbn('Moneda'),Val(FD:1),Val(AP:1),NO,NO) / CotizacionBNA(Val(ME:1),Val(FD:1),Val(AP:1),NO,NO))
            ACN(CT:2, CotizacionBNA(fbn('Moneda'),Val(FH:1),Val(AP:1),NO,NO) / CotizacionBNA(Val(ME:1),Val(FH:1),Val(AP:1),NO,NO))
         ENDIF
         ACN(DI:3, (Val(TI:1) * Val(CT:2)) - (Val(TI:1) * Val(CT:1)))
         ACN(DK:3, (Val(CP:1) * Val(CT:2)) - (Val(CP:1) * Val(CT:1)))
         ACN(DN:3, (Val(CP:2) * Val(CT:2)) - (Val(CP:2) * Val(CT:1)))
      ENDIF
   ENDIF
ENDIF


**// Si es Op. Vinculada se saca el promedio de las Cotizacion de Compra y Venta
If EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',FBN('TipoOp')),VAR('CLASEOPVIN'))
   IF Eqstr(fbn('Moneda'), Val(ME:1))
      ACN(CT:1, (CotizacionBNA(fbn('Moneda'),Val(FH:1),1,NO,NO) + CotizacionBNA(fbn('Moneda'),Val(FH:1),2,NO,NO))/2)
      ACN(CT:2, (CotizacionBNA(fbn('Moneda'),Val(FD:1),1,NO,NO) + CotizacionBNA(fbn('Moneda'),Val(FD:1),2,NO,NO))/2)
      ACN(DI:1, (Val(TI:1) * Val(CT:1)) - (Val(TI:1) * Val(CT:2)))
      ACN(DK:1, (Val(CP:1) * Val(CT:1)) - (Val(CP:1) * Val(CT:2)))
      ACN(DN:1, (Val(CP:2) * Val(CT:1)) - (Val(CP:2) * Val(CT:2)))
      IF Eqstr(fbn('Alias4'), Val(ML:1))
         ACN(DI:2, Val(DI:1))
         ACN(DK:2, Val(DK:1))
         ACN(DN:2, Val(DN:1))
      ELSE
         ACN(CT:1, (CotizacionBCU(fbn('Moneda'),Val(FH:1),1,NO,NO) + CotizacionBCU(fbn('Moneda'),Val(FH:1),2,NO,NO))/2)
         ACN(CT:2, (CotizacionBCU(fbn('Moneda'),Val(FD:1),1,NO,NO) + CotizacionBCU(fbn('Moneda'),Val(FD:1),2,NO,NO))/2)
         ACN(DI:2, (Val(TI:1) * Val(CT:1)) - (Val(TI:1) * Val(CT:2)))
         ACN(DK:2, (Val(CP:1) * Val(CT:1)) - (Val(CP:1) * Val(CT:2)))
         ACN(DN:2, (Val(CP:2) * Val(CT:1)) - (Val(CP:2) * Val(CT:2)))
      ENDIF
      ACN(DI:3, 0)
      ACN(DK:3, 0)
      ACN(DN:3, 0)
   ELSE
      IF Eqstr(fbn('Moneda'), Val(ML:1))
         ACN(DI:1, 0)
         ACN(DK:1, 0)
         ACN(DN:1, 0)
         IF Eqstr(fbn('Alias4'), Val(ML:1))
            ACN(DI:2, Val(DI:1))
            ACN(DK:2, Val(DK:1))
            ACN(DN:2, Val(DN:1))
         ELSE
            ACN(CT:1, (CotizacionBNABCU(Val(ME:1),Val(FH:1),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FH:1),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBNABCU(Val(ME:1),Val(FD:1),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FD:1),2,NO,NO))/2)
            ACN(DI:2, (Val(TI:1) * Val(CT:1)) - (Val(TI:1) * Val(CT:2)))
            ACN(DK:2, (Val(CP:1) * Val(CT:1)) - (Val(CP:1) * Val(CT:2)))
            ACN(DN:2, (Val(CP:2) * Val(CT:1)) - (Val(CP:2) * Val(CT:2)))
         ENDIF
         ACN(CT:1, (CotizacionBNA(Val(ME:1),Val(FH:1),1,NO,NO) + CotizacionBNA(Val(ME:1),Val(FH:1),2,NO,NO))/2)
         ACN(CT:2, (CotizacionBNA(Val(ME:1),Val(FD:1),1,NO,NO) + CotizacionBNA(Val(ME:1),Val(FD:1),2,NO,NO))/2)
         ACN(DI:3, (Val(TI:1) / Val(CT:1)) - (Val(TI:1) / Val(CT:2)))
         ACN(DK:3, (Val(CP:1) / Val(CT:1)) - (Val(CP:1) / Val(CT:2)))
         ACN(DN:3, (Val(CP:2) / Val(CT:1)) - (Val(CP:2) / Val(CT:2)))
      ELSE
         IF Eqstr(fbn('Moneda'), Val(MU:1))
            ACN(CT:1, (CotizacionBNABCU(Val(ME:1),Val(FH:1),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FH:1),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBNABCU(Val(ME:1),Val(FD:1),1,NO,NO) + CotizacionBNABCU(Val(ME:1),Val(FD:1),2,NO,NO))/2)
            ACN(DI:1, (Val(TI:1) / Val(CT:1)) - (Val(TI:1) / Val(CT:2)))
            ACN(DK:1, (Val(CP:1) / Val(CT:1)) - (Val(CP:1) / Val(CT:2)))
            ACN(DN:1, (Val(CP:2) / Val(CT:1)) - (Val(CP:2) / Val(CT:2)))
            IF Eqstr(fbn('Alias4'), Val(ML:1))
               ACN(DI:2, Val(DI:1))
               ACN(DK:2, Val(DK:1))
               ACN(DN:2, Val(DN:1))
            ELSE
               ACN(DI:2, 0)
               ACN(DK:2, 0)
               ACN(DN:2, 0)
            ENDIF
            ACN(CT:1, (CotizacionBCU(Val(ME:1),Val(FH:1),1,NO,NO) + CotizacionBCU(Val(ME:1),Val(FH:1),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBCU(Val(ME:1),Val(FD:1),1,NO,NO) + CotizacionBCU(Val(ME:1),Val(FD:1),2,NO,NO))/2)
            ACN(DI:3, (Val(TI:1) / Val(CT:1)) - (Val(TI:1) / Val(CT:2)))
            ACN(DK:3, (Val(CP:1) / Val(CT:1)) - (Val(CP:1) / Val(CT:2)))
            ACN(DN:3, (Val(CP:2) / Val(CT:1)) - (Val(CP:2) / Val(CT:2)))
         ELSE
            **// Para el resto de las monedas. EJ: EUR
            ACN(CT:1, (CotizacionBNA(fbn('Moneda'),Val(FH:1),1,NO,NO) + CotizacionBNA(fbn('Moneda'),Val(FH:1),2,NO,NO))/2)
            ACN(CT:2, (CotizacionBNA(fbn('Moneda'),Val(FD:1),1,NO,NO) + CotizacionBNA(fbn('Moneda'),Val(FD:1),2,NO,NO))/2)
            ACN(DI:1, (Val(TI:1) * Val(CT:1)) - (Val(TI:1) * Val(CT:2)))
            ACN(DK:1, (Val(CP:1) * Val(CT:1)) - (Val(CP:1) * Val(CT:2)))
            ACN(DN:1, (Val(CP:2) * Val(CT:1)) - (Val(CP:2) * Val(CT:2)))
            IF Eqstr(fbn('Alias4'), Val(ML:1))
               ACN(DI:2, Val(DI:1))
               ACN(DK:2, Val(DK:1))
               ACN(DN:2, Val(DN:1))
               ACN(CT:1, CotizacionBNA(fbn('Moneda'),Val(FD:1),1,NO,NO) / CotizacionBNA(Val(ME:1),Val(FD:1),1,NO,NO))
               ACN(CT:2, CotizacionBNA(fbn('Moneda'),Val(FH:1),1,NO,NO) / CotizacionBNA(Val(ME:1),Val(FH:1),1,NO,NO))
               ACN(CT:3, CotizacionBNA(fbn('Moneda'),Val(FD:1),2,NO,NO) / CotizacionBNA(Val(ME:1),Val(FD:1),2,NO,NO))
               ACN(CT:4, CotizacionBNA(fbn('Moneda'),Val(FH:1),2,NO,NO) / CotizacionBNA(Val(ME:1),Val(FH:1),2,NO,NO))
            ELSE
               ACN(CT:1, (CotizacionBCU(fbn('Moneda'),Val(FH:1),1,NO,NO) + CotizacionBCU(fbn('Moneda'),Val(FH:1),2,NO,NO))/2)
               ACN(CT:2, (CotizacionBCU(fbn('Moneda'),Val(FD:1),1,NO,NO) + CotizacionBCU(fbn('Moneda'),Val(FD:1),2,NO,NO))/2)
               ACN(DI:2, (Val(TI:1) * Val(CT:1)) - (Val(TI:1) * Val(CT:2)))
               ACN(DK:2, (Val(CP:1) * Val(CT:1)) - (Val(CP:1) * Val(CT:2)))
               ACN(DN:2, (Val(CP:2) * Val(CT:1)) - (Val(CP:2) * Val(CT:2)))
               **//ACN(CT:1, CotizacionBCU(fbn('Moneda'),Val(FD:1),1,NO,NO) / CotizacionBCU(Val(ME:1),Val(FD:1),1,NO,NO))
               **//ACN(CT:2, CotizacionBCU(fbn('Moneda'),Val(FH:1),1,NO,NO) / CotizacionBCU(Val(ME:1),Val(FH:1),1,NO,NO))
               **//ACN(CT:3, CotizacionBCU(fbn('Moneda'),Val(FD:1),2,NO,NO) / CotizacionBCU(Val(ME:1),Val(FD:1),2,NO,NO))
               **//ACN(CT:4, CotizacionBCU(fbn('Moneda'),Val(FH:1),2,NO,NO) / CotizacionBCU(Val(ME:1),Val(FH:1),2,NO,NO))
               ACN(CT:1, CotizacionBNA(fbn('Moneda'),Val(FD:1),1,NO,NO) / CotizacionBNA(Val(ME:1),Val(FD:1),1,NO,NO))
               ACN(CT:2, CotizacionBNA(fbn('Moneda'),Val(FH:1),1,NO,NO) / CotizacionBNA(Val(ME:1),Val(FH:1),1,NO,NO))
               ACN(CT:3, CotizacionBNA(fbn('Moneda'),Val(FD:1),2,NO,NO) / CotizacionBNA(Val(ME:1),Val(FD:1),2,NO,NO))
               ACN(CT:4, CotizacionBNA(fbn('Moneda'),Val(FH:1),2,NO,NO) / CotizacionBNA(Val(ME:1),Val(FH:1),2,NO,NO))
            ENDIF
            ACN(DI:3, (Val(TI:1) * (Val(CT:2) + Val(CT:4)) / 2) - (Val(TI:1) * (Val(CT:1) + Val(CT:3)) / 2))
            ACN(DK:3, (Val(CP:1) * (Val(CT:2) + Val(CT:4)) / 2) - (Val(CP:1) * (Val(CT:1) + Val(CT:3)) / 2))
            ACN(DN:3, (Val(CP:2) * (Val(CT:2) + Val(CT:4)) / 2) - (Val(CP:2) * (Val(CT:1) + Val(CT:3)) / 2))
         ENDIF
      ENDIF
   ENDIF
ENDIF


*********************************************
** --- Calculo de Resultado CER para PF ---**
*********************************************

If Incluido(FBN('TipoOp'),'MMCPM|')
   ACT(IC:1, Var('INDICEDEFA'))
   If Eqstr(FBN('Indice'),Val(IC:1))
      ***/// Para el ajuste CER se busca la cotizacion del dia habil anterior
      ACD(FD:2, Habiles(Val(FD:1), -1, 'ARG', SI))
      ACD(FH:2, Habiles(Val(FH:1), -1, 'ARG', SI))
      ACD(FD:3, Habiles(Val(FC:9), -1, 'ARG', SI))
   
      ACN(CF:2, COTIZACION(Val(IC:1),,,,Val(FH:2),1) / COTIZACION(Val(IC:1),,,,Val(FD:3),1))
      ACN(CF:3, COTIZACION(Val(IC:1),,,,Val(FD:2),1) / COTIZACION(Val(IC:1),,,,Val(FD:3),1))
   
      ***/// Coeficiente a aplicar
      ACN(CF:1, Val(CF:2)-Val(CF:3))
   
      ***/// Resultado de Ajuste CER
      ACN(CR:1, Val(CO:1) * Val(CF:1))
   Endif
Endif



*************************************************
** --- Calculo DC e Interes de forma DIARIA ---**
*************************************************

ACT(MO:88, fbn('Moneda'))
ACT(AL:88, fbn('Alias4'))
ACT(TO:88, fbn('TipoOp'))
ACT(TO:99, fbn('NrOperacion'))
ACN(BD:55, 0)
ACN(MO:66, 0)
ACN(DI:1, 0)
ACN(DI:2, 0)
ACN(DI:3, 0)
ACN(IT:1, 0)
ACN(IT:2, 0)
ACN(IT:3, 0)
***/// Proceso dia a dia desde el inicio hasta la fecha actual
SQL.ADD(" Select NrOperacion, Fecha, Monto ")
SQL.ADD(" From "~DBO~".MOVDEVENGADOS ")
SQL.ADD(" Where NrOperacion = '"~FBN('NrOperacion')~"' ")
SQL.ADD(" and TipoDevengado = '"~FBN('TipoDevengado')~"' ")
SQL.ADD(" and Fecha > '"~IdxDate(Val(FC:10))~"' ")
SQL.ADD(" and Fecha <= '"~IdxDate(Val(FH:1))~"' ")
SQL.ADD(" Order by Fecha ")
Recorrer SQL
    If FBN('Fecha') > Val(FD:1)
        ***// Para las operaciones Activas/Pasivas se toma TC Comprador/Vendedor
        If Not EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',Val(TO:88)),VAR('CLASEOPVIN'))
            ***/// Calculo de Interes con cotizacion diaria
            IF Eqstr(Val(MO:88), Val(ME:1))
               ACN(IT:11, fbn('Monto') * CotizacionBNA(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
               IF Eqstr(Val(AL:88), Val(ML:1))
                  ACN(IT:22, Val(IT:11))
               ELSE
                  ACN(IT:22, fbn('Monto') * CotizacionBCU(Val(MO:88),FBN('Fecha'),Val(AP:1),NO,NO))
               ENDIF
               ACN(IT:33, fbn('Monto'))
            ELSE
               IF Eqstr(Val(MO:88), Val(ML:1))
                  ACN(IT:11, fbn('Monto'))
                  IF Eqstr(Val(AL:88), Val(ML:1))
                     ACN(IT:22, Val(IT:11))
                  ELSE
                     ACN(IT:22, fbn('Monto') * CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                  ENDIF
                  ACN(IT:33, fbn('Monto') / CotizacionBNA(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
               ELSE
                  IF Eqstr(Val(MO:88), Val(MU:1))    
                     ACN(IT:11, fbn('Monto') / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                     IF Eqstr(Val(AL:88), Val(ML:1))
                        ACN(IT:22, fbn('Monto') / CotizacionBNABCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                     ELSE
                        ACN(IT:22, fbn('Monto'))
                     ENDIF
                     ACN(IT:33, fbn('Monto') / CotizacionBCU(Val(ME:1),FBN('Fecha'),Val(AP:1),NO,NO))
                  ENDIF
               ENDIF
            ENDIF
        ELSE
        ***/// Para las operaciones vinculadas toma TC promedio
            ***/// Calculo de Interes con cotizacion diaria
            IF Eqstr(Val(MO:88), Val(ME:1))
               ACN(CT:1, (CotizacionBNA(Val(MO:88),FBN('Fecha'),1,NO,NO) + CotizacionBNA(Val(MO:88),FBN('Fecha'),2,NO,NO))/2)
               ACN(IT:11, fbn('Monto') * Val(CT:1))
               IF Eqstr(Val(AL:88), Val(ML:1))
                  ACN(IT:22, Val(IT:11))
               ELSE
                  ACN(CT:1, (CotizacionBCU(Val(MO:88),FBN('Fecha'),1,NO,NO) + CotizacionBCU(Val(MO:88),FBN('Fecha'),2,NO,NO))/2)
                  ACN(IT:22, fbn('Monto') * Val(CT:1))
               ENDIF
               ACN(IT:33, fbn('Monto'))
            ELSE
               IF Eqstr(Val(MO:88), Val(ML:1))
                  ACN(IT:11, fbn('Monto'))
                  IF Eqstr(Val(AL:88), Val(ML:1))
                     ACN(IT:22, Val(IT:11))
                  ELSE
                     ACN(CT:1, (CotizacionBNABCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNABCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                     ACN(IT:22, fbn('Monto') * Val(CT:1))
                  ENDIF
                  ACN(CT:1, (CotizacionBNA(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNA(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                  ACN(IT:33, fbn('Monto') / Val(CT:1))
               ELSE
                  IF Eqstr(Val(MO:88), Val(MU:1))
                     ACN(CT:1, (CotizacionBNABCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNABCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                     ACN(IT:11, fbn('Monto') / Val(CT:1))
                     IF Eqstr(Val(AL:88), Val(ML:1))
                        ACN(CT:1, (CotizacionBNABCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBNABCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                        ACN(IT:22, fbn('Monto') / Val(CT:1))
                     ELSE
                        ACN(IT:22, fbn('Monto'))
                     ENDIF
                     ACN(CT:1, (CotizacionBCU(Val(ME:1),FBN('Fecha'),1,NO,NO) + CotizacionBCU(Val(ME:1),FBN('Fecha'),2,NO,NO))/2)
                     ACN(IT:33, fbn('Monto') / Val(CT:1)) 
                  ENDIF
               ENDIF
            ENDIF
        ENDIF
        SCN(IT:1, Val(IT:11))
        SCN(IT:2, Val(IT:22))
        SCN(IT:3, Val(IT:33))
    ENDIF
    ***/// Calculo DC Diario
    SCN(MO:66, Abs(fbn('Monto')))
    IF Val(BD:55) = 1
        ***---Hay DC desde el segundo dia que devenga, por el monto acumulado al dia anterior que se procesa
        ***---Tanto a fin de mes como al Vto. se calcula la DC dia a dia a partir del interes acumulado a principio de mes
        ACN(MO:55, Val(MO:66) - Abs(fbn('Monto')))
        ACD(FD:55, FBN('Fecha')-1)
        ACD(FH:55, FBN('Fecha'))
        IF [Val(CK:99) = 0 Y fbn('Fecha') >= Val(V:4)] O [Val(CK:99) = 1 Y fbn('Fecha') >= Val(V:3)]
            ***/// El dia procesado correspone al mes actual, entonces calculo DC diario.
            (.'DCDIARIA'.)
            SCN(DI:1, Val(DK:55))
            SCN(DI:2, Val(DK:66))
            SCN(DI:3, Val(DK:77))
        ENDIF
    ENDIF
    ACN(BD:55, 1)
Proximo

IF Eqstr(Val(TO:99), 'I2000256')
*    MessageBox(Val(IT:22))
*    MessageBox(Val(IT:1))
*    MessageBox(Val(IT:2))
*    MessageBox(Val(IT:3))
ENDIF
