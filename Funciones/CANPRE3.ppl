ACN(ha:val(x1),0)
ACN(hb:val(x1),0)
ACN(hc:val(x1),0)
ACN(na:val(x1),0)
ACN(nb:val(x1),0)

ACT(cz:val(x1),Fstr(FBN['NrCuota'],0,0))
ACD(cy:val(x1),FBN['Fecha1'])
ACT(cx:val(x1),Fstr(FBN['Plazo1'],0,0))
ACD(cw:val(x1),FBN['Fecha2'])
ACD(cv:val(x1),FBN['Fecha4'])
ACN(cu:val(x1),FBN['Tasa1'])

*** IMPORTE AMORTIZADO SALDO ANTERIOR
ACN(ca:val(x1),Round(FBN['Cantidad5'],2))

*** IMPORTE AMORTIZADO
ACN(ci:val(x1),Round(FBN['Cantidad1'],2))

*** SALDO CAPITAL
ACN(ct:val(x1),Round(FBN['Cantidad3'],2))

*** INTERES NORMAL
ACN(ch:val(x1),Round(FBN['Cantidad6'],2))

*** INTERES COMPENSATORIO
ACN(cc:val(x1),Round(FBN['Cantidad7'],2))

*** INTERES PUNITORIO
ACN(cd:val(x1),Round(FBN['Cantidad8'],2))

*** SALDO COMISIONES NORMALES
ACN(cq:val(x1),Round(FBN['Cantidad12'],2))

*** SALDO COMISIONES COMPENSATORIAS
ACN(cr:val(x1),Round(FBN['Total8'],2))

*** IVANORINT
ACN(ce:val(x1),Round(FBN['Cantidad9'],2))
*** IVAADIINT
ACN(cf:val(x1),Round(FBN['Cantidad10'],2))
*** IVAPERINT
ACN(cg:val(x1),Round(FBN['Cantidad11'],2))

*** IVANORCOM
ACN(cj:val(x1),Round(FBN['Cantidad13'],2))
*** IVAADICOM
ACN(ck:val(x1),Round(FBN['Cantidad14'],2))
*** IVAPERCOM
ACN(cl:val(x1),Round(FBN['Cantidad15'],2))

if val(z2) < val(cw:val(x1)) 
     *** INTERES NORMAL DEL PERIODO ***
     ACN(gg:val(x1),Round(val(ct:val(x1))*val(cu:val(x1))*iif(val(z2)>val(cy:val(x1)),val(z2)-val(cy:val(x1)),0)/val(g1),2))

     *** COMISION
     if val(t1)=2 y val(u1)=1 y Not[Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')]
        ACN(na:val(x1),Round(val(ct:val(x1))*iif(val(z2)>val(cy:val(x1)),val(z2)-val(cy:val(x1)),0)*val(v1)/val(g1),2))
     else
        ACN(na:val(x1),val(cq:val(x1))) 
     endif

     *** IVA ****
     if Not[Eqstr(val(p1),'INGCURA')] 

       *--- IVA / INTERES NORMAL
       ACN(pm1,val(gg:val(x1)))
       ACN(pf1,val(z2))
       ACT(pt1,'INT')
       (.'CANPREIVA'.)
       ACN(ga:val(x1),val(pr1))
       ACN(gb:val(x1),val(pr2))
       ACN(gc:val(x1),val(pr3))

       *--- IVA / COMISION
       ACN(pm1,val(na:val(x1)))
       ACN(pf1,val(z2))
       ACT(pt1,'COM')
       (.'CANPREIVA'.)
       ACN(nb:val(x1),val(pr1))
       ACN(nc:val(x1),val(pr2))
       ACN(nd:val(x1),val(pr3))
  
     endif    
     *--- FIN IVA

   *** TOTAL IVANORINT
   ACN(ha:val(x1),Round(val(ga:val(x1))+val(nb:val(x1)),2))
   
   *** TOTAL IVAADIINT
   ACN(hb:val(x1),Round(val(gb:val(x1))+val(nc:val(x1)),2))

   *** TOTAL IVAPERINT
   ACN(hc:val(x1),Round(val(gc:val(x1))+val(nd:val(x1)),2))

   ACN(mm:val(x1),Round(val(ca:val(x1))+val(gg:val(x1))+val(da:val(x1))+val(db:val(x1))+val(na:val(x1))+val(ha:val(x1))+val(hb:val(x1))+val(hc:val(x1)),2))
 
   if Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')
      ACN(mm:val(x1),Round(val(mm:val(x1))-val(ca:val(x1)),2))
   endif

   SCN(x2,Round(val(mm:val(x1)),2))

else

   *** INTERES NORMAL DEL PERIODO ***
   ACN(gg:val(x1),Round(val(ch:val(x1)),2))

   if val(cv:val(x1)) > 0
     ACN(pp:val(x1),val(z2)-val(cv:val(x1)))
   else
     if val(cw:val(x1))<>val(z2)
        if EsHabil(val(cw:val(x1)), 'ARG') 
           ACN(pp:val(x1),val(z2)-val(cw:val(x1)))
        else
           ACN(pp:val(x1),val(z2)-Habiles(val(cw:val(x1)),1,'ARG'))
        endif
     endif
   endif

   *** INTERES COMPENSATORIO DEL PERIODO ***
*   ACN(da:val(x1),Round(val(ca:val(x1))*val(bp1)*val(pp:val(x1))/val(g1),2))

*FO 08/05/2006   ACN(da:val(x1),Round(val(ct:val(x1))*val(bp1)*val(pp:val(x1))/val(g1),2))
* Vuelve a version anterior, porque quedan inconsistentes los devengados respecto de los mov de liquid
* Estaban dev por la cuota, y mov liq por el saldo del prestamo

   ACN(da:val(x1),Round(val(ca:val(x1))*val(bp1)*val(pp:val(x1))/val(g1),2))

   *** COMISION
   ACN(na:val(x1),val(cq:val(x1))) 

   *** COMISION COMPENSATORIA
   if val(t1)=2 y val(u1)=1 y Not[Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')]
     ACN(nh:val(x1),Round(val(ca:val(x1))*val(pp:val(x1))*val(v1)/val(g1),2))
   else
     ACN(nh:val(x1),0)
   endif

   *** Si es el primer pago recalculo el IVA sobre los Int. Normales y las Comisiones
   *** usando la tasa a la Fecha Vto.

   *** IVA ****
   if Not[Eqstr(val(p1),'INGCURA')] 

     if val(cv:val(x1)) > 0
         ACN(ga:val(x1),val(ce:val(x1)))
         ACN(gb:val(x1),val(cf:val(x1)))
         ACN(gc:val(x1),val(cg:val(x1)))

         ACN(nb:val(x1),val(cj:val(x1)))
         ACN(nc:val(x1),val(ck:val(x1)))
         ACN(nd:val(x1),val(cl:val(x1)))
     else
         *--- IVA / INTERES NORMAL
         ACN(pm1,val(gg:val(x1)))
         ACN(pf1,val(cw:val(x1)))
         ACT(pt1,'INT')
         (.'CANPREIVA'.)
         ACN(ga:val(x1),val(pr1))
         ACN(gb:val(x1),val(pr2))
         ACN(gc:val(x1),val(pr3))

         *--- IVA / COMISION
         ACN(pm1,val(na:val(x1)))
         ACN(pf1,val(cw:val(x1)))
         ACT(pt1,'COM')
         (.'CANPREIVA'.)
         ACN(nb:val(x1),val(pr1))
         ACN(nc:val(x1),val(pr2))
         ACN(nd:val(x1),val(pr3))
     endif
   endif

   *** INTERES PUNITORIO DEL PERIODO ***
   *** CAPITAL + INT.NORMAL + SALDO IMPUESTOS + SALDO COMISION + SALDO INT.PUNITORIO
   if Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')
     ACN(db:val(x1),Round((val(nb:val(x1))+val(nc:val(x1))+val(nd:val(x1))+val(na:val(x1)))*val(h1)*val(pp:val(x1))/val(g1),2))    
   else
     ACN(db:val(x1),Round((val(ca:val(x1))+val(gg:val(x1))+val(ga:val(x1))+val(gb:val(x1))+val(gc:val(x1))+val(nb:val(x1))+val(nc:val(x1))+val(nd:val(x1))+val(na:val(x1)))*val(h1)*val(pp:val(x1))/val(g1),2))    
   endif
   SCN(db:val(x1),val(cd:val(x1)))

   if Not[Eqstr(val(p1),'INGCURA')] 
     *** IVA / INT.COMPENSATORIOS
     ACN(pm1,val(da:val(x1)))
     ACN(pf1,val(z2))
     ACT(pt1,'INT')
     (.'CANPREIVA'.)
     ACN(ea:val(x1),val(pr1))
     ACN(eb:val(x1),val(pr2))
     ACN(ec:val(x1),val(pr3))

     *** IVA / COM.COMPENSATORIA
     ACN(pm1,val(nh:val(x1)))
     ACN(pf1,val(z2))
     ACT(pt1,'COM')
     (.'CANPREIVA'.)
     ACN(ne:val(x1),val(pr1))
     ACN(nf:val(x1),val(pr2))
     ACN(ng:val(x1),val(pr3))

     *--- IVA / INTERES PUNITORIO
     ACN(pm1,val(db:val(x1)))
     ACN(pf1,val(z2))
     ACT(pt1,'INT')
     (.'CANPREIVA'.)
     ACN(fa:val(x1),val(pr1))
     ACN(fb:val(x1),val(pr2))
     ACN(fc:val(x1),val(pr3))
   endif

   *** TOTAL IVANORINT
   ACN(ha:val(x1),Round(val(ga:val(x1))+val(ea:val(x1))+val(fa:val(x1))+val(nb:val(x1))+val(ne:val(x1)),2))
   
   *** TOTAL IVAADIINT
   ACN(hb:val(x1),Round(val(gb:val(x1))+val(eb:val(x1))+val(fb:val(x1))+val(nc:val(x1))+val(nf:val(x1)),2))

   *** TOTAL IVAPERINT
   ACN(hc:val(x1),Round(val(gc:val(x1))+val(ec:val(x1))+val(fc:val(x1))+val(nd:val(x1))+val(ng:val(x1)),2))
   
   ACN(mm:val(x1),Round(val(ca:val(x1))+val(gg:val(x1))+val(da:val(x1))+val(db:val(x1))+val(na:val(x1))+val(nh:val(x1))+val(ha:val(x1))+val(hb:val(x1))+val(hc:val(x1)),2))

   if Eqstr(val(p1),VAR('VEHICULODE')) y Eqstr(val(bo4),'1')
      ACN(mm:val(x1),Round(val(mm:val(x1))-val(ca:val(x1)),2))
   else
      SCN(y3,val(ca:val(x1)))
   endif

   *** TOTAL PUNITORIOS
   SCN(y6,Round(val(db:val(x1)),2))
   SCN(y7,Round(val(fa:val(x1))+val(fb:val(x1))+val(fc:val(x1)),2))

   SCN(y2,Round(val(mm:val(x1)),2))

   SCN(x2,Round(val(mm:val(x1)),2))
   ACN(y1, val(x1))
endif  

