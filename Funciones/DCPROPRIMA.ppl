*- DCPROPRIMA - Prorrateo de Primas P.Cobertura
*- Si el Vehiculo es Producto   -> Paga Prima
*- Si el Vehiculo es Consumidor -> Cobra Prima
*- Calculo de la Prima para sumar o restar al precio
*- MontoPrima/VolumenCubiertoMensual 

*- lc: VolumenCubiertoMensual 
acn(lc:fac,val(&j:fac))

If Dialogo.Radio1=1      
   acn(lc:fac,val(&j:fac)*(Dialogo.Fecha2-Dialogo.Fecha1+1))
EndIf

*- ld: MontoPrima/VolumenCubiertoMensual 
acn(ld:fac,val(z16)/val(lc:fac))

If Incluido(Dialogo.Vehiculo1, VAR('VEHIPRODU'))
   scn(&j+1:fac,-val(ld:fac))  
Else
   scn(&j+1:fac,val(ld:fac))  
EndIf

Message('Prorrateo de Primas '~val(ld:fac))