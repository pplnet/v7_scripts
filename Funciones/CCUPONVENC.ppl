*** Toma todas las operaciones vencidas y pendientes y los contados, pases y cauciones ***
*** Marca las operaciones, cambia la especie en los movimientos y agrega los cupones ***

SQL.ADD("SELECT Distinct O.TipoOp, O.Especie,O.NrOperacion, M.* ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrOperacion = O.NrOperacion ")
*SQL.ADD("and   O.Vehiculo1 = '"~Val(j2)~"' ")
SQL.ADD("and   O.Vehiculo1 IN ("~Pipe2Comillas(&vehiculos)~") ")
SQL.ADD("and   O.Especie   = '"~Val(b2)~"' ")
SQL.ADD("AND   M.Cupon     = '"~FSTR(VAL(c2),1,0)~"' ")
SQL.ADD("AND   M.NrSaldo   = 1 ")
SQL.ADD("and   O.TipoOp In ('CFTC','CFTP','VFTC','VFTP','CTE','VTE','CTP','VTP','CTC','VTC','CBL','VBL','PBT','PBC','PBTC')")
SQL.ADD("and   O.FechaVto <= '"~IdxDate(Val(g2))~"'  ")
SQL.ADD("and  (O.RB4 = '0' or O.RB4 is Null) ") 
SQL.ADD("order by O.TipoOp, O.Especie")

SetFilaActual(99)
Recorrer SQL
   act(a:fac,fbn['NrOperacion'])

   message(val(a:fac))

   SQL.ADD("Update "~DBO~".OPERACIONES ")
   SQL.ADD("Set RB4 = '1' ")
   SQL.ADD("where  NrOperacion = '"~Val(a:fac)~"' ")
   SQL.NEW

    ***---ACT(Y1,GetNumerador(20))
    ACT(Y:1, GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo', FBN('Vehiculo1'))))
    SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 (")
    SQL.ADD(" Especie, Especie2, Cupon1 ,")
    SQL.ADD(" Fecha1, Fecha2, Cliente1, ")
    SQL.ADD(" Cantidad1, Precio1, ")
    SQL.ADD(" Precio2, Precio3, Cambio1, ")
    SQL.ADD(" Cambio2, Vehiculo1, ")
    SQL.ADD(" TipoTr2, NrTrans, Mercado1, ")
    SQL.ADD(" Cuenta2, Cuenta6, ")
    SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, CB2, NrOperacionRef1,Cambio3 ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD(" '"~Val(b2)~"', '"~Val(b4)~"', '"~FStr(Val(c2),1,0)~"',")
    SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~IdxDate(Val(h4))~"', '"~fbn('Cliente')~"', ")
    SQL.ADD(" "~FStr(fbn('Cantidad'),1,2)~", "~FStr(Val(k2),1,8)~", ")    
    SQL.ADD(" "~FStr(Val(l2),1,8)~", "~FStr(Val(m2),1,8)~", "~FStr(Val(e2),1,8)~", ")
    *SQL.ADD(" "~FStr(Val(e3),1,8)~", '"~VAL(j2)~"', ")
    SQL.ADD(" "~FStr(Val(e3),1,8)~", '"~FBN('Vehiculo1')~"', ")
    SQL.ADD(" 'CUPON', '"~Val(y1)~"','"~fbn('Mercado')~"', " )
    SQL.ADD(" '"~fbn('Cuenta')~"', '"~fbn('Cuenta')~"', ")
    SQL.ADD(" "~SQLAhora~", '"~IdxDate(Fsys)~"', '"~UsuarioActivo~"', '1', '"~fbn['NrOperacion']~"',"~FStr(Val(in1),1,8)~" ")
    SQL.ADD(" ) ")
    SQL.NEW  

    SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
    SQL.ADD("(NrBit, NrOperacion, Valor) ")
    SQL.ADD(" VALUES ")
    SQL.ADD("(20, '"~Val(y1)~"', '1') ")
    SQL.NEW

    SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES (")
    SQL.ADD("NrOperacion, FechaMov, Cliente, ")
    SQL.ADD(" Especie, Cantidad, Leyenda,")
    SQL.ADD(" Bits, NrSaldo, NrGrupo, EnteCustodia, Mercado, ")
    SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
    SQL.ADD(" NrInstan, Cupon, Concepto, Cuenta, NrTrans2 ")
    SQL.ADD(" ) Values (")
*    SQL.ADD(" '"~Val(Y1)~"', '"~IdxDate(Val(g2))~"', '"~fbn('Cliente')~"', ")
    SQL.ADD(" '"~fbn('NrOperacion')~"', '"~IdxDate(Val(g2))~"', '"~fbn('Cliente')~"', ")
    SQL.ADD(" '"~Val(b2)~"', "~FStr(fbn('Cantidad')*-1,1,2)~", '"~Val(x4)~"', ")
    *SQL.ADD(" 'MI', 1, 1, '"~VAL(j2)~"', '"~fbn('Mercado')~"',")
    SQL.ADD(" 'MI', 1, 1, '"~fbn('Vehiculo1')~"', '"~fbn('Mercado')~"',")
    SQL.ADD(" '"~IdxDate(FSys)~"', 0, 1, ")
    SQL.ADD(" 0, '"~FStr(Val(c2),1,0)~"','"~fbn('Concepto')~"','"~fbn('Cuenta')~"', '"~Val(Y1)~"' ) ")
    SQL.NEW

    *----------------- Generar Movimientos por la especie nueva

    IF Val(C:3) > 0
        SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES (")
        SQL.ADD(" NrOperacion, FechaMov, Cliente, ")
        SQL.ADD(" Especie, Cantidad, Leyenda,")
        SQL.ADD(" Bits, NrSaldo, NrGrupo, EnteCustodia, Mercado, ")
        SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
        SQL.ADD(" NrInstan, Cupon, Concepto,Cuenta, NrTrans2 ")
        SQL.ADD(" ) Values (")
*        SQL.ADD(" '"~Val(Y1)~"', '"~IdxDate(Val(g2))~"', '"~fbn('Cliente')~"', ")
        SQL.ADD(" '"~fbn('NrOperacion')~"', '"~IdxDate(Val(g2))~"', '"~fbn('Cliente')~"', ")
        SQL.ADD(" '"~Val(b2)~"', "~FStr(fbn('Cantidad'),1,2)~", '"~Val(x4)~"', ")
        *SQL.ADD(" 'MI', 1, 2, '"~VAL(j2)~"', '"~fbn('Mercado')~"',")
        SQL.ADD(" 'MI', 1, 2, '"~FBN('Vehiculo1')~"', '"~fbn('Mercado')~"',")
        SQL.ADD(" '"~IdxDate(FSys)~"', 0, 2, ")
        SQL.ADD(" 0, '"~FStr(Val(c3),1,0)~"','"~fbn('Concepto')~"','"~fbn('Cuenta')~"', '"~Val(Y1)~"' ) ")
        SQL.NEW
    ENDIF

    *---------------- Generar Movimientos por los cupones
    If val(l2)+val(k2)<>0
       SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES (")
       SQL.ADD(" NrOperacion, FechaMov, Cliente, ")
       SQL.ADD(" Especie, Cantidad, Leyenda,")
       SQL.ADD(" Bits, NrSaldo, NrGrupo, EnteCustodia, Mercado, ")
       SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
       SQL.ADD(" NrInstan, Cupon, Concepto, Cuenta, NrTrans2")
       SQL.ADD(" ) Values (")
       *SQL.ADD(" '"~Val(Y1)~"', '"~IdxDate(Val(g2))~"', '"~fbn('Cliente')~"', ")
       SQL.ADD(" '"~fbn('NrOperacion')~"', '"~IdxDate(Val(g2))~"', '"~fbn('Cliente')~"', ")
       SQL.ADD(" '"~Val(b4)~"', "~FStr(fbn('Cantidad'),1,2)~", '"~Val(x4)~"', ")
       SQL.ADD(" 'MI', 1, 2, '"~FBN('Vehiculo1')~"', '"~fbn('Mercado')~"',")
       SQL.ADD(" '"~IdxDate(FSys)~"', 0, 3, ")
       SQL.ADD(" 0, '"~FStr(Val(c2),1,0)~"','"~fbn('Concepto')~"', '"~fbn('Cuenta')~"', '"~Val(Y1)~"' ) ")
       SQL.NEW
       SQL.EXEC
    EndIf

    *----- Corte de Posicion Sin Saldo (en Op Vencidas)
    SQL.ADD(" SELECT P.CantidadFin, P.PrecioFin, P.Cliente, P.NrSaldo, P.TipoNegocio, P.NrSaldo, ")
    SQL.ADD(" P.Vehiculo, P.Trader, E.Cotiza, E.InteresesC, E.TamanioLote, 'Ejecutado' Estado, P.Fecha FechaMov ")
    SQL.ADD(" FROM  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
    SQL.ADD(" WHERE P.Cliente  = '"~fbn('Cliente')~"' ")
    SQL.ADD(" AND   P.Especie  = E.Codigo ")
    SQL.ADD(" AND   P.NrSaldo IN (1,2)   ")
    SQL.ADD(" AND   P.Fecha    <= '"~IdxDate(Val(g2))~"' ")
    *SQL.ADD(" AND   P.Vehiculo  = '"~Dialogo.Vehiculo1~"' ")
    SQL.ADD(" AND   P.Vehiculo  IN '"~Pipe2Comillas(&vehiculos)~"' ")
    SQL.ADD(" AND   P.Especie   = '"~Val(b2)~"' ")
    SQL.ADD(" AND   P.Cupon     = '"~FStr(Val(c2),1,0)~"' ")
    SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES X")
    SQL.ADD("                   WHERE  X.Cliente = P.Cliente ")
    SQL.ADD("                   AND    X.Especie = P.Especie ")
    SQL.ADD("                   AND    (X.TipoNegocio  = P.TipoNegocio OR (X.TipoNegocio IS NULL AND P.TipoNegocio IS NULL) ) ")
    SQL.ADD("                   AND    X.Vehiculo     = P.Vehiculo ") 
    SQL.ADD("                   AND    X.NrSaldo      = P.NrSaldo  ") 
    SQL.ADD("                   AND    X.Trader       = P.Trader   ") 
    SQL.ADD("                   AND    X.Cupon        = P.Cupon    ") 
    SQL.ADD("                   AND    X.Fecha <= '"~IdxDate(Val(g2))~"') ")
    SQL.ADD(" ORDER By E.Cotiza ")

    Recorrer SQL
     IF fbn('CantidadFin')<>0
        ACN(z1, fbn('CantidadFin'))
        ACN(z2, fbn('PrecioFin'))

        * Precio Final actualizado

        if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(b2)),'CLE')
           ACN(z3,Val(z2))
        else
           ACN(z3,Val(z2)-((Val(k2)+Val(l2)+Val(m2))/100))
        endif 

        * Actualizar movimientos de posicion para la especie vieja
        *------ Posicion del Cliente ----------------*
        SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ")
        SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
        SQL.ADD(" FechaMov, Cliente, Vehiculo, ")
        SQL.ADD(" NrSaldo, Precio, ")
        SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~Val(b2)~"', "~Fstr(val(z1)*(-1),1,2)~", '"~Val(Y1)~"', ")
        SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', ")
        SQL.ADD(" "~FStr(FBN['NrSaldo'],1,0)~", "~FStr(Val(z2),1,8)~", ")
        SQL.ADD(" '"~FStr(Val(c2),1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"' ) ")
        SQL.NEW

        * Actualizar movimientos de posicion para la especie nueva
        IF Val(C:3) > 0
            SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ")
            SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
            SQL.ADD(" FechaMov, Cliente, Vehiculo, ")
            SQL.ADD(" NrSaldo, Precio,  ")
            SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader ")
            SQL.ADD(" ) Values ( ")
            SQL.ADD(" '"~Val(b2)~"', "~Fstr(val(z1),1,2)~", '"~Val(Y1)~"', ")
            SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', ")
            SQL.ADD(" "~FStr(FBN['NrSaldo'],1,0)~", "~FStr(Val(z3),1,8)~", ")
            SQL.ADD(" '"~FStr(Val(c3),1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"' ) ")
            SQL.NEW
        ENDIF

        If val(l2)+val(k2)<>0
           * Actualizar movimientos de posicion para el cupon
           SQL.ADD(" INSERT INTO "~DBO~".MOVPOSEJE ")
           SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
           SQL.ADD(" FechaMov, Cliente, Vehiculo, ")
           SQL.ADD(" NrSaldo, Precio,  ")
           SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader ")
           SQL.ADD(" ) Values ( ")
           SQL.ADD(" '"~Val(b4)~"', "~Fstr(val(z1),1,2)~", '"~Val(Y1)~"', ")
           SQL.ADD(" '"~IdxDate(Val(g2))~"', '"~FBN['Cliente']~"', '"~FBN['Vehiculo']~"', ")
           SQL.ADD(" "~FStr(FBN['NrSaldo'],1,0)~", "~FStr((Val(k2)+Val(l2)+Val(m2))/100,1,8)~",  ")
           SQL.ADD(" '"~FStr(Val(c2),1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"' ) ")
           SQL.NEW
           SQL.EXEC
        EndIf
     ENDIF
    Proximo
   *----------------------------------------------------------*
Proximo

