        SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.TipoOp, O.FechaOp, O.FechaVto, O.Cantidad, ")
        SQL.ADD(" O.Precio1, O.TotalBrutoCli1, O.Especie, O.Vehiculo1 ")
        SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".CLIENTES C ")
        SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
        SQL.ADD(" AND O.Cliente1 = C.Codigo ")
        SQL.ADD(" AND B.NrBit IN (10, 70) ")
        SQL.ADD(" AND B.Valor = '1' ")
        ***---Sin Boleto Asignado
        SQL.ADD(" AND O.NrOperacion4 Is Null ")
        ***---No Financiero o del Exterior
        SQL.ADD(" AND C.Codigo IN ("~Pipe2Comillas(Val(LS:1))~") ")
        IF Dialogo.Radio2 = 0
            SQL.ADD(" AND O.TipoOp = 'FXC' ")
        ELSE
            SQL.ADD(" AND O.TipoOp = 'FXV' ")
        ENDIF
        SQL.ADD(" Order By O.NrOperacion ")
        Recorrer SQL
            ACT(A:fac, fbn('NrOperacion'))
            ACT(B:fac, fbn('TipoOp'))
            ACT(C:fac, fbn('Cliente1'))
            ACD(D:fac, fbn('FechaOp'))
            ACD(E:fac, fbn('FechaVto'))
            ACN(F:fac, fbn('Cantidad'))
            ACN(G:fac, fbn('Precio1'))
            ACN(H:fac, fbn('TotalBrutoCli1'))
            ACT(O:fac, fbn('Especie'))
            ACT(Q:fac, fbn('Vehiculo1'))
            ACN(BD:1, 1)
        Proximo
        IF Val(BD:1) = 0
            Cancelar('No Hay Operaciones de '~IIF(Dialogo.Radio2 = 0, 'Compra', 'Venta')~' Sin Boleto Asignado')
        ENDIF

        CrearListBox ; 'Arial,8,';'Alta de Boletos BCRA: Seleccione una Operacion de Cambio'
           'OK'              ;K:1..K:fac;SI;Sum(K:1..K:fac)=0 O Sum(K:1..K:fac)=1;'Debe seleccionar solo una Operacion';60;CHECK;RGB(220,220,193);
           'Operacion'       ;A:1..A:fac;NO;;;70;STRING;;RGB(220,220,220);
           'TipoOp'          ;B:1..B:fac;NO;;;70;STRING;;RGB(220,220,220);
           'Cliente'         ;C:1..C:fac;NO;;;70;STRING;;RGB(220,220,220);
           'FechaOp'         ;D:1..D:fac;NO;;;70;FECHA;RGB(220,220,220);
           'Fecha Liq Mon'   ;E:1..E:fac;NO;;;80;FECHA;RGB(220,220,220);
           'Cantidad'        ;F:1..F:fac;NO;;;90;NUMERO;'###,###,###.##';RGB(220,220,220);
           'Precio'          ;G:1..G:fac;NO;;;90;NUMERO;'###,###.########';RGB(220,220,220);
           'Monto'           ;H:1..H:fac;NO;;;90;NUMERO;'###,###,###.##';RGB(220,220,220);
        FinListBox

        IF Not OK
            Cancelar
        ENDIF
