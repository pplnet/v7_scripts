*- Segun Corte Saldos o Movimientos las Fechas varian -> 
*- fv1: Fecha Valida para Movimiento del Corte  
*- fv2: Fecha Valida para Movimiento del Pago 

*- mp1: Nro. Transaccion mp2: Fecha Movimiento mp3: Cliente 
*- mp4: Especie  
*- mp5: CallPut  
*- mp6: FechaEj  
*- mp7: PrecioEj  
*- mp8: Mercado
*- mp9: EnteCustodia 
*- mp10: Cantidad 
*- mp11: Formula 
*- mp12: Leyenda 
*- mp13: Bits  
*- mp14: NrSaldo   
*- mp15: NrGrupo
*- mp16: Concepto (NrSaldo Original)
*- mp19: Cuenta mp22: Nro. de Movimiento mp20: NrGrupo2
*- mp27: Cupon  mp23: Com.Renta mp25: Com.Amortizacion
*- mp50: Leyendo para ver si viene de movimientos pendientes
***---MP26: NrInstan

 
*- Seteo el tipo de movimiento Automatico-Manual
*- jo1=1 -> Algunos Bits AV y Otros MV  
*- ch1=2 Todos MV 
ACT(mp13,'AV' )
ACD(mp2,val(fv1))

If val(jo1)=6 y Not Incluido(Fstr(val(c:val(fi1)),0,0),Val(dz6))
   ACT(mp13,'AV')
   ACD(mp17,val(mp2))
EndIf
         
*- mp20: En Nro. de grupo2 grabo la tenencia 
ACN(mp20,Val(g:val(fi1)) )

ACT(mp16,Fstr(Val(m:val(fi1)),0,0) )

*--------------------------------------------------------------
*- Movimiento por la Especie Bajando el Cupon Anterior - Si t y u no estan vacios tomo
*- esos montos que son la separacion del saldo libre disponibilidad
ACT(mp1,val(y1))
ACT(mp3,val(a:val(fi1)) )
ACT(mp4,Val(b2))

ACT(mp5,Val(y:3))
ACT(mp6,'' )
ACN(mp7,0 )

IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
   ACT(mp6,Val(p:val(fi1)) )
   ACN(mp7,Val(q:val(fi1)))
EndIf

ACT(mp8 ,Val(d:val(fi1)) )
ACT(mp9 ,Dialogo.Vehiculo1)

*- % IVA 
ACT(mp11,Fstr(val(ci:2),0,2) )          
ACT(mp12,'Corte de Cupon de '~val(mp4)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          
  
*- mp15: Nro. Grupo 1 es el de las Acciones 
ACN(mp15,1)
ACT(mp19,Val(f:val(fi1)) )
ACN(mp22,val(fi1) )
ACT(mp27,Val(c:val(fi1)) )

If Val(m:val(fi1))=101 y [Val(t:val(fi1))<>0 o Val(u:val(fi1))<>0]
  
   If Val(t:val(fi1))<>0 
      *- Mov. por 101
      ACN(mp14,101)

      *- Importe
      ACN(mp10,-Val(t:val(fi1)) )
      ACN(MP:26, 0)

      (."IMMOVPEND".)
   EndIf

   If Val(u:val(fi1))<>0 
      *- Mov. por 207
      ACN(mp14,207)
      *- Importe
      ACN(mp10,-Val(u:val(fi1)) )
      ACN(MP:26, 0)

      (."IMMOVPEND".)
   EndIf
Else 
   *- No es necesario desdoblar
   *- NrSaldo
   ACN(mp14,Val(m:val(fi1)))

   *- Importe
   ACN(mp10,- Val(g:val(fi1)) )
   ACN(MP:26, 0)

   (."IMMOVPEND".)
EndIf
*--------------------------------------------------------------

IF Val(C:3) > 0
    *- Movimiento por la Especie Subiendo el Cupon Nuevo
    ACT(mp1,val(y1))
    ACT(mp3,val(a:val(fi1)) )
    ACT(mp4,Val(b2) )

    ACT(mp5,Val(y:3) )
    ACT(mp6,'' )
    ACN(mp7,0 )

    IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
       ACT(mp6,Val(p:val(fi1)) )
       ACN(mp7,Val(q:val(fi1)))
    EndIf

    ACT(mp8 ,Val(d:val(fi1)))
    ACT(mp9 ,Dialogo.Vehiculo1)

    *- % IVA 
    ACT(mp11,Fstr(val(ci:2),0,2) )          
    ACT(mp12,'Corte de Cupon de '~val(mp4)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          

    *- mp15: Nro. Grupo 1 es el de las Acciones 
    ACN(mp15,1)
    ACT(mp19,Val(f:val(fi1)) )
    ACN(mp22,val(fi1)+100000 )
    ACT(mp27,FStr(Val(c3),0,0))

    If Val(m:val(fi1))=101 y [Val(t:val(fi1))<>0 o Val(u:val(fi1))<>0]
       *- Desdoblo el mov. de libre  disponibilidad por sus saldos originales
       If Val(t:val(fi1))<>0 
          *- Mov. por 101
          ACN(mp14,101)

          *- Importe
          ACN(mp10,Val(t:val(fi1)))
          ACN(MP:26, 0)

          (."IMMOVPEND".)
       EndIf
       If Val(u:val(fi1))<>0 
          *- Mov. por 207
          ACN(mp14,207)

          *- Importe
          ACN(mp10,Val(u:val(fi1)))
          ACN(MP:26, 0)

          (."IMMOVPEND".)
       Endif
    Else 
       *- No es necesario desdoblar
       *- NrSaldo
       ACN(mp14,Val(m:val(fi1)))

       *- Importe
       ACN(mp10,Val(g:val(fi1)))
       ACN(MP:26, 0)

       (."IMMOVPEND".)
    EndIf
ENDIF
*-------------------------------------------------------------------------------------
*- Movimiento por El Aumento del Cupon
ACT(mp1,val(y1))
ACT(mp3,val(a:val(fi1)) )
ACT(mp4,Val(b4) )

ACT(mp5,Val(y:3) )
ACT(mp6,'' )
ACN(mp7,0 )

IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
   ACT(mp6,Val(p:val(fi1)) )
   ACN(mp7,Val(q:val(fi1)))
EndIf

ACT(mp8 ,Val(d:val(fi1)) )
ACT(mp9 ,Dialogo.Vehiculo1)
ACN(mp10,  Val(g:val(fi1)) )

*- % IVA 
ACT(mp11,Fstr(val(ci:2),0,2) )          
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*ACT(mp12,'Corte de Cupon de '~val(mp4)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          
ACT(mp12,'Corte de Cupon de '~val(b2)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          

ACN(mp14,Val(m:val(fi1)))
  
*- mp15: Nro. Grupo 1 es el de las Acciones 
ACN(mp15,1)
ACT(mp19,Val(f:val(fi1)) )
ACT(mp29,Val(f:val(fi1))  )
ACN(mp22,val(fi1)+200000 )
ACT(mp27,Val(c:val(fi1)) )
ACN(MP:26, 0)

(."IMMOVPEND".)

*--------------------------------------------------------------
*- Si genera el pago automatico del cupon
If [val(jo1)=6 y Not Incluido(Fstr(val(m:val(fi1)),0,0),Val(dz6))]
   Message('*- Movimiento por Reverso del Cupon ')
   ACT(mp1,val(y2))
   ACD(mp2,val(fv2))
   ACT(mp3,val(a:val(fi1)) )
   ACT(mp4,Val(b4) )

   ACT(mp5,Val(y:3) )
   ACT(mp6,'' )
   ACN(mp7,0 )

   IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
      ACT(mp6,Val(p:val(fi1)) )
      ACN(mp7,Val(q:val(fi1)))
   EndIf

   ACT(mp8 ,Val(d:val(fi1)) )
   ACT(mp9 ,Dialogo.Vehiculo1)

   ACN(mp10,  - Val(g:val(fi1)) )

   *- % IVA 
   ACT(mp11,Fstr(val(ci:2),0,2) )          
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*   ACT(mp12,'Liquidacion de Cupon de '~val(mp4)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          
   ACT(mp12,'Liquidacion de Cupon de '~val(b2)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          

   ACN(mp14,Val(m:val(fi1)))
  
   *- mp15: Nro. Grupo 1 es el de las Acciones 
   ACN(mp15,1)
   ACT(mp19,Val(f:val(fi1)))
   ACT(mp29,Val(f:val(fi1))  )
   ACN(mp22,val(fi1))
   ACT(mp27,Val(c:val(fi1)) )
   ACN(MP:26, 0)

   (."IMMOVPEND".)


   Message('*- Genero el Movimiento del efectivo asociado a la transaccion LCUPON ')
   ACT(mp1,val(y2))
   ACT(mp3,val(a:val(fi1)) )
   ACT(mp4,Val(le:val(fi1)) )

   ACT(mp5,'')
   ACT(mp6,'' )
   ACN(mp7,0 )

   ACT(mp9 ,Dialogo.Vehiculo1)

   ACN(mp10,  Val(ld:val(fi1)) )

   *- % IVA 
   ACT(mp11,Fstr(val(ci:2),0,2) )          
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*   ACT(mp12,'Liquidacion de Cupon de '~val(mp4)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          
   ACT(mp12,'Liquidacion de Cupon de '~val(b2)~' Cup. '~Val(c:val(fi1))~' '~Val(mp50) )          

   *- mp15: Nro. Grupo 1 es el de las Acciones 
   ACN(mp15,1)
   ACT(mp19,Val(lb:val(fi1)))
   SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
   Recorrer SQL
       DFA
       ACT(mp8, fbn('Mercado'))
       ACT(TC:79, fbn('TipoCuenta'))
   Proximo
   IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(Y:3), 'PRE|PAS|PEN')
       ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
       ACN(mp14, 5)
   ELSE
       ACN(mp14, 1)
   ENDIF
   ACT(mp29,Val(f:val(fi1))  )
   ACN(mp22,val(fi1) + 100000  )
   ACT(mp27,'')
   ACN(MP:26, 0)

   (."IMMOVPEND".)

   *--------------------------------------------------------------
   Message('*- Movimiento por Comision Ya Bonificada')
   If Val(sa3)<>0   
      ACT(mp1,val(y2))
      ACT(mp3,val(a:val(fi1)) )
      ***ACT(mp4,Val(dz1))
      ACT(mp4,Val(le:val(fi1)))
      ***---09/03/06
***---      ACT(mp5,Val(y:3) )
      ACT(mp5, '')
      ACT(mp6,'' )
      ACN(mp7,0 )
      ACT(mp9 ,Dialogo.Vehiculo1)

      *- A Cantidad del Mov. va la comision bonificada
      ACN(mp10, Val(sa3)  )      
** FJL 12/07/23 - para que sea a pagar
      if Val(sa3)>0
        ACN(mp10, -Val(sa3))
      endif
      ACT(mp11,Fstr(val(ci:2),0,2) )
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*      ACT(mp12,'Comision Corte Cupon '~val(mp4)~' '~Val(mp50))          
      ACT(mp12,'Comision Corte Cupon '~val(b2)~' '~Val(mp50))          

      *- Comision de Renta 
      ACN(mp23,val(re1))

      *- Comision de Administracion 
      ACN(mp25,val(re2))

      *- mp20: En Nro. de grupo2 grabo la tenencia 
      *- mp15: Nro. Grupo 2 es el del Efectivo
      ACN(mp15,41)
      ***ACT(mp19,val(ch:1) )
      ACT(mp19,Val(lb:val(fi1)))

      SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
      Recorrer SQL
          DFA
          ACT(mp8, fbn('Mercado'))
          ACT(TC:79, fbn('TipoCuenta'))
      Proximo
      IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(Y:3), 'PRE|PAS|PEN')
          ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
          ACN(mp14, 4)
      ELSE
          ACN(mp14, 1)
      ENDIF
      ACN(mp22,val(fi1)+200000 )
      IF Val(SA:4) <> 0
          ***---Comision Bonificada
          ACN(MP:26, Val(SA:4))
      ELSE
          ACN(MP:26, 0)
      ENDIF


      (."IMMOVPEND".) 

      *-----------------------------------------
      Message('*- Movimiento por El Iva ')
      ACT(mp1,val(y2))
      ACT(mp3,val(a:val(fi1)) )
      ***ACT(mp4,Val(dz1))
      ACT(mp4,Val(le:val(fi1)) )
      ***---09/03/06
      ***---ACT(mp5,Val(y:3) )
      ACT(mp5, '')
      ACT(mp6,'' )
      ACN(mp7,0 )
      ACT(mp9 ,Dialogo.Vehiculo1)      
      
      *- Cantidad
      ACN(mp10,Val(ci:1) )
** FJL 12/07/23 - para que sea a pagar
      if Val(ci:1)>0
        ACN(mp10, -Val(ci:1))
      endif
      ACT(mp11,Fstr(val(ci:2),0,2) )
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*      ACT(mp12,'IVA Corte Cupon '~val(mp4)~' '~Val(mp50))          
      ACT(mp12,'IVA Comision Corte Cupon '~val(b2)~' '~Val(mp50))          
  
      *- mp15: Nro. Grupo 2 es el del Efectivo
      ACN(mp15,42)
      ***ACT(mp19,val(ch:1) )
      ACT(mp19,Val(lb:val(fi1)))
      SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
      Recorrer SQL
          DFA
          ACT(mp8, fbn('Mercado'))
          ACT(TC:79, fbn('TipoCuenta'))
      Proximo
      IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(Y:3), 'PRE|PAS|PEN')
          ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
          ACN(mp14, 4)
      ELSE
          ACN(mp14, 1)
      ENDIF
      ACN(mp22,val(fi1)+300000 )
      IF Val(SA:5) <> 0
          ***---IVA Comision Bonificada
          ACN(MP:26, Val(SA:5))
      ELSE
          ACN(MP:26, 0)
      ENDIF
      
      (."IMMOVPEND".) 

      *-----------------------------------------------------------------------
      If Round(val(re3),2)<>0
         Message('*- Movimiento por la Comision de CV')
         ACT(mp1,val(y2))
         ACT(mp3,val(a:val(fi1)) )
         ACT(mp4,Val(le:val(fi1)) )
         ***---09/03/06
         ***---ACT(mp5,Val(y:3) )
         ACT(mp5, '')
         ACT(mp6,'' )
         ACN(mp7,0 )
         ACT(mp9 ,Dialogo.Vehiculo1)
  
         *- A Cantidad del Mov. va la comision bonificada
         ACN(mp10,Val(re3))      
         ACT(mp11,Fstr(val(ci:12),0,2) )
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*         ACT(mp12,'Com. CV Corte Cupon '~val(mp4)~' '~Val(mp50))          
         ACT(mp12,'Com. CV Corte Cupon '~val(b2)~' '~Val(mp50))          

         *- Comision de Renta 
         ACN(mp23,val(re3))

         *- Comision de Amortizacion
         ACN(mp25,0)

         *- mp20: En Nro. de grupo2 grabo la tenencia 
         *- mp15: Nro. Grupo 2 es el del Efectivo
         ACN(mp15,51)
         ACT(mp19,Val(lb:val(fi1)))
         SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
         Recorrer SQL
             DFA
             ACT(mp8, fbn('Mercado'))
             ACT(TC:79, fbn('TipoCuenta'))
         Proximo
         IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(Y:3), 'PRE|PAS|PEN')
             ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
             ACN(mp14, 4)
         ELSE
             ACN(mp14, 1)
         ENDIF
         ACN(mp22,val(fi1)+400000 )
         ACN(MP:26, Val(mp10))


         (."IMMOVPEND".) 
      EndIf
      *-----------------------------------------
      If Round(val(ci:11),2)<>0
         Message('*- Movimiento por El Iva  de la Comision CV')
         ACT(mp1,val(y2))
         ACT(mp3,val(a:val(fi1)) )
         ACT(mp4,Val(le:val(fi1)) )
         ***---09/03/06
         ***---ACT(mp5,Val(y:3) )
         ACT(mp5, '')
         ACT(mp6,'' )
         ACN(mp7,0 )
         ACT(mp9 ,Dialogo.Vehiculo1)      
         * Cnatidad
         ACN(mp10,Val(ci:11) )
         ACT(mp11,Fstr(val(ci:12),0,2) )
** FJL 14/07/23 - para que ponga la especie que estoy cortando
*         ACT(mp12,'IVA CV Corte Cupon '~val(mp4)~' '~Val(mp50))          
         ACT(mp12,'IVA CV Corte Cupon '~val(b2)~' '~Val(mp50))          

         *- mp15: Nro. Grupo 2 es el del Efectivo
         ACN(mp15,52)
         ACT(mp19,Val(lb:val(fi1)))
         SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
         Recorrer SQL
             DFA
             ACT(mp8, fbn('Mercado'))
             ACT(TC:79, fbn('TipoCuenta'))
         Proximo
         IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(Y:3), 'PRE|PAS|PEN')
             ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
             ACN(mp14, 4)
         ELSE
             ACN(mp14, 1)
         ENDIF
         ACN(mp22,val(fi1)+500000 )
         ACN(MP:26, val(mp10))
      
         (."IMMOVPEND".)         
      EndIf
   EndIf
EndIf
*--------------------------------------------------------------
