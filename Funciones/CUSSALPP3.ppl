*- Por cada registro recupero el promedio ponderado de los saldos 
*- entre fecha 1 y fecha2 pp1: PPP de saldos
acn(pp1,0)

SQL.ADD("DECLARE @DESDE smalldatetime ")
SQL.ADD("DECLARE @HASTA smalldatetime ")
SQL.ADD("DECLARE @SUMA Float ")
SQL.ADD("DECLARE @SUMA2 Float ")
SQL.ADD("SELECT @DESDE = '"~IdxDate(Val(df1))~"' ")
SQL.ADD("SELECT @HASTA = '"~IdxDate(Val(df2))~"' ")
SQL.ADD("SELECT @SUMA = 0 ")
SQL.ADD("SELECT @SUMA2 = 0 ")
SQL.ADD("WHILE @DESDE <= @HASTA ")
SQL.ADD("   BEGIN ")
SQL.ADD("      SELECT @SUMA = (SELECT SUM(S.Saldo) ")
SQL.ADD("                      FROM "~DBO~".SALDOSDIA S ")
SQL.ADD("                      WHERE S.Cliente = '"~FBN['Cliente']~"' AND ")
SQL.ADD("                            S.Especie = '"~FBN['Especie']~"' AND ")
SQL.ADD("                            S.EnteCustodia = '"~FBN['EnteCustodia']~"' AND ")
SQL.ADD("                            S.Saldo <> 0 AND ")
SQL.ADD("                            S.Mercado = '"~FBN['Mercado']~"' AND ")
SQL.ADD("                            S.Cuenta = '"~FBN['Cuenta']~"' AND ")
SQL.ADD("                            S.NrSaldo = "~FStr(FBN['NrSaldo'],0,0)~" AND ")
*If NoVacio(FBN['Cupon'])
*   SQL.ADD("                            S.Cupon = "~FStr(FBN['Cupon'],0,0)~" AND ")
*Else
*   SQL.ADD("                            (S.Cupon Is Null or S.Cupon='') AND ")
*EndIf
SQL.ADD("                            S.Fecha = (SELECT MAX(Fecha) ")
SQL.ADD("                                       FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD("                                       WHERE S1.Cliente = S.Cliente AND ")
SQL.ADD("                                             S1.Especie = S.Especie AND ")
SQL.ADD("                                             S1.EnteCustodia = S.EnteCustodia AND ")
SQL.ADD("                                             S1.Mercado = S.Mercado AND ")
SQL.ADD("                                             S1.NrSaldo = S.NrSaldo AND ")
SQL.ADD("                                             S1.Cuenta = S.Cuenta AND ")
SQL.ADD("                                             ((S1.Cupon  = S.Cupon) or (((S.Cupon Is Null or S.Cupon='') and (S1.Cupon Is Null or S1.Cupon=''))))  AND ")
*If NoVacio(FBN['Cupon'])
*   SQL.ADD("                                          S1.Cupon  = S.Cupon  AND ")
*Else
*   SQL.ADD("                                          ((S.Cupon Is Null or S.Cupon='') and (S1.Cupon Is Null or S1.Cupon='')) AND ")
*EndIf
SQL.ADD("                                             S1.Fecha <= @DESDE)) ")
SQL.ADD("      IF @SUMA IS NULL ")
SQL.ADD("         BEGIN ")
SQL.ADD("            SELECT @SUMA = 0 ")
SQL.ADD("         END ")
SQL.ADD("      SELECT @SUMA2 = @SUMA2 + @SUMA ")
SQL.ADD("      SELECT @DESDE = @DESDE + 1 ")
SQL.ADD("   END ")
*SQL.ADD("SELECT @SUMA2 Suma, ")
SQL.ADD("SELECT @SUMA2 Suma ")

Recorrer SQL
   dfa
   ACN(pp1, FBN['Suma'])
