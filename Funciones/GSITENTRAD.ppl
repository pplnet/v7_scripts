SQL.ADD("Select CASE DeposDelComitente when '489'  Then Cliente1 ELSE  ")
SQL.ADD("       CASE DeposDelComitente when '0489' Then Cliente1 ELSE  ")
SQL.ADD("       CASE DeposDelComitente when '1125' Then Cliente1 ELSE 'BANCOR' END END END Cliente1,")
SQL.ADD("       O.Cliente1 as Cli, O.NrOperacion, ")
SQL.ADD("       CASE DeposDelComitente when '489'  Then Persona ELSE  ")
SQL.ADD("       CASE DeposDelComitente when '0489' Then Persona ELSE  ")
SQL.ADD("       CASE DeposDelComitente when '1125' Then Persona ELSE 'NO' END END END Persona, ")
SQL.ADD("       O.TipoOp, ")
SQL.ADD("       CASE DeposDelComitente when '489'  Then C.CodComitente ELSE ")
SQL.ADD("       CASE DeposDelComitente when '0489' Then C.CodComitente ELSE ")
SQL.ADD("       CASE DeposDelComitente when '1125' Then C.CodComitente ELSE '20' END END END CodComitente, ")
SQL.ADD("       O.Especie, O.ContraEspecie, O.FechaOp, O.FechaVto, ")
SQL.ADD("       O.Cantidad, O.TotalBrutoCli1 as CantT,  ")
SQL.ADD("       TipoEsp = CASE WHEN E.Tipo='PUB' THEN 1 ELSE 2 END  ")
SQL.ADD("  From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS B, ")
SQL.ADD("       "~DBO~".ESPECIES E,"~DBO~".CLIENTES C ")
SQL.ADD(" Where O.Vehiculo1   = '"~Dialogo.Vehiculo1~"' ") 
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD("   and O.NrOperacion = B.NrOperacion ")
SQL.ADD("   and B.NrBit = 30 ")
SQL.ADD("   and B.Valor = '0' ")
SQL.ADD("   and O.PaseCB = '0' ")
SQL.ADD("   and O.FechaVto >= "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   and O.FechaVto <= "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("   and O.Cliente1 = C.Codigo ")
SQL.ADD("   and O.Especie  = E.Codigo ")
SQL.ADD("   and O.TipoOp In ('TIV','TIC') ")
SQL.ADD("   and C.Sector  not in ('PPR','PNA','PMA','PNA','MDC') ")
SQL.ADD("   Order by O.TipoOp, O.FechaOp, O.FechaVto, O.Especie ")

ACT(tw1,'Compras')
ACN(tx1,1)
ACT(tw2,'Ventas')
ACN(tx2,1)
ACT(tw3,'Trading')
ACN(tx3,0)

ACT(ta1,'Cliente')
ACT(tb1,'Cli Orig')
ACT(tc1,'Nro Operacion')
ACT(td1,'Persona')
ACT(te1,'Tipo Op')
ACT(tf1,'Comitente')
ACT(tg1,'Especie')
ACT(th1,'Contra Especie')
ACT(ti1,'Fecha Op')
ACT(tj1,'Fecha Vto')
ACT(tk1,'Cantidad')
ACT(tl1,'Cant Trade')
ACT(tm1,'TIpo Esp')
ACT(tn1,'Procesado')

ACT(ua1,'Cliente')
ACT(ub1,'Cli Orig')
ACT(uc1,'Nro Operacion')
ACT(ud1,'Persona')
ACT(ue1,'Tipo Op')
ACT(uf1,'Comitente')
ACT(ug1,'Especie')
ACT(uh1,'Contra Especie')
ACT(ui1,'Fecha Op')
ACT(uj1,'Fecha Vto')
ACT(uk1,'Cantidad')
ACT(ul1,'Cant Trade')
ACT(um1,'TIpo Esp')
ACT(un1,'Procesado')

Recorrer SQL
if EqStr(FBN['TipoOp'],'TIC')
   SCN(tx1,1)
   ACT(ta:val(tx1),FBN['Cliente1'])
   ACT(tb:val(tx1),FBN['Cli'])
   ACT(tc:val(tx1),FBN['NrOperacion'])
   ACT(td:val(tx1),FBN['Persona'])
   ACT(te:val(tx1),FBN['TipoOp'])
   ACT(tf:val(tx1),FBN['CodComitente'])
   ACT(tg:val(tx1),FBN['Especie'])
   ACT(th:val(tx1),FBN['ContraEspecie'])
   ACD(ti:val(tx1),FBN['FechaOp'])
   ACD(tj:val(tx1),FBN['FechaVto'])
   ACN(tk:val(tx1),FBN['Cantidad'])
   ACN(tl:val(tx1),FBN['CantT'])
   ACN(tm:val(tx1),FBN['TipoEsp'])
   ACT(tn:val(tx1),'NO')
Else
   SCN(tx2,1)
   ACT(ua:val(tx2),FBN['Cliente1'])
   ACT(ub:val(tx2),FBN['Cli'])
   ACT(uc:val(tx2),FBN['NrOperacion'])
   ACT(ud:val(tx2),FBN['Persona'])
   ACT(ue:val(tx2),FBN['TipoOp'])
   ACT(uf:val(tx2),FBN['CodComitente'])
   ACT(ug:val(tx2),FBN['Especie'])
   ACT(uh:val(tx2),FBN['ContraEspecie'])
   ACD(ui:val(tx2),FBN['FechaOp'])
   ACD(uj:val(tx2),FBN['FechaVto'])
   ACN(uk:val(tx2),FBN['Cantidad'])
   ACN(ul:val(tx2),FBN['CantT'])
   ACN(um:val(tx2),FBN['TipoEsp'])
   ACT(un:val(tx2),'NO')
Endif
Proximo


** Compras con Ventas
Recorrer&i 2,Val(tx1)
   Recorrer&j 2,Val(tx2)
     if EqStr(val(un:&j),'NO')
        If EqStr(Val(tg:&i),Val(ug:&j)) y EqStr(Val(ti:&i),Val(ui:&j)) y EqStr(Val(tj:&i),Val(uj:&j)) y EqStr(Val(tk:&i),Val(uk:&j))
           SCN(tx3,1)
           ACT(a:val(tx3),Val(ta:&i))
           ACT(b:val(tx3),Val(tb:&i))
           ACT(c:val(tx3),Val(tc:&i))
           ACT(d:val(tx3),Val(td:&i))
           ACT(e:val(tx3),iif(EqStr(Val(tb:&i),'BANCOR'),'TIC','TIV'))
           ACT(f:val(tx3),Val(tf:&i))
           ACT(g:val(tx3),Val(tg:&i))
           ACT(h:val(tx3),Val(th:&i))
           ACD(i:val(tx3),Val(ti:&i))
           ACD(j:val(tx3),Val(tj:&i))
           ACN(k:val(tx3),Val(tk:&i))
           ACN(l:val(tx3),Val(tl:&i))
           ACN(m:val(tx3),Val(tm:&i))
           ACT(tn:&i,'SI')

           SCN(tx3,1)           
           ACT(a:val(tx3),Val(ua:&j))
           ACT(b:val(tx3),Val(ub:&j))
           ACT(c:val(tx3),Val(uc:&j))
           ACT(d:val(tx3),Val(ud:&j))
           ACT(e:val(tx3),iif(EqStr(Val(ub:&j),'BANCOR'),'TIV','TIC'))
           ACT(f:val(tx3),Val(uf:&j))
           ACT(g:val(tx3),Val(ug:&j))
           ACT(h:val(tx3),Val(uh:&j))
           ACD(i:val(tx3),Val(ui:&j))
           ACD(j:val(tx3),Val(uj:&j))
           ACN(k:val(tx3),Val(uk:&j))
           ACN(l:val(tx3),Val(ul:&j))
           ACN(m:val(tx3),Val(um:&j))
           ACT(un:&j,'SI')           
        Endif
     Endif
   Proximo
Proximo

** ventas con Compras
Recorrer&i 2,Val(tx2)
 if EqStr(val(un:&i),'NO')
   Recorrer&j 2,Val(tx1)
     if EqStr(val(tn:&j),'NO')
        If EqStr(Val(tg:&j),Val(ug:&i)) y EqStr(Val(ti:&j),Val(ui:&i)) y EqStr(Val(tj:&j),Val(uj:&i)) y EqStr(Val(tk:&j),Val(uk:&i))
           SCN(tx3,1)
           ACT(a:val(tx3),Val(ta:&j))
           ACT(b:val(tx3),Val(tb:&j))
           ACT(c:val(tx3),Val(tc:&j))
           ACT(d:val(tx3),Val(td:&j))
           ACT(e:val(tx3),iif(EqStr(Val(tb:&j),'BANCOR'),'TIC','TIV'))
           ACT(f:val(tx3),Val(tf:&j))
           ACT(g:val(tx3),Val(tg:&j))
           ACT(h:val(tx3),Val(th:&j))
           ACD(i:val(tx3),Val(ti:&j))
           ACD(j:val(tx3),Val(tj:&j))
           ACN(k:val(tx3),Val(tk:&j))
           ACN(l:val(tx3),Val(tl:&j))
           ACN(m:val(tx3),Val(tm:&j))
           ACT(tn:&j,'SI')           
           SCN(tx3,1)
           ACT(a:val(tx3),Val(ua:&i))
           ACT(b:val(tx3),Val(ub:&i))
           ACT(c:val(tx3),Val(uc:&i))
           ACT(d:val(tx3),Val(ud:&i))
           ACT(e:val(tx3),iif(EqStr(Val(ub:&i),'BANCOR'),'TIV','TIC'))
           ACT(f:val(tx3),Val(uf:&i))
           ACT(g:val(tx3),Val(ug:&i))
           ACT(h:val(tx3),Val(uh:&i))
           ACD(i:val(tx3),Val(ui:&i))
           ACD(j:val(tx3),Val(uj:&i))
           ACN(k:val(tx3),Val(uk:&i))
           ACN(l:val(tx3),Val(ul:&i))
           ACN(m:val(tx3),Val(um:&i))
           ACT(un:&i,'SI')           
        Endif
     Endif
   Proximo
 Endif
Proximo

SQL.ADD(" Delete "~DBO~".SITERTRADE ")
SQL.NEW
SQL.EXEC

Recorrer&k 1,Val(tx3)

SQL.ADD("INSERT INTO "~DBO~".SITERTRADE (")
SQL.ADD("Cliente,NrOperacion,Persona,")
SQL.ADD("TipoOp,CodComitente,Especie,")
SQL.ADD("ContraEspecie,FechaOp,FechaVto,")      
SQL.ADD("Cantidad,TipoEsp,Cliente1")
SQL.ADD(") Values (")
SQL.ADD(" '"~val(a:&k)~"','"~val(c:&k)~"','"~val(d:&k)~"',")
SQL.ADD(" '"~val(e:&k)~"', '"~val(f:&k)~"','"~val(g:&k)~"', ")
SQL.ADD(" '"~val(h:&k)~"', '"~IdxDate(val(i:&k))~"','"~IdxDate(val(j:&k))~"',")
SQL.ADD(" "~Fstr(val(l:&k),0,2)~","~Fstr(val(m:&k),0,0)~",'"~val(b:&k)~"' ")
SQL.ADD(" )")
SQL.NEW
SQL.EXEC
Proximo

