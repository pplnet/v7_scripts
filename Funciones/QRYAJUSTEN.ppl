SQL.ADD("SELECT M.NrOperacion, M.Cliente, M.FechaMov as FechaOp, Sum(M.Cantidad) as Cantidad, ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3 as FechaMov, T2.Fecha3 as FechaVto, M.Leyenda,        ")
SQL.ADD(" T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1 as CantOpe, M.Cuenta, M.Mercado ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVEJECUTADOS M WITH (NOLOCK),     ")
SQL.ADD("       "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                ") 
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.Cliente  = C.Codigo                                                 ")
SQL.ADD(" AND   M.Especie  = E.Codigo                                                 ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.Add(" AND   M.Cuenta  IN ("~val(li1)~")                                           ")
SQL.ADD(" Group  by                                                                   ")
SQL.ADD(" M.NrOperacion, M.Cliente, M.FechaMov,                                       ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3 , T2.Fecha3, M.Leyenda,                    ")
SQL.ADD(" T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1, M.Cuenta, M.Mercado      ")
SQL.ADD(" UNION                                                                       ")
SQL.ADD("SELECT M.NrOperacion, M.Cliente, M.FechaMov as FechaOp, Sum(M.Cantidad) as Cantidad, ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3 as FechaMov, T2.Fecha3 as FechaVto, M.Leyenda,        ")
SQL.ADD(" T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1 as CantOpe, M.Cuenta, M.Mercado ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVPENDIENTES M WITH (NOLOCK),     ")
SQL.ADD("       "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                ") 
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.ADD(" AND   M.Cliente  = C.Codigo                                                 ")
SQL.ADD(" AND   M.Especie  = E.Codigo                                                 ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.Add(" AND   M.Cuenta IN ("~val(li1)~")                                            ")
SQL.ADD(" Group  by                                                                   ")
SQL.ADD(" M.NrOperacion, M.Cliente, M.FechaMov,                                       ")
SQL.ADD(" T2.TipoTr2, T2.Fecha3, T2.Fecha3, M.Leyenda,                                ")
SQL.ADD(" T2.Especie, C.RazonSocial, E.Nombre, T2.Cantidad1, M.Cuenta, M.Mercado      ")