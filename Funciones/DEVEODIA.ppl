* DCREODIA - Calculo de Cant. Dias en Que se Ejercio el Barrier Option Diaria y su precio promedio
* Parametros Entrada: aa1: Fecha1, aa2: Fecha2, aa3: Fuente Referencia, aa4: Especie

act(z8,FBN['MB1'])
acn(z9,FBN['PrecioEj'])
act(z10,FBN['MB3'])
acn(z11,FBN['PrecioMer'])
acn(z12,FBN['TipoCambio2'])
acn(z13,FBN['TipoCambio3'])
act(z14,FBN['MB4'])
act(z15,FBN['CB8'])
act(aa3,FBN['PrecioRef'])
  
Message("Calculando Resultado Opcion Diaria "~val(aa3)~" "~VAL(aa1)~"' al "~VAL(aa2))
  
SQL.ADD("SELECT * FROM "~DBO~".CURVAFUTUROSCOMM Where Especie='"~VAL(aa4)~"' and ")
SQL.ADD("Fecha>='"~IdxDate(VAL(aa1))~"' and Fecha<='"~IdxDate(VAL(aa2))~"' Order By Fecha")

ACN(ab1,0)
ACN(ab2,0)
ACN(ab3,0)

Recorrer SQL
   dfa
   *- Por Cada precio verifico si cumple las condiciones 
   *-  
   IF Not Incluido(VAL(aa3),VAR('PRECOMMFUT')) y FBN['PrecioCon']<>0 
      ACN(ab3,FBN['PrecioCon'])
   Else 
      ACN(ab3,FBN['PrecioFut'])
   EndIf

   *- [Precio Real>=Precio Ejercicio y Call] o [Precio Real<=Precio Ejercicio y Put]
   IF [EqStr(val(z8),'0') y val(ab3)>=val(z9)] o [EqStr(val(z8),'1') y val(ab3)<=val(z9) ]  

      *- Si es Barrier Chequeo las Barreras
      If Incluido(val(t2),'DPBOD')
         ***--- Chequeo las barreras 
         IF EqStr(val(z8),'0')
            *---- CALL
            IF Eqstr(val(z14),'3')
               *-- Down&Out -> PrecioReal >=Knock
               IF val(ab3)>=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)
               ENDIF
            ENDIF
            IF Eqstr(val(z14),'2')
               *-- Down&In -> PrecioReal<=Knock
               IF val(ab3)<=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)
               ENDIF
            ENDIF
            IF Eqstr(val(z14),'1')
               *-- Up&Out -> PrecioReal <=Knock
               IF val(ab3)<=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)                  
               ENDIF
            ENDIF
            IF Eqstr(val(z14),'0')
               *-- Up&In -> PrecioReal >=Knock
               IF val(ab3)>=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)                  
               ENDIF
            ENDIF
         ELSE 
            *---- PUT
            IF Eqstr(val(z14),'3')
               *-- Down&Out -> PrecioReal >=Knock
               IF val(ab3)>=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)                  
               ENDIF
            ENDIF
            IF Eqstr(val(z14),'2')
               *-- Down&In -> PrecioReal<=Knock
               IF val(ab3)<=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)                  
               ENDIF
            ENDIF
            IF Eqstr(val(z14),'1')
               *-- Up&Out -> PrecioReal <=Knock
               IF val(ab3)<=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)                  
               ENDIF
            ENDIF
            IF Eqstr(val(z14),'0')
               *-- Up&In -> PrecioReal >=Knock
               IF val(ab3)>=val(z12)
                  SCN(ab1,val(ab3))
                  SCN(ab2,1)                  
               ENDIF
            ENDIF
         ENDIF
      Else 
         SCN(ab1,val(ab3))
         SCN(ab2,1)
      EndIf
   EndIf
Proximo 
Message(' Suma de Precios '~fstr(VAL(ab1),0,3))
Message(' Dias Ejercicio '~fstr(VAL(ab2),0,3))
ACN(j:fac,Round(VAL(ab1)/VAL(ab2),3))
