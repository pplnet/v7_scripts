ACT(a:1, Dialogo.Book1)
ACT(a:2, Dialogo.Book2)
ACN(b:1, Query("Select Count(*) from "~DBO~".MODELOSNEGOCIO where BOOKS Like '%"~Dialogo.Book1~"%' "))
ACN(b:2, Query("Select Count(*) from "~DBO~".MODELOSNEGOCIO where BOOKS Like '%"~Dialogo.Book2~"%' "))
if Val(b:1)=0
*  SCN(x:1,1)
*  MessageBox('El book '~Dialogo.Book1~' no esta incluido en ningun Modelo de Negocio')
endif
if Val(b:1)>1
  SCN(x:1,1)
  MessageBox('El book '~Dialogo.Book1~' esta incluido en mas de un Modelo de Negocio')
endif
if Val(b:2)=0
*  SCN(x:1,1)
*  MessageBox('El book '~Dialogo.Book2~' no esta incluido en ningun Modelo de Negocio')
endif
if Val(b:2)>1
  SCN(x:1,1)
  MessageBox('El book '~Dialogo.Book2~' esta incluido en mas de un Modelo de Negocio')
endif

if Val(x:1)>0
  if Dialogo.Check1=1
    Cancelar('Evento Cancelado')
  endif
endif

if Val(b:1)=1
  * El book origen tiene Modelo
  SQL.ADD("Select * from "~DBO~".MODELOSNEGOCIO where BOOKS Like '%"~Dialogo.Book1~"%' ")
  recorrer SQL
    DFA
    ACT(c:1, fbn('Codigo'))
    ACT(d:1, fbn('ValuaCarteraPartida'))
    ACT(e:1, fbn('ValuaORICartera'))
  proximo
else
  * El book origen no tiene Modelo
  ACT(c:1, 'Sin Modelo')
  ACT(d:1, 'NO')
  ACT(e:1, 'NO')
endif
if EqStr(Val(d:1),'SI')
  SCN(x:2,1)
  MessageBox('El Modelo de Negocio '~Val(c:1)~' correspondiente al book '~Dialogo.Book1~' tiene la marca de Valua Cartera por Partida.')
endif
if EqStr(Val(e:1),'SI')
  SCN(x:2,1)
  MessageBox('El Modelo de Negocio '~Val(c:1)~' correspondiente al book '~Dialogo.Book1~' tiene la marca de Valua ORI Cartera.')
endif

if Val(b:2)=1
  * El book destino tiene Modelo
  SQL.ADD("Select * from "~DBO~".MODELOSNEGOCIO where BOOKS Like '%"~Dialogo.Book2~"%' ")
  recorrer SQL
    DFA
    ACT(c:2, fbn('Codigo'))
    ACT(d:2, fbn('ValuaCarteraPartida'))
    ACT(e:2, fbn('ValuaORICartera'))
  proximo
else
  * El book destino no tiene Modelo
  ACT(c:2, 'Sin Modelo')
  ACT(d:2, 'NO')
  ACT(e:2, 'NO')
endif
if EqStr(Val(d:2),'SI')
  SCN(x:2,1)
  MessageBox('El Modelo de Negocio '~Val(c:2)~' correspondiente al book '~Dialogo.Book2~' tiene la marca de Valua Cartera por Partida.')
endif
if EqStr(Val(e:2),'SI')
  SCN(x:2,1)
  MessageBox('El Modelo de Negocio '~Val(c:2)~' correspondiente al book '~Dialogo.Book2~' tiene la marca de Valua ORI Cartera.')
endif