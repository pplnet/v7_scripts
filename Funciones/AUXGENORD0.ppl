         ** AUXGENORD0
         ***** Cantidad
         ACN(t:11, fbn('Cantidad'))
         if Val(t:11)=0
            SCN(z:1,1)
            **messagebox('Cantidad')
            ACN((26+FAC):11, 1)
         endif
         ***** PrecioMAE
         ACN(t:13, fbn('Precio'))
         ** Generar Operacion TIC/TIV
         ***** Precio3 / Precio4 / Precio1
         if Eqstr(Val(t:10),'CLE')
            ACN(t:14, Val(t:13))
         else
            ACN(t:15, Val(t:13))
         endif
         ** genera/actualiza Operacion y Ejecuciones
         ACT(t:5, fbn('AgenteContra'))
         if EqStr(fbn('Agente'),Val(v:5))
            ACT(t:50,Copy(fbn('NroOrdenVendedor'),7,5))
            ACT(t:5, fbn('AgenteContra'))
         else
            if EqStr(fbn('AgenteContra'),Val(v:5))
               ACT(t:5, fbn('Agente'))
            endif
         endif
         ***** Especie
         ACT(t:27, fbn('CodigoTitulo'))
         ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
         if Vacio(Val(t:3))
            * Marca Incompleto
            ACN(t:44, 1)
            ACN(es:1, 1)
            ACN((26+FAC):3, 1)
** FJL 25/06/24 - Issue BACS 7389 - Dar de alta la Especie con el cupon que se recibe del MAE
*            EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Check1=Dialogo.Check1)
            EjecutarEvento('ALTESP', String1=fbn('CodigoTitulo'),String2=fbn('Mnemotecnico'),Entero1=Num(fbn('Nrocupon')),Check1=Dialogo.Check1)
            ACT(t:3, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))
         else
            ACT(es:2, SQL("Select Status From "~DBO~".ESPECIES Where CodMAEContado='"~Val(t:27)~"' "))      
            if Eqstr(Val(es:2),'DES')
               ACN(es:1,1)
            Endif
         endif
         ***** Cupon MAE
         ACT(t:4, fbn('NroCupon'))
         if EqStr(fbn('CodigoRueda'),'MAE1')
            ACN(t:34, 1)
         endif
         
         ***** Cliente
         ACN(t:6, Num(Val(t:5)))
         ***** Cliente Tabla
         if EqStr(fbn('CodigoRegistro'),'7020')
            ACT(t:7, fbn('Cliente'))
         Else
         If [Incluido(fbn('CodigoRegistro'),'0205|0105') y EqStr(fbn('EnteLiquidador'),'G') y Vacio(fbn('ComitenteComprador')) y Vacio(fbn('ComitenteVendedor'))] y  (EqStr(fbn('TipoOpOrigen'),'5') o EqStr(fbn('TipoOpDestino'),'5'))
            ** Cartera Propia
            ***** Codigo Cliente
            ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(v:5)~"' "))
            ACT(t:54,Val(t:8))
            **messagebox('Cartera propia '~Val(T:54))
            ***** Operador Contra
            ACT(t:9, fbn('OperadorContra'))
            *messagebox('Ok cartera propia '~Val(t:8)~' '~Val(T:53)~' '~Val(t:9))
         Else   
            If Incluido(fbn('CodigoRegistro'),'0205|0105') y EqStr(fbn('EnteLiquidador'),'G') y [No Vacio(fbn('ComitenteComprador')) o No Vacio(fbn('ComitenteVendedor'))]
               * Agente=0  o Agente=Vehiculo
               if NoVacio(fbn('ComitenteComprador'))
                  ACT(t:61, fbn('ComitenteComprador'))
               else
                  ACT(t:61, fbn('ComitenteVendedor'))
               endif
               ACN(t:62, Longitud(Val(t:61)))
               if Val(t:62)>1
                  ACT(t:63, Copy(Val(t:61),1,2))
                  if EqStr(Val(t:63),'*C')
                     * es CUIT
                     if Val(t:62)>2
                        if Val(t:62)>13
                           ACT(t:64, Copy(Val(t:61),3,11))
                        else
                           ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                        endif
                        ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CUIT = '"~Val(t:64)~"' "))
                     endif
                  endif
                  if Incluido(Val(t:63),'*F|*S')
                    * es Fondo o Seguros
                    * FJL 23/08/21 - Issue 5092 - Cambio criterio FCI
*                    ACT(t:64, Copy(Val(t:61),2,Val(t:62)-1))
*                    if EqStr(Val(t:63),'*F')
*                       ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='FON' "))
*                    endif
*                    if EqStr(Val(t:63),'*S')
*                       ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where Alias10 = '"~Val(t:64)~"' and CategDepositante='CSE' "))
*                    endif
                    ACT(t:64, Copy(Val(t:61),3,Val(t:62)-2))
                    if EqStr(Val(t:63),'*F')
                      ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='FON' "))
                    endif
                    if EqStr(Val(t:63),'*S')
                      ACT(t:65, SQL("Select Codigo From "~DBO~".CLIENTES Where CodigoCNV = "~FStr(Num(Val(t:64)),1,0)~" and CodigoCNV>0 and CategDepositante='CSE' "))
                    endif
                  endif
                  if NoVacio(Val(t:65))
                     ACT(t:8, Val(t:65))
                     ACT(t:54,Val(t:8))
                     **messagebox('No cartera Propia '~Val(T:54))
                  endif
               endif  
               if EqStr(Val(t:5),'000') y Incluido(fbn('TipoOpDestino'),'2|4|6|7')
                  * Agente=0  y FCI/AFJP
                  ACN((26+FAC):8, 2)
               else
                  if Val(t:34)=1
                     * MAE1
                     ACN((26+FAC):8, 3)
                  else
                     ACN((26+FAC):8, 1)
                  endif
               endif
            else
               ***** Codigo MAE Cliente
               **ACT(t:53, Val(t:5))
               ***** Codigo Cliente
               ACT(t:8, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:5)~"' "))
               ACT(t:54,Val(t:8))
               **messagebox('Codigo MAE Cliente '~Val(T:54))
               ***** Operador Contra
               ACT(t:9, fbn('OperadorContra'))
               ** ver si es OTIC/OTIV
               ** if Vacio(Val(t:8)) y Not EqStr(Val(t:2),'TCOPRI')
               if Vacio(Val(t:8))
                  ACN(cl:1,1)
                  ACT(t:40, 'Cliente no existente en FPA. Nr MAE : '~Val(t:5))
               endif
            endif
         Endif         
         Endif
        ** messagebox(Val(t:54)~' '~fbn('CodigoRueda')~' '~Var('RUECPC1'))
         if  Eqstr(Val(t:54),Var('VEHICULO'))    
             ACN(t:55,1)
         Else
             ACN(t:55,0)   
         Endif

         ** Cta y Ord 3ros    
         if Incluido(fbn('CodigoRueda'),Var('RUECPC1')) y Not Eqstr(Val(t:54),Var('VEHICULO'))    
            ACT(t:73,'1')
         Else   
            ACT(t:73,'0')
         Endif
        
         **Mercado Especie y Mercado Contraespecie Orden desde SIOPEL
         if Not EqStr(fbn('CodigoRegistro'),'7020')
            ***** Mercado4
            ACT(t:31, Var('AMBMAE'))
            ***** Especie T:3/ Mercado T:22
            *ACT(t:22, MercadoDef(Val(t:3)))
            ACT(t:22, Var('MERLIQCPC1'))
            ***** ContraEspecie T:12 / Mercado2 T:52
            #ifdef MLASA
                   if EqStr(fbn('Moneda'),'D')
                      ACT(t:12, 'USD')
                      ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
                   else
                      if EqStr(fbn('Moneda'),'$')
                         ACT(t:12, 'ARP')
                         ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),VAR('MERCBCRA')))
                      else
                         * SCN(z:1,1)
                         * Marca Incompleto
                         **ACN(t:44, 1)
                         ACN((26+FAC):12, 1) 
                      endif
                   endif
            #else
                   if EqStr(fbn('Moneda'),'D')
                      ACT(t:12, 'USD')
                      ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),MercadoDef(Val(t:12))))
                   else
                      if EqStr(fbn('Moneda'),'$')
                         ACT(t:12, 'ARP')
                         ACT(t:52, iif(Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',Val(t:8)),'CLI'),VAR('MERCADOBT'),MercadoDef(Val(t:12))))
                      else
                         * SCN(z:1,1)
                         * Marca Incompleto
                         **ACN(t:44, 1)
                         ACN((26+FAC):12, 1) 
                      endif
                   endif
                   
            #endif
         Endif

         ***** InteresesMAE
         ACN(t:16, fbn('Interes'))
         ***** Es ZeroCupon
         ACT(t:58, BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Val(t:3)))
         ***** Nro Cupon
         if EqStr(Val(t:58),'SI')    
            ACT(t:17, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:3)),1,0))
         else
            ACT(t:17, Val(t:4))
         endif
         ***** Fecha Op
         if EqStr(Copy(fbn('CodigoRegistro'),3,2),'05') o (EqStr(fbn('CodigoRegistro'),'7020') y EqStr(Copy(fbn('CodRegContestado'),3,2),'05'))
            ACT(t:18, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa'))
            ACD(t:19, Fecha(Val(t:18)))
         else
            SCN(z:1,1)
            **messagebox('fecha Op')
            ACN((26+FAC):19, 1)
         endif
    
         ***** Mercado
         ** AA se omite. solo se realiza por Merdadodef
         if NO
         if Not EqStr(fbn('CodigoRegistro'),'7020')
            if Incluido(fbn('CodigoRueda'),Var('RUECPC1')) 
               ACT(t:22, 'CV')
               ACT(t:52, 'BCRA')
            Else
               if Incluido(fbn('EnteLiquidador'),'1|D|T|B')
                  ACT(t:22, 'AC')
                  ACT(t:52, 'AC')
               else
                  if EqStr(fbn('EnteLiquidador'),'2')
                     ACT(t:22, 'CRYL')
                     ACT(t:52, 'BCRA')
                  else
                     if EqStr(fbn('EnteLiquidador'),'3')
                        ACT(t:22, 'CE')
                        ACT(t:52, 'CE')
                     else
                        if EqStr(fbn('EnteLiquidador'),'4')
                           ACT(t:22, 'EU')
                           ACT(t:52, 'EU')
                        else
                           if Incluido(fbn('EnteLiquidador'),'5|6|8|9')
                              ACT(t:22, 'CV')
                           else
                              if Incluido(fbn('EnteLiquidador'),'G|F|W|U')
                                 ACT(t:22, 'MC')
                                 ACT(t:52, 'MC')
                              else
                                 *SCN(z:1,1)
                                 * Marca Incompleto
                                 **box('Ente liquidador')
                                 **ACN(t:44, 1)
                                 ACN((26+FAC):22, 1)
                              endif
                           endif
                        endif
                     endif
                  endif
               endif
            Endif
         Endif
**  Endif de IF NO
         ENDIF
         
         ***** FormaLiquidacion
         if EqStr(fbn('TipoLiquidacion'),'2')
            ACN(t:23, 0)
         else
            if EqStr(fbn('TipoLiquidacion'),'1')
               ACN(t:23, 1)
            else
               if EqStr(fbn('TipoLiquidacion'),'6')
                  ACN(t:23, 2)
               else
*                 SCN(z:1,1)
                  * Marca Incompleto
                  **messagebox('Forma liquidacion')
                  **ACN(t:44, 1)
                  ACN((26+FAC):23, 1)
               endif
            endif
         endif
         ** AA 05-05-2022 Se incorpora mercado variable FormaLiquidacion1 y FormaLiquidacion2
         **IF Incluido(Val(T:22), VAR('MERCAACMC'))         
         IF Incluido(Val(T:22), VAR('MERCAVARI'))
         ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
            ACN(T:23, 1)
            ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
            ACN(U:23, 1)
         Else
            ***** FormaLiquidacion1 (STD|DVP|RVP) = DVP
            ACN(T:23, 1)
            ***** FormaLiquidacion2 (FD&&P|DVP|FOP) = DVP
            ACN(U:23, 1)         
         ENDIF
         ***** Operador / OperadorContra
         if Incluido(Val(t:2),'TIV')
            ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('Operador')))
            ACT(t:26, fbn('OperadorContra'))
         else
            ACT(t:25, BuscarCampo('USUARIOS','Codigo','NroSIOPEL',fbn('OperadorContra')))
            ACT(t:26, fbn('Operador'))
         endif
         if Vacio(Val(t:25))
            ACT(t:25, UsuarioActivo)
         endif
         ACT(t:47, BuscarCampo('USUARIOS','Alias3','Codigo',val(t:25)))

         ***** Vehiculo1
         ACT(t:29, Var('VEHICULODE'))

         *** ContraEspecie2 Moneda de Liquidacion ****
         If Eqstr(Val(t:12),VAR('MONELOCA'))
            ACT(T:46,Val(t:12))
         Else
            ACT(t:46, BuscarCampo('ESPECIES','Alias10','Codigo',val(t:12)))
         Endif
         if EqStr(Val(t:12),'USD')
            if Incluido(Val(t:22),VAR('MERCAACMC'))
               ACT(t:46, 'USD')
               if EqStr(fbn('EnteLiquidador'),'B')
                  ACT(t:46, 'USB')
               endif
            endif
            if EqStr(Val(t:22),'CRYL')
               ACT(t:46, 'USB')
            endif
            if EqStr(Val(t:22),'CV')
               ACT(t:46, 'USB')
            endif
            if EqStr(Val(t:22),'EU')
               if EqStr(fbn('TipoOpDestino'),'5') 
                  ACT(t:46, 'USD')
               else
                  ACT(t:46, 'USD')
               endif
            endif
         endif
         ***** Tabla Feriados
         if Incluido(fbn('EnteLiquidador'),'D|3|4|6|9')
            ACT(t:24, 'USA')
         endif
         if Incluido(fbn('EnteLiquidador'),'1|2|5|8|B')
            ACT(t:24, 'ARG')
         endif
         if Incluido(Val(t:22),VAR('MERCAACMC'))
            if Incluido(Val(t:46),'ARP|USB')
               ACT(t:24, 'ARG')
            endif
            if EqStr(Val(t:46),'USD')
               ACT(t:24, 'USA')
            endif
         endif
        if Vacio(Val(t:24))
           * SCN(z:1,1)
           * Marca Incompleto
           *messagebox('feriados')
           **ACN(t:44, 1)
           ACN((26+FAC):24, 1)
        endif

        ***** RB5
        ACT(t:20, Fstr(Num(fbn('Plazo')),1,0))

        ***** Plazo / Lote
        ACN(t:21, Num(fbn('Plazo'))*24)

        ***** FechaVto
        ACD(t:45, Habiles(Val(t:19),Num(fbn('Plazo')),Val(t:24)))

        ***** UDN1
        ACT(t:30, 'MD')
        ***** Rueda 
        ACT(t:32, fbn('CodigoRueda'))
        ***** PaseCB
        ACT(t:33, '0')
        ***** MAE1
        if Val(t:34)=1
           ***** Datos MAE1
           ACT(t:36, fbn('Referencia'))
           ACN(t:37, Num(Val(t:36)))
           if Val(t:37)=0
              ACN(t:35, 0)
              ACN(t:38, 1)
           else
              if EqStr(fbn('TipoOpOrigen'),'1')
                 ** Terceros
                 ACN(t:35, 0)
              else
                 ACN(t:35, 1)
              endif
           endif
           if EqStr(fbn('TipoOpDestino'),'5')
              * Agente
              ACN(t:39, 0)
           else
              if Incluido(fbn('TipoOpDestino'),'2|4|6|7')
                 if EqStr(fbn('TipoOpDestino'),'2')
                    * FCI
                    ACN(t:39, 1)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'4')
                    * AFJP Fondo
                    ACN(t:39, 2)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'6')
                    * AFJP Encaje
                    ACN(t:39, 3)
                 endif
                 if EqStr(fbn('TipoOpDestino'),'7')
                    * AFJP Adminis (Cartera Propia)
                    ACN(t:39, 4)
                 endif
              endif
           endif
        endif

        if DesciendeDeEspecie(Val(t:3),'LETES')
           *** cupones de Letes no se graban ( = 1 si Especie es Letes, 0 si no)
           ACN(x:2, 1)
        else
           ACN(x:2, 0)
        endif 

        * Cliente definitivo a la Operacion
        ACT(t:56, Val(t:54))
        if Vacio(Val(t:56)) y Val(t:34)=1
           * Vacio Cliente y MAE1
           ACN(t:41, SQL("Select 4 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
        else
           ACN(t:41, SQL("Select 1 from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
        endif
        if Val(t:41) = 1
           ACN(t:42, 1)
           if Vacio(Val(t:56)) y Val(t:34)=1
              * Vacio Cliente y MAE1
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and CB5='1' "))
           else
              ACT(t:43, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NroAltaMAE='"~fbn('Secuencia')~"' and TipoOp='"~Val(t:2)~"' and FechaOp='"~IdxDate(Val(t:19))~"' and Especie='"~Val(t:3)~"' and Cliente1='"~Val(t:56)~"' and CB5='1' "))
           endif
           if Dialogo.Check1=1
              SQL.ADD("Update "~DBO~".OPSIOPEL ")
              SQL.ADD("   Set Procesado   = '1',")
              SQL.ADD("       Carga       = '1', ")
              SQL.ADD("       NrOperacion = 'DUPLIC' ")
              SQL.ADD(" where Secuencia2  = '"~Val(t:1)~"' ")
              SQL.NEW
              SQL.EXEC
           endif
        endif
        if Vacio(Val(t:56))
           * Vacio Cliente
           if Val(t:34)=0
              * NO MAE1
              * Marca Incompleto
           endif
           ACT(t:56, 'SIOPEL')
           ACN(t:44, 1)
           ACN((26+FAC):8, 1)
        endif
        ACT(t:48, fbn('Fecha_dd')~'/'~fbn('Fecha_mm')~'/'~fbn('Fecha_aa')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        *ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~fbn('Fecha_mm')~'-'~fbn('Fecha_dd')~' '~fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        ACT(t:84, Copy(fbn('FechaCarga'),7,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
        ** AA - Esta funcion no incorpora los segundos a la Hora se pasa a equipo del Core  y se cambia temporalmente por Convert(datetime,'"~Val(t:48)~"',120)
        ACT(t:49, SQLFechaStr(Val(t:48),Exe('FORFECHOR')))
        
        ACT(t:51, fbn('SecEnvioOrden'))
        **ACT(t:70,VAR('CANALDEF'))
        ACT(t:70,'MERCADO')
        ACT(t:71,BuscarCampo('CANALES','AfectaPorDefecto','Codigo',Val(t:70)))
        ACT(t:72,fbn('Hora_hh')~':'~fbn('Hora_mm')~':'~fbn('Hora_ss'))
        ACT(t:74,iif(EqStr(Val(t:2),'TIC'),fbn('NroOfertaCpra'),fbn('NroOfertaVen')))