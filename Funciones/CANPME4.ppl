*MessageBox('Gen.MovEje '~FStr(val(ss1),1,0)~' - '~Val(ss3)~' - '~PYC(val(ss2),1,2)~' - '~Val(a1))
if Dialogo.Check1=1
  SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS ( ")
  SQL.ADD("  NrOperacion, Cliente,    Especie, NrGrupo2, ")
  SQL.ADD("  NrSaldo,     FechaMov,   Leyenda, Bits, ")
  SQL.ADD("  FechaEje,    UsuarioEje, Cantidad, Cuenta  ")
  if val(ss1)>=73 y val(ss1)<=78 o [EqStr(Copy(Val(ss3),1,3),'IVA') y not EQSTR(val(a1),'ARP')]
    SQL.ADD(", Formula ")
  endif
  if Eqstr(val(p1),'INGCURA') y val(ss1)>=73 y val(ss1)<=78
    SQL.ADD(" , PrecioEj, Status ")
  endif
  SQL.ADD(" ) values ( ")

  SQL.ADD(" '"~val(z1)~"', ")
  SQL.ADD(" '"~val(b1)~"', ")
  SQL.ADD(" '"~val(a1)~"', ")
  SQL.ADD(" "~val(ss4)~", ")

  SQL.ADD(" "~val(ss1)~", ")
  SQL.ADD(" '"~IdxDate(val(z2))~"', ")
  SQL.ADD(" '"~val(ss3)~"', ")
  SQL.ADD(" 'AV', ")

  SQL.ADD(" '"~IdxDate(Fsys)~"', ")
  SQL.ADD(" '"~USUARIOACTIVO~"', ")
  SQL.ADD(" "~val(ss2)~", ")
  SQL.ADD(" '"~val(bo8)~"' ")
  if val(ss1)>=73 y val(ss1)<=78 o [EqStr(Copy(Val(ss3),1,3),'IVA') y not EQSTR(val(a1),'ARP')]

    if Incluido(FStr(val(ss1),1),'41|81|42|82|43|83') y val(z2)>val(cw:val(x1))
      SQL.ADD(" ,'"~Fstr(val(z10),0,7)~"' ")      
      else
      SQL.ADD(" ,'"~Fstr(val(z6),0,7)~"' ")
    endif

  endif
  if Eqstr(val(p1),'INGCURA') y val(ss1)>=73 y val(ss1)<=78
    *WHT s/Intereses y BF
    SQL.ADD(" , ")
    if val(ss1)=73 o val(ss1)=77
      SQL.ADD(" "~Fstr(val(z5),0,7)~", ")
    endif
    *WHT s/Comisiones
    if val(ss1)=74
      SQL.ADD(" "~Fstr(val(z7),0,7)~", ")
    endif
    *PISE s/Intereses y BF
    if val(ss1)=75 o val(ss1)=78
      SQL.ADD(" "~Fstr(MontoImpuesto('IVAPISINT',val(z2),3,''),0,7)~", ")
    endif
    *PISE s/Comisiones
    if val(ss1)=76
      SQL.ADD(" "~Fstr(MontoImpuesto('IVAPISCOM',val(z2),3,''),0,7)~", ")
    endif
    SQL.ADD(" '"~iif(val(z4)=0,iif(EQSTR(val(s1),'1'),'1','2'),iif(EQSTR(val(s1),'1'),'3','4'))~"' ")
  endif
  SQL.ADD(" )")
  SQL.NEW
endif
