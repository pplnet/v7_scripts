VCAN1: 'Depositos Pendientes de Confirmacion';1;1;1;NO;NO;;;;;QUERY(" SELECT SUM(Cantidad-TotalBrutoCli2-TotalBrutoCli3) FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B WHERE O.NrOperacion=B.NrOperacion AND O.TipoOp='CCDEP' AND O.Cuenta1='"~CUENTA1~"' AND B.NrBit IN (24,25,26) AND B.Valor='1' ")
CONDICIONES
Not EqStr(CLIENTE1,VEHICULO1);'El cliente no puede ser el mismo vehiculo.';NO
Not[Eqstr('DES',BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1))];'El Cliente no esta Habilitado.';NO
Incluido(Vehiculo1, UsrVehiculos(Operador)) o Vacio(UsrVehiculos(Operador));'El Operador no esta habilitado para operar con el Vehiculo.';NO
CANTIDAD<=VAR('EXCTACTE');'La operacion excede Monto '~VAR('EXCTACTE');SI;SI;FSYS;'EXCTACTE'
Incluido(Especie,BuscarCampo('CUENTAS','Especies','Codigo',Cuenta1));'La Moneda No Corresponde con la Cuenta.';NO
DifDias(FechaOp,Fsys,VAR('FERIDEF'),SI)<=VAR('DIASCTACTE');'Fecha Valor Mayor a '~VAR('DIASCTACTE')~' Dias: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'

Not EqStr(ABM,'A') o [INSTANCIA=24];"La Instancia de Carga es Incorrecta.";NO
Not EqStr(ABM,'E') o [INSTANCIA=24 y FechaVto2=FSYS];"La Instancia o Fecha de Modificacion es Incorrecta.";NO
Not EqStr(ABM,'B') o [INSTANCIA=24 y FechaVto2=FSYS];"La Instancia o Fecha de Anulacion es Incorrecta."   ;NO

Eqstr(TIPOOP, 'CCDEP') o VCAN1=0;'Hay Depositos de la Cuenta Pendientes de Autorizacion.';SI;


SQL:EqStr(ABM,'E')
"Delete from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~NrOperacion~"' "
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "
POSTEDICION
EqStr(ABM,'E');'ACTMOV';NrOperacion1=NROPERACION;
