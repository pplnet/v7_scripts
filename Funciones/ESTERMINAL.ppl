***************************************************
* PARAMETRO DE ENTRADA
* sq1: especie
*
* Indica si la especie en sq1 es terminal, supone que 
* es una especie valida
*
* PARAMETRO DE SALIDA
* sq2: 0 si la especie es terminal
*      1 caso contrario
****************************************************

SQL.ADD("   DECLARE @Ok1 int,@Jer INT, @Posic int, @Jer1 CHAR(15) ")
SQL.ADD("   SET @Ok1 = 0 ")
SQL.ADD("   SET @Jer1 = (SELECT Jerarquia FROM SUD.ESPECIES WHERE Codigo = '"~Val(sq1)~"') ")
SQL.ADD("   SET @Jer = 5 ")
SQL.ADD("   WHILE (@Jer > 1)AND( SUBSTRING(@Jer1, ((@Jer-1)*3)+1, 3) = '000' ) ")
SQL.ADD("   BEGIN ")
SQL.ADD("     SET @Jer  =  @Jer - 1 ")
SQL.ADD("   END  ")
SQL.ADD("   SET @Posic = @Jer * 3 ")
SQL.ADD("   SET @Ok1 = (SELECT COUNT(*) FROM SUD.ESPECIES ")
SQL.ADD("   WHERE SUBSTRING(Jerarquia, 1, @Posic) = SUBSTRING(@Jer1, 1, @Posic)) ")
SQL.ADD("   SET @Ok1 = @Ok1 - 1 ")
SQL.ADD("   SELECT @Ok1 as Resultado")
Recorrer SQL
   ACN(sq2, FBN['Resultado'])
Proximo
