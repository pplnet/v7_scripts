*** Escribo fila de fechas ***
SetFilaActual(9)
If Dialogo.Radio2 = 0
   *** Diario ***
   IFA
   *** cashflow diario ***
   ACN(b:200,1)
   ACD(aa:200,FinDeMes(Dialogo.Fecha1,SI,'ARG'))
   ACN(ab:200,DifDias(Dialogo.Fecha1,Val(aa:200),'ARG',SI)+1)
   Recorrer&i 1, Val(ab:200)
      If EsHabil(Habiles(Dialogo.Fecha1,&i-1,'ARG',SI),'ARG')     
         SCN(b:200,1)
         ACD(Val(b:200):fac,Habiles(Dialogo.Fecha1,&i-1,'ARG',SI))                
         ACO(Val(b:200),10)
      Endif
   Proximo
   SCN(b:200,1)
   ACT(Val(b:200):fac,'Sub-Total')
   ACO(Val(b:200),10)
   ACN(d:200,Val(b:200))
   ACD(ac:200,Habiles(Val(aa:200),1,'ARG',SI))
   ACD(ad:200,FinDeMes(Val(ac:200),SI,'ARG'))
   ACN(ae:200,DIfDias(Val(ac:200),Val(ad:200),'ARG',SI)+1)
   Recorrer&i 1, Val(ae:200)
      If EsHabil(Habiles(Val(ac:200),&i-1,'ARG',SI),'ARG')     
         SCN(b:200,1)
         ACD(Val(b:200):fac,Habiles(Val(ac:200),&i-1,'ARG',SI))                
         ACO(Val(b:200),10)
      Endif
   Proximo
   SCN(b:200,1)
   ACT(Val(b:200):fac,'Sub-Total')
   ACO(Val(b:200),10)
   ACN(g:200,Val(b:200))
   SCN(b:200,1)
   ACT(Val(b:200):fac,'Total')
   ACO(Val(b:200),10)
   SetFont(b:fac..Val(b:200):FAC,2)
   AlinearCeldas(b:fac..Val(b:200):FAC,'D')
   AgregarMarco(b:FAC..Val(b:200):FAC,2,2,Exe('COLOR6'))
Else
   *** Mensual ***
   ACN(b:200,2)
   ACT(Val(b:200):fac,'Ejercicio '~Fstr(Anio(Dialogo.Fecha1),0,0))
   ACN(m:200,Val(b:200))
   ACN(Val(b:200):280,Anio(Dialogo.Fecha1))
   ACN(aa:200,Anio(Dialogo.Fecha1))
   ACN(ab:200,Anio(Dialogo.Fecha1)+10)
   IFA
   ACN(b:200,1)
   Recorrer&i Mes(Dialogo.Fecha1), 12
      SCN(b:200,1)
      ACT(Val(b:200):fac,Fstr(&i,0,0)~'-'~Fstr(Anio(Dialogo.Fecha1),0,0))
      ACO(Val(b:200),10)
      ACN(Val(b:200):281,&i)
   Proximo
   ACN(n:200,Val(b:200))
   SCN(b:200,1)
   ACT(Val(b:200):fac,'Sub-Total')
   ACO(Val(b:200),10)
   If Mes(Dialogo.Fecha1)-1 <> 0
      SCN(b:200,1)
      ACT(Val(b:200):fac-1,'Ejercicio '~Fstr(Anio(Dialogo.Fecha1)+1,0,0))
      ACN(o:200,Val(b:200))
      ACN(Val(b:200):280,Anio(Dialogo.Fecha1)+1)
      SCN(aa:200,1)
      SCN(b:200,-1)
      Recorrer&i 1, Mes(Dialogo.Fecha1)-1
         SCN(b:200,1)
         ACT(Val(b:200):fac,Fstr(&i,0,0)~'-'~Fstr(Anio(Dialogo.Fecha1)+1,0,0))
         ACO(Val(b:200),10)
         ACN(Val(b:200):281,&i)
      Proximo
      ACN(p:200,Val(b:200))
      SCN(b:200,1)
      ACT(Val(b:200):fac,'Resto')
      ACO(Val(b:200),10)
      SCN(b:200,1)
      ACT(Val(b:200):fac,'Sub-Total')
      ACO(Val(b:200),10)
   Endif
   ACN(d:200,Val(b:200)+1)
   Recorrer&i Val(aa:200)+1, Val(ab:200)
      SCN(b:200,1)
      ACT(Val(b:200):fac-1,'Ejercicio '~Fstr(&i,0,0))
      ACN(Val(b:200):280,&i)
      ACO(Val(b:200),10)
   Proximo
   ACN(g:200,Val(b:200))
   SCN(b:200,1)
   ACT(Val(b:200):fac-1,'Total')
   ACO(Val(b:200),10)
   SetFont(b:fac-1..Val(b:200):FAC,2)
   AlinearCeldas(b:fac-1..Val(b:200):FAC,'D')
   AgregarMarco(b:FAC-1..Val(b:200):FAC,2,2,Exe('COLOR6'))
Endif
