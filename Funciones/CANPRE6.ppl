ACN(ka1,Dialogo.Cantidad9)

if Eqstr(val(p1),'INGCURA') 
  Recorrer&i 1,val(x1)
  *--- Calculo de WHT y PISE ----------------------------------------
  * INTERESES
    if Val(x6)=0
      ACN(hf:&i, val(gg:&i)+val(da:&i))
    else
      ACN(hf:&i, val(gg:&i)+val(da:&i)+val(db:&i))
    endif
  * COMISIONES
    ACN(hg:&i, val(na:&i)+val(nh:&i))

   *Calculo siempre WHT
*   if val(z4)=0
     * WHT / INTERESES
*     ACN(cm:&i,val(hf:&i)*val(z5)/100*val(z6))
     ACN(cm:&i,val(hf:&i)*val(z5)/100)
     * WHT / COMISIONES
*     ACN(co:&i,val(hg:&i)*val(z7)/100*val(z6))
     ACN(co:&i,val(hg:&i)*val(z7)/100)
*    endif

   if EQSTR(val(r1),'SI')
     * PISE / INTERESES
*     ACN(cn:&i,(val(hf:&i)*val(z6)+iif(EQSTR(val(s1),'1'),val(cm:&i),0))*MontoImpuesto('IVAPISINT',val(z2),3,'')/100)
     ACN(cn:&i,(val(hf:&i)+iif(EQSTR(val(s1),'1'),val(cm:&i),0))*MontoImpuesto('IVAPISINT',val(z2),3,'')/100)
     * PISE / COMISIONES
*     ACN(cp:&i,(val(hg:&i)*val(z6)+iif(EQSTR(val(s1),'1'),val(co:&i),0))*MontoImpuesto('IVAPISCOM',val(z2),3,'')/100)
     ACN(cp:&i,(val(hg:&i)+iif(EQSTR(val(s1),'1'),val(co:&i),0))*MontoImpuesto('IVAPISCOM',val(z2),3,'')/100)
   endif
  
  Proximo

  * WHT / BREAKFUNDING
*  ACN(kf1,val(ka1)*val(z5)/100*val(z6))
  ACN(kf1,val(ka1)*val(z5)/100)
  * PISE / BREAKFUNDING
*  ACN(ke1,(val(ka1)*val(z6)+iif(EQSTR(val(s1),'1'),val(kf1),0))*MontoImpuesto('IVAPISINT',val(z2),3,'')/100) 
  ACN(ke1,(val(ka1)+iif(EQSTR(val(s1),'1'),val(kf1),0))*MontoImpuesto('IVAPISINT',val(z2),3,'')/100) 

else

  *--- IVA / BREAKFUNDING
  ACN(pm1,val(ka1))
  ACN(pf1,val(z2))
  ACT(pt1,'INT')
  (.'CANPREIVA'.)
  ACN(kb1,val(pr1))
  ACN(kc1,val(pr2))
  ACN(kd1,val(pr3))

  *** Actualizo los totales de IVA
  *** SCN(ha:val(x1),val(kb:val(x1)))
  *** SCN(hb:val(x1),val(kc:val(x1)))
  *** SCN(hc:val(x1),val(kd:val(x1)))
endif




