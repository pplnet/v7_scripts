*- DETOPSWAP
*- Dada una Operacion de mm verifica si tiene swap asociados, 
*- si tiene swap devuelve los valores del swap, sino los de la operacion.
*- Datos de ENTRADA
*- no1: NroOperacion 
*- st1: Tasa ss1: Spread sf1: Fecha Inicio sf2: Fecha Fin sa1: Importe Amortizacion sr1: Valor Residual


*- Verifico las operaciones relacionadas
SQL.ADD("Select O.FechaOp,O.*,O.Cantidad VResidual,O.Precio3 Tasa,O.Spread ,O.FechaOp2 Fecha1,O.TotalBrutoCli1 Cantidad2,")
SQL.ADD("       O.TotalGanancias Tasa2,O.TotalNetoCli2 Total4,O.FechaOp2 Fecha5,Cantidad Cantidad6,")
SQL.ADD("       TotalBrutoCli1 Cantidad5,0 NrCuota,O.FechaOp Fecha2,O.FechaVto Fecha6,O.TipoOp,O.TotalIntereses InteresC ")
SQL.ADD("from   "~DBO~".OPERACIONES O ")
SQL.ADD("where  O.OperacionRef='"~val(no1)~"' ")
SQL.ADD("       and TipoOp In ('DTSFF','DTSFV','DTSVV') ")
SQL.ADD("Union All ")
SQL.ADD("Select O.FechaOp,O.*, C.Cantidad1 VResidual,C.Precio1 Tasa,C.Total3 Spread,C.Fecha1,C.Cantidad2, ")
SQL.ADD("       C.Precio2 Tasa2,C.Total4,C.Fecha5,C.Cantidad6,C.Cantidad5,C.NrCuota,C.Fecha2,C.Fecha6,O.TipoOp,C.Cantidad3 as InteresC ")
SQL.ADD("from   "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where  O.NrOperacion = C.NrOperacion  ")
SQL.ADD("       and O.OperacionRef = '"~val(no1)~"' ")
SQL.ADD("       and TipoOp In ('DTSFFM','DTSFVM','DTSVVM','DTCAP','DTFLO') ")
SQL.ADD("       and C.Fecha2> '"~IdxDate(val(fe1))~"' and C.Fecha1<='"~IdxDate(val(fe1))~"' ")   
SQL.ADD("Order By 1")      

ACN(st1,0)
ACT(st2,'')
ACN(ss1,0)
ACD(sf1,0)
ACD(sf2,0)
ACN(sa1,0)
ACN(sr1,0)
ACT(no4,'')


Recorrer SQL
  Message(Fstr(FBN['NrCuota'],0,0)~' '~FBN['NrOperacion']~' '~FBN['TipoOp']~' '~val(fe1)~' '~val(fe2)~' '~Fstr(val(nc2),0,2)~' '~FBN['Especie']~' '~FBN['ContraEspecie'])
  dfa
  *- st1: Tasa ss1: Spread sf1: Fecha Inicio sf2: Fecha Fin sa1: Importe Amortizacion sr1: Valor Residual
  ACN(sc1,FBN['TotalAux3'])
  ACN(st1,FBN['Tasa'])
  ACT(st2,FBN['TipoTasa'])

  If Vacio(val(st2))
     ACT(st2,'FIJA')
  EndIf

  ACN(ss1,FBN['Spread'])
  ACD(sf1,FBN['Fecha1'])
  ACD(sf2,FBN['Fecha2'])
  ACN(sa1,FBN['Cantidad6'])
  ACN(sr1,FBN['VResidual'])
  ACN(si1,FBN['InteresC'])

  ACN(sd1,FBN['RB8'])

  ACT(no4,FBN['NrOperacion'])
Proximo


