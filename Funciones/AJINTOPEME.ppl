ACN(IC:1, 0)
ACN(IA:1, 0)
ACN(DF:1, 0)
ACN(DF:2, 0)
ACN(DF:3, 0)
ACN(DF:4, 0)
ACT(MF:1, Var('MONEFUERTE'))
ACT(ML:1, Var('MONELOCA'))
ACT(MG:1, Var('MONEGRUPO'))
SQL.ADD(" Select NrOperacion, Cantidad, Intereses, FechaMov, Especie From "~DBO~".MOVPOSEJE2 ")
SQL.ADD(" Where Especie = '"~fbn('Especie')~"' ")
SQL.ADD(" AND Vehiculo = '"~fbn('Vehiculo')~"' ")
SQL.ADD(" AND Tipo = 1 ")
SQL.ADD(" AND NrSaldo = 2 ")
SQL.ADD(" AND FechaMov > '"~IdxDate(Val(V:3))~"' ")
SQL.ADD(" AND FechaMov < '"~IdxDate(Val(V:2))~"' ")
Recorrer SQL
    DFA
    ***---Obtengo Intereses Corridos de la FechaMov
    SQL.ADD(" Select Intereses From "~DBO~".INTERESESCORRIDOS ")
    SQL.ADD(" Where Especie = '"~fbn('Especie')~"' ")
    SQL.ADD(" AND Fecha = '"~IdxDate(fbn('FechaMov'))~"' ")
    Recorrer SQL
        DFA
        ACN(IC:1, fbn('Intereses'))
    Proximo
    ***---Intereses Acumulados que corresponden
    ACN(IA:1, fbn('Cantidad') * Val(IC:1))
    ***---Diferencia en ME = Intereses a tasa fin de mes - Intereses a tasa del dia de la operacion
    SCN(DF:4, fbn('Intereses') - Val(IA:1))
Proximo
ACN(DF:1, SQL(" Select dbo.ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Val(K:fac)~"', '"~IdxDate(Val(V:2))~"', '"~Val(MF:1)~"', "~Fstr(Val(DF:4), 0, 2)~") "))
ACN(DF:2, SQL(" Select dbo.ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Val(K:fac)~"', '"~IdxDate(Val(V:2))~"', '"~Val(ML:1)~"', "~Fstr(Val(DF:4), 0, 2)~") "))
ACN(DF:3, SQL(" Select dbo.ObtenerConversionMoneda_EspecieFechaEspecieResultadoValorAConvertir('"~Val(K:fac)~"', '"~IdxDate(Val(V:2))~"', '"~Val(MG:1)~"', "~Fstr(Val(DF:4), 0, 2)~") "))
