*VH1--vehiculo1
*cl1--Cliente
*cu1--cuenta
*mc1--mercado
*es1--especie
SQL.ADD("SELECT s1.Cuenta, s1.especie,sum(S1.saldo) saldo ")
SQL.ADD(" FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD("WHERE S1.EnteCustodia = '"~val(vh1)~"'")
IF NoVacio(val(cl1))
  SQL.ADD("and S1.Cliente = '"~val(cl1)~"' ")
ENDIF
IF NoVacio(val(cu1))
  SQL.ADD("and S1.Cuenta = '"~val(cu1)~"' ")
ENDIF
IF NoVacio(val(mc1))
  SQL.ADD("and S1.Mercado = '"~val(mc1)~"' ")
ENDIF
IF NoVacio(val(es1))
  SQL.ADD("and S1.Especie = '"~val(es1)~"' ")
ENDIF
SQL.ADD("  and S1.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("  AND S1.NrSaldo = 81")

SQL.ADD("  and round(S1.Saldo,2) <> 0 ")
SQL.ADD("  and S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente      = S1.Cliente ")
SQL.ADD("                    and S2.Especie      = S1.Especie ")
SQL.ADD("                    and IsNull(S2.Cupon,'') = IsNull(S1.Cupon,'') ")
SQL.ADD("                    and S2.EnteCustodia = S1.EnteCustodia ")
SQL.ADD("                    and S2.Mercado      = S1.Mercado ")
SQL.ADD("                    and S2.NrSaldo      = S1.NrSaldo ")
SQL.ADD("                    and S2.Cuenta       = S1.Cuenta ")
SQL.ADD("                    and S2.Fecha       < '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("  group by s1.Cuenta,s1.especie ")
Recorrer SQL
   *MAC 19-07-2023 Sumo los movmientos fecha valor
   acn(z95,sql("select sum(cantidad) from "~DBO~".MOVEJECUTADOS mvej where mvej.cliente = '"~val(cl1)~"' and mvej.especie = '"~val(es1)~"' and mvej.Mercado = '"~val(mc1)~"' and mvej.EnteCustodia = '"~val(vh1)~"' and mvej.Cuenta = '"~val(cu1)~"' and mvej.nrsaldo = 1 and mvej.Fechamov < '"~idxdate(Dialogo.fecha1)~"' AND mvej.FechaEje = '"~idxdate(Dialogo.fecha1)~"' and not exists (select * from "~DBO~".MOVEJECUTADOS mvej inner join "~DBO~".operaciones op on mvej.nroperacion = op.nroperacion where op.tipoop in ('TIC','TIV') and op.cb4 = 1 and op.cliente1 = '"~val(vh1)~"' and mvej.especie = '"~val(es1)~"' and mvej.Mercado = '"~val(mc1)~"' and mvej.EnteCustodia ='"~val(vh1)~"' and mvej.Cuenta = '"~val(cu1)~"' and mvej.nrsaldo = 1 and mvej.FechaEje = '"~idxdate(Dialogo.fecha1)~"')"))
   *MAC 19-07-2023 Doy vuelta los movmientos de garantizado
   acn(z96,sql("select sum((-1)*mvej.cantidad) from "~DBO~".MOVEJECUTADOS mvej inner join "~DBO~".operaciones op on mvej.nroperacion = op.nroperacion where op.tipoop in ('TIC','TIV') and op.cb4 = 1 and op.cliente1 = '"~val(vh1)~"' and mvej.especie = '"~val(es1)~"' and mvej.Mercado = '"~val(mc1)~"' and mvej.EnteCustodia ='"~val(vh1)~"' and mvej.Cuenta = '"~val(cu1)~"' and mvej.nrsaldo = 1 and mvej.FechaEje = '"~idxdate(Dialogo.fecha1)~"'"))
   acn(s:1,fbn('saldo')+val(z95)+val(z96))
