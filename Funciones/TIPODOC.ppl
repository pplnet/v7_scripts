* Esta funcion recibe una codigo de tipo de documento de BANTOTAL y 
* devuelve el equivalente en FPA, si no existe devuelve 'OTR' (Otro)

IF EqStr(Val(ba0),'1')
   ACT(bb0, 'DNI')
ELSE
   IF EqStr(Val(ba0),'2')
      ACT(bb0, 'LE')
   ELSE
      IF EqStr(Val(ba0),'3')
         ACT(bb0, 'LC')
      ELSE
         IF EqStr(Val(ba0),'30')
            ACT(bb0, 'CI')
         ELSE
            IF EqStr(Val(ba0),'40')
               ACT(bb0, 'PAS')
            ELSE
               IF EqStr(Val(ba0),'16') o EqStr(Val(ba0),'52') 
                  ACT(bb0, 'CUT')
               ELSE
                  IF EqStr(Val(ba0),'17')
                     ACT(bb0, 'CUL')
                  ELSE   
                     IF EqStr(Val(ba0),'13')
                        ACT(bb0, 'CDI')
                     ELSE
                        IF EqStr(Val(ba0),'50')
                           ACT(bb0, 'MOS')
                        ELSE
                           IF EqStr(Val(ba0),'51')
                              ACT(bb0, 'MIG')                              
                           ELSE
                              IF EqStr(Val(ba0),'98')
                                 ACT(bb0, 'DES')
                              ELSE
                                 IF EqStr(Val(ba0),'99')
                                    ACT(bb0, 'FIN')
                                 ELSE
                                    IF EqStr(Val(ba0),'22')
                                       ACT(bb0, 'CUL')
                                    ELSE
                                       ACT(bb0, 'OTR')
                                    ENDIF
                                 ENDIF
                              ENDIF
                           ENDIF
                        ENDIF
                     ENDIF
                  ENDIF
               ENDIF
            ENDIF
         ENDIF
      ENDIF
   ENDIF
ENDIF
