** AA 09-12-2025 Version previa a funcion fnRelacionCuenta
*SQL.ADD(" Select fechamov, especie, sum(cantidad) Cantidad, E.MonedaEmision, E.Tipo TipoEspecie,Tipoposicion Concepto, vehiculo Vehiculo1, Estrategia CuentaCustodia, Book ")
*SQL.ADD(" from MOVPOSEJE M, ESPECIES E ")
*SQL.ADD(" where E.Codigo=M.Especie")
*SQL.ADD(" and Nrsaldo = 121 and Cantidad > 0 and especie='"~Val(es:1)~"' and M.FechaMov  <= "~IdxDate2(Val(fe:2))~" ")
*SQL.ADD(" group by FechaMov,especie,MonedaEmision,E.Tipo,TipoPosicion,Vehiculo,Estrategia,BOOK ")
*SQL.ADD(" ) as Aux ") 
*SQL.ADD(" order by fechamov desc ")

SQL.ADD("SELECT * from ")
SQL.ADD("(SELECT Aux.*, RC.Cuenta AS CuentaCont, (Select RubroContable from CONTABILIDAD CO   where CO.Codigo  = RC.Cuenta) Rubro ")
SQL.ADD("   FROM ( ")
SQL.ADD("   SELECT fechamov, especie, SUM(cantidad) Cantidad, E.MonedaEmision MonedaEmision, E.Tipo TipoEspecie,Tipoposicion Concepto, vehiculo Vehiculo1, Estrategia CuentaCustodia, Book ")
SQL.ADD("   FROM MOVPOSEJE M INNER JOIN ESPECIES E ON E.Codigo=M.Especie ")
SQL.ADD("WHERE Nrsaldo = 121 and Cantidad > 0 and especie='"~Val(es:1)~"' and M.FechaMov  <= "~IdxDate2(Val(fe:2))~" ")
SQL.ADD("GROUP BY FechaMov,especie,MonedaEmision,E.Tipo,TipoPosicion,Vehiculo,Estrategia,BOOK ")
SQL.ADD(" ) AS Aux ")
SQL.ADD("CROSS APPLY dbo.fnRelacionCuenta('TIC', 'TITULO', Aux.MonedaEmision, Aux.TipoEspecie, Aux.Book, Aux.Vehiculo1, Aux.CuentaCustodia ) RC ")
SQL.ADD(" ) AS Aux1 ")
SQL.ADD(" Where Rubro ='"~Val(co:1)~"' ")
SQL.ADD("ORDER BY fechamov DESC ")

watch(SQL.Batch)


