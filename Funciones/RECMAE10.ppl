***********************************************************************************************
* Recibi un Registro 4426 y Completo la tabla MTMDETOCT               (OCT)                   *
***********************************************************************************************

*AbrirASCII(Val(z2)~'\OCTDETAL.TXT',0)
*EscribirASCII(Val(A:2))
*CerrarASCII

ACT(A:2,VAL(A:2))

*/Proceso el contenido.
ACT(ln1, Val(a:2))
ACN(z1,0)

*/123456789012345678901234567890123456789012345678901234567890
*/01210571000408251818163344344160255ODOLAR15 SEP 0010255057100000000000000800001181816          S20040825                 
*********************************************************************************
if [Var('AGESIOP') = Num(Copy(Val(ln1),68,3))] o [Var('AGESIOP') = Num(Copy(Val(ln1),74,3))]
  ACT(s:1,'Cliente')
  ACT(s:2,'TipoOp')
  if Num(trim(Var('AGESIOP'))) = Num(trim(Copy(Val(ln1),68,3)))
    */Somos Vendedor
    ACT(t:1,trim(Copy(Val(ln1),74,3)))    
    ACT(t:2,'FXOCTV')    
  else
    */Somos Comprador
    ACT(t:1,trim(Copy(Val(ln1),68,3)))    
    ACT(t:2,'FXOCTC')    
  endif
  if Vacio(Val(t:1))
    ACT(t:1, '')  
    if Val(z1)=0
      ACT(er:4, Pad('Campo Cliente en NULL',40))
    endif
    ACN(z1,1)  
  else
    ACT(c:1,'')
    ACT(c:1, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:1)~"' "))  
    ACT(t:1, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = '"~Val(t:1)~"' "))  
    if Vacio(Val(c:1))
      if Val(z1)=0
        ACT(er:4, Pad('Agente Inexistente '~Val(t:1),40))
      endif
      ACN(z1,1)  
    endif
  endif
*  message(Val(s:1)~' '~Val(t:1))
*  message(Val(s:2)~' '~Val(t:2))

  ACT(s:3,'Tipo Neg')
  ACT(t:3,trim(Copy(val(ln1),49,1)))
  if Vacio(Val(t:3))
    ACT(t:3,'')
    if Val(z1)=0
      ACT(er:4, Pad('Tipo Neg NULL',40))
    endif 
    ACN(z1,1)  
  endif
  if NOT Eqstr(Val(t:3),'O')
    if Val(z1)=0
      ACT(er:4, Pad('Tipo Neg Invalida '~Val(t:3),40))
    endif
    ACN(z1,1)  
  endif
*  message(Val(s:3)~' '~Val(t:3))

  ACT(s:4,'Especie')
  ACT(t:4,trim(Copy(Val(ln1),50,5)))
  if Vacio(Val(t:4))
    ACT(t:4, '')     
     if Val(z1)=0
       ACT(er:4, Pad('Especie NULL',40))
     endif
     ACN(z1,1)  
  else
    ACT(c:4,'')
    ACT(c:4, SQL("Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:4)~"' and TipoNegociacion = '"~Val(t:3)~"' "))  
    ACT(t:4, SQL("Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:4)~"' and TipoNegociacion = '"~Val(t:3)~"' "))  
    if Vacio(Val(c:4))
      if Val(z1)=0
        ACT(er:4, Pad('EspecieDestino Inexistente',40))
      endif
      ACN(z1,1)  
    endif
  endif
*  message(Val(s:4)~' '~Val(t:4))

  ACT(s:5,'FechaOp')
  ACT(s:5,'')
  ACN(t:5,0)
  ACN(t:5, Fecha(Copy(Val(ln1),36,2)~'/'~Copy(Val(ln1),34,2)~'/20'~Copy(Val(ln1),32,2)))
*  message(Val(s:5)~' '~Val(t:5))

  if Val(t:5) = 0
    if Val(z1)=0
      ACT(er:4, Pad('Fecha Op Invalida',40))
    endif
    ACN(z1,1)  
  endif
  ACT(s:6,'NroAltaMAE')
  ACT(t:6,trim(Copy(Val(ln1),44,5)))
  if Vacio(Val(t:6))
    ACT(t:6,'')
    if Val(z1)=0
      ACT(er:4, pad('Nro Alta MAE NULL ',40))
    endif
    ACN(z1,1)  
  endif

  ACT(s:7,'Cantidad') 
  ACN(t:7,Num(Copy(Val(ln1),79,14)) +(Num(Copy(Val(ln1),93,4))/10000 ))

  ACT(s:8,'Precio') 
  ACN(t:8,Num(Copy(Val(ln1),97,10)) +(Num(Copy(Val(ln1),107,8))/100000000 ))

  ACT(s:9,'MetodoFix')
  ACT(t:9,trim(Copy(Val(ln1),213,1)))
  if Vacio(Val(t:9))
     ACT(t:9,'')
  endif
*  message(Val(s:9)~' '~Val(t:9))

  ACT(s:10,'FechaVto')
  ACT(s:7,'FechaVar')
  ACT(t:10, Copy(Val(ln1),55,7))
  if NoVacio(Val(t:3)) y NoVacio(Val(t:4))
    ACN(c:10, 0)
    ACN(c:10, SQL("Select Fecha from  "~DBO~".PLAZOSOCT Where rtrim(ltrim(Especie))=rtrim(ltrim('"~Val(t:4)~"')) and rtrim(ltrim(TipoNegociacion)) = rtrim(ltrim('"~Val(t:3)~"')) and rtrim(ltrim(Variable))= rtrim(ltrim('"~Val(t:10)~"')) "))
    ACN(t:10, SQL("Select Fecha from  "~DBO~".PLAZOSOCT Where rtrim(ltrim(Especie))=rtrim(ltrim('"~Val(t:4)~"')) and rtrim(ltrim(TipoNegociacion)) = rtrim(ltrim('"~Val(t:3)~"')) and rtrim(ltrim(Variable))= rtrim(ltrim('"~Val(t:10)~"')) "))
    if Val(c:10)=0
      if Val(z1)=0
        ACT(er:4, Pad('Fecha No Encontrada en PLazosOCT',40))
      endif
      ACN(z1,1)  
    endif
  else
    ACT(t:10, '')
    if Vacio(Val(t:10))
      if Val(z1)=0
        ACT(er:4, Pad('Fecha Var Invalida',40))
      endif
      ACN(z1,1)  
    endif
  endif
*  message(Val(s:10)~' '~Val(t:10))

  ACT(s:11,'Monto') 
  ACN(t:11,Num(Copy(Val(ln1),314,16)) +(Num(Copy(Val(ln1),330,2))/100 ))
  if [Eqstr(Copy(Val(ln1),313,1),'C') Y Eqstr(Val(t:2),'OCTC')] o  [Eqstr(Copy(Val(ln1),313,1),'V') Y Eqstr(Val(t:2),'OCTV')] 
    ACN(t:11,Val(t:11) * (-1))
  endif

  ACT(s:12,'Precio MTM Hoy') 
  ACN(t:12,Num(Copy(Val(ln1),332,10)) +(Num(Copy(Val(ln1),342,8))/100000000 ))

  ACT(s:13,'Precio MTM Ayer') 
  ACN(t:13,Num(Copy(Val(ln1),350,10)) +(Num(Copy(Val(ln1),360,8))/100000000 ))

  ACT(s:14,'FechaProc')
  ACN(t:14, Fecha(Copy(Val(ln1),391,2)~'/'~Copy(Val(ln1),389,2)~'/'~Copy(Val(ln1),385,4)))
*  message(Val(t:14)~' '~Val(t:14))

  if Val(t:14)=0
    if Val(z1)=0
      ACT(er:4, Pad('Fecha Proc Invalida',40))
    endif
    ACN(z1,1)  
  endif
  ************************Actualizo las Tablas***************************
  if Val(z1)=0
    ACN(nu1,0)
    */Controlo si ya existe.
    SQL.ADD("Select '*' From "~DBO~".MTMDETOCT ")
    SQL.ADD(" Where NroAltaMAE      = rtrim(ltrim('"~Val(t:6)~"')) ")
    SQL.ADD("   and TipoNegociacion = '"~Val(t:3)~"' ")
    SQL.ADD("   and FechaOp         = '"~IdxDate(Val(t:5))~"'  ")
    SQL.ADD("   and FechaProc       = '"~IdxDate(Val(t:14))~"'")
    Recorrer SQL
      ACN(nu1,1)
    Proximo

    if Val(nu1)<> 0
      Message('*/Grabo en el Log de Errores')
      */Fecha 
      ACN(Y1, Ahora)
      ACT(Y2, Hora(Val(Y1)))
      ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
      ***** Fecha
      ACT(er:1,Val(Y3))
      ***** Hora
      ACT(er:1, Val(er:1)~Copy(Val(Y2),1,2))
      ACT(er:1, Val(er:1)~Copy(Val(Y2),4,2))
      ACT(er:1, Val(er:1)~Copy(Val(Y2),7,2))
      */Codigo de Registro
      ACT(er:1, Val(er:1)~Copy(Val(ln1),28,4))
      */Motivo
      ACT(er:1, Val(er:1)~pad('Clave Duplicada',40))
      */Contenido
      ACT(er:1, Val(er:1)~Val(ln1))
      AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
      EscribirASCII(Val(er:1))
      CerrarASCII
    else
      */Agrego el Registro
      SQL.ADD("Insert into "~DBO~".MTMDETOCT ( ")
      SQL.ADD(" FechaOp,    NroAltaMAE, TipoNegociacion, Especie,  ")
      SQL.ADD(" FechaProc,  Cliente,    TipoOp,          Cantidad, ")
      SQL.ADD(" Precio1,    MetodoFix,  FechaVto,        Monto,    ")
      SQL.ADD(" PrecioMTMH, PrecioMTMA  ")
      SQL.ADD(" ) Values ( ")
      SQL.ADD(" '"~IdxDate(Val(t:5))~"', ")
      SQL.ADD(" '"~Val(t:6)~"', ")
      SQL.ADD(" '"~Val(t:3)~"', ")
      SQL.ADD(" '"~Val(t:4)~"', ")
      SQL.ADD(" '"~IdxDate(Val(t:14))~"', ")
      SQL.ADD(" '"~Val(t:1)~"', ")
      SQL.ADD(" '"~Val(t:2)~"', ")
      SQL.ADD(" "~FStr(Val(t:7),0,4)~", ")
      SQL.ADD(" "~FStr(Val(t:8),0,8)~", ")
      SQL.ADD(" '"~Val(t:9)~"', ")
      SQL.ADD(" '"~IdxDate(Val(t:10))~"', ")
      SQL.ADD(" "~FStr(Val(t:11),0,2)~", ")
      SQL.ADD(" "~FStr(Val(t:12),0,8)~", ")
      SQL.ADD(" "~FStr(Val(t:13),0,8)~" ")
      SQL.ADD(" ) ")
      SQL.NEW
    endif
    SQL.EXEC
  else
    Message('*/Grabo en el Log de Errores')
    */Fecha 
    ACN(Y1, Ahora)
    ACT(Y2, Hora(Val(Y1)))
    ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
    ***** Fecha
    ACT(er:1,Val(Y3))
    ***** Hora
    ACT(er:1, Val(er:1)~Copy(Val(Y2),1,2))
    ACT(er:1, Val(er:1)~Copy(Val(Y2),4,2))
    ACT(er:1, Val(er:1)~Copy(Val(Y2),7,2))
    */Codigo de Registro
    ACT(er:1, Val(er:1)~Copy(Val(ln1),28,4))
    */Motivo
    ACT(er:1, Val(er:1)~Val(er:4))
    */Contenido
    ACT(er:1, Val(er:1)~Val(ln1))
    AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
    EscribirASCII(Val(er:1))
    CerrarASCII
  endif
  ***********************************************************************
else
  Message('*/Grabo en el Log de Errores')
  */Fecha 
  ACN(Y1, Ahora)
  ACT(Y2, Hora(Val(Y1)))
  ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
  ***** Fecha
  ACT(er:1, Val(Y3))
  ***** Hora
  ACT(er:1, Val(er:1)~Copy(Val(Y2),1,2))
  ACT(er:1, Val(er:1)~Copy(Val(Y2),4,2))
  ACT(er:1, Val(er:1)~Copy(Val(Y2),7,2))
  */Codigo de Registro
  ACT(er:1, Val(er:1)~Copy(Val(ln1),28,4))
  */Motivo
  ACT(er:1, Val(er:1)~pad('La operacion no es del Agente '~FStr(Var('AGESIOP'),0,0),40))
  */Contenido
  ACT(er:1, Val(er:1)~Val(ln1))
  AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
  EscribirASCII(Val(er:1))
  CerrarASCII
endif
