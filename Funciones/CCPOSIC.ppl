SQL.ADD("Select *  From "~DBO~".POSICIONES P Where Especie='"~Dialogo.Especie1~"' and NrSaldo="~Fstr(VAL(x3),0,0)~" ") 
SQL.ADD(" and CantidadFin<>0 and Fecha=")
SQL.ADD(" (Select Max(Fecha) From "~DBO~".POSICIONES P1 ")
SQL.ADD(" Where P1.Especie='"~Dialogo.Especie1~"' and P1.Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD(" P1.NrSaldo="~Fstr(VAL(x3),0,0)~" AND ") 
SQL.ADD(" P1.Vehiculo=P.Vehiculo) ")

Recorrer SQL

     Message("Verificando Posiciones NrSaldo= "~Fstr(VAL(x3),0,0))

     ACN(z1,FBN['CantidadFin'])
     ACN(z:fac,FBN['PrecioFin'])

     act(a:fac,fbn['Cliente'])
     act(b:fac,'POSIC '~Fstr(FBN['NrSaldo'],0,0))
     act(c:fac,fbn['Vehiculo'] )
     acn(d:fac,FBN['CantidadFin'])


     if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Dialogo.Especie1),'CLE')
        acn(h:fac,VAL(z:fac))    
     else
        acn(h:fac,VAL(z:fac)-(val(k2)/100))    
     endif 

     acn(n:fac,FBN['NrSaldo'])

