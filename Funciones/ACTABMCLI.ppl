     If SQL("Select 1 from "~DBO~".CLIENTES where Codigo='"~Mayusculas2(val(a10))~"'")=0
        If Dialogo.Radio4=0 o Dialogo.Radio4=2
           message('en alta '~Mayusculas2(val(a10)) )

           *- se1: Sector
           ACT(se1,'OTR')

           *- Alta o Alta y Modificacion
           *- cw3 => Codigo de para generar Jerarquia 'L' Bancos Locales, 'E' Bancos del Exterior, 'C' Clientes, 'J' Empresas.
           *- ba2: Codigo de Jerarquia a insertar cliente
           ACT(cw3,'C')

           If Dialogo.Radio3=1
              ACT(cw3,'J')
           EndIf
    
           If Dialogo.Radio3=2
              ACT(cw3,'L')
              ACT(se1,'BAN')
           EndIf

           If Dialogo.Radio3=3
              ACT(cw3,'E')
              ACT(se1,'BAN')
           EndIf

           (.'ALTAJERCLI'.)

           *- Insert
           SQL.ADD("INSERT INTO "~DBO~".CLIENTES ")
           SQL.ADD(" (Jerarquia, Codigo, RazonSocial, ")
           SQL.ADD("Direccion, Localidad,CodigoPostal, ")
           SQL.ADD("Provincia, PaisDir, Telefono, ")
           SQL.ADD("ActividadBCRA, Status, ")
           SQL.ADD("TipoCliente, CategDepositante,CorrespDireccion, ")
           SQL.ADD("CorrespLocalidad, CorrespCodigoPostal, CorrespProvincia, CorrespPais, ")
           SQL.ADD("CobroCustodia, FrecuenciaCobro, CobroMovCustodia, ")
           SQL.ADD("CondicionGan, CondicionIVA, Persona, Res3125, TipoInscripcion, CUIT,")
           SQL.ADD("FechaApertura,DeposDelComitente,CodDepCajaValores,Fecha1,CodigoBCRA,Sector) ")
           SQL.ADD(" VALUES (")
           SQL.ADD(" '"~Val(ba2)~"', '"~Val(a10)~"', '"~Val(b14)~"', ")
           SQL.ADD(" '"~val(b19)~"', '"~Val(a24)~"', '"~Val(a23)~"', ")
           SQL.ADD(" '"~Val(a25)~"', '"~Val(a26)~"', '"~Val(a27)~"', ")
           SQL.ADD(" '"~Val(a28)~"', 'HAB', ")
           SQL.ADD(" 'BIND', 'CLI', '"~val(b19)~"', ")
           SQL.ADD(" '"~Val(a24)~"', '"~Val(a23)~"', '"~Val(a25)~"', '"~Val(a26)~"', ")
           SQL.ADD(" 'SI', 'MEN', 'SI',    ")
           SQL.ADD("'"~Val(b31)~"', '"~Val(b30)~"', '"~Val(b13)~"', '"~Val(b32)~"', 'CIT', '"~val(a12)~"',")
           SQL.ADD(" "~IdxDate2(val(a41))~",'"~Fstr(VAR('NUMCV'),0,0)~"','"~Fstr(VAR('NUMCV'),0,0)~"',"~IdxDate2(Fsys)~",'"~val(a39)~"','"~val(se1)~"') ")
           SQL.NEW

           *- Datos de Personas
           *- Verifico que no exista en personas
           If SQL("Select 1 from "~DBO~".PERSONAS  where TipoDocumento='"~Val(b17)~"' AND NrDocumento='"~Fstr(Num(Val(a18)),0,0)~"' ")=0
              SQL.ADD("INSERT INTO "~DBO~".PERSONAS ")
              SQL.ADD("(Apellido, Nombre, TipoDocumento, NrDocumento, Nacionalidad, FechaNacimiento, Numero, ")
              SQL.ADD("Sexo, EstadoCivil, CondicionIVA, Ganancias, ActividadBCRA, Direccion, Localidad, CodigoPostal, Provincia, ")
              SQL.ADD("Pais, Telefono, CUIT,CUIL,Percepcion) VALUES(")
              SQL.ADD("'"~Val(a15)~"', '"~Val(a16)~"', '"~Val(b17)~"', '"~Fstr(Num(Val(a18)),0,0)~"', '"~Val(a26)~"', '"~IdxDate(Val(a35))~"', '"~Val(A21)~"', ")
              SQL.ADD("'"~Val(b37)~"', '"~Val(b36)~"', '"~Val(b30)~"', '"~Val(b31)~"', '"~Val(a28)~"', '"~Val(b19)~"', '"~Val(a24)~"', '"~Val(a23)~"', '"~Val(a25)~"', ")
              SQL.ADD("'"~Val(a26)~"', '"~Val(a27)~"','"~Val(a12)~"','"~Val(a12)~"','"~Val(b32)~"') ")
              SQL.NEW
           EndIf

           If SQL("Select 1 from "~DBO~".INTEGRANTESCLI where Codigo='"~Val(a10)~"' and TipoDocumento='"~Val(b17)~"' AND NrDocumento='"~Fstr(Num(Val(a18)),0,0)~"' ")=0
              *- Genero los integrantes
              SQL.ADD("INSERT INTO "~DBO~".INTEGRANTESCLI (Codigo, TipoDocumento, NrDocumento, TipoPoder,NrIntegrante,Status) ")
              SQL.ADD("VALUES('"~Val(a10)~"', '"~Val(b17)~"', '"~Fstr(Num(Val(a18)),0,0)~"','TIT',1,'VIG') ")
              SQL.NEW
           EndIf

           SQL.EXEC
        EndIf
     Else 
        If Dialogo.Radio4=1 o Dialogo.Radio4=2
           *- Modificacion o Alta y Modificacion
           *- Modificacion
           SQL.ADD("UPDATE "~DBO~".CLIENTES SET ")
           SQL.ADD(" RazonSocial='"~Val(b14)~"', ")
           SQL.ADD("Direccion='"~val(b19)~"', ")
           SQL.ADD("Localidad='"~Val(a24)~"', ")
           SQL.ADD("CodigoPostal='"~Val(a23)~"', ")
           SQL.ADD("Provincia='"~Val(a25)~"',  ")
           SQL.ADD("PaisDir='"~Val(a26)~"',   ")
           SQL.ADD("Telefono='"~Val(a27)~"', ")
           SQL.ADD("ActividadBCRA='"~Val(a28)~"',")
           SQL.ADD("Status='HAB',")
           SQL.ADD("CorrespDireccion='"~val(b19)~"', ")
           SQL.ADD("CorrespLocalidad='"~Val(a24)~"',   ")
           SQL.ADD("CorrespCodigoPostal='"~Val(a23)~"',  ")
           SQL.ADD("CorrespProvincia='"~Val(a25)~"', ")
           SQL.ADD("CorrespPais='"~Val(a26)~"', ")
           SQL.ADD("CondicionGan='"~Val(b31)~"',  ")
           SQL.ADD("CondicionIVA='"~Val(b30)~"',  ")
           SQL.ADD("Persona='"~Val(b13)~"', ")
           SQL.ADD("Res3125='"~Val(b32)~"',  ")
           SQL.ADD("CUIT='"~val(a12)~"',")
           SQL.ADD("CodigoBCRA='"~val(a39)~"', ")
           SQL.ADD("FechaApertura="~IdxDate2(val(a41))~", ")
           SQL.ADD("Fecha1="~IdxDate2(Fsys)~" ")
           SQL.ADD("WHERE Codigo='"~Val(a10)~"'")
           SQL.NEW
  
           *- Datos de Personas
           SQL.ADD("UPDATE "~DBO~".PERSONAS ")
           SQL.ADD("SET Apellido='"~Val(a15)~"', Nombre='"~Val(a16)~"', Nacionalidad='"~Val(a26)~"', FechaNacimiento='"~IdxDate(Val(a35))~"', Numero='"~Val(A21)~"', ")
           SQL.ADD("Sexo='"~Val(b37)~"',EstadoCivil='"~Val(b36)~"',CondicionIVA='"~Val(b30)~"',Ganancias= '"~Val(b31)~"', ActividadBCRA='"~Val(a28)~"', Direccion='"~Val(b19)~"', Localidad='"~Val(a24)~"', CodigoPostal='"~Val(a23)~"', Provincia='"~Val(a25)~"', ")
           SQL.ADD("Pais='"~Val(a26)~"', Telefono='"~Val(a27)~"', CUIT='"~Val(a12)~"',CUIL='"~Val(a12)~"',Percepcion='"~Val(b32)~"' ")
           SQL.ADD("WHERE TipoDocumento='"~Val(b17)~"' AND  NrDocumento='"~Fstr(Num(Val(a18)),0,0)~"' ")
           SQL.NEW
           SQL.EXEC    
        EndIf 
     EndIf
