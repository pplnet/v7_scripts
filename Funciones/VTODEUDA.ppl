SQL.ADD("Select M.* ")
SQL.ADD(" from "~DBO~".OPERACIONES O,"~DBO~".MOVPENDIENTES M,"~DBO~".ICRELACIONES I,  ")
SQL.ADD("where M.NrOperacion=O.NrOperacion and M.FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and I.ICInstante In ('04','05','06','07') and M.Leyenda LIKE R.ConceptoFPA ")
SQL.ADD("  and O.TipoOp In ('MMON','MMPSI','MMONM','MMSIMV','MMFIMV','MMPCL','MMPCOS','MMPI','MMPE','MMFRNP','MMPLME','MMPCLM','MMPOSM','MMPIM','MMPEM') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("  and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("  and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD("  and O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.NrOperacion='"~Dialogo.NrOperacion1~"', ")
EndIf
