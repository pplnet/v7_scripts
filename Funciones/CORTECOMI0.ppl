     * --- Calcula Comision sobre Renta --- *
     If val(re:1)<>0 
         * ---- Saldo libre Custodia
         ACN(sl:1, BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')))
         * ---- Tipo Arancel de Renta
         act(ct:1, VAR('COMCCRENTA'))
         * ---- Renta
         acn(cj:1, Val(re:1))
         * ---- Saldo
         acn(hg:1, Val(sa:1))
         * ---- NrSaldo
         acn(hs:1, fbn('NrSaldo'))
         * ---- Funcion que recupera los montos de comisiones
         (.'CORTECOMIS'.)
         * ---- Acumula Comisiones
         acn(cm:1, Val(sa:3))
     EndIf
*MESSAGEBOX('Com renta '~Val(cm:1))

     * ------------------------------------ *
     * --- Calcula Comision sobre Amort --- *
     If val(am:1)<>0 
         * ---- Saldo libre Custodia
         ACN(sl:1, BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')))
         * ---- Tipo Arancel de Renta
         act(ct:1, VAR('COMCCAMOR'))
         * ---- Renta
         acn(cj:1, Val(am:1))
         * ---- Saldo
         acn(hg:1, Val(sa:1))
         * ---- NrSaldo
         acn(hs:1, fbn('NrSaldo'))
         * ---- Funcion que recupera los montos de comisiones
         (.'CORTECOMIS'.)
         * ---- Acumula Comisiones
         acn(cm:2, val(sa:3)-Val(cm:1))
*MESSAGEBOX('Com Amort '~Val(cm:2))
     EndIf
     * ------------------------------------ *
     * -- Calcula IVA sobre Renta y Amort - *
     If Val(re:1)<>0 o Val(am:1)<>0
        * --- Si hay renta o amortizacion calcula el IVA
        acn(ci:2, Num(VAR('IVA'))+IIF(EQSTR(FBN['CondicionIVA'],'NOI'),Num(VAR('RNI')),IIF(EQSTR(FBN['Res3125'],'SI'),Num(VAR('RG3337')),0)))
        acn(ci:1,ROUND(Abs(Val(sa:3))*Val(ci:2)/100,2))
     Endif
     * ------------------------------------ *
*MESSAGEBOX('Com Total '~Val(sa:3)~' - IVA '~Val(ci:1))

*IF NO
     * ------ Comision Caja Valores ------- *
     ACT(dz20, VAR('IVACOMCV'))
     * --- dz21: Especies a las que se le cobre iva para comision cv
     ACT(dz:21, VAR('ESPIVACOCV'))
     If Not Incluido(Ascendientes('ESPECIES',fbn('Especie')),val(dz:21))
        *- A esta especie no se le cobrea comision iva caja de valores
        ACT(dz:20, '0')
     EndIf

     *- re3: Monto de la comision
     If val(re:1)<>0  
        act(ct1, VAR('COMCCCVALO'))
        acn(cj:1,Val(re:1))
        acn(hg:1, Val(sa:1))
        acn(hs:1, fbn('NrSaldo'))
        *- Funcion que recupera los montos de comisiones
        (.'CACOMISION'.)
         acn(cm:3, val(sa:3)-val(cm:1)-val(cm:2))
         scn(sa3,-val(cm:3))
     EndIf
     *- ci12: Calculo del % del Iva sobre comisiones DE CAJA DE VALORES 
     acn(ci:12, Num(Val(dz:20)) )
     *- ci:11 Monto de Iva
     acn(ci:11,ROUND(Abs(val(cm:3))*Val(ci:12)/100,2))
*ENDIF
*MESSAGEBOX('Com CV '~Val(cm:3))
*MESSAGEBOX('IVA CV '~Val(ci:11))
*MESSAGEBOX('Com Total '~Val(sa:3)~' - IVA '~Val(ci:1))
