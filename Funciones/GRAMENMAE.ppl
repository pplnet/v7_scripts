SQL.ADD(" Insert into "~DBO~".MENSAJESMAE ( ")
SQL.ADD(" Codigo, FechaMAE, HoraMAE, Secuencia, CodigoMAE, Estado, Mensaje1, ")
if NoVacio(Val(t:8))
  SQL.ADD(" Mensaje2, ")
endif
if NoVacio(Val(t:9))
  SQL.ADD(" Mensaje3, ")
endif
SQL.ADD(" Fecha ")
SQL.ADD(" ) Values ( ")
SQL.ADD(" '"~Val(t:1)~"', ")
SQL.ADD(" '"~Val(t:2)~"', ")
SQL.ADD(" '"~Val(t:3)~"', ")
SQL.ADD(" '"~Val(t:4)~"', ")
SQL.ADD(" '"~Val(t:5)~"', ")
SQL.ADD(" '"~Val(t:6)~"', ")
SQL.ADD(" '"~Val(t:7)~"', ")
if NoVacio(Val(t:8))
  SQL.ADD(" '"~Val(t:8)~"', ")
endif
if NoVacio(Val(t:9))
  SQL.ADD(" '"~Val(t:9)~"', ")
endif
SQL.ADD(" '"~IdxDate(FSYS)~"' ")
SQL.ADD(" ) ")
SQL.NEW
SQL.EXEC
