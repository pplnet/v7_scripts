Corredor       : 'Corredor'          ;1;1;2;;;
ContraEspecie2 : 'Moneda Comision'   ;2;1;2;;;Eqstr(CONTRAESPECIE2,ESPECIE) O Eqstr(CONTRAESPECIE2,CONTRAESPECIE);'La Moneda de la comision debe ser '~ESPECIE~' o '~CONTRAESPECIE;NO;;CONTRAESPECIE;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;
TCComCor1      : 'TC'                ;2;2;2;Not Eqstr(CONTRAESPECIE2,ESPECIE) Y Not Incluido(VEHICULO1,VAR('VEHIEXTRAN'));Not Incluido(VEHICULO1,VAR('VEHIEXTRAN'));;;;;IF(Not Eqstr(CONTRAESPECIE2,ESPECIE),PRECIO1,1);
TipoCambio2    : 'Cot.Comision'      ;3;2;2;NO;NO;;;;;IF(Not Eqstr(CONTRAESPECIE2,ESPECIE),CotizacionC(ESPECIE,,,,FECHAOP,1,SI,CONTRAESPECIE2),1);;

CB11           : 'Importe fijo'      ;4;1;2;;
ImpComCor1     : 'Imp.Comision'      ;4;2;2;  ;CB11=1;;;;;IF(CB11=0,0);
ImpComCorEq1   : 'Importe Eq.'       ;5;2;2;NO;CB11=1;;;;;IF(Not Incluido(VEHICULO1,VAR('VEHIEXTRAN')),IMPCOMCOR1*TCCOMCOR1,IMPCOMCOR1);;
CB12           : 'Porcentaje'        ;7;1;2;;
ImpComCor2     : 'Imp.Comision'      ;7;2;2;NO;CB12=1;;;;;IF(Not Incluido(VEHICULO1,VAR('VEHIEXTRAN')), CANTIDAD, IF(Eqstr(CONTRAESPECIE2,ESPECIE), CANTIDAD, TOTALBRUTOCLI1))*(PORCOMCOR1/100)
PorComCor1     : '% Comision'        ;8;1;2;;CB12=1;;;;;IF(CB12=0,0,IF(MODI,PORCOMCOR1,BuscarCampo('CORREDORES','ComisionDefault1','Codigo',CORREDOR)));
ImpComCorEq2   : 'Importe Eq.'       ;8;2;2;NO;CB12=1;;;;;IF(Not Incluido(VEHICULO1,VAR('VEHIEXTRAN')),IMPCOMCOR2*TCCOMCOR1,IMPCOMCOR2);

ImpComMer1     : 'Total Com.'        ;9;2;2;NO;CB11=1 O CB12=1;;;;;IMPCOMCOREQ1+IMPCOMCOREQ2;

ImpGastos2     : '% Tasa IVA'        ;11;1;2;  ;Not Incluido(VEHICULO1,VAR('VEHIEXTRAN')) Y [CB11=1 O CB12=1];Incluido(Fstr(IMPGASTOS2,2,2),VAR('IVA'));"El % de Tasa IVA de Comision Corredor es Erroneo: "~VAR('IVA');NO;VAR('TASAIVA');IF(Incluido(VEHICULO1,VAR('VEHIEXTRAN')),0,VAR('TASAIVA'));;;;;'###.#####'
TotalIVA       : 'Imp. IVA'          ;11;2;2;NO;Not Incluido(VEHICULO1,VAR('VEHIEXTRAN')) Y [CB11=1 O CB12=1];[TOTALIVA<= ROUND((IMPCOMMER1*IMPGASTOS2/100)*(1+Var('PORVAR')/100),2) y TOTALIVA >= ROUND((IMPCOMMER1*IMPGASTOS2/100)*(1-Var('PORVAR')/100),2)];'Importe IVA Fuera de Rango: '~Fstr(ROUND((IMPCOMMER1*IMPGASTOS2/100)*(1-Var('PORVAR')/100),2),0,2)~' y '~Fstr(ROUND((IMPCOMMER1*IMPGASTOS2/100)*(1+Var('PORVAR')/100),2),0,2);NO;0;(IMPCOMMER1*IMPGASTOS2)/100;;;;;'###,###,###,###.##';






