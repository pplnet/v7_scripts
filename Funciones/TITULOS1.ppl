IF Dialogo.Radio2=0
   ACT(a:5, 'Vehiculo: '~Dialogo.Vehiculo1)
ELSE
   IF Dialogo.Radio2=1
      ACT(a:5, 'Vehiculo: Todos')
   ELSE
      ACT(a:5, 'Vehiculo: '~Pipe2coma(Dialogo.Lista1))
   ENDIF
ENDIF
IF Dialogo.Radio3=0
   ACT(a:6, 'Producto: '~Dialogo.Producto1)
ELSE
   IF Dialogo.Radio3=1
      ACT(a:6, 'Producto: Todos')
   ELSE
      ACT(a:6, 'Producto: '~Pipe2coma(Dialogo.Lista2))
   ENDIF
ENDIF
IF Dialogo.Radio4=0
   ACT(a:7, 'GrupoEspecie: '~Dialogo.GrupoEspecie1)
ELSE
   IF Dialogo.Radio4=1
      ACT(a:7, 'GrupoEspecie: Todos')
   ELSE
      ACT(a:7, 'GrupoEspecie: '~Pipe2coma(Dialogo.Lista3))
   ENDIF
ENDIF
IF Dialogo.Radio5=0
   ACT(a:8, 'TipoNegocio: '~Dialogo.TipoNegocio1)
ELSE
   IF Dialogo.Radio5=1
      ACT(a:8, 'TipoNegocio: Todos')
   ELSE
      ACT(a:8, 'TipoNegocio: '~Pipe2coma(Dialogo.Lista4))
   ENDIF
ENDIF
IF Dialogo.Radio6=0
   ACT(a:9, 'Especie: '~Dialogo.Especie1)
ELSE
   IF Dialogo.Radio6=1
      ACT(a:9, 'Especie: Todos')
   ELSE
      ACT(a:9, 'Especie: '~Pipe2coma(Dialogo.Lista7))
   ENDIF
ENDIF
IF Dialogo.Radio7=0
   ACT(a:10, 'TipoPosicion: '~Dialogo.TipoPosicion1)
ELSE
   IF Dialogo.Radio7=1
      ACT(a:10, 'TipoPosicion: Todos')
   ELSE
      ACT(a:10, 'TipoPosicion: '~Pipe2coma(Dialogo.Lista5))
   ENDIF
ENDIF
IF Dialogo.Radio8=0
   ACT(a:11, 'Responsable: '~Dialogo.Responsable1)
ELSE
   IF Dialogo.Radio8=1
      ACT(a:11, 'Responsable: Todos')
   ELSE
      ACT(a:11, 'Responsable: '~Pipe2coma(Dialogo.Lista6))
   ENDIF
ENDIF
IF Dialogo.Radio9=0
   ACT(a:12, 'Book: '~Dialogo.Book1)
ELSE
   IF Dialogo.Radio9=1
      ACT(a:12, 'Book: Todos')
   ELSE
      ACT(a:12, 'Book: '~Pipe2coma(Dialogo.Lista8))
   ENDIF
ENDIF
IF Dialogo.Check1 = 1
   ACT(a:13, 'Por Tipo de Book: SI')
   IF Dialogo.Check2 = 1
      ACT(a:13, Val(a:13)~' - Intraday')
   ENDIF
   IF Dialogo.Check3 = 1
      ACT(a:13, Val(a:13)~' - OverNigth')
   ENDIF
   IF Dialogo.Check4 = 1
      ACT(a:13, Val(a:13)~' - Funding')
   ENDIF
   IF Dialogo.Check5 = 1
      ACT(a:13, Val(a:13)~' - Pos.Taking')
   ENDIF
   IF Dialogo.Check6 = 1
      ACT(a:13, Val(a:13)~' - Relative')
   ENDIF
   IF Dialogo.Check7 = 1
      ACT(a:13, Val(a:13)~' - Brokerage')
   ENDIF
ELSE
   ACT(a:13, 'Por Tipo de Book: NO')
ENDIF
