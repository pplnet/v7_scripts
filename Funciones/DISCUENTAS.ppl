*-Numero consecutivo de Operaciones
ACT(z1,GetNumerador(1))
                     
*- Monto Bruto                
If Eqstr(FBN['InteresesC'],'CLE')
   ACN(mv1, Val(pr:1)*Val(ca:1)*(ValorTeorico2(Val(e:1),Val(fe:2))+IntsCapitalizados2(Val(e:1),Val(fe:2))) )
else 
   ACN(mv1, Val(pr:1)*Val(ca:1))
Endif

*- Resolucion 1585
ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', Val(e1)))                               

* --- A la funcion InteresEspecie le paso VN con el factor de cap incluido --- *
ACN(cf:1, (ValorTeorico2(Val(e:1),Val(fe:2))+IntsCapitalizados2(Val(e:1),Val(fe:2)))/ValorTeorico2(Val(e:1),Val(fe:2)))
ACN(cf:2, Val(ca:2)*Val(cf:1))
**ACN(ti:1, InteresEspecie(val(e1),val(fo1),val(ca1)))
ACN(ti:1, InteresEspecie(val(e1),Val(fo1),Val(cf:2)) )
* --- Pasa Interes a ContraEspecie --- *
If Not Eqstr(fbn('ContraEspecie'),CotizaEn(fbn('Especie')))
   ACN(ti:1, Val(t:1)*COTIZACIONC(CotizaEn(fbn('Especie')),,,,Val(fe:1)-1,1,SI,fbn('ContraEspecie')) )
Endif
* ---------------------------------------------------------------------------- *

* Tasa de Interes de cap del cupon
ACN(tc:17, CampoAgenda(fbn('Especie'),FStr(NrCupon2(FBN['Especie'],Val(fe:2)),0,0),4) )

* Intereses Capitalizado
ACD(t:12, UltCupon2(fbn('Especie'),Val(fe:2)))
ACN(ta:17,(ValorTeorico2(fbn('Especie'),Val(fe:2))+IntsCapitalizados2(fbn('Especie'),Val(fe:2)))*Val(ct:2)*Val(tc:17)/DiasA(EspecieDiasAnio(fbn('Especie')),Val(fe:2))/100*iif(EspecieDiasAnio(fbn('Especie'))=0 y EspecieDiasMes(fbn('Especie'))=0,Dif360(Val(t:12),Val(fe:2),2),DifDias(Val(t:12),Val(fe:2),'USA',NO)))

* Pasa a contraespecie el interes en capitalizado
*ACT(WW1, CotizaEn(fbn('Especie')))
*messagebox(fbn('ContraEspecie')~' '~Val(ww1))
If Not Eqstr(fbn('ContraEspecie'), CotizaEn(fbn('Especie')))
*messagebox('1')
   ACN(ta:17, Val(ta:17)*COTIZACIONC(CotizaEn(fbn('Especie')),,,,Val(fe:1)-1,1,SI,fbn('ContraEspecie')) )
Endif

* Le aplica el precio al interes capitalizado
ACN(ta:17, Val(ta:17)*fbn('PrecioReal'))

* Le sumo al interes cash, el interes capitalizado. Ya esta todo en la misma moneda.
ACN(ti:1, Val(ti:1) + Val(ta:17))
* ---------------------------------------------------------------------------- *

           
*- Monto Neto
If Incluido(Val(al4), '1585')
   ACN(mn1, Val(mv1)+(Val(ti1)*Val(ca1)) )
Else
   ACN(mn1, Val(mv1)+Val(ti1))
Endif

*- Si la especie es Dirty Clean igualmente calculo los intereses
IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',Val(e1)),'CLE')
   ACN(ti:1,FBN['Impuestos'] )
EndIf

*- NroCupon Actual
ACT(z10, FStr(NrCupon2(FBN['Especie'],FBN['FechaVto']),0,0))

*- Aquellas operaciones que provienen de certificados de Tenencia se 
*- ingresan liquidadas y no actualizan ni posiciones ni limites
ACN(oc1,0)
SQL.ADD("SELECT 1 FROM "~DBO~".CERTIFICADOSTENENCIA WHERE NrOrden='"~FBN['NrOrden']~"' ")

Recorrer SQL
  dfa
  ACN(oc1,1)
Proximo


