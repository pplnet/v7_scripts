SQL.ADD("SELECT S1.Especie, E.Nombre ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK) INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK)")
SQL.ADD("           ON S1.Cliente = C.Codigo ")
SQL.ADD("     INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("           ON E.Codigo = S1.Especie ")
SQL.ADD("     INNER JOIN "~DBO~".CUENTAS CU WITH (NOLOCK) ")
SQL.ADD("           ON CU.Codigo = S1.Cuenta ")
SQL.ADD("     INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("           ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
SQL.ADD("WHERE S1.EnteCustodia = '"~VAR('VEHICULODE')~"' AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre ")
SQL.ADD("UNION ")
SQL.ADD(" SELECT DISTINCT P.Especie, E.Nombre  ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
SQL.ADD(" AND   "~DBO~".DesciendedeEspecie(P.Especie,'TITULO')=1 ")
SQL.ADD(" AND   P.NrSaldo IN (121,171,191) ")
SQL.ADD(" AND   P.Especie <> '"~VAR('MONELOCA')~"' ")
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon        OR ((P1.Cupon      IS NULL OR P1.Cupon      ='' OR P1.Cupon   =' '    ) AND (P.Cupon      IS NULL OR P.Cupon      ='' OR P.Cupon      =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector       OR ((P1.Sector     IS NULL OR P1.Sector     ='' OR P1.Sector  =' '    ) AND (P.Sector     IS NULL OR P.Sector     ='' OR P.Sector     =' ' )) )  ")
SQL.ADD("                   AND   (P1.Estrategia = P.Estrategia OR ((P1.Estrategia IS NULL OR P1.Estrategia ='' OR P1.Estrategia  =' ') AND (P.Estrategia IS NULL OR P.Estrategia ='' OR P.Estrategia =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut      OR ((P1.CallPut    IS NULL OR P1.CallPut    ='' OR P1.CallPut =' '    ) AND (P.CallPut    IS NULL OR P.CallPut    ='' OR P.CallPut    =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj      OR ((P1.FechaEj    IS NULL OR P1.FechaEj    ='' OR P1.FechaEj =' '    ) AND (P.FechaEj    IS NULL OR P.FechaEj    ='' OR P.FechaEj    =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj     OR ((P1.PrecioEj   IS NULL OR P1.PrecioEj   ='' OR P1.PrecioEj=' '    ) AND (P.PrecioEj   IS NULL OR P.PrecioEj   ='' OR P.PrecioEj   =' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY 1 ")

