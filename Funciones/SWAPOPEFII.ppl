*******************************************************************************************
***---Swaps Multiples Vto.
***---Datos Vehiculo
SQL.ADD(" Select C.Cantidad1 Cantidad, C.Precio1 Tasa,  0 SpreadC, C.Fecha1 FechaOp, ")
SQL.ADD(" C.Fecha2 FechaVto, O.TipoOp, C.Total3 Spread, P.RB8, 0 TotalComisiones, ")
SQL.ADD(" 0 PeriodoInts, 'SWAP' Tipo, O.NrOperacion, P.Especie,P.NrOperacion OpSwap ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where P.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.NrOperacion = '"~Val(eb2)~"' ")
SQL.ADD(" AND O.TipoOp = '"~Val(eb1)~"' ")
SQL.ADD(" AND P.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD(" AND C.Cantidad1 > 0 ")
SQL.ADD(" AND P.OperacionRef = O.NrOperacion ")

SQL.ADD(" UNION ")

***---Datos ContraParte
SQL.ADD(" Select -C.Cantidad2 Cantidad, C.Precio2 Tasa, 0 SpreadC, C.Fecha5 FechaOp, ")
SQL.ADD(" C.Fecha6 FechaVto, O.TipoOp, C.Total4 Spread, P.RB5 RB8, 0 TotalComisiones, ")
SQL.ADD(" 0 PeriodoInts, 'SWAP' Tipo, O.NrOperacion, P.ContraEspecie Especie,P.NrOperacion OpSwap ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where P.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND C.Fecha5 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha6 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.NrOperacion = '"~Val(eb2)~"' ")
SQL.ADD(" AND O.TipoOp = '"~Val(eb1)~"' ")
SQL.ADD(" AND P.TipoOp IN ('DTSFFM','DTSFVM','DTSVVM') ")
SQL.ADD(" AND C.Cantidad2 > 0 ")
SQL.ADD(" AND P.OperacionRef = O.NrOperacion ")

SQL.ADD(" UNION ")

*******************************************************************************************
***---Swaps Unico Vto.
***---Datos Vehiculo
SQL.ADD(" Select O.Cantidad, O.Precio3 Tasa,  0 SpreadC, O.FechaOp2 FechaOp, ")
SQL.ADD(" O.FechaEj FechaVto, O.TipoOp, O.Spread, P.RB8, 0 TotalComisiones, ")
SQL.ADD(" 0 PeriodoInts, 'SWAP' Tipo, O.NrOperacion, P.Especie,P.NrOperacion OpSwap ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where P.OperacionRef = O.NrOperacion ")
SQL.ADD(" AND O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.NrOperacion = '"~Val(eb2)~"' ")
SQL.ADD(" AND O.TipoOp = '"~Val(eb1)~"' ")
SQL.ADD(" AND P.TipoOp IN ('DTSFF','DTSFV','DTSVV') ")
SQL.ADD(" AND O.Cantidad > 0 ")

SQL.ADD(" UNION ")

***---Datos ContraParte
SQL.ADD(" Select -O.TotalBrutoCli1 Cantidad, O.TotalGanancias Tasa, 0 SpreadC, O.FechaOp2 FechaOp, ")
SQL.ADD(" O.FechaEj FechaVto, O.TipoOp, O.TotalNetoCli2 Spread, P.RB5 RB8, 0 TotalComisiones, ")
SQL.ADD(" 0 PeriodoInts, 'SWAP' Tipo, O.NrOperacion, P.ContraEspecie Especie,P.NrOperacion OpSwap ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where P.OperacionRef = O.NrOperacion ")
SQL.ADD(" AND O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaEj > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.NrOperacion = '"~Val(eb2)~"' ")
SQL.ADD(" AND O.TipoOp = '"~Val(eb1)~"' ")
SQL.ADD(" AND P.TipoOp IN ('DTSFF','DTSFV','DTSVV') ")
SQL.ADD(" AND O.TotalBrutoCli1 > 0 ")

