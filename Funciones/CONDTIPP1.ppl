CONDICIONES:
Not EqStr('DES',BuscarCampo('ESPECIES','Status','Codigo',ESPECIE));'La Especie est  deshabilitada';NO

[EqStr(CUPON1,'0')] o [VACIO(CUPON1) o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC4>FECHAOP];'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC4~') ';SI 

Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO

[RB6=1 y Not EqStr(CLIENTE1,VEHICULO1)] o [RB6=0 y EqStr(CLIENTE1,VEHICULO1)]           ;'Debe Ingresar un Cliente Valido'  ;SI
Not EqStr('DES',BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
[FECHAMADURACION(ESPECIE) >= FECHAOP y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'El Cupon ya fue pagado';NO
[NOT NOVACIO(CLIENTE1)] o Precio3<>0;'Tasa cero.';SI;SI;FSYS;'RPTASACERO'
Not [DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') y CANTIDAD<BuscarCampo('ESPECIES','VolumenMinimo','Codigo',ESPECIE)];'La Cantidad no puede ser inferior al Volumen Minimo.';NO 
[BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)<>0 y [CANTIDAD  Mod2(BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE))=0]] o BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)=0;'La Cantidad debe ser Multiplo de Lamina Minima.';NO 
Vacio(CORREDOR) o COMISION<=PRECIO3;'La ComisiOn NO debe SUPERAR la estipulada.' ; SI

Vacio(UsrVehiculos(USUARIOACTIVO)) o Incluido(VEHICULO1,UsrVehiculos(USUARIOACTIVO));'El Operador no puede operar con el Vehiculo elegido.' ; NO
Vacio(Var('LE'~Copy(USUARIOACTIVO,1,8))) o Incluido(Ascendientes('ESPECIES',ESPECIE),Var('LE'~Copy(USUARIOACTIVO,1,8)),1);'El Operador no puede operar con la Especie elegida.' ; NO

Not Eqstr(BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado), 'M');'Ingreso una Casa Cust. de Moneda para la Casa Cust. de Especie.' ;NO 

HEnBanda('MAE', Copy(Hora(Ahora),1,5));'Esta Operacion No sera informada Hoy al MAE, Horario de Concertacion INCORRECTO.';SI
VCAN1=0 o [Not Incluido(Mercado,VAR('MERCARGC')) y VCAN1=1];'No Puede Liquidar por ArgenClear un Cliente !!!';NO

PRECIO1<=VPRE15*(1+VAR('RPRECIO2')/100) Y PRECIO1>=VPRE15*(1-VAR('RPRECIO2')/100);'Precio Spot Fuera de Rango: '~FSTR(VPRE15*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE15*(1+VAR('RPRECIO2')/100),1,7);SI;SI;Fsys;'RANGOPRECIOSPOT'
PRECIO2<=VPRE15*(1+VAR('RPRECIO2')/100) Y PRECIO2>=VPRE15*(1-VAR('RPRECIO2')/100);'Precio Futuro Fuera de Rango: '~FSTR(VPRE15*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE15*(1+VAR('RPRECIO2')/100),1,7);SI;SI;Fsys;'RANGOPRECIOFUT'


Not Eqstr(CLIENTE1, VEHICULO1);'El Cliente no Puede ser el Vehiculo.';NO;

DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') o NoVacio(BuscarCampo('AGENDACUPONES','Especie','Especie',ESPECIE));'Falta Actualizar la Agenda para este Titulo.';SI

FechaOp=FSYS;'Operacion Ingresada con Fecha Valor.';SI;SI;FSYS;'FVALOR'

[NOT NOVACIO(CLIENTE1)] o ExisteLimite('PRESETTLEM',VTXT11,'USD',Vehiculo1)    ; 'Presettlement no asignado';SI;SI;FSYS;'PRESETNOAS'
[NOT NOVACIO(CLIENTE1)] o Not LimCancelado('PRESETTLEM',VTXT11,'USD',Vehiculo1); 'Presettlement cancelado'  ;SI;SI;FSYS;'PRESETCANC'
[NOT NOVACIO(CLIENTE1)] o LimAsignado(VTXT11,'PRESETTLEM','USD',Vehiculo1) > TotalAux2+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion); 'Presettlement excedido en U$D '~PYC(ABS(MINDERECHOBOLSA),1,0)~'.-';SI;SI;FSYS;'PRESETEXCE'

[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1 y FormaLiquidacion2=1] o ExisteLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1)    ; 'Settlement no asignado' ;SI;SI;FSYS;'SETTLENOAS'
[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1 y FormaLiquidacion2=1] o Not LimCancelado('SETTLEMENT',VTXT11,'USD',Vehiculo1); 'Settlement cancelado'   ;SI;SI;FSYS;'SETTLECANC'
[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion1=1] o LimAsignado(VTXT11,'SETTLEMENT','USD',Vehiculo1) >= LIMSUMADO(VTXT11,'SETTLEMENT',FECHAPAGO,VEHICULO1,,,NROPERACION)+VCAN10; 'Settlement Spot excedido en U$D '~PYC(ABS(MINDERECHOMERCADO),1,0)~'.-'  ;SI;SI;FSYS;'SETTLEEXCE'
[NOT NOVACIO(CLIENTE1)] o [FormaLiquidacion2=1] o LimAsignado(VTXT11,'SETTLEMENT','USD',Vehiculo1) >= LIMSUMADO(VTXT11,'SETTLEMENT',FECHAVTO2,VEHICULO1,,,NROPERACION)+VCAN9 ; 'Settlement Futuro excedido en U$D '~PYC(ABS(PORDERECHOMERCADO),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

VCAN1=1 o [FormaLiquidacion1<>1] o MinArancel     >=0;'Excede el limite de Monto '~MERCADO~' al '~FECHAPAGO~' en '~PYC(Abs(MinArancel),0,2)      ;SI;SI;FECHAOP ;'MAX'~MERCADO~'EXC';'Excede Monto '~MERCADO~' Spot al '~FECHAPAGO~' en '~PYC(Abs(MinArancel),0,2)
VCAN1=1 o [FormaLiquidacion2<>1] o PorDerechoBolsa>=0;'Excede el limite de Monto '~MERCADO~' al '~FECHAVTO2~' en '~PYC(Abs(PorDerechoBolsa),0,2) ;SI;SI;FECHAOP ;'MAX'~MERCADO~'EXC';'Excede Monto '~MERCADO~' Futuro al '~FECHAVTO2~' en '~PYC(Abs(PorDerechoBolsa),0,2)

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB' );'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO


DEVENGADOS
FechaOp  ;FechaVto-1 ;SI;NO;SI;'ARG';SI;NO;'TIDEV';-VPRE13;200;Vehiculo1;Vehiculo1;;;;;;;;ContraEspecie;;;;;;Book1;;;;;Especie;0;-TOTALCAUCION;TASAPRECAN;IF(Eqstr(DIASANIO,'0'),360,365)


