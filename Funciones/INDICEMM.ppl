TipoGracia     : 'TipoIndice'              ;7;2;2;NO;NO;;;;;BuscarCampo('ESPECIES','TipoIndice','Codigo',INDICE);
Indice         : 'Indice'                  ;8;2;2;Not EV;;;;;;;;;;;;" "~DBO~".DESCIENDEDEESPECIE(Codigo,'INDICE') = 1 ";
ContraEspecie6 : 'Moneda_Indice'           ;9;2;2;NO;NoVacio(INDICE);Vacio(INDICE) O NoVacio(CONTRAESPECIE6);'Moneda del Indice Invalida';NO;;CotizaEn(INDICE);
CantidadOri    : 'VN Original'             ;10;2;2;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'CAP');;;;IF(COEFICIENTE=0,CANTIDAD,CANTIDADORI);IF(COEFICIENTE=0,CANTIDAD,CANTIDADORI);;;;;'###,###,###,###.##'
Coeficiente    : 'Coeficiente'             ;11;2;2;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'CAP');;;;0;;;;;'###.########'
Plazo2         : 'Dias Precio'             ;11;2;2;Eqstr(TIPOGRACIA, 'ULK');Eqstr(TIPOGRACIA, 'ULK');;;;;IF(Eqstr(TIPOGRACIA, 'ULK'),BuscarCampo('ESPECIES','Valor6','Codigo', INDICE), 0);
Precio6        : 'PrecioIni'               ;12;2;2;NO;NoVacio(INDICE) Y Incluido(TIPOGRACIA, 'ULK|CUP');;;;0;COTIZACION(INDICE,,,,Habiles(FECHAOP2,-PLAZO2,TABLAFERIADOS1,SI),1,SI);;;;'###.########'
TotalAux7      : 'CuotasPartes'            ;13;2;2;NO;Eqstr(TIPOGRACIA, 'CUP');;;;;CANTIDAD/PRECIO6;;;;;'###,###,###,###.##'
Precio7        : 'PrecioFin'               ;14;2;2;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'CUP');;;;0;COTIZACION(INDICE,,,,Habiles(FECHAVTO,-PLAZO2,TABLAFERIADOS1,SI),1,SI);;;;'###.########'
ResultadoIndice: 'Resul Indice'            ;17;2;2;NO;NoVacio(INDICE) y RESULTADOINDICE<>0 Y Incluido(TIPOGRACIA, 'CAP|CUP');;;;CANTIDAD;IF(Eqstr(TIPOGRACIA, 'CAP'), CANTIDAD, TOTALAUX7 * (PRECIO7-PRECIO6));;;;;'###,###,###,###.##'
ContraEspecie5 : 'Moneda Liq'              ;13;2;2;NO;Eqstr(TIPOGRACIA, 'ULK');;;;;IF(Eqstr(TIPOGRACIA, 'ULK'), CONTRAESPECIE6);
TotalAux5      : 'VN Link'                 ;14;2;2;NO;Eqstr(TIPOGRACIA, 'ULK');;;;;CANTIDAD * PRECIO6;
TotalAux6      : 'Prima/Dto Link'          ;15;2;2;NO;Eqstr(TIPOGRACIA, 'ULK') Y Eqstr(TIPOOP, 'MMONM');;;;;IIF(Eqstr(TIPOOP, 'MMONM') THEN TOTALDERECHOS * PRECIO6 ELSE 0 ENDIF);

NrComis   : 'Nr_Comisiones'      ;;3;;VACIO(OPERACIONREF);SI;NRCOMIS>=0;'Debe ingresar la Cantidad de Comisiones';NO;0;;;;;;'###'
