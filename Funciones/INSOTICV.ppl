INSTANCIA4
CAMPOS:0
Especie               : 'Especie'        ;1;1;1;Not EV y [Vacio(ESPECIE) o MODI];  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y  EsTerminal(ESPECIE, Especie);'Debe Ingresar una Especie Valida';NO;;;;Var('LE'~USUARIOACTIVO);;;;"Status Like 'HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' AND Jerarquia Not Like '"~Jerarquia('ESPECIES','ACCION')~"%' ";
VTXT9                 : 'Especie 2'      ;1;2;1;NO;NoVacio(VTXT9);;;;BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',ESPECIE));BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',ESPECIE));;;;;'######';
Cliente               : 'Cliente'        ;2;1; ;[Not EV y VACIO(CLIENTE)] O [EqStr(CLIENTE,'SIOPEL') o Vacio(CLIENTE) o MODI];  ;NoVacio(CLIENTE) y Incluido(Ascendientes('CLIENTES', CLIENTE),VAR('CLIORDEN'),1) y EsTerminal(CLIENTE,Cliente) y EqStr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE),'HAB');'El Cliente no es valido.';NO;;;;;;;;
CantidadTotalOrden    : 'Cantidad VN'    ;3;1; ;NO
PrecioLimite          : 'Precio Limite'  ;4;1; ;NO;;;;;;;;;;;'####.########';
FechaOrden            : 'Fecha Orden'    ;5;1; ;NO
FechaVto              : 'Fecha Liq.'     ;5;2; ;NO;  ;;;;
Lotes                 : 'Plazo'          ;6;1; ;NO;
RB5                   : 'Plazo|'~VAR('PLAZOLIQ') ;6;2;;NO;

ContraEspecie         : 'ContraEspecie'  ;7;1; ;NO
Mercado3              : 'Merc. Neg.'     ;9;1; ;NO;
Mercado               : 'Merc.Liq.Esp.'  ;10;1; ;NO;
Mercado2              : 'Merc.Liq.Mon.'  ;11;1; ;NO
Book1                 : 'Book'           ;12;1; ;NO;
Vehiculo              : 'Vehiculo '      ;13;1; ;NO;
Operador              : 'Operador '      ;14;1; ;NO;
AfectaLS              : 'Afecta'         ;15;1; ;NO


CONDICIONES:
EV o EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La especie No esta Habilitada';NO
EV o [FECHAMADURACION(ESPECIE) >= FECHAORDEN y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'La especie esta vencida';SI;SI;FSys;'CUPONPAG'
EV o [EqStr(CUPON1,'0')] o [VACIO(CUPON1) o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC4>FECHAOP];'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC4~') ';SI;SI;FSys;'CUPONANT'
EV o Habiles(PROXCUPON(ESPECIE,FECHAORDEN),-3,'ARG') <> FECHAORDEN ;'Antes de cargarse la operacion debe realizarse el corte de cupon correspondiente';SI;SI;FSys;'CUPONPROX'
EV o ProxCupon(ESPECIE,FECHAORDEN) <> FSYS ;'Antes de cargarse la operacion debe realizarse el corte de cupon correspondiente';SI;SI;FSys;'CUPONPROX'
EV o DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') o NoVacio(BuscarCampo('AGENDACUPONES','Especie','Especie',ESPECIE));'Falta Actualizar la Agenda para este Titulo';SI
EV o Not [DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') y CANTIDAD<BuscarCampo('ESPECIES','VolumenMinimo','Codigo',ESPECIE)];'La Cantidad no puede ser inferior al Volumen Minimo';NO 
EV o [BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)<>0 y [CantidadTotalOrden  Mod2(BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE))=0]] o BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)=0;'La Cantidad debe ser Multiplo de Lamina Minima';NO
EV o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente),'HAB');'El Cliente No esta Habilitado';NO

