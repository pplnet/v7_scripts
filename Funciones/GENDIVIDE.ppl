**- Genera Transaccion de Dividendo 
*- bb9: bB9 Tipo de Transaccion Saldo/Posicion/Spot/Futuro
Message('Generando Operacion de Dividendo por Posiciones ')

SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 (")
SQL.ADD(" Especie, Fecha2, ")
SQL.ADD(" Fecha1, ")
SQL.ADD(" Especie2, ")
SQL.ADD(" Vehiculo1, ")
SQL.ADD(" TipoTr2, NrTrans, ")
SQL.ADD(" CB2, CB3,CB4,CB5,CB7,CB9, ")
SQL.ADD(" Precio1,Precio2,Cambio3,PrecioEj,")
SQL.ADD(" Cambio4,Especie3,Precio5,Precio3,Precio4, ")
SQL.ADD(" Cambio1,Especie4 ")
SQL.ADD(" ) VALUES (")
SQL.ADD(" '"~Dialogo.Especie1~"','"~IdxDate(Dialogo.Fecha1)~"', ")
SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"', ")
IF NoVacio(Dialogo.Especie2)
   SQL.ADD(" '"~Dialogo.Especie2~"', ")
Else 
   SQL.ADD(" '"~Dialogo.Especie1~"', ")
EndIf
SQL.ADD(" '"~Val(d:1)~"',")
SQL.ADD(" 'PDIVID', '"~Val(y:1)~"', ")
SQL.ADD(" '"~Fstr(Dialogo.Check1,0,0)~"','"~Fstr(Dialogo.Check2,0,0)~"','"~Fstr(Dialogo.Check3,0,0)~"','"~Fstr(Dialogo.Check4,0,0)~"','"~Fstr(Dialogo.Check2,0,0)~"','"~Fstr(Dialogo.Check3,0,0)~"',")
SQL.ADD(" "~Fstr(Dialogo.Precio1,0,8)~","~Fstr(Dialogo.Precio2,0,8)~","~Fstr(Dialogo.Precio9,0,8)~","~Fstr(Dialogo.Precio9,0,8)~",")
SQL.ADD(" "~Fstr(Dialogo.Precio10,0,8)~",'"~IIf(NoVacio(Dialogo.Especie3),Dialogo.Especie3,'')~"',"~Fstr(val(bg:1),0,8)~","~Fstr(Dialogo.Precio3,0,8)~","~Fstr(Dialogo.Precio4,0,8)~", ")
SQL.ADD(" "~Fstr(Val(PC:1),0,8)~",'"~IIf(NoVacio(Dialogo.Especie4),Dialogo.Especie4,'')~"' ")
SQL.ADD(" ) ")
SQL.NEW
SQL.EXEC
       
*- Alta en la Instancia nro. 4
ACT(az3,val(y:1))
ACT(az4,'TRANSACCIONES2')
ACT(az5,'4|')

(.'ALTAINSTAN'.)

