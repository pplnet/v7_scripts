VCAN21: 'Excep.F.Valor'; 2;1;1;NO;SI;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ")
VCAN22: 'Excep.Precio' ; 3;1;1;NO;SI;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'RANGOPRECI' ")
