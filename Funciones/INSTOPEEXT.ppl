VCAN25: 'Excep.Parking'; 5;1;1;NO;SI;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'SALDOPARK' ")
VCAN26: 'Control DDJJ' ; 6;1;1;NO;SI;;;;;if(EqStr(DDJJRequiere,'SI') y Not EqStr(DDJJPresentada,'SI'),1,0)
VCAN24: 'a Inst Contr' ; 7;1;1;NO;SI;;;;;IF(VCAN21+VCAN22+VCAN23+VCAN25+VCAN26>0,1,0)

VTXT19         : 'WF MAE reducido';7;1;1;NO;SI;;;;;IF(EqStr(BuscarCampo('VARIABLES','Valor','Codigo','WFMAEREDU'),'SI'),'SI','NO');;;;;'XX';

Especie        : 'Especie'       ; 7;2; ;NO
Cliente1       : 'Cliente'       ; 1;2; ;NO
EnteCus2       : 'CodMAE Clie'   ; 2;2; ;NO;NoVacio(ENTECUS2)
VTXT12         : 'NrMAE'         ; 3;2; ;NO;SI;;;;;BuscarCampo('CLIENTES','NrMAE','Codigo',CLIENTE1)
CB5            : 'CB5 - Ofertas' ; 4;2;1;NO;SI;
CB7            : 'CB7 - No MAE'  ; 5;2;1;NO;SI;
CB8            : 'CB8 - MAE1'    ; 6;2;1;NO;SI;
DDJJRequiere   : 'Requiere DJ'   ; 7;2;1;NO;SI;
DDJJCodigo     : 'Codigo DJ  '   ; 8;2;1;NO;SI;
DDJJPresentada : 'Presentada DJ' ; 9;2;1;NO;SI;

CONDICIONES
FW = 2 o (NoVacio(CLIENTE1) y Not EqStr(CLIENTE1,'SIOPEL'));'Debe ingresar un cliente valido';NO
FW = 2 o EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El Cliente No esta Habilitado';NO
FW = 2 o NoVacio(ESPECIE);'Debe ingresar una especie valida';NO
FW = 2 o EqStr(BuscarCampo('Especies','Status','Codigo',ESPECIE),'HAB');'La especie No esta Habilitada';NO
FW = 2 o CB5 = 0 o EqStr(BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE),ENTECUS1);'El Codigo MAE de la especie ('~BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE)~') no coincide con el recibido del MAE ('~ENTECUS1~')';NO
FW = 2 o EQSTR(TRIM(VAR('CONTROLAPM')),'NO') o Incluido(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO|NE|  |');VAR('MSGSISEXT');NO
FW = 2 o EQSTR(TRIM(VAR('CONTROLAPM')),'NO') o Incluido(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO|SI');'Especie PME no informada';NO
FW <> 1 o VCAN25=0;'La Operacion va a Supervision Parking';SI;NO;
FW <> 1 o VCAN26=0;'La Operacion va a Control DDJJ';SI;NO;

POSTEDICION
FW = 1 y [MinDerechoBolsa>=0 y MinArancel>=0 y MinDerechoMercado>=0] y Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ")<>1 y CB8=1 y CB7<>1 y Vacio(NrBoleto);'ASIBOL';NrOperacion1=NROPERACION;
FW = 2 y CB5=0 y NOVACIO(BOOK1);'ANULO';NrOperacion1=NROPERACION

BAJA
Query(" Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~NROPERACION~"' ") <> 1;'No se puede dar de baja, tiene Movimientos Ejecutados';
CB5 = 0;'No se puede dar de baja, Proviene del MAE.';

