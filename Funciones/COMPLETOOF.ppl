    *****Blanqueo el Error
    act(er1,'')

    ***** Tipo Op
       if EqStr(Copy(Val(aa:2),6,3),VAR('AGESIOP'))
          ACT(w2, Copy(Val(aa:2),48,3))
          if EqStr(Copy(Val(aa:2),138,1),'2')
             ACT(t:1,'TIFV')
          else 
             ACT(t:1,'TIV')
          endif
       else
         if EqStr(Copy(Val(aa:2),48,3),VAR('AGESIOP'))
            ACT(w2, Copy(Val(aa:2),6,3))
            if EqStr(Copy(Val(aa:2),138,1),'2')
               ACT(t:1,'TIFC')
           else 
              ACT(t:1,'TIC')
           endif
       else
          act(er1,'Error en tipo de operacion')
        endif
     endif



    ***** Especie
    ACT(s2, 'Especie')
    ACT(w3, Copy(Val(aa:2), 33, 5))
    ACT(t2, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado='"~Val(w3)~"' "))
    **ACT(t2, Copy(Val(aa:2), 33, 5))
    if Vacio(Val(t2))
      act(er1,'Especie no encontrada: '~Val(w3))
    endif

    ***** Fecha Op)
    if EqStr(Copy(Val(aa:2),30,2), '05')
      ACT(xx1, Copy(Val(aa:2),15,2)~'/'~Copy(Val(aa:2),13,2)~'/'~Copy(Val(aa:2),11,2))
      ACT(xx2, Val(xx1)~' '~Copy(Val(aa:2),17,2)~':'~Copy(Val(aa:2),19,2)~':'~Copy(Val(aa:2),21,2))
      ACT(xx3, SQLFechaStr(Val(xx2),Exe('FORFECHOR')))
      ACD(t:8, Fecha(Val(xx1)))
    else
      act(er1,'Problema con fecha de op.')
    endif
        if  Not EqStr(Copy(Val(aa:2),91,1),'6') o EsHabil(Val(t8)+Num(Copy(Val(aa:2),42,3)),'USA')
            ACD(t31, Val(t8)+Num(Copy(Val(aa:2),42,3)))
        else
            ACD(t31, Habiles(Val(t8)+Num(Copy(Val(aa:2),42,3)),1,'USA'))
        endif
        ACN(t32, DifDias(Val(t8), Val(t31), 'USA', SI)*24)
     
    ***** Rueda
    ACT(ru:1, Copy(Val(aa:2),93,4))

    ***** Cliente
    ACN(w4, Num(Val(w2)))


    if Val(w4)=0  y EqStr(Val(ru1),'MAE1')
       ACT(t:3, 'MAE1')
    else
       if Val(w4)=0 o Val(w4)=VAR('AGESIOP')
          act(er1,'Problema con agente')
       else
          ***** Codigo Cliente
          ACT(t:3, SQL("Select Codigo From "~DBO~".CLIENTES Where NrMAE = "~FStr(Val(w4), 3, 0)))
          ***** Operador Contra
          ACT(t:4, Copy(Val(aa:2),51,2))
       endif
       if Vacio(Val(t:3))
          ACT(er1, 'Cliente inexistente NrMAE: '~Val(w2))
       endif
    endif
    **ACT(t:3, FStr(Val(w4), 3, 0))


     ***** Mercado
    if EqStr(Copy(Val(aa:2),91,1),'2')
      ACT(t:6, 'CRYL')
    else
      if EqStr(Copy(Val(aa:2),91,1),'3')
        ACT(t:6, 'CE')
      else
        if EqStr(Copy(Val(aa:2),91,1),'4')
          ACT(t:6, 'CE')
        else
          if Incluido(Copy(Val(aa:2),91,1),'5|8|9')
            ACT(t:6, 'CV')
          else
            if Incluido(Copy(Val(aa:2),91,1),'1|D|T|B')
              ACT(t:6, 'AC')
            else
              act(er1,'Problema con mercado')
            endif
          endif
        endif
      endif
    endif

    ***** Tabla Feriados
    if Incluido(Copy(Val(aa:2),91,1),'8')
      ACT(t:7, 'ARG')
    else
      if Incluido(Copy(Val(aa:2),91,1),'9|D')
        ACT(t:7, 'USA')
      else
        if Incluido(Copy(Val(aa:2),91,1),'T')
          ACT(t:7, 'ARGUSA')
        else
          if Incluido(Val(t:6),'CE|EU')
            ACT(t:7, 'USA')
          else
            if Incluido(Val(t:6),'CV|CRYL|AC')
              ACT(t:7, 'ARG')
            else
              act(er1,'Problema con tabla de feriados')
            endif
          endif
        endif
      endif
    endif

     ***** Plazo
    if Incluido(Val(w2),'TIC|TIV')
      ACN(t:9, Num(Copy(Val(aa:2),42,3))*24)
    else
      ACN(t:9, Num(Copy(Val(aa:2),42,3)))
    endif

    ***** Fecha Vto
    if EqStr(Copy(Val(aa:2),32,1),'9')
      ACD(t10, Val(t31))
    else
       ACD(t10,Val(t:8) + Num(Copy(Val(aa:2),42,3)))
    endif

    ***** Cantidad
    ACN(t:11, Num(Copy(Val(aa:2),53,18))/10000)
    if Val(t:11)=0
      act(er1,'Cantidad igual a cero')
    endif


    ***** Nro Cupon
    ACT(t:28, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(t:2)),1,0))

    ***** FechaUltCupon
    ACD(t:12, UltCupon(Val(t:2),Val(t:10)))
    if Not EsHabil(Val(t:12),'USA')
      ACD(t:12, Habiles(UltCupon(Val(t:2),Val(t:10)) , iif(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',Val(t:2)),'SIG'),1,iif(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',Val(t:2)),'ANT'),-1,0)) , 'USA'))
    endif

    ***** TasaInteresCupon
    ACD(t:13, BuscarCampo('ESPECIES','FechaCambioTasa','Codigo', Val(t:2)))
    ACN(t:14, BuscarCampo('ESPECIES','TasaIntVigente' ,'Codigo', Val(t:2)))
    ACN(t:15, BuscarCampo('ESPECIES','TasaIntAnterior','Codigo', Val(t:2)))
    ACN(t:16, iif(Val(t:13)   > Val(t:12) y Val(t:13)   <= Val(t:10) , ((Val(t:15) *iif(EspecieDiasAnio(Val(t:2))=0 y EspecieDiasMes(Val(t:2))=0,Dif360(Val(t:12),Val(t:13)-1,2),DifDias(Val(t:12),Val(t:13)-1,'USA',NO)))+(Val(t:14)*(iif(EspecieDiasAnio(Val(t:2))=0 y EspecieDiasMes(Val(t:2))=0, Dif360(Val(t:13)-1,Val(t:10),2),DifDias(Val(t:13)-1,Val(t:10),'USA',NO)))))/(iif(EspecieDiasAnio(Val(t:2))=0 y EspecieDiasMes(Val(t:2))=0, Dif360(Val(t:12) ,Val(t:10),2),DifDias(Val(t:12),Val(t:10),'USA',NO))) ,iif(Val(t:13)<= Val(t:12),Val(t:14),Val(t:15)))*100)

    ***** Intereses / Precio1 / TotalBrutoCli1
     * if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(t:2)),'CLE') y Not EqStr(BuscarCampo('ESPECIES','Alias8','Codigo',Val(t:2)),'NO')
     *  ACN(t:17, ValorTeorico(Val(t:2))*Val(t:11)* iif(Eqstr(BuscarCampo('ESPECIES','Capitaliza','Codigo',Val(t:2)),'SI'),BuscarCampo('ESPECIES','Valor10','Codigo',Val(t:2)) ,1)*Val(t:16)/DiasA(EspecieDiasAnio(Val(t:2)),Val(t:8))/100*iif(EspecieDiasAnio(Val(t:2))=0 y EspecieDiasMes(Val(t:2))=0,Dif360(Val(t:12),Val(t:10),2),DifDias(Val(t:12),Val(t:10),'USA',NO)))
     * if Eqstr(BuscarCampo('ESPECIES','Capitaliza','Codigo',Val(t:2)),'SI')
     *   */Intereses de Capitalizacion
     *   ACN(ta:17,ValorTeorico(Val(t:2))*Val(t:11)* BuscarCampo('ESPECIES','Valor10','Codigo',Val(t:2))*BuscarCampo('ESPECIES','IntsCapitalizados' ,'Codigo', Val(t:2))*100 /DiasA(EspecieDiasAnio(Val(t:2)),Val(t:8))/100*iif(EspecieDiasAnio(Val(t:2))=0 y EspecieDiasMes(Val(t:2))=0,Dif360(Val(t:12),Val(t:10),2),DifDias(Val(t:12),Val(t:10),'USA',NO)))
     *   ACN(tb:17,Val(t:17))
     * endif

      if Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',Val(t:2)),'DIR')
        ACN(t:18, (((Num(Copy(Val(aa:2),71,18))/100000000)*Val(t:11))-Val(t:17))/Val(t:11))
      else
        ACN(t:18, Num(Copy(Val(aa:2),71,18))/100000000)
      endif

      */Monto / Intereses
       *if Eqstr(BuscarCampo('ESPECIES','Capitaliza','Codigo',Val(t:2)),'SI')
       *   ACN(tx:19, (((Val(t:11) * BuscarCampo('ESPECIES','Valor10','Codigo',Val(t2))) +Val(ta:17) )*Val(t:18) ) + Val(tb:17))
       *   ACN(t:17, Val(tx:19) -(Val(t:11)*Val(t:18)))
       *endif
     *ACN(t:19, ValorTeorico(Val(t:2))*Val(t:11)*Val(t:18))

     */PrecioEj/Prec.SemiD
     * acn(tc17,iif(Eqstr(BuscarCampo('ESPECIES','Capitaliza','Codigo',Val(t2)),'SI') ,(BuscarCampo('ESPECIES','Valor10','Codigo',Val(t2)) + ((BuscarCampo('ESPECIES','IntsCapitalizados','Codigo',Val(t2)) * BuscarCampo('ESPECIES','Valor10','Codigo',Val(t2))*(iif(EspecieDiasAnio(Val(t:2))=0 y EspecieDiasMes(Val(t:2))=0,Dif360(Val(t:12),Val(t:10),2),    DifDias(Val(t:12),Val(t:10),'USA',NO)))/360)))*Val(t18),Val(t18)))

      *ACN(u17, Val(t17))

      *if Incluido(BuscarCampo('ESPECIES','Alias4','Codigo',Val(t2)),'1585')
      *  ACN(t17, Val(t17) * Val(t18))
      *endif
    *else
    *  ACN(t:17, 0)
    *  ACN(t:18, Num(Copy(Val(aa:2),71,18))/100000000)
    *  ACN(t:19, Val(t:11)*Val(t:18))
    *  ACN(u17, Val(t17))
    *endif 


 
    ***** TotalNetoCli1
    ACN(t:20, Val(t:19)+Val(u:17))

    ***** Control Precio
    
    if Val(t:18)=0
      act(er1,'Precio cero')
    endif
 
    ***** Control Intereses
    if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(t:2)),'CLE')
      ACN(w5, Num(Copy(Val(aa:2),97,18))/100)
      if Val(t:17)-Val(w5)>1 o Val(t:17)-Val(w5)<-1
        act(er1,'Diferencia de Intereses con Siopel')
      endif
    endif

    ***** ContraEspecie
    if EqStr(Copy(Val(aa:2),45,1),'D')
      ACT(t:21, 'USD')
    else
      if EqStr(Copy(Val(aa:2),45,1),'$')
        ACT(t:21, 'ARP')
      else
        act(er1,'Error en moneda')
      endif
    endif

    ***** FormaLiquidacion
    if EqStr(Val(t:6),'CV')
      if EqStr(Copy(Val(aa:2),92,1),'2')
        ACN(t:22,0)
      else
        if EqStr(Copy(Val(aa:2),92,1),'1')
          ACN(t:22,1)
        else
          if EqStr(Copy(Val(aa:2),92,1),'6')
            ACN(t:22,2)
          else
            act(er1,'Error en forma de liquidacion')
            
          endif
        endif
      endif
      ACN(t:23,0)
    else
      if Incluido(Val(t:6),'CE|EU|CRYL|AC')
        ACN(t:22,0)
        if Incluido(Copy(Val(aa:2),92,1),'4')
          ACN(t:23,0)
        else
          if Incluido(Copy(Val(aa:2),92,1),'1|T')
            ACN(t:23,1)
          else
            if Incluido(Copy(Val(aa:2),92,1),'2|5')
              ACN(t:23,2)
            else
              act(er1,'Error en forma de liquidacion')
            endif
          endif
        endif
      else
        act(er1,'Mercado desconocido = problema con forma liq.')
      endif
    endif

    ***** Tipocambio
    if DesciendeDeEspecie(Val(t:2),VAR('IEP'))
      ACN(t:24, (1-Val(t:18))*36000/(BuscarCampo('ESPECIES','Fecha','Codigo',Val(t:2))-Val(t:10)))
    endif

    ***** PaseCB
    ACT(t:25, '0')

    ***** Operador
    if Incluido(Val(t1),'TIV|TIFV')
      ACT(t:26, Copy(Val(aa:2),51,2))
      ACT(t:27, BuscarCampo('USUARIOS', 'Codigo', 'NroSIOPEL', Copy(Val(aa:2),9,2)))
    else
      ACT(t:26, Copy(Val(aa:2),9,2))
      ACT(t:27, BuscarCampo('USUARIOS', 'Codigo', 'NroSIOPEL', Copy(Val(aa:2),51,2)))
    endif
    if Vacio(Val(t:27))
      ACT(t:27, UsuarioActivo)
        
    endif

    ***** NrOperacion MAE
    ACT(t:75, Copy(Val(aa:2),23,5))


    ***** Precio2 Y Precio3