if Val(ba:1)=1
  *------Leyenda del Comienzo
  If Not Incluido(Val(au:1), 'PABC|PABT|CBC|CBT') 
      if Incluido(fbn['TipoOp'],'CTP|CTC')
            act(ax:1,'Comprado')
      else
            act(ax:1,'Vendido')
      endif
 
      act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
      if Incluido(fbn['TipoOp'],'VTC|CTC')
         act(b:fac+1,Pad('',4)~Val(ax:1)~' en Rueda Continua de la Bolsa de Comercio de Buenos Aires, procediendo a liquidar el importe')
      else
         act(b:fac+1,Pad('',4)~Val(ax:1)~' en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a liquidar el importe')
      endif
      act(b:fac+2,Pad('',4)~'correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
  
  Else
      If Incluido(Val(au:1), 'PABC') 
         If Incluido(fbn['TipoOp'],'CTP')
             act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
             act(b:fac+1,Pad('',4)~'realizado un Pase Colocador_Compra en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
             act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
          else
             act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
             act(b:fac+1,Pad('',4)~'realizado un Pase Colocador_Venta en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
             act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
       
         Endif
      Endif
   
      If Incluido(Val(au:1), 'PABT') 
         If Incluido(fbn['TipoOp'],'VTP')
            act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
            act(b:fac+1,Pad('',4)~'realizado un Pase Tomador_Compra en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
            act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
         else
            act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
            act(b:fac+1,Pad('',4)~'realizado un Pase Tomador_Venta en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
            act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
        
         Endif
      Endif
  
      If Incluido(Val(au:1), 'CBT') 
         If Incluido(fbn['TipoOp'],'VTP')
            act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
            act(b:fac+1,Pad('',4)~'realizado una Caucion Tomadora_Compra en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
            act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
        
         else
            act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
            act(b:fac+1,Pad('',4)~'realizado una Caucion Tomadora_Venta en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
            act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
        
         Endif
      Endif
  
      If Incluido(Val(au:1), 'CBC') 
         If Incluido(fbn['TipoOp'],'CTP')
            act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
            act(b:fac+1,Pad('',4)~'realizado una Caucion Colocadora_Compra en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
            act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
        
         else
            act(b:fac, Pad('',4)~'Por la presente, nos dirigimos a Uds. a los efectos de informar que, de acuerdo con vuestra orden hemos')
            act(b:fac+1,Pad('',4)~'realizado una Caucion Colocadora_Venta en Rueda Normal de la Bolsa de Comercio de Buenos Aires, procediendo a')
            act(b:fac+2,Pad('',4)~ ' liquidar el importe correspondiente de su Cuenta Corriente/Caja de Ahorros Nro: '~IIF(EqStr(fbn['Alias1'],'CP'),'',fbn['Cliente1']))
        
         Endif
      Endif
   Endif
   SetFont(b:fac..e:fac+2,2)
  
else
  *------Leyenda del Pie
  ACT(g:FAC  , 'Promotor de Agentes y Sociedad de Bolsa . ' )
  ACT(g:FAC+1, 'CUIT '~Var('CUIT')~'. IVA Resp.Inscripto. Ingresos Brutos Nr. '~Var('INGBRUT')~'. RG(DGI). '~Var('RGDGI')~'.')
  SetFont(b:FAC..g:fac+1, 2)
  AlinearCeldas(g:fac..g:fac+1,'C')
  SetFilaActual(fac+3)
endif


