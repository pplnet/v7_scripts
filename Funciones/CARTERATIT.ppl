*- Inicializo las variables a utilizar en la funcion
*- Filas en las que inserto
ACN(fa1, Val(fi3))
ACN(fa2, Val(fi4))

*- Especies
ACT(ea1, '')
ACT(ea2, '')
ACT(me1, '')
ACT(es1, '')

*- Flag
ACN(ea6, 0)

*- Totales
ACN(aa1, 0)
ACN(aa2, 0)
ACN(aa3, 0)
ACN(fi10, 0)

If Dialogo.Radio2<>0
   *--  Se listan los titulo en el largo plazo
   *---Saldo Inicial de Cupones
   SQL.ADD("SELECT  DISTINCT E.Jerarquia,S.Especie ")
   SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE  S.NrSaldo = 1  ")
   SQL.ADD("AND    E.EsCupon = 'SI' ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND (S.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") OR S.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ) ")
   Endif
   SQL.ADD("       AND E.Codigo = S.Especie ")
   SQL.ADD("       AND S.Saldo <> 0 ")
   SQL.ADD("       AND S.Fecha IN (Select MAX(Fecha) from  "~DBO~".SALDOSDIA ")
   SQL.ADD("       WHERE (Mercado = S.Mercado OR (Mercado IS NULL AND S.Mercado IS NULL) ) ")
   SQL.ADD("       and  Cuenta       = S.Cuenta  ")
   SQL.ADD("       and  Cliente      = S.Cliente ")
   SQL.ADD("       and  Especie      = S.Especie ")
   SQL.ADD("       and  Cupon        = S.Cupon   ")
   SQL.ADD("       and  (EnteCustodia = S.EnteCustodia OR (EnteCustodia IS NULL AND S.EnteCustodia IS NULL) ) ")
   SQL.ADD("       and  NrSaldo      = S.NrSaldo ")
   SQL.ADD("       and  Fecha       <= "~IdxDate2(Dialogo.Fecha1)~") ")
   SQL.ADD(" UNION ")
   SQL.ADD("SELECT DISTINCT E.Jerarquia,E.Codigo as Especie ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE  O.Especie = E.Codigo ")
   SQL.ADD("       AND O.TipoOp In ('SECS','SECSV','SECT','SECTV','SEVS','SEVSV','SEVT','SEVTV') ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("       AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD("       AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("       AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" UNION ")
   SQL.ADD("SELECT DISTINCT E.Jerarquia,S.Especie ")
   SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE  S.NrSaldo = 10 ")
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("       AND S.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD("       AND E.Codigo = S.Especie ")
   SQL.ADD("       AND S.Saldo <> 0 ")
   SQL.ADD("       AND S.Fecha = (SELECT Max(D.Fecha) FROM "~DBO~".SALDOSDIA D ")
   SQL.ADD("                      WHERE  D.Cliente = S.Cliente ")
   SQL.ADD("                             AND D.Especie = S.Especie ")
   SQL.ADD("                             AND D.NrSaldo = S.NrSaldo ")
   SQL.ADD("                             AND D.Fecha < '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("ORDER BY 1,2")

   ACN(fo1,0)
   ACN(fo5,0)
   ACN(fo6,0)
   ACN(fo7,0)

   Recorrer SQL

      Message(fbn['Especie'])
      ACT(je1,ItemLista(Ascendientes('ESPECIES',fbn['Especie']),2) )

      *- Impresion de totales por especie
      IF Not EqStr(val(es1),FBN['Especie']) y NoVacio(val(es1))
         ACT(a:Val(fa1), Val(es1))
         SetFont(a:Val(fa1),1)
         (.'TOTALRESU'.)
         ACN(fo1,0)
         (.'TOTALRESU2'.)
         SCN(fa1, 1)
      EndIf

      IF Not EqStr(val(es2),val(je1)) y NoVacio(val(es2))
         *- Total Por Jerarquia
         ACT(a:Val(fa1), 'SubTotal '~val(a:val(es3)))
         Recorrer&i 2,17
           ACN(&i:val(fa1),Sum(&i:val(es3)..&i:val(fa1)-1) )             
  
           *- En val(fi3) acumulo el total de titulos para Despues generar al pie del bloque un total
           SCN(&i:val(fi3),val(&i:val(fa1)) )
         Proximo

         SetFont(1:val(fa1)..20:val(fa1),4)
         SCN(fa1, 1)
      EndIf

      IF Not EqStr(val(es2),val(je1)) 
         *- Corte por Jerarquia
         ACT(a:Val(fa1), Copy(Trim(BuscarCampo('ESPECIES','Extendido','Codigo',val(je1))),1,30) )
         ACT(es2,val(je1))
         *- es3: Desde Linea para sacar subtotales
         ACN(es3,val(fa1))
         SetFont(a:Val(fa1),4)
         SCN(fa1, 1)
      EndIf

      *- Corte de Control Por Especie para invocar al Informe
      IF Not EqStr(val(es1),FBN['Especie'])
         ACT(es1,FBN['Especie'])
         ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),CotizaEn(FBN['Especie'])),1,0))
         ACN(pr1,1)

         If Not EqStr(VAR('MONELOCA'),FBN['Especie']) y Not EqStr(VAR('MONEEXTR'),FBN['Especie'])
            ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')) )
         EndIf

         LinkearHoja('DETOPA', 1, Fecha1=PriDeMes(Dialogo.Fecha1, SI),Fecha2=Dialogo.Fecha1,Radio4=0,Especie1=CotizaEn(FBN['Especie']),Vehiculo1='',Lista1=Dialogo.Lista1,Lista2=FBN['Especie']~'|',Lista3='Bloomberg'~'|',Lista4=Fstr(Cotizacion(fbn('Especie'),,,,Fsys,1), 1, 8)~'|',Especie2=FBN['Especie'])
  
         *- fo1: Capital
         *- fo2: Interes 
         ACN(fo1, LinkH(1,fo1))
         ACN(fo2, LinkH(1,fo2))
  
         ACN(fo5,0)
         ACN(fo6,0)
         ACN(fo7,0)
 
         If Dialogo.Radio2<>0 y Dialogo.Radio2<>1 
            *- PARA LINKEAR EN RESUMEN: fo5: Capital*Tasa*Plazo fo6: Capital*Tasa fo7: Capital*Plazo 
            *- Tasa y plazo promedio solo para corto+largo
            ACN(fo5,LinkH(1,fo5)) 
            ACN(fo6,LinkH(1,fo6))
            ACN(fo7,LinkH(1,fo7))
         EndIf
         CerrarHoja('DETOPA', 1, Fecha1=PriDeMes(Dialogo.Fecha1, SI),Fecha2=Dialogo.Fecha1,Radio4=0,Especie1=CotizaEn(FBN['Especie']),Vehiculo1='',Lista1=Dialogo.Lista1,Lista2=FBN['Especie']~'|',Lista3='Bloomberg'~'|',Lista4=Fstr(Cotizacion(fbn('Especie'),,,,Fsys,1), 1, 8)~'|',Especie2=FBN['Especie'])
      EndIf
   Proximo

   IF NoVacio(val(es1))
      ACT(a:Val(fa1), Val(es1))
      SetFont(a:Val(fa1),1)
      (.'TOTALRESU'.)
      ACN(fo1,0)
      (.'TOTALRESU2'.)
      SCN(fa1, 1)
   EndIf

   IF NoVacio(val(es2))
      *- Total Por Jerarquia
      ACT(a:Val(fa1), 'SubTotal '~val(a:val(es3)))

      Recorrer&i 2,17
         ACN(&i:val(fa1),Sum(&i:val(es3)..&i:val(fa1)-1) )             
         *- En val(fi3) acumulo el total de titulos para Despues generar al pie del bloque un total
         SCN(&i:val(fi3),val(&i:val(fa1)) )
      Proximo

      SetFont(1:val(fa1)..20:val(fa1),4)
      SCN(fa1, 1)
   EndIf
   *- Se listan solamente en el largo
EndIf


If Dialogo.Radio2<>1
   ACT(es1,'')
   ACT(je1,'')
   ACT(es2,'')
   ACN(fo1,0)
   ACN(fo2,0)
   ACN(fo5,0)
   ACN(fo6,0)
   ACN(fo7,0)

   *- Recupero cada una de las cuasimonedas
   SQL.ADD("SELECT DISTINCT E.Jerarquia,E.Codigo as Especie FROM "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE  E.Codigo In ("~Pipe2Comillas(VAR('BGOBNAC'))~") ")
   SQL.ADD("OR     E.Codigo In ("~Pipe2Comillas(VAR('BONOCANJ'))~") ")
   SQL.ADD("Order By 1,2")

   Recorrer SQL

      ACT(es1,FBN['Especie'])

      ACN(ra2,IIf(Not EqStr(VAR('MONELOCA'),CotizaEn(FBN['Especie'])),1,0))
      ACN(pr1,1)

      ACN(pr1,CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI, CotizaEn(FBN['Especie'])) )

      LinkearHoja('PB134',1,Fecha1=Dialogo.Fecha1,Radio2=4,Check1=1,Lista1=Dialogo.Lista1,Lista2='',Lista3='',Lista4=FBN['Especie']~'|' )
      ACN(fo1, LinkH(1,ca1)*val(pr1))
      CerrarHoja('PB134',1,Fecha1=Dialogo.Fecha1,Radio2=4,Check1=1,Lista1=Dialogo.Lista1,Lista2='',Lista3='',Lista4=FBN['Especie']~'|' )

      If val(fo1)<>0 
         Message(fbn['Especie']~' '~val(fo1))
         ACT(je1,ItemLista(Ascendientes('ESPECIES',fbn['Especie']),2) )

         IF Not EqStr(val(es2),val(je1)) y NoVacio(val(es2))
            *- Total Por Jerarquia
            ACT(a:Val(fa1), 'SubTotal '~val(a:val(es3)))
   
            Recorrer&i 2,17
               ACN(&i:val(fa1),Sum(&i:val(es3)..&i:val(fa1)-1) )             
               *- En val(fi3) acumulo el total de titulos para Despues generar al pie del bloque un total
               SCN(&i:val(fi3),val(&i:val(fa1)) )
            Proximo
            SetFont(1:val(fa1)..20:val(fa1),4)
            SCN(fa1, 1)
         EndIf
         IF Not EqStr(val(es2),val(je1)) 
            *- Corte por Jerarquia
            ACT(a:Val(fa1), Copy(Trim(BuscarCampo('ESPECIES','Extendido','Codigo',val(je1))),1,30) )
            ACT(es2,val(je1))
            *- es3: Desde Linea para sacar subtotales
            ACN(es3,val(fa1))
            SetFont(a:Val(fa1),4)
            SCN(fa1, 1)
         EndIf

         *- Impresion de totales por especie
         ACT(a:Val(fa1), Val(es1))
         SetFont(a:Val(fa1),1)
         (.'TOTALRESU'.)
         ACN(fo1,0)
         (.'TOTALRESU2'.)
         SCN(fa1, 1)
      EndIf
   Proximo

   IF NoVacio(val(es2))  
      *- Total Por Jerarquia
      ACT(a:Val(fa1), 'SubTotal '~val(a:val(es3)))
      Recorrer&i 2,17
         ACN(&i:val(fa1),Sum(&i:val(es3)..&i:val(fa1)-1) )             
         *- En val(fi3) acumulo el total de titulos para Despues generar al pie del bloque un total
         SCN(&i:val(fi3),val(&i:val(fa1)) )          
      Proximo
      SetFont(1:val(fa1)..20:val(fa1),4)
   EndIf
   *- Lista las cuasimonedas en el corto   
EndIf 

Recorrer&i 2,17
   *- Totales de TITULOS
   ACT(a:Val(fa1)+2, 'TOTAL Cartera de Titulos ')
   ACN(&i:val(fa1)+2,val(&i:val(fi3)) )             
   BorrarCeldas(&i:val(fi3)..&i:val(fi3))             
Proximo

SetFont(1:val(fa1)..20:val(fa1)+2,4)
SCN(fa1, 3)

SetFont(b:Val(fa1)..q:Val(fa1), 1)
SetFont(b:Val(fa2)..q:Val(fa2), 1)
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(e:Val(fa2), Exe('F5'))
FormatoCeldas(j:Val(fa2), Exe('F5'))

*- Especies
ACT(ea1, '')
ACT(ea2, '')
ACT(me1, '')
*- Totales
ACN(aa1, 0)
ACN(aa2, 0)
ACN(aa3, 0)

