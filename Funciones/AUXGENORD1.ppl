               ** AUXGENORD1
               if Dialogo.Check1=1                 
                  ** Insert Operacion
                  (.'AUXGENORDA'.)
                
                 ** Generar Ejecuciones        
                 ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Val(t:53)~"' "))
                 ACT(w:1, Copy(Val(t:84),1,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
                 **Convert(datetime,'"~Val(w:1)~"',120)
                 SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio, Cantidad2) ")
                 SQL.ADD(" Values ('"~Val(t:53)~"', '"~Val(w6)~"', '"~FStr(Val(NE:1),0,0)~"', '"~Val(u:1)~"', Convert(datetime,'"~Val(w:1)~"',120), '"~FStr(Val(t:11),0,2)~"', '"~FStr(Val(t:13),0,8)~"', '"~FStr(Val(t:11)*Val(t:13),0,2)~"') ")
                 SQL.NEW
                  
                 SQL.ADD(" Update "~DBO~".ORDENES Set ")
                 SQL.ADD("  NrOperacion2 = '"~Val(w6)~"', ")
                 SQL.ADD("  Cuotas1      = "~FStr(Val(NE:1),0,0)~", ")
                 SQL.ADD("  Cantidad1    = "~FStr(Val(t:11),0,2)~", ")
                 SQL.ADD("  Cantidad4    = "~FStr(Val(t:13),0,8)~" ")
                 SQL.ADD(" Where NrOrden = '"~Val(t:53)~"' ")
                 SQL.NEW
                 SQL.EXEC
                 
                 Message('Modificar Operacion '~Val(w6))
                 ModificarOperacion(Val(w6),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,SI,NO,SI,NO,0,NO,NO)
                 
                 *Recalcula campos y Movimientos instancia 0 por recalculo comisiones
                 ModificarOrden(Val(t:53),0,NO,SI,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO)
                 
                 IF Ok
                    ** Actualizo Direccion para que aparezca en verde en la instancia que corresponda **
                    SQL.ADD("Update "~DBO~".OPERACIONES Set Direccion = 2 where NrOperacion = '"~Val(w6)~"' ")
                    SQL.NEW
                    SQL.EXEC                   
                 Endif
                 ** Instancia Orden 9 Ejecutada  
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='0'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(t:53)~"' and Valor = '1' ")
                 SQL.NEW
                 SQL.EXEC           
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='1'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(t:53)~"' and Nrbit = 9 ")
                 SQL.NEW
                 ** Instancia Operacion 13 Ejecutada Se elimina (va a 13 despues de poner boleto)
                 ** Instancia Operacion 65 envia Boleto MAE                   
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='0'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Valor = '1' ")
                 SQL.NEW
                 SQL.EXEC  
                 * asignar nro. de boleto automaticamente
                 EjecutarEvento('ASIBOL',Radio1=1,NrOperacion1=Val(w6))
                 SQL.ADD("Update "~DBO~".OPERACIONESBITS  ")
                 SQL.ADD("Set Valor='1'  ")
                 SQL.ADD(" where NrOperacion = '"~Val(w6)~"' and Nrbit = 65 ")
                 SQL.NEW
                 SQL.EXEC
               Endif