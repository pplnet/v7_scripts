ACN(li1,Fac)
ACN(li2,Fac)


SQL.ADD("SELECT Cliente1, TipoOp, ContraEspecie, Sum(TotalNetoCli1) as Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  Vehiculo1 = '"~Dialogo.Vehiculo1~"' ") 
SQL.ADD("       and  O.NrOperacion=B.NrOperacion and B.NrBit=30 and B.Valor='0' ")
SQL.ADD("       and  O.Especie=E.Codigo ")
SQL.ADD("       and  FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("       and  TipoOp In ('CTP','VTP','CFTP','VFTP','CTC','VTC','CFTC','VFTC') ")
*SQL.ADD("       and  "~DBO~".DesciendeDeEspecie(Especie,'PUBLIC') = 1 ")
SQL.ADD("       and Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
SQL.ADD("GROUP BY Cliente1, TipoOp, ContraEspecie ")
SQL.ADD("ORDER BY  Cliente1   ")

act(u1,' ')
acn(kk1,0)

Recorrer SQL
   if Val(kk1) = 0    
      act(u1,FBN['Cliente1'])
      acn(kk1,1)
   endif

   if Not DesciendeDeCliente(FBN['Cliente1'],EXE('SITERDESC'))

      if Eqstr(Val(u1),FBN['Cliente1'])
         
         if Incluido(FBN['TipoOp'],'CTP|CTC|CFTP|CFTC')
            scn(tc1,FBN['Cant']*CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA')) ) 
            scn(cc1,1) 
         else
            scn(tv1,FBN['Cant']* CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA'))) 
            scn(cv1,1) 
         endif

         scn(tt1,FBN['Cant']* CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA')))            

      else  

         if Val(tt1) >= Dialogo.Cantidad1
  
            SQL.ADD("SELECT C.*, I.TipoDocumento, I.NrDocumento FROM "~DBO~".CLIENTES C, "~DBO~".INTEGRANTESCLI I ")
            SQL.ADD("WHERE C.Codigo=I.Codigo and C.Codigo = '"~Val(u1)~"' ")

  
            Recorrer SQL

             act(aa:Val(li2),fbn['Codigo'])
             act(ab:Val(li2),fbn['RazonSocial'])
             act(ac:Val(li2),fbn['TipoDocumento'])
             act(ad:Val(li2),fbn['NrDocumento'])
             act(ae:Val(li2),fbn['CUIT'])
             act(af:Val(li2),fbn['Direccion'])
             act(ag:Val(li2),fbn['Localidad'])
             act(ah:Val(li2),BuscarCampo('PROVINCIAS','AliasDGI','Codigo',fbn['Provincia']) )
             act(ai:Val(li2),fbn['CodigoPostal'])
             act(aj:Val(li2),fbn['Persona'])

             act(ao:Val(li2),fbn['TipoInscripcion'])

             act(ar:Val(li2),fbn['PaisDir'])
             *act(as:Val(li2),fbn['Autonomo'])
             *act(at:Val(li2),fbn['PresentaDoc'])
             *acd(au:Val(li2),BuscarCampo('Cuentas','FechaApertura','Codigo',Val(cx1)) )
           Proximo

           SQL.ADD("Select Count(*) as CCli   from "~DBO~".INTEGRANTESCLI where Codigo = '"~Val(u1)~"' ")
    
           Recorrer SQL
               Acn(ak:Val(li2),fbn['CCli']+1)
           Proximo
   
           acn(al:Val(li2),Val(tc1))
           acn(am:Val(li2),Val(tv1))

           acn(an:Val(li2),Val(cc1))
           acn(ap:Val(li2),Val(cv1))
           SCN(li2,1)   

         endif
 
         ACN(tc1,0)
         ACN(tv1,0)
         ACN(tt1,0)
         ACN(cv1,0)
         ACN(cc1,0)
         ACT(u1, FBN['Cliente1'])
         if Incluido(FBN['TipoOp'],'CTP|CTC|CFTP|CFTC')
            scn(tc1,FBN['Cant']* CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA'))) 
            scn(cc1,1) 
         else
            scn(tv1,FBN['Cant']* CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA'))) 
            scn(cv1,1) 
         endif
         scn(tt1,FBN['Cant']* CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA')))            


      endif

    endif

proximo


if Val(tt1) >= Dialogo.Cantidad1
     SQL.ADD("SELECT C.*, I.TipoDocumento, I.NrDocumento FROM "~DBO~".CLIENTES C, "~DBO~".INTEGRANTESCLI I ")
     SQL.ADD("WHERE C.Codigo=I.Codigo and C.Codigo = '"~Val(u1)~"' ")

      Recorrer SQL

       act(aa:Val(li2),fbn['Codigo'])
                    

       act(ab:Val(li2),fbn['RazonSocial'])
       act(ac:Val(li2),fbn['TipoDocumento'])
       act(ad:Val(li2),fbn['NrDocumento'])
       act(ae:Val(li2),fbn['CUIT'])
       act(af:Val(li2),fbn['Direccion'])
       act(ag:Val(li2),fbn['Localidad'])
       act(ah:Val(li2),BuscarCampo('PROVINCIAS','AliasDGI','Codigo',fbn['Provincia']) )
       act(ai:Val(li2),fbn['CodigoPostal'])
       act(aj:Val(li2),fbn['Persona'])

       act(ao:Val(li2),fbn['TipoInscripcion'])
       act(ar:Val(li2),fbn['PaisDir'])
       *act(as:Val(li2),fbn['Autonomo'])
       *act(at:Val(li2),fbn['PresentaDoc'])
       *acd(au:Val(li2),BuscarCampo('Cuentas','FechaApertura','Codigo',Val(cx1)) )

 
   Proximo

   SQL.ADD("Select Count(*) as CCli   from "~DBO~".INTEGRANTESCLI where Codigo = '"~Val(u1)~"' ")

   Recorrer SQL
         Acn(ak:Val(li2),fbn['CCli']+1)
   Proximo
   
   acn(al:Val(li2),Val(tc1))
   acn(am:Val(li2),Val(tv1))
   acn(an:Val(li2),Val(cc1))
   acn(ap:Val(li2),Val(cv1))


endif
