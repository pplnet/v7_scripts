#ifdef BIND
    require '..\lib\IntegracionBIND.dll'

    import ServCuenta, 'IntegracionBIND.ServiciosBT'
    let &ServicioCuenta new ServCuenta(GetDataBase())
    * RR:10 Nro Orden o Voucher
    * RR:11 Sucursal
    * RR:33 Fecha Valor 
    * RR:36 Transaccion
    * RR:37 Fecha Cont
    * RR:38 Modulo 
    * RR:39 Relacion
    
    let &Cuenta &ServicioCuenta.Anular(""~Val(RR:36)~"",""~Val(RR:11)~"",""~Val(RR:37)~"",""~Val(RR:38)~"",""~Val(RR:39)~"",""~Val(RR:33)~"")

    ACT(RR:117,&Cuenta.Respuesta)
    if EqStr(Val(RR:117),'OK')
        ACT(RR:1,'OK')
        ACT(RR:102,&Cuenta.IdProceso)
    else
        ACT(RR:1,'NOK')
        ACT(RR:2,&Cuenta.Error)
        MessageBox("No se pudo realizar movimiento en cuenta del cliente: "~&Cuenta.Error)
    endif


    SQL.ADD("update "~DBO~".MOVCTASEXT set RespSistExt='"~&Cuenta.Respuesta~"',")
    SQL.ADD("Accion='AN',")
    SQL.ADD("Estado='"~&Cuenta.Estado~"',")
    SQL.ADD("FechaEnv='"~&Cuenta.FechaRequerimiento~"',")
    SQL.ADD("HoraEnv='"~&Cuenta.HoraRequerimiento~"',")
    SQL.ADD("FechaValor='"~&Cuenta.FechaRequerimiento~"',")
    SQL.ADD("Relacion='"~&Cuenta.Relacion~"',")
    SQL.ADD("Transaccion='"~&Cuenta.Transaccion~"',")
    SQL.ADD("DetalleError='"~&Cuenta.Error~"'")
    SQL.ADD("Where IdReferencia='" ~Val(RR:10)~"'")
    SQL.NEW
    SQL.EXEC
    
    SQL.ADD("UPDATE "~DBO~".VOUCONSOLIDADOS         ")
    SQL.ADD("   Set       Estado='ANU',             ")
    SQL.ADD("             Tipo='"~val(rr:26)~"',             ")
    SQL.ADD("             IdBaja='"~val(rr:102)~"'  ")
    SQL.ADD(" WHERE Id="~FSTR(Val(rr:9),1,0) )
    SQL.NEW

    SQL.ADD("DELETE "~DBO~".MOVEJECUTADOS         ")
    SQL.ADD(" WHERE NrOperacion='"~FSTR(Val(rr:9),1,0)~"'" )
    SQL.NEW
    SQL.EXEC
    
#endif
    