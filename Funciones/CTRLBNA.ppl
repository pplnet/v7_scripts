ACT(a:fac, 'Cotizacion BNA Dolares '~Val(fe:1) )
message(Val(a:fac))
SetFont(a:fac, 3)
ifa
ACN(b:fac, SQL("SELECT PrecioVenta FROM "~DBO~".CIERREBNA WHERE Especie = '"~VAR('MONEEXTR')~"' AND Fecha = "~idxdate2(Val(fe:1))~" "))
FormatoCeldas(b:fac, EXE('F9'))
If Val(b:fac)=0
   ACT(c:fac, 'ERROR')
   ColorCeldas(C:fac,clRed)
   ACN(fa:1, 1)
Else
   ACT(c:fac, 'OK')
   ColorCeldas(C:fac,clBlue)
Endif
SetFont(b:fac..c:fac, 2)
ifa
ifa
***********************************************
ACT(a:fac, 'Cotizacion BNA Dolar Billete '~Val(fe:1) )
message(Val(a:fac))
SetFont(a:fac, 3)
ifa
ACN(b:fac, SQL("SELECT PrecioVenta FROM "~DBO~".CIERREBNA WHERE Especie = 'USB' AND Fecha = "~idxdate2(Val(fe:1))~" "))
FormatoCeldas(b:fac, EXE('F9'))
ACT(ub:1, 'x')
*Concertados
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O WHERE O.FechaCargaSys = "~idxdate2(Dialogo.Fecha1)~" AND O.ContraEspecie = 'USB' ")
SQL.ADD(" UNION ")
*Liquidados
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M WHERE M.NrOperacion = O.NrOperacion AND M.NrSaldo=1 AND M.FechaEje = "~idxdate2(Dialogo.Fecha1)~" AND O.ContraEspecie = 'USB' AND M.Especie = O.ContraEspecie ")
SQL.ADD(" UNION ")
* Fallados
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T WHERE M.NrOperacion = O.NrOperacion AND M.NrTrans2 = T.NrTrans AND O.ContraEspecie = 'USB' AND M.Especie = O.ContraEspecie AND T.RB6 = '2' AND T.FechaFalla = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" UNION ")
* Confirmado
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T WHERE M.NrOperacion = O.NrOperacion AND M.NrTrans2 = T.NrTrans AND O.ContraEspecie = 'USB' AND M.Especie = O.ContraEspecie AND T.RB6 = '1' AND T.FechaConfir = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" UNION ")
* Saldos
SQL.ADD(" SELECT DISTINCT S.Especie ContraEspecie FROM "~DBO~".SALDOS S, "~DBO~".ESPECIES E WHERE S.Especie = E.Codigo AND E.Cotiza = 'USB' ")
Recorrer SQL
  dfa
  ACT(ub:1, fbn('ContraEspecie'))
Proximo

FormatoCeldas(b:fac, EXE('F9'))
*Solo controla cotizacion bna de usb si hay algo para contabilizar
If Val(b:fac)=0 y Eqstr(Val(ub:1), 'USB')
   ACT(c:fac, 'ERROR')
   ColorCeldas(C:fac,clRed)
   ACN(fa:1, 1)
Else
   If Eqstr(Val(ub:1), 'USB')
      ACT(c:fac, 'OK')
   Else
      ACT(c:fac, 'No hay Dolar Billete para Contabilizar')
   Endif
   ColorCeldas(C:fac,clBlue)
Endif
SetFont(b:fac..c:fac, 2)
ifa
ifa
ifa
***********************************************
ACT(a:fac, 'Cotizacion BNA Euros '~Val(fe:1) )
message(Val(a:fac))
SetFont(a:fac, 3)
ifa
ACN(b:fac, SQL("SELECT PrecioVenta FROM "~DBO~".CIERREBNA WHERE Especie = '"~VAR('MONEEURO')~"' AND Fecha = "~idxdate2(Val(fe:1))~" "))
FormatoCeldas(b:fac, EXE('F9'))
ACT(eu:1, 'x')
*Concertados
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O WHERE O.FechaCargaSys = "~idxdate2(Dialogo.Fecha1)~" AND O.ContraEspecie = '"~VAR('MONEEURO')~"' ")
SQL.ADD(" UNION ")
*Liquidados
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M WHERE M.NrOperacion = O.NrOperacion AND M.NrSaldo=1 AND M.FechaEje = "~idxdate2(Dialogo.Fecha1)~" AND O.ContraEspecie = '"~VAR('MONEEURO')~"' AND M.Especie = O.ContraEspecie ")
SQL.ADD(" UNION ")
* Fallados
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T WHERE M.NrOperacion = O.NrOperacion AND M.NrTrans2 = T.NrTrans AND O.ContraEspecie = '"~VAR('MONEEURO')~"' AND M.Especie = O.ContraEspecie AND T.RB6 = '2' AND T.FechaFalla = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" UNION ")
* Confirmado
SQL.ADD(" SELECT DISTINCT O.ContraEspecie FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T WHERE M.NrOperacion = O.NrOperacion AND M.NrTrans2 = T.NrTrans AND O.ContraEspecie = '"~VAR('MONEEURO')~"' AND M.Especie = O.ContraEspecie AND T.RB6 = '1' AND T.FechaConfir = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" UNION ")
* Saldos
SQL.ADD(" SELECT DISTINCT S.Especie ContraEspecie FROM "~DBO~".SALDOS S, "~DBO~".ESPECIES E WHERE S.Especie = E.Codigo AND E.Cotiza = '"~VAR('MONEEURO')~"' ")
Recorrer SQL
  dfa
  ACT(eu:1, fbn('ContraEspecie'))
Proximo

FormatoCeldas(b:fac, EXE('F9'))
*Solo controla cotizacion bna de euros si hay algo para contabilizar
If Val(b:fac)=0 y Eqstr(Val(eu:1), VAR('MONEEURO'))
   ACT(c:fac, 'ERROR')
   ColorCeldas(C:fac,clRed)
   ACN(fa:1, 1)
Else
   If Eqstr(Val(eu:1), VAR('MONEEURO'))
      ACT(c:fac, 'OK')
   Else
      ACT(c:fac, 'No hay Euros para Contabilizar')
   Endif
   ColorCeldas(C:fac,clBlue)
Endif
SetFont(b:fac..c:fac, 2)
ifa
ifa
ifa
