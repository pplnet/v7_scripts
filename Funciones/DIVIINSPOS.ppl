         *- mp13: Pendiente-Ejecutado
         *- pp1: FechaMov pp2: Cliente pp3: Vehiculo pp4: Unidad pp5: Centro pp6: Sector
         *- pp7: Sucursal pp8: NrSaldo pp9: Especie pp10: PrecioEj  pp11: FechaEj pp12: CallPut
         *- pp13: Cantidad pp14: Precio pp15: Estrategia pp16: Cartera pp17: Book pp18: Trader,
         *- pp19: TipoNegocio pp20: NrOperacion pp21: Cupon pp22: Tipo pp23: Responsable pp24: TipoPosicion,
         *- pp25: Producto pp26: GrupoEspecie pp27: CarteraBCRA

         *- Seteo el tipo de movimiento Automatico-Manual
         *- jo1=1 -> Algunos Bits AV y Otros MV ch1=2 Todos MV 
         ACT(mp13,'MV' )

         If val(jo1)=6
            ACT(mp13,'AV')
            ACD(mp17,Dialogo.Fecha2)
         EndIf

         *- Movimiento Nuevo de Posicion (Cantidad Original + Dividendo en Acciones )
         ACD(pp1 ,Dialogo.Fecha1)
         ACT(pp2 ,val(d:val(fi1)) )
         ACT(pp3 ,val(d:val(fi1)) )
         ACT(pp6 ,val(t:val(fi1)) )
         ACN(pp8 ,val(c:val(fi1)) )
         ACT(pp9 ,Dialogo.Especie4)
         If NoVacio(Dialogo.Especie3)
            *- Hay un Canje => Subo el monto del canje 
            ACT(pp9 ,Dialogo.Especie3)
         EndIf

         ACT(pp12,val(o:val(fi1)) )
         ACN(pp10,0 )
         ACT(pp11,'')

         IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
            ACN(pp10,Val(q:val(fi1)))
            ACT(pp11,Val(p:val(fi1)) )
         EndIf

         *- Cantidad Original + Acciones 
         ACN(pp13 ,val(i:val(fi1)) + Val(s:val(fi1)))

         *- Precio Nuevo 
         ACN(pp14 ,Val(bh:val(fi1)) )

         If Not EqStr(Dialogo.Especie1,Dialogo.Especie4) o NoVacio(Dialogo.Especie3)
            *- Subo el dividendo por la porcion de este, sin tener en cuenta el saldo inicial
            *- de la especie anterior para Div. en otra accion o Canje
            ACN(pp13 ,Val(s:val(fi1)))
            ACN(pp14 ,Cotizacion(val(pp9),,,,Dialogo.Fecha2,1))
         EndIf

         ACT(pp19,'TIT')
         ACT(pp20,val(y1))
         ACT(pp21,Val(b:val(fi1))) 
         ACT(pp22,'2')

         (."INMOVPOSPE".) 
         *--------------------------------------------------------------
         If EqStr(Dialogo.Especie1,Dialogo.Especie4) o NoVacio(Dialogo.Especie3)
            *- Solo bajo el movimiento cuando paga dividendo en la especie original
            *- Movimiento Posicion Disminuyendo la Cantidad Original 
            ACD(pp1 ,Dialogo.Fecha1)
            ACT(pp2 ,val(d:val(fi1)) )
            ACT(pp3 ,val(d:val(fi1)) )
            ACT(pp6 ,val(t:val(fi1)) )
            ACN(pp8 ,val(c:val(fi1)) )
            ACT(pp9 ,Dialogo.Especie1)
            ACT(pp12,val(o:val(fi1)) )
            ACN(pp10,0 )
            ACT(pp11,'')

            IF Incluido(Val(o:val(fi1)), 'CAL|PUT') 
               ACN(pp10,Val(q:val(fi1)))
               ACT(pp11,Val(p:val(fi1)) )
            EndIf

            *- Cantidad Original + Acciones 
            ACN(pp13 ,-val(i:val(fi1)) )

            *- Precio Nuevo 
            ACN(pp14 ,Val(aa:val(fi1)) )

            ACT(pp19,'TIT')
            ACT(pp20,val(y1))
            ACT(pp21,Val(b:val(fi1))) 
            ACT(pp22,'2')

            (."INMOVPOSPE".) 
         EndIf

         *--------------------------------------------------------------


