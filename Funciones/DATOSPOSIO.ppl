*- Selecciono las transaccion POSIO del dia.
SQL.ADD("SELECT Fecha1,NrTrans,Precio1 as CallTomado,")
SQL.ADD(" Precio2 as CancCredito, Precio3 as PFCCRemuner,")
SQL.ADD(" Cambio1 as CanjeEftvo, Precio4 as LetesPaseBC,")
SQL.ADD(" Precio5 as ColPaseVtaTit, Cambio2 as ANSES,")
SQL.ADD(" Cambio3 as TransferSuc, PrecioEj as Pendientes, Cambio4 as CtasCtes,")
SQL.ADD(" Cambio5    as CallOtCanc,")
SQL.ADD(" Cantidad19 as PFCCRemuner,")
SQL.ADD(" Cantidad1  as  CanjeEftvo,")
SQL.ADD(" Cantidad20 as  LetesPaseBC,")
SQL.ADD(" Cantidad2  as  ColPaseCpaTit,")
SQL.ADD(" Cantidad3  as  SucANSES,")
SQL.ADD(" Cantidad4  as CredGrEmpr,")
SQL.ADD(" Cantidad5  as  Factoring,")
SQL.ADD(" Cantidad6 as CtasCtes, ")
SQL.ADD(" Cantidad7 as AFIPImpuestos,")
SQL.ADD(" Cantidad8 as MEPSucursales,")
SQL.ADD(" Cantidad9 as Otros,")
SQL.ADD(" Cantidad10 as PendiEgre,")
SQL.ADD(" Cantidad21 as CtasGarantias,")
SQL.ADD(" Cantidad22 as ECCentral,")
SQL.ADD(" Cantidad23 as ESucursales,")
SQL.ADD(" Cantidad24 as Exigencia,")
SQL.ADD(" Cantidad25 as PGC80322,")
SQL.ADD(" Cantidad26 as SdoCEfMinDia ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T WHERE ")
SQL.ADD(" Fecha1='"~IDXDATE(Dialogo.Fecha1)~"' AND TipoTr2='POSIO' and ")
SQL.ADD(" Vehiculo1='"~Dialogo.Vehiculo1~"' and Mercado1='"~Dialogo.Mercado1~"' and ")
SQL.ADD(" Cuenta1='"~Dialogo.Cuenta1~"' and Especie='"~Dialogo.Especie1~"' ")

