*--- en ba:bz estan los totalizadores ------
Recorrer SQL 

   * Discrimina Divisiones de Vinculadas -> Division solamente si son dos divisiones del Mismo Vehiculo
   If [[Dialogo.Radio2=2 o Dialogo.Radio2=4 o Dialogo.Radio5=2 o Dialogo.Radio5=4] y [Incluido(Ascendientes('VEHICULOS',FBN['Vehiculo1']),Ascendientes('VEHICULOS',FBN['Cliente1']),1) y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',FBN['Vehiculo1']),'DIV') y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',FBN['Cliente1']),'DIV')] ] o [[Dialogo.Radio2=1 o Dialogo.Radio2=3 o Dialogo.Radio5=1 o Dialogo.Radio5=3] y Not [Incluido(Ascendientes('VEHICULOS',FBN['Vehiculo1']),Ascendientes('VEHICULOS',FBN['Cliente1']),1) y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',FBN['Vehiculo1']),'DIV') y EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',FBN['Cliente1']),'DIV')]] o [ [Dialogo.Radio1>=0 o Dialogo.Radio4>=0] y Not Incluido(Fbn['TipoOp'],'MMPCCV|VIMIND|VIMINM|SERPV|SERAV')] o Dialogo.Radio2=0 o Dialogo.Radio5=0 o Dialogo.Check1=1

      ACT(a:fac,FBN['Vehiculo1'])
      ACT(b:fac,FBN['TipoOp'])
      ACT(c:fac,FBN['NrOperacion'])
      ACLO(c:fac,FBN['NrOperacion'])
      ACT(d:fac,FBN['Cliente1']) 

      *--Capital---  
      If incluido(FBN['TipoOp'],'SERA|SERAV|SERP|SERPV|') 
         ACD(f:fac,FBN['FechaPago'])
         ACT(e:fac,FBN['ContraEspecie'])
         ACD(g:fac,FBN['FechaEj'])

         If Eqstr(FBN['ContraEspecie'],Dialogo.Especie1)
            ACN(h:fac,1)
            ACN(i:fac,1)
            ACN(j:fac,1)
            ACN(k:fac,1)
            ACN(xh:fac,1)
            ACN(xi:fac,1)
            ACN(xj:fac,1)
            ACN(xk:fac,1)
         Else
            If Eqstr(Var('MONEEXTR'),Dialogo.Especie1)
               If FBN['Cotizacion1'] <> 0
                  ACN(h:fac,FBN['Cotizacion1'])
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(xh:fac,1/Val(h:fac))
                  else
                     ACN(xh:fac,Val(h:fac))
                  endif
               Else
                  ACN(xh:fac, CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaPago']-1, 1,SI,Dialogo.Especie1) )
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(h:fac,1/Val(xh:fac))
                  else
                     ACN(h:fac,Val(xh:fac))
                  endif
               Endif 

               If FBN['Cotizacion2'] <> 0
                  ACN(i:fac,FBN['Cotizacion2'])
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(xi:fac,1/Val(i:fac))
                  else
                     ACN(xi:fac,Val(xi:fac))
                  endif
               Else
                  ACN(xi:fac, CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaPago']-1, 1,SI,Dialogo.Especie1) )
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(i:fac,1/Val(xi:fac))
                  else
                     ACN(i:fac,Val(xi:fac))
                  endif
               Endif 
            Else
               ACN(xh:fac, CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaPago']-1 , 1,SI,Dialogo.Especie1) )
               ACN(xi:fac, CotizacionC(FBN['ContraEspecie'],,,,FBN['FechaPago']-1, 1,SI,Dialogo.Especie1) )
               if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                  ACN(h:fac,1/Val(xh:fac))
                  ACN(i:fac,1/Val(xi:fac))
               else
                  ACN(h:fac,Val(xh:fac))
                  ACN(i:fac,Val(xi:fac))
               endif
            Endif
            ACN(xj:fac, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1 -1, 1,SI,Dialogo.Especie1) ) 
            ACN(xk:fac, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha2 -1, 1,SI,Dialogo.Especie1) ) 
            if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['ContraEspecie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
               ACN(j:fac,1/Val(xj:fac))
               ACN(k:fac,1/Val(xk:fac))
            else
               ACN(j:fac,Val(xj:fac))
               ACN(k:fac,Val(xk:fac))
            endif
         Endif

         ACN(l:fac,FBN['TotalNetoCli1'])
         *-- Tasa ------
         ACN(n:fac,FBN['Precio3'])
         ACN(m:fac,FBN['Plazo4'])

         *---Dias Transcurridos---
         If FBN['FechaEj'] <= Dialogo.Fecha2
            If FBN['FechaPago'] < Dialogo.Fecha1
               ACN(o:fac,DifDias(FBN['FechaEj'],Dialogo.Fecha1,'ARG',NO) ) 
            Else
               ACN(o:fac,DifDias(FBN['FechaEj'],FBN['FechaPago'],'ARG',NO) ) 
            Endif  
         Else
            If FBN['FechaPago'] < Dialogo.Fecha1
               ACN(o:fac,DifDias(Dialogo.Fecha2,Dialogo.Fecha1,'ARG',NO) ) 
            Else 
               ACN(o:fac,DifDias(Dialogo.Fecha2,FBN['FechaPago'],'ARG',NO) ) 
            Endif
         Endif
         *****************************************
      Else 
         *-- Para las Operaciones de MM -------------------------- 
         ACD(f:fac,FBN['FechaOp'])
         ACT(e:fac,FBN['Especie'])
         ACD(g:fac,FBN['FechaVto'])

         If Incluido(FBN['TipoOp'],'MMCDP') y NoVacio(FBN['FechaVto2'])
             *- Verifico si fue o no Precancelado
             ACD(g:fac,FBN['FechaVto2'])
         EndIf     
 
         If Eqstr(FBN['Especie'],Dialogo.Especie1)
            ACN(h:fac,1)
            ACN(i:fac,1)
            ACN(j:fac,1)
            ACN(k:fac,1)
            ACN(xh:fac,1)
            ACN(xi:fac,1)
            ACN(xj:fac,1)
            ACN(xk:fac,1)
         Else
            If Eqstr(Var('MONEEXTR'),Dialogo.Especie1)
               If FBN['Cotizacion1'] <> 0
                  ACN(h:fac,FBN['Cotizacion1'])
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(xh:fac,1/Val(h:fac))
                  else
                     ACN(xh:fac,Val(h:fac))
                  endif
               Else
                  ACN(xh:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaOp']-1, 1,SI,Dialogo.Especie1) )
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(h:fac,1/Val(xh:fac))
                  else
                     ACN(h:fac,Val(xh:fac))
                  endif
               Endif 

               If FBN['Cotizacion2'] <> 0
                  ACN(i:fac,FBN['Cotizacion2'])
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(xi:fac,1/Val(i:fac))
                  else
                     ACN(xi:fac,Val(i:fac))
                  endif
               Else
                  ACN(xi:fac, CotizacionC(FBN['Especie'],,,,VAL(g:fac), 1,SI,Dialogo.Especie1) )
                  if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                     ACN(i:fac,1/Val(xi:fac))
                  else
                     ACN(i:fac,Val(xi:fac))
                  endif
               Endif 
            Else
               ACN(xh:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaOp']-1 , 1,SI,Dialogo.Especie1) )
               ACN(xi:fac, CotizacionC(FBN['Especie'],,,,VAL(g:fac)-1, 1,SI,Dialogo.Especie1) )
               if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
                  ACN(h:fac,1/Val(xh:fac))
                  ACN(i:fac,1/Val(xi:fac))
               else
                  ACN(h:fac,Val(xh:fac))
                  ACN(i:fac,Val(xi:fac))
               endif
            Endif

            ACN(xj:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1 -1, 1,SI,Dialogo.Especie1) ) 
            ACN(xk:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2 -1, 1,SI,Dialogo.Especie1) ) 
            if EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~Dialogo.Especie1~"' "),'INV')
               ACN(j:fac,1/Val(xj:fac))
               ACN(k:fac,1/Val(xk:fac))
            else
               ACN(j:fac,Val(xj:fac))
               ACN(k:fac,Val(xk:fac))
            endif
         Endif

         If FBN['PrecioEj'] > 0
            ACN(l:fac,FBN['PrecioEj'])
         Else
            ACN(l:fac,FBN['Cantidad'])
         Endif

         *-- Tasa ------
         ACN(n:fac,FBN['Precio4'])
         ACN(m:fac,FBN['Plazo'])

         If Incluido(FBN['TipoOp'],'MMCDP') y FBN['Plazo2']>0
            ACN(m:fac,FBN['Plazo2'])
         EndIf

         *---Dias Transcurridos---
         If VAL(g:fac)<= Dialogo.Fecha2
            If FBN['FechaOp'] < Dialogo.Fecha1
               ACN(o:fac,DifDias(VAL(g:fac),Dialogo.Fecha1,'ARG',NO) ) 
            Else
               ACN(o:fac,DifDias(VAL(g:fac),FBN['FechaOp'],'ARG',NO) ) 
            Endif  
         Else
            If FBN['FechaOp'] < Dialogo.Fecha1
               ACN(o:fac,DifDias(Dialogo.Fecha2,Dialogo.Fecha1,'ARG',NO) ) 
            Else 
               ACN(o:fac,DifDias(Dialogo.Fecha2,FBN['FechaOp'],'ARG',NO) ) 
            Endif
         Endif
      Endif

      ACN(p:fac, Val(l:fac)*Val(n:fac)*Val(o:fac)/36500  )

      *--Capital Convertido ---
      If Val(f:fac) < Dialogo.Fecha1
         ACN(q:fac, Val(l:fac)*Val(xj:fac) )
      Else
         ACN(q:fac, Val(l:fac)*Val(xh:fac) )
      Endif 

      *--Monto Convertido --- 
      If VAL(g:fac) > Dialogo.Fecha2
         ACN(r:fac, (Val(l:fac)+Val(p:fac))*Val(xk:fac) )    
      else
         ACN(r:fac, (Val(l:fac)+Val(p:fac))*Val(xi:fac) )    
      Endif 

      ACN(s:fac, Val(r:fac)-Val(q:fac) ) 
      ACN(t:fac, (Val(s:fac)*36500) / (Val(q:fac)*Val(o:fac)) ) 
      ACN(u:fac, Val(q:fac)*Val(t:fac)*Val(o:fac) /100   )
      ACN(v:fac, Val(q:fac)*Val(o:fac) ) 
      ACN(w:fac, Val(q:fac)*Val(m:fac) ) 
     
      *--- Dias a End ----
      ACN(x:fac, DifDias(Val(g:fac),Dialogo.Fecha2,'ARG',NO) )
      If Val(x:fac) < 0
         ACN(x:fac,0)
      Endif

      *****************************************

      *---Ahead----
      If Val(x:fac) > 0
         *-- Capital Corregido ----
         If Val(xi:fac) = 0
            ACN(y:fac, Val(l:fac)*Val(xk:fac) ) 
         Else
            ACN(y:fac, Val(l:fac)*Val(xi:fac) ) 
         Endif     
     
         *---Cambio vencimiento Ahead
         If Val(xi:fac) = 0     
            ACN(ab:fac,Val(xk:fac) ) 
         Else
 	    ACN(ab:fac,Val(xi:fac) ) 
         Endif
         ACN(ac:fac, ((Val(l:fac)*Val(x:fac)*Val(n:fac)/36500) * Val(ab:fac) ) + Val(y:fac) ) 
         ACN(ad:fac, Val(ac:fac)-Val(y:fac) ) 
         ACN(ae:fac, (Val(ad:fac)*36500) / (Val(y:fac)*Val(x:fac)) ) 
         ACN(af:fac, Val(y:fac)*Val(x:fac)*Val(ae:fac)/100 ) 
         ACN(ag:fac, Val(y:fac)*Val(x:fac) ) 
      else
         ACN(y :fac,0) 
         ACN(ab:fac,0)
         ACN(ac:fac,0) 
         ACN(ad:fac,0) 
         ACN(ae:fac,0) 
         ACN(af:fac,0) 
         ACN(ag:fac,0) 
      EndIf
   Else 
      dfa
   EndIf

Proximo
