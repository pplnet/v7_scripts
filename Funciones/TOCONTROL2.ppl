VPRE19  : 'NroSaldo'           ;15;1;2;NO;NO;;;;;IF(Incluido(TIPOOP,'DTP|RTP'),RB4+2+101,0)
VFEC5   : 'MaxFecha'           ;15;2;2;NO;NO;;;;;IIF(NOVACIO(VEHICULO1)  Y NOVACIO(ESPECIE) Y NOVACIO(FECHA1) THEN QUERY("SELECT MAX(P2.Fecha) FROM "~DBO~".POSICIONES P2 WHERE P2.Cliente='"~VEHICULO1~"' AND P2.Especie = '"~ESPECIE~"' AND P2.NrSaldo ="~Fstr(VPRE19,0,0)~" AND P2.Fecha<='"~IdxDate(FECHA1)~"'") ELSE 0 ENDIF)
VPRE17  : 'Monto Posicion'     ;16;1;2;NO;NO;;;;;IIF(NOVACIO(VEHICULO1)  Y NOVACIO(ESPECIE) Y NOVACIO(NROPERACION) THEN (QUERY("SELECT Sum(P1.CantidadFin) FROM "~DBO~".POSICIONES P1 WHERE  P1.Cliente='"~VEHICULO1~"' AND P1.Especie = '"~ESPECIE~"' AND P1.NrSaldo="~Fstr(VPRE19,0,0)~" AND P1.Fecha='"~IdxDate(VFEC5)~"' ")-QUERY("SELECT Sum(Cantidad) FROM "~DBO~".MOVPOSEJE WHERE Cliente='"~VEHICULO1~"' AND Especie='"~ESPECIE~"' AND NrSaldo="~Fstr(VPRE19,0,0)~" AND NrOperacion='"~NROPERACION~"' ")) ELSE 0 ENDIF)
VPRE20  : 'Pos. Actual'        ;16;2;2;NO;NO;;;;;IF(Incluido(TIPOOP,'DTP'), VPRE17+CANTIDAD1,IF(Incluido(TIPOOP,'RTP'),VPRE17-CANTIDAD1))

