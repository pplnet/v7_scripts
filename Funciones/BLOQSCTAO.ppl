** opcion 1 con def afuera
def bloquearsaldoorden(Cuenta,Referencia,Monto,Bloquea)
  #ifdef BIND 
    if EqStr(Bloquea,'SI')
      require '..\lib\IntegracionBIND.dll'
      import ServCuenta, 'IntegracionBIND.ServiciosBT'
      let &ServicioCuenta new ServCuenta(GetDataBase())
      let &Cuenta &ServicioCuenta.Bloquear(""~Cuenta~"",""~Referencia~"",""~Monto~"")
      return &Cuenta.Respuesta
    else
      return 'OK'
    endif
  #else
    return 'OK'
  #endif
end

