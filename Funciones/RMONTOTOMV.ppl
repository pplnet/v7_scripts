* Utiliza las Tasas Simuladas ingresadas en TiposTasa
BorrarCeldas(az1001..az1050) 

*- mt1001: Cant mt2002: Int mt3003 Imp

SQL.ADD("Select C.NrOperacion,C.NrCuota,C.Cantidad1,C.Cantidad2, C.Total5, C.Plazo1,C.Cantidad4,C.Cantidad5,C.Tasa2,C.Tasa3,C.Precio4,C.Fecha1,C.Fecha2,C.Plazo3,C.Total6,C.Precio3,C.Cantidad7,C.Check1, ")
SQL.ADD("O.MB1,O.Precio3 OPrecio3,O.Precio2 OPrecio2,O.MB3,")
SQL.ADD("O.ImpGastos2,O.RB8,O.TotalAux1,O.RB9,O.PlazoGracia,")
SQL.ADD("O.RB6,O.CB10,O.MB1,O.Precio3,O.RB7,O.RB5,O.TasaPrecan,O.Spread,O.Cliente1,")
SQL.ADD("O.TotalAux2,O.Especie,O.ImpGastos1,O.TasaImp1,O.IntDevengados1,O.DeltaTasa,O.TipoTasa,O.TipoOp ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
SQL.ADD("where C.NrOperacion = '"~Val(NT:1000)~"' ")
SQL.ADD("and C.NrOperacion=O.NrOperacion ")
SQL.ADD("and C.NrCuota="~Fstr(FBN['NrCuota'],0,0)~"  and O.TipoOp like 'MM%' ")

Recorrer SQL
   Message('Recuperando Datos Operacion '~FBN['NrOperacion']~' Cuota '~FStr(fbn('NrCuota'),0,0))

   * Recupero la Tasa Simulada
   ACN(ts1,Num(SQL("SELECT TasaReferencia FROM "~DBO~".TIPOSTASA Where Codigo='"~FBN['TipoTasa']~"' ")) )
   *---
   * az1=iva, az2=wh, az3=interes, az4=interes total, az5=monto, az6=monto total, az10=cec total
   * az11=cen total, az20=cec imp var, az21=cen variable, az30=impuesto 

   * az50: Impto.Interes az51: Imp.IVA.CEN az52: Imp_Cs_Fin_CEC
   * ASIGNA CASO
   *----
   If Incluido(FBN['TipoOp'], 'MMPEM|MMPIM')
      acn(az1020,IIF(FBN['RB6']=0,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['OPrecio3']/100),0))
      acn(az1010,FBN['Cantidad5']+val(az1020))
      acn(az1021,IIF(FBN['RB6']=1,FBN['Cantidad2']*FBN['OPrecio2']*FBN['Plazo1']/IIF(FBN['MB3']=0,36000,36500),0))

      acn(az1011,val(az1021)+FBN['Plazo3'])
      acn(az1001,(FBN['ImpGastos2']/100)*(val(az1010)+(FBN['Cantidad2']*FBN['Plazo1']*(FBN['Tasa2']+val(ts1))/IIF(FBN['RB7']=0,36000,36500))))

      acn(az1002,IIF(FBN['RB6']=0,0,IIF(FBN['RB6']=2,FBN['Cantidad2']*((val(ts1)+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)*(FBN['TotalAux1']/100),FBN['Cantidad2']*FBN['Plazo1']*(FBN['Total6']+val(ts1))/IIF(FBN['RB9']=1,36500,36000)*(FBN['TotalAux1']/100))))
      acn(az1003,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+val(ts1))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))

      * Impto.Interes
      acn(az1050,IIF(FBN['RB6']=0,val(az1003),IIf(FBN['RB6']=1,val(az1011),0))*(FBN['TasaImp1']/100))

      * Imp_Cs_Fin_CEC
      acn(az1052,IIF(FBN['RB6']=0,val(az1010)*(FBN['DeltaTasa']/100),0))

      * Iva Cen
      acn(az1051,val(az1011)*(FBN['IntDevengados1']/100))

      acn(az1004,val(az1052)+val(az1050)+val(az1003)+val(az1010)+val(az1011)+val(az1002))
      acn(az1005,(FBN['Cantidad1']+val(az1003)))

      *- az6=monto total
      acn(az1006,(FBN['Cantidad1']+val(az1004)))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad1'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMPCLM')
      * az20: Imp.Variable CEC az10: Imp.Total CEC az1: Importe IVA  az50: Imp.Interes
      * az52: Imp_Cs_Fin_CEC    
      acn(az1020,IIF(FBN['RB6']=1,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['Precio3']/100),0))
      acn(az1010,IIF(FBN['RB6']=1, FBN['Cantidad5']+val(az1020), 0))
      acn(az1001,IIF(FBN['RB6']=1,((((FBN['Cantidad2']*FBN['Plazo1']*(FBN['Tasa2']+val(ts1)))/IIF(FBN['RB7']=0,36000,36500))+val(az1010))*(FBN['ImpGastos2']/100)), ((FBN['Cantidad2']*((val(ts1)+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))+val(az1010))*(FBN['ImpGastos2']/100)))

      acn(az1003,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+val(ts1))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))

      * Impto.Interes
      acn(az1050,val(az1003)*(FBN['TasaImp1']/100))

      * Imp_Cs_Fin_CEC
      acn(az1052,IIF(FBN['RB6']=1,val(az1010)*(FBN['DeltaTasa']/100),0))
           
      acn(az1004, val(az1003)+IIF(FBN['RB6']=1,val(az1010)+val(az1052),0)+val(az1050))
      acn(az1005,(FBN['Cantidad1']+val(az1003)))
      acn(az1006,(FBN['Cantidad1']+val(az1004)))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad1'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMPOSM')
      *- az21: Cen Variable az11: Cen Total  az1: Impte.Iva az2: Impte.WH
      *- az3: INTERES az4: Interes Total az12:  Importe CEN en Equivalente
      acn(az1021,IIF(FBN['RB6']=0,((FBN['Cantidad2']*FBN['OPrecio2']*FBN['Plazo1'])/IIF(FBN['RB5']=0,36000,36500)),0))
      acn(az1011,IIF(FBN['RB6']=0, FBN['Cantidad5']+val(az1021), 0))

      acn(az1002,FBN['Cantidad2']*FBN['Plazo1']*(FBN['Total6']+val(ts1))/IIF(FBN['RB9']=1,36500,36000)*(FBN['TotalAux1']/100))
      acn(az1003,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+val(ts1))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
      acn(az1001,(val(az1003)*(FBN['ImpGastos2']/100)))
      acn(az1012,FBN['Cantidad7']^IiF(EqStr(FBN['Check1'],'1'),1,-1)*val(az1011))

      * Impto.Interes
      acn(az1050,IIF(FBN['RB6']=0,val(az1003)*(FBN['TasaImp1']/100),0) )

      * Iva Cen
      acn(az1051,val(az1011)*(FBN['IntDevengados1']/100))
      acn(az1004,val(az1002)+val(az1003)+val(az1011)+val(az1050))
      acn(az1005,FBN['Cantidad1']+val(az1003))
      acn(az1006,FBN['Cantidad1']+val(az1004))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad1'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMONM')
      acn(az1003,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,FBN['Cantidad2']*((FBN['Precio4']+val(ts1))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
      acn(az1001,IIF(FBN['ImpGastos2']=0,0,(val(az1003)*FBN['ImpGastos2']/100)))
      acn(az1002,IIF(FBN['CB10']=0,0,(val(az1003)*FBN['TotalAux1']/100)))
      acn(az1005,(FBN['Cantidad4']+val(az1003)))

      * Impto.Interes -> Tasa3 es el % Imp.Interes
      acn(az1050,val(az1003)*FBN['Tasa3']/100 )
      acn(az1004,val(az1003)+val(az1002)+val(az1050))
      acn(az1006,FBN['Cantidad4']+val(az1004))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad4'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf

   If EQSTR(FBN['TipoOp'], 'MMPCCM')
      acn(az1001,IIF(FBN['RB6']=0,((FBN['Cantidad2']*FBN['Plazo1']*(FBN['Tasa2']+val(ts1)))/IIF(FBN['RB7']=0,36000,36500))*(FBN['ImpGastos2']/100),0))
      acn(az1002,IIF(FBN['RB6']=2 y FBN['MB3']=0,(((FBN['Cantidad2']*FBN['Plazo1']*(FBN['Total6']+val(ts1)))/IIF(FBN['RB9']=1,36500,36000)) *(FBN['TotalAux1']/100)),0))
      acn(az1003,FBN['Cantidad2']*((FBN['Precio4']+val(ts1))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))
      acn(az1030,IIF(FBN['RB6']=3 O [FBN['RB6']=4 y FBN['MB3']=0],val(az1003)*FBN['TasaPrecan']/100,0))
      acn(az1004,val(az1003)+IIF(FBN['RB6']=2 Y FBN['MB3']=0,val(az1002),0)+IIF(FBN['RB6']=4 Y FBN['MB3']=0,val(az1030),0))
      acn(az1005,(FBN['Cantidad1']+val(az1003)))
      acn(az1006,(FBN['Cantidad1']+val(az1004)))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad1'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf

   If Incluido(FBN['TipoOp'], 'MMFIMV|MMSIMV')
      acn(az1003,FBN['Cantidad2'] * ((val(ts1) + FBN['Precio4'])/100) * FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8'] +1))
      acn(az1001,((FBN['Cantidad2']*FBN['Plazo1']*(FBN['Tasa2']+val(ts1))) / IIF(FBN['RB7']=0,36000,36500)) * (FBN['ImpGastos2']/100))
      acn(az1002,((FBN['Cantidad2']*FBN['Plazo1']*(FBN['Total6']+val(ts1))) / IIF(FBN['RB9']=0,36000,36500)) * (FBN['TotalAux1']/100))

      * Impto.Interes
      acn(az1050,val(az1003)*(FBN['TasaImp1']/100))
      acn(az1004,val(az1003)+iif(FBN['CB10']=1,val(az1002),0)+val(az1050))

      acn(az1005,(FBN['Cantidad4']+val(az1003)))
      acn(az1006,FBN['Cantidad4']+val(az1004))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad4'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf
 
   If EqStr(FBN['TipoOp'], 'MMCPM')
      * az1=iva, az2=importe percepcion iva, az3=interes, az20=importe neto iva, az21=imp imp
      * az4=interes neto, az5=monto, az6=monto neto
      acn(az1003,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,(fbn['Cantidad2']*(FBN['Spread']+val(ts1))*fbn['Plazo1'])/IIF(FBN['RB8']=0,36000,36500)))
      acn(az1001,IIF(NOT DESCIENDEDECLIENTE(FBN['Cliente1'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['Cliente1'])),val(az1003)*FBN['ImpGastos2']/100,0))
      acn(az1002,IIF(NOT DESCIENDEDECLIENTE(FBN['Cliente1'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['Cliente1'])),val(az1003)*FBN['TotalAux2']/100,0))
      acn(az1020,IIF(NOT DESCIENDEDECLIENTE(FBN['Cliente1'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['Cliente1'])),val(az1001) + val(az1002),0))
      acn(az1021,IIF(EQSTR(FBN['Especie'],'ARP') Y DESCIENDEDECLIENTE(FBN['Cliente1'],'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',FBN['Cliente1'])),val(az1003)*FBN['ImpGastos1']/100,0))
      acn(az1004,val(az1003)-val(az1021))
      acn(az1005,FBN['Cantidad1']+val(az1003))
      acn(az1006,val(az1005)-val(az1021))

      *- Valores para Separar Capital + Interes + Impuestos
      acn(mt:1001, FBN['Cantidad1'] )
      acn(mt:2002, val(az1003) )
      acn(mt:3003, val(az1004)-val(az1003))
   EndIf
Proximo

SQL.ADD("Select O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion,O.Especie, O.ContraEspecie, O.FechaOp, O.FechaEj FVto, ")
SQL.ADD("O.FechaOp2 FInicio, O.FechaEj FFin, O.Cantidad ResidualV, O.TotalBrutoCli1 ResidualC, O.Precio3 VTasa, O.TotalGanancias CTasa, O.Spread VSpread, O.TotalNetoCli2 CSpread, ")
SQL.ADD("O.TotalIntereses VTotInt, O.InteresesCorr CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalBrutoCli2, O.FechaPago, 0 Cantidad5, 0 Cantidad6, 0 Cuotas1,0 NrCuota, ")
SQL.ADD("O.TipoTasa TasaVehi,O.TipoTasa2 TasaCont,O.FechaOp2 FInicioC,O.FechaEj FFinC,O.RB5 ")
SQL.ADD("from "~DBO~".OPERACIONES O Where ")
SQL.ADD("TipoOp IN ('DTSFV','DTSVV')  and O.NrOperacion='"~Val(NT:1000)~"' ")
SQL.ADD("Union All ")
*SQL.ADD("Select O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaOp, DECODE(O.TipoOp, 'DTSFVX', O.FechaEx2, 'DTSNFV', O.FechaEx2, C.Fecha2) FVto, ")
SQL.ADD("Select O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaOp, ")
SQL.ADD("(CASE WHEN O.TipoOp='DTSFVX' THEN O.FechaEx2 WHEN TipoOp='DTSNFV' THEN O.FechaEx2 ELSE C.Fecha2 END) FVto, ")
SQL.ADD("C.Fecha1 FInicio, C.Fecha2 FFin, C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa, C.Precio2 CTasa, C.Total3 VSpread, C.Total4 CSpread, ")
SQL.ADD("C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalBrutoCli2, C.Fecha3 FechaPago, C.Cantidad5, C.Cantidad6, O.Cuotas1,C.NrCuota, ")
SQL.ADD("O.TipoTasa TasaVehi,O.TipoTasa2 TasaCont,C.Fecha5 FInicioC,C.Fecha6 FFinC,O.RB5 ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("and TipoOp IN ('DTSFVM','DTSVVM')  and O.NrOperacion = '"~Val(NT:1000)~"' and C.NrCuota="~Fstr(FBN['NrCuota'],0,0)~"")
SQL.ADD("Union All ")
SQL.ADD("Select O.Vehiculo1, O.FechaCargaSys, O.Cliente1, O.NrOperacion, O.Especie, O.ContraEspecie, O.FechaOp, O.FechaVto FVto, ")
SQL.ADD("C.Fecha1 FInicio, C.Fecha2 FFin, C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa, C.Precio2 CTasa, C.Total3 VSpread, C.Total4 CSpread, ")
SQL.ADD("C.Cantidad3 VTotInt, C.Cantidad4 CTotInt, O.TipoOp, O.RB9, O.RB8, O.TotalAux3, O.TotalAux3 TotalBrutoCli2, C.Fecha3 FechaPago, C.Cantidad5, C.Cantidad6, O.Cuotas1,C.NrCuota, ")
SQL.ADD("O.TipoTasa TasaVehi,O.TipoTasa TasaCont,C.Fecha5 FInicioC,C.Fecha6 FFinC,O.RB8 RB5 ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("and TipoOp IN ('DTCAP','DTFLO') and O.NrOperacion = '"~Val(NT:1000)~"' and C.NrCuota="~Fstr(FBN['NrCuota'],0,0)~"")

Recorrer SQL
   Message('Recuperando Datos Operacion '~FBN['NrOperacion']~' Cuota '~FStr(fbn('NrCuota'),0,0)~' '~val(ts2))

   *-- ts3: Tipo de Tasa 
   ACT(ts3,FBN['TasaVehi'])

   *-- az3=interes
   If EqStr(val(ts2),'CONT')
      ACT(ts3,FBN['TasaCont'])
   EndIf
   *-- Recupero la Tasa Simulada
   ACN(ts1,Num(SQL("SELECT TasaReferencia FROM "~DBO~".TIPOSTASA Where Codigo='"~VAL(ts3)~"' ")) )

   If EqStr(val(ts2),'VEHI')
      acn(az1003,((FBN['ResidualV']*(val(ts1)+FBN['VSpread']))/100)*FACTORDIAS(FBN['FInicio'],FBN['FFin'],FBN['RB8']+1) )
      acn(mt:1001, FBN['ResidualV'] )
   Else
      acn(az1003,-(((FBN['ResidualC']*(val(ts1)+FBN['CSpread']))/100)*FACTORDIAS(FBN['FInicioC'],FBN['FFinC'],FBN['RB5']+1)) )
      acn(mt:1001, FBN['ResidualC'])
   EndIf 

   acn(mt:2002, val(az1003) )
   acn(mt:3003, 0)
Proximo

acn(mt1020,val(az1006))
acn(mt:1001,val(mt:1001))
acn(mt:2002,val(mt:2002))
acn(mt:3003,val(mt:3003))
ACN(MT:4, Val(AZ:1002))
ACN(MT:5, Val(AZ:1050))

Message('Interes Recuperado '~Fstr(val(mt:2002),0,2))
