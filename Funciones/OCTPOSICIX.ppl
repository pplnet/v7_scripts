               SQL.ADD(" '"~Val(g:&i)~"', '"~IdxDate(Val(l:&i))~"',  ")
               SQL.ADD(" '"~Val(bk:1)~"',   ")
               If eqstr(Val(bk:8), 'FXOCTC')
                  SQL.ADD(" "~FStr(Val(bk:4)-Val(bk:3),0,2)~", ")
               Else
                  SQL.ADD(" "~FStr(-(Val(bk:4)+Val(bk:3)),0,2)~", ")
