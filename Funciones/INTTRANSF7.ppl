AbrirASCII(Dialogo.String1~Dialogo.String2, 0)

***---Tipo de Registro
ACT(RG:1, "1")
***- Tipo de Tratamiento : I=Inmediato D=Diferido
IF EqStr(FBN['RB1'],'2')
   ACT(RG:1, Val(RG:1)~"'"~"I")
Else
   ACT(RG:1, Val(RG:1)~"'"~"D")
EndIf

***- Tipo de Instruccion : E=Emisora R=Receptora
IF EqStr(FBN['TipoTr2'],'DTP')
   ACT(RG:1, Val(RG:1)~"'"~"R")
   
   ***---Numero de Cuenta: Codigo de Depositante
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(fbn('DepReceptor'), 1, 4), 4))

   ***---Numero de Sucuenta: Nro.De Comitente
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn('ComReceptor')), 1, 9), 9))
Else
   ACT(RG:1, Val(RG:1)~"'"~"E")

   ***---Numero de Cuenta: Codigo de Depositante
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(fbn('DepEmisor'), 1, 4), 4))

   ***---Numero de Sucuenta: Nro.De Comitente
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn('ComEmisor')), 1, 9), 9))
EndIf

***---Especie
ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(fbn('Especie'), 1, 5), 12))

*-- Cantidad a transferir 19 caracteres alfanum‚ricos	11e.7d
If Incluido(VAR('CVENOMINAL'), Ascendientes('ESPECIES',FBN['Especie'])))
   ACT(RG:1, Val(rg:1)~"'"~Pad0(Fstr(FBN['Cantidad1'],0,7),19))
Else
   ACT(RG:1, Val(rg:1)~"'"~Pad0(Fstr(FBN['Cantidad2'],0,7),19))
EndIf

*- Numero de cuenta y subcuenta contraparte
IF EqStr(FBN['TipoTr2'],'RTP')
   ***---Numero de Cuenta: Codigo de Depositante
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(fbn('DepReceptor'), 1, 4), 4))

   ***---Numero de Sucuenta: Nro.De Comitente
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(IIF(EqStr(FBN['CB2'],'0'),fbn('ComReceptor'),BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn('ComReceptor'))), 1, 9), 9))
Else
   ***---Numero de Cuenta: Codigo de Depositante
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(fbn('DepEmisor'), 1, 4), 4))

   ***---Numero de Sucuenta: Nro.De Comitente
   ACT(RG:1, Val(RG:1)~"'"~Pad0(Copy(IIF(EqStr(FBN['CB2'],'0'),fbn('ComEmisor'),BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn('ComEmisor'))), 1, 9), 9))
EndIf

*- Solicitud de Reserva de Saldo
ACT(RG:1, Val(RG:1)~"'"~"N")

*- Nivel de Prioridad
ACT(RG:1, Val(RG:1)~"'"~"00")

*- Limite de Validez
ACT(RG:1, Val(RG:1)~"'"~Val(FE:1)~Val(FE:2))

*- Fecha de Ejecucion
ACT(RG:1, Val(RG:1)~"'"~IIF(Vacio(FBN['Fecha3']),'0000',Pad0(Fstr(Dia(FBN['Fecha3']), 0, 0), 2)~Pad0(Fstr(Mes(FBN['Fecha3']), 0, 0), 2)))

*- Solicitud de Matching
ACT(RG:1, Val(RG:1)~"'"~"S")

EscribirASCII(Val(RG:1))
CerrarASCII
