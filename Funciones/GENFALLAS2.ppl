  SQL.ADD("'"~IdxDate(FSys)~"', '"~Val(ba:&j)~"', 'SETTLEMENT',")

  SQL.ADD("'"~Val(bk:&j)~"', '"~IdxDate(FSys)~"', "~FStr(Val(bp:&j)*CotizacionC(Val(bk:&j),,,,FSys,1,SI,'USD'),0,2)~",")
