if Incluido(fbn['TipoOp'],'DFXO|DSEO')
   ACT(a:FAC, 'Numero Op.')
   ACT(b:FAC, 'F.Concert.')
   ACT(c:FAC, 'Entidad')
   ACT(d:FAC, 'Tipo Oper.')
   ACT(e:FAC, 'Tipo')
   ACT(f:FAC, 'Ejercicio')
   ACT(g:FAC, 'Mark to Market')
   ACT(h:FAC, 'Settlement')
   ACT(j:FAC, 'Precio Ejercicio')
   ACT(k:FAC, 'Referencia')
   ACT(l:FAC, 'Fecha Inicio')
   ACT(m:FAC, 'Plazo')
   ACT(n:FAC, 'Fecha Final')
   ACT(o:FAC, 'F.Settlement')
   if Incluido(fbn['TipoOp'],'DSEO')
      ACT(i:FAC, 'Especie')
      ACT(p:FAC, 'Cupon')
      ACN(co:50,ASCII('q')-96)
      AgregarMarco(a:FAC..p:FAC,2,0,Exe('COLOR'))
     else
      ACT(i:FAC, 'Moneda')
      ACN(co:50,ASCII('p')-96)
      AgregarMarco(a:FAC..o:FAC,2,0,Exe('COLOR'))
   endif
   SetFont(a:fac..p:FAC,2)
   ifa
endif

