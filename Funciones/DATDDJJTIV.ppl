DDJJRequiere: 'Requiere DDJJ' ;18;1;1;NO;NO;;;;;if(Not EqStr(Var('DDJJPARK'),'SI') o Not Incluido(CONTRAESPECIE,'USD') o DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') o Vacio(ORDEN1) o EqStr(CLIENTE1,VEHICULO1),'NO','SI')
DDJJMercado:   'Mercado DDJJ'  ;18;2;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),if(Incluido(MERCADO,Var('MERPAREXT')),'EXT',if(Incluido(MERCADO,Var('MERPARLOC')),'LOC')),'')
DDJJTipoCli:   'TipoCli DDJJ'  ;18;3;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),if(DESCIENDEDECLIENTE(CLIENTE1,'VINCULADOS'),'VIN',if(Incluido(BuscarCampo('CLIENTES','TipoInscripcion','Codigo',CLIENTE1),VAR('DDJJTICLEX')),'EXT','LOC')))
%%ifdef MLASA
  DDJJTipoEsp:   'TipoEsp DDJJ'  ;19;3;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),if(EqStr(BuscarCampo('ESPECIES','TipoTitulo','Codigo',ESPECIE),'BP'),'BOP',''))
%%else
  DDJJTipoEsp:   'TipoEsp DDJJ'  ;19;3;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),if(NO,'BOP',''))
%%endif
DDJJCodigo:    'DDJJ'          ;19;1;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),Query("Select Codigo from "~DBO~".PARAMETROSDDJJ where Mercado='"~DDJJMercado~"' and TipoCli='"~DDJJTipoCli~"' and IsNull(TipoEsp,'')='"~DDJJTipoEsp~"' "),'')
DDJJEmitida:   'DDJJ Emitida'  ;20;1;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;
DDJJPresentada:'DDJJ Presen.'  ;20;2;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;
DDJJFechaPres: 'DDJJ F.Pres'   ;20;3;1;NO;NO y EqStr(DDJJRequiere,'SI');;;;;
