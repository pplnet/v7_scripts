**Campo 'Valua' indica si valúa a Mercado (0) o a Partida (1)
SQL.ADD(" Select R.Fecha, R.Especie, R.Vehiculo Vehiculo1, R.Book, R.Cupon, R.NrSaldo, R.Day, E.MonedaEmision, E.Tipo TipoEspecie, R.Vehiculo Cliente, ")
SQL.ADD(" R.Estrategia as CuentaCustodia, R.TipoPosicion as Concepto, E.Issuer, E.Alias1 as EspBanTotal, E.VTeorico as VTeorico, E.Cotiza,0 as 'Valua'  ")
SQL.ADD(" From "~DBO~".RESULTADOS R, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = R.Especie ")
SQL.ADD(" AND R.NrSaldo   =  "~Fstr(Val(SL:2), 0, 0)~" ")
SQL.ADD(" AND R.Fecha = '"~IdxDate(Val(FE:99))~"' ")
SQL.ADD(" AND R.TipoResultado IN ('REVCON') ")
SQL.ADD(" AND Round(R.Day, 0, 2) <> 0 ")
SQL.ADD(" AND E.EsCupon <> 'SI' ")
**Cintia 17-2-23 Administracion de partidas - Issue 6089
SQL.ADD(" AND R.Book Not IN ("~Pipe2Comillas(&BValuaPartida)~") ")


SQL.ADD(" UNION ")

SQL.ADD(" Select C.Fecha1 Fecha,E.Codigo Especie,O.Vehiculo1 Vehiculo1, O.Book1 Book, O.Cupon1 Cupon, '"~Var('SALDOPOCON')~"' NrSaldo, Sum(C.Cantidad1) Day, ")
SQL.ADD(" E.MonedaEmision, E.Tipo TipoEspecie, O.Vehiculo1 Cliente, '' CuentaCustodia, '' Concepto,")
SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, E.VTeorico as VTeorico, E.Cotiza,1 as 'Valua'  ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".CUOTAS C")
SQL.ADD(" Where E.Codigo = O.Especie AND O.NrOperacion=C.NrOperacion ")
SQL.ADD(" AND Round(C.Cantidad1, 0, 2) <> 0 ")
SQL.ADD(" AND C.Fecha1= '"~IdxDate(Val(FE:99))~"'")
***---Cintia 230424 Caso1 = Operaciones cargadas a FechaOp => levanto el devengado de ese dia
SQL.ADD(" AND O.FechaCargaSys=O.FechaOp ")
SQL.ADD(" AND O.TipoOp='PARTID' ")
SQL.ADD(" Group By O.Book1,E.Codigo,O.Vehiculo1,O.Cupon1,E.MonedaEmision,E.Tipo,E.Issuer, E.Alias1,E.VTeorico,E.Cotiza,C.Fecha1 ")

SQL.ADD(" UNION ")

***---***---Cintia 230424 Caso2 = Operaciones FechaValor ingresadas Hoy => levanto devengados agrupados por FechaValor
SQL.ADD(" Select C.Fecha1 Fecha,E.Codigo Especie,O.Vehiculo1 Vehiculo1, O.Book1 Book, O.Cupon1 Cupon, '"~Var('SALDOPOCON')~"' NrSaldo, Sum(C.Cantidad1) Day, ")
SQL.ADD(" E.MonedaEmision, E.Tipo TipoEspecie, O.Vehiculo1 Cliente, '' CuentaCustodia, '' Concepto,")
SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, E.VTeorico as VTeorico, E.Cotiza,1 as 'Valua'  ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".CUOTAS C")
SQL.ADD(" Where E.Codigo = O.Especie AND O.NrOperacion=C.NrOperacion ")
SQL.ADD(" AND Round(C.Cantidad1, 0, 2) <> 0 ")
SQL.ADD(" AND C.Fecha1<= '"~IdxDate(Val(FE:99))~"' and O.FechaCargaSys>O.FechaOp and O.FechaCargaSys= '"~IdxDate(Val(FE:99))~"'")
SQL.ADD(" AND O.TipoOp='PARTID' ")

SQL.ADD(" Group By O.Book1,E.Codigo,O.Vehiculo1,O.Cupon1,E.MonedaEmision,E.Tipo,E.Issuer, E.Alias1,E.VTeorico,E.Cotiza,C.Fecha1")

SQL.ADD(" UNION ")

***---***---Cintia 230424 Caso3 = Operaciones FechaValor No ingresadas Hoy => levanto solo devengados de hoy
SQL.ADD(" Select C.Fecha1 Fecha,E.Codigo Especie,O.Vehiculo1 Vehiculo1, O.Book1 Book, O.Cupon1 Cupon, '"~Var('SALDOPOCON')~"' NrSaldo, Sum(C.Cantidad1) Day, ")
SQL.ADD(" E.MonedaEmision, E.Tipo TipoEspecie, O.Vehiculo1 Cliente, '' CuentaCustodia, '' Concepto,")
SQL.ADD(" E.Issuer, E.Alias1 as EspBanTotal, E.VTeorico as VTeorico, E.Cotiza,1 as 'Valua'  ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".CUOTAS C")
SQL.ADD(" Where E.Codigo = O.Especie AND O.NrOperacion=C.NrOperacion ")
SQL.ADD(" AND Round(C.Cantidad1, 0, 2) <> 0 ")
SQL.ADD(" AND C.Fecha1= '"~IdxDate(Val(FE:99))~"' and O.FechaCargaSys<'"~IdxDate(Val(FE:99))~"' and O.FechaCargaSys>O.FechaOp")
*SQL.ADD(" AND O.FechaCargaSys=O.FechaOp ")
SQL.ADD(" AND O.TipoOp='PARTID' ")
SQL.ADD(" Group By O.Book1,E.Codigo,O.Vehiculo1,O.Cupon1,E.MonedaEmision,E.Tipo,E.Issuer, E.Alias1,E.VTeorico,E.Cotiza,C.Fecha1 ")


