***---Compra de Cap y Floor
SQL.ADD(" Select -C.Total2 Cantidad, C.Precio1 Tasa,  0 SpreadC, C.Fecha1 FechaOp, ")
SQL.ADD(" C.Fecha2 FechaVto, O.TipoOp, C.Total3 Spread, P.RB8, 0 TotalComisiones, ")
SQL.ADD(" 0 PeriodoInts, 'SCAP/FLOOR' Tipo, O.NrOperacion, P.Especie,P.NrOperacion OpSwap ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where P.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND P.MB3 = 0 ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.NrOperacion = '"~Val(eb2)~"' ")
SQL.ADD(" AND O.TipoOp = '"~Val(eb1)~"' ")
SQL.ADD(" AND P.TipoOp IN ('DTCAP','DTFLO') ")
SQL.ADD(" AND C.Total2 > 0 ")
SQL.ADD(" AND P.OperacionRef = O.NrOperacion ")

SQL.ADD(" UNION ")

***---Venta de Cap y Floor
SQL.ADD(" Select C.Total2 Cantidad, C.Precio1 Tasa,  0 SpreadC, C.Fecha1 FechaOp, ")
SQL.ADD(" C.Fecha2 FechaVto, O.TipoOp, C.Total3 Spread, P.RB8, 0 TotalComisiones, ")
SQL.ADD(" 0 PeriodoInts, 'SCAP/FLOOR' Tipo, O.NrOperacion, P.Especie,P.NrOperacion OpSwap ")
SQL.ADD(" From "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES P ")
SQL.ADD(" Where P.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND P.MB3 = 1 ")
SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.NrOperacion = '"~Val(eb2)~"' ")
SQL.ADD(" AND O.TipoOp = '"~Val(eb1)~"' ")
SQL.ADD(" AND P.TipoOp IN ('DTCAP','DTFLO') ")
SQL.ADD(" AND C.Total2 > 0 ")
SQL.ADD(" AND P.OperacionRef = O.NrOperacion ")
