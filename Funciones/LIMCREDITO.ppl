Recorrer&i 1,val(da1)
   ACN(dv1,0)
   ACN(dv2,0)
   SQL.ADD("Select L.Commited,L.Sublimite,L.Especie,L.PlazoDesde,L.PlazoHasta,L.MontoOperativo,L.Tenor, ")
   SQL.ADD("L.Vehiculo ")
   SQL.ADD("from "~DBO~".LIMASIGNADOS L ")
   SQL.ADD("where L.Cliente='"~val(db:&i)~"' ")
   if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and   L.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD("and L.Limite='DFROM' ")
   SQL.ADD("and L.FAsignacion <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("and  (L.PlazoDesde in (1,31,91,181,366,731) and L.PlazoHasta in (30,90,180,365,730,10000)) ")
   SQL.ADD("Union ")
   SQL.ADD("Select LL.Commited,LL.Sublimite,LL.Especie,LL.PlazoDesde,LL.PlazoHasta,0 as MontoOperativo,0 as Tenor, ")
   SQL.ADD("LL.Vehiculo ")   
   SQL.ADD("from "~DBO~".LIMCONSUMIDOS LL ")
   SQL.ADD("where LL.Cliente='"~val(db:&i)~"' ")
   if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and   LL.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD("and   LL.Limite='DFVN' ")
   SQL.ADD("and   LL.Monto > 0 ")
   SQL.ADD("and   LL.Commited in ('SI','NO') ")
   SQL.ADD("and  (LL.PlazoDesde in (1,31,91,181,366,731) and LL.PlazoHasta in (30,90,180,365,730,10000)) ")
   SQL.ADD("and   Not Exists (Select Monto from "~DBO~".LIMASIGNADOS M")
   SQL.ADD("                where  M.Cliente   = '"~val(db:&i)~"' ")
   if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("                and   M.Vehiculo  = '"~Dialogo.Vehiculo1~"'")
   endif
   SQL.ADD("                and   (M.PlazoDesde in (1,31,91,181,366,731) and M.PlazoHasta in (30,90,180,365,730,10000)) ")
   SQL.ADD("                and    M.Limite    = 'DFROM' ")
   SQL.ADD("                and    M.FAsignacion <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("                and    M.Especie   = LL.Especie ")
   SQL.ADD("                and    M.PlazoDesde= LL.PlazoDesde ")
   SQL.ADD("                and    M.PlazoHasta= LL.PlazoHasta ")
   SQL.ADD("                and    M.Commited  = LL.Commited ")
   SQL.ADD("                and    M.Sublimite = LL.Sublimite) ")
   SQL.ADD("order by 8,1,2,3,4,5")

   Recorrer SQL
    ACN(zg:fac, FBN['MontoOperativo'])
 
    if Vacio(FBN['Sublimite']) y FBN['PlazoHasta']=30
      SCN(xa2,val(zg:fac))

      ACN(zh:fac,LimConsumido(val(db:&i),'DFROM',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,FBN['PlazoDesde'],,,,FBN['Commited']))
      if Eqstr(FBN['Especie'],'USD')
        SCN(xb2,val(zh:fac))
      else
        SCN(xb2,val(zh:fac)*CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1-1,1,SI,'USD'))
      endif
      if Eqstr(FBN['Commited'],'SI')
         ACN(dv1,1)
      else
         ACN(dv2,1)
      endif
    endif

    if val(dv1)=0 y NoVacio(FBN['Sublimite']) y Eqstr(FBN['Commited'],'SI')
      ACN(zh:fac,LimConsumido(val(db:&i),'DFVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,1,,,FBN['Sublimite'],FBN['Commited']))
      if Eqstr(FBN['Especie'],'USD')
        SCN(xb2,val(zh:fac))
      else
        SCN(xb2,val(zh:fac)*CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1-1,1,SI,'USD'))
      endif
      ACN(dv1,1)
    endif    

    if val(dv2)=0 y NoVacio(FBN['Sublimite']) y Eqstr(FBN['Commited'],'NO')
      ACN(zh:fac,LimConsumido(val(db:&i),'DFVN',FBN['Especie'],0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,1,,,FBN['Sublimite'],FBN['Commited']))
      if Eqstr(FBN['Especie'],'USD')
        SCN(xb2,val(zh:fac))
      else
        SCN(xb2,val(zh:fac)*CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1-1,1,SI,'USD'))
      endif
      ACN(dv2,1)
    endif    

   Proximo

   SCN(xa2, LimOperativo(val(db:&i),'SECDF','USD',Dialogo.Vehiculo1,,,,,,,,,,1))
   SCN(xb2, LimConsumido(val(db:&i),'SECDF','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,1))

   SCN(xa2, LimOperativo(val(db:&i),'PRESETTLEM','USD',Dialogo.Vehiculo1,,,,,,,,,,1))
   SCN(xb2, LimConsumido(val(db:&i),'PRESETTLEM','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,1))
 
   SCN(xa2, LimOperativo(val(db:&i),'PRESETREPO','USD',Dialogo.Vehiculo1,,,,,,,,,,1))
   SCN(xb2, LimConsumido(val(db:&i),'PRESETREPO','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,1))

   SCN(xa2, LimOperativo(val(db:&i), 'SETTLEMENT','USD',Dialogo.Vehiculo1))

   SCN(xb2, LimTotalizado3(val(db:&i),'SETTLEMENT',Dialogo.Fecha1,Dialogo.Vehiculo1,,,,,,,,,,,,,'USD'))
   SCN(xb2, LimTotalizado3(val(db:&i),'SETCRE',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1,,,,,,,,,'USD'))

Proximo
