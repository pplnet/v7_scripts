* AB1: 1: Filas especiales de Euroclear
*      2: Filas especiales no Euroclear
*      3: Resto de las filas

SQL.ADD("Select O.NrOperacion, MP.Cliente, MP.FechaMov, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre, O.Cuenta3 Cuenta, MP.Mercado Mercado  ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                 ")
SQL.ADD("   AND MP.Cliente=C.Codigo                 ")
SQL.ADD("   AND O.Especie=E.Codigo                 ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'        ")
if val(AB1) = 1
   * Filas de EuroClear
   SQL.ADD(" and MP.Mercado = 'EU' ")
else
   if val(AB1) = 2 
      SQL.ADD(" and MP.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
   else
      * AB1 = 3   
      SQL.ADD(" and MP.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
   endif
endif

SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and MP.NrSaldo in (1) ")
* FJL 29/9/22 - Incluir la moneda de las TOCPRI solo de CP
*SQL.ADD("  and O.TipoOp in ('TIC', 'TIV', 'TIFC', 'TIFV') ")
SQL.ADD("  and (O.TipoOp in ('TIC', 'TIV', 'TIFC', 'TIFV') OR (O.TipoOp in ('TCOPRI') and O.Cliente1=O.Vehiculo1)) ")
SQL.ADD("  and O.PaseCB = 0                               ")
SQL.ADD(" and  MP.Mercado <> 'EU'                         ")
SQL.ADD(" and (O.Convenio <> 1  or O.Convenio is null )   ")

SQL.ADD(" UNION ALL                                       ")

SQL.ADD("Select O.NrOperacion, MP.Cliente, MP.FechaMov, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre, O.Cuenta3 Cuenta, MP.Mercado Mercado  ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E  ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                 ")
SQL.ADD("   AND MP.Cliente=C.Codigo                 ")
SQL.ADD("   AND O.Especie=E.Codigo                 ")
SQL.ADD(" AND   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'        ")
if val(AB1) = 1
   * Filas de EuroClear
   SQL.ADD(" and MP.Mercado = 'EU' ")
else
   if val(AB1) = 2 
      SQL.ADD(" and MP.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
   else
      * AB1 = 3   
      SQL.ADD(" and MP.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
   endif
endif

SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" and (MP.NrSaldo = 1 OR  ")
SQL.ADD("     (MP.NrSaldo = 31 and MP.NrMov = 2) ) ")
* FJL 29/9/22 - Incluir la moneda de las TOCPRI solo de CP
*SQL.ADD("  and O.TipoOp in ('TIC', 'TIV', 'TIFC', 'TIFV') ")
SQL.ADD("  and (O.TipoOp in ('TIC', 'TIV', 'TIFC', 'TIFV') OR (O.TipoOp in ('TCOPRI') and O.Cliente1=O.Vehiculo1)) ")
SQL.ADD("  and O.PaseCB = 0                               ")
SQL.ADD(" and  MP.Mercado <> 'EU' ")
SQL.ADD(" and (O.Convenio <> 1  or O.Convenio is null )   ")