  acn(Y2,1)
  acn(Y3,longitud(val(Y1))+1)
  recorrer&j 1,val(Y3)

  acn(Y4,Posicion('#',val(Y1),val(Y2),val(Y3)))
  acn(y5,Posicion(' ',val(Y1),val(Y4)+1,val(Y3)))
  acn(z1,Posicion(')',val(Y1),val(Y4)+1,val(Y3)))
  acn(z2,Posicion('+',val(Y1),val(Y4)+1,val(Y3)))
  acn(z3,Posicion('-',val(Y1),val(Y4)+1,val(Y3)))
  acn(z4,Posicion('*',val(Y1),val(Y4)+1,val(Y3)))
  acn(z5,Posicion('/',val(Y1),val(Y4)+1,val(Y3)))
  acn(aa1,Posicion(',',val(Y1),val(Y4)+1,val(Y3)))
  acn(aa3,Posicion('<',val(Y1),val(Y4)+1,val(Y3)))
  acn(aa4,Posicion('>',val(Y1),val(Y4)+1,val(Y3)))
  acn(aa5,Posicion('~',val(Y1),val(Y4)+1,val(Y3)))
  
  acn(aa2,10000)

  If val(y5) > 0
     if val(y5) < val(aa2)
        acn(aa2,val(y5))
     endif
  endif
  If val(z1) > 0
     if val(z1) < val(aa2)
      acn(aa2,val(z1))
     endif
  endif
  If val(z2) > 0
     if val(z2) < val(aa2)
        acn(aa2,val(z2))
     endif
  endif
  If val(z3) > 0
     if val(z3) < val(aa2)
        acn(aa2,val(z3))
     endif
  endif
  If val(z4) > 0
     if val(z4) < val(aa2)
        acn(aa2,val(z4))
     endif
  endif
  If val(z5) > 0
     if val(z5) < val(aa2)
        acn(aa2,val(z5))
     endif
  endif
  If val(aa1) > 0
     if val(aa1) < val(aa2)
        acn(aa2,val(aa1))
     endif
  endif
  If val(aa3) > 0
     if val(aa3) < val(aa2)
        acn(aa2,val(aa3))
     endif
  endif
  If val(aa4) > 0
     if val(aa4) < val(aa2)
        acn(aa2,val(aa4))
     endif
  endif
  If val(aa5) > 0
     if val(aa5) < val(aa2)
        acn(aa2,val(aa5))
     endif
  endif

  if val(aa2) = 10000
     acn(aa2,val(Y3)+1)
  endif
* Hay una formula a partir de Y4
  if val(Y4)<>0
     ACT(x7,'SI')

     Recorrer&k val(x6),val(x5)
        If EqStr(val(a:&k),copy(val(Y1),val(Y4)+1,val(aa2)-(val(Y4)+1)))
           * No la informo denuevo
           ACT(x7,'NO')
        endif
     Proximo

     if EqStr(val(x7),'SI')

        act(a:val(x5),copy(val(Y1),val(Y4)+1,val(aa2)-(val(Y4)+1)))
        act(c:val(x5),SQL("Select Script From "~DBO~".FORMULAS Where Codigo = '"~Val(a:val(x5))~"' "))
        ACT(aY1,Copy(val(y1),Val(aa2)+1,(val(y3)-Val(aa2))))
        ACT(y1,Val(ay1))
        scn(x5,1)
     endif
  endif
  if [val(Y2) >=  val(Y3)] o [val(Y4)=0]
     break
  endif
  
  Proximo