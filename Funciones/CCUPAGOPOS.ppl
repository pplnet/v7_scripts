  SQL.ADD(" SELECT * FROM "~DBO~".POSICIONES  ")
  SQL.ADD(" WHERE Especie   ='"~Dialogo.Especie1~"' ")
  SQL.ADD(" AND   Cliente   ='"~Val(l:&i)~"' ")
  SQL.ADD(" and   Fecha    <='"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" and   NrSaldo  IN (1,2) ")
  SQL.ADD(" and   Cupon     ='"~FStr(Dialogo.Entero1,1,0)~"'")
  SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P ")
  SQL.ADD("                 WHERE  Especie = P.Especie ")
  SQL.ADD("                 AND    Cliente = P.Cliente ")
  SQL.ADD("                 AND    NrSaldo = P.NrSaldo ")
  SQL.ADD("                 AND    Cupon   = P.Cupon ")
  SQL.ADD("                 AND    Fecha  <='"~IdxDate(Dialogo.Fecha1)~"') ")

  Recorrer SQL
    *---- Actualizar movimientos de posicion para el cupon
     SQL.ADD(" Insert Into "~DBO~".MOVPOSEJE ")
     SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
     SQL.ADD(" FechaMov, Cliente, Vehiculo,  ")
     SQL.ADD(" NrSaldo, Precio,  ")
     SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader ")
     SQL.ADD(" ) Values ( ")
     SQL.ADD(" '"~Dialogo.Especie1~"', "~Fstr(FBN['CantidadFin']*(-1),1,2)~", '"~Val(y:1)~"', ")
     *SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~fbn('Cliente')~"', '"~Dialogo.Vehiculo1~"', ")
     SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~fbn('Cliente')~"', '"~FBN('Vehiculo')~"', ")
     SQL.ADD(" "~FSTR(fbn('NrSaldo'),1,0)~", "~FStr(fbn['PrecioFin'],1,8)~",  ")
*     SQL.ADD(" "~FSTR(fbn('NrSaldo'),1,0)~", "~FStr(fbn['PrecioFin'],1,8)~",  ")
     SQL.ADD(" '"~FStr(Dialogo.Entero1,1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"' ) ")
     SQL.NEW
     SQL.EXEC
  Proximo

  ** Nuevas Posiciones para Valuacion ***
  ** Agregado 26/05/08 FJL            ***
  ** Modificado 18/11/08 FJL          ***
  SQL.ADD("SELECT * FROM "~DBO~".POSICIONES  ")
  SQL.ADD(" WHERE Especie   ='"~Dialogo.Especie1~"' ")
  *SQL.ADD("   AND Vehiculo  ='"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("   AND Vehiculo  IN ("~Pipe2Comillas(&vehiculos)~") ")
  SQL.ADD("   and Fecha    <='"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD("   AND NrSaldo   >= 120 and NrSaldo < 140 ")
  SQL.ADD("   and Cupon     ='"~FStr(Dialogo.Entero1,1,0)~"'")
  SQL.ADD("   AND Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P ")
  SQL.ADD("                 WHERE  Especie         =  P.Especie ")
  SQL.ADD("                 AND    Vehiculo        =  P.Vehiculo ")
  SQL.ADD("                 AND    IsNull(Book,'') =  IsNull(P.Book,'') ")
  SQL.ADD("                 AND    NrSaldo         =  P.NrSaldo ")
  SQL.ADD("                 AND    Cupon           =  P.Cupon ")
  SQL.ADD("                 AND    Fecha           <= '"~IdxDate(Dialogo.Fecha1)~"') ")

  Recorrer SQL
    *---- Actualizar movimientos de posicion para el cupon
     SQL.ADD(" Insert Into "~DBO~".MOVPOSEJE ( ")
     SQL.ADD("   Especie, Cantidad, NrOperacion, ")
     SQL.ADD("   FechaMov, Cliente, Vehiculo, ")
     SQL.ADD("   NrSaldo, Precio, Cupon, ")
     SQL.ADD("   Tipo, TipoNegocio, Trader, ")
     SQL.ADD("   Book, Unidad, Centro, ")
     SQL.ADD("   Sector, Sucursal, CallPut, ")
     SQL.ADD("   Estrategia, Cartera ")
     SQL.ADD(" ) Values ( ")
     SQL.ADD("   '"~Dialogo.Especie1~"', ")
     SQL.ADD("   "~Fstr(FBN['CantidadFin']*(-1),1,2)~", ")
     SQL.ADD("   '"~Val(y:1)~"', ")

     SQL.ADD("   '"~IdxDate(Dialogo.Fecha1)~"', ")
     *SQL.ADD("   '"~Dialogo.Vehiculo1~"', ")
     SQL.ADD("   '"~FBN('Vehiculo')~"', ")
     *SQL.ADD("   '"~Dialogo.Vehiculo1~"', ")
     SQL.ADD("   '"~FBN('Vehiculo')~"', ")

     SQL.ADD("   "~FSTR(fbn('NrSaldo'),1,0)~", ")
     SQL.ADD("   "~FStr(fbn['PrecioFin'],1,8)~",  ")
     SQL.ADD("   '"~FStr(Dialogo.Entero1,1,0)~"', ")

     SQL.ADD("   '1', ")
     SQL.ADD("   '"~FBN['TipoNegocio']~"', ")
     SQL.ADD("   '"~FBN['Trader']~"', ")

     SQL.ADD("   '"~FBN['Book']~"', ")
     SQL.ADD("   '"~FBN['Unidad']~"', ")
     SQL.ADD("   '"~FBN['Centro']~"', ")

     SQL.ADD("   '"~FBN['Sector']~"', ")
     SQL.ADD("   '"~FBN['Sucursal']~"', ")
     SQL.ADD("   '"~FBN['CallPut']~"', ")

     SQL.ADD("   '"~FBN['Estrategia']~"', ")
     SQL.ADD("   '"~FBN['Cartera']~"' ")
     SQL.ADD(" ) ")
     SQL.NEW
     SQL.EXEC
  Proximo
