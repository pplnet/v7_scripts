SQL.ADD("FechaVto, PorComision, FormaLiquidacion1, ")
SQL.ADD("FormaLiquidacion2, TipoCambio, ")
SQL.ADD("TotalIntereses, TotalNetoCli1, TotalBrutoCli1, ")
SQL.ADD("Mercado, Vehiculo1, Operador, TablaFeriados1, TasaInteresesCupon, FechaUltCupon, TasaBase,  ")
SQL.ADD("Cartera, TotalComisiones, CB9, Cuenta1, Cuenta4, EnteCus1, Cupon1, NrOperacion2, ")      
SQL.ADD("TotalNetoCli3,CB6, ")
SQL.ADD("CanPosTrad,CanPosInv1,CanPosInv2,CanPosOSoc ")
SQL.ADD(") VALUES (")
SQL.ADD("'"~Val(z1)~"', '"~Val(z5)~"', '"~FBN['Especie']~"', "~Fstr(Val(ca:1),0,2)~", "~Val(pr:1)~", '"~FBN['Cliente1']~"', ")
SQL.ADD("'"~FBN['ContraEspecie']~"', '"~IdxDate(Dialogo.Fecha1)~"', 72,")
SQL.ADD(" '"~IdxDate(Habiles(Dialogo.Fecha1,3,'ARG',SI))~"', "~Fstr(FBN['PorComision'],0,7)~", '"~FBN['RB9']~"', ")
SQL.ADD(" '"~FBN['RB10']~"', "~Fstr(FBN['TipoCambio'],0,7)~",")
SQL.ADD(" '"~Val(ti1)~"', "~Fstr(Val(mn1),0,2)~", "~Fstr(Val(mv1),0,2)~", '"~FBN['Mercado']~"', '"~FBN['Vehiculo1']~"',")
SQL.ADD(" '"~FBN['Operador']~"', '"~FBN['TablaFeriados1']~"', "~Fstr(FBN['TasaInteresesCupon'],0,8)~", '"~IdxDate(Val(z9))~"',")
SQL.ADD(" "~Fstr(FBN['TasaBase'],0,8)~", '"~FBN['Cartera']~"', "~Fstr(Val(z6),0,7)~",")
SQL.ADD(" '"~FBN['CB9']~"', '"~Val(cu:1)~"', '"~FBN['Cuenta4']~"', '"~FBN['EnteCus1']~"', '"~FBN['Cupon1']~"', '"~FBN['NrOperacion']~"', ")
SQL.ADD("  "~Fstr(Val(mn1)*CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')),0,2)~",1, ")
SQL.ADD("  "~Fstr(Val(ca:2),0,2)~","~Fstr(Val(ca:3),0,2)~","~Fstr(Val(ca:4),0,2)~","~Fstr(Val(ca:5),0,2)~" ) ")
SQL.NEW
SQL.EXEC

Message('Actualizo Movimientos y Saldo ' )
SQL.ActualizarMovimientos4(Val(z1),SI,SI,SI,SI,SI,SI)
SQL.EXEC


