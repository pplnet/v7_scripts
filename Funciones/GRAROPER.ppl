*-Numero consecutivo de Operaciones

ACT(z1,GetNumerador(1))
                     
*- Monto Bruto                
If Eqstr(FBN['InteresesC'],'CLE')
   ACN(mv1, Val(pr:1)*Val(ca:1)*ValorTeorico2(Val(e:1),Fsys) )
else 
   ACN(mv1, Val(pr:1)*Val(ca:1))
Endif
                                
*- Total Intereses              
ACN(yt1, 1)
ACD(yu:1, Val(fo:1))
ACT(yv:1, Val(e:1))
ACN(yw:1, Val(ca1))
ACD(yx:1, Val(fc:1))
ACN(yy:1, Val(ta:1))
ACN(yz:1, Val(tv:1))

(.'INTERESCLE'.)

ACN(ti:1, Val(zz:1))
                             
*- Monto Neto
IF Incluido(Val(al4), '1585')
   ACN(mn1, Val(mv1)+(Val(ti1)*Val(pr1)) )
ELSE
   ACN(mn1, Val(mv1)+Val(ti1) )
ENDIF

ACD(x97,Habiles(Dialogo.Fecha1,3,'ARG',SI))

*** TotalComisiones
ACN(z6, Val(mv1)*Val(z2)/1000)

*** FechaUltCupon
if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(e1)),'CLE')
    ACD(z9,UltCupon2(Val(e1),Val(x97)))
endif          
     
