*-- Variables para calculo de Resultados
acn(va1,0)
acn(va2,0)
acn(fa1,0)
acn(fa2,0)
acn(pp1,0)
acn(pp2,0)
acn(da1,0)

*--- Titulos 
ACT(a:FAC, 'Fecha')
ACT(a:FAC+1, 'Concert.')
ACT(b:FAC+1, 'Liquidac.')
ACT(c:FAC, 'Contraparte')
ACT(d:FAC, 'Operacion')

If Not EqStr(val(v5),'DIR')
   ACT(e:FAC, 'Precio')
   ACT(e:FAC+1, 'Clean')
   ACT(f:FAC+1, 'Dirty')
   AgregarMarco(e:FAC..f:FAC,2,0,Exe('COLOR'))
   AgregarMarco(e:FAC+1..f:FAC+1,2,2,Exe('COLOR'))
Else
   ACT(f:FAC, 'Precio')
   AgregarMarco(e:FAC..f:FAC+1,2,0,Exe('COLOR'))
Endif

ACT(g:FAC, 'Movimiento')
ACT(g:fac+1,'V/N')
ACT(h:FAC, 'Saldo')
ACT(h:fac+1,'V/N')
ACT(i:FAC, 'Flujo de Fondos')
ACT(i:FAC+1, 'Del Periodo')
ACT(j:FAC+1, 'Acum. del Anio')
ACT(k:FAC  , 'Numero')
ACT(k:FAC+1, 'Operaci¦n')
ACT(l:FAC  , 'Promedio Numerales ')
ACT(l:FAC+1, 'Dias')
ACT(m:FAC+1, 'Numerales')

SetFont(a:fac..m:FAC+1,2)
AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))
AgregarMarco(a:FAC+1..b:FAC+1,2,2,Exe('COLOR'))
AgregarMarco(c:FAC..c:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(d:FAC..d:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(g:FAC..g:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(h:FAC..h:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(i:FAC..k:FAC+1,2,2,Exe('COLOR'))
AgregarMarco(l:FAC..m:FAC,2,0,Exe('COLOR'))
AgregarMarco(l:FAC+1..m:FAC+1,2,2,Exe('COLOR'))

******* Posicion Inicial ***
ifa
ifa
ACT(c:fac,'Posicion Inicial')

* Dias para Calculo de Numerales
ACN(l:fac,Dialogo.Fecha2-Dialogo.Fecha1)

SetFont(a:fac..m:FAC+1,1)
AgregarMarco(c:FAC..d:FAC,2,0)

*---  Calculo de Valor Inicial de Acumulado del Anio
ACD(fp1,VAL(ZZ5))
ACD(fp2,VAL(ZZ5))

(.'GERE3POSIC'.)

*--- Precio al Inicio del anio * Saldo al Inicio del Anio
ACN(j:fac,VAL(pd1)*val(vs1)*(-1))

acn(bb3,fac)

**--- Rango para Valores Numericos Parametro1 TIR Acumulado del Anio aa:fac (27:fac)
**--- Rango para Saldos  Parametro2 TIR Acumulado del Anio aa:fac+1         (27:fac+1)
*---- bb4: Contador de Columnas para Valores TIR
ACN(w3,0)
ACN(w4,0)
ACN(bb4,27)
ACN(val(bb4):fac,0)
ACN(val(bb4):fac+1,VAL(j:fac))

* Max. de Dias para valuar la Tir del Acumulado
If val(w3)=0 y val(j:fac)<>0
   acn(w3,Dialogo.Fecha2-VAL(ZZ5))
EndIf

* 1er. Valor de Columna para Tir de Acumulado Anio
If val(j:fac)<>0 y val(w4)=0
   acn(w4,val(bb4))    
EndIf
SCN(bb4,1)
