* Esta funcion recibe un codigo de estado civil de Iva de BANTOTAL y 
* devuelve el equivalente en FPA, si no existe devuelve vacio

IF EqStr(Val(ba0),'C')
   ACT(bb0, 'CAS')
ELSE
   IF EqStr(Val(ba0),'S')
      ACT(bb0, 'SOL')
   ELSE
      IF EqStr(Val(ba0),'V')
         ACT(bb0, 'VIU')
      ELSE
         IF EqStr(Val(ba0),'D')
            ACT(bb0, 'DIV')
         ELSE
            ACT(bb0, '')
         ENDIF
      ENDIF
   ENDIF
ENDIF
