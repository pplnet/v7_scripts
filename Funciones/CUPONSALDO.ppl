       'Cantidad'        ;g :Val(ha1)..g:val(w1) ;NO;;;100;NUMERO;'###,###,###.##'
       'NrSaldo'         ;m :Val(ha1)..m:val(w1) ;NO;;;100;NUMERO;'###'
       'Precio del Cupon';lc:Val(ha1)..lc:val(w1);NO;;;90;NUMERO;'###.######'
       'Moneda'          ;le:Val(ha1)..le:val(w1);NO;;;50;STRING
       'Efectivo'        ;ld:Val(ha1)..ld:val(w1);NO;;;100;NUMERO;'###,###,###.##'
*       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(l:FLB)~"'            AND Estado = 'HAB'  AND TipoCuenta IN ('CC','CA','CUS') AND (Especies LIKE '%"~val(m:FLB)~"%'             OR Especies LIKE '%"~IIf(EqStr(val(m:FLB)            ,Val(dz1)),Val(dz2),Val(dz1))~"%')  "
*       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(A:FLB+Val(ha1)-1)~"' AND Estado = 'HAB'  AND TipoCuenta IN ('CC','CA','CUS') AND (Especies LIKE '%"~val(le:FLB+Val(ha1)-1)~"%' OR Especies LIKE '%"~IIf(EqStr(val(le:FLB+Val(ha1)-1),Val(dz1)),Val(dz2),Val(dz1))~"%')  "
** FJL 29/07/2020 - Se agrega 2do Mercado
*       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI;;;90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(A:FLB)~"' AND Estado = 'HAB'  AND TipoCuenta IN ('CC','CA','CUS') AND (Mercado = '"~Val(d:FLB)~"' OR Mercado = '"~Val(e:FLB)~"') AND (Especies LIKE '%"~val(le:FLB)~"%' OR Especies LIKE '%"~IIf(EqStr(val(le:FLB),Val(dz1)),Val(dz2),Val(dz1))~"%')  ";RGB(220,220,193)
** FJL 01/08/2020 - Se agrega validacion y cambia criterio especies
*       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI          ;Val(k:FLB)=0 o Val(h:FLB)=0 o [NoVacio(Val(lb:FLB)) y Incluido(Val(lb:FLB),Val(lf:FLB))];'Debe ingresar una cuenta valida. (Linea '~FStr(Val(i:FLB),0,0)~')';90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(A:FLB)~"' AND Estado = 'HAB'  AND TipoCuenta IN ('CC','CA','CUS') AND (Mercado = '"~Val(d:FLB)~"' OR Mercado = '"~Val(e:FLB)~"') AND (Especies LIKE '%"~val(le:FLB)~"%' OR Especies LIKE '%MONEDA%')  ";IIF(Val(h:FLB)=1,RGB(220,220,193));IIF(Val(h:FLB)=1,Val(lb:FLB),'')
** FJL 10/03/2023 - Para agregar MERINT y VISTA
       'A Cuenta'        ;lb:Val(ha1)..lb:val(w1);SI          ;Val(k:FLB)=0 o Val(h:FLB)=0 o [NoVacio(Val(lb:FLB)) y Incluido(Val(lb:FLB),Val(lf:FLB))];'Debe ingresar una cuenta valida. (Linea '~FStr(Val(i:FLB),0,0)~')';90;TABLA;'Cuentas';'Codigo';'Codigo;Nombre;Numero;Especies';"Cliente = '"~Val(A:FLB)~"' AND Estado = 'HAB'  AND TipoCuenta IN ('CC','CA','CUS','VIS') AND (Mercado = '"~Val(d:FLB)~"' OR Mercado in ("~Pipe2Comillas(Val(e:FLB))~")) AND (Especies LIKE '%"~val(le:FLB)~"%' OR Especies LIKE '%MONEDA%')  ";IIF(Val(h:FLB)=1,RGB(220,220,193));IIF(Val(h:FLB)=1,Val(lb:FLB),'')
       'Linea'           ;i :Val(ha1)..i:val(w1) ;NO;;;60;NUMERO;'###';
*       'Valida Cta'      ;h :Val(ha1)..h:val(w1) ;NO;;;60;NUMERO;'###'
*       'CallPut'         ;o :Val(ha1)..o:val(w1) ;NO;;;40;STRING
*       'FechaEj'         ;p :Val(ha1)..p:val(w1) ;NO;;;50;FECHA
*       'PrecioEj'        ;q :Val(ha1)..q:val(w1) ;NO;;;60;NUMERO;'###.########'
     FinListBox

     IF NOT OK 
       Cancelar
     ENDIF
   ENDIF  

   ACT(k0, 'SI')
   Recorrer&i 100,val(w1)
      IF Val(k:&i)=1

         IF EqStr(Val(k0),'SI')
            ACT(k0, 'NO')

            *- Genera la Transaccion de Cupon 
            (."GENCUPON".)

            *- Genera la Transaccion de Liquidacion Cupon 
            If val(jo1)=6 
               *- Parametros para llamar a la funcion
               *- b4: Especie Cupon c2: Nro. Cupon h4: Fecha Proximo Corte 
               *- m1: Moneda k2: % Amortizacion l2: % Renta m2: Interes Capitalizados j2: Vehiculo  
               ACT(lb4,val(b4))
               ACN(lc2,val(c2))
               ACD(lh4,Dialogo.Fecha2)
               ACT(lm1,Dialogo.Especie2)
               ACN(lk2,val(k2))
** FJL 01/08/20 - Ingreso de TNA
               ACN(ls:2,val(s:2))
*****
               ACN(ll2,val(l2))
               ACN(lm2,val(m2))
               ACT(lj2,val(j2))

               (."GENLCUPON".)
               ACT(rx:1, Val(y2))
            EndIf
         ENDIF

         IF Eqstr(Val(o:&i), 'CAL')
            ACT(y:3,'0')
         ELSE
            IF Eqstr(Val(o:&i), 'PUT')
               ACT(y:3,'1')
            ELSE
               ACT(y:3,'')
            ENDIF
         ENDIF

         ACN(fi1,&i)

         If val(jo1)=6 
            Message('*---Calculo de Comisiones por CORTE DE CUPON')
            *- cl1: Cliente ce1: Especie Original del Saldo *- cv1: Vehiculo cy1: Mercado ct1: Tipo de Comision
            *- da: CallPut db: FechaEj dc: PrecioEj de:Cuenta sa2: Ultimo nro. de Cuota para insertar comisiones
            *- sa:3 Acumulador de Comisiones 

            act(cl1, Val(a:&i))
            act(cv1, Dialogo.Vehiculo1)
            act(cy1, Val(d:&i))
            act(da1, '')
            act(db1, '')
            acn(dc1, 0)
            act(de1, Val(lb:&i))
            act(ce1, Val(b:&i))

            acn(ci:2,0)
            acn(ci:1,0)
            acn(sa2,0)
            acn(sa3,0)
            acn(re1,0)
            acn(re2,0)
            acn(re3,0)
            acn(ci:12,0)
            acn(ci:11,0)

            *- Calculo la comision de la Renta solamente para los Saldos <> 201
            If val(aa:9)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz4))
               acn(cj:1,Val(g:&i)*val(aa:9))

               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               (.'CACOMISION'.)
               acn(re1, val(sa:3))
            EndIf

            *- Calculo la comision de la Amortizacion solamente para los Saldos <> 201
            If val(aa:8)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1 ,Val(dz5))
               acn(cj:1,Val(g:&i)*val(aa:8))
               acn(hg:1,Val(g:&i))
               acn(hs:1,Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               (.'CACOMISION'.)
               acn(re2, val(sa:3)-val(re1))
            EndIf

            **** Si la moneda de la comision y la de la liq son diferente, paso a otra moneda la comis.
            ***IF NOT EqStr(Dialogo.Especie2,VAR('MONELOCA'))
            ***   ACN(ZA0, CotizacionC(VAR('MONELOCA'), , , , FSys, 1, SI,Dialogo.Especie2))
            ***   acn(sa3,val(sa3)*Val(za0))
            ***   ***ACT(ch1, Val(h:&i))
            ***ENDIF

            *- ci2: Calculo del % del Iva sobre comisiones
            acn(ci:2, Num(Val(dz10))+IIF(EQSTR(Val(bn:&i),'NOI'),Num(Val(dz11)),IIF(EQSTR(Val(bo:&i),'SI'),Num(Val(dz12)),0)))

            *- ci:1 Monto de Iva
            acn(ci:1,ROUND(Abs(val(sa:3))*Val(ci:2)/100,2))

            *- COMISION CAJA DE VALORES DE RENTA
            *- re3: Monto de la comision
            If val(aa:9)<>0 y Val(m:&i)<>Val(sl1)+100
               act(ct1, Val(dz41))
               acn(cj:1,Val(g:&i)*val(aa:9))

               acn(hg:1, Val(g:&i))
               acn(hs:1, Val(m:&i))

               *- Funcion que recupera los montos de comisiones
               *-'CACOMISION'.)
               acn(re3, val(sa:3)-val(re1)-val(re2))
               scn(sa3,-val(re3))
            EndIf

            *- ci12: Calculo del % del Iva sobre comisiones DE CAJA DE VALORES 
            acn(ci:12, Num(Val(dz20)) )

            *- ci:11 Monto de Iva
            acn(ci:11,ROUND(Abs(val(re:3))*Val(ci:12)/100,2))            

            * si la comision es mayor que lo que pago
            IF Val(sa3)+Val(ci1)>Val(ld:&i)
               ACN(sa3, ROUND(val(ld:&i)/(1+Val(ci2)/100),2))
               ACN(ci1, Val(ld:&i)-Val(sa3))
            ENDIF

            ***---BC1 = %Bonif.Comision
            ***---SA4 = Comision Bonificada
            ***---SA5 = IVA Comision Bonificada
            IF Val(SA:3) <> 0 
                ***---Hay Bonificacion sobre la comision
                ACN(SA:4, Val(SA:3) - (Val(SA:3) * Val(BC:1) / 100))
            ELSE
                ACN(SA:4, 0)
            ENDIF

            IF Val(CI:1) <> 0 
                ***---Hay Bonificacion sobre el IVA comision
                ACN(SA:5, Val(CI:1) - (Val(CI:1) * Val(BC:1) / 100))
            ELSE
                ACN(SA:5, 0)
            ENDIF

         EndIf

         Message('Generando Movimientos Nro. '~Val(y:1)~' .... ')       
         *- fv1: Fecha Valida para Movimiento del Corte fv2: Fecha Valida para Movimiento del Pago 
         ACD(fv1,Dialogo.Fecha1)
         ACD(fv2,Dialogo.Fecha2)

         (.'CUPINSMOV'.)
      ENDIF
   Proximo
ELSE
   Message('Noy hay SALDOS para cortar.')
ENDIF
