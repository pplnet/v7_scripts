*acd(xa:1,Fecha(VAR('ULTDEPUR')))

SQL.ADD("SELECT S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente,  ")
SQL.ADD("       SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, C.Sucursal ")

*IF Dialogo.Fecha1<=Val(xa:1)
*   SQL.ADD("FROM   "~DBO~".SALDOSDIAHIST S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
*else
   SQL.ADD("FROM   "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
   *mac
   if novacio(val(ad:1))
       SQL.ADD(",  "~DBO~".CUENTAS CU")
   endif
   *endif
SQL.ADD("WHERE  S1.Cliente = C.Codigo AND ")
SQL.ADD("       E.Codigo = S1.Especie AND ")
*MAC
if novacio(val(ad:1))
     SQL.ADD("       CU.Codigo = S1.cuenta AND ")
     SQL.ADD("       CU.NRdepositante = '"~val(ad:1)~"' AND ")
endif
SQL.ADD("       S1.Saldo <> 0 AND ")
if Eqstr(val(z:10),'CONC')
   SQL.ADD("      S1.Cliente ='"~Val(ap:1)~"' AND ")
   SQL.ADD("      S1.Especie ='"~Val(ao:1)~"' AND ")
   SQL.ADD("      S1.Mercado ='CV' AND ")
   SQL.ADD("      S1.NrSaldo in ("~Val(bz:3)~") AND ")

* por bloqueo
  SQL.ADD("       (("~FSTR(Num(Val(al:1)),1,0)~"=0 AND S1.NrSaldo in ("~Val(bz:1)~")) OR ("~FSTR(Num(Val(al:1)),1,0)~"=2 AND S1.NrSaldo in ("~Val(bz:2)~")))  AND ")
else
   if Eqstr(val(z:10),'LISCE')
      IF NoVacio(Dialogo.Sucursal1)
         SQL.ADD("    C.Sucursal='"~Dialogo.Sucursal1~"' AND ")
      ENDIF
      IF NoVacio(Dialogo.ListaTabla1)
         SQL.ADD("       S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") AND ")
      ENDIF
      IF NoVacio(Dialogo.Lista1)
         SQL.ADD("       S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
      ENDIF
      IF NoVacio(Dialogo.Lista2)
         SQL.ADD("       S1.Especie Not IN ("~Pipe2Comillas(Dialogo.Lista2)~") AND ")
      ENDIF
      **SQL.ADD("       S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
      IF NoVacio(Dialogo.Mercado1)
         SQL.ADD("       S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
      ENDIF
   endif
endif

**SQL.ADD("      S1.NrSaldo in ("~Val(bz:3)~") AND ")
SQL.ADD("       S1.Fecha = (SELECT MAX(S2.Fecha) ")
*IF Dialogo.Fecha1<=Val(xa:1)
*   SQL.ADD("                   FROM   "~DBO~".SALDOSDIAHIST S2 ")
*else
   SQL.ADD("                   FROM   "~DBO~".SALDOSDIA S2 ")
*endif
SQL.ADD("                   WHERE  S2.Cliente = S1.Cliente AND ")
SQL.ADD("                          S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                          S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                          S2.Especie = S1.Especie AND ")
SQL.ADD("                          S2.Cupon = S1.Cupon AND ")
SQL.ADD("                          S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, C.Sucursal ")
SQL.ADD("ORDER BY S1.Especie, S1.Cupon, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.Sucursal ")
watch(sql.batch)
