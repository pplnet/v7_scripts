***********************************************************************************************
* Recibi un Registro 4427 y Completo la tabla COTIZACIONES_TEMPORAL    (OCT)                  *
***********************************************************************************************
*/Guardo en el log de cotizaciones lo que llega del MAE
*AbrirASCII(Val(z2)~'\OCTCOTIZ.TXT',0)
*EscribirASCII(Val(A:2))
*CerrarASCII




*/Proceso el registro
ACT(ln1, Val(a:2))
**********************************************************
*/0160000000040823170704911724427O              FA00000000030124000020040823O              FE00000000030254000020040823999999999999999                            
**********************************************************

ACN(de:1,32)
Repetir
  ACN(z1,0)

  */Recorro el registo hasta encontrar el fin de reg que se indica con -999-
  ACT(ln2, Copy(Val(ln1),Val(de:1),43))
*  Message(Val(ln2))

  */Completo la Tabla
  If Eqstr(trim(Copy(Val(ln2),1,1)),'O')
    ACT(s:1, 'TipoNegocio')
    ACT(t:1, Trim(Copy(Val(ln2),1,1)))
*    message(Val(s:1)~' '~Val(t:1))

    ACT(s:5, 'TipoPrecio')
    ACT(t:5, Copy(Val(ln2),16,1))
*    message(Val(s:5)~' '~Val(t:5))
    if NOT [Eqstr(Val(t:5),'O') o Eqstr(Val(t:5),'F')]
      ACT(er:4, Pad('Tipo de Precio Invalido '~Val(t:5),40))
      ACN(z1,1)
    endif

    ACT(s:6, 'Metodo')
    ACT(t:6, Copy(Val(ln2),17,1))
*    message(Val(s:6)~' '~Val(t:6))
    if NOT [Eqstr(Val(t:6),'A') o Eqstr(Val(t:6),'E') o Eqstr(Val(t:5),'O')]
      if Val(z1)=0
         ACT(er:4, Pad('Metodo Invalido '~Val(t:6),40))
      endif
      ACN(z1,1)
    endif

    ACT(s:10, 'Fecha Precio')
    ACN(t:10, 0)
    ACN(t:10, Fecha(Copy(Val(ln2),42,2)~'/'~Copy(Val(ln2),40,2)~'/'~Copy(Val(ln2),36,4)))
    if Val(t:10)=0
      if Val(z1)=0
         ACT(er:4, Pad('Fecha Precio Erronea',40))
      endif
      ACN(z1,1)
    endif

    ACT(s:11,'Precio') 
    ACN(t:11,Num(Copy(Val(ln2),18,10)) +(Num(Copy(Val(ln2),28,8))/100000000 ))

    if Eqstr(Val(t:5),'O')
      */Precio MTM
      ACT(s:2, 'Especie')
      ACT(c:2, '')
      ACT(t:2, Trim(Copy(Val(ln2),2,5)))

      ACT(c:2,SQL("Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:2)~"' and TipoNegociacion = '"~Val(t:1)~"' "))  
      ACT(t:2,SQL("Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:2)~"' and TipoNegociacion = '"~Val(t:1)~"' "))  
      if Vacio(Val(c:2))
        if Val(z1)=0
          ACT(er:4, Pad('Especie Destino Inexistente (1)',40))
        endif
        ACN(z1,1)
      endif

      ACT(s:7, 'Variable')
      ACT(t:7, Copy(Val(ln2),7,7))
      if Eqstr(Val(t:7),'')
        if Val(z1)=0
          ACT(er:4, Pad('Campo Variable en NULL',40))
        endif
        ACN(z1,1)
      endif
*      message(Val(s:7)~' '~Val(t:7))

      ACT(s:8, 'Especie 2')
      ACT(t:8, trim(Copy(Val(ln2),2,5)))
      ACT(c:8, '')
      ACT(c:8, SQL("Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:8)~"' and TipoNegociacion = '"~Val(t:1)~"' "))  
      ACT(t:8, SQL("Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:8)~"' and TipoNegociacion = '"~Val(t:1)~"' "))  
      if Vacio(Val(c:8))
        if Val(z1)=0
          ACT(er:4, Pad('Especie Destino Inexistente (2)',40))
        endif
        ACN(z1,1)
      endif

      ACT(s:9,'Fecha')
      if NoVacio(Val(t:2)) y NoVacio(Val(t:1)) y NoVacio(Val(t:7))
        ACN(t:9, SQL("Select Fecha from  "~DBO~".PLAZOSOCT Where rtrim(ltrim(Especie))=rtrim(ltrim('"~Val(t:2)~"')) and rtrim(ltrim(TipoNegociacion)) = rtrim(ltrim('"~Val(t:1)~"')) and rtrim(ltrim(Variable))= rtrim(ltrim('"~Val(t:7)~"')) "))
        if Val(t:9)=0
          if Val(z1)=0
            ACT(er:4, Pad('Fecha no encontrada en PLAZOSOCT',40))
          endif
          ACN(z1,1)
        endif
      else
        ACT(t:9, '')
        if Val(z1)=0
          ACT(er:4, Pad('Fecha no encontrada en PLAZOSOCT',40))
        endif
        ACN(z1,1)
      endif
     
      if Val(z1)=0
        ACN(nu1,0)
        SQL.ADD("Select Count('*')  as Cuenta from  "~DBO~".COTIZACIONES_TEMPORAL ")
        SQL.ADD(" Where Codigo  = '"~Val(t:8)~"' ")
        SQL.ADD("   and Fecha   = '"~IdxDate(Val(t:10))~"' ")
        SQL.ADD("   and CallPut = 'FUT' ")
        SQL.ADD("   and FechaEj = '"~IdxDate(Val(t:9))~"' ")
        Recorrer SQL 
          SCN(nu1,fbn('Cuenta'))
        Proximo 

        */Actualizo la Tabla 
        if Val(nu1) <> 0
          SQL.ADD(" Update "~DBO~".COTIZACIONES_TEMPORAL ")
          SQL.ADD("    Set Precio1 = "~Val(t:11)~" ")
          SQL.ADD("  Where Codigo  = '"~Val(t:8)~"' ")
          SQL.ADD("    and Fecha   = '"~IdxDate(Val(t:10))~"' ")
          SQL.ADD("    and CallPut = 'FUT' ")
          SQL.ADD("    and FechaEj = '"~IdxDate(Val(t:9))~"' ")
          SQL.NEW         
          SQL.EXEC
        else
          SQL.ADD("Insert into "~DBO~".COTIZACIONES_TEMPORAL ")
          SQL.ADD("(Codigo, Fecha, CallPut, FechaEj, Precio1)")
          SQL.ADD(" Values ")
          SQL.ADD(" ('"~Val(t:8)~"', '"~IdxDate(Val(t:10))~"', 'FUT', '"~IdxDate(Val(t:9))~"', "~Val(t:11)~") ")
          SQL.NEW         
          SQL.EXEC
        endif
      else
        Message('*/Grabo en el Log de Errores')
        */Fecha 
        ACN(Y1, Ahora)
        ACT(Y2, Hora(Val(Y1)))
        ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
        ***** Fecha
        ACT(er1,Val(Y3))
        ***** Hora
        ACT(er:1, Val(er:1)~Copy(Val(Y2),1,2))
        ACT(er:1, Val(er:1)~Copy(Val(Y2),4,2))
        ACT(er:1, Val(er:1)~Copy(Val(Y2),7,2))
        */Codigo de Registro
        ACT(er:1, Val(er:1)~'4427')
        */Motivo
        ACT(er:1, Val(er:1)~Val(er:4))
        */Contenido
        ACT(er:1, Val(er:1)~Val(ln2))
        AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
        EscribirASCII(Val(er:1))
        CerrarASCII
      endif
    else
      */Precio Fixing
      ACT(s:2, 'Especie')
      ACT(c:2, '')
      ACT(c:2, SQL("Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen is NULL and TipoNegociacion = '"~Val(t:1)~"' and TipoCotizacion =  '"~Val(t:5)~"'  and Metodo =  '"~Val(t:6)~"' " ))  
      ACT(t:2, SQL("Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen is NULL and TipoNegociacion = '"~Val(t:1)~"' and TipoCotizacion =  '"~Val(t:5)~"'  and Metodo =  '"~Val(t:6)~"' " ))  
      if Vacio(Val(c:2))
        if Val(z1)=0
          ACT(er:4, Pad('Especie Destino Inexistente (2)',40))
        endif
        ACN(z1,1)
      endif

      ACN(nu1,0)
      if Val(z1)=0
        SQL.ADD("Select Count('*') as Cuenta from  "~DBO~".COTIZACIONES_TEMPORAL ")
        SQL.ADD(" Where Codigo  = '"~Val(t:2)~"' ")
        SQL.ADD("   and Fecha   = '"~IdxDate(Val(t:10))~"' ")
        SQL.ADD("   and CallPut = 'CON' ")
        Recorrer SQL 
          SCN(nu1,fbn('Cuenta'))
        Proximo 
 
        */Actualizo la Tabla
        if Val(nu1) <> 0
          SQL.ADD(" Update "~DBO~".COTIZACIONES_TEMPORAL ")
          SQL.ADD("    Set Precio1 = "~Val(t:11)~" ")
          SQL.ADD("  Where Codigo  = '"~Val(t:2)~"' ")
          SQL.ADD("    and Fecha   = '"~IdxDate(Val(t:10))~"' ")
          SQL.ADD("    and CallPut = 'CON' ")
          SQL.NEW         
          SQL.EXEC
        else
          SQL.ADD("Insert into "~DBO~".COTIZACIONES_TEMPORAL ")
          SQL.ADD("(Codigo, Fecha, CallPut, Precio1 )")
          SQL.ADD(" Values ")
          SQL.ADD(" ('"~Val(t:2)~"', '"~IdxDate(Val(t:10))~"', 'CON', "~Val(t:11)~") ")
          SQL.NEW         
          SQL.EXEC
        endif
      else
        Message('*/Grabo en el Log de Errores')
        */Fecha 
        ACN(Y1, Ahora)
        ACT(Y2, Hora(Val(Y1)))
        ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
        ***** Fecha
        ACT(er:1, Val(Y3))
        ***** Hora
        ACT(er:1, Val(er:1)~Copy(Val(Y2),1,2))
        ACT(er:1, Val(er:1)~Copy(Val(Y2),4,2))
        ACT(er:1, Val(er:1)~Copy(Val(Y2),7,2))
        */Codigo de Registro
        ACT(er:1, Val(er:1)~'4427')
        */Motivo
        ACT(er:1, Val(er:1)~Val(er:4))
        */Contenido
        ACT(er:1, Val(er:1)~Val(ln2))
        AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
        EscribirASCII(Val(er:1))
        CerrarASCII
      endif
    endif
  endif

  SCN(de:1, 43)
  if Eqstr(Trim(Val(ln2)),'999999999999999')
    Break
  endif
Proximo
