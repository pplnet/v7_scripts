if Incluido(fbn['TipoOp'],'MMCDIA|MMFCMV|MMFIMV|MMONM|MMPCCM|MMPCLM|MMSELN|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMSIMV') o Incluido(fbn['TipoOp'],'DTO|DTOV|DTSFV|DTSFF|DTSVV') o Incluido(fbn['TipoOp'],'MRF|MRO') o Incluido(fbn['TipoOp'],'MMCDP|MMD|MMFRN|MMFRNP|MMO|MMON|MMPCCV|MMPCL|MMPCOS|MMPE|MMPI|MMPLME|MMPSC|MMPSI') O Incluido(fbn['TipoOp'],'VIMIND|VIMINM|TEMIND|TEMINM') o Incluido(fbn['TipoOp'],'DTK|DTKVI|DTOM|DTSFVM|DTSFFM|DTSVVM|DTSNFV|DTSNFF|DTSNVV|DTC|DTF|DTSFVV|DTSFVX|DTOMV|MMP|DTCAP|DTFLO') 
   ACT(a:FAC, 'Numero Op.')
   ACT(b:FAC, 'Tipo Op.')
   ACT(c:FAC, 'F.Concert.')
endif

if Incluido(fbn['TipoOp'],'MMCDIA|MMFCMV|MMFIMV|MMONM|MMPCCM|MMPCLM|MMSELN|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMSIMV') 
   ACT(d:FAC, 'Vehiculo')
   ACT(e:FAC, 'Periodo')
   ACT(f:FAC, 'F.Origen')
   ACT(g:FAC, 'Fecha Vto.')
   ACT(h:FAC, 'Plazo')
   ACT(i:FAC, 'Especie')
   ACT(j:FAC, 'V.Nominal')
   ACT(k:FAC, 'Imp.Amort.')
   ACT(l:FAC, 'Tasa Fi/Fl')
   ACT(m:FAC, 'Tasa/T.Base')
   ACT(n:FAC, 'Spread')
   ACT(o:FAC, 'Int.Deven.')
   ACT(p:FAC, 'Int.Total')
   ACT(q:FAC, 'WHT')
   ACT(r:FAC, 'IVA')
   ACT(s:FAC, 'Tasa Total')
   ACT(t:FAC, 'Monto')
   ACT(u:FAC, 'Monto Total')
   ACT(v:FAC, 'Entidad')
   ACN(co:50,ASCII('w')-96)
   SetFont(a:fac..v:FAC,2)
   AgregarMarco(a:FAC..v:FAC,2,0,Exe('COLOR'))
   AlinearCeldas(h:fac..h:fac, 'D')
   AlinearCeldas(j:fac..k:fac, 'D')
   AlinearCeldas(m:fac..u:fac, 'D')
   ifa
Endif

