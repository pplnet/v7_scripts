***---MC:1 = NrMov Monto Comision Total
***---MC:2 = NrMov Monto Comision Pago
***---MC:3 = NrMov Monto Comision Inicio CEC
***---MC:4 = NrMov Monto Comision Pago CEC
***---MC:5 = NrMov Monto Comision Inicio CEN
***---MC:6 = NrMov Monto Comision Pago CEN
***---LC:500 = Comisiones Borradas que hay que mandar contraasientos
ACN(MC:1, 5000)
ACN(MC:2, 10000)
ACN(MC:3, 15000)
ACN(MC:4, 20000)
ACN(MC:5, 25000)
ACN(MC:6, 30000)

***---Monto Comision (Total) al comienzo de la operacion
SQL.ADD(" Select '' NrTrans, 'DEP   ' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" C.Cliente1, C.Especie1 Especie, O.FechaOp Fecha1, Sum(C.Importe1) Cantidad1, O.Precio1, ")
SQL.ADD(" CASE O.TipoOp WHEN  'MMON  ' THEN O.Observac3 WHEN 'MMONM ' THEN O.Observac3 ELSE O.Especie END EspOp, ")
SQL.ADD(" O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, "~Val(MC:1)~" NrMov, ")
SQL.ADD(" '"~Var('INTCOMINI')~"' Leyenda, C.Especie1 EspecieMov, '' OpeMov, 0 as BD1, 0 as BD3, ")
SQL.ADD(" O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, '' Origen, '' Instante, ")
SQL.ADD(" ''SubInstante, 'COMISI' Concepto, '' Concepto1, 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND C.Importe1 > 0 ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
*   SQL.ADD("  and ((O.FechaCargaSys='"~IdxDate(Dialogo.Fecha1)~"') ")
   ***---Busco las operaciones que fueron modificadas
*   SQL.ADD("  OR (O.NrOperacion IN ("~Pipe2Comillas(Val(LC:500))~"))) ")
   SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:1)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif
***---Chequeo que este liquidada
SQL.ADD(" AND O.NrOperacion IN (Select M.NrOperacion From "~DBO~".MOVEJECUTADOS M ")
SQL.ADD("                       Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("                       AND M.Leyenda = 'Monto Comision') ")
SQL.ADD(" Group By O.NrOperacion, O.Vehiculo1, C.Cliente1, C.Especie1, O.FechaOp, O.Precio1, ")
SQL.ADD(" O.Especie, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, O.FechaCargaSys, ")
SQL.ADD(" O.FechaOp2, O.Observac3 ")
******************************************************************************

***---INICIO CEC
SQL.ADD(" UNION ")

***---Monto Comision CEC Inicio - Unico Vto.
SQL.ADD(" Select '' NrTrans, 'DEP   ' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" O.Cliente1, O.ContraEspecie Especie, O.FechaOp2 Fecha1, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMPCL ' THEN O.ImpComCor1 ELSE O.PorComMer1 END Cantidad1, ")
SQL.ADD(" O.Precio1, O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, ")
SQL.ADD(" "~Val(MC:3)~" NrMov, '"~Var('INTCECINI')~"' Leyenda, O.ContraEspecie EspecieMov, ")
SQL.ADD(" '' OpeMov, 0 as BD1, 0 as BD3, O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, ")
SQL.ADD(" '' Origen, '' Instante, ''SubInstante, 'COMISICEC' Concepto, '' Concepto1, ")
SQL.ADD(" 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('MMPCL','MMPE','MMPI') ")
SQL.ADD(" AND ((O.PorComMer1 > 0 AND O.TipoOp <> 'MMPCL') OR (O.TipoOp = 'MMPCL' AND O.ImpComCor1 > 0)) ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
   ***---Busco las operaciones que fueron modificadas
   SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:3)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif

SQL.ADD(" UNION ")

***---Monto Comision CEC Inicio - Multiple Vto.
SQL.ADD(" Select '' NrTrans, 'DEP   ' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" O.Cliente1, C.Especie2 Especie, O.FechaOp2 Fecha1, Sum(C.Cantidad6) Cantidad1, ")
SQL.ADD(" O.Precio1, O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, ")
SQL.ADD(" "~Val(MC:3)~" NrMov, '"~Var('INTCECINI')~"' Leyenda, ")
SQL.ADD(" CASE O.TipoOp WHEN  'MMPCLM' THEN C.Especie1 ELSE C.Especie2 END EspecieMov, ")
SQL.ADD(" '' OpeMov, 0 as BD1, 0 as BD3, O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, ")
SQL.ADD(" '' Origen, '' Instante, ''SubInstante, 'COMISICEC' Concepto, '' Concepto1, ")
SQL.ADD(" 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp IN ('MMPCLM','MMPEM','MMPIM') ")
SQL.ADD(" AND C.Cantidad6 > 0 ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
   ***---Busco las operaciones que fueron modificadas
   SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:3)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" Group By O.NrOperacion, O.Vehiculo1, O.Cliente1, C.Especie2, O.FechaOp2, O.Precio1, ")
SQL.ADD(" O.Especie, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, C.Especie1, ")
SQL.ADD(" O.FechaCargaSys, O.FechaOp2 ")

SQL.ADD(" UNION ")

***---Monto Comision CEC al momento del pago
SQL.ADD(" Select T.NrTrans, T.TipoTr2, T.NrOperacionRef1, T.Vehiculo1, T.Cliente1, ")
SQL.ADD(" M.Especie, T.Fecha1, M.Cantidad Cantidad1, O.Precio1, ")
SQL.ADD(" O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, ")
SQL.ADD(" "~Val(MC:4)~"+ M.NrMov NrMov, M.Leyenda, M.Especie EspecieMov, M.NrOperacion OpeMov, ")
*SQL.ADD(" 0 as BD1, 0 as BD3, M.FechaMov FechaContable, O.FechaVto2 FechaValor, ")
SQL.ADD(" 0 as BD1, 0 as BD3, M.FechaMov FechaContable, M.FechaMov FechaValor, ")
SQL.ADD(" '' Origen, '' Instante, ''SubInstante, 'COMISICEC' Concepto, '' Concepto1, ")
SQL.ADD(" 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
*SQL.ADD(" Where T.NrOperacionRef1 = O.NrOperacion and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" Where (T.NrOperacionRef1 = O.NrOperacion OR T.NrOperacionRef1 = O.OperacionRef) ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND T.NrTrans = M.NrTrans2 ")
SQL.ADD(" AND M.Cantidad > 0 ")
SQL.ADD(" AND M.Leyenda = 'Vto. Comision CEC' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
    SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    If NoVacio(Dialogo.Lista2)
       SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:4)~" + M.NrMov ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and T.Especie='"~Dialogo.Especie1~"' ")
Endif

***---FIN CEC

SQL.ADD(" UNION ")

***---Inicio CEN

***---Monto Comision CEN Inicio - Unico Vto.
SQL.ADD(" Select '' NrTrans, 'DEP   ' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" O.Cliente1, O.ContraEspecie2 Especie, O.FechaOp2 Fecha1, ")
SQL.ADD(" CASE O.TipoOp WHEN  'MMPCOS' THEN O.PorComCor1 ELSE O.ImpComCorEq2 END Cantidad1, ")
SQL.ADD(" O.Precio1, O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, ")
SQL.ADD(" "~Val(MC:5)~" NrMov, '"~Var('INTCENINI')~"' Leyenda, O.ContraEspecie2 EspecieMov, ")
SQL.ADD(" '' OpeMov, 0 as BD1, 0 as BD3, O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, ")
SQL.ADD(" '' Origen, '' Instante, ''SubInstante, 'COMISICEN' Concepto, '' Concepto1, ")
SQL.ADD(" 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN ('MMPE','MMPI','MMPCOS') ")
SQL.ADD(" AND ((O.ImpComCorEq2 > 0 AND O.TipoOp <> 'MMPCOS') OR (O.TipoOp = 'MMPCOS' AND O.PorComCor1 > 0)) ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
   ***---Busco las operaciones que fueron modificadas
   SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:5)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif

SQL.ADD(" UNION ")

***---Monto Comision CEN Inicio - Multiple Vto.
SQL.ADD(" Select '' NrTrans, 'DEP   ' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" O.Cliente1, C.Especie1 Especie, O.FechaOp2 Fecha1, ")
SQL.ADD(" CASE O.TipoOp WHEN  'MMPOSM' THEN Sum(C.Cantidad8) ELSE Sum(C.Plazo4) END Cantidad1, ")
SQL.ADD(" O.Precio1, O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, ")
SQL.ADD(" "~Val(MC:5)~" NrMov, '"~Var('INTCENINI')~"' Leyenda, C.Especie1 EspecieMov, ")
SQL.ADD(" '' OpeMov, 0 as BD1, 0 as BD3, O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, ")
SQL.ADD(" '' Origen, '' Instante, ''SubInstante, 'COMISICEN' Concepto, '' Concepto1, ")
SQL.ADD(" 0 CambioComis, 0 Tipo_De_Cambio, '' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp IN ('MMPEM','MMPIM','MMPOSM') ")
SQL.ADD(" AND ((C.Plazo4 > 0 AND O.TipoOp <> 'MMPOSM') OR (C.Cantidad8 > 0 AND O.TipoOp = 'MMPOSM')) ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
   ***---Busco las operaciones que fueron modificadas
   SQL.ADD(" AND O.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:5)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" Group By O.NrOperacion, O.Vehiculo1, O.Cliente1, C.Especie1, O.FechaOp2, O.Precio1, ")
SQL.ADD(" O.Especie, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, C.Especie1, ")
SQL.ADD(" O.FechaCargaSys, O.FechaOp2 ")

SQL.ADD(" UNION ")

***---Monto Comision CEN al momento del pago
SQL.ADD(" Select T.NrTrans, T.TipoTr2, T.NrOperacionRef1, T.Vehiculo1, T.Cliente1, ")
SQL.ADD(" M.Especie, T.Fecha1, M.Cantidad Cantidad1, O.Precio1, ")
SQL.ADD(" O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, ")
SQL.ADD(" "~Val(MC:6)~" + M.NrMov NrMov, M.Leyenda, M.Especie EspecieMov, M.NrOperacion OpeMov, ")
*SQL.ADD(" 0 as BD1, 0 as BD3, M.FechaMov FechaContable, O.FechaPrecan FechaValor, ")
SQL.ADD(" 0 as BD1, 0 as BD3, M.FechaMov FechaContable, M.FechaMov FechaValor, ")
SQL.ADD(" '' Origen, '' Instante, ''SubInstante, 'COMISICEN' Concepto, '' Concepto1, ")
SQL.ADD(" 0 CambioComis, 0 Tipo_De_Cambio, '' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
*SQL.ADD(" Where T.NrOperacionRef1 = O.NrOperacion and T.TipoTr2 in ('DEP','RET') ")
***---En las operaciones que son de partidas, el voucher tiene el NrOperacion de la partida
SQL.ADD(" Where (T.NrOperacionRef1 = O.NrOperacion OR T.NrOperacionRef1 = O.OperacionRef) ")
SQL.ADD(" and T.TipoTr2 in ('DEP','RET') ")
SQL.ADD(" AND O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND T.NrTrans = M.NrTrans2 ")
SQL.ADD(" AND M.Cantidad > 0 ")
SQL.ADD(" AND M.Leyenda = 'Vto. Comision CEN' ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
SQL.ADD(" AND O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
If Vacio(Dialogo.NrOperacion1)
    SQL.ADD(" AND T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
    If NoVacio(Dialogo.Lista2)
       SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:6)~" + M.NrMov ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and T.Especie='"~Dialogo.Especie1~"' ")
Endif

***---FIN CEN
******************************************************************************
SQL.ADD(" UNION ")

***---Monto Comision (Cuota) al momento de pago de la cuota
SQL.ADD(" Select '' NrTrans, 'DEP   ' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" C.Cliente1, C.Especie1 Especie, C.Fecha1, C.Importe1 Cantidad1, O.Precio1, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMON  ' THEN O.Observac3 WHEN 'MMONM ' THEN O.Observac3 ELSE O.Especie END EspOp, ")
SQL.ADD(" O.ContraEspecie, O.TipoOp, O.Spread, O.TotalIntereses, "~Val(MC:2)~" NrMov, ")
SQL.ADD(" '"~Var('INTCOMPAGO')~"' Leyenda, C.Especie1 EspecieMov, '' OpeMov, 0 as BD1, 0 as BD3, ")
SQL.ADD(" O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, '' Origen, '' Instante, ")
SQL.ADD(" ''SubInstante, 'COMISI' Concepto, '' Concepto1, 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" Where O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND C.Importe1 > 0 ")
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:2)~" ")
SQL.ADD("                              AND S.Estado = 'Pendiente') ")
If Vacio(Dialogo.NrOperacion1)
   ***---Fecha de Pago o Borradas hoy
*   SQL.ADD("  and ((C.Fecha1='"~IdxDate(Dialogo.Fecha1)~"') OR (O.NrOperacion IN ("~Pipe2Comillas(Val(LC:500))~") AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD(" AND C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
***---Chequeo que este liquidada
SQL.ADD(" AND O.NrOperacion IN (Select M.NrOperacion From "~DBO~".MOVEJECUTADOS M ")
SQL.ADD("                       Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("                       AND M.Leyenda = 'Monto Comision' ")
SQL.ADD("                       AND C.Fecha1 = M.FechaMov) ")

IF NO
SQL.ADD(" UNION ")

***---Pidieron no mandar mas el capital con origen comision.
***---Monto Capital (Solo para comisiones EF)
SQL.ADD(" Select '' NrTrans, 'DEP' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" C.Cliente1, C.Especie1 Especie, C.Fecha1, O.Cantidad Cantidad1, O.Precio1, ")
SQL.ADD(" O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, ")
SQL.ADD(" O.TotalIntereses, "~Val(MC:2)~" NrMov, '"~Var('INTCOMCAPI')~"' Leyenda, ")
SQL.ADD(" C.Especie1 EspecieMov, '' OpeMov, 0 as BD1, 1 as BD3, ")
SQL.ADD(" O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, '' Origen, '' Instante, ")
SQL.ADD(" ''SubInstante, 'COMISI' Concepto, '' Concepto1, 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" Where O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
***---Comisiones EF estan incluidas en el capital
SQL.ADD(" AND O.Cantidad > 0 ")
SQL.ADD(" AND O.TotalComisiones > 0 ")
SQL.ADD(" AND C.Tipo = 5 ")
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = "~Val(MC:2)~") ")
If Vacio(Dialogo.NrOperacion1)
   SQL.ADD("  and O.FechaCargaSys='"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")
ENDIF
