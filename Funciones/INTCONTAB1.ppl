***---IVA Comision
SQL.ADD(" UNION ")
SQL.ADD(" Select '' NrTrans, 'DEP' TipoTr2, O.NrOperacion NrOperacionRef1, O.Vehiculo1, ")
SQL.ADD(" C.Cliente1, C.Especie1 Especie, C.Fecha1, C.Importe2 Cantidad1, O.Precio1, ")
SQL.ADD(" O.Especie EspOp, O.ContraEspecie, O.TipoOp, O.Spread, ")
SQL.ADD(" O.TotalIntereses, C.NrComision NrMov, '"~Var('INTCOMIVA')~"' Leyenda, ")
SQL.ADD(" C.Especie1 EspecieMov, '' OpeMov, 0 as BD1, 1 as BD3, ")
SQL.ADD(" O.FechaCargaSys FechaContable, O.FechaOp2 FechaValor, '' Origen, '' Instante, ")
SQL.ADD(" ''SubInstante, 'COMISI' Concepto, '' Concepto1, 0 CambioComis, 0 Tipo_De_Cambio,'' as CuentaOrigen, '' as CuentaDestino ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".COMISIONES2 C ")
SQL.ADD(" Where O.TipoOp IN ("~Pipe2Comillas(Val(OC:1))~") ")
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND C.Importe2 > 0 ")
SQL.ADD(" AND O.NrOperacion Not IN (Select S.NrOperacion From "~DBO~".MOVIMIENTOS S ")
SQL.ADD("                              Where S.NrOperacion = O.NrOperacion ")
SQL.ADD("                              AND S.Movimiento_Numero = C.NrComision) ")
If Vacio(Dialogo.NrOperacion1)
   SQL.ADD("  and C.Fecha1='"~IdxDate(Dialogo.Fecha1)~"' ")
   If NoVacio(Dialogo.Lista2)
      SQL.ADD("       and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   Endif
Else
   SQL.ADD("       and O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie='"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:10))~") ")

