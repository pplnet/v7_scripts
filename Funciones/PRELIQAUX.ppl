SQL.ADD("  from "~DBO~".MOVEJECUTADOS M with (Index = INDME5), "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONES O ")
SQL.ADD("  where M.NrTrans2   = T.NrTrans ")
SQL.ADD("  and T.NrTrans IN (SELECT B.NrOperacion from "~DBO~".OPERACIONESBITS B WHERE B.NrOperacion=T.NrTrans and B.NrBit=12 and B.Valor='1') ")
SQL.ADD("  and   M.NrOperacion= O.NrOperacion ")
SQL.ADD("  and   T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and   T.Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif

if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if Dialogo.Radio6=0 
   SQL.ADD("  and M.Cliente = O.Cliente1 ")
   SQL.ADD("  and M.Cliente = T.Cliente1 ")
else
   if Dialogo.Radio6=1 
      SQL.ADD(" and M.Cliente = O.Cliente2 ")
      SQL.ADD("  and   M.Cliente = T.Cliente1 ")
   Else 
      *- Radio6=2 Preliquidacion de ArgenClear 
      SQL.ADD("  and M.Cliente = O.Cliente1 ")
      SQL.ADD("  and T.Cliente1='"~SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' ")~"' ")
   endif
endif
if Dialogo.Radio2=0
   *- Extrabursatil 
   SQL.ADD(" and O.TipoOp in ('TIC', 'TIV', 'TIFV', 'TIFC','TCC','TVP','TCP','TVC')")
   IF Dialogo.Radio7 = 0
      *- Por Clientes
      SQL.ADD("  and O.Cliente1 NOT IN (SELECT C.Codigo from "~DBO~".CLIENTES C WHERE C.Codigo=O.Cliente1 and C.CategDepositante IN ("~Pipe2Comillas(VAR('NOCLIENTES'))~")) " )
   ELSE
      *- Por ContraPartes
      SQL.ADD("  and O.Cliente1 IN (SELECT C.Codigo from "~DBO~".CLIENTES C WHERE C.Codigo=O.Cliente1 and C.CategDepositante IN ("~Pipe2Comillas(VAR('NOCLIENTES'))~")) ")
   ENDIF
Else
   if Dialogo.Radio2=3
      SQL.ADD(" and O.TipoOp in ('CTP', 'CTC', 'VTP', 'VTC','CFTC','CFTP','VFTP','VFTC')")
   else
      SQL.ADD(" and O.TipoOp in ('TCOPRI')")
      IF Dialogo.Radio7 = 0
         *- Por Clientes
         SQL.ADD("  and O.Cliente1 NOT IN (SELECT C.Codigo from "~DBO~".CLIENTES C WHERE C.Codigo=O.Cliente1 and C.CategDepositante IN ("~Pipe2Comillas(VAR('NOCLIENTES'))~")) ")
      ELSE
         *- Por ContraPartes
         SQL.ADD("  and O.Cliente1 IN (SELECT C.Codigo from "~DBO~".CLIENTES C WHERE C.Codigo=O.Cliente1 and C.CategDepositante IN ("~Pipe2Comillas(VAR('NOCLIENTES'))~")) ")
      ENDIF
   Endif
Endif

if Dialogo.Radio11 = 2
   Message('*- Comision')
   SQL.ADD("  and M.NrGrupo = '15' ")
else
   SQL.ADD("  and M.NrGrupo <> '15' ")
endif


