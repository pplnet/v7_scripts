If Eqstr(FBN['Campo'],'Persona')
   If Eqstr(FBN['ValorActual'],'SI')
      ACT(z1,'F')
      ACN(az1,1)
   Else
      ACT(z1,'J')
      ACN(az1,1)
   Endif
Else
   If Eqstr(FBN['Campo'],'RazonSocial')
      ACT(z2,FBN['ValorActual'])
      ACN(az1,1)
   Else
      If Eqstr(FBN['Campo'],'Direccion')
         ACT(z3,FBN['ValorActual'])
         ACN(az1,1)
      Else 
         If Eqstr(FBN['Campo'],'Localidad')
            ACT(z4,FBN['ValorActual'])
            ACN(az1,1)
         Else
            If Eqstr(FBN['Campo'],'PaisDir') o Eqstr(FBN['Campo'],'Pais')
               ACT(z5,FBN['ValorActual']) 
               ACN(az1,1)
            Else
               If Eqstr(FBN['Campo'],'CUIT')
                  ACT(z6,FBN['ValorActual'])
                  ACN(az1,1) 
                  *MessageBox('Campo CUIT')
               Else
                  If Eqstr(FBN['Campo'],'CodigoPostal')
                     ACT(z8,FBN['ValorActual'])
                     ACN(az1,1)
                  Else
                     If Eqstr(FBN['Campo'],'NroInsc')
                        ACT(z9,FBN['ValorActual'])
                        ACN(az1,1)
                     Else
                        If Eqstr(FBN['Campo'],'Folio')
                           ACT(z10,FBN['ValorActual'])
                           ACN(az1,1)  
                        Else
                           If Eqstr(FBN['Campo'],'Libro')
                              ACT(z11,FBN['ValorActual'])
                              ACN(az1,1)
                           Else
                              If Eqstr(FBN['Campo'],'Tomo')
                                 ACT(z12,FBN['ValorActual']) 
                                 ACN(az1,1)
                              Else
                                 If Eqstr(FBN['Campo'],'PaisInsc')
                                    ACT(z13,FBN['ValorActual'])
                                    ACN(az1,1)
                                 Else
                                    If Eqstr(FBN['Campo'],'TipoDocumento')
                                       ACT(z14,FBN['ValorActual'])
                                       ACN(az1,1)
                                    Else
                                       If Eqstr(FBN['Campo'],'NrDocumento')
                                          ACT(z15,FBN['ValorActual'])
                                          ACN(az1,1)
                                       Else
                                          If Eqstr(FBN['Campo'],'Provincia')
                                             ACT(z16,FBN['ValorActual'])
                                             ACN(az1,1)
                                          Else
                                             If Eqstr(FBN['Campo'],'Numero')
                                                ACT(z17,FBN['ValorActual'])
                                                ACN(az1,1)  
                                             Else
                                                If Eqstr(FBN['Campo'],'Apellido')
                                                   ACT(z2,FBN['ValorActual'])
                                                   ACN(az1,1) 
                                                Else
                                                   If Eqstr(FBN['Campo'],'Nombre')
                                                      ACT(z2,FBN['ValorActual'])
                                                      ACN(az1,1)
                                                   Else
                                                      If Eqstr(FBN['Campo'],'Nacionalidad')
                                                         ACT(z18,FBN['ValorActual'])
                                                         ACN(az1,1)
                                                      Endif
                                                   Endif
                                                Endif
                                             Endif
                                          Endif
                                       Endif
                                    Endif
                                 Endif
                              Endif
                           Endif
                        Endif
                     Endif
                  Endif
               Endif
            Endif
         Endif
      Endif
   Endif
Endif
