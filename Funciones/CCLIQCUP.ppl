*****************************************************************************************
**- CCLIQOPE
*****************************************************************************************
**- Genera Operacion de Liquidacion de Cupon

**- Genera la transaccion pago de cupon ***
*-- AA1=MB3=> 1:Pago 0: Cobro
act(aa1,Fstr(VAL(g:&i),0,0))

**-- Obtengo el numerador para la transaccion.
Message('Generando Operacion de Liquidacion Cupon '~VAL(c:&i)~' ')

ACT(Z3,GetNumerador(BuscarCampo('VEHICULOS','Alias1','Codigo',Val(c:&i)))) 

If EqSTr(val(z3),' ')
   Cancelar('Cancelado. Falta el Numerador de '~val(c:&i) )
EndIf

* Z4: MB4 0: Repo 3: Saldo
ACT(Z4,IIF(EqStr(VAL(b:&i),'SPOT'),'2',IIF(EqStr(VAL(b:&i),'SALDO'),'1','0')))

SQL.ADD(" INSERT INTO "~DBO~".OPERACIONES ")
SQL.ADD(" (TipoOp, MB3, NrOperacion, ContraEspecie, Cliente1, ")
SQL.ADD(" Cantidad,FechaOp, FechaPago, ")
SQL.ADD(" FechaCargaSys, FechaCarga, ")
SQL.ADD(" Vehiculo1,Cupon1, ")
SQL.ADD(" ImporteImp, ")
SQL.ADD(" Precio1, ")
SQL.ADD(" OperacionRef,MB4,Especie,")
SQL.ADD(" TotalAux3,TotalNetoCli1,")
SQL.ADD(" Cuenta1,TipoCambio,TipoCambio3,RB3) ")
SQL.ADD(" Values")
SQL.ADD(" ('CUPLIQ','"~Val(aa1)~"', '"~Val(Z3)~"', '"~Dialogo.Especie2~"', '"~Val(a:&i)~"', ")
SQL.ADD(" "~FStr(Val(d:&i),0,4)~",'"~IdxDate(Fsys)~"', '"~IdxDate(Dialogo.Fecha1)~"', ")
SQL.ADD(" '"~IdxDate(FSYS)~"', '"~IdxDate(FSYS)~"',")
SQL.ADD(" '"~Val(c:&i)~"','"~FStr(Dialogo.Entero1,0,0)~"',")
SQL.ADD(" "~Fstr(Dialogo.Precio2,0,7)~", ")
SQL.ADD(" "~Fstr(Dialogo.Precio1,0,7)~", ")
SQL.ADD(" '"~VAL(e:&i)~"','"~Val(Z4)~"','"~Dialogo.Especie1~"',")
SQL.ADD(" "~Fstr(val(i1),0,7)~","~Fstr(val(f:&i),0,7)~", ")
SQL.ADD(" '"~Val(k1)~"',"~Fstr(val(l1),0,7)~","~Fstr(val(h:&i),0,0)~",'1') ")
SQL.NEW


SQL.ADD("UPDATE "~DBO~".OPERACIONES Set NrOperacion2 ='"~VAL(Z3)~"' Where NrOperacion='"~VAL(e:&i)~"' ")
SQL.NEW
SQL.EXEC

* Insert de Instancias: Recibe z3: Nro.Op.
If val(h:&i)=3 o  EqStr(val(z4),'2')
   * Si es Saldo 3 va a supervision especial
   * sino a terminal
   (."ALTAINSTAN".)
Else
   (."ALTAINSTER".)
EndIf


SQL.ActualizarMovimientos2(Val(Z3),SI,NO,NO,SI)
SQL.EXEC