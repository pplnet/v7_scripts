INSTANCIA1
POSTEDICION
FW=2;'ANULO';NrOperacion1=NROPERACION

SQL
"UPDATE "~DBO~".INSTANCIASOP SET Mensaje = '"~OBSERVAC~"' Where NrOperacion = '"~NROPERACION~"' and NrInstancia = "~FSTR(INSTANCIA,2)

BITS
 1;0;FW=1 o FW=2 
30;1;FW=2
 8;1;FW=1 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('FVALOR') ") >= 1
19;1;FW=1 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('FVALOR') ") = 0 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('TASATMOD','RANGOTRANS')") >= 1 
 2;1;FW=1 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('FVALOR') ") = 0 Y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('TASATMOD','RANGOTRANS') ") = 0 Y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('RANGOTASA', 'SPREADNEG') ") >= 1
 3;1;FW=1 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('FVALOR') ") = 0 Y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('TASATMOD','RANGOTRANS') ") = 0 Y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('RANGOTASA', 'SPREADNEG') ") = 0 Y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('DFROMEXCE','DFROMNOAS','RDATEVENC') ") >= 1
 7;1;FW=1 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('FVALOR','RANGOTASA','SPREADNEG','TASATMOD','RANGOTRANS','DFROMEXCE','DFROMNOAS','RDATEVENC') ") = 0 y Not Incluido(VAR('OPSNOCONF'),'MMCO')
10;1;FW=1 y Query(" Select Count(1) From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo in ('FVALOR','RANGOTASA','SPREADNEG','TASATMOD','RANGOTRANS','DFROMEXCE','DFROMNOAS','RDATEVENC') ") = 0 y     Incluido(VAR('OPSNOCONF'),'MMCO')

