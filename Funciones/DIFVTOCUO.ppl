*- Inserto en Cuotas la Fecha Vto original y los intereses
*- originales

*- ta1=NrOperacion
*- ta2=FechaVto
*- ta3=Interes


SQL.ADD(" INSERT INTO "~DBO~".CUOTAS ")
SQL.ADD(" (NrOperacion,NrCuota,Fecha1,Cantidad1) ")
SQL.ADD(" Values ")
SQL.ADD(" ('"~Val(ta1)~"',"~Fstr(val(ck1),0,0)~",'"~IdxDate(Val(ta2))~"',"~FSTr(Val(ta3),0,2)~" ) ")
SQL.NEW

