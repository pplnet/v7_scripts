***************************** Generacion de Movimientos de Limites *****************************

*** Datos de la Operacion ****
SQL.ADD("Select FechaOp,FechaVto,Cliente1,Especie,")
SQL.ADD("Vehiculo1,Sublimite,RB5,Plazo, TipoOp, TotalAux1 ")
SQL.ADD("from "~DBO~".OPERACIONES ")
SQL.ADD("where NrOperacion = '"~val(zz1)~"' ")
Recorrer SQL
 dfa
 ACT(xx1,FBN['Cliente1'])
 ACD(xx2,FBN['FechaOp'])
 ACT(xx3,FBN['Especie'])
 ACT(xx5,FBN['Vehiculo1'])
 ACN(xx6,FBN['Plazo'])
 ACT(xx7,FBN['RB5'])
 ACT(xx8,FBN['Sublimite'])

 if Eqstr(FBN['TipoOp'],'PMU')
    ACN(xx4,FBN['TotalAux1'])
 else
    ACN(xx4,SQL("Select Sum(Cantidad5) from "~DBO~".CUOTAS where NrOperacion='"~val(zz1)~"' "))
 endif

Proximo

ACT(xy1,val(zz3)~' '~val(xx3))

if Eqstr(val(xx7),'0')
   ACT(xy3,'SI')
else
   ACT(xy3,'NO')
endif

if val(xx6)>0 y val(xx6)<31
   ACN(xy5,1)
   ACN(xy6,30)
else
   if val(xx6)>30 y val(xx6)<91
      ACN(xy5,31)
      ACN(xy6,90)
   else
      if val(xx6)>90 y val(xx6)<181
         ACN(xy5,91)
         ACN(xy6,180)
      else
         if val(xx6)>180 y val(xx6)<366
            ACN(xy5,181)
            ACN(xy6,365)
         else
            if val(xx6)>365 y val(xx6)<731
               ACN(xy5,366)
               ACN(xy6,730)
            else
               ACN(xy5,731)
               ACN(xy6,10000)
            endif
         endif
      endif
   endif
endif

**************************************** LIMITE DFROM *****************************************
ACT(xy2,'DFROM')
ACT(xy7,'USD')
if Eqstr(val(xx3),'USD')
   ACN(xy4,val(xx4))
else
   ACN(xy5,COTIZACIONC(val(xx3),,,,val(xx2),1,SI,'USD'))
   if val(xy5)>0
      ACN(xy4,val(xx4)*val(xy5))
   else
      ACN(xy4,val(xx4))
   endif
endif
(.'MIGRACION3'.)

**************************************** LIMITE DFVN ******************************************
ACT(xy2,'DFVN')
ACT(xy7,val(xx3))
ACN(xy4,val(xx4))
(.'MIGRACION3'.)

**************************************** LIMITE BCRAN ******************************************
if EqStr(val(xx5),VAR('VEHICULODE'))
   ACT(xy2,'BCRAN')
   ACT(xy7,'ARP')

   if Eqstr(val(xx3),'ARP')
      ACN(xy4,val(xx4))
   else
      ACN(xy5,COTIZACIONC(val(xx3),,,,val(xx2),1,SI,'ARP'))
      if val(xy5)>0
         ACN(xy4,val(xx4)*val(xy5))
      else
         ACN(xy4,val(xx4))
      endif
   endif
   (.'MIGRACION3'.)
endif



