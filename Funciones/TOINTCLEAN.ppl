VTXT3       : 'InteresClean'    ;1;3;;NO;NO;;;;;BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE);
VCAN19      : 'EspDiasAnio'     ; ; ;;NO;NO;;;;;EspecieDiasAnio(ESPECIE);
VCAN20      : 'EspDiasMes'      ; ; ;;NO;NO;;;;;EspecieDiasMes(ESPECIE);
VPRE2       : 'cd'              ; ; ;;NO;NO;;;;;IF(VCAN19=0 y VCAN20=0,1,0);
VPRE3       : 'TasaIntVig'      ; ; ;;NO;NO;;;;;BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE);
VFEC1       : 'FechaCambioTasa' ; ; ;;NO;NO;;;;;BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE);
VFEC2       : 'UltCupon'        ; ; ;;NO;NO;;;;;UltCupon2(ESPECIE,FECHAVTO);
VFEC3       : 'cg'              ; ; ;;NO;NO;;;;;IF(VCAN20=0 o EsHabil(VFEC2,'USA'),VFEC2,Habiles(VFEC2,BuscarCampo('ESPECIES','Valor10','Codigo',ESPECIE),'USA'));
VPRE4       : 'ch1'             ; ; ;;NO;NO;;;;;((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',ESPECIE)*IF(VPRE2=1,Dif360(VFEC3,VFEC1-1,2),DifDias(VFEC3,VFEC1-1,'USA',NO)))+(VPRE3*(IF(VPRE2=1,Dif360(VFEC1-1,FECHAVTO,2),DifDias(VFEC1-1,FECHAVTO,'USA',NO)))))/(IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))*100)
VPRE5       : 'ch2'             ; ; ;;NO;NO;;;;;VPRE3*100
VPRE6       : 'ch'              ; ; ;;NO;NO;;;;;IF(VFEC1>VFEC3 y VFEC1<=FECHAVTO,VPRE4,VPRE5)
VPRE7       : 'Sucio1'          ; ; ;;NO;NO;;;;;(VPRE6*IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))/(DiasA(VCAN19,FSys,BuscarCampo('ESPECIES','Valor9','Codigo',ESPECIE))*100))*if(Not eqstr(CotizaEn(ESPECIE),CONTRAESPECIE),COTIZACIONC(CotizaEn(ESPECIE),,,,FECHAORDEN-1,1,SI,CONTRAESPECIE),1)
VPRE8       : 'Sucio2'          ; ; ;;NO;NO;;;;;IF(EqStr(VTXT3,'CLE'),(ValorTeorico2(ESPECIE,FECHAORDEN)+IntsCapitalizados2(ESPECIE,FECHAORDEN)),1)
VPRE15      : 'SucioCap NUEVO'  ;1;1;;NO;NO;;;;;(CampoAgenda(ESPECIE,NrCupon2(ESPECIE,FECHAVTO),4)*IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))/(DiasAnio2(ESPECIE,UltCupon2(ESPECIE,FSYS),ProxCupon2(ESPECIE,FSYS))*100))*if(Not eqstr(CotizaEn(ESPECIE),CONTRAESPECIE),COTIZACIONC(CotizaEn(ESPECIE),,,,FECHAORDEN-1,1,SI,CONTRAESPECIE),1)

