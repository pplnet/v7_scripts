   SQL.ADD("NrMov, NrInstan, CallPut, Formula, ")
   SQL.ADD("Cuenta, Transaccion, Status, Cupon ")
   SQL.ADD(") VALUES ( ")
   SQL.ADD(" '"~val(xa1)~"',"~IdxDate2(val(xa2))~",'"~val(x11)~"','"~val(x10)~"', ")
   SQL.ADD(" '"~val(xa9)~"','"~val(x20)~"', "~val(xa8)~", '"~val(sa:&i)~"', ")
   SQL.ADD("'AV', "~val(sb:&i)~","~val(sc:&i)~",'PM', 0, ")
   SQL.ADD("1, 0,' ',' ', ")
   SQL.ADD(" '"~val(z4)~"',' ',' ',' ') ")
