if Vacio(SQL("Select NrOperacion from "~DBO~".OPERACIONES where NrSisExterno = '"~Fstr(num(val(x6)),0,0)~"' and TipoOp in ('PMU','PME') "))

ACT(xa1,GetNumerador(25))
MESSAGE(val(xa1))

ACD(xa2,Fecha(val(x7)))
ACD(xa3,Fecha(val(x8)))
ACN(xa4,val(xa3)-val(xa2))

ACD(xa5,Fecha(val(x29)))

if Vacio(val(x23))
  ACT(xa6,'0')
else
 if num(val(x23))=0
   ACT(xa6,'1')
 else
   ACT(xa6,'0')
 endif
endif

if Vacio(val(x24))
  ACT(xa7,'0')
else
 if num(val(x24))=0
   ACT(xa7,'1')
 endif
endif

if Vacio(val(x28))
   ACN(xa8,0)
else
   ACN(xa8,num(val(x28)))
endif

if Vacio(val(x14))
  ACN(x14,0)
endif

if Vacio(val(x16))
  ACN(x16,0)
endif

if Vacio(val(x18))
  ACT(x18,'ARG')
endif

if Vacio(val(x19))
  ACN(x19,0)
endif

ACT(xa9,BuscarCampo('ESPECIES','MercadoDef','Codigo',val(x10)))

ACT(xa10,FormaPago(val(x10),val(xa9) ,'COB',val(xa5),val(x20)))
ACT(xa11,FormaPago(val(x10),val(xa9) ,'PAG',val(xa5),val(x20)))

if Vacio(val(x31))
  ACT(xa12,'0')
else
  ACT(xa12,'1')
  ACT(xa13,val(x31))
endif

if Vacio(val(x32))
   ACN(x32,0)
endif

if Vacio(val(x15))
   ACN(x15,0)
endif

if Vacio(val(x27))
   ACN(x27,0)
endif

if Eqstr(val(x5),'PMU')
 ACN(xa14,num(val(x12))*num(val(x14))*num(val(xa4))/iif(Eqstr(Fstr(num(val(x17)),0,0),'0'),36000,36500))
 ACN(xa15,num(val(x12))+val(xa14))
 ACN(xa16,num(val(x12)))
else
 ACN(xa14,0)
 ACN(xa15,0)
 ACN(xa16,0)
endif

*** FechaVto IMMPO ***
ACD(xa17,SQL("Select FechaVto from "~DBO~".OPERACIONES where NrOperacion='"~val(x22)~"' "))

if Vacio(val(x18))
   ACT(xa18,SQL("Select TablaFeriados1 from "~DBO~".OPERACIONES where NrOperacion='"~val(x22)~"' "))
endif

SQL.ADD("Insert into "~DBO~".OPERACIONES ")
SQL.ADD("(NrOperacion, TipoOp, NrSisExterno, FechaOp, FechaVto, ")
SQL.ADD(" Plazo, Especie, Cliente1, Cantidad, MB2, Precio1, ")
SQL.ADD(" TasaInteresesCupon, DiasAnio, TablaFeriados1, Cuotas1, ")
SQL.ADD(" Vehiculo1, Book1, NrOperacion2, RB1, RB2, ")
SQL.ADD(" EsAforado, MB3, RB9, TotalComisiones, RB10, ")
SQL.ADD(" FechaEj, Mercado, CuentaContable1, CuentaContable2, ")
SQL.ADD(" RB8, ContraEspecie2, TotalRetenciones, RB5, ")
SQL.ADD(" TipoLimite, Sublimite, Centro2, Precio2, Operador, ")
SQL.ADD(" FechaUltCupon, CB6, TotalIntereses, TotalBrutoCli1, TotalAux1, ")
SQL.ADD(" FechaVto2 )")
SQL.ADD(" values ")
SQL.ADD(" ('"~val(xa1)~"','"~val(x5)~"','"~Fstr(num(val(x6)),0,0)~"',"~IdxDate2(val(xa2))~","~IdxDate2(val(xa3))~", ")
SQL.ADD(" "~val(xa4)~", '"~val(x10)~"', '"~val(x11)~"', "~val(x12)~",'"~Fstr(num(val(x13)),0,0)~"', "~val(x14)~", ")
SQL.ADD(" "~val(x16)~", '"~Fstr(num(val(x17)),0,0)~"', '"~val(xa18)~"', "~val(x19)~", ")
SQL.ADD(" '"~val(x20)~"', '"~val(x21)~"', '"~val(x22)~"', '"~val(xa6)~"', '0', ")
SQL.ADD(" '"~val(xa7)~"',  '"~Fstr(num(val(x25)),0,0)~"', '"~Fstr(num(val(x26)),0,0)~"', "~val(xa8)~", '0',")
SQL.ADD(" "~IdxDate2(val(xa5))~", '"~val(xa9)~"', '"~val(xa10)~"', '"~val(xa11)~"', ") 
SQL.ADD(" '"~val(xa12)~"', '"~val(xa13)~"',"~val(x32)~", '"~Fstr(num(val(x33)),0,0)~"', ")
SQL.ADD(" 'DFROM', '"~Fstr(num(val(x34)),0,0)~"','"~val(x35)~"', "~val(x15)~", '"~USUARIOACTIVO~"', ")
SQL.ADD(" "~IdxDate2(Dialogo.Fecha1)~", '0', "~val(xa14)~", "~val(xa15)~", "~val(xa16)~", ")
SQL.ADD(" "~IdxDate2(val(xa17))~" ) ")
SQL.NEW
SQL.EXEC

**** Generacion del GENDEVENGADO, si es PMU ***
if Eqstr(val(x5),'PMU') y num(val(x14))>0 y [Dialogo.Fecha1>=val(xa2) y Dialogo.Fecha1<=val(xa3)]
  ACN(zz18,1)
  ACT(zz1,val(xa1))
  ACT(zz4,'INTLEN')
  ACN(zz8,140)
  ACN(zz16,num(val(x14)))
  ACT(zz6,val(x20))
  ACT(zz7,val(x20))
  ACT(zz9,val(x10))
  ACT(zz10,val(x21))
  ACN(zz11,1)
  ACT(zz12,val(x10))
  ACT(zz13,val(x18))
  ACN(zz14,IIF(Eqstr(val(zz7),'INGBA'),1,0))

  if val(zz14)=1
    ACD(zz2,val(xa2))
  else
    ACD(zz2,Dialogo.Fecha1)
  endif
  ACD(zz3,val(xa3)-1)

  ACN(zz5,Round(num(val(x12))*(val(zz3)-val(zz2)+1)*num(val(x14))/iif(Eqstr(Fstr(num(val(x17)),0,0),'0'),36000,36500),2))

  ACN(zz15,num(val(x12)))
  ACN(zz17,IIF(Eqstr(Fstr(num(val(x17)),0,0),'0'),360,365))
  ACD(zz19,val(zz2)-1)

  (.'CANPRE12'.)
endif


*************************** La operacion queda en Instancia Terminal (70) **********************
ACN(op1,6)
ACN(op2,7)
ACN(op3,22)
ACN(op4,30)
ACN(op5,50)
ACN(op6,70)

Recorrer&j 1,6
 SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
 SQL.ADD("(NrOperacion,NrBit,Valor) ")
 SQL.ADD("values ")
 SQL.ADD("('"~val(xa1)~"',"~val(op:&j)~",'0') ")
 SQL.NEW
 SQL.EXEC
Proximo

SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor = '1' ") 
SQL.ADD("where NrOperacion = '"~val(xa1)~"' ")
SQL.ADD("and NrBit = 70 ")
SQL.NEW
SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor = '0' ") 
SQL.ADD("where NrOperacion = '"~val(xa1)~"' ")
SQL.ADD("and NrBit = 7 ")
SQL.NEW
SQL.EXEC

if EqStr(val(x5),'PMU')
 ACT(z3,'Alta Prestamo Pago Unico')
else
 ACT(z3,'Alta de Prestamo con Esquema')
endif

ACT(z4,CUENTACLIENTE(val(x11),val(x10),,val(xa9),val(x5))) 

****************************** Desembolso Liquidado ************************************
