SQL.ADD(" '"~val(xa9)~"','"~val(x20)~"', "~val(x12)~", '"~val(z3)~"', ")
SQL.ADD("'MV', 1, 1,'PM', 0, ")
SQL.ADD("1, 0,' ',' ', ")
SQL.ADD(" '"~val(z4)~"',' ',' ',' ') ")
SQL.NEW
