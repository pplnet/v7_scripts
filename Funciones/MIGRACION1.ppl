******************************* Si es 2412 / Prestamo relacionado ******************************
if Eqstr(val(xa6),'1')
  ACT(xb1,GetNumerador(25))

  SQL.ADD("Insert into "~DBO~".OPERACIONES ")
  SQL.ADD("(NrOperacion, TipoOp, NrOperacion3, FechaOp, FechaVto, ")
  SQL.ADD(" Plazo, Especie, Cliente1, Cantidad, MB2, Precio1, ")
  SQL.ADD(" TasaInteresesCupon, DiasAnio, TablaFeriados1, Cuotas1, ")
  SQL.ADD(" Vehiculo1, Book1, RB2, RB1, CB6, RB10, ")
  SQL.ADD(" EsAforado, MB3, RB9, PorComision, ")
  SQL.ADD(" FechaEj, Mercado, CuentaContable1, CuentaContable2, Operador, ")
  SQL.ADD(" RB5, TipoLimite, Sublimite, Centro2, ")
  SQL.ADD(" RB8, ContraEspecie2) ")
  SQL.ADD(" values ")
  SQL.ADD(" ('"~val(xb1)~"','"~val(x5)~"','"~val(xa1)~"',"~IdxDate2(val(xa2))~","~IdxDate2(val(xa3))~", ")
  SQL.ADD(" "~val(xa4)~", '"~val(x10)~"', '"~val(x11)~"', "~val(x12)~",'0', 0, ")
  SQL.ADD(" "~val(x16)~", '"~Fstr(num(val(x17)),0,0)~"', '"~val(x18)~"', "~val(x19)~", ")
  SQL.ADD(" 'INGBA', 'BACFS', '1', '0', '0', '1', ")
  SQL.ADD(" '"~val(xa7)~"',  '"~Fstr(num(val(x25)),0,0)~"', '2', "~val(x27)~", ")
  SQL.ADD(" "~IdxDate2(val(xa5))~", '"~val(xa9)~"', '"~val(xa10)~"', '"~val(xa11)~"', '"~USUARIOACTIVO~"', ") 
  SQL.ADD(" '"~Fstr(num(val(x33)),0,0)~"', 'DFROM', '"~val(x34)~"','"~val(x35)~"', ")
  SQL.ADD(" '"~val(xa12)~"', '"~val(xa13)~"' )")
  SQL.NEW
  SQL.EXEC

  SQL.ADD("Update "~DBO~".OPERACIONES set  ")
  SQL.ADD("NrOperacion3 = '"~val(xb1)~"' ")
  SQL.ADD("where NrOperacion = '"~val(xa1)~"' ")
  SQL.NEW
  SQL.EXEC

  Recorrer&j 1,6
   SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
   SQL.ADD("(NrOperacion,NrBit,Valor) ")
   SQL.ADD("values ")
   SQL.ADD("('"~val(xb1)~"',"~val(op:&j)~",'0') ")
   SQL.NEW
   SQL.EXEC
  Proximo

  *** La operacion queda en Instancia Terminal (70) ***
  SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor = '1' ") 
  SQL.ADD("where NrOperacion = '"~val(xb1)~"' ")
  SQL.ADD("and NrBit = 70 ")
  SQL.NEW
  SQL.ADD("Update "~DBO~".OPERACIONESBITS set Valor = '0' ") 
  SQL.ADD("where NrOperacion = '"~val(xb1)~"' ")
  SQL.ADD("and NrBit = 7 ")
  SQL.NEW
  SQL.EXEC

endif

