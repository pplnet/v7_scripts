SQL.ADD("Mercado, EnteCustodia, Cantidad, Leyenda, ")
SQL.ADD("Bits, NrSaldo, NrGrupo, Concepto, NrGrupo2, ")
SQL.ADD("NrMov, NrInstan, CallPut, Formula, ")
SQL.ADD("Cuenta, Transaccion, Status, Cupon ")
SQL.ADD(") VALUES ( ")
