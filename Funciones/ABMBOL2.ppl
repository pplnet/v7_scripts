IF Dialogo.Radio1 = 1
    ***---Baja
    SQL.ADD(" Select Cliente1, Cantidad1, Fecha2, NrOperacionRef1, Cambio1, CEmpresa3, NrOfic, ")
    SQL.ADD(" Cambio3, Ley2, CEmpresa4, Ley5, Especie1, Cantidad2, Cantidad3, Ley3 ")
    SQL.ADD(" From "~DBO~".TRANSACCIONES2 Where NrTrans = '"~Dialogo.NrTrans1~"' ")
    Recorrer SQL
        ACT(A:fac, Dialogo.NrTrans1)
        ACT(B:fac, fbn('Cliente1'))
        ACN(C:fac, fbn('Cantidad1'))
        ACT(D:fac, fbn('Especie1'))
        ACT(E:fac, fbn('NrOperacionRef1'))
        ACD(F:fac, fbn('Fecha2'))
        ACN(G:fac, fbn('Cambio1'))
        IF Dialogo.Radio2 = 0
            ACT(H:fac, fbn('CEmpresa3'))
            ACT(I:fac, fbn('NrOfic'))
            ACT(J:fac, Pad0(fbn('Cambio3'), 2))
        ELSE
            ACT(I:fac, Pad0(fbn('Cantidad2'), 2))
            ACT(J:fac, Pad0(fbn('Cantidad3'), 2))
            ACT(H:fac, fbn('Ley3'))
        ENDIF
        ACT(K:fac, fbn('Ley2'))
        ACT(L:fac, fbn('CEmpresa4'))
        ACT(M:fac, fbn('Ley5'))
    Proximo
    CrearListBox ; 'Arial,8,';'Baja De Boleto BCRA'
       'Boleto'             ;A:fac..A:fac;NO;;;80;STRING;;RGB(220,220,220);
       'Cliente'            ;B:fac..B:fac;NO;;;80;STRING;;RGB(220,220,220);
       'Cantidad'           ;C:fac..C:fac;NO;;;80;NUMERO;'###,###,###.##';RGB(220,220,220);
       'Moneda'             ;D:fac..D:fac;NO;;;80;STRING;;RGB(220,220,220);
       'Oper. FX'           ;E:fac..E:fac;NO;;;80;STRING;;RGB(220,220,220);
       'Fecha '~IIF(Dialogo.Radio2=0, 'Ingreso', 'Embarque') ;F:fac..A:fac;NO;;;80;FECHA;;RGB(220,220,220);
       'Concepto'           ;G:fac..G:fac;NO;;;80;NUMERO;'######';RGB(220,220,220);
       IIF(Dialogo.Radio2=0, 'Pais Origen', 'Cuenta') ;H:fac..H:fac;NO;;;80;STRING;;RGB(220,220,220);
       IIF(Dialogo.Radio2=0, 'Nro.Ofic.', 'Inst.Vendido') ;I:fac..I:fac;NO;;;80;STRING;;RGB(220,220,220);
       IIF(Dialogo.Radio2=0, 'Inst.Compra', 'Inst.Recibido') ;J:fac..J:fac;NO;;;80;STRING;;RGB(220,220,220);
       'Pagador/Benef'      ;K:fac..K:fac;NO;;;80;STRING;;RGB(220,220,220);
       'PaisPag/PaisBenef'  ;L:fac..L:fac;NO;;;80;STRING;;RGB(220,220,220);
       'SwiftPag/SwiftBenef';M:fac..M:fac;NO;;;80;STRING;;RGB(220,220,220);
    FinListBox
    IF Not OK
        Cancelar
    ENDIF
    message("Eliminando Boleto "~Dialogo.NrTrans1~" ... ")
    SQL.ADD(" Delete "~DBO~".TRANSACCIONES2 Where NrTrans = '"~Dialogo.NrTrans1~"' ")
    SQL.NEW

    SQL.ADD(" Update "~DBO~".OPERACIONES Set NrOperacion4 = Null Where NrOperacion = '"~Val(E:fac)~"' ")
    SQL.NEW
    SQL.EXEC
ENDIF