ACT(VH:2, BuscarCampo('OPERACIONES','Vehiculo2','NrOperacion',fbn('NrOperacion')))
IF Eqstr(Val(CC:1), 'S') Y EqStr(fbn('Libro'),'GL')
   ACT(li:1,Val(li:1)~Pad(IIF(EqStr(VAR('CLASEOPVIN'),BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion')))),Copy(BuscarCampo('CLIENTES','Alias4','Codigo',Val(VH:2)),1,6),''),6))
Else
   ACT(li:1,Val(li:1)~Pad('',6))
Endif
