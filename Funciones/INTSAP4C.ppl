***Obtengo la clase de cuenta***
ACT(cc:1,Copy(BuscarCampo('CONTABILIDAD','Tipo','Codigo',fbn('Cuenta')),1,1))
***Clave de contabilización***
***Cuenta de mayor	"S"	"40" si va al Debe
***Cuenta de mayor	"S"	"50" si va al Haber
***Cliente	"D"	"01" si va al Debe
***Cliente	"D"	"11"  si va al Haber
***Acreedor	"K"	"21" si va al Debe
***Acreedor	"K"	"31" si va al Haber
ACT(li:1,Val(li:1)~IIF(EqStr(Val(cc:1),'S'),IIF(EqStr(fbn('DebitoCredito'),'DEB'),'40','50'),IIF(EqStr(Val(cc:1),'D'),IIF(EqStr(fbn('DebitoCredito'),'DEB'),'01','11'),IIF(EqStr(fbn('DebitoCredito'),'DEB'),'21','31'))))
***Clase de cuenta***
ACT(li:1,Val(li:1)~Pad(VAL(cc:1),1))
***Indicador debe/haber***
ACT(li:1,Val(li:1)~IIF(EqStr(fbn('DebitoCredito'),'DEB'),'S','H'))
***División unívoca global***
ACT(li:1,Val(li:1)~Pad('',4))
***División unívoca global***
ACT(li:1,Val(li:1)~Pad('',4))
***Indicador IVA***
If Not Incluido(fbn('Vehiculo'),VAR('VEHIEXTRAN'))
  ACT(li:1,VAL(li:1)~Pad(SQL("Select Codigo From "~DBO~".DETALLEIVAPER where TipoImpuesto = 'IVA' and Porcentaje = "~FStr(fbn('Valor3'),0,2)~" "),2))
Else
  ACT(li:1,VAL(li:1)~Pad('',2))
Endif
***Importe en moneda local***
ACT(li:1,Val(li:1)~Pad(FStr(Round(fbn('Cantidad2'),2),0,2),15))
