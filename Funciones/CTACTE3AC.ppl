    If Dialogo.Radio8 = 0 
      *ACN(w1, LinkH(11, bv:1))
      *ACN(w11, LinkH(11, bu:1))
      *ACN(w12, LinkH(11, bw:1))
    Else
      *ACN(w1, LinkH(11, by:1))
      *ACN(w11, LinkH(11, bx:1))
      *ACN(w12, LinkH(11, bz:1))
    Endif   
    *CerrarHoja('COREN6',11,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=Dialogo.Radio3,Radio6=2,Radio1=2,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    *CerrarLink(11)
  Else 
    ACN(w1, 0)
    ACN(w11,0)
    ACN(w12, 0)
  Endif  
   *-- Vto. Simple --
  If Dialogo.Radio14=0  o Dialogo.Radio14=1 
     * LinkearHoja('COREN4',12,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=2,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
     * LinkearHoja('COREN4',12,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Check1=0,Radio3=1,Radio1=2,Radio4=-1,Radio2=-1,Radio5=-1,Lista1='',Radio7=Dialogo.Radio7,Lista2=Dialogo.Lista2,Radio6=2,Lista3=Dialogo.Lista3)
    If Dialogo.Radio8 = 0 
      *ACN(w2, LinkH(12, bv:1))
      *ACN(w21, LinkH(12, bu:1))
      *ACN(w22, LinkH(12, bw:1))
    Else
      *ACN(w2, LinkH(12, by:1))
      *ACN(w21, LinkH(12, bx:1))
      *ACN(w22, LinkH(12, bz:1))
    Endif   
    *CerrarHoja('COREN4',12,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=fbn('Codigo'),Radio3=1,Radio6=2,Radio1=2,Radio4=-1,Radio2=-1,Radio5=-1,Radio7=Dialogo.Radio7,Especie1=Dialogo.Especie1,Check4=Dialogo.Check4,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3)
    *CerrarLink(12)
  Else 
    ACN(w2, 0)
    ACN(w21,0)
    ACN(w22, 0)
  Endif  
Endif