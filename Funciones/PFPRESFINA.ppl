*- vi1: Vigentes=1 , Todos los Settements=0
*- vf1: Los que no estan vigentes pero vencieron en ese mes

*- MMPCL,MMPE,MMPI,MMPCOS
*- MMFIMV Definitivos
If Dialogo.Radio3 = 1 
   SQL.ADD("Select O.Vehiculo1,'FRN' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
Else
   SQL.ADD("Select 'Consolidado' Vehiculo1,'FRN' Grupo,O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
EndIf
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha3 FechaSett,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Total3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Cantidad5 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Precio1 ImpIva,O.TotalAux1 TasaWH,")
SQL.ADD("C.Precio3 ImpWH,C.Total1 MontoNeto,O.TasaImp1 TasaImpInt,C.Total9 ImpInt,  ")
SQL.ADD("C.Cantidad4 ImpAmort,O.Cotizacion1,O.Cantidad,C.NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1, ")
SQL.ADD("O.Mercado, O.PorComMer1, O.ImpComMer1, O.Corredor, O.PorComCor1, O.ImpComCor1, O.TasaImp1, O.TotalIVA IVAComCor")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")

If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf

If Dialogo.Radio1 = 1
  If NoVacio(Dialogo.Vehiculo1)   
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  Else
    IF NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
     ENDIF
  EndIf
Else
  IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  ENDIF
EndIf

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf

SQL.ADD(" and O.TipoOp In ('MMFIMV') and O.RB5='0' ")
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")

If val(vi1)=1
   SQL.ADD(" and (C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha3>'"~IdxDate(Dialogo.Fecha1)~"') ")
EndIf

If val(vf1)=1     
   *- Que Vencen en ese mes y anio aunque no esten vigentes
   SQL.ADD(" or (Year(C.Fecha3)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(C.Fecha3)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf

SQL.ADD(" ) ")


SQL.ADD(" Union All")


