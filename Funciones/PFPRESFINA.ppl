SQL.ADD("0 ImpWH,O.TotalNetoCli1 MontoNeto,O.TasaImp1 TasaImpInt,O.ImporteImp ImpInt,  ")
SQL.ADD("O.Cantidad ImpAmort,O.Cotizacion1,O.Cantidad,0 NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1, ")
SQL.ADD("O.Mercado, O.PorComMer1, O.ImpComMer1, O.Corredor, O.PorComCor1, O.ImpComCor1, O.TasaImp1, O.TotalIVA IVAComCor")
SQL.ADD(" from "~DBO~".OPERACIONES O Where ")
SQL.ADD(" O.TipoOp In ('MMSELN') and MB3='0' ")
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")

If val(vf1)=1     
   *- Que Vencen en ese mes aunque no esten vigentes
   SQL.ADD(" or (Year(O.FechaVto)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(O.FechaVto)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf

SQL.ADD(" ) ")

If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf


If Dialogo.Radio1 = 1
  If NoVacio(Dialogo.Vehiculo1)   
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  Else
    IF NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
  EndIf
Else
  IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  ENDIF
EndIf

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf


SQL.ADD(" Union All")


*- MMPCCM, Prestamos Vinculados Multiple Vto.
If Dialogo.Radio3 = 1 
   SQL.ADD("Select O.Vehiculo1, 'Prestamos Vinculados' Grupo, O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
Else
   SQL.ADD("Select 'Consolidado' Vehiculo1, 'Prestamos Vinculados' Grupo, O.NrOperacion,C.Fecha1 FechaOp,O.TipoOp,O.Cliente1,O.Cliente2,O.Cliente3,O.Especie,C.Cantidad2 VResidual,")
EndIf
SQL.ADD("O.RB8,C.Fecha2 FechaVto,C.Fecha2 FechaSett,O.TipoTasa,O.PrecioRef,C.Precio4 Spread,C.Precio2 Tasa,C.Precio3 TTN, ")
SQL.ADD("C.Cantidad3 TotalIntereses,C.Total3 IntNeto,C.Total2 Monto,O.ImpGastos2 TasaIva,C.Total4 ImpIva, CASE O.RB6 WHEN  2 THEN CASE O.MB3 WHEN 0 THEN O.TotalAux1 ELSE 0 END ELSE 0 END TasaWH,")
SQL.ADD(" C.Total7 ImpWH,C.Total1 MontoNeto, 0 TasaImpInt, 0 ImpInt,  ")
SQL.ADD("C.Cantidad1 ImpAmort,O.Cotizacion1,O.PrecioEj as Cantidad,C.NrCuota,O.RB6,O.FechaOp FInicio,O.FechaVto FFin,O.Plazo, O.ContraEspecie, O.FechaCargaSys, ")
SQL.ADD(" '' Swap, O.Observac3,O.CantidadOri, O.TablaFeriados1 Feriados, O.Cuotas1, ")
SQL.ADD("O.Mercado, O.PorComMer1, O.ImpComMer1, O.Corredor, O.PorComCor1, O.ImpComCor1, O.TasaImp1, O.TotalIVA IVAComCor")
SQL.ADD("from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion and MB3='1' ")

If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" AND O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
EndIf

If Dialogo.Radio1 = 1
  If NoVacio(Dialogo.Vehiculo1)   
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~")")
  Else
    IF NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
  EndIf
Else
  IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  ENDIF
EndIf

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf

SQL.ADD(" and O.TipoOp In ('MMPCCM') ")
SQL.ADD(" and O.FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and (O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ")

If val(vi1)=1
   SQL.ADD(" and (C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
EndIf

If val(vf1)=1     
   *- Que Vencen en ese mes aunque no esten vigentes
   SQL.ADD(" or (Year(C.Fecha2)="~Fstr(Anio(Dialogo.Fecha1),0,0)~" ")
   SQL.ADD(" and Month(C.Fecha2)="~Fstr(Mes(Dialogo.Fecha1),0,0)~") ")
EndIf
 
SQL.ADD(" ) ")