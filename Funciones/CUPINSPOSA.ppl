         *- mp13: Pendiente-Ejecutado
         *- pp1: FechaMov 
         *- pp2: Cliente 
         *- pp3: Vehiculo 
         *- pp4: Unidad 
         *- pp5: Centro 
         *- pp6: Sector
         *- pp7: Sucursal 
         *- pp8: NrSaldo 
         *- pp9: Especie 
         *- pp10: PrecioEj  
         *- pp11: FechaEj 
         *- pp12: CallPut
         *- pp13: Cantidad 
         *- pp14: Precio 
         *- pp15: Estrategia 
         *- pp16: Cartera 
         *- pp17: Book 
         *- pp18: Trader,
         *- pp19: TipoNegocio 
         *- pp20: NrOperacion 
         *- pp21: Cupon 
         *- pp22: Tipo 
         *- pp23: Responsable 
         *- pp24: TipoPosicion,
         *- pp25: Producto 
         *- pp26: GrupoEspecie 
         *- pp27: CarteraBCRA

         *- Movimiento Bajando el Cupon Anterior          
         if Dialogo.Fecha4<=FSys
           ACT(mp13, 'AV')
         else
           ACT(mp13, 'MV')
         endif
         
         ACD(pp1 ,Dialogo.Fecha4)
         ACT(pp2 ,FBN['Cliente'])
         ACT(pp3 ,FBN['Vehiculo'] )
         ACT(pp6 ,FBN['Sector'] )
         ACN(pp8 ,FBN['NrSaldo'] )
         ACT(pp9 ,FBN['Especie'] )
         ACT(pp12,'' )
         ACN(pp10,0 )
         ACT(pp11,'')

         IF Incluido(FBN['CallPut'], 'CAL|PUT') 
            ACN(pp10,FBN['PrecioEj'])
            ACT(pp11,FBN['FechaEj'])
         EndIf

         *- Cantidad Original 
         ACN(pp13 ,- val(z:1) )

         *- Precio Anterior
         ACN(pp14, Val(z2) )
         ACT(pp15, FBN['Estrategia'] )
         ACT(pp17, FBN['Book'] )
         ACT(pp19, FBN['TipoNegocio'])
         ACT(pp20, val(y1))
         ACT(pp21, Fstr(Num(FBN['Cupon']),0,0) ) 

         ACT(pp22,'2')
** FJL 25/9/18 - Por calculo de resultados
         If FBN['NrSaldo']>=190 and FBN['NrSaldo']<200
           ACT(pp22,'1')
         Endif

         If Val(c:3)<=0
            * Si es el ultimo cupon genero mov tipo 1 para que genere resultado
            ACT(pp22,'1')
            ACN(pp14 ,Val(z2)-Val(z93) ) 
         Endif
         
         ACT(pp24 ,FBN['TipoPosicion'])

         (."INMOVPOSPE".) 
         *--------------------------------------------------------------

          IF Val(C:3) > 0
             *- Movimiento Subiendo el Cupon Nuevo
             if Dialogo.Fecha4<=FSys
               ACT(mp13, 'AV')
             else
               ACT(mp13, 'MV')
             endif
             ACD(pp1 ,Dialogo.Fecha4)
             ACT(pp2 ,FBN['Cliente'])
             ACT(pp3 ,FBN['Vehiculo'] )
             ACT(pp6 ,FBN['Sector'] )
             ACN(pp8 ,FBN['NrSaldo'] )
             ACT(pp9 ,FBN['Especie'] )
             ACT(pp12,' ' )
             ACN(pp10,0 )
             ACT(pp11,'')

             IF Incluido(FBN['CallPut'], 'CAL|PUT') 
                ACN(pp10,FBN['PrecioEj'])
                ACT(pp11,FBN['FechaEj'])
             EndIf

             *- Cantidad Original 
             ACN(pp13 , val(z:1) )

             *- Precio Nuevo
* FJL 24/04/18 - Se agregan Posiciones Nuevas - Ya estaba con * desde antes
*             If FBN['NrSaldo'] = 171 o FBN['NrSaldo'] = 172 o [FBN['NrSaldo']>=190 and FBN['NrSaldo']<200]
                ACN(pp14 ,Val(z93) )
*             else
*                ACN(pp14 ,Val(z3) )
*             Endif
             ACT(pp15, FBN['Estrategia'] )
             ACT(pp17, FBN['Book'] )
             ACT(pp19, FBN['TipoNegocio'])
             ACT(pp20, val(y1))
             ACT(pp21, Fstr(Num(val(c3)),0,0)) 
             ACT(pp22, '2')
** FJL 25/9/18 - Por calculo de resultados
             If FBN['NrSaldo']>=190 and FBN['NrSaldo']<200
               ACT(pp22,'1')
             Endif

             ACT(pp24 ,FBN['TipoPosicion'])

             (."INMOVPOSPE".) 
          ENDIF
         *--------------------------------------------------------------


         * El cupon tiene alta y baja con los mismos valores para la contabilidad
         *- Movimiento por la Especie Cupon 
         if Dialogo.Fecha4<=FSys
           ACT(mp13, 'AV')
         else
           ACT(mp13, 'MV')
         endif
         ACD(pp1 ,Dialogo.Fecha4)
         ACT(pp2 ,FBN['Cliente']  )
         ACT(pp3 ,FBN['Vehiculo'] )
         ACT(pp6 ,FBN['Sector']   )
         ACN(pp8 ,FBN['NrSaldo']  )
         ACT(pp9 ,val(b4) )
         ACT(pp12,' ' )
         ACN(pp10,0 )
         ACT(pp11,'')

         IF Incluido(FBN['CallPut'], 'CAL|PUT') 
            ACN(pp10,FBN['PrecioEj'])
            ACT(pp11,FBN['FechaEj'])
         EndIf

         *- Cantidad Original 
         ACN(pp13 , val(z:1) )

         *- Precio Nuevo
* FJL 24/04/18 - Se agregan Posiciones Nuevas
         If FBN['NrSaldo'] = 171 o FBN['NrSaldo'] = 172 o [FBN['NrSaldo']>=190 and FBN['NrSaldo']<200]
            * --- Para estos saldos de posicion ppp siempre es en $
            ACN(pp14, Val(z2)-Val(z93) ) 
         else
            ACN(pp14, Val(z2)-Val(z3) ) 
         endif

         ACT(pp15, FBN['Estrategia'] )
         ACT(pp17, FBN['Book'] )
         ACT(pp19, FBN['TipoNegocio'])
         ACT(pp20, val(y1))
         ACT(pp21, Fstr(Num(FBN['Cupon']),0,0) ) 
         ACT(pp22,'2')
** FJL 25/9/18 - Por calculo de resultados
         If FBN['NrSaldo']>=190 and FBN['NrSaldo']<200
           ACT(pp22,'1')
         Endif

         ACT(pp24 ,FBN['TipoPosicion'])

         (."INMOVPOSPE".) 
         *--------------------------------------------------------------

         *- Movimiento por la Especie Cupon 
* FJL 26/04/18 - Se baja la posicion del cupon en la fecha de pago
*         ACD(pp1 ,Dialogo.Fecha4)
         if Dialogo.Fecha2<=FSys
           ACT(mp13, 'AV')
         else
           ACT(mp13, 'MV')
         endif
         ACD(pp1 ,Dialogo.Fecha2)
         ACT(pp2 ,FBN['Cliente'])
         ACT(pp3 ,FBN['Vehiculo'] )
         ACT(pp6 ,FBN['Sector'] )
         ACN(pp8 ,FBN['NrSaldo'] )
         ACT(pp9 ,val(b4) )
         ACT(pp12,' ' )
         ACN(pp10,0 )
         ACT(pp11,'')

         IF Incluido(FBN['CallPut'], 'CAL|PUT') 
            ACN(pp10,FBN['PrecioEj'])
            ACT(pp11,FBN['FechaEj'])
         EndIf

         *- Cantidad Original 
         ACN(pp13 , -val(z:1) )

         *- Precio Nuevo
* FJL 24/04/18 - Se agregan Posiciones Nuevas
         If FBN['NrSaldo'] = 171 o FBN['NrSaldo'] = 172 o [FBN['NrSaldo']>=190 and FBN['NrSaldo']<200]
            ACN(pp14 ,Val(z2)-Val(z93) ) 
         else
            ACN(pp14 ,Val(z2)-Val(z3) ) 
         endif

         ACT(pp15, FBN['Estrategia'] )
         ACT(pp17, FBN['Book'] )
         ACT(pp19, FBN['TipoNegocio'])
         ACT(pp20, val(y1))
         ACT(pp21, Fstr(Num(FBN['Cupon']),0,0) ) 
         ACT(pp22, '2')
** FJL 25/9/18 - Por calculo de resultados
         If FBN['NrSaldo']>=190 and FBN['NrSaldo']<200
           ACT(pp22,'1')
         Endif

         ACT(pp24 ,FBN['TipoPosicion'])

         (."INMOVPOSPE".) 
         *--------------------------------------------------------------

