***---IF fbn('CantidadFin') <> 0
    IF Not Eqstr(fbn('Cotiza'), Val(CZ:1))
        IF Not CeldaVacia(CZ:1)
            SetFont(A:Val(FI:1)..M:fac, 1)
            AgregarMarco(G:Val(FI:1)..I:fac, 0, 0)
            AgregarMarco(J:Val(FI:1)..L:fac, 0, 0)
            ACT(C:fac, 'Total')             
            ACN(D:fac, Sum(D:Val(FI:1)..D:fac-1))
            ACN(G:fac, Sum(G:Val(FI:1)..G:fac-1))
            ACN(H:fac, Sum(H:Val(FI:1)..H:fac-1))
            ACN(I:fac, Sum(I:Val(FI:1)..I:fac-1))
            ACN(J:fac, Sum(J:Val(FI:1)..J:fac-1))
            ACN(K:fac, Sum(K:Val(FI:1)..K:fac-1))
            ACN(L:fac, Sum(L:Val(FI:1)..L:fac-1))
            ACN(M:fac, Sum(M:Val(FI:1)..M:fac-1))
            ***---Total Cartera
            SCN(TD:1, Val(D:fac))
            SCN(TG:1, Val(G:fac))
            SCN(TH:1, Val(H:fac))
            SCN(TI:1, Val(I:fac))
            SCN(TJ:1, Val(J:fac))
            SCN(TK:1, Val(K:fac))
            SCN(TL:1, Val(L:fac))
            SCN(TM:1, Val(M:fac))
            SetFont(C:fac..m:FAC, 2)
            FormatoCeldas(A:Val(FI:1)..B:fac, Exe('F2'))
            FormatoCeldas(C:Val(FI:1)..C:fac, Exe('F8'))
            FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
            FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F8'))
            FormatoCeldas(F:Val(FI:1)..M:fac, Exe('F2'))
            AgregarMarco(A:fac..M:fac, 0, 0, Exe('COLOR6'))
            ACN(BD:2, 1)
            ifa
            ifa
        ENDIF
        ACT(A:fac, Val(TT:1)~' en '~fbn('Cotiza'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..M:fac, 0, 0)
        ifa
        ACN(FI:1, fac)
    ENDIF
    ***---ACT(A:fac, fbn('Especie')~' - '~fbn('Book'))
    ACT(A:fac, fbn('Especie')~' - '~BuscarCampo('ESPECIES','Nombre','Codigo', fbn('Especie')))
    ACN(B:fac, fbn('CantidadFin'))
    ACN(C:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,Val(MI:1)))
***---MessageBox(Val(C:fac))
    ACN(D:fac, Val(B:fac) * Val(C:fac))
    IF fbn('CantidadFin') = 0
        ACN(E:fac, Val(C:fac))
    ELSE
        IF Eqstr(fbn('Cotiza'), Val(MI:1))
            ACN(E:fac, fbn('PrecioFin'))
        ELSE
            ACN(CT:99, CotizacionC(fbn('Cotiza'),,,,Dialogo.Fecha2,1,SI,Val(MI:1)))
           ACN(E:fac, fbn('PrecioFin') * Val(CT:99))
        ENDIF
    ENDIF
    ACN(F:fac, ((Val(C:fac) / Val(E:fac)) - 1) * 100)
    ***---Resultados REVAL
    ACN(NR:1, 2)
    IF Val(TP:1) = 6
        ACT(TN:1, 'FC')
    ELSE
        ACT(TN:1, 'SEC')
    ENDIF
    ACT(TR:1, Val(NR:3))
    ACT(ES:1, fbn('Especie'))
    ACT(BK:1, fbn('Book'))
    ACT(VH:1, fbn('Vehiculo'))
    (.'RESUGENE-2'.)
    IF Eqstr(fbn('Cotiza'), Val(MI:1))
        ACN(G:fac, Val(RS:1))
    ELSE
        ACN(G:fac, Val(RS:1) * Val(CT:99))
    ENDIF
    ***---Resultados REALIZ y TRADE
    ACT(TR:1, Val(RZ:1))
    (.'RESUGENE-2'.)
    IF Eqstr(fbn('Cotiza'), Val(MI:1))
        ACN(H:fac, Val(RS:1))
    ELSE
        ACN(H:fac, Val(RS:1) * Val(CT:99))
    ENDIF
    ACN(I:fac, Val(G:fac) + Val(H:fac))
    ***---Capital Expuesto = ( (CE1 * CE2 * DS1) + CE3 - CE4 ) / DS1
       **+ Busca Posicion (CE1)
       (.'CARINV4'.)
       **+ Busca Cotizacion (CE2)
       ACN(CE:2, CotizacionC(FBN('Especie'),,,,Dialogo.Fecha1-1,1,SI,Val(MI:1)))
       **+ Busca Compras efectuadas durante el periodo (CE3) = (Cantidad * Precio * Cant Dias) 
       (.'CARINV5'.)
       **+ Busca Ventas efectuadas durante el periodo (CE4) = (Cantidad * Precio * Cant Dias) 
       (.'CARINV6'.)
       **+ Calcula Capital Expuesto
       ACN(M:fac, ((Val(CE:1) * Val(CE:2) * Val(DS:1)) + Val(CE:3) - Val(CE:4))  / Val(DS:1))
    ACN(J:fac, Val(G:fac) / Val(M:fac) * 100)
    ACN(K:fac, Val(H:fac) / Val(M:fac) * 100)
    ACN(L:fac, Val(J:fac) + Val(K:fac))
    ACT(CZ:1, fbn('Cotiza'))
    ACN(BD:3, 1)
***---ELSE
***---    DFA
***---ENDIF
