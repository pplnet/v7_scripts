* DCRSMENSUA - Resultado Range Swap Mensual

Message("Calculando Resultado Range Swap Mensual "~val(aa3)~" "~VAL(aa1)~"' al "~VAL(aa2))
  
SQL.ADD("SELECT * FROM "~DBO~".CURVAFUTUROSCOMM Where Especie='"~VAL(aa4)~"' and ")
SQL.ADD("Fecha>='"~IdxDate(VAL(aa1))~"' and Fecha<='"~IdxDate(VAL(aa2))~"' Order By Fecha")


acn(pf1,0)
acn(pr1,0)
acn(me1,0)
ACN(ab1,0)
ACN(ab2,0)
ACN(h:fac,0)

ACD(dm1,VAL(aa1))
ACD(dm2,VAL(aa1))

Recorrer SQL
   dfa
   If val(me1)<>Mes(FBN['Fecha'])
      If val(me1)>0
         *- ab1: Promedio de 1 mes 
         ACN(ab1,Round(VAL(ab1)/VAL(ab2),3))

         Message('Promedio del Mes '~Fstr(val(me1),0,0)~' '~Fstr(val(ab1),0,2))

         *- Cuando Cambia el mes calculo el resultado
         IF [val(ab1)>=val(g:fac) y Num(VAL(z8))=1] o [val(ab1)<=val(g:fac) y Num(VAL(z8))=0]   
            *-- Calculo el Resultado por Unidad    
            IF Num(VAL(z8))=0 
               ACN(Z3,(val(ab1)-VAL(z12)))
            ELSE 
               ACN(Z3,(VAL(z12)-val(ab1)))
            ENDIF
         EndIf

         acd(dm2,FinDeMes(val(dm1),SI,'ARG'))

         *- Calculo La ganancia Diaria : suma de resultados/Cantidad de Dias 
         If Incluido(val(z16),'BBLSD|BARRIL')
            ACN(Z2,val(z3)*val(d:fac)*(val(dm2)-val(dm1)+1) )
         Else 
            ACN(Z2,val(z3)*val(d:fac))
         EndIf

         Message('Resultado 1 '~Fstr(val(z2),0,2))

         SCN(h:fac,val(z2))

         ACN(ab1,0)
         ACN(ab2,0)
      EndIf

      acn(me1,Mes(FBN['Fecha']))
      acd(dm1,PriDeMes(FBN['Fecha'],SI,'ARG'))
   EndIf

   IF Not Incluido(VAL(aa3),VAR('PRECOMMFUT')) y FBN['PrecioCon']<>0 
      SCN(ab1,FBN['PrecioCon'])
   Else 
      SCN(ab1,FBN['PrecioFut'])
   EndIf

   SCN(ab2,1)
Proximo

If val(me1)>0
   Message('Suma     '~Fstr(val(ab1),0,3))
   Message('Cantidad '~Fstr(val(ab2),0,3))

   *- ab1: Promedio de 1 mes 
   ACN(ab1,Round(VAL(ab1)/VAL(ab2),3))

   Message('Promedio del Mes '~Fstr(val(me1),0,0)~' '~Fstr(val(ab1),0,3))
 
   *- Cuando Cambia el mes calculo el resultado
   IF [val(ab1)>=val(g:fac) y Num(VAL(z8))=1] o [val(ab1)<=val(g:fac) y Num(VAL(z8))=0]   
      *-- Calculo el Resultado por Unidad    
      IF Num(VAL(z8))=0 
         ACN(Z3,(val(ab1)-VAL(z12)))
      ELSE 
         ACN(Z3,(VAL(z12)-val(ab1)))
      ENDIF
   EndIf

   acd(dm2,FinDeMes(val(dm1),SI,'ARG'))

   *- Calculo La ganancia Diaria : suma de resultados/Cantidad de Dias 
   If Incluido(val(z16),'BBLSD|BARRIL')
      ACN(Z2,val(z3)*val(d:fac)*(val(dm2)-val(dm1)+1) )
   Else 
      ACN(Z2,val(z3)*val(d:fac))
   EndIf

   SCN(h:fac,val(z2))

   Message('Resultado 2 '~Fstr(val(z2),0,2))

   ACN(ab1,0)
   ACN(ab2,0)
EndIf
