*1-Chequeo de operaciones en instancias intermedias
ACT(a:FAC,'NrOperacion')
ACT(b:FAC,'TipoOp')
ACT(c:FAC,'Cantidad')
ACT(d:FAC,'Especie')
ACT(e:FAC,'Tasa')
ACT(f:FAC,'Sector')
ACT(g:FAC,'Instancia')

AgregarMarco(a:FAC..g:FAC,1,0,Exe('COLOR6'))
SetFont(a:FAC..g:FAC,2)

If Num(SQL("SELECT count(1) FROM "~DBO~".OPERACIONESBITS B INNER JOIN "~DBO~".OPERACIONES O ON O.NrOperacion = B.NrOperacion WHERE B.NrBit IN ("~Var('INTERCREM')~") AND B.Valor = '1' AND TipoOp ='MMCREM'")) > 0
    SQL.ADD("SELECT O.NrOperacion, O.TipoOp,O.Cantidad, O.Especie, O.Precio1, O.Sector1, B.NrBit, I.Nombre FROM "~DBO~".OPERACIONESBITS B ")
    SQL.ADD("INNER JOIN "~DBO~".OPERACIONES O ON O.NrOperacion = B.NrOperacion ")
    SQL.ADD("INNER JOIN "~DBO~".INSTANCIAS I ON B.NrBit = I.NrInstancia ")
    SQL.ADD("WHERE B.NrBit IN ("~Var('INTERCREM')~") AND B.Valor = '1' AND O.TipoOp ='MMCREM' AND I.Tabla = 'OPERACIONES'")
    SQL.ADD(" ORDER BY O.NrOperacion ")
    
    let &cuentasrem 0
    Recorrer SQL
        let &cuentasrem &cuentasrem + 1
    
        ACT(a:FAC, FBN('NrOperacion'))
        ACLO(a:fac,FBN['NrOperacion'])
        ACT(b:FAC, FBN('TipoOp'))
        ACN(c:FAC,FBN('Cantidad'))
        ACT(d:FAC,FBN('Especie'))
        ACN(e:FAC,FBN('Precio1'))
        ACT(f:FAC,FBN('Sector1'))
        ACT(g:FAC,FBN('NrBit')~' - '~FBN('Nombre'))
    Proximo
Endif
SetFilaActual(FAC+2)
FormatoCeldas(e:Val(w1)+1..e:fac,Exe('F7'))
