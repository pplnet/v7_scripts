*************************************************************************
* Obtiene el saldo total de la especie es1
* Si cl1 no es vacio, trae el saldo de este cliente para dicha especie
* Devuelve el saldo en zw1
*************************************************************************

SQL.ADD("SELECT SUM(S1.Saldo) Saldo ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK), "~DBO~".CUENTAS C1 ")
*MAC agregado 27/06/2023 Temporario No sumar los saldos de Bloqueo por parking
SQL.ADD("WHERE S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Val(cl91))
   SQL.ADD("   S1.Cliente = '"~Val(cl91)~"' AND ")
ENDIF
IF NoVacio(Val(ct91))
   SQL.ADD("   S1.Cuenta = '"~Val(ct91)~"' AND ")
ENDIF
SQL.ADD("      S1.Especie = '"~Val(es1)~"' AND ")
*SQL.ADD("      (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
SQL.ADD("       (S1.NrSaldo>201 or S1.NrSaldo=101) AND (S1.NrSaldo not in(121,227))  AND ")
SQL.ADD("      S1.Cuenta = C1.Codigo and ")
SQL.ADD("      C1.Comitente = '"~Dialogo.Vehiculo1~"' and ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
SQL.ADD("                  WHERE S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Val(fe91))~"' AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Especie = S1.Especie) ")
ACN(zw1, 0)
*watch(SQL.Batch)
Recorrer SQL
  ACN(zw1,FBN['Saldo'])
Proximo
dfa
