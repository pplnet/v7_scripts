* LIQMOROPER- Liquidacion Morgan Seleccion x Operacion

   *- Selecciona los movimientos agrupandolos por nro.operacion
   SQL.ADD("Select Distinct M.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.FechaVto,O.Especie,O.ContraEspecie, O.Cantidad, O.TotalNetoCli1 ")
***---Esto
***   SQL.ADD(" , M.Cantidad CantidadM ")
   SQL.ADD("from   "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M ")
   SQL.ADD(" where M.NrOperacion=O.NrOperacion and M.Transaccion = '"~val(a1)~"' ")
   SQL.ADD(" order by 1,2,3 ")

   *-- Con esta seleccion preparo un listbox complementario
   act(a0,'Marca')
   act(b0,'Vehiculo')
   act(c0,'Cliente')
   act(d0,'Operacion')
   act(e0,'TipoOp')
   act(f0,'FechaOp')
   act(g0,'FechaVto')
   act(h0,'Especie')
   act(i0,'ContraEspecie')
   act(j0,'Cantidad')
   act(k0,'TotalNetoCli1')
 
   Recorrer SQL
      acn(a:fac,1)
      act(c:fac,fbn['Cliente1'])
      act(d:fac,fbn['NrOperacion'])
      act(e:fac,fbn['TipoOp'])
      acd(f:fac,fbn['FechaOp'])
      acd(g:fac,fbn['FechaVto'])
      act(h:fac,fbn['Especie'])
      act(i:fac,fbn['ContraEspecie'])
      acn(j:fac,fbn['Cantidad'])
      acn(k:fac,fbn['TotalNetoCli1'])
      scn(b1,1)
   Proximo

   If Val(b1) >= 4
      CrearListBox       ; 'MS Sans Serif,8,'
         'Marca'         ;a4..a:val(b1);SI;;;30 ;CHECK  ;RGB(160,160,193); ; NO;NO;;NO;NO;NO;
         'Cliente'       ;c4..c:val(b1);NO;;;80 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'Operacion'     ;d4..d:val(b1);NO;;;60 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'TipoOp'        ;e4..e:val(b1);NO;;;60 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'Especie'       ;h4..h:val(b1);NO;;;80 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'ContraEspecie' ;i4..i:val(b1);NO;;;80 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'FechaOp'       ;f4..f:Val(b1);NO;;;80 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'FechaVto'      ;g4..g:Val(b1);NO;;;80 ;STRING;;RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'Cantidad  '    ;j4..j:val(b1);NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193); ; NO;NO;;NO;NO;NO;
         'Monto'         ;k4..k:val(b1);NO;;;120;NUMERO;'##,###,###.##';RGB(250,250,193); ; NO;NO;;NO;NO;NO;
      FinListBox

      If Ok 
         Recorrer&i 4, val(b1)
            If val(a:&i) = 1
               *- armo una lista con los nros. de operacion para aplicar a la seleccion del neteo
               act(ck1,val(ck1)~val(d:&i)~'|')
            EndIf
         Proximo
     Else 
         ACT(co1, 'NO')
     EndIf
   EndIf
