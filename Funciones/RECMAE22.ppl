if EqStr(Copy(Val(A:FAC),47,1),'S')
   Message('Inf.Correcta y Confirmada  '~Copy(Val(A:FAC),32,4))
   * Informacion Correcta y Confirmada
   ACT(E:1,'SI')
   ACT(E:2,'OK')
else
  if EqStr(Copy(Val(A:FAC),47,1),'N')
     Message('Informacion Incorrecta '~Copy(Val(A:FAC),32,4))
     * Informacion Incorrecta
     ACT(E:1,'NO')
     ACT(E:2,'ERR')
  endif
endif

if Vacio(Val(E:1))
   Message('Error Codido Respuesta  RECMAE22')
   if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Error Cod.Res. RECMAE22',30)~'-'~Val(A:FAC))
      CerrarASCII
   endif
else
  if Incluido(Copy(Val(A:FAC),32,4),'0151|0251')
    ************** Si el mensaje fue un alta de orden  *********************
    * Mensaje que dio origen a la respuesta fue :                          *
    *      0151 : Alta Orden Venta      0251 : Alta Orden Compra / TMANIF   *
    * con el primer digito de la secuencia = 0 Operacion                   *
    ************************************************************************
   
    ACN(v4, 0)
    if EqStr(Copy(Val(A:FAC),42,1),'0')
       ACT(E:3, 'ALTM%')
       ACT(tp:1,'Alta')
       ACT(ms:1,'7020|'~Copy(Val(A:FAC),32,4)~'(TM)')
       ACT(ms:2,'Error en Alta, va a Compliance')
       ACT(er:1,'ERRORALTA')

      SQL.ADD("Select O.NrOrden, O.TipoOrden, OB.NrBit ")
      SQL.ADD("  from "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB ")
      SQL.ADD(" Where O.NrOrden   Like '"~'____'~Copy(Val(A:FAC),43,4)~"' ")
      SQL.ADD("   and O.TipoOrden in ('TMANIF','OTIC','OTIV') ")
      SQL.ADD("   and O.NrOrden   = OB.NrOperacion ")
      SQL.ADD("   and OB.NrBit    in (162,169) ")
      SQL.ADD("   and OB.Valor    = '1' ")
      Recorrer SQL
        DFA
        SCN(v4, 1)
        if Val(v4)>1
           Message('Mas de una Operacion RECMAE22')
           if Eqstr(Var('LOGERRMAE'),'SI')
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('Mas de una Orden RECMAE22',30)~'-'~Val(A:FAC))
              CerrarASCII
           endif
          break
        endif
        
        ACT(or:1,fbn('NrOrden'))
        ACN(ob:1,fbn('NrBit')) 
        if  EqStr(fbn('TipoOrden'),'TMANIF')
            ACT(ms:3,'Ok Alta, va a Pendiente Adjudicacion') 
            ACN(ob:3,104)
        Else
            ACT(ms:3,'Ok Alta, va a Aceptada')         
            ACN(ob:3,8)
        Endif
        ACN(ob:2,169)
      Proximo
      
      ACN(v4,0)
      
      (.'RECMAE222'.)

    endif
  endif

  if Incluido(Copy(Val(A:FAC),32,4),'0152|0252')
    ************** Si el mensaje fue una baja de orden *********************
    * Mensaje que dio origen a la respuesta fue :                          *
    *      0152 : Baja Orden Venta      0252 : Baja Orden Compra / TMANIF  *
    * con el primer digito de la secuencia = 9 Operacion                   *
    ************************************************************************
    ACN(v4, 0)
    if EqStr(Copy(Val(A:FAC),42,1),'9')
       ACT(E:3, 'BATM%')
       ACT(tp:1,'Baja')
       ACT(ms:1,'7020|'~Copy(Val(A:FAC),32,4)~'(TM)')
       ACT(ms:2,'Error en Baja, va a Compliance')
       ACT(ms:3,'Ok Baja, va a Anulacion')
       ACN(ob:2,169)
       *ACN(ob:3,30)
       ACT(er:1,'ERRORBAJA')
       
       SQL.ADD("Select O.NrOrden, O.TipoOrden, OB.NrBit, O.TipoOrden, O.Mercado2, IsNull(OP.TotalNetoCli1,0) TotalNetoCli1,  ")
       SQL.ADD("       O.MB2, O.AfectaLS, O.TotalAux1, O.Cuenta4  as Cuenta, O.Leyenda3, O.CantidadTotalOrden, O.CantidadCompletada  ")
      SQL.ADD("  from "~DBO~".ORDENES O  ")
      SQL.ADD("       Left JOIN "~DBO~".OPERACIONES OP WITH (NOLOCK) ON O.NrOrden=OP.NrOrden1 ")
      SQL.ADD("       Left JOIN "~DBO~".OPERACIONESBITS OB WITH (NOLOCK) ON  O.NrOrden=OB.NrOperacion ")      
      SQL.ADD(" Where O.NrOrden   Like '"~'____'~Copy(Val(A:FAC),43,4)~"' ")
      SQL.ADD("   and O.TipoOrden in ('TMANIF','OTIC','OTIV') ")
      SQL.ADD("   and OB.NrBit    in (162,169) ")
      SQL.ADD("   and OB.Valor    = '1' ")
      
      
      Recorrer SQL
        DFA
        SCN(v4, 1)
        if Val(v4)>1
           Message('Mas de una Operacion RECMAE22')
           if Eqstr(Var('LOGERRMAE'),'SI')
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('Mas de una Orden RECMAE22',30)~'-'~Val(A:FAC))
              CerrarASCII
           endif
          break
        endif
        
        if FBN['TotalNetoCli1'] = 0 
           ACN(ob:3,30)
        else
           ACN(ob:3,11)
        endif
        
        ACT(or:1,fbn('NrOrden'))
        ACN(ob:1,fbn('NrBit')) 
        ACT(sc:1,'NOK')
        If EqStr(FBN['TipoOrden'],'OTIC') y  EqStr(FBN('Mercado2'],VAR('MERCADOBT')) y FBN['MB2']='1' y EqStr(FBN['AfectaLS'],'Saldos')
           ACT(sc:1,'OK')
           BorrarCeldas(rr:1..rr:50)
           ACT(sc:4, FBN['Cuenta'])
           ACT(rr:10, FBN['Leyenda3'])
           ACT(rr:12, Copy(FBN['Cuenta'],1,7))
           ACT(rr:13, Copy(FBN['Cuenta'],9,2))
           * Desbloqueo de Saldo
           *ACN(rr:15,FBN['TotalAux1'])
           ACN(rr:15,FBN['TotalAux1']-FBN['TotalNetoCli1'])
        Endif
       Proximo
       
       ACN(v4,0)
       
**  Desbloqueo por no utilizado Moneda, ARP De la Operacion
#ifdef BIND
  If EqStr(Val(sc:1),'OK')
     (.'DESBSALCTA'.)
     ACT(sc:2, val(rr:1))
     If Eqstr(Val(sc:2),'NOK')
        ACN(sc:3, Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~Val(or:1)~"' And Tipo = 'ERRDESBLOQ' "))
        if Val(sc:3)=0
           SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
           SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
           SQL.ADD(" ) Values ( ")
           SQL.ADD(" '"~Val(or:1)~"', ")
           SQL.ADD(" "~SQLAhora~", ")
           SQL.ADD(" 'ERRDESBLOQ', ")
           SQL.ADD(" '"~'Error al desbloquear cuenta '~Val(sc:4)~"' ")
           SQL.ADD(" ) ")
           SQL.NEW
           SQL.EXEC
        endif
      Endif
  endif      
#endif   
             
       (.'RECMAE222'.)
       
    endif    
  endif

  if Incluido(Copy(Val(A:FAC),32,4),'0153|0253')
    ************** Si el mensaje fue una modificacion de orden  ************
    * Mensaje que dio origen a la respuesta fue :                          *
    *      0153 : Modi Orden Venta      0253 : Modi Orden Comra / TMANIF   *
    * con el primer digito de la secuencia = 0 Operacion                   *
    ************************************************************************
  endif
endif
