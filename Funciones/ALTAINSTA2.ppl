** ALTAINSTAN
** Inserta las Instancias para las Operaciones que 
** se dan de alta en los eventos.
** az3: Debe estar el Nro. de La Operacion a ingresar
** az4: Tabla (OPERACIONES/TRANSACCIONES)
** az5: Nro. de Instancia a prender
** az6: (Instancias que debe estar) 

Message('Ingresando Instancias Operacion '~VAL(az3)~' ...')

SQL.ADD("SELECT NrInstancia FROM "~DBO~".INSTANCIAS Where Tabla='"~val(az4)~"' AND NrInstancia IN ("~Pipe2Comillas(Val(az6))~")")
SQL.ADD("ORDER BY NrInstancia ")
            
Recorrer SQL
  dfa
  SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
  SQL.ADD("(NrOperacion,NrBit,Valor) ")
  SQL.ADD(" Values ")
  SQL.ADD("('"~Val(az3)~"',"~Fstr(FBN['NrInstancia'],3,0)~",")
  IF Incluido(FBN['NrInstancia'], Val(az5))
     SQL.ADD("'1')")
  ELSE
     SQL.ADD("'0')")
  ENDIF
  SQL.NEW
Proximo

SQL.ADD("UPDATE "~DBO~".OPERACIONES Set ")
SQL.ADD("Observaciones=Observaciones+'"~BuscarCampo('EVENTOS','Nombre','Codigo',CodigoInforme)~"' ")
SQL.ADD("Where NrOperacion='"~Val(az3)~"' ")
SQL.NEW


