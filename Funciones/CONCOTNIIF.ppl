**CONT2 - Liquidacion Titulos
SQL.ADD(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'LIQ' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD("    INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")       
SQL.ADD("    INNER JOIN "~DBO~".MOVEJECUTADOS M ON O.NrOperacion = M.NrOperacion ")   
SQL.ADD("    INNER JOIN "~DBO~".TRANSACCIONES2 T ON T.NrTrans = M.NrTrans2 ")
SQL.ADD("    INNER JOIN "~DBO~".CUENTAS C ON M.Cuenta = C.Codigo ")  
SQL.ADD("    INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")  
SQL.ADD("    INNER JOIN "~DBO~".MODELOSASIENTO MA ON MA.TipoOp = O.TipoOp ")
SQL.ADD("    INNER JOIN "~DBO~".MERCADOS ME ON O.Mercado = ME.Codigo ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND (O.PaseCB = '0' OR O.PaseCB Is Null OR O.PaseCB = '' OR O.PaseCB = ' ') ")
SQL.ADD(" AND T.NrTrans = M.NrTrans2 ")
SQL.ADD(" AND M.Especie = O.Especie ")
SQL.ADD(" AND M.NrSaldo = 1 ")
SQL.ADD(" AND C.Codigo  = M.Cuenta ")
SQL.ADD(" AND O.TipoOp = MA.TipoOp ")
SQL.ADD(" AND MA.TipoAsiento = '"~Var('TIPASILT')~"' ")
SQL.ADD(" AND '|'+RTrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND T.TipoTr2 in ('RET','DEP','MATCH','COMP') ")
SQL.ADD("   AND ((T.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' AND ME.Netea = 'SI') OR (T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
SQL.ADD("   AND ((T.Fecha1 >= '"~IdxDate(Val(FE:1))~"' AND ME.Netea = 'SI') OR (T.Fecha2 >= '"~IdxDate(Val(FE:1))~"' AND (ME.Netea Is Null OR ME.Netea = 'NO'))) ")
SQL.ADD(" AND ((O.TipoOp IN ('TICT','TIDE','TICO','TIPO','TIC','TIV'))) ")
** FJL 15/05/25 - Issue EXTBACS-8157 - Especies vencidas
SQL.ADD(" AND     E.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
************************
SQl.ADD(" UNION ALL ")

**CONT4 - Pases y Prestamo
SQL.ADD(" Select Distinct E.Codigo Especie,O.FechaOp,O.FechaVto, E.Nombre, E.Cotiza, 'REV' as TipoAsi, O.TipoOp, 'N/A' Tipo, O.Book1  ")
SQL.ADD("FROM "~DBO~".OPERACIONES O ")  
SQL.ADD("      INNER JOIN "~DBO~".MODELOSASIENTO MA ON O.TipoOp = MA.TipoOp ")    
SQL.ADD("      INNER JOIN "~DBO~".ESPECIES E ON O.Especie = E.Codigo ")
SQL.ADD("      INNER JOIN "~DBO~".OPERACIONESBITS B ON O.NrOperacion = B.NrOperacion ")   
SQL.ADD("      INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo ")  
SQL.ADD(" Where B.Valor = 1 AND B.NrBit Not IN (1, 30, 31) ")
SQL.ADD(" AND MA.TipoAsiento IN ("~Pipe2Comillas(Var('TIPASRETID'))~") ")
SQL.ADD(" AND '|'+rtrim(MA.Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
SQL.ADD(" AND MA.Habilitado = 'SI' ")
SQL.ADD(" AND O.TipoOp IN ('TIPP','TIPA','TICT','TIDE','TIPO','TICO') ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND '"~IdxDate(Dialogo.Fecha1)~"' >= '"~IdxDate(Val(FE:1))~"' ")
** FJL 15/05/25 - Issue EXTBACS-8157 - Especies vencidas
SQL.ADD(" AND     E.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' ")
************************
SQL.ADD(" UNION ALL ")

