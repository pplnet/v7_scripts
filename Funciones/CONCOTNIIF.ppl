SQL.ADD(" SELECT Distinct P.Especie Especie, '"~IdxDate(Val(FE:99))~"' FechaOp, '"~IdxDate(Val(FE:99))~"' FechaVto, E.Nombre, E.Cotiza, 'REVPOS' as TipoAsi, '' TipoOp, 'N/A' Tipo, P.Book Book1 ") 
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" where E.Codigo = P.Especie ")
SQL.ADD("    AND E.EsCupon <> 'SI' ")
SQL.ADD("    AND P.Book not IN ("~Pipe2Comillas(&BValuaPartida)~") ")
SQL.ADD("    AND P.Fecha      <= "~IDXDATE2(Val(FE:99))~" ")
SQL.ADD("    AND ((P.Fecha="~IDXDATE2(Val(FE:99))~" and (Round(P.CantidadFin,2) <> 0 OR Round(P.CantidadIni,2)<>0 OR Round(P.Cantidad1,2)<>0 OR Round(P.Cantidad2,2)<>0 ))")
SQL.ADD("        OR  (P.Fecha<"~IDXDATE2(Val(FE:99))~" and (Round(P.CantidadFin,2) <> 0 ))")
SQL.ADD("        )")
SQL.ADD("    AND P.NrSaldo = "~Fstr(Val(SL:2), 0, 0)~" ")
