if SI o Incluido(Val(c13),Var('TIPONEGOCT'))
   ***Genera Operacion siopel en OPSIOPEL
   (.'OPSIOPEL'.)
   if EqStr(Val(f:FAC),'Error')
   */Ver si grabamos LOG
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('Gen OPSIOPEL duplicada',30)~'-'~Val(a:FAC))
      CerrarASCII
    endif
  endif
else
  if Eqstr(Var('LOGERRMAE'),'SI')
    AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
    EscribirASCII(Pad('Gen OPSIOPEL FX Fuera horario',30)~'-'~Val(a:FAC))
    CerrarASCII
  endif
endif
