
   *- Calculo el nro. de cupon a Modificar 
   ACN(nc1,SQL(" SELECT Max(NrComision) AS NrComision FROM "~DBO~".COMISIONES2 Where NrOperacion='"~Val(UA:&k)~"' "))

   SQL.ADD("SELECT *  FROM "~DBO~".COMISIONES2  ")
   SQL.ADD(" WHERE NrOperacion = '"~Val(UA:&k)~"' ORDER BY NrComision DESC ")

   Recorrer SQL
      dfa

      If FBN['NrComision']=val(nc1)
         *- Es la Ultima cuota que tenemos que modificar
         ACD(nc2,Dialogo.Fecha1 ) 

         *- Inserto la nueva comision
         ACN(nc5, ValorTeorico2(Dialogo.Especie1,Dialogo.Fecha1) )


         *- nc3: Calculo el interes desde el inicio de la operacion hasta la fecha de corte al valor residual anterior
         *- Capital* (FechaCorte-FechaInicio)*Tasa*ValorResidual de la ultima cuota grabada/36500
         ACN(nc3,ABS(val(ug:&k)) * (Val(nc2) - FBN['Fecha1'] ) * Val(UM:&k) * FBN['Importe1'] / Val(UN:&k)  )
         SCN(nc3,ABS(val(ug:&k)) * (FBN['Fecha2']-Val(nc2)) * Val(UM:&k) * val(nc5) / Val(UN:&k)  )

*MessageBox(ABS(val(ug:&k)))
*MessageBox(val(nc2))
*MessageBox(fbn('Fecha1'))
*MessageBox(Val(UM:&k))
*MessageBox( FBN['Importe1'])
*MessageBox(Val(UN:&k) )
         ***---Actualizo datos del corte anterior 
         SQL.ADD(" Update "~DBO~".COMISIONES2                  ")
         SQL.ADD(" Set Fecha2   = "~IdxDate2(Dialogo.Fecha1)~" ")
         SQL.ADD(" Where NrOperacion = '"~Val(UA:&k)~"'        ")
         SQL.ADD("   AND NrComision  = '"~Fstr(Val(nc1), 0, 0)~"'   ")
         SQL.NEW


         SQL.ADD(" INSERT "~DBO~".COMISIONES2  ")
         SQL.ADD(" (NrComision,NrOperacion,Fecha1, Fecha2,Importe1,Importe4) ")
         SQL.ADD(" Values ")
         SQL.ADD(" ('"~Fstr(FBN['NrComision']+1,0,0)~"','"~FBN['NrOperacion']~"', ")
         SQL.ADD("  "~IdxDate2(Dialogo.Fecha1)~","~IdxDate2(FBN['Fecha2'])~",  ")
         SQL.ADD(" '"~Fstr(Val(nc5),0,6)~"','"~Fstr(Val(C:3), 0, 0)~"') ")
         SQL.NEW
     Else
        *- Recorro las cuotas anteriores para acumular el interes
        *- Capital* (FechaCorte-FechaInicio)*Tasa*ValorResidual de la ultima cuota grabada/36500
        SCN(nc3,ABS(val(ug:&k)) * (FBN['Fecha2']  - FBN['Fecha1'] ) * Val(UM:&k) * FBN['Importe1'] / Val(UN:&k)  )
     EndIf
   Proximo                 

   ***---Actualizo intereses en la operacion 
   SQL.ADD(" Update "~DBO~".OPERACIONES ")
   SQL.ADD(" Set Cupon1 = '"~Fstr(Val(C:3), 0, 0)~"', Cuotas2 = "~Fstr(Val(nc1)+1, 0, 0)~",")
   SQL.ADD(" NrOperacion2 = '"~Val(Y:2)~"'  ,          ")       
   SQL.ADD(" TotalIntereses = '"~Fstr(Val(nc3), 0, 2)~"'  ")
   SQL.ADD(" Where NrOperacion = '"~Val(UA:&k)~"'     ")
   SQL.NEW
   SQL.EXEC                    
