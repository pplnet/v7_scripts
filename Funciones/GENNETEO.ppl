        SQL.ADD("and M.Especie = '"~Val(j:FilaCiclo)~"' ")
        SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and M.Mercado = '"~Val(b:FilaCiclo)~"'")
        SQL.ADD("and M.NrSaldo = 1 ")
        SQL.ADD("and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and M.Bits = 'MV' ")
        SQL.ADD("and (")
          SQL.ADD("'"~FStr(Val(bk:FilaCiclo),1,0)~"' = '0' ")
          SQL.ADD("or ('"~FStr(Val(bg:FilaCiclo),1,0)~"' = '1' and M.Status = 'DVP') ")
          SQL.ADD("or ('"~FStr(Val(bh:FilaCiclo),1,0)~"' = '1' and M.Status = 'RVP') ")
          SQL.ADD("or ('"~FStr(Val(bi:FilaCiclo),1,0)~"' = '1' and M.Status = 'CONF') ")
          SQL.ADD("or ('"~FStr(Val(bj:FilaCiclo),1,0)~"' = '1' and M.Status = 'MATCH') ")
          SQL.ADD("or ('"~FStr(Val(bk:FilaCiclo),1,0)~"' = '1' and M.Status = '' )")
        SQL.ADD(")")
        SQL.ADD("and O.Mercado = '"~Val(m:FilaCiclo)~"'")
        SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and B.NrBit = 70 ")
        SQL.ADD("and B.Valor = '1' ") 
        SQL.ADD("union ")
        SQL.ADD("select ")
        SQL.ADD("M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.CallPut, ")
        SQL.ADD("M.FechaEj, M.PrecioEj, M.EnteCustodia, M.NrSaldo, M.Mercado, ")
        SQL.ADD("M.Leyenda, M.Bits, M.NrGrupo, M.Concepto, M.NrGrupo2, ")
        SQL.ADD("M.NrMov, M.NrLiq, M.Status, M.NrInstan, M.Cupon, ")
        SQL.ADD("'"~IdxDate(Hoy)~"', '"~UsuarioActivo~"', M.Cuenta, M.Transaccion, M.Cantidad, ")
        SQL.ADD("'"~Val(n:FAC)~"' ")
        SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
        SQL.ADD("where M.NrOperacion = T.NrTrans")
        SQL.ADD("and M.NrOperacion = B.NrOperacion")
        SQL.ADD("and M.Cliente = '"~Val(a:FilaCiclo)~"' ")
        SQL.ADD("and M.Especie = '"~Val(j:FilaCiclo)~"' ")
        SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and M.Mercado = '"~Val(m:FilaCiclo)~"'")
        SQL.ADD("and M.NrSaldo = 1 ")
        SQL.ADD("and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and M.Bits = 'MV' ")
        SQL.ADD("and (")
          SQL.ADD("'"~FStr(Val(bk:FilaCiclo),1,0)~"' = '0' ")
          SQL.ADD("or ('"~FStr(Val(bg:FilaCiclo),1,0)~"' = '1' and M.Status = 'DVP') ")
          SQL.ADD("or ('"~FStr(Val(bh:FilaCiclo),1,0)~"' = '1' and M.Status = 'RVP') ")
          SQL.ADD("or ('"~FStr(Val(bi:FilaCiclo),1,0)~"' = '1' and M.Status = 'CONF') ")
          SQL.ADD("or ('"~FStr(Val(bj:FilaCiclo),1,0)~"' = '1' and M.Status = 'MATCH')")
          SQL.ADD("or ('"~FStr(Val(bk:FilaCiclo),1,0)~"' = '1' and M.Status = '' )")
        SQL.ADD(")")
        SQL.ADD("and T.Mercado1 = '"~Val(m:FilaCiclo)~"' ")
        SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and B.NrBit = 5 ")
        SQL.ADD("and B.Valor = '1' ") 
        SQL.NEW
 
        SQL.ADD("DELETE from "~DBO~".MOVPENDIENTES ")
        SQL.ADD("where Cliente = '"~Val(a:FilaCiclo)~"' ")
        SQL.ADD("and Especie = '"~Val(j:FilaCiclo)~"' ")
        SQL.ADD("and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
        SQL.ADD("and Mercado = '"~Val(b:FilaCiclo)~"'")
        SQL.ADD("and NrSaldo = 1 ")
        IF Dialogo.Check5 = 0
          SQL.ADD("and NrOperacion = '"~VAL(CA:FilaCiclo)~"' ")
        ENDIF
        SQL.ADD("and FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and Bits = 'MV' ")
        SQL.ADD("and (")
          SQL.ADD("'"~FStr(Val(bk:FilaCiclo),1,0)~"' = '0' ")
          SQL.ADD("or ('"~FStr(Val(bg:FilaCiclo),1,0)~"' = '1' and Status = 'DVP') ")
          SQL.ADD("or ('"~FStr(Val(bh:FilaCiclo),1,0)~"' = '1' and Status = 'RVP') ")
          SQL.ADD("or ('"~FStr(Val(bi:FilaCiclo),1,0)~"' = '1' and Status = 'CONF') ")
          SQL.ADD("or ('"~FStr(Val(bj:FilaCiclo),1,0)~"' = '1' and Status = 'MATCH') ")
          SQL.ADD("or ('"~FStr(Val(bk:FilaCiclo),1,0)~"' = '1' and Status = '' )")
        SQL.ADD(")")
        SQL.ADD("and (")
          SQL.ADD("NrOperacion in (Select O.NrOperacion from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
            SQL.ADD("where O.Cliente1 = '"~Val(a:FilaCiclo)~"' ")
            SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and O.Mercado = '"~Val(m:FilaCiclo)~"'")
            SQL.ADD("and B.NrBit = 70 ")
            SQL.ADD("and B.Valor = '1' ") 
            SQL.ADD(")")
          SQL.ADD("or NrOperacion in (Select T.NrTrans from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
            SQL.ADD("where T.Cliente1 = '"~Val(a:FilaCiclo)~"' ")
            SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and T.Mercado1 = '"~Val(m:FilaCiclo)~"'")
            SQL.ADD("and B.NrBit = 5 ")
            SQL.ADD("and B.Valor = '1' ") 
            SQL.ADD(")")
        SQL.ADD(")")
        SQL.NEW
      proximo

      SQL.EXEC
    endif     
