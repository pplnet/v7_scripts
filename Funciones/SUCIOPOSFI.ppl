*- Recibe como Parametro: x96: Especie, x97: Fecha x94: Valor Teorico x93: Saldo
*- Retorna cs1: Cotizacion

*- cs1: Cotizacion de la Especie 
acn(cs1,CotizacionC(val(x96),,,,val(x97),1,SI,VAR('MONEEXTR')))

If EqStr(FBN['InteresesC'],'CLE')
   *--- calcular la tasa (%)
   * x95:Dif. de dias x96:Especie  x97:Fecha de Liquidacion  
   * x98:Tasa Base x99: Tasa
   ACN(x98,0)
   ACN(x99,0)

   (.'CALCINT'.)

   * TotalIntereses
   ACN(y98,val(x94)*val(x93)*Val(x99)*100/DIASA(EspecieDiasAnio(Val(x96)),FSYS)/100*Val(x95))

   * Total Neto
   ACN(y99,(val(x94)*val(x93)*Val(cs1))+Val(y98))

   * Precio Sucio
   ACN(cs1,Val(y99)/val(x93))
Endif
