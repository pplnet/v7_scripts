ACN(CF:105, 0)
SQL.ADD(" Select CantidadFin From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.Especie = '"~Val(ES:105)~"' ")
SQL.ADD(" AND P.Cliente = '"~Val(CL:105)~"' ")
SQL.ADD(" AND P.Vehiculo = '"~Val(VH:105)~"' ")
SQL.ADD(" AND P.NrSaldo = "~Fstr(Val(SL:105), 0, 0)~" ")
SQL.ADD(" AND P.TipoNegocio = '"~Val(NG:105)~"' ")
SQL.ADD(" AND (P.Cupon = '"~Val(CP:105)~"' OR P.Cupon = '0' OR P.Cupon Is Null ) ")
SQL.ADD(" AND P.Fecha = (Select Max(P1.Fecha) From "~DBO~".POSICIONES P1 ")
SQL.ADD("                Where P.Especie = P1.Especie ")
SQL.ADD("                AND P.Cliente = P1.Cliente ")
SQL.ADD("                AND P.Vehiculo = P1.Vehiculo ")
SQL.ADD("                AND P.NrSaldo = P1.NrSaldo ")
SQL.ADD("                AND P.TipoNegocio = P1.TipoNegocio ")
SQL.ADD("                AND ((P.Cupon = P1.Cupon) OR (P.Cupon Is Null AND P1.Cupon Is Null) OR (P.Cupon = '' AND P1.Cupon = '')) ")
SQL.ADD("                AND P1.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"') ")
Recorrer SQL
    DFA
    ACN(CF:105, fbn('CantidadFin'))
