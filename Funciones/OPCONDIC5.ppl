CONDICIONES

EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie no esta Habilitada';NO
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El Cliente no esta Habilitado';NO
Not Eqstr(CLIENTE1, VEHICULO1);'El Cliente no puede ser el Vehiculo';NO;

EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA1),'HAB');'La Cuenta No esta Habilitada';NO
Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA1),'CUS');'La Cuenta debe ser una Cuenta de Custodia';NO

Vacio(Cuenta4) o EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA4),'HAB');'La Cuenta Monetaria no esta Habilitada';NO
Vacio(Cuenta4) o Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA4),'CC|CA|OTR|CAJ|');'La Cuenta Monetaria debe ser una CC o CA o OTR o CAJ';NO
Vacio(Cuenta4) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',CUENTA4),CLIENTE1) o Vacio(BuscarCampo('Cuentas','Cliente','Codigo',CUENTA4));'La Cuenta Monetaria debe pertenecer al Cliente Titular';SI

FechaOp > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(FechaOp,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'
DifDias(FechaOp,Fsys,'ARG',SI)<=Var('FVALORMAX');'Fecha Valor No Puede Superar '~Var('FVALORMAX')~' Dias';NO;

[VCAN1=0 y Not Incluido(Mercado3,VAR('MERCAACMC'))] o [VCAN1=1];'No Puede Liquidar por Neteado un Cliente ';NO

DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') o NoVacio(BuscarCampo('AGENDACUPONES','Especie','Especie',ESPECIE));'Falta Actualizar la Agenda para este Titulo';SI

FechaOp=FSYS;'Operacion Ingresada con Fecha Valor';SI;SI;FSYS;'FVALOR'

Not Incluido(TIPOOP, 'TICO|TIPO') o [NOT NOVACIO(CLIENTE1)] o ExisteLimite('DFROM',Cliente1,'USD',Vehiculo1)        ; 'Due From no asignado'                                          ;SI;SI;FSYS;'DFROMNOAS'
Not Incluido(TIPOOP, 'TICO|TIPO') o [NOT NOVACIO(CLIENTE1)] o LimOperativo(Cliente1,'DFROM','USD',Vehiculo1)   >= VCAN10+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)  ; 'Due From excedido en U$D '~PYC(VCAN10+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(Cliente1,'DFROM','USD',Vehiculo1),1,0)~'.-'   ;SI;SI;FSYS;'DFROMEXCE'
Not Incluido(TIPOOP, 'TICO|TIPO') o [NOT NOVACIO(CLIENTE1)] o BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1) >= FechaOp; 'Review date vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1));SI;SI;FSYS;'RDATEVENC'


BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1,OPERADOR, 'HAB');'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO