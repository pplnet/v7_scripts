*- h:Importe al Vto => CuotasPartes * Ultimo precio (compra o cotizacion)
SQL.ADD(" SELECT Precio1,Especie,FechaOp,TotalNetoCli1,Cantidad FROM "~DBO~".OPERACIONES WHERE TipoOp='FCS' and ")
SQL.ADD(" Especie='"~FBN['Especie']~"' and ")
SQL.ADD(" Vehiculo1 =  '"~FBN['Vehiculo1']~"' and ")      
SQL.ADD(" Precio1<>0 and FechaOp<='"~Dialogo.Fecha1~"' Order By FechaOp DESC")

Recorrer SQL
   dfa
   ACN(cp1, FBN['Precio1'])
   ACD(cf1, FBN['FechaOp'])
   Break
Proximo

*- Recupero la ultima cotizacion del fondo para comparar la fecha
SQL.ADD(" SELECT Precio1,Fecha FROM "~DBO~".COTIZACIONES WHERE ")
SQL.ADD(" Codigo='"~FBN['Especie']~"' and ")
If NoVacio(val(cf1))
   SQL.ADD(" Fecha>='"~IdxDate(val(cf1))~"' and ")
EndIf     
SQL.ADD(" Fecha<='"~Dialogo.Fecha1~"' Order By Fecha DESC")
Recorrer SQL
   dfa
   *- Fecha de Cotizacion = Fecha de Operacion de compra => Toma la de compra
   ACN(cp1, FBN['Precio1'])
   ACD(cf1, FBN['Fecha'])
   Break
Proximo

If val(cp1)=0
   ACN(cp1,val(co5))
EndIf
