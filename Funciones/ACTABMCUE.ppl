*- Verifico si es alta o modificacion
ACT(co1,'')

ACT(co1,SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~VAL(cl1)~"' AND Numero='"~val(cu1)~"' "))

If Vacio(val(co1))
   *- ALTA

   *- Recupero el numero de proxima cuenta de un cliente 
   *- Parametro de entrada => cl1= Codigo de cliente Parametro de salida= ab1 Nro. de Cuenta a generar
   ACT(ab1,'')

   (.'DIGABMCUE'.)

   *- Grabo como mercado el tipo de cuenta => CA o CC
   *- Alias1: Descripcion de Estado Alias2: Tipo de titular Alias3: Descripcion de Cuenta
   SQL.ADD("INSERT INTO "~DBO~".CUENTAS ")
   SQL.ADD(" (Codigo, Nombre, Cliente, Mercado, Especies, ")
   SQL.ADD("TipoCuenta, Numero, Estado, Alias1, Alias2, Alias3,CuentaContable1) VALUES(")
   SQL.ADD("'"~Val(ab1)~"', '"~Val(a14)~"', '"~Val(cl1)~"', '"~Val(B11)~"', '"~Val(b18)~"',")
   SQL.ADD("'"~Val(b11)~"', '"~Val(cu1)~"', '"~Val(b15)~"', '"~Val(a16)~"', '"~Val(b17)~"','"~Val(a20)~"','"~Val(cu2)~"')")
   SQL.NEW
   SQL.EXEC
Else 
   *- Modificacion 
   SQL.ADD("UPDATE "~DBO~".CUENTAS ")
   SQL.ADD("Set Nombre='"~Val(a14)~"',Cliente='"~Val(cl1)~"', Mercado='"~Val(B11)~"', Especies='"~Val(b18)~"', ")
   SQL.ADD("TipoCuenta='"~Val(b11)~"',Numero ='"~Val(cu1)~"', Estado='"~Val(b15)~"', ")
   SQL.ADD("Alias1='"~Val(a16)~"',Alias2='"~Val(b17)~"',Alias3= '"~Val(a20)~"',CuentaContable1='"~Val(cu2)~"' ")
   SQL.ADD("WHERE Codigo='"~Val(co1)~"' ")
   SQL.NEW
   SQL.EXEC
EndIf
