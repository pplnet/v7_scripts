SQL.ADD(" SELECT O.Cartera,O.FechaOp,O.Vehiculo1,O.Especie,M.Cantidad, ")
SQL.ADD("        O.Precio1,O.FechaVto,O.TipoOp,O.NrOperacion, M.NrSaldo, M.Book, O.Cliente1 ")
SQL.ADD(" FROM   "~DBO~".OPERACIONES O,"~DBO~".MOVPOSEJE M  ")
SQL.ADD(" WHERE  O.NrOperacion = M.NrOperacion ")
SQL.ADD("   and  M.FechaMov  >='"~IdxDate(Dialogo.Fecha1-VAR('DIASPAR'))~"' and M.FechaMov  <='"~IdxDate(Dialogo.Fecha1)~"' and M.FechaMov  >='"~IdxDate(Fecha(Var('FEINIPART')))~"'  ")
SQL.ADD("   and  M.NrSaldo    = '101' ")
SQL.ADD("   and  O.TipoOp    = 'TIC' ")
If NoVacio(&book)
   SQL.ADD("   and  M.Book    = '"~&book~"' ")
Else
   SQL.ADD("   and M.Book IN ("~Pipe2Comillas(Val(BK:1))~") ")   
EndIf
SQL.ADD("   and  (O.NrPartida Is Null OR O.NrPartida = '' OR O.NrPartida = ' ' ) ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT T.RB4 Cartera,T.Fecha1 FechaOp,T.Vehiculo1,T.Especie, ")
SQL.ADD(" M.Cantidad,T.Precio1, T.Fecha1 FechaVto,T.TipoTr2 TipoOp, ")
SQL.ADD(" T.NrTrans NrOperacion, M.NrSaldo, M.Book, T.Cliente1 ")
SQL.ADD(" FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPOSEJE M ")
SQL.ADD(" WHERE  T.NrTrans = M.NrOperacion ")
SQL.ADD("   and  M.FechaMov  >='"~IdxDate(Dialogo.Fecha1-VAR('DIASPAR'))~"' and M.FechaMov  <='"~IdxDate(Dialogo.Fecha1)~"' and M.FechaMov  >='"~IdxDate(Fecha(Var('FEINIPART')))~"'  ")
SQL.ADD("   and  M.NrSaldo     = '101' ")
SQL.ADD("   and  T.TipoTr2  IN ('DTP','TRPOS') ")
If NoVacio(&book)
   SQL.ADD("   and  M.Book    = '"~&book~"' ")
Else
   SQL.ADD("   and M.Book IN ("~Pipe2Comillas(Val(BK:1))~") ")
EndIf
SQL.ADD("   and  (T.NrPartida Is Null OR T.NrPartida = '' OR T.NrPartida = ' ' ) ")
SQL.ADD(" ORDER BY 9,1,2,4 ")