         SetFilaActual(FAC+4)
         act(c:FAC, 'Cantidad de Registros :'~fstr(Val(x:6),1,0))

         act(c:FAC+2, '(*) F = Fondo de Jubilaci›n y Pensi›n, E = Encaje, RP = Recursos Propios')
         act(i:fac+3, '______________________________________')
         act(i:fac+4, 'Firma y sello del Agente de Bolsa / Mandatario')
         act(i:fac+5, 'u Operador Sociedad de Bolsa / Mandatario.')
         SetFont(c:fac+2..i:fac+5,1)
         SetFilaActual(FAC+7)