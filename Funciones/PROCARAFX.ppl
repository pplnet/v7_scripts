acn(co2,0)
acn(fu1,val(j:fac))
acn(fu2,val(p:fac))
acn(fu3,val(q:fac))
acn(fu4,val(q:fac))

Recorrer SQL

 If fbn('Cantidad1')<>0 o fbn('Cantidad2')<>0 o fbn('CantidadFin')<>0
   ACN(BD:1, 0)
   IF Not Eqstr(fbn('Book'), Val(BK:1))
      ifa
      ACT(A:fac, 'Book: '~fbn('Book'))
      ACT(BK:1, fbn('Book'))
      ACN(BD:1, 1)
      SetFont(A:fac, 4)
      AgregarMarco(a:fac..r:fac,0,0,EXE('COLOR6'))
   ENDIF

   If fbn('NrSaldo')<>Val(sa:1) O Val(BD:1) = 1
     ifa
     ACN(sa:1, fbn('NrSaldo'))
     If fbn('NrSaldo')=31
      ACT(a:fac, 'Spot')
     Endif
     If fbn('NrSaldo')=35
       ACT(a:fac, 'Opciones')
     Endif
     If fbn('NrSaldo')=11
       ACT(a:fac, 'Spot')
     Endif
     If fbn('NrSaldo')=45
       ACT(a:fac, 'Opciones')
     Endif
     If fbn('NrSaldo')=41
       ACT(a:fac, 'Forward')
     Endif
     If fbn('NrSaldo')=21
       ACT(a:fac, 'Forward')
     Endif
     AgregarMarco(a:fac..r:fac,0,0,EXE('COLOR8'))
     SetFont(a:fac, 4)
     ifa
     ACT(ea:1, '')
     ACD(fj:1, 0)
     ACN(pj:1, 0)
     ACT(cp:1, '')
   Endif

   If Not Eqstr(fbn('Especie'), Val(ea:1)) o Not Eqstr(fbn('CallPut'), Val(cp:1)) o fbn('PrecioEj')<>Val(pj:1) o fbn('FechaEj')<>Val(fj:1) o Not Eqstr(fbn('Book'), Val(BK:1))
     ACT(ea:1, fbn('Especie'))
     ACD(fj:1, fbn('FechaEj'))
     ACN(pj:1, fbn('PrecioEj'))
     ACT(cp:1, fbn('CallPut'))
     ACT(BK:1, fbn('Book'))
     ACN(pp:1, 0)
     ACN(pp:2, 0)
   Else
     dfa
   Endif

   If NoVacio(fbn('CallPut'))
      ACT(a:fac, fbn('Especie')~' - '~fbn('CallPut')~' - '~fbn('FechaEj')~' - '~PyC(fbn('PrecioEj'),1,8) ) 
   Else
      ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre')~' - '~fbn('FechaEj')) 
   Endif
   *If fbn('NrSaldo')=31
   *   AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   *Endif
   *If fbn('NrSaldo')=35
   *   AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio4=1, Book1=fbn('Book'))
   *Endif
   *If fbn('NrSaldo')=11
   *  AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   *Endif
   *If fbn('NrSaldo')=45
   *  AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio4=1, Book1=fbn('Book'))
   *Endif
   *If fbn('NrSaldo')=41
   *  AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   *Endif
   *If fbn('NrSaldo')=21
   *  AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   *Endif
   ACT(FE:1, fbn('Fecha'))
   If fbn('Fecha')=Dialogo.Fecha1
     SCN(b:fac, fbn('CantidadIni'))
     SCN(c:fac, fbn('Cantidad1'))
     SCN(pp:1, fbn('Precio1')*fbn('Cantidad1'))
     ACN(d:fac, Val(pp:1)/Val(c:fac))

     SCN(e:fac, fbn('Cantidad2'))
     SCN(pp:2, fbn('Precio2')*fbn('Cantidad2'))
     ACN(f:fac, fbn('Precio2'))
     ACN(f:fac, Val(pp:2)/Val(e:fac))


     *IF Val(C:fac) <> 0 Y fbn('NrSaldo')=31
     *   AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *ENDIF
     *IF Val(E:fac) <> 0 Y fbn('NrSaldo')=31
     *  AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *Endif
     *If Val(C:fac) <> 0 Y fbn('NrSaldo')=35
     *  AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=1, Book1=fbn('Book'),Fecha2=0)
     *ENDIF
     *If Val(E:fac) <> 0 Y fbn('NrSaldo')=35
     *  AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=1, Book1=fbn('Book'),Fecha2=0)
     *Endif
     *If Val(C:fac) <> 0 Y fbn('NrSaldo')=11
     *  AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *ENDIF
     *If Val(E:fac) <> 0 Y fbn('NrSaldo')=11
     *  AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *Endif
     *If Val(C:fac) <> 0 Y fbn('NrSaldo')=45
     *  AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=1, Book1=fbn('Book'),Fecha2=0)
     *ENDIF
     *If Val(E:fac) <> 0 Y fbn('NrSaldo')=45
     *  AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=1, Book1=fbn('Book'),Fecha2=0)
     *Endif
     *If Val(C:fac) <> 0 Y fbn('NrSaldo')=41
     *  AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *ENDIF
     *If Val(E:fac) <> 0 Y fbn('NrSaldo')=41
     *  AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *Endif
     *If Val(C:fac) <> 0 Y fbn('NrSaldo')=21
     *  AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *ENDIF
     *If Val(C:fac) <> 0 Y fbn('NrSaldo')=21
     *  AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'),Fecha2=0)
     *Endif
   ELSE
     ***---Posicion Final del fecha anterior que se suma a Posicion Inicial de la fecha del dialogo
     SCN(b:fac, fbn('CantidadFin'))
   Endif

   ACN(g:fac, Val(c:fac)-Val(e:fac))
   SCN(h:fac, fbn('CantidadFin'))
   If Incluido(fbn('CallPut'), 'CAL|PUT')
     ACN(i:fac, CotizacionC(fbn('Especie'),fbn('CallPut'),fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
     ACN(m:fac, CotizacionC(fbn('Especie'),fbn('CallPut'),fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1-1,1,SI,val(ml1)) )
   Else
     ACN(i:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
     ACN(m:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI,val(ml1)) )
   Endif

   ACN(j:fac, Val(h:fac)*Val(i:fac))
   ACT(k:fac, IIF(Eqstr(Dialogo.Especie2,val(ml1)),'$','U$S') )

   *- Precio de Equilibrio ((Compras * ppp compras ) - (Vtas * ppp Vtas))/Descalce
   ACN(l:fac, (val(c:fac)*val(d:fac) - val(e:fac)*val(f:fac)) / val(g:fac))

   *- Precio Promedio de cierre
   ACN(n:fac,  (val(m:fac)*val(b:fac) + val(l:fac)*(Val(c:fac)-Val(e:fac))) / val(h:fac))

   *- o: Posicion final * ppcierre
   ACN(o:fac,val(n:fac)*val(h:fac))
  
   *- Saco totales de EUROS => Posicion/Precio Promedio/
   If Incluido(fbn('Especie'),val(me2))
      SCN(eu1,val(h:fac))
      SCN(eu2,val(o:fac))
   EndIf

   *- Para linkear posicion 
   ACN(ck1,val(b:fac))
   ACN(ck2,FBN['PrecioIni'])

   *- Valuacion de lo operado hoy
   ACN(p:fac,val(g:fac)*val(i:fac))

   *- Descalce * PpOperado hoy
   ACN(q:fac,val(g:fac)*val(l:fac))

   *- Volumen
   ACN(r:fac,(Val(c:fac)+Val(e:fac))*VAL(i:fac))

   If EqStr(FBN['Book'],val(co1))
      *- Book de Comex => Saco volumen
      scn(co2,val(r:fac))
   EndIf

   *- fu1: Suma de Posicion de forward
   If fbn('NrSaldo')=41
      scn(fu1,val(j:fac))
      scn(fu2,val(p:fac))
      scn(fu3,val(q:fac))
   Else
      scn(fu4,val(q:fac))
   EndIf
   SetFont(a:fac..r:fac,1)
 Else
   dfa
 Endif
Proximo

ifa

ifa
AgregarMarco(j:fac..j:fac,0,0,0)

ACN(j:fac, SUM(j:9..j:fac-1))


ACT(k:fac, IIF(Eqstr(Dialogo.Especie2,val(ml1)),'$','U$S') )
ACN(p:fac,Sum(p:9..p:fac-1))
ACN(q:fac,Sum(q:9..q:fac-1))
ACN(r:fac,Sum(r:9..r:fac-1))

*- monto operado en pesos => ut1
ACN(ut1,val(q:fac))

ACN(q:fac,val(q:fac)/val(p:fac))

SetFont(a:fac..r:fac,2)
FormatoCeldas(b:9..j:fac, EXE('F2'))
FormatoCeldas(i:9..i:fac, EXE('F9'))
FormatoCeldas(d:9..d:fac, EXE('F9'))
FormatoCeldas(f:9..f:fac, EXE('F9'))
FormatoCeldas(l:9..n:fac, EXE('F9'))

*- Para pgc 
ACN(aa:val(fp1),89)
ACN(ab:val(fp1),1)
ACT(ac:val(fp1),'PGC')
ACD(ad:val(fp1),Dialogo.Fecha1)
ACT(ae:val(fp1),Dialogo.Vehiculo1)
ACT(af:val(fp1),val(ml1))
ACT(ag:val(fp1),VAR('MERCBCRA'))
ACT(ah:val(fp1),CUENTACLIENTE(Dialogo.Vehiculo1,val(af:val(fp1)),,val(ag:val(fp1))) )

If Dialogo.Check4=0
   *- Con PGC
   ACT(ai:val(fp1),'|')

   SQL.ADD("SELECT Codigo FROM "~DBO~".ESPECIES WHERE  Tipo='MON' AND Status='HAB' ORDER BY Codigo ")
   Recorrer SQL
     dfa 
     If DesciendeDeEspecie(FBN['Codigo'],'MONEDA')
        ACT(ai:val(fp1),val(ai:val(fp1))~FBN['Codigo']~'|')
     EndIf
   Proximo

   LinkearHoja2(val(ac:val(fp1)), val(fp1),Fecha1=val(ad:val(fp1)), Vehiculo1=val(ae:val(fp1)), Especie1=val(af:val(fp1)), Mercado1=val(ag:val(fp1)),Cuenta1=val(ah:val(fp1)),Lista1=val(ai:val(fp1)),Check1=1)

   acn(c:val(fp1),LinkH(val(fp1),val(aa:val(fp1)):val(ab:val(fp1))) )
   SetFont(c:val(fp1),1)

   CerrarHoja(val(ac:val(fp1)), val(fp1),Fecha1=val(ad:val(fp1)), Vehiculo1=val(ae:val(fp1)), Especie1=val(af:val(fp1)), Mercado1=val(ag:val(fp1)),Cuenta1=val(ah:val(fp1)),Lista1=val(ai:val(fp1)),Check1=1)
EndIf

*-------------------

*- Este monto sube a PGN => Posicion Spot + Futura => FP1+2
acn(c:val(fp1)+2,val(j:fac))
SetFont(c:val(fp1)+2,1)

*- Precio Promedio General
ACN(n:fac, SUM(o:9..o:fac-1))
ACN(n:fac, val(n:fac)/val(j:fac))
FormatoCeldas(n:fac, EXE('F9'))

*- Este monto sube a PGN Promedio 
acn(e:val(fp1)+2,val(n:fac))
SetFont(e:val(fp1)+2,1)
FormatoCeldas(e:val(fp1)+2, EXE('F9'))

*- Cierre => Cotizacion del USD
acn(g:val(fp1)+2,CotizacionC(VAL(me1),,,,Dialogo.Fecha1,1,SI,val(ml1)))
SetFont(g:val(fp1)+2,1)
FormatoCeldas(g:val(fp1)+2, EXE('F9'))

*- Posicion de Forward
acn(c:val(fp1)+6,val(fu1))
SetFont(c:val(fp1)+6,1)

