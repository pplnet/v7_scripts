ACT(a:fac, 'R e s u m e n    d e   P o s i c i o n    (Expresado en '~Dialogo.Especie2~')')
SetFont(a:fac, 6)

SetFilaActual(fac+1)

*- fp1: Fila de POSICION fo1: Fila de OPERADO HOY fc1: Fila de CAJA fv1: Fila de VOLUMEN
*- fu1: SUma de Posicion de Forward eu1: Posicion de Euro eu2: PP de Euro 
*- fu2: Operado futuro fu3: PP Operado HOy Futuro Fu4: PP Operado hoy contado
*- co2: Volumen de Comex
ACN(fu1,0)
ACN(eu1,0)
ACN(eu2,0)

ACN(fi1, fac)
ACN(fp1, fac)
ACN(fo1, val(fp1)+10)
ACN(fc1, val(fp1)+16)
ACN(fv1, val(fp1)+20)

ACT(a:val(fp1)+4, 'POSICION')

ACT(b:val(fp1)  , 'PGC')
