*Oculto la fecha y la hora y el nro. de pßgina
Impresion(2,0)
Impresion(3,0)

SetMargins(1.5,0,0,0)

CrearFont(1,'Arial,8,B')                                                                                                          
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,6,')
CrearFont(4, 'Arial,10,B')

SetFilaActual(val(r1))

ACT(g:fac+1, val(t1))                                     
AlinearCeldas(g:fac+1,'D')
ACT(a:fac+1,'____________________________________________________________________________________________________________')

SetFont(a:fac+1..g:fac+1, 4)

SQL.ADD(" Select NrOperacionRef1,Cupon1, TipoTr2 from "~DBO~".TRANSACCIONES2 where NrTrans='"~Dialogo.NrTrans1~"' ")
Recorrer SQL
  ACT(op1,fbn('NrOperacionRef1'))
  ACN(cu1,fbn('Cupon1'))
  ACT(tt1,fbn('TipoTr2'))
Proximo
dfa

SQL.ADD("Select * from "~DBO~".OPERACIONES where NrOperacion='"~val(op1)~"' ")                                                                                                                                                                                                                                    
recorrer SQL  
  ACT(a:fac-4,BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Vehiculo1')))
  ACT(a:fac-3,BuscarCampo('CLIENTES', 'Direccion', 'Codigo', fbn('Vehiculo1'))~' '~BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Vehiculo1'))~' '~BuscarCampo('CLIENTES', 'Localidad', 'Codigo', fbn('Vehiculo1')))
*  ACT(a:fac-2,BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Vehiculo1')))
  ACT(a:fac-2,BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Vehiculo1')))

  SetFont(a:fac-4..a:fac-1, 3)

  ACT(a:fac+1, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Cliente1')))  
  ACT(g:fac+1, val(l1))
  AlinearCeldas(g:fac+1,'D')  
  if Dialogo.Check1=1
    ACT(g:fac+2,'REIMPRESION')
    AlinearCeldas(g:fac+2,'D')  
  endif
  ACT(a:fac+2, 'CUIT/CUIL: ')
  ACT(b:fac+2, BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Cliente1')))
  ACT(a:fac+3, 'Categoria IVA: ')
  ACT(w1,BuscarCampo('CLIENTES', 'CondicionIVA', 'Codigo', fbn('Cliente1')))
  (.'DESCONDIVA'.)
  ACT(b:fac+3, val(w2))
  ACT(a:fac+4, 'Domicilio: ')
  ACT(b:fac+4, BuscarCampo('CLIENTES', 'Direccion', 'Codigo', fbn('Cliente1'))~' '~BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Cliente1'))~' '~BuscarCampo('CLIENTES', 'Localidad', 'Codigo', fbn('Cliente1')))

  ACT(a:fac+5, 'Fecha proceso: ')
  ACT(d:fac+5, 'Fecha liquidacion: ')

  ACT(a:fac+6, 'Operacion: ')
  ACT(b:fac+6, fbn('NrOperacion'))
  ACT(d:fac+6, 'Tipo de Operacion: ')
  ACT(e:fac+6, fbn('TipoOp'))

  ACT(a:fac+7, 'Fecha de Inicio Oper.: ')
  ACT(b:fac+7, Fecha(fbn('FechaOp')))
  ACT(d:fac+7, 'Fecha Venc. Oper.: ')
  ACT(e:fac+7, Fecha(fbn('FechaVto')))

  ACT(a:fac+8, 'Moneda: ')
  ACT(b:fac+8, fbn('Especie'))
  ACT(d:fac+8, 'Cant de Cuotas: ')
  ACN(e:fac+8, fbn('Cuotas1'))
 
  ACT(a:fac+9, 'Capital Original: ')
  ACN(b:fac+9, fbn('Cantidad'))

  * Si es 2412 no muestro la Tasa ni el Saldo de Capital  
  if not fbn('RB2')=1
    ACT(d:fac+9, 'TNA: ')
    ACN(e:fac+9, fbn('Precio1'))
    else
    ACT(d:fac+9, 'Comision 2412 ')
  endif

  ACT(a:fac+10, 'Fecha Inicio Periodo: ')
  ACT(b:fac+10, Fecha(fbn('FechaOp')))
  ACT(d:fac+10, 'Fecha Venc. Periodo: ')
  ACT(e:fac+10, Fecha(fbn('FechaVto')))

  ACT(a:fac+11, 'Cuota Nro: ')
  ACT(b:fac+11, val(cu1))

  if not fbn('RB2')=1
    ACT(d:fac+11, 'Saldo de Capital: ')
    ACN(e:fac+11, fbn('TotalAux1'))
  endif
  ACN(bo4,fbn('RB2'))

  ACT(a:fac+12, 'Recibo Nro: ')
  ACT(d:fac+12, 'Tasa Punitoria: ')
  ACN(e:fac+12, fbn('TasaInteresesCupon'))

*-----------------------------------------------------------------
* PME
*-----------------------------------------------------------------
if EQSTR(fbn('TipoOp'),'PME')
  SQL.ADD("Select * from "~DBO~".CUOTAS where NrOperacion='"~val(op1)~"' and NrCuota="~val(cu1)~" ")
  recorrer SQL  
    dfa
    *---- TNA
    if not val(bo4)=1
      ACN(e:fac+9, fbn('Tasa1'))
    endif
    *---- Fecha Inicio, Fin Periodo
    ACT(b:fac+10, Fecha(fbn('Fecha1')))
    ACT(e:fac+10, Fecha(fbn('Fecha2')))
    *---- Saldo Capital
    ACN(e:fac+11, fbn('Cantidad3'))
        
    *ACT(h:fac+12, fbn('Fecha2'))        
    ACT(f:fac+12, 'Proximo Vto.: ')
    AlinearCeldas(f:fac+12,'D')
    ACN(cu2,val(cu1)+1)
    ACT(g:fac+12, SQL("Select Fecha2 from "~DBO~".CUOTAS where NrOperacion='"~val(op1)~"' and NrCuota="~val(cu2)))
  proximo
endif

AgregarMarco(a:FAC+6..g:FAC+12, 2,0)

FormatoCeldas(e:FAC+8..e:FAC+8,Exe('F0'))
FormatoCeldas(e:FAC+9..e:FAC+9,Exe('F9'))
FormatoCeldas(e:FAC+11..e:FAC+11,Exe('F2'))
FormatoCeldas(b:FAC+11..b:FAC+11,Exe('F0'))
FormatoCeldas(e:FAC+12..e:FAC+12,Exe('F9'))

SetFont(a:fac+1..a:fac+12, 1)
SetFont(d:fac+2..d:fac+12, 1)
SetFont(g:fac+2..g:fac+12, 1)

*** Excluir movimientos de WHT y PISE

SetFilaActual(val(r1)+13)

if EqStr(val(tt1),'CUPPAG')
  SQL.ADD("Select * from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD(" where NrTrans2='"~Dialogo.NrTrans1~"'")
  SQL.ADD(" and NrSaldo not between 73 and 78")
  SQL.ADD(" order by NrSaldo")
else
  SQL.ADD("Select * from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD(" where NrOperacion='"~Dialogo.NrTrans1~"'")
  SQL.ADD(" and NrSaldo not between 73 and 78")
  SQL.ADD(" order by NrSaldo")
endif

ACN(z1,0)

* Orden en que se muestran los items

(.'PMOAUXORD'.)
ACN(x1,fac)

recorrer SQL
  recorrer&i 1,25    
    if fbn('NrSaldo')=val(zx:&i)
      ACT(za:&i,fbn('Leyenda'))
      ACN(zb:&i,fbn('Cantidad'))
      break
    endif
  proximo 

  SCN(z1,fbn('Cantidad'))
  ACD(z2,fbn('FechaEje'))
  ACD(z3,fbn('FechaMov'))  
proximo

SetFilaActual(val(x1))
ifa

ACN(y1,0)
ACN(y2,1)
recorrer&i 1,25
  if NOVACIO(val(za:&i))
    SCN(y1,1)
    if val(y1)=15
      ACN(y2,4)
      SetFilaActual(val(x1)+1)
    endif
    ACT(val(y2):fac, val(za:&i))
    ACN(val(y2)+2:fac, val(zb:&i))    
    ifa
  endif
proximo

* Completo las lineas de items restantes
recorrer&i fac,val(r1)+29
 ACT(d:&i,' ')
proximo

SetFilaActual(val(r1)+29)

if val(y1)<=14
  ACN(y2,1)
else
  ACN(y2,4)
endif
ACT(val(y2):fac,'Total')
ACN(val(y2)+2:fac,val(z1))
SetFont(val(y2):fac..val(y2)+2:fac, 1)
AlinearCeldas(val(y2):fac,'D')

ifa

ACT(a:fac,VAR('LEYCOMPPM1'))
ACT(a:fac+1,VAR('LEYCOMPPM2'))
ACT(a:fac+2,VAR('LEYCOMPPM3'))
ACT(a:fac+3,' ')

AgregarMarco(a:FAC..g:FAC+2, 2,0)

AFI(fac,0.1)
AFI(fac+1,0.1)
AFI(fac+2,0.1)

SetFont(a:Fac..j:Fac+2, 3)

ACT(a:fac+4,'Fecha: '~Ahora~' Hora: '~Hora(Ahora))
ACT(e:fac+4,'FPA')
AlinearCeldas(e:fac+4,'C')
AgregarMarco(e:FAC+4..e:FAC+4, 1,0,EXE('COLOR10'))

* Muestro las fechas de proceso y liquidacion
SetFilaActual(val(r1)+1)
ACT(b:fac+5, val(z2))
ACT(e:fac+5, val(z3))

*Nro.Comprobante
ACT(z4,Copy(Dialogo.NrTrans1,3,6))
ACT(b:fac+12, val(z4))

proximo

SetFilaActual(val(r1)+13)
FormatoCeldas(d:FAC..d:FAC+10,Exe('F2'))

ACO(1,12)
ACO(2,9)
ACO(3,10)
ACO(4,12)
ACO(5,9)
ACO(6,10)
ACO(7,13)


* Reduzco el alto de todas las filas
recorrer&i 1,120
AFI(&i,0.1)
proximo

LimitesVision(i:120)
