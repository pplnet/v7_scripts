BorrarCeldas(NX:1..NX:1)
ACN(PP:99, 0)

***---Vinculadas
SQL.ADD(" SELECT O.NrOperacion, C.Cantidad1 CantCuota, C.Fecha2 FechaFin, O.Cantidad ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMPCCM')  ")
SQL.ADD("       and  O.MB3 = '0' ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
If Dialogo.Radio2=0
   *- Corto Plazo
   SQL.ADD("       and O.FechaVto <= '"~IdxDate(Val(ea1))~"' ")
Endif
If Dialogo.Radio2=1
   *- Largo Plazo
   SQL.ADD("       and O.FechaVto > '"~IdxDate(Val(ea1))~"' ")
Endif
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")

SQL.ADD(" ORDER BY 1 ")

Recorrer SQL
    IF Eqstr(fbn('NrOperacion'), Val(NX:1))
        SCN(PP:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
    ELSE
        IF Not CeldaVacia(NX:1)  
            ***---Cambio de Operacion
            ACN(PP:91, Val(PP:99) / fbn('Cantidad'))
            ACN(PP:99, 0)
        ENDIF
        ACT(NX:1, fbn('NrOperacion'))
        SCN(PP:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
    ENDIF
Proximo

