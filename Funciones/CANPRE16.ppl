SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
SQL.ADD("(TipoTr2,NrTrans, NrOperacionRef1, Cupon1, ")
SQL.ADD("Fecha1, Fecha2, Cantidad1, Especie, Vehiculo1,FechaCargaSys ) ")
SQL.ADD("VALUES ")
SQL.ADD("('ANUPAG','"~val(nm1)~"','"~val(z1)~"','"~val(pc1)~"', ")
SQL.ADD(""~IdxDate2(val(z2))~","~IdxDate2(val(z2))~","~val(x3)~",'"~val(a1)~"','"~val(p1)~"',"~IdxDate2(Fsys)~" ) ")
SQL.NEW

SQL.ADD("UPDATE "~DBO~".MOVEJECUTADOS ")
SQL.ADD("   SET NrOperacion ='"~val(nm1)~"' ")
SQL.ADD(" WHERE NrOperacion ='"~val(z1)~"' ")
SQL.ADD("   AND NrGrupo2    ="~val(pc1)~" ")
SQL.ADD("   AND FechaMov    ="~IdxDate2(val(z2))~" ")
SQL.ADD("   AND NrSaldo between 2 and 99 ")
SQL.ADD("   AND NrSaldo not between 73 and 78 ")
SQL.NEW

SQL.EXEC

