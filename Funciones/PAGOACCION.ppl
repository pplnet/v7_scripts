               *  Interfase Bantotal
               * Parámetros Salida
               * RR:1  'OK/NOK'  
               * RR:2  'Mensaje'  

               * Parámetros entrada
               * RR:10  'Referencia'  
               * RR:11  'Sucursal'  
               * RR:12  'Cuenta(1a7)'    
               * RR:13  'SubOperacion-Cuenta (9a10)'
               * RR:14  'Moneda'
               * RR:15  'Importe'
               * RR:16  'Observaciones'
               * RR:17  'Importe a Bloquear'
               * RR:18  'Importe a Debitar / Acreditar'
               * RR:19  'Cliente'
               * RR:20  'Cuenta'
               * RR:21  'Especie'
               * RR:22  'Importe Bloqueado'
               * RR:23  'Importe Debitado / Acreditado'
               * RR:24  'Tipo operacion'
               * RR:25  'Mercado'
               * RR:26  'Tipo Transferencia'
               * RR:27  'Capital'
               * RR:28  'Comisiones'
               * RR:29  'Derechos'
               * RR:30  'Iva'
               * RR:31  'Intereses'
               * RR:32  'Cod Evento (producto)'
               * RR:33  'Fecha Valor'
               * RR:34  'Referencia Corte'
               * RR:35  'Referencia Acciones'
               * RR:36  'Transaccion'
               * RR:37  'Fecha Cont'
               * RR:38  'Modulo' 
               * RR:39  'Relacion'
               * RR:40  'Tipo: 1 Resta_Liquidacion/'
               * RR:41  'Referencia CAMEST'
               * RR:47  'Capital Accion'
               * RR:48  'Comisiones Accion'
               * RR:49  'Derechos Accion'
               * RR:50  'Iva Accion'
               * RR:51  'Intereses Accion'
               * RR:57  'Capital Cupon'
               * RR:58  'Comisiones Cupon'
               * RR:59  'Derechos Cupon'
               * RR:60  'Iva Cupon'
               * RR:61  'Intereses Cupon'
               * RR:67  'Capital Camest'
               * RR:68  'Comisiones Camest'
               * RR:69  'Derechos Camest'
               * RR:70  'Iva Camest'
               * RR:71  'Intereses Camest'
               
               BorrarCeldas(rr:1..rr:50)
*               ACT(rr:10, FBN['NrOperacion']~'|')
               ACT(rr:12, Copy(FBN['Cuenta'],1,7))
               ACT(rr:13, Copy(FBN['Cuenta'],9,2))
               ACN(rr:17, 0)
               ACN(rr:18, FBN['Cantidad']-FBN['Comision']-FBN['Iva'])
               ACT(rr:19, FBN['Cliente'])
               ACT(rr:20, FBN['Cuenta'])
               ACT(rr:21, FBN['Especie'])
               ACT(rr:25, FBN['Mercado'])
               if Eqstr(CodigoInforme(),'STOCK1')
                  ACT(rr:26, 'STOCKS')
                  ACT(rr:33, Dialogo.Fecha2)
               else   
                  if Eqstr(CodigoInforme(),'PAGOD1')
                     ACT(rr:26, 'PDIVID')
                     ACT(rr:33, Dialogo.Fecha1)
                  else   
                     if Eqstr(CodigoInforme(),'CANJE2')
                        ACT(rr:26, 'CANJE')
                        ACT(rr:33, Dialogo.Fecha2)
                     else   
                        ACT(rr:26, 'ACCION')
                        ACT(rr:33, FSYS)
                     endif   
                  endif   
               endif   
               ACT(rr:27, FBN['Cantidad'])
               ACT(rr:28, FBN['Comision'])
               ACT(rr:29, '0')
               ACT(rr:30, FBN['Iva'])
               ACT(rr:31, '0')
               ACT(rr:32, '3')
*               ACT(rr:33, Dialogo.Fecha2)
*               ACT(rr:34, FBN['NrOperacion']~'|')
               ACT(rr:35, FBN['NrOperacion']~'|')
               ACT(rr:37, '0')
               ACT(rr:38, '0')
               ACT(rr:39, '0')
               ACT(rr:40, '0')
               ACT(rr:47, FBN['Cantidad'])
               ACT(rr:48, FBN['Comision'])
               ACT(rr:49, '0')
               ACT(rr:50, FBN['Iva'])
               ACT(rr:51, '0')
               
               if val(rr:17)<>0
                  * Desbloqueo de Saldo
                  ACN(rr:15, ABS(0))
                  if Dialogo.Check2=1
                     if Dialogo.Check1=1
                        (.'DESBSALCTA'.)
                        if Eqstr(Val(rr:1),'OK')
                           acn(rr:22, val(rr:17))
                        endif
                     else
                        act(rr:1,'NOK')
                     endif   
                  else
                     act(rr:1,'OK')
                     acn(rr:22, val(rr:17))
                     Messagebox('Desbloqueo '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                  endif   
               else
                  act(rr:1,'OK')
               endif   
               (.'GRAVOUCONS'.)
               If Eqstr(val(rr:1),'OK')
                  if val(rr:18)<0
                     * Debito de Saldo
                     ACN(rr:15, ABS(val(rr:18)))
                     ACT(rr:24, 'DB')
                     BorrarCeldas(rr:1..rr:2)
                     if Dialogo.Check2=1
                        if Dialogo.Check1=1
                           (.'DEBISALCTA'.)
                           if Eqstr(Val(rr:1),'OK')
                              acn(rr:23, val(rr:18))
                           endif
                        else
                           act(rr:1,'NOK')
                        endif   
                     else
                        act(rr:1,'OK')
                        acn(rr:23, val(rr:18))
                        Messagebox('Debito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                     endif   
                  else
                     if val(rr:18)>0
                     * Credito de Saldo
                        ACN(rr:15, ABS(val(rr:18)))
                        ACT(rr:24, 'CR')
                        BorrarCeldas(rr:1..rr:2)
                        if Dialogo.Check2=1
                           if Dialogo.Check1=1
                              (.'ACRESALCTA'.)
                              if Eqstr(Val(rr:1),'OK')
                                 acn(rr:23, val(rr:18))
                              endif
                           else
                              act(rr:1,'NOK')
                           endif   
                        else
                           act(rr:1,'OK')
                           acn(rr:23, val(rr:18))
                           Messagebox('Credito '~val(rr:10)~' '~val(rr:12)~' '~val(rr:13)~' '~val(rr:15))
                        endif   
                     endif                                
                  endif
               else
                  if val(rr:18)<0
                     * Debito de Saldo
                     ACT(rr:24, 'DB')
                  else   
                     if val(rr:18)>0
                        * Credito de Saldo
                        ACT(rr:24, 'CR')
                     endif
                  endif
               endif
               (.'VOUCONSSTA'.)                      
