Recorrer SQL
   IF Dialogo.Radio10=0
      SCN(h:Val(fa:1), fbn('Day'))
      SCN(i:Val(fa:1), fbn('MTD'))
      SCN(j:Val(fa:1), fbn('YTD'))
   ELSE
      IF Dialogo.Radio10=1
         SCN(i:Val(fa:1), fbn('MTD'))
         SCN(j:Val(fa:1), fbn('YTD'))
      ELSE
         SCN(i:Val(fa:1), fbn('MTD'))
         SCN(j:Val(fa:1), fbn('YTD'))
      ENDIF
   ENDIF
