ACN(fa:1, fac)

ACT(fe:2, '01/01/'~Fstr(Anio(Dialogo.Fecha1),1,0))

SQL.ADD(" SELECT R.Day, R.MTD, R.YTD, R.TipoResultado, R.NrSaldo, R.Book, R.Fecha ")
SQL.ADD(" FROM  "~DBO~".vRESULTADOS R ")
*SQL.ADD(" WHERE R.Especie = '"~fbn('Especie')~"'")
SQL.ADD(" WHERE R.Especie = '"~Val(ea:1)~"'")
if Dialogo.radio11=0
  SQL.ADD(" AND (R.NrSaldo=140 AND R.TipoResultado IN ('INTLEN','RINTLE')) ")
endif
if Dialogo.radio11=1
  SQL.ADD(" AND ((R.NrSaldo=141 AND R.TipoResultado IN ('INTFON','RINTFO')) ")
  SQL.ADD(" OR   (R.NrSaldo=134 AND R.TipoResultado IN ('FONDEO','RFONDE'))) ")
endif
if Dialogo.radio11=2
  SQL.ADD(" AND ((R.NrSaldo=140 AND R.TipoResultado IN ('INTLEN','RINTLE')) ")
  SQL.ADD(" OR   (R.NrSaldo=141 AND R.TipoResultado IN ('INTFON','RINTFO')) ")
  SQL.ADD(" OR   (R.NrSaldo=134 AND R.TipoResultado IN ('FONDEO','RFONDE'))) ")
endif
IF NOVACIO(Dialogo.Operador)
   SQL.ADD(" AND   R.Trader  = '"~Dialogo.Operador~"'")
ENDIF
IF Dialogo.Radio8=0
   SQL.ADD(" AND    R.Responsable = '"~Dialogo.Responsable1~"'")
ELSE
   IF Dialogo.Radio8=2 y NoVacio(Dialogo.Lista6)
      SQL.ADD(" AND  R.Responsable IN ("~Pipe2Comillas(Dialogo.Lista6)~")")
   ENDIF
ENDIF
IF Dialogo.Radio7=0
   SQL.ADD(" AND    R.TipoPosicion = '"~Dialogo.TipoPosicion1~"'")
ELSE
   IF Dialogo.Radio7=2 y NoVacio(Dialogo.Lista5)
      SQL.ADD(" AND  R.TipoPosicion IN ("~Pipe2Comillas(Dialogo.Lista5)~")")
   ENDIF
ENDIF
IF Dialogo.Radio5=0
   SQL.ADD(" AND    R.TipoNegocio = '"~Dialogo.TipoNegocio1~"'")
ELSE
   IF Dialogo.Radio5=2 y NoVacio(Dialogo.Lista4)
      SQL.ADD(" AND R.TipoNegocio IN ("~Pipe2Comillas(Dialogo.Lista4)~")")
   ENDIF
ENDIF
IF Dialogo.Radio9=0
   SQL.ADD(" AND  R.Book = '"~Dialogo.Book1~"'")
ELSE
   IF Dialogo.Radio9=2  y NoVacio(Dialogo.Lista8)
      SQL.ADD(" AND R.Book IN ("~Pipe2Comillas(Dialogo.Lista8)~")")
   ENDIF
ENDIF
IF Dialogo.Radio2=0
   SQL.ADD(" AND    R.Vehiculo = '"~Dialogo.Vehiculo1~"'")
ELSE
   IF Dialogo.Radio2=2 y NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND R.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
   ENDIF
ENDIF
IF Dialogo.Radio10<>0
   IF Dialogo.Radio10=1
      SQL.ADD(" AND   R.FechaRes = '"~IdxDate(Dialogo.Fecha1)~"'")
      SQL.ADD(" AND   R.MTD     <> 0 ")
   ELSE
      SQL.ADD(" AND   R.FechaRes = '"~IdxDate(Dialogo.Fecha1)~"'")
      SQL.ADD(" AND   R.YTD     <> 0 ")
   ENDIF
ELSE
*   SQL.ADD(" AND   R.Fecha = '"~IdxDate(Val(a:fac))~"'")
   SQL.ADD(" AND   R.FechaRes = '"~IdxDate(Dialogo.Fecha1)~"'")
      SQL.ADD(" AND   R.Day    <> 0 ")
ENDIF
