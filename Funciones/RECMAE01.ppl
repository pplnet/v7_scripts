********************************** Si el mensaje fue un alta de operacion  *********************
* Mensaje que dio origen a la respuesta fue :                                                  *
*      0301 : Alta para la venta hoy                          0401 : Alta para la compra hoy   *
*      0303 : Alta para la venta ayer                         0403 : Alta para la compra ayer  *
* con el primer digito de la secuencia = 0 Operacion - 3 OpMinorista                           *
************************************************************************************************
Message('----- Codigo Mensaje Recibido : Alta '~Copy(Val(A:FAC),32,4))
BorrarCeldas(e:1..g:3)
** Alta Operacion
if EqStr(Copy(Val(A:FAC),47,1),'1')
  Message('Inf.Correcta/Conf. desde oferta '~Copy(Val(A:FAC),32,4))
  * Informacion Correcta y Confirmada desde oferta
  ACT(E:1,'SI')
  ACT(E:2,'OK1')
else
  if EqStr(Copy(Val(A:FAC),47,1),'2')
    Message('Inf.Correcta/Conf. desde op. '~Copy(Val(A:FAC),32,4))
    * Informacion Correcta y Confirmada desde op.
    ACT(E:1,'SI')
    ACT(E:2,'OK2')
  else
    if EqStr(Copy(Val(A:FAC),47,1),'3')
      Message('Inf. Correcta/NO Confirmada por Agente '~Copy(Val(A:FAC),32,4))
      * Informacion Correcta pero NO Confirmada por Agente
      ACT(E:1,'NO')
      ACT(E:2,'REC')
    else
      if EqStr(Copy(Val(A:FAC),47,1),'4')
        Message('Inf. Correcta/NO Confirmada en Tiempo '~Copy(Val(A:FAC),32,4))
        * Informacion Correcta pero NO Confirmada en Tiempo
        ACT(E:1,'NO')
        ACT(E:2,'VE1')
      else
        if EqStr(Copy(Val(A:FAC),47,1),'N')
          Message('Informacion Incorrecta '~Copy(Val(A:FAC),32,4))
          * Informacion Incorrecta
          ACT(E:1,'NO')
          ACT(E:2,'ERR')
        endif
      endif
    endif
  endif
endif

if Vacio(Val(E:1))
  Message('Error Codido Respuesta Alta RECMAE01')
  if Eqstr(Var('LOGERRMAE'),'SI')
    AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
    EscribirASCII(Pad('Error Cod.Res.Alta RECMAE01',30)~'-'~Val(A:FAC))
    CerrarASCII
  endif
else
  ACN(v4, 0)
  if EqStr(Copy(Val(A:FAC),42,1),'0')
    ** Alta Operacion Mayorista
    SQL.ADD("Select O.NrOperacion, O.PaseCB, O.NrOperacion3, O.OperacionRef, O.TipoOp, O.Cliente1, OB.NrBit ")
    SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
    SQL.ADD(" Where O.NrOperacion Like '"~'T___'~Copy(Val(A:FAC),43,4)~"' ")
    SQL.ADD("   and O.TipoOp      in ('TIC','TIV','TIFC','TIFV') ")
    SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
    SQL.ADD("   and (OB.NrBit = 62 ")
    if EqStr(Copy(Val(A:FAC),5,4),Var('MERSIOP')~Var('AGESIOP'))
      SQL.ADD(" or OB.NrBit = 61 ")
    endif
    SQL.ADD(" ) ")
    SQL.ADD("   and OB.Valor = '1' ")
    Recorrer SQL
      DFA
      SCN(v4, 1)
      if Val(v4)>1
        Message('Mas de una Operacion RECMAE01')
        if Eqstr(Var('LOGERRMAE'),'SI')
          AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
          EscribirASCII(Pad('Mas de una Operacion RECMAE01',30)~'-'~Val(A:FAC))
          CerrarASCII
        endif
        break
      endif

      ACT(f:1, fbn('Cliente1'))
      ACT(f:2, Pad0(BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Cliente1')),3))
      if Vacio(Val(f:2)) o EqStr(Val(f:2),'000')
        * Operacion con tercero
        ACN(g:1, 0)
      else
        * Operacion con Agente
        ACN(g:1, 1)
      endif
      if Incluido(FBN['TipoOp'],'TIC|TIFC')
        ACN(g:2, 0)
      else
        ACN(g:2, 1)
      endif
      if Val(g:1)=0 o Val(g:2)=0
        * Terceros  o Compra
        ACN(v5, 0)
        SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
        SQL.ADD(" where Codigo    = 'CONALT' ")
        SQL.ADD("   and Secuencia = '"~Copy(Val(A:FAC),23,5)~"' ")
        SQL.ADD("   and FechaMAE  = '"~Copy(Val(A:FAC),36,6)~"' ")
        SQL.ADD("   and Estado    = 'PEN' ")
        Recorrer SQL
          DFA
          ACT(ab:1, fbn('Codigo'))
          ACT(ab:2, fbn('FechaMAE'))
          ACT(ab:3, fbn('HoraMAE'))
          ACT(ab:4, fbn('Secuencia'))
          ACT(ab:5, fbn('CodigoMAE'))
          ACT(ab:6, fbn('Estado'))
          SCN(v5,1)
        proximo
        if Val(v5)=1
          SQL.ADD("Update "~DBO~".MENSAJESMAE ")
          SQL.ADD("   Set Estado    = '"~Val(E:2)~"' ")
          SQL.ADD(" Where Codigo    = '"~Val(ab:1)~"' ")
          SQL.ADD("   and FechaMAE  = '"~Val(ab:2)~"' ")
          SQL.ADD("   and HoraMAE   = '"~Val(ab:3)~"' ")
          SQL.ADD("   and Secuencia = '"~Val(ab:4)~"' ")
          SQL.ADD("   and CodigoMAE = '"~Val(ab:5)~"' ")
          SQL.ADD("   and Estado    = 'PEN' ")
          SQL.NEW
        else
          if Eqstr(Var('LOGERRMAE'),'SI')
            if Val(v5)=0
              if Not Incluido(Val(E:2),'ERR|OK1|OK2')
                *** Error 7020/0301
                AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
                EscribirASCII(Pad('7020|0301 No Existe Pend. (1)',30)~'-'~Val(A:FAC))
                CerrarASCII
              endif
            else
              *** Error 7020/0301
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('7020|0301 Multipes Reg. (1)',30)~'-'~Val(A:FAC))
              CerrarASCII
            endif
          endif
        endif
      endif

      if EqStr(Copy(Val(A:FAC),32,2),'04')
        ACT(E:3, 'ALCO%')
      else
        ACT(E:3, 'ALVT%')
      endif
      ACN(v6, 0)
      SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
      SQL.ADD(" where Codigo    like '"~Val(E:3)~"' ")
      SQL.ADD("   and Secuencia = '"~Copy(Val(A:FAC),42,5)~"' ")
      SQL.ADD("   and FechaMAE  = '"~Copy(Val(A:FAC),36,6)~"' ")
      SQL.ADD("   and Estado    = 'INF' ")
      Recorrer SQL
        DFA
        ACT(ac:1, fbn('Codigo'))
        ACT(ac:2, fbn('FechaMAE'))
        ACT(ac:3, fbn('HoraMAE'))
        ACT(ac:4, fbn('Secuencia'))
        ACT(ac:5, fbn('CodigoMAE'))
        ACT(ac:6, fbn('Estado'))
        SCN(v6,1)
      proximo
      if Val(v6)=1
        SQL.ADD("Update "~DBO~".MENSAJESMAE ")
        SQL.ADD("   Set Estado    = '"~Val(E:2)~"' ")
        SQL.ADD(" Where Codigo    = '"~Val(ac:1)~"' ")
        SQL.ADD("   and FechaMAE  = '"~Val(ac:2)~"' ")
        SQL.ADD("   and HoraMAE   = '"~Val(ac:3)~"' ")
        SQL.ADD("   and Secuencia = '"~Val(ac:4)~"' ")
        SQL.ADD("   and CodigoMAE = '"~Val(ac:5)~"' ")
        SQL.ADD("   and Estado    = 'INF' ")
        SQL.NEW
      else
        if Eqstr(Var('LOGERRMAE'),'SI')
          if Val(v6)=0
            *** Error 7020/0301
            AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('7020|0301 No Existe Pend. (2)',30)~'-'~Val(A:FAC))
            CerrarASCII
          else
            *** Error 7020/0301
            AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('7020|0301 Multipes Reg. (2)',30)~'-'~Val(A:FAC))
            CerrarASCII
          endif
        endif
      endif
      if EqStr(Val(E:1),'NO')
        Message('E:1 = NO '~Copy(Val(A:FAC),32,4))
        Message('---------- '~FBN['NrOperacion']~' Error en Alta, va a Compliance')
        * Error en alta operacion, actualiza Operaciones
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("   Set AceptaMAE   = 'NO', ")
        SQL.ADD("       NroAltaMAE   = null, ")
        SQL.ADD("       CodErrorMAE = '"~Copy(Val(A:FAC),47,1)~"', ")
        SQL.ADD("       ObsErrorMAE = '"~Copy(Val(A:FAC),48,15)~"' ")
        SQL.ADD(" Where NrOperacion = '"~FBN['NrOperacion']~"' ")
        SQL.NEW
        SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
        SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" '"~FBN['NrOperacion']~"', ")
        SQL.ADD(" "~SQLAhora~", ")
        SQL.ADD(" 'ERRORALTA', ")
        SQL.ADD(" '"~'Alta-'~Copy(Val(A:FAC),48,55)~"' ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC
        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=fbn('NrBit'), Entero2=69)
      else
        Message('---------- '~FBN['NrOperacion']~' Ok Alta, va a Envio de Boletos')
        * Ok alta operacion, actualiza Operaciones
        BorrarCeldas(K9..K12)
        ACT(K9,  Copy(Val(A:FAC),52,2)~'/'~Copy(Val(A:FAC),50,2)~'/'~Copy(Val(A:FAC),48,2)~' '~Copy(Val(A:FAC),54,2)~':'~Copy(Val(A:FAC),56,2)~':'~Copy(Val(A:FAC),58,2))
        ACT(K10, SQLFechaStr(Val(K9),Exe('FORFECHOR')))
        if ESNUMERO(Copy(Val(A:FAC),333,5))
           ACT(xy44,Copy(Val(A:FAC),333,5))
        else
           ACT(xy44,Copy(Val(A:FAC),23,5))
        endif
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("   Set AceptaMAE    = 'SI', ")
        SQL.ADD("       FechaAltaMAE = "~Val(K10)~", ")
        SQL.ADD("       NroAltaMAE   = '"~Copy(Val(A:FAC),23,5)~"', ")
        SQL.ADD("       UDN2         = '"~Copy(Val(A:FAC),146,4)~"', ")
        SQL.ADD("       NrOrden      = '"~Val(xy44)~"' ")
        SQL.ADD(" Where NrOperacion  = '"~FBN['NrOperacion']~"' ")
        SQL.NEW
        SQL.EXEC
        EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=1, Radio2=2, Entero1=fbn('NrBit'), Entero2=71)
        * asignar nro. de boleto automaticamente
        EjecutarEvento('ASIBOL',NrOperacion1=FBN['NrOperacion'],Radio1=1)
      endif
*      MessageBox('RECMAE01 - PaseCB = '~FBN['PaseCB'])
      if EqStr(FBN['PaseCB'],'1')
*        MessageBox('RECMAE01 - Actualiza NroAltaMAE del Pase '~FBN['OperacionRef'])
** FJL 17/03/20 - En STD el pase es OperacionRef
*        ACT(w1, BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',FBN['NrOperacion3']))
        ACT(w1, BuscarCampo('OPERACIONES','NroAltaMAE','NrOperacion',FBN['OperacionRef']))
        if EqStr(Val(E:1),'SI')
          ACT(w2,'BOL ')
        else
          ACT(w2,'ERRO')
        endif
        if Incluido(FBN['TipoOp'],'TIC|TIV')
          ACT(w3, Pad(Val(w2),4)~Copy(Val(w1),5,4))
        else
          ACT(w3, Copy(Val(w1),1,4)~Pad(Val(w2),4))
        endif
        SQL.ADD("Update "~DBO~".OPERACIONES ")
        SQL.ADD("   Set NroAltaMAE  = '"~Val(w3)~"' ")
** FJL 17/03/20 - En STD el pase es OperacionRef
*        SQL.ADD(" Where NrOperacion = '"~FBN['NrOperacion3']~"' ")
        SQL.ADD(" Where NrOperacion = '"~FBN['OperacionRef']~"' ")
        SQL.NEW
        SQL.EXEC
      endif
    Proximo
    if Val(v4)=0
      Message('Operacion NO encontrada RECMAE01')
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Op. NO encontrada RECMAE01',30)~'-'~Val(A:FAC))
        CerrarASCII
      endif
    endif
  else
  if EqStr(Copy(Val(A:FAC),42,1),'3') y NO
      ** Alta Operacion Minorista
      SQL.ADD("Select O.NrOperacion, O.PaseCB, O.OperacionRef, O.TipoOp, O.Cliente1, OB.NrBit ")
      SQL.ADD("  from "~DBO~".OPMINORISTAS O, "~DBO~".OPERACIONESBITS OB ")
      SQL.ADD(" Where O.NrOperacion Like '"~'MT__'~Copy(Val(A:FAC),43,4)~"' ")
      SQL.ADD("   and O.TipoOp      in ('TIC','TIV') ")
      SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
      SQL.ADD("   and (OB.NrBit = 62 ")
      if EqStr(Copy(Val(A:FAC),5,4),Var('MERSIOP')~Var('AGESIOP'))
        SQL.ADD(" or OB.NrBit = 61 ")
      endif
      SQL.ADD(" ) ")
      SQL.ADD("   and OB.Valor = '1' ")
      Recorrer SQL
        DFA
        SCN(v4, 1)
        if Val(v4)>1
          Message('Mas de una Operacion RECMAE01')
          if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('Mas de 1 Op.Minorista RECMAE01',30)~'-'~Val(A:FAC))
            CerrarASCII
          endif
          break
        endif
        ACT(f:1, fbn('Cliente1'))
*        ACT(f:2, Pad0(BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Cliente1')),3))
        ACT(f:2, Pad0('000',3))
        if Vacio(Val(f:2)) o EqStr(Val(f:2),'000')
          * Operacion con tercero
          ACN(g:1, 0)
        else
          * Operacion con Agente
          ACN(g:1, 1)
        endif
        if Incluido(FBN['TipoOp'],'TIC|TIFC')
          ACN(g:2, 0)
        else
          ACN(g:2, 1)
        endif
        if Val(g:1)=0 o Val(g:2)=0
          * Terceros  o Compra
          ACN(v5, 0)
          SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
          SQL.ADD(" where Codigo    = 'CONALT' ")
          SQL.ADD("   and Secuencia = '"~Copy(Val(A:FAC),23,5)~"' ")
          SQL.ADD("   and FechaMAE  = '"~Copy(Val(A:FAC),36,6)~"' ")
          SQL.ADD("   and Estado    = 'PEN' ")
          Recorrer SQL
            DFA
            ACT(ab:1, fbn('Codigo'))
            ACT(ab:2, fbn('FechaMAE'))
            ACT(ab:3, fbn('HoraMAE'))
            ACT(ab:4, fbn('Secuencia'))
            ACT(ab:5, fbn('CodigoMAE'))
            ACT(ab:6, fbn('Estado'))
            SCN(v5,1)
          proximo
          if Val(v5)=1
            SQL.ADD("Update "~DBO~".MENSAJESMAE ")
            SQL.ADD("   Set Estado    = '"~Val(E:2)~"' ")
            SQL.ADD(" Where Codigo    = '"~Val(ab:1)~"' ")
            SQL.ADD("   and FechaMAE  = '"~Val(ab:2)~"' ")
            SQL.ADD("   and HoraMAE   = '"~Val(ab:3)~"' ")
            SQL.ADD("   and Secuencia = '"~Val(ab:4)~"' ")
            SQL.ADD("   and CodigoMAE = '"~Val(ab:5)~"' ")
            SQL.ADD("   and Estado    = 'PEN' ")
            SQL.NEW
          else
            if Eqstr(Var('LOGERRMAE'),'SI')
              if Val(v5)=0
                if Not Incluido(Val(E:2),'ERR|OK1|OK2')
                  *** Error 7020/0301
                  AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
                  EscribirASCII(Pad('7020|0301 No Existe Pend. (3)',30)~'-'~Val(A:FAC))
                  CerrarASCII
                endif
              else
                *** Error 7020/0301
                AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
                EscribirASCII(Pad('7020|0301 Multipes Reg. (3)',30)~'-'~Val(A:FAC))
                CerrarASCII
              endif
            endif
          endif
        endif

        if EqStr(Copy(Val(A:FAC),32,2),'04')
          ACT(E:3, 'ALCO%')
        else
          ACT(E:3, 'ALVT%')
        endif
        ACN(v6, 0)
        SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
        SQL.ADD(" where Codigo    like '"~Val(E:3)~"' ")
        SQL.ADD("   and Secuencia = '"~Copy(Val(A:FAC),42,5)~"' ")
        SQL.ADD("   and FechaMAE  = '"~Copy(Val(A:FAC),36,6)~"' ")
        SQL.ADD("   and Estado    = 'INF' ")
        Recorrer SQL
          DFA
          ACT(ac:1, fbn('Codigo'))
          ACT(ac:2, fbn('FechaMAE'))
          ACT(ac:3, fbn('HoraMAE'))
          ACT(ac:4, fbn('Secuencia'))
          ACT(ac:5, fbn('CodigoMAE'))
          ACT(ac:6, fbn('Estado'))
          SCN(v6,1)
        proximo
        if Val(v6)=1
          SQL.ADD("Update "~DBO~".MENSAJESMAE ")
          SQL.ADD("   Set Estado    = '"~Val(E:2)~"' ")
          SQL.ADD(" Where Codigo    = '"~Val(ac:1)~"' ")
          SQL.ADD("   and FechaMAE  = '"~Val(ac:2)~"' ")
          SQL.ADD("   and HoraMAE   = '"~Val(ac:3)~"' ")
          SQL.ADD("   and Secuencia = '"~Val(ac:4)~"' ")
          SQL.ADD("   and CodigoMAE = '"~Val(ac:5)~"' ")
          SQL.ADD("   and Estado    = 'INF' ")
          SQL.NEW
        else
          if Eqstr(Var('LOGERRMAE'),'SI')
            if Val(v6)=0
              *** Error 7020/0301
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('7020|0301 No Existe Pend. (4)',30)~'-'~Val(A:FAC))
              CerrarASCII
            else
              *** Error 7020/0301
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('7020|0301 Multipes Reg. (4)',30)~'-'~Val(A:FAC))
              CerrarASCII
            endif
          endif
        endif
        if EqStr(Val(E:1),'NO')
          Message('E:1 = NO '~Copy(Val(A:FAC),32,4))
          Message('---------- '~FBN['NrOperacion']~' Error en Alta, va a Compliance')
          * Error en alta operacion, actualiza Operaciones
          SQL.ADD("Update "~DBO~".OPMINORISTAS ")
          SQL.ADD("   Set AceptaMAE   = 'NO', ")
          SQL.ADD("       NroAltaMAE  = null, ")
          SQL.ADD("       CodErrorMAE = '"~Copy(Val(A:FAC),47,1)~"', ")
          SQL.ADD("       ObsErrorMAE = '"~Copy(Val(A:FAC),48,15)~"' ")
          SQL.ADD(" Where NrOperacion = '"~FBN['NrOperacion']~"' ")
          SQL.NEW
          SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
          SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
          SQL.ADD(" ) Values ( ")
          SQL.ADD(" '"~FBN['NrOperacion']~"', ")
          SQL.ADD(" "~SQLAhora~", ")
          SQL.ADD(" 'ERRORALTA', ")
          SQL.ADD(" '"~'Alta-'~Copy(Val(A:FAC),48,55)~"' ")
          SQL.ADD(" ) ")
          SQL.NEW
          SQL.EXEC
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=2, Entero1=fbn('NrBit'), Entero2=69)
        else
          Message('---------- '~FBN['NrOperacion']~' Ok Alta, va a Envio de Boletos')
          * Ok alta operacion, actualiza Operaciones
          BorrarCeldas(K9..K12)
          ACT(K9,  Copy(Val(A:FAC),52,2)~'/'~Copy(Val(A:FAC),50,2)~'/'~Copy(Val(A:FAC),48,2)~' '~Copy(Val(A:FAC),54,2)~':'~Copy(Val(A:FAC),56,2)~':'~Copy(Val(A:FAC),58,2))
          ACT(K10, SQLFechaStr(Val(K9),Exe('FORFECHOR')))
          SQL.ADD("Update "~DBO~".OPMINORISTAS ")
          SQL.ADD("   Set AceptaMAE    = 'SI', ")
          SQL.ADD("       FechaAltaMAE = "~Val(K10)~", ")
          SQL.ADD("       NroAltaMAE   = '"~Copy(Val(A:FAC),23,5)~"', ")
          SQL.ADD("       UDN2         = '"~Copy(Val(A:FAC),146,4)~"' ")
          SQL.ADD(" Where NrOperacion  = '"~FBN['NrOperacion']~"' ")
          SQL.NEW
          SQL.EXEC
          EjecutarEvento('CBOINS', String1=fbn['NrOperacion'], Radio1=0, Radio2=2, Entero1=fbn('NrBit'), Entero2=71)
          * asignar nro. de boleto automaticamente
          EjecutarEvento('ASIBOL',NrOperacion1='',Radio1=0)
        endif
      Proximo
      if Val(v4)=0
        Message('Operacion NO encontrada RECMAE01')
        if Eqstr(Var('LOGERRMAE'),'SI')
          AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
          EscribirASCII(Pad('Op.Min. NO encontrada RECMAE01',30)~'-'~Val(A:FAC))
          CerrarASCII
        endif
      endif
    else
      Message('Digito Secuencia incorrecto RECMAE01')
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('Digito incorrecto RECMAE01',30)~'-'~Val(A:FAC))
        CerrarASCII
      endif
    endif
  endif
endif
