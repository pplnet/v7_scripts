If SQL("Select 1 from "~DBO~".RENTABILIDAD Where Fecha ='"~IdxDate(Dialogo.Fecha1)~"'  AND Vehiculo = '"~&vehiculo~"' AND Book='"~&book~"' ") = 1
    SQL.ADD("UPDATE "~DBO~".RENTABILIDAD  ")
    If &radio2 = 0
        SQL.ADD("Set ValorCarteraML = "~FStr(&tCartera,1,2)~" ,")
    Else
        SQL.ADD("Set ValorCarteraME = "~FStr(&tCartera,1,2)~" ,")
    Endif
    SQL.ADD("FechaCarga = "~SQLAhora~", FechaCargaSys = '"~IdxDate(FSYS)~"'  ") 
    SQL.ADD("Where Fecha ='"~IdxDate(Dialogo.Fecha1)~"'  AND Vehiculo = '"~&vehiculo~"' AND Book='"~&book~"'  ") 
    SQL.NEW
    SQL.EXEC
Else
    If &radio2 = 0
          SQL.ADD("INSERT INTO "~DBO~".RENTABILIDAD (Fecha,Vehiculo,Book,ValorCarteraML,FechaCarga,FechaCargaSys) VALUES")
          SQL.ADD("('"~IdxDate(Dialogo.Fecha1)~"','"~&vehiculo~"','"~&book~"',"~FStr(&tCartera,1,2)~","~SQLAhora~",'"~IdxDate(FSYS)~"')") 
          SQL.NEW
          SQL.EXEC
    Else
          SQL.ADD("INSERT INTO  RENTABILIDAD (Fecha,Vehiculo,Book,ValorCarteraME,FechaCarga,FechaCargaSys) VALUES")
          SQL.ADD("('"~IdxDate(Dialogo.Fecha1)~"','"~&vehiculo~"','"~&book~"',"~FStr(&tCartera,1,2)~","~SQLAhora~",'"~IdxDate(FSYS)~"')") 
          SQL.NEW
          SQL.EXEC
    Endif     
Endif

        
        
        
 
         