*Solo para operaciones bursatiles
IF Dialogo.Radio2 = 3
   SQL.ADD("SELECT ABS(SUM(CASE M.NrGrupo WHEN 2 THEN M.Cantidad ELSE 0 END)) Monto, ")
   SQL.ADD("       ABS(SUM(CASE M.NrGrupo WHEN 3 THEN M.Cantidad ELSE ")
   SQL.ADD("               CASE M.NrGrupo WHEN 5 THEN M.Cantidad ELSE ")
   SQL.ADD("               CASE M.NrGrupo WHEN 6 THEN M.Cantidad ELSE 0 END END END)) Arancel, ")
   SQL.ADD("       ABS(SUM(CASE M.NrGrupo WHEN 4 THEN M.Cantidad ELSE ")
   SQL.ADD("               CASE M.NrGrupo WHEN 7 THEN M.Cantidad ELSE 0 END END)) Iva ")
   SQL.ADD("FROM "~DBO~".MOVPENDIENTES M ")
   IF Dialogo.Radio8<>1
      SQL.ADD("WHERE M.NrOperacion IN ("~Pipe2Comillas(Val(i:&i))~") AND ")
   ELSE
      SQL.ADD("WHERE M.Book IN ("~Pipe2Comillas(Val(ck1))~") AND ")
   ENDIF
   SQL.ADD("      M.Especie = '"~Val(d:&i)~"' AND ")
   SQL.ADD("      M.Cliente = '"~Val(b:&i)~"' ")

   Recorrer SQL
      ACN(ch:&i, FBN['Arancel'])
      ACN(ci:&i, FBN['Iva'])
   Proximo

   ACN(cj:&i, Val(cc:&i)+Val(ce:&i)+Val(cg:&i))

   * porcentaje monto 1 del total
   ACN(da:&i, Val(cc:&i)*100/Val(cj:&i))
   * porcentaje monto 2 del total
   ACN(db:&i, Val(ce:&i)*100/Val(cj:&i))
   * porcentaje monto 3 del total
   ACN(dc:&i, Val(cg:&i)*100/Val(cj:&i))

   * Comision e iva de cta1
   IF Val(cc:&i)<>0 y Val(ce:&i)=0 y Val(cg:&i)=0
      ACN(ck:&i, ROUND(Val(ch:&i),2))
      ACN(cl:&i, ROUND(Val(ci:&i),2))
   ELSE
      ACN(ck:&i, ROUND(Val(ch:&i)*Val(da:&i)/100,2))
      ACN(cl:&i, ROUND(Val(ci:&i)*Val(da:&i)/100,2))

      * Comision e iva de cta2
      IF Val(ce:&i)<>0 y Val(cg:&i)=0
         ACN(cm:&i, Val(ch:&i)-Val(ck:&i))
         ACN(cn:&i, Val(ci:&i)-Val(cl:&i))
      ELSE
         ACN(cm:&i, ROUND(Val(ch:&i)*Val(db:&i)/100,2))
         ACN(cn:&i, ROUND(Val(ci:&i)*Val(db:&i)/100,2))

         * Comision e iva de cta3
         ACN(co:&i, Val(ch:&i)-Val(ck:&i)-Val(cm:&i))
         ACN(cp:&i, Val(ci:&i)-Val(cl:&i)-Val(cn:&i))
      ENDIF
   ENDIF
ENDIF
