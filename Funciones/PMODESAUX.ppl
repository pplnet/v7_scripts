*Oculto la fecha y la hora y el nro. de pagina
Impresion(2,0)
Impresion(3,0)

SetMargins(0,0,0,0)

CrearFont(1,'Arial,8,B')                                                                                                          
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,6,')
CrearFont(4, 'Arial,10,B')

SetFilaActual(val(r1))

ACT(h:fac+1, val(t1))                                     
AlinearCeldas(h:fac+1,'D')
ACT(a:fac+1,'__________________________________________________________________________________________________')

SetFont(a:fac+1..j:fac+1, 4)

ACT(z1, SQL("Select NrOperacionRef1 from "~DBO~".TRANSACCIONES2 where NrTrans='"~Dialogo.NrTrans1~"' "))

SQL.ADD("Select * from "~DBO~".OPERACIONES where NrOperacion='"~val(z1)~"' ")                                                                                                              
                                                                                                                      
recorrer SQL  

  ACT(a:fac-4,BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Vehiculo1')))
  ACT(a:fac-3,BuscarCampo('CLIENTES', 'Direccion', 'Codigo', fbn('Vehiculo1'))~' '~BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Vehiculo1'))~' '~BuscarCampo('CLIENTES', 'Localidad', 'Codigo', fbn('Vehiculo1')))
  ACT(a:fac-2,BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Vehiculo1')))

  SetFont(a:fac-4..a:fac-1, 3)

  ACT(a:fac+1, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Cliente1')))  
  ACT(h:fac+1, val(l1))
  AlinearCeldas(h:fac+1,'D')    

  ACT(a:fac+2, 'CUIT/CUIL: ')
  ACT(b:fac+2, BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Cliente1')))

  if Dialogo.Check1=1
    ACT(h:fac+2,'REIMPRESION')
    AlinearCeldas(h:fac+2,'D')
  endif


  ACT(a:fac+3, 'Categoria IVA: ')
  ACT(w1,BuscarCampo('CLIENTES', 'CondicionIVA', 'Codigo', fbn('Cliente1')))
  (.'DESCONDIVA'.)
  ACT(b:fac+3, val(w2))
  ACT(a:fac+4, 'Domicilio: ')
  ACT(b:fac+4, BuscarCampo('CLIENTES', 'Direccion', 'Codigo', fbn('Cliente1'))~' '~BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Cliente1'))~' '~BuscarCampo('CLIENTES', 'Localidad', 'Codigo', fbn('Cliente1')))

  ACT(a:fac+5, 'Fecha proceso: ')
  ACT(d:fac+5, 'Fecha liquidacion: ')

  ACT(a:fac+6, 'Operacion: ')
  ACT(b:fac+6, fbn('NrOperacion'))
  ACT(d:fac+6, 'Tipo de Operacion: ')
  ACT(e:fac+6, fbn('TipoOp'))

  ACT(a:fac+7, 'Fecha de Inicio Oper.: ')
  ACT(b:fac+7, Fecha(fbn('FechaOp')))
  ACT(d:fac+7, 'Fecha Venc. Oper.: ')
  ACT(e:fac+7, Fecha(fbn('FechaVto')))

  ACT(a:fac+8, 'Moneda: ')
  ACT(b:fac+8, fbn('Especie'))
  ACT(d:fac+8, 'Cant de Cuotas: ')
  ACN(e:fac+8, fbn('Cuotas1'))
 
  ACT(a:fac+9, 'Capital Original: ')
  ACN(b:fac+9, fbn('Cantidad'))
  ACT(d:fac+9, 'TNA: ')
  ACN(e:fac+9, fbn('Precio1'))

  ACT(a:fac+12, 'Recibo Nro: ')
  ACT(b:fac+12,Copy(Dialogo.NrTrans1,3,6))

*-----------------------------------------------------------------
* PME
*-----------------------------------------------------------------
if EQSTR(fbn('TipoOp'),'PME')
  SQL.ADD("Select * from "~DBO~".CUOTAS where NrOperacion='"~val(z1)~"' and NrCuota=1 ")
  recorrer SQL  
    dfa
    *---- TNA
    ACN(e:fac+9, fbn('Tasa1'))

    ACT(d:fac+12, 'Primer Vto.')
    ACT(e:fac+12, fbn('Fecha2'))
  proximo
endif



AgregarMarco(a:FAC+6..h:FAC+12, 2,0)

FormatoCeldas(e:FAC+8..e:FAC+8,Exe('F0'))
FormatoCeldas(e:FAC+9..e:FAC+9,Exe('F9'))
FormatoCeldas(e:FAC+11..e:FAC+11,Exe('F2'))
FormatoCeldas(b:FAC+11..b:FAC+11,Exe('F0'))
FormatoCeldas(e:FAC+12..e:FAC+12,Exe('F9'))

SetFont(a:fac+1..a:fac+12, 1)
SetFont(d:fac+2..d:fac+12, 1)
SetFont(g:fac+2..g:fac+12, 1)

SetFilaActual(val(r1)+13)
ifa
ACT(a:fac,'Capital')
ACN(d:fac,fbn('Cantidad'))

ACD(z2,FSYS)
ACD(z3,fbn('FechaOp'))

ifa

* Completo las lineas de items restantes
recorrer&i fac,val(r1)+25
  ACT(a:&i,' ')
proximo

SetFilaActual(val(r1)+25)

ACT(c:fac,'Total')
ACN(d:fac,fbn('Cantidad'))
SetFont(c:fac..d:fac, 1)
AlinearCeldas(c:fac,'D')

ifa

ACT(a:fac,VAR('LEYCOMPPM1'))
ACT(a:fac+1,VAR('LEYCOMPPM2'))
ACT(a:fac+2,VAR('LEYCOMPPM3'))

AgregarMarco(a:FAC..h:FAC+2, 2,0)

AFI(fac,0.1)
AFI(fac+1,0.1)
AFI(fac+2,0.1)

SetFont(a:Fac..j:Fac+2, 3)

ACT(a:fac+4,'Fecha: '~Ahora~' Hora: '~Hora(Ahora))
ACT(e:fac+4,'FPA')
AlinearCeldas(e:fac+4,'C')
AgregarMarco(e:FAC+4..e:FAC+4, 1,0,EXE('COLOR10'))

* Muestro las fechas de proceso y liquidacion
SetFilaActual(val(r1)+1)
ACT(b:fac+5, val(z2))
ACT(e:fac+5, val(z3))

proximo

SetFilaActual(val(r1)+13)
FormatoCeldas(d:FAC..d:FAC+10,Exe('F2'))

ACO(1,12)
ACO(2,9)
ACO(4,13)
ACO(5,9)
ACO(6,2)
ACO(7,10)

* Reduzco el alto de todas las filas
recorrer&i 1,130
AFI(&i,0.1)
proximo

*LimitesVision(i:100)
