SQL.ADD("      Cliente = '"~val(pa2)~"' AND ")
SQL.ADD("      Mercado = '"~Val(pa4)~"' AND ")
SQL.ADD("      CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) = "~FStr(Val(pa5),0,0)~" ")
