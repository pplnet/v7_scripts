if EQSTR(VAR('INSTALACIO'),'MLASA')
    ** La dll debe estar en el mismo directorio que el exe.
    ** Caso contrario, hay que especificar el directorio relativo o absoluto.
    require 'FPA.BOFA.COMMON.dll'

    ** Declaro las clases a utilizar en ppl
    import ServiceFPA,            'FPA.BOFA.COMMON.Services.Default.ServiceFPA'
    import InputDealCreate,       'FPA.BOFA.COMMON.Entities.Raiden_IO.Input_SisExt_DealCreateResponse'
    import InputDealCancel,       'FPA.BOFA.COMMON.Entities.Raiden_IO.Input_SisExt_DealCancelResponse'
    import InputDealCreateSiopel, 'FPA.BOFA.COMMON.Entities.Raiden_IO.Input_SisExt_Siopel_DealCreationContingency'
    import InputDealCancelSiopel, 'FPA.BOFA.COMMON.Entities.Raiden_IO.Input_SisExt_Siopel_DealCancelationContingency'

    ** Instancio la clase ServiceFPA
    let &serv new ServiceFPA()

    ** Funciones Convert: STR() INT() DAT() DBL() BLN()

    def DealCreateResp(success, raidenId, nrOp, siopelId, settDate, errors)
       let &input new InputDealCreate()
       &input.set_Action("ND")
       &input.set_Success(success)
       &input.set_RaidenRefID(STR(raidenId))
       &input.set_TimeSent(DAT(Ahora))
       &input.set_FPAID(STR(nrOp))
       &input.set_SIOPELID(STR(siopelId))
       &input.set_SettlementDate(DAT(settDate))
       &input.SetErrorMessage(STR(errors))
       let &resp &serv.SisExt_DealCreateResponse(&input)
       OutputWrite("DealCreateResp: "~&resp)
       return &resp
    end


    def DealCancelResp(success, raidenId, nrOp, errors)
       let &input new InputDealCancel()
       &input.set_Action("CD")
       &input.set_Success(success)
       &input.set_RaidenRefID(STR(raidenId))
       &input.set_TimeSent(DAT(Ahora))
       &input.set_FPAID(STR(nrOp))
       &input.SetErrorMessage(STR(errors))
       let &resp &serv.SisExt_DealCancelResponse(&input)
       OutputWrite("DealCancelResp: "~&resp)
       return &resp
    end
    **Watch('CONECTASIS OK')

* FJL 25/11/19 - Se invierte FechaOp y fecha Carga - mail de PDomoni
*    def DealCreateSiopelCont(NrOp, SiopelID, TipoOpera, Especie, TipoEsp, Cliente, CoperID, Amount, Precio, Moneda, TipoCambio, Book, FechaOp, FechaLiq, FechaDeal, Plazo, Operad)
    def DealCreateSiopelCont(NrOp, SiopelID, TipoOpera, Especie, TipoEsp, Cliente, CoperID, Amount, Precio, Moneda, TipoCambio, Book, FechaCargaSys, FechaLiq, FechaOp, Plazo, Operad, Mercad)
       let &input new InputDealCreateSiopel()
       &input.set_Action("NA")
       &input.set_TimeSent(DAT(Ahora))
       &input.set_FPAID(STR(NrOp))
       &input.set_SIOPELID(STR(SiopelID))
       &input.set_Side(STR(TipoOpera))
       &input.set_InstrumentID(STR(Especie))
       &input.set_InstrumentTypeID(STR(TipoEsp))
       &input.set_Client(STR(Cliente))
       &input.set_CoperID(STR(CoperID))
       &input.set_Amount(DBL(Amount))
       &input.set_PriceType("Price")
       &input.set_FPAPrice(DBL(Precio))
       &input.set_SettlementCurrency(STR(Moneda))
       &input.set_FXRate(DBL(TipoCambio))
       &input.set_Book(STR(Book))
*       &input.set_TradeDate(DAT(FechaOp))
       &input.set_TradeDate(DAT(FechaCargaSys))
       &input.set_SettlementDate(DAT(FechaLiq))
*       &input.set_DealDate(DAT(FechaDeal))
       &input.set_DealDate(DAT(FechaOp))
       &input.set_SettlementDays(INT(Plazo))
       &input.set_TraderNBK(STR(Operad))
       &input.set_ClearingLocation(STR(Mercad))       
       let &resp &serv.SisExt_Siopel_DealCreationContingency(&input)
       OutputWrite("DealCreateSiopelCont: "~&resp)
       return &resp
    end

    def DealCancelSiopelCont(RaidenID, NrOp, operad)
       let &input new InputDealCancelSiopel()
       &input.set_Action("CA")
       &input.set_RaidenRefID(STR(RaidenID))
       &input.set_FPAID(STR(NrOp))
       &input.set_TimeSent(DAT(Ahora))
       &input.set_TraderNBK(STR(operad))
       let &resp &serv.SisExt_Siopel_DealCancelationContingency(&input)
       OutputWrite("DealCancelSiopelCont: "~&resp)
       return &resp
    end

endif    
