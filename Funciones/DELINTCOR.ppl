*- Recibe nu1: Nombre de Archivo da1: Fecha
Message('Eliminando generacion anterior para Archivo '~val(nu1))
SQL.ADD("DELETE "~DBO~".CABINTCORP Where FileName='"~val(nu1)~"' and FileDate="~Fstr(Num(val(da1)),0,0)~" ") 
SQL.NEW
SQL.ADD("DELETE "~DBO~".ITFXINTCORP Where FileName='"~val(nu1)~"' and FileDate="~Fstr(Num(val(da1)),0,0)~" ") 
SQL.NEW
SQL.ADD("DELETE "~DBO~".ITSEINTCORP Where FileName='"~val(nu1)~"' and FileDate="~Fstr(Num(val(da1)),0,0)~" ") 
SQL.NEW
SQL.ADD("DELETE "~DBO~".ITMMINTCORP Where FileName='"~val(nu1)~"' and FileDate="~Fstr(Num(val(da1)),0,0)~" ") 
SQL.NEW
SQL.ADD("DELETE "~DBO~".ITCONINTCORP Where FileName='"~val(nu1)~"' and FileDate="~Fstr(Num(val(da1)),0,0)~" ") 
SQL.NEW
SQL.EXEC

