*- CTRLINVEST: Control de Investment >= 0
*- Recibe: ia1: Cantidad con signo, ia2: Especie, ia3: Fecha, ia4: Vehiculo, ia5: NrOperacion, ia6: NrSaldo
*- Devuelve: ia7 Posicion con el nuevo saldo 

*- ia8: Descripcion de posiciones segun nros. de posicion
If val(ia6)=101
   ACT(ia8,'Posicion Sumarizada Contado')
EndIf
If val(ia6)=103
   ACT(ia8,'Posicion Trading Contado')
EndIf
If val(ia6)=104
   ACT(ia8,'Investment <= 6 meses Contado')
EndIf
If val(ia6)=105
   ACT(ia8,'Investment >  6 meses Contado')
EndIf
If val(ia6)=106
   ACT(ia8,'Otras Sociedades Contado')
EndIf
If val(ia6)=107
   ACT(ia8,'Posicion Trading a FechaVto')
EndIf
If val(ia6)=108
   ACT(ia8,'Investment <= 6 meses a FechaVto')
EndIf
If val(ia6)=109
   ACT(ia8,'Investment >  6 meses a FechaVto')
EndIf
If val(ia6)=110
   ACT(ia8,'Otras Sociedades a FechaVto')
EndIf


*- Recupero el Saldo Actual de Posiciones 
SQL.ADD("SELECT Sum(P1.CantidadFin) as CantidadFin ")
SQL.ADD("FROM   "~DBO~".POSICIONES P1 ")
SQL.ADD("WHERE  P1.Cliente='"~val(ia4)~"' AND ")
SQL.ADD("       P1.Especie='"~val(ia2)~"' AND P1.NrSaldo="~Fstr(val(ia6),0,0)~" AND ")
SQL.ADD("       P1.Fecha=(SELECT MAX(P2.Fecha) ")
SQL.ADD("                 FROM "~DBO~".POSICIONES P2 ")
SQL.ADD("                 WHERE P2.Cliente=P1.Cliente AND P2.Especie=P1.Especie ")
SQL.ADD("                       AND P2.NrSaldo=P1.NrSaldo AND P2.Fecha<='"~IdxDate(val(ia3))~"') ")

Recorrer SQL
   DFA
   ACN(ia7, FBN['CantidadFin'])
Proximo

SCN(ia7, val(ia1))

acn(ia10,ABS(Val(ia1)))
If val(ia7)<0
   ACN(nh1, MessageBox("ERROR!!, La Posicion "~val(ia8)~" quedaria en "~PYC(val(ia7),0,2)~" con la op.: "~Val(ia5)~", Esp.: "~Val(ia2)~", VN: "~Val(ia10),2,0))

   If Val(nh1)=1
      ACN(ia6, -1)
   Endif
EndIf
