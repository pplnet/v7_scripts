scn(c:200,1)
scn(d:200,1)
SQL.ADD("Select S.Cliente, S.EnteCustodia, S.Especie, S.CallPut, S.FechaEj, S.PrecioEj, S.Saldo/1000 Saldo, ")
SQL.ADD("E.Tipo, E.Cotiza ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("where   S.Especie = E.Codigo ")
SQL.ADD("and     S.NrSaldo = 2 ")
SQL.ADD("and    (S.CallPut is Null or S.CallPut = '') ")
SQL.ADD("and     S.Cliente = S.EnteCustodia ")
SQL.ADD("and     E.Tipo Not In ('FON') ")
SQL.ADD("and     S.EnteCustodia In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD("and     S.Especie Not In ("~VAR('ESPENOPF')~") ")
SQL.ADD("and     S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and    (D.CallPut is Null or D.CallPut = '') ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = 2 ")
SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by S.Cliente, S.Especie ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['EnteCustodia'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['EnteCustodia'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['EnteCustodia'])
  endif
  if Incluido(fbn['Tipo'],'PUB')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))

        scn(val(e:200):val(h:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
     else
        scn(val(e:200):val(d:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(k:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
     endif
  endif
  if Incluido(fbn['Tipo'],'PRI')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200)+1,fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(h:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(c:200)+1..val(e:200):val(c:200)+1,3)
       else
        scn(val(e:200):val(d:200)+1,fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(k:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(d:200)+1..val(e:200):val(d:200)+1,3)
     endif
  endif
  scn(val(e:200):val(t:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
  scn(b:val(t:200),fbn['Saldo']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
  SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
proximo

**** titulos a termino ****
scn(c:200,2)
scn(d:200,2)
scn(f:200,1)
scn(g:200,1)

SQL.ADD("Select O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto Fecha, E.Cotiza, O.Vehiculo2, ")
SQL.ADD("Sum(O.Cantidad)/1000 Monto from "~DBO~".OPERACIONES  O, "~DBO~".ESPECIES E  ")
SQL.ADD("where O.Especie = E.Codigo ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('SECT','SEVT','SECTV','SEVTV') ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~VAR('ESPENOPF')~") ")
SQL.ADD("group by O.Vehiculo1, O.Especie, O.TipoOp, O.FechaVto, E.Cotiza, O.Vehiculo2 ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif
  if Incluido(fbn['TipoOp'],'SEVT|SEVTV')
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(f:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(i:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(f:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
              scn(b:val(i:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
       else
        scn(val(e:200):val(g:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(l:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(g:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
              scn(b:val(l:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(v:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(v:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
        SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
       else
        scn(val(e:200):val(w:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(w:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
        SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
     endif
    else
     If Incluido(fbn['Cotiza'],'ARP')
        scn(val(e:200):val(c:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(h:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(c:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
              scn(b:val(h:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
       else
        scn(val(e:200):val(d:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        scn(val(e:200):val(k:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(d:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
              scn(b:val(k:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
     endif
     if fbn['Fecha'] <= (Dialogo.Fecha1+365)
        scn(val(e:200):val(t:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(t:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
        SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
       else
        scn(val(e:200):val(x:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)] o [EqStr(BuscarCampo('VEHICULOS','TipoVehiculo','Codigo',fbn['Vehiculo2']),'VIN')]
           if [Not Incluido(fbn['Vehiculo2'],Dialogo.Lista1)]
              scn(b:val(x:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
           endif
        endif
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif
proximo

