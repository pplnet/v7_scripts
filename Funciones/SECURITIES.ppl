        scn(b:val(x:200),fbn['Monto']*CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
        SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
     endif
  endif
proximo

SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, O.TipoOp, O.FechaPago Fecha, O.Vehiculo2, ")
SQL.ADD("Sum(O.TotalNetoCli1)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"' ")
