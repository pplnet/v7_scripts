SQL.ADD(" Select Sum(P.CantidadFin) CantidadFin ")
SQL.ADD(" From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.Especie = '"~Val(ES:1)~"' ")
SQL.ADD(" AND P.Book = '"~Val(BK:1)~"' ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Val(LV:4))~")  ")
ELSE
    SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~")  ")
ENDIF
SQL.ADD(" AND P.NrSaldo = 101 ")
IF Val(TP:1) = 6
    SQL.ADD(" AND P.TipoNegocio = 'FC' ")
ELSE
    SQL.ADD(" AND P.TipoNegocio = 'SEC' ")
ENDIF
*SQL.ADD(" AND P.Book Is Not Null ")
*SQL.ADD(" AND P.Book <> '' ")
SQL.ADD(" AND P.Fecha = (Select Max(Fecha) ")
SQL.ADD("               From "~DBO~".POSICIONES P2 ")
SQL.ADD("               Where P2.Especie = P.Especie ")
***+++SQL.ADD("               AND (P2.Cupon = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL) or (P.Cupon = 0 and P2.Cupon = 0)) ")
SQL.ADD("               AND (P2.Cupon = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("               AND P2.Cliente = P.Cliente ")
SQL.ADD("               AND P2.Vehiculo = P.Vehiculo ")
SQL.ADD("               AND P2.NrSaldo = P.NrSaldo ")
SQL.ADD("               AND P2.Book = P.Book ")
SQL.ADD("               AND P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("               AND P2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"')  ")
IF Eqstr(Val(ES:1), 'ACIN')
***    SQL.ADD(" Order By 1, ")
ENDIF
ACN(CE:1, 0)
Recorrer SQL
    DFA
    ACN(CE:1, fbn('CantidadFin'))
Proximo
