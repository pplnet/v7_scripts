VTXT14      : 'Sucursal Usuario' ;;;;NO;NO;;;;QUERY("Select Sucursal from "~DBO~".USRVEHICULO where Codigo = '"~USUARIOACTIVO~"' and Vehiculo = '"~VEHICULO1~"' ");QUERY("Select Sucursal from "~DBO~".USRVEHICULO where Codigo = '"~USUARIOACTIVO~"' and Vehiculo = '"~VEHICULO1~"' ");
Sucursal    : 'Sucursal'        ;1;2;2;Vacio(VTXT14);;;;;VTXT14;IF(MODI,SUCURSAL,VTXT14)
VTXT3       : 'InteresClean'    ;1;3;;NO;NO;;;;;BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE);
VCAN9       : 'EspDiasAnio'     ; ; ;;NO;NO;;;;;EspecieDiasAnio(ESPECIE);
VCAN10      : 'EspDiasMes'      ; ; ;;NO;NO;;;;;EspecieDiasMes(ESPECIE);
VPRE2       : 'cd'              ; ; ;;NO;NO;;;;;IF(VCAN9=0 y VCAN10=0,1,0);
VPRE3       : 'TasaIntVig'      ; ; ;;NO;NO;;;;;BuscarCampo('ESPECIES','TasaIntVigente','Codigo',ESPECIE);
VFEC1       : 'FechaCambioTasa' ; ; ;;NO;NO;;;;;BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',ESPECIE);
VFEC2       : 'UltCupon'        ; ; ;;NO;NO;;;;;UltCupon2(ESPECIE,FECHAVTO);
VFEC3       : 'cg'              ; ; ;;NO;NO;;;;;IF(VCAN10=0 o EsHabil(VFEC2,'USA'),VFEC2,Habiles(VFEC2,BuscarCampo('ESPECIES','Valor10','Codigo',ESPECIE),'USA'));
VPRE4       : 'ch1'             ; ; ;;NO;NO;;;;;((BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',ESPECIE)*IF(VPRE2=1,Dif360(VFEC3,VFEC1-1,2),DifDias(VFEC3,VFEC1-1,'USA',NO)))+(VPRE3*(IF(VPRE2=1,Dif360(VFEC1-1,FECHAVTO,2),DifDias(VFEC1-1,FECHAVTO,'USA',NO)))))/(IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))*100)
VPRE5       : 'ch2'             ; ; ;;NO;NO;;;;;VPRE3*100
VPRE6       : 'ch'              ; ; ;;NO;NO;;;;;IF(VFEC1>VFEC3 y VFEC1<=FECHAVTO,VPRE4,VPRE5)
VPRE7       : 'Sucio1'          ; ; ;;NO;NO;;;;;VPRE6*IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))/(DiasAnio2(ESPECIE,UltCupon2(ESPECIE,FSYS),ProxCupon2(ESPECIE,FSYS))*100)*if(Not eqstr(CotizaEn(ESPECIE),CONTRAESPECIE),COTIZACIONC(CotizaEn(ESPECIE),,,,FECHAOP-1,1,SI,CONTRAESPECIE),1);;;;;'#,###,###,###,###.########'
VPRE8       : 'Sucio2'          ; ; ;;NO;NO;;;;;IF(EqStr(VTXT3,'CLE'),(ValorTeorico2(ESPECIE,FECHAVTO)+IntsCapitalizados2(ESPECIE,FECHAVTO)),1)
VPRE15      : 'SucioCap NUEVO'  ; ; ;;NO;NO;;;;;(Query("SELECT TasaCapInt FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~ESPECIE~"' AND NrCupon= '"~CUPON1~"' ")*IF(VPRE2=1,Dif360(VFEC3,FECHAVTO,2),DifDias(VFEC3,FECHAVTO,'USA',NO))/(DiasAnio2(ESPECIE,UltCupon2(ESPECIE,FSYS),ProxCupon2(ESPECIE,FSYS))*100));;;;;'#,###,###,###,###.########'
