  message('--- '~Val(ca:&i)~' - '~Val(cd:&i))
  IF Dialogo.Radio1 = 0
     IF EqStr(Val(cc:&i),'TIV')
        IF [Val(cn:&i) = 0] o [Val(cn:&i) = 1]
           *Against Payment - Matcheo, Conf. y Settlement
           ACT(a:&i, ':23:DELAPMT//G')
        ELSE
          *Free of Payment - Matcheo, Conf. y Settlement
           ACT(a:&i, ':23:DELFREE//G')
        ENDIF
     ENDIF
     IF EqStr(Val(cc:&i),'TIFV')
        IF [Val(cm:&i)=1] o [Val(cm:&i)= 2]
           *Against Payment - Matcheo, Conf. y Settlement
           ACT(a:&i, ':23:DELAPMT//G')
        ELSE
           *Free of Payment - Matcheo, Conf. y Settlement
           ACT(a:&i, ':23:DELFREE//G')
        ENDIF
     ENDIF
  ENDIF

  IF Dialogo.Radio1 = 1
     IF EqStr(Val(cc:&i),'TIV')
        IF [Val(cn:&i)=0] o [Val(cn:&i)= 1]
           *Against Payment - Matcheo y Conf. 
           ACT(a:&i, ':23:DELAPMT/MATCH//G')
        ELSE
           *Free of Payment - Matcheo y Conf. 
           ACT(a:&i, ':23:DELFREE/MATCH//G')
        ENDIF
     ENDIF
     IF EqStr(Val(cc:&i),'TIFV')
        IF [Val(cm:&i)=1] o [Val(cm:&i)= 2]
           *Against Payment - Matcheo y Conf.
           ACT(a:&i, ':23:DELAPMT/MATCH//G')
        ELSE
           *Free of Payment - Matcheo y Conf. 
           ACT(a:&i, ':23:DELFREE/MATCH//G')
        ENDIF
     ENDIF
  ENDIF

  ACT(b:&i, ':30:'~Fecha(Val(ce:&i), 'yy/mm/dd')) 
  ACT(ag:&i, Val(cf:&i))
  ACT(c:&i, ':20:'~Val(ca:&i)~Copy(Val(ag:&i),1,4)~Val(ct:&i)) 
  ACT(e:&i, ':31P:'~Fecha(Val(bb:&i), 'yy/mm/dd'))    
  ACT(f:&i, ':26j:1')  
  ACN(x:&i, Val(ch:&i))    
  ACT(g:&i, ':35A:FMT'~FStr(Val(x:&i), 1, 0)~',')    

  ACN(ad:&i, 0)

  IF Dialogo.Check2=0
     ACT(ae:&i, Val(cr:&i))
  ELSE
     ACT(ae:&i, Val(cs:&i))
  ENDIF

  ACT(h:&i, ':35B:ISIN '~Val(ae:&i))
  ACT(i:&i, ':83R:PRIN'  ) 
  ACT(j:&i, ':83C:/'~VAR('CTAEURO')) 

  ACT(ah:&i, Val(cu:&i))
  ACT(ai:&i, Val(cv:&i))
  ACT(aj:&i, Val(cw:&i))

  IF EqStr(Val(ah:&i), 'EU')
     ACT(k:&i, ':84A:MGTCBEBEECL')     
     * --- Es un participante de EuroClear
  ELSE
     IF EqStr(Val(ah:&i), 'CE')
        ACT(k:&i, ':84A:CEDELULL')        
        * --- No es un participante de EuroClear
     ENDIF
  ENDIF

  ACN(ae:&i, 0)
  IF EqStr(Val(ah:&i), 'EU')
     ACN(ae:&i, 1)
     ACT(l:&i, ':87C:/' ~Val(ai:&i))
  ELSE
     IF EqStr(Val(ah:&i), 'CE')
        ACN(ae:&i, 1)
        ACT(l:&i, ':87C://XC' ~Val(ai:&i))
     ENDIF
  ENDIF

  ACT(m:&i, ':88C://'~Val(aj:&i))
  ACN(y:&i, Val(ck:&i))    
  ACT(n:&i, ':32M:'~Val(cq:&i)~Reemplazar(FStr(Val(y:&i),1,2), '.' , ','))

  ACN(z:&i, Val(cl:&i))    
  IF Val(z:&i) <> 0
     ACT(o:&i, ':32B:'~Val(cq:&i)~Reemplazar(FStr(Val(z:&i),1,2), '.' , ','))    
  ELSE
     ACT(o:&i, ':32B:'~Val(cq:&i) ~ Reemplazar(FStr(Val(y:&i),1,2), '.' , ','))    
  ENDIF

*** Grabar archivos ASCII *** 

  If Vacio(Val(ae:&i)) 
     AbrirASCII(Dialogo.String3,0)
     EscribirASCII('Error en la Generacion del Mensaje MT580')    
     EscribirASCII('Nro. de Operacion:     '~Val(c:&i))
     EscribirASCII('Fecha de Concertacion: '~Val(e:&i))
     EscribirASCII('Fecha de Liquidacion:  '~Val(b:&i))
     IF Val(ae:&i) = 0
        EscribirASCII('Falta Codigo de Especie EU para la especie '~Val(cg:&i))
        Messagebox('Falta ISIN para la especie '~Val(cg:&i)~' NrOperacion'~Val(ca:&i))
     ENDIF
     EscribirASCII('----------------------------------------')
     CerrarASCII
  ELSE
     If VAL(cy:&i)=1
        AbrirASCII(Dialogo.String1,0)
     Else
       AbrirASCII(Dialogo.String2,0)
     Endif
     EscribirASCII('580')
     EscribirASCII(Val(a:&i))
     EscribirASCII(Val(b:&i))
     EscribirASCII(Val(c:&i))
     EscribirASCII(Val(e:&i))
     EscribirASCII(Val(f:&i))
     EscribirASCII(Val(g:&i))
     EscribirASCII(Val(h:&i))
     EscribirASCII(Val(i:&i))
     EscribirASCII(Val(j:&i))
     EscribirASCII(Val(k:&i))
     EscribirASCII(Val(l:&i))
     EscribirASCII(Val(m:&i))
     EscribirASCII(Val(n:&i))
     EscribirASCII(Val(o:&i))
     EscribirASCII('-')
     CerrarASCII

     message('Actualizando estado de vocuher '~Val(cd:&i))
     ACT(ak:&i, Val(ca:&i)~Copy(Val(ag:&i),1,4)~Val(ct:&i))
     SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 SET ")
     SQL.ADD(" CB4  = '1', Fecha4 = '"~IdxDate(FSYS)~"',  Ley4 = '"~Val(ak:&i)~"' ")
     SQL.ADD(" WHERE  NrTrans = '"~Val(cd:&i)~"' ")
     SQL.NEW
  Endif