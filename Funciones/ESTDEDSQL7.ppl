If [Not Eqstr(Val(aa:2), FBN['Vehiculo1']) y Not Incluido(fbn['Vehiculo1'],VAL(ve:2))])
  SCN(ve:1,1)
  ACT(ve:2,VAL(ve:2)~fbn['Vehiculo1']~'|')
Endif

*--->Guarda la primera operacion
If Val(zz1) = 0 y NoVacio(FBN['Vehiculo1'])
   (.'ESTDEDCOL'.)
   ifa
   ACT(aa1, FBN['NrOperacion'])
   ACT(aa2, FBN['Vehiculo1'])
   If Not Incluido(fbn('TipoOp'),'MMCAUP|SERP|SERPV')
     ACT(aa3, FBN['Especie'])
   Else
     ACT(aa:3,fbn('ContraEspecie'))
     ACT(es:2, FBN['ContraEspecie'])
   Endif
   ACT(es:1, FBN['Especie'])
   ACT(aa:5,fbn['TipoOp'])
   ACT(a:fac,'Moneda:  '~Val(aa3)~'')
   ACN(jj1, 0)
   AgregarMarco(a:fac..v:fac,0,0)
   SetFont(a:fac..b:fac, 2)
   ACN(zz1, 1)
   ifa
EndIf

If Not EqStr(Val(aa1), FBN['NrOperacion'])
   ACT(aa4, FBN['TipoOp'])
   *--->Busca si la operacion tiene comisiones
   (.'ESTDEDSQLC'.)

   If Eqstr(fbn('TipoOp'),'MMCAUP')
     ACN(bb:3, fbn('ImpComCor1')+fbn('ImpComMer1'))
   Endif

   *--->Imprime el total por operacion
   ACT(a:fac, 'Total '~Val(aa1))
   ACN(J:fac, Val(bb1))
   ACN(K:fac, Val(bb2))
   ACN(L:fac, Val(bb:3))
   ACN(M:fac, Val(bb4))
   ACN(N:fac, Val(bb5))
   ACN(O:fac, Val(bb11))
   ACN(P:fac, Val(bb6))
   *--->Imprime total de Devengados
   ACN(S:fac, Val(bb7))
   ACN(T:fac, Val(bb8))
   ACN(U:fac, Val(bb9))
   ACN(V:fac, Val(bb10))
   
   AgregarMarco(a:fac..v:fac,0,0, Exe('COLOR6'))
   SetFont(a:fac..v:fac, 2)
   
   *--->Acumula los totales por vehiculo y especie
   ACN(cc1, Val(cc1) + Val(bb1))
   ACN(cc2, Val(cc2) + Val(bb2))
   ACN(cc3, Val(cc3) + Val(bb3))
   ACN(cc4, Val(cc4) + Val(bb4))
   ACN(cc5, Val(cc5) + Val(bb5))
   ACN(cc6, Val(cc6) + Val(bb6))
   ACN(cc7, Val(cc7) + Val(bb7))
   ACN(cc8, Val(cc8) + Val(bb8))
   ACN(cc9, Val(cc9) + Val(bb9))
   ACN(cc10, Val(cc10) + Val(bb10))
   ACN(cc11, Val(cc11) + Val(bb11))

   ACN(bb1, 0)
   ACN(bb2, 0)
   ACN(bb3, 0)
   ACN(bb4, 0)
   ACN(bb5, 0)
   ACN(bb6, 0)
   ACN(bb7, 0)
   ACN(bb8, 0)
   ACN(bb9, 0)
   ACN(bb10, 0)
   ACN(bb11, 0)
   ifa
   ACN(jj1, 0)
   SCN(jj1, FBN['Plaz'])
Else
   SCN(jj1, FBN['Plaz'])
EndIf

Acn(co:99,CotizacionC(FBN['Especie'],,,,Fsys,1,SI,'USD'))  

If Not Eqstr(Val(aa2), FBN['Vehiculo1']) o [Not Eqstr(Val(aa3), FBN['Especie']) y Not Incluido(fbn['TipoOp'], 'MMCAUP|SERP|SERPV')] o [Incluido(fbn['TipoOp'], 'MMCAUP|SERP|SERPV') y Not EqStr(Val(aa:3),fbn['ContraEspecie'])]

   ACT(a:fac, 'Total '~Val(aa2)~' en '~Val(aa3)~'')

   *--->Imprime Total Amort. Capital
   ACN(J:fac, Val(cc1))
   *--->Imprime Intereses a Pagar
   ACN(K:fac, Val(cc2))
   *--->Imprime Total Comision
   ACN(L:fac, Val(cc3))
   *--->Imprime Total IVA
   ACN(M:fac, Val(cc4))
   *--->Imprime Total WHT
   ACN(N:fac, Val(cc5))
   *--->Imprime Impuesto a los Sellos
   ACN(O:fac, Val(cc11))
   *--->Imprime Total a Pagar
   ACN(P:fac, Val(cc6))
   *--->Muestra Total Devengados
   ACN(S:fac, Val(cc7))
   ACN(T:fac, Val(cc8))
   ACN(U:fac, Val(cc9))
   ACN(V:fac, Val(cc10))
   
   SetFont(a:fac..v:fac, 2)
   AgregarMarco(a:fac..v:fac,2,0,Exe('COLOR11'))

   *--->Acumula los totales a pagar por moneda
*   Recorrer&j 1, Val(mo1)
*      If EqStr(Val(aa3), Val(mm:&j))
*         ***ACN(mn:&j, Val(mn:&j) + Val(cc6))
*         ACN(mn:&j, Val(mn:&j) + Val(cc1)+ Val(cc7))
*      EndIf
*   Proximo


   ***+++>Acumula la suma de Amort Capital y Intereses Dev para el cuadro de totales por moneda del final del informe
   If Val(mo1) = 0
       ACT(mm1, Val(aa3))
       ACN(mp1,CotizacionC(Val(me1),,,,Dialogo.Fecha1-1,1,SI,Val(aa3)))
       If DesciendeDeEspecie(fbn('Especie'),'MONEDA')
         ACN(mn:1, Val(cc1)+ Val(cc7) + Val(cc9))
       Else
         If Incluido(fbn('TipoOp'),'SERP|SERPV')
           ACN(mn:1, Val(cc:7))
         Endif
         If Incluido(fbn('TipoOp'),'MMCAUP')
           ACN(mn:1, Val(cc:1)+Val(cc:7))
         Endif
       Endif
       ACN(mo1, 1)
   Else
       Recorrer&j 1, Val(mo1)
          If EqStr(Val(aa3), Val(mm:&j))
             If DesciendeDeEspecie(fbn('Especie'),'MONEDA')
               ACN(mn:&j, Val(mn:&j) + Val(cc1)+ Val(cc7) )
             Else
               If Incluido(fbn('TipoOp'),'SERP|SERPV')
                 ACN(mn:&j, Val(mn:&j) + Val(cc:7))
               Endif
               If Incluido(fbn('TipoOp'),'MMCAUP')
                 ACN(mn:&j,Val(mn:&j) + Val(cc:1) + Val(cc:7))
               Endif
             Endif
             Break
          Endif
          If Val(mo1) = &j
             ACT(mm:&j+1, Val(aa3))
             ACN(mp:&j+1,CotizacionC(Val(me1),,,,Dialogo.Fecha1-1,1,SI,Val(aa3)))
             If DesciendeDeEspecie(fbn('Especie'),'MONEDA')
               ACN(mn:&j+1, Val(cc1) + Val(cc7) )
             Else
               If Incluido(fbn('TipoOp'),'SERP|SERPV')
                 ACN(mn:&j+1, Val(cc:7))
               Endif
               If Incluido(fbn('TipoOp'),'MMCAUP')
                 ACN(mn:&j+1, Val(cc:1) + Val(cc:7))
               Endif
             Endif
             SCN(mo1, 1)
          Endif
       Proximo
   Endif


   ACN(cc1, 0)
   ACN(cc2, 0)
   ACN(cc3, 0)
   ACN(cc4, 0)
   ACN(cc5, 0)
   ACN(cc6, 0)
   ACN(cc7, 0)
   ACN(cc8, 0)
   ACN(cc9, 0)
   ACN(cc10, 0)
   ACN(cc11, 0)

   ifa
   ifa
   If Not Incluido(fbn('TipoOp'),'MMCAUP|SERP|SERPV')
     ACT(a:fac, 'Moneda:  '~FBN['Especie']~'')
   Else
     ACT(a:fac, 'Moneda:  '~FBN['ContraEspecie']~'')
   Endif
   AgregarMarco(a:fac..v:fac,0,0)
   SetFont(a:fac..b:fac, 2)
   ifa

   ACT(aa:2, FBN['Vehiculo1'])
   If Not Incluido(fbn('TipoOp'),'MMCAUP|SERP|SERPV')
     ACT(aa:3, FBN['Especie'])
   Else
     ACT(aa:3,fbn('ContraEspecie'))
     ACT(es:2, FBN['ContraEspecie'])
   Endif
   ACT(es:1, FBN['Especie'])
EndIf

*--->Para una misma operacion no se muestran todos los datos 
If EqStr(Val(aa1), FBN['NrOperacion']) Y Val(zz1) = 2
   ACD(e:fac, FBN['FechaIni'])
   ACN(f:fac, FBN['Plaz'])
   ACD(g:fac, FBN['FechaFin'])
   ACN(J:fac, FBN['CapAmort'])
   *** Cuando el SWAP es por Flujo de fondos se muestra el Interes 
   ACN(K:fac, FBN['Intereses'])
   *** Cuando el SWAP es por compensacion se muestra el Resultado 
   If FBN['RB6'] = 0  y  FBN['Num'] = 7
      ACN(K:fac, FBN['Resultado'])
   EndIf
   If Vacio(Val(bb3)) O Val(bb3) = 0 y Not Eqstr(fbn('TipoOp'),'MMCAUP')
      ACN(L:fac, 0)
   Else
     ACN(L:fac, fbn('ImpComCor1')+fbn('ImpComMer1'))
   EndIf
   ACN(M:fac, FBN['IVA'])
   ACN(N:fac, FBN['WHT'])
   ACN(o:fac, FBN['Sellos'])

   If FBN['Num'] = 7
      ACN(P:fac, Val(K:fac) + FBN['IVA'] + FBN['Sellos'] )
   Else
      If FBN['Num'] = 10
        ACN(P:fac, FBN['TotPagar'])
      Else
        ACN(P:fac, FBN['TotPagar'] + FBN['IVA'] + FBN['Sellos'])
      Endif
   Endif

   ACN(Q:fac, FBN['TNA'])  

   *--->Formula para la TEA
   ACN(ff1, ( (1+ (FBN['TNA']/100+ (FBN['TNA']/100*FBN['TasaWHT'] /100) ) *FBN['Plaz'] /360 ) ^ (360  /FBN['Plaz'])-1) *100 )
   ACN(ff2, ( (1+ (FBN['TNA']/100+ (FBN['TNA']/100*FBN['TasaWHT'] /100) ) *FBN['Plaz'] /365 ) ^ (365  /FBN['Plaz'])-1) *100 )

   If FBN['RB8'] = 1
      ACN(R:fac, Val(ff1)) 
   Else
      ACN(R:fac, Val(ff2))
   EndIf
   
   *--->Interes a Devengar de las cuotas restantes = Interes a Pagar
   ACN(T:fac, Val(K:fac))
   *--->Interes a Devengar de las cuotas restantes = WHT + SELLOS
   ACN(v:fac, Val(O:fac) + Val(N:fac))

   *--->Acumula Int. a Dev
   ACN(bb8, Val(bb8) + Val(T:fac))
   ACN(bb10, Val(bb10) + Val(v:fac))
Else   
   ACT(a:fac, FBN['NrOperacion'])
   ACLO(a:fac, FBN['NrOperacion'])

   ACT(b:fac, BuscarCampo('OPERACIONES', 'Vehiculo1', 'NrOperacion', FBN['NrOperacion']))
   ACT(c:fac, FBN['Cliente1'])
   If Not Incluido (fbn('TipoOp'),'MMCAUP|SERP|SERPV')
      ACT(d:fac, FBN['Especie'])
   Else
      ACT(d:fac,fbn['ContraEspecie']~'/'~fbn['Especie'])
   Endif
   ACD(e:fac, FBN['FechaIni'])
   ACN(f:fac, FBN['Plaz'])
   ACD(g:fac, FBN['FechaFin'])
   ACN(I:fac, FBN['CapOrig'])
   ACN(J:fac, FBN['CapAmort'])
   *** Cuando el SWAP es por Flujo de fondos se muestra el Interes 
   ACN(K:fac, FBN['Intereses'])
   *** Cuando el SWAP es por compensacion se muestra el Resultado 
   If FBN['RB6'] = 0  y  FBN['Num'] = 7
      ACN(K:fac, FBN['Resultado'])
   EndIf
   If Vacio (Val(bb3)) O Val(bb3) = 0 y Not Eqstr(fbn('TipoOp'),'MMCAUP')
      ACN(L:fac, 0)
   Else
      ACN(L:fac, fbn('ImpComCor1')+fbn('ImpComMer1'))
   EndIf
   ACN(M:fac, FBN['IVA'])
   ACN(N:fac, FBN['WHT'])
   ACN(O:fac, FBN['Sellos'])

   If FBN['Num'] = 7
      *-Si es SWAP, suma el Total Interes mas IVA
      ACN(P:fac, Val(K:fac) + FBN['IVA'] + FBN['Sellos'] )
   Else
      If FBN['Num'] = 10
        ACN(P:Fac,FBN['TotPagar'])
      Else
        ACN(P:fac, FBN['TotPagar'] + FBN['IVA'] + FBN['Sellos'] )
      Endif
   Endif

   ACN(Q:fac, FBN['TNA'])  

   *--->Formula para la TEA
   ACN(ff1, ( (1+ (FBN['TNA']/100+ (FBN['TNA']/100*FBN['TasaWHT'] /100) ) *FBN['Plaz'] /360 ) ^ (360  /FBN['Plaz'])-1) *100 )
   ACN(ff2, ( (1+ (FBN['TNA']/100+ (FBN['TNA']/100*FBN['TasaWHT'] /100) ) *FBN['Plaz'] /365 ) ^ (365  /FBN['Plaz'])-1) *100 )
   
   If FBN['RB8'] = 1
      ACN(R:fac, Val(ff1))  
   Else
      ACN(R:fac, Val(ff2))
   EndIf

   *--->Calculo de Devengados
   (.'ESTDEDDEV'.)
   

   ACN(zz1, 2)
EndIf

ACN(H:fac, Val(G:FAC) - Dialogo.Fecha1)
FormatoCeldas(H:fac..H:fac,"0")
SetFont(H:fac..H:fac, 1)

***Se totaliza por vehiculo y especie para el resumen final***

*Para ver suma de plazos:
*ACN(a:fac,val(jj1))

ACN(ve:3,BuscarLista(fbn['Vehiculo1'],VAL(ve:2)))

*/ARP
if Eqstr(fbn('Especie'),VAR('MONELOCA')) o [Eqstr(fbn('ContraEspecie'),VAR('MONELOCA')) y Incluido(Val(aa:5),'SERP|SERPV|MMCAUP')]
  */Plazo Promedio Ponderado
  scn(pl:Val(ve:3), Val(jj1)*Val(Q:fac)*Val(J:fac))
  */Denominador Plazo Promedio
  SCN(lp:Val(ve:3),Val(jj1)*Val(J:fac))
  */Plazo Remanente
  SCN(za:Val(ve:3), Val(H:fac)*Val(Q:fac)*Val(J:fac))
  */Denominador Plazo Remanente
  SCN(zb:Val(ve:3), Val(H:fac)*Val(J:fac))
  */Numerador Tasa Promedio(TTP)
  scn(nl:Val(ve:3), Val(Q:fac)*Val(P:fac)*(fbn['FechaFin']-FSYS))
  */Denominador Tasa Promedio(TTP)
  scn(dl:Val(ve:3), Val(P:fac)*(fbn['FechaFin']-FSYS))
ENDiF

*/USD
if Eqstr(fbn('Especie'),VAR('MONEEXTR')) o [Eqstr(fbn('ContraEspecie'),VAR('MONEEXTR')) y Incluido(Val(aa:5),'SERP|SERPV|MMCAUP')]
  scn(pe:Val(ve:3),Val(jj1)*Val(Q:fac)*Val(J:fac))
  */Denominador Plazo Promedio
  SCN(ep:Val(ve:3),Val(jj1)*Val(J:fac))
  */Numerador Plazo Remanente
  scn(zc:Val(ve:3),Val(H:fac)*Val(Q:fac)*Val(J:fac))
  */Denominador Plazo Remanente
  SCN(zd:Val(ve:3),Val(H:fac)*Val(J:fac))
  */Numerador Tasa Promedio(TTP)
  scn(ne:Val(ve:3), Val(Q:fac)*Val(P:fac)*(fbn['FechaFin']-FSYS))
  */Denominador Tasa Promedio(TTP)
  scn(de:Val(ve:3), Val(P:fac)*(fbn['FechaFin']-FSYS))
ENDiF

*/OTRAS ESPECIES
if Not Eqstr(fbn('Especie'), VAR('MONELOCA')) y Not Eqstr(fbn('Especie'),VAR('MONEEXTR')) y [Not Eqstr(fbn('ContraEspecie'),VAR('MONELOCA')) y Not Eqstr(fbn('ContraEspecie'),VAR('MONEEXTR')) y Incluido(Val(aa:5),'SERP|SERPV|MMCAUP')] 
  */Plazo Promedio Ponderado
  scn(on:Val(ve:3), Val(jj1)*Val(Q:fac)*Val(J:fac))
  */Denominador Plazo Promedio
  SCN(dp:Val(ve:3),Val(jj1)*Val(J:fac))
  */Plazo Remanente
  scn(ze:Val(ve:3), Val(H:fac)*Val(Q:fac)*Val(J:fac))
  */Denominador Plazo Remanente
  SCN(zf:Val(ve:3),Val(H:fac)*Val(J:fac))
  */Tasa Promedio
  */Numerador Tasa Promedio(TTP)
  scn(to:Val(ve:3), Val(Q:fac)*val(co:99)*Val(P:fac)*(fbn['FechaFin']-FSYS))
  */Denominador Tasa Promedio(TTP)
  scn(do:Val(ve:3), Val(P:fac)*val(co:99)*(fbn['FechaFin']-FSYS))
ENDiF


*/Total
*/Plazo Promedio Ponderado Total
SCN(tn:Val(ve:3), Val(jj1)*Val(Q:fac)*Val(J:fac))
*/Denominador Plazo Promedio
SCN(tt:Val(ve:3),Val(jj1)*Val(J:fac))

*/Plazo Remanente
SCN(zu:Val(ve:3), Val(H:fac)*Val(Q:fac)*Val(J:fac))
*/Denominador Plazo Remanente
SCN(zn:Val(ve:3),Val(H:fac)*Val(J:fac))

*/Tasa Promedio Total
*/Numerador Tasa Promedio(TTP)
SCN(nt:Val(ve:3), Val(Q:fac)*val(co:99)*Val(P:fac)*(fbn['FechaFin']-FSYS))
*/Denominador Tasa Promedio(TTP)
SCN(dt:Val(ve:3), Val(P:fac)*val(co:99)*(fbn['FechaFin']-FSYS))
*/------------------------------------------------------------------------------*/
*/Plazo Remanente para ARP y USD: Suma(Plazo remanente * Monto)/Suma de Monto
*/Plazo Remanente para OTRO y TOTALES: Suma(Monto * TC * Plazo)/Suma(Monto * TC)

*/Tasa Promedio para ARP y USD: Suma(Tasa * Monto * Plazo)/Suma de Monto
*/Tasa Promedio para OTRO y TOTALES: Suma(Monto * TC * Tasa * Plazo)/Suma(Monto * TC)
*/------------------------------------------------------------------------------*/


*--->Acumula los datos de la operacion
ACN(bb1, Val(bb1) + FBN['CapAmort'])
If FBN['RB6'] = 0  y  FBN['Num'] = 7
   *** Cuando el SWAP es por compensacion se muestra el Resultado 
   ACN(bb2, Val(bb2) + FBN['Resultado'])
Else
   *** Cuando el SWAP es por Flujo de fondos se muestra el Interes
   ACN(bb2, Val(bb2) + FBN['Intereses'])
Endif
If EqStr(fbn('TipoOp'),'MMCAUP')
  ACN(bb:3,Val(bb:3)+fbn('ImpComCor1')+fbn('ImpComMer1'))
Endif
ACN(bb4, Val(bb4) + FBN['IVA'])
ACN(bb5, Val(bb5) + FBN['WHT'])
ACN(bb11, Val(bb11) + FBN['Sellos'])
If FBN['Num'] = 7
   ACN(bb6, Val(bb6) + Val(K:fac) + FBN['IVA']  + FBN['Sellos'])
Else
   If FBN['Num'] = 10
     ACN(bb6,Val(bb6)+FBN['TotPagar'])
   Else
     ACN(bb6, Val(bb6) + FBN['TotPagar'] + FBN['IVA']  + FBN['Sellos'])
   Endif
Endif
ACT(aa1, FBN['NrOperacion'])
SetFont(a:fac..v:fac,1)