Message('----- Mensaje de Ordenes Fin de Dia')

ACN(g3,5)
ACT(b1, 'Mercado')
ACT(c1, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b2, 'Agente')
ACT(c2, Copy(Val(a:FAC),Val(g3),3))
SCN(g3,3)
ACT(b3, 'OpSIOPEL')
ACT(c3, Copy(Val(a:FAC),Val(g3),2))
SCN(g3,2)
ACT(b4, 'Fecha')
ACT(c4, Copy(Val(a:FAC),Val(g3)+4,2)~'/'~Copy(Val(a:FAC),Val(g3)+2,2)~'/'~Copy(Val(a:FAC),Val(g3),2))
SCN(g3,6)
ACT(b5, 'Hora') 
ACT(c5, Copy(Val(a:FAC),Val(g3),2)~':'~Copy(Val(a:FAC),Val(g3)+2,2)~':'~Copy(Val(a:FAC),Val(g3)+4,2))
SCN(g3,6)
ACT(b6, 'FechaCarga')
ACT(c6, '' )
ACT(b7, 'Secuencia')
ACT(c7, Copy(Val(a:FAC),Val(g3),5))
SCN(g3,9)
ACT(b8, 'FechaOp')
ACT(c8, Copy(Val(a:FAC),Val(g3)+6,2)~'/'~Copy(Val(a:FAC),Val(g3)+4,2)~'/'~Copy(Val(a:FAC),Val(g3),4))
SCN(g3,8)
ACT(b9, 'HoraOp')
ACT(c9, Copy(Val(a:FAC),Val(g3),2)~':'~Copy(Val(a:FAC),Val(g3)+2,2)~':'~Copy(Val(a:FAC),Val(g3)+4,2))
SCN(g3,6)
ACT(b10, 'SecuenciaOp')
ACT(c10, Copy(Val(a:FAC),Val(g3),7))
SCN(g3,7)
ACT(b11, 'TipoOpEv')
ACT(c11, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b12, 'TipoMov')
ACT(c12, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b13, 'FechaOr')
ACT(c13, Copy(Val(a:FAC),Val(g3)+4,2)~'/'~Copy(Val(a:FAC),Val(g3)+2,2)~'/'~Copy(Val(a:FAC),Val(g3),2))
ACT(d13, Copy(Val(a:FAC),Val(g3),2)~'/'~Copy(Val(a:FAC),Val(g3)+2,2)~'/'~Copy(Val(a:FAC),Val(g3)+4,2))
SCN(g3,6)
ACT(b14, 'HoraOr')
ACT(c14, Copy(Val(a:FAC),Val(g3),2)~':'~Copy(Val(a:FAC),Val(g3)+2,2)~':'~Copy(Val(a:FAC),Val(g3)+4,2))
SCN(g3,6)
ACT(b15, 'SecuenciaOr')
ACT(c15, Copy(Val(a:FAC),Val(g3),5))
SCN(g3,5)
ACT(b16, 'FechaHo')
ACT(c16, Copy(Val(a:FAC),Val(g3)+4,2)~'/'~Copy(Val(a:FAC),Val(g3)+2,2)~'/'~Copy(Val(a:FAC),Val(g3),2))
SCN(g3,6)
ACT(b17, 'HoraHo')
ACT(c17, Copy(Val(a:FAC),Val(g3),2)~':'~Copy(Val(a:FAC),Val(g3)+2,2)~':'~Copy(Val(a:FAC),Val(g3)+4,2))
SCN(g3,6)
ACT(b18, 'SecuenciaHo')
ACT(c18, Copy(Val(a:FAC),Val(g3),5))
SCN(g3,5)
if Vacio(val(c18))
   ACT(c16, val(c4))
   ACT(c17, val(c5))
   ACT(c18, val(c7))
endif
ACT(b19, 'TipoOpOr')
ACT(c19, Copy(Val(a:FAC),Val(g3),1))
if EqStr(val(c19),'V')
*Se elimina No existe el tipo de Operacion   ACT(d19,'OTIV') 
   ** Tipos de Operacion
   ACT(d19,'TIV') 
   ACT(e19,'TIFV') 
  ** Tipo de Orden
   ACT(f19,'OTIV')   
Else
* Idem Anterior   ACT(d19,'OTIC') 
   ** Tipos de Operacion
   ACT(d19,'TIC')    
   ACT(e19,'TIFC')
  ** Tipo de Orden 
   ACT(f19,'OTIC')
Endif
SCN(g3,1)
ACT(b20, 'Especie')
ACT(d20, Copy(Val(a:FAC),Val(g3)+1,5))
ACT(c20, SQL("Select Codigo From "~DBO~".ESPECIES Where CodMAEContado = '"~Val(d20)~"' "))
   if Vacio(Val(c20))
      **   Error
      ACT(c20,Val(d20))
   endif
if EqStr(Copy(Val(a:FAC),Val(g3),1),'1')
   *  Titulos
    ***** Nro Cupon
    ACT(c35, Fstr(BuscarCampo('ESPECIES','Cupon','Codigo',Val(c20)),1,0))
Endif
ACT(e20, 'DatosEspecie')
ACT(f20, Copy(Val(a:FAC),Val(g3)+6,8))
SCN(g3,15)
ACT(b21, 'Plazo')
ACT(c21, Copy(Val(a:FAC),Val(g3),3))
SCN(g3,3)
ACT(b22, 'Cantidad')
ACT(c22, Copy(Val(a:FAC),Val(g3),18))
SCN(g3,18)
ACT(b23, 'Precio')
ACT(c23, Copy(Val(a:FAC),Val(g3),18))
SCN(g3,18)
ACT(b24, 'TipoMod')
ACT(c24, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b25, 'Comitente')
ACT(c25, Copy(Val(a:FAC),Val(g3),18))
SCN(g3,18)
ACT(b26, 'TipoModDe')
ACT(c26, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b27, 'ComitenteDe')
ACT(c27, Copy(Val(a:FAC),Val(g3),18))
SCN(g3,18)
ACT(b28, 'NroOrdenMe')
ACT(c28, Copy(Val(a:FAC),Val(g3),32))
SCN(g3,32)
ACT(b29, 'TipoOrd')
ACT(c29, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b30, 'NrOrdHo')
ACT(c30, Copy(Val(a:FAC),Val(g3),13))
SCN(g3,13)
ACT(b31, 'MercadoMeOr')
ACT(c31, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b32, 'MercadoMeDe')
ACT(c32, Copy(Val(a:FAC),Val(g3),1))
SCN(g3,1)
ACT(b33, 'NrOferta')
ACT(c33, Copy(Val(a:FAC),Val(g3),17))
SCN(g3,17)
ACT(b34, 'UsrInput')
ACT(c34, UsuarioActivo )
ACT(b35, 'Cupon')
ACT(b36, 'NrOperacion')

if Eqstr(Val(c11),'O')
   SQL.ADD(" Select NrOperacion,TipoOp,Cliente1 From "~DBO~".OPERACIONES Where NrOrden1 = (Select NrOrden From "~DBO~".ORDENES Where NroAltaMAE = '"~Val(c18)~"' and FechaOrden = '"~IdxDate(Fecha(Val(c13)))~"') ")
Else
   SQL.ADD("Select NrOperacion,TipoOp,Cliente1 From "~DBO~".OPERACIONES Where NroAltaMAE = '"~Val(c18)~"' and FechaOP = '"~IdxDate(Fecha(Val(c13)))~"' ")
Endif
watch(SQL.Batch)
Recorrer SQL
  dfa
  ACT(c36,FBN['NrOperacion'])
  ACT(c40,iif(incluido(FBN['TipoOp'],'TIC|TIV'),'NOK','NO'))
  ACT(c41,SQL("SELECT 'NOK' FROM "~DBO~".CLIENTES where Codigo = '"~FBN['Cliente1']~"'and (Jerarquia like '"~VAR('JERCLIENTE')~"%' or Jerarquia like '"~VAR('JERVINCULA')~"%') "))
Proximo  

#ifdef MLASA
    If Eqstr(val(c40),'NOK') y Eqstr(val(c41),'NOK')
       ACT(c45,'NO')
    else
       ACT(c45,'SI')
    endif
#else
    ACT(c45,'SI')
#endif

if EqStr(Val(c45),'SI') 

ACT(B48, Val(d13)~' '~Val(c14))
ACT(B49, SQLFechaStr(Val(B48),Exe('FORFECHOR')))

ACN(lo:1, SQL("SELECT 1 FROM "~DBO~".LIBORDENES  WHERE NrOperacionRef='"~Val(c36)~"'  "))  

if Val(lo:1) <> 1
   SQL.ADD(" Insert into "~DBO~".LIBORDENES ( ")
   SQL.ADD(" Mercado,Agente,OpSIOPEL,Fecha,Hora, ")
   SQL.ADD(" FechaCarga,Secuencia, ")
   SQL.ADD(" FechaOp,HoraOp,SecuenciaOp, ")
   SQL.ADD(" TipoOpEv,TipoMov,")
   SQL.ADD(" FechaOr,HoraOr,SecuenciaOr, ")
   SQL.ADD(" FechaHo,HoraHo,SecuenciaHo, ")
   SQL.ADD(" TipoOpOr,Especie,Plazo, ")
   SQL.ADD(" Cantidad,Precio,TipoMod,Comitente, ")
   SQL.ADD(" TipoModDe,ComitenteDe,NroOrdenMe, ")
   SQL.ADD(" TipoOrd,NrOrdHo,MercadoMeOr,MercadoMeDe, ")
   SQL.ADD(" NrOferta,NrOperacionRef,UsrInput,Cupon,DatosEspecie ")
   SQL.ADD(" ) Values ( ")
   **      Mercado
   SQL.ADD(" '"~Val(c1)~"', "~Fstr(num(Val(c2)),0,0)~", '"~Val(c3)~"', '"~IdxDate(fecha(Val(c4)))~"', '"~Val(c5)~"', ")
   **      FechaCarga
   SQL.ADD(" "~SQLAhora~", '"~Val(c7)~"', ")
   **      FechaOp
   SQL.ADD("  '"~IdxDate(Fecha(Val(c8)))~"', '"~Val(c9)~"', '"~Val(c10)~"', ")
   **      TipoEv
   SQL.ADD(" '"~Val(c11)~"', '"~Val(c12)~"', ")
   **      FechaOr
   SQL.ADD(" '"~IdxDate(Fecha(Val(c13)))~"', '"~Val(c14)~"', '"~Val(c15)~"', ")
   **      FechaHo
   SQL.ADD(" '"~IdxDate(fecha(Val(c16)))~"', '"~Val(c17)~"', '"~Val(c18)~"', ")
   **      TipoOpOr
   SQL.ADD(" '"~Val(c19)~"', '"~Val(c20)~"', "~Fstr(Val(c21),0,0)~", ")
   **      Cantidad
   SQL.ADD(" "~FsTr(num(Val(c22))/10000,0,4)~", "~Fstr(Num(Val(c23))/100000000,0,8)~", '"~Val(c24)~"', '"~Val(c25)~"',")
   **      TipoModDe
   SQL.ADD(" '"~Val(c26)~"', '"~Val(c27)~"', '"~Val(c28)~"', ")
   **      TipoOrd 
   SQL.ADD("  '"~Val(c29)~"', "~Fstr(Val(c30),0,0)~",'"~Val(c31)~"','"~Val(c32)~"', ")
   **      NrOferta
   SQL.ADD(" '"~Val(c33)~"', '"~Val(c36)~"', '"~Val(c34)~"','"~Val(c35)~"','"~Val(f20)~"' ")
   SQL.ADD(" ) ")
   SQL.NEW
Else
   SQL.ADD("Update ")
   SQL.ADD(" "~DBO~".LIBORDENES SET         ")
   SQL.ADD("Agente="~Fstr(num(Val(c2)),0,0)~",OpSIOPEL='"~Val(c3)~"',Fecha='"~IdxDate(fecha(Val(c4)))~"',Hora='"~Val(c5)~"',  ")
   SQL.ADD("FechaCarga="~SQLAhora~",Secuencia='"~Val(c7)~"',FechaOp='"~IdxDate(Fecha(Val(c8)))~"',HoraOp='"~Val(c9)~"',SecuenciaOp='"~Val(c10)~"', ")
   SQL.ADD("TipoOpEv='"~Val(c11)~"',TipoMov='"~Val(c12)~"',FechaOr='"~IdxDate(Fecha(Val(c13)))~"',HoraOr='"~Val(c14)~"',SecuenciaOr='"~Val(c15)~"', ")
   SQL.ADD("TipoOpOr='"~Val(c19)~"',Especie='"~Val(c20)~"',Plazo="~Fstr(Val(c21),0,0)~",Cantidad="~FsTr(num(Val(c22))/10000,0,4)~",Precio="~Fstr(Num(Val(c23))/100000000,0,8)~", ")
   SQL.ADD("TipoMod='"~Val(c24)~"',Comitente='"~Val(c25)~"',TipoModDe='"~Val(c26)~"',ComitenteDe='"~Val(c27)~"',NroOrdenMe='"~Val(c28)~"',TipoOrd='"~Val(c29)~"', ")
   SQL.ADD("NrOrdHo="~Fstr(Val(c30),0,0)~",MercadoMeOr='"~Val(c31)~"',MercadoMeDe='"~Val(c32)~"',NrOferta='"~Val(c33)~"', ")
   SQL.ADD("UsrInput='"~Val(c34)~"',Cupon='"~Val(c35)~"',DatosEspecie='"~Val(f20)~"' ")
   SQL.ADD("where NrOperacionRef = '"~Val(c36)~"' ")
   SQL.NEW
Endif
SQL.EXEC

Endif

** Graba Flag de Ordenes Recibidas
ACN(x1, SQL("Select Count(*) from "~DBO~".FLAGSMERCADO where Mercado = 'MAE' and Registro = '0620' and Fecha='"~IdxDate(fecha(Val(c4)))~"' "))
if Val(x1)=0
   Message('Insert Flag 0620')
   SQL.ADD("Insert into "~DBO~".FLAGSMERCADO ( ")
   SQL.ADD(" Mercado, Registro, Fecha, Cantidad ")
   SQL.ADD(" ) Values ( ")
   SQL.ADD(" 'MAE', ")
   SQL.ADD(" '0620', ")
   SQL.ADD(" '"~IdxDate(fecha(Val(c4)))~"', ")
   SQL.ADD(" 0 ")
   SQL.ADD(" ) ")
   SQL.NEW
   SQL.EXEC
Endif
