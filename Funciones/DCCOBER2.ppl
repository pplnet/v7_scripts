*-- DPCOBER2 - Criterio para Fijar Precios RANGE COLLAR
*- Si es Productor y El Floating Price < FadeOut -> El resultado es 0
IF [EqStr(VAL(z8),'1') y val(pc2)>=val(z9)] o [EqStr(VAL(z8),'0') y val(pc2)<=val(z9)]
   *-- Z3: Res. Unit. Puts     Z4: Res. Unit. Calls
   ACN(Z3,0)
   ACN(Z4,0)

   *-- Verifico las Condiciones de Ejercicio Para el Call
   **  Verifico los Floating Price con el Fade Out
   IF (val(pc2)-VAL(Z12))>=0 y [EqStr(val(z8),'1') o val(pc2)<=VAL(Z9)]
      ACN(Z4,(val(pc2)-val(z12)))
   EndIF

   IF (val(z13)-val(pc2))>=0 y [EqStr(val(z8),'0') o val(pc2)>=VAL(Z9)]
      ACN(Z3,(val(z13)-val(pc2)))
   EndIf

   * Invierto los resultados para la parte de la venta
   IF EqStr(val(z8),'0') 
      *-- Consumer
      *-- Compra de Call y Venta de Put
      ACN(Z3,-VAL(Z3))
   ELSE 
      *-- Producer 
      *-- Compra de Put y Venta de Call
      ACN(Z4,-VAL(Z4))
   ENDIF

   *-- Calculo el Resultado TOTAL 
   ACN(Z2,VAL(Z3)+VAL(Z4))
   ACN(&j+1:fac,val(pc2)+val(z2))
EndIf
