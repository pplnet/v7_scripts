*--> (cp:1) = CER <--*
*--> (cp:3) = Capital ajustado (Cantidad2) <--*
*--> (cp:5) = Capital amort. ajustado (Cantidad1 o Cantidad4) <--*
*--> (cp:6) = Incremento del capital próx. cuota <--*

*--> (vm:2) = Cantidad4--------- <--*
*--> (vm:3) = Cantidad3--------- <--*
*--> (vm:4) = Precio5----------- <--*
*--> (vm:5) = Precio7----------- <--*
*--> (vm:6) = Total2------------ <--*
*--> (vm:7) = Cantidad6--------- <--*
*--> (vm:8) = Cantidad7--------- <--*
*--> (vm:9) = Total3------------ <--*
*--> (vm:10) = Total4----------- <--*
*--> (vm:11) = Precio6---------- <--*
*--> (vm:12) = Cantidad8-------- <--*
*--> (vm:13) = Total1----------- <--*
*--> (vm:14) = Total7----------- <--*
*--> (vm:15) = Plazo4----------- <--*
*--> (vm:16) = Total9----------- <--*
*--> (vm:17) = Total8----------- <--*
*--> (vm:18) = Precio1---------- <--*
*--> (vm:19) = Precio3---------- <--*
*--> (vm:20) = Precio8---------- <--*
*--> (vm:21) = Cantidad5-------- <--*
*--> (vm:22) = Total5----------- <--*
*--> (vm:23) = ResultadoIndice-- <--*
*--> (vm:24) = VCAN10 ---------- <--*
*--> (vm:25) = Cantidad1Ori ---- <--*
*--> (vm:26) = Cantidad2Ori ---- <--*


If EqStr(FBN['Tipo'], 'MMCPM')
   * INTERES (Cantidad3) 
   ACN(vm:3, Val(cp:3) * FBN['Pr2'] *   FBN['Pl']  /  IIF (FBN['RB8']=0,36000,36500)   )
   * TOTALRETENCIONES(Cantidad4)
   ACN(vm:12, Val(vm:3) *  FBN['ImpG1'] / 100 )
   * IVA DIRECTO (Cantidad5)
   If FBN['C5'] = 0
      ACN(vm:21, 0 )  
   else
      ACN(vm:21, Val(vm:3) * FBN['ImpG2'] / 100 )
   endif
   * PERCEPCION IVA (Total5)
   If FBN['To5'] = 0
      ACN(vm:22, 0 )  
   else
      ACN(vm:22, Val(vm:3) * FBN['Alias3'] / 100 )
   endif
   * TOTAL IVA (Cantidad6)
   ACN(vm:17, Val(vm:21) + Val(vm:22)  )
   * INTERES NETO (Total3) 
   ACN(vm:9, Val(vm:3) - Val(vm:12)  )
   * MONTO (Total2)
   ACN(vm:6, Val(cp:5) + Val(vm:3) )
   * MONTO NETO (Total1)
   ACN(vm:13, Val(vm:6) - Val(vm:12) )
   * PRECIOmER
   ACN(vu:13, Val(cp:3) * COTIZACIONC(FBN['Esp'],,,,FBN['FIni'], 1, SI, VAR('MONEEXTR')) )
   * IMP DB/CR
   ACN(vu:29, Val(cp:3) * FBN['DT'] / 100 )
   * RESULTADO iNDICE 
   ACN(vm:23, Val(cp:5) - FBN['AmortOri'])
EndIf


If EqStr(FBN['Tipo'], 'MMPCLM')

   ACN(vm:2, IIF(FBN['RB6']=1,((Val(cp:3)*FBN['To5']*FBN['Pl'])/IIF(FBN['MB1']=0,36000,36500))*(FBN['Pr3']/100),0) )
   ACN(vm:3, IIF(FBN['Cuota']<FBN['PG'],0,Val(cp:3)*((FBN['Sp']+FBN['Pr2'])/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8'] +1)) )
   ACN(vm:4, IIF(FBN['Cuota']<FBN['PG'],0,Val(cp:3)*((FBN['Sp']+FBN['Pr2'])/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8'] +1)) )
   ACN(vm:5, IIF(FBN['RB6']=1,((Val(cp:3)*FBN['To5']*FBN['Pl'])/IIF(FBN['MB1']=0, 36000, 36500)) * (FBN['Pr3']/100),0) )
   ACN(vm:6, Val(cp:5)+Val(vm:3) )
   ACN(vm:7, IIF(FBN['RB6']=1, FBN['C5']+Val(vm:2), 0) )
   ACN(vm:8, IIF(FBN['RB6']=1, Val(vm:7)*(FBN['DT']/100),0) )
   ACN(vm:9, Val(vm:8)+FBN['To9']+Val(vm:3)+IIF(FBN['RB6']=1,Val(vm:7),0) )
   ACN(vm:10, IIF(FBN['RB6']=1,((((Val(cp:3)*FBN['Alias1']/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8']+1))+Val(vm:7))*(FBN['ImpG2']/100)), ((Val(cp:3)*((FBN['Pr2']+FBN['Sp'])/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8']+1)))*(FBN['ImpG2']/100)) )
   ACN(vm:11, IIF(FBN['RB6']=1,((((Val(cp:3)*FBN['Alias1'])*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8']+1))+Val(vm:7))*(FBN['ImpG2']/100)), ((Val(cp:3)*((FBN['Pr2']+FBN['Sp'])/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8']+1)))*(FBN['ImpG2']/100)) )
   ACN(vm:12, IIF(FBN['RB6']=1,Val(vm:7)*(FBN['DT']/100),0) )
   ACN(vm:13, Val(cp:5) + Val(vm:9) )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )

EndIf

If EqStr(FBN['Tipo'], 'MMPIM')

   ACN(vm:2, IIF(FBN['RB6']=1, Val(cp:3) * FBN['Pr2'] * FBN['Pl'] / IIF(FBN['MB3']=0, 36000, 36500), 0) )
   ACN(vm:3, IIF(FBN['Cuota']<FBN['PG'], 0, Val(cp:3) * ((FBN['Sp']+FBN['Pr2'])/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) )
   ACN(vm:6, Val(cp:5) + Val(vm:3) )
   ACN(vm:10, (FBN['ImpG2']/100) * (FBN['C6']+(Val(cp:3) * FBN['Alias1']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) )
   ACN(vm:14, IIF(FBN['RB6']=0, 0, IIF(FBN['RB6']=2, Val(cp:3) * (FBN['Pr2']+FBN['Sp']/100 * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1) * (FBN['Alias2']/100)), Val(cp:3)*FBN['To6']/100 * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1) * (FBN['Alias2']/100))) )
   ACN(vm:15, Val(vm:2) + FBN['Pl3'] )
   ACN(vm:16, IIF(FBN['RB6']=0 ,Val(vm:3), IIF(FBN['RB6']=1, Val(vm:15), 0)) * (FBN['TImp1']/100) )
   ACN(vm:9, FBN['C7'] + Val(vm:16) + Val(vm:3) + FBN['C6'] + Val(vm:15) + Val(vm:14) )
   ACN(vm:13, Val(cp:5) + Val(vm:9) )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )

EndIf

If EqStr(FBN['Tipo'], 'MMPEM')

   ACN(vm:17, IIF(FBN['RB6']=0, ((Val(cp:3) * FBN['To5'] * FBN['Pl'] / IIF(FBN['MB1']=0, 36000, 36500)) * (FBN['Pr3']/100)), 0) )
   ACN(vm:2, IIF(FBN['RB6']=1, Val(cp:3) * FBN['Pr2'] * FBN['Pl'] / IIF(FBN['MB3']=0, 36000, 36500), 0) )
   ACN(vm:10, (FBN['ImpG2']/100) * (FBN['C6']+(Val(cp:3) * FBN['Alias1']/100 * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1))) )
   ACN(vm:14, IIF(FBN['RB6']=0, 0, IIF(FBN['RB6']=2, Val(cp:3) * ((FBN['Pr2']+FBN['Sp'])/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1) * (FBN['Alias2']/100), Val(cp:3)*FBN['To6']/100 * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1) * (FBN['Alias2']/100))) )
   ACN(vm:3, IIF(FBN['Cuota']<FBN['PG'], 0, Val(cp:3) * ((FBN['Sp']+FBN['Pr2'])/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) )
   ACN(vm:6, Val(cp:5) + Val(vm:3) )
   ACN(vm:7, FBN['C5'] + Val(vm:17) )
   ACN(vm:15, Val(vm:2) + FBN['Pl3'] )
   ACN(vm:16, IIF(FBN['RB6']=0 ,Val(vm:3), IIF(FBN['RB6']=1, Val(vm:15), 0)) * (FBN['TImp1']/100) )
   ACN(vm:8, Val(vm:7) * (FBN['DT']/100) )
   ACN(vm:12, Val(vm:7) * (FBN['DT']/100) )
   ACN(vm:9, Val(vm:8) + Val(vm:16) + Val(vm:3) + Val(vm:7) + Val(vm:15) + Val(vm:14) )
   ACN(vm:13, Val(cp:5) + Val(vm:9) )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )

EndIf

If EqStr(FBN['Tipo'], 'MMSIMV')
   
   ACN(vm:2, Val(cp:5))
   ACN(vm:3, IIF(FBN['Cuota']<FBN['PG'], 0, Val(cp:3) * ((FBN['Sp']+FBN['Pr2'])/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) )
   ACN(vm:18, ((Val(cp:3)*FBN['Alias1']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) * (FBN['ImpG2']/100) )
   ACN(vm:19, ((Val(cp:3)*FBN['To6']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) * (FBN['Alias2']/100) )
   ACN(vm:20, IIF(FBN['TC2']>0, IIF(FBN['Pr8']<FBN['Pr3'], ROUND(((Val(cp:3) * FBN['To6']/100)*FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) * ((FBN['Alias2']-FBN['TC2'])/100), 2), 0),0) )
   ACN(vm:6, Val(cp:5) + Val(vm:3) )   
   ACN(vm:21, FBN['To9'] + Val(vm:3) + IIF(NOT EQSTR('ARG', BuscarCampo('Clientes','PaisDir','Codigo',FBN['Cl1'])), Val(vm:19), 0) )
   ACN(vm:13, Val(cp:5) + Val(vm:21) )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )
    
EndIf

If EqStr(FBN['Tipo'], 'MMFCMV')
 
   ACN(vm:3, Val(cp:3) * ((FBN['Sp']+FBN['Pr2'])/100)*FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1) )
   ACN(vm:6, Val(cp:5) + Val(vm:3) )
   ACN(vm:4, Val(cp:3) * ((FBN['Sp']+FBN['Pr2'])/100)*FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1) )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )
    
EndIf

If EqStr(FBN['Tipo'], 'MMONM')

   ACN(vm:3, IIF(FBN['Cuota']<FBN['PG'],0,Val(cp:3)*((FBN['Sp']+FBN['Pr2'])/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8'] +1)) )
   ACN(vm:18, IIF(FBN['Cuota']<FBN['PG'],0,((Val(cp:3)*(FBN['Alias1']/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8'] +1)))* FBN['ImpG2']/100) )
   ACN(vm:19, ((IIF(FBN['Cuota']<FBN['PG'],0, Val(cp:3)*(FBN['To6']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1))) * (FBN['Alias2']/100)) )
   ACN(vm:6, Val(cp:5) + Val(vm:3) )
   ACN(vm:21, Val(vm:3) + Val(vm:19) )
   ACN(vm:13, Val(cp:5) + Val(vm:21) )
   ACN(vm:17, Val(vm:3) * FBN['TBa']/100 )
   ACN(vm:16, Val(vm:3) * (FBN['Ta3']/100) )
   ACN(vm:24, SQL(" Select Sum(Tasa1) as Tasa1 from "~DBO~".COMISIONES2 Where Tipo = '5' and NrOperacion = '"~FBN['NrOp']~"' ") )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )

EndIf

If EqStr(FBN['Tipo'], 'MMPCCM')
   
   ACN(vm:10, IIF(FBN['RB6']=0 O [FBN['RB6']=2 y FBN['MB3']=0], ((Val(cp:5) * FBN['Alias1']/100) * FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1)) * (FBN['ImpG2']/100) ,0) )
   ACN(vm:14, IIF(FBN['RB6']=2 y FBN['MB3']=0, (( (Val(cp:3)*FBN['To6']/100)*FACTORDIAS(FBN['FIni'], FBN['FFin'], FBN['RB8'] +1))*(FBN['Alias2']/100)) ,0) )
   ACN(vm:3, Val(cp:3)*((FBN['Sp']+FBN['Pr2'])/100)*FACTORDIAS(FBN['FIni'],FBN['FFin'],FBN['RB8'] +1) )
   ACN(vm:22, IIF(FBN['RB6']=2 y FBN['MB3']=1, (( (Val(cp:3)*FBN['Pl']*FBN['To6'])/IIF(FBN['RB9']=1, 36500, 36000))*(FBN['Alias2']/100)) ,0) )
   ACN(vm:18, (FBN['To8']*36500) / (Val(cp:3)*FBN['Pl']) ) 
   ACN(vm:6, Val(cp:5) + Val(vm:3) )
   ACN(vm:21, (Val(cp:5) + FBN['To8']) )
   ACN(vm:2, IIF(FBN['RB6']=3 O [FBN['RB6']=4 y FBN['MB3']=0], Val(vm:3) * FBN['TPC']/100, 0) )
   ACN(vm:9, Val(vm:3) + Val(vm:14)+ IIF(FBN['RB6']=4 y FBN['MB3']=0, Val(vm:2),0) )   
   ACN(vm:16, Val(vm:3) * (FBN['TBa']/100) )
   ACN(vm:8, Val(vm:3) * FBN['ImpG1']/100 )
   ACN(vm:7, IIF(FBN['RB6']=3 O [FBN['RB6']=4 y FBN['MB3']=1], Val(cp:6) * FBN['TPC']/100, 0) )
   ACN(vm:13, (Val(cp:5) + Val(vm:9)) )
   ACN(vm:17, Val(vm:3) + Val(vm:22) + IIF(FBN['RB6']=4 y FBN['MB3']=1, Val(vm:7) ,0) )
   ACN(vm:23, - FBN['COri'] + Val(cp:5) )
  
EndIf

