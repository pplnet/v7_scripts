            SQL.ADD(" RB7,  ")

            SQL.ADD(" RB1 , Fecha4, Fecha3, Book1 ")

            SQL.ADD(") Values (")
          
            SQL.ADD("'"~Val(j:&i)~"', ")
            SQL.ADD("'"~IdxDate(FSys)~"', ")
            SQL.ADD("'"~IdxDate(Dialogo.Fecha1)~"', ")
            SQL.ADD("'"~Val(a:&i)~"', ")
          
            SQL.ADD("'"~Dialogo.Vehiculo1~"', ")
            SQL.ADD("'"~Val(b:&i)~"', ")
