            SQL.ADD("(NrOperacion, FechaMov, Cliente, Especie, CallPut, ")
            SQL.ADD("FechaEj, PrecioEj, EnteCustodia, NrSaldo, Mercado, ")
            SQL.ADD("Leyenda, Bits, NrGrupo, Concepto, NrGrupo2, ")
            SQL.ADD("NrMov, NrLiq, Status, NrInstan, Cupon, ")
            SQL.ADD("FechaEje, UsuarioEje, Cuenta, Transaccion, Cantidad, ")
            SQL.ADD("NrTrans2 ,    Book")
            SQL.ADD(") ")

            SQL.ADD("select ")
            SQL.ADD("M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.CallPut, ")
            SQL.ADD("M.FechaEj, M.PrecioEj, M.EnteCustodia, M.NrSaldo, M.Mercado, ")
            SQL.ADD("M.Leyenda, M.Bits, M.NrGrupo, M.Concepto, M.NrGrupo2, ")
            SQL.ADD("M.NrMov, M.NrLiq, M.Status, M.NrInstan, M.Cupon, ")
* ^Z 18/07/2024 Por si se cambió la cuenta            
*            SQL.ADD("'"~IdxDate(FSys)~"', '"~UsuarioActivo~"', M.Cuenta, M.Transaccion, M.Cantidad, ")
            SQL.ADD("'"~IdxDate(FSys)~"', '"~UsuarioActivo~"', '"~Val(r:&i)~"', M.Transaccion, M.Cantidad, ")
            SQL.ADD("'"~Val(n:&i)~"', M.Book ")

            SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
            SQL.ADD("where M.NrOperacion = O.NrOperacion")
            SQL.ADD("and M.NrOperacion = B.NrOperacion")
            if Dialogo.Check5 = 0
              * NO Compensa
              SQL.ADD("and IsNull(M.NrGrupo2,0) = "~Val(w:&i)~" ")
              if Dialogo.Check13=0
                 SQL.ADD("and IsNull(M.NrMov,0)    = "~Val(y:&i)~" ")
                 SQL.ADD("and M.NrOperacion      = '"~Val(CA:&i)~"' ")
              else   
                 * PZ 20/01/2023 No se por que utiliza el CA para otros casos
                 SQL.ADD("and M.NrOperacion      = '"~Val(i:&i)~"' ")
              endif   
            endif

            if Dialogo.Check13=1
*               SQL.ADD("and M.NrGrupo in (15,16)      ") 
               SQL.ADD("and NrGrupo = "~FSTR(val(nr:&i),1,0)) 
            else
               SQL.ADD("and (M.NrGrupo Not in (15,16) or M.NrGrupo is null)         ") 
            endif

            SQL.ADD("and M.Cliente = '"~Val(a:&i)~"' ")
            SQL.ADD("and M.Especie = '"~Val(j:&i)~"' ")
            SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and M.Mercado = '"~Val(b:&i)~"'")
            SQL.ADD("and M.NrSaldo = 1 ")
* agregado filtro cuenta
            SQL.ADD("and IsNull(M.Cuenta,'') = '"~Val(cr:&i)~"' ")
            
            if Dialogo.Check11=0
               SQL.ADD("and M.FechaMov = '"~IdxDate(Val(cg:&i))~"' ")
            else
               SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
            endif
            SQL.ADD("and M.Bits in ('MV','MI') ")
            SQL.ADD("and (")
              SQL.ADD("'"~FStr(Val(bk:&i),1,0)~"' = '0' ")
              SQL.ADD("or ('"~FStr(Val(bg:&i),1,0)~"' = '1' and M.Status = 'DVP') ")
              SQL.ADD("or ('"~FStr(Val(bh:&i),1,0)~"' = '1' and M.Status = 'RVP') ")
              SQL.ADD("or ('"~FStr(Val(bi:&i),1,0)~"' = '1' and M.Status = 'CONF') ")
              SQL.ADD("or ('"~FStr(Val(bj:&i),1,0)~"' = '1' and M.Status = 'MATCH') ")
              SQL.ADD("or ('"~FStr(Val(bk:&i),1,0)~"' = '1' and (M.Status = '' or Status is Null or M.Status = 'RVP') )")
            SQL.ADD(")")
            ** si es por CONU Cliente2 y Mercado2
            If EqStr(Val(TR:&i),'CONU')
               SQL.ADD("and O.Cliente2 = '"~Val(a:&i)~"'")
               SQL.ADD("and O.Mercado2 = '"~Val(m:&i)~"'")
            Else
               If Incluido(Val(TR:&i),'DDC|DDV|')
                  SQL.ADD("and M.Cliente = '"~Val(a:&i)~"'")
                  SQL.ADD("and M.Mercado = '"~Val(m:&i)~"'")
               Else
                  SQL.ADD("and O.Cliente1 = '"~Val(a:&i)~"'")
                  SQL.ADD("and O.Mercado = '"~Val(m:&i)~"'")
               Endif
            Endif
            SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD(" and B.NrBit IN ('10','70') and B.Valor = '1'                                                   ")
                    
            SQL.ADD("union ")
                    
            SQL.ADD("select ")
            SQL.ADD("M.NrOperacion, M.FechaMov, M.Cliente, M.Especie, M.CallPut, ")
            SQL.ADD("M.FechaEj, M.PrecioEj, M.EnteCustodia, M.NrSaldo, M.Mercado, ")
            SQL.ADD("M.Leyenda, M.Bits, M.NrGrupo, M.Concepto, M.NrGrupo2, ")
            SQL.ADD("M.NrMov, M.NrLiq, M.Status, M.NrInstan, M.Cupon, ")
* PZ 18/07/2024 Por si se cambió la cuenta
*            SQL.ADD("'"~IdxDate(Fsys)~"', '"~UsuarioActivo~"', M.Cuenta, M.Transaccion, M.Cantidad, ")
            SQL.ADD("'"~IdxDate(Fsys)~"', '"~UsuarioActivo~"', '"~Val(r:&i)~"', M.Transaccion, M.Cantidad, ")
            SQL.ADD("'"~Val(n:&i)~"' ,   M.Book")
            SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
            SQL.ADD("where M.NrOperacion = T.NrTrans")
            SQL.ADD("and M.NrOperacion = B.NrOperacion")
            IF Dialogo.Check5 = 0
            * NO Compensa
              if Dialogo.Check13=0
                 SQL.ADD("and M.NrMov = "~Val(y:&i))
                 SQL.ADD("and M.NrOperacion = '"~VAL(CA:&i)~"' ")
              else
                 * PZ 20/01/2023 No se por que utiliza el CA para otros casos
                 SQL.ADD("and M.NrOperacion = '"~Val(i:&i)~"' ")
              endif   
            ENDIF

            if Dialogo.Check13=1
*               SQL.ADD("and M.NrGrupo in (15,16)  ") 
               SQL.ADD("and NrGrupo = "~FSTR(val(nr:&i),1,0)) 
            else
               SQL.ADD("and (M.NrGrupo Not in (15,16) or M.NrGrupo is null)  ") 
            endif

            SQL.ADD("and M.Cliente = '"~Val(a:&i)~"' ")
            SQL.ADD("and M.Especie = '"~Val(j:&i)~"' ")
            SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and M.Mercado = '"~Val(b:&i)~"'")
            SQL.ADD("and M.NrSaldo = 1 ")
* agregado filtro cuenta
            SQL.ADD("and IsNull(M.Cuenta,'') = '"~Val(cr:&i)~"' ")
            SQL.ADD("and M.FechaMov = '"~IdxDate(Val(cg:&i))~"' ")
            SQL.ADD("and M.Bits in ('MV','MI') ")
            SQL.ADD("and (")
              SQL.ADD("'"~FStr(Val(bk:&i),1,0)~"' = '0' ")
              SQL.ADD("or ('"~FStr(Val(bg:&i),1,0)~"' = '1' and M.Status = 'DVP') ")
              SQL.ADD("or ('"~FStr(Val(bh:&i),1,0)~"' = '1' and M.Status = 'RVP') ")
              SQL.ADD("or ('"~FStr(Val(bi:&i),1,0)~"' = '1' and M.Status = 'CONF') ")
              SQL.ADD("or ('"~FStr(Val(bj:&i),1,0)~"' = '1' and M.Status = 'MATCH')")
              SQL.ADD("or ('"~FStr(Val(bk:&i),1,0)~"' = '1' and (M.Status = '' or Status is Null or M.Status = 'RVP'))")
            SQL.ADD(")")
            SQL.ADD("and T.Cliente1 = '"~Val(a:&i)~"' ")
            SQL.ADD("and T.Mercado1 = '"~Val(b:&i)~"' ")
            SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and ((B.NrBit = 5 AND '"~Val(TR:&i)~"' <> 'LIQOCT' ) OR (B.NrBit = 4 AND '"~Val(TR:&i)~"' = 'LIQOCT' )) ")
            SQL.ADD("and B.Valor = '1' ") 
            SQL.NEW
                      
            ***************************************
            ** Borro movs pendientes de la operacion
            ***************************************
            SQL.ADD("DELETE from "~DBO~".MOVPENDIENTES ")
            SQL.ADD("where Cliente = '"~Val(a:&i)~"' ")
            SQL.ADD("and Especie = '"~Val(j:&i)~"' ")
            SQL.ADD("and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
            SQL.ADD("and Mercado = '"~Val(b:&i)~"'")
            SQL.ADD("and NrSaldo = 1 ")
* agregado filtro cuenta
            SQL.ADD("and IsNull(Cuenta,'') = '"~Val(cr:&i)~"' ")
            IF Dialogo.Check5 = 0
              * NO Compensa
              SQL.ADD("and IsNull(NrGrupo2,0) = "~Val(w:&i)~" ")
              if Dialogo.Check13=0
                 SQL.ADD("and IsNull(NrMov,0)    = "~Val(y:&i)~" ")
                 SQL.ADD("and NrOperacion        = '"~Val(CA:&i)~"' ")
              else   
                 * PZ 20/01/2023 No se por que utiliza el CA para otros casos
                 SQL.ADD("and NrOperacion        = '"~Val(i:&i)~"' ")
              endif   
            ENDIF

            if Dialogo.Check13=1
*               SQL.ADD("and NrGrupo in (15,16)   ") 
               SQL.ADD("and NrGrupo = "~FSTR(val(nr:&i),1,0)) 
            else
               SQL.ADD("and (NrGrupo Not in (15,16) or NrGrupo is null)  ") 
            endif

            SQL.ADD("and FechaMov = '"~IdxDate(Val(cg:&i))~"' ")
            SQL.ADD("and Bits in ('MV','MI') ")
            SQL.ADD("and (")
              SQL.ADD("'"~FStr(Val(bk:&i),1,0)~"' = '0' ")
              SQL.ADD("or ('"~FStr(Val(bg:&i),1,0)~"' = '1' and Status = 'DVP') ")
              SQL.ADD("or ('"~FStr(Val(bh:&i),1,0)~"' = '1' and Status = 'RVP') ")
              SQL.ADD("or ('"~FStr(Val(bi:&i),1,0)~"' = '1' and Status = 'CONF') ")
              SQL.ADD("or ('"~FStr(Val(bj:&i),1,0)~"' = '1' and Status = 'MATCH') ")
              SQL.ADD("or ('"~FStr(Val(bk:&i),1,0)~"' = '1' and (Status = '' or Status is Null or Status = 'RVP') )")
            SQL.ADD(")")
            SQL.ADD("and (")
            SQL.ADD("NrOperacion in (Select O.NrOperacion from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
                SQL.ADD("where O.NrOperacion = B.NrOperacion ")
                If EqStr(Val(TR:&i),'CONU')                
                   SQL.ADD("and O.Mercado2 = '"~Val(m:&i)~"'")
                   SQL.ADD("and O.Cliente2 = '"~Val(a:&i)~"' ")
                Else
                   If Incluido(Val(TR:&i),'DDC|DDV|')                
                      SQL.ADD("and MOVPENDIENTES.Mercado = '"~Val(m:&i)~"'")
                      SQL.ADD("and MOVPENDIENTES.Cliente = '"~Val(a:&i)~"' ")
                   Else
                      SQL.ADD("and O.Mercado = '"~Val(m:&i)~"'")
                      SQL.ADD("and O.Cliente1 = '"~Val(a:&i)~"' ")
                   Endif
                Endif
                SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
                SQL.ADD(" and B.NrBit IN ('10','70') and B.Valor = '1'                                   ")

                SQL.ADD(")")

              SQL.ADD("or NrOperacion in (Select T.NrTrans from "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
                SQL.ADD("where T.NrTrans = B.NrOperacion ")
                SQL.ADD("and T.Cliente1 = '"~Val(a:&i)~"' ")
                SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
                SQL.ADD("and T.Mercado1 = '"~Val(b:&i)~"'")
                SQL.ADD("and ((B.NrBit = 5 AND '"~Val(TR:&i)~"' <> 'LIQOCT' ) OR (B.NrBit = 4 AND '"~Val(TR:&i)~"' = 'LIQOCT' )) ")
                SQL.ADD("and B.Valor = '1' ")
                SQL.ADD(")")
            SQL.ADD(")")
            SQL.NEW
          else
            ACT(n:&i, 'Liquida')
          endif
          * Fin Control Check8=1 (Procesa)
         endif
        * Fin Control o-k
      SQL.EXEC  
* FO 25/04/2006
     EjecutarEvento('LIQVT',NrTrans1=Val(n:&i))

