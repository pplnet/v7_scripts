              SQL.ADD("'"~Copy(Val(i:&i),1,8)~"', ")
            else
              if Incluido(Val(b:&i), VAR('MERCTITULO'))
                SQL.ADD("'"~Val(u:&i)~"', ")
              endif
            endif
            if Val(k:&i)=0
              SQL.ADD("'COMP', ")
            else
             if Val(k:&i) > 0
                SQL.ADD("'RET', ")
                SQL.ADD(""~FStr(Val(k:&i),1,2)~", ")
              else
                SQL.ADD("'DEP', ")
                SQL.ADD(""~FStr(-Val(k:&i),1,2)~", ")
              endif
              SQL.ADD(" '"~FStr(Val(bg:&i),1,0)~"', ")
              SQL.ADD("'"~FStr(Val(bh:&i),1,0)~"', ")
              SQL.ADD("'"~FStr(Val(bi:&i),1,0)~"', ")
            
              SQL.ADD("'"~Val(r:&i)~"', ")
              SQL.ADD("'"~Val(s:&i)~"', ")
