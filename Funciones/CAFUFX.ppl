Cuenta1          : 'Cta.Esp.CLI:'   ;16;1;1;;RB10=0;Vacio(CUENTA1) o [[[CLIENTECUENTA(CLIENTE1,CUENTA1) y EqStr(VTXT13,'NO')] o [CLIENTECUENTA(VEHICULO1,CUENTA1) y EqStr(VTXT13,'SI')]] y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO3, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))];'Cuenta Especie cliente inválida';NO;;IF(RB10=0,IF(NoVacio(BOOK1),IF(1<=VCAN4,ItemLista(VTXT6,1),'')),'');;;;;;"Cliente = '"~IF(EqStr(VTXT13,'SI'),VEHICULO1,CLIENTE1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~MERCADO3~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%')";;
