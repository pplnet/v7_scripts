*Cuenta2          : 'Cta.Esp.VEH:'   ;16;2;1;;RB10=0;Vacio(CUENTA2) o CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(ESPECIE,CUENTA2) y EqStr(MERCADO3, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2));'Cuenta Especie Vehiculo inválida';NO;;IF(RB10=0,IF(NoVacio(BOOK1),IF(EqStr(VTXT13,'SI'),CUENTA1,QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~MERCADO3~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))),'');;;;;;"Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~MERCADO3~"' "
*2da version Busca BCRA para vehiculos
*Cuenta2          : 'Cta.Esp.VEH:'   ;16;2;1;;RB10=0;Vacio(CUENTA2) o CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(ESPECIE,CUENTA2) y EqStr(IF(INCLUIDO(MERCADO3,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO3)),MERCADO3), BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2));'Cuenta Especie Vehiculo inválida';NO;;IF(RB10=0,IF(NoVacio(BOOK1),IF(EqStr(VTXT13,'SI'),CUENTA1,QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~IF(INCLUIDO(MERCADO3,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO3)),MERCADO3)~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))),'');;;;;;"Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~ IF(INCLUIDO(MERCADO3,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO3)),MERCADO3) ~"' "
*3ra version: Busca cuentas Rofex para todos
*Cuenta2          : 'Cta.Esp.VEH:'   ;16;2;1;;RB10=0;Vacio(CUENTA2) o CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(ESPECIE,CUENTA2) y EqStr(MERCADO4, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2));'Cuenta Especie Vehiculo inválida';NO;;IF(RB10=0,IF(NoVacio(BOOK1),IF(EqStr(VTXT13,'SI'),CUENTA1,QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~MERCADO4~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC "))),'');;;;;;"Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~MERCADO4~"' "
Cuenta2          : 'Cta.Esp.VEH:'   ;16;2;1;;RB10=0;Vacio(CUENTA2) o [CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(ESPECIE,CUENTA2) y EqStr(IF(Eqstr(VTXT1, 'SI'),MERCADO4,IF(INCLUIDO(MERCADO3,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO3)),MERCADO3)), BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))];'Cuenta Especie Vehiculo inválida';NO;;IF(RB10=0,IF(NoVacio(BOOK1),IF(EqStr(VTXT13,'SI'),CUENTA1,QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') and Mercado='"~IF(Eqstr(VTXT1, 'SI'),MERCADO4,IF(INCLUIDO(MERCADO3,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO3)),MERCADO3))~"' ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))),'');;;;;;"Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') and Mercado='"~ IF(INCLUIDO(MERCADO3,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO3)),MERCADO3) ~"'"

