TotalAux1         : 'Comision '     ;17;2;2;NO;SI;;;;0;IF([CB4=1 o EqStr(CLIENTE1,VEHICULO1)] y TOTALBRUTOCLI1<>0,MontoArancelC(TIPOOP,CLIENTE1,ESPECIE,VEHICULO1,'AOPER',TOTALBRUTOCLI1*if(Eqstr(VAR('LIQCOMMO'),'SI'),1,PORDERECHOMERCADO),0,,BUSCARCAMPO('CLIENTES','TipoCliente','Codigo',CLIENTE1),SI,,MERCADO4,,,SI,SI,,SI),0);;;;
TotalIva          : 'IVA'           ;18;2;2;NO;SI;;;;0;IF([CB4=1 o EqStr(CLIENTE1,VEHICULO1)] y TOTALBRUTOCLI1<>0,TotalAux1*TotalAux4,0);;;;;'###,###,###,###.##';
