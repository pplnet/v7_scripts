                 ** AUXGENORDA
                 ACT(w6, GetNumerador(1))
                 ACT(c:FAC, Val(w6))
                 Message('--- #Op : '~Val(w6)~' Tipo : '~Val(t:2)~' Especie : '~Val(t:3)~' Cliente : '~Val(t:56))
                 SQL.ADD("Insert into "~DBO~".OPERACIONES (")
               
                 SQL.ADD("NrOperacion, ")
                 SQL.ADD("TipoOp, ")
                 SQL.ADD("Especie, ")
                 SQL.ADD("Cliente1, ")
                
                 SQL.ADD("Cantidad, ")
                 SQL.ADD("ContraEspecie, ")
                 SQL.ADD("Precio1, ")
                 
                 SQL.ADD("Cupon1,")
                 SQL.ADD("FechaOp, ")
                
                 if EqStr(Val(x:1),'S')
                    * Spot        
                    SQL.ADD("Plazo, ")
                    SQL.ADD("RB5, ")
                 else
                    * Futuro
                    SQL.ADD("PlazoGracia, ")
                 endif
                 SQL.ADD("RB6, ")
                 SQL.ADD("FechaVto, ")
                 SQL.ADD("Mercado, ")
                 SQL.ADD("Mercado2, ")
                 SQL.ADD("FormaLiquidacion1, ")
                
                 SQL.ADD("FormaLiquidacion2, ")
                 SQL.ADD("TablaFeriados1, ")
                 SQL.ADD("Operador, ")
                 SQL.ADD("OpSIOPEL, ")
                
                 SQL.ADD("EnteCus1, ")
                 SQL.ADD("EnteCus2, ")
                 SQL.ADD("Vehiculo1, ")
                 SQL.ADD("Mercado4, ")
                 
                 SQL.ADD("CB5, ")
                 SQL.ADD("NroAltaMAE, ")
                 SQL.ADD("UDN2, ")
                 SQL.ADD("PaseCB, ")
                 
                 SQL.ADD("AceptaMAE, ")
                 SQL.ADD("FechaAltaMAE, ")
                 SQL.ADD("FechaEnvioMAE, ")
                 SQL.ADD("Cuenta1, ")
                 
                 SQL.ADD("Cuenta4, ")
                 SQL.ADD("Cuenta5, ")
                 SQL.ADD("Observaciones, ")
                 SQL.ADD("Numerador, ")
                
                 SQL.ADD("FechaCarga, ")
                 SQL.ADD("FechaCargaSys, ")
                 SQL.ADD("UsrInput, ")
                 SQL.ADD("CB4, ")
                 
                 SQL.ADD("Direccion, ")
                 SQL.ADD("NrOrden, ")
                 SQL.ADD("Corporate, ")
                 SQL.ADD("NrOrden1, ")
                 SQL.ADD("Book1, ")
                 SQL.ADD("MB2, ")
                 SQL.ADD("AfectaLS ")
                 
                 SQL.ADD(") values (")
               
                 * NrOperacion
                 SQL.ADD(" '"~Val(w6)~"', ")
                 * TipoOp
                 SQL.ADD(" '"~Val(t:2)~"', ")
                 * Especie
                 SQL.ADD(" '"~Val(t:3)~"', ")
                 * Cliente1
                 SQL.ADD(" '"~Val(t:56)~"', ")
                                 
                 * Cantidad
                 SQL.ADD(" "~FStr(Val(t:11),0,2)~", ")
                 * ContraEspecie
                 SQL.ADD(" '"~Val(t:12)~"', ")
                 * Precio1
                 SQL.ADD(" "~FStr(Val(t:13),0,8)~", ")
                 * Cupon1
                 SQL.ADD(" '"~Val(t:17)~"', ")
                 * FechaOp
                 SQL.ADD(" '"~IdxDate(Val(t:19))~"', ")
               
                 if EqStr(Val(x:1),'S')
                    * Spot        
                    * Plazo (N)
                    SQL.ADD(" "~FStr(Val(t:21),1,0)~", ")
                    * RB5 (N)
                    SQL.ADD(" '"~Val(t:20)~"', ")
                 else
                    * Futuro        
                    * PlazoGracia (N)
                   SQL.ADD(" "~FStr(Val(t:21),1,0)~" , ")
                 endif
                 * RB6 (N) Fuente=0=Siopel
                 SQL.ADD(" '1', ")
                 * FechaVto
                 SQL.ADD(" '"~IdxDate(Val(t:45))~"', ")
                 * Mercado
                 SQL.ADD(" '"~Val(t:22)~"', ")
                 * Mercado2
                 SQL.ADD(" '"~Val(t:52)~"', ")
                 * FormaLiquidacion1
                 SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
               
                 * FormaLiquidacion2
                 SQL.ADD(" '"~FStr(Val(t:23),1,0)~"', ")
                 * TablaFeriados1
                 SQL.ADD(" '"~Val(t:24)~"', ")
                 * Operador
                 SQL.ADD(" '"~Val(t:25)~"', ")
                 * OpSIOPEL
                 SQL.ADD(" '"~Val(t:26)~"', ")
              
                 * EnteCus1 (N)
                 SQL.ADD(" '"~Val(t:27)~"', ")
                 * EnteCus2 (N)
                 SQL.ADD(" '"~Val(t:57)~"', ")
                 * Vehiculo1
                 SQL.ADD(" '"~Val(t:29)~"', ")
                 * Mercado4
                 SQL.ADD(" '"~Val(t:31)~"', ")
               
                 * CB5 (Es de Mercado Externo )
                 SQL.ADD(" '1', ")
                 * NroAltaMAE
                 SQL.ADD(" '"~fbn('Secuencia')~"', ")
                 * UDN2 (Rueda)
                 SQL.ADD(" '"~Val(t:32)~"', ")
                 * PaseCB
                 SQL.ADD(" '"~Val(t:33)~"', ")
                
                 * AceptaMAE
                 SQL.ADD(" 'SI', ")
                 * FechaAltaMAE
                 SQL.ADD("Convert(datetime,'"~Val(t:84)~"',120), ")
                * FechaEnvioMAE
                 SQL.ADD(" "~Val(t:49)~", ")
                 * Cuenta1
                 SQL.ADD(" '"~Val(t:28)~"', ")

                 * Cuenta4
                 SQL.ADD(" '"~Val(t:80)~"', ")
                 * Cuenta5
                 SQL.ADD(" '"~Val(t:81)~"', ")
                 * Observaciones
                 SQL.ADD(" '"~Val(t:40)~"', ")
                 * Numerador
                 SQL.ADD(" 1, ")
               
                 * FechaCarga
                 SQL.ADD(" "~SQLAhora~", ")
                 * FechaCargaSys
                 SQL.ADD(" "~IdxDate2(FSys)~", ")
                 * UsrInput
                 SQL.ADD(" '"~UsuarioActivo~"', ")
                 * Marca CPC1 x Terceros
                 SQL.ADD(" '"~Val(t:73)~"', ")

                 * Direccion
                 SQL.ADD(" 2, ")
                 * NrOrden
                 SQL.ADD(" '"~Val(t:50)~"', ")
                 * Corporate (Cartera Propia)
                 SQL.ADD(" '"~FStr(Val(t:55),1,0)~"', ")
                 * NrOrden1 (OTIC/OTIV)
                 SQL.ADD(" '"~Val(t:53)~"', ")
                 * Book1
                 SQL.ADD(" '"~Val(t:75)~"', ")
                 * MB2 Bloqueo Moneda
                 SQL.ADD(" '"~Val(t:82)~"', ")                 
                 * AfectaLS
                 SQL.ADD(" '"~Val(t:71)~"' ")
                 
                 SQL.ADD(")")
                 SQL.NEW