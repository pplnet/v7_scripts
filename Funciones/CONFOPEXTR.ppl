********************************
* Op1: NrOperacion a Confirmar *
********************************

SQL.ADD(" UPDATE "~DBO~".OPERACIONES Set ")
SQL.ADD(" RB10='1',FechaPrecan='"~IdxDate(Fsys)~"' ")
SQL.ADD(" where NrOperacion='"~Val(Op1)~"' ")
SQL.NEW
SQL.EXEC

*** Actualiza movimientos y limites ****
SQL.ActualizarMovimientos2(Val(Op1),NO,SI,NO,NO)
SQL.EXEC
