  Cantidad17: 'PrecioVto'      ;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK');;;;PRECIO6;200;NO;Numero;'###,###,###,###,###.####';NO;NO;
  Check10  : 'Est'             ;  ;  ;CUOTASL.CHECK10[Fila] = 0;'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' Es Estimada';0;;50;;Check;;;;;;;;SI
  Coeficiente : 'Coeficiente'  ;NO;;;;IF(VACIO(INDICE) O [NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK')],1,IF(CUOTASL.FECHA2[Fila]>Fsys,IF(FECHAOP=FSYS,1,COTIZACION(INDICE,,,,FSYS,1,SI)/COTIZACION(INDICE,,,,FECHAOP-1,1,SI)),CUOTASL.COEFICIENTE[Fila]));IF(VACIO(INDICE) O [NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK')],1,IF(CUOTASL.FECHA2[Fila]>Fsys,IF(FECHAOP=FSYS,1,COTIZACION(INDICE,,,,FSYS,1,SI)/COTIZACION(INDICE,,,,FECHAOP-1,1,SI)),CUOTASL.COEFICIENTE[Fila]));100;;Numero;'###.########';NO;NO;'1;2'
  Cantidad1Ori: 'ImpAmor Orig' ;NO;;;;IF(CUOTASL.COEFICIENTE[Fila]=1,IF(INCLUIDO(TIPOOP,'MMONM'),CUOTASL.CANTIDAD4[Fila],CUOTASL.CANTIDAD1[Fila]));IF(CUOTASL.COEFICIENTE[Fila]=1,IF(INCLUIDO(TIPOOP,'MMONM'),CUOTASL.CANTIDAD4[Fila],CUOTASL.CANTIDAD1[Fila]),(CANTIDADORI*(1+VCAN10/100))*CUOTASL.TASA1[Fila]/100);200;;Numero;'###,###,###,###,###.##';NO;NO;;NO;NO
  Cantidad2Ori: 'VN Orig'      ;NO;;;;IF(CUOTASL.COEFICIENTE[Fila]=1,CUOTASL.CANTIDAD2[Fila]);IF(CUOTASL.COEFICIENTE[Fila]=1,CUOTASL.CANTIDAD2[Fila],IF(Fila=1,(CANTIDADORI*(1+VCAN10/100)),CUOTASL.CANTIDAD2ORI[Fila-1]-CUOTASL.CANTIDAD1ORI[Fila-1]) );200;;Numero;'###,###,###,###,###.##';NO;NO;;NO;NO
  ResultadoIndice: 'Resultado' ;NO;;;;IF(INCLUIDO(TIPOOP,'MMONM'),-CUOTASL.CANTIDAD1ORI[Fila]+CUOTASL.CANTIDAD4[Fila],-CUOTASL.CANTIDAD1ORI[Fila]+CUOTASL.CANTIDAD1[Fila]);IF(INCLUIDO(TIPOOP,'MMONM'),-CUOTASL.CANTIDAD1ORI[Fila]+CUOTASL.CANTIDAD4[Fila],-CUOTASL.CANTIDAD1ORI[Fila]+CUOTASL.CANTIDAD1[Fila]);200;;Numero;'###,###,###,###,###.##';NO;NO;;NO;NO

  Cantidad13: 'Imp Amort Link' ;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK');;;;IF(INCLUIDO(TIPOOP,'MMONM'),CUOTASL.CANTIDAD4[Fila]*CUOTASL.CANTIDAD17[Fila],CUOTASL.CANTIDAD1[Fila]*CUOTASL.CANTIDAD17[Fila]);200;;Numero;'###,###,###,###.##';NO;NO;
  Cantidad14: 'Interes Link'   ;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK');;;;CUOTASL.CANTIDAD3[Fila]*CUOTASL.CANTIDAD17[Fila];200;NO;Numero;'###,###,###,###,###.####';NO;NO;
  Cantidad15: 'WH Link'        ;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK') Y INCLUIDO(TIPOOP,'MMONM|MMPOSM');;;;IF(INCLUIDO(TIPOOP,'MMONM'),CUOTASL.PRECIO3[Fila]*CUOTASL.CANTIDAD17[Fila],CUOTASL.TOTAL7[Fila]*CUOTASL.CANTIDAD17[Fila]);200;NO;Numero;'###,###,###,###,###.####';NO;NO;
  Cantidad16: 'IVA Link'       ;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK');;;;IF(INCLUIDO(TIPOOP,'MMONM'),CUOTASL.PRECIO1[Fila]*CUOTASL.CANTIDAD17[Fila],IF(INCLUIDO(TIPOOP,'MMPCLM|MMPOSM'),CUOTASL.TOTAL4[Fila]*CUOTASL.CANTIDAD17[Fila],CUOTASL.CANTIDAD5[Fila]*CUOTASL.CANTIDAD17[Fila]));200;NO;Numero;'###,###,###,###,###.####';NO;NO;
  Fecha5    : 'Seteo Link'     ;NO;NoVacio(INDICE) Y Eqstr(TIPOGRACIA, 'ULK');;;;Habiles(CUOTASL.FECHA2[Fila], -PLAZO2,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Cantidad3Ori: 'ImpAmor Orig' ;NO;[INCLUIDO(TIPOOP,'MMSIMV|MMFIMV|') Y NOT EQSTR(ABM,'A')] O NOT INCLUIDO(TIPOOP,'MMSIMV|MMFIMV|MMLEAS');;;CUOTASL.CANTIDAD1[Fila];(CANTIDADORI*CUOTASL.TASA7[Fila]/100);200;;Numero;'###,###,###,###,###.##';NO;NO;;NO;NO
  ***pARA WH usar Precio3 si es MMONM, sino usar Total7
