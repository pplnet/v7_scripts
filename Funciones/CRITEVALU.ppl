*- Dado un nro. de operacion en np1 determinar por cual criterio valuar
*- to1: Tipo de Operacion 
ACT(cr1,'')
IF Incluido(Copy(val(to1),1,2),'MM|FC')
   *- radio3 para Marktomarket
   IF VAL(ra3)=2
      ACT(cr1,'MToMarket')
   EndIf

   IF VAL(ra3)=1

      *- Verifico si en la lista de operaciones esta esta
      Recorrer&i 1,Elementos(Dialogo.Lista5)
          IF EqStr(val(np1)~' '~val(to1),ItemLista(Dialogo.Lista5,&i))
             ACT(cr1,'MToMarket')             
             Break
          EndIf
      Proximo

   EndIf
   *- radio8 para Mark to model
   IF VAL(ra8)=2
      ACT(cr1,'MToModel')
   EndIf
   IF VAL(ra8)=1
      Recorrer&i 1,Elementos(Dialogo.Lista6)
          IF EqStr(val(np1)~' '~val(to1),ItemLista(Dialogo.Lista6,&i))
             ACT(cr1,'MToModel')             
             Break
          EndIf
      Proximo
   EndIf
   *- radio13 para devengado
   IF VAL(ra13)=2
      ACT(cr1,'Devengado')
   EndIf
   IF VAL(ra13)=1
      *- Verifico si en la lista de operaciones esta esta
      Recorrer&i 1,Elementos(Dialogo.Lista7)
          IF EqStr(val(np1)~' '~val(to1),ItemLista(Dialogo.Lista7,&i))
             ACT(cr1,'Devengado')             
             Break
          EndIf
      Proximo
   EndIf 
   *- radio18 para contable
   IF VAL(ra18)=2
      ACT(cr1,'Contable')
   EndIf
   IF VAL(ra18)=1
      *- Verifico si en la lista de operaciones esta esta
      Recorrer&i 1,Elementos(Dialogo.Lista8)
          IF EqStr(val(np1)~' '~val(to1),ItemLista(Dialogo.Lista8,&i))
             ACT(cr1,'Contable')             
             Break
          EndIf
      Proximo
   EndIf 
EndIf
