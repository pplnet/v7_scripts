SQL.ADD("Select  O.Observac2, O.Especie, O.FechaOp Fecha, ")
SQL.ADD("Sum(O.Cantidad)/1000 Cant from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('AJUSTE') ")
SQL.ADD(" and  O.RB6 = '0' ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" group by O.Observac2, O.Especie, O.FechaOp ")
SQL.ADD(" Union All ")
SQL.ADD("Select  O.Observac2, O.Especie, C.Fecha1 Fecha, ")
SQL.ADD("Sum(C.Cantidad1)/1000 Cant from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and C.Fecha1  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('AJUSMV') ")
SQL.ADD(" and  O.RB6 = '0' ")
if Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" group by O.Observac2, O.Especie, C.Fecha1 ")
if Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select  O.Observac2, O.Especie, O.FechaOp Fecha, ")
   SQL.ADD("Sum(O.Cantidad)/1000 Cant from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('AJUSTE') ")
   SQL.ADD(" and  O.RB6 = '0' ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" group by O.Observac2, O.Especie, O.FechaOp ")
   SQL.ADD(" Union All ")
   SQL.ADD("Select  O.Observac2, O.Especie, C.Fecha1 Fecha, ")
   SQL.ADD("Sum(C.Cantidad1)/1000 Cant from "~DBO~".OPSEVENTUALES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("  and C.Fecha1  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('AJUSMV') ")
   SQL.ADD(" and  O.RB6 = '0' ")
   if Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" group by O.Observac2, O.Especie, C.Fecha1 ")
endif
SQL.ADD("order by 1, 2, 3 ")

act(u:200,' ')
SetFilaActual(val(af:200)+1)
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Observac2'])
     act(u:200,fbn['Observac2'])
     act(a:fac,fbn['Observac2'])
  else
     dfa
  endif
  *** Diario o Mensual ***
  if Dialogo.Radio2 = 0
     *** Diario ***
     Recorrer&i 2, val(d:200)-1
       if fbn['Fecha'] = val(&i:10)
          scn(&i:fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     Recorrer&i val(d:200)+1, val(g:200)-1
       if fbn['Fecha'] = val(&i:10)
          scn(&i:fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
    else
     *** Mensual ***
     Recorrer&i val(m:200), val(n:200)
       if Anio(fbn['Fecha']) = val(val(m:200):280) y Mes(fbn['Fecha']) = val(&i:281)
          scn(&i:fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     if NoVacio(val(o:200))
        Recorrer&i val(o:200), val(p:200)
          if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) = val(&i:281)
             scn(&i:fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
          endif
        Proximo
     endif
     if val(o:200) > 0
        if Anio(fbn['Fecha']) = val(val(o:200):280) y Mes(fbn['Fecha']) > val(val(p:200):281)
           scn(val(p:200)+1:fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
        endif
     endif
     Recorrer&i val(d:200), val(g:200)
       if Anio(fbn['Fecha']) = val(&i:280)
          scn(&i:fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
       endif
     Proximo
     if Anio(fbn['Fecha']) > val(val(g:200):280)
        scn(val(g:200):fac,fbn['Cant']*IIF(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(fbn['Especie'],,,,Dialogo.Fecha1,1)))
     endif
  endif
  SetFont(a:fac..val(b:200):FAC,3)
proximo
ifa
ifa
ifa
AgregarMarco(b:val(q:200)..val(b:200):fac,1,3)
SetFont(a:val(q:200)+1..val(b:200):FAC,3)
ACT(a:FAC, 'Total Ajustes a la Pos.Finan.')
AgregarMarco(a:val(q:200)..a:FAC,2,0)
acn(r:200,fac)
*** Diario o Mensual ***
if Dialogo.Radio2 = 0
   *** Diario ***
   Recorrer&i 2, val(d:200)-1
     if Sum(&i:val(q:200)+1..&i:fac-2) <> 0
        acn(&i:fac,Sum(&i:val(q:200)+1..&i:fac-2))
     endif
   Proximo
   Recorrer&i val(d:200)+1, val(g:200)-1 
     if Sum(&i:val(q:200)+1..&i:fac-2) <> 0
        acn(&i:fac,Sum(&i:val(q:200)+1..&i:fac-2))
     endif
   Proximo
else
   *** Mensual ***
   Recorrer&i val(m:200), val(n:200) 
     if Sum(&i:val(q:200)+1..&i:fac-2) <> 0
        acn(&i:fac,Sum(&i:val(q:200)+1..&i:fac-2))
     endif
   Proximo
   
   if NoVacio(val(o:200))
      Recorrer&i val(o:200), val(p:200)+2         
        if Sum(&i:val(q:200)+1..&i:fac-2) <> 0
           acn(&i:fac,Sum(&i:val(q:200)+1..&i:fac-2))
        endif
      Proximo
   endif
   
   Recorrer&i val(d:200), val(g:200) 
     if Sum(&i:val(q:200)+1..&i:fac-2) <> 0
        acn(&i:fac,Sum(&i:val(q:200)+1..&i:fac-2))
     endif
   Proximo
endif
SetFont(a:fac..val(b:200):FAC,4)
ifa
ifa
ACT(a:FAC, 'Posicion Financiera Ajustada')
AgregarMarco(a:FAC..a:FAC,2,0,Exe('COLOR6'))
acn(s:200,fac)
*** Diario o Mensual ***
if Dialogo.Radio2 = 0
   *** Diario ***
   Recorrer&i 2, val(d:200)-1
     if val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)) <> 0
        acn(&i:fac,val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)))
     endif
   Proximo
   Recorrer&i val(d:200)+1, val(g:200)-1 
     if val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)) <> 0
        acn(&i:fac,val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)))
     endif
   Proximo
  else
   *** Mensual ***
   Recorrer&i val(m:200), val(n:200) 
     if val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)) <> 0
        acn(&i:fac,val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)))
     endif
   Proximo
   if NoVacio(val(o:200))
      Recorrer&i val(o:200), val(p:200) 
        if val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)) <> 0
           acn(&i:fac,val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)))
        endif
      Proximo
   endif
   Recorrer&i val(d:200), val(g:200) 
     if val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)) <> 0
        acn(&i:fac,val(&i:val(h:200))-val(&i:val(i:200))+val(&i:val(r:200)))
     endif
   Proximo
endif
SetFont(a:fac..val(b:200):FAC,2)
ifa
ACT(a:FAC, 'Posicion Financiera Ajustada (acum.)')
AgregarMarco(a:FAC..a:FAC,2,0,Exe('COLOR6'))
acn(t:200,fac)
*** Diario o Mensual ***
if Dialogo.Radio2 = 0
   *** Diario ***
   acn(2:fac,val(2:val(s:200)))
   Recorrer&i 3, val(d:200)-1
     acn(&i:fac,val(&i-1:fac)+val(&i:val(s:200)))
   Proximo
   acn(val(d:200)+1:fac,val(val(d:200)-1:fac)+val(val(d:200)+1:val(s:200)))
   Recorrer&i val(d:200)+2, val(g:200)-1
     acn(&i:fac,val(&i-1:fac)+val(&i:val(s:200)))
   Proximo
else
   *** Mensual ***
   acn(2:fac,val(2:val(s:200)))
   Recorrer&i val(m:200)+1, val(n:200)
     acn(&i:fac,val(&i-1:fac)+val(&i:val(s:200)))
   Proximo
   if NoVacio(val(o:200))
      acn(val(o:200):fac,val(val(n:200):fac)+val(val(o:200):val(s:200)))
      Recorrer&i val(o:200)+1, val(p:200)+1
        acn(&i:fac,val(&i-1:fac)+val(&i:val(s:200)))
      Proximo
   endif
   acn(val(d:200):fac,val(val(p:200)+1:fac)+val(val(d:200):val(s:200)))
   Recorrer&i val(d:200)+1, val(g:200)
     acn(&i:fac,val(&i-1:fac)+val(&i:val(s:200)))
   Proximo
endif
SetFont(a:fac..val(b:200):FAC,2)
ifa
ifa
ifa
ACT(a:FAC, 'Ajustes al Cashflow')
SetFont(a:fac..g:FAC,4)
acn(v:200,fac)

