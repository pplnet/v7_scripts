ACN(m:fac,FBN['Precio4'])
acn(o:fac,IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,val(j:fac)*((FBN['Precio4']+val(l:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1)))
acn(q:fac,IIF(FBN['ImpGastos2']=0,0,(IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,val(j:fac)*((FBN['Precio4']+val(AV:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))*FBN['ImpGastos2']/100)))
acn(p:fac,IIF(FBN['CB10']=0,0,(IIF(FBN['NrCuota']<FBN['PlazoGracia'],0,val(j:fac)*((FBN['Precio4']+val(aw:fac))/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],FBN['RB8']+1))*FBN['TotalAux1']/100)))
acn(z:fac,(val(k:fac)+val(o:fac)))

* Impto.Interes -> Tasa3 es el % Imp.Interes
acn(v:fac,val(o:fac)*FBN['Tasa3']/100 )
acn(ab:fac,val(o:fac)+val(p:fac)+val(v:fac))
acn(aa:fac,val(k:fac)+val(ab:fac))

*-- ta1: Atributo de TTN 
ACT(ta1,'Total3')

