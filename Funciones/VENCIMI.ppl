SQL.ADD("Select ")
SQL.ADD("     O.NrOperacion, ")
SQL.ADD("     E.Nombre, M.Especie, O.Especie Esp, O.Cliente1, M.Cantidad, O.Cantidad Can, O.FechaOp, O.FechaPago, ")
SQL.ADD("     O.FechaVto,O.TotalNetoCli1, O.TotalBrutoCli1, O.TipoOp, O.PaseCB, M.Mercado, ")
SQL.ADD("     O.ContraEspecie,O.TotalIntereses,O.RB4, O.Plazo, O.DiasAnio,O.Precio1,O.Observac3,M.NrGrupo ")
SQL.ADD("    from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M, "~DBO~".ESPECIES E ")
SQL.ADD("   where M.Especie=E.Codigo ")
SQL.ADD("     and O.TipoOp in ('MMPICO','FXC','FXV','TIC','TIV','FXCT','FXVT','FXA','FXAT','IMMPF','TIFC','TIFV','MMCO','MMCT','TICO','TICT','TIRES','MMPF','MMPFCE') ")
SQL.ADD("     and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and ( ")
SQL.ADD("          (O.FechaVto='"~idxdate(Dialogo.Fecha1)~"' and (isnull(O.CB6,'')!='1' or O.TipoOp <> 'IMMPO' ) ) ")
SQL.ADD("          or isnull(O.FechaPago,'01/01/1900')='"~idxdate(Dialogo.Fecha1)~"' ")
SQL.ADD("          or (O.FechaOp = '"~idxdate(Dialogo.Fecha1)~"' and TipoOp in ('MMCO','MMCT','TICO','TICT','IMMPF','MMPF','MMPFCE')) ")
SQL.ADD("         ) ")
SQL.ADD("    and (M.NrOperacion=O.NrOperacion or (O.RB4='1'and M.NrOperacion=O.NrOperacion3) ) ")
SQL.ADD("    and M.FechaMov='"~idxdate(Dialogo.Fecha1)~"' and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    and ( (M.NrSaldo=1  and O.TipoOp in ('MMPICO','FXC','FXV','TIC','TIV','FXCT','FXVT','FXA','FXAT','TIFC','TIFV','MMCO','MMCT','TICO','TICT','TIRES','MMPF','MMPFCE') ) ")
SQL.ADD("      or  (M.NrSaldo=2  and O.TipoOp in ('IMMPF') ) ) ")

SQL.ADD("   union Select  ")

SQL.ADD("     O.NrOperacion,E.Nombre, M.Especie, O.Especie Esp, O.Cliente1, M.Cantidad, O.Cantidad Can, O.FechaOp, O.FechaPago,O.FechaVto, ")
SQL.ADD("     O.TotalNetoCli1, O.TotalBrutoCli1, O.TipoOp, O.PaseCB, M.Mercado, ")
SQL.ADD("     O.ContraEspecie,O.TotalIntereses,O.RB4, O.Plazo, O.DiasAnio,O.Precio1,O.Observac3,M.NrGrupo ")
SQL.ADD("    from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E ")
SQL.ADD("   where  M.Especie=E.Codigo ")
SQL.ADD("     and O.TipoOp in ('MMPICO','FXC','FXV','TIC','TIV','FXCT','FXVT','FXA','FXAT','IMMPF','TIFC','TIFV','MMCO','MMCT','TICO','TICT','TIRES','MMPF','MMPFCE') ")
SQL.ADD("     and  O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and ((O.FechaVto='"~idxdate(Dialogo.Fecha1)~"' and (isnull(O.CB6,'')!='1' or O.TipoOp <> 'IMMPO' ) ) ")
SQL.ADD("         or isnull(O.FechaPago,'01/01/1900')='"~idxdate(Dialogo.Fecha1)~"' ")
SQL.ADD("         or (O.FechaOp = '"~idxdate(Dialogo.Fecha1)~"' and TipoOp in ('MMCO','MMCT','TICO','TICT','IMMPF','MMPF','MMPFCE')) ")
SQL.ADD("         ) ")
SQL.ADD("  and (M.NrOperacion=O.NrOperacion or (O.RB4='1'and M.NrOperacion=O.NrOperacion3) ) ")
SQL.ADD("   and M.FechaMov='"~idxdate(Dialogo.Fecha1)~"' and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and ((M.NrSaldo=1  and O.TipoOp in ('MMPICO','FXC','FXV','TIC','TIV','FXCT','FXVT','FXA','FXAT','TIFC','TIFV','MMCO','MMCT','TICO','TICT','TIRES','MMPF','MMPFCE') ) ")
SQL.ADD("     or (M.NrSaldo=2  and O.TipoOp  in ('IMMPF')) ) ")

SQL.ADD("   Union Select ")

SQL.ADD("     O.NrOperacion, E.Nombre, M.Especie, O.Especie Esp, O.Cliente1, M.Cantidad, O.Cantidad Can, O.FechaOp, O.FechaPago,O.FechaVto, ")
SQL.ADD("     O.TotalBrutoCli3 as TotalNetoCli1, O.TotalBrutoCli1, O.TipoOp, O.PaseCB, M.Mercado, ")
SQL.ADD("     O.ContraEspecie,O.TotalIntereses,O.RB4, O.Plazo, O.DiasAnio,O.Precio1,O.Observac3,M.NrGrupo ")
SQL.ADD("    from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E ") 
SQL.ADD("   where  M.Especie=E.Codigo ")
SQL.ADD("     and O.TipoOp in ('FXOCTC','FXOCTV') ")
SQL.ADD("     and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and M.NrOperacion=O.NrOperacion  ")
SQL.ADD("     and M.FechaMov='"~idxdate(Dialogo.Fecha1)~"' ")
SQL.ADD("     and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and M.NrSaldo=100  ")

SQL.ADD("   Union Select ")

SQL.ADD("     O.NrOperacion, E.Nombre, M.Especie, O.Especie Esp, O.Cliente1, M.Cantidad, O.Cantidad Can, O.FechaOp, O.FechaPago,O.FechaVto, ")
SQL.ADD("     O.TotalNetoCli1, O.TotalBrutoCli1, O.TipoOp, O.PaseCB, M.Mercado, ")
SQL.ADD("     O.ContraEspecie,O.TotalIntereses,O.RB4, O.Plazo, O.DiasAnio,O.Precio1,O.Observac3,M.NrGrupo ")
SQL.ADD("    from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E ")
SQL.ADD("   where  M.Especie=E.Codigo ")
SQL.ADD("     and O.TipoOp in ('FXCTC','FXVTC') ")
SQL.ADD("     and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and M.NrOperacion=O.NrOperacion  ")
SQL.ADD("     and M.FechaMov='"~idxdate(Dialogo.Fecha1)~"' ")
SQL.ADD("     and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and M.NrSaldo=1 ")  

SQL.ADD("   Union Select ")

SQL.ADD("     O.NrOperacion, E.Nombre, M.Especie, O.Especie Esp, O.Cliente1, M.Cantidad, O.Cantidad Can, O.FechaOp, O.FechaPago,O.FechaVto, ")
SQL.ADD("     O.TotalNetoCli1, O.TotalBrutoCli1, O.TipoOp, O.PaseCB, M.Mercado, ")
SQL.ADD("     O.ContraEspecie,O.TotalIntereses,O.RB4, O.Plazo, O.DiasAnio,O.Precio1,O.Observac3,M.NrGrupo ")
SQL.ADD("    from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M, "~DBO~".ESPECIES E ")
SQL.ADD("   where  M.Especie=E.Codigo ")
SQL.ADD("     and O.TipoOp in ('FXCTC','FXVTC') ")
SQL.ADD("     and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and M.NrOperacion=O.NrOperacion  ")
SQL.ADD("     and M.FechaMov='"~idxdate(Dialogo.Fecha1)~"' ")
SQL.ADD("     and M.EnteCustodia='"~Dialogo.Vehiculo1~"' ")
SQL.ADD("     and M.NrSaldo=1 ")  

SQL.ADD("   Union Select ")

SQL.ADD("     O.NrOperacion, E.Nombre, O.Especie, O.Especie Esp, O.Cliente1, O.Cantidad, O.Cantidad Can, O.FechaOp, O.FechaPago,O.FechaVto, ")
SQL.ADD("     O.TotalNetoCli1, O.TotalBrutoCli1, O.TipoOp, O.PaseCB, O.Mercado, ")
SQL.ADD("     O.ContraEspecie,O.TotalIntereses,O.RB4, O.Plazo, O.DiasAnio,O.Precio1,O.Observac3, 1 ")
SQL.ADD("    from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E")
SQL.ADD("   where  O.Especie=E.Codigo")
SQL.ADD("     and O.TipoOp in ('PMU','PME')")
SQL.ADD("     and O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
SQL.ADD("     and O.FechaVto='"~idxdate(Dialogo.Fecha1)~"' ") 

SQL.ADD("    order by 3, 5, 15, 13, 1 ")