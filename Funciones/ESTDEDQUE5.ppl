If Dialogo.Check1=1 O Dialogo.Radio3=1
******************** P R E S T A M O S   F I N A N C I E R O S ***************************

***** U N I C O  V E N C I M I E N T O *****

IF Dialogo.Radio2 = 0
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, 'Consolidado' Vehiculo1, ")
ELSE
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Vehiculo1, ")
ENDIF
SQL.ADD(" O.Cliente1, O.Especie, '' ContraEspecie, O.FechaOp FechaIni, O.Plazo Plaz, O.FechaVto FechaFin, O.Cantidad CapOrig, ")
SQL.ADD(" O.Cantidad CapAmort, O.TotalIntereses Intereses, CASE WHEN TipoOp ='MMPCL' THEN 0 ELSE O.TotalAux3 END AS WHT, ")
SQL.ADD("  CASE WHEN TipoOp ='MMPCL' THEN 0 ELSE O.TotalAux1 END AS TasaWHT, O.TotalIVA IVA, O.TotalNetoCli1 TotPagar, ")
SQL.ADD("  (O.Precio1 + O.Spread) TNA, O.RB8, 1 Num, O.RB6, O.Precio4 Resultado, 0 Sellos, O.RB10  ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and  O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")

SQL.ADD("   and O.TipoOp in ('MMPCL', 'MMPCOS','MMPE','MMPI') ")

***// Filtro por Contraparte
   SQL.ADD("   and O.Cliente1 in ("~Pipe2Comillas(Val(CL:1))~") ")

If Val(GR:1)=0
   ***// Si se agrupa por producto, se trae todos los vehiculos del dialogo y habilitados para el usuario
   SQL.ADD("   and O.Vehiculo1 in ("~Pipe2Comillas(Val(VH:1))~") ")
   If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD("   and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
   EndIf
Else
   ***/// Si se agrupa por vehiculo, se trae del vehiculo que corresponde
   SQL.ADD("   and O.Vehiculo1 = '"~Val(VH:2)~"' ")
Endif

SQL.ADD(" Union All")

***** M U L T I V E N C I M I E N T O *****

IF Dialogo.Radio2 = 0
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, 'Consolidado' Vehiculo1, ")
ELSE
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Vehiculo1, ")
ENDIF
SQL.ADD(" O.Cliente1, O.Especie, '' ContraEspecie, C.Fecha1 FechaIni, C.Plazo1 Plaz, C.Fecha2 FechaFin, O.Cantidad CapOrig, ")
SQL.ADD(" C.Cantidad1 CapAmort, C.Cantidad3 Intereses, CASE WHEN TipoOp ='MMPCLM' THEN 0 ELSE C.Total7 END AS WHT, ")
SQL.ADD(" CASE WHEN TipoOp ='MMPCLM' THEN 0 ELSE O.TotalAux1 END AS TasaWHT, C.Total4 IVA, C.Total1 TotPagar, ")
SQL.ADD(" (C.Precio2 + C.Precio4) TNA, O.RB8, 1 Num, O.RB6, C.Total2 Resultado,   ")

SQL.ADD(" CASE WHEN O.TipoOp = 'MMPIM' THEN 0 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPEM' THEN 0 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPOSM' AND O.RB12 = 0 AND O.RB13 = 0 AND C.NrCuota = 1 THEN 999 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPOSM' AND O.RB12 = 0 AND O.RB13 = 0 AND C.NrCuota > 1 THEN 0   ")
SQL.ADD("      WHEN O.TipoOp = 'MMPOSM' AND O.RB12 = 0 AND O.RB13 = 1 THEN C.Cantidad11          ")
SQL.ADD("      WHEN O.TipoOp = 'MMPOSM' AND O.RB12 = 1 THEN 0 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPCLM' AND O.RB12 = 0 AND O.RB13 = 0 AND C.NrCuota = 1 THEN 999 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPCLM' AND O.RB12 = 0 AND O.RB13 = 0 AND C.NrCuota > 1 THEN 0 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPCLM' AND O.RB12 = 0 AND O.RB13 = 1 THEN C.Cantidad11 ")
SQL.ADD("      WHEN O.TipoOp = 'MMPCLM' AND O.RB12 = 1 THEN 0           END Sellos, O.RB10 ")

SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C")
SQL.ADD(" Where C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and   O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")

SQL.ADD("   and O.NrOperacion = C.NrOperacion")
SQL.ADD("   and O.TipoOp in ('MMPCLM','MMPEM','MMPIM','MMPOSM', 'SEPTMV','MMLEAS') ")

***// Filtro por Contraparte
   SQL.ADD("   and O.Cliente1 in ("~Pipe2Comillas(Val(CL:1))~") ")

If Val(GR:1)=0
   ***// Si se agrupa por producto, se trae todos los vehiculos del dialogo y habilitados para el usuario
   SQL.ADD("   and O.Vehiculo1 in ("~Pipe2Comillas(Val(VH:1))~") ")
   If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD("   and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
   EndIf
Else
   ***/// Si se agrupa por vehiculo, se trae del vehiculo que corresponde
   SQL.ADD("   and O.Vehiculo1 = '"~Val(VH:2)~"' ")
Endif

SQL.ADD(" Order by Vehiculo1, Especie, NrOperacion, FechaFin ")

(.'ESTDEDVAR'.)

Recorrer SQL  
   If Dialogo.Radio4=0
      (.'ESTDEDSQL'.)
   Else
      (.'ESTDEDSQLR'.)
   Endif
Proximo

If Dialogo.Radio4=0
   (.'ESTDEDUR'.)
Else
   (.'ESTDEDURR'.)
Endif

ENDIF



