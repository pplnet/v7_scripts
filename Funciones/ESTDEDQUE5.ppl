If Dialogo.Check3=1 O Dialogo.Radio3=1
************************  D E S C U B I E R T O S  ***************************

*****  P O R   P A C T A D O  *****

IF Dialogo.Radio2 = 0
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, 'Consolidado' Vehiculo1, ")
ELSE
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Vehiculo1, ")
ENDIF
SQL.ADD(" O.Cliente1, O.Especie, '' ContraEspecie, O.FechaOp FechaIni, O.Plazo Plaz, O.FechaVto FechaFin, O.Cantidad CapOrig, ")
SQL.ADD("  0 CapAmort, O.TotalIntereses Intereses, O.TotalIVA IVA, 0 WHT, 0 TasaWHT,  ")
SQL.ADD("  O.TotalIntereses TotPagar, (O.Precio1 + O.Spread) TNA, O.RB8, 5 Num, O.RB6, O.Precio4 Resultado, 0 Sellos, O.RB10 ")

SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")

SQL.ADD("   and O.RB10 = 1 ")
SQL.ADD("   and O.TipoOp in ('MMDPAC') ")

***// Filtro por Contraparte
   SQL.ADD("   and O.Cliente1 in ("~Pipe2Comillas(Val(CL:1))~") ")

If Val(GR:1)=0
   ***// Si se agrupa por producto, se trae todos los vehiculos del dialogo y habilitados para el usuario
   SQL.ADD("   and O.Vehiculo1 in ("~Pipe2Comillas(Val(VH:1))~") ")
   If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD("   and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
   EndIf
Else
   ***/// Si se agrupa por vehiculo, se trae del vehiculo que corresponde
   SQL.ADD("   and O.Vehiculo1 = '"~Val(VH:2)~"' ")
Endif


SQL.ADD(" Union All")


*****  P O R   C O N S U M I D O  *****

IF Dialogo.Radio2 = 0
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, 'Consolidado' Vehiculo1, ")
ELSE
   SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Vehiculo1, ")
ENDIF
SQL.ADD(" O.Cliente1, O.Especie, '' ContraEspecie, CASE WHEN C.Fecha2 is NULL THEN O.FechaOp ELSE C.Fecha2 END as FechaIni, O.Plazo Plaz, ")
SQL.ADD(" CASE WHEN C.Fecha3 is NULL THEN O.FechaVto ELSE C.Fecha3 END as FechaFin, O.Cantidad CapOrig, 0 CapAmort, ")
SQL.ADD(" CASE WHEN C.Fecha1 is not NULL THEN C.Cantidad2 ELSE O.TotalIntereses END as Intereses, 0 AS WHT, 0 AS TasaWHT, 0 IVA, ")
SQL.ADD(" CASE WHEN C.Fecha1 is not NULL THEN C.Cantidad2 ELSE O.TotalIntereses END as TotPagar, ")
SQL.ADD(" (O.Precio1 + O.Spread) TNA, O.RB8, 5 Num, O.RB6, O.Precio4 Resultado, 0 Sellos, O.RB10  ")

SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C")
SQL.ADD(" Where O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and   O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")

***/// Outter join. Si no fue procesado, trae la operacion igual.
SQL.ADD("   and O.NrOperacion *= C.NrOperacion")
SQL.ADD("   and O.TipoOp = 'MMDPAC' ")
SQL.ADD("   and O.RB10 = 0 ")

***// Filtro por Contraparte
   SQL.ADD("   and O.Cliente1 in ("~Pipe2Comillas(Val(CL:1))~") ")

If Val(GR:1)=0
   ***// Si se agrupa por producto, se trae todos los vehiculos del dialogo y habilitados para el usuario
   SQL.ADD("   and O.Vehiculo1 in ("~Pipe2Comillas(Val(VH:1))~") ")
   If NoVacio(Dialogo.Vehiculo2)
      SQL.ADD("   and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
   EndIf
Else
   ***/// Si se agrupa por vehiculo, se trae del vehiculo que corresponde
   SQL.ADD("   and O.Vehiculo1 = '"~Val(VH:2)~"' ")
Endif

SQL.ADD(" Order by Vehiculo1, Especie, NrOperacion, FechaFin ")

(.'ESTDEDVAR'.)

Recorrer SQL
   If Dialogo.Radio4=0
      (.'ESTDEDSQL'.)
   Else
      (.'ESTDEDSQLR'.)
   Endif
   ACN(H:fac, Val(G:FAC) - Dialogo.Fecha1)
   If Val(H:fac)<0
     ACN(H:fac, 0)
   Endif
   FormatoCeldas(H:fac..H:fac,"0")
Proximo

If Dialogo.Radio4=0
   (.'ESTDEDUR'.)
Else
   (.'ESTDEDURR'.)
Endif

ENDIF




If Dialogo.Check4=1 O Dialogo.Radio3=1
******************* O B L I G A C I O N E S  N E G O C I A B L E S *********************

