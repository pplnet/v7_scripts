scn(c:200,2)
scn(d:200,2)
scn(f:200,3)
scn(g:200,3)

SQL.ADD("Select O.Vehiculo1, O.Especie, O.RB5, ")
SQL.ADD("Sum(O.Cantidad)/1000 Monto from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('AJUCOB') ")
SQL.ADD(" and  O.RB6 = '0' ")
SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and  O.Especie Not In ("~val(en1)~") ")
SQL.ADD("group by O.Vehiculo1, O.Especie, O.RB5 ")
SQL.ADD("order by 1, 2 ")

act(u:200,' ')
Recorrer SQL
  if Not EqStr(val(u:200),fbn['Vehiculo1'])
     Recorrer&i 3, val(b:200)
        if EqStr(fbn['Vehiculo1'],val(&i:2))
           acn(e:200,&i)
           Break
        endif
     Proximo
     act(u:200,fbn['Vehiculo1'])
  endif

  If Not EqStr(val(aa:200),fbn['Especie'])
     *- Cotizacion
     ACN(zz2, CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,Val(me1)))
     ACT(aa:200, fbn['Especie'] ) 
  Endif

  if Incluido(fbn['Especie'],'ARP')
     if fbn['Monto'] > 0
        scn(val(e:200):val(c:200),fbn['Monto'])
        scn(val(e:200):val(h:200),fbn['Monto'])
        SetFont(val(e:200):val(c:200)..val(e:200):val(c:200),3)
       else
        scn(val(e:200):val(f:200),Abs(fbn['Monto']))
        scn(val(e:200):val(i:200),Abs(fbn['Monto']))
        SetFont(val(e:200):val(f:200)..val(e:200):val(f:200),3)
     endif
    else
     if fbn['Monto'] > 0
        scn(val(e:200):val(d:200),fbn['Monto']*Val(zz2))
        scn(val(e:200):val(k:200),fbn['Monto']*Val(zz2))
        SetFont(val(e:200):val(d:200)..val(e:200):val(d:200),3)
       else
        scn(val(e:200):val(g:200),Abs(fbn['Monto'])*Val(zz2))
        scn(val(e:200):val(l:200),Abs(fbn['Monto'])*Val(zz2))
        SetFont(val(e:200):val(g:200)..val(e:200):val(g:200),3)
     endif
   endif

   if EqStr(fbn['RB5'],'0')
      if fbn['Monto'] > 0
         scn(val(e:200):val(t:200),Abs(fbn['Monto'])*Val(zz2))
         scn(b:val(t:200),Abs(fbn['Monto'])*Val(zz2))
         SetFont(val(e:200):val(t:200)..val(e:200):val(t:200),3)
        else
         scn(val(e:200):val(v:200),Abs(fbn['Monto'])*Val(zz2))
         scn(b:val(v:200),Abs(fbn['Monto'])*Val(zz2))
         SetFont(val(e:200):val(v:200)..val(e:200):val(v:200),3)
      endif
     else
      if fbn['Monto'] > 0
         scn(val(e:200):val(x:200),Abs(fbn['Monto'])*Val(zz2))
         scn(b:val(x:200),Abs(fbn['Monto'])*Val(zz2))
         SetFont(val(e:200):val(x:200)..val(e:200):val(x:200),3)
        else
         scn(val(e:200):val(w:200),Abs(fbn['Monto'])*Val(zz2))
         scn(b:val(w:200),Abs(fbn['Monto'])*Val(zz2))
         SetFont(val(e:200):val(w:200)..val(e:200):val(w:200),3)
      endif
  endif
proximo

scn(c:200,-1)
scn(d:200,-1)
scn(f:200,-1)
scn(g:200,-1)

