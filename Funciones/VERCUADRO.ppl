*
*PARAMETROS DE ENTRADA:
*                  SW1: donde SW1=1 indica Swaps de Tasa de Interes, y 0 swaps de tipo de cambio
*                  MO1: Moneda en la que esta expresado
*

ACT(a:fac,'Banco')
ACT(b:fac,'Fecha')
ACT(b:fac+1,'Origen')
ACT(c:fac,'Fecha')
ACT(c:fac+1,'Valor')
ACT(d:fac,'Fecha')
ACT(d:fac+1,'Vto')
ACT(e:fac,'                   Moneda')
ACT(e:fac+1,'Vehiculo')
ACT(f:fac+1,'Contrap.')
ACT(g:fac,'NrMinuta')
ACT(h:fac,'                      Fecha Periodo')
ACT(h:fac+1,'Inicial')
ACT(i:fac+1,'Final')
ACT(j:fac,'                                   Capital Residual')
ACT(j:fac+1,'Vehiculo')
ACT(k:fac+1,'Contraparte')
ACT(l:fac,'                                       Amortizacion')
ACT(l:fac+1,'Vehiculo')
ACT(m:fac+1,'Contraparte')
ACT(n:fac, FBN['Vehiculo1'])
ACT(n:fac+1,'Paga')
ACT(o:fac, FBN['Vehiculo1'])
ACT(o:fac+1,'Recibe')
ACT(p:fac+1,'A Recibir')
ACT(q:fac+1,'A Pagar')
ACT(r:fac,'Dias Trans.')
ACT(s:fac,'                   INTERESES DEVENG.')
ACT(s:fac+1,'A Recibir')
ACT(t:fac+1,'A Pagar')
ACT(u:fac,'                                  TOTAL')
if Val(SW1)=0
   ACT(w:fac, 'TC')
   ACT(p:fac,'             INTERESES ')
   ACT(u:fac+1,'A Recibir Moneda Original')
   ACT(v:fac+1, 'A Pagar Dolares' )

   ** Para Swaps de tipo de cambio varian algunos nombres de columnas (se adiciona texto al existente)
   ACT(j:fac+1, Val(j:fac+1)~' Dolares')   
   ACT(k:fac+1, Val(k:fac+1)~' Moneda Original')
   ACT(l:fac+1, Val(l:fac+1)~' Dolares')   
   ACT(m:fac+1, Val(m:fac+1)~' Moneda Original')
   ACT(q:fac+1, Val(q:fac+1)~' Dolares')   
   ACT(p:fac+1, Val(p:fac+1)~' Moneda Original')
   ACT(t:fac+1, Val(t:fac+1)~' Dolares')   
   ACT(s:fac+1, Val(s:fac+1)~' Moneda Original')
else
   ACT(p:fac,'                      INTERESES TOTALES')
endif

AlinearCeldas(a:fac..w:fac+1,'C')
AlinearCeldas(p:fac,'I')
AlinearCeldas(s:fac,'I')
AlinearCeldas(u:fac,'I')
SetFont(a:fac..w:fac+1,1)

AgregarMarco(a:fac..d:fac+1,2,2,Exe('COLOR8'))
AgregarMarco(a:fac..t:fac+1,2,0,Exe('COLOR8'))
AgregarMarco(e:fac..f:fac,2,0,Exe('COLOR8'))
AgregarMarco(e:fac+1..f:fac+1,2,3,Exe('COLOR8'))
AgregarMarco(h:fac..i:fac,2,0,Exe('COLOR8'))
AgregarMarco(h:fac+1..i:fac+1,2,3,Exe('COLOR8'))
AgregarMarco(j:fac..k:fac,2,0,Exe('COLOR8'))
AgregarMarco(j:fac+1..k:fac+1,2,3,Exe('COLOR8'))
AgregarMarco(l:fac..m:fac,2,0,Exe('COLOR8'))
AgregarMarco(l:fac+1..m:fac+1,2,3,Exe('COLOR8'))
AgregarMarco(n:fac..o:fac+1,2,2,Exe('COLOR8'))

AgregarMarco(p:fac+1..q:fac+1,2,3,Exe('COLOR8'))
AgregarMarco(p:fac..q:fac,2,0,Exe('COLOR8'))
*AgregarMarco(r:fac..r:fac+1,2)

AgregarMarco(s:fac..t:fac,2,0,Exe('COLOR8'))
AgregarMarco(s:fac+1..t:fac+1,2,3,Exe('COLOR8'))
if Val(SW1)=0
    AgregarMarco(u:fac..v:fac,2,0,Exe('COLOR8'))
    AgregarMarco(u:fac+1..v:fac+1,2,3,Exe('COLOR8'))
    AgregarMarco(w:fac..w:fac+1,2,0,Exe('COLOR8'))
    ACN(co1,23)
else
    AgregarMarco(u:fac..v:fac+1,2,0,Exe('COLOR8'))
    *AgregarMarco(p:fac+1..q:fac+1,2,3,Exe('COLOR8'))
    ACN(co1,22)
endif

SetFilaActual(fac+2)