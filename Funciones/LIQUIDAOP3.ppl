SQL.ADD("FROM  "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("      , "~DBO~".CLIENTES C ")
If Dialogo.Radio6=1
   *- Agente
   SQL.ADD(", "~DBO~".MINUTASBOLSA MI ")
Endif
SQL.ADD("WHERE M.NrOperacion = O.NrOperacion")
SQL.ADD("      and M.NrOperacion = B.NrOperacion")
SQL.ADD("      and M.Cliente = C.Codigo ")
SQL.ADD("      and O.NrOperacion = B.NrOperacion ")
If Dialogo.Radio6=1
   *- Agente
   SQL.ADD("  and M.Book = MI.NrMinuta ")
Endif

SQL.ADD("  and B.NrBit = 10  ")
SQL.ADD("  and B.Valor = '1' ") 

If Dialogo.Radio6=1 
   If Dialogo.Radio3=0 
      SQL.ADD("  and  ( O.TipoOp not in ('PBT','PBC','PBTC') or    ")   
      SQL.ADD("       ( M.Especie in ('ARP','USD','USB') and       ")
      SQL.ADD("          O.TipoOp in ('PBT','PBC','PBTC')  ) )     ")   
   Else 
      SQL.ADD("  and   ( M.Especie not in ('ARP','USD','USB') and   ")
      SQL.ADD("          O.TipoOp in ('PBT','PBC','PBTC')         ) ")   
   Endif
Else
   If Dialogo.Radio3=0 
      SQL.ADD("  and O.TipoOp not in ('PBT','PBC','PBTC')  ")   
   Else
      SQL.ADD("  and O.TipoOp in ('PBT','PBC','PBTC')  ")   
   Endif
Endif

if Dialogo.Radio6=0
   *- Cliente
   SQL.ADD("  and M.Cliente = O.Cliente1 ")
endif
if Dialogo.Radio6=1
   *- Agente 
   SQL.ADD("  and M.Cliente = O.Cliente2 ")
endif

If Dialogo.Radio2=0 o Dialogo.Radio2 = 4
   If Dialogo.Radio7=0
      SQL.ADD("  and C.CategDepositante NOT IN ("~Pipe2Comillas(VAR('NOCLIENTES'))~") ")
   Else
      SQL.ADD("  and C.CategDepositante IN ("~Pipe2Comillas(VAR('NOCLIENTES'))~") ")
   Endif
Endif

If Dialogo.Radio6=0 o Dialogo.Radio7=0 o Dialogo.Radio7=1
   SQL.ADD("  and M.NrSaldo = 1 ")
Else
   If Dialogo.Radio6=1 
      SQL.ADD("  and (M.NrSaldo = 1 or M.NrSaldo = 8) ")
   Else
      If Dialogo.Radio6=2 
         SQL.ADD("  and M.NrSaldo = 8 ")
      Endif 
   Endif
Endif

SQL.ADD("  and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("  and M.FechaMov    <= '"~IdxDate(Dialogo.Fecha1)~"' ")

if NoVacio(Dialogo.Cliente1)     
   SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif

if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif

If Dialogo.Radio2=3
   SQL.ADD("and M.Concepto = 'BOLSA' ") 
   If Dialogo.Radio6=2 
      SQL.ADD("and ( M.NrMov = 18  or M.NrMov =28  or M.NrMov = 38) ")                 
   endif 
Else
   If Dialogo.Radio2=4
      SQL.ADD("and M.Concepto = 'TCOPRI' ")
   Else 
      SQL.ADD("and M.Concepto<>'BOLSA' and M.Concepto <> 'TCOPRI' ")
   Endif 
Endif



