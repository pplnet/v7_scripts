***TotalIntereses
ACN(o:fac,IIF(Incluido(VAL(e:FAC),Var('CLIRED')) Y EQSTR(VAL(i:FAC),'USD'),ROUND(val(j:fac)*(FBN['Spread']+val(l:fac))*VAL(h:FAC)/IIF(fbn['RB8']=1,36500,36000),0),val(j:fac)*(FBN['Spread']+val(l:fac))*VAL(h:FAC)/IIF(fbn['RB8']=1,36500,36000)))
***TotalRetenciones
ACN(ac:FAC,IIF(DESCIENDEDECLIENTE(VAL(e:FAC),'BANCOS') Y EqStr('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(e:FAC))),VAL(o:FAC)*fbn['ImpGastos1']/100,0))
***TotalNetoCli2
ACN(ab:fac,VAL(o:FAC)-VAL(ac:FAC))
***TotalBrutoCli1
ACN(z:FAC,val(j:fac)+val(o:fac))
***TotalNetoCli1
ACN(aa:FAC,VAL(z:FAC)-VAL(ac:FAC))
***TotalAux1
ACN(ta:81,IIF(NOT DESCIENDEDECLIENTE(VAL(e:FAC),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(e:FAC))),(VAL(o:FAC)*fbn['ImpGastos2'])/100,0))
***TotalAux3
ACN(ta:83,IIF(NOT DESCIENDEDECLIENTE(VAL(e:FAC),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(e:FAC))),(Val(o:FAC)*VAR('RG3337'))/100,0))
***TotalIVA
ACN(q:FAC,IIF(NOT DESCIENDEDECLIENTE(VAL(e:FAC),'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',VAL(e:FAC))),VAL(ta:81)+VAL(ta:83),0))
***PrecioMer
ACN(pr:80,VAL(z:FAC)*COTIZACIONC(VAL(i:FAC),,,,Fsys,1,SI,SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~VAL(e:FAC)~"' AND Limite='COTOR' ")))