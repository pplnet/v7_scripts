
SQL.ADD("Select *  From "~DBO~".ESPECIES Where Codigo='"~Dialogo.Especie1~"' ") 

Recorrer SQL
    dfa
    ACT(is1,FBN['ISIN'])
    ACN(tl1,fbn('TamanioLote'))
Proximo

SQL.ADD(" Select Max(Fecha) as Fecha,Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,")
SQL.ADD(" Book From "~DBO~".POSICIONES P1 ")
SQL.ADD(" Where CantidadFin<>0 and P1.Especie='"~Dialogo.Especie1~"' and P1.Fecha<='"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" Group By Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,Book ")

Recorrer SQL
   DFA

   If Vacio(val(y1))
      ACT(y:1, GetNumerador(1))   

      Message('Inserto una sola transaccion Nro. '~Val(y:1)~' .... ')       
      (."GENDIVIDE".)
   EndIf

   Message(" Verificando Posiciones NrSaldo= "~Fstr(FBN['NrSaldo'],0,0)~' '~FBN['Vehiculo']~' '~FBN['PrecioEj']~' '~FBN['FechaEj']~' '~FBN['Book'])

   SQL.ADD("Select *  From "~DBO~".POSICIONES P Where Especie='"~Dialogo.Especie1~"' ") 
   SQL.ADD(" and CantidadFin<>0 and Fecha='"~IdxDate(FBN['Fecha'])~"' ")
   SQL.ADD(" and Cliente='"~FBN['Cliente']~"' and Vehiculo='"~FBN['Vehiculo']~"' ")
   SQL.ADD(" and NrSaldo="~Fstr(FBN['NrSaldo'],0,0)~" ")
   If NoVacio(FBN['PrecioEj'])
      SQL.ADD(" and PrecioEj="~Fstr(FBN['PrecioEj'],0,8)~" ")
   Else 
      SQL.ADD(" and (PrecioEj='' or PrecioEj Is Null or PrecioEj=' ') ")
   EndIf
   If NoVacio(FBN['FechaEj'])
      SQL.ADD(" and FechaEj='"~IdxDate(FBN['FechaEj'])~"' ")
   Else 
      SQL.ADD(" and (FechaEj='' or FechaEj Is Null or FechaEj=' ') ")
   EndIf
   If NoVacio(FBN['CallPut'])
      SQL.ADD(" and CallPut='"~FBN['CallPut']~"' ")
   Else 
      SQL.ADD(" and (CallPut='' or CallPut Is Null or CallPut=' ') ")
   EndIf  
***   If NoVacio(FBN['Cupon'])
***      SQL.ADD(" and Cupon='"~FBN['Cupon']~"' ")
***   Else 
***      SQL.ADD(" and (Cupon='' or Cupon Is Null or Cupon=' ') ")
***   EndIf
   If NoVacio(FBN['Book'])
      SQL.ADD(" and Book='"~FBN['Book']~"' ")
   Else 
      SQL.ADD(" and (Book='' or Book Is Null or Book=' ') ")
   EndIf

   Recorrer SQL
      Message("Verificando Posiciones NrSaldo= "~Fstr(FBN['NrSaldo'],0,0))
    
      ACN(z:2,FBN['CantidadFin'])
      ACN(aa:fac,FBN['PrecioFin'])

      ACT(a:fac, fbn('Especie'))
      ACT(b:fac, fbn('Cupon'))
      ACN(c:fac, fbn('NrSaldo'))
      ACT(d:fac, fbn('Vehiculo'))
      ACT(g:fac, fbn('Cliente'))
      ACT(v:fac, fbn('Book'))

      ACN(i:fac, Val(z:2))
      ACT(j:fac, val(is1))

      ACN(k:fac, Dialogo.Precio1)
  
      ACT(o:fac, fbn('CallPut'))
      ACD(p:fac, fbn('FechaEj'))
      ACN(q:fac, fbn('PrecioEj'))
      ACN(r:fac, val(tl1))
      ACT(t:fac, fbn('Sector'))

      IF Not Incluido(Val(o:fac), 'CAL|PUT')
         ACN(r:fac, 1)
      ENDIF

      ACN(x:fac, 1)
      SCN(z:1, 1)

      acn(bi:fac,val(z2)*VAL(aa:fac))    

      *-- Calculo el Precio del Dividendo en Efectivo => Solamente cambia el precio
      If Dialogo.Check1=1 
         ACN(k:fac, Dialogo.Precio1)
         acn(l:fac, val(z2)*(Dialogo.Precio1/100))    

         *- bh: Preciofin - % Efectivo  bi: CantidadFin*PrecioEfectivo
         acn(bh:fac,val(aa:fac)-(Dialogo.Precio1/100))    
         acn(bi:fac,val(z2)*VAL(bh:fac))    
      EndIf

      If Dialogo.Check2=1
         ACN(n:fac, Dialogo.Precio2)        
         acn(s:fac,val(z2)*(Dialogo.Precio2/100))    
      EndIf

      If Dialogo.Check3 = 1
         *- Revaluo
         acn(w:fac, Val(z:2)*(Dialogo.Precio9/100))
      Endif

      *-- Saldo + Dividendo en Acciones + Revaluo
      acn(ba:fac, Val(z:2)+val(s:fac)+val(w:fac))

      If Dialogo.Check4 = 1
         *-- Canje 
         acn(bb:fac, val(ba:fac)*(Dialogo.Precio10/100))
         acn(ba:fac, val(bb:fac))
      EndIf

      *-- Calcula la fraccion 
      acn(bc:fac, val(ba:fac)/Dialogo.Precio3)
      acn(bd:fac, Trunc(val(ba:fac)/Dialogo.Precio3))
      acn(be:fac, (Val(bc:fac)-Val(bd:fac))*Dialogo.Precio3)
      acn(bf:fac, val(be:fac))
      acn(bg:fac, Round(val(bf:fac)*Dialogo.Precio4/0.01)*0.01)

      *- Monto en Efectivo 
      acn(l:fac, val(l:fac) + val(bg:fac) )

      *- Monto en Acciones
      acn(s:fac, (val(s:fac)+val(w:fac)+val(bb:fac))-val(be:fac))

      If Dialogo.Check2=1
         acn(bh:fac,VAL(bi:fac)/(val(z2)+VAL(s:fac)))       
      EndIf

      ACN(fi1,fac)
      
      (.'DIVIINSPOS'.)

   Proximo
Proximo

