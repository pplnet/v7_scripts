**// Para los voucher que liquidan en Fecha Settlement, Fecha Valor = FechaVto.
If Eqstr(Copy(FBN('TipoOp'),1,2), 'MM')
   SQL.ADD(" Select Max(Fecha2) Fecha2 ")
   SQL.ADD(" From "~DBO~".CUOTAS ")
   SQL.ADD(" Where NrOperacion = '"~FBN('NrOperacion')~"' ")
   SQL.ADD(" and Fecha2 <= '"~IdxDate(Val(FV:1))~"' ")
   **//SQL.ADD(" and NrOperacion = 'G1000340' ")
   Recorrer SQL
      If Not Vacio(FBN('Fecha2'))
         **MessageBox('Fecha Set'~Fecha(Val(FV:1)))
         ACD(FV:1, FBN('Fecha2'))
         **MessageBox('Fecha Vto'~Fecha(Val(FV:1)))
      Endif
   Proximo
Endif