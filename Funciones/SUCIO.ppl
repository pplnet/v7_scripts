*** ca:fac: Especie, ck:fac: Fecha de interes ***
IF Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',val(ca:fac)),'CLE')
   acn(cb:fac,EspecieDiasAnio(val(ca:fac)))
   acn(cc:fac,EspecieDiasMes(val(ca:fac)))
   acn(cd:fac,iif(val(cb:fac)=0 y val(cc:fac)=0,1,0))
   acn(ce:fac,BuscarCampo('Especies','TasaIntVigente','Codigo',val(ca:fac)))
   acd(cf:fac,BuscarCampo('Especies','FechaCambioTasa','Codigo',val(ca:fac)))
   If Val(cc:fac) = 0 o EsHabil(UltCupon2(val(ca:fac),val(ck:fac)),'USA')
      acd(cg:fac,UltCupon2(val(ca:fac),val(ck:fac)))
   Else
      acd(cg:fac,Habiles(UltCupon2(val(ca:fac),val(ck:fac)),BuscarCampo('EspecieS','Valor10','Codigo',val(ca:fac)),'USA'))
   Endif
   If Val(cf:fac) > Val(cg:fac) y Val(cf:fac) <= val(ck:fac)
      acn(ch:fac,((BUSCARCAMPO('Especies','TasaIntAnterior','Codigo',val(ca:fac))*iif(Val(cd:fac)=1,Dif360(Val(cg:fac),Val(cf:fac)-1,2),DifDias(Val(cg:fac),Val(cf:fac)-1,'USA',NO)))+(Val(ce:fac)*(iif(Val(cd:fac)=1,Dif360(Val(cf:fac)-1,val(ck:fac),2),DifDias(Val(cf:fac)-1,val(ck:fac),'USA',NO)))))/(iif(Val(cd:fac)=1,Dif360(Val(cg:fac),val(ck:fac),2),DifDias(Val(cg:fac),val(ck:fac),'USA',NO)))*100)
   Else
      acn(ch:fac,Val(ce:fac)*100)
   Endif
   acn(cj:fac,Val(ch:fac)*iif(Val(cd:fac)=1,Dif360(Val(cg:fac),val(ck:fac),2),DifDias(Val(cg:fac),val(ck:fac),'USA',NO))/(DiasA(Val(cb:fac),FSYS,BuscarCampo('Especies','Valor9','Codigo',val(ca:fac)))*100))

   acn(ci:fac,ValorTeorico2(val(ca:fac),FSYS))
Else
   acn(cj:fac,0)
   acn(ci:fac,1)
Endif
