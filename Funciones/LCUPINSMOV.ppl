*- mp1: Nro. Transaccion 
*- mp2: Fecha Movimiento  
*- mp3: Cliente 
*- mp4: Especie  
*- mp5: CallPut  
*- mp6: FechaEj  
*- mp7: PrecioEj  
*- mp8: Mercado
*- mp9: EnteCustodia  
*- mp10: Cantidad  
*- mp11: Formula  
*- mp12: Leyenda  
*- mp13: Bits  
*- mp14: NrSaldo   
*- mp15: NrGrupo
*- mp16: Concepto (NrSaldo Original)
*- mp19: Cuenta  
*- mp22: Nro. de Movimiento  
*- mp20: NrGrupo2
*- mp23: Com.Renta  
*- mp25: Com.Amortizacion
*- mp27: Cupon   

*- Seteo el tipo de movimiento Automatico-Manual
*- jo1=1 -> Algunos Bits AV y Otros MV ch1=2 Todos MV 
ACT(mp13,'AV' )
ACD(mp2,Dialogo.Fecha1)
ACD(mp17,Dialogo.Fecha1)

*- mp20: En Nro. de grupo2 grabo la tenencia 
ACN(mp20, Val(g:val(fi1)) )

ACT(mp16,Fstr(Val(s:val(fi1)),0,0) )

*- Movimiento bajando el saldo de cupones
ACT(mp1,val(y2))
ACT(mp3,val(l:val(fi1)) )
ACT(mp4,Val(aa1) )

ACT(mp5,val(bz:&i))
ACT(mp6,'' )
ACN(mp7,0 )

ACT(mp8 ,Val(c:val(fi1)) )
ACT(mp9 ,val(aa4))

***************
* Cantidad  
***************
ACN(mp10,  - Val(g:val(fi1)) )

*- % IVA ==> Formula
ACT(mp11, Fstr(val(ci:2),0,2) )          
ACT(mp12, 'Liq. Cupon de '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0) )          

ACN(mp14,Val(s:val(fi1)) )

*- mp15: Nro. Grupo 1 es el de las Acciones 
ACN(mp15,1)
ACT(mp19,Val(b:val(fi1)) )
ACT(mp29,Val(b:val(fi1))  )
ACN(mp22,val(fi1) )
ACT(mp27,Val(x3) )
ACN(MP:26, 0)
(."IMMOVPEND".)

* Condicion agregada por Fernando el dia 14/09/2001 para que solo genere movimientos de moneda
* a los movimientos de la especie con saldo >= 101
IF Val(s:&i)>=Val(sl1)
** FJL 26/01/22 - Se abren los movimientos en Amortizacion y Renta
** En el IF NO queda la version anterior en un solo movimiento
IF NO
*   *- Genero el Movimiento del efectivo asociado a la transaccion LCUPON 
*   ACT(mp1,val(y2))
*   ACT(mp3,val(l:val(fi1)) )
*   ACT(mp4,val(aa7))
*
*   ***---Se quita para que no corte los saldos con esta clave
****---   ACT(mp5,val(bz:&i))  - FO 15/03/06 lo guardo en vehiculo que no es clave
*   ACT(mp30,val(bz:&i))  
*   ACT(mp5, '')
*   ACT(mp6,'' )
*   ACN(mp7,0 )
*
*   ACT(mp9 ,Dialogo.Vehiculo1)
*
****************
** Cantidad  
****************
*   ACN(mp10,  Val(k:val(fi1)) )
*
*   *- % IVA 
*   ACT(mp11,Fstr(val(ci:2),0,2) )          
*   ACT(mp12,'Liq. Cupon de '~val(mp4)~' Cup. '~FSTR(Val(aa:2),1,0) )           
*
*   *- mp15: Nro. Grupo 1 es el de las Acciones 
*   ACN(mp15,1)
*   ACT(mp19,Val(h:val(fi1)) )
*   SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
*   Recorrer SQL
*       DFA
*       ACT(mp8, fbn('Mercado'))
*       ACT(TC:79, fbn('TipoCuenta'))
*   Proximo
*   IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(BZ:&i), 'PRE|PAS|PEN')
*       ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
*       ACN(mp14, 5)
*   ELSE
*       ACN(mp14, 1)
*   ENDIF
*   ACT(mp29,Val(b:val(fi1))  )
*   ACN(mp22,val(fi1)+100000 )
*   ACT(mp27,'')
*   ACN(MP:26, 0)
*   (."IMMOVPEND".)
*
ELSE

** FJL 15/03/22 - Los movimientos en moneda ahora son manuales para liquidarlos. 
** FJL 11/07/22 - Cuanta Vista para saldos bloquedas
**                Si el saldo es bloqueado el Movimeinto es Automatico
*   ACT(mp13,'MV' )
* FJL 15/07/22 - Vuelven a ser todos Automaticos - Paola
*   If Val(t:val(fi1))=1
*     * Es Saldo Bloqueado
*     ACT(mp13,'AV' )
*   else
*     ACT(mp13,'MV' )
*   endif
   ACT(mp13,'AV' )

   *- Genero el Movimiento del efectivo asociado a la transaccion LCUPON 
   ACT(mp1,val(y2))
   ACT(mp3,val(l:val(fi1)) )
   ACT(mp4,val(aa7))

   ***---Se quita para que no corte los saldos con esta clave
***---   ACT(mp5,val(bz:&i))  - FO 15/03/06 lo guardo en vehiculo que no es clave
   ACT(mp30,val(bz:&i))  
   ACT(mp5, '')
   ACT(mp6,'' )
   ACN(mp7,0 )

   ACT(mp9 ,Dialogo.Vehiculo1)


   *- % IVA 
   ACT(mp11,Fstr(val(ci:2),0,2) )          

   ACT(mp19,Val(h:val(fi1)) )
   SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
   Recorrer SQL
       DFA
       ACT(mp8, fbn('Mercado'))
       ACT(TC:79, fbn('TipoCuenta'))
   Proximo
   IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(BZ:&i), 'PRE|PAS|PEN')
       ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
       ACN(mp14, 5)
   ELSE
       ACN(mp14, 1)
   ENDIF
   ACT(mp29,Val(b:val(fi1))  )
   ACN(mp22,val(fi1)+100000 )
   ACT(mp27,'')
   ACN(MP:26, 0)

   *************************************
   * Movimiento de Amortizacion
   *************************************
   if Val(pr:8)<>0
     ***************
     * Cantidad  
     ***************
     ACN(mp10,  Val(g:val(fi1))*Val(pr:12)*Val(pr:8)/100 )
     ACT(mp12,'Liq. Amortizacion Cupon de '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0) )           
     *- mp15: Nro. Grupo 1 es el de las Acciones 
     ACN(mp15,1)
     (."IMMOVPEND".)
   endif
   *************************************
   * Movimiento de Renta
   *************************************
   if Val(pr:9)<>0
     ***************
     * Cantidad  
     ***************
     ACN(mp10,  Val(g:val(fi1))*Val(pr:12)*Val(pr:9)/100 )
     ACT(mp12,'Liq. Renta Cupon de '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0) )           
     *- mp15: Nro. Grupo 1 es el de las Acciones 
     ACN(mp15,2)
     (."IMMOVPEND".)
   endif
   *************************************
   * Movimiento de Amort.int.Capitalizados
   *************************************
   if Val(pr:10)<>0
     ***************
     * Cantidad  
     ***************
     ACN(mp10,  Val(g:val(fi1))*Val(pr:12)*Val(pr:10)/100 )
     ACT(mp12,'Liq. Amort.Ints.Cap. Cupon de '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0) )           
     *- mp15: Nro. Grupo 1 es el de las Acciones 
     ACN(mp15,3)
     (."IMMOVPEND".)
   endif

ENDIF
* FJL 26/01/22 - Hasta aca es el IF NO de un solo movimento 
   
** FJL 15/03/22 - Los movimientos de Comisiones + IVA ahora son manuales para liquidarlos. 
** FJL 11/07/22 - Cuanta Vista para saldos bloquedas
**                Si el saldo es bloqueado el Movimeinto es Automatico
*   ACT(mp13,'MV' )
* FJL 15/07/22 - Vuelven a ser todos Automaticos - Paola
*   If Val(t:val(fi1))=1
*     * Es Saldo Bloqueado
*     ACT(mp13,'AV' )
*   else
*     ACT(mp13,'MV' )
*   endif
   ACT(mp13,'AV' )

   *--------------------------------------------------------------
   *- Movimiento por Comision
   If Round(Val(ja:val(fi1)),2)<>0
      ACT(mp1,val(y2))
      ACD(mp2,Dialogo.Fecha1)
      ACT(mp3,val(l:val(fi1)))
      ACT(mp4,Val(aa7))
      ***---Se quita para que no corte los saldos con esta clave
      ***---ACT(mp5,val(bz:&i) ) - LO GUARDO EN VEHICULO QUE NO ES CLAVE FO 15/03
      ACT(mp30,val(bz:&i) )
      ACT(mp5, '')
      ACT(mp6,'' )
      ACN(mp7,0 )
      ACT(mp9 ,val(aa4))
** FJL 14/12/21 - Las comisiones las paga el cliente
*      ACN(mp10,Val(sa3))
*      ACN(mp10, -Val(sa3))
***************
* Cantidad  
***************
** FJL 12/07/23 - para que sea a pagar
      ACN(mp10, -Val(ja:val(fi1)))
      ACT(mp11,Fstr(val(ci:2),0,2))
      ACT(mp12,'Comision Corte Cupon '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0))

      *- Comision de Renta
      ACN(mp23,val(re1))

      *- Comision de Administracion
      ACN(mp25,val(re2))

      *- mp20: En Nro. de grupo2 grabo la tenencia
      *- mp15: Nro. Grupo es el del Efectivo
      ACN(mp15,41)
***************
* Cuenta
***************
      ***ACT(mp19,val(ch:1))
      ACT(mp19,Val(h:val(fi1)) )
      SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
      Recorrer SQL
          DFA
          ACT(mp8, fbn('Mercado'))
          ACT(TC:79, fbn('TipoCuenta'))
      Proximo
      IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(BZ:&i), 'PRE|PAS|PEN')
          ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
          ACN(mp14, 5)
      ELSE
          ACN(mp14, 1)
      ENDIF
      ACN(mp22,val(fi1)+200000)
      IF Val(SA:4) <> 0
          ***---Comision Bonificada
          ACN(MP:26, Val(SA:4))
      ELSE
          ACN(MP:26, 0)
      ENDIF

      (."IMMOVPEND".) 
   EndIf

   *-----------------------------------------
   *- Movimiento por El Iva 
   If Round(Val(jb:val(fi1)),2)<>0
      ACT(mp1,val(y2))
      ACD(mp2,Dialogo.Fecha1)
      ACT(mp3,val(l:val(fi1)) )
      ACT(mp4,Val(aa7))
      ***---Se quita para que no corte los saldos por esta clave
      ***---ACT(mp5,val(bz:&i) )
      ACT(mp30,val(bz:&i) )
      ACT(mp5, '')
      ACT(mp6,'' )
      ACN(mp7,0 )
      ACT(mp9 ,val(aa4) )
** FJL 14/12/21 - Las comisiones las paga el cliente
*      ACN(mp10, Val(ci:1) )
*      ACN(mp10, -Val(ci:1) )
***************
* Cantidad  
***************
      ACN(mp10, -Val(jb:val(fi1)))
      ACT(mp11,Fstr(val(ci:2),0,2) )
      ACT(mp12,'IVA Comisiones Corte Cupon '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0))          

      *- mp15: Nro. Grupo es el del Efectivo
      ACN(mp15,42)
***************
* Cuenta
***************
      ***ACT(mp19,val(ch:1) )
      ACT(mp19,Val(h:val(fi1)) )
      SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
      Recorrer SQL
          DFA
          ACT(mp8, fbn('Mercado'))
          ACT(TC:79, fbn('TipoCuenta'))
      Proximo
      IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(BZ:&i), 'PRE|PAS|PEN')
          ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
          ACN(mp14, 4)
      ELSE
          ACN(mp14, 1)
      ENDIF
      ACN(mp22,val(fi1)+300000 )
      IF Val(SA:5) <> 0
          ***---IVA Comision Bonificada
          ACN(MP:26, Val(SA:5))
      ELSE
          ACN(MP:26, 0)
      ENDIF
      (."IMMOVPEND".) 

** FJL 22/11/21 - Se actualzian los valores de Comision - IVA en la trasaccion LCUPON      
