*      SQL.ADD("       Cantidad11 = "~FStr(Val(ci:1),1,2)~" ")
*      SQL.ADD(" Where NrTrans    = '"~Val(y:2)~"' ")
*      SQL.NEW
*      SQL.EXEC
    EndIf

   *-----------------------------------------------------------------------
   If Round(Val(jc:val(fi1)),2)<>0
      *- Movimiento por la Comision de CV
      ACT(mp1,val(y2))
      ACD(mp2,Dialogo.Fecha1)
      ACT(mp3,val(l:val(fi1)) )
** FJL 26/02/24 - Issue EXTBIND 6989 - La Comisiaon de CV es siempre en ARP
*      ACT(mp4,Val(aa7))
** FJL 18/03/24 - Se vuelve atras la modificacion
*      ACT(mp4, Var('MONELOCA'))
      ACT(mp4,Val(aa7))
      ***---Se quita para que no corte los saldos por esta clave
      ***---ACT(mp5,val(bz:&i) )
      ACT(mp30,val(bz:&i) )
      ACT(mp5, '')
      ACT(mp6,'' )
      ACN(mp7,0 )
      ACT(mp9 ,val(aa4))
** FJL 14/12/21 - Las comisiones las paga el cliente
*      ACN(mp10,Val(re3) )      
*      ACN(mp10, -Val(re3) )      
***************
* Cantidad  
***************
** FJL 12/07/23 - para que sea a pagar
      ACN(mp10, -Val(jc:val(fi1)))
      ACT(mp11,Fstr(val(ci:12),0,2) )
      ACT(mp12,'Com. CV Corte Cupon '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0) )          

      *- Comision de Renta 
      ACN(mp23,val(re3))

      *- Comision de Amortizacion
      ACN(mp25,0)

      *- mp20: En Nro. de grupo2 grabo la tenencia 
      *- mp15: Nro. Grupo es el del Efectivo
      ACN(mp15,51)
***************
* Cuenta
***************
** FJL 27/02/24 - Issue EXTBIND 6989 - La Comisiaon de CV es siempre en ARP
*      ACT(mp19,Val(h:val(fi1)))
** FJL 18/03/24 - Se vuelve atras la modificacion
*      ACT(mp19, Val(dh:val(fi1)))
      ACT(mp19,Val(h:val(fi1)))
      SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
      Recorrer SQL
          DFA
          ACT(mp8, fbn('Mercado'))
          ACT(TC:79, fbn('TipoCuenta'))
      Proximo
      IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(BZ:&i), 'PRE|PAS|PEN')
          ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
          ACN(mp14, 4)
      ELSE
          ACN(mp14, 1)
      ENDIF
      ACN(mp22,val(fi1)+400000 )
      ACN(MP:26, Val(mp10))
      (."IMMOVPEND".) 
** FJL 22/11/21 - Se actualzian los valores de Comision CV en la trasaccion LCUPON      
** FJL 13/12/21 - Lo saco de aca porque se graban en la funcion GENELCUPON
*      SQL.ADD("Update "~DBO~".TRANSACCIONES2 ")
*      SQL.ADD("   Set Cantidad12 = "~FStr(Val(re:3),1,2)~" ")
*      SQL.ADD(" Where NrTrans    = '"~Val(y:2)~"' ")
*      SQL.NEW
*      SQL.EXEC
   EndIf
   *-----------------------------------------
   If Round(Val(jd:val(fi1)),2)<>0
      *- Movimiento por El Iva  de la Comision CV
      ACT(mp1,val(y2))
      ACT(mp3,val(l:val(fi1)) )
      ACD(mp2,Dialogo.Fecha1)
** FJL 26/02/24 - Issue EXTBIND 6989 - La Comisiaon de CV es siempre en ARP
*      ACT(mp4,Val(aa7))
** FJL 18/03/24 - Se vuelve atras la modificacion
*      ACT(mp4, Var('MONELOCA'))
      ACT(mp4,Val(aa7))
      ***---Se quita para que no corte los saldos por esta clave
      ***---ACT(mp5,val(bz:&i) )
      ACT(mp30,val(bz:&i) )
      ACT(mp5, '')
      ACT(mp6,'' )
      ACN(mp7,0 )
      ACT(mp9 ,val(aa4))      
** FJL 14/12/21 - Las comisiones las paga el cliente
*      ACN(mp10,Val(ci:11) )
*      ACN(mp10, -Val(ci:11) )
***************
* Cantidad  
***************
      ACN(mp10, -Val(jd:val(fi1)))
      ACT(mp11,Fstr(val(ci:12),0,2) )
      ACT(mp12,'IVA Comision CV Corte Cupon '~val(aa:14)~' Cup. '~FSTR(Val(aa:2),1,0))          
  
      *- mp15: Nro. Grupo es el del Efectivo
      ACN(mp15,52)
***************
* Cuenta
***************
** FJL 27/02/24 - Issue EXTBIND 6989 - La Comisiaon de CV es siempre en ARP
*      ACT(mp19,Val(h:val(fi1)))
** FJL 18/03/24 - Se vuelve atras la modificacion
*      ACT(mp19, Val(dh:val(fi1)))
      ACT(mp19,Val(h:val(fi1)))
      SQL.ADD(" Select TipoCuenta, Mercado From "~DBO~".CUENTAS Where Codigo = '"~Val(MP:19)~"' ")
      Recorrer SQL
          DFA
          ACT(mp8, fbn('Mercado'))
          ACT(TC:79, fbn('TipoCuenta'))
      Proximo
      IF Eqstr(Val(TC:79), 'CUS') O Incluido(Val(BZ:&i), 'PRE|PAS|PEN')
          ***---Para las cta.custodia, la fc. CUSMONEDA genera una DTP que despues se pasa a NrSaldo 1
          ACN(mp14, 4)
      ELSE
          ACN(mp14, 1)
      ENDIF
      ACN(mp22,val(fi1)+500000 )
      ACN(MP:26, val(mp10))
      
      (."IMMOVPEND".)         
** FJL 22/11/21 - Se actualzian los valores de Comision CV en la trasaccion LCUPON      
** FJL 13/12/21 - Lo saco de aca porque se graban en la funcion GENELCUPON
