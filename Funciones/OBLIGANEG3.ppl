ACN(fa1, Val(fi7))
ACN(fa2, Val(fi8))

BorrarCeldas(NX:1..NX:1)

Recorrer&k 91, 99
    ACN(ZN:&k, 0)
Proximo

***---ZN:91 = Plazo Promedio x Operacion
***---ZN:92 = Suma de Plazo x Cantidad Total
***---ZN:93 = Suma de Cantidad Total
***---ZN:94 = Plazo Promedio Grupo

*- Selecciono los codigos de las distintas operaciones de antemano y ubico 
SQL.ADD(" SELECT O.NrOperacion, C.Cantidad4 CantCuota, C.Fecha2 FechaFin, ")
SQL.ADD(" O.PrecioEj Cantidad, O.Observac3 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".OPERACIONES OT ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       AND  O.NrOperacion = OT.OperacionRef  ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMONM') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
SQL.ADD(" AND C.Cantidad4 <> 0 ")

SQL.ADD("UNION ")

SQL.ADD(" SELECT O.NrOperacion, O.TotalNetoCli3 CantCuota, O.FechaVto FechaFin, ")
SQL.ADD(" O.PrecioEj Cantidad, O.Observac3 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONES OT ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       AND O.NrOperacion = OT.OperacionRef  ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMON') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND ((OT.Especie Is Null AND O.Especie = '"~Dialogo.Especie1~"') ")
SQL.ADD("       OR (OT.Especie Is Not Null AND OT.Especie = '"~Dialogo.Especie1~"')) ")
SQL.ADD(" AND (OT.NrOperacion Is Null OR OT.NrOperacion IN ( ")
SQL.ADD("      Select Max(OT1.NrOperacion) From "~DBO~".OPERACIONES OT1 ")
SQL.ADD("      Where O.NrOperacion = OT1.OperacionRef)) ")
SQL.ADD(" AND O.TotalNetoCli3 <> 0 ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT O.NrOperacion, O.Cantidad CantCuota, O.FechaVto FechaFin, O.Cantidad, ")
SQL.ADD(" O.Observac3 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFRN') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND O.Cantidad <> 0 ")

SQL.ADD("UNION ")

SQL.ADD(" SELECT O.NrOperacion, C.Cantidad1 CantCuota, C.Fecha2 FechaFin, O.Cantidad, ")
SQL.ADD(" O.Observac3 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.NrOperacion = C.NrOperacion ")
SQL.ADD("       and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.TipoOp In ('MMFCMV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND C.Cantidad1 <> 0 ")

SQL.ADD(" ORDER BY 1 ")

Recorrer SQL
    ***---Plazo
    IF Eqstr(fbn('NrOperacion'), Val(NX:1))
        SCN(ZD:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
    ELSE
        IF Not CeldaVacia(NX:1)  
            ***---Cambio de Operacion
            ACN(ZD:91, Val(ZD:99) / Val(ZD:98))
            SCN(ZD:92, Val(ZD:99))
            SCN(ZD:93, Val(ZD:98))
            ACN(ZD:99, 0)
            ***---Plazo de la Operacion
            ACN(ZD:Val(FA:1), Val(ZD:91))
            SCN(fa1,1)
        ENDIF
        ACT(A:Val(FA:1), fbn('NrOperacion')~' - '~fbn('Observac3'))
        ACT(NX:1, fbn('NrOperacion'))
        SCN(ZD:99, ((fbn('FechaFin') - Dialogo.Fecha1) / Val(DA:1)) * fbn('CantCuota'))
        ACN(ZD:98, fbn('Cantidad'))
        SetFont(a:Val(fa1), 2)
    ENDIF
Proximo

ACN(ZD:91, Val(ZD:99) / Val(ZD:98))
SCN(ZD:92, Val(ZD:99))
SCN(ZD:93, Val(ZD:98))
ACN(ZD:94, Val(ZD:92) / Val(ZD:93))
***---Plazo de la Operacion
ACN(ZD:Val(FA:1), Val(ZD:91))
