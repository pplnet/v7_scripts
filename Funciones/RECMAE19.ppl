*********************************************************
* Msg 1528 Estado de Orden
*********************************************************
* Filler                        Pic X(31).
* Mercado Externo               Pic X(01).
* Agente                        Pic X(15). 
* Trader/Operador               Pic X(30).
* N£mero de Orden origen        Pic X(32).
* N£mero de Orden origen previo Pic X(32).
* N£mero de Orden Host          Pic X(32).
* Estado                        Pic X(01) *
* Agente Negociador Venta       Pic X(15).
* Agente Compensador Venta      Pic X(15).
* Agente Negociador Compra      Pic X(15).
* Agente Compensador Compra     Pic X(15).
* Motivo                        Pic X(01) **
* Descripci¢n Motivo de Rechazo Pic X(100).
* ID Pedido de estado           Pic X(32).
* ID Pedido de estado masivo    Pic X(32).
* Total de Ordenes              Pic 9(05).
* Ultimo estado                 Pic X(01).
* ID Ejecuci¢n                  Pic X(32).
* Fecha de Liquidaci¢n          Pic 9(08).
* Instrumento/Especie           Pic X(30).
* Precio                        Pic S9(10)v9(08).
* Cantidad                      Pic 9(14)v9(04).
* Compra/Venta                  Pic X(01).
* Moneda                        Pic X(01).
* Rueda                         Pic X(04).
* Tipo de Negociaci¢n           Pic X(01).
* Cantidad Ejecutada            Pic 9(14)v9(04).
* Ultima Cantidad Ejecutada     Pic 9(14)v9(04).
* Motivo rechazo                Pic 9(02) ***
* Plazo                         Pic X(04).
* Cuenta                        Pic X(20).
* Precio Operaci¢n              Pic S9(10)v9(08).
*********************************************************

act(s:1,'Nro Orden Origen')
act(t:1,Copy(Val(a:2),78,32))
act(s:2,'Nro Orden FPA')
act(t:2,Copy(Val(a:2),102,8))
act(s:3,'Estado')
act(t:3,Copy(Val(a:2),174,1))
act(s:4,'Fecha')
*act(t:4,Copy(Val(A:2),15,2)~'/'~Copy(Val(A:2),13,2)~'/'~Copy(Ahora,7,2)~Copy(Val(A:2),11,2)~' '~Copy(Val(A:2),17,2)~':'~Copy(Val(A:2),19,2)~':'~Copy(Val(A:2),21,2))
act(t:4,Copy(Ahora,7,2)~Copy(Val(A:2),11,2)~'-'~Copy(Val(A:2),13,2)~'-'~Copy(Val(A:2),15,2)~' '~Copy(Val(A:2),17,2)~':'~Copy(Val(A:2),19,2)~':'~Copy(Val(A:2),21,2))
act(s:6,'Status Leyenda')
act(s:7,'Tipo')
act(s:8,'Motivo Rechazo')
act(t:8,Copy(Val(a:2),555,2))
act(s:9,'Descripcion Motivo Rechazo')
act(t:9,Copy(Val(a:2),236,100))

* Estados posibles
* 0 Nueva
* 1 ParcialmenteFill
* 2 Filled
* 3 DoneForDay
* 4 Cancelada
* 6 PendienteBaja
* 7 Stopped
* 8 Rechazada
* 9 Suspendido
* A PendienteNew
* B Calculated
* C Expirada
* D AcceptedForBidding
* E PendingReplace

act(s:5,'Instancia')
acn(t:5,SQL("SELECT NrBit from "~DBO~".OPERACIONESBITS where NrOperacion = '"~val(t:2)~"' and  Valor = '1' "))

* A Alta en Siopel
* R Rechazada + cambio a instancia Terminal
* F Fin + cambio de instancia a Liquid
* C Cambio de status

if Eqstr(val(t:3),'0')
   act(t:6,'0 Nueva')
   act(t:7,'A')
else
   if Eqstr(val(t:3),'1')
      act(t:6,'1 ParcialmenteFill')
      act(t:7,'C')
   else
      if Eqstr(val(t:3),'2')
         act(t:6,'2 Filled')
         act(t:7,'F')
      else
         if Eqstr(val(t:3),'3')
            act(t:6,'3 DoneForDay')
            act(t:7,'F')
         else
            if Eqstr(val(t:3),'4')
               act(t:6,'4 Cancelada')
               act(t:7,'R')
            else
               if Eqstr(val(t:3),'6')
                  act(t:6,'6 PendienteBaja')
                  act(t:7,'R')
               else
                  if Eqstr(val(t:3),'7')
                     act(t:6,'7 Stopped')
                     act(t:7,'R')
                  else
                     if Eqstr(val(t:3),'8')
                        act(t:6,'8 Rechazada')
                        act(t:7,'R')
                     else 
                        if Eqstr(val(t:3),'9')
                           act(t:6,'9 Suspendido')
                           act(t:7,'R')
                        else
                           if Eqstr(val(t:3),'A')
                              act(t:6,'A PendienteNew')
                              act(t:7,'C')
                           else
                              if Eqstr(val(t:3),'B')
                                 act(t:6,'B Calculated')
                                 act(t:7,'C')
                              else
                                 if Eqstr(val(t:3),'C')
                                    act(t:6,'C Expirada')
                                    act(t:7,'F')
                                 else
                                    if Eqstr(val(t:3),'D')
                                       act(t:6,'D AcceptedForBidding')
                                       act(t:7,'C')
                                    else
                                       if Eqstr(val(t:3),'E')
                                          act(t:6,'E PendingReplace')
                                          act(t:7,'C')
                                       else
                                       endif
                                    endif
                                 endif
                              endif
                           endif
                        endif
                     endif
                  endif
               endif
            endif
         endif
      endif
   endif
endif

if val(t:5)=61 
   if Eqstr(val(t:7),'A')
      * Proceso el alta
      SQL.ADD("UPDATE "~DBO~".ORDENES ")
      SQL.ADD(" SET AceptaMAE = 'SI', ")
      SQL.ADD(" FechaAltaMAE = Convert(datetime,'"~Val(t:4)~"',120), ")
      SQL.ADD(" NroAltaMAE = '"~Copy(Val(A:2),23,5)~"', ")
      if NoVacio(val(t:9))
         SQL.ADD(" CodErrorMAE = '"~Val(t:8)~"', ObsErrorMAE= '"~Val(t:9)~"', ")
      endif
      SQL.ADD(" RB3 = '"~val(t:3)~"', Leyenda2='"~val(t:6)~"' ")
      SQL.ADD(" Where NrOrden = '"~Val(t:2)~"' ")
      SQL.NEW
      act(a:3,'OkA')
   else
      if Eqstr(val(t:7),'R')
      * Rechazada
         SQL.ADD(" UPDATE "~DBO~".ORDENES ")
         SQL.ADD(" SET AceptaMAE = 'NO',  ")
         if NoVacio(val(t:9))
            SQL.ADD(" CodErrorMAE = '"~Val(t:8)~"', ObsErrorMAE= '"~Val(t:9)~"', ")
         endif
         SQL.ADD(" RB3 = '"~val(t:3)~"', Leyenda2='"~val(t:6)~"' ")
         SQL.ADD(" Where NrOrden= '"~Val(t:2)~"' ")
         SQL.NEW
         * Ok Baja operacion, pasa la Orden a la Inst. Eliminacion Manual
         SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
         SQL.ADD(" SET Valor = '0' ")
         SQL.ADD(" Where  NrBit=61 and NrOperacion= '"~Val(t:2)~"' ")
         SQL.NEW
         SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
         SQL.ADD(" SET Valor = '1' ")
         SQL.ADD(" Where  NrBit=4 and NrOperacion= '"~Val(t:2)~"' ")
         SQL.NEW
         act(a:3,'RechazadaA')
      else
         SQL.ADD("UPDATE "~DBO~".ORDENES ")
         SQL.ADD(" SET RB3 = '"~val(t:3)~"', ")
         if NoVacio(val(t:9))
            SQL.ADD(" CodErrorMAE = '"~Val(t:8)~"', ObsErrorMAE= '"~Val(t:9)~"', ")
         endif
         SQL.ADD(" Leyenda2='"~val(t:6)~"' ")
         SQL.ADD(" Where NrOrden = '"~Val(t:2)~"' ")
         SQL.NEW   
         if Eqstr(val(t:7),'F')
            if NO
               * Pasa la Orden a la Inst. Confirmacion
               SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
               SQL.ADD(" SET Valor = '0' ")
               SQL.ADD(" Where  NrBit=61 and NrOperacion= '"~Val(t:2)~"' ")
               SQL.NEW
               SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
               SQL.ADD(" SET Valor = '1' ")
               SQL.ADD(" Where  NrBit=2 and NrOperacion= '"~Val(t:2)~"' ")
               SQL.NEW
            endif
            act(a:3,'  Fin - A liquidacion')
         else
            act(a:3,'  Cambio Status')
         endif
      endif
   endif
endif
* Pedido de Baja
if val(t:5)=62
   SQL.ADD(" UPDATE "~DBO~".ORDENES ")
   SQL.ADD(" SET AceptaMAE = 'SI', FechaBajaMAE = Convert(datetime,'"~Val(t:4)~"',120), ")
   SQL.ADD(" NroBajaMAE = '"~Copy(Val(A:2),23,5)~"', ")
   if NoVacio(val(t:9))
      SQL.ADD(" CodErrorMAE = '"~Val(t:8)~"', ObsErrorMAE= '"~Val(t:9)~"', ")
   endif
   SQL.ADD(" RB3 = '"~val(t:3)~"', Leyenda2='"~val(t:6)~"' ")
   SQL.ADD(" Where NrOrden= '"~Val(t:2)~"' ")
   SQL.NEW
   * Ok Baja operacion, pasa la Orden a la Inst. Eliminacion Manual
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" SET Valor = '0' ")
   SQL.ADD(" Where  NrBit=62 and NrOperacion= '"~Val(t:2)~"' ")
   SQL.NEW
   SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
   SQL.ADD(" SET Valor = '1' ")
   SQL.ADD(" Where  NrBit=5 and NrOperacion= '"~Val(t:2)~"' ")
   SQL.NEW

endif
SQL.EXEC
