* SIOPEL Incompleto
INSTANCIA4
CAMPOS:0
Especie        : 'Especie'        ;1;1;1;SI o [Not EV y Vacio(NRORDEN1) y [CB5=0 o Vacio(ESPECIE) o MODI]];  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y  EsTerminal(ESPECIE, Especie);'Debe Ingresar una Especie Valida';NO;;;;Var('LE'~USUARIOACTIVO);;;;"Status = 'HAB'"
VTXT9          : 'Especie 2'      ;1;2;2;NO;NoVacio(VTXT9);;;;BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',ESPECIE));BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',ESPECIE));;;;;'######';
EnteCus1       : 'CodMAE Esp'     ;1;2;1;NO;NOT EQSTR(MERCADO4,VAR('AMBBYMA'));;;;IF(CB5=1,ENTECUS1,BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE));IF(CB5=1,ENTECUS1,BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE))
Cliente1       : 'Cliente'        ;2;1; ;[Not EV o [EQSTR(VAR('BOOK'),'1') y VACIO(CLIENTE1)]] y [CB5=0 o EqStr(CLIENTE1,'SIOPEL') o Vacio(CLIENTE1) o MODI];  ;[NOT DESCIENDEDECLIENTE(CLIENTE1,'OTROS') y EsTerminal(CLIENTE1,Cliente) y NoVacio(CLIENTE1) y EqStr(BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1),'HAB')];'El Cliente no es valido.';NO;if(Vacio(ENTECUS2),CLIENTE1,BuscarCampo('CLIENTES','Codigo','NrMAE',ENTECUS2));if(Vacio(ENTECUS2),CLIENTE1,BuscarCampo('CLIENTES','Codigo','NrMAE',ENTECUS2));;;;;;"Status = 'HAB'  and NrMAE = '"~ENTECUS2~"' "
EnteCus2       : 'CodMAE Clie'    ;2;2; ;NO;NoVacio(ENTECUS2);;;;IF(CB5=1,ENTECUS2,BuscarCampo('CLIENTES','NrMAE','Codigo',CLIENTE1));IF(CB5=1,ENTECUS2,BuscarCampo('CLIENTES','NrMAE','Codigo',CLIENTE1))
VTXT12         : 'NrMAE'          ;2;2; ;NO;NO;;;;;BuscarCampo('CLIENTES','NrMAE','Codigo',CLIENTE1)
Cantidad       : 'Cantidad'       ;3;1; ;NO
Precio1        : 'Precio (entero)';4;1; ;NO;;;;;;;;;;;'####.########';
FechaOp        : 'Fecha Op.'      ;3;2; ;NO
Plazo          : 'Plazo'          ;4;2; ;NO
FechaVto       : 'Fecha Liq.'     ;5;2; ;NO
ContraEspecie  : 'ContraEspecie'  ;5;1; ;NO
TotalNetoCli1  : 'Total'          ; ; ; ;NO
TotalBrutoCli1 : 'Monto'          ; ; ; ;NO
Mercado        : 'Casa Cust.'     ; ; ; ;NO
Vehiculo1      :                  ; ; ; ;NO
Operador       :                  ; ; ; ;NO
VTXT19         : 'WF MAE reducido';2;2;2;NO;NO;;;;;IF(EqStr(BuscarCampo('VARIABLES','Valor','Codigo','WFMAEREDU'),'SI'),'SI','NO');;;;;'XX';

VCAN21: 'Excep.F.Valor'; 8;2;1;NO;NO;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ")
VCAN22: 'Excep.Precio' ; 9;2;1;NO;NO;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'RANGOPRECI' ")
VCAN23: 'Excep.Lim'    ;10;2;1;NO;NO;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And (Tipo Like '%NOAS' or Tipo Like '%VENC' or Tipo Like '%CANC' or Tipo Like '%EXCE')")
VCAN24: 'a Inst Contr' ;11;2;1;NO;NO;;;;;IF(VCAN23>0,1,0)

CONDICIONES:
EV o EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La especie No esta Habilitada';NO
EV o [FECHAMADURACION(ESPECIE) >= FECHAOP y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'La especie esta vencida';SI;SI;FSys;'CUPONPAG'
EV o [EqStr(CUPON1,'0')] o [VACIO(CUPON1) o EqStr(BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE),'SI') o VFEC4>FECHAOP];'Esta trabajando con un cupon anterior (ZeroCoupon='~BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE)~' FechaCorte: '~VFEC4~') ';SI;SI;FSys;'CUPONANT'
EV o Habiles(PROXCUPON(ESPECIE,FECHAOP),-3,'ARG') <> FECHAOP ;'Antes de cargarse la operacion debe realizarse el corte de cupon correspondiente';SI;SI;FSys;'CUPONPROX'
EV o ProxCupon(ESPECIE,FECHAOP) <> FSYS ;'Antes de cargarse la operacion debe realizarse el corte de cupon correspondiente';SI;SI;FSys;'CUPONPROX'
EV o DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') o NoVacio(BuscarCampo('AGENDACUPONES','Especie','Especie',ESPECIE));'Falta Actualizar la Agenda para este Titulo';SI
EV o Not [DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') y CANTIDAD<BuscarCampo('ESPECIES','VolumenMinimo','Codigo',ESPECIE)];'La Cantidad no puede ser inferior al Volumen Minimo';NO 
EV o [BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)<>0 y [CANTIDAD  Mod2(BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE))=0]] o BuscarCampo('ESPECIES','LaminaMinima','Codigo',ESPECIE)=0;'La Cantidad debe ser Multiplo de Lamina Minima';NO
CB5 = 0 o EqStr(BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE),ENTECUS1);'El Codigo MAE de la especie ('~BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE)~') no coincide con el recibido del MAE ('~ENTECUS1~')';NO
EV o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
CB5 = 0 o EqStr(VTXT12,ENTECUS2) o Vacio(ENTECUS2);'El Codigo MAE del Cliente ('~VTXT12~') no coincide con el recibido del MAE ('~ENTECUS2~')';NO

POSTEDICION
FW = 1;'MODOPE';NrOperacion1=NROPERACION;Check1=1;Check2=1;Check3=0;
FW = 1 y QUERY("SELECT 1 FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~NROPERACION~"' AND NrBit IN (8) AND Valor= '1' ")<>1 y CB8=1 y CB7<>1 y VACIO(NrBoleto);'ASIBOL';NrOperacion1=NROPERACION;Radio1=1;

