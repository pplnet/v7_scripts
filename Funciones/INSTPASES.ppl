4 ;0;FW=1 y CB5=1
1 ;1;FW=1 y CB5=1 y EqStr(VTXT19,'NO') y EQSTR(TRIM(VAR('CONTROLAPM')),'NO') o     EqStr(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO')
72;1;FW=1 y CB5=1 y EqStr(VTXT19,'SI') y EQSTR(TRIM(VAR('CONTROLAPM')),'NO') o     EqStr(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO')
9 ;1;FW=1 y CB5=1 y EQSTR(TRIM(VAR('CONTROLAPM')),'SI') y Not EqStr(BuscarCampo('Especies','EstadoOperativo','Codigo',Especie),'NO')


