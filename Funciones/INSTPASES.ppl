[QUERY("SELECT COUNT(1) FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion IN (SELECT NrOperacion FROM "~DBO~".OPERACIONES WHERE OperacionRef = '"~NROPERACION~"' AND PaseCB = 1) AND NrBit = 30 AND Valor = '1' ")=2] o [QUERY("SELECT COUNT(1) FROM "~DBO~".OPERACIONES WHERE OperacionRef = '"~NROPERACION~"' AND PaseCB = 1")=0] ;'Las patas no estan en la instancia Anulacion Manual';
