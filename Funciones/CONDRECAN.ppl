
CONDICIONES
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ESPECIE),'HAB');'La Especie No esta Habilitada';NO
[VCAN4<>0 y [Cantidad1 Mod2(VCan4)=0]] o VCan4=0;'La cantidad V.N. no es multiplo de la cantidad de Lamina minima';NO
VCAN6=0 O [FECHAMADURACION(ESPECIE) >= FECHA1 y FECHAMADURACION(ESPECIE)<>0] o FECHAMADURACION(ESPECIE)=0;'El Cupon ya fue pagado';NO
VCAN6=0 O VCAN2 >=CANTIDAD1 ;'Cantidad de Titulos Supera el Saldo DEL CLIENTE '~PYC(VCAN2,0,2);NO;
VCAN6=0 O VCAN11>=CANTIDAD1 ;'Cantidad de Titulos Supera el Saldo DEL CLIENTE '~PYC(VCAN11,0,2)~' a la fecha de hoy';NO;
-VCAN5 >=CANTIDAD1 ;'Cantidad de Titulos Supera el Saldo DE EMISION DEL Vehiculo '~PYC(-VCAN5,0,2);NO;

