** funcion de informe TOMFO1 "Detalle de Toma de Fondos"
** imprime el cuadro principal y dibuja marcos

** PARAMETROS:
**             co2: cantidad de filas impresas
**             co3 = 0 indica que ya imprimi los titulos, entonces
**                   formateo celdas y pongo marcos 
**             co9: especie
**********************************************************************


if Val(co3)<>0

   ACT(a:fac, 'DETALLE DE OPERACIONES FINANCIERAS')
   AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR'))

   ACT(a:fac+2, 'TOMAS DE FONDOS EN '~IIF(EqStr(Dialogo.Especie1,'ARP'),'PESOS','MONEDA EXTRANJERA ('~Dialogo.Especie1~')') )
   ACT(g:fac+2, 'FECHA: '~Val(fe1) )
   AgregarMarco(a:fac+2..e:fac+2,2,0,Exe('COLOR'))
   AgregarMarco(g:fac+2..h:fac+2,2,0,Exe('COLOR'))
   SetFont(a:fac..g:fac+2,1)

   if NoVacio(Dialogo.Lista1)
      ACT(a:fac+4, 'Vehiculo : '~Dialogo.Lista1)
   else
      ACT(a:fac+4, 'Vehiculo : Todos')
   endif
   AgregarMarco(a:fac+4..b:fac+4,2,0,Exe('COLOR'))
   SetFont(a:fac+4..b:fac+4,1)

   SetFilaActual(fac+6)

   ACT(a:fac,'MINUTA')
   ACT(b:fac,'ENTIDAD')
   ACT(c:fac,'FECHA')
   ACT(c:fac+1,'ORIGEN')
   ACT(d:fac,'FECHA')
   ACT(d:fac+1,'  VTO')
   ACT(e:fac,'DIAS')
   ACT(e:fac+1,'OP.')
   ACT(f:fac,'IMPORTE')
   ACT(g:fac,'IMPORTE')
   ACT(g:fac+1,'AL VTO')
   ACT(h:fac,'TIPO OP')
   ACT(i:fac,'COD')
   ACT(j:fac,'T.E.M.')
   ACT(k:fac,'TNAV')
   ACT(l:fac,'TNAA')
   ACT(m:fac,'INTERESES')
   ACT(m:fac+1,'PERIODO')
   ACT(n:fac,'IMP.ENDEUD.')
   ACT(n:fac+1,'S/INT.')
   ACT(o:fac,'INT.TOT.')
   ACT(o:fac+1,'AL VTO')
   ACT(p:fac,'DIAS')
   ACT(p:fac+1,'VTO') 
   ACT(q:fac,'DIAS')
   ACT(q:fac+1,'TRANS.')
   ACT(r:fac,'DIAS')
   ACT(r:fac+1,'MES')
   ACT(s:fac,'INTERES')
   ACT(s:fac+1,'DIARIO')
   ACT(t:fac,'INTERESES')
   ACT(t:fac+1,'DEVENG.')
   ACT(u:fac,'IVA')
   ACT(u:fac+1,'S/INT.')
   ACT(v:fac,'TASA TOT.')
   ACT(w:fac,'NUMERALES')
   ACT(x:fac,'NUMERALES')
   ACT(x:fac+1,'T.E.M.')
   ACT(y:fac,'NUMERALES')
   ACT(y:fac+1,'VTO.')
   ACT(z:fac,'NUMERALES')
   ACT(z:fac+1,'SIN DIAS')
  
   AgregarMarco(a:fac..z:fac+1,1,2,Exe('COLOR8'))
   AlinearCeldas(a:fac..z:fac+1,'C')
   SetFont(a:fac..z:fac+1,1)
   ifa
else
   AgregarMarco(a:fac-Val(co2)+1..z:fac,1,2)
   ACO(5,4)
   ACO(6,8)
   ACO(7,8)
   ACO(8,23)
   ACO(9,8)
   ACO(10,6)
   ACO(11,6)
   ACO(12,6)
   ACO(13,8)
   ACO(14,8)
   ACO(15,8)
   ACO(16,4)
   ACO(17,4)
   ACO(18,4)
   ACO(19,8)
   ACO(20,8)
   ACO(21,8)
   ACO(22,6)
   ACO(23,7)
   ACO(24,7)
   ACO(25,7)
   ACO(26,7)
   SetFont(a:fac-Val(co2)+1..z:fac, 2)
endif
