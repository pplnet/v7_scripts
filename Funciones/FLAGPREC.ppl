*Recepcion de Cotizaciones Concluida SEC

    ACT(t:3, Copy(Val(a:FAC),11,6))
    ACD(t:4, Fecha(Copy(Val(a:FAC),15,2)~'/'~Copy(Val(a:FAC),13,2)~'/'~Copy(Val(a:FAC),11,2)))
    ACT(t:5, Copy(Val(a:FAC),17,6))
    ACT(t:7, Copy(Val(a:FAC),23,5))

** FJL 10/11/17 - Nueva tabla
    ACN(x1, SQL("Select Count(*) from "~DBO~".FLAGSMERCADO where Mercado = 'MAE' and Registro = 'COTS' and Fecha='"~IdxDate(Val(t:4))~"' "))
    if Val(x1)=0
        Message('Insert Flag COTS')
        SQL.ADD("Insert into "~DBO~".FLAGSMERCADO ( ")
        SQL.ADD(" Mercado, Registro, Fecha, ")
        SQL.ADD(" FechaMercado, HoraMercado, Secuencia, ")
        SQL.ADD(" Estado, Cantidad ")
        SQL.ADD(" ) Values ( ")
        SQL.ADD(" 'MAE', ")
        SQL.ADD(" 'COTS', ")
        SQL.ADD(" '"~IdxDate(Val(t:4))~"', ")
        SQL.ADD(" '"~Val(t:3)~"', ")
        SQL.ADD(" '"~Val(t:5)~"', ")
        SQL.ADD(" '"~Val(t:7)~"', ")
        SQL.ADD(" 'REC',0 ")
        SQL.ADD(" ) ")
        SQL.NEW
        SQL.EXEC
    else
        Message('Update Flag COTS')
        SQL.ADD("Update "~DBO~".FLAGSMERCADO ")
        SQL.ADD("Set FechaMercado  = '"~Val(t:3)~"', ")
        SQL.ADD("    HoraMercado   = '"~Val(t:5)~"', ")
        SQL.ADD("    Secuencia     = '"~Val(t:7)~"' ")
        SQL.ADD("Where Mercado  = 'MAE' ")
        SQL.ADD("  and Registro = 'COTS' ")
        SQL.ADD("  and Fecha    = '"~IdxDate(Val(t:4))~"' ")
        SQL.NEW
        SQL.EXEC
    
    endif
