IF Incluido(fbn('TipoOp'), Var('OPEIMPUEST'))
     IF SQL(" Select 1 From "~DBO~".IMPUESTOS Where NrOperacion = '"~fbn('NrOperacion')~"' AND Plazo4 = "~Fstr(fbn('NrMov'), 0, 0)~" ") = 1 O [fbn('NrMov') > 8000 Y fbn('NrMov') < 9000] O [fbn('NrMov') > 7000 Y fbn('NrMov') < 7100]
        ***---El Movimiento Tiene aplicado el impuesto o es un impuesto o es WHT
        ACN(BD:5, 0)
    ELSE
        IF fbn('NrMov') = 1
            ***---No aplica Impuesto al Alta del Prestamo
            ACN(BD:5, 0)
        ELSE
            IF Eqstr(fbn('TipoOp'), 'MMONM')
                IF BuscarCampo('OPERACIONES','MB3','NrOperacion', fbn('NrOperacion')) <= 0
                    ***---No se aplica Impuesto
                    ACN(BD:5, 0)
                ELSE
                    ***---No se Liquida
                    ACN(BD:5, 1)
                ENDIF
            ELSE
                ***+++IF Eqstr(fbn('TipoOp'), 'MMPCCM') o Eqstr(fbn('TipoOp'), 'MMSELN') 
                IF Eqstr(fbn('TipoOp'), 'MMSELN') 
                    IF BuscarCampo('OPERACIONES','MB3','NrOperacion', fbn('NrOperacion')) = 1
                        ***---No se aplica Impuesto para colocacion de Mutuo
                        ACN(BD:5, 0)
                    ELSE
                        ***---No se Liquida
                        ACN(BD:5, 1)
                    ENDIF
                ELSE
                    ***+++Para las MMPCCM, MMPRCO y MMPREC de colocacion se chequea si fue enviado a SAP
                    IF Incluido(fbn('TipoOp'), 'MMPCCM|MMPRCO|MMPREC')
                        IF BuscarCampo('OPERACIONES','MB3','NrOperacion', fbn('NrOperacion')) = 1
                            ***+++Busco si fue enviado a SAP
                            IF SQL(" Select 1 From "~DBO~".SOLFAC Where NrOperacion = '"~fbn('NrOperacion')~"' AND NrMov = "~Fstr(fbn('NrMov'), 0, 0)~" AND Tipo = 'FC' AND Estado = 'C' ") = 1
                               ***+++Fue enviado, se liquida
                               ACN(BD:5, 0)
                            ELSE
                               ***---No fue enviado, no se Liquida
                               ACN(BD:5, 1)
                            ENDIF
                        ELSE
                            ***---No se Liquida
                            ACN(BD:5, 1)
                        ENDIF
                    ELSE
                        ***---No se Liquida
                        ACN(BD:5, 1)
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ELSE
    ***---No se aplica Impuesto al TipoOp
    ACN(BD:5, 0)
ENDIF

**//Messagebox(FBN('NrOperacion')~' '~Fstr(Val(BD:5),0,0))