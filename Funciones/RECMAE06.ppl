***********************************************************************************************
* Recibi un Registro de Actualizacion de Agentes (2201)                                       *
***********************************************************************************************
if Not EqStr(Copy(Val(A:FAC),32,1),Var('MERSIOP'))
  Message('----- Mensaje Recibido 2201 otro mercado ('~Copy(Val(A:FAC),32,1)~')')
  if Eqstr(Var('LOGERRMAE'),'SI')
    AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
    EscribirASCII(Pad('2201 Otro Mercado ('~Copy(Val(A:FAC),32,1)~')',30)~'-'~Val(A:FAC))
    CerrarASCII
  endif
else
  if EqStr(Copy(Val(A:FAC),36,2),'00')
    Message('----- Operador 00 Agente '~Copy(Val(A:FAC),33,3))
    if Eqstr(Var('LOGERRMAE'),'SI')
      AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
      EscribirASCII(Pad('2201 Operador 00 Agente '~Copy(Val(A:FAC),33,3),30)~'-'~Val(A:FAC))
      CerrarASCII
    endif
  else
    BorrarCeldas(P3..P4)
    ACT(P3, SQL("Select Codigo from "~DBO~".CLIENTES where NrMAE = '"~Copy(Val(A:FAC),33,3)~"' "))
    if Vacio(Val(P3))
      Message('----- No encontrado Agente '~Copy(Val(A:FAC),33,3)~' para actualizar')
      if Eqstr(Var('LOGERRMAE'),'SI')
        AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
        EscribirASCII(Pad('2201 Agente '~Copy(Val(A:FAC),33,3)~' no encontrado',30)~'-'~Val(A:FAC))
        CerrarASCII
      endif
    else
      if Incluido(Copy(Val(A:FAC),38,1),'1')
        Message('----- Baja Agentes :'~Copy(Val(A:FAC),33,3)~' '~Copy(Val(A:FAC),36,2))
        SQL.ADD("Delete from "~DBO~".OPERADORESSIOPEL ")
*        SQL.ADD(" where AgenteMAE   = '"~Copy(Val(A:FAC),33,3)~"' ")
        SQL.ADD(" where AgenteMAE   = '"~Val(P3)~"' ")
        SQL.ADD("   and CodOperador = '"~Copy(Val(A:FAC),36,2)~"'")
        SQL.NEW
        SQL.EXEC
        if Eqstr(Var('LOGERRMAE'),'SI')
          AbrirASCII(Val(z2)~'\MODIAGEN.TXT',0)
          EscribirASCII(Pad('2201 Delete '~Val(P3)~' '~Copy(Val(A:FAC),36,2),30)~'-'~Val(A:FAC))
          CerrarASCII
        endif
      else
        if Incluido(Copy(Val(A:FAC),38,1),'2')
          Message('----- Alta Agentes :'~Copy(Val(A:FAC),33,3)~' '~Copy(Val(A:FAC),36,2))
          ACN(P4,SQL("Select Count(*) from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~Val(P3)~"' and CodOperador = '"~Copy(Val(A:FAC),36,2)~"'"))
          if Val(p4)=0
            SQL.ADD("Insert into "~DBO~".OPERADORESSIOPEL ( ")
            SQL.ADD(" AgenteMAE, CodOperador, NomOperador ")
            SQL.ADD(" ) values (")
            SQL.ADD(" '"~Val(P3)~"', ")
            SQL.ADD(" '"~Copy(Val(A:FAC),36,2)~"', ")
            SQL.ADD(" '"~Copy(Val(A:FAC),49,30)~"'")
            SQL.ADD(" ) ")
            SQL.NEW
            SQL.EXEC
            if Eqstr(Var('LOGERRMAE'),'SI')
              AbrirASCII(Val(z2)~'\MODIAGEN.TXT',0)
              EscribirASCII(Pad('2201 Insert x Alta',30)~'-'~Val(A:FAC))
              CerrarASCII
            endif
          else
            Message('----- Agentes :'~Copy(Val(A:FAC),33,3)~' '~Copy(Val(A:FAC),36,2)~' ya existente')
            SQL.ADD("Update "~DBO~".OPERADORESSIOPEL ")
            SQL.ADD("   set NomOperador = '"~Copy(Val(A:FAC),49,30)~"' ")
            SQL.ADD(" where AgenteMAE   = '"~Val(P3)~"' ")
            SQL.ADD("   and CodOperador = '"~Copy(Val(A:FAC),36,2)~"' ")
            SQL.NEW
            SQL.EXEC
            if Eqstr(Var('LOGERRMAE'),'SI')
              AbrirASCII(Val(z2)~'\MODIAGEN.TXT',0)
              EscribirASCII(Pad('2201 Update x Alta',30)~'-'~Val(A:FAC))
              CerrarASCII
            endif
          endif
        else
          if Incluido(Copy(Val(A:FAC),38,1),'3')
            Message('----- Modificacion Agentes :'~Copy(Val(A:FAC),33,3)~' '~Copy(Val(A:FAC),36,2))
            ACN(P4,SQL("Select Count(*) from "~DBO~".OPERADORESSIOPEL where AgenteMAE = '"~Val(P3)~"' and CodOperador = '"~Copy(Val(A:FAC),36,2)~"'"))
            if Val(p4)=0
              Message('----- Agentes :'~Copy(Val(A:FAC),33,3)~' '~Copy(Val(A:FAC),36,2)~' NO existe')
              SQL.ADD("Insert into "~DBO~".OPERADORESSIOPEL ( ")
              SQL.ADD(" AgenteMAE, CodOperador, NomOperador ")
              SQL.ADD(" ) values (")
              SQL.ADD(" '"~Val(P3)~"', ")
              SQL.ADD(" '"~Copy(Val(A:FAC),36,2)~"', ")
              SQL.ADD(" '"~Copy(Val(A:FAC),49,30)~"' ")
              SQL.ADD(" ) ")
              SQL.NEW
              SQL.EXEC
              if Eqstr(Var('LOGERRMAE'),'SI')
                AbrirASCII(Val(z2)~'\MODIAGEN.TXT',0)
                EscribirASCII(Pad('2201 Insert x Modi',30)~'-'~Val(A:FAC))
                CerrarASCII
              endif
            else
              SQL.ADD(" Update "~DBO~".OPERADORESSIOPEL ")
              SQL.ADD("   set NomOperador = '"~Copy(Val(A:FAC),49,30)~"' ")
              SQL.ADD(" where AgenteMAE   = '"~Val(P3)~"' ")
              SQL.ADD("   and CodOperador = '"~Copy(Val(A:FAC),36,2)~"' ")
              SQL.NEW
              SQL.EXEC
              if Eqstr(Var('LOGERRMAE'),'SI')
                AbrirASCII(Val(z2)~'\MODIAGEN.TXT',0)
                EscribirASCII(Pad('2201 Update x Modi',30)~'-'~Val(A:FAC))
                CerrarASCII
              endif
            endif
          else
            Message('----- Mensaje Actualizacion de Agentes incorrecto')
            if Eqstr(Var('LOGERRMAE'),'SI')
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('2201 Tipo incorrecto',30)~'-'~Val(A:FAC))
              CerrarASCII
            endif
          endif
        endif
      endif
    endif
  endif
endif
