IF NO

Message('Reversos de Fallas de Liquidacion ... ')

SQL.ADD("select T.NrTrans from "~DBO~".TRANSACCIONES2 T,  "~DBO~".ESPECIES E ")
SQL.ADD("where  T.FechaConfir = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" and   T.RB6     = '1'      ")
SQL.ADD(" and   T.Especie = E.Codigo ")
If Dialogo.Radio2=0
   SQL.ADD(" and   E.Tipo = 'MON' ")
Endif
If Dialogo.Radio2=1
   SQL.ADD(" and   E.Tipo <> 'MON' ")
Endif
SQL.ADD(" and   T.FechaFalla is NOT NULL ")
Recorrer SQL
  SQL.ADD("select AC.*, T.Fecha5 FROM "~DBO~".ASIENTOSCON AC, "~DBO~".TRANSACCIONES2 T ")
  SQL.ADD(" where AC.NrTrans2 = '"~fbn['NrTrans']~"' ")
  SQL.ADD(" AND   AC.NrTrans2 = T.NrTrans ")
  SQL.ADD(" and   AC.Modelo  IN ("~Pipe2Comillas(Var('OPFALLADAS'))~") ")
  SQL.ADD(" AND   AC.FechaGeneracion < = "~idxdate2(Dialogo.Fecha1)~"  ")
  Recorrer SQL
     MESSAGE('Operacion '~fbn('NrOperacion'))
     ACT(nn:1, GetNumerador(810))
     SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON ")
     SQL.ADD(" ( FechaGeneracion, FechaValor, Vehiculo, Libro, ")
     SQL.ADD("   Modelo, Book, UDN, Centro, ")
     SQL.ADD("   Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
     SQL.ADD("   NrOperacion, NrTrans2, Fecha1 ")
     SQL.ADD("    ) VALUES ( ")
     SQL.ADD("   "~Idxdate2(fsys)~", "~Idxdate2(fbn('Fecha5'))~", '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
     SQL.ADD("   '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
     SQL.ADD("   '"~fbn('Sector')~"', '"~fbn('NrLote')~"', '"~fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
     SQL.ADD("   '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', "~Idxdate2(Dialogo.Fecha1)~" ) ")
     SQL.NEW

     SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
     Recorrer SQL
       SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
       SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
       SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
       SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
       SQL.ADD(" Alias2, Alias3, Alias4, Alias5, ")
       SQL.ADD(" Detalle, CentroCosto ")
       SQL.ADD(" ) VALUES ( ")
       SQL.ADD(" '"~Val(nn:1)~"', '"~fbn('Cuenta')~"', ")
       If Eqstr(fbn('DebitoCredito'), 'DEB')
         SQL.ADD(" 'CRE', ")
       Else
         SQL.ADD(" 'DEB', ")
       Endif
       SQL.ADD(" '"~fbn('Especie1')~"', ")
       SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,2)~", "~fstr(-fbn('Cantidad2'),0,2)~", ")
       SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
       SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', '"~fbn('Alias4')~"', '"~fbn('Alias5')~"', ")
       SQL.ADD(" 'BajaFalla', '"~fbn('CentroCosto')~"' ) ")
       SQL.NEW
     Proximo
     SQL.EXEC
  Proximo
Proximo


Message('Reversos de Revaluo de Fallas ... ')

SQL.ADD("select T.NrTrans from "~DBO~".TRANSACCIONES2 T,  "~DBO~".ESPECIES E ")
SQL.ADD("where  T.FechaConfir = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" and   T.RB6     = '1'      ")
SQL.ADD(" and   T.Especie = E.Codigo ")
If Dialogo.Radio2=0
   SQL.ADD(" and   E.Tipo = 'MON' ")
Endif
If Dialogo.Radio2=1
   SQL.ADD(" and   E.Tipo <> 'MON' ")
Endif
SQL.ADD(" and   T.FechaFalla is NOT NULL ")
Recorrer SQL
  SQL.ADD("select AC.*, T.Fecha5 FROM "~DBO~".ASIENTOSCON AC, "~DBO~".TRANSACCIONES2 T, "~DBO~".MODELOSASIENTO M ")
  SQL.ADD(" where AC.NrTrans2 = '"~fbn['NrTrans']~"' ")
  SQL.ADD(" AND   AC.NrTrans2 = T.NrTrans ")
  SQL.ADD(" and   AC.Modelo   = M.Codigo  ")
  SQL.ADD(" and    M.TipoAsiento IN ("~Pipe2Comillas(Var('ROPFALLADA'))~") ")
  SQL.ADD(" AND   AC.FechaGeneracion < = "~idxdate2(Dialogo.Fecha1)~"      ")
  Recorrer SQL
     MESSAGE('Operacion '~fbn('NrOperacion'))
     ACT(nn:1, GetNumerador(810))
     SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON ")
     SQL.ADD(" ( FechaGeneracion, FechaValor, Vehiculo, Libro, ")
     SQL.ADD("   Modelo, Book, UDN, Centro, ")
     SQL.ADD("   Sector, NrLote, NrAsiento, NrUnicoAsiento, ")
     SQL.ADD("   NrOperacion, NrTrans2, Fecha1 ")
     SQL.ADD("    ) VALUES ( ")
     SQL.ADD("   "~Idxdate2(fsys)~", "~Idxdate2(fbn('Fecha5'))~", '"~fbn('Vehiculo')~"', '"~fbn('Libro')~"', ")
     SQL.ADD("   '"~fbn('Modelo')~"', '"~fbn('Book')~"', '"~fbn('UDN')~"', '"~fbn('Centro')~"', ")
     SQL.ADD("   '"~fbn('Sector')~"', '"~fbn('NrLote')~"', '"~fbn('NrUnicoAsiento')~"', '"~Val(nn:1)~"', ")
     SQL.ADD("   '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', "~Idxdate2(Dialogo.Fecha1)~" ) ")
     SQL.NEW

     SQL.ADD(" SELECT * FROM "~DBO~".ASIENTOSCON1 ")
     SQL.ADD(" WHERE NrUnicoAsiento = '"~fbn('NrUnicoAsiento')~"' ")
*     SQL.ADD(" AND   Alias3 IN ('1','2','5','6')  ")
     SQL.ADD(" AND   Alias3 IN ('1','2','5','6','9','10','11','12')  ")
     Recorrer SQL
       SQL.ADD(" INSERT INTO "~DBO~".ASIENTOSCON1 ")
       SQL.ADD(" (NrUnicoAsiento, Cuenta, DebitoCredito, Especie1, ")
       SQL.ADD(" Especie2, Especie3, Cantidad1, Cantidad2, ")
       SQL.ADD(" Cantidad3, NrOperacion, NrTrans2, Alias1, ")
       SQL.ADD(" Alias2, Alias3, Alias4, Alias5, ")
       SQL.ADD(" Detalle, CentroCosto ")
       SQL.ADD(" ) VALUES ( ")
       SQL.ADD(" '"~Val(nn:1)~"', '"~fbn('Cuenta')~"', ")
       If Eqstr(fbn('DebitoCredito'), 'DEB')
          SQL.ADD(" 'CRE', ")
       Else
          SQL.ADD(" 'DEB', ")
       Endif
       SQL.ADD(" '"~fbn('Especie1')~"', ")
       SQL.ADD(" '"~fbn('Especie2')~"', '"~fbn('Especie3')~"', "~fstr(fbn('Cantidad1'),0,2)~", "~fstr(fbn('Cantidad2'),0,2)~", ")
       SQL.ADD(" "~fstr(fbn('Cantidad3'),0,8)~", '"~fbn('NrOperacion')~"', '"~fbn('NrTrans2')~"', '"~fbn('Alias1')~"', ")
       SQL.ADD(" '"~fbn('Alias2')~"', '"~fbn('Alias3')~"', '"~fbn('Alias4')~"', '"~fbn('Alias5')~"', ")
       SQL.ADD(" 'BajaFalla', '"~fbn('CentroCosto')~"' ) ")
       SQL.NEW
     Proximo
     SQL.EXEC
  Proximo
Proximo

Message('Diferencia de Cambio ... ')
* Revalua la operacion fallada desde el dia de liquidacion hasta falla-1
* Agregado 17/05/05, porque no cierra la cuenta de op a liquidar luego de confirmar una falla 
* cuando el titulo cotiza en usd y la cotizacion vario desde la fecha de liq.
ENDIF

* SAQUE TODO LO DE ARRIBA PROQUE NO SE SI dbo LO NECESITA, ESO NO SE PUEDE DEDUCIR DE LOS MODELOS
* FO 24/09/2005


ACT(ce:1, VAR('CTRLENVIO'))
SQL.ADD(" select T.NrTrans, O.FechaVto, O.Especie, O.Cantidad, O.ContraEspecie, E.Cotiza, ")
SQL.ADD(" O.TipoOp, MA.Codigo CodAsi, O.NrOperacion, O.PaseCB, O.NrOperacion2 ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T,  "~DBO~".ESPECIES E, "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".MODELOSASIENTO MA ")
SQL.ADD(" where T.Especie = E.Codigo   ")
SQL.ADD(" AND   T.NrTrans = M.NrTrans2 ")
SQL.ADD(" and   M.NrOperacion = O.NrOperacion ")
SQL.ADD(" and   O.Especie     = M.Especie     ")
SQL.ADD(" AND   O.TipoOp      = MA.TipoOp ")
SQL.ADD(" and MA.TipoAsiento IN ("~Pipe2Comillas(VAR('TIPASIDIFC'))~")   ")
SQL.ADD(" and   O.ContraEspecie <>  '"~VAR('MONELOCA')~"'    ")
SQL.ADD(" AND   T.FechaConfir = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" and   T.RB6     = '1' ")
SQL.ADD(" and   E.Tipo <> 'MON' ")
SQL.ADD(" and   T.FechaFalla is NOT NULL ")
Recorrer SQL
  ACT(lf:1, 'LIQFALLA')
  
  If Val(re:1)<>0
     * -- 13/09/04 Si no controlo o no existe un asiento, lo genero.
     If Not Eqstr(Val(ce:1),'SI') o Vacio(SQL("Select NrUnicoAsiento from "~DBO~".ASIENTOSCON Where Modelo='"~fbn('CodAsi')~"' and NrOperacion='"~fbn('NrOperacion')~"' and FechaValor="~Idxdate2(Dialogo.Fecha1)~" ") )
        SQL.GenerarAsientoOp(fbn('CodAsi'), fbn('NrOperacion'),'','',810,Dialogo.Fecha1,Dialogo.Vehiculo1,,,,,,fbn('TipoOp'),,,,,,,fsys,Dialogo.Fecha1)
        SQL.EXEC
     Else
        message('La operacion ya tiene un asiento de Dif. Cambio por Liq. de Falla generado.')
     Endif  
  Endif
Proximo
