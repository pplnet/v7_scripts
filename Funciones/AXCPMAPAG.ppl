    if Val(aw1)>46 o Not Eqstr(Val(me:10),Val(me:20))
       if Not Eqstr(Val(me:10),Val(me:20))
          ACT(me:10,Val(me:20))
       Endif
       ifa
       if Dialogo.Radio1=1
          if Val(aw5)=0
             ACT(aw2, GetNumerador(990))
             ACN(aw3, Num(Val(aw2)))
          else
             SCN(aw3,1)
          endif
          setfilaactual(fac+3)
          IF EqStr(VAR('COPIATPAG'),'SI')
             ACT(l:fac, 'Folio: '~FStr(Val(aw4),1,0))
          ENDIF
          if val(ay1) = 0
             ACN(ay1, Val(aw3))
          endif
       else
          setfilaactual(fac+3)
           IF EqStr(VAR('COPIATPAG'),'SI')
              ACT(l:fac, 'Provisorio - Pag. '~FStr(Val(aw4),1,0))
           ENDIF   
       endif

       SaltarHoja    
       SCN(aw4, 1)
       IFA
       ACT(j:FAC+1, val(xx1))
       if Dialogo.Fecha2>Dialogo.Fecha1
          ACT(j:FAC+2, 'Registro de Operaciones desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
       else
          ACT(j:FAC+2, 'Registro de Operaciones del '~Dialogo.Fecha1)
       endif       
       AlinearCeldas(j:FAC+1..j:FAC+2,'C')

       ACT(q:fac+2, 'Cotizacion USD: '~fstr(Val(xx2),0,8))

       SetFilaActual(fac+4)

       ACT(a:FAC, 'Boleto')
       ACT(a:FAC+1, 'Nro Orden')
       ACT(b:FAC, 'Nro Minuta')
       ACT(b:FAC+1, 'Fecha Orden')
       ACT(b:FAC+2, 'Ejecucion')
       ACT(c:FAC, 'Fecha Op.')
       ACT(c:FAC+1, 'Hora Orden')
       ACT(c:FAC+2, 'Secuencia')
       ACT(d:FAC, 'Fecha Liq.')
       ACT(e:FAC, 'Tipo Op')
       ACT(f:FAC, 'Plazo')
       ACT(g:FAC, 'Nro Mercado')
       ACT(h:FAC, 'Cliente - Razon Social')
       ACT(h:FAC+1, 'CUIT - Comitente')
       *ACT(h:FAC, 'Comitente')
       *ACT(h:FAC+1, 'CUIT')
       ACT(i:fac, 'Especie')
       ACT(j:fac, 'Cantidad VN')
       ACT(j:fac+2, 'Cantidad VN')
       ACT(k:fac, 'Precio')
       ACT(k:fac+2, 'Precio')
       ACT(l:fac, 'Importe Bruto')
       ACT(m:fac, 'Intereses')
       ACT(n:fac, 'Importe Neto')
       ACT(o:fac, 'Comision')
       ACT(o:fac+1, 'IVA Comision')
       ACT(p:fac, 'Derechos')
       ACT(p:fac+1, 'IVA Derechos')
       ACT(q:fac, 'Gastos+IVA')
       ACT(r:fac, 'Monto Total')
       ACT(r:fac+2, 'Monto Total')
       ACT(s:fac, ' Cupon')
       ACT(t:fac, 'Age.')
       ACT(u:fac, 'Oper.')
       ACT(v:fac, 'Contr.')
       ACT(w:fac, 'Moneda')
       ACT(x:fac, 'Baja')
       ACT(y:fac, 'Mercado')
       
       AlinearCeldas(a:FAC..y:fac+2,'C')
       AgregarMarco(a:FAC..y:fac+2,2)
       SetFont(a:FAC..y:fac+2,2)

       *ACN(aw1, Val(aa:1))
       ACN(aw1, 6)
       IFA
       IFA
       IFA
    endif