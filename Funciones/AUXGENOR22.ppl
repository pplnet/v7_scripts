                    ** AUXGENOR22
                    ACN(NE:1,SQL(" Select IsNull(Max(NrEjecucion),0)+1 From "~DBO~".EJECUCIONES Where NrOrden='"~Val(t:53)~"' "))
                    ACT(w:1, Copy(Val(t:84),1,4)~'-'~Copy(Val(t:1),3,2)~'-'~Copy(Val(t:1),5,2)~' '~Copy(Val(t:1),7,2)~':'~Copy(Val(t:1),9,2)~':'~Copy(Val(t:1),11,2))
                     **Convert(datetime,'"~Val(w:1)~"',120)
                    SQL.ADD(" Insert Into "~DBO~".EJECUCIONES (NrOrden, NrOperacion, NrEjecucion, NrSecuencia, Fecha, Cantidad, Precio, Cantidad2) ")
                    SQL.ADD(" Values ('"~Val(t:53)~"', '"~Val(t:59)~"', '"~FStr(Val(NE:1),0,0)~"', '"~Val(u:1)~"', Convert(datetime,'"~Val(w:1)~"',120), '"~FStr(Val(t:11),0,2)~"', '"~FStr(Val(t:13),0,8)~"', '"~FStr(Val(t:11)*Val(t:13),0,2)~"') ")
                    SQL.NEW
                    SQL.EXEC
                    SQL.ADD(" Select SUM(Cantidad) as Cant ,SUM(Cantidad*Precio) CantPr From "~DBO~".EJECUCIONES Where NrOrden='"~Val(t:53)~"' ")
                    Recorrer SQL
                       ACN(ca:1,fbn('Cant'))
                       ACN(pr:1,Round((fbn('CantPr')/fbn('Cant')),8))
                    Proximo
                    ACT(SO:1,SQL(" Select MB1 From "~DBO~".ORDENES Where NrOrden='"~Val(t:53)~"' "))
                    if EqStr(Val(SO:1),'SI')
                       SQL.ADD(" Update "~DBO~".ORDENES Set ")
                       SQL.ADD("  CantidadTotalOrden   = "~FStr(Val(ca:1),0,0)~", ")
                       SQL.ADD("  Cuotas1              = "~FStr(Val(NE:1),0,0)~", ")
                       SQL.ADD("  Cantidad1            = "~FStr(Val(ca:1),0,2)~", ")
                       SQL.ADD("  Cantidad4            = "~FStr(Val(pr:1),0,8)~", ") 
                       SQL.ADD("  RuedaMAE             = '"~Val(t:32)~"' ")
                       SQL.ADD(" Where NrOrden         = '"~Val(t:53)~"' ")
                       SQL.NEW
                    else
                       SQL.ADD(" Update "~DBO~".ORDENES Set ")
                       SQL.ADD("  Cuotas1      = "~FStr(Val(NE:1),0,0)~", ")
                       SQL.ADD("  Cantidad1    = "~FStr(Val(ca:1),0,2)~", ")
                       SQL.ADD("  Cantidad4    = "~FStr(Val(pr:1),0,8)~", ") 
                       SQL.ADD("  RuedaMAE     = '"~Val(t:32)~"' ")
                       SQL.ADD(" Where NrOrden = '"~Val(t:53)~"' ")
                       SQL.NEW
                    endif
                    ** FIN AUXGENOR22 