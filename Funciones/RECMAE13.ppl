*/*******************************************************************
*/Interpreto los Registros 2102 y Completo la tabla PLAZOSOCT       *
*/*******************************************************************
*/Codigos Variables
*/AbrirASCII(Val(z2)~'\REC-2102.TXT',0)
*/EscribirASCII(Val(A:2))
*/CerrarASCII

ACT(ln1, Val(a:2))

**********************************************************
*/00560000000408201337543450421021ODOLAR$24 AGO 0000000009
*/Bloque de Control
*/0056000000040820133754345042102
*/Codigo de Movimiento ==>  1 (1- baja 2- alta)
*/Codigo de Negociacion ==> O
*/Codigo de Titulo ==> DOLAR
*/Moneda ==> $
*/Variable ==> 24 AGO 
*/Fecha de Liquidacion  ==> 00000000 (0 en baja - fecha en alta)
*/Due¤o de la info ==> 09
**********************************************************
ACN(z1,0)
if Eqstr(Trim(Copy(Val(ln1),33,1)),'O')
  ACT(s:2, 'Tipo Neg')
  ACT(t:2, Trim(Copy(Val(ln1),33,1)))
         
  ACT(s:3, 'Especie')
  ACT(t:3, Trim(Copy(Val(ln1),34,5)))
         
  ACT(t:3, SQL("Select EspecieDestino1 From "~DBO~".EQUIVALENCIA_ESPECIES Where EspecieOrigen = '"~Val(t:3)~"' and TipoNegociacion = '"~Val(t:2)~"' "))  
  if Vacio(Val(t:3))
    ACN(z1,1)      
    ACT(er:4, Pad('Especie Destino Inexistente',40)) 
  endif
         
  ACT(s:1, 'Movimiento')
  ACN(t:1, Num(Copy(Val(ln1),32,1)))
  if NOT [Val(t:1)>=0 y Val(t:1)<=3] 
    ACN(z1,1)      
    ACT(er:4, Pad('Movimiento Invalido',40)) 
  endif
         
  ACT(s:4, 'Variable')
  ACT(t:4, Trim(Copy(Val(ln1),40,7)))
  if Vacio(Val(t:4))
    ACN(z1,1)      
    ACT(er:4, Pad('Campo Variable NULL',40)) 
  endif
         
  ACT(s:5,'FechaLiq')
  ACN(t5, Fecha(Copy(Val(ln1),53,2)~'/'~Copy(Val(ln1),51,2)~'/'~Copy(Val(ln1),47,4)))
  if Val(t:5)=0 
    ACN(z1,1)      
    ACT(er:4, Pad('Fecha Liquidacion Invalida',40)) 
  endif
         
  ACN(x1,0)
  if Val(z1)=0
    If Val(t:1)=2
      ACN(x1, SQL("Select Count('*') from  "~DBO~".PLAZOSOCT Where Especie='"~Val(t:3)~"' and TipoNegociacion='"~Val(t:2)~"' and Variable= '"~Val(t:4)~"' "))
      if Val(x1)=0
        */Alta de Plazo
        SQL.ADD("Insert into "~DBO~".PLAZOSOCT ")
        SQL.ADD("(Especie,TipoNegociacion,Fecha,Variable,NroPlazo,Habilitado)")
        SQL.ADD(" Values ")
        SQL.ADD(" ('"~Val(t:3)~"', '"~Val(t:2)~"', '"~IdxDate(Val(t:5))~"', '"~Val(t:4)~"', 0, 'SI' )")
        SQL.NEW
      Else
        */Alta de Plazo Existente
        SQL.ADD("Update "~DBO~".PLAZOSOCT ")
        SQL.ADD("   Set Habilitado      = 'SI', ")
        SQL.ADD("       Fecha           = '"~IdxDate(Val(t:5))~"' ")
        SQL.ADD(" Where Especie         = '"~Val(t:3)~"' ")
        SQL.ADD("   and TipoNegociacion = '"~Val(t:2)~"' ")
        SQL.ADD("   and Variable        = '"~Val(t:4)~"' ")
        SQL.NEW
      Endif
    Endif
    If Val(t:1)=1
      */Baja de Plazo
      SQL.ADD("Update "~DBO~".PLAZOSOCT ")
      SQL.ADD("   Set Habilitado      = 'NO' ")
      SQL.ADD(" Where Especie         = '"~Val(t:3)~"' ")
      SQL.ADD("   and TipoNegociacion = '"~Val(t:2)~"' ")
      SQL.ADD("   and Variable        = '"~Val(t:4)~"' ")
      SQL.NEW
    Endif
    If Val(t:1)=3
      */Modificacion de Plazo (Solo Existen Modificaciones de Fecha de Liquidacion)
      SQL.ADD("Update "~DBO~".PLAZOSOCT ")
      SQL.ADD("   Set Fecha           = '"~IdxDate(Val(t:5))~"' ")
      SQL.ADD(" Where Especie         = '"~Val(t:3)~"' ")
      SQL.ADD("   and TipoNegociacion = '"~Val(t:2)~"' ")
      SQL.ADD("   and Variable        = '"~Val(t:4)~"' ")
      SQL.NEW
    Endif
    SQL.EXEC
    */Llamado al Evento que asigna los plazos.
    EjecutarEvento('OCTNPZ', Especie1=Val(t:3), String1=Val(t:2))
  else
    Message('*/Grabo en el Log de Errores')
    */Fecha 
    ACN(Y1, Ahora)
    ACT(Y2, Hora(Val(Y1)))
    ACT(Y3, Fecha(FSYS, Exe('FORFECMAE')))
    ***** Fecha
    ACT(er:1, Val(Y3))
    ***** Hora
    ACT(er:1, Val(er:1)~Copy(Val(Y2),1,2))
    ACT(er:1, Val(er:1)~Copy(Val(Y2),4,2))
    ACT(er:1, Val(er:1)~Copy(Val(Y2),7,2))
    */Codigo de Registro
    ACT(er:1, Val(er:1)~Copy(Val(ln1),28,4))
    */Motivo
    ACT(er:1, Val(er:1)~Val(er:4))
    */Contenido
    ACT(er:1, Val(er:1)~Val(ln1))
    AbrirASCII(Val(z2)~'\OCTERROR.TXT',0)
    EscribirASCII(Val(er:1))
    CerrarASCII
  endif 
endif
