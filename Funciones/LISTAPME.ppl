LISTA: RB2<>1 o Eqstr(ABM,'E') o [RB2=1 y Not Eqstr(ABM,'A') y Eqstr(Vehiculo1,VAR('VEHICULODE'))];CUOTAS1;
  Fecha1     : 'F.Origen'      ;NO   ;  ;;;IF(Fila=1,FECHAOP,CUOTASL.FECHA3[Fila-1])                              ;IF(Fila=1,FECHAOP,CUOTASL.FECHA3[Fila-1]);90;;Fecha;SI;;;
  Plazo1     : 'Plazo'         ;NO   ;SI;CUOTASL.PLAZO1[Fila]>0 y CUOTASL.PLAZO1[Fila]=CUOTASL.PLAZO2[Fila] o SI                                                                                                                                                                                               ; 'El plazo de la Cuota no puede ser 0 o Plazo incorrecto'       ;IF(Fila=CUOTAS1,VPRE3,VPRE2)                                                                                                                                                                               ;IF(Fila=CUOTAS1,VPRE3,VPRE2)             ;40;NO;Numero;'####';SI;SI;;SI
  Fecha2     : 'F.Vto.'        ;     ;SI;[[Fila<CUOTAS1 y CUOTASL.FECHA2[Fila]<FECHAVTO] o [Fila=CUOTAS1 y CUOTASL.FECHA2[Fila]=FECHAVTO]] y CUOTASL.FECHA2[Fila] >= CUOTASL.FECHA1[Fila] y ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1) y [ESHABIL(CUOTASL.FECHA3[Fila],'USA') O NOT EQSTR(ESPECIE,'USD')]; 'Fecha de Vencimiento erronea (No Habil/Menor origen/Mayor Vto Pmo';IF(Fila=CUOTAS1,FECHAVTO,IF(MODI,CUOTASL.FECHA2[Fila],CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]))   ;IF(Fila=CUOTAS1,FECHAVTO, IF(MB5=0, CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila] , IF(MODI,CUOTASL.FECHA2[Fila],IF(SI,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO2[Fila]+PLAZO-PLAZO,CUOTASL.FECHA3[Fila])))) ;90;;Fecha;SI;;'2';SI;
  Fecha3     : 'F.Vto.Real'    ;NO   ;SI;[CUOTASL.FECHA3[Fila]>=FECHAOP]                                                                                                                                                    ; 'Cuotas Vencidas'                                                  ;                                                                                                                                                                                                                        ;IF(Fila=CUOTAS1,FECHAVTO,IF(ESHABIL(CUOTASL.FECHA2[Fila],IF(Eqstr(ESPECIE,'USD'),'USA',TABLAFERIADOS1)) , CUOTASL.FECHA2[Fila] , HABILES(CUOTASL.FECHA2[Fila],IF(MB4=0,1,IF(MB4=1,-1,IF(MB4=2,IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],1,IF(Eqstr(ESPECIE,'USD'),'USA',TABLAFERIADOS1),SI)),1,-1),IF(Mes(CUOTASL.FECHA2[Fila])=Mes(HABILES(CUOTASL.FECHA2[Fila],-1,IF(Eqstr(ESPECIE,'USD'),'USA',TABLAFERIADOS1),SI)),-1,1)))),IF(Eqstr(ESPECIE,'USD'),'USA',TABLAFERIADOS1),SI)));90;;Fecha
  Plazo2     : 'P.Calc'        ;NO   ;  ;                                                                                                                                                                                                                                                                                    ;                                                                    ;CUOTASL.FECHA3[Fila]-CUOTASL.FECHA1[Fila]                                                                                                                                                                               ;CUOTASL.FECHA3[Fila]-CUOTASL.FECHA1[Fila]                                                                                                                                            ;40;NO;Numero;'####';SI;SI;;SI

  Cantidad1  : 'Imp Amort'     ;RB1=0;  ;[Fila=CUOTAS1 y CUOTASL.CANTIDAD1[Fila]>0 y Round(CUOTASL.CANTIDAD1[Fila],2)=Round(CUOTASL.CANTIDAD3[Fila],2)] o [Fila<CUOTAS1];'Capital de Ultima cuota erroneo';IF(MODI,CUOTASL.CANTIDAD1[Fila],IF(Fila=CUOTAS1,Round(VCAN11+CUOTAS1-CUOTAS1,2),Round(VCAN10+CUOTAS1-CUOTAS1,2)))     ;IF(MODI,CUOTASL.CANTIDAD1[Fila],IF(Fila=CUOTAS1,Round(CANTIDAD-(Sum(CUOTASL,6)-CUOTASL.CANTIDAD1[Fila])+CUOTAS1-CUOTAS1,2),IF(SI,Round(VCAN10+CUOTAS1-CUOTAS1,2),Round(CUOTASL.CANTIDAD1[Fila],2))))            ;120;;Numero;'###,###,###,###,###.##';SI;NO;;;;;

  Precio5    : '%Amort.'       ;SI   ;SI; ; ;IF(CUOTASL.CANTIDAD1[Fila]>0,(CUOTASL.CANTIDAD1[Fila]/CANTIDAD)*100,0) ;IF(CUOTASL.CANTIDAD1[Fila]>0,(CUOTASL.CANTIDAD1[Fila]/CANTIDAD)*100,0) ;80 ;;Numero;'###.##'                 ;SI;NO

  Tasa1      : 'Tasa'          ;RB1=0;MB2=1 y RB2<>1;                                                                                                             ;                                 ;IF(MB2=0,PRECIO1,IF(MODI,CUOTASL.TASA1[Fila],IF(Fila=1,PRECIO1,0)))                                                    ;CUOTASL.TASA1[Fila]                                                                                                                                    ; 80;;Numero;'###,###.######'        ;SI;NO;;
  Cantidad3  : 'Saldo'         ;NO   ;              ;                                                                                                             ;                                 ;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD3[Fila-1]-CUOTASL.CANTIDAD1[Fila-1])                                                ;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD3[Fila-1]-CUOTASL.CANTIDAD1[Fila-1])                                                                                ;120;;Numero;'###,###,###.##'        ;SI
  Cantidad2  : 'Intereses'     ;NO   ;RB2<>1        ;                                                                                                             ;                                 ;IF(RB2<>1,ROUND(CUOTASL.CANTIDAD3[Fila]*(CUOTASL.TASA1[Fila])*CUOTASL.PLAZO1[Fila]/(DIASA(DIASANIO,FECHAVTO)*100),2),0);IF(RB2<>1,IF(CUOTASL.CANTIDAD3[Fila]>0,ROUND(CUOTASL.CANTIDAD3[Fila]*(CUOTASL.TASA1[Fila])*CUOTASL.PLAZO1[Fila]/(DIASA(DIASANIO,FECHAVTO)*100),2),0),0);120;;Numero;'###,###,###,###,###.##';SI;;;;SI

  Total7     : 'Comisiones'    ;RB1=0;RB9=2;;;IF(RB9=2,IF(RB10=0,TOTALCOMISIONES,CUOTASL.CANTIDAD3[Fila]*CUOTASL.PLAZO1[Fila]*PORCOMISION/IF(DIASANIO=0,36000,36500)),0);IF(RB9=2,IF(RB10=0,TOTALCOMISIONES,CUOTASL.CANTIDAD3[Fila]*CUOTASL.PLAZO1[Fila]*PORCOMISION/IF(DIASANIO=0,36000,36500)),0);120;;Numero;'###,###.##';SI

  Cantidad9  : 'IVA Int.'      ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO1[Fila]/100,0);IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO1[Fila]/100,0);120;;Numero;'###,###.##';SI;;
  Cantidad10 : 'IVAAdic.Int.'  ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO2[Fila]/100,0);IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO2[Fila]/100,0);120;;Numero;'###,###.##';SI;;
  Cantidad11 : 'IVAPerc.Int.'  ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,IF(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO3[Fila]/100>=VAR('IVAPERMIN'),CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO3[Fila]/100,0),0);IF(NOT EQSTR(VEHICULO1,'INGCURA') y RB2<>1,IF(CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO3[Fila]/100>=VAR('IVAPERMIN'),CUOTASL.CANTIDAD2[Fila]*CUOTASL.PRECIO3[Fila]/100,0),0);120;;Numero;'###,###.##';SI;;
  Total3     : 'IVA Int.'      ;NO;NO;;;;CUOTASL.CANTIDAD9[Fila];;;Numero;'###,###.##';
  Total4     : 'IVAAdic.Int.'  ;NO;NO;;;;CUOTASL.CANTIDAD10[Fila];;;Numero;'###,###.##';
  Total5     : 'IVAPerc.Int.'  ;NO;NO;;;;CUOTASL.CANTIDAD11[Fila];;;Numero;'###,###.##';

  Cantidad13 : 'IVA Com.'      ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB9=2;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')],CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO8[Fila]/100,0);IF(Not [Eqstr(VEHICULO1,'INGCURA')],CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO8[Fila]/100,0);120;;Numero;'###,###.##';SI;;
  Cantidad14 : 'IVAAdic.Com.'  ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB9=2;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')],CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO9[Fila]/100,0);IF(Not [Eqstr(VEHICULO1,'INGCURA')],CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO9[Fila]/100,0);120;;Numero;'###,###.##';SI;;
  Cantidad15 : 'IVAPerc.Com.'  ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB9=2;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')],IF(CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO10[Fila]/100>=VAR('IVAPERMIN'),CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO10[Fila]/100,0),0);IF(Not [Eqstr(VEHICULO1,'INGCURA')],IF(CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO10[Fila]/100>=VAR('IVAPERMIN'),CUOTASL.TOTAL7[Fila]*CUOTASL.PRECIO10[Fila]/100,0),0);120;;Numero;'###,###.##';SI;;
  Total6     : 'IVA Com.'      ;NO;NO;;;;CUOTASL.CANTIDAD13[Fila];;;Numero;'###,###.##';
  Plazo3     : 'IVAAdic.Com.'  ;NO;NO;;;;CUOTASL.CANTIDAD14[Fila];;;Numero;'###,###.##';
  Plazo4     : 'IVA Com.'      ;NO;NO;;;;CUOTASL.CANTIDAD15[Fila];;;Numero;'###,###.##';

  Cantidad4  : 'Monto'         ;NO;  ;;;CUOTASL.CANTIDAD4[Fila];ROUND(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD2[Fila]+CUOTASL.TOTAL7[Fila]+CUOTASL.CANTIDAD9[Fila]+CUOTASL.CANTIDAD10[Fila]+CUOTASL.CANTIDAD11[Fila]+CUOTASL.CANTIDAD13[Fila]+CUOTASL.CANTIDAD14[Fila]+CUOTASL.CANTIDAD15[Fila],2);120;;Numero;'###,###,###,###,###.##';SI

  Cantidad5  : 'Saldo Cap.'    ;NO;NO;;;CUOTASL.CANTIDAD1[Fila];CUOTASL.CANTIDAD1[Fila];120;;Numero;'###,###,###,###,###.##';SI
  Cantidad6  : 'Saldo Int.'    ;NO;NO;;;IF(RB2<>1,CUOTASL.CANTIDAD2[Fila],0);IF(RB2<>1,CUOTASL.CANTIDAD2[Fila],0);120;;Numero;'###,###,###,###,###.##';SI
  Cantidad12 : 'Saldo Com.'    ;NO;NO;;;CUOTASL.TOTAL7[Fila];CUOTASL.TOTAL7[Fila];120;;Numero;'###,###.##';SI;;

  Precio1    : '%IVA Int.'     ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,MontoImpuesto('IVANORINT',CUOTASL.FECHA1[Fila],3,VTXT16),0);IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,MontoImpuesto('IVANORINT',CUOTASL.FECHA1[Fila],3,VTXT16),0);80;;Numero;'###,###.##';SI;NO;
  Precio2    : '%IVAAdic.Int.' ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,MontoImpuesto('IVAADIINT',CUOTASL.FECHA1[Fila],3,VTXT16),0);IF(Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1,MontoImpuesto('IVAADIINT',CUOTASL.FECHA1[Fila],3,VTXT16),0);80;;Numero;'###,###.##';SI;NO;
  Precio3    : '%IVAPerc.Int.' ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB2<>1;;;IF(NOT EQSTR(VEHICULO1,'INGCURA') y RB2<>1,IF(EQSTR(VTXT1,'SI'),IF(EQSTR(VTXT2,'SI'),MontoImpuesto('IVAPERINT',CUOTASL.FECHA2[Fila],3,'')*(IF(CUOTASL.FECHA2[Fila]>=BuscarCampo('CLIENTES','FDesdeExIVA','Codigo',CLIENTE1) y CUOTASL.FECHA2[Fila]<=BuscarCampo('CLIENTES','FHastaExIVA','Codigo',CLIENTE1),1-VCAN7/100,1)),MontoImpuesto('IVAPERINT',CUOTASL.FECHA2[Fila],3,'')),0),0);IF(NOT EQSTR(VEHICULO1,'INGCURA'),IF(EQSTR(VTXT1,'SI'),IF(EQSTR(VTXT2,'SI'),MontoImpuesto('IVAPERINT',CUOTASL.FECHA2[Fila],3,'')*(IF(CUOTASL.FECHA2[Fila]>=BuscarCampo('CLIENTES','FDesdeExIVA','Codigo',CLIENTE1) y CUOTASL.FECHA2[Fila]<=BuscarCampo('CLIENTES','FHastaExIVA','Codigo',CLIENTE1),1-VCAN7/100,1)),MontoImpuesto('IVAPERINT',CUOTASL.FECHA2[Fila],3,'')),0),0);80;;Numero;'###,###.##';SI;NO

  Precio8    : '%IVA Com.'     ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB9=2;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')],MontoImpuesto('IVANORCOM',CUOTASL.FECHA1[Fila],3,VTXT16),0);IF(Not [Eqstr(VEHICULO1,'INGCURA')],MontoImpuesto('IVANORCOM',CUOTASL.FECHA1[Fila],3,VTXT16),0);80;;Numero;'###,###.##';SI;NO;
  Precio9    : '%IVAAdic Com.' ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB9=2;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')],MontoImpuesto('IVAADICOM',CUOTASL.FECHA1[Fila],3,VTXT16),0);IF(Not [Eqstr(VEHICULO1,'INGCURA')],MontoImpuesto('IVAADICOM',CUOTASL.FECHA1[Fila],3,VTXT16),0);80;;Numero;'###,###.##';SI;NO;
  Precio10   : '%IVAPerc.Com.' ;NO;Not [Eqstr(VEHICULO1,'INGCURA')] y RB9=2;;;IF(Not [Eqstr(VEHICULO1,'INGCURA')],IF(EQSTR(VTXT1,'SI'),IF(EQSTR(VTXT2,'SI'),MontoImpuesto('IVAPERCOM',CUOTASL.FECHA2[Fila],3,'')*(IF(CUOTASL.FECHA2[Fila]>=BuscarCampo('CLIENTES','FDesdeExIVA','Codigo',CLIENTE1) y CUOTASL.FECHA2[Fila]<=BuscarCampo('CLIENTES','FHastaExIVA','Codigo',CLIENTE1),1-VCAN7/100,1)),MontoImpuesto('IVAPERCOM',CUOTASL.FECHA2[Fila],3,'')),0),0);IF(Not [Eqstr(VEHICULO1,'INGCURA')],IF(EQSTR(VTXT1,'SI'),IF(EQSTR(VTXT2,'SI'),MontoImpuesto('IVAPERCOM',CUOTASL.FECHA2[Fila],3,'')*(IF(CUOTASL.FECHA2[Fila]>=BuscarCampo('CLIENTES','FDesdeExIVA','Codigo',CLIENTE1) y CUOTASL.FECHA2[Fila]<=BuscarCampo('CLIENTES','FHastaExIVA','Codigo',CLIENTE1),1-VCAN7/100,1)),MontoImpuesto('IVAPERCOM',CUOTASL.FECHA2[Fila],3,'')),0),0);80;;Numero;'###,###.##';SI;NO
