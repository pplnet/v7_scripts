  *- Validaciones: o1: Indica si se produjo un error de validacion (0-No y 1-Error)
  ACN(o1,0)

  *- Controlo el BOLETO (a12) de la Operacion
  If Vacio(val(a12))
    *- Boleto Vacio
    ACN(o1,1)
    AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
    EscribirASCII('Error en Numero de Boleto')
    CerrarASCII
  EndIF

  *- Controlo la SUCURSAL (a13) de la Operacion
  If SQL("Select 1 from "~DBO~".SUCURSALES where CAST(Codigo as Int)="~val(a13)) <> 1
    *- NO Existe la Sucursal
    ACN(o1,1)
    AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
    EscribirASCII('Error en Boleto: '~Val(a12)~' - Sucursal Inexistente: '~val(a13))
    CerrarASCII
  EndIF

  *- Controlo el Tipo (a11) de la Operacion
  IF NOT[Incluido(val(a11),'A13|A23|A14|A24|A11|A21|A12|A22|A15|A25|A16|A26|')] 
    *- NO Existe el Tipo Operacion
    ACN(o1,1)
    AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
    EscribirASCII('Error en Boleto: '~Val(a12)~' - Tipo de Operacion Inexistente: '~val(a11))
    CerrarASCII
  ELSE
    *- Leo el Tipo Operacion en B11 y dejo el Estado en C11
    ACN(d11, DifDias(Val(b16),Val(b15),Val(De:4),SI))
    IF Incluido(VAL(A:11),'A13|A14|A23|A24|')
      IF Val(D11)>3 
        ACT(B11,'FXCT')
      ELSE
        ACT(B11,'FXC')
      ENDIF
      IF Incluido(VAL(A:11),'A13|A14|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A13|A14|A23|A24|')
      IF Val(D11)>3 
        ACT(B11,'FXCT')
      ELSE
        ACT(B11,'FXC')
      ENDIF
      IF Incluido(VAL(A:11),'A13|A14|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A11|A21|A12|A22|')
      IF Val(D11)>3 
        ACT(B11,'FXVT')
      ELSE
        ACT(B11,'FXV')
      ENDIF
      IF Incluido(VAL(A:11),'A11|A12|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A15|A25|')
      ACT(B11,'FXC')
      IF Incluido(VAL(A:11),'A15|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A15|A25|')
      ACT(B11,'FXC')
      IF Incluido(VAL(A:11),'A15|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A16|A26|')
      ACT(B11,'FXV')
      IF Incluido(VAL(A:11),'A16|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
  ENDIF

  *- Verifico si es Alta/Baja de la Operacion
  IF Incluido(VAL(C:11),'DES|') y VAL(o1)=0
  *- BAJA de Operacion
     *- Verifico SI Existe la clave de la Operacion: SUCURSAL (a13) + BOLETO (a12)    
     If SQL("Select 1 from "~DBO~".OPERACIONES where NrBoleto='"~val(a12)~"' and Sucursal='"~val(a13)~"'")<>1
     *- NO Existe la Operacion
        AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
        EscribirASCII('Error en Baja - Operacion Inexistente: '~Val(a13)~'-'~Val(a12))
        CerrarASCII
     ELSE
     *- SI Existe la Operacion
        ACT(o2, SQL("Select NrOperacion from "~DBO~".OPERACIONES where NrBoleto='"~val(a12)~"' and Sucursal='"~val(a13)~"'") )
        message('en baja '~Val(o2))
        *- Borro la Operacion
        SQL.ADD("DELETE FROM "~DBO~".OPERACIONES WHERE NrBoleto='"~val(a12)~"' and Sucursal='"~val(a13)~"'")
        SQL.NEW
        SQL.EXEC
        *- Borro los movimientos asociados a la Operacion
        SQL.ADD("DELETE FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion ='"~val(o2)~"'")
        SQL.NEW
        SQL.EXEC
        SQL.ADD("DELETE FROM "~DBO~".MOVPOSEJE WHERE NrOperacion ='"~val(o2)~"'")
        SQL.NEW
        SQL.EXEC
     EndIF
  ELSE
     *- ALTA de Operacion
     *- Verifico SI Existe la clave de la Operacion: SUCURSAL (a13) + BOLETO (a12)    
     If SQL("Select 1 from "~DBO~".OPERACIONES where NrBoleto='"~val(a12)~"' and Sucursal='"~val(a13)~"'")<>0
       *- SI Existe la Operacion
       ACN(o1,1)
       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
       EscribirASCII('Error en Alta - Operacion Existente: '~Val(a13)~'-'~Val(a12))
       CerrarASCII
     EndIF

*--- CLAUDIA: OK ( No validar el cliente contra la tabla de clientes y no grabar excepcion si no existe )
*--- OK ( EN LUGAR DE RECUPERAR EL CLIENTE CON TIPO Y NRO. DE DOCUMENTO VAS A CREAR UNA VARIABLE CLIGLOB Valor: CLIGLOB )
*--- OK ( Recuper la variable de clientes ( *****QUE SIGNIFICA, b19=CLIGlOB**** ) en la celda b18, b19 es fijo 'CLI' )
*--- DAR DE ALTA EL CLIENTE EN LA TABLA DE CLIENTES DESCENDIENDO DE 'CLIENTES' 

     ACT(b18, VAR('CLIGLOB'))
     ACT(b19, 'CLI') 

     *- Controlo el Concepto (a14) de la Operacion
     IF Not[Incluido(VAL(B:19),'BAN|')]
       *- Si NO ES Banco Controlo el Concepto
       IF Incluido(VAL(B:11),'FXC|FXCT|')
         *- Controlo Concepto de Compra
         If SQL("Select 1 from "~DBO~".CONCEPTOSBCRA where Codigo="~val(a14)~" and Alias1='COMPRA'" ) <> 1
         *- NO Existe el Concepto
           ACN(o1,1)
           AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
           EscribirASCII('Error en Boleto: '~Val(a12)~' - ConceptoBCRA1 Inexistente: '~val(a14))
           CerrarASCII
         EndIF
       EndIF
       IF Incluido(VAL(B:11),'FXV|FXVT|')
         *- Controlo Concepto de Venta
         If SQL("Select 1 from "~DBO~".CONCEPTOSBCRA where Codigo="~val(a14)~" and Alias1='VENTA'" ) <> 1
         *- NO Existe el Concepto
           ACN(o1,1)
           AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
           EscribirASCII('Error en Boleto: '~Val(a12)~' - ConceptoBCRA2 Inexistente: '~val(a14))
           CerrarASCII
         EndIF
       EndIF
     ELSE
       *- Si ES Banco no lleva Concepto
       ACT(A14,'')
     EndIF

     *- Controlo el Codigo de la Moneda (a21) con Especie.Valor10
     If SQL("Select 1 from "~DBO~".ESPECIES where Valor10="~val(a21)~"") <> 1
       *- NO Existe el Codigo
       ACN(o1,1)
       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
       EscribirASCII('Error en Boleto: '~val(a12)~' - CodigoEspecie2 Inexistente: '~val(a21))
       CerrarASCII
     ELSE
       *- Busco el CodigoEspecie
       ACT(b21,SQL("Select Codigo from "~DBO~".ESPECIES where Valor10="~val(a21)~""))
     EndIF

     *- Controlo la Fecha de la Operacion (a15) 
     If  Fecha(val(b15)) > FSys O NOT[EsHabil(Fecha(val(b15)),Val(De:4))]
       *- Error
       ACN(o1,1)
       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
       EscribirASCII('Error en Boleto: '~val(a12)~' - Fecha Operacion No Valida: '~val(a15))
       CerrarASCII
     EndIF

     *- Controlo la Fecha de la Liquidacion (a16) 
     If  NOT[EsHabil(Fecha(val(b16)),Val(De:4))]
       *- Error
       ACN(o1,1)
       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
       EscribirASCII('Error en Boleto: '~val(a12)~' - Fecha Liquidacion No Valida: '~val(a16))
       CerrarASCII
     EndIF

     *- Controlo la Ent. Cpa/Vta (a17)
     If SQL("Select 1 from "~DBO~".CLIENTES where CodigoBCRA="~val(a17)~"") <> 1
       *- Error
       ACN(o1,1)
       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
       EscribirASCII('Error en Boleto: '~val(a12)~' - CodigoBCRA No Valido2: '~val(a18)~'/'~val(a19))
       CerrarASCII
     EndIF

     *- Controlo la Fecha de Carga (b39) 
     If NOT[EsHabil((val(b39)),Val(De:4))] Y EqStr(Val(c11),'DES')
       *- Error
       ACN(o1,1)
       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
       EscribirASCII('Error en Boleto: '~val(a12)~' - Fecha de Carga No Valida: '~val(a39))
       CerrarASCII
     EndIF

     *- vadi-tipo-liquidacion (N3) 
     *- Definiciones de Mercados  => me1: Mercado Efectivo
     ACT(me1,VAR('MERCEFEC'))
     ACT(me2,VAR('MERCTRANS'))
     ACT(me3,VAR('MERCBCRA'))
     ACT(me4,VAR('MERSWIFT'))
     *-  b25 => 'Mercado'
     *-  c25 => 'Mercado2'
     IF EqStr(Val(a25),'1')
       ACT(b25,val(me1))
       ACT(c25,val(me1))
     ELSE
       IF EqStr(Val(a25),'2')
         ACT(b25,val(me1))
         ACT(c25,val(me3))
       ELSE
         IF EqStr(Val(a25),'3')
           ACT(b25,val(me1))
           ACT(c25,'CC')
         ELSE
           IF EqStr(Val(a25),'4')
             ACT(b25,val(me1))
             ACT(c25,'CA')
           ELSE
             IF EqStr(Val(a25),'6')
               ACT(B25,val(me4))
               ACT(C25,val(me1))
             ELSE
               IF EqStr(Val(a25),'7')
                 ACT(B25,val(me4))
                 ACT(C25,val(me3))
               ELSE
                 IF EqStr(Val(a25),'8')
                   ACT(B25,val(me4))
                   ACT(C25,'CC')
                 ELSE
                   IF EqStr(Val(a25),'9')
                     ACT(B25,val(me4))
                     ACT(C25,'CA')
                   ELSE
                     IF EqStr(Val(a25),'11')
                       ACT(B25,val(me3))
                       ACT(C25,val(me3))
                     ELSE
                       *- Error
                       ACT(B25,'ERROR')
                       ACT(C25,'ERROR')
                       ACN(o1,1)
                       AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
                       EscribirASCII('Error en Boleto: '~val(a12)~' - TipoLiquidacion No Valida: '~val(a25))
                       CerrarASCII
                     EndIf
                   EndIf
                 EndIf
               EndIf
             EndIf
           EndIf
         EndIf
       EndIf
     EndIf

     *- INST-VTA vadi-cod-inst-vta (N2)
     *- INST-RECI vadi-cod-int-reci (N2)
     *- No los utilizo ya que se arman para la interfase de salida y no aportan datos.

     *- Selecciono los datos de la cuenta corresponsal
     IF NOT[EqStr(val(b:25),val(me1))]
        IF SQL("SELECT 1 FROM "~DBO~".CUENTAS WHERE Estado='HAB' AND Mercado='"~Val(b:25)~"' and Numero='"~Val(a:35)~"'") <> 1
           *- Error
           ACN(o1,1)
           AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
           EscribirASCII('Error en Boleto: '~val(a12)~' - CuentaCorresponsal No Valida: '~val(a35))
           CerrarASCII
        ELSE
           ACT(B:35,SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Estado='HAB' AND Mercado='"~Val(b:25)~"' and Numero='"~Val(a:35)~"'"))
        EndIF
     EndIF

     *- Selecciono los datos del operador
     ACT(b:10, SQL("SELECT Codigo FROM "~DBO~".USUARIOS WHERE Alias2='"~Val(a:10)~"'"))
     IF NoVacio(Val(b10))
       ACT(a:10,val(b10))
     EndIf

     *- Calculo los Campos según el tipo de Operacion
     IF VAL(o1)=0
        *-Precio2          : 'Euro/USD'       ; 9;2;2;VCAN1<>0 Y Not EV;VCAN1<>0;[VCAN1<>0 Y PRECIO2>0] O PRECIO2>=0 ;'El Tipo de Cambio EURO/USD debe ser Positivo';NO;COTIZACION('EUR',,,,FECHAOP,1);IIF(VCAN1<>0 THEN IIF(EqStr(CampoModificado,'PRECIO1') THEN VCAN1/(1/PRECIO1) ELSE COTIZACION('EUR',,,,FECHAOP,1) ENDIF) ENDIF);  
        ACN(e:10,COTIZACION('EUR',,,,Val(b:15),1))
        *-TotalBrutoCli1   : 'Monto'          ; 5;1;1;Not EV;;;;;0;IIF(EqStr(CampoModificado,'TOTALBRUTOCLI1') THEN TOTALBRUTOCLI1 ELSE CANTIDAD*PRECIO1 ENDIF);
        ACN(e:11, Round(Num(Val(a23))*Val(b22),2))
        *-TotalNetoCli3    : 'Equiv.Euro'     ; 3;2;1;NO;VCAN1<>0;;;;;CANTIDAD/VCAN1;
        ACN(e:12, Num(Val(a23)))
        *-Plazo: FECHAPAGO-FECHAOP
        IF Incluido(Val(b11),'FXC|FXV|')
           *- Operaciones FXC y FXV
           ACN(e:13, DifDias(Val(b16),Val(b15),Val(De:4),SI))
        ELSE
           ACN(e:13, DifDias(Val(b16),Val(b15),'',NO))
        ENDIF
        *-CB8              : 'M.Cierre Pmo'   ;13;2; ;Not EV;NO;;;;0
        ACN(e:14, 0)
        *-Cotizacion1      : 'Cotizacion'     ; 7;1;2;NO;NO;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP');COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP');
        ACN(e:15, COTIZACIONC(Val(b21),,,,Val(b15),1,SI,'ARP'))
        *-CB6              : 'Cot.Esp/ContDirecta'  ;4;2;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
        ACN(e:16,IIF(eqstr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~Val(b21)~"' and Especie2='ARP' "),'INV'),0,1))
        *-Campos Especificos 
        IF Incluido(Val(b11),'FXC|FXV|')
           *- Operaciones FXC y FXV
           *-Precio4          : 'Cotizacion'     ;1;1;2;NO;NO;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP'),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP'))
           ACN(e:17,IIF(Val(e16)=1,COTIZACIONC(Val(b21),,,,Val(b15),1,SI,'ARP')/COTIZACIONC('ARP',,,,Val(b15),1,SI,'ARP'),COTIZACIONC('ARP',,,,Val(b15),1,SI,'ARP')/COTIZACIONC(Val(b21),,,,Val(b15),1,SI,'ARP')))
           *-Cotizacion2      : 'CotizEsp-USD'   ;13;1;2;NO;;;;;;IF(NoVacio(BOOK1), COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));;;;;'###,###.########'
           ACN(e:18, COTIZACIONC(Val(b21),,,,Val(b15),1,SI,'USD'))
        ELSE 
           *- Operaciones FXCT y FXVT
           ACN(e:17,(Val(b22)))
           *-Cotizacion2      : 'Cotiz. Futuro'  ; 2;2;2;NO;NO;;;;;COTIZACION(ESPECIE,,FECHAVTO,,FECHAOP,1,SI,SI);
           ACN(e:18, COTIZACION(Val(b21),,Val(b16),,Val(b15),1,SI,SI))
        EndIF
        *-InteresesCorr    : 'C.CE USD'       ;14;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, INTERESESCORR, if(EqStr(Modo(CONTRAESPECIE,'USD'),'INV'),PRECIO1/COTIZACION2,COTIZACION2/PRECIO1)));;;;;'###,###.########'
        ACN(e:19,iif(EqStr(Modo('ARP','USD'),'INV'),VAL(b22)/VAL(E:18),VAL(E:18)/VAL(b22)))
        *-TipoCambio       : 'Precio Mer.'    ; 7;1;2;NO;  ;;;;;IIF(Incluido(ESPECIE,'USD|USB|GBP|EUR') O SI THEN COTIZACION1 ELSE 1/COTIZACION1 ENDIF);
        ACN(e:20,IIF(Incluido(Val(b21),'USD|USB|GBP|EUR') O SI,VAL(E:15),1/VAL(E:15)))
        *-Corredor
        ACT(e:21, Val(De:3))
        *-RB9              IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), -1)
        ACN(e:22, -1)
        *-PorComision    ValorComCorredor(CORREDOR,ESPECIE,TIPOOP,VTXT7)
        * VTXT7  IIF(RB9=1,'AGE',IIF(RB9=0,'AGI','AMB'))
        ACN(e:23, ValorComCorredor(Val(e21),val(b21),val(b11),IIF(val(e22)=1,'AGE',IIF(val(e22)=0,'AGI','AMB'))))
        IF Incluido(Val(b11),'FXC|FXV|')
           *- Operaciones FXC y FXV
           *-TotalBrutoCli2   : 'Total USD Eq.'  ; 1;1;2;NO;;;;;;CANTIDAD*COTIZACION2
           ACN(e:24,Num(Val(a23))*Val(e18) )
        ELSE
           *- Operaciones FXCT y FXVT
           *-TotalAux5        : 'CotiC Esp/USD'  ;15;1;2;NO;;;;;;IF(NoVacio(BOOK1), COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));;;;;'###,###.########'
           ACN(e:54,COTIZACIONC(Val(b21),,,,Val(b15),1,SI,'USD'))
           *-TotalBrutoCli2   : 'Total USD Eq.'  ; 1;1;2;NO;;;;;;CANTIDAD*TOTALAUX5;
           ACN(e:24,Num(Val(a23))*Val(e54) )
        EndIF
        *-TotalBrutoCli3   : 'Total PreSettl.'; LIMCONSUMIDO(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)+TOTALAUX3)
        *-PorCaucion       : 'RiskWeighting'  ; Query("Select Factor from "~DBO~".RISKWEIGHT where Especie = '"~VTXT15~"' and TipoOp = '"~TIPOOP~"' and FormaLiquidacion = '"~VTXT16~"' and Plazo >= "~VPRE5~" and Fecha <= '"~IdxDate(FECHAOP)~"' order by Fecha desc, Plazo")
        *-TotalAux3        : 'PreSettlement'  ; IF(Incluido(ESPECIE,'USD|USB|ULI'),CANTIDAD,TOTALBRUTOCLI1*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'USD'))*if(PORCAUCION=0,Var('PORPRESMON')/100,PORCAUCION/100))
        *-VTXT10           : 'Controlante'    ; 9;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~CLIENTE1~"' "))
        *-VTXT11           : 'Controlante'    ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),IF(VACIO(VTXT10),CLIENTE1,CLIENTE1))
        ACT(i:25,Val(b18))
        ACT(h:25,'STD')
        ACN(g:25,SQL("Select Factor from "~DBO~".RISKWEIGHT where Especie = '"~Val(b21)~"' and TipoOp = '"~Val(b11)~"' and FormaLiquidacion = '"~Val(h25)~"' and Plazo >= "~Val(e13)~" and Fecha <= '"~IdxDate(Val(b15))~"' order by Fecha desc, Plazo"))
        ACN(f:25,Round(IIF(Incluido(Val(b21),'USD|USB|ULI'),Num(Val(a23)),Val(e11)*COTIZACIONC('ARP',,,,Val(b15),1,SI,'USD'))*iif(Val(g25)=0,Var('PORPRESMON')/100,Val(g25)/100),2))
        *-Campos No Comunes
        IF Incluido(Val(b11),'FXC|FXV|')
           *- Operaciones FXC y FXV
           ACN(J:25, LIMCONSUMIDO(Val(i:25),'PRESETTLEM','USD',-1,Val(De2)))
           ACN(e:25,Round(LIMCONSUMIDO(Val(i:25),'PRESETTLEM','USD',-1,Val(De2))+Val(f:25),2))
        ELSE
           *- Operaciones FXCT y FXVT
           *-TotalBrutoCli3   : 'Total PreSettl.';10;2;2;NO;  ;;;;;IF(NoVacio(BOOK1), LIMCONSUMIDO(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)+TOTALAUX3)
           *-LIMCONSUMIDO(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)+TOTALAUX3)
           ACN(e:25,LIMCONSUMIDO(Val(i:25),'PRESETTLEM','USD',-1,Val(De2))+Val(f:25))
        ENDIF
        *-Comision         : 'Comision (%o)'  ; 9;1; ;Not EV Y NoVacio(CORREDOR);;;;;;IIF(Vacio(CORREDOR) THEN 0 ELSE IIF(EqStr(CAMPOMODIFICADO,'COMISION') THEN COMISION ELSE IIF(EqStr(CAMPOMODIFICADO,'TOTALCOMISIONES') THEN TOTALCOMISIONES*100/TOTALBRUTOCLI1 ELSE PORCOMISION ENDIF) ENDIF) ENDIF);;;;;'###,###.######';;SI
        ACN(e:26, Val(e:23))
        *-TotalComisiones  : 'Importe Com.'   ;10;1; ;Not EV;;;;;;TOTALBRUTOCLI1*COMISION/100;
        ACN(e:27,Round(val(e11)*val(e26)/100,1))
        *-RB2              : 'Circ.3619'      ;13;1; ;Not EV Y [Incluido(CONCEPTOBCRA,'101|102')];[incluido(CONCEPTOBCRA,'101|102')];RB2=0 o [Incluido(CONCEPTOBCRA,'101|102')];'La Operacion no puede ser Circular 3619';NO;0;IIF(Incluido(CONCEPTOBCRA,'101|102') THEN RB2 ELSE 0 ENDIF);
        ACN(e:28,0)
        *-PorDerechoBolsa  : 'C.Esp ARP'      ;14;1;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORDERECHOBOLSA, PRECIO1));;;;;'###,###.########'
        ACN(e:29,Val(b22))
        *-PorImpuestoBolsa : 'C.Esp USD'      ;15;1;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORIMPUESTOBOLSA, if(EqStr(Modo(ESPECIE, 'USD'),'INV'), 1/COTIZACION2, COTIZACION2)));;;;;'###,###.########'
        ACN(e:30,iif(EqStr(Modo(Val(b21), 'USD'),'INV'), 1/Val(e18), Val(e18)))
        *-PorDerechoMercado: 'C.CE ARP'       ;15;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORDERECHOMERCADO, 1));;;;;'###,###.########'
        ACN(e:31,1)
        *-VCAN20           : 'Cliente'        ;1;1;1;NO;NO;;;;IF(EqStr(BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1),'CLI'),1,0);IF(EqStr(BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1),'CLI'),1,0);
        ACN(f:32,IIF(EqStr(Val(b19),'CLI'),1,0))
        *-Cuenta1          : 'Cta.Esp.Veh.'   ;15;1;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o VACIO(CUENTA1);;;IF(VCAN20=0,CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP));IF(VCAN20=0,IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP)));;;;;;" Estado='HAB' and Mercado='"~MERCADO~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ";
        ACT(e:32,IIF(Val(f:32)=0,CUENTACLIENTE(Val(de2),Val(b21),,Val(b25),Val(b11))))
        *-Cuenta2          : 'Cta.Mon.Veh.'   ;15;2;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))] o VACIO(CUENTA2) ;;;IF(VCAN20=0,CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP)),0);IF(VCAN20=0,IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP))));;;;;;" Estado='HAB' and Mercado='"~MERCADO2~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') ";
        ACT(e:33,IIF(Val(f:32)=0,CUENTACLIENTE(Val(de2),'ARP',,Val(c25),Val(b11))))
        *-Cuenta4
        ACT(b:36,SQL("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Estado='HAB' AND Mercado='"~Val(c:25)~"' and Cliente='"~Val(b:18)~"'"))
        *-FechaPago
        ACD(e:37, Val(B:16))
        *-Puesto           : 'Puesto'                 ; 8;2;;Not EV;;;;;1;
        ACT(e:38, IIF(Val(B:16)=Val(e:37),'1','0'))
        *-ValorRB1 : 'Valor|Hoy|Normal|48hs|72hs|Otro'; 7;2;;Not EV;;;;;0;
        ACT(e:39, IIF(VAL(E13)>3,'4',FStr(VAL(E13),1,0)))
        *-FormaLiquidacion1: 'Liquidacion|STD|DVP|RVP'; 9;2;;PUESTO=1 Y Not EV;PUESTO=1;FORMALIQUIDACION1>=0;'Forma de Liquidacion Invalida';NO;;IIF(PUESTO=0 THEN 0 ELSE IIF(MODI THEN FORMALIQUIDACION1 ELSE FORMALIQUIDACION1 ENDIF) ENDIF);
        ACT(e:40,'0')
        *-VCAN9            : 'T.Settlement'   ;9 ;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMSUMADO(VTXT11,'SETTLEMENT',FECHAPAGO,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2);;;;;'###,###,###,###.##'
        ACN(e:41, LIMSUMADO(Val(i25),'SETTLEMENT',Val(e:37),Val(De2))+Val(e:24))
        *-VCAN10           : 'T.Settlement'   ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMSUMADO(VTXT11,'SETTLEMENT',FECHAVTO ,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2);;;;;'###,###,###,###.##'
        ACN(e:42, LIMSUMADO(Val(i25),'SETTLEMENT',Val(b:16),Val(De2))+Val(e:24))
        *-MinArancel (fxc)      : 'Exc Settlem F.Vto'   ;13;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o PUESTO=1 o FORMALIQUIDACION1=1 o [VALORRB1=0 y PUESTO=1 Y FORMALIQUIDACION1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) >= VCAN10, 0, LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) - VCAN10));;;;;'###,###,###,###.##'
        *-MinArancel (fxv)      : 'Exc Settlem F.Vto'    ;11;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o PUESTO=0 o FORMALIQUIDACION1=1 o [VALORRB1=0 y PUESTO=1 Y FORMALIQUIDACION1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) >= VCAN10, 0, LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) - VCAN10));;;;;'###,###,###,###.##'
        IF EqStr(Val(b11),'FXV')
           *- Operaciones FXC
           IF Val(e:14)=1 o EqStr(Val(e38),'0') o EqStr(Val(e40),'1') o [EqStr(Val(e39),'0') y  EqStr(Val(e38),'1') y EqStr(Val(e40),'1')] o LimOperativo(Val(i25),'SETTLEMENT','USD',Val(De2)) >= Val(e42)
              ACN(e:43,0)
           Else
              ACN(e:43, LimOperativo(Val(i25),'SETTLEMENT','USD',Val(De2)) - Val(e42))
           EndIF
        ELSE
           IF EqStr(Val(b11),'FXC')
              *- Operaciones FXV
              IF Val(e:14)=1 o EqStr(Val(e38),'1') o EqStr(Val(e40),'1') o [EqStr(Val(e39),'0') y  EqStr(Val(e38),'1') y EqStr(Val(e40),'1')] o LimOperativo(Val(i25),'SETTLEMENT','USD',Val(De2)) >= Val(e42)
                 ACN(e:43,0)
              Else
                 ACN(e:43, LimOperativo(Val(i25),'SETTLEMENT','USD',Val(De2)) - Val(e42))
              EndIF
              *-MinDerechoMercado: 'Exc Settlem F.Pago'  ;12;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o FORMALIQUIDACION1=1 o [VALORRB1=0 y PUESTO=1 Y FORMALIQUIDACION1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) >= VCAN9, 0, LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) - VCAN9));;;;;'###,###,###,###.##'
              IF Val(e:14)=1 o EqStr(Val(e38),'1') o [EqStr(Val(e39),'1') o EqStr(Val(e38),'1') o EqStr(Val(e40),'1')] o [LimOperativo(Val(i25),'SETTLEMENT','USD',Val(De2)) >= Val(e41)]
                 ACN(e:44,0)
              Else
                 ACN(e:44, LimOperativo(Val(i25),'SETTLEMENT','USD',Val(De2)) - Val(e41))
              EndIF
           EndIF
        EndIF
        *-MinDerechoBolsa  : 'Exc Presett'         ;11;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o [VALORRB1=0 y PUESTO=1] o LimOperativo(VTXT11,'PRESETTLEM','USD',VEHICULO1) > TOTALAUX3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION), 0, (LimOperativo(VTXT11,'PRESETTLEM','USD',VEHICULO1) - (TOTALAUX3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)))));;;;;'###,###,###,###.##'
        IF Val(e:14)=1 o [EqStr(Val(e39),'0') y EqStr(Val(e38),'1')] o [LimOperativo(Val(i25),'PRESETTLEM','USD',Val(De2)) >  Val(f25)+LimConsumido(Val(i25),'PRESETTLEM','USD',-1,Val(De2)) ]
           ACN(e:45,0)
        Else
           ACN(e:45, LimOperativo(Val(i25),'PRESETTLEM','USD',Val(De2)) - (Val(f25) + LimConsumido(Val(i25),'PRESETTLEM','USD',-1,Val(De2))))
        EndIF
        *- vadi-usuario-baja (A7) en Observaciones
        ACT(e:46,Val(a41))
        *-Campos Especificos
        IF Incluido(Val(b11),'FXCT|FXVT|')
           *- Operaciones FXCT y FXVT
           *-Precio3          : 'Precio Venc'    ; 1;2;2;NO;
           ACN(e:47,0)
           *-TipoCambio2      : 'Cierre_Regular' ; 9;1;2;NO;RB10=0;
           ACN(e:48,0)
           *-TipoCambio3      : 'Cierre_NDF'     ;10;1;2;NO;RB10=1;
           ACN(e:49,0)
           *-TotalNetoCli1    : 'Resultado_NDF'    ;11;1;2;NO;RB10=1;
           ACN(e:50,0)
           *-FechaVto2        : 'F.Valuacion'    ;10;2; ;Not EV Y Eqstr(RB10,'1');Eqstr(RB10,'1');Eqstr(RB10,'0') o [Eqstr(RB10,'1') y ESHABIL(FECHAVTO2,TABLAFERIADOS1)];'Dia de Evaluacion NO es Habil';NO; HABILES(FECHAPAGO,-2, TABLAFERIADOS1,SI) ; HABILES(FECHAPAGO,-2, TABLAFERIADOS1,SI)
           ACD(e:51,HABILES(Val(e37),-2,Val(De4),SI))
           *-RB10             : 'Tipo|Delivery|N.D.F.'        ;8;2;;Not EV;;;;;0;0;
           ACN(e:52,0)
           *-RB6              : 'Mercado|Local|Intern.'  ;9;2;;Not EV Y RB10=1;RB10=1;RB10=0 O RB6 = 0 O RB6 = 1;'Indique Mercado NDF';NO;
           ACN(e:53,-1)
           *-TotalAux6        : 'CotiC Esp/ARP'  ;15;2;2;NO;;;;;;IF(NoVacio(BOOK1), COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP'));;;;;'###,###.########'
           ACN(e:55,COTIZACIONC(Val(b21),,,,Val(b15),1,SI,'ARP'))
           *-InteresesCorr    : 'C.CE USD'       ;16;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, INTERESESCORR, if(EqStr(Modo(CONTRAESPECIE,'USD'),'INV'),PRECIO1/TOTALAUX5,TOTALAUX5/PRECIO1)));;;;;'###,###.########'
           ACN(e:19,iif(EqStr(Modo('ARP','USD'),'INV'),Val(b22)/VAL(E:54),VAL(E:54)/VAL(b22)))
        EndIF
     EndIf

     *- VERIFICO AUSENCIA DE ERRORES E INSERTO LA OPERACION.
     IF VAL(o1)=0
        ACT(o2,GetNumerador(35))
        message('en alta '~val(o2))
        SQL.ADD("INSERT INTO "~DBO~".OPERACIONES ")
        SQL.ADD(" (Especie, TipoOp, Sucursal, NrBoleto, ")
        SQL.ADD("  Cliente1, ConceptoBCRA, FechaOp, FechaVto, ")
        SQL.ADD("  NrOperacion, Cantidad, Precio1, ")
        SQL.ADD("  Mercado, FechaCarga, FechaCargaSys, UsrInput, ")
        SQL.ADD("  Mercado2, Cuenta3, Cuenta4, ContraEspecie, Operador, ") 
        SQL.ADD("  Precio2, TotalBrutoCli1, Plazo, ")
        SQL.ADD("  CB8, Cotizacion1, Precio4, ")
        SQL.ADD("  Cotizacion2, InteresesCorr, TipoCambio, ")
        SQL.ADD("  Corredor, RB9, PorComision, TotalBrutoCli2, ")
        SQL.ADD("  PorCaucion, Comision, TotalComisiones, ")
        SQL.ADD("  Numerador, TotalAux3, Arbitraje, TablaFeriados1,")
        SQL.ADD("  PaseCB, RB5, PorDerechoBolsa, PorImpuestoBolsa, PorDerechoMercado, ")
        SQL.ADD("  Book1, Vehiculo1, Cuenta1, Cuenta2, ") 
        SQL.ADD("  FechaPago, Puesto, FormaLiquidacion1, ")
        SQL.ADD("  MinDerechoBolsa, Observaciones, TotalBrutoCli3, ")
        IF Incluido(Val(b11),'FXC|')
           *- Operaciones FXC
           SQL.ADD(" MinDerechoMercado, ")
        EndIF
        IF Incluido(Val(b11),'FXC|FXV|')
           *- Operaciones FXC y FXV
           SQL.ADD(" TotalNetoCli3, RB2, CB6, RuedaContinua, ValorRB1, MinArancel, ")
        EndIF
        IF Incluido(Val(b11),'FXCT|FXVT|')
           SQL.ADD(" Precio3, TipoCambio2, TipoCambio3, TotalNetoCli1, FechaVto2, ")
           SQL.ADD(" RB10, RB6, TotalAux5, TotalAux6, ")
        EndIF
        SQL.ADD(" Direccion, LInstancia, CB9 )") 
        SQL.ADD(" VALUES (")
        *-(Especie, TipoOp, Sucursal, NrBoleto)
        SQL.ADD(" '"~Val(b21)~"','"~Val(b11)~"','"~Val(a13)~"','"~Val(a12)~"',")
        *-(Cliente1, ConceptoBCRA, FechaOp, FechaVto)
        SQL.ADD(" '"~Val(b18)~"','"~Val(a14)~"','"~IdxDate(Val(b15))~"','"~IdxDate(Val(b16))~"',")
        *-(NrOperacion, Cantidad, Precio1)
        SQL.ADD(" '"~Val(o:2)~"', "~Val(a23)~" , "~Val(a22)~" , ")
        *-(Mercado, FechaCarga, FechaCargaSys, UsrInput)
        SQL.ADD(" '"~Val(b25)~"','"~IdxDate(FSys)~" "~Val(b40)~"','"~IdxDate(FSys)~"','"~USUARIOACTIVO~"'," )
        *-(Mercado2, Cuenta3, Cuenta4, ContraEspecie, Operador, )
        SQL.ADD(" '"~Val(c25)~"','"~Val(b35)~"','"~Val(b36)~"','ARP','"~Val(a10)~"'," )
        *-(Precio2, TotalBrutoCli1, Plazo )
        SQL.ADD("  "~Val(e10)~","~Val(e11)~","~Val(e13)~",")
        *-(CB8,Cotizacion1,Precio4 ) 
        SQL.ADD("  "~FStr(Val(e14),0,0)~","~Val(e15)~","~Val(e17)~",")
        *-Cotizacion2, InteresesCorr, TipoCambio
        SQL.ADD("  "~Val(e18)~","~Val(e19)~","~Val(e20)~",")
        *-Corredor, RB9, PorComision, TotalBrutoCli2
        SQL.ADD(" '"~Val(e21)~"',"~FStr(Val(e22),0,0)~","~Val(e23)~","~Val(e24)~",")
        *-PorCaucion, Comision, TotalComisiones, 
        SQL.ADD("  "~Val(g25)~","~Val(e26)~","~Val(e27)~",")
        *-Numerador, TotalAux3, Arbitraje, TablaFeriados1
        SQL.ADD(" 35,"~Val(f25)~",0,'"~Val(DE4)~"',")
        *-PaseCB, RB5, PorDerechoBolsa, PorImpuestoBolsa, PorDerechoMercado  
        SQL.ADD(" 0, 1, "~Val(e29)~","~Val(e30)~","~Val(e31)~",")
        *-Book1, Vehiculo1, Cuenta1, Cuenta2 ") 
        SQL.ADD("'"~Val(de1)~"','"~Val(de2)~"','"~Val(e32)~"','"~Val(e33)~"',")
        *-FechaPago, Puesto, ValorRB1, FormaLiquidacion1
        SQL.ADD("'"~IdxDate(Val(e37))~"','"~Val(e38)~"','"~Val(e40)~"',")
        *-MinDerechoBolsa, Observaciones,TotalBrutoCli3,
        SQL.ADD(Val(e45)~",'"~Val(e46)~"',"~Val(e25)~",")
        IF Incluido(Val(b11),'FXC|')
           *-Operaciones FXC
           *-MinDerechoMercado
           SQL.ADD(Val(e44)~",")
        EndIF
        IF Incluido(Val(b11),'FXC|FXV|')
           *- Operaciones FXC y FXV
           *-TotalNetoCli3, RB2, CB6, RuedaContinua, ValorRB1
           SQL.ADD(Val(e12)~","~FStr(Val(e28),0,0)~","~FStr(Val(e16),0,0)~", 0,'"~Val(e39)~"'," )
           *-MinArancel,  
           SQL.ADD(Val(e43)~",")
        EndIF
        IF Incluido(Val(b11),'FXCT|FXVT|')
           *-Precio3, TipoCambio2, TipoCambio3, TotalNetoCli1, FechaVto2
           SQL.ADD( Val(e:47)~","~Val(e:48)~","~Val(e:49)~","~Val(e:50)~","~Val(e:51)~",")
           *-RB10, RB6, TotalAux5, TotalAux6
           SQL.ADD( Val(e:52)~","~Val(e:53)~","~Val(e:54)~","~Val(e:55)~",")
        EndIF
        *-Direccion, LInstancia, CB9 ") 
        SQL.ADD(" 2, 10, 1 )")
        SQL.NEW
        SQL.EXEC

        *-Actualizo movimientos
        SQL.ActualizarMovimientos4(Val(o:2),SI,SI,NO,SI,SI,SI)

        *-Seteo el Estado de la Operacion en Terminal(70)
        SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS (NrOperacion,NrBit,Valor)")
        SQL.ADD("VALUES ('"~Val(o:2)~"',70,1)")
        SQL.NEW
        SQL.EXEC
     ENDIF
  EndIF