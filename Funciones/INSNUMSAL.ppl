  * FO 12/05/06 Numerador 28 reemplaza al 1 
  ACT(z:2,GetNumerador(28))
 


   *- Doy de alta una transaccion DE NUMERALES para guardar el Saldo por mercado/nrsaldo
   SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
   SQL.ADD("(Vehiculo1, Fecha1,  Cliente1, Cuenta1, ")
   SQL.ADD(" Especie,   NrTrans, TipoTr2,  Cantidad1, ")
   SQL.ADD(" Mercado1,  Cambio4, CB1,      Cantidad2, ")
   SQL.ADD(" Cantidad3, Precio1, Cantidad4, Precio2, ")
   SQL.ADD(" Cupon1 ")
   SQL.ADD(" ) Values ( ")
   SQL.ADD(" '"~val(z:6)~"', ")
   SQL.ADD(" '"~IdxDate(Dialogo.Fecha2)~"', ")
   SQL.ADD(" '"~val(z:7)~"', ")
   SQL.ADD(" '"~FBN['Cuenta']~"', ")

   SQL.ADD(" '"~FBN['Especie']~"', ")
   SQL.ADD(" '"~val(z:2)~"', ")
   SQL.ADD(" 'NUMSAL', ")
   * Cantidad1
   SQL.ADD(" "~Fstr(Abs(val(pp:2)),0,2)~", ")

   SQL.ADD(" '"~FBN['Mercado']~"', ")
   * Cambio4
   SQL.ADD(" "~Fstr(FBN['NrSaldo'],0,0)~", ")
   * CB1
   SQL.ADD(" '"~val(ft:1)~"', ")
   * Cantidad2
   SQL.ADD(" "~Fstr(Abs(val(g:fac)),0,2)~", ")

   * Cantidad3
   SQL.ADD(" "~Fstr(Abs(val(j:fac)),0,2)~", ")
   * Precio1
   SQL.ADD(" "~Fstr(val(i:fac),0,8)~", ")
   * Cantidad4
   SQL.ADD(" "~Fstr(Abs(val(k:fac)),0,2)~", ")
   * Precio2
   SQL.ADD(" "~Fstr(Abs(val(l:fac)),0,4)~", ")

   If NoVacio(FBN['Cupon'])
      SQL.ADD(" '"~Fstr(FBN['Cupon'],0,0)~"') ")   
   Else
      SQL.ADD("  '') ")
   EndIf
   SQL.NEW
   SQL.EXEC

   *** graba en instancia Terminal ***
   SQL.ADD("Insert Into "~DBO~".OPERACIONESBITS ")
   SQL.ADD("  (NrOperacion, NrBit, Valor ) ")
   SQL.ADD(" Values ")
   SQL.ADD("  ('"~val(z:2)~"','70','1') ")
   SQL.NEW
   SQL.EXEC


