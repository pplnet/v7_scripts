  BorrarCeldas(x1..x99)
  BorrarCeldas(a1..l:fac)
  ACT(x3,Val(ux:3))
  ACD(x5,Val(ux:5))

  SQL.ADD(" SELECT DISTINCT S.NrOperacion, S.Cantidad, S.Cliente, S.Cuenta, S.Mercado, S.Concepto ")
  SQL.ADD(" FROM "~DBO~".MOVPENDIENTES S ")
  SQL.ADD(" WHERE '"~Val(ec:1)~"' = S.Especie ")
  SQL.ADD(" AND 1 = S.NrSaldo and '"~VAL(x3)~"'=S.Cupon ")

  SetFilaActual(0)
  ACN(z:1,0)
  Recorrer SQL
    * Cantidad
    ACN(x1,fbn('Cantidad'))
    ACN(a:fac,1)

    IF Val(x1)<>0 
       ACN(z:1,1)
       if Val(x:1)>0
          ACT(w:fac,'CCUPON')
       else
          ACT(w:fac,'PCUPON')
       endif
       ACT(b:fac, fbn('Cuenta'))
       ACT(c:fac, fbn('Mercado'))
       ACT(d:fac, Val(ec:1))
       ACT(e:fac, Val(x:3))
       IF Eqstr(Val(w:fac), 'CCUPON')
          ACT(f:fac, 'Cobro de Cupon')
       ELSE
          ACT(f:fac, 'Pago de Cupon')
       ENDIF
        ACN(g:fac, Val(x:1))
       ACN(j:fac, Val(pr:1))
       ACN(k:fac, Val(x:1)*Val(pr:1))
       ACT(l:fac, fbn('Cliente'))
       ACT(o:fac, fbn('NrOperacion'))
       ACT(m:fac, Val(ec:2))
       *IF Eqstr(fbn('Cliente'), Val(aa4))
       *  ACT(q:fac, fbn('Cliente'))
       *ENDIF
       IF Incluido(fbn('Cliente'), &vehiculos)
         ACT(q:fac, fbn('Cliente'))
       ENDIF      
       ACT(o:fac, fbn('NrOperacion'))
       ACT(m:fac, Val(ec:2))
     
       ACN(s:fac, Val(x:1)*Val(pr:2)*Val(CB:1)*val(ci2))
       ACN(t:fac, Val(x:1)*Val(pr:3)*val(ci2))

       ACT(cp:fac, fbn('Concepto'))

       *---- Busca Cuentas Default ----*
       *IF Not Eqstr(fbn('Cliente'), Val(aa4))
       IF Not Eqstr(fbn('Cliente'), Val(ve:fac))
          ACT(h:fac, SQL(" SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~fbn('Cliente')~"' AND Estado = 'HAB' AND TipoCuenta = 'VIS' AND (Especies LIKE '%"~Val(m:fac)~"%' OR Especies LIKE '%MONEDA%' ) "))
       ELSE
       *ACT(h:fac, SQL(" SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~Val(aa:4)~"' AND Estado = 'HAB' AND (Especies LIKE '%"~Val(m:fac)~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~Val(q:fac)~"' ")) 
        ACT(h:fac, SQL(" SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente IN ("~Pipe2Comillas(&vehiculos)~") AND Estado = 'HAB' AND (Especies LIKE '%"~Val(m:fac)~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~Val(q:fac)~"' ")) 
       ENDIF
       *----------------*
    ELSE
       dfa
    ENDIF 
  Proximo

  IF Val(z:1)<>0
    CrearListBox ; 'Arial,8,';'Saldos Pendientes.'
      'OK'              ;a1..a:fac;SI;;;30;CHECK ;RGB(255,255,193)
      'Cliente'         ;l1..l:FAC;NO;;;60;STRING
      'De Cuenta'       ;b1..b:FAC;NO;;;90;STRING
      'Mercado'         ;c1..c:FAC;NO;;;50;STRING
      'Especie'         ;d1..d:FAC;NO;;;50;STRING
      'Cupon'           ;e1..e:FAC;NO;;;50;STRING
      'Transaccion'     ;f1..f:FAC;NO;;;90;STRING
      'Saldo'           ;g1..g:FAC;NO;;;80;NUMERO;'###,###,###.##'
      'Precio del Cupon';j1..j:FAC;NO;;;90;NUMERO;'###.######'
      'Moneda'          ;m1..m:FAC;NO;;;50;STRING
      'Total Renta'     ;s1..s:FAC;NO;;;80;NUMERO;'###,###,###.##'
      'Total Amort'     ;t1..t:FAC;NO;;;80;NUMERO;'###,###,###.##'
      'Total'           ;k1..k:FAC;NO;;;80;NUMERO;'###,###,###.##'
      *'Custodio'        ;q1..q:FAC;Eqstr(Val(l:FLB),Val(aa4));NOVACIO(Val(q:FLB)) o Val(a:FLB)=0;'Custodio Invalido'; 70;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';" EsDepositante='SI' AND Status = 'HAB' AND Codigo<>'CAJA' ";RGB(255,255,193)
      'Custodio'        ;q1..q:FAC;Eqstr(Val(l:FLB),Val(q:FLB));NOVACIO(Val(q:FLB)) o Val(a:FLB)=0;'Custodio Invalido'; 70;TABLA;'Clientes';'Codigo';'Codigo;RazonSocial';" EsDepositante='SI' AND Status = 'HAB' AND Codigo<>'CAJA' ";RGB(255,255,193)
      *'A Cuenta'        ;h1..h:FAC;SI;NOVACIO(Val(h:FLB)) o Val(a:FLB)=0;'Cuenta Invalida'  ;100;TABLA;'CUENTAS' ;'Codigo';'Codigo; Nombre';IIF(Eqstr(Val(l:FLB),Val(aa:4)),"Cliente = '"~Val(l:FLB)~"' AND Estado= 'HAB' AND (Especies LIKE '%"~Val(m:FLB)~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~Val(q:FLB)~"' ","Cliente = '"~Val(l:FLB)~"' AND Estado= 'HAB' AND TipoCuenta= 'VIS' AND (Especies LIKE '%"~Val(m:FLB)~"%' OR Especies LIKE '%MONEDA%') ");RGB(255,255,193)
      'A Cuenta'        ;h1..h:FAC;SI;NOVACIO(Val(h:FLB)) o Val(a:FLB)=0;'Cuenta Invalida'  ;100;TABLA;'CUENTAS' ;'Codigo';'Codigo; Nombre';IIF(Incluido(Val(l:FLB),Val(ve:FLB)),"Cliente = '"~Val(l:FLB)~"' AND Estado= 'HAB' AND (Especies LIKE '%"~Val(m:FLB)~"%' OR Especies LIKE '%MONEDA%') AND Comitente = '"~Val(q:FLB)~"' ","Cliente = '"~Val(l:FLB)~"' AND Estado= 'HAB' AND TipoCuenta= 'VIS' AND (Especies LIKE '%"~Val(m:FLB)~"%' OR Especies LIKE '%MONEDA%') ");RGB(255,255,193)
      'NrOperacion'     ;o1..o:FAC;NO;;;90;STRING
    FinListBox

    IF NOT OK 
       Cancelar
    ENDIF

    Message('------ Generando Cobro/Pago - Saldos Pendientes --------')

    Recorrer&i 1,fac               
       * insertar una transaccion para actualizar el saldo
       *-- Cuenta2 = A  Cuenta 
       *-- Cuenta6 = De Cuenta
    IF Val(a:&i)=1
        IF Not EspecieCuenta(Val(m:&i),Val(h:&i))             
           *----- Si no encontro la cuenta para la moneda o cambio la cuenta 
           *----- por otra, de otra moneda
           MessageBox('La cuenta seleccionada no es '~Val(m:&i))
           CrearDialogo
             Cliente1:  'Cliente'      ;1;1;1;NO;;;;;Val(l:&i)
             Especie1:  'Especie'      ;2;1;1;NO;;;;;Val(d:&i)
             Entero1:   'Cupon'        ;2;2;1;NO;;;;;Num(Val(x3))
             Cantidad1: 'Total USD'    ;3;1;1;NO;Eqstr(Val(m:&i), 'USD');;;;Val(k:&i)
             Cantidad2: 'Total Pesos'  ;3;1;1;NO;Eqstr(Val(m:&i), VAR('MONELOCA'));;;;Val(k:&i)
             Precio1:   'Cotizacion'   ;4;1;1; ;;Dialogo.Precio1>0;'La cotizacion debe ser positiva';NO;1
             Cantidad3: 'Total'        ;5;1;;NO;;;;;IIF(Eqstr(Val(m:&i),'USD'), Dialogo.Cantidad1*Dialogo.Precio1, Dialogo.Cantidad2*Dialogo.Precio1);IIF(Eqstr(Val(m:&i), 'USD'), Dialogo.Cantidad1*Dialogo.Precio1, Dialogo.Cantidad2*Dialogo.Precio1)
             Cuenta1:   'a Cuenta'     ;5;2;;NO;;;;;Val(h:&i)
           FinDialogo
           ACN(k:&i, Dialogo.Cantidad3)
        ENDIF

        IF OK
           ***---ACT(Y1,GetNumerador(20))
           *ACT(Y:1, GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo', Val(AA:4))))
           ACT(Y:1, GetNumerador(BuscarCampo('VEHICULOS','Alias3','Codigo', Val(ve:&i))))
           SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 (")
           SQL.ADD(" Especie, Especie1, Cupon1 , Fecha1, ")
           SQL.ADD(" Cliente1, Cantidad1, Cantidad4, RB1,")
           SQL.ADD(" Vehiculo1, TipoTr2, NrTrans, Mercado1, ")
           SQL.ADD(" Cuenta2, Cuenta6, Cuenta1, Cliente2, ")
           SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, CB2, ")
           SQL.ADD(" Cantidad2, Cuenta3, Precio1, Precio2, Precio3,  ")
           SQL.ADD(" Cantidad5, Cantidad6, PrecioEj ")
           SQL.ADD(" ) VALUES ( ")
           SQL.ADD(" '"~Val(d:&i)~"', '"~Val(m:&i)~"','"~Val(x3)~"', '"~IdxDate(Val(x5))~"',")
           SQL.ADD(" '"~Val(l:&i)~"', "~FStr(ABS(Val(g:&i)),1,2)~", "~FStr((ABS(Val(k:&i))-ABS(Val(p:&i))),1,2)~", '"~Val(x4)~"',")
           *SQL.ADD(" '"~Val(aa:4)~"', '"~Val(w:&i)~"', '"~Val(Y1)~"', '"~Val(c:&i)~"',")
           SQL.ADD(" '"~Val(ve:&i)~"', '"~Val(w:&i)~"', '"~Val(Y1)~"', '"~Val(c:&i)~"',")
           SQL.ADD(" '"~Val(h:&i)~"','"~Val(b:&i)~"', '"~Val(n:&i)~"', '"~Val(q:&i)~"',")
           SQL.ADD(" "~SQLAhora~", '"~IdxDate(Fsys)~"', '"~UsuarioActivo~"', '1', ")
           SQL.ADD("  "~FStr(ABS(Val(k:&i)),1,2)~", '"~Val(r:&i)~"', "~FStr(ABS(Val(pr:1)),1,8)~", "~FStr(ABS(Val(pr:2)),1,8)~", "~FStr(ABS(Val(pr:3)),1,8)~", ")
           SQL.ADD("  "~FStr(ABS(Val(s:&i)),1,2)~", "~FStr(ABS(Val(t:&i)),1,2)~", "~Fstr(Val(CB:1), 0, 7)~" ")
           SQL.ADD(" ) ")
           SQL.NEW  

           SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
           SQL.ADD("(NrBit, NrOperacion, Valor) ")
           SQL.ADD(" VALUES ")
           SQL.ADD(" (70, '"~Val(y1)~"', '1') ")
           SQL.NEW
           SQL.EXEC

*           SQL.ActualizarMovimientosT4(Val(y:1),SI,NO,NO,NO,NO,SI,0)
*           SQL.EXEC

*-------------------------------*
           ACN(nm:1, SQL("SELECT MAX(NrMov) FROM "~DBO~".MOVPENDIENTES WHERE NrOperacion = '"~Val(o:&i)~"' ") )
           SCN(nm:1,1)
            
           SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES (")
           SQL.ADD(" NrTrans2, NrOperacion, FechaMov, Cliente, ")
           SQL.ADD(" Especie, Bits, NrSaldo, ")
           SQL.ADD(" NrGrupo, EnteCustodia, Mercado, ")
           SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
           SQL.ADD(" NrInstan, Cupon, Concepto, Cuenta, ")
           SQL.ADD(" Cantidad, Leyenda ")
           SQL.ADD(" ) Values ( ")
           SQL.ADD(" '"~Val(Y1)~"', '"~Val(o:&i)~"', '"~IdxDate(Val(x5))~"', '"~Val(l:&i)~"', ")
           SQL.ADD(" '"~Val(d:&i)~"', 'MV', 1, ")
           *SQL.ADD(" 1, '"~VAL(aa:4)~"', '"~Val(c:&i)~"', ")
           SQL.ADD(" 1, '"~VAL(ve:&i)~"', '"~Val(c:&i)~"', ")
           SQL.ADD(" '"~IdxDate(FSys)~"', 0, "~FSTR(Val(nm:1),1,0)~",  ")
           SQL.ADD(" 0, '"~Val(x:3)~"','"~Val(cp:&i)~"','"~Val(b:&i)~"',  ")
           IF Eqstr(Val(w:&i), 'PCUPON')
              SQL.ADD(" "~FStr(ABS(Val(g:&i)),1,2)~", ")
              SQL.ADD(" 'Pago de Cupones')")
           ELSE
              SQL.ADD(" "~FStr(ABS(Val(g:&i))*-1,1,2)~", ")
              SQL.ADD(" 'Cobro de Cupones') ") 
           ENDIF
           SQL.NEW

           SCN(nm:1,1)
           SQL.ADD("INSERT INTO "~DBO~".MOVPENDIENTES (")
           SQL.ADD(" NrTrans2, NrOperacion, FechaMov, Cliente, ")
           SQL.ADD(" Especie, Bits, NrSaldo, ")
           SQL.ADD(" NrGrupo, EnteCustodia, Mercado, ")
           SQL.ADD(" FechaEje, NrGrupo2, NrMov, ")
           SQL.ADD(" NrInstan, Concepto, Cuenta, ")
           SQL.ADD(" Cantidad, Leyenda ")
           SQL.ADD(" ) Values (")
           SQL.ADD(" '"~Val(Y1)~"', '"~Val(o:&i)~"', '"~IdxDate(Val(x5))~"', '"~Val(l:&i)~"', ")
           SQL.ADD(" '"~Val(m:&i)~"', 'MV', 1, ")
           *SQL.ADD(" 1, '"~VAL(aa:4)~"', '"~BuscarCampo('CUENTAS','Mercado','Codigo',Val(h:&i))~"',")
           SQL.ADD(" 1, '"~VAL(ve:&i)~"', '"~BuscarCampo('CUENTAS','Mercado','Codigo',Val(h:&i))~"',")
           SQL.ADD(" '"~IdxDate(FSys)~"', 0, "~FSTR(Val(nm:1),1,0)~", ")
           SQL.ADD(" 0, '"~Val(cp:&i)~"','"~Val(h:&i)~"',  ")
           IF Eqstr(Val(w:&i), 'PCUPON')
              SQL.ADD(" "~FStr( (ABS(Val(k:&i)))*-1,1,2)~", 'Pago de Cupones')")
           ELSE
              SQL.ADD(" "~FStr((ABS(Val(k:&i))),1,2)~", 'Cobro de Cupones')")
           ENDIF
           SQL.NEW
           SQL.EXEC

*-------------------------------* 

           SQL.ADD(" SELECT * FROM "~DBO~".POSICIONES  ")
           SQL.ADD(" WHERE Especie   ='"~Dialogo.Especie1~"' ")
           SQL.ADD(" AND   Cliente   ='"~Val(l:&i)~"' ")
***---           SQL.ADD(" and   Fecha    <='"~IdxDate(Dialogo.Fecha1)~"' ")
           SQL.ADD(" and   Fecha    <='"~IdxDate(Val(AA:3))~"' ")
           SQL.ADD(" and   NrSaldo  IN (1,2) ")
           SQL.ADD(" and   Cupon     ='"~FStr(Dialogo.Entero1,1,0)~"'")
           SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P ")
           SQL.ADD("                 WHERE  Especie = P.Especie ")
           SQL.ADD("                 AND    Cliente = P.Cliente ")
           SQL.ADD("                 AND    NrSaldo = P.NrSaldo ")
           SQL.ADD("                 AND    Cupon   = P.Cupon ")
***---           SQL.ADD("                 AND    Fecha  <='"~IdxDate(Dialogo.Fecha1)~"') ")
           SQL.ADD("                 AND    Fecha  <='"~IdxDate(Val(AA:3))~"') ")

           Recorrer SQL
           *---- Actualizar movimientos de posicion para el cupon
             SQL.ADD(" Insert Into "~DBO~".MOVPOSEJE ")
             SQL.ADD(" ( Especie, Cantidad, NrOperacion, ")
             SQL.ADD(" FechaMov, Cliente, Vehiculo,  ")
             SQL.ADD(" NrSaldo, Precio,  ")
             SQL.ADD(" Cupon, Tipo, TipoNegocio, Trader ")
             SQL.ADD(" ) Values ( ")
             SQL.ADD(" '"~Dialogo.Especie1~"', "~Fstr(FBN['CantidadFin']*(-1),1,2)~", '"~Val(y:1)~"', ")
***---       SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', '"~fbn('Cliente')~"', '"~Dialogo.Vehiculo1~"', ")
             *SQL.ADD(" '"~IdxDate(Val(AA:3))~"', '"~fbn('Cliente')~"', '"~Dialogo.Vehiculo1~"', ")
             SQL.ADD(" '"~IdxDate(Val(AA:3))~"', '"~fbn('Cliente')~"', '"~Val(ve:fac)~"', ")
             SQL.ADD(" "~FSTR(fbn('NrSaldo'),1,0)~", "~FStr(fbn['PrecioFin'],1,8)~",  ")
             SQL.ADD(" '"~FStr(Dialogo.Entero1,1,0)~"', '1', '"~FBN['TipoNegocio']~"', '"~FBN['Trader']~"' ) ")
             SQL.NEW
           Proximo
           SQL.EXEC

        ENDIF
     ENDIF
   Proximo
 ENDIF
