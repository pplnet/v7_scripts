**Debe estar declarado para su uso las monedas a comparar en &monedaTC1 y &monedaTC2
**&monedaTC1 habitualmente es la moneda del informe y &monedaTC2 la moneda a comparar
IF Incluido(&monedaTC1, &monedaTC2)
    let &tc 1
ELSE
    IF Eqstr(&monedaTC1, &monedaLocal)
        let &tc &cotVehiculo
    ELSE
        let &tc 1/&cotVehiculo
    ENDIF
ENDIF
