     *************** P A S I V O S   F I N A N C I E R O S ***************

SCN(fl:2,1)
SetFilaActual(Val(fl:2))
ACT(a:fac, "Total Pasivos Financieros")
SetFont(a:fac, 4)
AgregarMarco(a:fac..Val(cc:1990):fac, 2, 0, Exe('COLOR6'))

SCN(fl:2,1)
SetFilaActual(Val(fl:2))
ACT(B:fac, 'FPA')

*--> Fila para acumular el total 
ACN(i:2000, fac-1)
Recorrer&k 4, Val(LM:2)
    SCN(&k:Val(I:2000), 0)
Proximo

*--> Fila para acumular el diario
***---ACN(f:2000, fac)
ACN(f:2000, fac)
ACN(f:1999, fac)

*--> Marca para que ejecute solo los PASIVOS financieros
ACN(mn:1000, 1)

     ***** PRESTAMOS VINCULADOS *****
(.'RVINCCASHF'.)

     ***** PRESTAMOS TERCEROS PESOS / (LOCALES) MON. EXTRANJERA *****
(.'RPTERPMOEX'.)


     ***** PRESTAMOS TERCEROS (OFF-SHORE) *****
(.'RPTEROFFSH'.)

     ***** PREFINANCIACION EXPORTACION *****
(.'RPREFEXP'.)


     ***** FINANCIACION IMPORTACIONES *****
(.'RFINIMP'.)

     ***** OBLIGACIONES NEGOCIABLES *****
(.'ROBLNEG'.)

     ***** COMERCIAL PAPERS *****
(.'RCOMPAPERS'.)


     ***** OP. CAMBIO A TERM. VENTA / OP. CAMBIO A TERM. COMPRA *****
(.'RFXCASH'.)

     ***** GARANTIA P / OP HEDGE FINANCIERO *****
(.'RGARPOPHF'.)

     ***** EQUITY SWAPS *****
(.'REQUISWAPS'.)

     ***** OPCIONES *****
(.'ROPCICASH'.)

     ***** OTROS ACTIVOS *****
(.'ROTACCASH'.)

SetFilaActual(Val(fl:2))

*--> RESTA los Pasivos Financieros para el TOTAL
RECORRER&i Val(VT:1), Val(cc:1990)
   SCN(&i:Val(kk:1), -Val(&i:Val(i:2000)))
PROXIMO
Recorrer&i Val(F:1999), Val(F:2000)
    ***---Concepto FPA para orden de aparicion en los cuadros
    ACT(CX:&i, '8A-')
Proximo