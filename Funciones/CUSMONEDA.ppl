SQL.ADD(" SELECT SUM(Cantidad) Cantidad, M.NrSaldo, M.Cliente, M.Cuenta, M.Especie, M.Mercado, M.EnteCustodia ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS C ")
SQL.ADD(" WHERE M.NrOperacion = '"~Val(y2)~"'   ")
SQL.ADD(" AND   M.Especie   <> '"~Val(aa:14)~"' ")
SQL.ADD(" AND   M.Cuenta     = C.Codigo  ")
SQL.ADD(" AND   C.TipoCuenta = 'CUS'     ")
SQL.ADD(" AND   M.NrSaldo   IN (4,5)     ")
SQL.ADD(" GROUP BY M.NrSaldo, M.Cliente, M.Cuenta, M.Especie, M.Mercado, M.EnteCustodia ")
SQL.ADD(" ORDER BY M.Cliente ")
ACT(cl:1, '')
ACN(z1,0)
Recorrer SQL
  ACN(z1,1)
  If Not Eqstr(fbn('Cliente'), Val(cl:1)) y Not Eqstr(Val(cl:1),'')
     * Inserta DTP
     message('Generando Custodia de Moneda ... ')
     * FO 12/05 Numerador 26 reemplaza al 1
     ACT(y3,GetNumerador(26))
     SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
     SQL.ADD(" NrTrans, Especie, Cupon1, Vehiculo1, Fecha1,   ")
     SQL.ADD(" CB1, Mercado1, Cliente1, Cantidad1, Cantidad2, ")
     SQL.ADD(" RB4, Especie4, Especie5, CB3, NrOperacionRef2, ")
     SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, RB2, TipoTr2, Cuenta1  ")
     SQL.ADD(" ) VALUES ( ")
     SQL.ADD(" '"~Val(y3)~"', '"~Val(cl:2)~"', '0', '"~Val(cl:3)~"', "~idxdate2(Dialogo.Fecha1)~", ")
     SQL.ADD(" '0', '"~Val(cl:4)~"', '"~Val(cl:1)~"', "~fstr(Val(cm:1),0,2)~", "~fstr(Val(cm:1),0,2)~", ")
     SQL.ADD(" '0', 'CUS', 'CUS', '0', '"~Val(y2)~"', ")
     SQL.ADD(" "~idxdate2(FSYS)~", "~idxdate2(FSYS)~", '"~USUARIOACTIVO~"', '1', 'DTP', '"~Val(cl:5)~"' ) ")
     SQL.NEW
     SQL.EXEC

     SQL.ActualizarMovimientosT2(Val(y3),SI,NO,NO,NO)
     SQL.EXEC

     ACT(li1,'1|2|5|30|70|')
     Recorrer&j 1,Elementos(val(li1))
       ACN(az5,Num(ItemLista(val(li1),&j)))
       SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
       SQL.ADD("(NrOperacion,NrBit,Valor) ")
       SQL.ADD(" Values ")
       SQL.ADD("('"~Val(Y3)~"',"~Fstr(val(az5),3,0)~",")
       IF Val(az5)=70
          SQL.ADD("'1')")
       ELSE
          SQL.ADD("'0')")
       ENDIF
       SQL.NEW
       SQL.EXEC
     Proximo
     ACN(cm:1, 0)
  Endif

  IF fbn('NrSaldo')=4
     SCN(cm:1, -fbn('Cantidad'))
  Else
     SCN(cm:1, fbn('Cantidad'))
  Endif

  ACT(cl:1, Fbn('Cliente'))
  ACT(cl:2, Fbn('Especie'))
  ACT(cl:3, Fbn('EnteCustodia'))
  ACT(cl:4, Fbn('Mercado'))
  ACT(cl:5, Fbn('Cuenta'))
Proximo

If Val(z:1)<>0
   * Inserta DTP
   message('Generando Custodia de Moneda ... ')
   * FO 12/05/06 Numerador 26 reemplaza al 1
   ACT(y3,GetNumerador(26))
   SQL.ADD(" INSERT INTO "~DBO~".TRANSACCIONES2 ( ")
   SQL.ADD(" NrTrans, Especie, Cupon1, Vehiculo1, Fecha1,   ")
   SQL.ADD(" CB1, Mercado1, Cliente1, Cantidad1, Cantidad2, ")
   SQL.ADD(" RB4, Especie4, Especie5, CB3, NrOperacionRef2, ")
   SQL.ADD(" FechaCarga, FechaCargaSys, UsrInput, RB2, TipoTr2, Cuenta1  ")
   SQL.ADD(" ) VALUES ( ")
   SQL.ADD(" '"~Val(y3)~"', '"~Val(cl:2)~"', '0', '"~Val(cl:3)~"', "~idxdate2(Dialogo.Fecha1)~", ")
   SQL.ADD(" '0', '"~Val(cl:4)~"', '"~Val(cl:1)~"', "~fstr(Val(cm:1),0,2)~", "~fstr(Val(cm:1),0,2)~", ")
   SQL.ADD(" '0', 'CUS', 'CUS', '0', '"~Val(y2)~"', ")
   SQL.ADD(" "~idxdate2(FSYS)~", "~idxdate2(FSYS)~", '"~USUARIOACTIVO~"', '1', 'DTP', '"~Val(cl:5)~"' ) ")
   SQL.NEW
   SQL.EXEC
   SQL.ActualizarMovimientosT2(Val(y3),SI,NO,NO,NO)
   SQL.EXEC

   ACT(li1,'1|2|5|30|70|')
   Recorrer&j 1,Elementos(val(li1))
     ACN(az5,Num(ItemLista(val(li1),&j)))
     SQL.ADD(" INSERT INTO "~DBO~".OPERACIONESBITS ")
     SQL.ADD(" (NrOperacion,NrBit,Valor) ")
     SQL.ADD(" Values ")
     SQL.ADD(" ( '"~Val(Y3)~"',"~Fstr(val(az5),3,0)~",")
     IF Val(az5)=70
        SQL.ADD("'1') ")
     ELSE
        SQL.ADD("'0') ")
     ENDIF
     SQL.NEW
     SQL.EXEC
   Proximo
Endif