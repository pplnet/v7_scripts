    SCN(aa:2, 1)
    ACT(b:Val(aa:2), Val((4-1)*7+1+10:500+&j))
    ACT(c:Val(aa:2), Val((4-1)*7+2+10:500+&j))
    ACLO(c:Val(aa:2), Val((4-1)*7+2+10:500+&j))
    ACD(d:Val(aa:2), Val((4-1)*7+3+10:500+&j))
    ACD(e:Val(aa:2), Val((4-1)*7+4+10:500+&j))
    ACN(f:Val(aa:2), Val((4-1)*7+5+10:500+&j))
    ACN(g:Val(aa:2), Val((4-1)*7+6+10:500+&j))
