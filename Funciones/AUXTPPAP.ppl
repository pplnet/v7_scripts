**//   Proximo


**// Ignoramos Dialogo.Lista1 Usamos siempre este desglose
ACT(kk:1, "7|15|30")


***************************************************************************
*************************  7  *********************************************
***************************************************************************
Recorrer&j 1, val(p:1)
    SCN(aa:2, 1)
    ACT(b:Val(aa:2), Val((1-1)*7+1+10:500+&j))
    ACT(c:Val(aa:2), Val((1-1)*7+2+10:500+&j))
    ACLO(c:Val(aa:2), Val((1-1)*7+2+10:500+&j))
    ACD(d:Val(aa:2), Val((1-1)*7+3+10:500+&j))
    ACD(e:Val(aa:2), Val((1-1)*7+4+10:500+&j))
    ACN(f:Val(aa:2), Val((1-1)*7+5+10:500+&j))
    ACN(g:Val(aa:2), Val((1-1)*7+6+10:500+&j))
    SetFont(b:Val(aa:2)..g:Val(aa:2),1)
Proximo

SCN(aa:2,1)
if 1 <> Elementos(Val(kk:1))+1
    ACT(g:Val(aa:2), 'Total hasta '~ItemLista(Val(kk:1), 1)~' dias')
else
    ACT(g:Val(aa:2), 'Total mas de '~ItemLista(Val(kk:1), 1-1)~' dias')
endif
ACN(h:Val(aa:2), val((1-1)*7+1+10:500))
ACN(i:Val(aa:2), val((1-1)*7+2+10:500) / val((1-1)*7+3+10:500))
SetFont(g:Val(aa:2)..i:Val(aa:2),2)

SCN(aa:3, Val((1-1)*7+1+10:500))
SCN(aa:4, Val((1-1)*7+2+10:500))
SCN(aa:5, Val((1-1)*7+3+10:500))



***************************************************************************
*************************  15  ********************************************
***************************************************************************
Recorrer&j 1, val(p:2)
    SCN(aa:2, 1)
    ACT(b:Val(aa:2), Val((2-1)*7+1+10:500+&j))
    ACT(c:Val(aa:2), Val((2-1)*7+2+10:500+&j))
    ACLO(c:Val(aa:2), Val((2-1)*7+2+10:500+&j))
    ACD(d:Val(aa:2), Val((2-1)*7+3+10:500+&j))
    ACD(e:Val(aa:2), Val((2-1)*7+4+10:500+&j))
    ACN(f:Val(aa:2), Val((2-1)*7+5+10:500+&j))
    ACN(g:Val(aa:2), Val((2-1)*7+6+10:500+&j))
    SetFont(b:Val(aa:2)..g:Val(aa:2),1)
Proximo

SCN(aa:2,1)
if 2 <> Elementos(Val(kk:1))+1
    ACT(g:Val(aa:2), 'Total hasta '~ItemLista(Val(kk:1), 2)~' dias')
else
    ACT(g:Val(aa:2), 'Total mas de '~ItemLista(Val(kk:1), 2-1)~' dias')
endif
ACN(h:Val(aa:2), val((2-1)*7+1+10:500))
ACN(i:Val(aa:2), val((2-1)*7+2+10:500) / val((2-1)*7+3+10:500))
SetFont(g:Val(aa:2)..i:Val(aa:2),2)

SCN(aa:3, Val((2-1)*7+1+10:500))
SCN(aa:4, Val((2-1)*7+2+10:500))
SCN(aa:5, Val((2-1)*7+3+10:500))



