      If Not Eqstr(Val(f:&i), 'TRANFX')
        SQL.ADD(" UPDATE "~DBO~".OPERACIONES SET ")
        If Eqstr(Val(d:&i),VAR('MONELOCA'))
          SQL.ADD(" Cuenta2 = '"~Val(k:&i)~"', ")
          SQL.ADD(" Cuenta4 = '"~Val(e:&i)~"' ")
        Else
          SQL.ADD(" Cuenta1 = '"~Val(k:&i)~"', ")
          SQL.ADD(" Cuenta3 = '"~Val(e:&i)~"' ")
        Endif
        SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"' ")
        SQL.NEW
      Else
        SQL.ADD(" UPDATE "~DBO~".TRANSACCIONES2 SET ")
        SQL.ADD(" Cuenta2 = '"~Val(k:&i)~"', ")
        SQL.ADD(" Cuenta1 = '"~Val(e:&i)~"' ")
        SQL.ADD(" WHERE NrTrans = '"~Val(b:&i)~"' ")
        SQL.NEW
      Endif

      SQL.ADD(" UPDATE "~DBO~".MOVPENDIENTES SET ")
      If Not Eqstr(Val(f:&i), 'TRANFX')
        SQL.ADD(" Cuenta = '"~Val(e:&i)~"' ")
        SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"' ")
        SQL.ADD(" AND Cliente = '"~Val(c:&i)~"' ")
      Else
        SQL.ADD(" Cuenta = '"~Val(k:&i)~"' ")
        SQL.ADD(" WHERE NrOperacion = '"~Val(b:&i)~"' ")
        SQL.ADD(" AND Cliente = '"~Dialogo.Vehiculo1~"' ")
      Endif
      SQL.ADD(" AND Especie  = '"~Val(d:&i)~"' ")
      SQL.ADD(" AND NrMov    = "~Fstr(Val(m:&i),0,0)~" ")
      SQL.ADD(" AND FechaMov = "~Idxdate2(Val(j:&i))~" ")
      SQL.NEW
      SQL.EXEC