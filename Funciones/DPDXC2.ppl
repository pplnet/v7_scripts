ACT(a1, 'Detalle de Posicion y Disponibilidad')
IF Dialogo.Cantidad1 = 3
   ACT(a2, '(Retiros)')
ENDIF
IF Dialogo.Cantidad1 = 4
   ACT(a2, '(Depositos)')
ENDIF
IF Dialogo.Cantidad1 = 5
   ACT(a2, '(Compras a Liquidar al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 6
   ACT(a2, '(Ventas a Liquidar al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 7
   ACT(a2, '(Pases Activos Concertados al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 8
   ACT(a2, '(Pases Pasivos Concertados al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 9
   ACT(a2, '(Prestamos y Depositos Concertados al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 10
   ACT(a2, '(Compras Futuras)')
ENDIF
IF Dialogo.Cantidad1 = 11
   ACT(a2, '(Ventas Futuras)')
ENDIF
IF Dialogo.Cantidad1 = 12
   ACT(a2, '(Pases Activos Vigentes no Concertados al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 13
   ACT(a2, '(Pases Pasivos Vigentes no Concertados al '~Dialogo.Fecha1~')')
ENDIF
IF Dialogo.Cantidad1 = 15
   ACT(a2, '(Prestamos y Depositos Futuros)')
ENDIF
ACT(a3, 'Fecha: '~Dialogo.Fecha1)
ACT(a4, 'Cartera: ')
IF Dialogo.Radio1=0
   ACT(a4, Val(a4)~'Trading')
   ACT(cr2, '107|')
ENDIF
IF Dialogo.Radio1=1
   ACT(a4, Val(a4)~'Investment <= 6 meses')
   ACT(cr2, '108|')
ENDIF
IF Dialogo.Radio1=2
   ACT(a4, Val(a4)~'Investment > 6 meses')
   ACT(cr2, '109|')
ENDIF
IF Dialogo.Radio1=3
   ACT(a4, Val(a4)~'Otras Sociedades')
   ACT(cr2, '110|')
ENDIF
SetFont(a1..a5, 1)

ACT(a6, 'NrOperacion')
ACT(b6, 'Tipo Op.')
ACT(c6, 'Fecha Op.')
ACT(d6, 'Fecha Vto.')
ACT(e6, 'Cantidad')
ACT(f6, 'Monto')
ACT(g6, 'Interes')
ACT(h6, 'Neto')
ACT(i6, 'Valuacion')

SetFont(a6..i6, 1)
AgregarMarco(a6..i6,1,0,Exe("COLOR6"))
SetFilaActual(6)
