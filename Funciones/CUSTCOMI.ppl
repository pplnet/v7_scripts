VTXT15      : 'Alias4'         ;7;2;2;NO;NO;;;;;IIF(NOVACIO(ESPECIE) THEN QUERY("Select Alias4 from "~DBO~".ESPECIES where Codigo = '"~ESPECIE~"' ") ELSE " " ENDIF)

Cambio4     : 'Monto'          ;16;2;1;NO;;;;;;IF(Eqstr(VTXT12,'CLE'),CANTIDAD1*(1+IntsCapitalizados2(ESPECIE,FECHA1))*PRECIO1*VPRE10,PRECIO1*CANTIDAD1);;;;;'##,###,###,###.##';
Cambio1     : 'Total'          ;17;2;1;NO;Eqstr(VTXT12,'CLE');;;;;CAMBIO4+CAMBIO3;;;;;'##,###,###,###.##';

Cambio2     : 'Tasa'           ;7;1;2;CB6=0;Incluido('LETES',VTXT18);;;;;IF(Incluido('LETES',VTXT18),(1-PRECIO1)*36000/(FechaMaduracion(ESPECIE)-FECHA1),0)
Cambio3     : 'Interes'        ; ;1;2;NO;Eqstr(VTXT12,'CLE');;;;;IF(Eqstr(VTXT12,'CLE'),VCAN5+CANTIDAD5,0)
VCAN5       : 'Ints.Capitaliz.'; ;1;2;NO;  ;;;;;InteresEspecieCap(ESPECIE,FECHA1,CANTIDAD1,,VPRE1,(1+IntsCapitalizados2(ESPECIE,FECHA1)),PRECIO1)
Cantidad5   : 'Ints.a Pagar'   ; ;1;2;NO;  ;;;;;IF(Eqstr(VTXT15,'1585'),InteresEspecie(ESPECIE,FECHA1,CANTIDAD1*(1+IntsCapitalizados2(ESPECIE,FECHA1)))*PRECIO1,InteresEspecie(ESPECIE,FECHA1,CANTIDAD1*(1+IntsCapitalizados2(ESPECIE,FECHA1))))
VPRE3       : 'Tasa (%)'       ; ;1;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(VFEC1>VFEC2 y VFEC1<=FECHA1,((VPRE7*IF(VCAN9=0 y VCAN10=0,Dif360(VFEC2,VFEC1-1,2),DifDias(VFEC2,VFEC1-1,'USA',NO)))+(VPRE8*(IF(VCAN9=0 y VCAN10=0,Dif360(VFEC1-1,FECHA1,2),DifDias(VFEC1-1,FECHA1,'USA',NO)))))/(IF(VCAN9=0 y VCAN10=0,Dif360(VFEC2,FECHA1,2),DifDias(VFEC2,FECHA1,'USA',NO))),VPRE4)*100;
VFEC2       : 'Ult.Cupon'      ; ;1;2;NO;Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE');;;;;IF(EsHabil(UltCupon2(ESPECIE,FECHA1),'USA'),UltCupon2(ESPECIE,FECHA1),Habiles(UltCupon2(ESPECIE,FECHA1),IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',Especie),'SIG'),1,IF(EqStr(BuscarCampo('ESPECIES','CuponFeriado','Codigo',Especie),'ANT'),-1,0)),'USA'))

Precio2     : 'COMISION'       ;5;2;2;NO;;;;;;MontoArancelC(,CLIENTE1,ESPECIE,VEHICULO1,VAR('COMCUSMOV'),CAMBIO1,0,,BuscarCampo('Clientes','TipoCliente','Codigo',CLIENTE1),SI,TIPOOP,MERCADO1,VAR('SALLIBRECU'),IF(CB6=0,'MAN','AUT'),SI)*CotizacionC(VTXT3,,,,FECHA1 ,1,SI,VTXT6)
Precio3     : '  Porcentaje'   ; ;2;2;NO;;;;;;MontoArancelC(,CLIENTE1,ESPECIE,VEHICULO1,VAR('COMCUSMOV'),CAMBIO1,4,,BuscarCampo('Clientes','TipoCliente','Codigo',CLIENTE1),SI,TIPOOP,MERCADO1,VAR('SALLIBRECU'),IF(CB6=0,'MAN','AUT'),SI)
Precio4     : '  Minimo    '   ; ;2;2;NO;;;;;;MontoArancelC(,CLIENTE1,ESPECIE,VEHICULO1,VAR('COMCUSMOV'),CAMBIO1,1,,BuscarCampo('Clientes','TipoCliente','Codigo',CLIENTE1),SI,TIPOOP,MERCADO1,VAR('SALLIBRECU'),IF(CB6=0,'MAN','AUT'),SI)*CotizacionC(VTXT3,,,,FECHA1 ,1,SI,VTXT6)
Precio5     : '  Fijo      '   ; ;2;2;NO;;;;;;MontoArancelC(,CLIENTE1,ESPECIE,VEHICULO1,VAR('COMCUSMOV'),CAMBIO1,2,,BuscarCampo('Clientes','TipoCliente','Codigo',CLIENTE1),SI,TIPOOP,MERCADO1,VAR('SALLIBRECU'),IF(CB6=0,'MAN','AUT'),SI)*CotizacionC(VTXT3,,,,FECHA1 ,1,SI,VTXT6)
Cuenta3     : '  Cuenta'       ; ;2;2;CB6=0;;Precio2=0 o [Precio2>0 y NoVacio(Cuenta3)];'Cuenta de Comision Incorrecta';NO;;IF(NoVacio(VTXT4),VTXT4,If(NoVacio(VTXT5),VTXT5,VAR('CTAMOD23')));;;;;;"Cliente='"~CLIENTE1~"' and (Especies Like '%"~VAR('MONELOCA')~"%' or Especies LIke '%"~VAR('MONEEXTR')~"%') and Estado='HAB' and TipoCuenta In('CC','CA') ";
VTXT6       : '  Moneda'       ; ;2;2;NO;NO;;;;;VAR('MONELOCA')
Cambio5     : '  % IVA'        ; ;2;2;NO;  ;;;; Var('IVA')+IF(EqStr(IVA(CLIENTE1),'NOI'),VAR('RNI'),IF(EQSTR(BUSCARCAMPO('CLIENTES','Res3125','Codigo',CLIENTE1),'SI'),Var('RG3337'),0)); Var('IVA')+IF(EqStr(IVA(CLIENTE1),'NOI'),VAR('RNI'),IF(EQSTR(BUSCARCAMPO('CLIENTES','Res3125','Codigo',CLIENTE1),'SI'),Var('RG3337'),0))
Cantidad3   : '  Total IVA'    ; ;2;2;NO;  ;;;; ROUND(PRECIO2*CAMBIO5/100,2); ROUND(PRECIO2*CAMBIO5/100,2)

VTXT4       : 'Cta $'          ; ;2;2;NO;;;;;;IIF(NOVACIO(CLIENTE1) THEN QUERY("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and Especies Like '%"~VAR('MONELOCA')~"%' and Estado='HAB' and TipoCuenta In('CC','CA') ") ELSE ' ' ENDIF)
VTXT5       : 'Cta U$S'        ; ;2;2;NO;;;;;;IIF(NOVACIO(CLIENTE1) THEN QUERY("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and Especies Like '%"~VAR('MONEEXTR')~"%' and Estado='HAB' and TipoCuenta In('CC','CA') ") ELSE ' ' ENDIF)

