SQL.ADD(" Select Max(Fecha) as Fecha,Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,")
SQL.ADD("        Book, Cupon, Sector, IsNull(Estrategia,'') Estrategia, IsNull(TipoPosicion,'') TipoPosicion ") 
SQL.ADD(" From "~DBO~".POSICIONES P1 ")
SQL.ADD(" Where P1.Especie='"~Dialogo.Especie1~"' and P1.Fecha<='"~IdxDate(Dialogo.Fecha2)~"' and P1.Cupon='"~FSTR(VAL(c2),1,0)~"'")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" and P1.Sector='"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD(" Group By Cliente,Vehiculo,NrSaldo,PrecioEj,FechaEj,CallPut,Book,Cupon,Sector, IsNull(Estrategia,''), IsNull(TipoPosicion,'') ")

Recorrer SQL
   DFA

   Message("Verificando Posiciones NrSaldo= "~Fstr(FBN['NrSaldo'],0,0)~' '~FBN['Vehiculo']~' '~FBN['PrecioEj']~' '~FBN['FechaEj']~' '~FBN['Book'])

   SQL.ADD("Select *  From "~DBO~".POSICIONES P Where Especie='"~Dialogo.Especie1~"' ") 
   SQL.ADD(" and CantidadFin<>0 and Fecha='"~IdxDate(FBN['Fecha'])~"' ")
   SQL.ADD(" and Cliente='"~FBN['Cliente']~"' and Vehiculo='"~FBN['Vehiculo']~"' ")
   SQL.ADD(" and NrSaldo="~Fstr(FBN['NrSaldo'],0,0)~" ")
   If NoVacio(FBN['PrecioEj'])
      SQL.ADD(" and PrecioEj="~Fstr(FBN['PrecioEj'],0,8)~" ")
   Else 
      SQL.ADD(" and (PrecioEj='' or PrecioEj Is Null or PrecioEj=' ') ")
   EndIf
   If NoVacio(FBN['FechaEj'])
      SQL.ADD(" and FechaEj='"~IdxDate(FBN['FechaEj'])~"' ")
   Else 
      SQL.ADD(" and (FechaEj='' or FechaEj Is Null or FechaEj=' ') ")
   EndIf
   If NoVacio(FBN['CallPut'])
      SQL.ADD(" and CallPut='"~FBN['CallPut']~"' ")
   Else 
      SQL.ADD(" and (CallPut='' or CallPut Is Null or CallPut=' ') ")
   EndIf  
   If NoVacio(FBN['Sector'])
      SQL.ADD(" and Sector='"~FBN['Sector']~"' ")
   Else 
      SQL.ADD(" and (Sector='' or Sector Is Null or Sector=' ') ")
   EndIf  
   SQL.ADD(" and Book='"~FBN['Book']~"' and Cupon='"~FBN['Cupon']~"'  ")
   
* PZ 12/07/24 - Se agregan los campos Estrategia y TipoPosicion que utilizan los saldos 121 y 122
   If NoVacio(FBN['Estrategia'])
     SQL.ADD(" and Estrategia      = '"~FBN['Estrategia']~"' ")
   Else 
     SQL.ADD(" and (Estrategia     = '' or Estrategia Is Null or Estrategia = ' ') ")
   EndIf  

   If NoVacio(FBN['TipoPosicion'])
     SQL.ADD(" and TipoPosicion      = '"~FBN['TipoPosicion']~"' ")
   Else 
     SQL.ADD(" and (TipoPosicion     = '' or TipoPosicion Is Null or TipoPosicion = ' ') ")
   EndIf  
   

   Recorrer SQL
      ACN(y:2, 0)   
      Message("Verificando Posiciones NrSaldo= "~Fstr(FBN['NrSaldo'],0,0)~' '~FBN['Vehiculo']~' '~FBN['PrecioEj']~' '~FBN['FechaEj']~' '~FBN['Book'])    

      ACN(x1,FBN['Fecha'])
      ACN(z1,FBN['CantidadFin'])
      ACN(z2,FBN['PrecioFin'])

      * Precio Final actualizado
      If Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(b2)),'CLE')
         ACN(z3,Val(z2))
      Else
         ACN(z3,Val(z2)-((Val(k2)+Val(l2)+Val(m2))/100))
      Endif 

**Messagebox('PrecioFin '~Fstr(FBN['PrecioFin'],1,5) )
**Messagebox('  B2  '~Val(b2) )
**Messagebox(' Especie2   '~Dialogo.Especie2 )
**MessageBox(' Coti '~Fstr(Cotizacion(Dialogo.Especie2,,,,Dialogo.Fecha1,1,SI),1,5) )
**MessageBox(' z3 '~Fstr(Val(z3),1,5) )


      if Not Eqstr(Dialogo.Especie2,VAR('MONELOCA') )
         ACN(z93,Val(z2)-( ((Val(k2)+Val(l2)+Val(m2))/100)  * Cotizacion(Dialogo.Especie2,,,,Dialogo.Fecha1,1,SI))  )
      else
         ACN(z93,Val(z2)-((Val(k2)+Val(l2)+Val(m2))/100))
      Endif

**MessageBox(' z93 '~Fstr(Val(z93),1,5) )
** FJL 06/11/19 - Se agrega esta funcion para que genere una transaccion CUPON si no se genero antes
      If Vacio(val(y1))
        *- Genera la Transaccion de Cupon 
        (.'GENCUPON'.)
      EndIf
      (.'CUPINSPOS'.)
   Proximo
Proximo
*LimitesVision(aa:fac)
