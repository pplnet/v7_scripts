If Dialogo.Radio2=0 o Dialogo.Radio2=2   
   **-- MOVIMIEMTOS DE TRANSACCIONES DTP Y RTP
   SQL.ADD("SELECT ME.NrOperacion, T.TipoTr2 TipoOp, ME.FechaMov, ME.Especie, ME.TipoNegocio, ME.Cantidad, ME.NrSaldo, ME.Sector,ME.Precio,' ' ContraEspecie")
   SQL.ADD("FROM   "~DBO~".MOVPOSEJE ME, "~DBO~".TRANSACCIONES2 T ") 
   SQL.ADD("WHERE  ME.NrOperacion = T.NrTrans ")
   SQL.ADD("       and T.TipoTr2 In ('DTP', 'RTP') ")
   SQL.ADD("       and ME.FechaMov = '"~IdxDate(&i)~"' ")
   SQL.ADD("       and ME.NrSaldo In ("~Pipe2Comillas(Val(cr2))~") ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("    and ME.Especie In ('"~Dialogo.Especie1~"') ")
   Endif
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("    and ME.Sector In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   **-- MOVIMIENTOS DE PAGO DE DIVIDENDOS
   SQL.ADD("SELECT ME.NrOperacion, T.TipoTr2 TipoOp, ME.FechaMov, ME.Especie, ME.TipoNegocio, SUM(ME.Cantidad) AS Cantidad, ME.NrSaldo, ME.Sector,ME.Precio,' ' ContraEspecie ")
   SQL.ADD("FROM   "~DBO~".MOVPOSEJE ME, "~DBO~".TRANSACCIONES2 T ") 
   SQL.ADD("WHERE  ME.NrOperacion = T.NrTrans ")
   SQL.ADD("       and T.TipoTr2 In ('PDIVID') ")
   SQL.ADD("       and ME.FechaMov = '"~IdxDate(&i)~"' ")
   SQL.ADD("       and ME.NrSaldo In ("~Pipe2Comillas(Val(cr2))~") ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("    and ME.Especie In ('"~Dialogo.Especie1~"') ")
   Endif
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("    and ME.Sector In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD("GROUP BY ME.NrOperacion, T.TipoTr2, ME.FechaMov, ME.Especie, ME.TipoNegocio, ME.NrSaldo, ME.Sector,ME.Precio ")
   SQL.ADD(" UNION ALL")
   **-- MOVIMIENTOS DE CORTE DE CUPON
   SQL.ADD("SELECT ME.NrOperacion, T.TipoTr2 TipoOp, ME.FechaMov, ME.Especie, ME.TipoNegocio, ME.Cantidad, ME.NrSaldo, ME.Sector,ME.Precio,' ' ContraEspecie ")
   SQL.ADD("FROM   "~DBO~".MOVPOSEJE ME, "~DBO~".TRANSACCIONES2 T ") 
   SQL.ADD("WHERE  ME.NrOperacion = T.NrTrans ")
   SQL.ADD("       and T.TipoTr2 In ('CUPON') ")
   SQL.ADD("       and ME.FechaMov = '"~IdxDate(&i)~"' ")
   SQL.ADD("       and ME.NrSaldo In ("~Pipe2Comillas(Val(cr2))~") ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("    and ME.Especie In ('"~Dialogo.Especie1~"') ")
   Endif
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("    and ME.Sector In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   **-- MOVIMIENTOS DE OPERACIONES EXTRABURSATILES
   SQL.ADD("SELECT ME.NrOperacion, O.TipoOp, ME.FechaMov, ME.Especie, ME.TipoNegocio, ME.Cantidad, ME.NrSaldo, ME.Sector ,ME.Precio,O.ContraEspecie ")
   SQL.ADD("FROM   "~DBO~".MOVPOSEJE ME, "~DBO~".OPERACIONES O ") 
   SQL.ADD("WHERE  ME.NrOperacion = O.NrOperacion ")
   SQL.ADD("       and O.TipoOp In ('TIC', 'TIV','TIFC','TIFV') ")
   SQL.ADD("       and ME.FechaMov = '"~IdxDate(&i)~"' ")
   SQL.ADD("       and ME.NrSaldo In ("~Pipe2Comillas(Val(cr2))~") ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("    and ME.Especie In ('"~Dialogo.Especie1~"') ")
   Endif
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("    and ME.Sector In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
   SQL.ADD(" UNION ALL ")
   **-- MOVIMIENTOS DE OPERACIONES BURSATILES
   SQL.ADD("SELECT ME.NrOperacion, O.TipoOp, ME.FechaMov, ME.Especie, ME.TipoNegocio, ME.Cantidad, ME.NrSaldo, ME.Sector,ME.Precio,O.ContraEspecie ")
   SQL.ADD("FROM   "~DBO~".MOVPOSEJE ME, "~DBO~".OPERACIONES O ") 
   SQL.ADD("WHERE  ME.NrOperacion = O.NrOperacion ")
   SQL.ADD("       and O.TipoOp In ('CTP','CTC','VTP','VTC','CFTP','CFTC','VFTP','VFTC') ")
   SQL.ADD("       and O.Cliente1 = '"~Var('VEHICULO')~"' ")
   SQL.ADD("       and ME.FechaMov = '"~IdxDate(&i)~"' ")
   SQL.ADD("       and ME.NrSaldo In ("~Pipe2Comillas(Val(cr2))~") ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("    and ME.Especie In ('"~Dialogo.Especie1~"') ")
   Endif
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("    and ME.Sector In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
***************************************************************
   SQL.ADD(" UNION ALL ")
   ***---Movimientos de Prestamos, Depostios y Calls
   SQL.ADD("SELECT ME.NrOperacion, O.TipoOp, ME.FechaMov, ME.Especie, ME.TipoNegocio, ME.Cantidad, ME.NrSaldo, ME.Sector,ME.Precio,O.ContraEspecie ")
   SQL.ADD("FROM   "~DBO~".MOVPOSEJE ME, "~DBO~".OPERACIONES O ") 
   SQL.ADD("WHERE  ME.NrOperacion = O.NrOperacion ")
   SQL.ADD("       and O.TipoOp In ('TIDE','TIPO','TICT','TICO') ")
   SQL.ADD("       and ME.FechaMov = '"~IdxDate(&i)~"' ")
   SQL.ADD("       and ME.NrSaldo In ("~Pipe2Comillas(Val(cr2))~") ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD("    and ME.Especie In ('"~Dialogo.Especie1~"') ")
   Endif
   If NoVacio(Dialogo.Lista1)
      SQL.ADD("    and ME.Sector In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Endif
***************************************************************
endif
If Dialogo.Radio2=2
   SQL.ADD(" UNION ALL ")
endif
If Dialogo.Radio2=1 o Dialogo.Radio2=2
