   SQL.ADD("SELECT MP.NrOperacion, T.TipoTr2 TipoOp, MP.FechaMov, MP.Especie, MP.TipoNegocio, SUM(MP.Cantidad) as Cantidad , MP.NrSaldo, MP.Sector,MP.Precio,' ' ContraEspecie ")
   SQL.ADD("FROM   "~DBO~".MOVPOSPEN MP, "~DBO~".TRANSACCIONES2 T ") 
