ACN(BD:1, 0)
ACN(BD:2, 0)
BorrarCeldas(CA:fac..CB:fac)
BorrarCeldas(QQ:1..QQ:2)
AbrirAscii(val(z:3),0)
Recorrer&k 1, Longitud(Val(AE:fac))
    IF Not Incluido(Copy(Val(AE:fac), &k, 1), '.|,')
        IF Val(BD:1) = 0
            ***---Parte Entera
            ACT(CB:fac, Val(CB:fac)~Copy(Val(AE:fac), &k, 1))
        ELSE
            ***---Parte Decimal
            ACT(CA:fac, Val(CA:fac)~Copy(Val(AE:fac), &k, 1))
        ENDIF
    ELSE
        ACN(BD:1, 1)
    ENDIF
Proximo
***---Parte Entera
ACT(CB:fac, Pad0(Val(CB:fac), 15))
***---Parte Decimal
IF Longitud(Val(CA:fac)) <= 2
    IF Longitud(Val(CA:fac)) = 2
        ACT(CA:fac, Pad0(Copy(Val(CA:fac), 1, 2), 2))
    ENDIF
    IF Longitud(Val(CA:fac)) < 2
        ACT(CA:fac, Pad(Copy(Val(CA:fac), 1, 2), 2, '0'))
    ENDIF
ELSE
    ***---Redondeo a 2 decimales
    ACN(QQ:1, Num(Val(CA:fac))/(10^Longitud(Val(CA:fac))))
    ACT(CA:fac, Fstr(Round(Val(QQ:1), 2), 0, 2))
    Recorrer&k 1, Longitud(Val(CA:fac))
        IF Not Incluido(Copy(Val(CA:fac), &k, 1), '.|,')
            IF Val(BD:2) = 1
                ACT(QQ:2, Val(QQ:2)~Copy(Val(CA:fac), &k, 1))
            ENDIF
        ELSE
            ACN(BD:2, 1)
        ENDIF
    Proximo
    ACT(CA:fac, Copy(Val(QQ:2), 1, 2))
ENDIF
If val(an:fac)=0
    ACT(bc:fac, '*M*'~Pad(val(ap:fac),3)~Pad(val(av:fac),2)~Pad(val(ar:fac),17)~Pad0(trim(mirt(val(cb:fac)~val(ca:fac))),17)~Pad(val(at:fac),60)~Pad(Val(FC:fac), 2)~Pad('',136))
Else
    If val(an:fac)=1
        ACT(bc:fac, '*M*'~Pad(val(ap:fac),3)~Pad(val(av:fac),2)~Pad(val(ar:fac),17)~Pad0(trim(mirt(val(cb:fac)~val(ca:fac))),17)~Pad(val(at:fac),60)~Pad('',2)~Pad('',12)~Pad('',2)~Pad('',12)~Pad(val(aj:fac),12)~Pad('',2)~Pad0(trim(mirt('')),12)~Pad('',12)~Pad0(trim(mirt('')),10)~Pad(Val(CU:fac), 11)~Pad(Val(BU:fac), 22)~Pad('',29))
    Else
        If val(an:fac)=2
            ACT(bc:fac, '*M*'~Pad(val(ap:fac),3)~Pad(val(av:fac),2)~Pad(val(ar:fac),17)~Pad0(trim(mirt(val(cb:fac)~val(ca:fac))),17)~Pad(val(at:fac),60)~Pad('',2)~Pad('',12)~Pad('',2)~Pad('',12)~Pad(BuscarCampo('VEHICULOS','Alias5','Codigo', val(ai:fac)),12)~Pad('',2)~Pad0(trim(mirt('')),12)~Pad('',12)~Pad0(trim(mirt('')),10)~Pad(Val(CU:fac), 11)~Pad(Val(BU:fac), 22)~Pad('',29))
        EndIf
    EndIf
EndIf