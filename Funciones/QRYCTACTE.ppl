SQL.ADD("Select M.NrOperacion, M.Cliente, M.FechaMov, M.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre, M.Mercado, M.Cuenta                                    ")   
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where M.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'    ")
SQL.ADD(" and   M.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" and   O.Especie      = '"~Dialogo.Especie1~"'          ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion                  ")
SQL.ADD(" and   O.NrOperacion  = M.NrOperacion                   ")
SQL.ADD(" and   M.Cliente=C.Codigo                       ")
SQL.ADD(" and   O.Especie=E.Codigo                               ")
SQL.ADD(" and   OB.Valor =  '1'                                  ")
SQL.ADD(" and   OB.NrBit <>  30                                  ")
SQL.ADD(" and   M.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and   M.Cliente   = '"~Dialogo.Vehiculo1~"'            ")
SQL.ADD(" and   O.TipoOp in ('CCDEP','CCRET')                    ")
SQL.ADD(" and   M.NrSaldo = 1                                    ") 
