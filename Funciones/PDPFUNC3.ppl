*         Setear Funcion
*         Objeto a Buscar                  ACT(xz11,'INFORMES') 
*         Codigo del Objeto a Buscar       ACT(xz12,Val(t1))
*         Colunma Inicial para el detalle  ACN(xz13,4)

          ACT(aa13, BuscarLinkearHojas(Val(xz11), Val(xz12)))
          if NoVacio(Val(aa13))
             act(val(xz13):val(xy1)+1,'Incluye Informe')
             AlinearCeldas(val(xz13):val(xy1)+1,'D')
             SetFont(val(xz13):val(xy1)+1, 5)
             ACN(xy88,Elementos(Val(aa13)))
             SCN(xz40,Val(xy88))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy88)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa13), &k))))
                ACT(val(xz13)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz14,'INFORMES')
                ACT(xz15,Val(t10))
                ACN(xz16,Val(xz13)+1)
                (.'PDPFUNC4'.)
             proximo
          Endif

          ACT(aa23, BuscarEjecutarEventos(Val(xz11), Val(xz12)))
          if NoVacio(Val(aa23))
             act(Val(xz13):val(xy1)+1,'Incluye Evento')
             AlinearCeldas(val(xz13):val(xy1)+1,'D')
             SetFont(Val(xz13):val(xy1)+1, 5)
             ACN(xy88,Elementos(Val(aa23)))
             SCN(xz40,Val(xy88))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy88)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa23), &k))))
                ACT(Val(xz13)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz14,'EVENTOS')
                ACT(xz15,Val(t10))
                ACN(xz16,Val(xz13)+1)
                (.'PDPFUNC4'.)
             proximo
          Endif

          ACT(aa33, BuscarFunciones(Val(xz11), Val(xz12)))
          if NoVacio(Val(aa33))
             act(val(xz13):val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(val(xz13):val(xy1)+1,'D')
             SetFont(val(xz13):val(xy1)+1, 5)
             ACN(xy88,Elementos(Val(aa33)))
             **messagebox('7 - '~val(xy99)~' - '~val(aa33))
             SCN(xz40,Val(xy88))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy88)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa33), &k))))
                ACT(val(xz13)+1:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz14,'FUNCIONES')
                ACT(xz15,Val(t10))
                ACN(xz16,Val(xz13)+1)
                (.'PDPFUNC4'.)
             proximo
          Endif
           
