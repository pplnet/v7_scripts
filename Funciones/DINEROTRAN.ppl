*-- El dinero en transito corresponde a las operacion FXCS, FXCSV, FXVS, FXVSV
*-- que sean no puesto, es decir, que la fecha de vto de la especie sea distinta  
*-- a la fecha de vto de la contraespecie. Estas operaciones son de moneda <> a pesos

Recorrer&k 1, 15
   ACN(AA:&k, 0)
Proximo

ACN(fa1, Val(fi2)+10)
ACN(fa2, Val(fi4))

*-- Depositos por compra/venta de moneda no puesto 
SQL.ADD("SELECT O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp, ")
SQL.ADD("       O.Cantidad Cant ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaPago  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and  O.FechaVto <> O.FechaPago ")
SQL.ADD("       and  O.TipoOp In ('FXCS','FXCSV','FXVS','FXVSV') ")
SQL.ADD("       and  O.Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
SQL.ADD("       and  O.Especie In ("~Pipe2Comillas(VAR('MONELOCA')~'|'~VAR('MONEEXTR'))~") ")
IF Dialogo.Radio2 = 0
   SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
IF Dialogo.Radio2 = 1
   SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1+365)~"' ")
ENDIF
SQL.ADD("ORDER BY 2, 1 ")

Recorrer SQL
   If Not EqStr(val(ea2),FBN['Especie'])
      *- Cotizacion
      ACN(ea5, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
      ACT(ea2, FBN['Especie'] ) 
   Endif

   If Incluido(FBN['TipoOp'],'FXCS|FXCSV')
      SCN(aa4, FBN['Cant']*Val(ea5))
   Else
      SCN(aa4, FBN['Cant']*Val(ea5)*(-1))
   Endif
Proximo

SCN(G:Val(FA:1), Val(AA:4))
SCN(G:Val(FA:2), Val(AA:4))
SCN(L:Val(FA:1), Val(AA:4)*Dialogo.Precio1)
SCN(L:Val(FA:2), Val(AA:4)*Dialogo.Precio1)
SCN(O:Val(FA:1), Val(AA:4))
SCN(O:Val(FA:2), Val(AA:4))

SetFont(b:Val(fa1)..q:Val(fa1), 1)
SetFont(b:Val(fa2)..q:Val(fa2), 1)

*- Totales
ACN(I:Val(FA:1), Val(G:Val(FA:1))+Val(H:Val(FA:1)))
ACN(N:Val(FA:1), Val(L:Val(FA:1))+Val(M:Val(FA:1)))
ACN(Q:Val(FA:1), Val(O:Val(FA:1))+Val(P:Val(FA:1)))

*- Totales Activo
SCN(I:Val(FA:2), Val(I:Val(FA:1)))
SCN(N:Val(FA:2), Val(N:Val(FA:1)))
SCN(Q:Val(FA:2), Val(Q:Val(FA:1)))

SetFont(b:Val(fa1)..q:Val(fa1), 1)
FormatoCeldas(e:Val(fa1), Exe('F5'))
FormatoCeldas(j:Val(fa1), Exe('F5'))
FormatoCeldas(f:Val(fa1), Exe('F2'))
FormatoCeldas(k:Val(fa1), Exe('F2'))
FormatoCeldas(b:Val(fa1)..d:Val(fa1), Exe('F2'))
FormatoCeldas(g:Val(fa1)..i:Val(fa1), Exe('F2'))
FormatoCeldas(l:Val(fa1)..q:Val(fa1), Exe('F2'))




