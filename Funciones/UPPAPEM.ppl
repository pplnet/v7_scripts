* UPPAPEM. Update de Partidas- MMPEM/MMPIM
         ACN(o1,FBN['ImpGastos2'])
         ACN(o2,FBN['TotalAux1'])
         ACN(o3,FBN['TasaImp1'])
         ACN(o4,FBN['RB6'])
         ACN(o5,FBN['MB1'])
         ACN(o7,FBN['RB7'])
         ACN(o8,FBN['RB8'])
         ACN(o9,FBN['RB9'])
         ACN(o10,FBN['IntDevengados1'])
         ACN(o12,FBN['MB3'])
         ACN(o13,FBN['Precio3'])

         SQL.ADD(" SELECT * FROM  "~DBO~".CUOTAS where NrOperacion='"~FBN['NrOperacion']~"' and Fecha2 > '"~IdxDate(Val(a2))~"' ")

         Recorrer SQL

            Message(' Recuperando Cuota Nro '~Fstr(FBN['NrCuota'],0,0)~' '~FBN['NrOperacion'])
            * e1=>Interes  d1=> Importe Variable CEN  d2: Importe Total CEN  
            * d3: Importe Variable CEC  d4: Importe Total CEC 
            * f1: Importe de Iva  f2: Importe WH f3: Importe IVA CEN   
            ACN(e1,FBN['Cantidad2']*((FBN['Precio4']+FBN['Precio2'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],Val(o8)+1)) 
            ACN(d1,IIF(Val(o4)=1,(FBN['Cantidad2']*Val(o11)*FBN['Plazo1'])/IIF(Val(o12)=0,36000,36500),0)  )
            ACN(d2,IIF(Val(o4)=1,VAL(d1)+FBN['Cantidad5'],0))
            ACN(d3,IIF(Val(o4)=0,((FBN['Cantidad2']*FBN['Total5']*FBN['Plazo1'])/IIF(Val(o5)=0,36000,36500))*(Val(o13)/100),0) )
            ACN(d4,IIF(Val(o4)=0,FBN['Cantidad5']+VAL(d3),0))

*MessageBox('Iva '~Fstr( ((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(Val(o7)=0,36000,36500)),0,2))
*MessageBox('Iva '~Fstr(VAL(d4),0,2))
*MessageBox('Iva '~Fstr((Val(o1)/100),0,2))
*MessageBox('Iva '~Fstr((VAL(d4)+((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(Val(o7)=0,36000,36500))),0,2))
            ACN(f1,(VAL(d4)+((FBN['Cantidad2']*FBN['Plazo1']*FBN['Tasa2'])/IIF(Val(o7)=0,36000,36500))) *(Val(o1)/100) ) 
*MessageBox('Iva fINAL '~Fstr(Val(F1),0,2))
            ACN(f2,IIF(Val(o4)=0,0,IIF(Val(o4)=2,FBN['Cantidad2']*((FBN['Precio2']+FBN['Precio4'])/100)*FACTORDIAS(FBN['Fecha1'],FBN['Fecha2'],Val(o8)+1)*(Val(o2)/100),FBN['Cantidad2']*FBN['Plazo1']*FBN['Total6']/IiF(Val(o9)=1,36500,36000)*(Val(o2)/100))) )

            * e2=> Impuesto Interes e3 => Interes Total 
            ACN(e2,IIF(Val(o4)=0,VAL(e1),IIF(Val(o4)=1,VAL(d2),0))*(Val(o3)/100)  )
            ACN(e3,FBN['Cantidad7']+VAL(e1)+VAL(d4)+VAL(d2)+Val(f2)+VAL(e2))

            * e4: Monto e5: MontoTotal
            ACN(e4,FBN['Cantidad1']+VAL(e1))
            ACN(e5,FBN['Cantidad1']+VAL(e3))
            ACN(f3,VAL(d2)*(Val(o10)/100) )

      
            SQL.ADD(" UPDATE "~DBO~".CUOTAS Set ")
            SQL.ADD(" Cantidad3="~Fstr(val(e1),0,2)~", Precio5="~Fstr(val(e1),0,2)~",")
            SQL.ADD(" Cantidad4="~Fstr(val(d1),0,2)~", Plazo4="~Fstr(val(d2),0,2)~", ")
            SQL.ADD(" Total8="~Fstr(val(d3),0,2)~",Precio8="~Fstr(val(d3),0,2)~", ")
            SQL.ADD(" Cantidad6="~Fstr(val(d4),0,2)~", Total9="~Fstr(val(e2),0,2)~", PrecioRef1='"~Fstr(val(e2),0,2)~"', ")
            SQL.ADD(" Total3="~Fstr(val(e3),0,2)~", Total2="~Fstr(val(e4),0,2)~",")
            SQL.ADD(" Tasa3 ="~Fstr(val(f3),0,2)~", PrecioRef2='"~Fstr(val(f3),0,2)~"', ")
            SQL.ADD(" Total7="~Fstr(val(f2),0,2)~",Precio7="~Fstr(val(f2),0,2)~", ")
            SQL.ADD(" Total1="~Fstr(val(e5),0,2)~",Total4="~Fstr(val(f1),0,2)~",Precio6="~Fstr(val(f1),0,2)~"  ")
            SQL.ADD(" where NrOperacion='"~FBN['NrOperacion']~"' ")
            SQL.ADD(" and NrCuota="~Fstr(FBN['NrCuota'],0,0)~" ")
            SQL.NEW  
         Proximo
