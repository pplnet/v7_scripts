IF SQL(" Select 1 From "~DBO~".IMPUESTOS Where NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") AND Plazo4 = "~Fstr(Val(P:&i),0,0)~" ") = 1
    SQL.ADD(" Update "~DBO~".IMPUESTOS ")
    SQL.ADD(" Set NrTrans1 = '"~Val(T:&i)~"' ")
    SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
    SQL.ADD(" AND Plazo4 = "~Fstr(Val(P:&i),0,0)~" ")
    SQL.NEW
    SQL.EXEC
ENDIF