* Funcion para el resumen de cuenta - Cta Cte
   IF EQSTR(FBN['CondicionIVA'],'EXE')
      ACT(a:fac+1, 'Iva: Exento')
      ACT(a:fac+2,'El monto de Iva discriminado no puede computarse como crédito fiscal')
   ENDIF
   IF Incluido(FBN['CondicionIVA'],'NDR|NOR')
      ACT(a:fac+1,'Iva : No Responsable')
      ACT(a:fac+2,'El monto de Iva discriminado no puede computarse como crédito fiscal')
   ENDIF
   IF EQSTR(FBN['CondicionIVA'],'INS')
      ACT(a:fac+1,'Iva : Responsable Inscripto')
      ACT(a:fac+2,'El monto de Iva discriminado puede computarse como crédito fiscal')
   ENDIF
   IF Incluido(FBN['CondicionIVA'],'OTR|FIN')
      ACT(a:fac+1,'Iva : Consumidor Final')
      ACT(a:fac+2,'El monto de Iva discriminado no puede computarse como crédito fiscal')
   ENDIF
   IF EQSTR(FBN['CondicionIVA'],'NOI')
      ACT(a:fac+1,'Iva : Responsable No Inscripto')
      ACT(a:fac+2,'El monto de Iva discriminado no puede computarse como crédito fiscal')
   ENDIF
   IF EQSTR(FBN['CondicionIVA'],'MON')
      ACT(a:fac+1,'Iva : Responsable Monotributo')
      ACT(a:fac+2,'El monto de Iva discriminado no puede computarse como crédito fiscal')
   ENDIF
   IF EQSTR(FBN['CondicionIVA'],'NOC')
      ACT(a:fac+1,'Iva : No Categorizado')
      ACT(a:fac+2,'El monto de Iva discriminado no puede computarse como crédito fiscal')
   ENDIF

