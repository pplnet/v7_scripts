ACN(cp2,0)
ACN(cp3,0)

***---Busco el PPP de Posiciones
SQL.ADD("SELECT P.Especie,P.Fecha,P.CantidadFin, P.PrecioFin FROM "~DBO~".POSICIONES P ")
SQL.ADD("WHERE  P.Especie = '"~VAL(es3)~"' and P.Cupon='"~val(cc1)~"' ")
SQL.ADD("       AND P.NrSaldo IN ('101','201') ")
SQL.ADD("       AND P.Cliente IN ("~Pipe2Comillas(val(ve1))~") ")
SQL.ADD("       AND P.Fecha = (SELECT Max(D.Fecha) FROM "~DBO~".POSICIONES D ")
SQL.ADD("                      WHERE  D.Cliente = P.Cliente ")
SQL.ADD("                             AND D.Especie = P.Especie ")
SQL.ADD("                             AND D.NrSaldo = P.NrSaldo ")
SQL.ADD("                             AND D.Fecha < '"~IdxDate(val(fp1))~"') ")

