**/ PARAMETROS DE LA FUNCION /**
* xa1: Especie
* xa2: Fecha
* xa3: Cantidad
* xa4: Check
******************************** 

ACT(wa1, 'Intereses por Especie ')
ACT(wa2, 'Fecha Liq.: '~Val(xa2))
ACT(wa3, 'Especies: '~Val(xa1))

ACT(wa5, 'Especie')
ACT(wb5, 'Intereses ')
ACT(wc5, 'Cod.MAE')
ACT(wd5, 'Cupon Vig.')
ACT(we5, 'F. Ult. Cupon')
ACT(wf5, 'F. Prox. Cupon')
ACT(wg5, 'Contraesp.')
ACT(wh5, 'T.Int.Vig.')
ACT(wi5, 'V.Residual.')

ACN(wf1, 5)

*-- Busco especies
SQL.ADD("Select Codigo, Tipo, CodMAEContado, FechaCambioTasa, TasaIntVigente, TasaIntAnterior, VTeorico, Cupon, InteresesC, DiasMes, DiasAnio, IntsCapitalizados ")
SQL.ADD("from "~DBO~".ESPECIES ")
SQL.ADD("where Tipo in ('PUB','PRI','ONE') ")
SQL.ADD("and Codigo = '"~Val(xa1)~"' ")
SQL.ADD("Order by Codigo" )

Recorrer SQL

  SCN(wf1, 1)

  * solo considero las Terminales que desciendan de titulos
  if EsTerminal(fbn('Codigo'), Especie)
     * asigno valor a las celdas
     ACT(wa:val(wf1), fbn('Codigo'))
     ACT(wc:val(wf1), fbn('CodMAEContado'))
     ACN(wd:val(wf1), fbn('Cupon'))
     ACT(wg:val(wf1), Cotizaen(Val(wa:val(wf1))))
     ACN(wh:val(wf1), 100 * fbn('TasaIntVigente'))
     ACN(wi:val(wf1), 100 * fbn('VTeorico'))
     ACN(ae:val(wf1), UltCupon2(Val(wa:val(wf1)),Val(xa2)))
     ACN(fe:val(wf1), ProxCupon2(Val(wa:val(wf1)),Val(xa2)))    
     if Val(ae:val(wf1))>0
        ACD(we:val(wf1), Val(ae:val(wf1)))
     endif

     if Val(fe:val(wf1))>0
        ACD(wf:val(wf1), Val(fe:val(wf1)))
     endif
     
     * calculo el interes 
     if Eqstr(fbn('InteresesC'),'CLE') o Val(xa4)=1
        * obtengo diferencia de dias (x2,x3)
        ACN(x2,0)
        if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
           ACN(x2, Dif360(Val(ae:val(wf1)), Val(xa2),2))
        else
           ACN(x2, DifDias(Val(ae:val(wf1)), Val(xa2),'USA',NO))
        endif
 
        * obtengo tasa interes cupon para la formula (xx1)
        ACN(xx1,0)
        if fbn('FechaCambioTasa') > Val(ae:val(wf1)) y fbn('FechaCambioTasa') <= Val(xa2)
           ACN(ww1, fbn('TasaIntAnterior'))
           if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
              ACN(ww1, Val(ww1)* Dif360(Val(ae:val(wf1)),fbn('FechaCambioTasa')-1,2)) 
           else
              ACN(ww1, Val(ww1)* DifDias(Val(ae:val(wf1)),fbn('FechaCambioTasa')-1,'USA',NO))
           endif
           ACN(zz1 ,fbn('TasaIntVigente'))
           if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
              ACN(zz1, Val(zz1)* Dif360(fbn('FechaCambioTasa')-1, Val(xa2) ,2)) 
           else
              ACN(zz1, Val(zz1)* DifDias(fbn('FechaCambioTasa')-1, Val(xa2), 'USA', NO))
           endif
           ACN(xx1, Val(ww1)+Val(zz1))
           if EqStr(fbn('DiasAnio'),'360') y EqStr(fbn('DiasMes'),'30')
              ACN(xx1, Val(xx1) / Dif360(Val(ae:val(wf1)),Val(xa2),2))
           else
              ACN(xx1, Val(xx1) / DifDias(Val(ae:val(wf1)),Val(xa2),'USA',NO))
           endif
        else
           if fbn('FechaCambioTasa') <= Val(ae:val(wf1))
              ACN(xx1, fbn('TasaIntVigente'))
           endif
           if fbn('FechaCambioTasa') > Val(xa2)
              ACN(xx1, fbn('TasaIntAnterior'))
           endif
        endif

        * formula completa
        *if Eqstr(BuscarCampo('ESPECIES','Alias6','Codigo',fbn('Codigo')),'ESP')               
        *    if [(Anio(Val(ae:val(wf1))) MOD 4) = 0] y [(Anio(Val(ae:val(wf1))) MOD 4000) <> 0] y  [ [(Anio(Val(ae:val(wf1))) MOD 100) <> 0] O [(Anio(Val(ae:val(wf1))) MOD 400) = 0] ] 
        *       Acn(ac3,366)
        *    else
        *       Acn(ac3,365)
        *    endif
        *else
        *   Acn(ac3,DiasAnio2(fbn('Codigo'),Val(ae:val(wf1)),Val(fe:val(wf1))))
        *endif   
       
        *ACN(wb:val(wf1),fbn('VTeorico')*Val(xa3)*(1+fbn('IntsCapitalizados'))*Val(xx1)*Val(x2)/Val(ac3))  
        ACN(wb:val(wf1),fbn('VTeorico')*Val(xa3)*(1+fbn('IntsCapitalizados'))*Val(xx1)*Val(x2)/Diasa(EspecieDiasAnio(Val(xa1)),Val(xa2)))

     else
        ACN(wb:val(wf1),0)
     endif
  else
     dfa
  endif

  *- Valor para linkear desde el informe de Partidas 
  ACN(z1, val(wb:val(wf1))) 
Proximo

