SQL.ADD("Select MP.NrOperacion, MP.Cliente, MP.FechaMov, MP.FechaMov as FechaOp, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre,  MP.Mercado,                       ")
SQL.ADD("          CASE  WHEN O.Especie=MP.Especie THEN Cuenta1 Else (CASE  WHEN O.ContraEspecie=MP.Especie THEN Cuenta2  END ) END AS Cuenta ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                             ")
SQL.ADD(" and   MP.Cliente=C.Codigo                                ")
SQL.ADD(" and   O.Especie=E.Codigo                                 ")
SQL.ADD(" and   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'             ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'             ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'                    ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                      ")
SQL.ADD(" and   MP.NrSaldo = 100                                           ")
SQL.ADD(" and   O.TipoOp in ('FXOCTC','FXOCTV')                            ")
SQL.ADD(" and   (                                                          ")
SQL.ADD(" (O.Especie=MP.Especie and O.Cuenta1 IN ("~val(li1)~"))           ")
SQL.ADD(" or  (O.ContraEspecie=MP.Especie and O.Cuenta2 IN ("~val(li1)~")) ")
SQL.ADD("       )                                                          ")
SQL.ADD(" Union ")
SQL.ADD("Select MP.NrOperacion, MP.Cliente, MP.FechaMov, MP.FechaMov as FechaOp, -MP.Cantidad as Cantidad, O.TipoOp, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("       C.Razonsocial, E.Nombre,  MP.Mercado,                       ")
SQL.ADD("          CASE  WHEN O.Especie=MP.Especie THEN Cuenta1 Else (CASE  WHEN O.ContraEspecie=MP.Especie THEN Cuenta2  END ) END AS Cuenta ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS MP, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where MP.NrOperacion = O.NrOperacion                             ")
SQL.ADD(" and   MP.Cliente=C.Codigo                                ")
SQL.ADD(" and   O.Especie=E.Codigo                                 ")
SQL.ADD(" and   MP.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'             ")
SQL.ADD(" and   MP.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'             ")
SQL.ADD(" and   MP.Especie     = '"~Dialogo.Especie1~"'                    ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                      ")
SQL.ADD(" and   MP.NrSaldo = 100                                           ")
SQL.ADD(" and   O.TipoOp in ('FXOCTC','FXOCTV')                            ")
SQL.ADD(" and   (                                                          ")
SQL.ADD(" (O.Especie=MP.Especie and O.Cuenta1 IN ("~val(li1)~"))           ")
SQL.ADD(" or  (O.ContraEspecie=MP.Especie and O.Cuenta2 IN ("~val(li1)~")) ")
SQL.ADD("       )                                                          ")


