message('--- Asientos de Devengados diarios Partidas ---')

ACD(FV:1, Dialogo.Fecha1)

**** Usamos Check1 para saber si el informe se llama de contabilidad
LinkearHoja('PARTID',1,Fecha1=Dialogo.Fecha1,Book1='',Lista1='',Radio1=0,Check1=1)
****siempre van a ser cartera
ACN(SL:1, Var('SALDOPOCON'))

Recorrer&i LinkH(1, ZZ:1),LinkH(1, ZZ:2)
    ****Campos que faltan
    SQL.ADD(" Select Codigo CodAsi, '"~LinkH(1, ac:&i)~"' Vehiculo1, '"~LinkH(1, aa:&i)~"' Especie, '"~LinkH(1, ac:&i)~"' Vehiculo, ")
    SQL.ADD(" '"~LinkH(1, ad:&i)~"' TipoEspecie, '"~LinkH(1, ae:&i)~"' MonedaEmision, '"~LinkH(1, af:&i)~"' Book1, 'TIC' TipoOp, '"~LinkH(1, ag:&i)~"' Cliente,  ")
    SQL.ADD(" '"~LinkH(1, ah:&i)~"' CuentaCustodia, '"~LinkH(1, ai:&i)~"' Concepto, '"~LinkH(1, aj:&i)~"' Issuer, ")
    SQL.ADD("'"~LinkH(1, ag:&i)~"' Cliente1,'"~LinkH(1, ak:&i)~"' EspBanTotal, ")
    SQL.ADD(" "~Fstr(LinkH(1, ab:&i), 0, 2)~" Cantidad ")
    SQL.ADD(" From "~DBO~".MODELOSASIENTO ")
    SQL.ADD(" Where (TipoAsiento = '"~Var('TIPASRETID')~"') ")
    SQL.ADD(" AND '|'+rtrim(Vehiculo)+'|' like '%|"~VAL(VC:1)~"|%' ")
    SQL.ADD(" AND Habilitado = 'SI' ")
    SQL.ADD(" AND (TipoOp Is Null OR TipoOp = '') ")
    Recorrer SQL
        ACT(bk:1,FBN['Book1'])
        ACN(RT:1, fbn('Cantidad'))
        IF Dialogo.Check1 = 1 O Dialogo.Fecha1 < Fsys
            ACN(CK:1, 1)
            IF Vacio(SQL(" Select A.NrUnicoAsiento from "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 Where A.NrUnicoAsiento = A1.NrUnicoAsiento AND  A.Modelo = '"~fbn('CodAsi')~"' AND A.Estado IN ('E','A') AND A1.Alias1 = '"~fbn('Especie')~"' AND A.Vehiculo = '"~fbn('Vehiculo')~"' AND A.Fecha1 = '"~Idxdate(val(FV:1))~"' AND A1.Alias2 = '"~fbn('Book1')~"' AND (A.NrOperacion = '' OR A.NrOperacion = ' ' OR A.NrOperacion Is Null) "))
                ACN(CK:1, 0)
            ENDIF
        ENDIF
        let &codAsi fbn('CodAsi')
        IF Val(CK:1) = 0
            Message(fbn('Especie')~'  - Modelo: '~fbn('CodAsi'))
            SQL.GenerarAsientoOp(&codAsi,,,,Val(NA:1),Val(FV:1),fbn('Vehiculo1'),,fbn('Book1'),,,,,,,,,,,fsys,Dialogo.Fecha1)
            SQL.EXEC
        ENDIF
    Proximo
    
Proximo

CerrarLink(1)