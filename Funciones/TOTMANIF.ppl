INSTANCIA101
CAMPOS: 0;;1;1=2;
VCAN21: 'Excep.F.Valor'; 2;1;1;NO;SI;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NRORDEN~"' And Tipo = 'FVALOR' ")
VCAN22: 'Excep.Precio' ; 3;1;1;NO;SI;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NRORDEN~"' And Tipo = 'RANGOPRECI' ")
VCAN23: 'Excep.Lim'    ; 4;1;1;NO;SI;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NRORDEN~"' And (Tipo Like '%NOAS' or Tipo Like '%VENC' or Tipo Like '%CANC' or Tipo Like '%EXCE')")
VCAN24: 'a Inst Contr' ; 5;1;1;NO;SI;;;;;IF(VCAN22+VCAN23>0,1,0)

POSTEDICION
FW = 2 ;'ANUORD';NrOrden1=NRORDEN;Check1=1

BITS
