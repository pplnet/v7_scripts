* --- Genera MovDevengados para Resultados --- *
message('Recuperando intereses del dia ...')
SQL.ADD(" SELECT SUM(M.Cantidad) Cantidad, M.Concepto, M.NrSaldo, M.Especie, ")
SQL.ADD(" M.EnteCustodia, M.NrOperacion, M.FechaMov ")
SQL.ADD(" FROM "~DBO~".VMOVDEVENGADOSCC M  ")
SQL.ADD(" WHERE  M.FechaMov     = "~idxdate2(Val(fe:1))~" ")
SQL.ADD(" AND    M.EnteCustodia = '"~Dialogo.Vehiculo1~"'      ")
SQL.ADD(" AND    M.NrSaldo      = 15                           ")
SQL.ADD(" AND    M.Concepto IN ('INTPAG','INTSOB','INTDES')    ")
SQL.ADD(" GROUP BY M.Concepto, M.NrSaldo, M.Especie, M.EnteCustodia, M.NrOperacion, M.FechaMov ")
Recorrer SQL
    Message('Borrando devengados del dia ... ')
    SQL.ADD("DELETE FROM "~DBO~".MOVDEVENGADOS  ")
    SQL.ADD(" WHERE Fecha     = "~idxdate2(fbn('FechaMov'))~" ")
    SQL.ADD(" AND   NrSaldo   = 15 ")
    SQL.ADD(" AND   TipoDevengado = '"~fbn('Concepto')~"'    ")
    SQL.ADD(" AND   Cliente       = '"~Dialogo.Vehiculo1~"'  ")
    SQL.ADD(" AND   Vehiculo      = '"~Dialogo.Vehiculo1~"'  ")
    SQL.ADD(" AND   NrOperacion   = '"~fbn('NrOperacion')~"' ")
    SQL.NEW

    message('Generando movimiento devengado ... ')
    SQL.ADD(" INSERT INTO "~DBO~".MOVDEVENGADOS ( ")
    SQL.ADD(" NrOperacion, Fecha, Monto, TipoDevengado, ")
    SQL.ADD(" Cliente, Vehiculo, NrSaldo, Especie, ")
    SQL.ADD(" Book, EspecieRef ")
    SQL.ADD(" ) VALUES ( ")
    SQL.ADD(" '"~fbn('NrOperacion')~"', "~IdxDate2(fbn('FechaMov'))~",  "~FSTR(-fbn('Cantidad'),0,2)~", '"~fbn('Concepto')~"', ")
    SQL.ADD(" '"~FBN['EnteCustodia']~"', '"~FBN['EnteCustodia']~"', "~FSTR(fbn('NrSaldo'),0,0)~", '"~FBN['Especie']~"', ")
    SQL.ADD(" '"~VAR('BOOKCC')~"', '"~FBN['Especie']~"' ")
    SQL.ADD(" ) ")
    SQL.NEW
Proximo
SQL.EXEC

* --------------------- Actualiza Devengados -------------------------- *
EjecutarEvento('DEVENG',Fecha1=Val(fe:1))

* --------------------- Revaluo de Devengados ------------------------- *
EjecutarEvento('DEVREC',Fecha1=Val(fe:1))