    **Fecha
    ACD(g:1, Fecha(val(c:7)~'/'~val(c:6)~'/'~'20'~''~val(c:5)))
    ***Fecha de Carga en SIOPEL
    ACT(g:2, val(c:6)~'/'~val(c:7)~'/'~val(c:5)~' '~val(c:8)~':'~val(c:9)~':'~val(c:10))  
    ***Convierte Cantidad
    ACN(d:23, Round(num(Val(c:23))/10000,2))
    ACT(e:23, Fstr(Val(d:23),0,2))
    ***Convierte Precios
    ACN(d:24, Round(num(val(c:24))/100000000,8))
    ACT(e:24, Fstr(Val(d:24),0,8))
    ***Convierte Interes
    ACN(d:30, Round(num(val(c:30))/100,2))
    ACT(e:30, Fstr(Val(d:30),0,2))
    ***Convierte Tasa
    ACN(d:32, Round(num(val(c:32))/100000000,8))
    ACT(e:32, Fstr(Val(d:32),0,8))
    ***Convierte Valorizacion(monto $)
    ACN(d:35, Round(num(val(c:35))/100,2))
    ACT(e:35, Fstr(val(d:35),0,2))
    ***Convierte Valorizacion(monto USD)
    ACN(d:36, Round(num(val(c:36))/100,2))
    ACT(e:36, Fstr(val(d:36),0,2))

    * FJL 04/09/18 - Campos Nuevos
    ***Convierte Arancel1
    ACN(d:78, Round(num(val(c:78))/100,2))
    ACT(e:78, Fstr(val(d:78),0,2))
    ***Convierte Arancel2
    ACN(d:80, Round(num(val(c:80))/100,2))
    ACT(e:80, Fstr(val(d:80),0,2))
    ***Convierte Arancel3
    ACN(d:82, Round(num(val(c:82))/100,2))
    ACT(e:82, Fstr(val(d:82),0,2))

    BorrarCeldas(h:1..h:5)
    ***Busca Cliente
    if Eqstr(Val(c:12),'0105')
      if Not EqStr(Val(c:21),'000')
        ACT(h:1, SQL("Select Codigo from "~DBO~".CLIENTES where NrMAE='"~Val(c:21)~"' "))
      endif
    else
      if Eqstr(Val(c:12),'0205')
        if Not EqStr(Val(c:3),'000')
          ACT(h:1, SQL("Select Codigo from "~DBO~".CLIENTES where NrMAE='"~Val(c:3)~"' "))
        endif
      else
        ** Es llamado por un 7020 0105/0205 y la funcion GENOPSIOPL
        ACT(h:1, Val(c:57))
      endif
    endif

    ACT(h:4, '0')

    **Genero Secuencia2
* FJL 23/03/18 Se agrega hora a secuencia2   
**    ACT(h:5, Val(c:5)~Val(c:6)~Val(c:7)~Val(c:11))
    ACT(h:5, Val(c:5)~Val(c:6)~Val(c:7)~Val(c:8)~Val(c:9)~Val(c:10)~Val(c:11))

    ***valido que no exista
    if (SQL("Select Count(*) from "~DBO~".OPSIOPEL where Secuencia2= '"~Val(h:5)~"' ")) = 0
      Message('Insert OPSIOPEL Secuencia2 = '~Val(h:5))
      SQL.ADD("Insert into "~DBO~".OPSIOPEL ( ")
      SQL.ADD("Fecha,            Longitud,            Mercado,           Agente,             Operador,             ")
      SQL.ADD("Fecha_aa,         Fecha_mm,            Fecha_dd,          Hora_hh,            Hora_mm,              ")
      SQL.ADD("Hora_ss,          FechaCarga,          Secuencia,         CodigoRegistro,     CodigoNego,           ")
      SQL.ADD("CodigoTitulo,     Cupon,               Nrocupon,          Plazo,              Moneda,               ")
      SQL.ADD("Clase,            MercadoContra,       AgenteContra,      OperadorContra,     Cantidad,             ")
      SQL.ADD("Precio,           TipoOpOrigen,        TipoOpDestino,     EnteLiquidador,     TipoLiquidacion,      ")
      SQL.ADD("CodigoRueda,      Interes,             Referencia,        Tasa,               Pata,                 ")
      SQL.ADD("OrigenOp,         Valorizacion,        ValorizacionUSD,   Mnemotecnico,       NroOfertaVen,         ")
      SQL.ADD("NroOfertaCpra,    DuenoInformacion,    Filler,            TipoCobertura,      CodigoAgenteAgredido, ")
      SQL.ADD("NroOrdenVendedor, ComitenteVendedor,   NroOrdenComprador, ComitenteComprador, TipoGiro,             ")
      if Incluido(Val(c:12),'0303|0403')
        * Operaciones rueda TRD de Ayer
        SQL.ADD("Corredor, ")
      else
        SQL.ADD("Garantizada,      ")
        if Eqstr(Val(c:12),'7020')
          SQL.ADD("CodRegContestado, FechaOrden,        SecEnvioOrden,     CodRespuesta,      CodAgenteContra,      ")
          SQL.ADD("FechaAltaMAE,     NroAltaMAE,        NrOrden,           ")
        endif
        * FJL 04/09/18 - Campos Nuevos
        SQL.ADD("OrdenTipoCpra,     OrdenTipoVta,      MercadoExtCpra, NroOrdenMerExtCpra, ")
        SQL.ADD("MercadoExtVta,     NroOrdenMerExtVta, Corredor,       CodArancel1, ")
        SQL.ADD("Arancel1,          CodArancel2,       Arancel2,       CodArancel3, ")
        SQL.ADD("Arancel3,          FechaOfertaVta,    HoraOfertaVta,  SecOfertaVta, ")
        SQL.ADD("FechaOfertaCpra,   HoraOfertaCpra,    SecOfertaCpra,   ")
        if Not Eqstr(Val(c:12),'7020')
          SQL.ADD("ComitCtaVendedor, ComitCtaComprador, ")
        endif
      endif
      SQL.ADD("Procesado,       Cliente,           NrOperacion,     Secuencia2 ")
      SQL.ADD(" ) Values ( ")
      * Fecha
      SQL.ADD(" '"~IdxDate(Val(g:1))~"', ")
      * Longitud
      SQL.ADD(" '"~Val(c:1)~"', ")
      * Mercado
      SQL.ADD(" '"~Val(c:2)~"', ")
      * Agente
      SQL.ADD(" '"~Val(c:3)~"', ")
      * Operador
      SQL.ADD(" '"~Val(c:4)~"', ")

      * Fecha_aa
      SQL.ADD(" '"~Val(c:5)~"', ")
      * Fecha_mm 
      SQL.ADD(" '"~Val(c:6)~"', ")
      * Fecha_dd
      SQL.ADD(" '"~Val(c:7)~"', ")
      * Hora_hh
      SQL.ADD(" '"~Val(c:8)~"', ")
      * Hora_mm
      SQL.ADD(" '"~Val(c:9)~"', ")

      * Hora_ss
      SQL.ADD(" '"~Val(c:10)~"', ")
      * FechaCqarga
      SQL.ADD(" Convert(smalldatetime,'"~Val(g:2)~"'), ")
      * Secuencia
      SQL.ADD(" '"~Val(c:11)~"', ")
      * CodidoRegistro
      SQL.ADD(" '"~Val(c:12)~"', ")
      * CodigoNego
      SQL.ADD(" '"~Val(c:13)~"', ")

      * CodigoTitulo
      SQL.ADD(" '"~Val(c:14)~"', ")
      * Cupon
      SQL.ADD(" '"~Val(c:15)~"', ")
      * NroCupon
      SQL.ADD(" '"~Val(c:16)~"', ")
      * Plazo
      SQL.ADD(" '"~Val(c:17)~"', ")
      * Moneda
      SQL.ADD(" '"~Val(c:18)~"', ")

      * Clase
      SQL.ADD(" '"~Val(c:19)~"', ")
      * MercadoContra
      SQL.ADD(" '"~Val(c:20)~"', ")
      * AgenteContra
      SQL.ADD(" '"~Val(c:21)~"', ")
      * OperadorContra
      SQL.ADD(" '"~Val(c:22)~"', ")
      * Cantidad
      SQL.ADD(" "~Val(e:23)~", ")

      * Precio
      SQL.ADD(" "~Val(e:24)~", ")
      * TipoOpOrigen
      SQL.ADD(" '"~Val(c:25)~"', ")
      * TipoOpDestino
      SQL.ADD(" '"~Val(c:26)~"', ")
      * EnteLiquidador
      SQL.ADD(" '"~Val(c:27)~"', ")
      * TipoLiquidacion
      SQL.ADD(" '"~Val(c:28)~"', ")

      * CodigoRueda
      SQL.ADD(" '"~Val(c:29)~"', ")
      * Interes
      SQL.ADD(" "~Val(e:30)~", ")
      * Referencia
      SQL.ADD(" '"~Val(c:31)~"', ")
      * Tasa
      SQL.ADD(" "~Val(e:32)~", ")
      * Pata
      SQL.ADD(" '"~Val(c:33)~"', ")

      * OrigenOp
      SQL.ADD(" '"~Val(c:34)~"', ")
      * Valorizacion
      SQL.ADD(" "~Val(e:35)~", ")
      * ValorizacionUSD
      SQL.ADD(" "~Val(e:36)~", ")
      * Mnemotecnico
      SQL.ADD(" '"~Val(c:37)~"', ")
      * NroOfertaVen
      SQL.ADD(" '"~Val(c:38)~"', ")

      * NroOfertaCpra
      SQL.ADD(" '"~Val(c:39)~"', ")
      * DuenoInformacion
      SQL.ADD(" '"~Val(c:40)~"', ")
      * Filler
      SQL.ADD(" '"~Val(c:41)~"', ")
      * TipoCobertura
      SQL.ADD(" '"~Val(c:42)~"', ")
      * CodigoAgenteAgredido
      SQL.ADD(" '"~Val(c:43)~"', ")

      * NroOrdenVendedor
      SQL.ADD(" '"~Val(c:44)~"', ")
      * ComitenteVendedor
      SQL.ADD(" '"~Val(c:45)~"', ")
      * NroOrdenComprador
      SQL.ADD(" '"~Val(c:46)~"', ")
      * ComitenteComprador
      SQL.ADD(" '"~Val(c:47)~"', ")
      * TipoGiro
      SQL.ADD(" '"~Val(c:48)~"', ")

      if Incluido(Val(c:12),'0303|0403')
        * Operaciones rueda TRD de Ayer
        * Corredor
        SQL.ADD(" '"~Val(c:76)~"', ")
      else
        * Garantizada
        SQL.ADD(" '"~Val(c:51)~"', ")
        if Eqstr(Val(c:12),'7020')
          * CodRegContestado
          SQL.ADD(" '"~Val(c:52)~"', ")
          * FechaOrden
          SQL.ADD(" '"~Val(c:53)~"', ")
          * SecEnvioOrden
          SQL.ADD(" '"~Val(c:54)~"', ")
          * CodRespuesta
          SQL.ADD(" '"~Val(c:55)~"', ")
          * CodAgenteContra
          SQL.ADD(" '"~Val(c:56)~"', ")

          * FechaAltaMAE
          SQL.ADD(" "~Val(c:62)~", ")
          * NroAltaMAE
          SQL.ADD(" '"~Val(c:60)~"', ")
          * NrOrden
          SQL.ADD(" '"~Val(c:63)~"', ")
        endif

        * OrdenTipoCpra
        SQL.ADD(" '"~Val(c:70)~"', ")
        * OrdenTipoVta
        SQL.ADD(" '"~Val(c:71)~"', ")
        * MercadoExtCpra 
        SQL.ADD(" '"~Val(c:72)~"', ")
        * NroOrdenMerExtCpra
        SQL.ADD(" '"~Val(c:73)~"', ")
        * MercadoExtVta
        SQL.ADD(" '"~Val(c:74)~"', ")
        * NroOrdenMerExtVta
        SQL.ADD(" '"~Val(c:75)~"', ")
        * Corredor
        SQL.ADD(" '"~Val(c:76)~"', ")
        * CodArancel1
        SQL.ADD(" '"~Val(c:77)~"', ")
        * Arancel1
        SQL.ADD(" "~Val(e:78)~", ")
        * CodArancel2
        SQL.ADD(" '"~Val(c:79)~"', ")
        * Arancel2
        SQL.ADD(" "~Val(e:80)~", ")
        * CodArancel3
        SQL.ADD(" '"~Val(c:81)~"', ")
        * Arancel3
        SQL.ADD(" "~Val(e:82)~", ")
        * FechaOfertaVta
        SQL.ADD(" '"~Val(c:83)~"', ")
        * HoraOfertaVta
        SQL.ADD(" '"~Val(c:84)~"', ")
        * SecOfertaVta
        SQL.ADD(" '"~Val(c:85)~"', ")
        * FechaOfertaCpra
        SQL.ADD(" '"~Val(c:86)~"', ")
        * HoraOfertaCpra
        SQL.ADD(" '"~Val(c:87)~"', ")
        * SecOfertaCpra
        SQL.ADD(" '"~Val(c:88)~"', ")
        if Not Eqstr(Val(c:12),'7020')
          * ComitCtaVendedor
          SQL.ADD(" '"~Val(c:89)~"', ")
          * ComitCtaComprador
          SQL.ADD(" '"~Val(c:90)~"', ")
        endif      
      endif      
       
      * Procesado
      SQL.ADD(" '"~Val(h:4)~"', ")
      * Cliente
      SQL.ADD(" '"~Val(h:1)~"', ")
      * NrOperacion
      SQL.ADD(" NULL, ")
      * Secuencia2
      SQL.ADD(" '"~Val(h:5)~"' ")

      SQL.ADD(" ) ")
      SQL.NEW
      SQL.EXEC

      ACT(f:FAC, 'OK')
    else
      Message('Secuencia2 '~Val(h:5)~' ya existente')
      ACT(f:FAC, 'Error')
    endif
