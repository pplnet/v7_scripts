ACT(b:63, 'c63- Nro Orden TMANIF/OTIC/OTIV')
SQL.ADD("Select O.NrOrden, O.TipoOrden, O.Cliente, OB.NrBit ")
SQL.ADD("  from "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where (O.NrOrden   Like '"~'____'~Copy(Val(c:54),2,4)~"' and O.TipoOrden in ('TMANIF') and OB.NrBit in (104) ) ")
SQL.ADD("   and O.NroAltaMAE = '"~Val(c:60)~"' ")
SQL.ADD("   and O.FechaAltaMAE = "~Val(c:62)~" ")
SQL.ADD("   and O.NrOrden   = OB.NrOperacion ")
SQL.ADD("   and OB.Valor    = '1' ")
SQL.ADD(" UNION ")
SQL.ADD("Select O.NrOrden, O.TipoOrden, O.Cliente, OB.NrBit ")
SQL.ADD("  from "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where  O.NrOrden   Like '"~'____'~Copy(Val(c:54),2,4)~"' and O.TipoOrden in ('OTIC','OTIV')  ")
SQL.ADD("   and O.NroAltaMAE = '"~Val(c:60)~"' ")
SQL.ADD("   and O.NrOrden   = OB.NrOperacion ")
SQL.ADD("   and OB.Valor    = '1' ")
watch(SQL.BAtch())
Recorrer SQL
  DFA
  ACT(c:63, fbn('NrOrden'))
proximo

if Incluido(Val(c13),Var('TIPONEGLIC')) o Incluido(Val(c13),Var('TIPONEGCPC'))
  ***Genera Operacion siopel en OPSIOPEL
  (.'OPSIOPEL'.)
  if EqStr(Val(f:FAC),'Error')
    */Ver si grabamos LOG
    if Eqstr(Var('LOGERRMAE'),'SI')
       AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
       EscribirASCII(Pad('Gen OPSIOPEL ADJ duplicada',30)~'-'~Val(a:FAC))
       CerrarASCII
    endif
  endif
else
  if Eqstr(Var('LOGERRMAE'),'SI')
    AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
    EscribirASCII(Pad('Gen OPSIOPEL ADJ - error T.Neg',30)~'-'~Val(a:FAC))
    CerrarASCII
  endif
endif
