  SCN(xx1,1)

  ACT(cz:val(xx1),Fstr(1,0,0))
  ACD(cy:val(xx1),FBN['FechaOp'])
  ACT(cx:val(xx1),Fstr(FBN['Plazo'],0,0))
  ACD(cw:val(xx1),FBN['FechaVto'])
*  ACD(cv:val(xx1),FBN['FechaEj'])
  ACD(cv:val(xx1),0)
  ACN(cu:val(xx1),FBN['Precio1'])

  ACN(ca:val(xx1),0)
  ACN(gg:val(xx1),0)
  ACN(da:val(xx1),0)
  ACN(db:val(xx1),0)
  ACN(na:val(xx1),0)
  ACN(nh:val(xx1),0)
  ACN(ga:val(xx1),0)
  ACN(gb:val(xx1),0)
  ACN(gc:val(xx1),0)
  ACN(ea:val(xx1),0)
  ACN(eb:val(xx1),0)
  ACN(ec:val(xx1),0)
  ACN(fa:val(xx1),0)
  ACN(fb:val(xx1),0)
  ACN(fc:val(xx1),0)
  ACN(nb:val(xx1),0)
  ACN(nc:val(xx1),0)
  ACN(nd:val(xx1),0)
  ACN(ne:val(xx1),0)
  ACN(nf:val(xx1),0)
  ACN(ng:val(xx1),0)

  * CAPITAL
  ACN(ca:val(xx1),Round(val(c1),2))

  * INTERESES
  ACN(ch:val(xx1),Round(val(ca:val(xx1))*val(cu:val(xx1))*(val(cw:val(xx1))-val(cy:val(xx1)))/val(g1),2))
  
  * COMISION
  ACN(cq:val(xx1),Round(FBN['TotalComisiones'],2))

if val(z2) < val(cw:val(xx1))
  (.'PMOOUTAUX2'.)
else
  ACN(pc1,1)
  ACD(pa:val(pc1),0)
  ACN(pb:val(pc1),0)

  SQL.ADD("select FechaMov, sum(Cantidad) as Monto from "~DBO~".MOVEJECUTADOS ")
  SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
  SQL.ADD("and NrSaldo <100 and NrSaldo not in (1,20,73,74,75,76,77,78) ")
  SQL.ADD("and FechaMov<= "~IdxDate2(val(z2))~" ")
  SQL.ADD("group by FechaMov ")
  Recorrer SQL
    SCN(pc1,1)
    ACD(pa:val(pc1),fbn('FechaMov'))
    ACN(pb:val(pc1),fbn('Monto'))
  Proximo

  if val(pc1)=1
    (.'PMOOUTAUX2'.)  
  else

  *** CAPITAL FALLADO
*  ACN(ca:val(xx1),Round(Val(ad:25),2))

  *** IMPORTE AMORTIZADO
*  ACN(ci:val(xx1),Round(val(ca:val(xx1)),2))

  *** INTERES NORMAL
*  ACN(ch:val(xx1),Round(Val(ad:21),2))
  *** INTERES COMPENSATORIO
  ACN(cc:val(xx1),0)
  *** INTERES PUNITORIO
  ACN(cd:val(xx1),0)

  *** IVANORINT
  ACN(ce:val(xx1),0)
  *** IVAADIINT
  ACN(cf:val(xx1),0)
  *** IVAPERINT
  ACN(cg:val(xx1),0)

  *** IVANORCOM
  ACN(cj:val(xx1),0)
  *** IVAADICOM
  ACN(ck:val(xx1),0)
  *** IVAPERCOM
  ACN(cl:val(xx1),0)
  
  *** SALDO COMISIONES
  * Normal
*  ACN(cq:val(xx1),0)
  * Compensatoria
  ACN(cr:val(xx1),0)  


  SCN(pc1,1)
  ACD(pa:val(pc1),val(z2))
  ACN(pb:val(pc1),0)
  
  Recorrer&k 1,val(pc1)-1

    ACD(cv:val(xx1),val(pa:&k))
    ACD(z2,val(pa:&k+1))

    (.'PMOOUTAUX2'.)

    ACN(x5,val(pb:&k+1))

    (.'PMOOUTAUX3'.)  

    *** CAPITAL FALLADO
    ACN(ca:val(xx1),Round(Val(ad:25),2))

    *** IMPORTE AMORTIZADO
  *  ACN(ci:val(xx1),Round(val(ca:val(xx1)),2))

    *** INTERES NORMAL
    ACN(ch:val(xx1),Round(Val(ad:21),2))
    *** INTERES COMPENSATORIO
    ACN(cc:val(xx1),Round(Val(ad:20),2))
    *** INTERES PUNITORIO
    ACN(cd:val(xx1),Round(Val(ad:19),2))

    *** IVANORINT
    ACN(ce:val(xx1),Round(Val(ad:13),2))
    *** IVAADIINT
    ACN(cf:val(xx1),Round(Val(ad:7),2))
    *** IVAPERINT
    ACN(cg:val(xx1),Round(Val(ad:1),2))

    *** IVANORCOM
    ACN(cj:val(xx1),Round(Val(ad:16),2))
    *** IVAADICOM
    ACN(ck:val(xx1),Round(Val(ad:10),2))
    *** IVAPERCOM
    ACN(cl:val(xx1),Round(Val(ad:4),2))
  
    *** SALDO COMISIONES
    * Normal
    ACN(cq:val(xx1),Round(Val(ad:23),2))
    * Compensatoria
    ACN(cr:val(xx1),Round(Val(ad:22),2))

  Proximo

  ACN(gg:val(xx1),Round(val(ch:val(xx1)),2))

  ACN(da:val(xx1),Round(val(cc:val(xx1)),2))
  ACN(db:val(xx1),Round(val(cd:val(xx1)),2))
  ACN(na:val(xx1),Round(val(cq:val(xx1)),2))  
  ACN(nh:val(xx1),Round(val(cr:val(xx1)),2))  

  endif
endif

*** TOTAL IVA INTERES
ACN(ia:val(xx1),Round(val(ga:val(xx1))+val(gb:val(xx1))+val(gc:val(xx1)),2))
*** TOTAL IVA COMPENSATORIOS
ACN(ib:val(xx1),Round(val(ea:val(xx1))+val(eb:val(xx1))+val(ec:val(xx1)),2))
*** TOTAL IVA PUNITORIOS
ACN(ic:val(xx1),Round(val(fa:val(xx1))+val(fb:val(xx1))+val(fc:val(xx1)),2))
*** TOTAL IVA COMISION
ACN(id:val(xx1),Round(val(nb:val(xx1))+val(nc:val(xx1))+val(nd:val(xx1)),2))
*** TOTAL IVA COMISION
ACN(ie:val(xx1),Round(val(ne:val(xx1))+val(nf:val(xx1))+val(ng:val(xx1)),2))