      ** Ordenes
      SQL.ADD("Select O.NrOrden, O.TipoOrden, O.Cliente ")
      SQL.ADD("  from "~DBO~".ORDENES O")
      SQL.ADD(" Where O.NrOrden   = '"~Val(or:1)~"' ")
      Recorrer SQL
        DFA
       SCN(v4, 1)
        if Val(v4)>1
           Message('Mas de una Operacion RECMAE22')
           if Eqstr(Var('LOGERRMAE'),'SI')
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad('Mas de una Orden RECMAE22',30)~'-'~Val(A:FAC))
              CerrarASCII
           endif
          break
        endif

        ACN(v6, 0)
        SQL.ADD("Select * from "~DBO~".MENSAJESMAE ")
        SQL.ADD(" where Codigo    like '"~Val(E:3)~"' ")
        SQL.ADD("   and Secuencia = '"~Copy(Val(A:FAC),42,5)~"' ")
        SQL.ADD("   and FechaMAE  = '"~Copy(Val(A:FAC),36,6)~"' ")
        SQL.ADD("   and Estado    = 'INF' ")
        Recorrer SQL
          DFA
          ACT(ac:1, fbn('Codigo'))
          ACT(ac:2, fbn('FechaMAE'))
          ACT(ac:3, fbn('HoraMAE'))
          ACT(ac:4, fbn('Secuencia'))
          ACT(ac:5, fbn('CodigoMAE'))
          ACT(ac:6, fbn('Estado'))
          SCN(v6,1)
          proximo
        if Val(v6)=1
          SQL.ADD("Update "~DBO~".MENSAJESMAE ")
          SQL.ADD("   Set Estado    = '"~Val(E:2)~"' ")
          SQL.ADD(" Where Codigo    = '"~Val(ac:1)~"' ")
          SQL.ADD("   and FechaMAE  = '"~Val(ac:2)~"' ")
          SQL.ADD("   and HoraMAE   = '"~Val(ac:3)~"' ")
          SQL.ADD("   and Secuencia = '"~Val(ac:4)~"' ")
          SQL.ADD("   and CodigoMAE = '"~Val(ac:5)~"' ")
          SQL.ADD("   and Estado    = 'INF' ")
          SQL.NEW
          SQL.EXEC
        else
         if Eqstr(Var('LOGERRMAE'),'SI')
            if Val(v6)=0
            *** Error 7020 no existe
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad(Val(ms:1)~' No Existe Pend.',30)~'-'~Val(A:FAC))
              CerrarASCII
            else
            *** Error 7020 multiples Reg.
              AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
              EscribirASCII(Pad(Val(ms:1)~' Multipes Reg.',30)~'-'~Val(A:FAC))
              CerrarASCII
            endif
          endif
        endif
        
        if EqStr(Val(E:1),'NO')
          Message('E:1 = NO '~Copy(Val(A:FAC),32,4))
          Message('---------- '~FBN['NrOrden']~' '~Val(ms:2))
          * Error en orden, actualiza Operaciones
          SQL.ADD("Update "~DBO~".ORDENES ")
          SQL.ADD("   Set AceptaMAE   = 'NO', ")
          SQL.ADD("       NroAltaMAE   = null, ")
          SQL.ADD("       CodErrorMAE = '"~Copy(Val(A:FAC),47,1)~"', ")
          SQL.ADD("       ObsErrorMAE = '"~Copy(Val(A:FAC),48,15)~"' ")
          SQL.ADD(" Where NrOrden = '"~FBN['NrOrden']~"' ")
          SQL.NEW
          SQL.ADD("Insert into "~DBO~".EXCEPCIONES ( ")
          SQL.ADD(" NrOperacion, Fecha, Tipo, Descripcion ")
          SQL.ADD(" ) Values ( ")
          SQL.ADD(" '"~FBN['NrOrden']~"', ")
          SQL.ADD(" "~SQLAhora~", ")
          SQL.ADD(" '"~Val(er:1)~"', ")
          SQL.ADD(" '"~Val(tp:1)~'-'~Copy(Val(A:FAC),48,55)~"' ")
          SQL.ADD(" ) ")
          SQL.NEW
          SQL.EXEC
          EjecutarEvento('CBOINS', String1=fbn['NrOrden'], Radio1=1, Radio2=0, Entero1=Val(ob:1), Entero2=Val(ob:2))
        else
        Message('---------- '~FBN['NrOrden']~' '~Val(ms:3))
          * Ok operacion, actualiza Operaciones
          BorrarCeldas(K9..K12)
          ACT(K9,  Copy(Val(A:FAC),15,2)~'/'~Copy(Val(A:FAC),13,2)~'/'~Copy(Val(A:FAC),11,2)~' '~Copy(Val(A:FAC),17,2)~':'~Copy(Val(A:FAC),19,2)~':'~Copy(Val(A:FAC),21,2))
          ACT(K10, SQLFechaStr(Val(K9),Exe('FORFECHOR')))
          SQL.ADD("Update "~DBO~".ORDENES ")
          SQL.ADD("   Set AceptaMAE    = 'SI', ")
          SQL.ADD("       FechaAltaMAE = "~Val(K10)~", ")
          SQL.ADD("       NroAltaMAE   = '"~Copy(Val(A:FAC),23,5)~"' ")
          SQL.ADD(" Where NrOrden      = '"~FBN['NrOrden']~"' ")
          SQL.NEW

          SQL.ADD("Delete "~DBO~".EXCEPCIONES ")
          SQL.ADD(" where NrOperacion = '"~FBN['NrOrden']~"' ")
          SQL.ADD("   and Tipo        = '"~Val(er:1)~"' ")
          SQL.NEW
          SQL.EXEC
          EjecutarEvento('CBOINS', String1=fbn['NrOrden'], Radio1=1, Radio2=2, Entero1=Val(ob:1), Entero2=Val(ob:3))
          endif
      proximo
      if Val(v4)=0
         Message('Operacion NO encontrada RECMAE22')
         if Eqstr(Var('LOGERRMAE'),'SI')
            AbrirASCII(Val(z2)~'\ERRORMAE.TXT',0)
            EscribirASCII(Pad('Orden NO encontrada RECMAE22',30)~'-'~Val(A:FAC))
            CerrarASCII
         endif
      endif
