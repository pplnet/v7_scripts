BorrarCeldas(mp:1..mp:30)
SetFilaActual(fac+100)
ACN(z:1, fac)
ACN(x:4, 0)


*- Saldos que no son de opciones 
SQL.ADD("SELECT S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, NrSaldo, S.Fecha, C.RazonSocial, ")
SQL.ADD("       '' CallPut, '' FechaEj, 0 PrecioEj, C.RecibePreaviso, S.Saldo, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes,S.NrSaldo as NumSalOri")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  S.NrSaldo in ("~Pipe2Comillas(Val(dz17))~") ")
SQL.ADD("       AND S.Cliente = C.Codigo ")
SQL.ADD("       AND S.Especie='"~VAL(b2)~"' and S.Cupon='"~FSTR(VAL(c2),1,0)~"' ")
SQL.ADD("       AND S.Especie = E.Codigo ")
SQL.ADD("       AND S.Cupon= "~Fstr(Dialogo.Entero1,0,0)~" ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("       AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
EndIf
If NoVacio(Dialogo.Mercado1)
   SQL.ADD("       AND S.Mercado = '"~Dialogo.Mercado1~"'")
EndIf
If NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("       AND S.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
EndIf
SQL.ADD("       AND isnull(S.CallPut,'') NOT IN ('CALL','PUT') ")
SQL.ADD("       AND S.Saldo <> 0 ")
SQL.ADD("       AND S.Fecha=( ")
SQL.ADD("                    SELECT Max(S1.Fecha)  ")
SQL.ADD("                    FROM   "~DBO~".SALDOSDIA S1")
SQL.ADD("                    WHERE  S1.Cliente = S.Cliente ")
SQL.ADD("                           AND   S1.Especie = S.Especie ")
SQL.ADD("                           AND   S1.Mercado = S.Mercado ")
SQL.ADD("                           AND   S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                           AND   S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("                           AND   S1.Cupon = S.Cupon  ")
SQL.ADD("                           AND   S1.Cuenta  = S.Cuenta   ")
SQL.ADD("                           AND   S1.Fecha <= '"~IdxDate(VAL(g2))~"') ")

SQL.ADD("UNION ALL")

*- Saldos  de opciones 
SQL.ADD("SELECT S.Cliente, S.Especie, S.Mercado, S.Cuenta, S.EnteCustodia, NrSaldo, S.Fecha, C.RazonSocial, ")
SQL.ADD("       S.CallPut, S.FechaEj, S.PrecioEj, C.RecibePreaviso, S.Saldo, ")
SQL.ADD("       C.TipoCliente, C.CondicionGan, C.CondicionIVA, C.Res3125, E.InteresesC, E.Cotiza, ")
SQL.ADD("       E.TasaIntVigente, E.FechaCambioTasa, E.Valor10, E.TasaIntAnterior, E.Valor9, ")
SQL.ADD("       E.DiasAnio, E.DiasMes,S.NrSaldo as NumSalOri ")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE  S.NrSaldo in ("~Pipe2Comillas(Val(dz17))~") ")
SQL.ADD("       AND S.Cliente = C.Codigo ")
SQL.ADD("       AND S.Especie='"~VAL(b2)~"' and S.Cupon='"~FSTR(VAL(c2),1,0)~"' ")
SQL.ADD("       AND S.Especie = E.Codigo ")
SQL.ADD("       AND S.Cupon= "~Fstr(Dialogo.Entero1,0,0)~" ")
SQL.ADD("       AND S.Saldo <> 0 ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("       AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
EndIf
If NoVacio(Dialogo.Mercado1)
   SQL.ADD("       AND S.Mercado = '"~Dialogo.Mercado1~"'")
EndIf
If NoVacio(Dialogo.ListaTabla1) 
   SQL.ADD("       AND S.Cliente in ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
EndIf
SQL.ADD("       AND isnull(S.CallPut,'') In ('CALL','PUT') ")
SQL.ADD("       AND S.Fecha=( ")
SQL.ADD("                    SELECT Max(S1.Fecha)  ")
SQL.ADD("                    FROM   "~DBO~".SALDOSDIA S1")
SQL.ADD("                    WHERE  S1.Cliente = S.Cliente ")
SQL.ADD("                           AND S1.Especie = S.Especie ")
SQL.ADD("                           AND S1.Mercado = S.Mercado ")
SQL.ADD("                           AND S1.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                           AND S1.NrSaldo = S.NrSaldo  ")
SQL.ADD("                           AND   S1.Cupon = S.Cupon  ")
SQL.ADD("                           AND S1.Cuenta  = S.Cuenta   ")
SQL.ADD("                           AND (S1.CallPut = S.CallPut or (S1.CallPut Is Null and S.CallPut Is Null) or (S1.CallPut='' and S.CallPut=''))")
SQL.ADD("                           AND (S1.FechaEj = S.FechaEj or (S1.FechaEj Is Null and S.FechaEj Is Null) or (S1.FechaEj='' and S.FechaEj=''))")
SQL.ADD("                           AND (S1.PrecioEj = S.PrecioEj or (S1.PrecioEj Is Null and S.PrecioEj Is Null)or (S1.PrecioEj='' and S.PrecioEj=''))")
SQL.ADD("                           AND S1.Fecha <= '"~IdxDate(VAL(g2))~"') ")
SQL.ADD("ORDER BY 6, 1, 2, 8, 9, 10, 5, 3, 4 ")

watch(SQL.batch())

Recorrer SQL
  SCN(x:4, 1)
  ACT(a:FAC, fbn('Cliente'))
  ACT(b:FAC, fbn('Especie'))
  ACT(c:FAC, fbn('Mercado'))
  ACT(d:FAC, fbn('Cuenta'))
  ACT(e:FAC, fbn('EnteCustodia'))
  ACN(f:FAC, fbn('NrSaldo'))
  ACN(g:FAC, fbn('Saldo'))
  ACD(h:FAC, fbn('Fecha'))

  If Vacio(val(y1))
    ACT(j:FAC, 'Genera Tr')
    *- Genera la Transaccion de Cupon 
    (."GENCUPON".)
    ACT(k:FAC, Val(y:1))
  EndIf

  (.'CUPINSMOVP'.)

proximo
