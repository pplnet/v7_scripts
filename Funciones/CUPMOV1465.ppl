*- Segun Corte Saldos o Movimientos las Fechas varian -> 
*- fv1: Fecha Valida para Movimiento del Corte fv2: Fecha Valida para Movimiento del Pago 

*- mp1: Nro. Transaccion mp2: Fecha Movimiento mp3: Cliente 
*- mp4: Especie mp5: CallPut mp6: FechaEj mp7: PrecioEj mp8: Mercado
*- mp9: EnteCustodia mp10: Cantidad mp11: Formula mp12: Leyenda mp13: Bits mp14: NrSaldo  mp15: NrGrupo
*- mp16: Concepto (NrSaldo Original)
*- mp19: Cuenta mp22: Nro. de Movimiento mp20: NrGrupo2
*- mp27: Cupon  mp23: Com.Renta mp25: Com.Amortizacion
*- mp50: Leyendo para ver si viene de movimientos pendientes
 
*- Movimiento por El Aumento del Cupon Cupon 
ACT(mp13,'AV' )
ACD(mp2,Dialogo.Fecha1)

ACT(mp1,val(y1))
ACT(mp3, Val(UE:&k))
ACT(mp4,Val(b4))
*If Incluido(Val(ub:k),'TICT|TIDE')
*Endif
*If Incluido(Val(ub:k),'TICO|TIPO')
*Endif

ACT(mp5,'PRE')

ACT(mp8 , Val(UI:&k))
ACT(mp9 , Dialogo.Vehiculo1)
ACN(mp10, Val(UG:&k))
ACD(mp17,Dialogo.Fecha1)
ACN(mp20, Val(UG:&k))

*- % IVA
ACT(mp11,Fstr(val(ci:2),0,2) )         
 
ACT(mp12,'Corte de Cupon de '~val(mp4)~' Cup. '~Fstr(Dialogo.Entero1, 0, 0)~' por '~Val(UB:&k))

ACN(mp14, 101)
ACT(mp16, '101')

*- mp15: Nro. Grupo 1 es el de las Acciones 
ACN(mp15,1)
ACT(mp19, Val(UF:&k))
ACT(mp29, Val(UF:&k))
ACT(mp28, Val(UA:&k))
ACN(mp22, &k+300000 )
ACT(mp27, Fstr(Dialogo.Entero1, 0, 0))
ACD(MP:2, Dialogo.Fecha1)

(."IMMOVPEND".)
SQL.EXEC


IF Val(JO:1) = 6 y EqStr(val(ul:&k),'HAB')
   Message('Entro en bajando saldo de cupones !!! '~VAL(Y2))
   ACT(mp13,'AV' )
   ACD(mp2,Dialogo.Fecha1)

   *- mp20: En Nro. de grupo2 grabo la tenencia 
   ACN(mp20, Val(UG:&k))

    ACT(mp16, '101')

    *- Movimiento bajando el saldo de cupones
    ACT(mp1,val(y2))
    ACT(mp3,val(UE:&k))
    ACT(mp4, Val(B:4))

    ACT(mp5,'PRE')
    ACT(mp6,'' )
    ACN(mp7,0 )

    ACT(mp8 ,Val(UI:&k))
    ACT(mp9 , Dialogo.Vehiculo1)

    ACN(mp10,  - Val(UG:&k))

    *- % IVA 
    ACT(mp11,Fstr(val(ci:2),0,2))

    ACT(mp12,'Liq. Cupon de '~val(mp4)~' Cup. '~Val(aa2)~'por '~Val(UB:&k))

    ACN(mp14, 101)

    ACN(mp15,1)
    ACT(mp19,Val(UF:&k))
    ACT(mp29,Val(UF:&k))
    ACN(mp22, &k)
    ACT(mp27, Fstr(Dialogo.Entero1, 0, 0))

    (."IMMOVPEND".)

    IF Val(BD:&K) = 0
       *- Genero el Movimiento del efectivo asociado a la transaccion LCUPON 
       ACT(mp1,val(y2))
       ACD(mp2,Dialogo.Fecha1)
       ACT(mp3,val(UE:&k))
       ACT(mp4, Dialogo.Especie2)
       ACT(mp5,'PRE')
       ACT(mp6,'' )
       ACN(mp7,0 )
       ACT(mp8 , Val(UI:&k))
       ACT(mp9 ,Dialogo.Vehiculo1)
       ACN(mp10,  Val(UJ:&k))
       *- % IVA 
       ACT(mp11,Fstr(val(ci:2),0,2) )          
       ACT(mp12,'Liq. Cupon de '~val(mp4)~' Cup. '~Val(aa2)~'por '~Val(UB:&k))
       ACN(mp14, 5)
       ACN(mp15,1)
       ACT(mp19, Val(LB:&k))
       ACT(mp29,Val(UF:&k))
       ACN(mp22, &k+100000 )
       ACT(mp27,'')
       (."IMMOVPEND".)
   *--------------------------------------------------------------
    ENDIF
ENDIF
SQL.EXEC