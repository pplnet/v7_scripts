
Vehiculo1   : 'Vehiculo'       ;1;2; ;NO;;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
Especie     : 'Especie'        ;2;1; ; ;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO');'Debe Ingresar una Especie Valida';NO;
Mercado1    : 'Ubicacion'      ;2;2; ;NO O VCAN6=0; ;NoVacio(MERCADO1) ;'Debe Ingresar Un Mercado';NO;;IF(CB1=1,VAR('CLHODEFA'),MERCADO1)
Cliente1    : 'Cliente'        ;3;1; ;NO O VCAN6=0;;[Not EqStr(CLIENTE1,VEHICULO1)] o VCAN6=0;'Cliente Invalido';NO;;
Cuenta2     : 'Cta_Cte'        ;3;2; ;NO O VCAN6=0; ;NoVacio(CUENTA2) y EqStr(BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2),MERCADO1);'Debe Ingresar el Numero de Cuenta del Cliente';NO;Query("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and (Especies Like '%TITULO%' or Especies='"~ESPECIE~"|') and Estado='HAB' and TipoCuenta In ('CUS','CCO') and Mercado='"~MERCADO1~"' and Comitente='"~VEHICULO1~"' ");Query("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and (Especies Like '%TITULO%' or Especies='"~ESPECIE~"|') and Estado='HAB' and TipoCuenta In ('CUS','CCO') and Mercado='"~MERCADO1~"' and Comitente='"~VEHICULO1~"' ");;;;;;"Estado='HAB' and TipoCuenta  In ('CUS','CCO') and Comitente='"~VEHICULO1~"' and Cliente='"~CLIENTE1~"' and Mercado='"~MERCADO1~"' "
Fecha1      : 'Fecha Emi'      ;4;2; ;NO O VCAN6=0;  ;FECHA1 <= FSYS y EsHabil(FECHA1,'ARG');'Fecha Incorrecta';NO;FSYS;

Cantidad1   : 'Cantidad'       ;5;1; ;NO O VCAN6=0; ;CANTIDAD1>0;'La Cantidad en Valor Nominal debe ser Positiva';NO;;;
Cantidad2   : 'Val.Tecnica'    ; ;1; ;NO O VCAN6=0; ;CANTIDAD2>0 O VCAN6=0;'La Valuacion Tecnica debe ser Positiva';NO;PRECIO2*CANTIDAD1;PRECIO2*CANTIDAD1;;;;;'###,###,###,###.######' 

Cupon1      : 'NrCupon'        ;1;2;2;NO O VCAN6=0;;;;;NrCupon2(ESPECIE,FECHA1);NrCupon2(ESPECIE,FECHA1);;;
NrTransRef1 : 'DTP Asociada'   ;1;1;2;NO;;;;;
VCAN4       : 'Lamina Minima'  ; ; ;2;NO;;;;;BuscarCampo('Especies','LaminaMinima','Codigo',ESPECIE);BuscarCampo('Especies','LaminaMinima','Codigo',ESPECIE)

Cantidad3 :'Dias transcurridos' ;1;3;2;NO;NO;;;;DifDias(UltCupon2(ESPECIE,FECHA1),FECHA1,'USA',NO);DifDias(UltCupon2(ESPECIE,FECHA1),FECHA1,'USA',NO)
VTXT1       : 'Indexado'        ; ; ; ;NO;NO;;;;Query("Select Indexado from "~DBO~".ESPECIES WHERE Codigo='"~ESPECIE~"'");Query("Select Indexado from "~DBO~".ESPECIES WHERE Codigo='"~ESPECIE~"'");
VPRE1       : 'TasaIntVigente'  ; ; ; ;NO;NO;;;;Query("Select TasaIntVigente from "~DBO~".ESPECIES WHERE Codigo='"~ESPECIE~"'");Query("Select TasaIntVigente from "~DBO~".ESPECIES WHERE Codigo='"~ESPECIE~"'");
VTXT2       : 'Indice'          ; ; ; ;NO;NO;;;;Query("Select Indice from "~DBO~".ESPECIES WHERE Codigo='"~ESPECIE~"'");Query("Select Indice from "~DBO~".ESPECIES WHERE Codigo='"~ESPECIE~"'");
Precio1     : 'Valor indice'    ; ; ; ;NO;NO;;;;IF(EQSTR(VTXT1,'SI'),CotizacionC(VTXT2,,,,FECHA1,1),1);IF(EQSTR(VTXT1,'SI'),CotizacionC(VTXT2,,,,FECHA1,1),1);
Precio2     : 'Calculo parcial Val Tec';;; ;NO;NO;;;;(1+(VPRE1*CANTIDAD3/365))*VALORTEORICO2(ESPECIE,FECHA1)*PRECIO1;(1+(VPRE1*CANTIDAD3/365))*VALORTEORICO2(ESPECIE,FECHA1)*PRECIO1;


VCAN1       : 'Numerador S.Disp';1;3;2;NO;NO;;;;;BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU'))
VCAN3       : 'Retiros no Ej.'  ;1;1;2;NO;NO;;;;;Query("SELECT SUM(Cantidad) FROM "~DBO~".MOVPENDIENTES WHERE Cantidad<0 AND Cliente='"~CLIENTE1~"' AND Especie='"~ESPECIE~"' AND Cuenta='"~CUENTA2~"' AND Mercado = '"~MERCADO1~"' AND EnteCustodia = '"~VEHICULO1~"' AND "~IF(NoVacio(CUPON1),"Cupon = '"~CUPON1~"' AND","")~" NrSaldo = "~FStr(VCAN1,3,0)~" ");;;;;'###,###,###,###.####'
VCAN7       : 'Saldo Confirm'   ; ; ;2;NO;NO;;;;;SaldoC(CLIENTE1,ESPECIE,,,,MERCADO1,VEHICULO1,CUENTA2,VCAN1,FECHA1);;;;;'###,###,###,###.####'
VCAN2       : 'Saldo Total'     ; ; ;2;NO;NO;;;;;VCAN7+VCAN3;;;;;'###,###,###,###.####'
VCAN8       : 'Saldo Conf.Hoy'  ; ; ;2;NO;NO;;;;;SaldoC(CLIENTE1,ESPECIE,,,,MERCADO1,VEHICULO1,CUENTA2,VCAN1,FSys);;;;;'###,###,###,###.####'
VCAN11      : 'Saldo Tot. Hoy'  ; ; ;2;NO;NO;;;;;VCAN8+VCAN3;;;;;'###,###,###,###.####'
VCAN5       : 'Saldo EMISION'   ; ; ;2;NO;NO;;;;;SaldoC(VEHICULO1,ESPECIE,,,,MERCADO1,VEHICULO1,,10,FECHA1);;;;;'###,###,###,###.####'
VCAN6       : 'VTeorico '       ;1;1;1;NO;NO;;;;VALORTEORICO2(ESPECIE,FECHA1);VALORTEORICO2(ESPECIE,FECHA1)*PRECIO1;

