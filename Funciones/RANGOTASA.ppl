VPRE11      : 'Tasa min. Tolerancia' ;16;1;2;NO;SI;;;;IF(VCB1=1,IF(VCB3=1,VAR('TASAREFACT'),VAR('TASAREFPAS'))*(1-VAR('RTASA3')/100),VAR('RTASA1'));IF(VCB1=1,IF(VCB3=1,VAR('TASAREFACT'),VAR('TASAREFPAS'))*(1-VAR('RTASA3')/100),VAR('RTASA1'))
