VCB2        : 'TipoOp Vinculada'     ;10;1;2;NO;SI;;;;IF(EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',TIPOOP),VAR('CLASEOPVIN')),1,0);IF(EqStr(BuscarCampo('TIPOSOPERACION','ClaseOperacion','Codigo',TIPOOP),VAR('CLASEOPVIN')),1,0)
