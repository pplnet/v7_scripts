      *- Si el Cliente es ....
      If EQSTR(BUSCARCAMPO('CLIENTES','CondicionIVA','Codigo',FBN['Cliente']),'MON')
         *- Monotributista
         SCN(l:val(a2), Var('IVA')*Val(s:Val(a2))/100)
      Else 
         If EQSTR(BUSCARCAMPO('CLIENTES','CondicionIVA','Codigo',FBN['Cliente']),'NOI')
            *- No Inscripto => Acrecentamiento
            * Tengo que sacar el 10,5 % por diferencia con el movimiento, porque no me daba 
            * el iva por un centavo
            ACN(b1, ROUND(Var('IVA')*Val(s:Val(a2))/100,2))
            SCN(i:val(a2), Val(b1))
            SCN(j:val(a2), Val(h:val(a2))-Val(b1))
            ***SCN(j:val(a2), VAR('RNI')*Val(s:Val(a2))/100)
         Else 
            IF EQSTR(BUSCARCAMPO('CLIENTES','Res3125','Codigo',FBN['Cliente']),'SI')
               *- Percepcion 
               * Tengo que sacar el 5 % por diferencia con el movimiento, porque no me daba 
               * el iva por un centavo
               ACN(b1, ROUND(Var('IVA')*Val(s:Val(a2))/100,2))
               SCN(i:val(a2), Val(b1))
               SCN(k:val(a2), Val(h:val(a2))-Val(b1))
               ***SCN(k:val(a2), Var('RG3337')*Val(s:Val(a2))/100)
            ELSE
               *- Consumidor Final o Inscripto
               SCN(i:val(a2), Var('IVA')*Val(s:Val(a2))/100)
            EndIf
         ENDIF
      EndIf
