  *- Controlo el Tipo (a11) de la Operacion
  IF NOT[Incluido(val(a11),'A13|A23|A14|A24|A11|A21|A12|A22|A15|A25|A16|A26|')] 
    *- NO Existe el Tipo Operacion
    ACN(o1,1)
    AbrirAscII(Dialogo.String12~Dialogo.String13, 0)
    EscribirASCII('Error en Boleto: '~Val(a12)~' - Tipo de Operacion Inexistente: '~val(a11))
    CerrarASCII
  ELSE
    *- Leo el Tipo Operacion en B11 y dejo el Estado en C11
    ACN(d11, DifDias(Val(b16),Val(b15),Val(De:4),SI))
    IF Incluido(VAL(A:11),'A13|A14|A23|A24|')
      IF Val(D11)>3 
        ACT(B11,'FXCT')
      ELSE
        ACT(B11,'FXC')
      ENDIF
      IF Incluido(VAL(A:11),'A13|A14|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A13|A14|A23|A24|')
      IF Val(D11)>3 
        ACT(B11,'FXCT')
      ELSE
        ACT(B11,'FXC')
      ENDIF
      IF Incluido(VAL(A:11),'A13|A14|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A11|A21|A12|A22|')
      IF Val(D11)>3 
        ACT(B11,'FXVT')
      ELSE
        ACT(B11,'FXV')
      ENDIF
      IF Incluido(VAL(A:11),'A11|A12|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A15|A25|')
      ACT(B11,'FXC')
      IF Incluido(VAL(A:11),'A15|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A15|A25|')
      ACT(B11,'FXC')
      IF Incluido(VAL(A:11),'A15|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
    IF Incluido(VAL(A:11),'A16|A26|')
      ACT(B11,'FXV')
      IF Incluido(VAL(A:11),'A16|')
        ACT(C11,'ACT')
      ELSE
        ACT(C11,'DES')
      ENDIF
    ENDIF
  ENDIF
