      (.'DELMPOSTR'.)
      (."INMOVPOSPE".) 


   *--- POS 10-----------------------------------------------------------
   *- FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;IF(Eqstr(MERCADO,'AC'),'CV',MERCADO);;110;
   *- -CanPosOSoc;If(Eqstr(CONTRAESPECIE,VTXT13),Precio1,Precio1*TotalAux1);;;;;'TIT';;Cupon1;;;;;;;

      ACD(pp1 ,FBN['FechaVto'])
      ACT(pp2 ,FBN['Vehiculo1'])
      ACT(pp3 ,FBN['Vehiculo1'])
  
      IF Eqstr(FBN['MERCADO'],'AC')
         ACT(pp6 ,'CV')
      else
         ACT(pp6 ,FBN['Mercado'] )
      endif

      ACN(pp8 ,110 )
  
      ACT(pp12,'' )
      ACN(pp10,0 )
      ACT(pp11,'')

      If Eqstr(FBN['TipoOp'],'TIV')
         ACN(pp13 ,-FBN['CanPosOSoc'])
         ACT(pp9 ,FBN('Especie')   )
      else  
         if NoVacio(Val(pp55))
            ACT(pp9 ,Val(pp55) )
         else
            ACT(pp9 ,FBN('Especie')   )
         endif
  
         ACN(pp13 ,FBN['CanPosOSoc'])   
      endif

      act(vc7,BuscarCampo('ESPECIES', 'Cotiza', 'Codigo',FBN['ESPECIE']) )

      If Eqstr(fbn['CONTRAESPECIE'],Val(vc7) )
         ACN(pp14 ,FBN['Precio1'])
      else
         ACN(pp14 ,FBN['Precio1']*fbn['TotalAux1'])
      endif

      ACT(pp19,'TIT')
      ACT(pp21, FBN['Cupon1']) 

      *- Elimino el mov. previamente vc5: Tabla
      ACT(vc5,'MOVPOSPEN' )
      IF EqStr(val(mp13),'AV')
         ACT(vc5,'MOVPOSEJE' )
      ENDIF
      (.'DELMPOSTR'.)
      (."INMOVPOSPE".) 

  ENDIF

Proximo





