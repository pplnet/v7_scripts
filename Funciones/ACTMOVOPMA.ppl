*- TIC TIV
*- Parametros de entrada
*- DT1: Nr.Transaccion a Actualizar los movimientos

*- mp1: Nro. Orden  
*- mp2: Fecha Movimiento 
*- mp3: Cliente 
*- mp4: Especie 
*- mp5: CallPut 
*- mp6: FechaEj 
*- mp7: PrecioEj 
*- mp8: Mercado
*- mp9: EnteCustodia 
*- mp10: Cantidad 
*- mp11: Formula 
*- mp12: Leyenda 
*- mp13: Bits 
*- mp14: NrSaldo  
*- mp15: NrGrupo
*- mp16: Concepto (NrSaldo Original)
*- mp19: Cuenta 
*- mp20: NrGrupo2
*- mp22: Nro. de Movimiento 
*- mp23: Com.Renta
*- mp25: Com.Amortizacion
*- mp27: Cupon   
*- mp50: Leyendo para ver si viene de movimientos pendientes

* TIV Operacions 
* MOVIMIENTOS

*- Datos a Recuperar de la transaccion
*- vc1: Numerador LD
ACN(vc1,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')))

*- Nr.Transaccion para Mov. y para Posiciones
ACT(mp1,val(dt1))
ACT(pp20,val(dt1))

*- vtxt6 Para Insert mov. comision de custodia
ACT(vc2,VAR('MONELOCA'))

*- vcan12 de rtp=> Saldo de Bloqueos
ACN(vc3,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALBLOQVTA'))+100)

*- Cuenta que no genera posicion
ACT(vc4,BuscarCampo('VARIABLES','Valor','Codigo','CTANOPOS') )

SQL.ADD(" SELECT FechaOp,FechaVto,Especie,ContraEspecie,Precio1,CanPosTrad,TotalAux1,Cantidad,     ")
SQL.ADD(" Mercado, Mercado2, TotalNetoCli1, Cliente1, Vehiculo1, TipoOp, Cupon1, Cuenta1,Cuenta2,  ")
SQL.ADD(" Cuenta3,Cuenta4, TotalCaucion, PaseCB, CanPosOSoc, CanPosInv2, CanPosInv1                ")
SQL.ADD(" FROM "~DBO~".OPERACIONES WHERE NrOperacion ='"~val(dt1)~"'                               ")

Recorrer SQL
   dfa

   *- Variables de la Transaccion
   *- vt9: Especie Arancelada 
   ACT(vt9,BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('Especies','Alias8','Codigo',FBN('Especie'))) )

   *- Escribe los datos en la celdas mp1 .. mp30 para Invocar a la Fc.IMMOVPEND
   *------------------------------------------------------------------------------------------------
   *---- Movimiento  
   *-- FechaVto;Cliente1;Especie      ;;;;Mercado
   *-- ;Vehiculo1;1;  Cantidad;;'Venta de '~Especie;SI;NO;1;NOVACIO(CLIENTE1)
   *-- ;;Cuenta1;;1;'TI';IF(Incluido(Mercado,'CV'),IF(FormaLiquidacion1=1,'CONF',IF(FormaLiquidacion1=2,'RVP' )),IF(FormaLiquidacion2=1,'MATCH'));Cupon1
   
   ACD(mp2,FBN('FechaVto') )
   ACT(mp3,FBN('Cliente1') )
   ACT(mp4,FBN('Especie') )
   ACT(mp5,'')
   ACT(mp6,'')
   ACT(mp7,'')
   ACT(mp8,FBN('Mercado'))
   ACT(mp9,FBN('Vehiculo1'))
    
   If Eqstr(FBN['TipoOp'],'TIV')
      ACN(mp10,FBN('Cantidad'))
   else
      ACN(mp10,-FBN('Cantidad'))
   endif

   ACT(mp11,'')
   ACT(mp12,'Venta de  '~fbn['Especie']  )

   *- Condicion de Automatico
   *- 
   ACT(mp13,'MV')

   ACT(mp17,'')
 
   *- mp14: Nr.Saldo
   ACN(mp14,1)

   *- mp15: NrGrupo 
   ACN(mp15,1)

   * mp20: NrGrupo2 nada

   *- mp16: Concepto 
   ACT(mp16,'TI' )

   *- mp19: Cuenta
   ACT(mp19,FBN('Cuenta1'))

   *- Nro.Mov.
   ACN(mp22,1)

   *- Cupon 
   ACT(mp27,FBN('Cupon1'))

   *- mp25: NrLiq = ''
   ACT(mp25,'')

   *- Elimino el mov. previamente vc5: Tabla
   ACT(vc5,'MOVPENDIENTES' )
   IF EqStr(val(mp13),'AV')
      ACT(vc5,'MOVEJECUTADOS' )
   ENDIF
      
   (.'DELMOVTR'.)
   (.'IMMOVPEND'.)      

   *------------------------------------------------------------------------------------------------
   
   IF FBN['PaseCB']=0 o FBN['TotalCaucion'] = 0 

      ACD(mp2,FBN('FechaVto')) 
      ACT(mp3,FBN('Cliente1'))
      ACT(mp4,FBN('ContraEspecie') )

      ACT(mp5,'')
      ACT(mp6,'')
      ACT(mp7,'')
      ACT(mp8,'')

      IF NoVacio(FBN['Mercado2'])
         ACT(mp8,FBN('Mercado2'))
      else
      IF Incluido(fbn['Mercado'],VAR('MERCAACMC'))
            ACT(mp8,FBN('Mercado'))
         endif 
      endif


      ACT(mp9,FBN('Vehiculo1'))

      If Eqstr(FBN['TipoOp'],'TIV')
         ACN(mp10,-FBN('TotalNetoCli1'))
      else
         ACN(mp10,FBN('TotalNetoCli1'))
      endif

      ACT(mp11,'')
      ACT(mp12,'Venta de '~FBN('Especie') )

      *- Condicion de Automatico
      *- 
      ACT(mp13,'MV')
      ACT(mp17,'')


      *- mp14: Nr.Saldo
      ACN(mp14,1 )

      *- mp15: nro Grupo
      ACN(mp15,2 )

      *- mp16: Concepto 
      ACT(mp16,'TI' )

      *- mp19: Cuenta
      ACT(mp19,FBN('Cuenta4'))

      *- mp20: NrGrupo2 nada

      *- Nro.Mov.
      ACN(mp22,2)

      *- mp27 Cupon nada 
      ACT(mp27,'')

      *- mp25: NrLiq = ''
      ACT(mp25,'')

      *- Elimino el mov. previamente vc5: Tabla
      ACT(vc5,'MOVPENDIENTES' )
      IF EqStr(val(mp13),'AV')
         ACT(vc5,'MOVEJECUTADOS' )
      ENDIF
      
      (.'DELMOVTR'.)
      (.'IMMOVPEND'.)      

   EndIf

   *-------- P O S I C I O N E S
   ACT(mp13,'MV')

   IF FBN('FechaOp')<=Fsys 
      ACT(mp13,'AV')
   EndIf
   act(pp55,'')
   act(pp55,BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',fbn['Especie'])) )

   *- mp13: Pendiente-Ejecutado
   *- pp1 : FechaMov 
   *- pp2: Cliente  
   *- pp3: Vehiculo 
   *- pp4: Unidad 
   *- pp5: Centro 
   *- pp6: Sector
   *- pp7: Sucursal 
   *- pp8: NrSaldo 
   *- pp9: Especie 
   *- pp10: PrecioEj  
   *- pp11: FechaEj 
   *- pp12: CallPut
   *- pp13: Cantidad 
   *- pp14: Precio 
   *- pp15: Estrategia 
   *- pp16: Cartera 
   *- pp17: Book 
   *- pp18: Trader,
   *- pp19: TipoNegocio 
   *- pp20: NrOperacion 
   *- pp21: Cupon 
   *- pp22: Tipo 
   *- pp23: Responsable 
   *- pp24: TipoPosicion,
   *- pp25: Producto 
   *- pp26: GrupoEspecie 
   *- pp27: CarteraBCRA



   *- POS 1 ---------------------------------------------------------
   *- FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;IF(Eqstr(MERCADO,'AC'),'CV',MERCADO);;103;-CanPosTrad;If(Eqstr(CONTRAESPECIE,VTXT13),Precio1,Precio1*TotalAux1);;;;;'TIT';;Cupon1;
    
   IF FBN['CanPosTrad'] <> 0
      ACD(pp1 ,FBN['FechaOp'])
      ACT(pp2 ,FBN['Vehiculo1'])
      ACT(pp3 ,FBN['Vehiculo1'])
    
      IF Eqstr(FBN['MERCADO'],'AC')
         ACT(pp6 ,'CV')
      else
         ACT(pp6 ,FBN['Mercado'] )
      endif
 
      ACN(pp8 ,103 )
   
      ACT(pp12,'' )
      ACN(pp10,0 )
      ACT(pp11,'')

      If Eqstr(FBN['TipoOp'],'TIV')
        ACN(pp13 ,-FBN['CanPosTrad'])
        ACT(pp9 ,FBN('Especie')   )
      else
         if NoVacio(Val(pp55))
            ACT(pp9 ,Val(pp55) )
         else
            ACT(pp9 ,FBN('Especie')   )
         endif
     
         ACN(pp13 ,FBN['CanPosTrad'])
      endif
  
      act(vc7,BuscarCampo('ESPECIES', 'Cotiza', 'Codigo',FBN['ESPECIE']) )
 
      If Eqstr(fbn['CONTRAESPECIE'],Val(vc7) )
         ACN(pp14 ,FBN['Precio1'])
      else
         ACN(pp14 ,FBN['Precio1']*fbn['TotalAux1'])
      endif

      ACT(pp19,'TIT')
      ACT(pp21, FBN['Cupon1']) 
   
      *- Elimino el mov. previamente vc5: Tabla
      ACT(vc5,'MOVPOSPEN' )
      IF EqStr(val(mp13),'AV')
         ACT(vc5,'MOVPOSEJE' )
      ENDIF
      (.'DELMPOSTR'.)
      (."INMOVPOSPE".) 



