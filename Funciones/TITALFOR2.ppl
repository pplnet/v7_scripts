*SetFilaActual(2)
ACT(a:fac, 'CAJA DE VALORES S.A.')
ACT(a:fac+1, 'SARMIENTO 299-Capital Federal')
AlinearCeldas(a:fac..a:fac+1,'C')
SetFont(a:fac..a:fac+1,2)

ACT(b:fac, 'REGISTRO DE COMITENTES')
ACT(b:fac+1, 'MODIFICACION DE DATOS')
ACT(b:fac+2, 'PERSONALES DE CONDOMINOS')
AlinearCeldas(b:fac..b:fac+2,'C')
*SetFont(b:fac..b:fac,4)
SetFont(b:fac..b:fac+2,5)

ACT(c:fac-1, 'FECHA:  ')
ACT(c:fac, Dialogo.Fecha1)
ACT(c:fac+1, 'HOJA '~FStr(val(ay1),0,0))
ACT(c:fac+2, 'DE ')
AlinearCeldas(c:fac-1..c:fac+2,'C')

SetFont(c:fac-1..c:fac+2,2)
AgregarMarco(a:fac-1..d:fac+2,2,0)
AgregarMarco(b:fac-1..b:fac+2,2,0)
AgregarMarco(c:fac-1..d:fac+2,2,0)
AgregarMarco(c:fac-1..c:fac-1,2,0)
AgregarMarco(c:fac..c:fac,2,0)
AgregarMarco(c:fac+1..c:fac+1,2,0)
AgregarMarco(c:fac+2..c:fac+2,2,0)

SetFilaActual(fac+3)

ACT(a:fac, 'DEPOSITANTE')
ACT(a:fac+1,'CODIGO                 '~BuscarCampo('CLIENTES', 'CodDepCajaValores', 'Codigo', Dialogo.Vehiculo1)~'/1')
ACT(a:fac+2,'DENOMINACION     '~BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', Dialogo.Vehiculo1))

ACT(c:fac, 'COMITENTE')
ACT(c:fac+1, 'NUMERO  '~Dialogo.String1 )
ACT(b:fac+3, 'NOTA: INGRESAR SOLO EL CAMPO A MODIFICAR')

*Guardo la ultima fila del Titulo
ACN(f9,Val(d:fac+3))

AlinearCeldas(a:fac..c:fac,'C')
AlinearCeldas(a:fac+1..c:fac+2,'I')
SetFont(a:fac..d:fac+3,2)
SetFont(a:fac+1..c:fac+2,1)
AgregarMarco(a:fac..d:fac+2,2,0)
AgregarMarco(c:fac..d:fac+2,2,0)
AgregarMarco(a:fac+3..d:fac+3,2,0)

ACN(az4,val(az3))
ACN(az3,0)

SetFilaActual(fac+4)
ACN(f1,fac)
(.'FORPM2'.)
AgregarMarco(a:fac..d:fac,2,0)
BorrarCeldas(z1..z30)

SetFilaActual(fac+1)
ACN(f2,fac)
(.'FORPM2'.)
AgregarMarco(a:fac..d:fac,2,0)
BorrarCeldas(z1..z30)

SetFilaActual(fac+1)
ACN(f3,fac)
(.'FORPM2'.) 
BorrarCeldas(z1..z30)
SetFilaActual(fac+1)

ACN(az3,val(az4))

AgregarMarco(a:fac..d:fac,2,0)
ACT(a:fac, '  * La confeccion del presente se ajusta a las leyes 20643, 23299, y a los Decretos Reglamentarios  659/74, 2220/80 y 83/86')
ACT(a:fac+1,'GRABO                              VERIFICO')  
ACT(b:fac+1,'CONTROLO')
ACT(c:fac+1,'FIRMA Y SELLO DEL DEPOSITANTE')
*ACT(a:fac+1,val(z2))
AlinearCeldas(a:fac..b:fac+1,'I')
AlinearCeldas(c:fac+1..c:fac+1,'I')
AlinearCeldas(b:fac+1..b:fac+1,'C')
SetFont(a:fac..b:fac+1,1)
SetFont(a:fac+1..c:fac+1,2)
AgregarMarco(a:fac..d:fac+1,2,0)
AgregarMarco(a:fac..d:fac+5,2,0)
AgregarMarco(c:fac+1..d:fac+5,2,0)
ACN(f5,fac+7)