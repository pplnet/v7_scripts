SQL.ADD(" SELECT DISTINCT  M.NrGrupo2, T.NrTrans NrOperacion, T.TipoTr2, T.Especie,   ")
SQL.ADD(" M.Cliente, E.Cotiza, T.Vehiculo1, T.Fecha1, T.Cupon1, T.Precio1, T.Precio2, ")
SQL.ADD(" T.Especie2, T.Precio3, M.Mercado, M.Cuenta, E.CodNumCajaValores, M.CallPut, ")
SQL.ADD(" C.NrCuenta, M.Leyenda, M.NrSaldo, E.Cotiza ContraEspecie, M.NrTrans2, C.TipoCliente, C.CondicionIVA, C.Res3125 ")
SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE T.Especie  = E.Codigo   ")
SQL.ADD(" AND   T.Especie  = '"~fbn('Especie')~"'  ")
SQL.ADD(" AND   T.Especie2 = M.Especie  ")
SQL.ADD(" AND   M.Cliente  = C.Codigo   ")
SQL.ADD(" AND   M.Cliente  = '"~VAR('VEHICULODE')~"'   ")
SQL.ADD(" AND   M.FechaEje = "~Idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   T.Fecha1  >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" AND   T.NrTrans  = M.NrOperacion  ")
SQL.ADD(" AND   T.TipoTr2  = 'CUPON'        ")
SQL.ADD(" AND   M.Leyenda NOT LIKE '%MovPend%'   ")
SQL.ADD(" UNION ")
SQL.ADD(" SELECT DISTINCT  M.NrGrupo2, T.NrTrans NrOperacion, T.TipoTr2, T.Especie,   ")
SQL.ADD(" M.Cliente, E.Cotiza, T.Vehiculo1, T.Fecha1, T.Cupon1, T.Precio1, T.Precio2, ")
SQL.ADD(" T.Especie2, T.Precio3, M.Mercado, M.Cuenta, E.CodNumCajaValores, M.CallPut, ")
SQL.ADD(" C.NrCuenta, M.Leyenda, M.NrSaldo, E.Cotiza ContraEspecie, M.NrTrans2, C.TipoCliente, C.CondicionIVA, C.Res3125 ")
SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE T.Especie  = E.Codigo   ")
SQL.ADD(" AND   T.Especie  = '"~fbn('Especie')~"'  ")
SQL.ADD(" AND   T.Especie2 = M.Especie  ")
SQL.ADD(" AND   M.Cliente  = C.Codigo   ")
SQL.ADD(" AND   M.Cliente  = '"~VAR('VEHICULODE')~"'   ")
SQL.ADD(" AND   M.FechaEje = "~Idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   T.Fecha1  >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
SQL.ADD(" AND   T.NrTrans  = M.NrOperacion  ")
SQL.ADD(" AND   T.TipoTr2  = 'CUPON'        ")
SQL.ADD(" AND   M.Leyenda NOT LIKE '%MovPend%'   ")
Recorrer SQL
  DFA
  * Saldo Cortado
  ACN(sa:1, fbn('NrGrupo2'))
  If Eqstr(fbn('Cliente'), VAR('VEHICULODE')) y Not Buscar('MovPend', fbn('Leyenda'))
     * Le resto al saldo del vehiculo los mov de los calls
     SQL.ADD(" SELECT SUM(M.NrGrupo2) CANTIDAD FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
     SQL.ADD(" WHERE T.Especie2 = M.Especie ")
     SQL.ADD(" AND   T.Especie  = '"~fbn('Especie')~"' ")
     SQL.ADD(" AND   T.Cupon1   = '"~fbn('Cupon1')~"'  ")
     SQL.ADD(" AND   M.FechaEje = "~Idxdate2(Dialogo.Fecha1)~" ")
     SQL.ADD(" AND   T.Fecha1  >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
     SQL.ADD(" AND   T.NrTrans  = M.NrOperacion  ")
     SQL.ADD(" AND   T.TipoTr2  = 'CUPON'        ")
     SQL.ADD(" AND   M.Cliente <> '"~VAR('VEHICULODE')~"' ")
     SQL.ADD(" AND   M.CallPut = 'PRE' ")
     SQL.ADD(" UNION ")
     SQL.ADD(" SELECT SUM(M.NrGrupo2) CANTIDAD FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T ")
     SQL.ADD(" WHERE T.Especie2 = M.Especie ")
     SQL.ADD(" AND   T.Especie  = '"~fbn('Especie')~"' ")
     SQL.ADD(" AND   T.Cupon1   = '"~fbn('Cupon1')~"'  ")
     SQL.ADD(" AND   M.FechaEje = "~Idxdate2(Dialogo.Fecha1)~" ")
     SQL.ADD(" AND   T.Fecha1  >= "~IdxDate2(Habiles(fsys,-Var('CONTVALOR'),'ARG'))~" ")
     SQL.ADD(" AND   T.NrTrans  = M.NrOperacion  ")
     SQL.ADD(" AND   T.TipoTr2  = 'CUPON'        ")
     SQL.ADD(" AND   M.Cliente <> '"~VAR('VEHICULODE')~"' ")
     SQL.ADD(" AND   M.CallPut = 'PRE' ")
     Recorrer SQL
       dfa
       ACN(sa:1, Val(sa:1)-fbn('Cantidad'))
     Proximo
  Endif
  * AMORTIZACION
  ACN(am:1, Val(sa:1)*FBN('Precio1')/100 )
  SCN(am:1, Val(sa:1)*FBN('Precio3')/100 )
Proximo
