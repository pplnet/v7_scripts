BITS
** FJL 19/07/21 - Modificacion logica Workflow
*1 ;0;FW=1 o FW=2
*2 ;1;FW=1 y [Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'RANGOTAS1' ") = 1]
*3 ;1;FW=1 y  Incluido(TIPOOP,'TICO|TIPO') y Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo Not in ('RANGOTAS1', 'FVALOR') ") = 1
*8 ;1;FW=1 y Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ") = 1
*7 ;1;FW=1 Y Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ") <> 1 Y [[Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo Not in ('RANGOTAS1', 'FVALOR') ")=0 y Incluido(TIPOOP,'TICO|TIPO')] o Not Incluido(TIPOOP,'TICO|TIPO')]
*30;1;FW=2
