** FJL 19/07/21 - Modificacion logica Workflow
VCAN21: 'Excep.F.Valor'; 8;2;1;NO;NO;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ")
VCAN22: 'Excep.Tasa'   ; 9;2;1;NO;NO;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'RANGOTAS1' ")
VCAN23: 'Excep.Lim'    ;10;2;1;NO;NO;;;;;Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And (Tipo Like '%NOAS' or Tipo Like '%VENC' or Tipo Like '%CANC' or Tipo Like '%EXCE')")
VCAN24: 'a Inst Contr' ;11;2;1;NO;NO;;;;;0
VTXT23: 'Excep.Lim'    ;12;2;1;NO;NO;;;;;if(VCAN23>0,Pipe2Comillas(SQLSet("SELECT Tipo FROM "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' And (Tipo Like '%NOAS' or Tipo Like '%VENC' or Tipo Like '%CANC' or Tipo Like '%EXCE') ")),'')
VTXT24: 'Excep.Lim'    ;13;2;1;NO;NO;;;;;if(VCAN23>0,Copy(VTXT23,2,Longitud(VTXT23)-2),'')

