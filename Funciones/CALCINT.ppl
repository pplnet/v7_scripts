* calcular Tasa (%) de interes de una especie para una fecha determinada
   
********************************
* Variables                    *
* x95 - Dif. de dias
* x96 - Especie                *  
* X97 - Fecha de Liquidacion   *
* X98 - Tasa Base              *
* X99 - Tasa                   *
********************************
   

ACN(ae1, UltCupon(Val(x96),Val(x97)))
ACN(ae2,BuscarCampo('ESPECIES','FechaCambioTasa','Codigo',Val(x96)))
ACN(ae3,BuscarCampo('ESPECIES','TasaIntAnterior','Codigo',Val(x96)))
ACN(ae4,BuscarCampo('ESPECIES','TasaIntVigente','Codigo',Val(x96)))

if Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',Val(x96)),'CLE')

  * obtengo tasa base
  if Val(ae2) <= Val(ae1)
    ACN(x98, Val(ae4))
  else
    ACN(x98, Val(ae3))
  endif

  * obtengo diferencia de dias (x95,x3)
  ACN(x95,0)
  if EspecieDiasAnio(Val(x96))=0 y EspecieDiasMes(Val(x96))=0
    ACN(x95, Dif360(Val(ae1), Val(x97),2))
  else
    ACN(x95, DifDias(Val(ae1), Val(x97),'USA',NO))
  endif
  * obtengo tasa interes cupon para la formula (xx1)
  ACN(xx1,0)
  if Val(ae2) > Val(ae1) y Val(ae2) <= Val(x97)
    ACN(ww1, Val(ae3))
    if EspecieDiasAnio(Val(x96))=0 y EspecieDiasMes(Val(x96))=0
      ACN(ww1, Val(ww1)* Dif360(Val(ae1),Val(ae2)-1,2)) 
    else
      ACN(ww1, Val(ww1)* DifDias(Val(ae1),Val(ae2)-1,'USA',NO))
    endif
    ACN(zz1 ,Val(ae4))
    if EspecieDiasAnio(Val(x96))=0 y EspecieDiasMes(Val(x96))=0
      ACN(zz1, Val(zz1)* Dif360(Val(ae2)-1, Val(x97) ,2)) 
    else
      ACN(zz1, Val(zz1)* DifDias(Val(ae2)-1, Val(x97), 'USA', NO))
    endif
    ACN(xx1, Val(ww1)+Val(zz1))
    if EspecieDiasAnio(Val(x96))=0 y EspecieDiasMes(Val(x96))=0
      ACN(xx1, Val(xx1) / Dif360(Val(ae1),Val(x97),2))
    else
      ACN(xx1, Val(xx1) / DifDias(Val(ae1),Val(x97),'USA',NO))
    endif
  else
    if Val(ae2) <= Val(ae1)
      ACN(xx1, Val(ae4))
    endif
    if Val(ae2) > Val(x97)
      ACN(xx1, Val(ae3))
    endif
  endif
  ACN(x99,Val(xx1))
else
  ACN(x99,0)
endif
