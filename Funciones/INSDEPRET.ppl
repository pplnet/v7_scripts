       SQL.ADD("INSERT INTO "~DBO~".TRANSACCIONES2 ")
       SQL.ADD("(TipoTr2, NrTrans, Vehiculo1, Cliente1, Especie, ")
       SQL.ADD(" Cuenta1, Cuenta2, Fecha1, Fecha2, ")
       SQL.ADD(" Cantidad1, Ley1, Ley2, CB1, CB2, ")
       SQL.ADD(" RB1, Fecha4, Fecha3, Cuenta3, Cantidad3, ")
       SQL.ADD(" Cuenta4,Cantidad4,Cuenta5,Cantidad5,Cupon1,Mercado1,RB4, ")
       SQL.ADD(" Cantidad6, Precio2, Cantidad7, Precio3, Cantidad8, Precio4, ")
       SQL.ADD(" Observaciones, Ley5 ")
       * --- DATOS PARA LAVADO 20/04/2005 --- *
       SQL.ADD(" , Sector1, Cliente3, Cliente4, ")
       SQL.ADD("  Cliente5, Ley3, Ley4 ")
       * ------------------------------------ *
       SQL.ADD(" ) Values ( ")
       SQL.ADD(" '"~Val(l:&i)~"', '"~Val(q:&i)~"', '"~Val(a:&i)~"', '"~Val(b:&i)~"', '"~Val(d:&i)~"', ")
       SQL.ADD(" '"~Val(v:&i)~"', ") 
       SQL.ADD(" '"~Val(j:&i)~"', ") 
       SQL.ADD(" '"~IdxDate(Val(ak:&i))~"', '"~IdxDate(Fsys)~"', ")
       SQL.ADD(" "~FStr(Abs(Val(f:&i)),0,2)~", '"~iIf(val(r:&i)>1,'NETO','')~"', '"~Val(u:&i)~"', ")           
       * Marca de Automatica 
       If [Val(aa:&i)=1 o Val(c:&i)=1] y [Not Eqstr(Val(l:&i),'COMP')]             
           SQL.ADD(" '1' , ")  
       Else
           SQL.ADD(" '0' , ")  
       EndIf
       * Marca de Prestamos 
       If Val(c:&i) = 1
          SQL.ADD(" '1' ,")  
       Else
          SQL.ADD(" '0' ,")  
       EndIf
       *- Tipo de Transferencias y Fechas de Matching y Ejecucion
       If Val(s:&i)>0
          *- Indica Tipo de Transferencia 
          SQL.ADD(" "~IIf(Val(s:&i)=1,'2',IIf(Val(s:&i)=2,'1','0'))~",")
       Else 
          SQL.ADD(" '-1',")
       EndIf
       If Val(w:&i)<>0
          SQL.ADD(" '"~IdxDate(Val(w:&i))~"',")
       Else 
          SQL.ADD(" Null,")
       EndIf
       If Val(x:&i)<>0
          SQL.ADD(" '"~IdxDate(Val(x:&i))~"', ")
       Else 
          SQL.ADD(" Null, ")
       EndIf
       SQL.ADD(" '"~Val(ca:&i)~"', "~FStr(ABS(Val(cc:&i)),0,2)~", ")
       SQL.ADD(" '"~Val(cd:&i)~"', "~FStr(ABS(Val(ce:&i)),0,2)~", ")
       SQL.ADD(" '"~Val(cf:&i)~"', "~FStr(ABS(Val(cg:&i)),0,2)~", ")
       IF NoVacio(Val(cp:&i))
          SQL.ADD(" '"~FStr(Val(cp:&i),0,0)~"', ")
       ELSE
          SQL.ADD(" NULL, ")
       ENDIF
       SQL.ADD(" '"~Val(am:&i)~"', '"~FSTR(Val(dr:&i),0,0)~"', ")
       SQL.ADD(" "~FStr(ABS(Val(ck:&i)),0,2)~", "~FStr(ABS(Val(cl:&i)),0,2)~", ")
       SQL.ADD(" "~FStr(ABS(Val(cm:&i)),0,2)~", "~FStr(ABS(Val(cn:&i)),0,2)~", ")
       SQL.ADD(" "~FStr(ABS(Val(co:&i)),0,2)~", "~FStr(ABS(Val(cp:&i)),0,2)~", ")
       ***---En observaciones se guarda lista de operaciones para contraasientos
       SQL.ADD(" '"~Copy(Val(I:&i), 1, 255)~"', '"~Val(he:&i)~"'  ")

       * --- DATOS PARA LAVADO 20/04/2005 --- *
       SQL.ADD(" , '"~Val(bh:&i)~"', '"~Val(bi:&i)~"', '"~Val(bj:&i)~"', ")
       SQL.ADD(" '"~Val(bk:&i)~"', '"~Val(bl:&i)~"', '"~Val(bm:&i)~"' ")
       * ------------------------------------ *
       SQL.ADD(" ) ")
       SQL.NEW
       SQL.EXEC

       *SQL.ActualizarMovimientosT2(Val(q:&i),SI,NO,NO,NO)
       *SQL.EXEC 

       *- Alta en la Instancia nro.1,3,6,11,12,70
       ACT(li1,'1|3|6|8|11|12|70|')

       Recorrer&j 1,Elementos(val(li1))
         ACN(az5,Num(ItemLista(val(li1),&j)))
         SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ")
         SQL.ADD("(NrOperacion,NrBit,Valor) ")
         SQL.ADD(" Values ")
         SQL.ADD("('"~Val(q:&i)~"',"~Fstr(val(az5),3,0)~",")
         IF Val(az5)=12
            SQL.ADD("'1')")
         ELSE
            SQL.ADD("'0')")
         ENDIF
         SQL.NEW
         SQL.EXEC
       Proximo
