      * ACD(pp1 ,IIf(NoVacio(FBN('Fecha3')),FBN('Fecha3'),FBN('Fecha1')))
      ACD(pp1 ,FBN('Fecha5'))
      ACT(pp2 ,FBN['Cliente2'])
      ACT(pp3 ,FBN['Vehiculo1'] )
      ACT(pp6 ,FBN['Mercado2'] )
      ACN(pp8 ,FBN['RB4']+5+102 )
      ACT(pp9 ,FBN('Especie') )
      ACT(pp12,'' )
      ACN(pp10,0 )
      ACT(pp11,'')
      ACN(pp13 ,-FBN['Cantidad1'])

      If EqStr(FBN['TipoTr2'],'RTP')
         ACN(pp13 ,-val(pp13))
      EndIf

      ACN(pp14 ,FBN['Precio1'])
      ACT(pp19,'TIT')
      ACT(pp21, FBN['Cupon2']) 
      *- Elimino el mov. previamente vc5: Tabla
      ACT(vc5,'MOVPOSPEN' )
      IF EqStr(val(mp13),'AV')
         ACT(vc5,'MOVPOSEJE' )
      ENDIF
      (.'DELMPOSTR'.)

      (."INMOVPOSPE".) 
      *--------------------------------------------------------------
      ACD(pp1 ,FBN['Fecha1'])
      ACT(pp2 ,FBN['Cliente2'])
      ACT(pp3 ,FBN['Vehiculo1'] )
      ACT(pp6 ,FBN['Mercado2'] )
      ACN(pp8 ,101 )
      ACT(pp9 ,FBN('Especie') )
      ACT(pp12,'' )
      ACN(pp10,0 )
      ACT(pp11,'')
      ACN(pp13 ,-FBN['Cantidad1'])
      If EqStr(FBN['TipoTr2'],'RTP')
         ACN(pp13 ,-val(pp13))
      EndIf

      ACN(pp14 ,FBN['Precio1'])
      ACT(pp19,'TIT')
      ACT(pp21, FBN['Cupon1']) 

      *- Elimino el mov. previamente vc5: Tabla
      ACT(vc5,'MOVPOSPEN' )
      IF EqStr(val(mp13),'AV')
         ACT(vc5,'MOVPOSEJE' )
      ENDIF
      (.'DELMPOSTR'.)

      (."INMOVPOSPE".) 
      *--------------------------------------------------------------
      *--ACD(pp1 ,IIf(NoVacio(FBN('Fecha3')),FBN('Fecha3'),FBN('Fecha1')))
      ACD(pp1 ,FBN('Fecha5'))
      ACT(pp2 ,FBN['Cliente2'])
      ACT(pp3 ,FBN['Vehiculo1'] )
      ACT(pp6 ,FBN['Mercado2'] )
      ACN(pp8 ,102 )
      ACT(pp9 ,FBN('Especie') )
      ACT(pp12,'' )
      ACN(pp10,0 )
      ACT(pp11,'')
      ACN(pp13 ,-FBN['Cantidad1'])

      If EqStr(FBN['TipoTr2'],'RTP')
         ACN(pp13 ,-val(pp13))
      EndIf

      ACN(pp14 ,FBN['Precio1'])
      ACT(pp19,'TIT')
      ACT(pp21, FBN['Cupon2']) 
      *- Elimino el mov. previamente vc5: Tabla
      ACT(vc5,'MOVPOSPEN' )
      IF EqStr(val(mp13),'AV')
         ACT(vc5,'MOVPOSEJE' )
      ENDIF
      (.'DELMPOSTR'.)

      (."INMOVPOSPE".) 
   EndIf
