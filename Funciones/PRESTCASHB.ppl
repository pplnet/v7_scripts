Message('Prestamos CashFlow B ')
SCN(f:200,2)
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp, 'Vto' as Tipo,")
SQL.ADD(" CASE TipoOp WHEN 'MMPOSM' THEN C.Cantidad1 ELSE C.Cantidad4 END/1000 Cant, CASE TipoOp WHEN 'MMPOSM' THEN C.Cantidad3 ELSE C.Cantidad5 END/1000 Int, ")
SQL.ADD(" CASE TipoOp WHEN 'MMPOSM' THEN C.Total3-C.Cantidad3 ELSE C.Cantidad5-C.Cantidad3 END/1000 Imp,  ")
SQL.ADD(" C.Cantidad1/1000 ImpAm,")
SQL.ADD(" C.Precio2,C.NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
**--- Capital si FechaInicio<>FechaConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
SQL.ADD("CASE TipoOp WHEN 'MMPOSM' THEN O.Cantidad ELSE 0 END/1000 Cant, 0 Int, CASE TipoOp WHEN 'MMPOSM' THEN O.TotalComisiones ELSE 0 END/1000 Imp,0 ImpAm, ")
SQL.ADD("1 Precio2,C.NrCuota ")
SQL.ADD("from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Union All ")
**--
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo,")
SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp ,PrecioEj/1000 ImpAm,")
SQL.ADD(" 1 Precio2,0 NrCuota")
SQL.ADD("from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
*-- Capital si FechaInicio<>FechaConcertacion
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo,")
SQL.ADD("CASE TipoOp WHEN 'MMPCOS' THEN O.Cantidad ELSE 0 END/1000 Cant, 0 Int, CASE TipoOp WHEN 'MMPCOS' THEN O.TotalComisiones ELSE 0 END/1000 Imp ,0 ImpAm,")
SQL.ADD("1 Precio2,0 NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp  >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp  <> O.FechaOp2 ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
*--
SQL.ADD(" Union All ")
* Listo los SIMV que no son definitivos por el capital no amoritzado para la fecha de
* de Vto Final
SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' Tipo, ")
SQL.ADD(" (O.Cantidad-SUM(C.Cantidad4))/1000 Cant, 0 Int, 0 Imp,C.Cantidad1/1000 ImpAm, ")
SQL.ADD(" 1 Precio2,0 NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMSIMV') ")
SQL.ADD(" and  O.RB5='1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" Group By O.Vehiculo1, O.Especie, O.FechaVto, O.NrOperacion, O.TipoOp,O.Cantidad,C.Cantidad1,O.RB8,O.TipoTasa ")
SQL.ADD(" Union All ")
*-- Capital si FechaInicio<>FechaConcertacion
SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' Tipo, ")
SQL.ADD(" 0 Cant, 0 Int, 0 Imp, 0 ImpAm, ")
SQL.ADD(" 1 Precio2,0 NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaOp <> O.FechaOp2 ")
SQL.ADD(" and  C.Fecha2  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMSIMV') ")
SQL.ADD(" and  O.RB5='1' ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
*-----
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha2 Fecha, O.NrOperacion, O.TipoOp,'Vto' Tipo, ")
   SQL.ADD(" CASE TipoOp WHEN 'MMPOSM' THEN C.Cantidad1 ELSE C.Cantidad4 END/1000 Cant, CASE TipoOp WHEN 'MMPOSM' THEN C.Cantidad3 ELSE C.Cantidad5 END/1000 Int, ")
   SQL.ADD(" CASE TipoOp WHEN 'MMPOSM' THEN C.Total3-C.Cantidad3 ELSE C.Cantidad5-C.Cantidad3 END/1000 Imp,  ")
   SQL.ADD("C.Cantidad1/1000 ImpAm,")
   SQL.ADD("C.Precio2,C.NrCuota ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha2   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *--- Capital si FInicio<>FConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select DISTINCT O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("CASE TipoOp WHEN 'MMPOSM' THEN O.Cantidad ESLE 0 END/1000 Cant, 0 Int, CASE TipoOp WHEN 'MMPOSM' THEN O.TotalComisiones ELSE 0 END/1000 Imp,0 ImpAm, ")
   SQL.ADD(" 1 Precio2,0 NrCuota ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp>='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp<>O.FechaOp2 ")
   SQL.ADD(" and  C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPOSM','MMSIMV') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *---
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaVto Fecha, O.NrOperacion, O.TipoOp,'Vto' as Tipo, ")
   SQL.ADD("O.Cantidad/1000 Cant, O.TotalIntereses/1000 Int, (O.TotalNetoCli2-O.TotalIntereses)/1000 Imp ,PrecioEj ImpAm,")
   SQL.ADD("Precio1 Precio2,0 NrCuota ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
   *--- Capital si FInicio<>FConcertacion
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp Fecha, O.NrOperacion, O.TipoOp,'Cap' as Tipo, ")
   SQL.ADD("CASE TipoOp WHEN 'MMPCOS' THEN O.Cantidad ELSE 0 END/1000 Cant, 0 Int, CASE TipoOp WHEN 'MMPCOS' THEN O.TotalComisiones ELSE 0 END/1000 Imp ,0 ImpAm,")
   SQL.ADD("1 Precio2,0 NrCuota ")
   SQL.ADD("from "~DBO~".OPSEVENTUALES  O ")
   SQL.ADD("where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.FechaOp2 <> O.FechaOp2 ")
   SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  O.TipoOp In ('MMPCOS','MMPSI') ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
*-- Comisiones 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
SQL.ADD("0 Cant, 0 Int, C.Importe4/1000 Imp,0 ImpAm,")
SQL.ADD("Tasa1 Precio2,0 NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".COMISIONES2 C ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  ( ")
SQL.ADD(" (O.TipoOp In ('MMPOSM','MMSIMV','MMPCOS','MMPSI')) or ")
SQL.ADD(" (O.TipoOp In ('MMSIMV') and O.RB5='1') ") 
SQL.ADD(" ) ")
If Dialogo.Radio1 = 1
   SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
If Dialogo.Radio3 = 1
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.Vehiculo1, O.Especie, C.Fecha1 Fecha, O.NrOperacion, O.TipoOp,'Com' as Tipo, ")
   SQL.ADD("0 Cant, 0 Int, C.Importe4/1000 Imp,0 ImpAm,")
   SQL.ADD(" Tasa1 Precio2,0 NrCuota ")
   SQL.ADD(" from "~DBO~".OPSEVENTUALES  O, "~DBO~".COMISIONES2 C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD(" and  O.FechaOp2  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  C.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and  ( ")
   SQL.ADD(" (O.TipoOp In ('MMPOSM','MMSIMV','MMPCOS','MMPSI')) or ")
   SQL.ADD(" (O.TipoOp In ('MMSIMV') and O.RB5='1') ") 
   SQL.ADD(" ) ")
   If Dialogo.Radio1 = 1
      SQL.ADD(" and  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
   Endif
Endif
SQL.ADD("order by 1,2,4,6 ")
act(m:201,'')

Recorrer SQL
   ACN(mt1, FBN['Cant'])
   ACN(mt2, FBN['Int'])
   ACN(mt3, FBN['Imp'])
    
   If FBN['Precio2']=0 y Dialogo.Radio10=1
      ACT(NT:1, fbn('NrOperacion'))
      *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
      (.'MONTOTOMV'.)
   Endif
   
   ACN(mt11,0)
    
   If Dialogo.Check1=1
      SCN(mt11,Val(mt1))      
   Endif
   If Dialogo.Check2=1
      SCN(mt11,Val(mt2))      
   Endif
   If Dialogo.Check3=1
      SCN(mt11,Val(mt3))      
   Endif
   
   *ACN(mt12,IIf(EqStr(SQL("Select Modo from "~DBO~".MODOESPECIES where Especie1='"~FBN['Especie']~"' and Especie2='"~VAR('MONEEXTR')~"' "),'INV'),1/Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1),Cotizacion(FBN['Especie'],,,,Dialogo.Fecha1,1))  )
   ACN(mt12,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mt50)))
   
   *** Diario o Mensual ***
   If Dialogo.Radio2 = 0
      *** Diario ***
      *-- Ajuste por Capital si FInicio<>FConcertacion
      If EqStr(FBN['Tipo'],'Cap') y Dialogo.Check1=1
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
***             SCN(&i:Val(af:200),FBN['Cant']*Val(mt12))
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
***             SCN(&i:Val(af:200),FBN['Cant']*Val(mt12))
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo       
         *-- af201: Nro. de Operacion que Mostro Capital
         ACT(af:201,FBN['NrOperacion'])
      Else     
         ACN(mt1, FBN['Cant'])
         ACN(mt2, FBN['Int'])
         ACN(mt3, FBN['Imp'])
         
         If FBN['Precio2']=0 y Dialogo.Radio10=1
             ACT(NT:1, fbn('NrOperacion'))
            *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
            (.'MONTOTOMV'.)
         Endif
          
         ACN(mt11,0)
          
         If Dialogo.Check1=1
            SCN(mt11,Val(mt1))      
         Endif
         If Dialogo.Check2=1
            SCN(mt11,Val(mt2))      
         Endif
         If Dialogo.Check3=1
            SCN(mt11,Val(mt3))      
         Endif
          
         Recorrer&i 2, Val(d:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If FBN['Fecha'] = Val(&i:10)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
      Endif
   Else
      *-- Ajuste por Capital si FInicio<>FConcertacion
      If EqStr(FBN['Tipo'],'Cap') y Dialogo.Check1=1
         Recorrer&i 2, Val(d:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
***             SCN(&i:Val(af:200),FBN['Cant']*Val(mt12))
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(d:200)+1, Val(g:200)-1
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
***             SCN(&i:Val(af:200),FBN['Cant']*Val(mt12))
               SCN(&i:Val(af:200),Val(mt11)*Val(mt12))
            Endif
         Proximo       
         *-- m201: Nro. de Operacion que Mostro Capital
         ACT(af:201,FBN['NrOperacion'])
      Else
         *** Mensual ***
         ACN(mt1, FBN['Cant'])
         ACN(mt2, FBN['Int'])
         ACN(mt3, FBN['Imp'])
           
         If FBN['Precio2']=0  y Dialogo.Radio10=1
            ACT(NT:1, fbn('NrOperacion'))
            *- Tasa en 0, llamo a la fc. para calcular el monto total mt1: Monto Total/1000
            (.'MONTOTOMV'.)
         Endif
          
         If Dialogo.Check1=1
            SCN(mt11,Val(mt1))      
         Endif
         If Dialogo.Check2=1
            SCN(mt11,Val(mt2))      
         Endif
         If Dialogo.Check3=1
            SCN(mt11,Val(mt3))      
         Endif
          
         Recorrer&i Val(m:200), Val(n:200)
            If Anio(FBN['Fecha']) = Val(Val(m:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         Recorrer&i Val(o:200), Val(p:200)
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) = Val(&i:281)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Val(o:200) > 0
            If Anio(FBN['Fecha']) = Val(Val(o:200):280) y Mes(FBN['Fecha']) > Val(Val(p:200):281)
               SCN(Val(p:200)+1:Val(f:200),Val(mt11)*Val(mt12))
               SCN(Val(p:200)+1:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Endif
         Recorrer&i Val(d:200), Val(g:200)
            If Anio(FBN['Fecha']) = Val(&i:280)
               SCN(&i:Val(f:200),Val(mt11)*Val(mt12))
               SCN(&i:Val(i:200),Val(mt11)*Val(mt12))
            Endif
         Proximo
         If Anio(FBN['Fecha']) > Val(Val(g:200):280)
            SCN(Val(g:200):Val(f:200),Val(mt11)*Val(mt12))
            SCN(Val(g:200):Val(i:200),Val(mt11)*Val(mt12))
         Endif
      Endif
   Endif
Proximo

