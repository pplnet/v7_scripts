VCAN18    : 'SaldoFechaTot'         ;7 ;1;2;NO;  ;VCAN18>=CANTIDADTOTALORDEN;'Saldo Insuficiente';NO;;IF(EqStr(AfectaLS,'Saldos'),SaldoC(CLIENTE,ESPECIE,,,,MERCADO,VEHICULO,,VCAN9,FSys,CUPON1),CANTIDADTOTALORDEN);;;;;'#########.####'
VCAN28    : 'SaldoFechaUSD'         ;8 ;1;2;NO;  ;VCAN28>=CANTIDADTOTALORDEN;'Saldo No Disponible para vender en moneda extranjera';NO;;IF((EqStr(AfectaLS,'Saldos') y EqStr(CONTRAESPECIE,VAR('MONEEXTR'))),SaldoC(CLIENTE,ESPECIE,,,,MERCADO,VEHICULO,,VCAN39,FSys,CUPON1),CANTIDADTOTALORDEN);;;;;'#########.####'
VCAN7     : 'SaldoTeorico '         ;9 ;1;2;NO;  ;;;;;SaldoC(CLIENTE,ESPECIE,,,,MERCADO,VEHICULO,,VCAN9,FECHAORDEN,CUPON1)+Query("SELECT SUM(Cantidad) FROM "~DBO~".MOVPENDIENTES WHERE Mercado='"~MERCADO~"' AND Cantidad < 0 AND Cliente='"~CLIENTE~"' AND Especie='"~ESPECIE~"' AND EnteCustodia='"~VEHICULO~"' AND "~IF(NoVacio(CUPON1),"Cupon='"~CUPON1~"' AND","")~" NrSaldo="~FStr(VCAN9,3,0)~" AND NrOperacion In (SELECT NrTrans FROM "~DBO~".TRANSACCIONES2 WITH (NOLOCK)  WHERE CB6=0 AND NrTrans=NrOperacion)")+Query("SELECT Cantidad FROM "~DBO~".MOVEJECUTADOS with (NOLOCK) WHERE Mercado='"~MERCADO~"' AND NrOperacion='"~NROPERACION~"'  AND Cliente='"~CLIENTE~"' AND Especie='"~ESPECIE~"' AND EnteCustodia='"~VEHICULO~"' AND "~IF(NoVacio(CUPON1),"Cupon='"~CUPON1~"' AND","")~" NrSaldo="~FStr(VCAN8,3,0)~" ");;;;;'#########.####'
