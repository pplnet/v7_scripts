*********************************************************************************
* PARAMETROS:
*            EE1: ESPECIE
*            EE2: FECHA1
*            CB:Val(FI1): VALORTEORICO2
*            FI1: FILA
*            CO1: COLUMNA
*********************************************************************************

      *- Calculo del Valor Tecnico y Valuacion Total
      If DesciendeDeEspecie(Val(EE1),'CEDRO')

         *- ba: Dias Transcurridos  bb: Tasa bc: Valor del Indice
         ACN(ba:1,DifDias(UltCupon2(Val(EE1),Dialogo.Fecha1), Dialogo.Fecha1,'USA',NO))

         SQL.ADD("SELECT Indexado,TasaIntVigente,Indice FROM "~DBO~".ESPECIES WHERE Codigo='"~Val(EE1)~"' ")
         Recorrer SQL
            ACN(bb:1,FBN['TasaIntVigente'])
            ACT(bf:1, FBN['Indexado'])
            ACT(bg:1, FBN['Indice'])
            Break
         Proximo

         ACN(bc:1,1)
         If EqStr(Val(bf:1),'SI')
            *- Recupero de cotizaciones el valor del indice
            ACN(bc:1,CotizacionC(Val(bg:1),,,,Dialogo.Fecha1,1))
         EndIf

         *- Valor Tecnico
         ACN(Val(co1):Val(fi1),1)
         ** VAL TECNICO= (1+(TasaIntVigente*dias trans/365))*ValorTeorico2*valorindice
         ACN(Val(co1):Val(fi1), (1+(val(bb:1)*val(ba:1)/365))*val(cb:Val(fi1))*val(bc:1) )

         FormatoCeldas(Val(co1):Val(fi1),Exe('F7'))
      EndIf

