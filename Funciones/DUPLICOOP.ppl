**Duplicar el registro de la Operaci¢n original 

** Selecciono Numerador ***
If Incluido(FBN('TipoOP'), 'TCC|TCP|TVC|TVP')
    ACT(Z:1,GetNumerador(11))
Endif
If Incluido(FBN('TipoOP'), 'TICO|TICT|TIDE|TIPO')
    ACT(Z:1,GetNumerador(6))
Endif 
If Incluido(FBN('TipoOP'), 'TIC|TIV|TIFC|TIFV|TIPP|TIPA|TIADJ|TIRES')
    ACT(Z:1,GetNumerador(5))
Endif

If Vacio(val(Z:1))
  MessageBox('No se pudo duplicar operaci¢n, falta numerador...',2) 
  cancelar    
Endif  

**----Crear el nuevo Registro----------------

  SQL.ADD(" INSERT INTO "~DBO~".OPERACIONES ")
  SQL.ADD(" ( FechaOp, Especie, Cliente1, ")
  SQL.ADD(" Cantidad, Precio1, Corredor, ")
  SQL.ADD(" Plazo, FechaVto, PorComision, ")
  SQL.ADD(" ContraEspecie, ")
  SQL.ADD(" FormaLiquidacion1, FormaLiquidacion2, ")
  SQL.ADD(" TipoCambio, TotalIntereses, TotalNetoCli1, ")
  SQL.ADD(" TotalBrutoCli1, Mercado, Operador, ")
  SQL.ADD(" TablaFeriados1, Observaciones, TotalComisiones, ")
  SQL.ADD(" PaseCB, OperacionRef, TasaInteresesCupon, ")
  SQL.ADD(" FechaUltCupon, Vehiculo1, OpSIOPEL, CB5, CB6, CB7,Cupon1,")
  SQL.ADD(" NrOperacion, TipoCambio2, EsAforado, PorAforo, TotalCaucion, ")
  SQL.ADD(" TipoOp, MB6, ObservacDoc, Mercado2, ")
**  SQL.ADD(" FechaAltaMAE, NroAltaMAE, AceptaMAE, FechaEnvioMAE, ")
  SQL.ADD(" MB1, TasaBase,")
  SQL.ADD(" Precio3, Precio4, TotalAux3,TotalAux4,")
  SQL.ADD(" Cuenta1, Cuenta2, Cuenta3, Cuenta4, ")
  SQL.ADD(" PorImpuesto, TotalGanancias, PorArancel,")
  SQL.ADD(" TotalRetenciones, FechaPago, ")
  SQL.ADD(" Book, Book1, NrOperacion2 ")
  SQL.ADD(" ) VALUES ( ")
  SQL.ADD(" '"~IdxDate(fbn('FechaOp'))~"', '"~fbn('Especie')~"', '"~fbn('Cliente1')~"', ")
  SQL.ADD(" "~FStr(fbn('Cantidad'),1,2)~","~FStr(fbn('Precio1'),1,8)~", '"~fbn('Corredor')~"', ")
  SQL.ADD(" "~FStr(fbn('Plazo'),1,2)~", '"~IdxDate(fbn('FechaVto'))~"', "~FStr(fbn('PorComision'),1,8)~", ")
  SQL.ADD(" '"~fbn('ContraEspecie')~"', ")
  SQL.ADD(" '"~fbn('FormaLiquidacion1')~"', '"~fbn('FormaLiquidacion2')~"', ")
  SQL.ADD(" "~FStr(fbn('TipoCambio'),1,8)~", "~FStr(fbn('TotalIntereses'),1,8)~", "~FStr(fbn('TotalNetoCli1'),1,8)~", ")
  SQL.ADD(" "~FStr(fbn('TotalBrutoCli1'),1,8)~", '"~fbn('Mercado')~"', '"~fbn('Operador')~"', ")
  SQL.ADD(" '"~fbn('TablaFeriados1')~"', '"~fbn('Observaciones')~"', "~FStr(fbn('TotalComisiones'),1,8)~", ")  
  SQL.ADD(" '"~fbn('PaseCB')~"', '"~fbn('OperacionRef')~"', "~FStr(fbn('TasaInteresesCupon'),1,8)~", ")
  SQL.ADD(" '"~IdxDate(fbn('FechaUltCupon'))~"', '"~fbn('Vehiculo1')~"', '"~fbn('OpSIOPEL')~"', '"~fbn('CB5')~"', '"~fbn('CB6')~"', '"~fbn('CB7')~"','"~fbn('Cupon1')~"', ")
  SQL.ADD(" '"~Val(Z:1)~"', "~FStr(fbn('TipoCambio2'),1,8)~", '"~fbn['EsAforado']~"', "~FStr(FBN['PorAforo'],1,8)~", "~FStr(fbn('TotalCaucion'),1,8)~",")
  SQL.ADD(" '"~FBN['TipoOp']~"','0','OK', '"~fbn('Mercado2')~"' ,")
  SQL.ADD(" '"~fbn('MB1')~"', "~FStr(fbn('TasaBase'),1,8)~", ")
  SQL.ADD(" "~FStr(fbn('Precio3'),1,8)~", "~FStr(fbn('Precio4'),1,8)~","~FStr(fbn('TotalAux3'),1,8)~","~FStr(fbn('TotalAux4'),1,8)~",")
  SQL.ADD(" '"~fbn('Cuenta1')~"', '"~fbn('Cuenta2')~"', '"~fbn('Cuenta3')~"', '"~fbn('Cuenta4')~"',")
  SQL.ADD(" "~FStr(fbn('PorImpuesto'),1,8)~", "~FStr(fbn('TotalGanancias'),1,8)~","~FStr(fbn('PorArancel'),1,8)~", ")
  SQL.ADD(" "~FStr(fbn('TotalRetenciones'),1,8)~", '"~IdxDate(fbn('FechaPago'))~"', ")
  SQL.ADD(" '"~fbn('Book')~"', '"~fbn('Book1')~"', '"~fbn('NrOperacion2')~"' ")
  SQL.ADD(" )")
  SQL.NEW
  SQL.EXEC


  *-- Generacion de Instancias en OperacionesBits ----
  Recorrer&I 1,81
    ACT(A1,FStr(&I,1,0))
    If Incluido(Val(A1),'1|21|22|30|31|50|60|61|62|63|64|65|66|67|68|69|70|71|73|74|75|76|77|78|80|81')
      SQL.ADD(" Insert into "~DBO~".OPERACIONESBITS (NrOperacion, NrBit, Valor) ")
      SQL.ADD(" Values ('"~Val(Z:1)~"',"~Fstr(&I,1,0)~",'0') ")
      SQL.NEW
    EndIf
  Proximo

  *-- Queda en Carga Trader ---
  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS SET Valor = '1' ")
  SQL.ADD(" Where  NrBit=1 and NrOperacion= '"~Val(Z:1)~"' ")
  SQL.NEW
  SQL.EXEC

  *-- Graba los movimientos de la operacion  ***
  SQL.ActualizarMovimientos3(Val(z1),SI,SI,SI,SI,SI,0,80,81)
  SQL.EXEC

Messagebox('La Operaci¢n ha sido duplicada, la nueva Operaci¢n generada es: '~Val(Z:1)) 
