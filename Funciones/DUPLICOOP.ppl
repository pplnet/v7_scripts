**preguntar si desea borrar la original. 
If MessageBox('Desea Borrar la Operaci¢n Original?',3,2) = 6
    SQL.ADD(" DELETE FROM "~DBO~".OPERACIONES ")
    SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    SQL.NEW
    SQL.EXEC
Endif
cancelar

