*- Busco el mayor codigo de cuenta que tenga
*- Parametro de entrada => cl1= Codigo de cliente Parametro de salida= ab1 Nro. de Cuenta a generar
ACT(n2,'0')

*- Para saltear los simbolos entre las mayusculas y las minusculas
SQL.ADD("SELECT Char(Ascii(SubString(Codigo,1,1))+1) as Sig,Ascii(SubString(Codigo,1,1))  FROM "~DBO~".CUENTAS WHERE Cliente = '"~VAL(cl1)~"' AND SUBSTRING(Codigo,2,LEN(Codigo))=Cliente ")
*- 49 a 57 son los numeros
SQL.ADD("and ((Ascii(SubString(Codigo,1,1))>=48 and Ascii(SubString(Codigo,1,1))<57) ")
SQL.ADD("or ")
*- 65 a 90 son las mayusculas
SQL.ADD("(Ascii(SubString(Codigo,1,1))>=65 and Ascii(SubString(Codigo,1,1))<90) ")
SQL.ADD("or ")
*- 97 a 122  son las minusculas
SQL.ADD("(Ascii(SubString(Codigo,1,1))>=97 and Ascii(SubString(Codigo,1,1))<122)) ")
SQL.ADD("Union All ")
*- Para saltear los simbolos entre las mayusculas y las minusculas
SQL.ADD("SELECT 'A',Ascii(SubString(Codigo,1,1))  FROM "~DBO~".CUENTAS WHERE Cliente = '"~VAL(cl1)~"' AND SUBSTRING(Codigo,2,LEN(Codigo))=Cliente ")
SQL.ADD("and Ascii(SubString(Codigo,1,1))=57 ")
SQL.ADD("Union All ")
SQL.ADD("SELECT 'a',Ascii(SubString(Codigo,1,1))  FROM "~DBO~".CUENTAS WHERE Cliente = '"~VAL(cl1)~"' AND SUBSTRING(Codigo,2,LEN(Codigo))=Cliente ")
SQL.ADD("and Ascii(SubString(Codigo,1,1))=90 ")
SQL.ADD("ORDER BY Ascii(SubString(Codigo,1,1)) DESC ")

