*-- Importar Tipos de Variables
LeerPMG('TIPOVAR', 'WKS')
If Vacio(val(ab1))
   Cancelar('No se ha podido recuperar el TIPOVAR.wks')
EndIf

*- Elimino la fila en la planilla wks z1: Encontro la variable
acn(z1,0)
   
Recorrer&i 1,val(ab1)

   Message('Recupero el tipo de variable '~Fstr(&i,0,0))

   If EqStr(Dialogo.Variable1,val(a:&i))
      acn(z1,&i)
   EndIf

   If val(z1)>0
      BorrarCeldas(a:&i.. e:&i)          
      act(a:&i,val(a:&i+1))
      act(b:&i,val(b:&i+1))
      act(c:&i,val(c:&i+1))
      act(d:&i,val(d:&i+1))
      act(e:&i,val(e:&i+1))
   EndIf
Proximo
If val(z1)>0
   scn(ab1,-1)
EndIf

Message('*-- Actualizando TIPOVAR.WKS ')
GrabarPMG('TIPOVAR','WKS')   
