*         Setear Funcion
*         Objeto a Buscar                  ACT(xz1,'INFORMES') 
*         Codigo del Objeto a Buscar       ACT(xz2,Val(t1))
*         Colunma Inicial para el detalle  ACN(xz3,4)

          ACT(aa12, BuscarLinkearHojas(Val(xz1), Val(xz2)))
          if NoVacio(Val(aa12))
             act(val(xz3):val(xy1)+1,'Incluye Informe')
             AlinearCeldas(val(xz3):val(xy1)+1,'D')
             SetFont(val(xz3):val(xy1)+1, 5)
             ACN(xy77,Elementos(Val(aa12)))
             SCN(xz40,Val(xy77))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy77)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa12), &k))))
                ACT(val(xz3)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".INFORMES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz11,'INFORMES')
                ACT(xz12,Val(t10))
                ACN(xz13,Val(xz3)+1)
                (.'PDPFUNC3'.)
             proximo
          Endif

          ACT(aa22, BuscarEjecutarEventos(Val(xz1), Val(xz2)))
          if NoVacio(Val(aa22))
             act(Val(xz3):val(xy1)+1,'Incluye Evento')
             AlinearCeldas(val(xz3):val(xy1)+1,'D')
             SetFont(Val(xz3):val(xy1)+1, 5)
             ACN(xy77,Elementos(Val(aa22)))
             SCN(xz40,Val(xy77))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy77)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa22), &k))))
                ACT(Val(xz3)+1:Val(xy1),Val(t10)~' - '~SQL("select Nombre from "~DBO~".EVENTOS where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz11,'EVENTOS')
                ACT(xz12,Val(t10))
                ACN(xz13,Val(xz3)+1)
                (.'PDPFUNC3'.)
             proximo
          Endif

          ACT(aa32, BuscarFunciones(Val(xz1), Val(xz2)))
          if NoVacio(Val(aa32))
             act(val(xz3):val(xy1)+1,'Incluye Funcion')
             AlinearCeldas(val(xz3):val(xy1)+1,'D')
             SetFont(val(xz3):val(xy1)+1, 5)
             ACN(xy77,Elementos(Val(aa32)))
             *messagebox('6 - '~val(xy99)~' - '~val(aa32))
             SCN(xz40,Val(xy77))
             ACN(xy50,0)
             
             Recorrer&k 1,Val(xy77)
                SCN(xy1,1)
                ACT(t10,Mirt(Trim (ItemLista(Val(aa32), &k))))
                ACT(val(xz3)+1:Val(xy1),Val(t10)~' - '~SQL("select Descripcion from "~DBO~".FUNCIONES where Codigo = '"~Val(t10)~"' "))
                *  Setear Funcion
                ACT(xz11,'FUNCIONES')
                ACT(xz12,Val(t10))
                ACN(xz13,Val(xz3)+1)
                (.'PDPFUNC3'.)
             proximo
          Endif
           
