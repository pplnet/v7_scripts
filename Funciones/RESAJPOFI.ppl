** funcion de informe "Detalle de Operaciones Financieras"

** PARAMETROS:
**             co1: es la columna inicial para comenzar a imprimir
**             co3 = 0 indica que ya imprimi los titulos, entonces
**                   formateo celdas y pongo marcos 
**             fi1: fila actual (fila en la que empiezo a imprimir)
**             tx1: indica si es en efectivo
**********************************************************************

ACT(Val(co1):Val(fi1), 'DETALLES SALDOS OTRAS CTAS CTES '~IIF(EqStr(Val(tx1),'efectivo'),'EN EFECTIVO','') )
ACT(Val(co1):Val(fi1)+1, 'ENTIDAD')
ACT(Val(co1)+3:Val(fi1)+1, 'IMPORTE')
AlinearCeldas(Val(co1):Val(fi1)+1..Val(co1)+3:Val(fi1)+1,'D')
SetFont(Val(co1):Val(fi1)..Val(co1)+3:Val(fi1)+1,1)
SCN(fi1,2)

IF Not EqStr(Dialogo.Especie1,Dialogo.Especie2)
   IF EqStr(Modo(Dialogo.Especie1,Dialogo.Especie2),'DIR')
      ACN(ct1, Dialogo.Precio1)
   Else
      ACN(ct1, 1/Dialogo.Precio1)
   Endif
else
   ACN(ct1,1)
Endif

*- Ajuste de Cobertura
SQL.ADD("Select Cliente1,Sum(Cantidad) as Cantidad from "~DBO~".OPERACIONES ")
SQL.ADD("Where FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  FechaVto  >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  TipoOp In ('AJPOFI') ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and  Vehiculo1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
if EqStr(Val(tx1),'efectivo')
   SQL.ADD(" and RB5=1 ")
else
   SQL.ADD(" and RB5=0 ")
endif
if EqStr(Dialogo.Especie1,'USD')
   SQL.ADD(" and RB6=0 ")
else
   SQL.ADD(" and RB6=1 ")
endif
SQL.ADD(" and RB9=0 ")
SQL.ADD("Group by Cliente1")
SQL.ADD("Order by 1 ")

ACN(bs1,0)
ACN(co7,0)
Recorrer SQL
   ACT(Val(co1):Val(fi1), FBN['Cliente1'] )
   ACN(Val(co1)+3:Val(fi1), FBN['Cantidad']*Val(ct1) )
   SCN(bs1, Val(Val(co1)+3:Val(fi1)) )
   SCN(fi1,1)
   SCN(co7,1)
Proximo

ACT(Val(co1):Val(fi1), 'TOTAL' )
ACN(Val(co1)+3:Val(fi1), Val(bs1) )
SetFont(Val(co1):Val(fi1)..Val(co1)+3:Val(fi1),1)

** Marco de fila de resumen
AgregarMarco(Val(co1):Val(fi1)-Val(co7)-2..Val(co1)+3:Val(fi1)-Val(co7)-2,1,1)
** Marco de datos y columnas
AgregarMarco(Val(co1):Val(fi1)-Val(co7)-1..Val(co1)+1:Val(fi1)-1,1,1)
AgregarMarco(Val(co1):Val(fi1)-Val(co7)-1..Val(co1)+3:Val(fi1)-1,1,1)
** Marco de totales
AgregarMarco(Val(co1):Val(fi1)..Val(co1)+3:Val(fi1),1,1)

** Realizo el formato de todas las celdas
FormatoCeldas(Val(co1)+3:Val(fi1)-Val(co7)..Val(co1)+3:Val(fi1),Exe('F2'))
Setfont(Val(co1):Val(fi1)-Val(co7)..Val(co1)+3:Val(fi1)-1,2)
