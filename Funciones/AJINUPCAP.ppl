*--> Hacer el update a TODAS las operaciones UV y MV
*--> Al relevar todas las operaciones probar si en vez de preguntar por tipoop, se lo puede hacer por uni_mul 

************************************************ U N I C O  V E N C I M I E N T O ******************************************

*--> (cp:1) = Coeficiente de ajuste CER <--*
*--> (cp:3) = Capital ajustado <--*

*--> (vu:3) = TotalComisiones---- <--*
*--> (vu:4) = PrecioEj----------- <--*
*--> (vu:5) = TotalIntereses----- <--*
*--> (vu:6) = TotalBrutoCli1----- <--*
*--> (vu:7) = ImpComCorEq2------- <--*
*--> (vu:8) = ImpComCor1--------- <--*
*--> (vu:9) = ImporteImp--------- <--*
*--> (vu:10) = TotalNetoCli2----- <--*
*--> (vu:11) = TotalNetoCli1----- <--*
*--> (vu:12) = TotalIVA---------- <--*  MMCP
*--> (vu:13) = PrecioMer--------- <--*
*--> (vu:14) = ResultadoIndice--- <--*
*--> (vu:15) = TotalRetenciones-- <--*
*--> (vu:16) = PeriodoInts------- <--*
*--> (vu:17) = TotalAux3--------- <--*  MMCP
*--> (vu:18) = TotalGanancias---- <--*
*--> (vu:19) = ImpComCorEq1------ <--*
*--> (vu:20) = PorComMer1-------- <--*
*--> (vu:21) = Precio2----------- <--*
*--> (vu:22) = TotalGastos------- <--*
*--> (vu:23) = TotalBrutoCli3---- <--*
*--> (vu:24) = TotalNetoCli3----- <--*
*--> (vu:25) = TotalDerechos----- <--*
*--> (vu:26) = TotalImpuestos---- <--*
*--> (vu:27) = TotalImpuesto1---- <--*
*--> (vu:28) = Cantidad---------- <--*
*--> (vu:29) = PeriodoInts X MMCP <--*
*--> (vu:30) = TotalAux1--------- <--*  MMCP
*--> (vu:31) = ImpGastos2-------- <--*  MMCP
*--> (vu:31) = TotalAux2--------- <--*  MMCP


************************************************* M U L T I P L E  V E N C I M I E N T O ***********************************

*--> (cp:10) = Coeficiente de ajuste CER <--*
*--> (cp:3) = Capital ajustado <--*
*--> (cp:5) = Capital amort. ajustado <--*
*--> (cp:6) = Incremento del capital próx. cuota <--*

*--> (vm:2) = Cantidad4--- <--*
*--> (vm:3) = Cantidad3--- <--*
*--> (vm:4) = Precio5----- <--*
*--> (vm:5) = Precio7----- <--*
*--> (vm:6) = Total2------ <--*
*--> (vm:7) = Cantidad6--- <--*
*--> (vm:8) = Cantidad7--- <--*
*--> (vm:9) = Total3------ <--*
*--> (vm:10) = Total4----- <--*
*--> (vm:11) = Precio6---- <--*
*--> (vm:12) = Cantidad8-- <--*
*--> (vm:13) = Total1----- <--*
*--> (vm:14) = Total7----- <--*
*--> (vm:15) = Plazo4----- <--*
*--> (vm:16) = Total9----- <--*
*--> (vm:17) = Total8----- <--*
*--> (vm:18) = Precio1---- <--*
*--> (vm:19) = Precio3---- <--*
*--> (vm:20) = Precio8---- <--*
*--> (vm:21) = Cantidad5-- <--*
*--> (vm:22) = Total5----- <--*
*--> (vm:23) = ResultadoIndice- <--*


If EqStr(FBN['Tipo'], 'MMCPM')  
   Sql.Add(" Update "~DBO~".CUOTAS  Set ")
   Sql.Add(" Cantidad2       = "~FStr(Val(cp:3),0,2)~" ,")
   IF Mes(Val(fc:1)) <> Mes(Val(zz:1))
     Sql.Add(" Cantidad1     = "~FStr(Val(cp:5),0,2)~" ,") 
   EndIf   
   Sql.Add(" Coeficiente     = "~FStr(Val(cp:10),0,8)~" ,")
   Sql.Add(" Cantidad4       = "~FStr(Val(vm:12),0,2)~" ,")
   Sql.Add(" Cantidad3       = "~FStr(Val(vm:3),0,2)~" ,")
   Sql.Add(" Total2          = "~FStr(Val(vm:6),0,2)~" ,")
   Sql.Add(" Total3          = "~FStr(Val(vm:9),0,2)~" ,")
   Sql.Add(" Total5          = "~FStr(Val(vm:22),0,2)~" ,")
   Sql.Add(" Cantidad6       = "~FStr(Val(vm:17),0,2)~" ,")
   Sql.Add(" Cantidad5       = "~FStr(Val(vm:21),0,2)~" ,")
   Sql.Add(" ResultadoIndice = "~FStr(Val(vm:23),0,2)~", ")
   Sql.Add(" Total1          = "~FStr(Val(vm:13),0,2)~" ")
   Sql.Add(" Where NrOperacion = '"~FBN['NrOp']~"' ")
   Sql.Add("   and NrCuota = "~FStr(FBN['Cuota'],0,0)~" ")

   Sql.New
   Sql.Exec

   ** Esto es si no es la ultima cuota
   ACN(ct:1, FBN['Cuota'] + 1 )   
   ACN(ct:2, SQL("Select 1 From "~DBO~".CUOTAS Where NrOperacion = '"~FBN['NrOp']~"' and NrCuota = "~Val(ct:1)~" ") )   
   If Val(ct:2) = 1
      *--> Actualiza el capital de la próx. cuota <--*
      Sql.Add(" Update "~DBO~".CUOTAS Set ")
      Sql.Add(" Cantidad2 = "~FStr(Val(cp:6),0,2)~" ")
      Sql.Add(" Where NrOperacion = '"~FBN['NrOp']~"' ")
      Sql.Add("   and NrCuota = "~FStr(Val(ct:1),0,0)~" ")

      Sql.New
      Sql.Exec
   EndIf
EndIf

