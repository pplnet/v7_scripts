*** Orden para la Cancelacion Parcial de la deuda: IVAPERC,IVAADIC,IVANOR, ***
*** Intereses Punitorios,Intereses Compensatorios,Intereses Normales,Comision,Capital ***

ACN(x4,0)
ACN(x5,val(x3))
             
* Si bonifico punitorios
if Val(x6)=0
  SCN(x5, Val(y6)+Val(y7))
endif

************************ Cancelacion de Impuestos, Intereses, Comision ************************
Recorrer&i 1,val(x1)

* Cotizacion de la Especie a Fecha Vto.
if EqStr(val(a1),'ARP')
  ACN(z10,1)
else
*  ACN(z10,COTIZACIONC(val(a1),,,,val(cw:val(x1))-1,1,SI,'USD')*COTIZACIONC('USN',,,,val(cw:val(x1))-1,1,SI,'ARP'))    
*  Esto cambia por la cotizacion del USD de CIerreBNA

   ACN(z10,COTIZACIONBNA('USD',val(cw:val(x1))-1,2,NO,NO) )

endif

  ACN(ss4, Num(val(cz:&i)))

  (.'CANPRE8'.)

  recorrer&j 1,25
    ACN(ad:&j, val(ac:&j))
  proximo

*------ Aplico los pagos----------------------
  recorrer&j 1,24
    if val(x5)>0
      if round(val(ac:&j)-val(x5),2)<=0
        ACN(ad:&j, 0)
      else
        ACN(ad:&j, round(val(ac:&j)-val(x5),2))
      endif
      ******************************************
      * Atento a la condicion para ver si es ARP
      ******************************************
      if EqStr(Copy(Val(ab:&j),1,3),'IVA')

        if Incluido(FStr(val(aa:&j),1),'41|81|42|82|43|83') y val(z2)>val(cw:val(x1))
          ACN(ae:&j, (val(ac:&j)-val(ad:&j))*Val(z10))
          else
          ACN(ae:&j, (val(ac:&j)-val(ad:&j))*Val(z6))
        endif

        ACT(af:&j, 'ARP')
*        ACT(ag:&j, 'BCRA')
        ACT(ag:&j, Val(me2))
      else
        ACN(ae:&j, val(ac:&j)-val(ad:&j))
        ACT(af:&j, Val(a1))
*        ACT(ag:&j, Val(q1))
        ACT(ag:&j, Val(me1))
      endif
      ACN(x5,round(val(x5)-val(ac:&j),2))
    else
      break
    endif
  proximo
            
  *------ Genero Movimientos ---------------------
  recorrer&j 1,24
    if Val(ac:&j)<>Val(ad:&j)
      * Genero Mov. Ejecutados
      * Si los punitorios estßn bonificados, cambio el Nr.saldo
      if [val(x6)=0 y val(aa:&j)>=60 y val(aa:&j)<=63]
        ACN(ss1,val(aa:&j)+140)
      else
        ACN(ss1,val(aa:&j))
      endif
      ACN(ss2,val(ac:&j)-val(ad:&j))
      ACT(ss3,val(ab:&j))    
      (.'CANPME4'.)

      * Genero Mov. Pendientes
      * Tienen signo (-) porque son vistos del lado del cliente
      if not [val(x6)=0 y val(aa:&j)>=60 y val(aa:&j)<=63]
        ACN(ss1, val(aa:&j))
*        ACN(ss2, -(val(ac:&j)-val(ad:&j)))
        ACN(ss2, -val(ae:&j))
        ACT(ss3, val(ab:&j))
        ACT(ss5, val(af:&j))
        ACT(ss6, val(ag:&j))
        (.'CANPME6'.)
      endif

      * Genero Mov. Saldo Anterior
      if val(ba:&j)>0 y not [val(x6)=0 y val(aa:&j)>=60 y val(aa:&j)<=63]
        ACN(ss1,val(ba:&j))
        ACN(ss2,val(bc:&j))
        ACT(ss3,val(bb:&j))
        (.'CANPME4'.)
      endif
    endif
  proximo
             
  *--- Movimientos de WHT y PISE ----------------------------------------
  if Eqstr(val(p1),'INGCURA')
    * Grabo siempre WHT
    * WHT / INTERESES
    if val(cm:&i)>0
      ACN(ss1,73)
      ACN(ss2,val(cm:&i))
      ACT(ss3,'WHT sobre Intereses')
      (.'CANPME4'.)

      if val(z4)=0       
        ACN(ss2, -val(cm:&i)*val(z6))
        ACT(ss5, 'ARP')
        ACT(ss6, val(me2))
        (.'CANPME6'.)
      endif
    endif
    * WHT / COMISIONES
    if val(co:&i)>0
      ACN(ss1,74)
      ACN(ss2,val(co:&i))
      ACT(ss3,'WHT sobre Comisiones')
      (.'CANPME4'.)

      if val(z4)=0       
        ACN(ss2, -val(co:&i)*val(z6))
        ACT(ss5, 'ARP')
        ACT(ss6, val(me2))
        (.'CANPME6'.)
      endif
    endif
    * WHT / BREAKFUNDING
    if val(kf:&i)>0
      ACN(ss1,77)
      ACN(ss2,val(kf:&i))
      ACT(ss3,'WHT sobre Breakfunding')
      (.'CANPME4'.)

      if val(z4)=0       
        ACN(ss2, -val(kf:&i)*val(z6))
        ACT(ss5, 'ARP')
        ACT(ss6, val(me2))
        (.'CANPME6'.)
      endif

    endif
             
    if EQSTR(val(r1),'SI')
      * PISE / INTERESES
      if val(cn:&i)>0
        ACN(ss1,75)
        ACN(ss2,val(cn:&i))
        ACT(ss3,'PISE sobre Intereses')
        (.'CANPME4'.)

        if val(z4)=0       
          ACN(ss2, -val(cn:&i)*val(z6))
          ACT(ss5, 'ARP')
          ACT(ss6, val(me2))
          (.'CANPME6'.)
        endif
      endif
      * PISE / COMISIONES
      if val(cp:&i)>0
        ACN(ss1,76)
        ACN(ss2,val(cp:&i))
        ACT(ss3,'PISE sobre Comisiones')
        (.'CANPME4'.)

        if val(z4)=0       
          ACN(ss2, -val(cp:&i)*val(z6))
          ACT(ss5, 'ARP')
          ACT(ss6, val(me2))
          (.'CANPME6'.)
        endif
      endif
      * PISE / BREAKFUNDING
      if val(ke:&i)>0
        ACN(ss1,78)
        ACN(ss2,val(ke:&i))
        ACT(ss3,'PISE sobre Breakfunding')
        (.'CANPME4'.)

        if val(z4)=0       
          ACN(ss2, -val(ke:&i)*val(z6))
          ACT(ss5, 'ARP')
          ACT(ss6, val(me2))
          (.'CANPME6'.)
        endif
      endif
    endif
  endif

*** Actualizacion de Saldos y Fecha de cobro
  if Dialogo.Check1=1
    SQL.ADD("Update "~DBO~".CUOTAS set  ")
    SQL.ADD("Cantidad9 ="~FStr(Val(ad:13),1,2)~", ")
    SQL.ADD("Cantidad10="~FStr(Val(ad:7),1,2)~", ")
    SQL.ADD("Cantidad11="~FStr(Val(ad:1),1,2)~", ")
    SQL.ADD("Cantidad13="~FStr(Val(ad:16),1,2)~", ")
    SQL.ADD("Cantidad14="~FStr(Val(ad:10),1,2)~", ")
    SQL.ADD("Cantidad15="~FStr(Val(ad:4),1,2)~", ")
    if Val(x6)=0
      SQL.ADD("Cantidad8="~FStr(Val(ad:19),1,2)~", ")
    endif
    SQL.ADD("Cantidad7 ="~FStr(Val(ad:20),1,2)~", ")
    SQL.ADD("Cantidad6 ="~FStr(Val(ad:21),1,2)~", ")
    SQL.ADD("Cantidad12="~FStr(Val(ad:23),1,2)~", ")
    if val(x5)=0
       if Val(ca:&i)=0
          SQL.ADD("Radio6='1', ")
       else
          SQL.ADD("Radio6='0', ")
       endif
    else
      SQL.ADD("Radio6='0', ")
    endif
    SQL.ADD("Fecha4 = '"~IdxDate(val(z2))~"' ")
    SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
    SQL.ADD("and   NrCuota     = "~val(ss4)~" ")
    SQL.NEW
    SQL.EXEC
  endif

Proximo

************************ Cancelacion de Capital ***********************************************
if val(x5)>0

 Recorrer&i 1,val(x1)
  ACN(ss4, Num(val(cz:&i)))

  ACN(ad:25, val(ca:&i))
  if val(x5)>0
      if round(val(ca:&i)-val(x5),2)<=0
        ACN(ad:25, 0)
      else
        ACN(ad:25, round(val(ca:&i)-val(x5),2))
      endif
      ACN(x5,round(val(x5)-val(ca:&i),2))
  else
      break
  endif

  if Val(ca:&i)<>Val(ad:25)
      * Genero Mov. Ejecutados
      ACN(ss1, 30)
      ACN(ss2,val(ca:&i)-val(ad:25))
      ACT(ss3,'Capital cobrado')    
      (.'CANPME4'.)

      * Genero Mov. Pendientes
      * Tienen signo (-) porque son vistos del lado del cliente
        ACN(ss2, -(val(ca:&i)-val(ad:25)))
        ACT(ss3, 'Capital cobrado')
        ACT(ss5, val(a1))
        ACT(ss6, val(q1))
        (.'CANPME6'.)

      * Genero Mov. Saldo Anterior
      if val(ca:&i)>0 
        ACN(ss1,130)
        ACN(ss2,val(ca:&i))
        ACT(ss3,'Capital Saldo Anterior')
        (.'CANPME4'.)
      endif
  endif

  SQL.ADD("Update "~DBO~".CUOTAS set  ")
  SQL.ADD("Cantidad5 ="~FStr(Val(ad:25),1,2)~", ")
  SQL.ADD("Cantidad3 ="~FStr(Val(ct:&i)-(val(ca:&i)-val(ad:25)),1,2)~" ")
  if val(ad:25)=0
     SQL.ADD(", Radio6='1' ")  
  endif
  SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
  SQL.ADD("and   NrCuota     = "~val(ss4)~" ")
  SQL.NEW
  SQL.EXEC

 Proximo

endif

if Dialogo.Cantidad3=0 y Dialogo.Radio1=0 y val(x5)<0
  ACN(x1,val(ss4)-1)
endif

*** Marca en OPERACIONES FechaUltPago y CB6, si esta totalmente cancelado *************************************
  SQL.ADD("Update "~DBO~".OPERACIONES set  ")
  SQL.ADD(" FechaEj = '"~IdxDate(val(z2))~"' ")
  if SQL("select count(*) from "~DBO~".CUOTAS where NrOperacion='"~val(z1)~"' and isnull(Radio6,'0')<>'1' ")=0
     SQL.ADD(", CB6 = '1' ")
  endif
  SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
  SQL.NEW
  SQL.EXEC

*************************** Si es Pre-Cancelacion, se borran los MOVDEVENGADOS ******************
if Dialogo.Radio1=1 y val(z2)<val(f1)
*** Marca en OPERACIONES ***
  SQL.ADD("Update "~DBO~".OPERACIONES set  ")
  SQL.ADD("CB6 = '1' , FechaPrecan = '"~IdxDate(val(z2))~"' ")
  SQL.ADD("where NrOperacion = '"~val(z1)~"' ")
  SQL.NEW
  SQL.EXEC

  Recorrer&i 1,val(x1)
* FO 08/05/2006, No borra los mov deveng si la fecah coincide con el comienzo de una nueva cuota
*    if [val(z2)>val(cy:&i) y val(z2)<val(cw:&i)] 

    if [val(z2)>=val(cy:&i) y val(z2)<val(cw:&i)] 
      ACN(ss4, Num(val(cz:&i)))

      ACN(zz3, 140)
      ACT(zz4, 'INTLEN')
* FO 08/05      ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=140 and Fecha<"~IdxDate2(val(z2)-1)~" and Cupon='"~Fstr(val(ss4),0,0)~"' "))
      ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=140 and Fecha<"~IdxDate2(val(z2))~" and Cupon='"~Fstr(val(ss4),0,0)~"' "))
      ACN(zz6, val(gg:&i))
      ACN(zz7,Round(val(zz6)-val(zz5),9))

      message('Borro los devengados que sobran - hasta hoy ')
* FO 08/05      SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and Fecha >='"~IdxDate(val(z2)-1)~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo=140 ")
      SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and Fecha >='"~IdxDate(val(z2))~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo=140 ")
      SQL.NEW

      if val(zz7) > 0   
        (.'CANPRE11'.)            
      endif

      if val(t1)=2 y val(u1)=1
         ACN(zz3, 180)
         ACT(zz4, 'COMIS')
*fo 08/05         ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=180 and Fecha<"~IdxDate2(val(z2)-1)~" and Cupon='"~Fstr(val(ss4),0,0)~"' "))
         ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=180 and Fecha<"~IdxDate2(val(z2))~" and Cupon='"~Fstr(val(ss4),0,0)~"' "))
         ACN(zz6, val(na:&i))
         ACN(zz7,Round(val(zz6)-val(zz5),9))

         message('Borro los devengados que sobran - hasta hoy ')
* FO 08/05         SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and Fecha >='"~IdxDate(val(z2)-1)~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo=180 ")
         SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and Fecha >='"~IdxDate(val(z2))~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo=180 ")
         SQL.NEW
         
         if val(zz7) > 0
            (.'CANPRE11'.)            
         endif
      endif

      message('Borro los devengados que sobran -  el resto ')
      SQL.ADD("INSERT "~DBO~".DELDEVENGADOS (NrOperacion, Fecha) VALUES ('"~val(z1)~"','"~IdxDate(FSYS)~"')")
      SQL.NEW
      SQL.EXEC
    endif
  Proximo

  *** Si es de INGCURA, 2412 ***
  if Eqstr(val(bo2),'1') y Eqstr(val(p1),'INGCURA')
   ACT(zx1,val(z1))
   ACT(zx2,val(p1))
   ACT(zx3,val(bo1))

   Recorrer&i 1,val(x1)
    if [val(z2)>val(cy:&i) y val(z2)<val(cw:&i)] 
      ACN(ss4, Num(val(cz:&i)))

      ACN(zz3, 180)
      ACT(zz4, 'COMIS')
      ACN(zz5, SQL("Select sum(Monto) from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(bo3)~"' and NrSaldo=180 and Fecha<"~IdxDate2(val(z2)-1)~" and Cupon='"~Fstr(val(ss4),0,0)~"' "))
      ACN(zz6, val(ct:&i)*(val(z2)-val(cy:&i))*BuscarCampo('OPERACIONES','PorComision','NrOperacion',val(bo3))/val(g1))
      ACN(zz7,Round(val(zz6)-val(zz5),9))

      ACT(z1,val(bo3))
      ACT(p1,BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',val(bo3)))
      ACT(bo1,BuscarCampo('OPERACIONES','Book1','NrOperacion',val(bo3)))

      message('Borro los devengados que sobran - hasta hoy ')
      SQL.ADD("Delete "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(bo3)~"' and Fecha >='"~IdxDate(val(z2)-1)~"' and Fecha <='"~IdxDate(FSYS)~"' and NrSaldo=180 ")
      SQL.NEW
      
      (.'CANPRE11'.)            

      message('Borro los devengados que sobran -  el resto ')
      SQL.ADD("INSERT "~DBO~".DELDEVENGADOS (NrOperacion, Fecha) VALUES ('"~val(bo3)~"','"~IdxDate(FSYS)~"')")
      SQL.NEW
      SQL.EXEC
    endif   
   Proximo
   ACT(z1,val(zx1))
   ACT(p1,val(zx2))
   ACT(bo1,val(zx3))
  endif
endif

************ Si FechaValor < FechaSistema, se generan los MOVDEVENGADOS de COMPENSATORIOS con signo contrario ******************
if val(z2)<val(z22)
  ACD(z23,val(z2))
  Recorrer&i 1,val(x1)
    if val(cw:&i) < val(z22)
       ACN(ss4, Num(val(cz:&i)))

       *** COMPENSATORIOS ***
       SQL.ADD("Select TipoDevengado,Fecha,Monto ")
       SQL.ADD("from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=150 ")
       SQL.ADD("and Fecha>="~IdxDate2(val(cw:&i))~" and Fecha<="~IdxDate2(val(z22))~" and Cupon='"~Fstr(val(ss4),0,0)~"' ")
       SQL.ADD("and Monto > 0 ")
       Recorrer SQL
         ACD(z2,val(z22))
         ACN(zz7,FBN['Monto']*-1)
         ACT(zz4,FBN['TipoDevengado'])
         ACN(zz3,150)
         (.'CANPRE11'.)
         SQL.EXEC
       Proximo       
       *** PUNITORIOS ***
       SQL.ADD("Select TipoDevengado,Fecha,Monto ")
       SQL.ADD("from "~DBO~".MOVDEVENGADOS where NrOperacion='"~val(z1)~"' and NrSaldo=160 ")
       SQL.ADD("and Fecha>="~IdxDate2(val(cw:&i))~" and Fecha<="~IdxDate2(val(z22))~" and Cupon='"~Fstr(val(ss4),0,0)~"' ")
       SQL.ADD("and Monto > 0 ")
       Recorrer SQL
         ACD(z2,val(z22))
         ACN(zz7,FBN['Monto']*-1)
         ACT(zz4,FBN['TipoDevengado'])
         ACN(zz3,160)
         (.'CANPRE11'.)
         SQL.EXEC
       Proximo       
    endif
  Proximo
  ACD(z2,val(z23))
endif
