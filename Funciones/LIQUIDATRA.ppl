SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = T.NrTrans")
SQL.ADD("  and M.NrOperacion = B.NrOperacion")
SQL.ADD("  and B.NrBit = 1 ")
SQL.ADD("  and B.Valor = '1' ") 
SQL.ADD("  and M.Cliente = T.Cliente1 ")
SQL.ADD("  and M.Cliente = 'CV' ")
SQL.ADD("  and M.NrSaldo = 1 ")
*SQL.ADD("  and M.Mercado  =   '"~Dialogo.Vehiculo1~"' ")
*if [Dialogo.Radio6=1] y [Dialogo.Radio7<3]
*    SQL.ADD("  and M.FechaMov  between '"~IdxDate(Dialogo.Fecha2)~"' and '"~IdxDate(Dialogo.Fecha3)~"' ")
*else
    SQL.ADD("  and M.FechaMov    <= '"~IdxDate(Dialogo.Fecha1)~"' ")
*endif

*SQL.ADD("  and M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")

*if NoVacio(Dialogo.Cliente1)
*  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
*endif

if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif

SQL.ADD("and M.Concepto = 'BOLSA' ") 
SQL.ADD("and M.NrMov =  7 ")
SQL.ADD("and M.NrGrupo =  4 ")
SQL.ADD("and T.TipoTr2 in ('AJCASH','AJCAPR')  ")



