IF Val(XX:2) = 0
 If Val(XX:1) = 0
 If NoVacio(SQL("Select NrUnicoAsiento from "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M Where M.Codigo = A.Modelo AND M.TipoAsiento in ("~Pipe2Comillas(Val(TA:1))~") AND A.Fecha1="~Idxdate2(val(FD:1))~" and A.NrLote<>0"))
      *NO ELIMINO NADA PORQUE HAY ASIENTOS ENVIADOS
      IF Dialogo.Radio1=1
        MessageBox('Tiene asientos enviados.')
      Else
        Message('Tiene asientos enviados.')
      ENDIF
      ACN(XX:2,1)
    ELSE
    If NoVacio(SQL("Select NrUnicoAsiento from "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M Where M.Codigo = A.Modelo AND M.TipoAsiento in ("~Pipe2Comillas(Val(TA:1))~") AND A.Fecha1="~Idxdate2(val(FD:1))~" AND A.Book = '"~val(VK:1)~"' and (A.NrLote=0 OR A.NrLote = NULL)"))
      *ELIMINO PORQUE HAY ASIENTOS NO ENVIADOS
         If Dialogo.Radio1 = 1 
             *Manual
             If messagebox('Ya existen asientos de '~BuscarCampo('TIPOSASIENTO','Descripcion','Codigo',val(TA:1))~' para esa fecha, desea eliminarlos?',1,2) = 6
               Message('Borrando Asientos Previos')
               SQL.ADD("Delete "~DBO~".ASIENTOSCON1 Where NrUnicoAsiento IN ")
               SQL.ADD("(Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~Idxdate2(val(FD:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(TA:1))~") AND A.Book = '"~val(VK:1)~"')")
               SQL.NEW
               SQL.EXEC
               SQL.ADD("Delete "~DBO~".ASIENTOSCON Where NrUnicoAsiento IN ")
               SQL.ADD("(Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~Idxdate2(val(FD:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(TA:1))~") AND A.Book = '"~val(VK:1)~"')")
               SQL.NEW
               SQL.EXEC
               Message(val(NR:1)~' - Modelo: '~val(TO:1))
               SQL.GenerarAsientoOp(val(TO:1), val(NR:1),'','',Var('ASINUM'),Val(FV:1),Val(VH:1),,Val(VK:1),,,,val(TI:1),,val(NR:2),,,,,fsys,val(FD:1))
               SQL.EXEC
             ELSE
               ACN(XX:2,1)
             ENDIF
         ELSE
             *Automatica
             Message('Borrando Asientos Previos')
             SQL.ADD("Delete "~DBO~".ASIENTOSCON1 Where NrUnicoAsiento IN ")
             SQL.ADD("(Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~Idxdate2(val(FD:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(TA:1))~") AND A.Book = '"~val(VK:1)~"')")
             SQL.NEW
             SQL.EXEC
             SQL.ADD("Delete "~DBO~".ASIENTOSCON Where NrUnicoAsiento IN ")
             SQL.ADD("(Select A.NrUnicoAsiento From "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M Where A.Modelo = M.Codigo AND A.Fecha1="~Idxdate2(val(FD:1))~" AND M.TipoAsiento in ("~Pipe2Comillas(Val(TA:1))~") AND A.Book = '"~val(VK:1)~"')")
             SQL.NEW
             SQL.EXEC
             Message(val(NR:1)~' - Modelo: '~val(TO:1))
             SQL.GenerarAsientoOp(val(TO:1), val(NR:1),'','',Var('ASINUM'),Val(FV:1),Val(VH:1),,Val(VK:1),,,,val(TI:1),,val(NR:2),,,,,fsys,val(FD:1))
             SQL.EXEC 
         ENDIF
      ELSE
         Message(val(NR:1)~' - Modelo: '~val(TO:1))
         SQL.GenerarAsientoOp(val(TO:1), val(NR:1),'','',Var('ASINUM'),Val(FV:1),Val(VH:1),,Val(VK:1),,,,val(TI:1),,val(NR:2),,,,,fsys,val(FD:1))
         SQL.EXEC
      ENDIF
      ACN(XX:1,1)
   ENDIF
 ELSE
    Message(val(NR:1)~' - Modelo: '~val(TO:1))
    SQL.GenerarAsientoOp(val(TO:1), val(NR:1),'','',Var('ASINUM'),Val(FV:1),Val(VH:1),,Val(VK:1),,,,val(TI:1),,val(NR:2),,,,,fsys,val(FD:1))
    SQL.EXEC
 ENDIF
ENDIF