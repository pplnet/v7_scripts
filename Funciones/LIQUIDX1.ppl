****** -- Insert

               SQL.ADD("Insert into "~DBO~".TRANSACCIONES2 (")
               SQL.ADD("Especie, ")
               SQL.ADD("Fecha1, ")
               SQL.ADD("Fecha2, ")
               SQL.ADD("Cliente1, ")
               SQL.ADD("Vehiculo1, ")
               SQL.ADD("NrOperacionRef1, ")
               SQL.ADD("TipoTr2, ")
               SQL.ADD("Cantidad1, ")
               SQL.ADD("Cuenta1, ")
               SQL.ADD("Cuenta2, ")
               SQL.ADD("Cuenta5, ")
               SQL.ADD("Cuenta6, ")
               SQL.ADD("Cupon1, ")
               SQL.ADD("Ley1, ")
               SQL.ADD("NrTrans, ")
               SQL.ADD("CB2, ")
               SQL.ADD("CB3, ")
               SQL.ADD("CB4, ")
               SQL.ADD("CB10, ")

               SQL.ADD("Observaciones ")
               SQL.ADD(") Values (")
               SQL.ADD("'"~Val(r:&i)~"', ")
               SQL.ADD("'"~IdxDate(FSys)~"', ")
               SQL.ADD("'"~IdxDate(Val(b:&i))~"', ")
               SQL.ADD("'"~Val(c:&i)~"', ")
               SQL.ADD("'"~Dialogo.Vehiculo1~"', ")
               SQL.ADD("'"~Val(a:&i)~"', ")
               If Val(e:&i) > 0
                  SQL.ADD("'DEP', ")
                  SQL.ADD(""~FStr(Val(e:&i),1,2)~", ")
               Else
                  SQL.ADD("'RET', ")
                  SQL.ADD(""~FStr(-Val(e:&i),1,2)~", ")
               Endif
               SQL.ADD("'"~Val(h:&i)~"', ")
               SQL.ADD("'"~Val(f:&i)~"', ")
               SQL.ADD("'"~Val(h:&i)~"', ")
               SQL.ADD("'"~Val(f:&i)~"', ")
               SQL.ADD("'"~Val(s:&i)~"', ")
               SQL.ADD("'"~Val(g:&i)~"', ")
               SQL.ADD("'"~Val(t:&i)~"', ")
               SQL.ADD(" "~Fstr(Val(v:&i),0,0)~",")
               SQL.ADD(" "~Fstr(Val(vv:&i),0,0)~",")
               SQL.ADD(" "~Fstr(Val(vu:&i),0,0)~",")
               SQL.ADD(" "~Fstr(Val(vw:&i),0,0)~",")
               SQL.ADD(" '"~Val(XX:&i)~"' ")
               SQL.ADD(")")
               SQL.NEW

               SQL.ADD("Insert into "~DBO~".OPERACIONESBITS ")
               SQL.ADD("(NrBit, NrOperacion, Valor) ")
               SQL.ADD("Select NrInstancia, '"~Val(t:&i)~"', '0'")
               SQL.ADD("from "~DBO~".INSTANCIAS ")
               SQL.ADD("where Tabla = 'TRANSACCIONES2'")
               SQL.NEW

               *** Prendo instancias segun si es por DATANET o no
               If Val(v:&i)=0
                  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
                  SQL.ADD(" SET Valor = '1' ")
                  SQL.ADD(" Where NrBit = 1 and NrOperacion = '"~Val(t:&i)~"' ")
               Else
                  SQL.ADD(" UPDATE "~DBO~".OPERACIONESBITS ")
                  SQL.ADD(" SET Valor = "~Fstr(Val(v:&i),0,0))
                  SQL.ADD(" Where NrBit = 17 and NrOperacion = '"~Val(t:&i)~"' ")
               Endif
               SQL.NEW
               Message('Genera Voucher '~Val(t:&i))
               Message('Genera Movimientos de la Transaccion')
               If Val(vv:&i)=0 y Val(vu:&i)=0
                 * Si NO Concilia con datanet los movimientos siguen como antes
                 If Dialogo.Fecha1>FSys
                    SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")
                 Else
                    SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS (")
                    SQL.ADD("FechaEje, ")
                    SQL.ADD("UsuarioEje, ")
                 Endif
               Else
                 * Si Concilia con datanet los movimientos siempre quedan pendientes
                 SQL.ADD("Insert into "~DBO~".MOVPENDIENTES (")
               Endif
               SQL.ADD("NrTrans2, ")
               SQL.ADD("NrOperacion, ")
               SQL.ADD("Leyenda, ")
               SQL.ADD("Cantidad, ")
               SQL.ADD("Cliente, ")
               SQL.ADD("Especie, ")
               SQL.ADD("CallPut, ")
               SQL.ADD("NrSaldo, ")
               SQL.ADD("NrGrupo, ")
               SQL.ADD("NrGrupo2, ")
               SQL.ADD("Bits, ")
               SQL.ADD("Cupon, ")
               SQL.ADD("NrMov, ")
               SQL.ADD("NrInstan, ")
               SQL.ADD("FechaMov, ")
               SQL.ADD("EnteCustodia, ")
               SQL.ADD("Cuenta, ")
               SQL.ADD("Transaccion ")
               SQL.ADD(") Values (")
               If Val(vv:&i)=0 y Val(vu:&i)=0
                 If Dialogo.Fecha1<=FSys
                    SQL.ADD("'"~IdxDate(Hoy)~"', ")
                    SQL.ADD("'"~UsuarioActivo~"', ")
                 Endif
               Endif
               SQL.ADD("'"~Val(t:&i)~"', ")
               SQL.ADD("'"~Val(t:&i)~"', ")
               * Agrego la leyenda del movimiento para en informe de Posicion Bancaria
               If Val(e:&i) > 0
                  ACT(ly:1, 'Cobro - '~Val(i:&i))
               Else
                  ACT(ly:1, 'Pago - '~Val(i:&i))
               Endif
               SQL.ADD(" '"~Val(ly:1)~"' , ")
               SQL.ADD(""~FStr(Val(e:&i),1,2)~", ")
               SQL.ADD("'"~Dialogo.Vehiculo1~"',")
               SQL.ADD("'"~Val(r:&i)~"', ")
               SQL.ADD("'', ")
               * Pongo Saldo 99 si liquida con cheque para que no se duplique el mov en el saldo
               If Val(vu:&i)=1
                 SQL.ADD(""~FStr(99,1,0)~", ")
               Else
                 SQL.ADD(""~FStr(1,1,0)~", ")
               Endif
               SQL.ADD(""~FStr(0,1,0)~", ")
               SQL.ADD(""~FStr(0,1,0)~", ")
               If Val(vv:&i)=0 y Val(vu:&i)=0
                 SQL.ADD("'AV', ")
               Else
                 SQL.ADD("'MV', ")
               Endif
               SQL.ADD("'"~Val(s:&i)~"', ")
               SQL.ADD(""~FStr(0,0,0)~", ")
               SQL.ADD(""~FStr(0,1,0)~", ")
               SQL.ADD("'"~IdxDate(Val(b:&i))~"', ")
               SQL.ADD("'"~Dialogo.Vehiculo1~"', ")
               SQL.ADD("'"~Val(f:&i)~"', ")
               SQL.ADD("'"~Val(g:&i)~"' ")
               SQL.ADD(")")
               SQL.NEW

               *Genera Movimientos Ejecutados de la Operacion
               SQL.ADD("Insert into "~DBO~".MOVEJECUTADOS (")
               SQL.ADD("NrOperacion, ")
               SQL.ADD("FechaMov, ")
               SQL.ADD("Cliente, ")
               SQL.ADD("Especie, ")
               SQL.ADD("NrSaldo, ")
               SQL.ADD("CallPut, ")
               SQL.ADD("FechaEj, ")
               SQL.ADD("PrecioEj, ")
               SQL.ADD("EnteCustodia, ")
               SQL.ADD("Mercado, ")
               SQL.ADD("Formula, ")
               SQL.ADD("Leyenda, ")
               SQL.ADD("Bits, ")
               SQL.ADD("NrGrupo, ")
               SQL.ADD("Concepto, ")
               SQL.ADD("NrGrupo2, ")
               SQL.ADD("NrMov, ")
               SQL.ADD("NrLiq, ")
               SQL.ADD("Status, ")
               SQL.ADD("NrComprob, ")
               SQL.ADD("NrInstan, ")
               SQL.ADD("FechaEje, ")
               SQL.ADD("UsuarioEje, ")
               SQL.ADD("Cuenta, ")
               SQL.ADD("Transaccion, ")
               SQL.ADD("Cupon, ")
               SQL.ADD("NrTrans2, ")
               SQL.ADD("Cantidad ")
               SQL.ADD(") select ")
               SQL.ADD("NrOperacion, ")
               SQL.ADD("FechaMov, ")
               SQL.ADD("Cliente, ")
               SQL.ADD("Especie, ")
               SQL.ADD("NrSaldo, ")
               SQL.ADD("CallPut, ")
               SQL.ADD("FechaEj, ")
               SQL.ADD("PrecioEj, ")
               SQL.ADD("EnteCustodia, ")
               SQL.ADD("Mercado, ")
               SQL.ADD("Formula, ")
               SQL.ADD("Leyenda, ")
               SQL.ADD("Bits, ")
               SQL.ADD("NrGrupo, ")
               SQL.ADD("Concepto, ")
               SQL.ADD("NrGrupo2, ")
               SQL.ADD("NrMov, ")
               SQL.ADD("NrLiq, ")
               SQL.ADD("Status, ")
               SQL.ADD("NrComprob, ")
               SQL.ADD("NrInstan, ")
               SQL.ADD("'"~IdxDate(Hoy)~"', ")
               SQL.ADD("'"~UsuarioActivo~"', ")
               SQL.ADD("'"~Val(f:&i)~"', ")
               SQL.ADD("Transaccion, ")
               SQL.ADD("Cupon, ")
               SQL.ADD("'"~Val(t:&i)~"', ")
               SQL.ADD("Cantidad ")
               SQL.ADD(" from "~DBO~".MOVPENDIENTES ")
               IF Dialogo.Check1 = 1
                   SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
               ELSE
                   SQL.ADD(" Where NrOperacion='"~VAL(a:&i)~"' ")
               ENDIF
               SQL.ADD(" and NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")
               SQL.ADD("and NrSaldo = 1 ")
               SQL.ADD("and FechaMov = '"~IdxDate(Val(b:&i))~"'")
               SQL.ADD("and Cliente = '"~Val(c:&i)~"'")
               SQL.ADD("and Especie = '"~Val(r:&i)~"' ")
               If NoVacio(Val(s:&i))
                  SQL.ADD("and Cupon = '"~Val(s:&i)~"' ")
               Else
                  SQL.ADD("and (Cupon = '"~Val(s:&i)~"' or Cupon is NULL)")
               Endif
               SQL.NEW
               Message(' Se Borran los Movs Pendientes de la operacion')
               SQL.ADD("DELETE FROM "~DBO~".MOVPENDIENTES ")
               IF Dialogo.Check1 = 1
                   SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(Val(LS:&i))~") ")
               ELSE
                   SQL.ADD(" Where NrOperacion='"~VAL(a:&i)~"' ")
               ENDIF
               SQL.ADD(" and NrMov      = "~Fstr(VAL(p:&i),0,0)~" ")
               SQL.ADD("and NrSaldo = 1 ")
               SQL.ADD("and FechaMov = '"~IdxDate(Val(b:&i))~"'")
               SQL.ADD("and Cliente = '"~Val(c:&i)~"'")
               SQL.ADD("and Especie = '"~Val(r:&i)~"' ")
               If NoVacio(Val(s:&i))
                  SQL.ADD("and Cupon = '"~Val(s:&i)~"' ")
               Else
                  SQL.ADD("and (Cupon = '"~Val(s:&i)~"' or Cupon is NULL)")
               Endif
               SQL.NEW
               SQL.EXEC
