#ifdef BIND
    require '..\lib\IntegracionBIND.dll'

    import ServCuenta, 'IntegracionBIND.ServiciosBT'
    let &ServicioCuenta new ServCuenta(GetDataBase())
    * RR:12 Cuenta 
    * RR:13 Suboperacion 
    * RR:15 Importe 
    * RR:10 Nro Orden o Voucher
    * RR:27 Capital 
    * RR:28 Comisiones
    * RR:29 Derechos 
    * RR:30 iva
    * RR:31 intereses
    * RR:32 CodigoEvento
    * RR:33 Fecha Valor 
    
    let &Cuenta &ServicioCuenta.Acreditar(""~Val(RR:12)~"",""~Val(RR:13)~"",""~Val(RR:15)~"",""~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"",""~Val(RR:33)~"",""~Val(RR:27)~"",""~Val(RR:28)~"",""~Val(RR:29)~"",""~Val(RR:30)~"",""~Val(RR:31)~"",""~Val(RR:32)~"")

    ACT(RR:117,&Cuenta.Respuesta)
    ACT(RR:3,&Cuenta.IdProceso)
    ACT(RR:4,&Cuenta.Modulo)
    ACT(RR:5,&Cuenta.SucursalCuenta)
    ACT(RR:6,&Cuenta.Transaccion)
    ACT(RR:8,&Cuenta.Relacion)
    ACT(RR:101,&Cuenta.FechaCont)
    
    if EqStr(Val(RR:117),'OK')
        ACT(RR:1,'OK')
    else
        ACT(RR:1,'NOK')
        ACT(RR:2,&Cuenta.Error)
        MessageBox("No se pudo realizar movimiento en cuenta del cliente: "~&Cuenta.Error)
    endif

    if  SQL("Select Count(*) from "~DBO~".MOVCTASEXT where IdReferencia ='" ~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"'") = 0
        SQL.ADD("INSERT INTO "~DBO~".MOVCTASEXT values('O','"~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"',")
        SQL.ADD("case when '"~Copy(TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41)),1,2)~"'='OR' then 'O' else 'V' end,")
        SQL.ADD("'"~Val(RR:12)~"','DB','"~Val(RR:117)~"','"~&Cuenta.Estado~"',")
        SQL.ADD("'"~&Cuenta.FechaRequerimiento~"','"~&Cuenta.HoraRequerimiento~"','"~&Cuenta.FechaRequerimiento~"',")
        SQL.ADD("'"~Val(RR:5)~"','"~&Cuenta.Moneda~"','"~Val(RR:4)~"','"~&Cuenta.TipoOperacion~"',")
        SQL.ADD("'"~Val(RR:13)~"',"~Val(RR:15)~",'"~Val(RR:3)~"',NULL,'"~Val(RR:8)~"','"~Val(RR:6)~"',")
        SQL.ADD("NULL,'"~&Cuenta.Error~"')")
    else
        SQL.ADD("update "~DBO~".MOVCTASEXT set RespSistExt='"~Val(RR:117)~"',")
        SQL.ADD("Accion='DB',")
        SQL.ADD("Estado='"~&Cuenta.Estado~"',")
        SQL.ADD("FechaEnv='"~&Cuenta.FechaRequerimiento~"',")
        SQL.ADD("HoraEnv='"~&Cuenta.HoraRequerimiento~"',")
        SQL.ADD("FechaValor='"~&Cuenta.FechaRequerimiento~"',")
        SQL.ADD("Suscursal='"~Val(RR:5)~"',")
        SQL.ADD("Moneda='"~&Cuenta.Moneda~"',")
        SQL.ADD("Modulo='"~Val(RR:4)~"',")
        SQL.ADD("TipoOperacion='"~&Cuenta.TipoOperacion~"',")
        SQL.ADD("SubOperacion='"~Val(RR:13)~"',")
        SQL.ADD("IdRespuesta='"~Val(RR:3)~"',")
        SQL.ADD("Relacion='"~Val(RR:8)~"',")
        SQL.ADD("Transaccion='"~Val(RR:6)~"',")
        SQL.ADD("DetalleError='"~&Cuenta.Error~"',")
        SQL.ADD("Importe="~Val(RR:15))
        SQL.ADD("Where IdReferencia='" ~TRIM(Val(RR:10))~TRIM(Val(RR:34))~TRIM(Val(RR:35))~TRIM(Val(RR:41))~"'")
    endif
    SQL.NEW
    SQL.EXEC
#endif
