    *--- Consolidado de Activas/Terceros ----  
    SetFilaActual(22)
    ACN(Val(co1):fac, Val(Val(co1):23)+Val(Val(co1):24)+Val(Val(co1):25)  )
    ACN(Val(co1)+2:fac, ( (Val(Val(co1):23)*Val(Val(co1)+2:23))+(Val(Val(co1):24)*Val(Val(co1)+2:24))+(Val(Val(co1):25)*Val(Val(co1)+2:25))  ) /  Val(Val(co1):fac) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):23)*Val(Val(co1)+1:23))+(Val(Val(co1):24)*Val(Val(co1)+1:24))+(Val(Val(co1):25)*Val(Val(co1)+1:25))  ) /  Val(Val(co1):fac)  )
    else
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):23)*Val(Val(co1)+2:23)*Val(Val(co1)+1:23))+(Val(Val(co1):24)*Val(Val(co1)+2:24)*Val(Val(co1)+1:24))+(Val(Val(co1):25)*Val(Val(co1)+2:25)*Val(Val(co1)+1:25))  ) /  ( (Val(Val(co1):23)*Val(Val(co1)+2:23))+(Val(Val(co1):24)*Val(Val(co1)+2:24))+(Val(Val(co1):25)*Val(Val(co1)+2:25))  )  )
    endif

    *--- Consolidado de Activas/Vinculados ----  
    SetFilaActual(27)
    ACN(Val(co1):fac, Val(Val(co1):28)+Val(Val(co1):29) )
    ACN(Val(co1)+2:fac, ( (Val(Val(co1):28)*Val(Val(co1)+2:28))+(Val(Val(co1):29)*Val(Val(co1)+2:29))  ) /  Val(Val(co1):fac) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):28)*Val(Val(co1)+1:28))+(Val(Val(co1):29)*Val(Val(co1)+1:29))  ) /  Val(Val(co1):fac)  )
    else
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):28)*Val(Val(co1)+2:28)*Val(Val(co1)+1:28))+(Val(Val(co1):29)*Val(Val(co1)+2:29)*Val(Val(co1)+1:29))  ) /  ( (Val(Val(co1):28)*Val(Val(co1)+2:28))+(Val(Val(co1):29)*Val(Val(co1)+2:29)) )  )
    endif

    *--- Consolidado de Activas ----  
    SetFilaActual(18)
    ACN(Val(co1):fac, Val(Val(co1):22)+Val(Val(co1):27) )
    ACN(Val(co1)+2:fac, ( (Val(Val(co1):22)*Val(Val(co1)+2:22))+(Val(Val(co1):27)*Val(Val(co1)+2:27))  ) /  Val(Val(co1):fac) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):22)*Val(Val(co1)+1:22))+(Val(Val(co1):27)*Val(Val(co1)+1:27))  ) /  Val(Val(co1):fac)  )
    else
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):22)*Val(Val(co1)+2:22)*Val(Val(co1)+1:22))+(Val(Val(co1):27)*Val(Val(co1)+2:27)*Val(Val(co1)+1:27))  ) /  ( (Val(Val(co1):22)*Val(Val(co1)+2:22))+(Val(Val(co1):27)*Val(Val(co1)+2:27)) )  )
    endif

    *--- Consolidado de Pasivos/Terceros ----  
    SetFilaActual(33)
    ACN(Val(co1):fac, Val(Val(co1):34)+Val(Val(co1):35) )
    ACN(Val(co1)+2:fac, ( (Val(Val(co1):34)*Val(Val(co1)+2:34))+(Val(Val(co1):35)*Val(Val(co1)+2:35))  ) /  Val(Val(co1):fac) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):34)*Val(Val(co1)+1:34))+(Val(Val(co1):35)*Val(Val(co1)+1:35))  ) /  Val(Val(co1):fac)  )
    else
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):34)*Val(Val(co1)+2:34)*Val(Val(co1)+1:34))+(Val(Val(co1):35)*Val(Val(co1)+2:35)*Val(Val(co1)+1:35))  ) /  ( (Val(Val(co1):34)*Val(Val(co1)+2:34))+(Val(Val(co1):35)*Val(Val(co1)+2:35)) )  )
    endif

    *--- Consolidado de Pasivos/Vinculados ----  
    SetFilaActual(37)
    ACN(Val(co1):fac, Val(Val(co1):38)+Val(Val(co1):39) )
    ACN(Val(co1)+2:fac, ( (Val(Val(co1):38)*Val(Val(co1)+2:38))+(Val(Val(co1):39)*Val(Val(co1)+2:39))  ) /  Val(Val(co1):fac) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):38)*Val(Val(co1)+1:38))+(Val(Val(co1):39)*Val(Val(co1)+1:39))  ) /  Val(Val(co1):fac)  )
    else
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):38)*Val(Val(co1)+2:38)*Val(Val(co1)+1:38))+(Val(Val(co1):39)*Val(Val(co1)+2:39)*Val(Val(co1)+1:39))  ) /  ( (Val(Val(co1):38)*Val(Val(co1)+2:38))+(Val(Val(co1):39)*Val(Val(co1)+2:39)) )  )
    endif

    *--- Consolidado de Pasivos ----  
    SetFilaActual(31)
    ACN(Val(co1):fac, Val(Val(co1):33)+Val(Val(co1):37) )
    ACN(Val(co1)+2:fac, ( (Val(Val(co1):33)*Val(Val(co1)+2:33))+(Val(Val(co1):37)*Val(Val(co1)+2:37))  ) /  Val(Val(co1):fac) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):33)*Val(Val(co1)+1:33))+(Val(Val(co1):37)*Val(Val(co1)+1:37))  ) /  Val(Val(co1):fac)  )
    else
      ACN(Val(co1)+1:fac, ( (Val(Val(co1):33)*Val(Val(co1)+2:33)*Val(Val(co1)+1:33))+(Val(Val(co1):37)*Val(Val(co1)+2:37)*Val(Val(co1)+1:37))  ) /  ( (Val(Val(co1):33)*Val(Val(co1)+2:33))+(Val(Val(co1):37)*Val(Val(co1)+2:37)) )  )
    endif


    *--- Consolidado de TOTAL NETO  ----  
    SetFilaActual(13)
    ACN(Val(co1):fac, Val(Val(co1):18) - Val(Val(co1):31) )
    ACN(Val(co1)+2:fac, ABS(( (Val(Val(co1):18)*Val(Val(co1)+2:18)) - (Val(Val(co1):31)*Val(Val(co1)+2:31))  ) /  Val(Val(co1):fac) ) )
    if Dialogo.Radio8 = 0
      ACN(Val(co1)+1:fac, ABS(( (Val(Val(co1):18)*Val(Val(co1)+1:18)) - (Val(Val(co1):31)*Val(Val(co1)+1:31))  ) /  Val(Val(co1):fac) ) )
    else
      ACN(Val(co1)+1:fac, ABS(( (Val(Val(co1):18)*Val(Val(co1)+2:18)*Val(Val(co1)+1:18)) - (Val(Val(co1):31)*Val(Val(co1)+2:31)*Val(Val(co1)+1:31))  ) /  ( (Val(Val(co1):18)*Val(Val(co1)+2:18)) - (Val(Val(co1):31)*Val(Val(co1)+2:31)) )  ) )
    endif

    *--- Consolidado de Terceros (activo y Pasivo) ----  
    SetFilaActual(15)
    ACN(Val(co1):fac, Val(Val(co1):22) - Val(Val(co1):33) )
    ACN(Val(co1)+2:fac, ABS(( (Val(Val(co1):22)*Val(Val(co1)+2:22)) - (Val(Val(co1):33)*Val(Val(co1)+2:33))  ) /  Val(Val(co1):fac) ))
    if Dialogo.Radio8 = 0 
      ACN(Val(co1)+1:fac, ABS(( (Val(Val(co1):22)*Val(Val(co1)+1:22)) - (Val(Val(co1):33)*Val(Val(co1)+1:33))  ) /  Val(Val(co1):fac) ))
    else
      ACN(Val(co1)+1:fac, ABS(( (Val(Val(co1):22)*Val(Val(co1)+2:22)*Val(Val(co1)+1:22)) - (Val(Val(co1):33)*Val(Val(co1)+2:33)*Val(Val(co1)+1:33))  ) /  ( (Val(Val(co1):22)*Val(Val(co1)+2:22)) - (Val(Val(co1):33)*Val(Val(co1)+2:33)) )  ))
    endif

    *--- Consolidado de Vinculados  (activo y Pasivo)  ----  
    SetFilaActual(16)
    ACN(Val(co1):fac, Val(Val(co1):37) - Val(Val(co1):27) )
    ACN(Val(co1)+2:fac, ABS(( (Val(Val(co1):37)*Val(Val(co1)+2:37)) - (Val(Val(co1):27)*Val(Val(co1)+2:27))  ) /  Val(Val(co1):fac) ))
    if Dialogo.Radio8 = 0 
      ACN(Val(co1)+1:fac, ABS(( (Val(Val(co1):37)*Val(Val(co1)+1:37)) - (Val(Val(co1):27)*Val(Val(co1)+1:27))  ) /  Val(Val(co1):fac) ))
    else
      ACN(Val(co1)+1:fac, ABS(( (Val(Val(co1):37)*Val(Val(co1)+2:37)*Val(Val(co1)+1:37)) - (Val(Val(co1):27)*Val(Val(co1)+2:27)*Val(Val(co1)+1:27))  ) /  ( (Val(Val(co1):37)*Val(Val(co1)+2:37)) - (Val(Val(co1):27)*Val(Val(co1)+2:27)) )  ))
    endif