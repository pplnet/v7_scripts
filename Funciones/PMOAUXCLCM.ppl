Recorrer&i 1,31
  ACN(&i+1:fac, &i)
Proximo
FormatoCeldas(2:fac..&i+1:fac,Exe('F0'))  
AgregarMarco(2:fac..&i+2:fac,2,2,EXE('COLOR10'))

ACT(a:fac+1,'No Financiero')
ACT(a:fac+2, VAR('BCCONLNF')~'* RPC')
ACT(a:fac+3,'Exceso')

ACT(a:fac+5,'No Financiero')
ACT(a:fac+6,'Financiero')
ACT(a:fac+7,'Total')
ACT(a:fac+8, VAR('BCCONLF')~'* RPC')
ACT(a:fac+9,'Exceso')

recorrer&j val(z2),val(z4)
  LinkearHoja('PMCLCD',1,Fecha1=&j,Cliente1=Dialogo.Cliente1)
  *No Financiero
  ACN(bc1,LinkH(1,ax1))
  ACN(bc2,LinkH(1,ax2))
  ACN(bc3,LinkH(1,ax3))

  *Financiero
  ACN(bd1,LinkH(1,ay1))
  ACN(bd2,LinkH(1,ay2))
  ACN(bd3,LinkH(1,ay3))
  
  CerrarHoja('PMCLCD',1,Fecha1=&j,Cliente1=Dialogo.Cliente1)

  ACN(&j-val(z2)+2:fac+1,val(bc1))
  ACN(&j-val(z2)+2:fac+2,val(bc2))
  ACN(&j-val(z2)+2:fac+3,val(bc3))

  ACN(&j-val(z2)+2:fac+5,val(bc1))
  ACN(&j-val(z2)+2:fac+6,val(bd1))
  ACN(&j-val(z2)+2:fac+7,val(bc1)+val(bd1))
  ACN(&j-val(z2)+2:fac+8,val(bd2))
  ACN(&j-val(z2)+2:fac+9,val(bd3))
Proximo

ACN(ag:fac+1, Sum(b:fac+1..af:fac+1))
ACN(ag:fac+2, Sum(b:fac+2..af:fac+2))
ACN(ag:fac+3, Sum(b:fac+3..af:fac+3))

ACN(ag:fac+5, Sum(b:fac+5..af:fac+5))
ACN(ag:fac+6, Sum(b:fac+6..af:fac+6))
ACN(ag:fac+7, Sum(b:fac+7..af:fac+7))
ACN(ag:fac+8, Sum(b:fac+8..af:fac+8))
ACN(ag:fac+9, Sum(b:fac+9..af:fac+9))

SetFont(a:fac+1..a:fac+9,2)
SetFont(b:fac+1..ag:fac+9,1)

AgregarMarco(a:fac+1..ag:fac+3,1,3)
AgregarMarco(a:fac+5..ag:fac+9,1,3)

AgregarMarco(a:fac+3..ag:fac+3,2,2,EXE('COLOR6'))
AgregarMarco(a:fac+9..ag:fac+9,2,2,EXE('COLOR6'))

ACO(1,10)
Recorrer&i 3,32
  ACO(&i,8)
Proximo
