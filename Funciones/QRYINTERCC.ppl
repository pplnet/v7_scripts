SQL.ADD(" Select   Case TipoOp                                   ")
SQL.ADD("          When 'TICO' then  O.TotalBrutoCli3            ")
SQL.ADD("          When 'TICT' then -O.TotalBrutoCli3            ")
** FJL 05/07/22 - Se Agregan Prestamos de Titulos
SQL.ADD("          When 'TIPO' then  O.TotalBrutoCli3            ")
SQL.ADD("          When 'TIDE' then -O.TotalBrutoCli3            ")
SQL.ADD("          END as  Cantidad, C.Razonsocial, E.Nombre,    ")
SQL.ADD("          O.TipoOp, O.FechaOp, O.FechaVto , O.Especie,   ")
SQL.ADD("          O.Cantidad CantOpe, O.Precio1, O.TotalBrutoCli1, ")
SQL.ADD("          O.NrOperacion, O.Mercado, O.Cuenta3 Cuenta, ") 
** FJL 05/07/22 - Se agregan campos que se usan en el recorrer y daba error
SQL.ADD("          C.Codigo Cliente, E.Nombre, O.Mercado2 ") 
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                     ")
SQL.ADD(" where O.FechaVto   >= '"~IdxDate(Dialogo.Fecha1)~"'    ")
SQL.ADD(" and   O.FechaVto   <= '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" and   O.ContraEspecie = '"~Dialogo.Especie1~"'         ")
SQL.ADD(" and   O.NrOperacion   = OB.NrOperacion                 ")
SQL.ADD(" and   O.Cliente1      = C.Codigo                   ")
SQL.ADD(" and   O.Especie       = E.Codigo                       ")
SQL.ADD(" and   OB.Valor =  '1'                                  ")
SQL.ADD(" and   OB.NrBit <>  30                                  ")
SQL.ADD(" and   O.Cuenta3 in ("~val(li1)~")                      ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'              ")
** FJL 05/07/22 - Se Agregan Prestamos de Titulos
*SQL.ADD(" and O.TipoOp in ('TICO','TICT')                        ")
SQL.ADD(" and O.TipoOp in ('TICO','TICT','TIPO','TIDE')                        ")
