if Vacio(SQL("Select NrOperacion from "~DBO~".CAMBIOSBCRA where NrOperacion = '"~FBN['NrOperacion']~"' and TipoOp = '"~val(to1)~"' "))
  SQL.ADD(" Insert Into "~DBO~".CAMBIOSBCRA ")
  SQL.ADD(" (NrOperacion, TipoOp, FechaOp, Cliente, TipoCliente, TipoDocum, NrDocum, RazonSocial,")
  SQL.ADD("  Domicilio, CodigoPostal, CodigoEntidad, Beneficiario, PaisBeneficiario,")
  SQL.ADD("  Corresponsal, CuentaBeneficiario, InsComprado, InsVendido, Concepto, FechaEmbarque,")
  SQL.ADD("  NroOficializacion, Moneda, Cantidad, Precio, Monto, Rectificativa, Arbitraje,")
  SQL.ADD("  Reversa, NrOperacionRef, PaisOrigen,Cuenta1,FechaVto) ")
  SQL.ADD("  Values  ")
  SQL.ADD(" ('"~FBN['NrOperacion']~"', '"~val(to1)~"', '"~IdxDate(FBN['FechaOp'])~"', '"~FBN['Cliente1']~"',")
  SQL.ADD(" '"~val(aa13)~"','"~val(aa1)~"', '"~val(aa2)~"', '"~Reemplazar(FBN['RazonSocial'],"'"," ")~"',") 
  SQL.ADD(" '"~val(aa11)~"', '"~copy(FBN['CodigoPostal'],1,5)~"', '"~val(aa14)~"', '"~copy(FBN['Observac2'],1,50)~"', '"~val(aa5)~"',") 
  SQL.ADD(" '"~val(aa6)~"', '"~val(aa4)~"', '"~copy(FBN['Plaza1'],1,2)~"', '"~copy(FBN['Plaza2'],1,2)~"',")   
  SQL.ADD(" '"~FBN['ConceptoBCRA']~"', '"~IdxDate(FBN['FechaAltaCV'])~"',")
  SQL.ADD(" '"~copy(FBN['CodErrorMae'],1,16)~"', '"~val(aa7)~"', "~val(aa8)~",")
  SQL.ADD(" "~FBN['Precio1']~", "~val(aa9)~", '"~val(aa3)~"', '"~val(aa10)~"',")
  SQL.ADD(" '"~val(aa12)~"', '"~FBN['NrOperacion3']~"', '"~val(aa22)~"', '"~val(aa15)~"','"~IdxDate(FBN['FechaPago'])~"')")
else
  SQL.ADD(" Update "~DBO~".CAMBIOSBCRA set TipoOp = '"~val(to1)~"', FechaOp  = '"~Idxdate(FBN['FechaOp'])~"',")
  SQL.ADD(" Cliente = '"~FBN['Cliente1']~"', TipoDocum = '"~val(aa1)~"' , NrDocum = '"~val(aa2)~"',")
  SQL.ADD(" RazonSocial = '"~Reemplazar(FBN['RazonSocial'],"'"," ")~"' , Domicilio = '"~val(aa11)~"',TipoCliente = '"~val(aa13)~"',")
  SQL.ADD(" CodigoPostal = '"~copy(FBN['CodigoPostal'],1,5)~"', CodigoEntidad = '"~val(aa14)~"',")
  SQL.ADD(" Beneficiario = '"~copy(FBN['Observac2'],1,50)~"', PaisBeneficiario = '"~val(aa5)~"',")       
  SQL.ADD(" Corresponsal = '"~val(aa6)~"', CuentaBeneficiario = '"~val(aa4)~"', ")
  SQL.ADD(" InsComprado = '"~copy(FBN['Plaza1'],1,2)~"', InsVendido = '"~copy(FBN['Plaza2'],1,2)~"', Concepto = '"~FBN['ConceptoBCRA']~"',")
  SQL.ADD(" FechaEmbarque = '"~IdxDate(FBN['FechaAltaCV'])~"', NroOficializacion = '"~copy(FBN['CodErrorMae'],1,16)~"',")
  SQL.ADD(" Moneda = '"~val(aa7)~"', Cantidad = "~val(aa8)~", Precio = "~FBN['Precio1']~",")
  SQL.ADD(" Monto = "~val(aa9)~", Arbitraje = '"~val(aa10)~"',")
  SQL.ADD(" Reversa = '"~val(aa12)~"', NrOperacionRef = '"~FBN['NrOperacion3']~"', PaisOrigen = '"~val(aa22)~"',Cuenta1='"~val(aa15)~"',FechaVto='"~IdxDate(FBN['FechaPago'])~"' ")
  SQL.ADD(" Where  NrOperacion = '"~FBN['NrOperacion']~"' ")
  SQL.ADD(" and TipoOp = '"~val(to1)~"' ")
endif
SQL.NEW
SQL.EXEC
