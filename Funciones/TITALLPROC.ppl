**Generacion TXT IVSA - Verificacion fecha incorporacion

**Si aa:&j =1  verificar si aa:&j+1 es = 2 para la misma especie v:&j y rubrocontable g:&j
**   Si están --> verificar fecha incorporación j:&j vs j:&j+1
**                 Si son iguales generar 2 registros en TXT &j para BIND (tipo 7)
**                               &j+1 para IVSA (tipo 3) sumando VN de &j y &j+1
**                 Si son distintos generar tipo 7 y tipo 3 con datos BIND y tipo 3 solo con valores de IVSA

**Si no hay aa:&j+1=2 para la misma especie grabar seguir con prox reg.
**si aa:&j  =2 y aa:&j-1 >= de:1 verificar si especie y rubrocontable son = 
**                               si fuese asi descartar 
**                               si no es reg IVSA sin saldo en BIND para esa especie/rubro.

**Si no hay aa:&j+1=2 grabar seguir con prox reg.
**si aa:&j  =2 y aa:&j-1 >= de:1 verificar si especie y rubrocontable son = 
**                               si fuese asi descartar 
**                               si no es reg IVSA sin saldo en BIND para esa especie/rubro.

If &j=Val(de:1) y Eqstr(val(aa:&j),'2')
   *-1
   ACT(re:1, '')  
   ACT(re:2, '')
   ACT(re:3, '')
   Recorrer&i 1,21
      ACT(re:1, Val(re:1)~Val(&i:&j))
   Proximo      
else
   If Eqstr(val(aa:&j),'2') y (Not Eqstr(Mirt(Trim(val(v:&j)))~Mirt(Trim(val(g:&j))),Mirt(Trim(val(v:&j-1)))~Mirt(Trim(val(g:&j-1)))))
   *0
      ** Grabar reg2 solo
       ACT(re:1, '')
       ACT(re:2, '')
       ACT(re:3, '')
      Recorrer&i 1,21
         ACT(re:1, Val(re:1)~Val(&i:&j))
      Proximo      
   
   else 
   If Eqstr(val(aa:&j),'2') y (Eqstr(Mirt(Trim(val(v:&j)))~Mirt(Trim(val(g:&j))),Mirt(Trim(val(v:&j-1)))~Mirt(Trim(val(g:&j-1)))))  
         ACT(re:1, '')
         ACT(re:2, '')
         ACT(re:3, '')         
         if Not EqStr(Val(j:&j),Val(j:&j-1))
            *---- Graba linea TXT Solo IVSA ----
            Recorrer&i 1,21
               ACT(re:1, Val(re:1)~Val(&i:&j))
            Proximo           
         Endif     
      else   
      
      if Eqstr(val(aa:&j),'1')
         *1
         if Eqstr(val(aa:&j+1),'2') y EqStr(Val(j:&j),Val(j:&j+1))
            *2
            if Eqstr(Mirt(Trim(val(v:&j)))~Mirt(Trim(val(g:&j))),Mirt(Trim(val(v:&j+1)))~Mirt(Trim(val(g:&j+1))))
               *3
               if EqStr(Val(j:&j),Val(j:&j+1))
                  *4
                  *---- Graba linea TXT BIND y Consolidado IVSA ----
                  ACT(re:1, '')
                  ACT(re:2, '')
                  ACT(re:3, '')
                  Recorrer&i 1,21
                     ACT(re:1, Val(re:1)~Val(&i:&j))
                     if &i=3
                        ACT(re:2, Val(re:2)~Val(cc:&j))
                     else
                        if &i=8 o &i=9
                           ACN(xy1,Num(Val(&i:&j))+Num(val(&i:&j+1)))
                           ACT(xy2, iif(EqStr(Copy(Fstr(Val(xy1),0),1,1),'-'),'-'~Pad0(Copy(Fstr(Val(xy1),0),2,Longitud(Val(xy1))-1),10),Pad0(Fstr(Val(xy1),0),11))) 
                           ACT(re:2, Val(re:2)~Val(xy2))
                        else
                           ACT(re:2, Val(re:2)~Val(&i:&j))
                        endif
                     endif
                  Proximo
              else
                 *---- Graba linea TXT BIND y Consolidado IVSA + IVSA distinta fecha ----
                 ACT(re:1, '')
                 ACT(re:2, '')
                 ACT(re:3, '')
                 Recorrer&i 1,21
                    ACT(re:1, Val(re:1)~Val(&i:&j))
                    if &i=3
                       ACT(re:2, Val(re:2)~Val(cc:&j))
                    else
                       ACT(re:2, Val(re:2)~Val(&i:&j))
                    endif
                    ACT(re:3, Val(re:3)~Val(&i:&j+1))
                 Proximo

              endif
              *4    
            else
               ACT(re:1, '')
               ACT(re:2, '')
               ACT(re:3, '')
               Recorrer&i 1,21
                  ACT(re:1, Val(re:1)~Val(&i:&j))
                  if &i=3
                     ACT(re:2, Val(re:2)~Val(cc:&j))
                  else     
                     ACT(re:2, Val(re:2)~Val(&i:&j))
                  endif
               Proximo      
            endif
            *3
         else
            ACT(re:1, '')
            ACT(re:2, '')
            ACT(re:3, '')
            Recorrer&i 1,21
               ACT(re:1, Val(re:1)~Val(&i:&j))
               if &i=3
                  ACT(re:2, Val(re:2)~Val(cc:&j))
                else     
                  ACT(re:2, Val(re:2)~Val(&i:&j))
                endif               
            Proximo      
         endif
         *2
      else
         ACT(re:1, '')
         ACT(re:2, '')
         ACT(re:3, '')
         Recorrer&i 1,21
            ACT(re:1, Val(re:1)~Val(&i:&j))
            if &i=3
               ACT(re:2, Val(re:2)~Val(cc:&j))
            else     
               ACT(re:2, Val(re:2)~Val(&i:&j))
            endif
         Proximo      
      endif
      endif
      *1   
endif
*0   
endif
*-1   

If Not Eqstr(Val(tb:2),'NO')
   if Novacio(Val(re:1))
      EscribirASCII(Val(re:1))
   endif   
   if Novacio(Val(re:2))
      EscribirASCII(Val(re:2))
   endif  
   if Novacio(Val(re:3))
      EscribirASCII(Val(re:3))
   endif      
Endif