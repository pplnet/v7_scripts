***---PFRME = Precio Final Reseteado en Moneda de Emision
***---IFME = Intereses Corridos Final en Moneda de Emision

SQL.ADD(" Select P.Especie, E.Cotiza, Sum(P.CantidadFin) CantidadFin, P.PFRME+P.IFME PrecioFin, P.Book, ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" 'Consolidado' Vehiculo ")
ELSE
    SQL.ADD(" P.Vehiculo ")
ENDIF
SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" Where P.Especie = E.Codigo ")
IF Val(TP:1) = 1
    ***---PUBLIC
    ACT(TT:1, 'Titulos Publicos')
    SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:1))~") ")
    IF Not CeldaVacia(LS:2)
        ***---PREGAR
        SQL.ADD(" AND P.Especie Not IN ("~Pipe2Comillas(Val(LS:2))~") ")
    ENDIF
    IF Not CeldaVacia(LS:3)
        ***---Notas y Letras
        SQL.ADD(" AND P.Especie Not IN ("~Pipe2Comillas(Val(LS:3))~") ")
    ENDIF
ELSE
    IF Val(TP:1) = 2
        ***---PREGAR
        ACT(TT:1, 'Prestamos Garantizados')
        SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:2))~") ")
    ELSE
        IF Val(TP:1) = 3
            ***---Notas y Letras
            ACT(TT:1, 'Notas y Letras')
            SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:3))~") ")
        ELSE
            IF Val(TP:1) = 4
                ***---ONs
                ACT(TT:1, 'Obligaciones Nacionales')
                SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:4))~") ")
            ELSE
                IF Val(TP:1) = 5
                    ***---Acciones
                    ACT(TT:1, 'Acciones')
                    SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:5))~") ")
                ELSE
                    IF Val(TP:1) = 6
                        ***---FCI de Securities
                        IF Eqstr(Val(AL:2), '1')
                            ACT(TT:1, 'FCI - Securities')
                        ELSE
                            ACT(TT:1, 'FCI - MM')
                        ENDIF
                        SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:6))~") ")
                    ELSE
                        IF Val(TP:1) = 7
                            ***---Fideicomisos
                            ACT(TT:1, 'Fideicomisos')
                            SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Val(LS:7))~") ")
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
    ENDIF
ENDIF
SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Val(LV:4))~")  ")
SQL.ADD(" AND P.NrSaldo = 2 ")
SQL.ADD(" AND ((P.Cupon = E.Cupon) or (P.Cupon IS NULL and E.Cupon IS NULL) or (P.Cupon = 0 and E.Cupon IS NULL) or (P.Cupon IS NULL and E.Cupon = 0)) ")
IF Val(TP:1) = 6
    SQL.ADD(" AND P.TipoNegocio = 'FC' ")
    SQL.ADD(" AND E.Alias2 = '"~Val(AL:2)~"' ")
ELSE
    SQL.ADD(" AND P.TipoNegocio = 'SEC' ")
ENDIF
SQL.ADD(" AND P.Book Is Not Null ")
SQL.ADD(" AND P.Book <> '' ")
SQL.ADD(" AND (E.EsCupon Is Null OR E.EsCupon = 'NO') ")
SQL.ADD(" AND P.Fecha = (Select Max(Fecha) ")
SQL.ADD("               From "~DBO~".POSICIONES2 P2 ")
SQL.ADD("               Where P2.Especie = P.Especie ")
SQL.ADD("               AND (P2.Cupon = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL) or (P.Cupon = 0 and P2.Cupon = 0)) ")
SQL.ADD("               AND P2.Vehiculo = P.Vehiculo ")
SQL.ADD("               AND P2.NrSaldo = P.NrSaldo ")
SQL.ADD("               AND P2.Book = P.Book ")
SQL.ADD("               AND P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("               AND P2.Fecha <= "~IdxDate2(Dialogo.Fecha2)~") ")
IF Dialogo.Radio2 = 0
    SQL.ADD(" Group By E.Cotiza, P.Especie, P.PFRME+P.IFME, P.Book ")
    SQL.ADD(" Order By 2, 1 ")
ELSE
    SQL.ADD(" Group By Vehiculo, E.Cotiza, P.Especie, P.PFRME+P.IFME, P.Book ")
    SQL.ADD(" Order By 6, 2, 1 ")
ENDIF


