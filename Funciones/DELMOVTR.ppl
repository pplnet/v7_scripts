*- VC5: Tabla mp1: NrOperaicon mp22: Nro.Mov
SQL.ADD("DELETE "~DBO~".MOVPENDIENTES" )
SQL.ADD("WHERE NrOperacion='"~val(mp1)~"' and NrMov="~Fstr(val(mp22),0,0)~" ")
SQL.NEW

SQL.ADD("DELETE "~DBO~".MOVEJECUTADOS ") 
SQL.ADD("WHERE NrOperacion='"~val(mp1)~"' and NrMov="~Fstr(val(mp22),0,0)~" ")
SQL.NEW
SQL.EXEC
