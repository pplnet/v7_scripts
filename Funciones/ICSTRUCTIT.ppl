*- Selecciono los campos a listar en a: Campo, b: Tipo, c:Long
SQL.ADD("SELECT C.colid as Nro, O.name as Tabla, C.name as Campo, ")
SQL.ADD("T.name as Tipo,CASE RTrim(T.name) WHEN 'char' THEN  C.length ELSE C.xprec END as Long ")
SQL.ADD("from sysobjects O,syscolumns C, systypes T")
SQL.ADD(" where O.id = C.id ")
SQL.ADD("   and C.xusertype = T.xusertype ")
SQL.ADD("   and O.id > 100 ")
SQL.ADD("   and O.xtype = 'U' ")
SQL.ADD("   and O.name = '"~Mirt(Trim(Dialogo.String1))~"' ")
SQL.ADD("order by C.colid ")

Recorrer SQL
   ACT(a:fac,FBN['Campo'])
   ACT(b:fac,FBN['Tipo'])
   ACN(c:fac,FBN['Long'])
Proximo

*- uf1: Ultima Fila de Campos
acn(uf1,fac)
