ModoReproceso(ConDialogo)

CrearDialogo
  Fecha1   :'Fecha Desde' ;2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar Fecha Desde';NO;habiles(FSys,-1,'ARG')
  Fecha2   :'Fecha Hasta' ;3;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar Fecha Hasta';NO;FSys
  Especie1 :'Especie'     ;4;1
  Cliente1 :'Cliente'     ;5;1
  NrTrans1 :'Nro. Trans'  ;6;1
  Vehiculo1: "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Lista1   : "Tipos Op."  ;7;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where Codigo  like 'T%' ")  
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:2, 'FALLAS')
SetFont(a:2..a:2,1)
ACT(m:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(m:2..m:2,1)
AlinearCeldas(m:2..m:2,'D')

SetFilaActual(3)

ACT(a:FAC, 'Informe de Fallas de Titulos')
SetFont(a:FAC..a:FAC,3)

SetFilaActual(FAC+1)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo :  '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
  else
   ACT(a:FAC+1, 'Vehiculo :  Todos')
endif
ACT(a:FAC+2, 'Fecha Desde:  '~Dialogo.Fecha1)
ACT(c:FAC+2, 'Fecha Hasta:  '~Dialogo.Fecha2)
if NoVacio(Dialogo.especie1)
   ACT(a:FAC+3, 'Especie :  '~BuscarCampo('ESPECIES', 'Nombre','Codigo',Dialogo.Especie1))
  else
   ACT(a:FAC+3, 'Especie :  Todas')
endif
if NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+4, 'Cliente :  '~(BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1)))
  else
   ACT(a:FAC+4, 'Cliente :  Todos')
endif
if NoVacio(Dialogo.NrTrans1)
   ACT(a:FAC+5, 'Transaccion :  '~Dialogo.NrTrans1)
  else
   ACT(a:FAC+5, 'Transaccion :  Todas')
endif
if NoVacio(Dialogo.Lista1)
  ACT(a:FAC+6, 'Tipo de Operaciones : '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(a:FAC+6, 'Tipo de Operaciones : Todos')
endif

SetFilaActual(FAC+8)
ACT(a:FAC, 'Instancia')
ACT(b:FAC, 'Tipo Tr.')
ACT(c:FAC, 'Numero')
ACT(d:FAC, 'F.Falla')

ACT(e:FAC, 'Numero Cta.Cl.')
ACT(f:FAC, 'Cta.Propia')
ACT(g:FAC, 'Codigo')
ACT(h:FAC, 'Cliente')
ACT(i:FAC, 'Monto Trans.')

ACT(j:FAC, 'Monto Cob/Pag')
ACT(k:FAC, 'Monto Fallado')

ACT(l:FAC, 'Estado')
ACT(m:fac, 'Fecha Op.')
ACT(n:FAC, 'Tipo Op.')
ACT(o:FAC, 'Numero Op.')
ACT(p:FAC, 'Monto Op.')
ACT(q:FAC, 'Concepto')
ACT(r:FAC, 'Fecha Mov.')
acn(vx8,fac)

AlinearCeldas(a:FAC..h:FAC,'I')
AlinearCeldas(i:FAC..i:FAC,'D')

AlinearCeldas(l:FAC..n:FAC,'I')
AlinearCeldas(m:FAC..m:FAC,'D')
AlinearCeldas(o:FAC..p:FAC,'D')
SetFont(a:5..p:FAC,2)
AgregarMarco(a:FAC..s:FAC,2,0,Exe('COLOR6'))

SetFilaActual(FAC)

SQL.ADD("Select T.*, M.NrOperacion, M.FechaMov, M.Cantidad, O.NrBit, O.Valor,           ")
SQL.ADD("I.Nombre, M.Leyenda, P.TipoOp, P.FechaOp                                       ")
SQL.ADD("From "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS O, "~DBO~".INSTANCIAS I, "~DBO~".OPERACIONES P ")
SQL.ADD("where T.NrTrans = M.NrTrans2 ")
SQL.ADD("and O.NrOperacion = T.NrTrans ")
SQL.ADD("and M.NrOperacion <> T.NrTrans ")
SQL.ADD("and O.Valor = '1' ")
SQL.ADD("and O.NrBit = 8 ")
SQL.ADD("and O.NrBit = I.NrInstancia ")
SQL.ADD("and I.Tabla = 'TRANSACCIONES2' ")
SQL.ADD("and T.Especie = M.Especie ")
SQL.ADD("and M.NrOperacion = P.NrOperacion ")
SQL.ADD("and M.Concepto = 'TI'        ")

if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Fecha1) o NoVacio(Dialogo.Fecha2)
   SQL.ADD("and T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQl.ADD("and T.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.NrTrans1)
   SQL.ADD("and T.NrTrans = '"~Dialogo.NrTrans1~"' ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and P.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
endif

SQL.ADD("order by T.Especie, T.FechaEj, T.PrecioEj, T.CallPut, T.TipoTr2, T.NrTrans  ")

acn(z4,0)

Watch(SQL.Batch())

recorrer SQL

  IF Not EqStr(FBN['Especie'], Val(Z2)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9) o Not EqStr(FBN['tipotr2'], Val(Z10))
     if val(z4) <> 0
        if vacio(val(z9)) o val(z9) = 0
           ACT(h:FAC,'Total '~val(z10)~'  '~val(z2)~' :')
        else
           ACT(h:FAC,'Total '~val(z10)~'  '~val(z2)~' '~val(z8)~' '~val(z9)~' :')
        endif
        acn(i:fac,val(z3))
        SetFont(a:fac..i:FAC,2)
        ifa
     endif
     ACT(Z10,FBN['tipotr2'])
     acn(z3,0)
  endif

  if Not EqStr(FBN['Especie'], Val(Z2)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9)
     if vacio(fbn['precioej']) o fbn['precioej'] = 0
        ACT(a:FAC,FBN['Especie'])
       else
        ACT(a:FAC,FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     endif
     SetFont(a:fac..a:FAC,2)
     ACT(Z2,FBN['Especie'])
     ACD(Z8,FBN['FechaEj'])
     ACN(z9,FBN['PrecioEj'])
     ifa
  endif
  acn(z4,1)

  IF Not EqStr(FBN['Nrtrans'], Val(Z11))
     ACT(Z11,FBN['Nrtrans'])
     ACT(a:FAC, FBN['Nombre'])
     ColorCeldas(a:fac,clBlue)
     ACT(b:FAC, FBN['TipoTr2'])
     ACT(c:FAC, FBN['NrTrans'])
     ACLT(c:fac,FBN['NrTrans'])
     ACT(e:FAC, BuscarCampo('CUENTAS','Numero','Codigo',FBN['Cuenta1']))
     ACT(f:FAC, FBN['Cuenta2'])
     ACT(g:FAC, FBN['Cliente1'])
     ACT(h:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
     ACT(az1,val(h:FAC))
     ACN(i:FAC, FBN['Cantidad1'])

     if FBN['Cantidad4']>0
       ACN(j:FAC, FBN['Cantidad4'])
       ACN(k:FAC, ABS(FBN['Cantidad3']))
     else
       ACN(j:FAC, 0)
       ACN(k:FAC, FBN['Cantidad1'])
     endif

     ACT(l:FAC, FBN['Ley1'])
     if Not Eqstr(FBN['Ley1'],'FALL')
        SCN(z3, FBN['Cantidad1'])
     endif
*     acd(k:fac, fbn['Fecha1'])
     acd(m:fac, fbn['FechaOp'])
     AlinearCeldas(m:FAC..m:FAC,'D')
  endif

  ACT(n:FAC, iif(NoVacio(fbn['TipoOp']),fbn['TipoOp'],BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion'])))
  ACT(o:FAC, FBN['NrOperacion'])
  ACLO(o:FAC, FBN['NrOperacion'])

  ACN(p:FAC, FBN['Cantidad']*(-1))
  ACT(q:FAC, FBN['Leyenda']~' '~Val(az1))
  acd(r:fac, fbn['FechaMov'])
** FJL 06/09/22 - Isuue 5356 - El campo FechaTransp esta en null para fallas parciales
*  acd(d:fac, fbn['FechaTransp'])
  acd(d:fac, fbn['Fecha3'])
  AlinearCeldas(o:FAC..o:FAC,'D')
  formatoCeldas(i:FAC..k:FAC,exe('F2'))
  formatoCeldas(p:FAC..p:FAC,exe('F2'))
  SetFont(a:fac..r:FAC,1)

proximo

if val(z4) <> 0
   if vacio(val(z9)) o val(z9) = 0
      ACT(h:FAC+1,'Total '~val(z10)~'  '~val(z2)~' :')
     else
      ACT(h:FAC+1,'Total '~val(z10)~'  '~val(z2)~' '~val(z8)~' '~val(z9)~' :')
   endif
   acn(i:fac+1,val(z3))
   SetFont(a:fac+1..i:FAC+1,2)
   ifa
endif

ifa
ifa
ACT(a:FAC, 'Diferimientos de Argenclear ')
SetFont(a:fac,2)

ifa

ACT(a:fac, 'Instancia')
ACT(b:fac, 'Tipo Op.' )
ACT(c:fac, 'Numero ')

ACT(d:fac, 'Fecha Op.' )
ACT(e:fac, 'Fecha Vto. Orig.')
ACT(f:fac, 'Fecha Vto. Actual')

ACT(g:fac, 'Codigo ' )
ACT(h:fac, 'Cliente ')
ACT(i:fac, 'Monto' )
ACT(j:fac, 'Cantidad')
ACT(k:fac, 'Precio' )
ACT(l:fac, 'Moneda' )
ACT(m:fac, 'Especie')

SetFont(a:5..p:FAC,2)
AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR6'))

ifa

******************************************************************
** Se agregan los diferimientos de Argenclear
******************************************************************

SQL.ADD(" Select distinct O.TipoOp, O.NrOperacion, O.Mercado, O.FechaOp, O.FechaVto, O.Cliente1, O.Precio1,I.Nombre,")
SQL.ADD(" O.Especie, O.ContraEspecie, O.Cantidad, O.TotalNetoCli1, C.RazonSocial, O.FechaAltaSisExterno, O.Convenio ")
SQL.ADD(" from  "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS B , "~DBO~".INSTANCIAS I         ")
SQL.ADD(" where  O.Cliente1    = C.Codigo                                                                           ")
SQL.ADD(" AND    O.NrOperacion = B.NrOperacion                                                                      ")
SQL.ADD(" AND    B.NrBit       = 10                                                                                 ")
SQL.ADD(" AND    B.Valor       = '1'                                                                                ")
SQL.ADD(" AND    O.Convenio    = '1'                                                                                ")
SQL.ADD(" AND    B.NrBit       = I.NrInstancia                                                                      ")
SQL.ADD(" AND    I.Tabla       = 'OPERACIONES'                                                                      ")

* --- Toma la fecha de vto original o la de diferimiento --- *

if NoVacio(Dialogo.Fecha1) o NoVacio(Dialogo.Fecha2)
   SQL.ADD(" AND    ((O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'  ) OR       ") 
   SQL.ADD("         (O.FechaAltaSisExterno between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'  AND O.FechaAltaSisExterno IS NOT NULL)) ")
endif

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and    O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                                           ")
Endif

If novacio(Dialogo.Cliente1)
   SQL.ADD(" and    O.Cliente1 = '"~Dialogo.Cliente1~"'                                                             ")
Endif

if NoVacio(Dialogo.Especie1)
   SQl.ADD("and    O.Especie = '"~Dialogo.Especie1~"'                                                               ")
endif

SQL.ADD(" and    O.TipoOp In ('TIC','TIV','TIFV','TIFC')                                                            ")
SQL.ADD(" and    O.Mercado in ("~Pipe2Comillas(VAR('MERCAACMC'))~")                                                                  ")
SQL.ADD(" and    O.NrOperacion not in (select NrOperacion from  "~DBO~".MOVEJECUTADOS M                             ")
SQL.ADD("                              where  M.NrOperacion = O.NrOperacion )                                       ")
SQL.ADD(" order by O.NrOperacion                                                                                    ")

Recorrer SQL
   ACT(a:fac, fbn('Nombre'))
   ACT(b:fac, fbn('TipoOp'))
   ACT(c:fac, fbn('NrOperacion'))

   ACD(d:fac, fbn('FechaOp'))
   ACD(e:fac, fbn('FechaAltaSisExterno'))
   ACD(f:fac, fbn('FechaVto'))

   ACT(g:fac, fbn('Cliente1'))
   ACT(h:fac, Copy(FBN['RazonSocial'],1,30))
   ACN(i:fac, fbn('TotalNetoCli1'))
   ACN(j:fac, fbn('Cantidad'))
   ACN(k:fac, fbn('Precio1'))
   ACT(l:fac, fbn('ContraEspecie'))
   ACT(m:fac, fbn('Especie'))  

Proximo

ACO(1,12)
ACO(2,5)
ACO(3,7)
ACO(4,7)
ACO(5,10)
ACO(6,10)
ACO(7,6)
ACO(8,20)
ACO(9,10)

ACO(10,10)
ACO(11,10)

ACO(12,5)
ACO(13,7)
ACO(14,5)
ACO(15,7)
ACO(16,9)
ACO(17,25)
ACO(18,9)

Impresion(1,2)
SetFilaActual(FAC+3)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(r:FAC)
SetPrintFit(2)
RangoTitulo(a:1..s:fac+1, val(vx8))
