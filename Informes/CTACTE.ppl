ModoReproceso(ConDialogo)
CrearDialogo
  Corredor1:'Corredor' ;;;;;;Novacio(Dialogo.Corredor1);'Debe ingresar un Corredor';NO;
  Fecha1   :'F.Desde'    ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar Fecha Desde';NO;PriDeMes(Fsys,NO,'ARG')
  Fecha2   :'F.Hasta'    ;;;;;;NoVacio(Dialogo.Fecha2) y Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar Fecha Hasta valida';NO;FSys
  Vehiculo1: 'Vehiculo'  ;;;;;;;;NO;VAR('VEHICULODE')
FinDialogo

IF Not Ok
   Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)

ACT(a:FAC, 'Movimientos por Corredor')
SetFont(a:fac..a:fac,3)

SetFilaActual(3)
ACN(w1,FAC)

ACN(Q1, Cotizacion('USD',,,,FSYS,1))

ACT(a:FAC+1, 'Corredor: '~BuscarCampo('Corredores','Nombre','Codigo',Dialogo.Corredor1))
ACT(a:FAC+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'F.Hasta: '~Dialogo.Fecha2)
ACT(e:FAC+3, 'Cotizacion USD:  '~Val(q1))
IF NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+4, 'Vehiculo : '~Dialogo.Vehiculo1)
ELSE
   ACT(a:FAC+3, 'Vehiculo : Todos')
ENDIF

SetFilaActual(9)

ACT(a:FAC, 'Fecha Mov.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Descripcion')
ACT(e:FAC, 'Debitos')
ACT(f:FAC, 'Creditos')
*ACT(g:FAC, 'Saldo')
ACT(h:FAC, 'Estado')

AlinearCeldas(a:FAC..a:FAC,'D')
AlinearCeldas(b:FAC..d:FAC,'I')
AlinearCeldas(e:FAC..g:FAC,'D')
SetFont(a:Val(w1)..h:FAC,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))

SetFilaActual(FAC+1)

*ACT(e:FAC, 'Saldo Inicial')
*ACN(g:FAC, Saldo(Dialogo.Corredor1,'ARP',,,,,,1,Dialogo.Fecha1-1)+Saldo(Dialogo.Corredor1,'USD',,,,,,1,Dialogo.Fecha1-1)*Val(q1))

SQL.ADD("SELECT NrOperacion, FechaMov, Cliente, Especie, Cantidad, Leyenda, NrSaldo, FechaEje, 'Ejecutado' est  ")
SQL.ADD("FROM   "~DBO~".MOVEJECUTADOS  ")
SQL.ADD("WHERE  Cliente = '"~Dialogo.Corredor1~"' ")
SQL.ADD("       and FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("     and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
ENDIF
SQL.ADD("UNION ")
SQL.ADD("SELECT NrOperacion, FechaMov, Cliente, Especie, Cantidad, Leyenda, NrSaldo, FechaEje, 'Pendiente' est  ")
SQL.ADD("FROM   "~DBO~".MOVPENDIENTES  ")
SQL.ADD("WHERE  Cliente = '"~Dialogo.Corredor1~"' ") 
SQL.ADD("       and FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("     and EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
ENDIF
SQL.ADD("ORDER BY 2, 1 ")

ACN(de1, fac+1)
Recorrer SQL
  ACT(a:FAC, FBN['FechaMov'])
  ACT(b:FAC, FBN['NrOperacion'])
  ACLO(b:fac, fbn('NrOperacion'))
  ACT(c:FAC, FBN['Especie'])
  ACT(d:FAC, FBN['Leyenda'])

  IF FBN['Cantidad']<0
     IF EqStr(FBN['Especie'],'USD')
        ACN(e:FAC, FBN['Cantidad']*Val(q1))
     ELSE
        ACN(e:FAC, FBN['Cantidad'])
     ENDIF
  ELSE
     IF EqStr(FBN['Especie'],'USD')
        ACN(f:FAC, FBN['Cantidad']*Val(q1))
     ELSE
        ACN(f:FAC, FBN['Cantidad'])
     ENDIF
  ENDIF
  ACT(h:FAC, FBN['est'])
  AlinearCeldas(a:fac..a:fac,'D')
Proximo

IF FAC>Val(w1)+8
   Recorrer&i Val(de1),FAC
      IF &i = Val(de1)
        ACN(g:&i, Val(g:&i-1)-Val(e:&i)+Val(f:&i))
      ELSE
        ACN(g:&i, Val(g:&i-1)-Val(e:&i)+Val(f:&i))
      ENDIF
   Proximo
ELSE
   IFA
*   ACT(a:FAC, 'No Hay Movimientos')
ENDIF

AgregarMarco(a:Val(w1)+8..h:FAC,2)
SetFont(a:Val(w1)+8..n:FAC+1,1)

ACO(1,7)
ACO(2,6)
ACO(3,5)
ACO(4,12)
ACO(5,8)
ACO(6,8)
ACO(7,8)
ACO(8,6)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(f:FAC)
CrearFont(6,"Arial,6,B")
RangoTitulo(a:Val(w1)+6..i:FAC, 8)
