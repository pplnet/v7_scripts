ModoReproceso(SinDialogo)
CrearDialogo
  CuentaContable1      : 'Cuenta Cont'   
  TipoOp1              : 'TipoOp'     
  Especie1             : 'Especie'
  Vehiculo1            : 'Vehiculo'
FinDialogo

If Not Ok
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,8,BI")

IFA

ACT(E:fac, 'Relación Cuenta')

If NoVacio(Dialogo.CuentaContable1)
  ACT(a:fac+2, 'Cuenta Contable: '~Dialogo.CuentaContable1)
Else
  ACT(a:fac+2, 'Cuenta Contable: Todos')
EndIf

If NoVacio(Dialogo.TipoOp1)
  ACT(a:fac+3, 'TipoOp: '~Dialogo.TipoOp1)
Else
  ACT(a:fac+3, 'TipoOp: Todos')
EndIf

If NoVacio(Dialogo.Especie1)
  ACT(a:fac+4, 'Especie: '~Dialogo.Especie1)
Else
  ACT(a:fac+4, 'Especie: Todos')
EndIf

If NoVacio(Dialogo.Vehiculo1)
  ACT(a:fac+5, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
  ACT(a:fac+5, 'Vehiculo: Todos')
EndIf

SetFont(A:fac..Z:fac+5, 2)
SetFont(A:fac, 3)
SetFilaActual(fac+7)

ACT(B:fac, 'Cuenta')
ACT(A:fac, 'Codigo')
ACT(C:fac, 'TiposOperacion')
ACT(D:fac, 'Especies')
ACT(E:fac, 'Vehiculos')
ACT(F:fac, 'Tabla')
ACT(G:fac, 'Residente')
ACT(H:fac, 'Vinculado')
ACT(I:fac, 'Sector')
ACT(J:fac, 'TipoImporte')
ACT(K:fac, 'CentroCosto')
ACT(L:fac, 'Libro')

AlinearCeldas(A:fac..L:fac, 'C')
SetFont(A:fac..L:fac, 2)
AgregarMarco(A:fac..L:fac, 0, 0, EXE('COLOR6'))

SQL.ADD(" Select * from "~DBO~".RELACIONCUENTA ")
SQL.ADD(" Where Cuenta=Cuenta ")
If NoVacio(Dialogo.CuentaContable1)
  SQL.ADD(" And Cuenta='"~Dialogo.CuentaContable1~"' ")
EndIf
If NoVacio(Dialogo.TipoOp1)
SQL.ADD(" And TiposOperacion Like '%"~Dialogo.TipoOp1~"|%' ")
EndIf
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" And Especies Like '%"~Dialogo.Especie1~"|%' ")
EndIf
If NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" And Vehiculos Like '%"~Dialogo.Vehiculo1~"|%' ")
EndIf
SQL.ADD(" Order by Cuenta, Codigo ")
Recorrer SQL

  ACT(B:fac, fbn('Cuenta'))
  ACT(A:fac, fbn('Codigo'))
  ACT(C:fac, fbn('TiposOperacion'))
  ACT(D:fac, fbn('Especies'))
  ACT(E:fac, fbn('Vehiculos'))
  ACT(F:fac, fbn('Tabla'))
  ACT(G:fac, fbn('Residente'))
  ACT(H:fac, fbn('Vinculado'))
  ACT(I:fac, fbn('Sector'))
  ACT(J:fac, fbn('TipoImporte'))
  ACT(K:fac, fbn('CentroCosto'))
  ACT(L:fac, fbn('Libro'))

  AlinearCeldas(A:fac..B:fac, 'C')
  AlinearCeldas(F:fac..L:fac, 'C')
  SetFont(A:fac..L:fac, 1)

Proximo

ACT(A:fac+2, 'Fin del informe.')
SetFont(A:fac+2, 2)

ACO(1, 6)
ACO(2, 9)
ACO(3, 50)
ACO(4, 50)
ACO(5, 50)
ACO(6, 7)
ACO(7, 7)
ACO(8, 7)
ACO(9, 6)
ACO(10, 8)
ACO(11, 8)
ACO(12, 5)

LimitesVision(L:fac+2)
SetPrintFit(3, 46)
Impresion(1, 2)