ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"                          ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1     : "Fecha"                             ;  ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Radio2     : "Moneda|Pesos|Dolares"              ;  ; ;;;;;;;0;
  Cliente1   : "Cliente"                           ;  ; ;;;;NoVacio(Dialogo.Cliente1);'Debe ingresar el nro. de Cuenta';NO;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(xz1, Hora(Ahora))

SQL.ADD(" SELECT S1.Especie, CU.Nombre as NomCuenta, S1.Cupon, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("        E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion DescEst, ")
SQL.ADD("        EC.Codigo,SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC, E.Cotiza,CU.NrDepositante,E.Indexado,E.Indice,E.Codigo CodEsp ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".ESTADOSCUSTODIA EC, ")
SQL.ADD(" "~DBO~".CUENTAS CU ")
SQL.ADD("WHERE S1.Cliente = C.Codigo AND CU.Codigo = S1.Cuenta AND ")
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD("   S1.Cliente = '"~Dialogo.Cliente1~"' AND ")
ENDIF
SQL.ADD("      E.Codigo = S1.Especie AND ")
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
* 25/03/2021 Temporario No sumar los saldos de LD y Bloqueo por parking
SQL.ADD("      ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201 AND S1.NrSaldo not in(121,227)) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) and ")
SQL.ADD("      (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, CU.Nombre, S1.Cupon, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion, EC.Codigo,E.Alias5, E.InteresesC, E.Cotiza,CU.NrDepositante,E.Indexado,E.Indice,E.Codigo ")
SQL.ADD("ORDER BY S1.Especie, S1.Cupon, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo ")
watch(sql.batch)
ACT(d1, 'Saldo de Custodia al '~Dialogo.Fecha1)

SetFont(d1..d2,3)
AlinearCeldas(d1..d2,'C')

ACT(h1, 'Fecha: '~IdxDate(Fsys))
ACT(a3, 'Moneda: '~IIF(Dialogo.Radio2=0, 'Pesos','Dolares'))

If NoVacio(Dialogo.Cliente1)
   ACT(a4, "Cliente: "~Dialogo.Cliente1)
EndIf

SetFont(a3..h4,2)

SetFilaActual(6)

ACT(a:fac, 'Especie')
ACT(b:fac, 'Cupon')
ACT(c:fac, 'Ubic.')
ACT(d:fac, 'Cliente')
ACT(e:fac, 'Comitente')
ACT(f:fac, 'Estado')
ACT(g:fac, 'Valor Nominal')
ACT(h:fac, 'Valor Tecnico')
ACT(i:fac, 'Valuacion Val Tec.')
ACT(j:fac, 'V.R.')
ACT(k:fac, 'Valuacion')

ACO(1, 14)
ACO(2, 5)
ACO(3, 3)
ACO(4, 20)
ACO(5, 8)
ACO(6,12)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)
ACO(11,10)

SetFont(a:fac..k:fac,2)
AgregarMarco(a:fac..k:fac,0,0,Exe('COLOR'))

* Variable Especie
ACT(az2, '')

* Variable Mercado
ACT(az3, '')

* Variable Cliente
ACT(az4, '')

* Variable Cuenta
ACT(az5, '')

* Acumulador Especie VN
ACN(ay2, 0)

* Acumulador Mercado VN
ACN(ay3, 0)

* Acumulador Cliente VN
ACN(ay4, 0)

* Acumulador Especie VR
ACN(ax2, 0)

* Acumulador Mercado VR
ACN(ax3, 0)

* Acumulador Cliente VR
ACN(ax4, 0)

* Acumulador General Valuacion
ACN(aw1, 0)

* Acumulador Especie Valuacion
ACN(aw2, 0)

* Acumulador Mercado Valuacion
ACN(aw3, 0)

* Acumulador Cliente Valuacion
ACN(aw4, 0)

ACN(fi1, fac)
SetFilaActual(Val(fi1))

Recorrer SQL

   SCN(fi1, 1)

   IF Not EqStr(FBN['Especie']~FBN['Cupon'], Val(az2))
      IF Val(ay2)<>0 o Val(ay4)<>0  o Val(ay3)<>0
         ACT(f:Val(fi1), 'Total Cliente --->')
         ACN(g:Val(fi1), Val(ay4))
         ACN(j:Val(fi1), Round(Val(ax4),val(vr2)) )
         ACN(k:Val(fi1), Val(aw4))
         SetFont(f:Val(fi1)..k:Val(fi1),2)
         ACN(ax4, 0)
         ACN(ay4, 0)
         ACN(aw4, 0)
         SCN(fi1, 1)
         ACT(f:Val(fi1), 'Total Ubicacion --->')
         ACN(g:Val(fi1), Val(ay3))
         ACN(j:Val(fi1), Round(Val(ax3),val(vr2)))
         ACN(k:Val(fi1), Val(aw3))
         SetFont(f:Val(fi1)..k:Val(fi1),2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         SCN(fi1, 1)
         ACT(f:Val(fi1), 'Total Especie --->')
         ACN(g:Val(fi1), Val(ay2))
         ACN(j:Val(fi1), Round(Val(ax2),val(vr2)))
         ACN(k:Val(fi1), Val(aw2))
         SetFont(f:Val(fi1)..k:Val(fi1),2)
         ACN(ax2, 0)
         ACN(ay2, 0)
         ACN(aw2, 0)
         SCN(fi1, 2)
      ENDIF

      ACT(a:Val(fi1), FBN['CodEsp']~' - '~FBN['Nombre'])
      ACT(b:Val(fi1), FBN['Cupon'])
      ACT(az2, FBN['Especie']~FBN['Cupon'])
      ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACT(c:Val(fi1), FBN['Mercado'])
      ACT(az3, FBN['Mercado'])
      ACT(d:Val(fi1), FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az4, FBN['Cliente'])

      ACT(e:Val(fi1), FBN['NrDepositante'])

      ACT(az5, FBN['Cuenta'])
      SetFont(a:Val(fi1)..d:Val(fi1),2)

      acn(vr2,FBN['Alias5'])
   ENDIF

   IF Not EqStr(FBN['Mercado'], Val(az3))
      IF Val(ay2)<>0 o Val(ay4)<>0  o Val(ay3)<>0
         ACT(f:Val(fi1), 'Total Cliente --->')
         ACN(g:Val(fi1), Val(ay4))
         ACN(j:Val(fi1), Round(Val(ax4),val(vr2)) )
         ACN(k:Val(fi1), Val(aw4))
         SetFont(f:Val(fi1)..k:Val(fi1),2)
         ACN(ax4, 0)
         ACN(ay4, 0)
         ACN(aw4, 0)
         SCN(fi1, 1)
         ACT(f:Val(fi1), 'Total Ubicacion --->')
         ACN(g:Val(fi1), Val(ay3))
         ACN(j:Val(fi1), Round(Val(ax3),val(vr2)) )
         ACN(k:Val(fi1), Val(aw3))
         SetFont(f:Val(fi1)..k:Val(fi1),2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         SCN(fi1, 1)
      ENDIF

      ACT(c:Val(fi1), FBN['Mercado'])
      ACT(az3, FBN['Mercado'])
      ACT(d:Val(fi1), FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az4, FBN['Cliente'])
      ACT(az5, FBN['Cuenta'])
      ACT(e:Val(fi1), FBN['NrDepositante'])
      SetFont(c:Val(fi1)..d:Val(fi1),2)
   ENDIF

   IF Not EqStr(FBN['Cliente'], Val(az4))
      IF Val(ay2)<>0 o Val(ay4)<>0  o Val(ay3)<>0
         ACT(f:Val(fi1), 'Total Cliente --->')
         ACN(g:Val(fi1), Val(ay4))
         ACN(j:Val(fi1), Round(Val(ax4),val(vr2)))
         ACN(k:Val(fi1), Val(aw4))
         SetFont(f:Val(fi1)..k:Val(fi1),2)
         ACN(ax4, 0)
         ACN(ay4, 0)
         ACN(aw4, 0)
         SCN(fi1, 1)
      ENDIF

      ACT(d:Val(fi1), FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az4, FBN['Cliente'])
      ACT(az5, FBN['Cuenta'])
      ACT(e:Val(fi1), FBN['NrDepositante'])
      SetFont(e:Val(fi1),2)
   ENDIF

   IF Not EqStr(FBN['Cuenta'], Val(az5))
      ACT(az5, FBN['Cuenta'])
      ACT(e:Val(fi1), FBN['NrDepositante'])
      SetFont(e:Val(fi1),2)
   ENDIF

   ACT(f:Val(fi1), FBN['DescEst'])

   *- VN
   ACN(g:Val(fi1), FBN['Saldo'])

   *- Intereres Corridos para calcular valuacion
   ACN(yt1, Val(fi1))
   ACD(yu:Val(fi1), Dialogo.Fecha1)
   ACT(yv:Val(fi1), FBN['Especie'])
   ACN(yw:Val(fi1), FBN['Saldo'])
   ACD(yx:Val(fi1), FBN['FechaCambioTasa'])
   ACN(yy:Val(fi1), FBN['TasaIntAnterior'])
   ACN(yz:Val(fi1), FBN['TasaIntVigente'])
   (.'INTERESCLE'.)

   ACN(ca:Val(fi1), Val(zz:Val(fi1)))
   ACN(cb:Val(fi1), VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
   IF Dialogo.Radio2 = 0
      ACN(cc:Val(fi1), CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   ELSE
      ACN(cc:Val(fi1), CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   ENDIF

   ACN(j:Val(fi1), Round(Val(g:Val(fi1))*Val(cb:Val(fi1)),val(vr2)) )

   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(k:Val(fi1), Val(j:Val(fi1))*Val(cc:Val(fi1))+(Val(ca:Val(fi1))*Val(cc:Val(fi1))) ) 
      ELSE
         ACN(k:Val(fi1), Val(j:Val(fi1))*Val(cc:Val(fi1))+Val(ca:Val(fi1)) )
      ENDIF
   ELSE
      ACN(k:Val(fi1), Val(g:Val(fi1))*Val(cc:Val(fi1))+Val(ca:Val(fi1)) )
   ENDIF


      ACT(EE1,FBN['Especie'])
      ACD(EE2,Dialogo.Fecha1)
      ACN(CO1,8)
      (.'VALTECNICO'.)
      *- En Val(co1):Val(fi1) tengo el valor tecnico

      *- Valuacion en Valor Tecnico
      *- Despues de calcular el vt por unidad hay que multiplicarlo por el valor nominal
      ACN(i:Val(fi1), val(g:Val(fi1))*val(Val(co1):Val(fi1)))



   SetFont(g:Val(fi1)..k:val(fi1),1)

   SCN(ay4, Val(g:Val(fi1)))
   SCN(ax4, Val(j:Val(fi1)))
   SCN(aw4, Val(k:Val(fi1)))
   SCN(ay3, Val(g:Val(fi1)))
   SCN(ax3, Val(j:Val(fi1)))
   SCN(aw3, Val(k:Val(fi1)))
   SCN(ay2, Val(g:Val(fi1)))
   SCN(ax2, Val(j:Val(fi1)))
   SCN(aw2, Val(k:Val(fi1)))
   SCN(aw1, Val(k:Val(fi1)))
Proximo


SCN(fi1, 1)
ACT(f:Val(fi1), 'Total Cliente --->')
ACN(g:Val(fi1), Val(ay4))
ACN(j:Val(fi1), Round(Val(ax4),val(vr2)) )
ACN(k:Val(fi1), Val(aw4))
SetFont(f:Val(fi1)..k:Val(fi1),2)
SCN(fi1, 1)
ACT(f:Val(fi1), 'Total Ubicacion --->')
ACN(g:Val(fi1), Val(ay3))
ACN(j:Val(fi1), Round(Val(ax3),val(vr2)) )
ACN(k:Val(fi1), Val(aw3))
SetFont(f:Val(fi1)..k:Val(fi1),2)
SCN(fi1, 1)
ACT(f:Val(fi1), 'Total Especie --->')
ACN(g:Val(fi1), Val(ay2))
ACN(j:Val(fi1), Round(Val(ax2) ,val(vr2)) )
ACN(k:Val(fi1), Val(aw2))
SetFont(f:Val(fi1)..k:Val(fi1),2)
SCN(fi1, 2)
ACT(f:Val(fi1), 'Total Valuacion --->')
ACN(k:Val(fi1), Val(aw1))
SetFont(f:Val(fi1)..k:Val(fi1),2)
SCN(fi1, 2)

FormatoCeldas(h:7..G:Val(FI:1), Exe('F7'))
FormatoCeldas(i:7..H:Val(FI:1), Exe('F3'))
FormatoCeldas(j:7..I:Val(FI:1), Exe('F8'))

ACT(xz2, Hora(Ahora))

SCN(fi1, 4)
ACT(a:Val(fi1), 'Fin del Listado '~VAL(XZ1)~' '~VAL(XZ2))

LimitesVision(l:Val(fi1))
Impresion(1,2)
SetPrintFit(3,87)
RangoTitulo(a:1..l:Val(fi1), 10)
