ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'     ;;;;;;Dialogo.Fecha1>=FSys;'Fecha No Valida';NO;FSys+1
  Radio1   : 'Tipo|Vehiculo|Consolidado' ;;;;;;;;;0
  Lista2   : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Lista1   : 'Especies' ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES") 
FinDialogo

if Not OK
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista2)
   ACT(zz6,Dialogo.Lista2)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACN(az1,Habiles(Dialogo.Fecha1,1,'ARG',SI))

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC,'Flujo de Especies al '~Fecha(Dialogo.Fecha1))
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

If NoVacio(val(zz6))
   ACT(a:FAC+1, 'Vehiculo : '~val(zz6))
EndIf

if NoVacio(Dialogo.Lista1)
   ACT(a:FAC+2, 'Especies: '~Dialogo.Lista1)
  else
   ACT(a:FAC+2, 'Especies: Todas')
endif

ACT(a:FAC+3, 'Tipo: '~iif(Dialogo.Radio1=0,'Por Vehiculo','Consolidado'))

SetFont(A:FAC+1..a:FAC+3,2)

SetFilaActual(FAC+5)

ACT(a:FAC,'Especie')
ACT(b:FAC,'Saldo Inicial')
ACT(b:FAC+1, Fecha(Dialogo.Fecha1))

** Semana 1
ACT(c:FAC, Fecha(Val(az1)))
ACT(d:FAC, Fecha(Habiles(Val(az1),1,'ARG',SI)))
ACT(e:FAC, Fecha(Habiles(Val(az1),2,'ARG',SI)))
ACT(f:FAC, Fecha(Habiles(Val(az1),3,'ARG',SI)))
ACT(g:FAC, Fecha(Habiles(Val(az1),4,'ARG',SI)))
ACT(h:FAC, Fecha(Habiles(Val(az1),5,'ARG',SI)))
ACT(i:FAC, Fecha(Habiles(Val(az1),6,'ARG',SI)))
ACT(j:FAC, Fecha(Habiles(Val(az1),7,'ARG',SI)))

** semana 3
ACN(AZ2,Habiles(Val(az1),8,'ARG',SI))
ACN(AZ3,Val(AZ2)+6)
ACT(k:FAC, 'Semana del '~Fecha(Val(AZ2)))
ACT(k:FAC+1, ' al '~Fecha(VAL(AZ3)))

** semana 4
ACN(AZ4,Habiles(Val(az3),1,'ARG',SI))
ACN(AZ5,Val(AZ4)+6)
ACT(l:FAC, 'Semana del '~Fecha(Val(AZ4)))
ACT(l:FAC+1, ' al '~Fecha(Val(AZ5)))

** mes 2
ACN(AZ6,Habiles(Val(az5),1,'ARG',SI))
ACN(AZ7,Val(AZ6)+29)
ACT(m:FAC, 'Mes del '~Fecha(Val(az6)))
ACT(m:FAC+1, ' al '~Fecha(Val(AZ7)))

** mes 3
ACN(AZ8,Habiles(Val(az7),1,'ARG',SI))
ACN(AZ9,Val(AZ8)+29)
ACT(n:FAC, 'Mes del '~Fecha(Val(az8)))
ACT(n:FAC+1, ' al '~Fecha(Val(AZ9)))

** Posterior
ACT(o:FAC, 'Posterior al '~Fecha(Val(AZ9)))

** total
ACT(p:FAC,' TOTAL  ')   

AlinearCeldas(a:FAC..p:FAC+1,'I')
SetFont(a:FAC..p:FAC+1,2)
AgregarMarco(A:FAC..A:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(b:FAC..j:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(k:FAC..l:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(m:FAC..n:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(o:FAC..o:FAC+1,2,0,Exe('COLOR'))
AgregarMarco(p:FAC..p:FAC+1,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)
ACT(a:FAC,' ')

SQL.ADD("Select EnteCustodia, Especie, FechaMov, SUM(Cantidad) as Sal from "~DBO~".MOVPENDIENTES M, "~DBO~".ESPECIES ")
SQL.ADD("where Especie=Codigo ")
SQL.ADD("and FechaMov>='"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(val(zz6))
   SQL.ADD(" and EnteCustodia IN ("~Pipe2Comillas(val(zz6))~") ")
EndIf
if NoVacio(Dialogo.Lista1)
   SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and NrSaldo=1")
SQL.ADD("and (PrecioEj is Null or PrecioEj=0) ")
SQL.ADD("and FechaEj is Null ")
SQL.ADD("and (CallPut is Null or CallPut=' ') ")
SQL.ADD("Group By EnteCustodia,Especie,FechaMov")
SQL.ADD(" Union ")
SQL.ADD("Select EnteCustodia, Especie, FechaMov, SUM(Cantidad) as Sal from "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES ")
SQL.ADD("where Especie=Codigo ")
SQL.ADD("and FechaMov>='"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(val(zz6))
   SQL.ADD(" and EnteCustodia IN ("~Pipe2Comillas(val(zz6))~") ")
EndIf
if NoVacio(Dialogo.Lista1)
   SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and NrSaldo=1")
SQL.ADD("and (PrecioEj is Null or PrecioEj=0) ")
SQL.ADD("and FechaEj is Null ")
SQL.ADD("and (CallPut is Null or CallPut=' ') ")
SQL.ADD("Group By EnteCustodia,Especie,FechaMov")
SQL.ADD(" Union ")
SQL.ADD("Select S.Cliente, S.Especie,Fecha, ")
SQL.ADD("Sum(S.Saldo) Sal ")
SQL.ADD("from "~DBO~".SALDOSDIA S ")
SQL.ADD("where  ")
SQL.ADD("S.NrSaldo=3 ")
If NoVacio(val(zz6))
   SQL.ADD(" and Cliente IN ("~Pipe2Comillas(val(zz6))~") ")
EndIf
if NoVacio(Dialogo.Lista1)
   SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and  (S.CallPut is Null or S.CallPut = ' ') ")
SQL.ADD("and  S.Fecha=(Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("             where  D.Cliente= S.Cliente ")
SQL.ADD("             and    D.Especie = S.Especie  ")
SQL.ADD("             and   (D.CallPut is Null or D.CallPut = ' ') ")
SQL.ADD("             and    D.Cliente = S.Cliente  ")
SQL.ADD("             and    D.NrSaldo=3 ")
SQL.ADD("             and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("Group By Cliente,Especie,Fecha")
If Dialogo.Radio1=0
   SQL.ADD("Order By EnteCustodia,Especie,FechaMov")
Else 
   SQL.ADD("Order By Especie,EnteCustodia,FechaMov")
EndIf


act(q1,' ')
act(q2,' ')

acn(q3,0)

Recorrer SQL
   If Dialogo.Radio1=0
      If Not EqStr(FBN['EnteCustodia'],Val(Q2)) o Not EqStr(FBN['Especie'],Val(Q1)) 
         * Si es por Vehiculo 
         If Not EqStr(FBN['EnteCustodia'],Val(Q2)) 
            If Dialogo.Radio1=0
               ACT(a:FAC,FBN['EnteCustodia'])
               ACT(Q2,FBN['EnteCustodia'])
            Else 
               ACT(a:FAC,'Consolidado')
            EndIf
            SetFont(a:fac..P:FAC,2)
            act(q1,' ')
            ifa
         EndIf

         If Not EqStr(FBN['Especie'],Val(Q1))
            ACT(a:FAC,FBN['Especie'])
            ACT(Q1,FBN['Especie'])
         Endif
      Else 
          If EqStr(FBN['Especie'],Val(Q1))
             dfa
          Endif
      EndIf    
   Else 

      If EqStr(FBN['Especie'],Val(Q1)) 
         dfa
      EndIf

      * Consolidado Corte solamente por Fecha
      If Not EqStr(FBN['Especie'],Val(Q1)) o Not EqStr(FBN['EnteCustodia'],Val(Q2)) 
         If Not EqStr(FBN['Especie'],Val(Q1))
            ACT(a:FAC,FBN['Especie'])
            ACT(Q1,FBN['Especie'])
         EndIf

         If Not EqStr(FBN['EnteCustodia'],Val(Q2)) 
            ACT(Q2,FBN['EnteCustodia'])            
         EndIF
      EndIf
   EndIf

   acn(q5,fac)

   Message(FBN['EnteCustodia']~' '~FBN['Especie']~' '~FBN['FechaMov']~' ... ')   

   If FBN['FechaMov'] < Fecha(Val(3:10)) 
      If Not DesciendeDeEspecie(fbn['Especie'],'MONEDA')
         * Saldo Inicial
         SCN(b:FAC,fbn['Sal'])
         SCN(p:FAC,FBN['Sal'])
      Else 
         ACN(b:FAC,0)
      EndIf
   Else 
      RecorrerColumnas 3, 10
        IF FBN['FechaMov'] = Fecha(Val(ColCiclo:10))
           SCN(ColCiclo:FAC,-FBN['Sal'])
        endif
      Proximo

      IF FBN['FechaMov'] >= Val(az2) y FBN['FechaMov'] <= Val(az3)
         SCN(k:FAC,-FBN['Sal'])
      ELSE
         IF FBN['FechaMov'] >= val(az4) y FBN['FechaMov'] <= Val(az5)
            SCN(l:FAC,-FBN['Sal'])
         ELSE
            IF FBN['FechaMov'] >= Val(az6) y FBN['FechaMov'] <= Val(az7)
               SCN(m:FAC,-FBN['Sal'])
            ELSE
               IF FBN['FechaMov'] >= Val(az8) y FBN['FechaMov'] <= Val(az9)
                  SCN(n:FAC,-FBN['Sal'])
               else
                  IF FBN['FechaMov'] > Val(az9) 
                     SCN(o:FAC,-FBN['Sal'])
                  ENDIF 
               endif
            ENDIF  
         ENDIF 
      endif
      SCN(p:FAC,-FBN['Sal'])
      scn(q3,1)
   EndIf
   FormatoCeldas(b:fac..p:FAC,Exe('F2')) 
   SetFont(a:fac..P:FAC,1)

Proximo


ACO(1,5)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,7)
ACO(8,7)
ACO(9,7)
ACO(10,12)
ACO(11,12)
ACO(12,12)
ACO(13,12)
ACO(14,12)
ACO(15,12)
ACO(16,10)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(p:FAC)
*RangoTitulo(a:1..l:FAC, Val(w1)+5)
RangoTitulo(a:1..p:FAC, Val(w1)+5)