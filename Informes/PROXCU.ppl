CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,9,B")

*ACN(z1, Habiles(Dialogo.Fecha1,Dialogo.Entero1,'ARG'))
ACN(z1, Habiles(Val(z3),Val(z4),'ARG'))

SetFilaActual(2)
ACT(a:FAC, 'Proximos Cupones')
SetFont(a:fac, 3)

ACT(a:FAC+2, 'D.Fecha: '~Fecha(Val(z3)))
ACT(a:fac+3, 'H.Fecha: '~Fecha(Val(z1)))
SetFont(a:fac+2..a:fac+3, 2)

SetFilaActual(fac+5)
ACT(a:FAC, 'Proximas Actualizaciones de Especies')
SetFont(a:fac, 3)

SetFilaActual(fac+2)
ACT(a:FAC, 'F.Actualziacion')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Tipo')
ACT(d:FAC, 'Estado')
ACT(e:FAC, 'F.Corte')
SetFont(a:fac..e:fac, 2)
AgregarMarco(a:FAC..e:FAC,1,0,Exe("COLOR"))

*SQL.ADD("Select A.*,E.PlazoLiq, A.FechaCorte-(E.PlazoLiq/24) FechaActua ")
*SQL.ADD("  from "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
*SQL.ADD("where A.Especie=E.Codigo ")
*SQL.ADD("  and A.FechaCorte-(E.PlazoLiq/24) >= '"~Idxdate(Val(z3))~"' and A.FechaCorte-(E.PlazoLiq/24) <= '"~IdxDate(Val(z1))~"' ")
*SQL.ADD("order by A.FechaCorte-(E.PlazoLiq/24), Especie")

ACN(w:1, FAC)
SQL.ADD("Select A.*,E.PlazoLiq ")
SQL.ADD("  from "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
SQL.ADD("where A.Especie=E.Codigo ")
SQL.ADD("  and A.FechaCorte >= '"~Idxdate(Val(z3)-10)~"' and A.FechaCorte <= '"~IdxDate(Val(z1)+4)~"' ")
SQL.ADD("order by A.FechaCorte, A.Especie ")
recorrer SQL
  SCN(x:1, 1)
  ACD(j:fac, Habiles(fbn('FechaCorte'),-fbn('Plazoliq')/24,'ARG','SI'))
  ACT(k:fac, fbn('Especie')~'/'~fbn('NrCupon'))
  if EqStr(fbn('TipoCupon'),'REN')
    ACT(l:fac, 'Renta')
  else
    if EqStr(fbn('TipoCupon'),'RYA')
      ACT(l:fac, 'Renta+Amortizacion')
    else
      ACT(l:fac, 'Amortizacion')
    endif
  endif
  if EqStr(fbn('Estado'),'PRO')
    ACT(m:fac, 'Procesado')
  else
    ACT(m:fac, 'Pendiente')
  endif
  ACD(n:fac, fbn('FechaCorte'))
  ACN(o:fac, fbn('PlazoLiq'))
  if Val(j:FAC)>=Val(z3) y Val(j:FAC)<=Val(z1)
    ACT(p:FAC,'OK')
  endif
  SetFont(j:fac..p:fac, 1)
proximo

ACN(w:2, FAC)
SetFilaActual(Val(w:1))
if Val(x:1)>0
  OrdenarFilas(Val(w:1)+1,Val(w:2),10,'A',11)
  recorrer&i Val(w:1)+1,Val(w:2)
    if EqStr(Val(p:&i),'OK')
      IFA
      if Val(j:&i)<>Val(z2)
        ACT(a:fac, 'Fecha: '~Fecha(Val(j:&i)))
        AgregarMarco(a:fac..e:fac, 1)
        ACN(z2, Val(j:&i))
        SetFont(a:fac..z:fac, 1)
        IFA
      endif
      ACD(a:fac, Val(j:&i))
      ACT(b:fac, Val(k:&i))
      ACT(c:fac, Val(l:&i))
      ACT(d:fac, Val(m:&i))
      ACD(e:fac, Val(n:&i))
      SetFont(a:fac..z:fac, 1)
    endif
  proximo
endif
if Val(z:2)=0
  IFA
  ACT(a:FAC, 'No hay actualizaciones en los proximos dias')
  SetFont(a:fac, 1)
endif
    
ACN(z:2, 0)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Proximos Cortes de Cupones')
SetFont(a:fac, 3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'F.Corte')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Tipo')
ACT(d:FAC, 'Estado')
ACT(e:FAC, 'F.Pago')
SetFont(a:fac..e:fac, 2)
AgregarMarco(a:FAC..e:FAC,1,0,Exe("COLOR"))

SQL.ADD("Select * from "~DBO~".AGENDACUPONES")
SQL.ADD("where FechaCorte >= '"~Idxdate(Val(z3))~"' and FechaCorte <= '"~IdxDate(Val(z1))~"' order by FechaCorte, Especie")
recorrer SQL
  if fbn('FechaCorte')<>Val(z2)
     ACT(a:fac, 'Fecha: '~fbn('FechaCorte'))
     AgregarMarco(a:fac..e:fac, 1)
     ACN(z2, fbn('FechaCorte'))
     SetFont(a:fac..z:fac, 1)
     ifa
  endif
  ACD(a:fac, fbn('FechaCorte'))
  ACT(b:fac, fbn('Especie')~'/'~fbn('NrCupon'))
  if EqStr(fbn('TipoCupon'),'REN')
     ACT(c:fac, 'Renta')
  else
    if EqStr(fbn('TipoCupon'),'RYA')
       ACT(c:fac, 'Renta+Amortizacion')
    else
       ACT(c:fac, 'Amortizacion')
    endif
  endif
  if EqStr(fbn('Estado'),'PRO')
     ACT(d:fac, 'Procesado')
  else
     ACT(d:fac, 'Pendiente')
  endif
  ACD(e:fac, fbn('FechaPago'))
  SetFont(a:fac..z:fac, 1)
proximo
if Val(z:2)=0
  IFA
  ACT(a:FAC, 'No hay cortes en los proximos dias')
  SetFont(a:fac, 1)
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del listado')
SetFont(a:fac, 2)

ACO(1, 10)
ACO(2, 10)
ACO(3, 12)
ACO(4, 10)

SetFont(v1..z4, 1)
LimitesVision(f:fac+1)
