*ModoReproceso(ConDialogo)

CrearDialogo
  Fecha1   :'Fecha Desde' ;2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar Fecha Desde';NO;FSys
  Fecha2   :'Fecha Hasta' ;3;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar Fecha Hasta';NO;FSys
  Cliente1 :'Cliente'     ;5;1
  Vehiculo1: "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*ACT(a:2, 'TRAOPE')
SetFont(a:2..a:2,1)
ACT(m:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(m:2..m:2,1)
AlinearCeldas(m:2..m:2,'D')

SetFilaActual(3)

ACT(a:FAC, 'Detalle de Voucher consolidados')
SetFont(a:FAC..a:FAC,3)

SetFilaActual(FAC+1)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo :  '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
  else
   ACT(a:FAC+1, 'Vehiculo :  Todos')
endif
ACT(a:FAC+2, 'Fecha Desde:  '~Dialogo.Fecha1)
ACT(c:FAC+2, 'Fecha Hasta:  '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+3,copy( 'Cliente :  '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1),1,40))
  else
   ACT(a:FAC+3, 'Cliente :  Todos')
endif
SQL.ADD("SELECT * ")
SQL.ADD("FROM "~DBO~".VOUCONSOLIDADOS vou")
SQL.ADD("WHERE ")
if NoVacio(Dialogo.Fecha1) o NoVacio(Dialogo.Fecha2)
   SQL.ADD("vou.Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and vou.Cliente = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD("order by fecha")
acn(z97,12)
acn(z98,12   )
*if NoVacio(Dialogo.Vehiculo1)
*   SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
*endif
recorrer SQL
    *SetFilaActual(FAC+1)
    ACT(a:FAC, 'ID')
    ACT(b:FAC, 'Estado')
    ACT(c:FAC, 'Accion')
    ACT(d:FAC, 'Fecha')
    ACT(e:FAC,'MontoABloquear')
    ACT(f:FAC,'MontoADebCred')
    ACT(g:FAC, 'MontoBloqueado')
    ACT(h:FAC,'MontoDebCred')
    ACT(i:FAC,'Tipo')
    ACT(j:FAC,'Capital') 
    ACT(k:FAC,'Intereses') 
    ACT(l:FAC,'Comisiones') 
    ACT(m:FAC,'Derechos' )
    ACT(n:FAC,'Iva')
    ACT(o:FAC, 'CodEvento')
    ACT(p:FAC, 'Referencia')
    ACT(q:FAC, 'Detalle error')
    SetFont(a:5..r:FAC,2)
    AgregarMarco(a:FAC..q:FAC,2,0,Exe('COLOR'))
    ifa
    
    ACT(a:FAC, fbn('ID'))
    ACT(Z:95, fbn('ID'))
    ACT(b:FAC, fbn('Estado'))
    ACT(c:FAC, fbn('Accion'))
    ACT(d:FAC, fbn('fecha'))
    ACN(e:FAC,fbn('MontoABloquear') )
    ACN(f:FAC,fbn('MontoADebCred'))
    ACN(g:FAC, fbn('MontoBloqueado'))
    ACN(h:FAC,fbn('MontoDebCred'))
    ACT(i:FAC,fbn('Tipo'))
    ACN(j:FAC,fbn('Capital')) 
    ACN(k:FAC,fbn('Intereses')) 
    ACN(l:FAC,fbn('Comisiones')) 
    ACN(m:FAC,fbn('Derechos') )
    ACN(n:FAC,fbn('Iva'))
    ACT(o:FAC, fbn('CodEvento'))
    ACT(p:FAC, fbn('Referencia')~fbn('Refcorte')~fbn('Refaccion'))
    if longitud(val(p:FAC))>val(z97)
       acn(z97,longitud(val(p:FAC)))
    endif
    ACT(q:FAC, fbn('Detalleerror'))
    if longitud(val(q:FAC))>val(z98)
       acn(z98,longitud(val(q:FAC)))
    endif
    FormatoCeldas(e:FAC..m:FAC,exe('F2'))
    SetFont(a:fac..r:FAC,2)
    SetFilaActual(FAC+1)
    ACT(a:FAC, 'Instancia')
    ACT(b:FAC, 'Tipo Tr.')
    ACT(c:FAC, 'Numero')
    ACT(d:FAC, 'Numero Cta.Cl.')
    ACT(e:FAC, 'Cta.Propia')
    ACT(f:FAC, 'Codigo')
    ACT(g:FAC, 'Cliente')
    ACT(h:FAC, 'Monto Trans.')
    ACT(i:FAC, 'Estado')
    ACT(j:fac, 'Fecha')
    ACT(k:FAC, 'Tipo Op.')
    ACT(l:FAC, 'Numero Op.')
    ACT(m:FAC, 'Especie2')
    ACT(n:FAC, 'Monto Esp2')
    ACT(o:FAC, 'Monto Op.')
    ACT(p:FAC, 'Concepto')
    ACT(q:FAC, 'Fecha Mov.')
    ACT(r:FAC, 'Custodia')
    acn(vx8,fac)
    AlinearCeldas(a:FAC..g:FAC,'I')
    AlinearCeldas(h:FAC..h:FAC,'D')
    AlinearCeldas(i:FAC..k:FAC,'I')
    AlinearCeldas(j:FAC..j:FAC,'D')
    AlinearCeldas(l:FAC..o:FAC,'D')
    SetFont(a:fac..r:FAC,2)
    AgregarMarco(a:FAC..r:FAC,2,0,0)
    
    SetFilaActual(FAC)
    
    SQL.ADD("Select 'Vigente' estado_t,")
    sql.add("T.Nrtrans ,")
    sql.add("T.TipoTr2 ,")
    sql.add("T.Cuenta1 ,")
    sql.add("T.Cliente1 ,")
    sql.add(" '"~FBN['Cliente']~"' Cliente ,")
    sql.add("T.Cantidad1 ,")
    sql.add("T.Ley1 ,")
    sql.add("T.Fecha1 ,")
    sql.add("T.Especie1 ,")
    sql.add("T.Cantidad2 ,")
    sql.add("T.Especie ,")
    sql.add("T.Mercado1 ,")
    sql.add("T.fechaej ,")
    sql.add("T.precioej ,")
    sql.add("T.cuenta2 ,")
    sql.add("T.NrOperacionRef2 ,")
    sql.add("M.NrOperacion, M.FechaMov, M.Cantidad, O.NrBit, O.Valor, ")
    SQL.ADD("I.Nombre, M.Leyenda, P.TipoOp ")
    SQL.ADD("From ")
    sql.add(" ("~DBO~".transacciones2 t left join "~DBO~".MOVEJECUTADOS M on T.NrTrans = M.NrTrans2 and M.NrOperacion <> T.NrTrans and T.Especie = M.Especie) left join "~DBO~".OPERACIONES P on M.NrOperacion = P.NrOperacion , ")
    sql.add(" "~DBO~".OPERACIONESBITS O, ")
    sql.add(" "~DBO~".INSTANCIAS I")
    SQL.ADD("where ")
    SQL.ADD("O.NrOperacion = T.NrTrans ")
    SQL.ADD("and O.Valor = '1' ")
    SQL.ADD("and O.NrBit = I.NrInstancia ")
    SQL.ADD("and I.Tabla = 'TRANSACCIONES2' ")
    *if NoVacio(fbn('referencia')) y NoVacio(fbn('refcorte')) y NoVacio(fbn('refaccion'))
    *SQL.ADD("and T.NrTrans in ("~Pipe2Comillas(fbn('referencia'))~Pipe2Comillas(fbn('refcorte'))~Pipe2Comillas(fbn('refaccion'))") ")
       *else
    if NoVacio(fbn('referencia')) o NoVacio(fbn('refcorte')) o NoVacio(fbn('refaccion'))
      SQL.ADD("and T.NrTrans in (")
       if NoVacio(fbn('referencia'))
          SQL.ADD(Pipe2Comillas(fbn('referencia')))
       endif
       if NoVacio(fbn('refcorte'))
          if NoVacio(fbn('referencia'))
              SQL.ADD(",")
          endif
          SQL.ADD(Pipe2Comillas(fbn('refcorte')))
       endif
       if NoVacio(fbn('refaccion'))
          if NoVacio(fbn('referencia')) o NoVacio(fbn('refcorte'))
            SQL.ADD(" , ")
          endif
          SQL.ADD(Pipe2Comillas(fbn('refaccion')))
       endif
       sql.add(" ) ")
    endif
    if NoVacio(Dialogo.Vehiculo1)
       SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    endif
    sql.add("union ")
    SQL.ADD("Select 'Anulado' estado_t,")
    sql.add("T.Nrtrans ,")
    sql.add("T.TipoTr2 ,")
    sql.add("T.Cuenta1 ,")
    sql.add("T.Cliente1 ,")
    sql.add(" '"~FBN['Cliente']~"' Cliente ,")
    sql.add("T.Cantidad1 ,")
    sql.add("T.Ley1 ,")
    sql.add("T.Fecha1 ,")
    sql.add("T.Especie1 ,")
    sql.add("T.Cantidad2 ,")
    sql.add("T.Especie ,")
    sql.add("T.Mercado1 ,")
    sql.add("T.fechaej ,")
    sql.add("T.precioej ,")
    sql.add("T.cuenta2 ,")
    sql.add("T.NrOperacionRef2 ,")
    sql.add("M.NrOperacion, M.FechaMov, M.Cantidad, O.NrBit, O.Valor, ")
    SQL.ADD("I.Nombre, M.Leyenda, '' TipoOp ")
    SQL.ADD("From ")
    sql.add(" ("~DBO~".BTRANSACCIONES2 T left join "~DBO~".MOVEJECUTADOS M on T.NrTrans = M.NrTrans2 and T.Especie = M.Especie and M.NrOperacion <> T.NrTrans),")
    sql.add(" "~DBO~".OPERACIONESBITS O, ")
    sql.add(" "~DBO~".INSTANCIAS I")
    SQL.ADD("where  ")
    SQL.ADD("O.NrOperacion = T.NrTrans ")
    SQL.ADD("and O.Valor = '1' ")
    SQL.ADD("and O.NrBit = I.NrInstancia ")
    SQL.ADD("and I.Tabla = 'TRANSACCIONES2' ")
    *SQL.ADD("and M.NrOperacion = P.NrOperacion ")
    *if NoVacio(fbn('referencia')) y NoVacio(fbn('refcorte')) y NoVacio(fbn('refaccion'))
    *SQL.ADD("and T.NrTrans in ("~Pipe2Comillas(fbn('referencia'))~Pipe2Comillas(fbn('refcorte'))~Pipe2Comillas(fbn('refaccion'))") ")
       *else
    if NoVacio(fbn('referencia')) o NoVacio(fbn('refcorte')) o NoVacio(fbn('refaccion'))
      SQL.ADD("and T.NrTrans in (")
       if NoVacio(fbn('referencia'))
          SQL.ADD(Pipe2Comillas(fbn('referencia')))
       endif
       if NoVacio(fbn('refcorte'))
          if NoVacio(fbn('referencia'))
              SQL.ADD(",")
          endif
          SQL.ADD(Pipe2Comillas(fbn('refcorte')))
       endif
       if NoVacio(fbn('refaccion'))
          if NoVacio(fbn('referencia')) o NoVacio(fbn('refcorte'))
          SQL.ADD(" , ")
          endif
          SQL.ADD(Pipe2Comillas(fbn('refaccion')))
       endif
       sql.add(" ) ")
    endif
    if NoVacio(Dialogo.Vehiculo1)
       SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    endif
    *SQL.ADD("order by T.Especie, T.Mercado1, T.FechaEj, T.PrecioEj, T.CallPut, T.TipoTr2, T.NrTrans     ")
    watch(SQL.BATCH())
    
    acn(z3,0)
    acn(z4,0)
    ACN(Z13,0)
    recorrer SQL
    
      IF Not EqStr(FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'], Val(Z2)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9) o Not EqStr(FBN['tipotr2'], Val(Z10))
         if val(z4) <> 0
            if vacio(val(z9)) o val(z9) = 0
               ACT(g:FAC,'Total '~val(z10)~'  '~val(z2)~' :')
            else
               ACT(g:FAC,'Total '~val(z10)~'  '~val(z2)~' '~val(z8)~' '~val(z9)~' :')
            endif
            acn(h:fac,val(z3))
            acn(n:fac,val(z5))
            SetFont(a:fac..n:FAC,2)
            FormatoCeldas(h:FAC..o:FAC,exe('F2'))
            acn(z13,1)
            ifa
         endif
         ACT(Z10,FBN['tipotr2'])
         acn(z3,0)
         acn(z5,0)
      endif
      if Not EqStr(FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'], Val(Z2)) o FBN['FechaEj']<>Val(Z8) o FBN['PrecioEj']<>Val(Z9)
         if vacio(fbn['precioej']) o fbn['precioej'] = 0
            ACT(a:FAC,FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'])
           else
            ACT(a:FAC,FBN['Especie']~' '~FBN['Mercado1']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
         endif
         SetFont(a:fac..a:FAC,2)
         ACT(Z2,FBN['Especie']~' '~FBN['Especie1']~' '~FBN['Mercado1'])
         ACD(Z8,FBN['FechaEj'])
         ACN(z9,FBN['PrecioEj'])
         ifa
      else
         if val(z13)=0
             ACT(a:FAC,FBN['Especie']~' '~FBN['Mercado1']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
             SetFont(a:fac..a:FAC,2)
             acn(z13,1)
             ifa
         endif
      endif
      acn(z4,1)
    
      IF Not EqStr(FBN['Nrtrans'], Val(Z11)) o Not EqStr(FBN['cliente'], Val(Z12))
         acn(z13,1)
         ACT(Z11,FBN['Nrtrans'])
         ACT(Z12,FBN['Cliente'])
         ACT(a:FAC, FBN['estado_t'])
         ColorCeldas(a:fac,clBlue)
         ACT(b:FAC, FBN['TipoTr2'])
         ACT(c:FAC, FBN['NrTrans'])
         if eqstr(FBN['estado_t'],'Anulado')
            ACLBT(c:fac,FBN['NrTrans'])
         else
            ACLT(c:fac,FBN['NrTrans'])
         endif
         ACT(d:FAC, BuscarCampo('CUENTAS','Numero','Codigo',FBN['Cuenta1']))
         ACT(e:FAC, FBN['Cuenta2'])
         ACT(f:FAC, FBN['Cliente1'])
         ACT(g:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
         ACT(az1,val(g:FAC))
         ACN(h:FAC, FBN['Cantidad1'])
         if eqstr(FBN['TipoTr2'],'LCUPON')
             acn(z96,sql("SELECT isnull(intereses,0)+isnull(comisiones,0)+isnull(derechos,0)+isnull(iva,0)+isnull(capital,0) total FROM "~DBO~".VOUCONSOLIDADOS vou WHERE id = '"~VAL(z95)~"'"))
             ACN(h:FAC, val(z96))
         endif
         ACT(i:FAC, FBN['Ley1'])
         if Not Eqstr(FBN['Ley1'],'FALL')
            if eqstr(FBN['TipoTr2'],'LCUPON')
               SCN(z3, val(z96))
            else
               SCN(z3, FBN['Cantidad1'])
            endif
         endif
         ACD(j:fac, fbn['Fecha1'])
         AlinearCeldas(j:FAC..j:FAC,'D')
      endif
    
      ACT(k:FAC, iif(NoVacio(fbn['TipoOp']),fbn['TipoOp'],BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion'])))
      ACT(l:FAC, FBN['NrOperacion'])
      if NoVacio(FBN['NrOperacion'])
         ACLO(l:FAC, FBN['NrOperacion'])
      endif   
      IF Eqstr(FBN['TipoTr2'],'MATCH')
         ACT(m:FAC, FBN['Especie1'])
         ACN(n:FAC, FBN['Cantidad2'])
         SCN(z5, FBN['Cantidad2'])
      ENDIF   
      if NoVacio(fbn['FechaMov'])
         ACD(q:fac, fbn['FechaMov'])
         ACN(o:FAC, FBN['Cantidad']*(-1))
         ACT(p:FAC, FBN['Leyenda']~' '~Val(az1))
      endif
      if Novacio(fbn['NrOperacionRef2'])
           ACT(r:fac, fbn['NrOperacionRef2'])
           ACLT(r:fac, fbn['NrOperacionRef2'])
      endif
      AlinearCeldas(l:FAC..l:FAC,'D')
      FormatoCeldas(h:FAC..h:FAC,exe('F2'))
      FormatoCeldas(n:FAC..o:FAC,exe('F2'))
      SetFont(a:fac..r:FAC,1)
    
    proximo
    if val(z4) <> 0
       if vacio(val(z9)) o val(z9) = 0
           ACT(g:FAC+1,'Total '~val(z10)~'  '~val(z2)~' :')
       else
           ACT(g:FAC+1,'Total '~val(z10)~'  '~val(z2)~' '~val(z8)~' '~val(z9)~' :')
       endif
       acn(h:fac+1,val(z3))
       acn(n:fac+1,val(z5))
       SetFont(a:fac+1..n:FAC+1,2)
       FormatoCeldas(h:FAC..o:FAC,exe('F2'))
       ifa
       ifa
    endif
proximo



ACO(1,15)
ACO(2,5)
ACO(3,7)
ACO(4,15)
ACO(5,10)
ACO(6,10)
ACO(7,20)
ACO(8,12)
ACO(9,5)
ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,val(z97)/1.65)
ACO(17,val(z98)/1.65)
ACO(18,10)
ACO(19,9)
ACO(20,9)

Impresion(1,2)
SetFilaActual(FAC+3)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(r:FAC)
SetPrintFit(2)
RangoTitulo(a:1..r:fac+1, val(vx8))
