       SQL.ADD("WHERE NrOperacion='"~VAL(V:15)~"'")
    ELSE
       SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES")
       SQL.ADD("WHERE NrOperacion='"~Copy(FBN['NrOperacionRef1'],1,8)~"'")
    ENDIF
    Recorrer SQL
       *--- Esta confirmado si/no?  
       act(n:1,SQL("SELECT NrOperacion FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~fbn['NrOperacion']~"' AND NrBit=4 AND Valor='1'"))
       if NoVacio(fbn['Observac3']) y Not CeldaVacia(n:1)
