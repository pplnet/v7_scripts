    if Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV|TIADJ|TIRES|TCPCEM')
        if [Incluido(FBN['TipoOp'],'TIC|TIV|TIADJ|TIRES') y FBN['FormaLiquidacion2']<2] o [Incluido(fbn['TipoOp'],'TIFC|TIFV') y fbn['FormaLiquidacion1']<2]
           ACN(w1,1)
        else
           ACN(w1,2)
        endif
        if Incluido(fbn['TipoOp'],'TIC|TIFC|TIADJ|TIRES|TCPCEM')
           ACT(v2, 'Comprada')
           ACT(v3, 'DEBITAR')
           ACT(v4, 'ACREDITAR')
           ACN(v5, 1)
        endif
        if Incluido(fbn['TipoOp'],'TIV|TIFV')
           ACT(v2, 'Vendida')
           ACT(v3, 'ACREDITAR')
           ACT(v4, 'DEBITAR')
