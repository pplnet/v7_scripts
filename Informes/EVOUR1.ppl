        SetFont(f:FAC,2)
        SetFilaActual(FAC+5)

        ACT(c:fac+10,'   '~BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Telefono','Codigo',fbn('Vehiculo1')))
  
        SetFont(c:fac+10..c:fac+10,1)
        SetFilaActual(FAC+10)
        FormatoCeldas(c:1..f:FAC,Exe('F2'))
        SetFont(x1..z2,1)
        ACT(a:FAC,' ')
      Endif
      ACO(1,3)
      ACO(2,8)
      ACO(3,15)
      ACO(4,6)
      ACO(5,5)
      ACO(6,5)
      ACO(7,1)
      ACO(8,5)
      LimitesVision(h:FAC)
    Endif

    if Val(w1)=3
      ACT(a:FAC+4, 'Voucher de liquidacion Nro. : '~Dialogo.NrTrans1)
      ACT(e:FAC+4, 'Liquidacion del : '~fbn['Fecha2'])
      SetFont(a:FAC..f:FAC+4,2)
      SetFilaActual(FAC+4)
      if EqStr(fbn['TipoTr2'],'RET')
        ACT(c:FAC+2, 'Pagar ')
        ACT(u1, 'Entregar')
        ACN(u2, -1)
        ACT(u3, 'ACREDITAR')
      else
        ACT(c:FAC+2, 'Cobrar ')
        ACT(u1, 'Recibir')
        ACN(u2, 1)
        ACT(u3, 'DEBITAR')
      endif
      if DesciendeDeEspecie(fbn['TESP'], 'TITULO')
        ACT(c:FAC+2, Val(c:FAC+2)~'Titulos')
      else
        ACT(c:FAC+2, Val(c:FAC+2)~fbn['TESP'])
      endif
      ACT(c:FAC+2, Val(c:FAC+2)~' por CRYL - Transferencia Libre')
      if FBN['PaseCB']=1
        ACT(c:FAC+2, Val(c:FAC+2)~' Conformada / FTC')
      else
        ACT(c:FAC+2, Val(c:FAC+2)~' / FT')
      endif
      AgregarMarco(a:FAC+2..h:FAC+3, 2)
      SetFont(c:FAC+2,4)
      SetFilaActual(FAC+4)
      ACT(a:FAC, 'Cliente : '~BuscarCampo('Clientes','RazonSocial','Codigo',FBN['TCl1']))
      act(z:12,BuscarCampo('Cuentas','Cliente','Codigo',FBN['TCUE1']))
      act(z:11,BuscarCampo('Cuentas','Comitente','Codigo',FBN['TCUE1']))
      ACT(a:FAC+1, 'Custodia : ')
      ACT(a:FAC+1, Val(a:FAC+1)~BuscarCampo('Clientes','RazonSocial','Codigo',val(z:11)))
      ACT(a:FAC+2, 'Tipo Operacion : '~Val(v1))
      ACT(a:FAC+3, 'Clase de Operacion : ')
      if EqStr(val(z:11),val(z:12)) o CeldaVacia(z:11)
        ACT(a:FAC+3, Val(a:FAC+3)~'MERCADO')
      else
        ACT(a:FAC+3, Val(a:FAC+3)~'CUSTODIA')
      endif
      ACT(a:FAC+4, 'Nro Operacion: '~fbn['NrOperacionRef1'])
      ACT(a:FAC+5, 'Fecha Concertacion: '~fbn['FechaOp'])
      ACT(a:FAC+6, 'Fecha Liquidacion: '~fbn['Fecha2'])
      SetFont(a:FAC..a:FAC+8,2)
      SetFilaActual(FAC+8)
      ACT(c:FAC, 'Especie a '~Val(u1))
      ACT(d:FAC, 'Cuenta de Registro')
      ACT(e:FAC, 'Numero Interno de')

      ACT(g:FAC, 'Confir.')
      ACT(a:FAC+1, 'Cod.')
      ACT(b:FAC+1, 'Denominacion')
      ACT(c:FAC+1, 'Val.Nominal Residual')
      ACT(d:FAC+1, 'a '~Val(u3))
      ACT(e:FAC+1, 'Cuenta de Terceros')
      AgregarMarco(a:FAC..C:FAC, 2,0,EXE('COLOR'))
      AgregarMarco(a:FAC+1..C:FAC+1, 2,2,EXE('COLOR'))
      AgregarMarco(d:FAC..h:FAC+1, 2,2,EXE('COLOR'))
      AlinearCeldas(c:FAC+1, 'D')
      AlinearCeldas(d:FAC..g:FAC+1, 'C')
      SetFont(a:FAC..g:FAC+1,2)
      SetFont(h:FAC..h:FAC+1,4)

      SetFilaActual(FAC+2)  
      ACT(a:FAC, FStr(BuscarCampo('Especies','Valor10','Codigo',fbn['TESP']),1,0))
      ACT(b:FAC, BuscarCampo('Especies','Nombre','Codigo',fbn['TESP']))
      ACN(c:FAC, FBN['Cantidad1']*Val(u2))
      ACT(d:FAC, BuscarCampo('Cuentas','NrDepositante','Codigo',FBN['TCUE1']))

      ACT(g:FAC, Val(v7))
      AlinearCeldas(d:FAC..g:FAC, 'C')
      AgregarMarco(a:FAC..h:FAC, 2)
      SetFont(a:FAC..g:FAC,1)
      FormatoCeldas(c:FAC,EXE('F2'))
      ACT(h:FAC, '|')
      SetFont(h:FAC,4)

      SetFilaActual(FAC+1)
      ACT(c:FAC, 'Valor Nominal Residual')
      ACT(d:FAC, 'Valor Residual')
      AlinearCeldas(c:FAC..d:FAC, 'D')
      ACT(b:FAC+1, 'Total:')
      ACN(c:FAC+1, FBN['Cantidad1']*Val(u2))
      ACN(d:FAC+1, FBN['Cantidad1']*BuscarCampo('Especies','VTeorico','Codigo',fbn['TESP'])*Val(u2))
      SetFont(b:FAC+1,2)
      SetFont(c:FAC..d:FAC+1,2)
      FormatoCeldas(c:FAC+1..d:FAC+1,EXE('F2'))
      AgregarMarco(b:FAC..e:FAC+2, 2,0,EXE('COLOR'))
      SetFilaActual(FAC+3)

      if EqStr(FBN['TipoTr2'],'RET')
        ACT(a:FAC+1, 'Aprobacion desembolso')
        AgregarMarco(a:FAC+1..C:FAC+6,2,0)
        SetFont(a:FAC+1,2)
      endif

      SetFilaActual(FAC+8)
      ACT(a:fac, 'Preparado por : '~BuscarCampo('Usuarios','Nombre','Codigo',USUARIOACTIVO))
      SetFont(a:FAC,2)

      ACT(c:fac+10,'   '~BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Telefono','Codigo',fbn('Vehiculo1')))
      SetFont(c:fac+10..c:fac+10,1)
      SetFilaActual(FAC+10)
      FormatoCeldas(c:1..f:FAC,Exe('F2'))
      SetFont(x1..z2,1)

      ACO(1,3)
      ACO(2,9)
      ACO(3,12)
      ACO(4,13)
      ACO(5,13)
      ACO(6,1)
      ACO(7,4)
      LimitesVision(g:FAC)
    Endif
    SetFont(u1..z7,1)
    if Dialogo.Check3=1
      ImprimirHoja
    endif
  Proximo
else
  Cancelar('El Voucher '~Dialogo.NrTrans1~' no puede imprimirse')
Endif
