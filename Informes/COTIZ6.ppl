ModoReproceso(ConDialogo)
CrearDialogo
  Especie1 : 'Especie' ;;;;;;NoVacio(Dialogo.Especie1);'Debe Ingresar una Especie';NO
  Fecha1   : 'Fecha'   ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO; FSys
  Especie2 : 'Moneda'  ;;;;;;Vacio(Dialogo.Especie2) o DesciendeDeEspecie(Dialogo.Especie2,'MONEDA');'Debe Ingresar una Moneda';NO
  String1  : 'Plazo'   ;;;;;;;;;;;'Todos|0:Contado|24:24Hs|48:48Hs|'
  Mercado1 :'Mercados' ;;;;;;;;;;;
FinDialogo
if Not OK
  Cancelar
endif


CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

SetFont(c:2..c:2,1)

ACT(a:FAC, 'Cotizaciones por Ranking Mercado Plazo')
SetFont(a:4..a4,3)


SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Especie : '~Dialogo.Especie1)

if NoVacio(dialogo.string1)
    if EqStr(dialogo.string1,'Todos')
    ACT(w2,'')
    else
        if EqStr(dialogo.string1,'0:Contado')
               ACT(w2,'0')
        else
            if EqStr(dialogo.string1,'24:24Hs')
               ACT(w2,'24')
            else
                ACT(w2,'48')
            endif
        endif
    endif
endif

ACT(w:3, CotizacionRanking(Dialogo.Especie1,,,,Dialogo.Fecha1,1,SI,Dialogo.Especie2,Dialogo.Mercado1,val(w:2)))




ACT(c:FAC+1, 'Cotización:' ~ val(w:3))
ACT(a:FAC+2, 'Fecha: '~Dialogo.Fecha1)

SetFilaActual(FAC+4)

ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Precio Cierre')
ACT(c:FAC, 'Precio Contable')
ACT(d:FAC, 'Cont./Fut.')
ACT(e:FAC, 'FechaEj')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'Plazo')
ACT(h:FAC, 'Mercado')
ACT(i:FAC, 'Fuente')

AlinearCeldas(a:FAC..j:FAC,'D')
AlinearCeldas(f:FAC..i:FAC,'C')

SetFont(a:5..i:FAC,2)
AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)



ACT(a:fac, dialogo.Fecha1)
ACT(b:fac,val(w:3))
ACT(f:fac, dialogo.Especie2)
if EqStr(dialogo.string1,'Todos')
    ACT(g:fac,'Todos')
else
    ACT(g:fac,val(w:2))
endif
ACT(h:fac,dialogo.Mercado1)


AlinearCeldas(a:FAC..h:FAC,'D')


SetFont(a:Val(w1)+6..i:FAC,1)
AlinearCeldas(d:Val(w1)+6..d:FAC,'C')
AlinearCeldas(f:Val(w1)+6..i:FAC,'C')

ACO(1,7)
ACO(2,10)
ACO(3,10)
ACO(4,8)
ACO(5,8)
ACO(7,10)
ACO(8,10)
ACO(9,10)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL INFORME')
SetPrintFit(3, 70)

SetFont(a:FAC,2)
FormatoCeldas(b5..c:fac, Exe('F10'))
FormatoCeldas(d5..d:fac, Exe('F0'))
FormatoCeldas(g5..j:fac, Exe('F10'))

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(i:FAC)
RangoTitulo(a:1..i:FAC, Val(w1)+5)

