ModoReproceso(ConDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:    'FechaVto'                      ;1;1;;;;;;;FSYS
  Especie1 : 'Moneda'                        ;1;2;;;;;;;;;;;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Radio4   : '|C/V|Opciones|Todo'            ;;;;NO;NO;;;;2
  Radio2:    'Posicion|Spot|Forward|Ambos'   ;3;2;;;;;;;2
  Radio1:    'Cartera|Trading|General|Ambas' ;;;;NO;NO;;;;2
  Radio3:    '|Compras|Ventas|Ambas'         ;;;;;;;;;2
  Vehiculo1 : 'Vehiculo'   ;3;1;;;;[NoVacio(Dialogo.Vehiculo1)] y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) O Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;Var('VEHICULODE');;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo))," Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");
  Book1:      'Book'       ;5;1;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Fecha2: 'FechaOp'        ;;;;NO;NO;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(2)
ACT(a:fac, 'FechaVto: '~Dialogo.Fecha1)
ifa
If NoVacio(Dialogo.Especie1)
   ACT(a:fac, 'Moneda : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
   ACT(a:fac, 'Moneda : Todas')
Endif
ifa
If Dialogo.Radio1=0
   ACT(a:fac, 'Compras')
Else
  If Dialogo.Radio1=1
     ACT(a:fac, 'Ventas')
  Else
     ACT(a:fac, 'Compras y Ventas')
  Endif
Endif
ifa
ACT(a:fac, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
ifa
IF NoVacio(Dialogo.Book1)
    ACT(A:fac, 'Book: '~Dialogo.Book1)
ELSE
    ACT(A:fac, 'Book: Todos')
ENDIF
SetFont(a:fac-4..a:fac,2)
ifa
ACT(d:fac, "Operaciones por Fecha de Vencimiento - ")
If Dialogo.Radio2=0
   ACT(d:fac, Val(d:fac)~'Spot' )
Else
   If Dialogo.Radio1=1
      ACT(d:fac, Val(d:fac)~'Forward' )
   Else
      ACT(d:fac, Val(d:fac)~'Spot y Forward' )
   Endif
Endif
SetFont(d:fac,3)

SetFilaActual(fac+2)

ACT(a:FAC, "Operacion")
ACT(b:FAC, "TipoOp")
ACT(c:FAC, "Cliente")
ACT(d:FAC, "Moneda")
ACT(e:FAC, "Cantidad")
ACT(f:FAC, "Precio")
ACT(g:FAC, "Total")
ACT(h:FAC,   "FechaVto")
ACT(h:FAC+1, "Moneda")
ACT(i:FAC,   "FechaVto")
ACT(i:FAC+1, "Mon. de Pago")
ACT(j:FAC, "Corredor")
ACT(k:FAC, "Comision")
ACT(l:FAC, "Sector")

AlinearCeldas(a:FAC..l:FAC+1,'C')
SetFont(a:fac..n:FAC+1,2)
AgregarMarco(a:FAC..l:FAC+1,1,0,Exe('COLOR6'))

ifa

ACN(FI:1, fac)

***---Select
(.'FX0025'.)

ACT(ea:1, '')
ACD(fj:1, 0)
ACN(pj:1, 0)
ACT(cp:1, '' )
ACN(fi:1, fac)

Recorrer SQL
    message(fbn('NrOperacion')~'  '~fbn('Especie'))
    IF Not Eqstr(fbn('Book1'), Val(BK:1))
        ifa
        ACT(A:fac, fbn('Book1'))
        SetFont(A:fac, 2)
        AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR6'))
        ifa
        ACN(FI:2, fac)
    ENDIF
    IF [Dialogo.Radio3 = 0 O Dialogo.Radio3 = 2] O [Not Incluido(fbn('TipoOp'), 'FXA|FXAT')] O [Incluido(fbn('TipoOp'), 'FXA|FXAT') Y Eqstr(fbn('FXA'), 'Venta') Y Dialogo.Radio3 = 1]  O [Incluido(fbn('TipoOp'), 'FXP') Y Eqstr(fbn('FXP'), 'Venta') Y Dialogo.Radio3 = 1]
        ***---Si es Arbitraje O Pase y solo se piden las vtas, descarto las compras
        ACT(a:fac, fbn('NrOperacion'))
        ACLO(a:fac, fbn('NrOperacion'))
        ACT(b:fac, fbn('TipoOp'))
        ACT(c:fac, fbn('Cliente1'))
        ACN(g:fac, fbn('TotalBrutoCli1'))
        ACN(e:fac, fbn('Cantidad'))
        ACD(h:fac, fbn('FechaVto'))
        ACD(i:fac, fbn('FechaPago'))
        ACT(j:fac, fbn('Corredor'))
        ACN(k:fac, fbn('TotalComisiones'))
        ACT(l:fac, IIF(fbn('SectorRB')=0,'Mesa',IIF(fbn('SectorRB')=1,'Corporate',IIF(fbn('SectorRB')=2,'Institucionales',IIF(fbn('SectorRB')=3,'Back Office',IIF(fbn('SectorRB')=4,'Descuentos','Com. Exterior'))))))
        If Not Incluido(fbn('CallPut'), 'CAL|PUT')
           ACT(d:fac, fbn('Especie')~' - '~fbn('Nombre'))
        Else
           ACT(d:fac, fbn('Especie')~' - '~fbn('CallPut')~' - '~fbn('FechaEj')~' - '~PyC(fbn('PrecioEj'),1,8))
        Endif

        IF [Incluido(fbn('TipoOp'), 'FXA|FXAT')]
IF NO
            ACT(B:fac, Val(B:fac)~' - '~fbn('FXA'))
            ACN(CB:5, IIF(Eqstr(Modo(fbn('Especie'), Var('MONELOCA')), 'INV'), 0, 1))
            ACN(CB:6, IIF(Eqstr(Modo(fbn('ContraEspecie'), Var('MONELOCA')), 'INV'), 0, 1))
            IF [Eqstr(fbn('TipoOp'), 'FXA')]
               ACN(PC:1, fbn('Cotizacion1'))
            ELSE
               ACN(PC:1, fbn('Cotizacion1')+(fbn('Precio4')*fbn('Plazo')/36500))
            ENDIF
            ACN(TC:1, IIF(Val(CB:5)=1, fbn('Cantidad')*Val(PC:1), fbn('Cantidad')/Val(PC:1)))
            ACN(PV:1, IIF(Val(CB:6)=1, Val(TC:1)/fbn('TotalBrutoCli1'), 1/(Val(TC:1)/fbn('TotalBrutoCli1'))))
            IF Eqstr(fbn('FXA'), 'Venta')
               ACT(CS:1, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
               ACT(D:fac, fbn('ContraEspecie')~' - '~Val(CS:1))
               ACN(E:fac, fbn('TotalBrutoCli1'))
               ACN(F:fac, Val(PV:1))
               ACN(G:fac, Val(TC:1))
            ELSE
               ACN(E:fac, fbn('Cantidad'))
               ACN(F:fac, Val(PC:1))
               ACN(G:fac, Val(TC:1))
            ENDIF
ENDIF
            IF Eqstr(fbn('FXA'), 'Venta')
               ACT(CS:1, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('ContraEspecie')))
               ACT(D:fac, fbn('ContraEspecie')~' - '~Val(CS:1))
               ACN(E:fac, fbn('TotalBrutoCli1'))
               ACN(F:fac, fbn('Precio1'))
               ACN(G:fac, fbn('Cantidad'))
            ELSE
               ACN(E:fac, fbn('Cantidad'))
               ACN(F:fac, fbn('Precio1'))
               ACN(G:fac, fbn('TotalBrutoCli1'))
            ENDIF

        ELSE
            ACT(CS:1, BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
            ACT(D:fac, fbn('Especie')~' - '~Val(CS:1))
            ACN(E:fac, fbn('Cantidad'))
            ACN(F:fac, fbn('Precio1'))
            ACN(G:fac, fbn('TotalBrutoCli1'))
        ENDIF
    ELSE
        DFA
    ENDIF
    ACT(BK:1, fbn('Book1'))
Proximo

AgregarMarco(A:Val(FI:1)+1..L:fac,0,0)
SetFont(a:Val(FI:2)..z:fac,1)
FormatoCeldas(e:10..g:fac,Exe('F2'))
FormatoCeldas(f:10..f:fac,Exe('F9'))

ACO(2, 12)
ACO(4, 13)
ACO(5, 10)
ACO(6,  8)
ACO(7, 10)
ACO(8,  8)
ACO(9,  8)
ACO(11, 8)
ACO(12, 9)

Impresion(1,2)
Impresion(4,1)
SetFilaActual(fac+3)

ACT(a:fac, 'Fin del Informe.')
ACT(a:fac, USUARIOACTIVO)
SetFont(a:fac,2)

FijarFila(Val(FI:1)+1)

LimitesVision(k:fac+1)
RangoTitulo(A:1..K:fac, Val(FI:1))
SetPrintFit(3,90)

