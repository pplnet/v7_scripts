*     Endif
*     SetFilaActual(fac+1)
*     act(b:Val(ej:2),'El monto del IVA no puede computarse como credito fiscal.') 
*     SetFont(b:Val(ej:2)..b:Val(ej:2),2)
*     AlinearCeldas(J:FAC,'D')
*     SetFont(J:fac,2)
*     AgregarMarco(K:FAC-1,2,0)
*     SetFilaActual(Val(ej:2)+2)
*   Endif

  * ---> Impresion De La Forma De Pago Y De La Cuenta A Acreditar
  if Incluido(fbn['TipoOp'],'TIC|TCOPRI|')
     act(zb:02,'Credito')
  else
     act(zb:02,'Debito')
