      ACT(cl:1, '')
      SQL.ADD(" SELECT O.Cliente1, C.CategDepositante, C.AFJP, C.Alias2, C.NrCuenta ")
      SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
      SQL.ADD(" WHERE O.Cliente1 = C.Codigo ")
      SQL.ADD(" AND   O.NrOperacion = '"~fbn('NrOperacion')~"' ")
      SQL.ADD(" AND   O.TipoOp IN ('TIC','TIV')      ")
      SQL.ADD(" AND   O.FechaOp = "~idxdate2(fbn('FechaOp'))~" ")
      SQL.ADD(" AND   O.Especie = '"~fbn('Especie')~"' ")
      watch(SQL.Batch) 
      Recorrer SQL
