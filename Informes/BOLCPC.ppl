  SQL.ADD("SELECT * from "~DBO~".EJECUCIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
  ACN(co:1,99)
  
  Recorrer SQL
   dfa
   SCN(ej:1,1)
   if val(co:1)=99
      ACN(co:1,0)
      #ifdef MLASA
         ACT(a:Val(ej:1),'Fecha         Hora               Registro') 
      #else
         ACT(a:Val(ej:1),'Fecha         Hora               Registro     Nro Orden') 
      #endif
      *ACT(c:Val(ej:1),'Nro Orden')
      ACT(d:Val(ej:1),'Cantidad VN')
      ACT(e:Val(ej:1),'Precio')
      ACT(g:Val(ej:1),'Subtotal')
      SetFont(a:Val(ej:1)..g:Val(ej:1),2)
      AlinearCeldas(c:Val(ej:1)..g:Val(ej:1),'D')
      SCN(ej:1,1)
   endif 
   #ifdef MLASA
      ACT(a:Val(ej:1),fbn['Fecha']~'   '~fbn['NrSecuencia'])
   #else
      ACT(a:Val(ej:1),fbn['Fecha']~'   '~fbn['NrSecuencia']~'          '~iif(Incluido(Val(xa:1),'FIX|SDIB'),Val(xb:1),fbn['NrSecuencia']))
   #endif
      *ACT(c:Val(ej:1),iif(Incluido(Val(xa:fac),'FIX|SDIB'),Val(xb:fac),fbn['NrSecuencia']))
      ACN(d:Val(ej:1),fbn['Cantidad'])
      ACN(e:Val(ej:1),fbn['Precio'])
      ACN(g:Val(ej:1),fbn['Cantidad']*fbn['Precio'])
      FormatoCeldas(c:Val(ej:1),Exe('F0'))
      FormatoCeldas(e:Val(ej:1),Exe('F9'))
      ACN(ej:2,Val(ej:1)+2)
  Proximo  
  
  AgregarMarco(a:Val(w3)..g:Val(ej:1),2,0)
  
  ACT(J:FAC,'SUBTOTAL')
  ACN(k:FAC, Val(z:11))
  AlinearCeldas(J:FAC..k:FAC,'D')
  SetFont(J:fac,2)
  AgregarMarco(K:FAC,2,0)

  SetFilaActual(fac+1) 
  ACT(J:FAC,'INTERESES CORRIDOS')
  If EqStr(FBN['InteresesC'],'DIR')
     ACN(k:FAC,0)     
  Else
     ACN(k:FAC,FBN['TotalIntereses']) 
  EndIf
  AlinearCeldas(J:FAC,'D')
  SetFont(J:fac,2)
  AgregarMarco(K:FAC,2,0)

  SetFilaActual(fac+1) 
  ACT(J:FAC,'Aranceles Mercado')
  ACN(k:FAC,FBN['TotalGastos']) 
  AlinearCeldas(J:FAC,'D')
  SetFont(J:fac,2)
  AgregarMarco(K:FAC,2,0)

  *If Eqstr(fbn('CB8'),'1') y [eqstr(fbn('NrMAE'),'000') o Vacio(fbn('NrMAE'))]
  * If [eqstr(fbn('NrMAE'),'000') o Vacio(fbn('NrMAE'))]
     SetFilaActual(fac+1) 
     ACT(J:FAC,'Comision')
     ACN(k:FAC,FBN['TotalAux2'])
     AgregarMarco(K:FAC,2,0)
     SetFilaActual(fac+1) 
     ACT(J:FAC,'IVA')
     *ACN(k:FAC,FBN['TotalAux4'])
     ACN(k:FAC,FBN['TotalIVA']+FBN['TotalIvaAdi'])
     AgregarMarco(K:FAC,2,0)
     If Not eqstr(fbn('ContraEspecie'), VAR('MONELOCA'))
     ** AA 28-05-2021 se toma Cotizacion de ContraEspecie en ARP de la Operacion Cotizacion2
     **     ACT(a:Val(ej:2),'A los fines fiscales el tipo de cambio a considerar es '~fbn('ContraEspecie')~' 1 = $'~fstr(cotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),2,SI,SI),0,8))
     ACT(a:Val(ej:2),'A los fines fiscales el tipo de cambio a considerar es '~fbn('ContraEspecie')~' 1 = $'~fstr(fbn('Cotizacion2'),0,4))     
        SetFont(a:Val(ej:2),2)
        SCN(ej:2,1)
     Endif

     SetFilaActual(fac+1)
     ACT(J:FAC,'TOTAL NETO')
     
     act(b:Val(ej:2),'El monto del IVA no puede computarse como credito fiscal.')
     SetFont(b:Val(ej:2)..b:Val(ej:2),2)
 
     IF EqStr(FBN['EsAforado'],'1')   
        ACN(k:FAC,FBN['TotalCaucion'])
     Else
        ACN(k:FAC,FBN['TotalNetoCli1'])
     Endif

     AlinearCeldas(j:fac-4..J:FAC,'D')
     SetFont(J:FAC-4..J:fac,2)
     AgregarMarco(K:FAC,2,0)
     
     SetFilaActual(Val(ej:2))
     SetFilaActual(fac+2)
*  Else
*     SetFilaActual(fac+1) 
*     ACT(J:FAC,'TOTAL NETO')
*     SetFont(J:FAC,2)
*     IF EqStr(FBN['EsAforado'],'1')   
