         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
         EndIf      
      EndIf
   Else
      ACT(ZB:10, '')
   EndIf
   ACT(ZB:11, FBN('TipoInscripcion'))
   (.'ARMACUIT'.)
   IFA
   ACT(A:FAC, Val(ZB:14))
   * ---> Impresion De La Direccion  - IVA

    If EqStr(fbn('CondicionIVA'),'INS') 
       ACT(xy1,'Inscripto')
    Else
       If EqStr(fbn('CondicionIVA'),'EXE')
          ACT(xy1,'Exento')
       Else
          If EqStr(fbn('CondicionIVA'),'FIN')
             ACT(xy1,'Consumidor Final')
          Else
             If EqStr(fbn('CondicionIVA'),'NRE')
                ACT(xy1,'No Responsable')
             Else
                 If EqStr(fbn('CondicionIVA'),'NOI')
                    ACT(xy1,'No Inscripto')
                 Else
                    If EqStr(fbn('CondicionIVA'),'MON')
                       ACT(xy1,'Monotributista')
                    Else
                       If EqStr(fbn('CondicionIVA'),'NCA')
                          ACT(xy1,'No Categorizado')
                       Else
                          ACT(xy1,'Otra Categorizacion')
                       Endif
                    Endif
                Endif
             Endif
          Endif
       Endif
    Endif


   * ---> Impresion De La Direccion
   #ifdef MLASA
      ACT(e:FAC, 'Domicilio / Address')
   #else
      ACT(e:FAC, 'Domicilio')
   #endif
   ACT(j:FAC, 'Cond. IVA')
   AlinearCeldas(e:fac,'I')
   SetFont(A:FAC..j:FAC, 2)
   IFA
   ACT(A:FAC, Val(ZB:13))
   AgregarMarco(a:FAC..b:FAC,2,0)  
   ACT(ZB:01, FBN('Dire'))
   if Vacio(val(ZB:01))
   *ACT(ZB:01, FBN('Calle')~' '~FBN('Altura')~' '~FSTR(FBN('Piso'),1,0)~' '~FBN('Depto'))
      ACT(ZB:01, FBN('Calle')~' '~FBN('Altura')~' '~FBN('Piso')~' '~FBN('Depto'))
   endif
   (.'ELIBLANCOS'.)

      ACT(j:FAC, Val(xy:1))
   AgregarMarco(j:FAC..k:FAC,2,0)  
      SetFont(A:FAC..c:FAC, 1)
   
   
   ACT(E:FAC, Val(ZB:03))
   AgregarMarco(e:FAC..h:FAC,2,0)  
     SetFont(A:FAC..j:FAC, 1)
   
   * ---> Impresion Del Codigo Postal Y La Localidad
   IFA
      
   #ifdef MLASA   
      ACT(A:FAC, 'Localidad / Town')
      ACT(C:FAC, 'Codigo Postal / Zip Code')
      ACT(E:FAC, 'Telefono/s / Telephone/s')
   #else
      ACT(A:FAC, 'Localidad')
      ACT(C:FAC, 'Codigo Postal')
      ACT(E:FAC, 'Telefono/s')
   #endif
   SetFont(A:FAC..E:FAC, 2)
   
   IFA
   If [NoVacio(FBN('Localidad'))]
      ACT(ZB:01, FBN('Localidad'))
      (.'ELIBLANCOS'.)
      ACT(A:FAC, Val(ZB:03))
   EndIf
   AgregarMarco(a:FAC..b:FAC,2,0)     

   If [NoVacio(FBN('CodigoPostal')) y Not EqStr(FBN('CodigoPostal'), '000000')]
   
    If [EqStr(Copy(FBN('CodigoPostal'), 01, 02), '00')]
      ACT(C:FAC, "(" ~ Copy(FBN('CodigoPostal'), 03, 09) ~ ')')
    Else  
      ACT(C:FAC, "(" ~ Copy(FBN('CodigoPostal'), 01, 08) ~ ')')
    EndIf
   EndIf
   AgregarMarco(c:FAC,2,0)  
   
   ACT(E:FAC, fbn['Telefono'])
   AgregarMarco(e:FAC..h:fac,2,0)  

   SetFont(A:FAC..E:FAC, 1)
   AgregarMarco(A:Val(w1)..k:FAC,2,0)
   
   SetFilaActual(fac+1)
   
   if Incluido(fbn['TipoOp'],'TIC|')
       act(z1,'COMPRADO')
       act(z2,'PARA')
       act(z3,'COMPRADO')
       act(z11,'BOUGHT')
       act(z12,'FOR')
       act(z13,'BOUGHT')
   else
       act(z1,'VENDIDO')
       act(z2,'DE')
       act(z3,'VENDIDO')
       act(z11,'SOLD')
       act(z12,'FROM ')
       act(z13,'SOLD')
   endif
  
   If Eqstr(fbn('NrMAE'),'000') o Vacio(fbn('NrMAE'))
      * CLIENTE
      ACT(b:FAC+1,   '  POR MEDIO DE LA PRESENTE CONFIRMAMOS QUE EL '~fbn['FechaOp']~' HEMOS '~Val(z3)~' POR VUESTRA CUENTA Y ORDEN')
      ACT(b:FAC+2, '  PARA LIQUIDAR EL DIA '~Val(fv:1)~' CON PLAZO DE '~fbn['Plazo']~' HORAS, LOS VALORES QUE A CONTINUACION SE DETALLAN:')
      #ifdef MLASA
         ACT(b:FAC+3, '  WE HEREBY CONFIRM THAT ON '~fbn['FechaOp']~' WE HAVE '~Val(z13)~' ON YOUR BEHALF,')
         ACT(b:FAC+4, '  TO SETTLE ON '~Val(fv:1)~' WITH A '~fbn['Plazo']~' TERM, THE BELOW DETAILED VALUES:')
      #endif
   Else
      * CONTRAPARTE
      ACT(b:FAC+1, '  POR MEDIO DE LA PRESENTE CONFIRMAMOS QUE EL '~fbn['FechaOp']~' HEMOS EFECTUADO POR VUESTRA CUENTA Y ORDEN LA SIGUIENTE')
      ACT(b:FAC+2, '  OPERACION PARA LIQUIDAR EL DIA '~Val(fv:1)~' CON PLAZO DE '~fbn['Plazo']~' HORAS, CON LOS VALORES QUE A CONTINUACION SE DETALLAN:')
      #ifdef MLASA
         ACT(b:FAC+3, '  WE HEREBY CONFIRM THAT ON '~fbn['FechaOp']~' WE HAVE CARRY OUT ON BEHALF OF A THIRD PARTY, THE')
         ACT (b:FAC+4, '  FOLLOWING OPERATION TO SETTLE ON '~Val(fv:1)~' WITH A '~fbn['Plazo']~' TERM, WITH THE BELOW DETAILED VALUES:')
      #endif
   Endif

  
   ACT(ZB:21, fbn('ESPECIE'))
   ACT(ZB:22, fbn('CONTRAESPECIE'))
   SetFont(a:fac+1..c:fac+6,2)
   #ifdef MLASA   
      SetFilaActual(fac+7)   
   #else
      SetFilaActual(fac+5)   
   #endif
   ACT(a:FAC, 'Moneda')
   ACT(b:FAC, 'Codigo')
   ACT(c:FAC, 'CodCV')
   ACT(d:FAC, 'Descripcion')
   ACT(e:FAC, 'Mercado')
   ACT(f:FAC, 'Cupon')
   ACT(H:FAC, 'V.Nominal')
   ACT(I:FAC, 'V.Residual')
   ACT(J:FAC, 'Precio')
   ACT(K:FAC, 'Importe')
   ACN(W4,FAC)
   ACN(W40,FAC)
   AlinearCeldas(A:FAC..L:FAC,'C')
   AlinearCeldas(K:FAC,'D')
   SetFont(a:fac..k:fac,2)
   
   #ifdef MLASA   
      ACT(a:FAC+1, 'Currency')
      ACT(b:FAC+1, 'Code')
      ACT(c:FAC+1, 'CodeCV')
      ACT(d:FAC+1, 'Description')
      ACT(e:FAC+1, 'Market')
      ACT(f:FAC+1, 'Cupon')
      ACT(H:FAC+1, 'Notional Value')
      ACT(I:FAC+1, 'Residual Value')
      ACT(J:FAC+1, 'Price')
      ACT(K:FAC+1, 'Amount')
      ACN(W4,FAC+1)
      AlinearCeldas(A:FAC+1..L:FAC+1,'C')
      AlinearCeldas(K:FAC+1,'D')
      SetFont(a:fac+1..k:fac+1,2)
      SetFilaActual(fac+1)   
   #endif   
 
   IFA   
   ACT(b:FAC, fbn('CodMAEContado'))
   ACT(c:FAC, fbn('CodNumCajaValores'))
   ACT(d:FAC, BuscarCampo('Especies', 'Nombre', 'Codigo', fbn['Especie']))
   ** AA 05-09-2022 se discrimina NroOrden y el mercado para BYMA y MAE
   
   ACT(xb:1,fbn['NrOrdenAux'])
   **Modificacion 30/5/23
   ACT (xa:1,fbn['UDN2'])
   #ifdef BACS
     ACT(e:FAC, fbn('MercadoNeg'))
   #else
     ACT(e:FAC, iif(Incluido(Val(xa:1),'FIX|SDIB'),'BYMA-PISO',VAR('AMBMAE')))  
   #endif
   
   if NOT Eqstr(FBN['Cupon1'],' ') y NOT Eqstr(FBN['Cupon1'],'  ') Y NoVacio(FBN['Cupon1'])
      ACN(f:FAC, FBN['Cupon1'])
   Endif
   FormatoCeldas(f:FAC,Exe('FE'))
   if Incluido(FBN['MercadoMon'],VAR('MERMCMEP')) o Incluido(FBN['MercadoMon'],VAR('MERCBCRA'))
      ACT(a:FAC, Trim(BuscarCampo('Especies', 'Alias2', 'Codigo', FBN('ContraEspecie'))))
   Endif
   If Vacio(Val(a:fac))   
      ACT(a:FAC, Trim(BuscarCampo('Especies', 'Nombre', 'Codigo', FBN('ContraEspecie'))))
   Endif   
   FormatoCeldas(d:FAC,Exe('FE'))
   ACN(H:FAC, fbn['Cantidad'])
   acn(vr2,   FBN['Alias5'])
   acn(ZB:08, FBN['CANTIDAD']*ValorTeorico2(FBN['ESPECIE'],FBN['FECHAOP']))
   IF val(zb:08) = 0
     acn(ZB:08, FBN['CANTIDAD']*ValorTeorico(FBN['ESPECIE']))
   ENDIF
   
   ACN(I:FAC, Round(Val(ZB:08),Val(vr2)))
   
   
   IF EqStr(FBN['EsAforado'],'1')
      ACN(J:FAC, fbn['TipoCambio2'])
   Else
      ACN(J:FAC, fbn['Precio1'])
   Endif
   * --- FO 16/08/2006 Esto tiene que ser igual que el copiativo --- *
   FormatoCeldas(J:FAC,Exe('F9'))
   ACN(Z:11,fbn['TotalBrutoCli1'])

   * --- FO 16/08/2006 Agrego esta parte  s/CRISTINA SEGATO
   * --- Monto Bruto
   If EqStr(fbn['EsAforado'],'1')  
      ACN(z:11, fbn['TotalCaucion']-IIF(EqStr(FBN['CotizaMAE'],'CLE'),fbn['TotalIntereses'],0))
   Else
      ACN(z:11, fbn['TotalBrutoCli1'])
   Endif

   *- Si la especie es Dirty Clean igualmente calculo los intereses
   IF EqStr(FBN['CotizaMAE'],'CLE') y EqStr(FBN('InteresesC'),'DIR')
       *- Calculo el precio sacandole los intereses
       If EqStr(fbn['EsAforado'],'1')
           * Precio Clean Aforado
          ACN(j:fac,(fbn['TotalCaucion']-fbn['TotalIntereses'])/fbn['Cantidad'])
           * Bruto Aforado
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
*          ACN(z:11, fbn['Cantidad']*Val(j:fac)*ValorTeorico2(fbn('Especie'),fbn('FechaVto')) )
          ACN(z:11, fbn['Cantidad']*Val(j:fac)*ValorTeorico2(fbn('Especie'),Val(fv:1)) )
       Else
          ACN(j:fac,(fbn['TotalNetoCli1']-fbn['TotalIntereses'])/fbn['Cantidad'])
          ACN(z:11, fbn['TotalBrutoCli1']-fbn['TotalIntereses'])
       Endif
   EndIf
   * - La especie es CLEAN DIRTY, informo Neto y precio sucio
   IF EqStr(FBN['CotizaMAE'],'DIR') y EqStr(FBN('InteresesC'),'CLE')
       *- Calculo el precio sacandole los intereses
       If EqStr(fbn['EsAforado'],'1')
          ACN(j:fac,(fbn['TotalCaucion'])/fbn['Cantidad'])
          ACN(z:11, fbn['TotalCaucion'])
       Else
          ACN(j:fac,(fbn['TotalNetoCli1'])/fbn['Cantidad'])
          ACN(z:11, fbn['TotalNetoCli1'])
       Endif
   EndIf
 

      ACN(K:FAC, Val(Z:11))
   * ------------------------------------------------- *
   SetFont(a:fac..k:fac,1)
   AgregarMarco(a:fac,2,0)
   AgregarMarco(b:fac,2,0)
   AgregarMarco(c:fac,2,0)
