SQL.ADD("SELECT CUIT, NrIngBrutos, RazonSocial, CodigoCNV, NrMAE, NrBYMA ")
SQL.ADD("FROM   "~DBO~".CLIENTES ")
SQL.ADD("WHERE  Codigo  = '"~Var('VEHICULO')~"'")
Recorrer SQL
 
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 02)~'-'~Copy(FBN('CUIT'), 03, 08)~'-'~Copy(FBN('CUIT'), 11, 01))
         EndIf      
      EndIf
      ACT(vh:1,Val(ZB:10))
   Else
      ACT(ZB:10, '')
      ACT(vh:1,Var('VEHICULO'))
   EndIf
   
   ACT(vh:2,FBN['NrIngBrutos'])
   ACT(vh:3,FBN['RazonSocial'])
   ACT(vh:4,FBN['CodigoCNV'])
   ACT(vh:5,FBN['NrMAE'])
   ACT(vh:6,FBN['NrBYMA'])

Proximo

SQL.ADD("SELECT O.NrOperacion,  O.Cliente1,            O.Cantidad,        O.Especie,      O.ContraEspecie, O.Precio1,           TotalGastos,         ")
SQL.ADD("       O.Cupon1,       O.TotalBrutoCli1,      O.TotalNetoCli1,   O.TotalAux2,    O.TotalIVA,     O.TotalIntereses,     O.TotalIvaAdi,       ") 
SQL.ADD("       O.CB5,          O.CB8,                 O.PorAforo,        O.EsAforado,    O.TipoOp,        O.Convenio,          O.FechaOp,           ")
SQL.ADD("       O.FechaVto,     O.FechaAltaSisExterno, O.FechaEnvioMAE,   O.FechaAltaMAE, O.FechaCarga,    O.Cuenta1,           O.NrBoleto,          ")
SQL.ADD("       O.NrOperacion3, O.Plazo,               O.NroAltaMAE,      O.NrOrden1,     O.NrOrdenAux,    Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE,       ")
SQL.Add("       O.UDN2,         C.Codigo,       C.RazonSocial,         C.Direccion Dire,  C.Localidad,    C.CodigoPostal,  C.CUIT,              ")
SQL.Add("       C.NrMAE,        C.CondicionIVA,        C.TipoInscripcion, C.Sucursal,     C.Telefono,      C.CategDepositante,  ")
SQL.Add("       C.Calle,        C.Altura,              C.Piso,            C.Depto,                                              ")
SQL.Add("       C.Alias1,       C.NrCuenta,            E.Alias5,          E.InteresesC,   E.Extendido,     E.CodMAEContado,     ")
SQL.ADD("       O.TotalCaucion, E.CotizaMAE,           E.VTeorico,        O.TipoCambio2,  O.PaseCB,        E.CodNumCajaValores, ")
SQL.ADD("       O.FechaPago,    0 Valor,               O.Cotizacion2,     O.Mercado2 MercadoMon, O.Mercado MercadoTit, O.Mercado4 MercadoNeg ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
*SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and ((O.Cliente1 = '"~VAR('VEHICULODE')~"' and O.Mercado4='"~VAR('AMBMAE')~"' and '"~VAR('CLIENTEMAE')~"'=C.Codigo) or ((O.Cliente1 <> '"~VAR('VEHICULODE')~"' or O.Mercado4<>'"~VAR('AMBMAE')~"') and O.Cliente1=C.Codigo)) ")                                                                                                                                                                                                                                            
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit  NOT IN (30,31) AND OB.Valor=1 ")
SQL.ADD("  UNION ")
SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, TotalGastos, O.Cupon1, ")
SQL.ADD("       O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalIVA, O.TotalIntereses, O.TotalIvaAdi, O.CB5, O.CB8, ") 
SQL.ADD("       O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno, ")
SQL.ADD("       O.FechaEnvioMAE, O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,")
SQL.ADD("       NrOrden1, NrOrdenAux, Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE,")
SQL.Add("       O.UDN2, C.Codigo, C.RazonSocial, C.Direccion Dire, C.Localidad, C.CodigoPostal, C.CUIT,")
SQL.Add("       C.NrMAE, C.CondicionIVA, C.TipoInscripcion, C.Sucursal, C.Telefono, C.CategDepositante, ")
SQL.Add("       C.Calle,        C.Altura,              C.Piso,            C.Depto,                                              ")
SQL.Add("       C.Alias1, C.NrCuenta, E.Alias5,  E.InteresesC, E.Extendido, ")
SQL.ADD("       E.CodMAEContado, O.TotalCaucion, E.CotizaMAE, E.VTeorico, O.TipoCambio2, O.PaseCB, E.CodNumCajaValores, ")
SQL.ADD("       O.FechaPago,    1 Valor, O.Cotizacion2, O.Mercado2 MercadoMon, O.Mercado MercadoTit, O.Mercado4 MercadoNeg ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
*SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and ((O.Cliente1 = '"~VAR('VEHICULODE')~"' and O.Mercado4='"~VAR('AMBMAE')~"' and '"~VAR('CLIENTEMAE')~"'=C.Codigo) or ((O.Cliente1 <> '"~VAR('VEHICULODE')~"' or O.Mercado4<>'"~VAR('AMBMAE')~"') and O.Cliente1=C.Codigo)) ")                                                                                                                                                                                                                                            
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit  IN (30,31) AND OB.Valor=1 ")
SQL.ADD("  UNION ")
SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, TotalGastos, O.Cupon1, ")
SQL.ADD("       O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalIVA, O.TotalIntereses, O.TotalIvaAdi, O.CB5, O.CB8, ") 
SQL.ADD("       O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno, ")
SQL.ADD("       O.FechaEnvioMAE, O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,  ")
SQL.ADD("       NrOrden1, NrOrdenAux,Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE, ")
SQL.Add("       O.UDN2, C.Codigo, C.RazonSocial, C.Direccion Dire, C.Localidad, C.CodigoPostal, C.CUIT, ")
SQL.Add("       C.NrMAE, C.CondicionIVA, C.TipoInscripcion, C.Sucursal, C.Telefono, C.CategDepositante, ")
SQL.Add("       C.Calle,        C.Altura,              C.Piso,            C.Depto,                                              ")
SQL.Add("       C.Alias1, C.NrCuenta, E.Alias5,  E.InteresesC, E.Extendido,  ")
SQL.ADD("       E.CodMAEContado, O.TotalCaucion, E.CotizaMAE, E.VTeorico, O.TipoCambio2, O.PaseCB, E.CodNumCajaValores, ")
SQL.ADD("       O.FechaPago,    1 Valor, O.Cotizacion2, O.Mercado2 MercadoMon, O.Mercado MercadoTit, O.Mercado4 MercadoNeg ")
SQL.ADD("FROM   "~DBO~".BOPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
*SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and ((O.Cliente1 = '"~VAR('VEHICULODE')~"' and O.Mercado4='"~VAR('AMBMAE')~"' and '"~VAR('CLIENTEMAE')~"'=C.Codigo) or ((O.Cliente1 <> '"~VAR('VEHICULODE')~"' or O.Mercado4<>'"~VAR('AMBMAE')~"') and O.Cliente1=C.Codigo)) ")                                                                                                                                                                                                                                            
SQL.ADD("       and E.Codigo   = O.Especie ")
