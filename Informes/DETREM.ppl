CrearDialogo
    Fecha1: 'Fecha Desde' ;;;;;;;;;PriDeMes(Fsys);;;;;;
    Fecha2: 'Fecha Hasta' ;;;;;;;;;Fsys;;;;;;
    NrOperacion1: 'Op Acuerdo' ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar una operacion de referencia';NO;;;;;;"TipoOp = 'MMRPAC'";
    Precio1: 'Tipo Cambio' ;;;;;;;;;;;;;
    Radio1  : 'Expresado en|ARP|USD'  ;;;;;;;;;0;;;
    String1 : 'Banco'   ;;;;NO;NO;;;;;;
    Precio2: 'Tasa Colocacion' ;;;;NO;NO;;;;;;
    String2 : 'Moneda'   ;;;;NO;NO;;;;;;
    String3 : 'Cuenta'   ;;;;NO;NO;;;;;;
    String4 : 'Vehiculo' ;;;;NO;NO;;;;;;
    String5 : 'Book'     ;;;;NO;NO;;;;;;
FinDialogo

If Not Ok
    Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

***Insertar Logo
let &filaLogo 1
@LOGO


ACT(D:1,'DETALLE INTERESES REMUNERADAS')
SetFont(D:1,3)

SetFilaActual(5)

let &FilaActual fac
ACT(A:fac,'Fecha Desde: '~Dialogo.Fecha1)
ifa
ACT(A:fac,'Fecha Hasta: '~Dialogo.Fecha1)
ifa
ACT(A:fac,'Op. Acuerdo: ')
ACT(B:fac,Dialogo.NrOperacion1)
ACLO(B:fac,Dialogo.NrOperacion1)
ifa
IF Dialogo.Precio1 <> 1
    ACT(A:fac,'Tipo Cambio: '~Fstr(Dialogo.Precio1,0,8))
    ifa
ENDIF
ACT(A:fac,'Expresado en: '~IIF(Dialogo.Radio1 = 0,'ARP','USD'))
ifa
ACT(A:fac,'Vehiculo: '~Dialogo.String4)
ifa
ACT(A:fac,'Book: '~Dialogo.String5)
ifa
IF NoVacio(Dialogo.String1)
    ACT(A:fac,'Banco: '~Dialogo.String1)
    ifa
ENDIF
IF NoVacio(Dialogo.String3)
    ACT(A:fac,'Cuenta: '~Dialogo.String3)
    ifa
ENDIF
IF NoVacio(Dialogo.Precio2)
    ACT(A:fac,'Tasa Colocacion: '~Fstr(Dialogo.Precio2,0,8))
    ifa
ENDIF
IF NoVacio(Dialogo.String2)
    ACT(A:fac,'Moneda: '~Dialogo.String2)
    ifa
ENDIF
SetFont(A:&FilaActual..B:fac,4)

let &TipoCambio Dialogo.Precio1

ifa
ifa

ACT(A:fac,'Operacion')
ACT(B:fac,'Fecha')
ACT(C:fac,'Plazo')
ACT(D:fac,'Saldo Dia')
ACT(E:fac,'Saldo Promedio')
ACT(F:fac,'Intereses')
AgregarMarco(a:fac..F:fac,1,3,Exe('COLOR'))
SetFont(a:fac..F:fac,2)

let &TotalIntereses 0

*TipoCambio ponerlo si es diferente a 1. Tanto acá como en el detalle.

SQL.ADD(" SELECT NrOperacion, FechaOp, FechaVto, Especie, Precio1, Plazo, Cantidad, TotalIntereses, TotalNetoCli1 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES ")
SQL.ADD(" WHERE TipoOp = 'MMCCR' ")
SQL.ADD(" AND FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND OperacionRef = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
    ACT(A:fac,fbn('NrOperacion'))
    ACLO(A:fac,fbn('NrOperacion'))
    ACD(B:fac,fbn('FechaOp'))
    ACT(C:fac,Fstr(fbn('Plazo'),0,0))
    ACN(D:fac,fbn('TotalNetoCli1')*&TipoCambio)
    ACN(E:fac,fbn('Cantidad')*&TipoCambio)
    ACN(F:fac,fbn('TotalIntereses')*&TipoCambio)
    let &TotalIntereses &TotalIntereses+Val(F:fac)
    SetFont(a:fac..F:fac,1)
Proximo
ifa
ACT(A:fac,'Total')
ACN(F:fac,&TotalIntereses)
AgregarMarco(a:fac..F:fac,1,3,Exe('COLOR'))
SetFont(a:fac..F:fac,2)

ACO(1,9)
ACO(3,4)
ACO(4,12)
ACO(5,12)
ACO(7,10)

ACT(A:fac+2,'Fin del informe')

SetFont(a:fac+2,4)
LimitesVision(H:fac+2)