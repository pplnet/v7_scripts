HOJAVISIBLE(NO)
CrearDialogo
  Fecha1     :'Fecha Desde';;;;;;Dialogo.Fecha1<=FSys;'Debe ingresar una fecha';NO;FSys
  Fecha2     :'Fecha Hasta';;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe ingresar una fecha';NO;FSys
  Radio1     :'|Provisorio|Definitivo' ;;;;;NO;;;;;1
  Vehiculo1  : 'Vehiculo'  ;;;;NO;NO;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Especie1   :'Moneda Totales' ;;;;NO;NO;noVacio(Dialogo.Especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";
  Check1     :'MAE/BYMA'               ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATMB'),'SI'),1,0);
  Check2     :'ROFEX/DNF'              ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATROF'),'SI'),1,0);
  Check3     :'MAV'                    ;;;;NO;NO;;;;IIF(EqStr(VAR('COPIATMAV'),'SI'),1,0);
  Radio2     :'|Manual|Evento'         ;;;;NO;NO;;;;;0
  
FinDialogo

IF NOT OK   
  Cancelar
Endif

Recorrer&k Dialogo.Fecha1, Dialogo.Fecha2

  if EsHabil(Fecha(&k), 'ARG')
     LinkearHoja('COPIAX',1,Fecha1 = Fecha(&k), Radio1 =Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1, Fecha2 = &k,Radio2=Dialogo.Radio2,Especie1=Dialogo.Especie1,Check1=Dialogo.Check1,Check2=Dialogo.Check2,Check3=Dialogo.Check3)
  endif
  Proximo 