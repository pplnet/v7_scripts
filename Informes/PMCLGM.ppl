ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  : 'Fecha Desde'   ;;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;PriDeMes(FSys,SI);PriDeMes(DIALOGO.FECHA2,SI)
  Fecha2  : 'Fecha Hasta'   ;;;;;;NoVacio(Dialogo.Fecha2);'Debe ingresar la Fecha Hasta';NO;FinDeMes(FSys,SI);FinDeMes(DIALOGO.FECHA1,SI)
  Cliente1: 'Cliente'       ;;;;;;Vacio(Dialogo.Cliente1) o [EsTerminal(Dialogo.Cliente1,Clientes) y Not EqStr(BuscarCampo('CLIENTES','Sector','Codigo',Dialogo.Cliente1),'BAN') y Not EqStr(BuscarCampo('CLIENTES','Persona','Codigo',Dialogo.Cliente1),'SI')];'Cliente incorrecto';NO;;;;;;;;;"isnull(Sector,' ')<>'BAN' and  isnull(Persona,' ')<>'SI'  "
  Check1:   'Solo c/Asist.';;;;;NO;;;;;1
FinDialogo
if Not OK
  Cancelar
endif

if NoVacio(Dialogo.Cliente1)
  if Not EsTerminal(Dialogo.Cliente1,Clientes)
    ACT(v1, Dialogo.Cliente1)
  else
    Cancelar('Cliente no vßlido')
  endif 
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACN(ww1,FAC)

ACT(a:FAC, 'Control de Limites de Graduacion (BCRA) - Mensual')
ACT(a:FAC+1, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)

ACT(o:FAC, 'RPC')
ACT(p:FAC, 'Porcentaje')
ACT(q:FAC, 'Limite')

ACN(o:FAC+1, BuscarCampo('CLIENTES','Valor3','Codigo',Var('VEHICULODE')))
ACN(p:FAC+1, VAR('BCGRARPC'))
ACN(q:FAC+1, Val(o:FAC+1)*Val(p:FAC+1)/100)
AlinearCeldas(o:FAC+1..q:FAC+1,'D')

AgregarMarco(o:FAC..q:FAC+1,2,3)

ACT(a:FAC+3, 'Cliente')

SetFont(a:FAC..n:FAC+1,2)


ACT(r:FAC, 'Control de Limites de Graduacion (BCRA) - Mensual')
ACT(r:FAC+1, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)

ACT(ae:FAC, 'RPC')
ACT(af:FAC, 'Porcentaje')
ACT(ag:FAC, 'Limite')

ACN(ae:FAC+1, val(o:fac+1))
ACN(af:FAC+1, val(p:fac+1))
ACN(ag:FAC+1, val(q:fac+1))

AlinearCeldas(ae:FAC+1..ag:FAC+1,'D')

AgregarMarco(ae:FAC..ag:FAC+1,2,3)

SetFont(r:FAC..r:FAC+1,2)



SetFilaActual(FAC+3)
acn(ww3,fac)

ACD(zz2, Dialogo.Fecha1)
ACD(zz4, Dialogo.Fecha2)

Recorrer&i 1,31
  ACN(&i+1:fac, &i)
Proximo
FormatoCeldas(2:fac..&i+2:fac,Exe('F0'))  
AgregarMarco(1:fac..34:fac,2,2,EXE('COLOR10'))
ACO(1,8)

Recorrer&i 2,34
  ACO(&i,8)
Proximo

(.'PMOAUXCLGM'.)


Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC,2)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
AgregarBMP(r1,Exe('LOGO'),Exe('ESCALOGO'))


*** Desplazamiento de filas hacia la derecha para incluir el Cliente en la segunda hoja...

ACN(cc1,34)
recorrer&i 19,34
  recorrer&j 8,fac-2
    if val(aq:&j)<>1
      ACN(val(cc1):&j,val(val(cc1)-1:&j))
    endif
  proximo
  SCN(cc1,-1)
proximo

SetFont(ah:8..ah:fac-2,2)
SetFont(r:fac-2..ah:fac-2,2)

ACT(r:7, 'Cliente')

recorrer&k 8,fac-2
  ACT(r:&k,val(a:&k))
  if val(aq:&k)=1
    SetFont(r:&k,2)
  endif
proximo

SetFont(r:fac-2,2)
ACT(ah:fac-2,'')

recorrer&k 17,31
  ACT(&k+2:7, FStr(&k,1,0))
proximo



LimitesVision(ah:FAC)
RangoTitulo(a:1..ah:FAC, 7)

SetMargins(0,0,0,1.5)
SetPrintFit(3,75)
