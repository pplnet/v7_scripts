*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  :  'Fecha'    ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Invalida';NO;FSys
  Vehiculo1: 'Vehiculo' ;;;;NO;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
FinDialogo
if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

***---Este informe baja primero los MTM FPA. Luego ubica los MTM del MAE en las filas correspon-
***---dientes con los MTM FPA. Si no los encuentra los inserta. Por ultimo recorre los MTM FPA
***---para ver cuales no tienen sus correspondencias con el MAE.

ACN(bz:1, 0)
ACT(bz:2, 'OK')

**AgregarBMP(A:1, Exe('LOGO'), 60)
SetFilaActual(2)
ACT(a:fac, CodigoInforme)
SetFilaActual(4)
ACT(D:fac, 'Conciliacion FPA - MAE')
SetFont(D:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(A:fac-1..A:fac, 2)

SetFilaActual(fac+2)
ACT(A:fac, 'Agente')
ACT(B:fac, 'Especie')
ACT(C:fac, 'Vto')
ACT(D:fac, 'MTM FPA')
ACT(E:fac, 'MTM MAE')
ACT(F:fac, 'Diferencia')
SetFont(A:fac..F:fac, 2)
AlinearCeldas(A:fac..F:fac, 'C')
AgregarMarco(A:fac..F:fac, 0, 0, Exe('COLOR'))

ACN(BD:1, 0)
ACN(FI:1, fac+1)
***---MTM FPA
SQL.ADD("Select M.Cliente, O.Especie, M.NrOperacion, M.Cantidad, O.FechaVto ")
SQL.ADD("  From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("   and O.TipoOp      IN ('FXOCTC','FXOCTV') ")
SQL.ADD("   and M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and M.NrSaldo     = 100 ")
SQL.ADD("   and O.Vehiculo1   = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("Order By M.Cliente, O.Especie, O.FechaVto ")
Recorrer SQL
  ACN(BD:1, 1)
  SCN(TO:1, fbn('Cantidad'))
  if Not Eqstr(fbn('Cliente'), Val(CL:1))
    if Not CeldaVacia(CL:1)
      SetFont(A:Val(FA:1)+1..F:fac, 1)
    else
      ifa
      ***---Fila Inicial
      ACN(FI:2, fac)
    endif
    ACT(A:fac, fbn('Cliente'))
    SCN(D:fac, fbn('Cantidad'))
    ACN(FA:1, fac)
    ifa
    ACT(B:fac, fbn('Especie'))
    ACD(C:fac, fbn('FechaVto'))
    SCN(D:fac, fbn('Cantidad'))
    ACN(FE:1, fac)
    ACT(CL:1, fbn('Cliente'))
    ACT(ES:1, fbn('Especie'))
    ACD(FV:1, fbn('FechaVto'))
    ACT(AG:fac, fbn('Cliente'))
  else
    SCN(D:Val(FA:1), fbn('Cantidad'))
    if Not Eqstr(fbn('Especie'), Val(ES:1)) O fbn('FechaVto') <> Val(FV:1)
      ACT(B:fac, fbn('Especie'))
      ACD(C:fac, fbn('FechaVto'))
      SCN(D:fac, fbn('Cantidad'))
      ACN(FE:1, fac)
      ACT(ES:1, fbn('Especie'))
      ACD(FV:1, fbn('FechaVto'))
      ACT(AG:fac, fbn('Cliente'))
    else
      DFA
      SCN(D:Val(FE:1), fbn('Cantidad'))
    endif
  endif
Proximo
if Val(BD:1) = 0
  Cancelar('El MTM FPA del Dia No Ha Sido Procesado')
endif
SetFont(A:Val(FA:1)+1..F:fac, 1)
***---Fila Final FPA
ACN(FI:3, fac)

***---MTM MAE
***---Tabla MTMTOCT
**********************************************************************************************
***---Campo                    Nivel1           Nivel2           Nivel3               Nivel4 *
***---Especie                                                                          xxxx  *
***---TipoNegociacion                                             xxxx                 xxxx  *
***---Fecha                     xxxx             xxxx             xxxx                 xxxx  *
***---Variable                                                                         xxxx  *
***---Cliente                                    xxxx             xxxx                 xxxx  *
***---NroPlazo                                                                         xxxx  *
***---Paso                      xxxx             xxxx             xxxx                 xxxx  *
***---Excluido                                   xxxx             xxxx                 xxxx  *
***---Monto                     xxxx             xxxx             xxxx                 xxxx  *
***---FechaVar                                                                         xxxx  *
**********************************************************************************************

***---Cantidad de Registros 4416 que indica el MAE que envio
ACN(FL:1, SQL(" Select Cantidad From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = '4416' and Paso = 0 "))
***---Cantidad de Registros 4416 recibidos
ACN(MO:1, SQL(" Select Count(*) From "~DBO~".MTMOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Paso = 0  "))
if Val(FL:1) <> Val(MO:1)
  MessageBox('La Cantidad de Registros MTM Recibidos por el MAE es Invalida')
endif

***---Cantidad de Registros 4426 que indica el MAE que envio
ACN(FL:2, SQL(" Select Cantidad From "~DBO~".FLAGSOCT Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = '4426' "))
***---Cantidad de Registros 4426 recibidos
ACN(MO:2, SQL(" Select Count(*) From "~DBO~".MTMDETOCT Where FechaProc = '"~IdxDate(Dialogo.Fecha1)~"' "))
if Val(FL:2) <> Val(MO:2)
  MessageBox('La Cantidad de Registros DETALLE de MTM Recibidos por el MAE es Invalida')
endif


ACN(BD:2, 0)

***---Nivel1: Multilateral
SQL.ADD("Select Cliente, Especie, Monto, 5 Nivel, FechaVar FechaVto ")
SQL.ADD("  From "~DBO~".MTMOCT ")
SQL.ADD(" Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Paso  = 0 ")
SQL.ADD("   and (Especie         Is Null or Especie         = '' or Especie         = ' ') ")
SQL.ADD("   and (TipoNegociacion Is Null or TipoNegociacion = '' or TipoNegociacion = ' ') ")
SQL.ADD("   and (Cliente         Is Null or Cliente         = '' or Cliente         = ' ') ")

SQL.ADD(" UNION ")

***---Nivel2: No se levanta porque es como Nivel3 pero sin TipoNegociacion
***---Nivel3: Agente
SQL.ADD("Select Cliente, Especie, Monto, 3 Nivel, FechaVar FechaVto ")
SQL.ADD("  From "~DBO~".MTMOCT ")
SQL.ADD(" Where Fecha           = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Paso            = 0 ")
SQL.ADD("   and (Especie Is Null OR Especie = '' OR Especie = ' ') ")
SQL.ADD("   and TipoNegociacion Is Not Null ")
SQL.ADD("   and TipoNegociacion <> '' ")
SQL.ADD("   and TipoNegociacion <> ' ' ")
SQL.ADD("   and Cliente         Is Not Null ")
SQL.ADD("   and Cliente         <> '' ")
SQL.ADD("   and Cliente         <> ' ' ")

SQL.ADD(" UNION ")

***---Nivel4: Maximo detalle: Especie-Vto-Cliente-TipoNegociacion
SQL.ADD("Select Cliente, Especie, Monto, 4 Nivel, FechaVar FechaVto ")
SQL.ADD("  From "~DBO~".MTMOCT ")
SQL.ADD(" Where Fecha           = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Paso            = 0 ")
SQL.ADD("   and Especie         Is Not Null ")
SQL.ADD("   and Especie         <> '' ")
SQL.ADD("   and Especie         <> ' ' ")
SQL.ADD("   and TipoNegociacion Is Not Null ")
SQL.ADD("   and TipoNegociacion <> '' ")
SQL.ADD("   and TipoNegociacion <> ' ' ")
SQL.ADD("   and Cliente         Is Not Null ")
SQL.ADD("   and Cliente         <> '' ")
SQL.ADD("   and Cliente         <> ' ' ")
SQL.ADD(" Order By 4 ")
Recorrer SQL
  DFA
  ACN(BD:2, 1)
  ACN(BD:3, 0)
  ACN(BD:4, 0)
  Recorrer&k Val(FI:2), Val(FI:3)
    if fbn('Nivel') = 3 y Eqstr(fbn('Cliente'), Val(A:&k))
      ACN(BD:3, 1)
      ACN(E:&k, fbn('Monto'))
      ACN(F:&k, Val(D:&k) - Val(E:&k))
      ACL(F:&k, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = fbn('Cliente'), Especie1 = '', Fecha2 = 0, Vehiculo1 = Dialogo.Vehiculo1)
      if Val(f:&k)>0.01 o Val(f:&k)<-0.01
        ACN(bz:1, 1)
        ACT(bz:2, 'DIF')
      endif
      SetFont(e:&k..f:&k, 2)
    endif
    if fbn('Nivel') = 4 y Eqstr(fbn('Especie'), Val(B:&k)) Y fbn('FechaVto') = Val(C:&k) Y Eqstr(fbn('Cliente'), Val(AG:&k))
      ACN(BD:4, 1)
      ACN(E:&k, fbn('Monto'))
      ACN(F:&k, Val(D:&k) - Val(E:&k))
      ACL(F:&k, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = fbn('Cliente'), Especie1 = fbn('Especie'), Fecha2 = fbn('FechaVto'), Vehiculo1 = Dialogo.Vehiculo1)
      if Val(f:&k)>0.01 o Val(f:&k)<-0.01
        ACN(bz:1, 1)
        ACT(bz:2, 'DIF')
      endif
      SetFont(E:&k..F:&k, 1)
    endif
  Proximo
  if fbn('Nivel') = 3 Y Val(BD:3) = 0
    ***---FPA no tiene este registro de Agente
    IFA
    ACT(A:fac, fbn('Cliente'))
    ACN(E:fac, fbn('Monto'))
    ACN(F:fac, -fbn('Monto'))
    ACL(F:fac, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = fbn('Cliente'), Especie1 = '', Fecha2 = 0, Vehiculo1 = Dialogo.Vehiculo1)
    if Val(f:fac)>0.01 o Val(f:fac)<-0.01
      ACN(bz:1, 1)
      ACT(bz:2, 'DIF')
    endif
  endif
  if fbn('Nivel') = 4 Y Val(BD:4) = 0
    ***---FPA no tiene este registro de Maximo Detalle. Recorro de nuevo desde el ppio. hasta el ultimo agente insertado
    Recorrer&i Val(FI:2), fac
      if Eqstr(fbn('Cliente'), Val(A:&i))
        InsertarFila(&i+1)
        ACT(B:&i+1, fbn('Especie'))
        ACD(C:&i+1, fbn('FechaVto'))
        ACN(E:&i+1, fbn('Monto'))
        ACN(F:&i+1, -fbn('Monto'))
        ACL(F:&i+1, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = fbn('Cliente'), Especie1 = fbn('Especie'), Fecha2 = fbn('FechaVto'), Vehiculo1 = Dialogo.Vehiculo1)
        if Val(f:&i+1)>0.01 o Val(f:&i+1)<-0.01
          ACN(bz:1, 1)
          ACT(bz:2, 'DIF')
        endif
        SetFont(A:&i+1..F:&i+1, 1)
        SCN(FI:3, 1)
        ifa
      endif
    Proximo
  endif
  if fbn('Nivel') = 5
    ***---Ultimo Registro
    ACN(E:fac+2, fbn('Monto'))
  endif
Proximo
if Val(BD:2) = 0
   Cancelar('No se Ha Recibido MTM MAE del Dia')
endif

ACT(TM:1, 'Total Multilateral')

Recorrer&k Val(FI:2), Val(FI:3)
  ***---Esto porque el insetarfila no desplaza los formatos
  if Not CeldaVacia(A:&k)
    AgregarMarco(A:&k..F:&k, 0, 0, Exe('COLOR10'))
    SetFont(A:&k..F:&k, 2)
  endif
Proximo

SetFilaActual(fac+2)
ACT(A:fac, Val(TM:1))
ACN(D:fac, Val(TO:1))
ACN(F:fac, Val(D:fac) - Val(E:fac))
ACL(F:fac, 'DETCO3',     Fecha1=Dialogo.Fecha1, Cliente1='', Especie1='', Fecha2=0, Vehiculo1=Dialogo.Vehiculo1)
if Val(f:fac)>0.01 o Val(f:fac)<-0.01
  ACN(bz:1, 1)
  ACT(bz:2, 'DIF')
endif
LinkearHoja('DETCO3', 1, Fecha1=Dialogo.Fecha1, Cliente1='', Especie1='', Fecha2=0, Vehiculo1=Dialogo.Vehiculo1)
if LinkH(1, z2) > 0
  ACT(g:fac, 'Revise Detalle')
  AlinearCeldas(g:fac, 'C')
  SetFont(g:fac, 2)
  ACN(bz:1, 1)
  ACT(bz:2, 'DIF')
endif
CerrarHoja('DETCO3', 1)
SetFont(A:fac..F:fac, 2)
AgregarMarco(A:fac..F:fac, 0, 0, Exe('COLOR'))

***---Busco Registros que tiene FPA y no el MAE
Recorrer&k Val(FI:2), Val(FI:3)
  if CeldaVacia(e:&k) Y Not CeldaVacia(d:&k)
    ACN(F:&k, Val(d:&k) - Val(e:&k))
    if Val(f:&k)>0.01 o Val(f:&k)<-0.01
      ACN(bz:1, 1)
      ACT(bz:2, 'DIF')
    endif
    if CeldaVacia(A:&k)
      ***---Maximo Detalle
      ACL(f:&k, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = Val(AG:&k), Especie1 = Val(B:&k), Fecha2 = Val(C:&k), Vehiculo1 = Dialogo.Vehiculo1)
      SetFont(f:&k, 1)
    else
      if Eqstr(Val(A:&k), Val(TM:1))
        ACL(f:&k, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = '', Especie1 = '', Fecha2 = 0, Vehiculo1 = Dialogo.Vehiculo1)
      else
        ***---Nivel 3 por Cliente
        ACL(f:&k, 'DETCO3', Fecha1 = Dialogo.Fecha1, Cliente1 = Val(A:&k), Especie1 = '', Fecha2 = 0, Vehiculo1 = Dialogo.Vehiculo1)
      endif
      SetFont(f:&k, 2)
    endif
  endif
proximo
FormatoCeldas(D:Val(FI:1)..F:fac, Exe('F2'))

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACO(4, 12)
ACO(5, 12)
ACO(6, 12)
ACO(7, 10)
LimitesVision(G:fac+1)

*MessageBox('Llama Evento CONMTM')
EjecutarEvento('CONMTM',Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(bz:1))
