*FO 09/02/2007 SQL.ADD("SELECT O.Especie, E.Nombre, E.Cupon Cupon, O.Mercado, O.TipoOp, O.Cantidad, O.FechaVto, ISNULL(O.PaseCB,0) PaseCB, ")
SQL.ADD("SELECT O.Especie, E.Nombre, O.Cupon1 Cupon, O.Mercado, O.TipoOp, Abs(MOV.Cantidad) Cantidad, MOV.FechaMov FechaVto, ISNULL(O.PaseCB,0) PaseCB, ")
SQL.ADD("  E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, '' Inv,O.FechaOp, O.NrOperacion, ")
SQL.ADD(" O.TipoOp TipoOp2, 'Q6' Tipo ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES MOV ")
SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")

SQL.ADD("      MOV.NrOperacion=O.NrOperacion and ")
SQL.ADD("      MOV.NrSaldo=1 and ")
SQL.ADD("      MOV.Especie=O.Especie and ")

** AA 10/02/2022 Se toman Cuenta y Orden
**SQL.ADD("  O.CB4 <> 1 AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("      E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ELSE
   SQL.ADD("      E.Status='HAB' AND ")
   SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' AND ")
ENDIF
SQL.ADD("      O.Especie = E.Codigo AND ")
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("      O.Mercado IN ("~Pipe2Comillas(Dialogo.Lista2)~") AND ")
ENDIF
SQL.ADD("      IsNull(O.Cartera,0) >= 0  ") 
SQL.ADD(" AND  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'       ")
SQL.ADD(" AND  O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
** FJL 08-06-18 - Se incorporan TCOPRI de Cartera Propia
*SQL.ADD(" AND O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA','TIDE','TIPO','TICO','TICT') ")
** FJL 18-07-22 - Excluidr Operaciones Cta y Orden
