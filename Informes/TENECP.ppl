***---Patas de Pase
SQL.ADD(" Select O.Especie, E.Nombre, O.Cupon1 Cupon, O.Mercado, 'PASE' TipoOp, O.Cantidad, O.FechaVto, O.PaseCB, ")
SQL.ADD(" E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, '' Inv, O.FechaOp, O.NrOperacion, ")
SQL.ADD(" O.TipoOp TipoOp2, 'Q8' Tipo ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" Where O.Especie = E.Codigo ")
SQL.ADD(" AND O.TipoOp In ('TIC','TIV','TIFC','TIFV') ")
SQL.ADD(" AND O.PaseCB=1 ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
** AA 10/02/2022 No se toman Cuenta y Orden
** FJL 06/09/2022 Si estaba en Null no las tomaba
*SQL.ADD("  AND O.CB4 <> 1 ")
SQL.ADD("  AND IsNull(O.CB4,0) <> 1 ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("  AND  E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ELSE
   SQL.ADD(" AND  E.Status='HAB' ")
   SQL.ADD(" AND  E.Jerarquia LIKE '"~Var('JERTITULOS')~"%' ")
ENDIF
SQL.ADD(" AND O.Especie = E.Codigo ")
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND O.Mercado IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
ENDIF
** FJL 05/05/23 - Issue 6385 - Sacar cuando esta liquidada la pata
SQL.ADD(" AND  O.NrOperacion IN (SELECT DISTINCT M.NrOperacion FROM "~DBO~".MOVPENDIENTES M ")
SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion  ")
SQL.ADD("                        AND   M.Especie     = O.Especie      ")
IF Incluido('101', Val(SL:1))
    SQL.ADD("                        UNION ")
    SQL.ADD("                        SELECT DISTINCT M.NrOperacion FROM "~DBO~".MOVEJECUTADOS M ")
    SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion  ")
    SQL.ADD("                        AND   M.Especie     = O.Especie      ")
*    SQL.ADD("                        AND   EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1,"~DBO~".MOVPENDIENTES MP1 ")
    SQL.ADD("                        AND   Not EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1,"~DBO~".MOVEJECUTADOS MP1 ")
    SQL.ADD("                                        WHERE T.NrTrans  = M.NrTrans2        ")
    SQL.ADD("                                        AND   T1.NrTrans = T.NrOperacionRef2 ")
    SQL.ADD("                                        AND   T1.NrTrans = MP1.NrOperacion   ")
    SQL.ADD("                                        AND   O.Especie  = MP1.Especie       ")
    SQL.ADD("                                        AND   MP1.NrSaldo = 101)             ")
ENDIF
SQL.ADD("                        )  ")
SQL.ADD(" ORDER BY 1, 3, 4, 5  ")

Watch(SQL.Batch())

* Fila donde comienzan los datos
ACN(fe1, 8)
* Fila actual
ACN(fi1, Val(fe1))
* Fila de valor nominal
ACN(aa1, 0)
* Fila de valor residual
ACN(aa2, 0)
* Fila de valuacion
ACN(aa3, 0)

* Primer pasada
ACT(aa4, 'SI')

* Especie
ACT(z1, '')
* Cupon
ACT(z2, 'XX')
* Mercado
ACT(z3, '')

Recorrer SQL

  SCN(ad:1, 1)
  ACT(ae:Val(ad:1), fbn('Especie'))
  ACT(af:Val(ad:1), fbn('Cupon'))
  ACT(ag:Val(ad:1), fbn('Mercado'))
  ACT(ah:Val(ad:1), fbn('TipoOp'))
  ACN(ai:Val(ad:1), fbn('Cantidad'))
  ACD(aj:Val(ad:1), fbn('FechaVto'))

  ACT(ak:Val(ad:1), fbn('Inv'))
  ACD(al:Val(ad:1), fbn('FechaOp'))
  
  ACT(am:Val(ad:1), fbn('NrOperacion'))
  ACT(an:Val(ad:1), fbn('TipoOp2'))
  ACT(ao:Val(ad:1), fbn('Tipo'))

  Message('Especie: '~FBN['Especie']~FBN['Cupon'])
   IF Not EqStr(FBN['Especie'],Val(z1)) o Not EqStr(FBN['Cupon'], Val(z2))
      IF EqStr(Val(aa4),'NO')
         * Saldo HOY
         ACN(F:Val(aa1), Val(b:Val(aa1))+Val(c:Val(aa1))-Val(d:Val(aa1)) + Val(E:Val(AA:1)))
         ACN(F:Val(aa2), Val(b:Val(aa2))+Val(c:Val(aa2))-Val(d:Val(aa2)) + Val(E:Val(AA:2)))

         * Saldo 24 Hs.
         ACN(J:Val(aa1), Val(F:Val(aa1))+Val(G:Val(aa1))-Val(H:Val(aa1)) + Val(I:Val(AA:1)))
         ACN(J:Val(aa2), Val(F:Val(aa2))+Val(G:Val(aa2))-Val(H:Val(aa2)) + Val(I:Val(AA:2)))

         * Saldo 48 Hs.
         ACN(N:Val(aa1), Val(J:Val(aa1))+Val(K:Val(aa1))-Val(L:Val(aa1)) + Val(M:Val(AA:1)))
         ACN(N:Val(aa2), Val(J:Val(aa2))+Val(K:Val(aa2))-Val(L:Val(aa2)) + Val(M:Val(AA:2)))

         * Saldo 72 Hs.
         ACN(R:Val(aa1), Val(N:Val(aa1))+Val(O:Val(aa1))-Val(P:Val(aa1)) + Val(Q:Val(AA:1)))
         ACN(R:Val(aa2), Val(N:Val(aa2))+Val(O:Val(aa2))-Val(P:Val(aa2)) + Val(Q:Val(AA:2)))

         * Saldo Final
         ACN(V:Val(aa1), Val(R:Val(aa1))+Val(S:Val(aa1))-Val(T:Val(aa1)) + Val(U:Val(AA:1)))
         ACN(V:Val(aa2), Val(R:Val(aa2))+Val(S:Val(aa2))-Val(T:Val(aa2)) + Val(U:Val(AA:2)))

         Recorrer&i 3, 21
         If Val(&i:Val(aa1))<>0 Y Not Buscar('Pases', Val(&I:Val(FI:2)))
         *               I*F &i <> 5 y &i <> 8 y &i <> 11 y &i <> 14
         IF &i <> 6 y &i <> 10 y &i <> 14 y &i <> 18
         *acn(xy1,&i)
         *messagebox('paso 1 '~Val(z3)~' Columna '~Val(xy1)~' Especie '~Val(z1)~' Cupon '~Val(z2))
                  ACL(&i:Val(aa1), 'DTENCP', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Mercado1=Val(z3), Cantidad1=&i, Especie1=Val(z1), Radio2=Dialogo.Radio2, String1=Val(z2))
               ENDIF
            Endif
         Proximo

         SCN(fi1, 1)
      ELSE
         ACT(aa4, 'NO')
      ENDIF
      * Corte por Especie
      ACT(z1, FBN['Especie'])
      ACT(z2, FBN['Cupon'])
      ACT(bl4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACT(a:Val(fi1), Val(z1)~' - '~FBN['Nombre']~' - Cup '~Val(z2))
      ACN(es1, Val(fi1))
      SetFont(a:Val(fi1), 1)
      AgregarMarco(a:Val(fi1)..V:Val(fi1),2,0,Exe('COLOR'))
      SCN(fi1, 1)

      * Corte por Mercado
      ACT(z3, FBN['Mercado'])
      ACT(a:Val(fi1), BUSCARCAMPO('MERCADOS','Descripcion','Codigo',Val(z3)))
      SetFont(a:Val(fi1), 1)
      SCN(fi1, 1)
      
      ACN(aa1, Val(fi1))
      ACT(a:Val(fi1), 'Valor Nominal')
      SCN(fi1, 1)
      ACN(aa2, Val(fi1))
      ACT(a:Val(fi1), 'Valor Residual')
      SCN(fi1, 1)

      ACN(b:Val(aa1), 0)
      ACN(b:Val(aa2), 0)

      * yt..yz -> parametros para la funcion INTERESCLE 
      ACN(yt1, 1)
      ACD(yu:1, Dialogo.Fecha1)
      ACT(yv:1, Val(z1))
      ACD(yx:1, FBN['FechaCambioTasa'])
      ACN(yy:1, FBN['TasaIntAnterior'])
      ACN(yz:1, FBN['TasaIntVigente'])

      ACN(vr2, FBN['Alias5'])
      ACT(in1, FBN['InteresesC'])
      ACN(vr1, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
      ACN(cc1, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,Val(mn1))) 
   ENDIF

   IF Not EqStr(FBN['Mercado'],Val(z3))
      IF EqStr(Val(aa4),'NO')
         * Saldo HOY
         ACN(F:Val(aa1), Val(b:Val(aa1))+Val(c:Val(aa1))-Val(d:Val(aa1)) + Val(E:Val(AA:1)))
         ACN(F:Val(aa2), Val(b:Val(aa2))+Val(c:Val(aa2))-Val(d:Val(aa2)) + Val(E:Val(AA:2)))

         * Saldo 24 Hs.
         ACN(J:Val(aa1), Val(F:Val(aa1))+Val(G:Val(aa1))-Val(H:Val(aa1)) + Val(I:Val(AA:1)))
         ACN(J:Val(aa2), Val(F:Val(aa2))+Val(G:Val(aa2))-Val(H:Val(aa2)) + Val(I:Val(AA:2)))

         * Saldo 48 Hs.
         ACN(N:Val(aa1), Val(J:Val(aa1))+Val(K:Val(aa1))-Val(L:Val(aa1)) + Val(M:Val(AA:1)))
         ACN(N:Val(aa2), Val(J:Val(aa2))+Val(K:Val(aa2))-Val(L:Val(aa2)) + Val(M:Val(AA:2)))

         * Saldo 72 Hs.
         ACN(R:Val(aa1), Val(N:Val(aa1))+Val(O:Val(aa1))-Val(P:Val(aa1)) + Val(Q:Val(AA:1)))
         ACN(R:Val(aa2), Val(N:Val(aa2))+Val(O:Val(aa2))-Val(P:Val(aa2)) + Val(Q:Val(AA:2)))

         * Saldo Final
         ACN(V:Val(aa1), Val(R:Val(aa1))+Val(S:Val(aa1))-Val(T:Val(aa1)) + Val(U:Val(AA:1)))
         ACN(V:Val(aa2), Val(R:Val(aa2))+Val(S:Val(aa2))-Val(T:Val(aa2)) + Val(U:Val(AA:2)))

         Recorrer&i 3, 21
            If Val(&i:Val(aa1))<>0 Y Not Buscar('Pases', Val(&I:Val(FI:2)))
            *               I*F &i <> 5 y &i <> 8 y &i <> 11 y &i <> 14
               IF &i <> 6 y &i <> 10 y &i <> 14 y &i <> 18
               *acn(xy1,&i)
               *messagebox('paso 2 Mercado '~Val(z3)~' Columna '~Val(xy1)~' Especie '~Val(z1)~' Cupon '~Val(z2))
                  ACL(&i:Val(aa1), 'DTENCP', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Mercado1=Val(z3), Cantidad1=&i, Especie1=Val(z1), Radio2=Dialogo.Radio2, String1=Val(z2))
               ENDIF
            Endif
         Proximo
      ELSE
         ACT(aa4, 'NO')
      ENDIF
      * Corte por Mercado
      ACT(z3, FBN['Mercado'])
      ACT(a:Val(fi1), BUSCARCAMPO('MERCADOS','Descripcion','Codigo',Val(z3)))
      SetFont(a:Val(fi1), 1)
      SCN(fi1, 1)
      
      ACN(aa1, Val(fi1))
      ACT(a:Val(fi1), 'Valor Nominal')
      SCN(fi1, 1)
      ACN(aa2, Val(fi1))
      ACT(a:Val(fi1), 'Valor Residual')
      SCN(fi1, 1)

      ACN(b:Val(aa1), 0)
      ACN(b:Val(aa2), 0)
   ENDIF


   * Si el registro es un saldo
   IF EqStr(FBN['TipoOp'], 'ASALDOPOSIC')
      * ca1 V.N. / ca2 V.R.
      ACN(ca1, FBN['Cantidad'])
      ACN(ca2,Round(val(ca1)*val(vr1),val(vr2)))

      ACN(b:Val(aa1), val(ca1))
      ACN(b:Val(aa2), Val(ca2))
   ENDIF
   * Si el registro no es un saldo
   IF NOT EqStr(FBN['TipoOp'], 'ASALDOPOSIC')
      *- ca1: Cantidad VN  ca2: VR ca3: Valuacion
      ACN(ca1,FBN['Cantidad'])
      ACN(ca2,Round(val(ca1)*val(vr1),val(vr2)))

      IF Eqstr(fbn('TipoOp'), 'PASE')
        IF Incluido(fbn('TipoOp2'), 'TIC|TIFC')
            ACN(SG:1, 1)
        ELSE
            ACN(SG:1, -1)
        ENDIF
        IF fbn('FechaVto') = Dialogo.Fecha1
            ACN(BD:55, 0)
            SQL.ADD(" Select NrOperacion From "~DBO~".MOVEJECUTADOS ")
            SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
            SQL.ADD(" AND NrSaldo IN ("~Pipe2Comillas(Val(SL:1))~") ")
            SQL.ADD(" AND Especie = '"~fbn('Especie')~"' ")
            Recorrer SQL
                DFA
                ***---Si ya fué liquidado lo ignoro porque suma en la columna de saldo inicial
                ACN(BD:55, 1)
            Proximo
            IF Val(BD:5) = 0
                SCN(E:Val(AA:1), fbn('Cantidad') * Val(SG:1))
                SCN(E:Val(AA:2), Round(fbn('Cantidad') * Val(SG:1) * Val(VR:1), Val(VR:2)))
                ACL(E:Val(AA:1), 'DETEPA', Fecha1=fbn('FechaVto'), Vehiculo1=Dialogo.Vehiculo1, Mercado1=fbn('Mercado'), Especie1=fbn('Especie'), Entero1 = fbn('Cupon'), Radio1=0)
            ENDIF
        ELSE
            IF fbn('FechaVto') = Habiles(Dialogo.Fecha1,1,'ARG')
                SCN(I:Val(AA:1), fbn('Cantidad') * Val(SG:1))
                SCN(I:Val(AA:2), Round(fbn('Cantidad') * Val(SG:1) * Val(VR:1), Val(VR:2)))
                ACL(I:Val(AA:1), 'DETEPA', Fecha1=fbn('FechaVto'), Vehiculo1=Dialogo.Vehiculo1, Mercado1=fbn('Mercado'), Especie1=fbn('Especie'), Entero1 = fbn('Cupon'), Radio1=0)
            ELSE
                IF fbn('FechaVto') = Habiles(Dialogo.Fecha1,2,'ARG')
                    SCN(M:Val(AA:1), fbn('Cantidad') * Val(SG:1))
                    SCN(M:Val(AA:2), Round(fbn('Cantidad') * Val(SG:1) * Val(VR:1), Val(VR:2)))
                    ACL(M:Val(AA:1), 'DETEPA', Fecha1=fbn('FechaVto'), Vehiculo1=Dialogo.Vehiculo1, Mercado1=fbn('Mercado'), Especie1=fbn('Especie'), Entero1 = fbn('Cupon'), Radio1=0)
                ELSE
                    IF fbn('FechaVto') = Habiles(Dialogo.Fecha1,3,'ARG')
                        SCN(Q:Val(AA:1), fbn('Cantidad') * Val(SG:1))
                        SCN(Q:Val(AA:2), Round(fbn('Cantidad') * Val(SG:1) * Val(VR:1), Val(VR:2)))
                        ACL(Q:Val(AA:1), 'DETEPA', Fecha1=fbn('FechaVto'), Vehiculo1=Dialogo.Vehiculo1, Mercado1=fbn('Mercado'), Especie1=fbn('Especie'), Entero1 = fbn('Cupon'), Radio1=0)
                    ELSE
                        IF fbn('FechaVto') > Habiles(Dialogo.Fecha1,3,'ARG')
                            SCN(U:Val(AA:1), fbn('Cantidad') * Val(SG:1))
                            SCN(U:Val(AA:2), Round(fbn('Cantidad') * Val(SG:1) * Val(VR:1), Val(VR:2)))
                            ACL(U:Val(AA:1), 'DETEPA', Fecha1=Habiles(Dialogo.Fecha1,3,'ARG'), Vehiculo1=Dialogo.Vehiculo1, Mercado1=fbn('Mercado'), Especie1=fbn('Especie'), Entero1 = fbn('Cupon'), Radio1=1)
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ENDIF
      ELSE
        * Compras a Liq.
        IF [Incluido(FBN['TipoOp'], 'CTC|CTP|TIC|TCOPRI|DTP|TIFC|DRT') y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'RTP') y EqStr(FBN['Inv'],'INV')]
             * HOY
             IF FBN['FechaVto'] <= HABILES(Dialogo.Fecha1,0,'ARG')
               SCN(c:Val(aa1), val(ca1))
               SCN(c:Val(aa2), val(ca2))
             ENDIF
             * 24 HS.
             IF FBN['FechaVto'] = HABILES(Dialogo.Fecha1,1,'ARG')
                SCN(G:Val(aa1), val(ca1))
                SCN(G:Val(aa2), val(ca2))
             ENDIF
             * 48 HS.
             IF FBN['FechaVto'] = HABILES(Dialogo.Fecha1,2,'ARG')
                SCN(K:Val(aa1), val(ca1))
                SCN(K:Val(aa2), val(ca2))
             ENDIF
             * 72 HS.
             IF FBN['FechaVto'] = HABILES(Dialogo.Fecha1,3,'ARG')
                SCN(O:Val(aa1), val(ca1))
                SCN(O:Val(aa2), val(ca2))
             ENDIF
             * > 72 HS.
             IF FBN['FechaVto'] > HABILES(Dialogo.Fecha1,3,'ARG')
                SCN(S:Val(aa1), val(ca1))
                SCN(S:Val(aa2), val(ca2))
             ENDIF
          ENDIF

          * Ventas a Liq.
          IF [Incluido(FBN['TipoOp'], 'VTC|VTP|TIV|RTP|TIFV|') y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'DRT|DTP|') y EqStr(FBN['Inv'],'INV')]
             * HOY
             IF FBN['FechaVto'] <= HABILES(Dialogo.Fecha1,0,'ARG')
                SCN(d:Val(aa1), val(ca1))
                SCN(d:Val(aa2), val(ca2))
             ENDIF
             * 24 HS.
             IF FBN['FechaVto'] = HABILES(Dialogo.Fecha1,1,'ARG')
                SCN(H:Val(aa1), val(ca1))
                SCN(H:Val(aa2), val(ca2))
             ENDIF
             * 48 HS.
             IF FBN['FechaVto'] = HABILES(Dialogo.Fecha1,2,'ARG')
                SCN(L:Val(aa1), val(ca1))
                SCN(L:Val(aa2), val(ca2))
             ENDIF
             * 72 HS.
             IF FBN['FechaVto'] = HABILES(Dialogo.Fecha1,3,'ARG')
                SCN(P:Val(aa1), val(ca1))
                SCN(P:Val(aa2), val(ca2))
             ENDIF
             * > 72 HS.
             IF FBN['FechaVto'] > HABILES(Dialogo.Fecha1,3,'ARG')
                SCN(T:Val(aa1), val(ca1))
                SCN(T:Val(aa2), val(ca2))
             ENDIF
          ENDIF

          *- mc1: Movimiento ejecutado concertacion 
          *- mv1: Movimiento Ejecutado Vto
          ACN(mc1,0)
          ACN(mv1,0)

          IF Incluido(FBN['TipoOp'], 'TIDE|TICT|TIPO|TICO')
             *- Chequeo si tiene algun movimiento ejecutado a la concertacion
             SQL.ADD("SELECT DISTINCT M.NrOperacion ")
             SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M ")
             SQL.ADD("WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' ")
             SQL.ADD("  AND M.Especie     = '"~FBN['Especie']~"' ")
             SQL.ADD("  AND M.FechaMov    = '"~IdxDate(FBN['FechaOp'])~"' ")
             SQL.ADD("  AND M.NrSaldo     = 1 ")
             SQL.ADD("  AND EXISTS ")
             SQL.ADD("(SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 ")
             SQL.ADD(" WHERE T.NrTrans=M.NrTrans2 ")
             SQL.ADD(" and T1.NrTrans=T.NrOperacionRef2 ")
             SQL.ADD(" AND T1.RB2=1) ")
             Recorrer SQL
                 dfa
                 ACN(mc1,1)
             Proximo

             *- Chequeo si tiene algun movimiento ejecutado vencimiento
             SQL.ADD("SELECT DISTINCT M.NrOperacion ")
             SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M ")
             SQL.ADD("WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' ")
             SQL.ADD("  AND M.Especie     = '"~FBN['Especie']~"' ")
             SQL.ADD("  AND M.FechaMov    = '"~IdxDate(FBN['FechaVto'])~"' ")
             SQL.ADD("  AND M.NrSaldo     = 1 ")
             SQL.ADD("  AND EXISTS ")
             SQL.ADD("(SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 ")
             SQL.ADD("  WHERE T.NrTrans=M.NrTrans2 ")
             SQL.ADD("    and T1.NrTrans=T.NrOperacionRef2 ")
             SQL.ADD("    AND T1.RB2=1)  ")
             Recorrer SQL
                 dfa
                 ACN(mv1,1)
             Proximo      
          EndIf

          ACN(ap:Val(ad:1), Val(mc:1))
          ACN(aq:Val(ad:1), Val(mv:1))
          * Ingresos a Liq
          IF [Incluido(FBN['TipoOp'], 'TIDE|TICT') y FBN['FechaVto']=FBN['FechaOp']] o [Incluido(FBN['TipoOp'], 'TIPO|TICO') y FBN['FechaVto']>FBN['FechaOp']]
             * HOY
             IF [val(mc1)=0 y FBN['FechaOp']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mv1)=0 y FBN['FechaVto']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(c:Val(aa1), val(ca1))
                SCN(c:Val(aa2), val(ca2))
             ENDIF
             * 24 HS.
             IF [val(mc1)=0 y FBN['FechaOp'] = HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mv1)=0 y FBN['FechaVto']=HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(G:Val(aa1), val(ca1))
                SCN(G:Val(aa2), val(ca2))
             ENDIF
             * 48 HS.
             IF [val(mc1)=0 y FBN['FechaOp'] = HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mv1)=0 y FBN['FechaVto']=HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(K:Val(aa1), val(ca1))
                SCN(K:Val(aa2), val(ca2))
             ENDIF
             * 72 HS.
             IF [val(mc1)=0 y FBN['FechaOp'] = HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mv1)=0 y FBN['FechaVto'] =HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(O:Val(aa1), val(ca1))
                SCN(O:Val(aa2), val(ca2))
             ENDIF
             * > 72 HS.
             IF [val(mc1)=0 y FBN['FechaOp'] > HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mv1)=0 y FBN['FechaVto'] >HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(S:Val(aa1), val(ca1))
                SCN(S:Val(aa2), val(ca2))
             ENDIF
          ENDIF
          * Egresos a Liq
          IF [Incluido(FBN['TipoOp'], 'TIDE|TICT') y FBN['FechaVto']>FBN['FechaOp']] o [Incluido(FBN['TipoOp'], 'TIPO|TICO') y FBN['FechaVto']=FBN['FechaOp']]
             * HOY
             IF [val(mv1)=0 y FBN['FechaVto']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mc1)=0 y FBN['FechaOp']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(d:Val(aa1), val(ca1))
                SCN(d:Val(aa2), val(ca2))
             ENDIF
             * 24 HS.
             IF [val(mv1)=0 y FBN['FechaVto'] = HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mc1)=0 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(H:Val(aa1), val(ca1))
                SCN(H:Val(aa2), val(ca2))
             ENDIF
             * 48 HS.
             IF [val(mv1)=0 y FBN['FechaVto'] = HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mc1)=0 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(L:Val(aa1), val(ca1))
                SCN(L:Val(aa2), val(ca2))
             ENDIF
             * 72 HS.
             IF [val(mv1)=0 y FBN['FechaVto'] = HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mc1)=0 y FBN['FechaOp'] =HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(P:Val(aa1), val(ca1))
                SCN(P:Val(aa2), val(ca2))
             ENDIF
             * > 72 HS.
             IF [val(mv1)=0 y FBN['FechaVto'] > HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT|')] o [val(mc1)=0 y FBN['FechaOp'] >HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'], 'TIPO|TICO|')] 
                SCN(T:Val(aa1), val(ca1))
                SCN(T:Val(aa2), val(ca2))
             ENDIF
          ENDIF
      ENDIF
   ENDIF
Proximo
IF EqStr(Val(aa4),'NO')
   * Saldo HOY
   ACN(F:Val(aa1), Val(b:Val(aa1))+Val(c:Val(aa1))-Val(d:Val(aa1)) + Val(E:Val(AA:1)))
   ACN(F:Val(aa2), Val(b:Val(aa2))+Val(c:Val(aa2))-Val(d:Val(aa2)) + Val(E:Val(AA:2)))

   * Saldo 24 Hs.
   ACN(J:Val(aa1), Val(F:Val(aa1))+Val(G:Val(aa1))-Val(H:Val(aa1)) + Val(I:Val(AA:1)))
   ACN(J:Val(aa2), Val(F:Val(aa2))+Val(G:Val(aa2))-Val(H:Val(aa2)) + Val(I:Val(AA:2)))

   * Saldo 48 Hs.
   ACN(N:Val(aa1), Val(J:Val(aa1))+Val(K:Val(aa1))-Val(L:Val(aa1)) + Val(M:Val(AA:1)))
   ACN(N:Val(aa2), Val(J:Val(aa2))+Val(K:Val(aa2))-Val(L:Val(aa2)) + Val(M:Val(AA:2)))

   * Saldo 72 Hs.
   ACN(R:Val(aa1), Val(N:Val(aa1))+Val(O:Val(aa1))-Val(P:Val(aa1)) + Val(Q:Val(AA:1)))
   ACN(R:Val(aa2), Val(N:Val(aa2))+Val(O:Val(aa2))-Val(P:Val(aa2)) + Val(Q:Val(AA:2)))

   * Saldo Final
   ACN(V:Val(aa1), Val(R:Val(aa1))+Val(S:Val(aa1))-Val(T:Val(aa1)) + Val(U:Val(AA:1)))
   ACN(V:Val(aa2), Val(R:Val(aa2))+Val(S:Val(aa2))-Val(T:Val(aa2)) + Val(U:Val(AA:2)))


   Recorrer&i 3, 21
      If Val(&i:Val(aa1))<>0 Y Not Buscar('Pases', Val(&I:Val(FI:2)))
      *         I*F &i <> 5 y &i <> 8 y &i <> 11 y &i <> 14
         IF &i <> 6 y &i <> 10 y &i <> 14 y &i <> 18
         *acn(xy1,&i)
         *messagebox('paso 3 Mercado '~Val(z3)~' Columna '~Val(xy1)~' Especie '~Val(z1)~' Cupon '~Val(z2))
            ACL(&i:Val(aa1), 'DTENCP', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Mercado1=Val(z3), Cantidad1=&i, Especie1=Val(z1), Radio2=Dialogo.Radio2, String1=Val(z2))
         ENDIF
      Endif
   Proximo
ENDIF

AgregarMarco(F:Val(fe1)..F:Val(aa2),2,0,Exe('COLOR'))
AgregarMarco(J:Val(fe1)..J:Val(aa2),2,0,Exe('COLOR'))
AgregarMarco(N:Val(fe1)..N:Val(aa2),2,0,Exe('COLOR'))
AgregarMarco(R:Val(fe1)..R:Val(aa2),2,0,Exe('COLOR'))
AgregarMarco(v:Val(fe1)..v:Val(aa2),2,0,Exe('COLOR'))

SCN(fi1, 1)
ACT(a:Val(fi1),'FIN DE LISTADO')
SetFont(a:Val(fi1), 1)

FormatoCeldas(b9..V:Val(fi1), Exe('F2'))

SetFont(b9..V:Val(fi1), 2)

Impresion(1,2)

ACO(1, 18)
ACO(2, 10)
ACO(3, 10)
ACO(4, 10)
ACO(5, 10)
ACO(6, 10)
ACO(7, 10)
ACO(8, 10)
ACO(9, 10)
ACO(10, 10)
ACO(11, 10)
ACO(12, 10)
ACO(13, 10)
ACO(14, 10)
ACO(15, 10)
ACO(16, 10)
ACO(17, 10)
ACO(18, 10)
ACO(19, 10)
ACO(20, 10)
ACO(21, 10)
ACO(22, 10)

ACO(34, 10)
ACO(35, 10)
ACO(40, 10)

FijarCol(2)
FijarFila(8)

SetPrintFit(3, 65)
LimitesVision(V:Val(fi1)+1)
RangoTitulo(a:1..V:Val(fi1)+1, 7)
