CrearDialogo
   Fecha1   : 'Fecha'           ;1;1;;;;Dialogo.Fecha1>=FSys;'Debe ingresar fecha correcta';NO;FSys
   Vehiculo1: 'Vehiculo'        ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE');;
   Lista1   : 'Especies'        ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' AND Jerarquia LIKE '"~Var('JERTITULOS')~"%' ORDER BY Codigo ");
   Lista2   : 'Casas Custodia'      ;-3;2;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".MERCADOS WHERE Observaciones LIKE '%T|%' ORDER BY Codigo ");
   Lista3   : 'Saldos'          ;;1;;;;;;;'Libre Disp';;'|Bloqueados|Garantias';
   Radio2   : 'Expresado|Mon.Local|Mon.Extranjera|';0;1;;NO;NO;;;;0
FinDialogo

IF Not Ok
  Cancelar
ENDIF

IF NoVacio(Dialogo.Lista3)
    Recorrer&k 1, Elementos(Dialogo.Lista3)
        IF Eqstr(ItemLista(Dialogo.Lista3, &k),'Libre Disp')
            ACT(SL:1, Var('SALLIBRE'))
        ENDIF
        IF Eqstr(ItemLista(Dialogo.Lista3, &k),'Bloqueados')
            ACT(SL:1, Val(SL:1)~Var('SALBLOQUE'))
        ENDIF
        IF Eqstr(ItemLista(Dialogo.Lista3, &k),'Garantias')
            ACT(SL:1, Val(SL:1)~Var('SALGARA'))
        ENDIF
        ACT(SL:2, Val(SL:2)~ItemLista(Dialogo.Lista3, &k)~'|')
    Proximo
ELSE
    ACT(SL:1, Var('SALLIBRE')~Var('SALBLOQUE')~Var('SALGARA'))
    ACT(SL:2, 'Libre Disp|Bloqueados|Garantias')
ENDIF

IF Dialogo.Radio2 = 0
   ACT(mn1, VAR('MONELOCA'))
ELSE
   ACT(mn1, VAR('MONEEXTR'))
ENDIF

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

ACT(i1, 'Tenencia de Cartera Propia')
SetFont(i1, 3)

ACT(a5, 'Fecha : '~Dialogo.Fecha1)
IF NoVacio(Dialogo.Lista2)
   ACT(b5, 'Ente Liq.: '~Dialogo.Lista2)
ELSE
   ACT(b5, 'Ente Liq.: Todos')
ENDIF
