CrearDialogo
  Vehiculo1 : 'Vehiculo'           ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1    : 'Vto.Desde'          ;2;1;;;;Dialogo.Fecha1<>0;'Vto.Desde Invalido';NO;Fsys
  ** FJL 14/12/18 - Se cambia Vto hasta
*  Fecha2    : 'Vto.Hasta'          ;3;1;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Vto.Hasta Invalido';NO;Habiles(Dialogo.Fecha1, 2, 'ARG', SI);;
  Fecha2    : 'Vto.Hasta'          ;3;1;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Vto.Hasta Invalido';NO;FSys+365;;
  Lista1    : 'Mercado'             ;;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".MERCADOS Where TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%'  ")
FinDialogo
If Not Ok
   Cancelar
Endif

*  Fecha2    : 'Vto.Hasta'          ;2;2;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Vto.Hasta Invalido';NO;Habiles(Dialogo.Fecha1, 2, 'ARG', SI);Habiles(Dialogo.Fecha1, 2, 'ARG', SI);
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

SetFilaActual(3)
ACT(I:fac, 'Vencimientos Futuros de Moneda')
SetFont(I:fac, 3)

SetFilaActual(fac+2)
ACT(A:fac, 'Desde: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Hasta: '~Dialogo.Fecha2)
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
ifa
if NoVacio(Dialogo.Lista1)
  ACT(A:FAC, 'Mercados : '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(A:FAC, 'Mercados : Todos')
endif
SetFont(A:fac-3..a:fac, 2)
SetFilaActual(fac+2)
ACT(A:fac, 'Operacion')
ACT(B:fac, 'TipoOp')
ACT(C:fac, 'Mercado')
ACT(D:fac, 'Cliente')
ACT(E:fac, 'Tipo NDF')
ACT(F:fac, 'Fecha Conc.')
ACT(G:fac, 'Fecha Vto.')
** FJL 14/12/18 - Se cambia por Fecha Fixing
*ACT(H:fac, 'Dias Ant')
ACT(H:fac, 'Fecha Fixing')
ACT(I:fac, 'Especie')
ACT(J:fac, 'Ctra.Especie')
ACT(K:fac, 'Mon.Liq.')
ACT(L:fac, 'Cantidad')
ACT(M:fac, 'PrecioOp')
ACT(N:fac, 'PrecioCierre')
ACT(O:fac, 'Cot.ARP Mon.Liq.')
ACT(P:fac, 'Resultado')
SetFont(A:fac..P:fac, 2)
AlinearCeldas(A:fac..P:fac, 'C')
AgregarMarco(A:fac..P:fac, 0, 0, Exe('COLOR6'))

ACN(FI:1, fac+1)
SQL.ADD(" Select NrOperacion, TipoOp, O.Cliente1, RB6, FechaOp, FechaVto, FechaVto2, Especie, Lotes, TasaEspecie,")
** FJL 20/12/18 - El Resultado esta en TotalAux3 (MTM) y TotalAux2 (FIX)
*SQL.ADD(" ContraEspecie, Cantidad, Precio1, TotalNetoCli1, TasaEspecie, TipoCambio3, Precio2, Mercado4, Especie1 ")
SQL.ADD(" ContraEspecie, Cantidad, Precio1, TotalNetoCli1, TasaEspecie, TipoCambio3, Precio2, Mercado4, Especie1,  ")
SQL.ADD(" TotalAux2, TotalAux3, CB6 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MERCADOS M ")
SQL.ADD(" Where O.TipoOp IN ('FXCF','FXVF') ")
SQL.ADD("   AND O.Mercado4=M.Codigo ")   
IF NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND O.Mercado4 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
  SQL.ADD(" AND (M.TipoNegocio Like '%FT%' or M.TipoNegocio Like '%FM%') ")
ENDIF
** FJL 11/12/18 - Se cambia por FechaVto. El evento de cambio de Fecha no actualiza FechaVto2
*SQL.ADD(" AND O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" AND O.FechaVto2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.RB10 = 1 ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
** FJL 14/12/18 - Se cambia orden por FechaVto
*SQL.ADD(" Order By O.FechaVto2, O.Cliente1 ")
SQL.ADD(" Order By O.FechaVto, O.Cliente1 ")
watch(sql.batch())
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('TipoOp'))
    ACT(C:fac, fbn('Mercado4'))    
    ACT(D:fac, fbn('Cliente1'))
    IF fbn('RB6') = 0
       ACT(E:fac, 'Local')
    ELSE
       ACT(E:fac, 'Internac.')
    ENDIF
    ACD(F:fac, fbn('FechaOp'))
    ACD(G:fac, fbn('FechaVto'))
** FJL 14/12/18 - Se cambia por FechaVto2
*    ACT(H:fac, fbn('Lotes'))
    ACD(H:fac, fbn('FechaVto2'))
    ACT(I:fac, fbn('Especie'))
    ACT(J:fac, fbn('ContraEspecie'))
    ACT(K:fac, iif(NoVacio(fbn('TasaEspecie')),fbn('TasaEspecie'),fbn('ContraEspecie')))

    ACN(L:fac, fbn('Cantidad'))
    ACN(M:fac, fbn('Precio1'))
    ACN(N:fac, fbn('TipoCambio3'))
    ACN(O:fac, fbn('Precio2'))
** FJL 20/12/18 - El Resultado esta en TotalAux3 (MTM) y TotalAux2 (FIX)
*    ACN(P:fac, fbn('TotalNetoCli1'))
    if EqStr(BuscarCampo('MERCADOS','Regulado','Codigo',fbn('Mercado4')),'SI')
      ACN(P:fac, fbn('TotalAux3')+fbn('TotalAux2'))
    else
      if fbn('CB6')=1
        ACN(P:fac, fbn('TotalAux2'))
      else
        ACN(P:fac, fbn('TotalAux3'))
      endif
    endif
Proximo
FormatoCeldas(M:Val(FI:1)..O:fac, Exe('F9'))
FormatoCeldas(p:Val(FI:1)..p:fac, Exe('F2'))
SetFont(A:Val(FI:1)..P:fac, 1)
AlinearCeldas(G:Val(FI:1)..G:fac,'C')
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACO(9, 8)
ACO(11, 8)
ACO(12, 9)
ACO(13, 9)
ACO(14, 10)
ACO(15, 11)
Impresion(1,2)
SetPrintFit(3, 80)
LimitesVision(P:fac+1)