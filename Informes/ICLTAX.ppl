CrearDialogo
  Fecha1       : 'Fecha Desde'       ;1;1;;;;Dialogo.Fecha1 <> 0 y (Dialogo.Fecha1 = Dialogo.Fecha2 o Dialogo.Fecha1 < Dialogo.Fecha2);'Fecha Desde Invalida';NO;PriDeMes(Fsys);
  Fecha2       : 'Fecha Hasta'       ;1;2;;;;Dialogo.Fecha2 <> 0 y (Dialogo.Fecha2=Fsys o Dialogo.Fecha2 < Fsys);'Fecha Hasta Invalida';NO;Fsys;
  Book1        : 'Book'              ; ;1;;;;Vacio(Dialogo.Book1) o Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VAR('VEHICULODE')~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%CONU|%') "));'Debe ingresar un Book Valido';NO;;;;;;" Estado  = 'HAB' and Vehiculo = '"~VAR('VEHICULODE')~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%CONU|%') "
  NrOperacion1 : 'Nro. CONU'         ; ;1;;;;Vacio(Dialogo.NrOperacion1) o Incluido(Dialogo.NrOperacion1, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND TipoOp='CONU'  "));'Debe ingresar una Operacion Valida';NO;;;;;;"TipoOp  = 'CONU'"
FinDialogo

