SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.FechaOp, O.FechaVto, O.Cantidad, O.Mercado2, O.Book1, CL.RazonSocial, ")
SQL.ADD(" C.Cantidad1, C.Cantidad2, C.Cantidad3, C.Cantidad4, C.Cantidad5, C.Cantidad6, C.Precio1, C.Precio2, C.Precio3, C.Fecha1,")
* FJL 15/01/20 - Se agrega Termsheet ID
* AA 27/04/20 falta TipoOp por agregado de TSID
*SQL.ADD("  ObservacDoc as TSID, O.TipoOp, ")
* FJL 07/11/20 - Por Issue 4523 se cambia el campo del TS y se agrega TipoCONU
*13/09/2024 Se agrega CB9 para  Operaciones bloqueadas
SQL.ADD("  O.Termsheet as TSID, O.TipoCONU, O.TipoOp, O.CB9, ")
SQL.ADD("  (Select "~DBO~".SaldoCONU(O.NrOperacion,C.Fecha1,2)) as Utilizado ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES CL ")
SQL.ADD(" where C.NrOperacion = O.NrOperacion ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD("   and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif
If NoVacio(Dialogo.Book1)
  SQL.ADD("   and O.Book1= '"~Dialogo.Book1~"' ")
Endif  
SQL.ADD("   and O.Cliente1 = CL.Codigo ")  
SQL.ADD("   and O.TipoOp in ('CONU')  ")
SQL.ADD("   and C.Radio1 = '3' ")
SQL.ADD("   and C.Fecha1 Between "~IdxDate2(Dialogo.Fecha1)~" and  "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" Order By O.Book1, C.Fecha1, O.NrOperacion  ")
watch(SQL.Batch)

Recorrer SQL
  
  If vacio(Dialogo.Book1)
     if Not EqStr(FBN('Book1'),val(x2))
        if Val(x1)>0
           ifa
           act(f:fac,'Totales')
           acn(g:fac,Val(z1))
           acn(h:fac,Val(z2))
           acn(m:fac,Val(z3))
           acn(n:fac,Val(z4))
           acn(p:fac,Val(z5))
           acn(q:fac,Val(z6))
           SetFont(f:fac..q:fac, 2)
           acn(z1,0)
           acn(z2,0)
           acn(z3,0)
           acn(z4,0)
           acn(z5,0)
           acn(z6,0)
           ifa
        Endif
        act(a:fac, 'Book: '~FBN('Book1'))
        AgregarMarco(a:fac..b:fac,1,0)   
        SetFont(a:fac, 2)
        ifa
        act(x2,FBN('Book1'))
     endif
  Endif
  
  scn(x1,1)
  If not vacio(Dialogo.book1)
    act(a:fac, fbn('Book1'))
  Endif
  act(b:fac, fbn('NrOperacion'))
  aclo(b:fac, fbn('NrOperacion'))    
  act(c:fac, fbn('Cliente1')~' - '~fbn('RazonSocial'))
  act(d:fac, fbn('FechaOp'))
  act(e:fac, fbn('Fecha1'))
  acn(f:fac, fbn('Utilizado'))
  ** AA Jun-2021 se cambia Cantidad1(negativo) por Cantidad2 
  **acn(g:fac, fbn('Cantidad1'))
  acn(g:fac, fbn('Cantidad2'))
  acn(h:fac, fbn('Cantidad5'))
  AsignarLink(h:fac,'ICLDVD',Fecha1=PriDeMes(FBN['Fecha1'],SI),Fecha2=FinDeMes(FBN['Fecha1'],SI),NrOperacion1=fbn('NrOperacion'))
  acn(i:fac, fbn('Cantidad6'))
  acn(j:fac, Round(fbn('Cantidad6')/fbn('Cantidad5')*100,2))
  acn(k:fac, fbn('Precio2'))  
  acn(l:fac, fbn('Precio3')) 
  FormatoCeldas(j:fac..l:fac,EXE('F5'))    
  acn(m:fac, fbn('Cantidad3'))
  acn(n:fac, fbn('Cantidad4'))
  acn(o:fac, fbn('Precio1')) 
  FormatoCeldas(o:fac,EXE('F5'))    
  acn(p:fac, Val(m:fac)*Val(o:fac))
  acn(q:fac, Val(n:fac)*Val(o:fac))
* 13/09/24 Se agrega  Operaciones bloqueadas
  if EqStr(FBN['CB9'], '1') 
      ACT(r:fac,'SI')
  else
      ACT(r:fac,'NO')
  endif
* FJL 15/01/20 - Se agrega Termsheet ID
  if EqStr(FBN['TipoOp'],'CONU')
    ACT(s:fac, FBN['TSID'])
* FJL 07/11/20 - Se agrega TipoCONU
    ACT(t:fac, FBN['TipoCONU'])
  endif
  
  scn(z1,Val(g:fac))
  scn(z2,Val(h:fac))
  scn(z3,Val(m:fac))
  scn(z4,Val(n:fac))
  scn(z5,Val(p:fac))
  scn(z6,Val(q:fac))  
Proximo

  
