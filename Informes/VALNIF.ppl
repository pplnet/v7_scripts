        * --- Imprime Totales paar Book
        ACN(l:fac,Val(tc:1))
        ACN(n:fac,Val(tc:2))
        ACN(o:fac,Val(tc:3))
        *ACN(p:fac,Val(tc:4))
        ACN(q:fac,Val(tc:5))
        ACN(r:fac,Val(tc:6))
        ACN(s:fac,Val(tc:7))
        ACN(t:fac,Val(tc:8))
        ACN(u:fac,Val(tc:9))
        ACN(v:fac,Val(tc:10))
        ACN(w:fac,Val(tc:11))
        ACN(x:fac,Val(tc:12))
        ACN(y:fac,Val(tc:13))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0)
        ifa
        ifa
        endif
        ACN(fi:1, fac)
        * --- Limpia totales para Cuenta
        ACN(tc:1, 0 )
        ACN(tc:2, 0 )
        ACN(tc:3, 0 )
        ACN(tc:4, 0 )
        ACN(tc:5, 0 )
        ACN(tc:6, 0 )
        ACN(tc:7, 0 )
        ACN(tc:8, 0 )
        ACN(tc:9, 0 )
        ACN(tc:10, 0 )
        ACN(tc:11, 0 )
        ACN(tc:12, 0 )
        ACN(tc:13, 0 )
     Endif
     ACN(xx:1,0)
  Endif
  
  If fbn('NrSaldo')<>Val(xx:1) 
     If Val(xx:1)<>0
        If Val(xx:1)=171 o Val(xx:1)=172
           ACT(a:fac, 'Total Titulos')
        Endif
        If Val(xx:1)=31 o Val(xx:1)=51
           ACT(a:fac, 'Total FX')
        Endif
        If Val(xx:1)=43
           ACT(a:fac, 'Total OCT')
        Endif
        If Val(xx:1)=44
           ACT(a:fac, 'Total Rofex ')
        Endif
        If Val(xx:1)=45
           ACT(a:fac, 'Total Internal FX Exposure')
        Endif
        If Val(xx:1)=42
           ACT(a:fac, 'Total FX NDF')
        Endif
        If Val(xx:1)=41
           ACT(a:fac, 'Total FX DF')
        Endif
        ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
        ACN(n:fac, SUM(n:Val(fi:1)..n:fac) )
        ACN(o:fac, SUM(o:Val(fi:1)..o:fac) )
        *ACN(p:fac, SUM(p:Val(fi:1)..p:fac) )
        ACN(q:fac, SUM(q:Val(fi:1)..q:fac) )
        ACN(r:fac, SUM(r:Val(fi:1)..r:fac) )
        ACN(s:fac, SUM(s:Val(fi:1)..s:fac) )
        ACN(t:fac, SUM(t:Val(fi:1)..t:fac) )
        ACN(u:fac, SUM(u:Val(fi:1)..u:fac) )
        ACN(v:fac, SUM(v:Val(fi:1)..v:fac) )
        ACN(w:fac, SUM(w:Val(fi:1)..w:fac) )
        ACN(x:fac, SUM(x:Val(fi:1)..x:fac) )
        ACN(y:fac, SUM(y:Val(fi:1)..y:fac) )
        SetFont(a:fac..z:fac, 3)

        * --- Suma totales para Book
        SCN(tt:1, Val(l:fac) )
        SCN(tt:2, Val(n:fac) )
        SCN(tt:3, Val(o:fac) )
        SCN(tt:4, Val(p:fac) )
        SCN(tt:5, Val(q:fac) )
        SCN(tt:6, Val(r:fac) )
        SCN(tt:7, Val(s:fac) )
        SCN(tt:8, Val(t:fac) )
        SCN(tt:9, Val(u:fac) )
        SCN(tt:10, Val(v:fac) )
        SCN(tt:11, Val(w:fac) )
        SCN(tt:12, Val(x:fac) )
        SCN(tt:13, Val(y:fac) )

        * --- Suma totales para vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(n:fac) )
        SCN(tv:3, Val(o:fac) )
        SCN(tv:4, Val(p:fac) )
        SCN(tv:5, Val(q:fac) )
        SCN(tv:6, Val(r:fac) )
        SCN(tv:7, Val(s:fac) )
        SCN(tv:8, Val(t:fac) )
        SCN(tv:9, Val(u:fac) )
        SCN(tv:10, Val(v:fac) )
        SCN(tv:11, Val(w:fac) )
        SCN(tv:12, Val(x:fac) )
        SCN(tv:13, Val(y:fac) )

        ifa
        ifa
        ACN(fi:1, fac)
     Endif
  Endif

  ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
  message(Val(a:fac))
  ACT(b:fac, fbn('Cupon'))
  ACD(c:fac, fbn('FechaEj'))

  If Dialogo.Fecha1=fbn('Fecha')
     ACN(d:fac, fbn('CantidadIni'))
     ACN(e:fac, fbn('Cantidad1'))
     ACN(f:fac, -fbn('Cantidad2'))
  Else
     ACN(d:fac, fbn('CantidadFin'))
     ACN(e:fac, 0)
     ACN(f:fac, 0)
  Endif
  ACN(g:fac, fbn('CantidadFin'))
  ACN(h:fac, fbn('PrecioFin'))
  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
     ACN(i:fac, 1)
  Else
  *ACN(i:fac, CotizacionC(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1,5,SI, Var('MONELOCA')))
    ACN(I:fac, CotizacionUtilizadaNIIF(fbn('Especie'), Dialogo.Fecha1-1, fbn('Book')))
  Endif

  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
     ACN(j:fac, 1)
  Else
    *ACN(j:fac, CotizacionC(fbn('Especie'),,fbn('FechaEj'),,habiles(Dialogo.Fecha1,-1,'ARG'),5,SI, Var('MONELOCA')))
      IF Not Eqstr(fbn('Cotiza'), Var('MONELOCA'))
          ACT(MN:99, fbn('Cotiza'))
          ACD(FV:1, Dialogo.Fecha1)
          ACN(J:fac, Val(I:fac) * #TCCONTABLE)
      ELSE
        ACN(J:fac, Val(I:fac))
      ENDIF

  Endif
  FormatoCeldas(h:fac..j:fac, EXE('F9'))

  ACN(k:fac, Val(g:fac)-Val(d:fac))
  
  **ACN(l:fac, Val(i:fac)*Val(g:fac))
  ACN(l:fac, CotizacionUtilizadaNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book')))
  
  let &valuacion ValuacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book'), 0)
  if NoVacio(&valuacion)
      if(Eqstr(&valuacion.get_TipoValuacionNIIF(), 'PARTIDAS'))
        ACN(M:fac, &valuacion.get_ValuacionNIIF)
      ELSE
        ACN(M:fac, Val(G:fac) * Val(L:fac))
      ENDIF
  endif  
  IF Not Eqstr(fbn('Cotiza'), Var('MONELOCA'))
    ACT(MN:99, fbn('Cotiza'))
    ACD(FV:1, Dialogo.Fecha1)
    ACN(N:fac, Val(L:fac) * #TCCONTABLE)
        ACN(O:fac, Val(M:fac) * #TCCONTABLE)
  ELSE
    ACN(N:fac, Val(L:fac))
    ACN(O:fac, Val(G:fac) * Val(N:fac))    
  ENDIF

  Let &Valuacion ValuacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book'), fbn('CantidadFin'))
  IF Vacio(&Valuacion)
    ACT(P:fac, '')
  ELSE
    ACT(P:fac, &valuacion.get_TipoValuacionNIIF )
  ENDIF
  SetFont(a:fac..z:fac, 1)

  FormatoCeldas(d:fac..g:fac, EXE('F2'))
  FormatoCeldas(H:fac..j:fac, EXE('F9'))
  SetFont(a:fac..z:fac, 1)

  ACN(xx:1, fbn('NrSaldo'))
  ACT(xx:2, fbn('Vehiculo'))
  ACT(xx:3, fbn('Book'))
  ACT(xx:4, fbn('Estrategia'))
Proximo

