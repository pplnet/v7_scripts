** Funcion que utiliza el informe para obtener la valuacion NIIF
def CotizacionUtilizadaNIIF(especie, fecha, book)
    *** Param nominal siempre cero
    let &valuacion ValuacionNIIF(especie, Dat(fecha), book, 0)
    if(Vacio(&valuacion))
        return 0
    endif
    *** Si es TipoValuacion PARTIDAS, devuelvo cero.
    if(Eqstr(&valuacion.get_TipoValuacionNIIF(), 'PARTIDAS'))
        return 0
    endif
    return &valuacion.get_CotizacionUtilizadaNIIF
end

