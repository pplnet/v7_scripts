HojaVisible(SI)

ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1    : "Vehiculo"     ;;;;;;;;;
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  NrOperacion1 : "Nr.Operacion"
  Lista2       : "TipoOp"      ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION") 
FinDialogo


if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

IF NoVacio(Dialogo.Vehiculo1)
    ACT(VH:10, Dialogo.Vehiculo1)
ELSE
    IF NoVacio(UsrVehiculos(UsuarioActivo))
        ACT(VH:10, UsrVehiculos(UsuarioActivo))
    ELSE
        ACT(VH:10, SQLSet(" Select Codigo From "~DBO~".VEHICULOS "))
    ENDIF
ENDIF

ACT(a1, 'Listado de Devengados Generados para Interfase Contable')
SetFont(A:1, 3)

SetFilaActual(fac+3)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:fac+1, 'Vehiculo: '~Dialogo.Vehiculo1)
else
  ACT(a:fac+1, 'Vehiculo: Todos')
endif

ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)

if NoVacio(Dialogo.Lista2)
  ACT(C:fac, 'Tipos de Operacion: '~Dialogo.Lista2)
else
  ACT(C:fac, 'Tipos de Operacion: Todas')
endif

SetFilaActual(fac+4)

ACT(a:fac,'Vehiculo')
