CrearDialogo
  Fecha1           :  'Fecha'               ;1;;;;;;;;FSYS
  Cliente1         :  'Cliente'             ;3;;;;;;;
  Radio1           : 'Moneda Exp.|ARP|USD'  ;4;;;;;;;;0;;
  Lista1           :  'Vehiculo'            ;5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

SetFilaActual(1)
ACT(C:fac, 'Resumen de Titulos Caucionados')
SetFont(C:fac, 3)
SetFilaActual(fac+2)
ACN(FI:1, fac)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculo/s : '~Dialogo.Lista1) 
ELSE
    ACT(A:fac, 'Vehiculo : Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:fac, 'Cliente: '~Dialogo.Cliente1)
ELSE
    ACT(A:fac, 'Cliente: Todos')
ENDIF
ifa
IF Dialogo.Radio1 = 0
    ACT(MN:1, Var('MONELOCA'))
ELSE
    ACT(MN:1, Var('MONEEXTR'))
ENDIF
ACT(A:fac, 'Expresado en: '~Val(MN:1))
SetFilaActual(fac+2)
ACT(A:fac, 'Especie')
ACT(B:fac, 'Vehiculo')
ACT(C:fac, 'V.Nominal')
ACT(D:fac, 'Pr.Mercado')
ACT(E:fac, 'Valuacion a la Fecha')
SetFont(A:Val(FI:1)..E:fac, 2)
AlinearCeldas(A:fac..E:fac, 'C')
AgregarMarco(A:fac..E:fac, 0, 0, Exe('COLOR'))
ACN(FI:1, fac+1)
SQL.ADD(" Select O.Vehiculo1, C.Especie1, C.Cantidad1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" Where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" AND O.TipoOp = 'SECAT' ")
SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" Order By C.Especie1, O.Vehiculo1 ")
watch(sql.batch)
Recorrer SQL
    DFA
    IF Not Eqstr(fbn('Especie1'), Val(ES:1))
        ifa
        ACT(A:fac, fbn('Especie1'))       
        ACT(B:fac, fbn('Vehiculo1'))
        ACN(D:fac, CotizacionC(fbn('Especie1'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
    ENDIF
    IF Not Eqstr(fbn('Vehiculo1'), Val(VH:1))
        IF Eqstr(fbn('Especie1'), Val(ES:1))
            ifa
        ENDIF
        ACT(A:fac, fbn('Especie1'))
        ACT(B:fac, fbn('Vehiculo1'))
        ACN(D:fac, CotizacionC(fbn('Especie1'),,,,Dialogo.Fecha1,1,SI,Val(MN:1)))
    ENDIF
    SCN(C:fac, fbn('Cantidad1'))
    ACN(E:fac, Val(C:fac) * Val(D:fac))
    ACT(ES:1, fbn('Especie1'))
    ACT(VH:1, fbn('Vehiculo1'))
    ACL(A:fac, 'CADETA',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie1'),Vehiculo1=fbn('Vehiculo1'),Especie2=Val(MN:1)) 
Proximo
SetFont(A:Val(FI:1)..E:fac, 1)
FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F8'))
AgregarMarco(A:Val(FI:1)..E:fac, 0, 0)
ifa
ACT(A:fac, 'Total')
ACN(E:fac, Sum(E:Val(FI:1)..E:fac-1))
SetFont(A:fac, 2)
SetFont(E:fac, 2)
AgregarMarco(A:fac..E:fac, 0, 0, Exe('COLOR'))
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)
ACO(5, 15)