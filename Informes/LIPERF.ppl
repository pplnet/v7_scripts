if EQSTR(VAR('INSTALACIO'),'MLASA')
CrearDialogo
   Vehiculo1  : "Vehiculo"                           ;1;1;1;NO;NO;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar El Vehiculo';NO;Var('VEHICULODE')
   Cliente1   : 'Cliente'                            ;;;;;;;;; 
   Radio2     : 'Consumido|Actual|Rango Fecha'       ;;;;;;;;;0
   Fecha3     : 'Fecha      '   ;4;1;;NO;Dialogo.Radio2=0;NoVacio(Dialogo.Fecha3);'Debe ingresar Fecha';NO;Fsys;
   Fecha1     : 'Fecha Desde'   ;4;1;;;Dialogo.Radio2=1;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;PriDeMes(FSys,SI);
   Fecha2     : 'Fecha Hasta'   ;5;1;;;Dialogo.Radio2=1;NoVacio(Dialogo.Fecha2) y Dialogo.Fecha2 > Dialogo.Fecha1;'Debe ingresar Fecha Hasta Correcta';NO;FinDeMes(FSys,SI);   
   Radio1     : 'Limites|Consumidos|Asignados' ;;;;;Dialogo.Radio2=0;;;;0
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,10,B')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

SetFilaActual(3)
if Dialogo.Radio2= 0
   ACT(a:FAC, 'Limites Perfilamiento de Clientes al '~Dialogo.Fecha3)
Else
   ACT(a:FAC, 'Limites Perfilamiento de Clientes del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
Endif   
SetFont(a:FAC, 3)
ifa 
If Dialogo.Radio1=0
   ACT(a:FAC, 'Limites Consumidos')
Else
   ACT(a:FAC, 'Limites Asignados')
Endif
SetFont(a:FAC, 3)

If NoVacio(Dialogo.Cliente1) 
   ACT(a:FAC+1, 'Cliente : '~Dialogo.Cliente1~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:FAC+1, 'Cliente : Todos' )
Endif
SetFont(a:FAC+1, 3)

SetFilaActual(FAC+3)
ACT(a:FAC, 'Cliente')
ACT(b:FAC, 'Limite')
ACT(c:FAC, 'Vencimiento')
ACT(d:FAC, 'Descripcion')
ACT(e:FAC, 'Moneda')
ACT(f:FAC, 'Estado')
ACT(g:FAC, 'Consumido')
ACT(h:FAC, 'Asignado')
ACT(i:FAC, 'Exceso')

AgregarMarco(a:FAC..i:FAC,1,0,Exe('COLOR'))
SetFont(a:FAC..i:FAC, 2)

ACN(w:1, FAC)
if Dialogo.Radio2= 0
   If Dialogo.Radio1=0
      SQL.ADD("Select ClienteLC, LimiteLC, MConsumido,ISNULL(LA.FVencimiento,'1900-03-03') FVto,ISNULL(LA.Cliente,'NOASIGNADO') ClienteLA, ISNULL(LA.Monto,0) MAsignado, TL.Descripcion ")
      SQL.ADD("From (Select LC.Cliente ClienteLC, LC.limite LimiteLC, SUM(LC.Monto) as MConsumido from "~DBO~".LIMCONSUMIDOS LC ")
      SQL.ADD("       where LC.Limite in ('VOLOPE','CANOPE') ")
      SQL.ADD("       Group by Cliente,Limite) as Aux ")
      SQL.ADD(" Left JOIN "~DBO~".LIMASIGNADOS LA WITH (NOLOCK) ON  LA.Cliente=ClienteLC and LA.Limite = LimiteLC ")
      SQL.ADD(" Left JOIN "~DBO~".TIPOSLIMITE TL WITH (NOLOCK) ON TL.Codigo= LimiteLC ")
      If NoVacio(Dialogo.Cliente1) 
         SQL.ADD("  Where  ClienteLC = '"~Dialogo.Cliente1~"' ")
      Endif
      If NoVacio(Dialogo.Cliente1) 
         SQL.ADD(" AND ")
      Else
         SQL.ADD("  Where ")
      Endif
      SQL.ADD("  MConsumido Between 0.01 and 9999999999999 ")
   Else
      SQL.ADD("Select LA.Cliente ClienteLC,LA.Cliente ClienteLA,LA.Limite LimiteLC,LA.FVencimiento FVto,LA.Monto MAsignado, TL.Descripcion, (Select SUM(LC.Monto) from "~DBO~".LIMCONSUMIDOS LC ")
      SQL.ADD(" where LC.Limite in ('VOLOPE','CANOPE')  and LA.Cliente=LC.Cliente and LA.Limite=LC.Limite ")
      SQL.ADD(" Group by Cliente,Limite)  as MConsumido ")
      SQL.ADD("from "~DBO~".LIMASIGNADOS LA, "~DBO~".TIPOSLIMITE TL where LA.Limite in ('VOLOPE','CANOPE') and LA.Limite=TL.Codigo ")
   Endif   
   SQL.ADD(" Order by ClienteLC, LimiteLC ")
Else
  If Dialogo.Radio2= 1
     SQL.ADD("Select ClienteLC, LimiteLC, MConsumido,ISNULL(LA.FVencimiento,'1900-03-03') FVto,ISNULL(LA.Cliente,'NOASIGNADO') ClienteLA, ISNULL(LA.Monto,0) MAsignado, TL.Descripcion ")
     SQL.ADD("From (Select LC.Cliente ClienteLC, LC.limite LimiteLC, SUM(LC.Monto) as MConsumido from "~DBO~".MOVLIMITES LC ")
     SQL.ADD("      where (FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' and Bits = 'P' and LC.Monto > 0) ")
     SQL.ADD("      and Limite in ('VOLOPE','CANOPE')")
     SQL.ADD("      Group by Cliente,Limite) as Aux ")
     SQL.ADD(" Left JOIN "~DBO~".LIMASIGNADOS LA WITH (NOLOCK) ON  LA.Cliente=ClienteLC and LA.Limite = LimiteLC ")
     SQL.ADD(" Left JOIN "~DBO~".TIPOSLIMITE TL WITH (NOLOCK) ON TL.Codigo= LimiteLC ")
     If NoVacio(Dialogo.Cliente1) 
        SQL.ADD("  Where  ClienteLC = '"~Dialogo.Cliente1~"' ")
     Endif
     SQL.ADD(" Order by ClienteLC, LimiteLC ")
  Else
     SQL.ADD("Select ClienteLC, LimiteLC, MConsumido,ISNULL(LA.FVencimiento,'1900-03-03') FVto,ISNULL(LA.Cliente,'NOASIGNADO') ClienteLA, ISNULL(LA.Monto,0) MAsignado, TL.Descripcion ")
     SQL.ADD("From (Select LC.Cliente ClienteLC, LC.limite LimiteLC, SUM(LC.Monto) as MConsumido from "~DBO~".MOVLIMITES LC ")
     SQL.ADD("      where (FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' and Bits = 'P' and LC.Monto > 0) ")
     SQL.ADD("      and Limite in ('VOLOPE','CANOPE')")
     SQL.ADD("      Group by Cliente,Limite) as Aux ")
     SQL.ADD(" Left JOIN "~DBO~".LIMASIGNADOS LA WITH (NOLOCK) ON  LA.Cliente=ClienteLC and LA.Limite = LimiteLC ")
     SQL.ADD(" Left JOIN "~DBO~".TIPOSLIMITE TL WITH (NOLOCK) ON TL.Codigo= LimiteLC ")
     If NoVacio(Dialogo.Cliente1) 
        SQL.ADD("  Where  ClienteLC = '"~Dialogo.Cliente1~"' ")
     Endif
     SQL.ADD(" Order by ClienteLC, LimiteLC ")
  Endif 
Endif
watch(SQL.BATCH())
Recorrer SQL
 
  ACT(a:fac, FBN['ClienteLC'])
  ACT(b:fac, FBN['LimiteLC'])
  ACT(c:fac, iif(EqStr(FBN('FVto'),'1900-03-03'),'',FBN('FVto')))
  ACT(d:fac, FBN['Descripcion'])    
  ACT(e:fac, 'USD')
  if Not EqStr(FBN['ClienteLA'],'NOASIGNADO')
    * Asignado Cliente
    if FBN('FVto')<FSys
       ACT(f:fac, 'Vencido el '~Fecha(FBN('FVto')))
    else
       ACT(f:fac, 'Vigente')
    endif
  else
    *Sin Limite Asignado
    ACT(f:fac, 'No Asignado')
  endif
  
  * Consumido 
  ACN(g:fac, IIF(FBN('MConsumido') >= 0.01,FBN('MConsumido'),0))
  if Val(g:FAC)>0
     * Detalle consumido
     if Dialogo.Radio2= 0
        ACL(g:fac, 'LPERF1',Cliente1=FBN['ClienteLC'],Vehiculo1=Dialogo.Vehiculo1,TipoLimite1=FBN['LimiteLC'],Fecha1=Dialogo.Fecha3,Fecha2=Dialogo.Fecha3)
     else
        ACL(g:fac, 'LPERF1',Cliente1=FBN['ClienteLC'],Vehiculo1=Dialogo.Vehiculo1,TipoLimite1=FBN['LimiteLC'],Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2)
     endif
  endif
  
  If Dialogo.Radio2=0
     * Asignado
     ACN(h:fac, FBN('MAsignado'))
  
     if Val(g:FAC)>Val(h:FAC)
        ACN(i:FAC, Val(g:FAC)-Val(h:FAC))
     endif
  Endif
Proximo

If FAC>Val(w:1)
  SetFont(a:Val(w:1)+1..a:FAC, 2)
  SetFont(b:Val(w:1)+1..p:FAC, 1)
else
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay Limites de Perfilamiento a informar')
  SetFont(a:FAC, 2)
endif

ACO(1,8)
ACO(2,10)
ACO(3,10)
ACO(4,20)
ACO(5,8)
ACO(6,15)
ACO(7,10)
ACO(8,10)
ACO(9,10)

Ifa
Ifa

ACT(a:fac,'FIN LISTADO')
SetFont(a:fac, 2)
if Dialogo.Radio2= 0
   LimitesVision(i:fac)
else
   LimitesVision(h:fac)
endif
Impresion(1,2)
Rangotitulo(a:1..i:7,2)

SetPrintFit(3, 60)

GrabarGrilla('PERFILA')
** Endif por INSTALACION
Endif