AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
(.'DIALOGOPNL'.)
&DifDias := DifDias(Dialogo.Fecha2,Dialogo.Fecha1,no,no) + 1
********************************************ANOTACIONES****************************************************************
*AA Saldos
    *AA:1  Saldo para MMCREM a ese dia(pesificado)
    *AA:2  SNC suma de saldos MMCREM
    *AA:3  Promedio de saldos dividido en la cantidad de fechas que 
    *AA:4 Pivote para guardar la cantidad para las operaciones de Tipo MMCO/MMCT/MMPF
*BB P&L
    *BB:1  SNC suma de P&LMMCREM ese dia(pesificado)
*CC Fechas para operaciones de Tipo MMCO/MMCT/MMPF
    *CC:1 FechaDesde
    *CC:2 FechaHasta     
*DD Controles de igualdad
    *DD:1 Valor de FAC donde se guardara el mismo Cliente
    *DD:2 Valor de FAC donde se guardara el mismo Cliente pero diferente Cuenta
*****************************************FIN ANOTACIONES****************************************************************
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

*********************************************ENCABEZADOS****************************************************************
ACT(a:fac+6,'P&L Tasa de Transferencia- Por Cliente y Cuenta')
SetFont(a:fac+6,1)
(.'ENCABEPNL'.)
*****************************************FIN ENCABEZADOS****************************************************************
*SetFilaActual(13)
ACN(w1,FAC)


ACT(a:fac, 'Codigo del Cliente')
ACT(b:fac, 'Tipo y numero de documento')
ACT(c:fac, 'Razon social')
ACT(d:fac, 'Tipo de Operacion')
ACT(e:fac, 'Cuenta')
ACT(f:fac, 'Capital Promedio')
ACT(g:fac, 'P&L Período')

SetFont(a:FAC..g:FAC,1)
AgregarMarco(a:FAC..g:FAC,1,0,Exe('COLOR6'))
AlinearCeldas(f:FAC..g:fac,'D')

*Recorrer SQL operaciones 
(.'CONSPRETSA'.)
SQL.ADD("Order BY O.Cliente1,  O.Cuenta1, O.TipoOp")



Recorrer SQL
    DFA
    &TipoOp := FBN['TipoOp']
    *validacion check
    IF Dialogo.Radio2 = 0
        *PRECIO
        
    ELSE
        &DifDiasMMCREM := &DifDias
        &AuxDia := &DifDiasMMCREM
        &CodigoCliente := FBN['Cliente1']
        &CodigoCuenta := FBN['Cuenta1'] 
        If EqStri(&TipoOp, 'MMCT') O EqStri(&TipoOp, 'MMCO')
            &CodigoCuenta := FBN['Cuenta3']  
        Endif
        
        &TasaOP := Num(FBN['Precio1'])
        *Tasa de transf 
        &TasaTransf := Num(FBN['Precio4'])
        *Fecha Vencimiento de la operacion
        &FechaVto := FBN['FechaVto']
        *Fecha de la Operacion
        &FechaOp := FBN['FechaOp']
        *Saber si el cliente es el mismo
        IF NOT Eqstr(&CodigoCliente, Val(A:Val(DD:1)))
            IFA
            ACT(A:FAC,&CodigoCliente)
            ACN(DD:1,FAC)
            *TASA
            *CodigoCliente
            ACT(A:VAL(DD:1),FBN['Codigo'])
            if EqStri(FBN['CategDepositante'], 'FON')
                ACT(B:VAL(DD:1),FBN['TipoDocum']~" "~FBN['NrDocum'])
            else
                ACT(B:VAL(DD:1),FBN['TipoInscripcion']~" "~FBN['CUIT'])
            endif
            *Razon social
            ACT(C:VAL(DD:1),FBN['RazonSocial'])
            ACT(E:VAL(DD:1),'TOTAL')
            ACL(E:VAL(DD:1), 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1= VAL(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            SetFont(E:VAL(DD:1), 1)
            AgregarMarco(b:VAL(DD:1)..g:VAL(DD:1),1,0,Exe('COLOR13'))
         ENDIF
      
        IF NOT Eqstr(&TipoOp, Val(D:Val(DD:2)))
            IFA
            ACN(DD:2,FAC)
            *&CodigoCuenta := FBN['Cuenta1'] 
            If EqStri(&TipoOp, 'MMCT') O EqStri(&TipoOp, 'MMCO')
                ACT(E:FAC,FBN['Cuenta3'])  
                ACL(E:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1= &CodigoCliente, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta3 = Val(E:FAC))
            else
                ACT(E:FAC,FBN['Cuenta1'])  
                ACL(E:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1= &CodigoCliente, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Val(E:FAC))
            Endif  
            ACT(D:FAC,&TipoOp)
            ACL(D:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Val(D:FAC),Cliente1= Val(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
        ENDIF
        
         IF NOT Eqstr(&CodigoCuenta, Val(E:Val(DD:2)))
            IFA
            ACN(DD:2,FAC)
            *&CodigoCuenta := FBN['Cuenta1'] 
            If EqStri(&TipoOp, 'MMCT') O EqStri(&TipoOp, 'MMCO')
                ACT(E:FAC,FBN['Cuenta3'])  
                ACL(E:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1= &CodigoCliente, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta3 = Val(E:FAC))
            else
                ACT(E:FAC,FBN['Cuenta1'])  
                ACL(E:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1= &CodigoCliente, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Val(E:FAC))
            Endif  
            ACT(D:FAC,&TipoOp)
            ACL(D:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Val(D:FAC),Cliente1= Val(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
        ENDIF
        

        If EqStri(&TipoOp, 'MMCREM')
            If DifDias(Dialogo.Fecha1,FBN['FechaVto'],no,no) = 0
            Else
                Recorrer&i 0, Num(&DifDiasMMCREM)
                    *Capital 
                    ACN(AA:5,SQL("SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"') THEN 1 WHEN EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"' AND SALDO < 0) THEN 2 ELSE 3 END AS CodigoResultado;"))
                    *Val(AA:5) = 2 El saldo existe pero es negativo
                    IF Dialogo.Fecha1+&i >= &FechaOp Y   ((Dialogo.Fecha1+&i) < &FechaVto) Y Dialogo.Fecha1+&i <= Dialogo.Fecha2
                        IF Val(AA:5) = 2
                            &DifDiasMMCREM := &DifDiasMMCREM - 1
                            ELSE IF  DifDias(Dialogo.Fecha1 + &i,FBN['FechaVto'],no,no) = 0
                                *Val(AA:5) = 1 El saldo NO existe para ese dia
                                ELSE IF Val(AA:5) = 1
                                        If Dialogo.Radio4 =0
                                            ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
                                        else 
                                            ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                        endif
                                    ELSE
                                        *El saldo existe y no es negativo para ese dia
                                        If Dialogo.Radio4 =0
                                            ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
                                        else 
                                            ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                        endif
                                ENDIF
                            endif
                        ENDIF 
                    endif
                    SCN(AA:2,Val(AA:1))
                    SCN(BB:1,(((&TasaTransf-&TasaOP) / 365 *  Val(AA:1) ))/100)
                    ACN(AA:1,0)
                Proximo
                           
                ACN(AA:3,(Val(AA:2) / (&AuxDia)))
                SCN(F:Val(DD:1), Val(AA:3))
                SCN(G:Val(DD:1),Val(BB:1))
                SCN(F:Val(DD:2), Val(AA:3))
                SCN(G:Val(DD:2) ,Val(BB:1))
                *Seteo en 0 los pivotes
                ACN(AA:1,0)
                ACN(AA:2,0)
                ACN(AA:3,0)
                ACN(BB:1,0)
            endif
        Else
        (.'FECHAP&L'.)
            *Capital
            If Dialogo.Radio4 =0
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
            else 
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
            endif           
            IF  Buscar(&TipoOp, Pipe2Comillas(Var('TIPOOPACTI')))
                *ACTIVO
                SCN(G:Val(DD:1),((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100)
                SCN(G:Val(DD:2),((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100) 
            Else 
                *Pasivo
                SCN(G:Val(DD:1),((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100)
                SCN(G:Val(DD:2),((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100)
            EndIf
            ACN(AA:4,Val(AA:4)*&DifDias2)
            SCN(F:Val(DD:1),(Val(AA:4)/(&DifDias)))
            SCN(F:Val(DD:2),(Val(AA:4)/(&DifDias)))
         ENDIF   
    EndIF
Proximo

*If NoVacio(Val(DD:2))
*    SetFilaActual(Val(DD:2))
*ENDIF

FormatoCeldas(F:14..F:FAC,Exe('F2'))
FormatoCeldas(G:14..G:FAC,Exe('F2'))
ACT(a:FAC+2,'FIN DEL INFORME')
SetFont(a:FAC+2, 1)
ACO(1,14)
ACO(2,18)
ACO(3,40)
ACO(4,14)
ACO(5,14)
ACO(6,14)
ACO(7,14)
RangoTitulo(a:1..g:fac, Val(w1))
SetPrintFit(3, 99)
Impresion(1, 2)

LimitesVision(H:FAC+2)
