MostrarCuadroDeMensajes

(.'DNLISTA'.)

CrearDialogo
  Fecha1:    'F.Bajada'    ;;;;;;;;;fsys
  Vehiculo1: 'Vehiculo'    ;;;;;;;;;VAR('VEHICULODE')
  Lista1:    'Archivo'     ;;;;;;;;;;;Val(l:1)
FinDialogo
*  Lista1:    'Archivo'     ;;;;;;;;;;;'DNCTAS|DNAHMS|DNCCDO|DNCADO|DNCOBR'

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial, 8,BI")

ACT(a:1, 'Tabla DATANET')
SetFont(a:1, 3)

ACT(a:3, 'Fecha:    '~Dialogo.Fecha1)
ACT(a:4, 'Vehiculo: '~Dialogo.Vehiculo1)
ACT(a:5, 'Archivos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
SetFont(a:3..a:5, 2)

SetFilaActual(7)

ACT(a:fac, 'Banco')
ACT(b:fac, 'Sucursal')
ACT(c:fac, 'Cuenta')
ACT(d:fac, 'Moneda')
ACT(e:fac, 'Importe')
ACT(f:fac, 'D/C')
ACT(g:fac, 'F.Ingreso')
ACT(h:fac, 'F.Acredit')
ACT(i:fac, 'TipoMov')
ACT(j:fac, 'Comprobante')
ACT(k:fac, 'Observaciones')
ACT(l:fac, 'Operacion')
ACT(m:fac, 'NrMov')
ACT(n:fac, 'Estado')
SetFont(a:fac..n:fac, 2)
AgregarMarco(a:fac..n:fac,0,0,EXE('COLOR6'))


SQL.ADD(" SELECT M.*, D.Archivo, D.Estado FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".VEHICULOS V")
SQL.ADD(" WHERE M.NrDataNet   = D.NrDataNet ")
SQL.ADD(" AND   M.Vehiculo    = V.Codigo  ")
SQL.ADD(" AND   D.FechaBajada = "~IdxDate2(Dialogo.Fecha1)~" ")
If NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND V.Codigo = '"~Dialogo.Vehiculo1~"' ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND  D.Archivo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif

SQL.ADD(" ORDER BY M.NrDataNet, M.Vehiculo, M.Banco, M.Cuenta, M.Moneda ")

ACT(da:1,'')
ACT(vh:1,'')

Recorrer SQL
 If Not Eqstr(fbn('NrDatanet'),Val(da:1))
   message(fbn('NrDatanet')~' - Archivo: '~fbn('Archivo'))
   ACT(a:fac,fbn('NrDatanet')~' - Archivo: '~fbn('Archivo')~' - Estado: '~fbn('Estado'))
   SetFont(a:fac, 4)
   AgregarMarco(a:fac..n:fac,0,0,EXE('COLOR8'))
   ACT(vh:1,'')
   ifa
 Endif
 If Not Eqstr(fbn('Vehiculo'),Val(vh:1))
   message(fbn('Vehiculo'))
   ACT(a:fac,fbn('Vehiculo'))
   SetFont(a:fac, 4)
   AgregarMarco(a:fac..n:fac,0,0,0)
   ifa
 Endif

 ACT(a:fac, fbn('Banco'))
 ACT(b:fac, fbn('Sucursal'))
 ACT(c:fac, fbn('Cuenta'))
 ACT(d:fac, fbn('Moneda'))
 ACN(e:fac, fbn('Importe'))
 ACT(f:fac, fbn('DC'))
 ACD(g:fac, fbn('FechaIngreso'))
 ACD(h:fac, fbn('FechaAcreditacion'))
 ACT(i:fac, fbn('TipoMov'))
 ACT(j:fac, fbn('Comprobante'))
 ACT(k:fac, fbn('Observaciones'))
 ACT(l:fac, fbn('NrOperacion'))
 ACT(m:fac, fbn('NrMovimiento'))
 ACT(n:fac, fbn('EstadoConciliacion'))

 ACT(da:1,fbn('NrDatanet'))
 ACT(vh:1,fbn('Vehiculo'))
SetFont(a:fac..n:fac, 1)
