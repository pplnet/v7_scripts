CrearDialogo
    Fecha1: 'Fecha Desde' ;;;;;;;;;PriDeMes(Fsys);;;;;;
    Fecha2: 'Fecha Hasta' ;;;;;;;;;Fsys;;;;;;
    Cliente1: 'Banco'     ;;;;;;;;;;BuscarCampo('CUENTAS','Comitente','Codigo',Dialogo.Cuenta1);;;;"Alias3 IN (Select Distinct Banco from SALDOSBANCARIOS)";;;;
    Cuenta1 : 'Cuenta'    ;;;;;;Vacio(Dialogo.Cuenta1) O IF(NoVacio(BuscarCampo('SALDOSBANCARIOS','NrCuenta','NrCuenta',BuscarCampo('CUENTAS','Numero','Codigo',Dialogo.Cuenta1))),SI,NO);'La cuenta no registra saldos';NO;;BuscarCampo('CUENTAS','Codigo','Numero',BuscarCampo('CUENTAS','Numero','Comitente',Dialogo.Cliente1));;;;"Numero IN (SELECT Distinct NrCuenta FROM SALDOSBANCARIOS)";;;;;;  
    Radio3  : 'Filtra Book|SI|NO'     ;5;1;;;;;;;1;
    Vehiculo1: 'Vehiculo' ;6;1;;Dialogo.Radio3=0;Dialogo.Radio3=0;Dialogo.Radio3=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
    Lista2  : 'Books'     ;7;1;;;Dialogo.Radio3=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
    Lista1: 'Vehiculos'   ;0;1;;;Dialogo.Radio3=1;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;;;;
    Radio1  : 'Expresado en|ARP|USD'  ;2;1;;;;;;;0;;;
    Radio2  : 'Consolidado|SI|NO'     ;;;;;NO;;;;1;;;
    
FinDialogo

If Not Ok
    Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

let &moneLocal Var('MONELOCA')
let &moneExtr Var('MONEEXTR')

ACT(D:1,'INTERESES REMUNERADAS')
SetFont(D:1,3)

SetFilaActual(3)

ACT(A:fac,'Fecha Desde: '~Dialogo.Fecha1)
ifa
ACT(A:fac,'Fecha Hasta: '~Dialogo.Fecha2)
ifa
If Dialogo.Radio3 = 0
   If NoVacio(Dialogo.Vehiculo1)
    ACT(A:fac,'Vehiculos: '~Dialogo.Vehiculo1)
       If NoVacio(Dialogo.Lista2)
          ACT(A:fac,'Book: '~Dialogo.Lista2)
       Else
          ACT(A:fac,'Book: Todos')
       Endif
    Else
    ACT(A:fac,'Vehiculos: Todos')
     ACT(A:fac,'Book: Todos')
   Endif
Else
       If NoVacio(Dialogo.Lista1)
          ACT(A:fac,'Vehiculos:'~Dialogo.Lista1)
          ACT(A:fac,'Book: Todos')
       Else
          ACT(A:fac,'Vehiculos: Todos')
          ACT(A:fac,'Book: Todos')
       Endif
Endif
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:fac,'Banco: '~Dialogo.Cliente1)
ELSE
    ACT(A:fac,'Banco: Todos')
ENDIF
ifa
ACT(A:fac,'Cuenta: '~IIF(NoVacio(Dialogo.Cuenta1),Dialogo.Cuenta1,'Todas'))
ifa
ACT(A:fac,'Expresado en: '~IIF(Dialogo.Radio1 = 0,'ARP','USD'))
*ifa
*ACT(A:fac,'Consolidado: '~IIF(Dialogo.Radio2 = 0,'SI','NO'))
SetFont(A:FAC-6..A:fac,4)
ifa
ifa

IF Dialogo.Radio1 = 0
    let &Expresado 'ARP'
ELSE
    let &Expresado 'USD'
ENDIF

let &Vehiculo ''
let &PrimerRegistro 1
let &TotalSaldoDiaVehiculo 0
let &TotalCantidadVehiculo 0
let &TotalInteresesVehiculo 0
let &TotalCantidadGeneral 0
let &TotalInteresesGeneral 0
let &TotalSaldoGenVehiculo 0
let &NuevoVehiculo 1


ifa
ACT(A:fac,'Operacion')
ACT(B:fac,'Book')
ACT(C:fac,'Banco')
ACT(D:fac,'Cuenta')
ACT(E:fac,'Fecha Origen')
ACT(F:fac,'Fecha Vto')
ACT(G:fac,'Moneda')
ACT(H:fac,'Tasa Coloc.')
ACT(I:fac,'Plazo')
ACT(J:fac,'Saldo Dia')
ACT(K:fac,'Saldo Promedio')
ACT(L:fac,'Interes Generado')
ACT(M:fac,'Tipo Cambio')
AgregarMarco(a:fac..M:fac,1,3,Exe('COLOR'))
SetFont(a:fac..M:fac,2)

IF Dialogo.Radio2 = 1
    SQL.ADD(" SELECT Vehiculo1, NrOperacion, Cliente1, FechaOp, FechaVto, Especie, Plazo, Cantidad, TotalIntereses, Precio1, Cuenta1, TotalNetoCli1, Book1 ")
ELSE
    SQL.ADD(" SELECT 'Consolidado' Vehiculo1, NrOperacion, Cliente1, FechaOp, FechaVto, Especie, Plazo, Cantidad, TotalIntereses, Precio1, Cuenta1, TotalNetoCli1, Book1 ")
ENDIF
SQL.ADD(" FROM "~DBO~".OPERACIONES ")
SQL.ADD(" WHERE FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' AND '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND TipoOp = 'MMRPAC' ")
IF NoVacio(Dialogo.Cuenta1)
    SQL.ADD(" AND Cuenta1 = '"~Dialogo.Cuenta1~"' ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF Dialogo.Radio3 = 0
    SQL.ADD(" AND Vehiculo1= '"~Dialogo.Vehiculo1~"' ")
   IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND Book1 in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
   ENDIF
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
ENDIF
SQL.ADD(" ORDER BY Vehiculo1 ")
Recorrer SQL
    IF Not Eqstr(fbn('Vehiculo1'),&Vehiculo)
        IF &PrimerRegistro = 0
            ACT(A:fac,'Total '~&Vehiculo)
            ACN(H:fac,&TotalSaldoDiaVehiculo)
            ACN(K:fac,&TotalCantidadVehiculo)
            ACN(L:fac,&TotalInteresesVehiculo)
            AgregarMarco(a:fac..M:fac,1,3,Exe('COLOR'))
            SetFont(a:fac..M:fac,2)
            ifa
            IF Not Eqstr('',&Vehiculo)
                ifa
            ENDIF
            let &TotalSaldoDiaVehiculo 0
            let &TotalCantidadVehiculo 0
            let &TotalInteresesVehiculo 0
        ELSE
            let &PrimerRegistro 0
        ENDIF 
        let &Vehiculo fbn('Vehiculo1')
        let &NuevoVehiculo 1
    ENDIF
    IF &NuevoVehiculo = 1
        ACT(A:fac,'Vehiculo: '~fbn('Vehiculo1'))
        AgregarMarco(a:fac..M:fac,1,3)
        SetFont(a:fac..a:fac,2)
        ifa
        let &NuevoVehiculo 0
    ENDIF
    ACT(A:fac,fbn('NrOperacion'))
    ACLO(A:fac,fbn('NrOperacion'))
    ***CINTIA 15-12 Agregar una columna con el código del book de la cuenta. (campo alias1, si ese campo está vacío poner el Book Default del Vehículo)
    ACT(B:fac,BuscarCampo('CUENTAS','Alias1','Codigo',fbn['Cuenta1']))
    If Vacio(Val(B:fac))
        ACT(B:fac,BuscarCampo('VEHICULOS','Alias5','Codigo',fbn['Vehiculo1']))
    Endif
    ****
    let &Book Val(B:fac)
    ACT(C:fac,fbn('Cliente1'))
    let &Banco Val(C:fac)
    ACT(D:fac,fbn('Cuenta1'))
    let &Cuenta Val(D:fac)
    ACD(E:fac,fbn('FechaOp'))
    ACD(F:fac,fbn('FechaVto'))
    ACT(G:fac,fbn('Especie'))
    let &Moneda fbn('Especie')
    ACT(H:fac,Fstr(fbn('Precio1'),0,8))
    let &TasaColocacion fbn('Precio1')
    ACT(I:fac,Fstr(fbn('Plazo'),0,0))
    IF Eqstr(&Expresado,fbn('Especie'))
        let &TipoCambio 1
        let &TipoCambioDisplay 1
    ELSE
        IF Eqstr(fbn('Especie'), &moneLocal)
            let &TipoCambio 1/CotizacionBNA(&moneExtr,fbn('FechaVto'),1)        
        ELSE
            let &TipoCambio CotizacionBNA(&moneExtr,fbn('FechaVto'),1)        
        ENDIF
        let &tipoCambioDisplay CotizacionBNA(&moneExtr,fbn('FechaVto'),1)
    ENDIF
    
    let &OperacionRef fbn('NrOperacion')
    
*    SQL.ADD(" SELECT Cantidad, TotalIntereses ")
*    SQL.ADD(" FROM "~DBO~".OPERACIONES ")
*    SQL.ADD(" WHERE TipoOp = 'MMCCR' ")
*    SQL.ADD(" AND FechaOp = '"~IdxDate(Dialogo.Fecha2)~"' ")
*    SQL.ADD(" AND OperacionRef = '"~&OperacionRef~"' ")
*    Recorrer SQL
*        DFA
*        ACN(I:fac,fbn('Cantidad')*&TipoCambio)
*        ACN(J:fac,fbn('TotalIntereses')*&TipoCambio)
*        ACL(J:fac,'DETREM',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,NrOperacion1=&OperacionRef,Precio1=&TipoCambio,Radio1=Dialogo.Radio1)
*    Proximo
    
    *Cantidad: Traigo la cantidad de la ultima MMCCR cuya FechaOp menor o igual a fecha hasta
    SQL.ADD(" SELECT Cantidad, TotalNetoCli1 ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES ")
    SQL.ADD(" WHERE TipoOp = 'MMCCR' ")
    SQL.ADD(" AND OperacionRef = '"~&OperacionRef~"' ")
    SQL.ADD(" AND FechaOp = ( ")
    SQL.ADD(" SELECT Max(FechaOp) FROM "~DBO~".OPERACIONES ")
    SQL.ADD(" WHERE TipoOp = 'MMCCR' ")
    SQL.ADD(" AND OperacionRef = '"~&OperacionRef~"' ")
    SQL.ADD(" AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD(" ) ")
    Recorrer SQL
        DFA
        ACN(J:fac,fbn('TotalNetoCli1')*&TipoCambio)
        ACN(K:fac,fbn('Cantidad')*&TipoCambio)
    Proximo
    
    *TotalIntereses: Sumo los intereses de todas las MMCCR cuya FechaOp menor o igual a fecha hasta
    SQL.ADD(" SELECT SUM(TotalIntereses) TotalIntereses")
    SQL.ADD(" FROM "~DBO~".OPERACIONES ")
    SQL.ADD(" WHERE TipoOp = 'MMCCR' ")
    SQL.ADD(" AND FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
    SQL.ADD(" AND OperacionRef = '"~&OperacionRef~"' ")
    Recorrer SQL
        DFA
        ACN(L:fac,fbn('TotalIntereses')*&TipoCambio)
        ACL(L:fac,'DETREM',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,NrOperacion1=&OperacionRef,Precio1=&TipoCambioDisplay,Radio1=Dialogo.Radio1,String1=&Banco,Precio2=&TasaColocacion,String2=&Moneda,String3=&Cuenta,String4=&Vehiculo,String5 = &Book)        
    Proximo
    
    ACT(M:fac,IIF(&TipoCambio <> 1,Fstr(&TipoCambioDisplay,0,8),'--'))
    let &TotalSaldoDiaVehiculo &TotalSaldoDiaVehiculo+Val(J:fac)
    let &TotalSaldoGenVehiculo &TotalSaldoGenVehiculo+Val(J:fac)
    let &TotalCantidadVehiculo &TotalCantidadVehiculo+Val(K:fac)
    let &TotalInteresesVehiculo &TotalInteresesVehiculo+Val(L:fac)
    let &TotalCantidadGeneral &TotalCantidadGeneral+Val(K:fac)
    let &TotalInteresesGeneral &TotalInteresesGeneral+Val(L:fac)
    SetFont(a:fac..M:fac,1)
Proximo

ifa
ACT(A:fac,'Total '~&Vehiculo)
ACN(J:fac,&TotalSaldoDiaVehiculo)
ACN(K:fac,&TotalCantidadVehiculo)
ACN(L:fac,&TotalInteresesVehiculo)
AgregarMarco(a:fac..M:fac,1,3,Exe('COLOR'))
SetFont(a:fac..M:fac,2)
ifa
ACT(A:fac,'Total General')
ACN(J:fac,&TotalSaldoGenVehiculo)
ACN(K:fac,&TotalCantidadGeneral)    
ACN(L:fac,&TotalInteresesGeneral)
AgregarMarco(a:fac..M:fac,1,3,Exe('COLOR6'))
SetFont(a:fac..M:fac,2)

ACO(1,9)
ACO(4,12)
ACO(5,8)
ACO(9,4)
ACO(10,12)
ACO(11,12)
ACO(12,12)
ACO(13,12)

ACT(A:fac+2,'Fin del informe')
SetFont(a:fac+2,4)

LimitesVision(N:fac+2)