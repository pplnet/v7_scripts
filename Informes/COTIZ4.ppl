ModoReproceso(ConDialogo)
CrearDialogo
  Especie1: 'Especie';;;;;;NoVacio(Dialogo.Especie1);'Debe Ingresar una Especie';NO
  Fecha1  : 'F.Desde';;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO; FSys
  Fecha2  : 'F.Hasta';;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO; FSys
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*ACT(c:2,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,1)

ACT(a:FAC, 'Pizarra por Especie')
SetFont(a:4..a4,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Especie : '~Dialogo.Especie1)
ACT(C:FAC+1, 'Cotiza en: '~CotizaEn(Dialogo.Especie1))
ACT(a:FAC+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'F.Hasta: '~Dialogo.Fecha2)

SetFilaActual(FAC+5)
ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Precio Cierre')
ACT(c:FAC, 'Volatilidad')
ACT(d:FAC, 'Profundidad')
ACT(E:FAC, 'Cont./Fut.')
ACT(F:FAC, 'FechaEj')
ACT(g:FAC, 'Precio Bloomberg')
ACT(h:FAC, 'Precio MAE')
ACT(i:FAC, 'Precio Reuters')
ACT(j:FAC, 'Precio SIB')
ACT(k:FAC, 'Moneda')

AlinearCeldas(a:FAC..k:FAC,'D')
SetFont(a:5..K:FAC,2)
AgregarMarco(a:FAC..K:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

SQL.ADD("Select Fecha, Precio1, VolumenPromedio, VolatilidadHistorica,CallPut,FechaEj,  ")
SQL.ADD("PrecioBloomberg, PrecioMAE, PrecioReuters, PrecioTelerate,Moneda               ")
SQL.ADD("From "~DBO~".PIZARRACOTIZACIONES where                                         ")
SQL.ADD("Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD("and Codigo = '"~Dialogo.Especie1~"'                                            ")
SQL.ADD("order by Fecha                                                                 ")

recorrer SQL
    ACT(a:fac, FBN['Fecha'])
    ACN(b:fac, FBN['Precio1'])
    ACN(c:fac, FBN['VolatilidadHistorica'])
    ACN(d:fac, FBN['VolumenPromedio'])
    ACT(E:FAC, FBN['CallPut'])
    ACT(F:FAC, FBN['FechaEj'])
    ACN(g:fac, FBN['PrecioBloomberg'])
    ACN(h:fac, FBN['PrecioMAE'])
    ACN(i:fac, FBN['PrecioReuters'])
    ACN(j:fac, FBN['PrecioTelerate'])
    ACT(K:fac, FBN['Moneda'])

    AlinearCeldas(a:FAC..a:FAC,'D')
proximo

SetFont(a:Val(w1)+6..K:FAC,1)
AlinearCeldas(E:Val(w1)+6..E:FAC,'C')

ACO(1,7)
ACO(2,10)

ACO(7,12)
ACO(8,12)
ACO(9,12)
ACO(10,12)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL INFORME')

SetFont(a:FAC,2)
FormatoCeldas(b5..c:fac, Exe('F10'))
FormatoCeldas(d5..d:fac, Exe('F0'))
FormatoCeldas(g5..j:fac, Exe('F10'))

*AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(K:FAC)
RangoTitulo(a:1..K:FAC, Val(w1)+5)
