********************************************************************
*
* Lista los Codigos de Entidades (Tabla Clientes)
*
*********************************************************************

HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
   Lista2:   "Entidades"  ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES ");
   Lista3:   "Paises"     ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".PAISES ");
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

SetFilaActual(1)
ACT(a:1,'Posicion Bancaria - CONFIDENCIAL')
SetFont(a:1,1)

SetFilaActual(fac+2)
ACT(b:fac, 'Listado de Entidades')
SetFont(f:fac, 3)
ACN(cd2, 0)

SetFilaActual(fac+1)
If NoVAcio(Dialogo.Lista2)
  ACT(a:fac, 'Entidades: '~iif(vacio(Dialogo.Lista2),'Todas',Pipe2Comillas(Dialogo.Lista2)))
  ACN(cd2, elementos(Dialogo.Lista2))
else
  ACT(a:fac, 'Entidades:  Todas')
endif

SetFilaActual(fac+1)
If NoVAcio(Dialogo.Lista3)
  ACT(a:fac, 'Paises: '~iif(vacio(Dialogo.Lista3),'Todos',Pipe2Comillas(Dialogo.Lista3)))
else
  ACT(a:fac, 'Paises:  Todos')
endif
SetFilaActual(fac+2)
ACT(A:fac,'Codigo')
ACT(B:fac,'Nombre')
ACT(C:fac,'Nro.Cuenta')
ACT(D:fac,'Direccion')
ACT(E:fac,'Localidad')
ACT(F:fac,'Cod.Postal')
ACT(G:fac,'Pais')
ACT(h:fac,'Nombre')
ACT(I:fac,'Status')
ACT(J:fac,'Alias1')
ACT(K:fac,'Nro.Datanet')
ACT(cd1,' ')
AgregarMarco(a:fac..k:fac,1,0,Exe('COLOR'))
Setfont(a2..k:fac, 1)
AlinearCeldas(j:fac..d:fac, 'C')
SQL.ADD(" Select A.Codigo, A.RazonSocial, A.NrCuenta, A.Direccion, A.Localidad, A.CodigoPostal, ")
SQL.ADD("  A.PaisDir, A.Status, A.Alias1, A.Alias2, P.Nombre PaisN ")
SQL.ADD("    from "~DBO~".CLIENTES A,"~DBO~".PAISES P ")
SQL.ADD("   where A.PaisDir = P.Codigo     ")
If NoVAcio(Dialogo.Lista2)
   SQL.ADD(" AND ( A.Codigo  IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
   Recorrer&I 1, elementos(Dialogo.Lista2)
      SQL.ADD("   or A.Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES',ItemLista(Dialogo.Lista2,&I)))~")  ")
   Proximo 
   SQL.ADD("      )  ")
endif
If NoVAcio(Dialogo.Lista3)
   SQL.ADD(" AND A.PaisDir  IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
endif
SQL.ADD("order by A.Jerarquia, A.Codigo")
acn(z3,0)
acn(z2,0)
ACN(FI:1, fac+1)
Recorrer SQL
   ACT(a:fac,FBN['Codigo'])
   ACT(b:fac,FBN['RazonSocial'])
   ACT(c:fac,FBN['NrCuenta'])
   ACT(d:fac,FBN['Direccion'])
   ACT(e:fac,FBN['Localidad'])
   ACT(f:fac,FBN['CodigoPostal'])
   ACT(g:fac,FBN['PaisDir'])
   ACT(h:fac,FBN['PaisN'])
   ACT(i:fac,FBN['Status'])
   ACT(j:fac,FBN['Alias1'])
   ACT(k:fac,FBN['Alias2'])
   SetFont(a:fac..k:fac, 2)
Proximo
Ifa
Ifa
AgregarMarco(a:fac..k:fac,1,0,Exe('COLOR'))
SetFont(a:fac..k:fac, 1)
Impresion(1,1)
act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)
SetFilaActual(fac+1)
LimitesVision(k:fac+1)
ACO(2, 15)
ACO(3, 15)
ACO(4, 20)
ACO(5, 15)
ACO(8, 10)
SetPrintFit(3, 75)
RangoTitulo(a:1..k:fac+1, 7)