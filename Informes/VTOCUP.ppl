CrearDialogo
  Fecha1 : 'Fecha' ;1;1;;;;Dialogo.Fecha1<>0;'Fecha invalida';NO;Fsys
  Radio1 : 'Estado|Procesado|Pendiente|Ambos' ;;;;;;;;;2
FinDialogo

If NOT OK
  Cancelar
Endif

CrearFont(1,"Arial,12,BI")
CrearFont(2,"Arial,10,B")
CrearFont(4,"Arial,8,BU")
CrearFont(5,"Arial,8,B")
CrearFont(6,"Arial,8,")
CrearFont(7,"Arial,8,BI")

ACT(a:3, 'Vencimiento de Cupones del '~Dialogo.Fecha1~' al '~Fecha(Habiles(Dialogo.Fecha1, 3, 'ARG')))
SetFont(a:3, 1)

SetFilaActual(5)
ACT(a:fac, 'Cortes de Cupon')
SetFont(a:fac, 4)
ifa
ifa
ACT(a:fac, 'Especie')
ACT(b:fac, 'Cupon')
ACT(c:fac, 'F.Corte')
ACT(d:fac, '%Renta')
ACT(e:fac, '%Am.Capital')
ACT(f:fac, '%Am.Int.Capital')
ACT(g:fac, 'Tipo')
ACT(h:fac, 'Estado')
SetFont(a:fac..h:fac, 5)
AlinearCeldas(a:fac..h:fac,'C')
AgregarMarco(a:fac..h:fac,0,0,EXE('COLOR6'))

SQL.ADD(" SELECT A.Especie, A.NrCupon, A.FechaPago, A.PorRenta, A.PorAmCapital, A.PorAmIntCap, A.TipoCupon, A.Estado, ")
SQL.ADD(" E.Nombre, 'NO' ZeroCupon ")
SQL.ADD(" FROM "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  A.Especie    = E.Codigo ")
SQL.ADD(" AND    A.FechaCorte <= '"~IdxDate(Habiles(Dialogo.Fecha1, 3, 'ARG'))~"' ")
SQL.ADD(" AND    (A.FechaCorte >= '"~IdxDate(Dialogo.Fecha1)~"' Or A.Estado = 'PEN') ")
If Dialogo.Radio1=0
  SQL.ADD(" AND A.Estado = 'PRO' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND A.Estado = 'PEN' ")
Endif

SQL.ADD(" UNION ")

SQL.ADD(" SELECT E.Codigo Especie, E.Cupon NrCupon, E.Fecha FechaPago, 0 PorRenta, 100 PorAmCapital, 0 PorAmIntCap, 'AMO' TipoCupon, '' Estado, ")
SQL.ADD(" E.Nombre, 'SI' ZeroCupon ")
SQL.ADD(" FROM "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE E.ZeroCoupon = 'SI' ")
SQL.ADD(" AND    E.Fecha <= '"~IdxDate(Habiles(Dialogo.Fecha1, 3, 'ARG'))~"' ")
SQL.ADD(" AND    E.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")

SQL.ADD(" ORDER BY A.Especie ")

Recorrer SQL
  ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
  ACT(b:fac, fbn('NrCupon'))
  ACD(c:fac, fbn('FechaPago'))
  ACN(d:fac, fbn('PorRenta'))
  ACN(e:fac, fbn('PorAmCapital'))
  ACN(f:fac, fbn('PorAmIntCap'))
  ACT(g:fac, IIF(Eqstr(fbn('TipoCupon'),'REN'),'Renta',IIF(Eqstr(fbn('TipoCupon'),'AMO'),'Amortizacion','Renta/Amortiz.')))
  ACT(h:fac, IIF(Eqstr(fbn('Estado'),'PEN'),'Pendiente','Procesado'))
  AlinearCeldas(b:fac,'C')
  FormatoCeldas(d:fac..f:fac,Exe('F8'))
  SetFont(a:fac..h:fac, 6)
Proximo

ifa
ifa
ifa


ACT(a:fac, 'Pagos de Cupones')
SetFont(a:fac, 4)
ifa
ifa
ACT(a:fac, 'Especie')
ACT(b:fac, 'Cupon')
ACT(c:fac, 'F.Pago')
ACT(d:fac, '%Renta')
ACT(e:fac, '%Am.Capital')
ACT(f:fac, '%Am.Int.Capital')
ACT(g:fac, 'Tipo')
ACT(h:fac, 'Estado')
SetFont(a:fac..h:fac, 5)
AlinearCeldas(a:fac..h:fac,'C')
AgregarMarco(a:fac..h:fac,0,0,EXE('COLOR6'))

SQL.ADD(" SELECT A.Especie, A.NrCupon, A.FechaPago, A.PorRenta, A.PorAmCapital, A.PorAmIntCap, A.TipoCupon, A.Estado, E.Nombre, 'NO' ZeroCupon ")
SQL.ADD(" FROM "~DBO~".AGENDACUPONES A, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  A.Especie   = E.Codigo ")
SQL.ADD(" AND    A.FechaPago <= '"~IdxDate(Habiles(Dialogo.Fecha1, 3, 'ARG'))~"' ")
SQL.ADD(" AND    (A.FechaPago >= '"~IdxDate(Dialogo.Fecha1)~"' Or A.Estado = 'PEN') ")
If Dialogo.Radio1=0
  SQL.ADD(" AND A.Estado = 'PRO' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND A.Estado = 'PEN' ")
Endif


SQL.ADD(" UNION ")

SQL.ADD(" SELECT E.Codigo Especie, E.Cupon NrCupon, E.Fecha FechaPago, 0 PorRenta, 100 PorAmCapital, 0 PorAmIntCap, 'AMO' TipoCupon, '' Estado, ")
SQL.ADD(" E.Nombre, 'SI' ZeroCupon ")
SQL.ADD(" FROM "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE E.ZeroCoupon = 'SI' ")
SQL.ADD(" AND    E.Fecha <= '"~IdxDate(Habiles(Dialogo.Fecha1, 3, 'ARG'))~"' ")
SQL.ADD(" AND    E.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")


SQL.ADD(" ORDER BY A.Especie ")

Recorrer SQL
  ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
  ACT(b:fac, fbn('NrCupon'))
  ACD(c:fac, fbn('FechaPago'))
  ACN(d:fac, fbn('PorRenta'))
  ACN(e:fac, fbn('PorAmCapital'))
  ACN(f:fac, fbn('PorAmIntCap'))
  ACT(g:fac, IIF(Eqstr(fbn('TipoCupon'),'REN'),'Renta',IIF(Eqstr(fbn('TipoCupon'),'AMO'),'Amortizacion','Renta/Amortiz.')))
  ACT(h:fac, IIF(Eqstr(fbn('Estado'),'PEN'),'Pendiente','Procesado'))
  AlinearCeldas(b:fac,'C')
  FormatoCeldas(d:fac..f:fac,Exe('F8'))
  SetFont(a:fac..h:fac, 6)
Proximo

ifa
ifa
ifa
ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac, 5)

SetMargins(0,0,0,2)
LimitesVision(i:fac+2)
Impresion(4,1)

ACO(1,10)
ACO(2, 5)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)