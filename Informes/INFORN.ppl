CrearDialogo
   Lista1: "Tipos de Evento"  ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".TIPOSEVENTO WHERE Codigo NOT IN ('VIEJOS','AUX','CONTD','PRUEBA')  ");SI
FiNdialogo

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Listado de Eventos')
ACT(a:FAC+2,'Codigo')
ACT(b:FAC+2,'Tipo')
ACT(c:FAC+2,'Nombre')
AgregarMarco(a:FAC+2..d:FAC+2,2,0,Exe('COLOR'))
SetFont(a:FAC..c:FAC+2,2)

SetFilaActual(FAC+2)

SQL.ADD("Select * From "~DBO~".EVENTOS")
SQL.ADD(" where Tipo NOT IN ('VIEJOS','AUX','CONTD','PRUEBA') ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND Tipo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD(" ORDER BY Tipo, Codigo ")
Recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN('Codigo'))
  ACT(b:FAC, BuscarCampo('TiposEvento','Descripcion','Codigo',FBN('Tipo')))
  ACT(c:FAC, FBN('Nombre'))
proximo

AgregarMarco(a:Val(w1)+3..d:FAC+1,1)
SetFont(a:Val(w1)+3..c:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(2,20)
ACO(3,25)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC, 2)
AgregarBMP(a1,'logo.bmp',60)
AlinearCeldas(c:3,'D')
LimitesVision(c:FAC)
RangoTitulo(a:1..c:FAC,Val(w1)+2)



