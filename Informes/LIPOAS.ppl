ACN(w:1, FAC)
SQL.ADD("Select LA.*,TL.Descripcion from LIMASIGNADOS LA, TIPOSLIMITE TL ")
SQL.ADD("where LA.Limite=TL.COdigo ")
SQL.ADD("and TL.Clase='P' ")
SQL.ADD("and LA.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("order by Limite,Book,Vehiculo,Cliente")
Recorrer SQL
  IF Not EqStr(FBN['Limite'],val(z1))
    ACT(z:1,FBN['Limite'])
    ACT(a:fac, FBN['Limite'])
    ACT(b:fac, FBN['Descripcion'])    
  EndIf

  if Incluido(FBN['Limite'],'BOOK')
    ACT(c:fac, FBN['BOOK'])
  else
    ACT(c:fac, FBN['Cliente'])
  endif
  ACT(d:fac, FBN['Especie'])
  ACN(e:fac, FBN['Monto'])
  ACD(f:fac, FBN['FAsignacion'])
  ACD(g:fac, FBN['FVencimiento'])
  ACD(h:fac, FBN['FRevision'])
Proximo

If FAC>Val(w:1)
  SetFont(a:Val(w:1)+1..a:FAC, 2)
  SetFont(b:Val(w:1)+1..k:FAC, 1)
else
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay Limites de Posicion asignados')
  SetFont(a:FAC, 2)
endif

