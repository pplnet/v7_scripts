*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Fecha'   ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Invalida';NO;Fsys
  Vehiculo1 : 'Vehiculo';;;;NO;;NoVacio(DIalogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

**AgregarBMP(A:1, Exe('LOGO'), 60)
ACT(A:2, CodigoInforme)
SetFilaActual(3)
ACT(c:fac, 'Operaciones Vigentes OCT -Compras y Ventas- al '~Dialogo.Fecha1)
*ACT(a:fac+1, 'Fecha: '~Dialogo.Fecha1)
SetFont(D:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(A:2..D:fac, 2)
SetFont(c:3, 3)
ACN(xx1, Cotizacion(Var('SECLIMUSD'),,,,Dialogo.Fecha1,1))

ACN(BD:1, 0)
ACN(BD:2, 0)
ACN(TM:1, 0)
ACN(TN:1, 0)
ACN(TO:1, 0)

SetFilaActual(fac+2)
ACT(b:fac, 'FechaVto')

ACT(c:fac, 'Cantidad')
ACT(d:fac, 'Precio MAE')
ACT(e:fac, 'Precio A3500')
ACT(f:fac, 'Valuacion MAE')
ACT(g:fac, 'Valuacion A3500')
AlinearCeldas(a:fac..g:fac, 'C')
SetFont(a:fac..g:fac, 2)
AgregarMarco(a:fac..g:fac, 0, 0, Exe('COLOR12'))
ACN(FI:1, fac+1)

SQL.ADD(" Select O.FechaVto,sum(O.Cantidad) VN, O.EnteCus1,O.ContraEspecie,O.TipoOp, ")
SQL.ADD(" Case O.TipoOp WHEN 'FXOCTC' THEN 1 ELSE 2 END BD ")
SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS OB  ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion AND OB.NrBit = 30 AND OB.Valor <> '1' ")
SQL.ADD(" AND O.TipoOp IN ('FXOCTC','FXOCTV') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND ((O.CB6 = '1' AND O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"') OR ((O.CB6 <> '1' OR O.CB6 Is Null OR O.CB6 = '') AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" Group by O.TipoOp,O.FechaVto,O.EnteCus1,O.ContraEspecie ")
SQL.ADD(" Order By O.TipoOp,O.FechaVto,O.EnteCus1,O.ContraEspecie ")

Recorrer SQL

    IF Val(BD:1) = 0 y fbn('BD') = 1
       ifa
       ACT(a:fac,'OCT Compras')
       SetFont(a:fac, 2)
       ACN(BD:1,1)
       ifa
       ifa
    endif
    IF fbn('BD') = 2 Y Val(BD:2) = 0
            SetFont(b:Val(FI:1)..R:fac, 1)
            IF Val(BD:1) = 1
                ifa
                ACT(a:fac, 'Totales OCT Compras')
                ACN(c:fac, Val(TO:1))
                ACN(f:fac, Val(TM:1))
                ACN(g:fac, Val(TN:1))
                SetFont(a:fac..g:fac, 2)
                FormatoCeldas(c:fac..g:fac, Exe('F2'))
                AgregarMarco(a:fac..g:fac, 0, 0, Exe('COLOR9'))
                FormatoCeldas(d:Val(FI:1)..e:fac, Exe('F9'))
                ACN(TM:1, 0)
                ACN(TN:1, 0)
                ACN(TO:1, 0)
                ifa
            ENDIF
            ifa
            ACT(a:fac, 'OCT Ventas')
            SetFont(a:fac, 2)
            ifa
            ifa
            ACN(FI:1, fac)
            ACN(BD:2, 1)
    ENDIF
    ACD(b:fac, fbn('FechaVto'))
    ACL(b:fac, 'OCTVIG', Vehiculo1 = Dialogo.Vehiculo1, Cliente1='',Fecha1 = Dialogo.Fecha1, Fecha2 = Val(b:fac),Lista1 ='', Lista2 = FBN('TipoOp'), Radio1 = 1)
    ACN(c:fac, fbn('VN'))
    ACN(d:fac, Cotizacion(FBN('EnteCus1'),'FUT',fbn('FechaVto'),,Dialogo.Fecha1,1,NO))
    ACN(e:fac, val(xx1))
    ACN(f:fac, val(c:fac)*Val(d:fac))
    ACN(g:fac, val(c:fac)*Val(xx1))
    SCN(TM:1,Val(f:fac))
    SCN(TN:1,Val(g:fac))
    SCN(TO:1,Val(c:fac))

Proximo
SetFont(b:Val(FI:1)..R:fac, 1)
IF Val(BD:2) = 1
    SetFilaActual(fac+2)
    ACT(a:fac, 'Totales OCT Ventas')
    ACN(c:fac, Val(TO:1))
    ACN(f:fac, Val(TM:1))
    ACN(g:fac, Val(TN:1))
    SetFont(a:fac..g:fac, 2)
    AgregarMarco(a:fac..g:fac, 0, 0, Exe('COLOR9'))
    ifa
ELSE
    IF Val(BD:1) = 1
        SetFilaActual(fac+2)
        ACT(a:fac, 'Totales OCT Compras')
        ACN(c:fac, Val(TO:1))
        ACN(f:fac, Val(TM:1))
        ACN(g:fac, Val(TN:1))
        SetFont(a:fac..g:fac, 2)
        AgregarMarco(a:fac..g:fac, 0, 0, Exe('COLOR9'))
    ENDIF
    ifa
ENDIF

FormatoCeldas(d:Val(FI:1)..e:fac, Exe('F9'))
SetFilaActual(fac+2)

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)


ACO(2, 12)
ACO(3, 12)
ACO(4, 12)
ACO(5, 12)
ACO(7, 12)

*SetMargins(1.5,0.5,0.5,1.5)
LimitesVision(g:fac+1)
