MostrarCuadroDeMensajes
CrearDialogo
   Fecha1:      'D.FechaLiq'             ;;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCAJ' "),1,'ARG',SI)   
   Fecha2:      'H.FechaLiq'             ;;;;NO;NO;;;;Dialogo.Fecha1;Dialogo.Fecha1
   Vehiculo1:   'Vehiculo'               ;;;;;;;;;VAR('VEHICULODE')
   Radio1:      '|Provisorio|Definitivo' ;2;1;;;;;;;;0
   Check1:      'Imp.T.General'          ;;;;;;;;;1
   ListaTabla1: 'Excluye Op'             ;4;;;;;;;;;;;;;;'NrOperacion' ; 'NrOperacion;FechaOp;TipoOp;Cliente1;Especie;Cantidad' ; 'OPERACIONES'
   ListaTabla2: 'Excluye Tr'             ;4;2;;;;;;;;;;;;;'NrTrans'     ; 'NrTrans;Fecha1;TipoTr2;Especie' ; 'TRANSACCIONES2'
   Radio2:      '|Manual|Evento'         ;;;;NO;NO;;;;;0
FinDialogo

If Not OK
   Cancelar
Endif

ACN(s:1, SQL("Select 1 From "~DBO~".FLAGSMERCADO Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'NCAJ' "))
if Val(s:1)>0
  if Dialogo.Radio1=0
    MessageBox('El Libro de Caja del '~Dialogo.Fecha1~' ya fue emitido.')
  else
    Cancelar('El Libro de Caja del '~Dialogo.Fecha1~' ya fue emitido. Debe utlizar la reimpresion.')
  endif
endif

if Dialogo.Radio1=1
  ACD(t:1,Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCAJ' "),1,'ARG',SI))
  if Dialogo.Radio2=0
     if Val(t:1) >  Habiles(FSys,-1,'ARG',SI)
        Cancelar('LICAJC - No hay fechas disponibles para impresión.')
     endif
  else
     if Val(t:1) >  Habiles(FSys,1,'ARG',SI)
        Cancelar('LICAJC - No hay fechas disponibles para impresión.')
     endif
  endif
  if Val(t:1) <> 0  y Val(t:1) <> Dialogo.Fecha1
     Cancelar('LICAJC - No se permite saltar fechas habiles.')
  endif
endif

**---------------------------------------------**

ACN(u:1,0)

