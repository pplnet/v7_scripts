If val(ra16)>0
   ACT(z7,'Titulos: '~IIF(val(ra16)=2,'Todos','Alguno'))
EndIf
If val(ra17)>0
   ACT(z7,VAL(z7)~' FX: '~IIF(val(ra17)=2,'Todos','Alguno'))
EndIf
