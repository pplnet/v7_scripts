   ACT(z5,VAL(z5)~' MM o FC: '~IIF(val(ra8)=2,'Todos','Alguno'))
EndIf
If val(ra9)>0
   ACT(z5,VAL(z5)~' Derivados: '~IIF(val(ra9)=2,'Todos','Alguno'))
EndIf
If val(ra10)>0
   ACT(z5,VAL(z5)~' MR: '~IIF(val(ra10)=2,'Todos','Alguno'))
EndIf
If NoVacio(Dialogo.Lista6)
   ACT(z5,VAL(z5)~' NrOperacion o Tipos: '~Dialogo.Lista6)
EndIf
ACT(d:5,val(z5))

ACT(a:6,'DEVENGADO => ')
ACT(z6,'')

If val(ra11)>0
   ACT(z6,'Titulos: '~IIF(val(ra11)=2,'Todos','Alguno'))
EndIf
