ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'             ;1;1;;;;Dialogo.Fecha1<=FSYS y EsHabil(Dialogo.Fecha1,'ARG');'Fecha de Valuacion Incorrecta';NO;FSys
  NrOperacion1 : 'Operacion'     ;1;2;;;;;;; 
  Lista1   : 'Vehiculo'          ;2;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Lista3   : 'Especies'          ;-4;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Status='HAB' ORDER BY Codigo "); 
  Label1   : ''        ;-4;1;;NO;;;;;'Mark To Market'  
  Radio1   : 'Titulos  |Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio2   : 'Fx       |Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio3   : 'MM o FC  |Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio4   : 'Derivados|Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio5   : 'MR       |Nada|Alguno|Todos|'         ;;;;;;;;;2
  Label2   : ''        ;-4;2;;NO;;;;;'Mark To Model'  
  Radio6   : 'Titulos  |Nada|Alguno|Todos|'         ;;2;;;;;;;2
  Radio7   : 'Fx       |Nada|Alguno|Todos|'         ;;2;;;;;;;2
  Radio8   : 'MM o FC  |Nada|Alguno|Todos|'         ;;2;;;;;;;2
  Radio9   : 'Derivados|Nada|Alguno|Todos|'         ;;2;;;;;;;2
  Radio10  : 'MR       |Nada|Alguno|Todos|'         ;;2;;NO;NO;;;;0
  Label3   : ''        ;2;1;;NO;;;;;'Devengado'  
  Radio11  : 'Titulos  |Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio12  : 'Fx       |Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio13  : 'MM o FC  |Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio14  : 'Derivados|Nada|Alguno|Todos|'         ;;;;;;;;;0
  Radio15  : 'MR       |Nada|Alguno|Todos|'         ;;;;NO;NO;;;;0
  Label4   : ''        ;2;2;;NO;;;;;'Contable'  
  Radio16  : 'Titulos  |Nada|Alguno|Todos|'         ;;2;;;;;;;0
  Radio17  : 'Fx       |Nada|Alguno|Todos|'         ;;2;;;;;;;0
  Radio18  : 'MM o FC  |Nada|Alguno|Todos|'         ;;2;;;;;;;0
  Radio19  : 'Derivados|Nada|Alguno|Todos|'         ;;2;;;;;;;0
  Radio20  : 'MR       |Nada|Alguno|Todos|'         ;;2;;NO;NO;;;;0
FinDialogo

If not OK
  Cancelar
endif

ACN(pa1,0)
IF Dialogo.Radio1=1 o Dialogo.Radio2=1 o Dialogo.Radio3=1 o Dialogo.Radio4=1 o Dialogo.Radio5=1 o Dialogo.Radio6=1 o Dialogo.Radio7=1 o Dialogo.Radio8=1 o Dialogo.Radio9=1 o Dialogo.Radio10=1 o Dialogo.Radio11=1 o Dialogo.Radio12=1 o Dialogo.Radio13=1 o Dialogo.Radio14=1 o Dialogo.Radio15=1 o Dialogo.Radio16=1 o Dialogo.Radio17=1 o Dialogo.Radio18=1 o Dialogo.Radio19=1 o Dialogo.Radio20=1
   ACN(pa1,1)
EndIf
ACT(op1,Dialogo.NrOperacion1)
ACN(ra1,Dialogo.Radio1)
ACN(ra2,Dialogo.Radio2)
ACN(ra3,Dialogo.Radio3)
ACN(ra4,Dialogo.Radio4)
ACN(ra5,Dialogo.Radio5)
ACN(ra6,Dialogo.Radio6)
ACN(ra7,Dialogo.Radio7)
ACN(ra8,Dialogo.Radio8)
ACN(ra9,Dialogo.Radio9)
ACN(ra10,Dialogo.Radio10)
ACN(ra11,Dialogo.Radio11)
ACN(ra12,Dialogo.Radio12)
ACN(ra13,Dialogo.Radio13)
ACN(ra14,Dialogo.Radio14)
ACN(ra15,Dialogo.Radio15)
ACN(ra16,Dialogo.Radio16)
ACN(ra17,Dialogo.Radio17)
ACN(ra18,Dialogo.Radio18)
ACN(ra19,Dialogo.Radio19)
ACN(ra20,Dialogo.Radio20)


ACD(fe1,Dialogo.Fecha1)
ACT(li1,Dialogo.Lista1)
ACT(li3,Dialogo.Lista3)
ACT(li5,'')
ACT(li5,SQLSet("Select NrOperacion+' '+TipoOp as Codigo From "~DBO~".OPERACIONES WHERE FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"'  ORDER BY 1"))
ACT(li5,val(li5)~SQLSet("Select Distinct TipoOp as Codigo From "~DBO~".OPERACIONES WHERE FechaOp<='"~IdxDate(Dialogo.Fecha1)~"' and FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' ORDER BY 1 "))

*- 2da pantalla del reporte
CrearDialogo
  Fecha1   : 'Fecha'             ; 1;1;;NO;NO;;;;val(fe1)
  Radio2   : 'Expresado|ARP|USD' ; 1;1;;;;;;;0
  Lista4   : 'Clientes'          ; 1;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Status='HAB' ORDER BY Codigo ");
  Lista5   : 'A MtMarket'        ;  ;1;;val(ra1)=1  o val(ra2)=1  o val(ra3)=1  o val(ra4)=1  o  val(ra5)=1;;;;;;;val(li5);
  Lista6   : 'A MtModel '        ;-4;2;;val(ra6)=1  o val(ra7)=1  o val(ra8)=1  o val(ra9)=1  o val(ra10)=1;;;;;;;val(li5);
  Lista7   : 'A Devengado'       ;-3;1;;val(ra11)=1 o val(ra12)=1 o val(ra13)=1 o val(ra14)=1 o val(ra15)=1;;;;;;;val(li5);
  Lista8   : 'A Contable '       ;-9;2;;val(ra16)=1 o val(ra17)=1 o val(ra18)=1 o val(ra19)=1 o val(ra20)=1;;;;;;;val(li5);
FinDialogo

If not OK
   Cancelar
EndIf

*- Control de Vehiculo Habilitado
ACT(zz6, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null  or Status='') ")) )

CrearFont(3, 'Arial,10,B')
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFilaActual(1)
ACT(a:1,'Informe de VALUACIONES Segun Distintos Criterios al '~Dialogo.Fecha1)
SetFont(a1,3)

ACT(a:2, 'Vehiculo : '~VAL(ZZ6))
ACT(e:2, 'Clientes : '~IIf(Vacio(Dialogo.Lista4),' Todos ',Dialogo.Lista4))
ACT(g:2, 'Especies : '~IIf(Vacio(val(li3)),' Todos ',val(li3)))
ACT(i:2, 'Expresado en '~IIF(Dialogo.Radio2=0,'Pesos','Dolares') )
SetFont(a:2..z:2,1)

*---------------------
ACT(a:4,'MARK TO MARKET => ')
ACT(z4,'')

If val(ra1)>0
   ACT(z4,'Titulos: '~IIF(val(ra1)=2,'Todos','Alguno'))
EndIf
