ACT(z5,'')

If val(ra6)>0
   ACT(z5,'Titulos: '~IIF(val(ra6)=2,'Todos','Alguno'))
EndIf
If val(ra7)>0
   ACT(z5,VAL(z5)~' FX: '~IIF(val(ra7)=2,'Todos','Alguno'))
EndIf
