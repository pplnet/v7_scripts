MostrarCuadroDeMensajes
CrearDialogo
   Fecha1  : 'Fecha'     ;1;1;;;;;;;habiles(FSYS,-1,'ARG')
   Especie1: 'Moneda'    ;2;1;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1,'MONEDA');'Moneda Invalida';NO;'ARP';;;;;"Status = 'HAB' AND Tipo='MON' "
   Radio2 :  'Tipo Cuenta|Cta.Cte|Intermedia|Recaudadora|Todos' ;4;1;;;;;;;3
   Lista1:   'Vehiculos' ; 5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
   Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
   Lista3:   'Cuentas'   ; 0;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') " ) )~"  ");
FinDialogo

If NOT OK
  Cancelar
Endif

CrearFont(1,"Arial,12,BI")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,BI")
CrearFont(4,"Arial,8,BU")
CrearFont(5,"Arial,8,BI")
CrearFont(6,"Arial,8,B")
CrearFont(7,"Arial,8,")

ACT(a:1, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:2, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:3, 'Cuentas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Fecha: '~Dialogo.Fecha1 )
If Dialogo.Radio2=0
  ACT(a:5, 'Tipo de Cta: Cuenta Corriente')
Endif
If Dialogo.Radio2=1
  ACT(a:5, 'Tipo de Cta: Intermedia')
Endif
If Dialogo.Radio2=2
  ACT(a:5, 'Tipo de Cta: Recaudadora')
Endif
If Dialogo.Radio2=3
  ACT(a:5, 'Tipo de Cta: Todas')
Endif

ACT(b:6, 'Diferencias de Estimaciones para Presupuestos del '~Dialogo.Fecha1 )
SetFont(a:1..z:5,6)
SetFont(b:6,3)

SetFilaActual(7)

HoJaVisible(SI)

SQL.ADD(" SELECT T.Cantidad4*(-1) Cantidad, T.Especie, T.Fecha2 FechaMov, T.Vehiculo1 Cliente, T.Cuenta1 Cuenta, T.TipoTr2 Tipo, ")
SQL.ADD(" T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ")
SQL.ADD(" B.Codigo, 'E' Estado, T.CB6, T.Observaciones, T.NrTrans ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C,  ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  T.Cuenta1     = C.Codigo ")
SQL.ADD(" AND    C.Comitente   = B.Codigo ")
SQL.ADD(" AND    T.Especie     = E.Codigo ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
SQL.ADD(" AND    T.CB6         = '1' ")
SQL.ADD(" AND    T.TipoTR2 IN ('TRANSF') ")
SQL.ADD(" AND    T.Fecha2 = "~IdxDate2(Dialogo.Fecha1)~" ")
(.'PBSELECT'.)
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND T.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT T.Cantidad4 Cantidad, T.Especie, T.Fecha2 FechaMov, T.Vehiculo1 Cliente, T.Cuenta2 Cuenta, T.TipoTr2 Tipo, ")
SQL.ADD(" T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ")
SQL.ADD(" B.Codigo, 'E' Estado, T.CB6, T.Observaciones, T.NrTrans ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C,  ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  T.Cuenta2     = C.Codigo ")
SQL.ADD(" AND    C.Comitente   = B.Codigo ")
SQL.ADD(" AND    T.Especie     = E.Codigo ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
SQL.ADD(" AND    T.CB6         = '1' ")
SQL.ADD(" AND    T.TipoTR2 IN ('TRANSF') ")
SQL.ADD(" AND    T.Fecha2 = "~IdxDate2(Dialogo.Fecha1)~" ")
(.'PBSELECT'.)
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND T.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
*ESTIMACIONES
SQL.ADD(" UNION ")
SQL.ADD(" SELECT M.Cantidad1 Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
SQL.ADD(" M.Cuenta2 Cuenta, M.TipoTr2 Tipo, M.Fecha2 FechaOp, ")
SQL.ADD(" B.RazonSocial Banco, C.Numero, B.Codigo, 'E' Estado, '9' CB6, M.Observaciones, M.NrTrans ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".TRANSACCIONES2 M, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
SQL.ADD(" AND    M.Fecha2    = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.TipoTr2   = 'ESTIMA' ")
(.'PBSELECT'.)
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo1 IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
*DISPONIBILIDADES  - INGRESOS 
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT (M.Importe8+M.Importe9+M.Importe10+M.Importe11) Cantidad, ")
SQL.ADD(" E.Codigo Especie, M.FechaAcreditacion FechaMov, M.Vehiculo Cliente, ")
SQL.ADD(" C.Codigo Cuenta, 'DISPOI' Tipo, M.FechaAcreditacion FechaOp, B.RazonSocial Banco, ")
SQL.ADD(" C.Numero, B.Codigo, 'E' Estado, '9' CB6, ' ' Observaciones, ' ' NrTrans ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVDATANET M, "~DBO~".ESPECIES E, "~DBO~".DATANET D ")
SQL.ADD(" WHERE  M.Moneda    = E.Alias3 ")
SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    C.Numero    = M.Cuenta ")
SQL.ADD(" AND    (C.Pagadora <> 'SI' OR C.Pagadora IS NULL ) ")
SQL.ADD(" AND    M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    D.Archivo   IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
(.'PBSELECT'.)
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
* DISPONIBILIDADES  - EGRESOS
SQL.ADD(" SELECT (M.Importe4+M.Importe5+M.Importe6+M.Importe7)*(-1) Cantidad, ")
SQL.ADD(" E.Codigo Especie, M.FechaAcreditacion FechaMov, M.Vehiculo Cliente, ")
SQL.ADD(" C.Codigo Cuenta, 'DISPOE' Tipo, M.FechaAcreditacion FechaOp, B.RazonSocial Banco, ")
SQL.ADD(" C.Numero, B.Codigo, 'E' Estado, '9' CB6, ' ' Observaciones, ' ' NrTrans ")
SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVDATANET M, "~DBO~".ESPECIES E, "~DBO~".DATANET D ")
SQL.ADD(" WHERE  M.Moneda    = E.Alias3 ")
SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    C.Numero    = M.Cuenta ")
SQL.ADD(" AND    (C.Pagadora <> 'SI' OR C.Pagadora IS NULL ) ")
SQL.ADD(" AND    M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    D.Archivo   IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
(.'PBSELECT'.)
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"') ")
  Endif
Endif
SQL.ADD(" ORDER BY 4,10,5 ")

ACT(va:1,'')
ACT(cu:1,'')
ACT(ba:1,'')

ACN(te:1,0)
ACN(te:2,0)
ACN(ti:1,0)
ACN(ti:2,0)

Recorrer SQL
  If Not Eqstr(Val(cu:1), fbn('Cuenta')) 
    * CAMBIA LA CUENTA
    If Not Eqstr(Val(cu:1), '')
      *NO ES LA PRIMERA DEL BANCO NI EL VEHICULO
      ACN(fi:2,fac)
      SQL.ADD(" SELECT T.NrTrans, T.TipoTr2, M.Cantidad, M.Cuenta, M.FechaMov, MD.TipoMov CodigoDatanet1, M.EnteCustodia, ")
      SQL.ADD(" CD.Descripcion DescripcionCD, TD.Descripcion DescripcionTD, CD.Tipo ")
      SQL.ADD(" FROM  "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".CONCILIACIONES C, ")
      SQL.ADD(" "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".MOVDATANET MD ")
      SQL.ADD(" WHERE T.NrTrans = C.NrOperacion ")
      SQL.ADD(" AND   M.NrMov   = C.NrMovimiento ")
      SQL.ADD(" AND   MD.NrDatanet    = C.NrDatanet ")
      SQL.ADD(" AND   MD.NrMovDatanet = C.NrMovDatanet ")
      SQL.ADD(" AND   T.NrTrans = M.NrOperacion ")
      SQL.ADD(" AND   M.Cuenta  = '"~Val(cu:1)~"' ")
      SQL.ADD(" AND   M.FechaMov= "~IdxDate2(Dialogo.Fecha1)~" ")
      SQL.ADD(" AND   MD.TipoMov= CD.Codigo ")
      SQL.ADD(" AND   CD.Tipo          = TD.Codigo ")
      SQL.ADD(" AND   CD.Tipo IN ("~Pipe2Comillas(VAR('DNPRESUP'))~")  ")
      SQL.ADD(" UNION ALL ")
      SQL.ADD(" SELECT T.NrTrans, T.TipoTr2, M.Cantidad, M.Cuenta, M.FechaMov, MD.TipoMov CodigoDatanet1, M.EnteCustodia,  ")
      SQL.ADD(" CD.Descripcion DescripcionCD, TD.Descripcion DescripcionTD, CD.Tipo ")
      SQL.ADD(" FROM  "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPENDIENTES M, "~DBO~".CONCILIACIONES C, ")
      SQL.ADD(" "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".MOVDATANET MD ")
      SQL.ADD(" WHERE T.NrTrans = C.NrOperacion ")
      SQL.ADD(" AND   M.NrMov   = C.NrMovimiento ")
      SQL.ADD(" AND   T.NrTrans = M.NrOperacion ")
      SQL.ADD(" AND   MD.NrDatanet    = C.NrDatanet ")
      SQL.ADD(" AND   MD.NrMovDatanet = C.NrMovDatanet ")
      SQL.ADD(" AND   M.Cuenta  = '"~Val(cu:1)~"' ")
      SQL.ADD(" AND   M.FechaMov= "~IdxDate2(Dialogo.Fecha1)~" ")
      SQL.ADD(" AND   MD.TipoMov= CD.Codigo ")
      SQL.ADD(" AND   CD.Tipo          = TD.Codigo ")
      SQL.ADD(" AND   CD.Tipo IN ("~Pipe2Comillas(VAR('DNPRESUP'))~")  ")
      SQL.ADD(" ORDER BY 3 ")

      SetFilaActual(Val(fi:1)-1)
      ACN(pr:1,0)
      ACN(pr:2,0)
      ACN(fi:2, Val(fi:1))
      ACN(fi:3, fac)

      Recorrer SQL
        If [fbn('Cantidad') >0 y Val(pr:2)<0 y Val(pr:1)<>0] o [fbn('Cantidad') <0 y Val(pr:2)>0 y Val(pr:1)<>0]

          ACN(d:fac, SUM(d:Val(fi:3)..d:fac))

          If fbn('Cantidad') >0
            ACT(c:fac, 'Total Egresos ->')
            SCN(te:2,Val(d:fac))
          Else
            ACT(c:fac, 'Total Ingresos ->')
            SCN(ti:2,Val(d:fac))
          Endif

          SetFont(a:fac..d:fac,5)
          FormatoCeldas(d:fac,EXE('F2'))
          IFA
          ifa
          ACN(fi:3, fac)

        Endif

        ACN(pr:1,1)
        ACN(d:fac, fbn('Cantidad'))
        SCN(tc:1, Val(d:fac))
        ACLT(d:fac, fbn('NrTrans'))
        ACT(e:fac, fbn('CodigoDatanet1')~' - '~fbn('DescripcionCD'))
        ACT(f:fac, fbn('Tipo')~' - '~fbn('DescripcionTD'))

        ACN(pr:2,fbn('Cantidad'))
        FormatoCeldas(d:fac,EXE('F2'))
        SetFont(d:fac..f:fac,7)

      Proximo

      If fac < Val(fi:2)
        SetFilaActual(Val(fi:2))
      Else
        ifa
      Endif

      ACN(d:fac, SUM(d:Val(fi:3)..d:fac))
      If Val(pr:2) <0
        ACT(c:fac, 'Total Egresos ->')
        SCN(te:2,Val(d:fac))
      Else
        ACT(c:fac, 'Total Ingresos ->')
        SCN(ti:2,Val(d:fac))
      Endif

      SetFont(a:fac..d:fac,5)
      FormatoCeldas(d:fac,EXE('F2'))
      IFA
      IFA

      ACN(fi:3, fac)

      ACN(b:fac, SUM(b:Val(fi:1)..b:fac))
      ACN(d:fac, Val(tc:1))
      ACN(tc:1,0)

      ACN(dc:1, Val(b:fac)-Val(d:fac))
      SCN(db:1, (Val(b:fac)-Val(d:fac)))
      SCN(dv:1, (Val(b:fac)-Val(d:fac)))
      SetFont(a:fac..f:fac,4)
      AgregarMarco(a:fac..f:fac,0,0,0)
      ifa
      ACT(a:fac, 'Diferencia por Egresos '~PYC(Val(te:1)-Val(te:2),0,2))
      ifa
      ACT(a:fac, 'Diferencia por Ingresos '~PYC(Val(ti:1)-Val(ti:2),0,2))
      ifa
      ACT(a:fac, 'Diferencia por Cuenta '~PYC(Val(dc:1),0,2))
      AgregarMarco(a:fac-2..f:fac,0,0,EXE('COLOR8'))
      SetFont(a:fac-2..a:fac,5)
      ifa
    Endif

    If Not Eqstr(Val(ba:1), fbn('Banco'))
      * CAMBIA EL BANCO
      If Not Eqstr(Val(ba:1), '')
        ifa
        ACT(a:fac, 'Diferencia por Banco '~PYC(Val(db:1),0,2))
        SetFont(a:fac,5)
        AgregarMarco(a:fac..f:fac,0,0,EXE('COLOR6'))
        ifa
        ifa
        ACN(db:1,0)
      Endif
    Endif

    If Not Eqstr(Val(va:1), fbn('Cliente'))
      * CAMBIA EL VEHICULO
      If Not Eqstr(Val(va:1), '')
        ACT(a:fac, 'Diferencia por Vehiculo '~PYC(Val(dv:1),0,2))
        SetFont(a:fac,2)
        AgregarMarco(a:fac..f:fac,0,0,0)

        ACN(dv:1,0)
        ACN(db:1,0)
        ifa
        SaltarHoja
      Endif

      message('Vehiculo: '~fbn('Cliente'))
      ACT(a:fac, 'Vehiculo: '~fbn('Cliente'))
      ACT(va:1,fbn('Cliente'))
      SetFont(a:fac,2)
      ACT(ba:1,'')
      ACT(cu:1,'')
      ifa
    Endif

    If Not Eqstr(Val(ba:1), fbn('Banco'))
      ifa
      message('Banco: '~fbn('Banco'))
      ACT(a:fac,'Banco: '~fbn('Banco'))
      SetFont(a:fac,6)
      AgregarMarco(a:fac..f:fac,0,0,EXE('COLOR6'))
    Endif

    ifa
    ifa
    message('Cuenta:   '~fbn('Cuenta'))
    ACT(a:fac,'Cuenta: '~fbn('Cuenta')~' - Nro: '~fbn('Numero'))
    ACT(cu:1,fbn('Cuenta'))
    SetFont(a:fac,4)
    AgregarMarco(a:fac..f:fac,0,0,EXE('COLOR8'))
    ifa
    ACT(b:fac, 'E S T I M A D O')
    ACT(e:fac, 'R E A L')
    AgregarMarco(a:fac..c:fac,0,0,0)
    AgregarMarco(d:fac..f:fac,0,0,0)
    SetFont(a:fac..z:fac,2)
    ifa
    ACT(b:fac, 'Importe')
    ACT(c:fac, 'Observaciones')
    ACT(d:fac, 'Importe')
    ACT(e:fac, 'Codigo Datanet')
    ACT(f:fac, 'Tipo')
    SetFont(a:fac..z:fac,5)
    IFA
    ACN(fi:1,fac)
    ACN(tc:1,0)

    ACN(te:1,0)
    ACN(te:2,0)
    ACN(ti:1,0)
    ACN(ti:2,0)
  Endif

  If Eqstr(fbn('Tipo'),'DISPOE')
    ACT(a:fac, 'Egresos por Disponibilidades')
  Endif
  If Eqstr(fbn('Tipo'),'DISPOI')
    ACT(a:fac, 'Ingresos por Disponibilidades')
  Endif
  If Eqstr(fbn('Tipo'),'ESTIMA')
    ACT(a:fac, 'Estimaciones')
  Endif
  If Eqstr(fbn('Tipo'),'TRANSF')
    ACT(a:fac, 'Traslados Automaticos')
  Endif
  ACN(b:fac, fbn('Cantidad'))
  If Val(b:fac)>0
    SCN(ti:1,Val(b:fac))
  Else
    SCN(te:1,Val(b:fac))
  Endif
  If Not Incluido(fbn('Tipo'),'DISPOI|DISPOE')
    ACLT(b:fac, fbn('NrTrans'))
  Endif
  ACT(c:fac, fbn('Observaciones'))

  ACT(ba:1,fbn('Banco'))
  ACT(va:1,fbn('Cliente'))
  ACT(cu:1,fbn('Cuenta'))

  ACN(fe:3, fac)

  ACN(te:2,0)
  ACN(ti:2,0)

  FormatoCeldas(b:fac,EXE('F2'))
  SetFont(a:fac,6)
  SetFont(b:fac..c:fac,7)
Proximo

IFA
ACN(fi:2,fac)
*SQL.ADD(" SELECT T.NrTrans, T.TipoTr2, M.Cantidad, M.Cuenta, M.FechaMov, T.CodigoDatanet1, M.EnteCustodia, ")
SQL.ADD(" SELECT T.NrTrans, T.TipoTr2, M.Cantidad, M.Cuenta, M.FechaMov, MD.TipoMov CodigoDatanet1, M.EnteCustodia, ")
SQL.ADD(" CD.Descripcion DescripcionCD, TD.Descripcion DescripcionTD, CD.Tipo ")
SQL.ADD(" FROM  "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".CONCILIACIONES C, ")
SQL.ADD(" "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".MOVDATANET MD ")
SQL.ADD(" WHERE T.NrTrans = C.NrOperacion ")
SQL.ADD(" AND   M.NrMov   = C.NrMovimiento ")
SQL.ADD(" AND   T.NrTrans = M.NrOperacion ")
SQL.ADD(" AND   MD.NrDatanet    = C.NrDatanet ")
SQL.ADD(" AND   MD.NrMovDatanet = C.NrMovDatanet ")
SQL.ADD(" AND   M.Cuenta  = '"~Val(cu:1)~"' ")
SQL.ADD(" AND   M.FechaMov= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   MD.TipoMov= CD.Codigo ")
SQL.ADD(" AND   CD.Tipo          = TD.Codigo ")
SQL.ADD(" AND   CD.Tipo IN ("~Pipe2Comillas(VAR('DNPRESUP'))~")  ")
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT T.NrTrans, T.TipoTr2, M.Cantidad, M.Cuenta, M.FechaMov, MD.TipoMov CodigoDatanet1, M.EnteCustodia,  ")
SQL.ADD(" CD.Descripcion DescripcionCD, TD.Descripcion DescripcionTD, CD.Tipo ")
SQL.ADD(" FROM  "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPENDIENTES M, "~DBO~".CONCILIACIONES C, ")
SQL.ADD(" "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".MOVDATANET MD ")
SQL.ADD(" WHERE T.NrTrans = C.NrOperacion ")
SQL.ADD(" AND   M.NrMov   = C.NrMovimiento ")
SQL.ADD(" AND   T.NrTrans = M.NrOperacion ")
SQL.ADD(" AND   MD.NrDatanet    = C.NrDatanet ")
SQL.ADD(" AND   MD.NrMovDatanet = C.NrMovDatanet ")
SQL.ADD(" AND   M.Cuenta  = '"~Val(cu:1)~"' ")
SQL.ADD(" AND   M.FechaMov= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   MD.TipoMov= CD.Codigo ")
SQL.ADD(" AND   CD.Tipo          = TD.Codigo ")
SQL.ADD(" AND   CD.Tipo IN ("~Pipe2Comillas(VAR('DNPRESUP'))~")  ")
SQL.ADD(" ORDER BY 3 ")
SetFilaActual(Val(fi:1)-1)

ACN(tc:1,0)
ACN(pr:1,0)
ACN(pr:2,0)
ACN(fi:2, Val(fi:1))
ACN(fi:3, fac)

Recorrer SQL
  If [fbn('Cantidad') >0 y Val(pr:2)<0 y Val(pr:1)<>0] o [fbn('Cantidad') <0 y Val(pr:2)>0 y Val(pr:1)<>0]
    ACN(d:fac, SUM(d:Val(fi:3)..d:fac))
    If fbn('Cantidad') >0
      ACT(c:fac, 'Total Egresos ->')
      SCN(te:2,Val(d:fac))
    Else
      ACT(c:fac, 'Total Ingresos ->')
      SCN(ti:2,Val(d:fac))
    Endif
    SetFont(a:fac..d:fac,5)
