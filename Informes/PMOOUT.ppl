ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha';;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;FSys
  Check1   : 'Impuestos' ;;;;;;;;;1
  Check2   : 'Aper. Cuotas' ;;;;;;;;;0
  Vehiculo1: 'Vehiculo'  
  Especie1 : 'Especie';;;;;;VACIO(DIALOGO.ESPECIE1) o [DesciendeDeEspecie(DIALOGO.ESPECIE1,'MONEDA') y EsTerminal(DIALOGO.ESPECIE1, Especie) y Incluido(DIALOGO.ESPECIE1,Var('LISESPMO'))];'Debe Ingresar una Moneda Valida';NO
  Cliente1 : 'Cliente'
  TipoOp1  : 'Tipo Op.';;;;;;;;;;;;;;" Codigo in ('PMU','PME')"
  Radio1   : 'Otras Deudas|No incluir|Solo BCRA|Solo HO' ;;;;;;;;;0
FinDialogo

if not Ok
  Cancelar
endif

HojaVisible(SI)

ACD(z2,Dialogo.Fecha1)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

SetFilaActual(4)

ACT(a:fac,'Vehiculo')
ACT(b:fac,'Cliente')
ACT(c:fac,'Moneda')
ACT(d:fac,'TipoOp')
ACT(e:fac,'NrOperacion')
ACT(f:fac,'F.Inicio')
ACT(g:fac,'F.Vto')
ACT(h:fac,'Plazo')
ACT(i:fac,'Capital')
ACT(j:fac,'Int.Normal')
ACT(k:fac,'Compensat.')
ACT(l:fac,'Punitorios')
ACT(m:fac,'Comisiones')
ACT(n:fac,'Com. Comp.')
if Dialogo.Check1=1
  ACT(o:fac,'IVA Interes')
  ACT(p:fac,'IVA Compen.')
  ACT(q:fac,'IVA Punit.')
  ACT(r:fac,'IVA Comis.')
  ACT(s:fac,'IVA Com.C.')
endif
ACT(t:fac,'Total')
*ACT(u:fac,'FacilityType')
*ACT(v:fac,'Commited')
*ACT(w:fac,'ContractSub')
ACT(u:fac,'IMM Asociada')

AlinearCeldas(t:fac..t:fac, 'D')

SetFont(a:fac..z:fac, 1)
ACT(ff3,'Filtro: ')
ACT(ff3,val(ff3)~"Fecha: "~Dialogo.Fecha1~" ")

SQL.ADD("Select O.Vehiculo1,O.Cliente1,O.Especie,O.TipoOp,O.NrOperacion,O.Sublimite,O.RB5,O.Cantidad, ")
SQL.ADD("O.FechaOp,O.Plazo,O.FechaVto,O.DiasAnio,O.MB3, ")
SQL.ADD("O.TasaInteresesCupon,O.Mercado,O.RB9,O.RB10,O.PorComision, ")
SQL.ADD("O.Book1, O.RB1, O.NrOperacion3, O.RB2, O.TotalAux8, ")
SQL.ADD("O.Precio1, O.TotalComisiones, O.Centro2, ")
SQL.ADD("C.CondicionIVA, C.AgPercepcionIVA, C.ExIVA, C.PorcExIVA, C.FDesdeExIVA, C.FHastaExIVA, C.IVAPISE, O.NrOperacion2 ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("where O.TipoOp in ('PMU','PME') and (O.FechaPrecan>"~IdxDate2(val(z2))~" or O.FechaPrecan is null)")
SQL.ADD("and O.FechaOp <="~IdxDate2(val(z2))~" ")
SQL.ADD("and C.Codigo = O.Cliente1 ")
SQL.ADD("and O.NrOperacion=OB.NrOperacion and OB.NrBit in ('70','10') and OB.Valor='1' ")

if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
  ACT(ff3,val(ff3)~" TipoOp: "~Dialogo.TipoOp1~"  ")
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
  ACT(ff3,val(ff3)~" Vehiculo: "~Dialogo.Vehiculo1~"  ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
  ACT(ff3,val(ff3)~" Especie: "~Dialogo.Especie1~"  ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
  ACT(ff3,val(ff3)~" Cliente: "~Dialogo.Cliente1~"  ")
endif

ACT(ff3,val(ff3)~" Otras Deudas: "~iif(Dialogo.Radio1=0,'No incluir',iif(Dialogo.Radio1=1,'Solo BCRA','Solo HO'))~"  ")

*==========================
*     OTRAS DEUDAS
*==========================

if Dialogo.Radio1>0
  SQL.ADD("union all ")
  SQL.ADD("select Vehiculo,Cliente,Especie,(case Limite when 'ACMAN' then 'BCRA' when 'DFVN' then 'HO' end) as TipoOp,Substring(Descripcion,1,8) as NrOperacion,Sublimite,Commited,sum(Monto) as Total, ")
  SQL.ADD("null,null,null,null,null, ")
  SQL.ADD("null,null,null,null,null, ")
  SQL.ADD("null,null,null,null,null, ")
  SQL.ADD("null,null,null, ")
  SQL.ADD("null,null,null,null,null,null,null ")
  SQL.ADD("from "~DBO~".MOVLIMITES ")
  SQL.ADD("where NrOperacion='CONTABLE' ")
  SQL.ADD("and convert(datetime,Usuario)<="~IdxDate2(val(z2))~" ")
  if Dialogo.Radio1=1
    SQL.ADD("and Limite in ('ACMAN') ")
  else
    if Dialogo.Radio1=2
      SQL.ADD("and Limite in ('DFVN') ")
    endif
  endif
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and Vehiculo = '"~Dialogo.Vehiculo1~"' ")
  endif
  if NoVacio(Dialogo.Especie1)
    SQL.ADD("and Especie = '"~Dialogo.Especie1~"' ")
  endif
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD("and Cliente = '"~Dialogo.Cliente1~"' ")
  endif

  SQL.ADD("group by Vehiculo, Cliente, Especie, (case Limite when 'ACMAN' then 'BCRA' when 'DFVN' then 'HO' end), Substring(Descripcion,1,8),Sublimite,Commited ")
endif

SQL.ADD(" order by 1,2,3,4 ")

ACT(ww1,'')
ACN(xx1,0)

ACT(ac1,'ww')
ACT(ac2,'ww')
ACT(ac3,'ww')

ACN(pz1,0)
ACN(pz2,0)
ACN(pz3,0)

ACN(to1,0)

recorrer SQL
ACN(xx1,0)


if not EQSTR(fbn('Cliente1'),val(ac1)) o not EQSTR(fbn('Especie'),val(ac2)) o not EQSTR(fbn('Vehiculo1'),val(ac3))
  if val(pz1)=1
    ACT(g:fac,'Total: ')
    ACN(i:fac, val(tt1))       
    ACN(j:fac, val(tt2))       
    ACN(k:fac, val(tt3))       
    ACN(l:fac, val(tt4))       
    ACN(m:fac, val(tt5))       
    ACN(n:fac, val(tt6))       
    if Dialogo.Check1=1
      ACN(o:fac, val(tt7))       
      ACN(p:fac, val(tt8))       
      ACN(q:fac, val(tt9))       
      ACN(r:fac, val(tt10))       
      ACN(s:fac, val(tt11))       
    endif
    ACN(t:fac, sum(i:fac..s:fac))

    *Sumo Otras Deudas
    SCN(t:fac,val(to1))

    SetFont(g:fac..t:fac, 1)
    ifa    
    recorrer&k 1,12
      ACN(tt:&k,0)
    proximo

    ACN(to1,0)
  else
    ACN(pz1,1)
  endif
endif



if Incluido(fbn('TipoOp'),'PMU|PME|')
  if not EQSTR(val(ww1),fbn('NrOperacion'))
    ACT(a:fac,fbn('Vehiculo1'))
    ACT(b:fac,fbn('Cliente1'))
    ACT(c:fac,fbn('Especie'))
    ACT(d:fac,fbn('TipoOp'))
    ACT(e:fac,fbn('NrOperacion'))
    ACT(f:fac,fbn('FechaOp'))
    ACT(g:fac,fbn('FechaVto'))
    ACT(h:fac,fbn('Plazo'))
*    ACT(u:fac,fbn('Sublimite'))
*    ACT(v:fac,IIF(EqStr(fbn('RB5'),'0'),'SI','NO'))
*    ACT(w:fac,fbn('Centro2'))
    ACT(u:fac,fbn('NrOperacion2'))
    ACLO(u:fac,fbn('NrOperacion2'))
    ACLO(e:fac,fbn('NrOperacion'))
 
    ACT(ww1,fbn('NrOperacion'))
  endif
else
    * Otras Deudas
    ACT(a:fac,fbn('Vehiculo1'))
    ACT(b:fac,fbn('Cliente1'))
    ACT(c:fac,fbn('Especie'))
    ACT(d:fac,fbn('TipoOp'))
    ACT(e:fac,fbn('NrOperacion'))

    ACN(t:fac,fbn('Cantidad'))
    SCN(to1,val(t:fac))

*    ACT(u:fac,fbn('Sublimite'))
*    ACT(v:fac,fbn('RB5'))


endif 

ACT(z1,fbn('NrOperacion'))

  ACT(a1,FBN['Especie'])
  ACT(b1,FBN['Cliente1'])
  ACN(c1,FBN['Cantidad'])
  ACD(d1,FBN['FechaOp'])
  ACN(e1,FBN['Plazo'])
  ACD(f1,FBN['FechaVto'])
  if FBN['DiasAnio']=0
    ACN(g1,36000)
  else
    ACN(g1,36500)
  endif
  ACN(h1,FBN['TasaInteresesCupon'])
         
  ACT(j1,FBN['CondicionIVA'])
  ACT(k1,FBN['AgPercepcionIVA'])
  ACT(l1,FBN['ExIVA'])
  ACN(m1,FBN['PorcExIVA'])
  ACD(n1,FBN['FDesdeExIVA'])
  ACD(o1,FBN['FHastaExIVA'])
  ACT(p1,FBN['Vehiculo1'])
  ACT(q1,FBN['Mercado'])
  ACT(r1,FBN['IVAPISE'])
  ACT(s1,FBN['MB3'])
  ACN(t1,FBN['RB9'])
  ACN(u1,FBN['RB10'])
  ACN(v1,FBN['PorComision'])
  ACT(w1,FBN['TipoOp'])
  ACT(bo1,FBN['Book1'])
  ACT(bo2,FBN['RB1'])
  ACT(bo3,FBN['NrOperacion3'])
  ACT(bo4,FBN['RB2'])

ACN(fx1, fac)
if EQSTR(fbn('TipoOp'),'PMU')
  (.'PMOOUTAUX'.)
  else
  if EQSTR(fbn('TipoOp'),'PME')
    (.'PMOOUTAUX4'.)
  endif
endif
SetFilaActual(val(fx1))

if Dialogo.Check2=1 y Incluido(fbn('TipoOp'),'PMU|PME|')
  ifa
  ACT(b:fac,'NrCuota')
  ACT(c:fac,'FInicio')
  ACT(d:fac,'FVtoFinal')
  ACT(e:fac,'Plazo')
  ACT(f:fac,'TNA')
  ifa
  if EQSTR(val(w1),'PMU')
    ACT(b:fac,'1')
    ACT(c:fac,val(d1))
    ACT(d:fac,val(f1))
*    ACT(e:fac,val(e1))
    ACT(e:fac,FStr(val(e1),0,0))
    ACT(f:fac,val(cu:val(xx1)))
  else
    recorrer&j 1,val(xx1)
      ACT(b:fac,val(cz:&j))
      ACT(c:fac,val(cy:&j))
      ACT(d:fac,val(cw:&j))
      ACT(e:fac,val(cx:&j))
      ACT(f:fac,val(cu:&j))
      ifa
    proximo        
    dfa
  endif

endif

SetFilaActual(val(fx1))

if Dialogo.Check2=1 y Incluido(fbn('TipoOp'),'PMU|PME|')
  ifa
  ifa
endif

if EQSTR(val(w1),'PMU')
  if not EQSTR(val(bo4),'1')
    ACN(i:fac,val(ca:val(xx1)))   
  else
    ACN(i:fac,0)
  endif

  ACN(j:fac,val(gg:val(xx1)))
  ACN(k:fac,val(da:val(xx1)))
  ACN(l:fac,val(db:val(xx1)))
  ACN(m:fac,val(na:val(xx1)))
  ACN(n:fac,val(nh:val(xx1)))

  if Dialogo.Check1=1
    ACN(o:fac,val(ia:val(xx1)))
    ACN(p:fac,val(ib:val(xx1)))
    ACN(q:fac,val(ic:val(xx1)))
    ACN(r:fac,val(id:val(xx1)))
    ACN(s:fac,val(ie:val(xx1)))
  endif

  ACN(t:fac,sum(i:fac..s:fac))

else

  if EQSTR(val(w1),'PME')

    if Dialogo.Check2=1
      * Apertura por cuotas
      recorrer&j 1,val(xx1)
        if not EQSTR(val(bo4),'1')
          ACN(i:fac,val(ca:&j))
        else
          ACN(i:fac,0)
        endif
  
        ACN(j:fac,val(gg:&j))
        ACN(k:fac,val(da:&j))
        ACN(l:fac,val(db:&j))
        ACN(m:fac,val(na:&j))
        ACN(n:fac,val(nh:&j))

        if Dialogo.Check1=1
          ACN(o:fac,val(ia:&j))
          ACN(p:fac,val(ib:&j))
          ACN(q:fac,val(ic:&j))
          ACN(r:fac,val(id:&j))
          ACN(s:fac,val(ie:&j))
        endif

        ACN(t:fac,sum(i:fac..s:fac))
        ifa
      proximo
      dfa
    else
      * Por operacion
      if not EQSTR(val(bo4),'1')
        ACN(i:fac,sum(ca:1..ca:val(xx1)))
      else
        ACN(i:fac,0)
      endif
  
      ACN(j:fac,sum(gg:1..gg:val(xx1)))
      ACN(k:fac,sum(da:1..da:val(xx1)))
      ACN(l:fac,sum(db:1..db:val(xx1)))
      ACN(m:fac,sum(na:1..na:val(xx1)))
      ACN(n:fac,sum(nh:1..nh:val(xx1)))

      if Dialogo.Check1=1
        ACN(o:fac,sum(ia:1..ia:val(xx1)))
        ACN(p:fac,sum(ib:1..ib:val(xx1)))
        ACN(q:fac,sum(ic:1..ic:val(xx1)))
        ACN(r:fac,sum(id:1..id:val(xx1)))
        ACN(s:fac,sum(ie:1..ie:val(xx1)))
      endif
      ACN(t:fac,sum(i:fac..s:fac))
    endif

  endif
endif

if Incluido(fbn('TipoOp'),'PMU|PME|')
  if not EQSTR(val(bo4),'1')
    SCN(tt1, sum(ca:1..ca:val(xx1)) )      
  endif
  SCN(tt2, sum(gg:1..gg:val(xx1)) )      
  SCN(tt3, sum(da:1..da:val(xx1)) )      
  SCN(tt4, sum(db:1..db:val(xx1)) )      
  SCN(tt5, sum(na:1..na:val(xx1)) )      
  SCN(tt6, sum(nh:1..nh:val(xx1)) )      
  SCN(tt7, sum(ia:1..ia:val(xx1)) )      
  SCN(tt8, sum(ib:1..ib:val(xx1)) )      
  SCN(tt9, sum(ic:1..ic:val(xx1)) )      
  SCN(tt10, sum(id:1..id:val(xx1)) )      
  SCN(tt11, sum(ie:1..ie:val(xx1)) )      
endif

*ACT(ac1,val(b1))
*ACT(ac2,val(a1))
*ACT(ac3,val(p1))

ACT(ac1,FBN['Cliente1'])
ACT(ac2,FBN['Especie'])
ACT(ac3,FBN['Vehiculo1'])

proximo

ifa
ACT(g:fac,'Total: ')
ACN(i:fac, val(tt1))       
ACN(j:fac, val(tt2))       
ACN(k:fac, val(tt3))       
ACN(l:fac, val(tt4))       
ACN(m:fac, val(tt5))       
ACN(n:fac, val(tt6))       
if Dialogo.Check1=1
  ACN(o:fac, val(tt7))       
  ACN(p:fac, val(tt8))       
  ACN(q:fac, val(tt9))       
  ACN(r:fac, val(tt10))       
  ACN(s:fac, val(tt11))       
endif
ACN(t:fac, sum(i:fac..s:fac))

*Sumo Otras Deudas
SCN(t:fac,val(to1))

SetFont(g:fac..t:fac, 1)

*-------------------------------------
BorrarCeldas(a1..w1)

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
ACT(w1,VAR('TITULO'))
ACT(w2, 'Listado de Outstandings')
AlinearCeldas(w1..w2,'D')
SetFont(w1..w2, 1)

ACT(a3,'Sistema: FPA')
ACT(c3,'Fecha de Proceso: '~Fecha(FSYS))
ACT(f3,val(ff3))
ACT(w3,'Usuario: '~USUARIOACTIVO~'  Server: '~SQL("select @@servername"))
AlinearCeldas(w3..w3,'D')

*Landscape
Impresion(1,2)
*Fecha
Impresion(2,1)
*Pagina
Impresion(3,1)

ACO(3,5)
ACO(4,4)
ACO(8,4)

if Dialogo.Check2=1
  ACO(3,7)
  ACO(4,7)
endif

if not Dialogo.Check1=1
  ACO(15,5)
  ACO(16,5)
  ACO(17,5)
  ACO(18,5)
  ACO(19,5)
endif
ACO(22,6)
ACO(23,7)
ACO(24,10)

* Reduzco el alto de todas las filas
recorrer&i 1,fac+7
  AFI(&i,1)
proximo

if Dialogo.Check2=1
  SetPrintFit(3,68)
  else
  SetPrintFit(3,72)
endif

LimitesVision(x:UFila)

* Encabezado
RangoTitulo(a:1..x:fac+7,4)
SetMargins(0,0,0,1.0)