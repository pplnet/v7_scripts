ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

CrearDialogo
  Fecha1:   'Fecha'   ;1;1;;;;;;;fsys
  Radio1 : 'Tipo Cuenta|Cta.Cte|Intermedia|Recaudadora|Todos' ;2;1;;;;;;;3
  Lista2:   'Bancos'    ; 3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Monedas'   ;-3;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES WHERE Tipo='MON' ");
  Lista1:   'Vehiculos' ;  ;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
  Lista4:   'Cuentas'   ;-8;2;;;;;;;;;SQLSet(" Select TRIM(Codigo) From "~DBO~".CUENTAS WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")
If Dialogo.Radio1=0
  ACT(a:2, 'Tipo de Cuenta: Cuenta Corriente')
Endif
If Dialogo.Radio1=1
  ACT(a:2, 'Tipo de Cuenta: Intermedia')
Endif
If Dialogo.Radio1=2
  ACT(a:2, 'Tipo de Cuenta: Recaudadora')
Endif
If Dialogo.Radio1=3
  ACT(a:2, 'Tipo de Cuenta: Todos')
Endif
ACT(a:3, 'Monedas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:5, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
SetFont(a:2..a:5,2)

ACT(b:6, 'Detalle de Estimaciones del '~Dialogo.Fecha1)
SetFont(b:6,3)

SetFilaActual(7)

ACT(ea:1,'')
ACT(ba:1,'')
ACT(ca:1,'')

ACN(to:1,0 )
ACN(to:2,0 )
ACN(to:3,0 )
ACN(to:4,0 )
ACN(to:5,0 )
ACN(to:6,0 )
ACN(to:7,0 )
ACN(to:8,0 )


SQL.ADD(" SELECT O.Especie, O.Cantidad1 Cantidad, O.TipoTr2 TipoOp, C.Comitente, E.Nombre, ")
SQL.ADD(" CL.RazonSocial, O.Cuenta2 Cuenta, C.Numero, O.Fecha1 FechaMov, 'ESTIMA' Estado, O.NrTrans, O.Observaciones ")
SQL.ADD(" FROM  "~DBO~".TRANSACCIONES2 O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  O.Cuenta2     = C.Codigo ")
SQL.ADD(" AND    O.Especie     = E.Codigo ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
SQL.ADD(" AND    O.TipoTr2 IN ('ESTIMA') ")
SQL.ADD(" AND    O.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   O.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND   O.Cuenta2 IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT E.Codigo Especie, (O.Importe4+O.Importe5+O.Importe6+O.Importe7)*(-1) Cantidad, ")
SQL.ADD("  ' ' TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, O.Cuenta, C.Numero, O.FechaIngreso FechaMov, 'DISPO' Estado, O.NrDatanet NrTrans, ' ' Observaciones ")
SQL.ADD(" FROM  "~DBO~".MOVDATANET O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  O.Cuenta      = C.Numero ")
SQL.ADD(" AND    O.Moneda      = E.Alias3 ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
SQL.ADD(" AND    O.FechaIngreso = "~IdxDate2(Dialogo.Fecha1)~" ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   O.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND O.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT E.Codigo Especie, (O.Importe8+O.Importe9+O.Importe10+O.Importe11) Cantidad, ")
SQL.ADD(" ' ' TipoOp, C.Comitente, E.Nombre, CL.RazonSocial, O.Cuenta, C.Numero, O.FechaIngreso FechaMov, 'DISPO' Estado, O.NrDatanet NrTrans, ' ' Observaciones")
SQL.ADD(" FROM  "~DBO~".MOVDATANET O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
SQL.ADD(" WHERE  O.Cuenta      = C.Numero ")
SQL.ADD(" AND    O.Moneda      = E.Alias3 ")
SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
If Dialogo.Radio1=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC')")
Endif
SQL.ADD(" AND    O.FechaIngreso = "~IdxDate2(Dialogo.Fecha1)~" ")
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   O.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND O.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
SQL.ADD(" ORDER BY 1, 4, 7, 3 ")

Recorrer SQL
 If Not Eqstr(fbn('Especie'), Val(ea:1))
    message('Moneda: '~fbn('Nombre'))

    If Not Eqstr(Val(ea:1),'')
      ACT(a:fac, 'Total Banco -> ')
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      SetFont(a:fac..k:fac,5) 
      FormatoCeldas(b:fac..k:fac,EXE('F2')) 
      AgregarMarco(a:fac..k:fac,0,0,0)
      SCN(to:9, Val(d:fac) )

      ifa
      ifa
      ACT(a:fac, 'Total Moneda -> ')
      ACN(d:fac, Val(to:9) )
      SetFont(a:fac..k:fac,5) 
      AgregarMarco(a:fac..k:fac,0,0,EXE('COLOR8'))

      ACN(to:9,0 )
      ifa
      SaltarHoja
    Endif

    ifa
    ACT(a:fac, 'Moneda: '~fbn('Nombre'))
    SetFont(a:fac,5)
    ifa
    ACT(a:fac, 'Banco ')
    ACT(b:fac, 'Cuenta ')
    ACT(c:fac, 'Transaccion')
    ACT(d:fac, 'Importe')
    ACT(e:fac, 'Observaciones')

    AlinearCeldas(b:fac..k:fac+1, 'C')
    SetFont(a:fac..k:fac+1,2)
    AgregarMarco(a:fac..k:fac+1,0,0,EXE('COLOR6'))
    ifa
    ifa
   
    ACT(ba:1, '')
    ACT(ca:1, '')
 Endif

 If Not Eqstr(fbn('Comitente'), Val(ba:1))
    If Not Eqstr(Val(ba:1),'')
      ACT(a:fac, 'Total Banco -> ')
      ACN(d:fac, SUM(d:Val(fi:1)..d:fac) )
      SetFont(a:fac..i:fac,5) 
      FormatoCeldas(b:fac..k:fac,EXE('F2')) 
      AgregarMarco(a:fac..k:fac,0,0,0)
      SCN(to:9,  Val(d:fac) )
      ifa
    Endif
    ifa
    message('Banco: '~fbn('Comitente'))
    ACT(a:fac, fbn('RazonSocial'))
    SetFont(a:fac,5)
    ACT(ca:1,'')
    ifa
    ACN(fi:1, fac)
 Endif

 If Not Eqstr(fbn('Cuenta'), Val(ca:1))
    message('Cuenta: '~fbn('Numero'))
    ACT(b:fac, trim(fbn('Cuenta'))~' - '~fbn('Numero'))
    SetFont(b:fac,5)
 Else
    dfa
 Endif

 ACT(c:fac, fbn('NrTrans'))
 If Eqstr(fbn('TipoOp'),'ESTIMA')
   ACLT(c:fac, fbn('NrTrans'))
 Endif
 ACN(d:fac, fbn('Cantidad'))
 ACT(e:fac, fbn('Observaciones'))

 ACN(k:fac, SUM(b:fac..d:fac))
 SetFont(b:fac..k:fac,1) 
 FormatoCeldas(b:fac..k:fac,EXE('F2')) 

 ACT(ea:1, fbn('Especie'))
 ACT(ba:1, fbn('Comitente'))
 ACT(ca:1, fbn('Cuenta'))
