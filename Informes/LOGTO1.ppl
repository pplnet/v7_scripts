ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1 :'Desde';1;;;;;;;;FSys
  Fecha2 :'Hasta';2;;;;;;;;FSys
  String3:'D.Hora';1;2;;;;NoVacio(Dialogo.String3) y HoraValida(Dialogo.String3);'Debe especificar una Hora_Desde Valida';NO;'00:00';;;;'##:##'
  String4:'H.Hora';2;2;;;;NoVacio(Dialogo.String4) y HoraValida(Dialogo.String4) y [GtStr(Dialogo.String4,Dialogo.String3) o EqStr(Dialogo.String4,Dialogo.String3)] ;'Debe especificar una Hora_Hasta Valida';NO;'23:59';;;;'##:##'
  String1: 'Tabla' ;3;1;
  String2: 'Codigo'
  String : 'Campo'
  Operador: 'Usuario';;;;;;;;;
  Check1  : 'Resumido'  ;;;;;;;;;0;
  Radio1  : 'Muestra|Separado|Junto';;;;NO;NO;;;;0;
FinDialogo

if not Ok
  Cancelar
endif

ACT(a4, 'Log Total de Modificaciones '~DBO)
ACT(a5, 'Desde : '~Dialogo.Fecha1~' Hasta '~Dialogo.Fecha2)
ACT(e5, 'Hora  '~Dialogo.String3~' a '~Dialogo.String4)
ACT(a6, 'Filtros : '~Dialogo.String1~' '~Dialogo.String2~' '~Dialogo.String)

ACT(a7, 'Usuario')
ACT(b7, 'Fecha')
ACT(c7, 'Accion')
ACT(d7, 'Tabla')
ACT(e7, 'Codigo')
ACT(f7, 'Campo')
ACT(g7, 'Val.Anterior')
ACT(h7, 'Val.Actual')


SetFilaActual(7)
If Dialogo.Check1=1
  SQL.ADD("Select Distinct Tabla,Codigo ")
Else
  SQL.ADD("Select Tabla,Codigo,Accion,Fecha,ValorAnterior,ValorActual,Operador,Campo,Convert(Char,Fecha) Fechita")
Endif
SQL.ADD("  From "~DBO~".PMAUDIT  ")
SQL.ADD(" Where Convert(Char,Fecha,20) >='"~Fecha(Dialogo.Fecha1,'YYYY-MM-DD')~' '~Dialogo.String3~":00'")
SQL.ADD("   and Convert(Char,Fecha,20) <='"~Fecha(Dialogo.Fecha2,'YYYY-MM-DD')~' '~Dialogo.String4~":00'")
IF NoVacio(Dialogo.String1)
   SQL.ADD(" AND Tabla = '"~Dialogo.String1 ~"' ")
ENDIF
IF NoVacio(Dialogo.String2)
   SQL.ADD(" AND Codigo = '"~Dialogo.String2 ~"' ")
ENDIF
IF NoVacio(Dialogo.String)
   SQL.ADD(" AND Campo = '"~Dialogo.String ~"' ")
ENDIF
IF NoVacio(Dialogo.Operador)
   SQL.ADD(" AND Operador = '"~Dialogo.Operador ~"' ")
ENDIF
IF Dialogo.Radio1 = 1 Y Vacio(Dialogo.String1)
   SQL.ADD(" AND Tabla IN ('INFORMES','EVENTOS','TIPOSOPERACION','TIPOSORDEN','TIPOSMINUTABOLSA','FUNCIONES','FORMULAS','MODELOSASIENTO','MODELOSASIENTO1','TIPOSTRANSACCION2','VARIABLES','INSTANCIAS','TIPOSIMPUESTO','TIPOSARANCEL','TIPOSPOSICION','TIPOSFACTURA','PRODUCTOS') ")
ENDIF
If Dialogo.Check1=0
   SQL.ADD("order by Tabla, Codigo, Accion, Fecha")
Endif


Recorrer SQL

  acn(x1, 0)

  If Dialogo.Check1 = 0

    if Not EqStr(Val(z1), fbn('Tabla')~fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
      ACT(z1,    fbn('Tabla')~fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
      ACT(a:FAC, fbn('Operador'))
      ACT(b:FAC, fbn('Fecha'))
      ACT(c:FAC, fbn('Accion'))
      ACT(d:FAC, fbn('Tabla'))
      ACT(e:FAC, fbn('Codigo'))
      scn(x1, 1)
    endif
    if [EqStr(fbn('Accion'),'A') y NoVacio(fbn('ValorActual'))] o [EqStr(fbn('Accion'),'M') y Not EqStr(fbn('ValorActual'),fbn('ValorAnterior'))] o [EqStr(fbn('Accion'),'B') y NoVacio(fbn('ValorAnterior'))]
      ACT(f:FAC, fbn('Campo'))
      ACT(g:FAC, fbn('ValorAnterior'))
      ACT(h:FAC, fbn('ValorActual'))
    else
      if Val(x1) = 0
        dfa
      endif
    endif

  Else

    ACT(d:FAC, fbn('Tabla'))
    ACT(e:FAC, fbn('Codigo'))

  Endif


Proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z7, 1)
SetFont(a8..z:fac, 2)
AgregarMarco(a7..h7,1,0,Exe('COLOR'))

ACO(3,5)
ACO(4,12)
ACO(5,9)
ACO(6,10)
ACO(7,14)
ACO(8,14)
ACO(9,1)
LimitesVision(i:Fac+1)
SetPrintFit(3,90)