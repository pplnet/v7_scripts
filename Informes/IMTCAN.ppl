MostrarCuadroDeMensajes
CrearDialogo
 Fecha1   :'R.Date Desde';1;1;;;;;;;FSys
 Fecha2   :'R.Date Hasta';2;1;;;;;;;FSys
 Fecha3   :'F.Pago Desde';1;2;;;;;;;FSys
 Fecha4   :'F.Pago Hasta';2;2;;;;;;;FSys
 Especie1 :'Especie'     ;4;1;;;;;;;
 Cliente1 :'Cliente'     ;5;1;;;;;;;
 Check1   :'Inc.Vehiculo';5;2;;;;;;;1
 Mercado1 :'Mercado'     ;4;2;;;;;;;
 Vehiculo1:'Vehiculo'    ;6;1;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial,10,B")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,U")
CrearFont(4,"Arial,8,")

** FJL 10/08/22 - No mostrar transacciones saldos Parking
ACT(w:1, VAR('SALPARK'))

SetFilaActual(1)
ACT(a:fac,'Transacciones Canje')
Setfont(a:fac,1)

SetFilaActual(fac+2)
if NoVacio(Dialogo.Fecha1)
  ACT(a:fac,'R.Date Desde:')
  ACT(b:fac,Dialogo.Fecha1)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
endif
if NoVacio(Dialogo.Fecha2)
  ACT(a:fac,'R.Date Hasta:')
  ACT(b:fac,Dialogo.Fecha2)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
endif
if NoVacio(Dialogo.Fecha3)
  ACT(a:fac,'F.Pago Desde:')
  ACT(b:fac,Dialogo.Fecha3)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
endif
if NoVacio(Dialogo.Fecha4)
  ACT(a:fac,'F.Pago Hasta:')
  ACT(b:fac,Dialogo.Fecha4)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:fac,'Especie:')
  ACT(b:fac,Dialogo.Especie1)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
endif
If NoVacio(Dialogo.Cliente1)
  ACT(a:fac,'Cliente:')
  ACT(b:fac,Dialogo.Cliente1)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
Endif
If NoVacio(Dialogo.Mercado1)
  ACT(a:fac,'Mercado:')
  ACT(b:fac,Dialogo.Mercado1)
  SetFont(a:fac,4)
  SetFont(b:fac,2)
  ifa
Endif
ACT(a:fac,'Vehiculo:')
ACT(b:fac,Dialogo.Vehiculo1)
SetFont(a:fac,4)
SetFont(b:fac,2)

SetFilaActual(fac+2)
ACT(a:fac  ,'Cliente')
ACT(b:fac  ,'NrTrans')
ACT(c:fac  ,'Record')
ACT(c:fac+1,'Date')
ACT(d:fac  ,'Fecha')
ACT(d:fac+1,'Pago')
ACT(e:fac  ,'ORIGEN')
ACT(e:fac+1,'Especie')
ACT(f:fac+1,'V.Nominal')
ACT(g:fac+1,'Relacion')
ACT(h:fac  ,'DESTINO')
ACT(h:fac+1,'Relacion')
ACT(i:fac+1,'Especie')
ACT(j:fac+1,'V.Nominal')
ACT(k:fac  ,'FRACCION')
ACT(k:fac+1,'Especie')
ACT(l:fac+1,'Valor')
ACT(m:fac+1,'Importe')
ACT(n:fac  ,'Status')
SetFont(a:fac..n:fac+1,2)
AlinearCeldas(a:fac..n:fac+1,'C')
AlinearCeldas(e:fac..m:fac,'I')
AgregarMarco(a:fac..d:fac+1,0,0,Exe('COLOR6'))
AgregarMarco(e:fac..g:fac+1,0,0,Exe('COLOR6'))
AgregarMarco(h:fac..j:fac+1,0,0,Exe('COLOR6'))
AgregarMarco(k:fac..m:fac+1,0,0,Exe('COLOR6'))
AgregarMarco(n:fac..n:fac+1,0,0,Exe('COLOR6'))

ifa
ACT(z:1,'')
ACN(z:2,0)
ACN(z:3,0)

SQL.ADD(" select DISTINCT T.Cliente1, C.RazonSocial, T.NrTrans, T.Fecha1, T.Fecha2, T.Especie, ")
SQL.ADD(" E1.Nombre NomEsp, CU.Cantidad4 Cantidad1, CU.Especie1, E2.Nombre NomEsp1, CU.Cantidad1 Cantidad2, T.Especie2, ")
SQL.ADD(" E3.Nombre NomEsp2, T.Cantidad3, T.Cambio4, CU.Cantidad2 Cambio2, CU.Cantidad3 Cambio3 ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E2, ")
SQL.ADD(" "~DBO~".ESPECIES E3, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS B, "~DBO~".CUOTAS CU ")
SQL.ADD(" where T.TipoTr2   = 'CANJE' ")
SQL.ADD(" AND B.NrOperacion = T.NrTrans ")
SQL.ADD(" AND  CU.NrOperacion = T.NrTrans ")
SQL.ADD(" AND B.NrBit <> 40 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" and T.Especie   = E1.Codigo ")
SQL.ADD(" and CU.Especie1 = E2.Codigo ")
SQL.ADD(" and T.Especie2  = E3.Codigo ")
SQL.ADD(" and T.Cliente1  = C.Codigo ")
If Dialogo.Check1=0
  SQL.ADD(" and T.Cliente1 <> '"~Dialogo.Vehiculo1~"' ")
Endif
If NoVacio(Dialogo.Fecha3)
  SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Dialogo.Fecha1) )
Endif
If NoVacio(Dialogo.Fecha4)
  SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha2) )
Endif
If NoVacio(Dialogo.Fecha1)
  SQL.ADD("  and  T.Fecha2    >= "~IdxDate2(Dialogo.Fecha3) )
Endif
If NoVacio(Dialogo.Fecha2)
  SQL.ADD("  and  T.Fecha2    <= "~IdxDate2(Dialogo.Fecha4) )
Endif
If NoVacio(Dialogo.Especie1)
  SQL.ADD("  and  T.Especie    = '"~Dialogo.Especie1~"' ")
Endif
If NoVacio(Dialogo.CLiente1)
  SQL.ADD("  and  T.Cliente1   = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.Mercado1)
  SQL.ADD("  and  T.Mercado1   = '"~Dialogo.Mercado1~"' ")
Endif
SQL.ADD("  and  T.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
** FJL 10/08/22 - No mostrar transacciones saldos Parking
SQL.ADD("  and  Cambio5 not in ("~Pipe2Comillas(Val(w:1))~") ")
SQL.ADD(" order by T.Cliente1, T.NrTrans ")
watch(sql.batch)
Recorrer SQL
 If not EqStr(fbn('NrTrans'),Val(ta:1)) 
   message(fbn('RazonSocial')~' - '~fbn('NrTrans'))

   ACT(a:fac, fbn('RazonSocial'))
   ACT(b:fac, fbn('NrTrans'))
   ACLT(b:fac, fbn('NrTrans'))
   ACT(c:fac, fbn('Fecha1'))
   ACT(d:fac, fbn('Fecha2'))
   AlinearCeldas(c:fac..d:fac,'C')
   ACT(e:fac, fbn('NomEsp'))
   ACT(ta:1, fbn('NrTrans'))
 Endif

 ACN(f:fac, fbn('Cantidad1'))
 ACN(g:fac, fbn('Cambio2'))
 ACN(h:fac, fbn('Cambio3'))
 FormatoCeldas(f:fac..h:fac,Exe('F0'))

 ACT(i:fac, fbn('NomEsp1'))
 ACN(j:fac, fbn('Cantidad2'))
 FormatoCeldas(j:fac,Exe('F0'))

 ACT(k:fac, fbn('NomEsp2'))
 ACN(l:fac, fbn('Cambio4'))
 FormatoCeldas(l:fac,Exe('F7'))

 ACN(m:fac, fbn('Cantidad3'))
 FormatoCeldas(m:fac,Exe('F2'))
 If Num(SQL("select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~fbn('NrTrans')~"' ")) = 0
   ACT(n:fac,'Pendiente')
 Else
   ACT(n:fac,'Confirmado')
 Endif
 SetFont(a:fac..n:fac,4)

 If NoVacio(Dialogo.Especie1)
   ACT(aa:2,fbn('NomEsp'))
   SCN( z:2,fbn('Cantidad1'))
   ACT(aa:3,fbn('NomEsp2'))
   SCN( z:3,fbn('Cantidad3'))
 Endif
Proximo

If NoVacio(Dialogo.Especie1)
  ifa
  ACT(e:fac,Val(aa:2))
  ACN(f:fac,Val(z:2))
  FormatoCeldas(f:fac,Exe('F0'))
  ACT(k:fac,Val(aa:3))
  ACN(m:fac,Val(z:3))
  FormatoCeldas(m:fac,Exe('F2'))
  SetFont(a:fac..n:fac,2)
  AgregarMarco(e:fac..g:fac,0,0,Exe('COLOR6'))
  AgregarMarco(k:fac..m:fac,0,0,Exe('COLOR6'))
Endif

Impresion(1,2)
Impresion(2,1)
Impresion(3,0)
Impresion(4,1)
SetPrintFit(3,75)
SetMargins(0,0,0,2)

LimitesVision(n:fac+2)

