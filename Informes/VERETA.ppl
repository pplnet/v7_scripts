CrearDialogo
  Radio1       : 'Tipo|Reales|Simuladas' ;1;1;;NO;NO;;;;1;;;
  Entero1      : 'Dias+'                 ;2;1;;NO;NO;;;;Dialogo.Radio1+1;Dialogo.Radio1+1;;
  Fecha1       : "Fecha Vigencia"        ;1;1;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1<=Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  NrOperacion1 : "Operacion"             ;;;;;;
  Radio2       : 'Recalcula|NO|SI'       ;;;;;;;;;0;;;
  Radio3       : 'Actualiza|NO|SI'       ;;;;;;;;;1;;;
  Lista2       : 'Tipo Op.'              ;5;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' or Codigo In ('DTSFVM','DTSVVM','DTSVV','DTSFV','DTCAP','DTFLO') ");
  Lista1       : "Vehiculo"              ;-1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")); 
FinDialogo

If Not Ok
   Cancelar
Endif

*- fa5: Ultimo dia en que ejecute el Informe
ACD(fa5,HABILES(Dialogo.Fecha1,-1,VAR('FERIADODEF'),SI) )

*- fa6: Dia Siguiente que tendria que haberlo Ejecutado
ACD(fa6,Habiles(VAL(fa5),1,,SI) )

Recorrer&j val(fa6),Dialogo.Fecha1

   If DiaSem(&j)<>1 y DiaSem(&j)<>7
      ACD(fe2,Habiles(&j,Dialogo.Entero1,,SI))      
      ACD(fe4,Habiles(&j,Dialogo.Entero1,,SI))
      ACD(fe3,Habiles(&j,Dialogo.Entero1,,SI)+Dialogo.Entero1 )
      ACD(fe5,Habiles(&j,Dialogo.Entero1,,SI)+Dialogo.Entero1 )

      If DiaSem(&j)=5
         *- Jueves => Resetea Sabado, Domingo y Lunes
         ACD(fe2,Habiles(&j,Dialogo.Entero1,,NO))    
         ACD(fe3,Habiles(&j,Dialogo.Entero1,,NO)+Dialogo.Entero1 )  
      EndIf

      If SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='REPTAS' and Extension='"~Dialogo.Radio1~Dialogo.Entero1~Dialogo.Fecha1~Dialogo.NrOperacion1~Dialogo.Radio2~Dialogo.Radio3~Dialogo.Lista2~Dialogo.Lista1~"' ")=0
         Cancelar('No existe el reporte solicitado')
      Else
         acd(di1,&j)
         LeerPMG('REPTAS', Dialogo.Radio1~Dialogo.Entero1~val(di1)~Dialogo.NrOperacion1~Dialogo.Radio2~Dialogo.Radio3~Dialogo.Lista2~Dialogo.Lista1)
      Endif
   EndIf
Proximo 

Impresion(1,2)
*LimitesVision(val(b:200)+2:130)


