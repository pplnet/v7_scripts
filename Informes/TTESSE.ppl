ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1 : "Vehiculo"                          ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1    : "Fecha"                             ;  ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Mercado1  : "Ubicacion"                         ;  ; ;;;;Vacio(Dialogo.MERCADO1) o [NoVacio(Dialogo.MERCADO1) y NoVacio(BuscarCampo('Mercados','Codigo','Codigo',Dialogo.MERCADO1))];'Error en Ubicacion';NO;;;
  Radio2    : "Moneda|Pesos|Dolares"              ;  ; ;;;;;;;0;
  Lista1    : "Especies"                          ;  ; ;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");
FinDialogo
IF Not Ok
  Cancelar
ENDIF


IF Vacio(Dialogo.Lista1) 
   IF MessageBox('Selecciona todas las Especies, #Continua?',0,2) = 7
      Cancelar
   ENDIF
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT S1.Especie, E.Nombre, E.CodAlfCajaValores, E.Cedel, E.EuroClear, S1.Mercado, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, M.Descripcion DescMerc, ")
SQL.ADD("       SUM(S1.Saldo) Saldo, E.InteresesC, S1.Cupon ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK INDEX=INDSALDIA2), "~DBO~".ESPECIES E WITH (NOLOCK), "~DBO~".MERCADOS M WITH (NOLOCK) ")
SQL.ADD("WHERE E.Codigo = S1.Especie AND ")
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
SQL.ADD("      (S1.NrSaldo> 201 or S1.NrSaldo=101) AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Mercado = M.Codigo AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK INDEX=INDSALDIA2) ")
SQL.ADD("                  WHERE ")
SQL.ADD("                        S2.Cliente = S1.Cliente                   AND ")
SQL.ADD("                        S2.Especie = S1.Especie                   AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia         AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado                   AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta                     AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo)                      ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre, E.CodAlfCajaValores, E.Cedel, E.EuroClear, S1.Mercado, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, M.Descripcion, E.InteresesC, S1.Cupon ")
SQL.ADD("ORDER BY S1.Especie, S1.Cupon, S1.Mercado")

ACT(c1, 'Saldos Totales de Especie por Ubicacion')
ACD(c2, Dialogo.Fecha1)
SetFont(c1..c2,3)
AlinearCeldas(c1..c2,'C')

ACT(e4, 'Fecha: '~Var('FECHASYS'))
ACT(a5, 'Moneda: '~IIF(Dialogo.Radio2=0, 'Pesos','Dolares'))
IF NoVacio(Dialogo.Vehiculo1)
   ACT(a6, 'Vehiculo: '~Dialogo.Vehiculo1)
ENDIF
IF NoVacio(Dialogo.Mercado1)
   ACT(c6, 'Ubicacion: '~Dialogo.Mercado1)
ENDIF
IF NoVacio(Dialogo.Lista1)
   ACT(a7, 'Especies: '~Dialogo.Lista1)
ENDIF

SetFont(a4..e7,2)

ACT(a:8, 'Especie')
ACT(b:8, 'Cupon')
ACT(c:8, 'Ubicacion')
ACT(d:8, 'V.N.')
ACT(e:8, 'V.R.')
ACT(f:8, 'Valuacion')

SetFont(a:8..f:8,2)
AlinearCeldas(a:8..f:8,'C')
AgregarMarco(a:8..f:8,2,2,Exe('COLOR'))


* Variable Especie
ACT(az2, '')

* Acumulador Especie VN
ACN(ay2, 0)

* Acumulador Especie VR
ACN(ax2, 0)

* Acumulador General Valuacion
ACN(aw1, 0)
* Acumulador Especie Valuacion
ACN(aw2, 0)

ACN(fi1, 9)
SetFilaActual(Val(fi1)-1)
Recorrer SQL
   IF FBN['Saldo']<>0

   IF Not EqStr(FBN['Especie']~FBN['Cupon'], Val(az2))
      IF Val(ay2) <> 0
         ACT(c:fac, 'Total Especie --->')
         ACN(d:fac, Val(ay2))
         ACN(e:fac, Val(ax2))
         ACN(f:fac, Val(aw2))
         SetFont(c:fac..f:fac,2)
         ACN(ax2, 0)
         ACN(ay2, 0)
         ACN(aw2, 0)
         SetFilaActual(fac+2)
      ENDIF

      IF EqStr(FBN['Mercado'],'CV')
         ACT(me1, FBN['CodAlfCajaValores'])
      ELSE
         IF EqStr(FBN['Mercado'],'EU')
            ACT(me1, FBN['EuroClear'])
         ELSE
            IF EqStr(FBN['Mercado'],'CE')
               ACT(me1, FBN['Cedel'])
            ELSE
               ACT(me1, FBN['CodAlfCajaValores'])
            ENDIF
         ENDIF
      ENDIF
      ACT(a:fac, FBN['Especie']~' - '~Val(me1)~' - '~FBN['Nombre'])
      ACT(b:fac, FBN['Cupon'])
      ACT(az2, FBN['Especie']~FBN['Cupon'])
      ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
   ENDIF
   ACT(c:fac, FBN['DescMerc'])
   ACN(d:fac, FBN['Saldo'])

   * (yu:fac..yz:fac)parametros para la funcion INTERESCLE 
   ACN(yt1, fac)
   ACD(yu:fac, Dialogo.Fecha1)
   ACT(yv:fac, FBN['Especie'])
   ACN(yw:fac, FBN['Saldo'])
   ACD(yx:fac, FBN['FechaCambioTasa'])
   ACN(yy:fac, FBN['TasaIntAnterior'])
   ACN(yz:fac, FBN['TasaIntVigente'])
   (.'INTERESCLE'.)
   ACN(ca:fac, Val(zz:fac))
   ACN(cc:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
   IF Dialogo.Radio2 = 0
      ACN(cd:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   ELSE
      ACN(cd:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   ENDIF

   ACN(e:fac, Val(d:fac)*Val(cc:fac))

   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(f:fac, Val(e:fac)*Val(cd:fac)+(Val(ca:fac)*Val(cd:fac)))
      ELSE
         ACN(f:fac, Val(e:fac)*Val(cd:fac)+Val(ca:fac))
      ENDIF
   ELSE
      ACN(f:fac, Val(d:fac)*Val(cd:fac)+Val(ca:fac))
   ENDIF

   ACT(az4, FBN['Cupon'])
   SCN(ay2, Val(d:fac))
   SCN(ax2, Val(e:fac))
   SCN(aw2, Val(f:fac))
   SCN(aw1, Val(f:fac))
   SetFont(a:fac..c:fac,2)
   Else
     dfa
   EndIf
Proximo

IF Val(ay2) <> 0
   ifa
   ACT(c:fac, 'Total Especie --->')
   ACN(d:fac, Val(ay2))
   ACN(e:fac, Val(ax2))
   ACN(f:fac, Val(aw2))
   SetFont(c:fac..f:fac,2)
   SetfilaActual(fac+2)

   ACT(c:fac, 'Total Valuacion --->')
   ACN(f:fac, Val(aw1))
   SetFont(c:fac..f:fac,2)
   SetfilaActual(fac+2)
ENDIF

FormatoCeldas(e:Val(fi1)..e:fac,Exe('F8'))


SetfilaActual(fac+4)
ACT(a:fac, 'Fin del Listado')
SetFont(a:fac,2)

ACO(1,25)
ACO(2,5)
ACO(3,17)
ACO(4,10)
ACO(5,10)
ACO(6,10)

FijarFila(Val(fi1))

LimitesVision(f:fac+1)
SetPrintFit(3,93)
RangoTitulo(a:1..f:fac, 8)