ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1    : "Vehiculo"     ;;;;;;;;;
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")


SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Fecha(FSys))
SetFont(g:2..g:2,1)

ACT(a:FAC, "# Regist. Contable - Movimientos Liquidados")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)


  if NoVacio(Dialogo.Vehiculo1)
    ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
  else
    ACT(a:FAC+1, 'Vehiculo : Todos')
  endif
  ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
  ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)


SetFilaActual(FAC+5)

ACT(a:FAC, 'Tipo Op.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'F.Operacion')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio / Tasa N.A.')

ACT(c:FAC+1, 'F.Ejecucion')
ACT(d:FAC+1, 'F.Mov.')
ACT(e:FAC+1, 'Cliente Afectado')
ACT(f:FAC+1, 'Especie Afectada')
ACT(g:FAC+1, 'Cantidad')
ACT(h:FAC+1, 'Leyenda')
ACT(i:FAC+1, 'Saldo')
ACT(j:FAC+1, 'Cuenta')
ACT(k:FAC+1, 'Transaccion')
ACT(l:FAC+1, 'Nr.Comp.')
ACT(m:FAC+1, 'Nr.Trans.')
ACT(n:FAC+1, 'F.Trans.')
ACT(o:FAC+1, 'Nr.Mov.')
ACT(p:FAC+1, 'F.Interf.')
ACT(q:FAC+1, 'Nro.Env.')
ACT(r:FAC+1, 'Origen')
ACT(s:FAC+1, 'Instante')
ACT(t:FAC+1, 'SubInst')
ACT(u:FAC+1, 'F.Anul')

AlinearCeldas(a:FAC+1..f:FAC+1,'I')
AlinearCeldas(g:FAC+1..g:FAC+1,'D')
AlinearCeldas(h:FAC+1..l:FAC+1,'I')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
SetFont(a:Val(w1)..z:FAC+1,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))
AgregarMarco(b:FAC+1..u:FAC+1,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)


SQL.ADD("select  T.TipoTr2, T.NrTrans,  ") 
SQL.ADD("T.Cuenta1, T.Cuenta2, T.Cuenta5, T.Cantidad1,  ") 
SQL.ADD("T.Fecha1, T.Fecha2, T.Ley1,   ") 
SQL.ADD("T.FechaConfir, T.NrOperacionRef1, T.Cupon1, T.Cupon2,  ") 
SQL.ADD("T.Cuenta6, ")  

SQL.ADD("O.TipoOp, O.Nroperacion, O.FechaOp,  O.FechaVto,  O.Cliente1,   ")  
SQL.ADD("O.Especie,  O.Cantidad,  O.Precio1,  O.Vehiculo1,    ")  
SQL.ADD("O.PrecioEj,  O.FechaEj  ")  

SQL.ADD("from "~DBO~".TRANSACCIONES2 T , "~DBO~".OPERACIONES O ")  
SQL.ADD("where T.fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")  
SQL.ADD("  and T.NrOperacionref1 = O.NrOperacion ")  

if NoVacio(Dialogo.Vehiculo1)
     SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
endif


SQL.ADD("order by O.Nroperacion ")  

ACT(Z4, '0')

Recorrer SQL
    Message('Recuperando Datos Operacion ...')
    
 if eqstr(val(Z4),FBN['NrOperacion'])
 Else
 

    ACT(Z4, FBN['NrOperacion'])

    IF Not EqStr(FBN['NrOperacion'],Val(z1))
       ifa
       ACT(z1, FBN['NrOperacion'])
       ACT(a:FAC, FBN['TipoOp'])
       ACT(b:FAC, FBN['NrOperacion'])
       ACLO(b:FAC, fbn('NrOperacion'))
       ACD(c:FAC, FBN['FechaOp'])
       ACT(d:FAC, fbn('Vehiculo1'))
       ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
       ACT(f:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
       ACN(g:FAC, FBN['Cantidad'])
       ACN(h:FAC, FBN['Precio1'])
       ACN(z2,SQL("Select NrBit from "~DBO~".OPERACIONESBITS where nroperacion ='"~FBN['Nroperacion']~"' and valor = '1' "))
       ACT(z3,SQL("Select Nombre from "~DBO~".Instancias     where NrInstancia = "~val(z2)))
       ACT(j:fac,val(z3))

       SetFont(a:FAC..y:FAC,2)
       ifa
    endif

    Message('Recuperando Mov. Ejecutados  ...')

        SQL.ADD("select  T.TipoTr2, T.NrTrans,  ") 
        SQL.ADD("T.Cuenta1, T.Cuenta2, T.Cuenta5, T.Cantidad1,  ") 
        SQL.ADD("T.Fecha1, T.Fecha2, T.Fey1,   ") 
        SQL.ADD("T.FechaConfir, T.Nroperacionref1, T.Cupon1, T.Cupon2,  ") 
        SQL.ADD("T.Cuenta6, ")  

        SQL.ADD("O.TipoOp, O.Nroperacion, O.FechaOp,  O.FechaVto,  O.Cliente1,   ")  
        SQL.ADD("O.Especie,  O.Cantidad,  O.Precio1,  O.Vehiculo1,  M.NrOperacion,   ")  
        SQL.ADD("M.Cliente,  M.FechaMov,  M.FechaEje,  M.Especie esp,  M.Leyenda,   ")  
        SQL.ADD("M.NrSaldo,  M.Cuenta,  M.Transaccion,  M.NrComprob,  'EJEC' est,   ")  
        SQL.ADD("M.Cantidad can,  O.PrecioEj,  O.FechaEj,  M.PrecioEj pe,  M.FechaEj fe,   ")  
        SQL.ADD("M.NrMov, X.FechaProceso,  X.NrEnvio,  X.Origen,  X.Instante,  X.Subinstante,  X.FechaAnulada   ") 

        SQL.ADD("from "~DBO~".TRANSACCIONES2 T , "~DBO~".MOVEJECUTADOS M   , "~DBO~".MOVIMIENTOS X, "~DBO~".OPERACIONES O ")  
        SQL.ADD("where   ")  
        SQL.ADD("      T.NrTrans = M.Nrtrans2 (+) ")  
        SQL.ADD("  and T.Nroperacionref1 = O.NrOperacion ")  
        SQL.ADD("  and O.NrOperacion = '"~fbn['NrOperacion']~"' ")
        SQL.ADD("  and O.NrOperacion = M.NrOperacion  ")  
        SQL.ADD("  and (M.NrOperacion = X.NrOperacion (+) and M.NrMov = X.Movimiento_Numero (+))    ")  

        if NoVacio(Dialogo.Vehiculo1)
            SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
        endif


        SQL.ADD("order by T.nrOperacionref1, T.Fecha1 ")  


    Recorrer SQL
       ACT(b:FAC, FBN['est'])
       ACD(c:FAC, FBN['FechaEje'])
       ACD(d:FAC, FBN['FechaMov'])
       ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

       if Vacio(Val(e:FAC))
          ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
       endif

       ACT(f:FAC, FBN['Esp']~' '~FBN['fe']~' '~FBN['pe'])
       ACN(g:FAC, FBN['Can'])
       ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
       ACN(i:FAC, FBN['NrSaldo'])
       ACT(j:FAC, FBN['Cuenta'])
       ACT(k:FAC, FBN['Transaccion'])
       ACT(l:FAC, FBN['NrComprob'])
       ACT(m:FAC, FBN['NrTrans'])
       ACLT(m:FAC, FBN['NrTrans'])
       ACD(n:FAC, FBN['Fecha1'])
       ACT(o:FAC, FBN['NrMov'])
       ACT(p:FAC, FBN['FechaProceso'])
       ACT(q:FAC, FBN['Nrenvio'])
       ACT(r:FAC, FBN['Origen'])
       ACT(s:FAC, FBN['Instante'])
       ACT(t:FAC, FBN['Subinstante'])
       ACT(u:FAC, FBN['Fechaanulada'])

       SetFont(a:FAC..z:FAC,1)

       IF EqStr(FBN['est'],'PEND')
          ColorCeldas(a:FAC..L:FAC,clGREEN)
      endif 
      FormatoCeldas(i:fac..i:fac,"0")
   proximo

   Message('Recuperando Mov. Pendientes  ...')

   SQL.ADD("SELECT  O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1, ")
   SQL.ADD("O.Especie, O.Cantidad, O.Precio1, O.Vehiculo1, E.NrOperacion, ")
   SQL.ADD("E.Cliente, E.FechaMov, E.FechaEje, E.Especie esp, E.Leyenda, ")
   SQL.ADD("E.NrSaldo, E.Cuenta, E.Transaccion, E.NrComprob, 'PEND' est, ")
   SQL.ADD("E.Cantidad can, O.PrecioEj, O.FechaEj, E.PrecioEj pe, E.FechaEj fe, ")  
   SQL.ADD("NrTrans2, E.NrMov ")  
   SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES E ")
   SQL.ADD("where O.NrOperacion = E.NrOperacion ")
   SQL.ADD("and O.NrOperacion = '"~fbn['NrOperacion']~"' ")
   SQL.ADD("order by O.TipoOp, O.NrOperacion, NrMov,est  ")

   Recorrer SQL
       ACT(b:FAC, FBN['est'])
       ACD(c:FAC, FBN['FechaEje'])
       ACD(d:FAC, FBN['FechaMov'])
       ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

       if Vacio(Val(e:FAC))
          ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
       endif

       ACT(f:FAC, FBN['Esp']~' '~FBN['fe']~' '~FBN['pe'])
       ACN(g:FAC, FBN['Can'])
       ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
       ACN(i:FAC, FBN['NrSaldo'])
       ACT(j:FAC, FBN['Cuenta'])
       ACT(k:FAC, FBN['Transaccion'])
       ACT(l:FAC, FBN['NrComprob'])
       ACT(m:FAC, FBN['NrTrans2'])
       ACLT(m:FAC, FBN['NrTrans2'])
       ACT(o:FAC, FBN['NrMov'])

       SetFont(a:FAC..z:FAC,1)
       IF EqStr(FBN['est'],'PEND')
          ColorCeldas(a:FAC..L:FAC,clGREEN)
      endif 
      FormatoCeldas(i:fac..i:fac,"0")
   proximo
    
   Message('Recuperando Mov. Posiciones  ...')

   SQL.ADD("SELECT  O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1, ")
   SQL.ADD("O.Especie, O.Cantidad, O.Precio1, O.Vehiculo1, P.NrOperacion, ")
   SQL.ADD("P.Cliente, P.FechaMov, P.FechaEj as FechaEje, P.Especie esp, TipoNegocio as Leyenda, ")
   SQL.ADD("P.NrSaldo, ' ' as Cuenta, ' ' as Transaccion, 0 as NrComprob, 'POSI' est, ")
   SQL.ADD("P.Cantidad can, O.PrecioEj, O.FechaEj, P.Precio pe, P.FechaEj fe, ")  
   SQL.ADD("' ' as NrTrans2, 999 NrMov ")  
   SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPOSEJE P ")
   SQL.ADD("where O.NrOperacion = P.NrOperacion ")
   SQL.ADD("and O.NrOperacion = '"~fbn['NrOperacion']~"' ")
   SQL.ADD("order by O.TipoOp, O.NrOperacion, NrMov,est  ")

   Recorrer SQL
       ACT(b:FAC, FBN['est'])
       ACD(c:FAC, FBN['FechaEje'])
       ACD(d:FAC, FBN['FechaMov'])
       ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

       if Vacio(Val(e:FAC))
          ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
       endif

       ACT(f:FAC, FBN['Esp']~' '~FBN['fe']~' '~FBN['pe'])
       ACN(g:FAC, FBN['Can'])
       ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
       ACN(i:FAC, FBN['NrSaldo'])
       ACT(j:FAC, FBN['Cuenta'])
       ACT(k:FAC, FBN['Transaccion'])
       ACT(l:FAC, FBN['NrComprob'])
       ACT(m:FAC, FBN['NrTrans2'])
       ACLT(m:FAC, FBN['NrTrans2'])
       ACT(o:FAC, FBN['NrMov'])

       SetFont(a:FAC..z:FAC,1)

       IF EqStr(FBN['est'],'PEND')
          ColorCeldas(a:FAC..L:FAC,clGREEN)
      endif 
      FormatoCeldas(i:fac..i:fac,"0")
   proximo

   Message('Recuperando Mov. Ajsutes  ...')

   SQL.ADD("SELECT  O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1, ")
   SQL.ADD("O.Especie, O.Cantidad, O.Precio1, O.Vehiculo1, M.NrOperacion, ")
   SQL.ADD("M.Cliente, M.FechaGen FechaMov, M.FechaValor as FechaEje, M.Especie esp, ' ' as Leyenda, ")
   SQL.ADD("0 NrSaldo, '' as Cuenta, '' as Transaccion, 0 as NrComprob, 'MAJUSTE' est, ")
   SQL.ADD("M.Cantidad can, O.PrecioEj, O.FechaEj, 0 pe, M.FechaValor  fe, ")  
   SQL.ADD("'' as NrTrans2, NrMov ")  
   SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVAJUSTE M ")
   SQL.ADD("where O.NrOperacion = M.NrOperacion ")
   SQL.ADD("and O.NrOperacion = '"~fbn['NrOperacion']~"' ")
   SQL.ADD("order by O.TipoOp, O.NrOperacion, NrMov,est  ")

    Recorrer SQL
       ACT(b:FAC, FBN['est'])
       ACD(c:FAC, FBN['FechaEje'])
       ACD(d:FAC, FBN['FechaMov'])
       ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

       if Vacio(Val(e:FAC))
          ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
       endif

       ACT(f:FAC, FBN['Esp']~' '~FBN['fe']~' '~FBN['pe'])
       ACN(g:FAC, FBN['Can'])
       ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
       ACN(i:FAC, FBN['NrSaldo'])
       ACT(o:FAC, FBN['NrMov'])

       SetFont(a:FAC..z:FAC,1)

       IF EqStr(FBN['est'],'PEND')
          ColorCeldas(a:FAC..L:FAC,clGREEN)
      endif 
      FormatoCeldas(i:fac..i:fac,"0")
   proximo

 Endif
Proximo

ACO(1,5)
ACO(2,6)
