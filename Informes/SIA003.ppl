ACO(13,7)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(u:FAC)
RangoTitulo(a:1..u:FAC, Val(w1)+3)
