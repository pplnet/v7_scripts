IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  #ifdef STD_CORP
    Radio4: 'Valuacion|Oficial|USD Alternativo' ;1;2;;;;;;;0;;;
  #endif
  Fecha1: 'Fecha'                ;1;1;;;;;;;FSys
  Lista1: 'Vehiculo'             ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Radio1: 'Consolidado Book|SI|NO'    ;;;;;;;;;0;;
  Radio2: 'Expresado en|ARP|USD' ;;;;;;;;;0
  Radio3: 'Expresado en|Millones|ImporteOri';;;;SI;SI;;;;0;;;;;
  Check1: 'Ejec.Auto.'    ;;;;;NO;;;;0;0;
FinDialogo

IF Not OK
  Cancelar
ENDIF

If Dialogo.Check1=1
    HojaVisible(NO)
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

let &FechaTC Dialogo.Fecha1-1
@VARTIPOCAM

IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF
**Para funcion TIPOCAMBIO
let &monedaTC1 &monedaInforme

SetFilaActual(1)

******FECHA DE POSICIONES*******
*Si la fecha es un sábado, se elige el viernes anterior
If DiaSem(Dialogo.Fecha1) = 7 
    let &fechaPosiciones2 Dialogo.Fecha1-1
else
    *Si la fecha es un domingo, se elige el viernes anterior
    If DiaSem(Dialogo.Fecha1) = 1 
        let &fechaPosiciones2 Dialogo.Fecha1-2
    else
        *sino, se deja la fecha del diálogo
        let &fechaPosiciones2 Dialogo.Fecha1
    Endif
Endif
********************************************

If Dialogo.Check1=0
    let &filaLogo 1
    @LOGO
Endif

ifa
ifa
ifa
ACT(F:1, 'Informe de POSICIONES')
SetFont(F:1, 3)
SetFilaActual(fac+2)
Let &fi1 fac
ACT(A:fac, 'Fecha: ')
ACT(B:fac,Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Lista1)
    ACT(A:fac, 'Vehiculos: '~Dialogo.Lista1)
    ACT(LS:1, Dialogo.Lista1)
ELSE
    ACT(A:fac, 'Vehiculos: '~Val(LS:1))
ENDIF
ifa
IF Dialogo.Radio1 = 0
    ACT(A:fac, 'Consolidado: SI')
ELSE
    ACT(A:fac, 'Consolidado: NO')
ENDIF
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: ARP')
    ACT(MN:1, '$')
ELSE
    ACT(A:fac, 'Expresado en: USD')
    ACT(MN:1, 'U$S')
ENDIF
SetFont(A:&fi1..A:fac, 2)
ifa
ACT(A:fac, 'TC Divisa:')
ACN(B:fac, &cotDolDivisa)
ifa
ACT(A:fac, 'TC Billete:')
ACN(B:fac, &cotDolBillete)
FormatoCeldas(B:fac-1..B:fac, Exe('F8'))
ifa
IF Dialogo.Radio3 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF
ifa
#ifdef STD_CORP
    ACT(A:fac, 'Valuacion: ')
    IF Dialogo.Radio4 = 0
        ACT(B:fac, 'Oficial')
        ifa
        ACT(A:fac, 'BNA')
        ACN(B:fac, &cotDolDivisa)
    ELSE
        ACT(B:fac, 'Alternativo')
        ifa
        ACT(A:fac, 'USMEP')
        ACN(B:fac, CotizacionBNA('USMEP',Dialogo.Fecha1-1,1,NO,NO))
        ifa
        ACT(A:fac, 'USCCL')
        ACN(B:fac, CotizacionBNA('USCCL',Dialogo.Fecha1-1,1,NO,NO))
    ENDIF
#endif
SetFont(A:&fi1..B:fac, 2)
FormatoCeldas(B:fac-1..B:fac, Exe('F8'))
SetFilaActual(fac+2)
*ACT(C:fac, '                TOTAL '~Val(MN:1))
ACT(B:fac, 'TOTAL '~Val(MN:1))
AlinearCeldas(B:fac, 'D')
SetFont(B:fac, 2)
AgregarMarco(A:fac..X:fac, 0, 0, Exe('COLOR8'))
let &filaTotales fac
ifa
ACT(C:fac, '               Vehiculos Activos')
ACT(J:fac, 'A LA VISTA')
ACT(P:fac, 'INVERTIDO')
let &fi1 fac
AgregarMarco(A:fac..X:fac, 0, 0, Exe('COLOR'))
ifa
ACT(A:fac, 'Vehiculo')
ACT(B:fac, 'CUIT')
ACT(E:fac, 'CC ARP')
ACT(F:fac, 'CC USD')
ACT(G:fac, 'Op. a Liq. ARP')
ACT(H:fac, 'Op. a Liq. USD')

ACT(I:fac, 'Cta Comitente ARP')
ACT(J:fac, 'Cta Comitente USD')
ACT(K:fac, 'Saldos Inmovilizados ARP')
ACT(L:fac, 'Saldos Inmovilizados USD')
ACT(M:fac, 'Total a la vista ARP')
ACT(N:fac, 'Total a la vista USD')

ACT(O:fac, 'Remuneradas')
ACT(P:fac, 'FCI')
ACT(Q:fac, 'PF')
ACT(R:fac, 'CAUCION')
ACT(S:fac, 'LETRAS')
ACT(T:fac, 'BONOS')
ACT(U:fac, 'ACCIONES') 
ACT(V:fac, 'ONs') 
ACT(W:fac, 'Total Invertido') 
ACT(X:fac, 'Total Cartera')  
AlinearCeldas(A:fac..X:fac,'C')
AgregarMarco(A:fac..X:fac, 0, 0, Exe('COLOR6'))
SetFont(A:fac-1..X:fac, 2)
Let &filaInicial fac+1
SQL.ADD(" Select V.Codigo Vehiculo, V.Descripcion, V.CUIT, B.Codigo Book ")
SQL.ADD(" From "~DBO~".VEHICULOS V, "~DBO~".BOOKS B ")
SQL.ADD(" Where V.Codigo = B.Vehiculo ")
SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" Order By 1, 4 ")
Recorrer SQL
    ***--Orderno todos los vehículos, books
    IF Dialogo.Radio1 = 0
        ***---Consolidado
        IF Not Eqstr(fbn('Vehiculo'), Val(VH:1))
            ACT(A:fac, fbn('Vehiculo'))
            ACT(B:fac, fbn('CUIT'))
            ACT(C:fac, fbn('Descripcion'))
        ELSE
            DFA
        ENDIF
    ELSE
        ***---NO Consolidado
        IF Not Eqstr(fbn('Vehiculo'), Val(VH:1))
            ACT(A:fac, fbn('Vehiculo'))
            ACT(B:fac, fbn('CUIT'))
            ACT(C:fac, fbn('Descripcion'))
            AgregarMarco(A:fac..X:fac, 0, 0)
            ifa
            ACT(D:fac, fbn('Book'))
        ELSE
            ACT(D:fac, fbn('Book'))
        ENDIF
    ENDIF
    ACT(VH:1, fbn('Vehiculo'))
Proximo
Let &filaFinal fac
***---Busco Informacion para completar el informe
***---Ctas a la vista
SQL.ADD(" Select S.SaldoContable/"~Fstr(&unidad, 0, 0)~" SaldoContable, C.Cliente Vehiculo, C.Alias1 BookCta, V.Alias5 BookDafult, C.Especies, S.NrCuenta ")
SQL.ADD(" From "~DBO~".SALDOSBANCARIOS S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where S.NrCuenta = C.Numero ")
SQL.ADD(" AND V.Codigo = C.Cliente ")
SQL.ADD(" AND S.FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND C.Cliente IN ("~Pipe2Comillas(Val(LS:1))~") ")
***---Watch(sql.Batch)
Recorrer SQL
    DFA
    let &vehiculoTC fbn('Vehiculo')
    @COTVEHIC
    
    let &monedaTC2 fbn('Especies')
    @TIPOCAMBIO
    
    let &saldoContable fbn('SaldoContable') * &tc
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            ***---Chequeo si la cta está remunerada
            let &bd1 0
            let &intRem 0
            SQL.ADD(" Select O.Book1, O.NrOperacion From "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C ")
            SQL.ADD(" Where C.Codigo = O.Cuenta1 ")
            SQL.ADD(" AND O.TipoOp = 'MMRPAC' ")
            SQL.ADD(" AND C.Numero = '"~fbn('NrCuenta')~"' ")
            SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
            SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
            Recorrer SQL
                DFA
                let &bookCta fbn('Book1')
                let &bd1 1
                **Se modifica para que levante MOVDEVENGADOS de las MMCCR asociadas a la MMRPAC en vez de los mov de la MMRPAC en si 110523
                SQL.ADD(" Select NrOperacion from "~DBO~".OPERACIONES Where OperacionRef='"~fbn('NrOperacion')~"' ")
                let &MMCCRAsociada ''
                Recorrer SQL
                DFA
                    let &MMCCRAsociada &MMCCRAsociada~fbn('NrOperacion')~'|'
                Proximo
                
                SQL.ADD(" Select Sum(Monto)/"~Fstr(&unidad, 0, 0)~" Monto From "~DBO~".MOVDEVENGADOS ")
                SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(&MMCCRAsociada)~") ")
                SQL.ADD(" AND NrSaldo = 140 ")
                SQL.ADD(" AND TipoDevengado = 'INTLEN' ")
                SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
                **
                Recorrer SQL
                    DFA
                    let &intRem &intRem + (fbn('Monto') * &tc)
                Proximo
            Proximo
            IF &bd1 = 0
                ***---Cta a la vista
                IF Incluido(&monedaLocal, fbn('Especies'))
                    SCN(E:&k, &saldoContable )
                    *Link a detalle vh
                    ACL(E:&k,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
                    let &totalCCARP &totalCCARP + &saldoContable
                    ***---sumo al total cartera de la fila
                    SCN(X:&k, &saldoContable)
                    let &totalCartera &totalCartera + &saldoContable
                    let &col 5
                      ***---sumo al total a la vista ARP de la fila
                    SCN(M:&k, &saldoContable)
                    let &totalVistaARP &totalVistaARP + &saldoContable
                ELSE
                    SCN(F:&k, &saldoContable)
                    *Link a detalle vh
                    ACL(F:&k,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)
                    let &totalCCUSD &totalCCUSD + &saldoContable
                    ***---sumo al total cartera de la fila
                    SCN(X:&k, &saldoContable)
                    let &totalCartera &totalCartera + &saldoContable
                    let &col 6
                     ***---sumo al total a la vista USD de la fila
                     SCN(N:&k, &saldoContable)
                     let &totalVistaUSD &totalVistaUSD + &saldoContable
                ENDIF
                ***---Si la cuenta tiene definido el book, tomamos ese, sino el book default del vehículo
                IF NoVacio(fbn('BookCta'))
                    let &bookCta fbn('BookCta')
                ELSE
                    let &bookCta fbn('BookDafult')
                ENDIF
            ELSE
                ***---Remunerada
                SCN(O:&k, &saldoContable + &intRem)
                **Detalle Remuneradas 
                ACL(O:&k,'POSREM',Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Lista1=FBN['Vehiculo'],Book1='')
                let &totalRem &totalRem + &saldoContable + &intRem
                ***---Sumo el Total Invertido y total cartera de la fila
                SCN(W:&k, &saldoContable + &intRem)
                SCN(X:&k, &saldoContable + &intRem)
                let &totalInvertido &totalInvertido + &saldoContable + &intRem
                let &totalCartera &totalCartera + &saldoContable + &intRem
                let &col 15
            ENDIF
            IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    *pinchaIF Not CeldaVacia(Val(D:&i))
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), &bookCta)
                            SCN(&col:&i, &saldoContable + &intRem)
                            If &col = 15
                                ACL(&col:&i,'POSREM',Fecha1=Dialogo.Fecha1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Lista1=FBN['Vehiculo'],Book1=&bookCta)
                                ***---Sumo el Total Invertido y total cartera de la fila
                                *Se pone acá para que se sume solo si va en la columna de inversiones
                                SCN(W:&i, &saldoContable + &intRem)
                                SCN(X:&i, &saldoContable + &intRem)
                            Else
                                If &col=6
                                    ACL(&col:&i,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)
                                Else
                                    ACL(&col:&i,'DECUAV',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
                                Endif
                            Endif
                            
                            
                            If &col=5
                                ***---Sumo el Total a la vista CC ARP             
                                SCN(M:&i, &saldoContable)
                                SCN(X:&i, &saldoContable)
                            Endif
                            If &col=6
                                ***---Sumo el total a la vista CC USD
                                SCN(N:&i, &saldoContable)
                                SCN(X:&i, &saldoContable)
                            Endif
                            
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
            ENDIF
        ELSE
        ENDIF
    Proximo
Proximo
***---Operaciones a Liquidar
*SQL.ADD(" Select M.Cantidad/"~Fstr(&unidad, 0, 0)~" Cantidad, M.Especie Moneda, M.Book, M.Cliente Vehiculo ")
*SQL.ADD(" From "~DBO~".MOVPENDIENTES M ")
*SQL.ADD(" Where M.FechaMov > '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" AND M.NrSaldo = 50 ")
*SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(M.Especie,'MONEDA') = 1 ")
*SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(LS:1))~") ")
*SQL.ADD(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(LS:1))~") ")
***---Tomamos Operaciones porque el reporte puede ejecutarse fecha valor, y los mov ya estar ejecutados
SQL.ADD(" Select O.TotalNetoCli1/"~Fstr(&unidad, 0, 0)~" Cantidad, O.ContraEspecie Moneda, O.Book1 Book, O.Vehiculo1 Vehiculo, O.TipoOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND O.TipoOp IN ('FCS','FCR','SECS','SEVS') ")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
Recorrer SQL
    DFA
    let &vehiculoTC fbn('Vehiculo')
    @COTVEHIC
    
    let &monedaTC2 fbn('Moneda')
    @TIPOCAMBIO
    
    IF Incluido(fbn('TipoOp'), 'FCR') O Incluido(fbn('TipoOp'), 'SEVS')
        let &movPte fbn('Cantidad') * &tc
    ELSE
        let &movPte (-fbn('Cantidad') * &tc)
    ENDIF
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            IF Eqstr(&monedaLocal, fbn('Moneda'))
                SCN(G:&k, &movPte)
                ACL(G:&k,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal)
                let &totalPteARP &totalPteARP + &movPte
                ***---sumo al total cartera de la fila
                SCN(X:&k, &movPte)
                let &totalCartera &totalCartera + &movPte
                let &col 7
                ***---sumo al total a la vista ARP de la fila
                SCN(M:&k, &movPte)
                let &totalVistaARP &totalVistaARP + &movPte
            ELSE
                SCN(H:&k, &movPte)
                ACL(H:&k,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr)                
                let &totalPteUSD &totalPteUSD + &movPte
                ***---sumo al total cartera de la fila
                SCN(X:&k, &movPte)
                let &totalCartera &totalCartera + &movPte
                let &col 8
                ***---sumo al total a la vista USD de la fila
                SCN(N:&k, &movPte)
                let &totalVistaUSD &totalVistaUSD + &movPte
            ENDIF
            IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book'))
                            SCN(&col:&i, &movPte)
                            If &col = 7
                                let &monedaDPOPLI &monedaLocal
                            Else
                                let &monedaDPOPLI &monedaExtr
                            Endif
                            ACL(&col:&i,'DPOPLI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaDPOPLI)                
                            ***---sumo al total cartera de la fila
                            SCN(X:&i, &movPte)
                            
                            If &col=7
                                ***---Sumo el Total a la vista Op. a liq. ARP   
                                SCN(M:&i, &movPte)
                            Endif
                            If &col=8
                                ***---Sumo el total a la vista Op. a liq. USD
                                SCN(N:&i, &movPte)
                            Endif
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
            ENDIF
        ENDIF
    Proximo
Proximo




***---Cta. Comitente ARP y USD + Saldos Inmovilizados ARP y USD
SQL.ADD("Select Round(S.Saldo/"~Fstr(&unidad, 0, 0)~", 2) Saldo,S.EnteCustodia as 'Vehiculo',C.Alias1 BookCta,")
SQL.ADD(" V.Alias5 BookDefault,S.Especie,S.Cuenta,C.TipoCuenta")
SQL.ADD(" From "~DBO~".SALDOSDIA S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where S.Cuenta = C.Codigo  and C.TipoCuenta IN ('CUS','INV') ")
SQL.ADD(" AND S.NrSaldo=50 ")
SQL.ADD(" AND S.Especie IN ('"~&monedaLocal~"','"~&monedaExtr~"')") 
SQL.ADD(" AND V.Codigo = C.Cliente ")
SQL.ADD(" AND S.EnteCustodia IN("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" AND S.Fecha = (Select Max(Fecha)FROM "~DBO~".SALDOSDIA ") 
SQL.ADD("                   WHERE  (Cuenta =S.Cuenta OR Cuenta='' or Cuenta =' ' or Cuenta is null)  ")
SQL.ADD("                   AND (Especie =S.Especie OR Especie='' or Especie =' ' or Especie is null)  ")
SQL.ADD("                   AND NrSaldo=50 ")
SQL.ADD("                   AND (EnteCustodia =S.EnteCustodia OR EnteCustodia='' or EnteCustodia =' ' or EnteCustodia is null) ")
SQL.ADD("                   AND Fecha  <= '"~IdxDate(Dialogo.Fecha1)~"' )")
SQL.ADD(" Order By C.TipoCuenta,S.Especie ")
Watch(sql.batch)
Recorrer SQL
    IF fbn('Saldo') <> 0
        DFA
        let &vehiculoTC fbn('Vehiculo')
        @COTVEHIC
        
        #ifdef STD_CORP
            IF Dialogo.Radio4 = 1 Y Eqstr(fbn('Especie'), &monedaExtr)
                ***---Hay que tomar TC Valuacion
                let &cotVehiculo CotizacionBNA('USMEP',Dialogo.Fecha1-1,1,NO,NO)
            ENDIF
        #endif

        let &monedaTC2 fbn('Especie')
        @TIPOCAMBIO 
        
        let &saldo fbn('Saldo') * &tc
        Recorrer&k &filaInicial, &filaFinal
            IF Eqstr(Val(A:&k), fbn('Vehiculo'))
                IF EqStr(FBN['TipoCuenta'],'CUS')
                    **CUENTA COMITENTE
                    IF Incluido(&monedaLocal, fbn('Especie'))
                        **COMITENTE ARP
                        SCN(I:&k, &saldo )
                        *Link a detalle vh
                        ACL(I:&k,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal,Radio3=0)
                        let &totalCtteARP &totalCtteARP + &saldo
                        let &col 9
                        ***---sumo al total a la vista ARP de la fila
                        SCN(M:&k, &saldo)
                        let &totalVistaARP &totalVistaARP + &saldo
                        ***---sumo al total cartera de la fila
                        SCN(X:&k, &saldo)
                        let &totalCartera &totalCartera + &saldo
                    ELSE
                        **COMITENTE USD
                        SCN(J:&k, &saldo)
                        *Link a detalle vh
                        ACL(J:&k,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr,Radio3=0)
                        let &totalCtteUSD &totalCtteUSD + &saldo
                        let &col 10
                        ***---sumo al total a la vista USD de la fila
                        SCN(N:&k, &saldo)
                        let &totalVistaUSD &totalVistaUSD + &saldo
                        ***---sumo al total cartera de la fila
                        SCN(X:&k, &saldo)
                        let &totalCartera &totalCartera + &saldo
                     ENDIF
                ELSE
                    **SALDOS INMOVILIZADOS
                    IF Incluido(&monedaLocal, fbn('Especie'))
                        **SALDOS INMOVILIZADOS ARP
                        SCN(K:&k, &saldo )
                        *Link a detalle vh
                        ACL(K:&k,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal,Radio3=1)
                        let &totalSalInmARP &totalSalInmARP + &saldo
                        let &col 11
                        ***---sumo al total a la vista ARP de la fila
                        SCN(M:&k, &saldo)
                        SCN(X:&k, &saldo)
                        let &totalVistaARP &totalVistaARP + &saldo
                        let &totalCartera &totalCartera + &saldo
                    ELSE
                        **SALDOS INMOVILIZADOS USD
                        SCN(L:&k, &saldo)
                        *Link a detalle vh
                        ACL(L:&k,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr,Radio3=1)
                        let &totalSalInmUSD &totalSalInmUSD + &saldo
                        let &col 12
                        ***---sumo al total a la vista USD de la fila
                        SCN(N:&k, &saldo)
                        SCN(X:&k, &saldo)
                        let &totalVistaUSD &totalVistaUSD + &saldo
                        let &totalCartera &totalCartera + &saldo
                    ENDIF
                ENDIF
                ***---Si la cuenta tiene definido el book, tomamos ese, sino el book default del vehículo
                IF NoVacio(fbn('BookCta'))
                    let &bookCta fbn('BookCta')
                ELSE
                    let &bookCta fbn('BookDefault')
                ENDIF
                **********************************
                **NO CONSOLIDADO
                **********************************************
                IF Dialogo.Radio1 = 1
                    ***---No Consolidado
                    Recorrer&i &k+1, &filaFinal
                        ***---Buscamos el book
                        IF NoVacio(Val(D:&i))
                            IF Eqstr(Val(D:&i), &bookCta)
                                SCN(&col:&i, &saldo)
                                **links a detalles
                                   If &col=9
                                       ACL(&col:&i,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal,Radio3=0)
                                   Else
                                       IF &col=10
                                           ACL(&col:&i,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr,Radio3=0)
                                       Else
                                            IF &col=11
                                                 ACL(&col:&i,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaLocal,Radio3=1)
                                            Else
                                               ACL(&col:&i,'DCTESI',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=fbn('Vehiculo'),Book1=&bookCta,Precio1 = &cotDolDivisa,Precio2=&cotDolBillete,String1=&monedaExtr,Radio3=1)
                                            Endif
                                       Endif
                                   Endif
                                   
                                If &col=9
                                    ***---Sumo el Total a la vista Cta. Comitente ARP   
                                    SCN(M:&i, &saldo)
                                    SCN(X:&i, &saldo)
                                Endif
                                If &col=10
                                    ***---Sumo el total a la vista Cta. Comitente USD
                                    SCN(N:&i, &saldo)
                                    SCN(X:&i, &saldo)
                                Endif
                                If &col=11
                                    ***---Sumo el Total a la vista Saldos Inmovilizados ARP   
                                    SCN(M:&i, &saldo)
                                    SCN(X:&i, &saldo)
                                Endif
                                If &col=12
                                    ***---Sumo el total a la vista Saldos Inmovilizados USD
                                    SCN(N:&i, &saldo)
                                    SCN(X:&i, &saldo)
                                Endif
                            ENDIF
                        ELSE
                            ***---Cambio de Vehiculo
                            Break
                        ENDIF
                    Proximo
                ENDIF
                ***************************
            ELSE
            ENDIF
        Proximo
    ELSE
        DFA
    ENDIF
Proximo

***---FCI
SQL.ADD(" Select P.Especie, P.CantidadFin/"~Fstr(&unidad, 0, 0)~" CantidadFin, P.Vehiculo, P.Book, E.Cotiza Moneda ")
SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = P.Especie ")
SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(P.Especie,'FONDOS') = 1 ")
SQL.ADD(" AND P.NrSaldo = 1 ")
SQL.ADD(" AND P.Fecha = '"~IdxDate(&fechaPosiciones2)~"' ")
SQL.ADD(" Order By 1 ")
Recorrer SQL
    DFA
    let &vehiculoTC fbn('Vehiculo')
    @COTVEHIC
    
    let &monedaTC2 fbn('Moneda')
    @TIPOCAMBIO
    
    IF Not Eqstr(fbn('Especie'), &especieAnt)
        let &cotEspecie Cotizacion(fbn('Especie'),,,,&fechaPosiciones2,1,SI)
    ENDIF
    let &posValuadaFCI fbn('CantidadFin') * &cotEspecie * &tc
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            SCN(P:&k, &posValuadaFCI)
            **Link a Detalle Totales FCI
            ACL(P:&k,'DPOFCI',Fecha1=&fechaPosiciones2,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
            **
            let &totalFCI &totalFCI + &posValuadaFCI
            ***---Sumo al total invertido y total cartera de la fila
            SCN(W:&k, &posValuadaFCI)
            SCN(X:&k, &posValuadaFCI)
            let &totalInvertido &totalInvertido + &posValuadaFCI
            let &totalCartera &totalCartera + &posValuadaFCI
            IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book'))
                            SCN(P:&i, &posValuadaFCI)
                            **Link a Detalle Totales FCI
                                ACL(P:&i,'DPOFCI',Fecha1=&fechaPosiciones2,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
                            **
                            ***---Sumo al total invertido y total cartera de la fila
                            SCN(W:&i, &posValuadaFCI)
                            SCN(X:&i, &posValuadaFCI)
                            
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
            ENDIF
        ENDIF
        let &especieAnt fbn('Especie')
    Proximo
Proximo
***---PF VER QUE NO SALE LA OP SI NO HAY DEVENGADOS PARA LA FECHA
SQL.ADD(" Select (Sum(M.Monto)+O.Cantidad)/"~Fstr(&unidad, 0, 0)~" as 'Importe',M.NrOperacion, ")
SQL.ADD(" M.Vehiculo,O.Especie 'Moneda',O.Book1,O.ContraEspecie2 ")
SQL.ADD(" FROM "~DBO~".MOVDEVENGADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where M.NrOperacion=O.NrOperacion and O.TipoOp='MMCPM' and O.FechaVto>'"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD(" Group by M.NrOperacion,O.Cantidad,M.Vehiculo,O.Especie,O.Book1, O.ContraEspecie2 ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.Cantidad/"~Fstr(&unidad, 0, 0)~" as 'Importe',O.NrOperacion, ")
SQL.ADD(" O.Vehiculo1,O.Especie 'Moneda',O.Book1,O.ContraEspecie2 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp='MMCPM' AND O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD(" Group by O.NrOperacion,O.Cantidad,O.Vehiculo1,O.Especie,O.Book1, O.ContraEspecie2 ")

SQL.ADD(" Order By O.Especie ")
Recorrer SQL
    DFA
    let &vehiculoTC fbn('Vehiculo')
    @COTVEHIC
    #ifdef STD_CORP
        IF Dialogo.Radio4 = 1 Y NoVacio(fbn('ContraEspecie2'))
            ***---Hay que tomar TC Valuacion
            let &cotVehiculo CotizacionBNA(fbn('ContraEspecie2'),Dialogo.Fecha1-1,1,NO,NO)
        ENDIF
    #endif

    let &monedaTC2 fbn('Moneda')
    @TIPOCAMBIO
    
    IF Not Eqstr(fbn('Moneda'), &especieAnt)
        let &cotEspecie Cotizacion(fbn('Moneda'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    ***---let &importePF fbn('Importe') * &cotEspecie * &tc
    let &importePF fbn('Importe') * &tc
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            SCN(Q:&k, &importePF)
            ***---Sumo al total invertido y total cartera de la fila
            SCN(W:&k, &importePF)
            SCN(X:&k, &importePF)
            let &totalInvertido &totalInvertido + &importePF
            let &totalCartera &totalCartera + &importePF
            #ifdef STD_CORP
                ACL(Q:&k,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete, Radio4=Dialogo.Radio4)
            #else
                ACL(Q:&k,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
            #endif
            let &totalPF &totalPF + &importePF
            IF Dialogo.Radio1 = 1
                *No Consolidado
                Recorrer&i &k+1, &filaFinal
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book1'))
                            SCN(Q:&i, &importePF)
                            #ifdef STD_CORP 
                                ACL(Q:&i,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book1'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete, Radio4=Dialogo.Radio4)
                            #else
                                ACL(Q:&i,'DPOPF',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book1'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
                            #endif
                            ***---Sumo el Total Invertido y total cartera de la fila
                            SCN(W:&i, &importePF)
                            SCN(X:&i, &importePF)
                        ENDIF
                    ELSE
                        Break
                    ENDIF
                Proximo
            ENDIF
        Endif
        let &especieAnt fbn('Moneda')
    Proximo
Proximo
*--CAUCIONES
SQL.ADD("Select (Sum(M.Monto)+O.Cantidad)/"~Fstr(&unidad, 0, 0)~" as 'Importe',M.NrOperacion,M.Vehiculo,O.Especie 'Moneda',O.Book1,O.TipoOp,O.CB1 ")
SQL.ADD("FROM MOVDEVENGADOS M, OPERACIONES O")
SQL.ADD("Where M.NrOperacion=O.NrOperacion and O.TipoOp IN('SECAC','SECAT') ")
SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD("Group by M.NrOperacion,O.Cantidad,M.Vehiculo,O.Especie,O.Book1,O.TipoOp,O.CB1 ")

SQL.ADD(" UNION ")

SQL.ADD("Select O.Cantidad/"~Fstr(&unidad, 0, 0)~" as 'Importe',O.NrOperacion,O.Vehiculo1 as 'Vehiculo',O.Especie 'Moneda',O.Book1,O.TipoOp,O.CB1 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp IN('SECAC','SECAT') AND O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD("Group by O.NrOperacion,O.Cantidad,O.Vehiculo1,O.Especie,O.Book1,O.TipoOp,O.CB1 ")

SQL.ADD("Order By O.Especie")


Recorrer SQL
    DFA
    let &vehiculoTC fbn('Vehiculo')
    @COTVEHIC
    
    let &monedaTC2 fbn('Moneda')
    @TIPOCAMBIO

    IF Not Eqstr(fbn('Moneda'), &especieAnt)
        let &cotEspecie Cotizacion(fbn('Moneda'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    let &signo 1
    IF EqStr(fbn('TipoOp'),'SECAT') y EqStr(fbn('CB1'),'1')
        let &signo (-1)
    ENDIF
    let &importeCaucion fbn('Importe') * &cotEspecie * &tc *&signo
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            SCN(R:&k, &importeCaucion)
            ACL(R:&k,'DPOCAU',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1='',Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
            let &totalCaucion &totalCaucion + &importeCaucion
            ***---Sumo al total invertido y total cartera de la fila
            SCN(W:&k, &importeCaucion)
            SCN(X:&k, &importeCaucion)
            let &totalInvertido &totalInvertido + &importeCaucion
            let &totalCartera &totalCartera + &importeCaucion
            IF Dialogo.Radio1 = 1
                *No Consolidado
                Recorrer&i &k+1, &filaFinal
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), fbn('Book1'))
                            SCN(R:&i, &importeCaucion)
                            ACL(R:&i,'DPOCAU',Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio2,Radio2=Dialogo.Radio3,Vehiculo1=FBN['Vehiculo'],Book1=FBN['Book1'],Precio1 = &cotDolDivisa,Precio2=&cotDolBillete)
                            ***---Sumo el Total Invertido y total cartera de la fila
                            SCN(W:&i, &importeCaucion)
                            SCN(X:&i, &importeCaucion)
                        ENDIF
                    ELSE
                        Break
                    ENDIF
                Proximo
            ENDIF
        Endif
        let &especieAnt fbn('Moneda')
    Proximo
Proximo


**LETRAS y TITULOS
SQL.ADD(" Select P.Especie, P.CantidadFin/"~Fstr(&unidad, 0, 0)~" CantidadFin,dbo.DESCIENDEDEESPECIE(P.Especie,'LETRA') as 'EsLetra',")
SQL.ADD(" dbo.DESCIENDEDEESPECIE(P.Especie,'ACCION') as 'EsAccion',P.Vehiculo, P.Book, E.Cotiza Moneda , E.Codigo,E.Alias6 EspecieVinculada, E.MonedaEmision, E.Alias4 TCValuacion, E.Cotiza, ")
SQL.ADD(" dbo.DESCIENDEDEESPECIE(P.Especie,'PUBLIC') as 'EsBono', dbo.DESCIENDEDEESPECIE(P.Especie,'CORP B') as 'EsON'  ")
SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = P.Especie ")
SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(P.Especie,'TITULO') = 1 ")
SQL.ADD(" AND P.NrSaldo = 1 ")
SQL.ADD(" AND P.Fecha = '"~IdxDate(&fechaPosiciones2)~"' ")
SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Val(LS:1))~") ")
SQL.ADD(" Order By 1 ")
Watch(sql.Batch)
Recorrer SQL
*MessageBox(fbn('Especie'))
    DFA
    let &vehiculoTC fbn('Vehiculo')
    @COTVEHIC
    
    #ifdef STD_CORP
        IF Dialogo.Radio4 = 1 Y NoVacio(fbn('TCValuacion'))
            ***---Hay que tomar TC Valuacion
            let &cotVehiculo CotizacionBNA(fbn('TCValuacion'),Dialogo.Fecha1-1,1,NO,NO)
        ENDIF
    #endif
    
    let &monedaTC2 fbn('Moneda')
    @TIPOCAMBIO
    
    IF FBN['EsLetra']=1 y Vacio(fbn['EspecieVinculada'])
        let &cotEspecie Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
        let &posValuadaTI fbn('CantidadFin') * &cotEspecie * &tc
    ELSE
        *IF Eqstr(fbn('Cotiza'), &monedaLocal)   
        IF Eqstr(fbn('Cotiza'), &monedaInforme)
            let &cotEspecie Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
            let &posValuadaTI fbn('CantidadFin') * &cotEspecie
        ELSE
            let &cotEspecie Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
            let &posValuadaTI fbn('CantidadFin') * &cotEspecie * &tc
        ENDIF
    ENDIF
    Recorrer&k &filaInicial, &filaFinal
        IF Eqstr(Val(A:&k), fbn('Vehiculo'))
            IF FBN['EsLetra']=1
                **LETRAS
                SCN(S:&k, &posValuadaTI)
                *Link a detalle vh
                #ifdef STD_CORP
                    ACL(S:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio4=Dialogo.Radio4, Radio5=0, Radio3=Dialogo.Radio3)
                #else
                    ACL(S:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio5=0, Radio3=Dialogo.Radio3)
                #endif
                let &totalLetras &totalLetras + &posValuadaTI
                let &col S
             ELSE
                IF FBN['EsBono']=1
                    **BONOS
                    SCN(T:&k, &posValuadaTI)
                    *Link a detalle vh
                    #ifdef STD_CORP
                        ACL(T:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio4=Dialogo.Radio4, Radio5=1, Radio3=Dialogo.Radio3)
                    #else
                        ACL(T:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio5=1, Radio3=Dialogo.Radio3)
                    #endif
                    let &totalTitulos &totalTitulos + &posValuadaTI
                    let &col T
                ELSE
                    IF FBN['EsAccion']=1
                        **ACCIONES
                        SCN(U:&k, &posValuadaTI)
                        *Link a detalle vh
                        #ifdef STD_CORP
                            ACL(U:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio4=Dialogo.Radio4, Radio5=2, Radio3=Dialogo.Radio3)
                        #else
                            ACL(U:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio5=2, Radio3=Dialogo.Radio3)
                        #endif
                        let &totalAccion &totalAccion + &posValuadaTI
                        let &col U
                    ELSE
                        IF FBN['EsON']=1
                            **ONs
                                SCN(V:&k, &posValuadaTI)
                            *Link a detalle vh
                            #ifdef STD_CORP
                                ACL(V:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio4=Dialogo.Radio4, Radio5=3, Radio3=Dialogo.Radio3)
                            #else
                                ACL(V:&k,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio2=Dialogo.Radio2,Radio1=1,Lista1=fbn('Vehiculo'),Vehiculo1='',Lista2='', Radio5=3, Radio3=Dialogo.Radio3)
                            #endif
                            let &totalONs &totalONs + &posValuadaTI
                            let &col V
                        Endif    
                    ENDIF
                ENDIF
             ENDIF
            ***---Sumo al total invertido y total cartera de la fila
            SCN(W:&k, &posValuadaTI)
            SCN(X:&k, &posValuadaTI)
            let &totalInvertido &totalInvertido + &posValuadaTI
            let &totalCartera &totalCartera + &posValuadaTI
             let &bookCta fbn('Book')
                **********************************
                **NO CONSOLIDADO
                **********************************************
             IF Dialogo.Radio1 = 1
                ***---No Consolidado
                Recorrer&i &k+1, &filaFinal
                    ***---Buscamos el book
                    IF NoVacio(Val(D:&i))
                        IF Eqstr(Val(D:&i), &bookCta)
                            IF FBN['EsLetra']=1
                                SCN(S:&i, &posValuadaTI)
                            Else
                                IF FBN['EsBono']=1 
                                    SCN(T:&i, &posValuadaTI)
                                Else
                                    IF FBN['EsAccion']=1
                                        SCN(U:&i, &posValuadaTI)
                                    Else
                                        IF FBN['EsON']=1
                                            SCN(V:&i, &posValuadaTI)
                                        EndIf
                                    Endif
                                Endif
                            EndIf
                            **links a detalles
                            IF &col=19
                                #ifdef STD_CORP
                                    ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio4=Dialogo.Radio4, Radio5=0, Radio3=Dialogo.Radio3)
                                #else
                                    ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio5=0, Radio3=Dialogo.Radio3 )
                                #endif
                            Else
                                IF &col=20
                                    #ifdef STD_CORP
                                        ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio4=Dialogo.Radio4, Radio5=1, Radio3=Dialogo.Radio3)
                                    #else
                                        ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio5=1, Radio3=Dialogo.Radio3)
                                    #endif
                                ELSE
                                    if &COL=21
                                        #ifdef STD_CORP
                                            ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio4=Dialogo.Radio4, Radio5=2, Radio3=Dialogo.Radio3)
                                        #else
                                            ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio5=2, Radio3=Dialogo.Radio3)
                                        #endif
                                    ELSE
                                        if &COL=22
                                            #ifdef STD_CORP
                                                ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio4=Dialogo.Radio4, Radio5=3, Radio3=Dialogo.Radio3)
                                            #else
                                                ACL(&col:&i,'POSTIT',Fecha1=&fechaPosiciones2,Especie1='',Radio1=0,Radio2=Dialogo.Radio2,Vehiculo1=fbn('Vehiculo'),Lista2=&bookCta,Lista1='', Radio5=3, Radio3=Dialogo.Radio3)
                                            #endif
                                        Endif
                                    Endif
                                Endif
                            Endif
                            ***---Sumo el Total Invertido y total cartera de la fila
                            SCN(W:&i, &posValuadaTI)
                            SCN(X:&i, &posValuadaTI)
                        ENDIF
                    ELSE
                        ***---Cambio de Vehiculo
                        Break
                    ENDIF
                Proximo
             ENDIF
        ENDIF
    Proximo
Proximo
