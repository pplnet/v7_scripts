AlinearCeldas(l:FAC..m:FAC,'D')
SetFont(a:5..aa:FAC,2)
AgregarMarco(a:FAC..ab:FAC,1,0,Exe('COLOR6'))

SQL.ADD("Select * from ")
SQL.ADD("(Select O.*,OB.NrBit,I.Nombre,C.RazonSocial, ")
* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
*SQL.ADD(" O.ObservacDoc as TSID,  ")
* FJL 08/11/20 - Por Issue 4523 se cambia el campo del TS
SQL.ADD(" O.Termsheet as TSID, ")
SQL.ADD(" O.Mercado4 MercNeg, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TIC','TIV','TIPA','TIPP','TIFC','TIFV','TICT','TICO','TIPO','TIDE','TCPCEM','TCOPRI','FXC','FXV','FXCF','FXVF') THEN O.Mercado ELSE O.Mercado3 END MercLiqEsp, ")
SQL.ADD(" O.Mercado2  MercLiqMon, ")
*MAC 5186 agrega cuenta custodia
SQL.ADD(" cu.codigo + '-' + cu.numero cu_numero ")
* FJL 04/07/19 - Por Opraciones sin Cliente
*SQL.ADD("  From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS OB, "~DBO~".INSTANCIAS I, "~DBO~".CLIENTES C ")
*MAC 5186 agrega cuenta custodia
SQL.ADD("  From "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CLIENTES C on O.Cliente1=C.Codigo LEFT OUTER JOIN dbo.cuentas cu on O.Cuenta1=Cu.Codigo, "~DBO~".OPERACIONESBITS OB, "~DBO~".INSTANCIAS I")
*MAC 5186 agrega cuenta custodia
SQL.ADD("Where O.NrOperacion=OB.NrOperacion and OB.Valor='1' ")
SQL.ADD("   and O.FechaCarga >= "~IdxDate2(Dialogo.Fecha1)~" AND O.FechaCarga < DATEADD(day, 1, "~IdxDate2(Dialogo.Fecha2)~")")
SQL.ADD("  and OB.NrBit=I.NrInstancia and I.Tabla='OPERACIONES' ")
* FJL 04/07/19 - Por Opraciones sin Cliente
*SQL.ADD("  and O.Cliente1=C.Codigo ")

If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
EndIf

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" and O.TipoOp In ( Select Codigo From "~DBO~".TIPOSOPERACION Where TipoNegocio in ("~Pipe2Comillas(Val(LI:1))~") ) ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
EndIf

SQL.ADD(" ) as Aux")
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Where MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf

SQL.ADD("UNION")
*----------------------------
SQL.ADD("Select * from ")
SQL.ADD("(Select O.*, 0 NrBit,'*** Sin Instancia ***' Nombre,C.RazonSocial, ")
* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
*SQL.ADD(" O.ObservacDoc as TSID,  ")
* FJL 08/11/20 - Por Issue 4523 se cambia el campo del TS
SQL.ADD("  O.Termsheet as TSID, ")
SQL.ADD(" O.Mercado4 MercNeg, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TIC','TIV','TIPA','TIPP','TIFC','TIFV','TICT','TICO','TIPO','TIDE','TCPCEM','TCOPRI','FXC','FXV','FXCF','FXVF') THEN O.Mercado ELSE O.Mercado3 END MercLiqEsp, ")
SQL.ADD(" O.Mercado2  MercLiqMon, ")
*MAC 5186 agrega cuenta custodia
SQL.ADD(" cu.codigo + '-' + cu.numero cu_numero ")
* FJL 04/07/19 - Por Opraciones sin Cliente
*SQL.ADD("  From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
*MAC 5186 agrega cuenta custodia
SQL.ADD("  From "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CLIENTES C on O.Cliente1=C.Codigo LEFT OUTER JOIN dbo.cuentas cu on O.Cuenta1=Cu.Codigo ")
SQL.ADD(" Where Not Exists (SELECT 1 FROM OPERACIONESBITS OB2 WHERE OB2.NrOperacion=O.NrOperacion and OB2.Valor=1 ) ")
*SQL.ADD(" Where Not Exists (SELECT 1 FROM OPERACIONESBITS OB2 WHERE OB2.NrOperacion=O.NrOperacion and OB2.Valor=1 ) ")
SQL.ADD("   and O.FechaCarga >= "~IdxDate2(Dialogo.Fecha1)~" AND O.FechaCarga < DATEADD(day, 1, "~IdxDate2(Dialogo.Fecha2)~")")
* FJL 04/07/19 - Por Opraciones sin Cliente
*SQL.ADD("   and O.Cliente1=C.Codigo ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" and O.TipoOp In ( Select Codigo From "~DBO~".TIPOSOPERACION Where TipoNegocio in ("~Pipe2Comillas(Val(LI:1))~") ) ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie ='"~Dialogo.Especie1~"'")
EndIf

If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
EndIf

SQL.ADD(" ) as Aux")
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Where MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD(" order by FechaCarga,NrOperacion ")
watch(SQL.BATCH())
*----------------------------
Recorrer SQL
   Message(fbn('NrOperacion'))
   ACT(a:fac, Copy(FBN['Nombre'],1,20))
   If Incluido(Fbn['NrBit'],'13')
      ColorCeldas(a:fac..a:fac,clBlue)
   Endif
   If Incluido(Fbn['NrBit'],'30')
      ColorCeldas(a:fac..a:fac,clRED)
   Endif
   ACT(b:fac, FBN['NrOperacion'])
   ACLO(b:fac, FBN['NrOperacion'])
   ACD(c:FAC, FBN['FechaOp'])
   ACD(d:FAC, FBN['FechaVto'])
   ACT(e:fac, FBN['Especie'])
   ACT(f:fac, FBN['ContraEspecie'])
** FJL 22/03/21 - Para que no diga x pase cuando es la cabecera
*   ACT(g:fac, FBN['TipoOp']~IIF(EqStr(FBN['PaseCB'],'1'),' x Pase'))
   ACT(g:fac, FBN['TipoOp'])
   if fbn('PaseCB')=1 y Not Incluido(FBN['TipoOp'],'TIPA|TIPP')
     ACT(g:fac, Val(g:FAC)~' x Pase')
   endif
   ACT(h:fac, FBN['MercNeg'])
   *ACT(h:fac, FBN['NRBOLETO'])
    
   if fbn('RB10')=1 y Incluido(FBN['TipoOp'],'FXCF|FXVF|')
      ACT(i:fac, '')
   Else
      ACT(i:fac, FBN['MercLiqEsp'])
   Endif 
 
   *ACT(i:fac, FBN['MercLiqEsp'])
   ACT(j:fac, FBN['MercLiqMon'])
   ACT(k:fac, FBN['Cliente1']~'-'~Copy(FBN['RazonSocial'],1,25))
   
   If Incluido(FBN['TipoOp'],'FXCTC|FXVTC|')
      ACN(l:fac, FBN['Cantidad']* BuscarCampo('ESPECIES','TamanioLote','Codigo',FBN['Especie'])  )
   Else
      ACN(l:fac, FBN['Cantidad'])
   EndIf
   
   ACN(m:fac, FBN['Precio1'])
   ACT(n:fac, FBN['Vehiculo1'])
   ACT(o:fac, FBN['Operador'])
   ACD(p:FAC, FBN['FechaCarga'])
   
   if Eqstr(fbn['TipoOp'],'MMCREM')
      ACT(q:fac, '')
   else
    ACT(q:fac, Copy(FBN['Observac2'],1,20))    
   endif
   
   ACT(r:fac, FBN['NroAltaMAE'])
** FJL 19/07/2019 - Por pedido de Brenda
*   ACT(r:fac, FBN['NrOperacion3'])
   ACT(s:fac, FBN['NrExterno'])
* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
   If Incluido(fbn['TipoOp'],'CONU')
      ACT(t:fac, fbn('TSID'))
   EndIf
   If Incluido(fbn['TipoOp'],'PICO|PICD')
*      ACT(s:fac, BuscarCampo('OPERACIONES','ObservacDoc','NrOperacion',fbn('OperacionRef')))
      ACT(u:fac, BuscarCampo('OPERACIONES','Termsheet','NrOperacion',fbn('OperacionRef')))
   EndIf
   if Incluido(FBN['TipoOp'],'FXCF|FXVF|')
      act(u:fac,BuscarCampo('OPROFEX','Warning','NrOperacion',FBN['NrOperacion']))
      #ifdef BIND
      if Vacio(val(u:fac))
      act(u:fac,BuscarCampo('OPNDF','Warning','NrOperacion',FBN['NrOperacion']))
      endif
      #endif
      if NoVacio(val(u:fac))
        acn(ab:1,1)
      endif
   endif
   
   ACT(v:fac, fbn('ObservacDoc')~' '~fbn('ConceptoEmp')~' '~fbn('CodErrorCV')~' '~fbn('CodErrorMAE'))
   *MAC 5186 agrega cuenta custodia
   ACT(w:fac, fbn('UDN2'))
   if INCLUIDO(fbn('MERCADO'),VAR('MERCADOCV'))
    if fbn('formaliquidacion1')=0
        ACT(x:fac,'STD')
    else
       if fbn('formaliquidacion1')=1
        ACT(x:fac,'DVP')
       else
          if fbn('formaliquidacion1')=2
            ACT(x:fac,'RVP')
          endif
       endif
    endif
   else 
       if Incluido(fbn('MERCADO'),VAR('MERCAVARI'))
        if fbn('formaliquidacion2')=0
            ACT(x:fac,'FDP')
        else
            if fbn('formaliquidacion2')=1
                ACT(x:fac,'DVP')
            else
                if fbn('formaliquidacion2')=2
                    ACT(x:fac,'FOP')
                endif
           endif
        endif
       endif
   endif   
   If Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV|TCOPRI|')
       if fbn('TotalNetoCli1')>0
        ACN(y:fac, fbn('TotalNetoCli1'))
       else
           if fbn('TotalBrutoCli1')>0
            ACN(y:fac, fbn('TotalBrutoCli1'))
           endif   
       endif   
   else
        if Incluido(FBN['TipoOp'],'TIPA|TIPP|')
            ACN(y:fac, fbn('TotalBrutoCli1'))
        endif
   endif
   *ACT(y:fac, fbn('NroAltaMae'))
   ACT(z:fac, FBN['NRBOLETO'])
   ACT(aa:fac, fbn('cu_numero'))
   
   if EqStr(FBN['UDN2'],'FIX') or EqStr(FBN['UDN2'],'SDIB')
    ACT(ab:fac, FBN('NrOrdenAux'))
   endif
   
   if EqStr(FBN['UDN2'],VAR('CPC1DEF'))
    ACT(ab:fac, FBN('NrOrden'))
   endif 
   
Proximo

