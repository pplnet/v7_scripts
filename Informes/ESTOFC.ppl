*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1      :'D.Carga.'    ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2      :'H.Carga.'    ; 2;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
  Vehiculo1   :'Vehiculo'      ; 1;2;;;;;;;Var('VEHICULODE')
  NrOperacion1: 'Operacion'    ;;;;;;;;;;;;;;"SELECT NrOperacion, Especie, TipoOp, Cliente1, FechaOp FROM "~DBO~".OPERACIONES"
  Especie1    : 'Especie'      ;;;;;;;;;;;;
  Mercado1    :'Mercado'       ; 3 1;;;;;;;;  
  Lista2      :'ClaseOp.'      ; 4;1;;;;;;;;;SqlSet("Select Distinct ClaseOperacion from "~DBO~".TIPOSOPERACION ")
  Lista1      :'Tipos Op.'     ;-2;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION "~IIF(NoVacio(Dialogo.Lista2)," where ClaseOperacion IN ("~Pipe2Comillas(Dialogo.Lista2)~")"," "));
  Lista3      :'Tipos Neg.'    ;-1;1;;;;;;;;;SQLSet("Select Descripcion from "~DBO~".TIPOSNEGOCIO");
FinDialogo
*** --- ***
If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

Recorrer&i 1,Elementos(Dialogo.Lista3)
  ACT(LI:1,BuscarCampo('TIPOSNEGOCIO','Codigo','Descripcion',ItemLista(Dialogo.Lista3,&i))~'|'~Val(LI:1))
Proximo
*AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))
SetFilaActual(4)
ACT(a:FAC, 'Estado de Operaciones por Fecha de Carga')
SetFont(a:FAC..a:FAC,3)

ACT(a:FAC+1, 'F.Carga Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
If NoVacio(Dialogo.Mercado1)
   ACT(a:FAC+2, 'Mercado: '~Dialogo.Mercado1)
Else
   ACT(a:FAC+2, 'Mercados: Todos')
EndIf
If NoVacio(Dialogo.NrOperacion1)
   ACT(a:FAC+3,'Operacion: '~Pipe2Comillas(Dialogo.NrOperacion1))
Else
   ACT(a:FAC+3,'Operaciones: Todas')
EndIf
If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+4, 'Tipos Operacion: '~Dialogo.Lista1)
Else
   ACT(a:FAC+4, 'Tipos Operacion: Todas')
EndIf

If NoVacio(Dialogo.Lista3)
   ACT(a:FAC+5,'Tipos Negocio: '~Pipe2Comillas(Dialogo.Lista3))
Else
   ACT(a:FAC+5,'Tipos Negocio: Todos')
EndIf

If NoVacio(Dialogo.Vehiculo1)
   ACT(c:FAC+2, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
   ACT(c:FAC+2, 'Vehiculo: Todos')
EndIf
If NoVacio(Dialogo.Especie1)
   ACT(c:FAC+3, 'Especie: '~Dialogo.Especie1)
Else
   ACT(c:FAC+3, 'Especie: Todas')
EndIf




SetFilaActual(FAC+6)
ACN(w1,FAC)

ACT(a:FAC, 'Instancia')
