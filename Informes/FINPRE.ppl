ACT(J:fac, Fstr(Trunc(fbn('NrCuota'), 0), 0, 0)~'/'~Fstr(Trunc(fbn('Cuotas1'), 0), 0, 0))
ACN(k:fac,FBN['TotalIntereses'])
ACN(l:fac,(FBN['ImpWH']+FBN['ImpInt']))
ACN(m:fac,FBN['IntNeto'])
ACN(n:fac,FBN['Tasa'])
ACN(O:fac,FBN['TTN'])

ACN(az1,CotizacionC(fbn['Especie'],,,,Fsys,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )

If Eqstr(fbn['Especie'],Var('MONELOCA')) y Dialogo.Radio2=1
   ACT(az2,PYC(1/val(az1),0,8)~' (INV) ')
ELSE
   ACT(az2,PYC(Val(az1),0,8))
ENDIF

*--****************************************** CALCULO DEVENGADO  NUEVO ***************

ACN(P:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND M.Fecha <='"~IdxDate(Dialogo.Fecha1)~"' AND M.TipoDevengado = 'INTLEN' AND M.NrSaldo = '140'  "))
ACN(Q:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND M.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' AND M.TipoDevengado = 'INTLEN' AND M.NrSaldo = '140'  "))
ACN(R:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND (M.Fecha >= '"~IdxDate(Val(X:3))~"' AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1) ~"') AND M.TipoDevengado = 'INTLEN' AND M.NrSaldo = '140' "))
                               
   
ACN(S:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND M.Fecha <='"~IdxDate(Dialogo.Fecha1)~"' AND M.TipoDevengado = 'INTWHT' AND M.NrSaldo = '140'  "))
ACN(T:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND M.Fecha > '"~IdxDate(Dialogo.Fecha1)~"' AND M.TipoDevengado = 'INTWHT' AND M.NrSaldo = '140'  "))
ACN(U:FAC, SQL(" SELECT SUM(ABS(M.Monto)) FROM "~DBO~".MOVDEVENGADOS M WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND (M.Fecha >= '"~IdxDate(Val(X:3))~"' AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1) ~"') AND M.TipoDevengado = 'INTWHT' AND M.NrSaldo = '140' "))
                                                                                                                                            
