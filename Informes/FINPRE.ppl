*-Intereses PostFinanciacion de Importaciones y  Prestamos Financieros de Capital e Interes
HOJAVISIBLE(SI)
ModoReproceso(SinDialogo)
CrearDialogo
  Radio1      : "LLamado |INFINA|INPRES"   ;1;1;;NO;NO;;
  Radio2      : "Expresado|ARP  |USD      ";2;;;NO;NO;;;;0
  Fecha1      : "F.Vigencia"       ;1;1;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Especie1    : "Especie"          ;2;1;;;;;;;;;
  Cliente1    : "Entidad"          ;1;2;;;;;;;;;
  NrOperacion1: "Operacion"        ;;;;;;;;;;;;;" TipoOp In ('MMFIMV','MMPCLM','MMSELN','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME')"
  Lista1      : "Vehiculo"         ;4;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
  Lista2      : "TipoOp"           ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMFIMV','MMPCLM','MMSELN','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME') ")
  Vehiculo1   : "Grupo"            ;;;;NO;NO;;
  Radio3      : "Consolidado|SI|NO";;;;SI;SI;;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)
ACN(fi1,0)
ACT(j:FAC,'Fecha : '~Var('FECHASYS'))
ACD(x:3, PriDeMes(Dialogo.Fecha1, SI))
SetFont(j:FAC..j:FAC,1)

if Dialogo.Radio1=0
   ACT(a:FAC  ,"Intereses PostFinanciacion de Importaciones")
else
   ACT(a:FAC  ,"Prestamos Financieros de Capital e Interes")
endif
ACT(a:FAC+1,"Vigentes al "~Dialogo.Fecha1~" ")

ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(d:FAC+1, 'Expresado en '~Val(mo1))
SetFont(a:fac..d:fac+2,3)

*                              ++++NUEVO
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Vehiculo1~' - '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  If NoVacio(Dialogo.Lista2)
   * ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Lista1)  ******* nOMBRE LISTA DE VEHICULOS
  *Else 
    ACT(a:FAC+2, 'Vehiculo : Todos')
  EndIf
endif
SetFont(a:fac..a:fac+2,3)
IFA
*                             +++++


SetFilaActual(FAC+1)

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+1, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+1, 'Especie : Todas')
endif


if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Banco : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Banco : Todos')
endif


if NoVacio(Dialogo.NrOperacion1)
  ACT(a:FAC+3, 'NrOperacion: '~Dialogo.NrOperacion1)
else
  ACT(a:FAC+3, 'NrOperacion: Todas')
endif


SetFilaActual(FAC+1)
If Dialogo.Radio1 = 0
   if NoVacio(Dialogo.Lista2)
      ACT(a:FAC, 'Tipo Op.: '~Dialogo.Lista2)
   else
      ACT(a:FAC, 'Tipo Op.: Todas')
   endif
ENDIF  

If Dialogo.Radio1 = 1 
  If Dialogo.Radio3 = 0
    ACT(a:FAC, 'Consolidado : Si')
  Else
    ACT(a:FAC, 'Consolidado : No')
  EndIf
EndIf

SetFont(a:fac..u:FAC+7,2)
SetFilaActual(FAC+2)

ACT(a:FAC,'Banco')
ACT(b:FAc,'Mon.')
ACT(c:FAC,'Tipo Op')
ACT(d:FAC,'Numero Op.')
ACT(e:FAC,'F.Orig.Cap.')
ACT(f:FAC,'F.Vto.Cap.')
ACT(g:FAC,'Capital')
ACT(h:FAC,'F.Orig.Cta.')
ACT(i:FAC,'F.Vto.Cta.')
***---ACT(j:FAC,'F.Cupon Int.')
ACT(j:FAC,'Cuota')
ACT(k:FAC,'Interes')
ACT(l:FAC,'WH + Imp.Int')
ACT(m:FAC,'Int.Total')
ACT(N:FAC,'Tasa')
ACT(O:FAC,'T.I.T.')
ACT(P:FAC,'Int.Dev.Acum.')
ACT(Q:FAC,'Int. a Dev.')
ACT(R:FAC,'Int.Dev.mes')
ACT(S:FAC,'WH Dev.Acum.')
ACT(T:FAC,'WH a Dev.')
ACT(U:FAC,'WH Dev.mes')


AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(h:FAC..j:FAC,'I')
AlinearCeldas(g:FAC..g:FAC,'C')
AlinearCeldas(k:FAC..u:FAC,'C')
SetFont(a:fac..u:FAC,2)
AgregarMarco(a:FAC..u:FAC,2,0,Exe('COLOR'))

*- cc1: Vehiculo  cc2: Grupo   cc3: Especie
ACT(cc1, '')
ACT(cc2, '')
ACT(cc3, '')

BorrarCeldas(w11..w17)
BorrarCeldas(w21..w27)
BorrarCeldas(w31..w27)
BorrarCeldas(w91..w97)
*--SetFilaActual(13)

*- Llamo a la funcion pidiendo solamente los settlements vigentes vi1: Vigentes=1 , Todos los Settements=0
ACN(vi1,1)
(.'PFPRESFINA'.)
*- Ordenado por Vehiculo,Grupo,Especie,Cliente1,NrOperacion
SQL.ADD(" Order By 1,2,9,6,3 ")
Recorrer SQL
   *-- Preparo el corte de control
   if eqstr(Val(cc1),'') y eqstr(Val(cc2),'') y eqstr(Val(cc3),'')
       act(cc1, fbn['Vehiculo1'])
       act(cc2, fbn['Grupo'])
       act(cc3, fbn['Especie'])
       act(a:fac,fbn('Vehiculo1'))
       AgregarMarco(a:FAC..U:FAC,2,0,Exe('COLOR6'))
       SetFont(a:fac..U:fac,2)
       ifa
   else
      If [Not Eqstr(fbn['Vehiculo1'],Val(cc1))] y NoVacio(Val(cc1))
         act(a:fac,'Total Especie '~Val(cc3) )
         act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(g:fac, Val(w31))
         acn(k:fac, Val(w32))
         acn(l:fac, Val(w33))
         acn(m:fac, Val(w34))
         acn(P:fac, Val(w35))
         acn(Q:fac, Val(w36))
         acn(R:fac, Val(w37))
         ** WHT w50
         acn(S:fac, Val(w55))
         acn(T:fac, Val(w56))
         acn(U:fac, Val(w57))
         BorrarCeldas(w31..w37)
         BorrarCeldas(w55..w57)
         AgregarMarco(a:fac..U:fac,2,0,RGB(192,192,192))
         SetFont(a:fac..U:fac,2)
         ifa
         act(a:fac,'Total Grupo '~Val(cc2)~' en '~Val(mo1))
         acn(g:fac, Val(w21))
         acn(k:fac, Val(w22))
         acn(l:fac, Val(w23))
         acn(m:fac, Val(w24))
         acn(P:fac, Val(w25))
         acn(Q:fac, Val(w26))
         acn(R:fac, Val(w27))
         ** WHT W60
         acn(S:fac, Val(w65))
         acn(T:fac, Val(w66))
         acn(U:fac, Val(w67))
         BorrarCeldas(w21..w27)
         BorrarCeldas(w65..w67)
         AgregarMarco(a:fac..U:fac,2,0,RGB(192,192,192))
         SetFont(a:fac..U:fac,2)
         ifa
         act(a:fac,'Total Cia. '~Val(cc1)~' en '~Val(mo1))
         acn(g:fac, Val(w11))
         acn(k:fac, Val(w12))
         acn(l:fac, Val(w13))
         acn(m:fac, Val(w14))
         acn(P:fac, Val(w15))
         acn(Q:fac, Val(w16))
         acn(R:fac, Val(w17))
         ** WHT E70
         acn(S:fac, Val(w75))
         acn(T:fac, Val(w76))
         acn(U:fac, Val(w77))
         SCN(w91, Val(w11))
         SCN(w92, Val(w12))
         SCN(w93, Val(w13))
         SCN(w94, Val(w14))
         SCN(w95, Val(w15))
         SCN(w96, Val(w16))
         SCN(w97, Val(w17))
         ** WHT E90
         SCN(w98, Val(w75))
         SCN(w99, Val(w76))
         SCN(w90, Val(w77))
         BorrarCeldas(w11..w17)
         BorrarCeldas(w75..w77)
         AgregarMarco(a:fac..U:fac,2,0,Exe('COLOR6'))
         SetFont(a:fac..U:fac,2)
         ifa
         act(cc1, fbn['Vehiculo1'])
         act(cc2, fbn['Grupo'])
         act(cc3, fbn['Especie'])
         ifa
         act(a:fac,fbn('Vehiculo1'))
         AgregarMarco(a:FAC..u:FAC,2,0,Exe('COLOR6'))
         SetFont(a:fac..U:fac,2)
         ifa
    Else 
      If [Not Eqstr(fbn['Grupo'],Val(cc2))] y NoVacio(Val(cc2))
         *-- Cambia El Grupo
         act(a:fac,'Total Especie '~Val(cc3) )
         act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(g:fac, Val(w31))
         acn(k:fac, Val(w32))
         acn(l:fac, Val(w33))
         acn(m:fac, Val(w34))
         acn(P:fac, Val(w35))
         acn(Q:fac, Val(w36))
         acn(R:fac, Val(w37))
         **  WHT W50
         acn(S:fac, Val(w55))
         acn(T:fac, Val(w56))
         acn(U:fac, Val(w57))
         BorrarCeldas(w31..w37)
         BorrarCeldas(w55..w57)  
         AgregarMarco(a:fac..U:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..U:fac,2)
         ifa
         act(a:fac,'Total Grupo '~Val(cc2)~' en '~Val(mo1))
         acn(g:fac, Val(w21))
         acn(k:fac, Val(w22))
         acn(l:fac, Val(w23))
         acn(m:fac, Val(w24))
         acn(P:fac, Val(w25))
         acn(Q:fac, Val(w26))
         acn(R:fac, Val(w27))
         ** WHT W60
         acn(S:fac, Val(w65))
         acn(T:fac, Val(w66))
         acn(U:fac, Val(w67))
         BorrarCeldas(w21..w27)
         BorrarCeldas(w65..w67)
         AgregarMarco(a:fac..U:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..U:fac,2)
         ifa
         act(cc1, fbn['Vehiculo1'])
         act(cc2, fbn['Grupo'])
         act(cc3, fbn['Especie'])
      Else
         If [Not Eqstr(fbn['Especie'],Val(cc3))] y NoVacio(Val(cc3))
            *-- Cambia Especie
            act(a:fac,'Total Especie '~Val(cc3) )
            act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
            acn(g:fac, Val(w31))
            acn(k:fac, Val(w32))
            acn(l:fac, Val(w33))
            acn(m:fac, Val(w34))
            acn(P:fac, Val(w35))
            acn(Q:fac, Val(w36))
            acn(R:fac, Val(w37))
            acn(S:fac, Val(w55))
            acn(T:fac, Val(w56))
            acn(U:fac, Val(w57))
            BorrarCeldas(w31..w37)
            BorrarCeldas(w55..w57)
            AgregarMarco(a:fac..U:fac,1,0,RGB(192,192,192))
            SetFont(a:fac..U:fac,2)
            ifa
            act(cc1, fbn['Vehiculo1'])
            act(cc2, fbn['Grupo'])
            act(cc3, fbn['Especie']) 
         EndIf
      Endif
 Endif
Endif

