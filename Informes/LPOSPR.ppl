CrearDialogo
  Fecha1    : 'Fecha'        ;;;;;;;;;FSys
  Vehiculo1 : 'Vehiculo'     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio1    : 'Detalle|No|Si';;;;;;;;;0
FinDialogo

if not Ok 
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif


ACT(a4, 'Limites de Posicion - Profundidad y Emision')
if NoVacio(Dialogo.Vehiculo1)
  ACT(a5, 'Vehiculo: '~Dialogo.Vehiculo1)
  ACT(z10, Descendientes('Vehiculos', Dialogo.Vehiculo1))
  if NoVacio(Val(z10))
    ACT(z11, "'"~Dialogo.Vehiculo1~"',"~Pipe2Comillas(Val(z10)))
  else
    ACT(z11, "'"~Dialogo.Vehiculo1~"'")
  endif
else
  ACT(a5, 'Vehiculo: Todos')
endif
ACT(a6, 'Fecha: '~Dialogo.Fecha1)

ACT(a8, 'Titulo')
ACT(b8, 'Valor(000s)')
ACT(c8, 'Tot.Emision(000s)')
ACT(d8, '% Emision')
ACT(e8, '% Max.Emision')
ACT(f8, 'Estado')
ACT(g8, 'Prof.Promedio')
ACT(h8, 'Ct.Ruedas')
ACT(i8, 'Ct.Max.Ruedas')
ACT(j8, 'Estado')
AlinearCeldas(b8..e8, 'D')
AlinearCeldas(g8..i8, 'D')

AgregarMarco(a8..j8,1,0,Exe("COLOR"))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z8, 1)

ACT(a9, 'Titulos Publicos')
AgregarMarco(a9..j9,1,0,RGB(192,192,192))

SetFilaActual(9)

*- Saco los Cupones 
SQL.ADD("Select Codigo, Valor1, Cotiza from "~DBO~".ESPECIES where Tipo='PUB' and EsCupon='NO'")

Recorrer SQL

  ACN(z1, 0)
  ACN(z7, 0)
  ACN(z8, 0)

  (.'LPOSSPOTTT'.)
  (.'LPOSFUTURO'.)

  Message(fbn('Codigo')~' '~Fstr(val(z8),0,2) )
  Message(fbn('Codigo')~' '~Fstr(val(z1),0,2) )

  if Val(z1)>0 o Val(z8)>0
     ACT(a:fac, fbn('Codigo'))
     ACN(m1,CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD'))

     Message(fbn('Codigo')~' '~Fstr(val(m1),0,2) )

     ACN(b:fac, (Val(z8)+Val(z1))/1000)

     if Val(b:fac) < 0
        ACN(b:fac, 0)
     endif

     *- Volumen ingresado en Miles -> No Divido para Display
     ACN(c:fac, fbn('Valor1'))

     ACN(d:fac, Val(b:fac)/Val(c:fac)*100)

     *- Profundidad en Miles
     ACN(g:fac, Cotizacion(fbn('Codigo'),,,,FSys,11,SI)/1000)

     ACN(h:fac, Val(b:fac)/Val(g:fac))

     if Vacio(Dialogo.Vehiculo1)
        if Val(b:fac)>Val(c:fac)
           ACT(f:fac, 'Error')
           ColorCeldas(f:fac,clRED)
        else
           ACN(e:fac, LimAsignado('VINCULADOS', 'POREMI', Val(a:fac)))
           ACN(i:fac, LimAsignado('VINCULADOS', 'CANTRUEDAS', Val(a:fac)))
           if Val(d:fac)>Val(e:fac)
              ACT(f:fac, 'Excedido')
              ColorCeldas(f:fac,clRED)
           else
              ACT(f:fac, 'OK')
              ColorCeldas(f:fac,clGREEN)
           endif
           if Val(h:fac)>Val(i:fac)
              ACT(j:fac, 'Excedido')
              ColorCeldas(j:fac,clRED)
           else
              ACT(j:fac, 'OK')
              ColorCeldas(j:fac,clGREEN)
           endif
        endif
     endif
  else
     dfa
  endif
proximo

ifa
ACT(a:fac, 'Titulos Privados')
AgregarMarco(a:fac..j:fac,1,0,RGB(192,192,192))

SQL.ADD("Select Codigo, Cotiza, Valor1 from "~DBO~".ESPECIES where Tipo in ('ONE','PRI') ")

recorrer SQL

  ACN(z1, 0)
  ACN(z7, 0)
  ACN(z8, 0)

  (.'LPOSSPOTTT'.)
  (.'LPOSFUTURO'.)

  if Val(z1)>0 o Val(z8)>0
     ACN(m1,CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD'))
 
    ACT(a:fac, fbn('Codigo'))
    if EqStr(fbn('Cotiza'), 'ARP') 
      ACN(b:fac, Val(z8)+Val(z1)/1000)
    else
      ACN(b:fac, Val(z8)+Val(z1)/1000)
    endif
    if Val(b:fac) < 0
      ACN(b:fac, 0)
    endif

    *- Volumen ingresado en Miles -> No Divido para Display
    ACN(c:fac, fbn('Valor1'))
    ACN(d:fac, Val(b:fac)/Val(c:fac)*100)

    *- Profundidad 
    ACN(g:fac, Cotizacion(fbn('Codigo'),,,,FSys,11,SI)/1000)

    ACN(h:fac, Val(b:fac)/Val(g:fac))
    if Vacio(Dialogo.Vehiculo1)
       if Val(b:fac)>Val(c:fac)
          ACT(f:fac, 'Error')
          ColorCeldas(f:fac,clRED)
       else
          ACN(e:fac, LimAsignado('VINCULADOS', 'POREMI', Val(a:fac)))
          ACN(i:fac, LimAsignado('VINCULADOS', 'CANTRUEDAS', Val(a:fac)))
          if Val(d:fac)>Val(e:fac)
             ACT(f:fac, 'Excedido')
             ColorCeldas(f:fac,clRED)
          else
             ACT(f:fac, 'OK')
             ColorCeldas(f:fac,clGREEN)
          endif
          if Val(h:fac)>Val(i:fac)
             ACT(j:fac, 'Excedido')
             ColorCeldas(j:fac,clRED)
          else
             ACT(j:fac, 'OK')
             ColorCeldas(j:fac,clGREEN)
          endif
       endif
    endif
  else
    dfa
  endif
proximo

ACN(v1, fac)
ACO(1, 12)
ACO(2, 9)
ACO(3, 10)
ACO(4, 9)
ACO(5, 9)
ACO(6, 9)
ACO(7, 9)
ACO(8, 9)
ACO(9, 9)
ACO(10, 9)

AgregarMarco(a8..a:fac,1)
AgregarMarco(b8..b:fac,1)
AgregarMarco(c8..f:fac,1)
AgregarMarco(g8..j:fac,1)
AgregarMarco(d8..d8,1)
AgregarMarco(g8..g8,1)
AgregarMarco(e8..e8,1)
AgregarMarco(i8..i8,1)


if no
recorrer&i 9, fac
  ACN(c:&i, Val(b:&i)/Val(b:fac+1)*100)
  if Val(d:&i) > 0
    if Val(c:&i)>Val(d:&i)
      ACT(e:&i, 'Excedido')
      ColorCeldas(e:&i,clRED)
    else
      ACT(e:&i, 'OK')
      ColorCeldas(e:&i,clGREEN)
    endif
  endif
  if Vacio(Val(f:&i))
    if &i > Val(w10)
      ACN(f:&i, Val(b:&i)/Val(b:Val(w10))*100)
    else
      if &i > Val(w9)
        ACN(f:&i, Val(b:&i)/Val(b:Val(w9))*100)
      else
        if &i > Val(w8)
          ACN(f:&i, Val(b:&i)/Val(b:Val(w8))*100)
        else
          if &i > Val(w4)
            ACN(f:&i, Val(b:&i)/Val(b:Val(w4))*100)
          else
            if &i > 19
              ACN(f:&i, Val(b:&i)/Val(b19)*100)
            else
              ACN(f:&i, Val(b:&i)/Val(b9)*100)
            endif
          endif
        endif
      endif
    endif
  endif
  if Val(g:&i) > 0
    if Val(f:&i)>Val(g:&i)
      ACT(h:&i, 'Excedido')
      ColorCeldas(h:&i,clRED)
    else
      ACT(h:&i, 'OK')
      ColorCeldas(h:&i,clGREEN)
    endif
  endif
proximo
endif

SetFont(a9..a:fac+1,1)
SetFont(b9..z:fac+1,2)

SetFilaActual(fac+2)
If Dialogo.Radio1=1
   ACN(w20, fac)
   recorrer ("Select Codigo from "~DBO~".VEHICULOS")
      dfa
      if [DesciendeDeVehiculo(fbn('Codigo'),Dialogo.Vehiculo1) y not EqStr(fbn('Codigo'), Dialogo.Vehiculo1)] o Vacio(Dialogo.Vehiculo1)
         ifa
         ACT(a:fac, fbn('Codigo'))
         AsignarLink(a:fac, 'LPOSPR', Vehiculo1=Val(a:fac), Fecha1=Dialogo.Fecha1)
      endif
   proximo
   SetFont(a:Val(w20)..z:fac,2)
EndIf

LimitesVision(k:fac+1)
Impresion(1,2)
