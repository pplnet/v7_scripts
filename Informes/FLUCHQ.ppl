CrearDialogo
  Fecha1 : 'F.Desde'     ;1;1;;;;;;;Fsys
  Fecha2 : 'F.Hasta'     ;2;1;;;;;;;Fsys+7
  Cliente1:'Cliente'     ;2;2;
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Flujo de Cheques')
ACT(a2, 'D.Fecha: '~Dialogo.Fecha1)
ACT(c2, 'H.Fecha: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
  ACT(a3, 'Cliente: '~Dialogo.Cliente1)
else
  ACT(a3, 'Cliente: Todos')
endif
ACT(c3, 'Especie:'~Dialogo.Especie1)

ACT(a6, 'Fecha')
ACT(b5, 'Liquidacion')
ACT(b6, 'Compras')
ACT(c6, 'Ventas')
ACT(d6, 'Derechos')
ACT(e6, 'Comisiones')
ACT(f6, 'Gastos')
ACT(g6, 'IVA')
ACT(h6, 'Neto')
ACT(j5, 'Concertacion')
ACT(j6, 'Compras')
ACT(k6, 'Ventas')

SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and ((FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp<'"~IdxDate(Dialogo.Fecha2+1)~"') or ")
SQL.ADD("(FechaOp2 >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp2<='"~IdxDate(Dialogo.Fecha2+1)~"'))")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
SQL.ADD(" and Cliente1 <> '"~VAR('VEHICULODE')~"'")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("       and Cliente1 = '"~Dialogo.Cliente1~"'")
endif

  SetFilaActual(6)

Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
  ifa
  ACD(a:fac, Dialogo.Fecha1+&i-1)
proximo

recorrer SQL
  if fbn('FechaOp2')>=Dialogo.Fecha1 y fbn('FechaOp2')<Dialogo.Fecha2+1
    Let &Fila 6+(fbn('FechaOp2')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
      SCN(b:&Fila, fbn('Cantidad'))
    else
      SCN(c:&Fila, fbn('Cantidad'))
    endif
    SCN(d:&Fila, fbn('TotalDerechos'))
    SCN(e:&Fila, fbn('ImpGastos1'))
    SCN(f:&Fila, fbn('TotalGastos'))
    SCN(g:&Fila, fbn('TotalIVA')+fbn('ImpGastos2')+fbn('TotalAux1'))
        *aca va el resto de los campos que se acumulan
  endif

  if fbn('FechaOp')>=Dialogo.Fecha1 y fbn('FechaOp')<Dialogo.Fecha2+1
    Let &Fila 6+(fbn('FechaOp')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
    SCN(j:&Fila, fbn('Cantidad'))
    else
    SCN(k:&Fila, fbn('Cantidad'))
    endif
  endif
proximo

setfilaactual(6)
Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
  ifa
  if NoVacio(b:fac)
    ACL(b:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=1)
  endif  
  if NoVacio(c:fac)
    ACL(c:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=2)
  endif  
  if NoVacio(j:fac)
    ACL(j:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=3)
  endif  
  if NoVacio(k:fac)
    ACL(k:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=4)
  endif  


  *agregar todos los links, seleccionando el tipo por el radio1: liqcompras, liqventas, conccompras, concventas
proximo

let &AnchoColumna 8
ACO(2,&AnchoColumna)
ACO(3,&AnchoColumna)
ACO(4,&AnchoColumna)
ACO(5,&AnchoColumna)
ACO(6,&AnchoColumna)
ACO(7,&AnchoColumna)
ACO(8,&AnchoColumna)

ACO(10,&AnchoColumna)
ACO(11,&AnchoColumna)

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,14,B")
CrearFont(4, "Arial,6,")
CrearFont(5, "Arial,10,BU")
CrearFont(6, "Arial,10,B")
CrearFont(7, "Arial,10,")

setfont(a1..z:fac, 1)
*SetFont(a6..z6, 2)
SetFont(a1..z6, 2)

* ColorCeldas(a23..c23,Var('COLOR2'))
  FormatoCeldas(b7..k:fac+1, EXE('F2'))
  *  FormatoCeldas(g7..g:fac+1, EXE('F9'))
  * FormatoCeldas(j7..j:fac+1, EXE('F9'))
  AgregarMarco(a6..h6,1,0,Exe('COLOR2'))
  AgregarMarco(j6..k6,1,0,Exe('COLOR2'))
  AgregarMarco(b5..h5,1,0,Exe('COLOR2'))
  AgregarMarco(j5..k5,1,0,Exe('COLOR2'))
