ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'  ;;;;;;;;;FSys
  Vehiculo1: 'Vehiculo' ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');;
  Radio1   : 'Cartera|Trading|Invest<=6M.|Invest>6M.|Otras Soc.';;;;;;;;;0
  Especie1 : 'Especie'                              ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;
  Radio2   : 'Expresado|Mon.Local|Mon.Extranjera|'  ;;;;;;;;;0
  String1  : 'Cupon'                                ;;;;NO;NO;;;;;;
FinDialogo

If Not OK
   Cancelar
Endif

If Dialogo.Radio2 = 0
   ACT(mn1, VAR('MONELOCA'))
Else
   ACT(mn1, VAR('MONEEXTR'))
EndIf

*- Datos de la Especie
SQL.ADD("SELECT Codigo,FechaCambioTasa,TasaIntAnterior,TasaIntVigente,Alias5,InteresesC FROM "~DBO~".ESPECIES ")
IF NoVacio(Dialogo.Especie1)
   SQL.ADD("WHERE Codigo='"~Dialogo.Especie1~"' ")
ENDIF

ACN(cr1, Dialogo.Radio1+107)

ACD(yu:1 , Dialogo.Fecha1)

Recorrer SQL
   dfa
   ACN(yt1, 1)
   ACT(yv:1 , FBN['Codigo'])
   ACD(yx:1 , FBN['FechaCambioTasa'])
   ACN(yy:1 , FBN['TasaIntAnterior'])
   ACN(yz:1 , FBN['TasaIntVigente'])
   ACN(vr2,FBN['Alias5'])
   ACN(vr1, IIf(EqStr(FBN['InteresesC'],'CLE'),VALORTEORICO2(FBN['Codigo'],Dialogo.Fecha1),1) )
   ACN(cc1, CotizacionC(FBN['Codigo'],,,,Dialogo.Fecha1,1,SI,Val(mn1)) ) 
Proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

ACT(a1, 'Detalle de Posicion Inicial')

ACT(a3, 'Fecha: '~Dialogo.Fecha1)
ACT(a4, 'Cartera: ')
IF Dialogo.Radio1=0
   ACT(a4, Val(a4)~'Trading')
ENDIF
IF Dialogo.Radio1=1
   ACT(a4, Val(a4)~'Investment <= 6 meses')
ENDIF
IF Dialogo.Radio1=2
   ACT(a4, Val(a4)~'Investment > 6 meses')
ENDIF
IF Dialogo.Radio1=3
   ACT(a4, Val(a4)~'Otras Sociedades')
ENDIF
SetFont(a1..a5, 1)

ACT(a6, 'Tipo Op.')
ACT(b6, 'NrOperacion')
ACT(c6, 'Ubicacion')
ACT(d6, 'Fecha Op.')
ACT(e6, 'Fecha Vto.')
ACT(f6, 'Cantidad')
ACT(g6, 'Observacion')

SetFont(a6..g6, 1)
AgregarMarco(a6..g6,1,0,Exe("COLOR6"))

SetFilaActual(6)

** Guardo en az1 la columna que corresp. al tipo de Cartera, para usarlo en el SELECT
if Dialogo.Radio1 = 0
   ACT(az1,'O.CanPosTrad')
else
    if Dialogo.Radio1 = 1
       ACT(az1,'O.CanPosInv1')
    else
        if Dialogo.Radio1 = 2
           ACT(az1,'O.CanPosInv2')
        else
            ACT(az1,'O.CanPosOSoc')
        endif  
    endif
endif


SQL.ADD("SELECT P1.Sector Mercado, 'ASALDOPOSIC' TipoOp, P1.CantidadFin Cantidad, ")
SQL.ADD("       '' FechaOp,'' FechaVto, '0' NrOperacion, 0 PaseCB, TipoNegocio, '' Inv  ")
SQL.ADD("FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("WHERE P1.Cliente = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      P1.Especie = '"~Dialogo.Especie1~"' AND ")
If NoVacio(Dialogo.String1)
   SQL.ADD(" P1.Cupon = "~Dialogo.String1~" AND ")
EndIf
SQL.ADD("      P1.NrSaldo = "~FStr(Val(cr1),0,0)~" AND ")
SQL.ADD("      P1.Fecha = (SELECT MAX(P2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".POSICIONES P2 ")
SQL.ADD("                  WHERE P2.Cliente = P1.Cliente AND ")
SQL.ADD("                        P2.Especie = P1.Especie AND ")
SQL.ADD("                        P2.NrSaldo = P1.NrSaldo AND ")
SQL.ADD("                        P2.Cupon = P1.Cupon AND ")
SQL.ADD("                        P2.TipoNegocio = P1.TipoNegocio AND ")
SQL.ADD("                        P2.Sector = P1.Sector AND ")
IF Dialogo.Fecha1 > FSys
   SQL.ADD("                        P2.Fecha <= '"~IdxDate(FSys-1)~"') ")
ELSE
   SQL.ADD("                        P2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"') ")
ENDIF
IF Dialogo.Fecha1 > FSys
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.Mercado1 Mercado, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, T.Fecha1 FechaOp, ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, ")
   SQL.ADD("       T.NrTrans NrOperacion, 0 PaseCB, '' TipoNegocio, '' Inv ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSPEN M ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   SQL.ADD("      T.NrTrans = M.NrOperacion AND ")
   SQL.ADD("      M.NrSaldo = "~FStr(Val(cr1),0,0)~" AND ")
   SQL.ADD("      M.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("      T.Cliente1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.RB4 = '"~FStr(Dialogo.Radio1,0,0)~"' AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
   SQL.ADD("      T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.Mercado1 Mercado, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, T.Fecha1 FechaOp, ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, ")
   SQL.ADD("       T.NrTrans NrOperacion, 0 PaseCB, '' TipoNegocio, '' Inv ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSEJE M ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   SQL.ADD("      T.NrTrans = M.NrOperacion AND ")
   SQL.ADD("      M.NrSaldo = "~FStr(Val(cr1),0,0)~" AND ")
   SQL.ADD("      M.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("      T.Cliente1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.RB4 = '"~FStr(Dialogo.Radio1,0,0)~"' AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
   SQL.ADD("      T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.Mercado1 Mercado, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, T.Fecha1 FechaOp, ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, ")
   SQL.ADD("       T.NrTrans NrOperacion, 0 PaseCB, '' TipoNegocio, 'INV' Inv ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSPEN M ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   SQL.ADD("      T.NrTrans = M.NrOperacion AND ")
   SQL.ADD("      M.NrSaldo = "~FStr(Val(cr1),0,0)~" AND ")
   SQL.ADD("      M.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("      T.Cliente2 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.RB4 = '"~FStr(Dialogo.Radio1,0,0)~"' AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
   SQL.ADD("      T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.Mercado1 Mercado, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, T.Fecha1 FechaOp, ")
   SQL.ADD("       CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, ")
   SQL.ADD("       T.NrTrans NrOperacion, 0 PaseCB, '' TipoNegocio, 'INV' Inv ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSEJE M ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   SQL.ADD("      T.NrTrans = M.NrOperacion AND ")
   SQL.ADD("      M.NrSaldo = "~FStr(Val(cr1),0,0)~" AND ")
   SQL.ADD("      M.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("      T.Cliente2 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      T.RB4 = '"~FStr(Dialogo.Radio1,0,0)~"' AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      T.TipoTr2 IN ('DTP','RTP') AND ")
   SQL.ADD("      T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.Mercado, O.TipoOp TipoOp, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.FechaOp, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, '' TipoNegocio, '' Inv  ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("       (O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND")
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      O.TipoOp IN ('CTC','VTC','CTP','VTP') AND ")
   SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.Mercado, O.TipoOp TipoOp, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.FechaOp, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, '' TipoNegocio, '' Inv  ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("       (O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND")
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
   SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.Mercado, O.TipoOp TipoOp, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.FechaOp, O.FechaVto, O.NrOperacion, ISNULL(O.PaseCB,0) PaseCB, '' TipoNegocio, '' Inv  ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD("   O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("       (O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND")
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("      O.FechaVto >= '"~IdxDate(FSys)~"' AND ")
   SQL.ADD("      O.TipoOp IN ('TIC','TIV','TIFC','TIFV','TIBCRA') AND ")
   SQL.ADD("      O.PaseCB = '1' ")
   SQL.ADD("ORDER BY 2, 6 ")
ELSE
   SQL.ADD("ORDER BY 2, 6 ")
ENDIF


ACN(t1, 0)
Recorrer SQL
   IF EqStr(FBN['TipoOp'],'ASALDOPOSIC')
      ACT(a:fac, 'Posicion')
      ACT(b:fac, '')
      ACT(d:fac, '')
      ACT(e:fac, '')
   ELSE
      ACT(a:fac, FBN['TipoOp'])
      ACT(b:fac, FBN['NrOperacion'])
      IF Incluido(FBN['TipoOp'],'DTP|RTP|')
         ACLT(b:fac, FBN['NrOperacion'])
      ELSE
         ACLO(b:fac, FBN['NrOperacion'])
      ENDIF
      ACD(d:fac, FBN['FechaOp'])
      ACD(e:fac, FBN['FechaVto'])
   ENDIF
   ACT(c:fac, BUSCARCAMPO('MERCADOS','Descripcion','Codigo',FBN['Mercado']))
   ACN(f:fac, FBN['Cantidad'])
   IF FBN['PaseCB']=1 
      ACT(g:fac, 'Pase')
   ELSE
      IF EqStr(FBN['TipoNegocio'],'CUS')
         ACT(g:fac, 'Custodia')
      ELSE
         IF EqStr(FBN['TipoNegocio'],'BOLSA')
            ACT(g:fac, 'Bursatil')
         ELSE
            IF EqStr(FBN['TipoNegocio'],'SEC')
               ACT(g:fac, 'ExtraBursatil')
            ELSE
               ACT(g:fac, '')
            ENDIF
         ENDIF
      ENDIF
   ENDIF

   IF EqStr(FBN['TipoOp'],'ASALDOPOSIC')
      SCN(t1, FBN['Cantidad'])
   ELSE
      IF [Incluido(FBN['TipoOp'],'DTP|CTC|CTP|TIC|TIFC|') y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'],'RTP|') y EqStr(FBN['Inv'],'INV')]
         SCN(t1, FBN['Cantidad'])
      ELSE
         SCN(t1, -FBN['Cantidad'])
      ENDIF
   ENDIF
   SetFont(a:fac..f:fac, 2)
   FormatoCeldas(f:fac, Exe('F2'))
Proximo
IF Val(t1) <> 0
   ifa
   ACT(a:fac, 'Total')
   ACN(f:fac, Val(t1))   
   SetFont(a:fac..f:fac, 1)
   FormatoCeldas(f:fac, Exe('F2'))
ENDIF

ifa
ifa

ACT(a:fac,'FIN DE LISTADO')
SetFont(a:fac, 1)

ACO(1, 8)
ACO(2, 10)
ACO(3, 15)
ACO(4, 6)
ACO(5, 6)
ACO(6, 10)
ACO(7, 20)

LimitesVision(g:fac+1)
Rangotitulo(a:1..g:fac+1, 6)
