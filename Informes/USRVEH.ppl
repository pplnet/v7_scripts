ACT(a3, 'Usuarios sin Vehiculo asignado')

ACT(a5, 'Codigo')
ACT(b5, 'Nombre')
ACT(c5, 'Perfil')
ACT(d5, 'Estado')
SetFilaActual(5)
SQL.ADD("Select Codigo, Nombre, Perfil, Status from "~DBO~".USUARIOS U where")
SQL.ADD("(Select Count(*) from "~DBO~".USRVEHICULO V where U.Codigo=V.Codigo) = 0")
recorrer SQL
  ACT(a:fac, fbn('Codigo'))
  ACT(b:fac, fbn('Nombre'))
  ACT(c:fac, fbn('Perfil'))

  if fbn['Status']=0
    ACT(d:fac, 'Habilitado')
  endif
  if fbn['Status']=1
    ACT(d:fac, 'No Habilitado')
  endif

proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z5, 1)
SetFont(a6..z:fac,2)

AgregarMarco(a5..d5, 1,0, Exe('COLOR'))
ACO(1, 12)
ACO(2, 20)
ACO(3, 10)
