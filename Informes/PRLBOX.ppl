acn(r4,1000)

CrearDialogo
Fecha1: 'Fecha';;;;;;;;;;FSYS
ListBox; 'Arial,8,N'; 510; 300
   'Marca'     ;m4..m:Val(z1);;;;;45;CHECK
   'Esp.Nr'    ;o4..o:Val(z1);Dialogo.Fecha1=FSYS;;;;55;STRING 
   'Fecha'     ;q4..q:Val(z1);;;;;80;FECHA
