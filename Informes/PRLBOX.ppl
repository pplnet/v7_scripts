   'Cta Propia';s4..s:Val(z1);;;;;110;COMBO;"TOMI|SOFI|KEVIN|VALEN"
   Val(z2)     ;t1..t:fac;;;;;40;COMBO;'A|B|C';'blue';;SI;;;;;;SI
FinListBox
FinDialogo

Recorrer&i 1,5
    ACD(C:FAC,FSYS+&i)
    if fac=3 or fac=4
        ACT(D:FAC,'SETEAR')
    else
        ACT(D:FAC,'NO-SETEAR')
    endif
    if fac=2
        ACN(A:FAC,1)
    endif
    ifa
Proximo
DFA
