** LICAJX ** Reimpresión de Libro de Caja
HojaVisible(NO)
CrearDialogo
   Fecha1     :'Fecha'      ;;;;  ;  ;;;;FSYS
   Fecha2     :'Hasta Fecha';;;;;;;;;FSYS;Dialogo.Fecha1
   Radio1     :'|Provisorio|Definitivo' ;;;;;NO;;;;;1
   Vehiculo1  : 'Vehiculo'  ;;;;NO;NO;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Especie1   :'Moneda Totales' ;;;;NO;NO;noVacio(Dialogo.Especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";   
   Check1:      'Imp.T.General'          ;;;;;;;;;1
   ListaTabla1: 'Excluye Op'             ;4;;;;;;;;;;;;;;'NrOperacion' ; 'NrOperacion;FechaOp;TipoOp;Cliente1;Especie;Cantidad' ; 'OPERACIONES'
   ListaTabla2: 'Excluye Tr'             ;4;2;;;;;;;;;;;;;'NrTrans'     ; 'NrTrans;Fecha1;TipoTr2;Especie' ; 'TRANSACCIONES2'   
FinDialogo

If not Ok
   Cancelar
endif

Recorrer&k Dialogo.Fecha1, Dialogo.Fecha2

  if EsHabil(&k, 'ARG')
  LinkearHoja('LICAJX',1,Fecha1 = &k, Fecha2 = &k, Radio1 =Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1, Especie1=Dialogo.Especie1,Check1=Dialogo.Check1,ListaTabla1 = Dialogo.ListaTabla1,ListaTabla2 = Dialogo.ListaTabla2)
  endif
Proximo