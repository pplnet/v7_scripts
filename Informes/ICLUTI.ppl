CrearDialogo
  Fecha1       : 'Utilizacion Desde'    ;1;1;;;;Dialogo.Fecha1 <> 0 y (Dialogo.Fecha1 = Dialogo.Fecha2 o Dialogo.Fecha1 < Dialogo.Fecha2);'Fecha Desde Invalida';NO;PriDeMes(Fsys,SI);
  Fecha2       : 'Utilizacion Hasta'    ;1;2;;;;Dialogo.Fecha2 <> 0 y (Dialogo.Fecha2=Fsys o Dialogo.Fecha2 < Fsys);'Fecha Hasta Invalida';NO;Fsys;
  Fecha3       : 'Vto CONU > a'         ;2;1;;;;Dialogo.Fecha3 >= Dialogo.Fecha1;'Fecha CONU debe ser mayor a Utilizacion Desde';NO;PriDeMes(Fsys,SI);
  NrOperacion1 : 'Nro. CONU'            ;3;1;;;;Vacio(Dialogo.NrOperacion1) o Incluido(Dialogo.NrOperacion1, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND TipoOp='CONU'  "));'Debe ingresar una Operacion Valida';NO;;;;;;"TipoOp  = 'CONU'"
  Book1        : 'Book'                 ; ;1;;;;Vacio(Dialogo.Book1) o Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VAR('VEHICULODE')~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%CONU|%') "));'Debe ingresar un Book Valido';NO;;;;;;" Estado  = 'HAB' and Vehiculo = '"~VAR('VEHICULODE')~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%CONU|%') "
  Termsheet    : 'TermSheet'            ; ; ;;;;
 FinDialogo

if Not OK
  Cancelar  
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))


SetFilaActual(3)
ACT(g:fac,'ICL - Reporte Utilizacion CONU')
SetFont(g:fac,3)
AlinearCeldas(g:fac,'D')

SetFilaActual(fac+1)
acn(w1,fac)

act(a:fac,'Fecha Utilizacion: '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2)
ifa
act(a:fac,'Fecha Vto CONU >= '~Dialogo.Fecha3)

if NoVacio(Dialogo.Book1)
   act(a:fac+1,'Book : '~Dialogo.Book1)
Else
   act(a:fac+1,'Book : Todos')
Endif
if NoVacio(Dialogo.NrOperacion1)
   act(a:fac+2,'CONU : '~Dialogo.NrOperacion1)
Else
   If NoVacio(Dialogo.Termsheet)
      act(a:fac+2,'TermSheet : '~Dialogo.Termsheet)
   else
      act(a:fac+2,'CONU : Todas')
   Endif   
Endif

SetFont(a:Val(w1)..a:Val(w1)+2,2)

SetFilaActual(fac+4)
acn(w2,fac)

ACT(a:fac,'Fecha Sdo.')
ACT(b:fac,'Nro. Op.')
ACT(c:fac,'Fecha Op.')
ACT(d:fac,'Fecha Vto.')
ACT(e:fac,'Cliente - Nombre')
ACT(f:fac,'Especie')
ACT(g:fac,'Cantidad Original')
ACT(h:fac,'Saldo Consumido')
ACT(i:fac,'Saldo Disponible')
ACT(j:fac, 'Monto PICO' )
ACT(k:fac, 'Monto PICD' )
ACT(l:fac, 'Afectado a Bonos')
* FJL 15/01/20 - Se agrega Termsheet ID
ACT(m:FAC, 'TermSheet ID')
*13/09/24 Se agrega  Operaciones bloqueadas
ACT(n:FAC, ' Bloqueada SI/NO')
* FJL 07/11/20 - Se agrega TipoCONU
ACT(o:FAC, 'Tipo CONU')

AlinearCeldas(g:Val(w2)..i:Val(w2),'D')
AgregarMarco(a:Val(w2)..o:Val(w2),2,0,EXE('COLOR'))
SetFont(a:Val(w2)..o:Val(w2),2)

SQL.ADD(" Select O.NrOperacion, Cliente1, Especie, TipoOp, Cantidad, Book1, FechaOp, ")
SQL.ADD("  FechaVto, C.RazonSocial, ")
* FJL 15/01/20 - Se agrega Termsheet ID
*SQL.ADD("  ObservacDoc as TSID,  ")
* FJL 07/11/20 - Por Issue 4523 se cambia el campo del TS y se agrega TipoCONU
SQL.ADD("  Termsheet as TSID, TipoCONU,  ")
SQL.ADD("  Precio1 as Tasa, TipoTasa as CodTasa, Spread, Especie1 as CodSpread, O.CB9,Cuotas2 Uti")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".CLIENTES C ")
SQL.ADD(" where (FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"'  or CB1=1) ")
SQL.ADD("   and O.Cliente1 = C.Codigo ")
SQL.ADD("   and O.NrOperacion = OB.NrOperacion ")
SQL.ADD("   and OB.NrBit in ('10','70') and OB.Valor = '1' ")
SQL.ADD("   and TipoOp in ('CONU')")   
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("   and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
else
  If NoVacio(Dialogo.Termsheet)
     SQL.ADD(" and Termsheet = '"~Dialogo.Termsheet~"' ")   
  endif   
Endif
if NoVacio(Dialogo.Book1)
   SQL.ADD("   and O.Book1 = '"~Dialogo.Book1~"' ")  
Endif      
*SQL.ADD("   and FechaOp Between "~IdxDate2(Dialogo.Fecha1)~" and  "~IdxDate2(Dialogo.Fecha2)~" ")
*SQL.ADD("   and FechaOp <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("Order by O.NrOperacion, FechaOp ")
**watch(SQL.Batch)

Recorrer SQL

   if fbn('FechaOp') > Dialogo.Fecha1
      ACD(fe:1,fbn('FechaOp'))
   Else
      ACD(fe:1,Dialogo.Fecha1)
   Endif
         
   Recorrer&k Val(fe:1), Dialogo.Fecha2
           
      if fbn('FechaOp') > &k
         DFA
      Else
         if EsHabil(&k, 'ARG')
            IFA
            ACN(fa:1,fac)
            ACD(a:fac, &k)     
            ACT(b:fac,fbn('NrOperacion'))
            ACLO(b:fac,fbn('NrOperacion'))         
            ACT(c:fac,fbn('FechaOp'))
            ACT(d:fac,fbn('FechaVto'))
            ACT(e:fac,fbn('Cliente1')~' - '~fbn('RazonSocial'))
            ACT(f:fac,fbn('Especie'))
            ** buscar cambios en Cantidad PMAUDIT
            ACN(g:fac,999999999)
            if fbn('Uti')=1
               SQL.ADD(" Select NrCuota,C.Nroperacion,Fecha1,C.Cliente1,C.Especie1,Cantidad1,Cantidad2 from CUOTAS C ")
               SQL.ADD(" where  C.Nroperacion='"~fbn('NrOperacion')~"' and Radio1=5 ")
               SQL.ADD(" and fecha1 =  (select min(fecha1) from CUOTAS where  Nroperacion='"~fbn('NrOperacion')~"' and Radio1=5 and Fecha1 > '"~IdxDate(val(a:fac))~"')")
               **watch(SQL.Batch)
               Recorrer SQL
                 DFA
                 ACN(g:val(fa:1),fbn('Cantidad2'))
               Proximo
            else
               ACN(g:fac,fbn('Cantidad'))
            endif
            if val(g:fac)=999999999
               ACN(g:fac,fbn('Cantidad'))
            endif
            ACN(h:fac,SQL("Select "~DBO~".SaldoCONU('"~fbn('NrOperacion')~"','"~IdxDate(&k)~"',2)"))
            *AsignarLink(h:fac,'DETICL',Fecha1=Dialogo.Fecha1,Fecha2=&k,NrOperacion1=fbn('NrOperacion'))
            AsignarLink(h:fac,'DETICL',Fecha1=Dialogo.Fecha1,Fecha2=&k,NrOperacion1=fbn('NrOperacion'))
            **ACN(i:fac,SQL("Select "~DBO~".SaldoCONU('"~fbn('NrOperacion')~"','"~IdxDate(&k)~"',1)"))
            ACN(i:fac,Val(g:fac)-Val(h:fac))
            *AsignarLink(i:fac,'DETICL',Fecha1=Dialogo.Fecha1,Fecha2=&k,NrOperacion1=fbn('NrOperacion'))
            AsignarLink(i:fac,'DETICL',Fecha1=Dialogo.Fecha1,Fecha2=&k,NrOperacion1=fbn('NrOperacion'))
            ACN(j:fac,SQL("select SUM(Cantidad) from "~DBO~".OPERACIONES where OperacionRef = '"~fbn('NrOperacion')~"' and FechaOp = '"~IdxDate(&k)~"' and TipoOp ='PICO' "))
            ACN(k:fac,SQL("select SUM(Cantidad) from "~DBO~".OPERACIONES where OperacionRef = '"~fbn('NrOperacion')~"' and FechaOp = '"~IdxDate(&k)~"' and TipoOp ='PICD' "))                 
            ** Cambiar Default cuando las PICO/PICD tengan el dato de afectacion
            ACT(l:fac, 'NO')
* FJL 15/01/20 - Se agrega Termsheet ID
            if EqStr(FBN['TipoOp'],'CONU')
              ACT(m:fac, FBN['TSID'])
* FJL 07/11/20 - Se agrega TipoCONU
              ACT(o:fac, FBN['TipoCONU'])
            endif
            * 13/09/24 Se agrega  Operaciones bloqueadas
            if EqStr(FBN['CB9'], '1') 
                ACT(n:fac,'SI')
            else
                ACT(n:fac,'NO')
            endif
         Endif
      Endif
   Proximo
Proximo
  
SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac,2)

Impresion(1,2)
Impresion(2,1)
Impresion(3,1)
Impresion(4,1)

LimitesVision(o:fac)
Rangotitulo(a:1..o:fac,Val(w2)+1)
SetPrintFit(3, 90)

ACO(1,7)
ACO(2,6)
ACO(3,8)
ACO(4,7)
