** CB00101 - PPLStudio test Informe
** Informe de prueba para Studio

CrearDialogo
  Fecha1    : 'Fecha'     ;;;;;;Dialogo.Fecha1<>0;'Fecha invalida';NO;FSys;
  Cantidad1 : 'Filas'     ;;;;;;Dialogo.Cantidad1>0;'Debe ser mayor a cero';NO;5;
FinDialogo

If Not Ok
  Cancelar
EndIf

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,10,B')

ACO(1,12)
ACO(2,20)
ACO(3,12)

** Titulos
ACT(a:1, 'Prueba de Studio')
ACT(a:2, 'Fecha')
ACT(b:2, Dialogo.Fecha1)
ACT(a:4, 'Nro')
ACT(b:4, 'Descripcion')
ACT(c:4, 'Importe')
SetFont(a:1..c:4, 2)

** Detalle
SetFilaActual(5)
&total := 0
Recorrer&i 1, Dialogo.Cantidad1
  ACN(a:fac, &i)
  ACT(b:fac, 'Fila numero ' ~ &i)
  ACN(c:fac, &i * 100)
  &total := &total + &i * 100
  SetFilaActual(fac+1)
Proximo

** Total
ACT(b:fac, 'Total')
ACN(c:fac, &total)
SetFont(a:5..c:fac, 1)
SetFont(b:fac..c:fac, 2)
AlinearCeldas(a:4..c:4, 'C')