*ModoReproceso(ConDialogo)
CrearDialogo
  Cliente1   : 'Cliente' ;;;;;;NoVacio(Dialogo.Cliente1);'Debe ingresar un Cliente';NO;
  TipoLimite1: 'Limite'  ;;;;;;NoVacio(Dialogo.TipoLimite1);'Debe ingresar un Tipo de Limite de Credito';NO;;;;;
  Vehiculo1  : 'Vehiculo';;;;;;;;;VAR('VEHICULODE')
  Fecha1     : 'Fecha'   ;;;;;;Dialogo.Fecha1>0;'Fecha incorrecta';NO;FSys;
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

ACT(a:4, 'Detalle de Limites de Credito')
ACT(a:5, 'Cliente : '~Dialogo.Cliente1)
ACT(a:6, 'Limite : '~Dialogo.TipoLimite1)
ACT(a:7, 'Fecha : '~Dialogo.Fecha1)

ACT(a:9, 'Cliente')
ACT(b:9, 'Limite')
ACT(c:9, 'Fecha')
ACT(d:9, 'Especie')
ACT(e:9, 'Operacion')
ACT(f:9, 'Tipo')
ACT(g:9, 'Cantidad')
ACT(h:9, 'Acumulado')
AgregarMarco(a:9..h:9,1,1,Exe('COLOR6'))
SetFont(a:1..h:9,2)

SetFilaActual(9)
SQL.ADD("Select * from "~DBO~".MOVLIMITES ")
SQL.ADD("where Cliente = '"~Dialogo.Cliente1~"' ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD("and FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and Bits = 'P' ")
if EqStr(Dialogo.TipoLimite1,'SETTLEMENT')
  SQL.ADD("and (")
  SQL.ADD("(Limite = '"~Dialogo.TipoLimite1~"' and FechaLim = '"~IdxDate(Dialogo.Fecha1)~"') ")
  SQL.ADD(")")
  SQL.ADD("order by Limite,Especie,FechaMov")
else
   if NoVacio(Dialogo.TipoLimite1)
      SQL.ADD("and Limite = '"~Dialogo.TipoLimite1~"'            ")
   else
      SQL.ADD("and Limite IN ('BCRAN','ACROFEX','ACMAN')    ")
   endif

   SQL.ADD("order by FechaMov  ")
endif

recorrer SQL
  ACN(x1, SQL("Select Sum(Monto) from "~DBO~".MOVLIMITES where NrOperacion='"~FBN['NrOperacion']~"' and Limite='"~FBN['Limite']~"' and Cliente='"~FBN['Cliente']~"' and Especie='"~FBN['Especie']~"' and Bits ='P' and FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"'"))
  if Val(x1)>0.01 o Val(x1)<-0.01
    ACT(a:FAC, FBN['Cliente'])
    ACT(b:FAC, FBN['Limite'])
    ACT(c:FAC, FBN['FechaMov'])
    ACT(d:FAC, FBN['Especie'])
    ACT(e:FAC, FBN['NrOperacion'])
    if EqStr(Copy(FBN['NrOperacion'],1,2),'AA')
      ACT(f:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',FBN['NrOperacion']))
    else
      ACT(f:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion']))
    endif
    ACN(g:FAC, FBN['Monto'])
    ACN(h:FAC, Val(h:FAC-1)+Val(g:FAC))
*    ACLO(e:fac, Val(e:fac))
  else
    DFA
  endif
proximo

SetFont(a:10..h:FAC,1)
SetFilaActual(FAC+2)
ACT(f:FAC, 'Limite Consumido')
ACN(h:FAC, Sum(g:10..g:Fac)  )

IF NO
  if EqStr(Dialogo.TipoLimite1,'SETTLEMENT')
    ACN(h:FAC, LimSumado(Dialogo.Cliente1, 'SETTLEMENT',Dialogo.Fecha1,Dialogo.Vehiculo1))
  *  SCN(h:FAC, LimSumado(Dialogo.Cliente1, 'SETTFAIL'  ,Dialogo.Fecha1,Dialogo.Vehiculo1))  
  else
  *  if EqStr(Dialogo.TipoLimite1,'BCRAN')
    if Incluido(Dialogo.TipoLimite1,'BCRAN|ACROFEX|')
      ACN(h:FAC, LimConsumido(Dialogo.Cliente1, Dialogo.TipoLimite1,'ARP',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))
    else
      ACN(h:FAC, LimConsumido(Dialogo.Cliente1, Dialogo.TipoLimite1,'USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))
    endif
  endif
ENDIF

SetFont(f:FAC..h:FAC,2)
FormatoCeldas(g:10..h:FAC,EXE('F2'))

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,10)
ACO(8,10)

LimitesVision(h:FAC)
