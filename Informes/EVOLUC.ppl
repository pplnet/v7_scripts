SetFilaActual(FAC+2)

SQL.ADD("Select IO.Fecha Momento, IO.Mensaje Mensaje, I.Nombre NomI, U.Nombre NomU, O.NrOperacion Oper  ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".INSTANCIASOP IO, "~DBO~".INSTANCIAS I, "~DBO~".USUARIOS U ")
SQL.ADD(" where  O.NrOperacion = '"~Dialogo.NrOperacion1~"'  ")
SQL.ADD(" and   IO.NrOperacion = O.NrOperacion ")
SQL.ADD(" and   IO.NrInstancia = I.NrInstancia ")
SQL.ADD(" and   IO.Usuario     = U.Codigo      ")
SQL.ADD(" and   I.Tabla        = 'OPERACIONES' ")
SQL.ADD(" Order By Momento ")


