ModoReproceso(ConDialogo)
CrearDialogo
  Cliente1   : "Entidad"      ;;;
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : "Especie"      ;;;
  Fecha1     : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys+30
  TipoOp1    : "Tipo Op."     ;;;
FinDialogo
if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Caida de Depositos a Plazo por Entidad")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+1, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+1, 'Entidad : Todos')
endif
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+2, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+2, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+3, 'Especie : Todos')
endif
ACT(a:FAC+4, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+6, 'Tipo Op.: '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
 else
  ACT(a:FAC+6, 'Tipo Op.: Todos')
endif
SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

SQL.ADD("Select O.Cliente1, O.Especie, O.Vehiculo1, O.FechaOp, O.TipoOp, O.NrOperacion, ")
SQL.ADD(" C.Fecha2 as Vto, ")
SQL.ADD(" CASE TipoOp WHEN 'MMCDIA' THEN C.Cantidad3 ELSE C.Total1 END Cant ")
*- SQL.ADD(" CASE TipoOp When 'MMCDIA' Then C.Cantidad3 ")
*- SQL.ADD("             Else  C.Total1 END Cant ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMCDIA','MMCDP','MMCP','MMCPM','MMD','MMDCA','MMO','SEABP','SERP','SERPV') ")
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Cliente1, O.Especie, O.Vehiculo1, O.FechaOp, O.TipoOp, O.NrOperacion, ")
SQL.ADD(" O.FechaVto as Vto,  ")
SQL.ADD(" CASE TipoOp WHEN 'MMCDIA' THEN O.Cantidad WHEN 'MMCP' THEN O.TotalNetoCli1 WHEN 'MMDCA' THEN O.Cantidad+O.TotalNetoCli2 WHEN 'MMO  ' THEN O.TotalBrutoCli1 ELSE O.Cantidad+O.TotalIntereses END Cant ")
*- SQL.ADD(" CASE TipoOp When 'MMCDIA' Then O.Cantidad ")
*- SQL.ADD("             When 'MMCP'   Then O.TotalNetoCli1 ")
*- SQL.ADD("             When 'MMCP'   Then O.TotalNetoCli1 ")
*- SQL.ADD("             When 'MMDCA'  Then O.Cantidad+O.TotalNetoCli2 ")
*- SQL.ADD("             When 'MMO  '  Then O.TotalBrutoCli1 ")
*- SQL.ADD("             Else  O.Cantidad+O.TotalIntereses END Cant")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
* SQL.ADD("where O.NrOperacion Not In (Select C.NrOperacion from "~DBO~".CUOTAS C where C.NrOperacion = O.NrOperacion) ")
SQL.ADD("where O.TipoOp In ('MMCDIA','MMCP','MMCPM','MMD','MMDCA','MMCCR','MMO','SEABP','SERP','SERPV') ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" Union All ")
SQL.ADD("Select O.Cliente1, O.Especie, O.Vehiculo1, O.FechaOp, O.TipoOp, O.NrOperacion, ")
SQL.ADD(" CASE Plazo2 WHEN 0 THEN O.FechaVto ELSE O.FechaVto2 END  Vto, ")
SQL.ADD(" CASE Plazo2 WHEN 0 THEN O.TotalBrutoCli1 ELSE O.TotalAux3 END Cant ")
*- SQL.ADD(" CASE Plazo2 When 0 Then O.FechaVto Else O.FechaVto2 End Vto, ")
*- SQL.ADD(" CASE Plazo2 When 0 Then O.TotalBrutoCli1 Else O.TotalAux3 End Cant ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where  O.TipoOp In ('MMCDP')  ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and O.TipoOp = '"~Dialogo.TipoOp1~"'")
endif
SQL.ADD(" and ((Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD("     or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2<='"~IdxDate(Dialogo.Fecha2)~"')) ")
SQL.ADD("order by 1, 2, 4 ")

ACT(X1,' ')
ACT(X3,' ')
acn(x2,0)
acn(x4,0)
acn(x5,0)
Recorrer SQL
message(fbn['Cliente1']~' '~fbn['Especie'])
  if Not EqStr(val(x1),fbn['Cliente1'])
     if Not EqStr(val(x3),' ')
        act(a:fac,'Total  '~val(x3))
        acn(c:fac,val(x5))
        SetFont(a:FAC..c:FAC,2)
        AgregarMarco(a:FAC..b:FAC,2,0)
        AgregarMarco(c:FAC..g:FAC,2,0)
        ifa
        ifa
     endif

     if val(x2) > 0
        ifa
        ifa
     endif
     act(x1,fbn['Cliente1'])
     act(a:fac,'Entidad')
     ACT(b:FAC, fbn['Cliente1'])
     SetFont(a:FAC..g:FAC,2)
     AgregarMarco(a:FAC..a:FAC,2,0,Exe('COLOR'))
     AgregarMarco(b:FAC..g:FAC,2,0,Exe('COLOR'))

     ifa
     acn(x5,0)
     act(x3,fbn['Especie'])
     act(a:fac,'Especie')
     ACT(b:FAC, fbn['Especie'])
     AgregarMarco(a:FAC..a:FAC,2,0)
     AgregarMarco(b:FAC..g:FAC,2,0)
     SetFont(a:FAC..g:FAC,2)

     ifa
     act(a:fac,'Fecha Vto.')
     act(b:fac,'Plazo Rem.')
     act(c:fac,'Importe')
     act(d:fac,'Vehiculo')
     act(e:fac,'Fecha Op.')
     act(f:fac,'Tipo Op.')
     act(g:fac,'Numero Op.')
     AgregarMarco(a:FAC..g:FAC,2,1)
     SetFont(a:FAC..g:FAC,2)
     ifa
     acn(x2,1)
  endif
  if Not EqStr(val(x3),fbn['Especie'])
     act(a:fac,'Total  '~val(x3))
     acn(c:fac,val(x5))
     SetFont(a:FAC..c:FAC,2)
     AgregarMarco(a:FAC..b:FAC,2,0)
     AgregarMarco(c:FAC..g:FAC,2,0)
     ifa
     ifa

     acn(x4,1)
     acn(x5,0)
     act(x3,fbn['Especie'])
     act(a:fac,'Especie')
     ACT(b:FAC, fbn['Especie'])
     AgregarMarco(a:FAC..a:FAC,2,0)
     AgregarMarco(b:FAC..g:FAC,2,0)
     SetFont(a:FAC..g:FAC,2)

     ifa
     act(a:fac,'Fecha Vto.')
     act(b:fac,'Plazo Rem.')
     act(c:fac,'Importe')
     act(d:fac,'Vehiculo')
     act(e:fac,'Fecha Op.')
     act(f:fac,'Tipo Op.')
     act(g:fac,'Numero Op.')
     AgregarMarco(a:FAC..g:FAC,2,1)
     SetFont(a:FAC..g:FAC,2)
     ifa
  endif
  acd(a:fac,fbn['Vto'])
  acn(b:fac,fbn['Vto']-Fsys)
  acn(c:fac,fbn['Cant'])
  act(d:fac,fbn['Vehiculo1'])
  acd(e:fac,fbn['FechaOp'])
  act(f:fac,fbn['TipoOp'])
  act(g:fac,fbn['NrOperacion'])
  aclo(g:fac,fbn['NrOperacion'])
  scn(x5,fbn['Cant'])
  SetFont(a:FAC..g:FAC,1)
  FormatoCeldas(c:fac..c:fac,Exe('F2'))
  FormatoCeldas(b:fac..b:fac,"0")
proximo

if Not EqStr(val(x3),' ')
   act(a:fac+1,'Total  '~val(x3))
   acn(c:fac+1,val(x5))
   SetFont(a:FAC+1..c:FAC+1,2)
   AgregarMarco(a:FAC+1..b:FAC+1,2,0)
   AgregarMarco(c:FAC+1..g:FAC+1,2,0)
   ifa
   ifa
endif

ACO(1,8)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,12)
ACO(6,9)
ACO(7,12)
ACO(8,8)
ACO(9,8)
ACO(10,9)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(g:FAC)
*RangoTitulo(a1..k:8,36)
RangoTitulo(a1..g:FAC, 12)

