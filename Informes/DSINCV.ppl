CrearDialogo
  Fecha1     : "Fecha Desde"    ; 1; ; ;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "Fecha Hasta"    ; 2; ; ;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  Cliente1   : "Cliente"  ;  ; ; ;;;
  Mercado1   : "Mercado"  ;  ; ; ;;;
  Cuenta1    : "Cuenta"   ;  ; ; ;;;
  Especie1   : "Moneda"   ;  ; ; ;;;
  Vehiculo1  : "Vehiculo" ;  ; ; ;;;;;;VAR('VEHICULODE')
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

* Reconstruye saldos por si se hubiera desliquidado FValor
EjecutarEvento('DES81')

ACT(x:1, VAR('MERCUSMON'))

SetFilaActual(4)
ACT(a:fac, 'Detalle de Saldo Cuenta Vista')
SetFont(a:fac,3)

SetFilaActual(fac+2)
ACT(a:fac, 'Fecha Desde: ' ~ Dialogo.Fecha1)
ACT(c:fac, 'Fecha Hasta: ' ~ Dialogo.Fecha2)
ACT(a:fac+1, 'Cliente')
ACT(c:fac+1, IIF(NoVacio(Dialogo.Cliente1), Dialogo.Cliente1~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1), 'Todos'))
ACT(a:fac+2, 'Vehiculo')
ACT(c:fac+2, IIF(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))


AlinearCeldas(b:fac,'I')
SetFont(a:fac..a:FAC+2,2)
SetFont(a:fac..a:FAC+2,1)

SetFilaActual(fac+4)

ACT(a:fac, 'Fecha')
ACT(b:fac, 'Cliente')
ACT(c:fac, 'Especie')
ACT(d:fac, 'Cuenta')
ACT(e:fac, 'Mercado')
ACT(f:fac, 'Leyenda')
ACT(g:fac, 'Saldo')
ACT(h:fac, 'TipoOp')
ACT(i:fac, 'NrOperacion')

SetFont(a:fac..p:fac,2)
AgregarMarco(a:fac..i:fac,0,0,Exe('COLOR'))
ACN(w:1, FAC)


SQL.ADD("SELECT  Cliente, Especie, Mercado, EnteCustodia, Cuenta, Saldo, Cupon, Fecha, Leyenda, NrOperacion, Query")
SQL.ADD("FROM (")

*Saldo hasta la fecha
SQL.ADD("SELECT         S1.Cliente, S1.Mercado, S1.Cuenta,  S1.Especie, "~IdxDate2(Dialogo.Fecha1-1)~" Fecha,")
SQL.ADD("        ISNULL(S1.Cupon, '') AS Cupon, Sum(S1.Saldo) Saldo,   S1.EnteCustodia, '' As Leyenda, '' As NrOperacion, 1 as Query")
SQL.ADD("  FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD(" WHERE S1.NrSaldo = 81")
SQL.ADD("   and S1.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("   and round(S1.Saldo,2) <> 0 ")
IIF(NoVacio(Dialogo.Cliente1) , SQL.ADD("and S1.Cliente      = '"~Dialogo.Cliente1~"' ") ,"")
IIF(NoVacio(Dialogo.Mercado1),  SQL.ADD("and S1.Mercado = '"~Dialogo.Mercado1~"'       "),"")
IIF(NoVacio(Dialogo.Cuenta1),   SQL.ADD("and S1.Cuenta = '"~Dialogo.Cuenta1~"'         "),"")
IIF(NoVacio(Dialogo.Especie1),  SQL.ADD("and S1.Especie = '"~Dialogo.Especie1~"'       "),"")
IIF(NoVacio(Dialogo.Vehiculo1), SQL.ADD("and S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' "),"")

SQL.ADD("  and S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE IsNull(S2.Cliente,'')      = IsNull(S1.Cliente,'')      ")
SQL.ADD("                    and IsNull(S2.Especie,'')      = IsNull(S1.Especie,'')      ")
SQL.ADD("                    and IsNull(S2.EnteCustodia,'') = IsNull(S1.EnteCustodia,'') ")
SQL.ADD("                    and IsNull(S2.Mercado,'')      = IsNull(S1.Mercado,'')      ")
SQL.ADD("                    and IsNull(S2.NrSaldo,'')      = IsNull(S1.NrSaldo,'')      ")
SQL.ADD("                    and IsNull(S2.Cuenta,'')       = IsNull(S1.Cuenta,'')       ")
SQL.ADD("                    and IsNull(S2.Book,'')         = IsNull(S1.Book,'')         ")
SQL.ADD("                    and IsNull(S2.Cupon,'') = IsNull(S1.Cupon,'')               ")
SQL.ADD("                    and S2.Fecha       < '"~IdxDate(Dialogo.Fecha1)~"' )        ")
SQL.ADD("GROUP BY Cliente, Mercado, Cuenta, Especie, Cupon, EnteCustodia")

*Rueda Garantizada invierto cantidad
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT        S3.Cliente,              S3.Mercado,  S3.Cuenta,   S3.Especie, S3.FechaMov Fecha, ")
SQL.ADD("       ISNULL(S3.Cupon, '') AS Cupon, -S3.Cantidad, S3.EnteCustodia,  S3.Leyenda, S3.NrOperacion, 2 As Query")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS S3")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONES O")
SQL.ADD("    on  S3.NrOperacion  = O.NrOperacion")
SQL.ADD("WHERE  ")
SQL.ADD("        ((O.TipoOp  in('TIC','TIV') and (O.CB4 = 1 or O.Cliente1=O.Vehiculo1)) OR (O.TipoOp  in('TCOPRI')))")
SQL.ADD("    and S3.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("    and S3.NrSaldo = 1")
SQL.ADD("    and S3.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' " )
SQL.ADD("    and S3.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' " )
IIF(NoVacio(Dialogo.Cliente1),  SQL.ADD("    and S3.Cliente = '"~Dialogo.Cliente1~"' "      ),"")
IIF(NoVacio(Dialogo.Mercado1),  SQL.ADD("    and S3.Mercado = '"~Dialogo.Mercado1~"'       "),"")
IIF(NoVacio(Dialogo.Cuenta1),   SQL.ADD("    and S3.Cuenta = '"~Dialogo.Cuenta1~"'         "),"")
IIF(NoVacio(Dialogo.Especie1),  SQL.ADD("    and S3.Especie = '"~Dialogo.Especie1~"'       "),"")
IIF(NoVacio(Dialogo.Vehiculo1), SQL.ADD("    and S3.EnteCustodia = '"~Dialogo.Vehiculo1~"' "),"")
    
*Resto de los movimientos 
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT        S3.Cliente,             S3.Mercado,  S3.Cuenta,  S3.Especie, S3.FechaMov Fecha,")
SQL.ADD("       ISNULL(S3.Cupon, '') AS Cupon, S3.Cantidad, S3.EnteCustodia, S3.Leyenda, S3.NrOperacion, 2 As Query")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS S3")
SQL.ADD("LEFT JOIN "~DBO~".OPERACIONES O")
SQL.ADD("    on  S3.NrOperacion  = O.NrOperacion")
SQL.ADD("WHERE   ")
SQL.ADD("    not((IsNull(O.TipoOp,'') in('TIC','TIV') and (IsNull(O.CB4, 0) = 1 or IsNull(O.Cliente1,'')=IsNull(O.Vehiculo1,''))) OR (IsNull(O.TipoOp,'') in('TCOPRI')))")
SQL.ADD("    and S3.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("    and S3.NrSaldo = 1")
SQL.ADD("    and S3.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' " )
SQL.ADD("    and S3.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' " )
IIF(NoVacio(Dialogo.Cliente1),  SQL.ADD("    and S3.Cliente = '"~Dialogo.Cliente1~"' "      ),"")
IIF(NoVacio(Dialogo.Mercado1),  SQL.ADD("    and S3.Mercado = '"~Dialogo.Mercado1~"'       "),"")
IIF(NoVacio(Dialogo.Cuenta1),   SQL.ADD("    and S3.Cuenta = '"~Dialogo.Cuenta1~"'         "),"")
IIF(NoVacio(Dialogo.Especie1),  SQL.ADD("    and S3.Especie = '"~Dialogo.Especie1~"'       "),"")
IIF(NoVacio(Dialogo.Vehiculo1), SQL.ADD("    and S3.EnteCustodia = '"~Dialogo.Vehiculo1~"' "),"")

SQL.ADD(") SaldoTotal")
SQL.ADD("ORDER BY Cliente, Mercado, Cuenta, Especie, Cupon, Fecha")

WATCH(SQL.BATCH())

*Cambios en la cuenta
ACT(aa:1, "")
*Suma del Total
ACN(ab:1, 0)

Recorrer SQL
  If(Not EqStr(fbn('Cliente')~fbn('Mercado')~fbn('Especie')~fbn('Cuenta'), val(aa:1)))
      If(Not EqStr(val(aa:1), ""))
          ACT(f:fac,'Saldo Final')
          ACN(g:fac, val(ab:1))
          ACN(ab:1,0)
          SetFont(f:fac..g:fac,2)
          ifa
          ifa
      EndIf
      
*      ACT(a:fac, fbn('Cliente'))
*      ACT(b:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente')))
*      ACT(c:fac, fbn('Especie'))
*      ACT(d:fac, Copy(fbn('cuenta')~' - '~BuscarCampo('CUENTAS','Nombre','Codigo', fbn('cuenta')),1,50))
*      ACT(e:fac, fbn('Mercado'))
      act(a:fac, fbn('Cliente')~' - '~Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente')),1,50)~' - '~fbn('Especie')~' - '~fbn('Mercado')~' - '~Copy(fbn('cuenta')~' - '~BuscarCampo('CUENTAS','Nombre','Codigo', fbn('cuenta')),1,50))
      SetFont(a:fac..e:fac,2)
      AgregarMarco(a:fac..e:fac,0,0,Exe('COLOR'))
      
      ifa
      ifa
      ACT(f:fac,'Saldo Inicial')
      ACN(g:fac, IIF(fbn('Query')=1, fbn('Saldo'), 0))
      SetFont(f:fac..g:fac,2)
      ACN(ab:1, val(ab:1)+val(g:fac))
      IF fbn('Query')=2
         ifa
      endif   
      ACT(aa:1, fbn('Cliente')~fbn('Mercado')~fbn('Especie')~fbn('Cuenta'))
  EndIf 
  If(fbn('Query')=2)
      ACD(a:fac, fbn('Fecha'))
      ACT(b:fac, fbn('Cliente'))  
      ACT(c:fac, fbn('Especie'))
      ACT(d:fac, Copy(fbn('cuenta')~' - '~BuscarCampo('CUENTAS','Nombre','Codigo', fbn('cuenta')),1,50))
      ACT(e:fac, fbn('Mercado'))
      ACT(f:fac, fbn('Leyenda'))
      ACN(g:fac, fbn('Saldo'))
      ACT(h:fac, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion')))
      ACT(i:fac, fbn('NrOperacion'))
      
      ACN(ab:1, val(ab:1)+val(g:fac))
      SetFont(a:fac..p:fac,1)
  EndIf

Proximo
ifa
ACT(f:fac,'Saldo Final')
ACN(g:fac, val(ab:1)) 
ACN(ab:1,0)
SetFont(f:fac..g:fac,2)
ifa

