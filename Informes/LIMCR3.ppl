SetFilaActual(8)
SQL.ADD("Select Codigo, RazonSocial from "~DBO~".CLIENTES")
Recorrer SQL

  if DesciendeDeCliente(fbn('Codigo'), 'BANCOS') y EsTerminal(fbn('Codigo'), Cliente)
    ACT(a:fac, fbn('Codigo'))

    ACT(b:fac, SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~val(a:fac)~"' and Limite='COTOR'      ") )
    ACT(f:fac, SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~val(a:fac)~"' and Limite='CONTRACT'   ") )
    ACT(j:fac, SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~val(a:fac)~"' and Limite='PRESETTLEM' ") )
    ACT(n:fac, SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~val(a:fac)~"' and Limite='CUSTODY'    ") )
    ACT(r:fac, SQL("SELECT Especie FROM "~DBO~".LIMASIGNADOS WHERE Cliente='"~val(a:fac)~"' and Limite='SETTLEMENT' ") )

    ACN(c:fac, LimAsignado(fbn('Codigo'), 'COTOR'     ,val(b:fac)))
    ACN(g:fac, LimAsignado(fbn('Codigo'), 'CONTRACT'  ,val(f:fac)))
    ACN(k:fac, LimAsignado(fbn('Codigo'), 'PRESETTLEM',val(j:fac)))
    ACN(o:fac, LimAsignado(fbn('Codigo'), 'CUSTODY'   ,val(n:fac)))
    ACN(s:fac, LimAsignado(fbn('Codigo'), 'SETTLEMENT',val(r:fac)))

    ACN(d:fac, LimConsumido(fbn('Codigo'), 'COTOR'     ,val(b:fac),0,,,,,Dialogo.Fecha1))
    ACN(h:fac, LimConsumido(fbn('Codigo'), 'CONTRACT'  ,val(f:fac),0,,,,,Dialogo.Fecha1))
    ACN(l:fac, LimConsumido(fbn('Codigo'), 'PRESETTLEM',val(j:fac),0,,,,,Dialogo.Fecha1))
    ACN(p:fac, LimConsumido(fbn('Codigo'), 'CUSTODY'   ,val(n:fac),0,,,,,Dialogo.Fecha1))
    SCN(t:fac, LimConsumido(fbn('Codigo'), 'SETCRE'    ,val(r:fac),0,,,,,Dialogo.Fecha1))

    if Val(d:fac)<>0
       AsignarLink(d:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1='COTOR')
    endif
    if Val(h:fac)<>0
       AsignarLink(h:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1='CONTRACT')
    endif
    if Val(l:fac)<>0
       AsignarLink(l:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1='PRESETTLEM')
    endif
    if Val(p:fac)<>0
       AsignarLink(p:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1='CUSTODY')
    endif
    if Val(t:fac)<>0
       * AsignarLink(o:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1='SETTLEMENT')
       AsignarLink(t:fac,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1='SETCRE')
    endif

    ACN(e:fac, Val(c:fac)-Val(d:fac))
    ACN(i:fac, Val(g:fac)-Val(h:fac))
    ACN(m:fac, Val(k:fac)-Val(l:fac))
    ACN(q:fac, Val(o:fac)-Val(p:fac))
    ACN(u:fac, Val(s:fac)-Val(t:fac))
  else
    dfa
  endif
proximo

