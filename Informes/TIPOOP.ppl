recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN['Codigo'])
  ACT(b:FAC, FBN['Nombre'])
  if NoVacio(FBN['Inversa'])
    ACT(c:FAC, FBN['Inversa'])
