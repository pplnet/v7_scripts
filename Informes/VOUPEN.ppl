ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'   ;;;;;;;;;Habiles(FSys,-1,'ARG')
  Cliente1 : 'Cliente' ;
  Mercado1 : 'Mercado' ;
  Vehiculo1: 'Vehiculo';
FinDialogo
If Not OK
  Cancelar
EndIf

if Incluido(Dialogo.Mercado1,VAR('MERCAACMC'))
   Cancelar('El Mercado es Incorrecto.')
Endif


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(y1, Fecha(Habiles(Dialogo.Fecha1,1,'ARG'), 'YYYY.MM.DD'))

SetFilaActual(4)
ACN(W1,FAC)

ACT(A:FAC,'Vouchers Pendientes de Confirmacion')
ACT(A:FAC+1,'Fecha: '~Dialogo.Fecha1)
ACT(A:FAC+2,'Cliente: '~iif(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(A:FAC+3,'Mercado: '~iif(NoVacio(Dialogo.Mercado1),Dialogo.Mercado1,'Todos'))
ACT(A:FAC+4,'Vehiculo: '~iif(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))

ACT(A:FAC+6,'Cliente')
ACT(B:FAC+6,'Especie')
ACT(C:FAC+6,'Nr.Compr.')
ACT(D:FAC+6,'Nr.Operac.')
ACT(E:FAC+6,'Merc.')
ACT(F:FAC+6,'Mod.Liq.')
ACT(G:FAC+6,'Fecha')
ACT(H:FAC+6,'Cant.Especie')
ACT(I:FAC+6,'Cant.Moneda')
ACT(J:FAC+6,'Observaciones')

AlinearCeldas(G:FAC+6..I:FAC+6,'D')
SetFont(A:FAC..J:FAC+6,2)
AgregarMarco(A:FAC+6..K:FAC+6,2,0,EXE('COLOR6'))

SetFilaActual(FAC+6)

Message('Leyendo Transacciones')
SQL.ADD("Select * from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where Fecha2<='"~IdxDate(DIALOGO.FECHA1)~"' ")
SQL.ADD(" and TipoTr2 in ('DEP','RET','COMP','MATCH','TRACTA','COBROS','PAGOS') ")
SQL.ADD(" and T.Mercado1  not in("~Pipe2Comillas(VAR('MERCAACMC'))~")  ")
SQL.ADD(" and Not T.NrTrans in (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrInstancia = 30 and Convert(Char,I.Fecha,102) = '"~Val(y1)~"') ")
SQL.ADD(" and EXISTS (Select * FROM "~DBO~".OPERACIONESBITS B ")
SQL.ADD("             where T.NrTrans = B.NrOperacion ")
SQL.ADD("             and (")
SQL.ADD("                    (NrBit=3 and Valor='1') ")
SQL.ADD("                 or (NrBit=6 and Valor='1') ")
SQL.ADD("                 ) ")
SQL.ADD("            ) ")
If NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente1='"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Mercado1)
  SQL.ADD(" and Mercado1='"~Dialogo.Mercado1~"' ")
EndIf
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" and Mercado1 not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD(" ORDER BY Fecha2,Cliente1,Especie,Especie1,Mercado1 ")
Recorrer SQL
  If FBN['Fecha2']<>Val(v5)
    If FAC>Val(W1)+6
      If Val(X1)>1
        ACT(G:FAC, 'Totales')
        ACN(H:FAC, SUM(H:FAC-Val(X1)..H:FAC-1))
        ACN(I:FAC, SUM(I:FAC-Val(X1)..I:FAC-1))
        SetFont(G:FAC..I:FAC,2)
        IFA
      EndIf
      IFA
      AgregarMarco(A:FAC..K:FAC,2)
    EndIf
    ACD(V5, FBN['Fecha2'])
    ACT(A:FAC, 'Liquidacion del '~Fecha(Val(V5)))
    SetFont(A:FAC,2)
    SetFilaActual(FAC+1)
    ACN(X1,0)
    ACT(V1,'@')
    ACT(V2,'@')
    ACT(V3,'@')
  EndIf
  If Not EqStr(FBN['Cliente1'],Val(V1)) o Not EqStr(FBN['Especie'],Val(V2)) o [NoVacio(FBN['Especie1']) y Not EqStr(FBN['Especie1'],Val(V3))] o Not EqStr(FBN['Mercado1'],Val(V4))
    If FAC>Val(W1)+6
      If Val(X1)>1
        ACT(G:FAC, 'Totales')
        ACN(H:FAC, SUM(H:FAC-Val(x1)..H:FAC-1))
        ACN(I:FAC, SUM(I:FAC-Val(x1)..I:FAC-1))
        SetFont(G:FAC..I:FAC,2)
        IFA
      EndIf
      IFA
    EndIf
    ACN(X1,0)
    If Not EqStr(FBN['Cliente1'],Val(V1))
      ACT(V1, FBN['Cliente1'])
      ACT(A:FAC,Val(V1))
    EndIf
    ACT(V2,FBN['Especie'])
    ACT(V3,' ')
    ACT(V3,FBN['Especie1'])
    ACT(V4,FBN['Mercado1'])
    ACT(B:FAC,Val(V2))
    If EqStr(FBN['TipoTr2'],'MATCH')
      ACT(B:FAC,Val(B:FAC)~'/'~Val(V3))
    EndIf
    SetFont(A:FAC..B:FAC,2)
  EndIf
  SCN(X1,1)
  ACT(C:FAC, FBN['NrTrans'])
  ACLT(c:FAC, FBN['NrTrans'])
  ACT(D:FAC, Copy(FBN['NrOperacionRef1'],1,8))
  if EqStr(Copy(FBN['NrOperacionRef1'],1,1),'V') O Eqstr(fbn('Mercado1'), Var('MERCOCT'))
    ACLT(d:FAC, FBN['NrOperacionRef1'])
  else
    ACLO(d:FAC, FBN['NrOperacionRef1'])
  endif
  ACT(E:FAC, FBN['Mercado1'])
  If EqStr(FBN['TipoTr2'],'MATCH')
    ACT(F:FAC, 'Match')
  EndIf
  If Incluido(FBN['TipoTr2'],'DEP|RET')
    If Incluido(FBN['Mercado1'],'EU|CE|CRYL')
      If EqStr(Copy(FBN['NrOperacionRef1'],1,1),'I')
        ACT(F:FAC, 'STD')
      Else
        DFA
        SQL.ADD(" Select * from "~DBO~".OPERACIONES WHERE NrOperacion = '"~FBN['NrOperacionRef1']~"' ")
        Recorrer SQL
          If Incluido(FBN['TipoOp'],'TIC|TIV|LICITA|RESCAT')
            If FBN['FormaLiquidacion2']=0
              ACT(F:FAC, 'FD&P')
            EndIf
            If FBN['FormaLiquidacion2']=2
              ACT(F:FAC, 'FOP')
            EndIf
          EndIf
          If Incluido(FBN['TipoOp'],'TIFC|TIFV')
            If FBN['FormaLiquidacion1']=0
              ACT(F:FAC, 'FD&P')
            EndIf
            If FBN['FormaLiquidacion1']=2
              ACT(F:FAC, 'FOP')
            EndIf
          EndIf
        Proximo
      EndIf
    Else
      if NoVacio(fbn('NrOperacionRef1')) y Incluido(Copy(fbn('NrOperacionRef1'),1,2),'FX|FA')
        ACN(x3, BuscarCampo('OPERACIONES','FormaLiquidacion1','NrOperacion',fbn('NrOperacionRef1')))
        ACT(x4, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')))
        ACT(x5, BuscarCampo('OPERACIONES','Especie','NrOperacion',fbn('NrOperacionRef1')))
        if Val(x3)=0
          ACT(f:FAC, 'STD')
        endif
        if Incluido(Val(x4),'FXC|FXCT|FXA|FXAT')
          if Val(x3)=1
            if EqStr(fbn('Especie'),Val(x5))
              ACT(f:FAC, 'Conf.')
            else
              ACT(f:FAC, 'DVP')
            endif
          endif
          if Val(x3)=2
            if EqStr(fbn('Especie'),Val(x5))
              ACT(f:FAC, 'RVP')
            else
              ACT(f:FAC, 'Conf.')
            endif
          endif
        else
          if Val(x3)=1
            if EqStr(fbn('Especie'),Val(x5))
              ACT(f:FAC, 'DVP')
            else
              ACT(f:FAC, 'Conf.')
            endif
          endif
          if Val(x3)=2
            if EqStr(fbn('Especie'),Val(x5))
              ACT(f:FAC, 'Conf.')
            else
              ACT(f:FAC, 'RVP')
            endif
          endif
        endif
      else
        If FBN['CB6']=1
          ACT(F:FAC, 'DVP')
        EndIf
        If FBN['CB7']=1
          ACT(F:FAC, 'RVP')
        EndIf
        If FBN['CB8']=1
          ACT(f:FAC, 'Conf.')
        EndIf
        If CeldaVacia(F:FAC)
          ACT(F:FAC, 'STD')
        EndIf
      EndIf
    EndIf
  EndIf
  ACD(G:FAC, FBN['Fecha2'])
  If DesciendeDeEspecie(FBN['Especie'],'TITULO')
    ACN(X2,8)
  Else
    ACN(X2,9)
  EndIf
  If Incluido(FBN['TipoTr2'],'DEP|COBROS|TRACTA|COMP')
    ACN(Val(X2):FAC, FBN['Cantidad1'])
  EndIf
  If Incluido(FBN['TipoTr2'],'RET|PAGOS')
    ACN(Val(X2):FAC, -FBN['Cantidad1'])
  EndIf
  If Incluido(FBN['TipoTr2'],'MATCH')
    ACN(H:FAC, -FBN['Cantidad1'])
    ACN(I:FAC, -FBN['Cantidad2'])
  EndIf
  If FBN['CB9']=1
    ACT(J:FAC, 'ERROR - Confirmado')
  EndIf
  ACD(Z9,SQL(" Select Fecha from "~DBO~".INSTANCIASOP WHERE NrOperacion = '"~FBN['NrTrans']~"' and NrInstancia = 7 ") )
  If FBN['CB3']=1 y VAL(Z9)>FBN['Fecha2'] y VAL(Z9)>=FSys
    ACT(J:FAC, 'Fallado '~VAL(Z9))
  EndIf
  SetFont(C:FAC..J:FAC,1)
Proximo

If FAC>Val(W1)+6
  If Val(X1)>1
    IFA
    ACT(G:FAC, 'Totales')
    ACN(H:FAC, SUM(H:FAC-Val(X1)..H:FAC-1))
    ACN(I:FAC, SUM(I:FAC-Val(X1)..I:FAC-1))
    SetFont(G:FAC..I:FAC,2)
  EndIf
EndIf
FormatoCeldas(H:Val(W1)+6..i:FAC,EXE('F2'))
SetFont(V1..Z3,1)

ACO(1,8)
ACO(2,10)
ACO(3,7)
ACO(4,7)
ACO(5,4)
ACO(6,5)
ACO(7,8)
ACO(8,12)
ACO(9,12)
ACO(10,15)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(A:FAC, 'Fin del informe.')
SetFont(A:FAC, 2)
AgregarBMP(A1,EXE('LOGO'),EXE('ESCALOGO'))
SetFont(J:3,2)
Impresion(1,2)
LimitesVision(J:FAC)
RangoTitulo(A:1..J:FAC, Val(W1)+5)
