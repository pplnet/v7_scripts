ModoReproceso(ConDialogo)

CrearDialogo:1,'Position|Scope1|Scope2|VarMethodology|'
  
    Reporting1  :'Reporte'                  ; 1;1;1;NO;NO;

    Radio4      :'TPos|COB|ONL|SIM|'        ; 3;1;1;NO;NO;
    Fecha5      :'PositionDate'             ; 4;1;1;NO;NO;
    Fecha6      :'MTMPriceDate'             ; 5;1;1;NO;NO;
    Posicion1   :'Position'                 ; 6;1;1;NO;NO;

    Precio1     :'TC Dolar'                 ; 8;1;1;SI;SI;;;;FTRAEPRECIOSFX('BANK','SPOT',Var('TCDOLAR'),0,Dialogo.Fecha6);FTRAEPRECIOSFX('BANK','SPOT',Var('TCDOLAR'),0,Dialogo.Fecha6);
    
    Radio5      :'Report Currency|ARS|USD|' ;10;1;1;SI;SI;;;;1;IIF(MODI, Dialogo.Radio5, iif(NoVacio(Dialogo.Reporting1),iif(Eqstr(BuscarCampo('REPORTING','Currency','Codigo',Dialogo.Reporting1),'ARS'),0,1),Dialogo.Radio5)); 
    
    Radio6      :'Reporting|String|VAR|'    ;12;1;1;SI;SI;;;;0;IIF(MODI, Dialogo.Radio6, iif(NoVacio(Dialogo.Reporting1),iif(Eqstr(BuscarCampo('REPORTING','VerString','Codigo',Dialogo.Reporting1),'SI'),0,1),Dialogo.Radio6));
    String1     :'Row'                      ;13;1;1;Dialogo.Radio6=1;Dialogo.Radio6=1;[Dialogo.Radio6 = 1 Y Not EqStr(Dialogo.String1,Dialogo.String2)] O [Dialogo.Radio6 = 0];'Row y Column no pueden tener el mismo valor';NO;'Ticker';IIF(MODI, Dialogo.String1, iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Fila'   ,'Codigo',Dialogo.Reporting1),Dialogo.String1));'Geographic Location|Entity|Book|Product|Subproduct|Issuer|Ticker|Maturity Date|Currency|Tenor|Nr Operation|Interest Rate|';
    String2     :'Column'                   ;14;1;1;Dialogo.Radio6=1;Dialogo.Radio6=1;[Dialogo.Radio6 = 1 Y Not EqStr(Dialogo.String1,Dialogo.String2)] O [Dialogo.Radio6 = 0];'Row y Column no pueden tener el mismo valor';NO;'Book'  ;IIF(MODI, Dialogo.String2, iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Columna','Codigo',Dialogo.Reporting1),Dialogo.String2));'Geographic Location|Entity|Book|Product|Subproduct|Issuer|Ticker|Maturity Date|Currency|Tenor|Nr Operation|Interest Rate|';    
    
    Check1      :'Automatico'               ;16;1;1;NO;NO;;;;0;

    Check3      :'Gen.Archivo'              ;18;1;1;NO;NO;;;;0;
    String10    :'Path'                     ;19;1;1;Dialogo.Check3=1;Dialogo.Check3=1;;;;Var('PATHREP');
    String11    :'Archivo'                  ;20;1;1;Dialogo.Check3=1;Dialogo.Check3=1;;;;Fecha(FSYS, 'YYYYMMDD')~'-'~Hora(Ahora)~'_'~'VAR';

    Entero5     :'Cod. Corrida'             ;22;1;1;NO;NO;
    Entero1     :'Cantidad'                 ;23;1;1;NO;NO;
    
    Check5      :'Detalle'                  ;25;1;1;NO;NO;

    
    Lista1      :'Geographic Location'   ;  0;1;2;SI;SI;;;;;IIF(MODI, Dialogo.Lista1 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Locacion'    ,'Codigo',Dialogo.Reporting1),Dialogo.Lista1 ) );SQLSet("Select C.Codigo  from "~DBO~".LOCACIONES C   ");
    Lista2      :'Entity'                ; -6;2;2;SI;SI;;;;;IIF(MODI, Dialogo.Lista2 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Entidad'     ,'Codigo',Dialogo.Reporting1),Dialogo.Lista2 ) );SQLSet("Select E.Codigo  from "~DBO~".ENTIDADES E    ");
    Lista3      :'Book'                  ; -5;1;2;SI;SI;;;;;IIF(MODI, Dialogo.Lista3 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Book'        ,'Codigo',Dialogo.Reporting1),Dialogo.Lista3 ) );SQLSet("Select B.Codigo  from "~DBO~".BOOKS B where "~dbo~".desciendedebook(B.Codigo,'MRM') = 1 and B.Codigo <> 'MRM' ");
    Lista4      :'Product'               ;-11;2;2;SI;SI;;;;;IIF(MODI, Dialogo.Lista4 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','TipoNegocio' ,'Codigo',Dialogo.Reporting1),Dialogo.Lista4 ) );SQLSet("Select T.Codigo  from "~DBO~".TIPOSNEGOCIO T ");
    Lista5      :'SubProduct'            ;-10;1;2;SI;SI;;;;;IIF(MODI, Dialogo.Lista5 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Producto'    ,'Codigo',Dialogo.Reporting1),Dialogo.Lista5 ) );SQLSet("Select P.Codigo  from "~DBO~".PRODUCTOS P    ");
    Lista6      :'Issuer'                ;  0;1;3;SI;SI;;;;;IIF(MODI, Dialogo.Lista6 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Emisor'      ,'Codigo',Dialogo.Reporting1),Dialogo.Lista6 ) );SQLSet("Select E.Codigo  from "~DBO~".EMISORES E     ");
    Lista7      :'Ticker'                ; -6;2;3;SI;SI;;;;;IIF(MODI, Dialogo.Lista7 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Especie'     ,'Codigo',Dialogo.Reporting1),Dialogo.Lista7 ) );SQLSet("Select E.Codigo  from "~DBO~".ESPECIES E Where "~dbo~".desciendedeespecie(Codigo,'TITULO') = 1 and E.Status = 'HAB' and E.Fecha > '"~IdxDate(Dialogo.Fecha5)~"' UNION Select E.Codigo from "~DBO~".ESPECIES E Where "~dbo~".desciendedeespecie(Codigo,'TITULO') = 1 and not "~dbo~".EsTerminalEspecie(Codigo)=0 UNION Select E.Codigo from "~DBO~".ESPECIES E Where "~dbo~".desciendedeespecie(Codigo,'MONEDA') = 1 and E.Status = 'HAB' ");
    Lista8      :'Maturity Date'         ; -5;1;3;SI;SI;;;;;IIF(MODI, Dialogo.Lista8 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Deal'        ,'Codigo',Dialogo.Reporting1),Dialogo.Lista8 ) );SQLSet("Select Distinct To_Char(P.FechaEj, 'DD/MM/YYYY') from "~DBO~".MRMPOSICIONES P where Fecha = '"~IdxDate(Dialogo.Fecha5)~"' and TipoPosicion ='"~iif(Dialogo.Radio4=0,'COB',iif(Dialogo.Radio4=1,'ONL','SIM'))~"' and P.NrPosicion = "~IIF(Vacio(Dialogo.Posicion1),"0",Dialogo.Posicion1)~" and TipoNegocio in ('FX','IR') ")
    Lista9      :'Tenor'                 ;-11;2;3;SI;SI;;;;;IIF(MODI, Dialogo.Lista9 , iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','Tenor'       ,'Codigo',Dialogo.Reporting1),Dialogo.Lista9 ) );SQLSet("Select T.Codigo  from "~DBO~".TENORS T   ");
    Lista10     :'Operation Number - IR' ;-10;1;3;SI;SI;;;;;IIF(MODI, Dialogo.Lista10, iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','NrOperacion' ,'Codigo',Dialogo.Reporting1),Dialogo.Lista10) );SQLSet("Select Distinct NrOperacion                      from "~DBO~".MRMPOSICIONES P where Fecha = '"~IdxDate(Dialogo.Fecha5)~"' and TipoPosicion ='"~iif(Dialogo.Radio4=0,'COB',iif(Dialogo.Radio4=1,'ONL','SIM'))~"' and P.NrPosicion = "~IIF(Vacio(Dialogo.Posicion1),"0",Dialogo.Posicion1)~" and TipoNegocio = 'IR' ")
    Lista11     :'Tasa Variable - IR'    ;-16;2;3;SI;SI;;;;;IIF(MODI, Dialogo.Lista11, iif(NoVacio(Dialogo.Reporting1),BuscarCampo('REPORTING','InterestRate','Codigo',Dialogo.Reporting1),Dialogo.Lista11) );SQLSet("Select Distinct TasaVariable                     from "~DBO~".MRMPOSICIONES P where Fecha = '"~IdxDate(Dialogo.Fecha5)~"' and TipoPosicion ='"~iif(Dialogo.Radio4=0,'COB',iif(Dialogo.Radio4=1,'ONL','SIM'))~"' and P.NrPosicion = "~IIF(Vacio(Dialogo.Posicion1),"0",Dialogo.Posicion1)~" and TipoNegocio = 'IR' ")

    
    Radio2      :'Historical Period|Days|Between days|' ; 1;1;4;NO;NO;
    Entero2     :'Days Back'                            ; 2;1;4;NO;NO;
    Fecha3      :'From'                                 ; 2;1;4;NO;NO;
    Fecha4      :'To'                                   ; 3;1;4;NO;NO;
    Entero3     :'Holding Period'                       ; 5;1;4;NO;NO;
    Check2      :'Translation'                          ; 6;1;4;NO;NO;
    Especie2    :'TCTranslation'                        ; 6;2;4;NO;NO;
    Cantidad4   :'Confidence Level'                     ; 7;1;4;SI;SI;Dialogo.Cantidad4 >0 Y Dialogo.Cantidad4 <= 100                                             ;'Nivel invalido'                   ;NO;95                              ;IIF(MODI, Dialogo.Cantidad4, iif(NoVacio(Dialogo.Reporting1),          BuscarCampo('REPORTING','Nivel'        ,'Codigo',Dialogo.Reporting1)            ,Dialogo.Cantidad4  ));;;'###.####'
    Radio3      :'NegPos|NEG|POS|'                      ; 8;1;4;SI;SI;                                                                                            ;                                   ;  ;0                               ;IIF(MODI, Dialogo.Radio3   , iif(NoVacio(Dialogo.Reporting1),iif(Eqstr(BuscarCampo('REPORTING','NegPos'       ,'Codigo',Dialogo.Reporting1),'NEG'),0,1),Dialogo.Radio3     ));

    
FinDialogo
 
if not ok
  cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(1)
ACT(a:fac, CODIGOINFORME)

SetFilaActual(fac+2)

ACT(a:fac, 'Base Reporting:')
ACT(b:fac, Dialogo.Reporting1)
ifa
ACT(a:fac, 'Geographic Location:')
IF NOVACIO(Dialogo.Lista1)
    ACT(b:fac, Dialogo.Lista1)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Entity:')
IF NOVACIO(Dialogo.Lista2)
    ACT(b:fac, Dialogo.Lista2)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Book:')
IF NOVACIO(Dialogo.Lista3)
    ACT(b:fac, Dialogo.Lista3)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Product:')
IF NOVACIO(Dialogo.Lista4)
    ACT(b:fac, Dialogo.Lista4)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'SubProduct:')
IF NOVACIO(Dialogo.Lista5)
    ACT(b:fac, Dialogo.Lista5)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Issuer:')
IF NOVACIO(Dialogo.Lista6)
    ACT(b:fac, Dialogo.Lista6)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Ticker:')
IF NOVACIO(Dialogo.Lista7)
    ACT(b:fac, Dialogo.Lista7)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Maturity Date:')
IF NOVACIO(Dialogo.Lista8)
    ACT(b:fac, Dialogo.Lista8)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Tenor:')
IF NOVACIO(Dialogo.Lista9)
    ACT(b:fac, Dialogo.Lista9)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Operation Number:')
IF NOVACIO(Dialogo.Lista10)
    ACT(b:fac, Dialogo.Lista10)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Interest Rate:')
IF NOVACIO(Dialogo.Lista11)
    ACT(b:fac, Dialogo.Lista11)
ELSE
    ACT(b:fac, 'TODOS')
ENDIF
ifa
ACT(a:fac, 'Historical Period:')
If Dialogo.Radio2=0
  ACT(b:fac, 'Days')
  ifa
  ACT(a:fac, 'Days Back:')
  ACT(b:fac, Fstr(Dialogo.Entero2,0,0))
Endif
If Dialogo.Radio2=1
  ACT(b:fac, 'Between days')
  ifa
  ACT(a:fac, 'From:')
  ACT(b:fac, Dialogo.Fecha3)
  ifa
  ACT(a:fac, 'To:')
  ACT(b:fac, Dialogo.Fecha4)
Endif
ifa
ACT(a:fac, 'Holding Period')
ACT(b:fac, Fstr(Dialogo.Entero3,0,0))

ifa
ACT(a:fac, 'Translation:')
IF Dialogo.Check2 = 0
  ACT(b:fac, 'NO')
ENDIF
IF Dialogo.Check2 = 1
  ACT(b:fac, 'YES')
  ifa
  ACT(a:fac, 'TC Translation:')
  ACT(b:fac, Dialogo.Especie2)
ENDIF

ifa
ACT(a:fac, 'Confidence Level:')
ACT(b:fac, Fstr(Dialogo.Cantidad4,0,4))
ifa
ACT(a:fac, 'Neg/Pos:')
If Dialogo.Radio3=0
  ACT(b:fac, 'NEG')
Endif
If Dialogo.Radio3=1
  ACT(b:fac, 'POS')
Endif
ifa

ACT(a:fac, 'Type Position:')
If Dialogo.Radio4=0
  ACT(b:fac, 'Close Of Bussiness')
Endif
If Dialogo.Radio4=1
  ACT(b:fac, 'Online')
Endif
If Dialogo.Radio4=2
  ACT(b:fac, 'Simulated')
Endif
ifa

ACT(a:fac, 'PositionDate:')
ACD(b:fac, Dialogo.Fecha5)
ifa
ACT(a:fac, 'MTMPriceDate:')
ACD(b:fac, Dialogo.Fecha6)
ifa
ACT(a:fac, 'Position:')
ACT(b:fac, Dialogo.Posicion1)
ifa

ACT(a:fac, 'TC Dolar:')
ACT(b:fac, Dialogo.Precio1)
ifa

ACT(a:fac, 'Report Currency:')
If Dialogo.Radio5=0
  ACT(b:fac, 'ARS')
Endif
If Dialogo.Radio5=1
  ACT(b:fac, 'USD')
Endif
ifa

ACT(a:fac, 'Reporting:')
If Dialogo.Radio6=0
  ACT(b:fac, 'String')
  ifa
Endif
If Dialogo.Radio6=1
  ACT(b:fac, 'VAR')
  ifa
  
  ACT(a:fac, 'Row:')
  ACT(b:fac, Dialogo.String1)
  ifa
  ACT(a:fac, 'Column:')
  ACT(b:fac, Dialogo.String2)
  ifa
  
Endif

ACT(a:fac, 'Weigthed per day: ')
ACT(b:fac, 1/Dialogo.Entero1 * 100)

SetFilaActual(fac+2)

ACT(a:fac, 'POSITION')
*ACL(a:fac,'POSGEN', Reporting1 = Dialogo.Reporting1, Radio4 = Dialogo.Radio4, Fecha5 = Dialogo.Fecha5, Posicion1 = Dialogo.Posicion1, Lista1 = Dialogo.Lista1, Lista2 = Dialogo.Lista2, Lista3 = Dialogo.Lista3, Lista4 = Dialogo.Lista4, Lista5 = Dialogo.Lista5, Lista6 = Dialogo.Lista6, Lista7 = Dialogo.Lista7, Lista8 = Dialogo.Lista8, Lista9 = Dialogo.Lista9, Lista10 = Dialogo.Lista10, Lista11 = Dialogo.Lista11 )

SetFont(a:1..b:fac,2)

SetFilaActual(fac+2)

IF Dialogo.Check1 = 0 
    ACT(a:fac, 'SAVE')
    *   ACL(a:fac,'GUAREP', Radio7 = 0, Reporting1 = Dialogo.Reporting1, Entero5 = Dialogo.Entero5, Lista1 = Dialogo.Lista1, Lista2 = Dialogo.Lista2, Lista3 = Dialogo.Lista3, Lista4 = Dialogo.Lista4, Lista5 = Dialogo.Lista5, Lista6 = Dialogo.Lista6, Lista7 = Dialogo.Lista7, Lista8 = Dialogo.Lista8, Lista9 = Dialogo.Lista9, Lista10 = Dialogo.Lista10, Lista11 = Dialogo.Lista11, Radio2 = Dialogo.Radio2, Entero2 = Dialogo.Entero2, Fecha3 = Dialogo.Fecha3, Fecha4 = Dialogo.Fecha4, Entero3 = Dialogo.Entero3, Check2 = Dialogo.Check2, Especie2 = Dialogo.Especie2, Cantidad4 = Dialogo.Cantidad4, Radio3 = Dialogo.Radio3, Radio4 = Dialogo.Radio4, Fecha5 = Dialogo.Fecha5, Fecha6 = Dialogo.Fecha6, Posicion1 = Dialogo.Posicion1, Radio5 = Dialogo.Radio5, Radio6 = Dialogo.Radio6, String1 = Dialogo.String1, String2 = Dialogo.String2, Lista20 = '', Radio8 = 0, Especie1 = '')
    SetFont(a:1..b:fac,2)
    SetFilaActual(fac+2)
ENDIF

IF Dialogo.Radio6 = 0
*    (.'VARSTRING'.)
ENDIF
messagebox('hola1')
messagebox(Dialogo.Radio6)
IF Dialogo.Radio6 = 1
    ACT(id:1, 'VAR')
    (.'AUXFILCOL'.)    
ENDIF
messagebox('hola2')
*Return -> Val(ca:1) -> Ultima columna utilizada

ACT(Val(ca:1)-1:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(Val(ca:1)-1:2..Val(ca:1)-1:2,1)

SetFilaActual(fac+2)
ACT(a:fac, 'FIN REPORTE')
SetFont(a:FAC, 2)

IF Dialogo.Check1 = 1 Y Dialogo.Check3 = 1

    *Salvar en HREPORTING
    ACT(co:1, Dialogo.Reporting1)
    ACN(co:2, Dialogo.Entero5)
    ACD(fe:1, Dialogo.Fecha5)
    *    (.'GUAHREPORT'.)

    ExportarXLS(a:1..Val(ca:1):fac, a:1..Val(ca:1):fac, Dialogo.String10~Dialogo.String11~'.XLS')
    *ExportarPDF(Dialogo.String10~Dialogo.String11~'.PDF')
    
ENDIF

limitesVision(Val(ca:1):fac)