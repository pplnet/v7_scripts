CrearDialogo
  Fecha1: 'Fecha Desde'  ;;;;;;;;;FSys
  Fecha2: 'Fecha Hasta'  ;;;;;;;;;FSys
  Lista1: 'Cuentas'       ;;;;;;;;;;;SQLSet("Select Distinct C.Codigo from "~DBO~".CONTABILIDAD C, "~DBO~".ASIENTOSCON1 A Where C.Codigo = A.Cuenta ")
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,BU')

ACT(a:2,'Saldos por Cuenta Contable')
SetFont(a:2,3)

SetFilaActual(4)

ACT(a:fac, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:fac+1, 'Fecha Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista1)
   ACT(a:fac+2, 'Cuentas: '~Pipe2Comillas(Dialogo.Lista1))
else
   ACT(a:fac+2, 'Cuentas: Todas')
endif

SetFont(a:fac..a:fac+2, 2)

SetFilaActual(fac+4)

ACT(a:fac, 'Especie')
ACT(b:fac, 'Saldo')
ACT(c:fac, 'Cuenta')
ACT(d:fac, 'Nombre')
ACT(e:fac, 'Tipo')

AgregarMarco(a:fac..e:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..e:fac, 2)
AlinearCeldas(a:fac..e:fac, 'C')

SQL.ADD(" Select A1.Alias1 Especie, SUM(CASE WHEN A1.DebitoCredito='CRE' THEN A1.Cantidad1 ELSE -A1.Cantidad1 END) Saldo, A1.Cuenta, C.Nombre, M1.TablaRC ")
SQL.ADD("  From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1, "~DBO~".CONTABILIDAD C, "~DBO~".MODELOSASIENTO M, "~DBO~".MODELOSASIENTO1 M1 ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ")
SQL.ADD("   And A1.Cuenta = C.Codigo ")
SQL.ADD("   And A.Modelo = M.Codigo ")
SQL.ADD("   And M.Codigo = M1.Modelo ")
SQL.ADD("   And A1.NrItem = M1.NrItem ")
SQL.ADD("   And A.FechaValor Between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" Group by A1.Alias1, A1.Cuenta, C.Nombre, M1.TablaRC ")
SQL.ADD(" Order by A1.Alias1, A1.Cuenta, C.Nombre, M1.TablaRC ")
watch(sql.batch)

Recorrer SQL
  ACT(a:fac,FBN['Especie'])
  ACN(b:fac,FBN['Saldo'])
  ACL(b:fac, 'DETSCU', Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, String1=FBN['Especie'], String2=FBN['Cuenta'])
  ACT(c:fac,FBN['Cuenta'])
  ACT(d:fac,FBN['Nombre'])
  ACT(e:fac,FBN['TablaRC'])
  If CeldaVacia(e:fac)
     ACN(CU:1,SQL("Select 1 from "~DBO~".CUENTAS where CuentaContable1 = '"~FBN['Cuenta']~"' "))
     If Val(CU:1)=1
        ACT(e:fac,'BANCO')
     EndIf
  EndIf
  FormatoCeldas(b:fac, EXE('F2'))
Proximo

SetFilaActual(fac+2)

ACT(a:fac,'FIN DEL INFORME')
SetFont(a:fac, 2)

LimitesVision(f:fac+1)

ACO(2,15)
ACO(3,10)
ACO(4,30)
ACO(5,10)
