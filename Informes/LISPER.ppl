* Este informe es para que tengan el mismo orden de eventos informes y TiposOperacion
* que en la pantalla de perfiles, y los puedan ubicar rapido.

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,12,B')
CrearFont(3, 'Arial,8,B')

SetFilaActual(1)

SQL.ADD("SELECT E.Codigo, E.Nombre, TE.Descripcion ")
SQL.ADD("FROM "~DBO~".EVENTOS E, "~DBO~".TIPOSEVENTO TE ")
SQL.ADD("WHERE E.Tipo = TE.Codigo ")
SQL.ADD("ORDER BY E.Tipo ")

ACT(a:fac, 'EVENTOS')
SetFont(a:fac, 2)
Recorrer SQL
   ACT(a:fac, FBN['Nombre']~' ('~FBN['Codigo']~')')
   ACT(b:fac, FBN['Descripcion'])
   SetFont(a:fac..b:fac, 1)
Proximo
SetFilaActual(fac+3)



SQL.ADD("SELECT  I.Codigo, I.Nombre, TI.Descripcion ")
SQL.ADD("FROM "~DBO~".INFORMES I, "~DBO~".TIPOSINFORME TI ")
SQL.ADD("WHERE I.Tipo = TI.Codigo ")
SQL.ADD("ORDER BY I.Tipo ")

ACT(a:fac, 'INFORMES')
SetFont(a:fac, 2)
Recorrer SQL
   ACT(a:fac, FBN['Nombre']~' ('~FBN['Codigo']~')')
   ACT(b:fac, FBN['Descripcion'])
   SetFont(a:fac..b:fac, 1)
Proximo
SetFilaActual(fac+3)



SQL.ADD("SELECT Codigo,Nombre ")
SQL.ADD("FROM "~DBO~".TIPOSOPERACION ")

ACT(a:fac, 'TIPOS OPERACION')
SetFont(a:fac, 2)
Recorrer SQL
   ACT(a:fac, FBN['Nombre']~' ('~FBN['Codigo']~')')
   SetFont(a:fac, 1)
Proximo
SetFilaActual(fac+3)

ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac, 3)

ACO(1, 25)
ACO(2, 25)

LimitesVision(b:fac)
