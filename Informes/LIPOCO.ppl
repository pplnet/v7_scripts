CrearDialogo
   Vehiculo1  : "Vehiculo"             ;1;1;1;SI;SI;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar El Vehiculo';NO;Var('VEHICULODE')
FinDialogo

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,10,B')

SetFilaActual(4)
ACT(a:FAC, 'Limites de Posicion Consumidos')
SetFont(a:FAC, 3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(a:FAC, 2)

SetFilaActual(FAC+2)
ACT(a:FAC, 'limite')
ACT(b:FAC, 'Descripcion')
ACT(c:FAC, 'Cliente/Book')
ACT(d:FAC, 'Moneda')
ACT(e:FAC, 'Consumido')
ACT(f:FAC, 'Asignado')
ACT(g:FAC, 'Estado')
ACT(h:FAC, 'Exceso')

AgregarMarco(a:FAC..h:FAC,1,0,Exe('COLOR'))
SetFont(a:FAC..h:FAC, 2)

ACN(w:1, FAC)
SQL.ADD("Select Limite,Descripcion,Cliente,Book,Vehiculo,Sum(Monto) as Monto from LIMCONSUMIDOS LC, TIPOSLIMITE TL ")
SQL.ADD("where LC.Limite = TL.COdigo ")
SQL.ADD("and TL.Clase='P' ")
SQL.ADD("and LC.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and LC.Monto > 0 ")
SQL.ADD("Group by Limite,Cliente,Book,Vehiculo,Descripcion ")
SQL.ADD("order by Limite,Vehiculo,Book,Cliente ")
Recorrer SQL
  ACT(j:fac, FBN['Limite'])
  ACT(k:fac, FBN['Cliente'])
  ACT(l:fac, FBN['Vehiculo'])
  ACT(m:fac, FBN['Book'])
  if ExisteLimite(FBN('Limite'),FBN('Cliente'),'USD',FBN('Vehiculo'),,FBN('Book'))
    ACT(n:fac, 'SI')
    ACD(o:fac, VtoLimite(FBN('Limite'),FBN('Cliente'),'USD',FBN('Vehiculo'),,FBN('Book')))
  else
    ACT(n:fac, 'NO')
  endif
  ACN(p:fac, FBN('Monto'))

  ACT(a:fac, FBN['Limite'])
  ACT(b:fac, FBN['Descripcion'])    
  if Incluido(FBN['Limite'],'BOOK')
    ACT(c:fac, FBN['Book'])
  else
    ACT(c:fac, FBN['Cliente'])
  endif
  ACT(d:fac, 'USD')
  ACN(e:fac, LimTotalizado3(FBN('Cliente'),FBN('Limite'),0,FBN('Vehiculo'),,FBN('Book'),,,,,,,,,,,'USD'))
  if Val(e:FAC)>0
  ACL(e:fac, 'LIPODC',Cliente1=FBN['Cliente'],Vehiculo1=FBN['Vehiculo'],String1=FBN['Limite'],Book1=FBN['Book'])
  endif
  if EqStr(Val(n:FAC),'SI')
    ACN(f:fac, LimAsignado(FBN('Cliente'),FBN('Limite'),'USD',FBN('Vehiculo'),,FBN('Book')))
    if Val(o:FAC)<FSys
      ACT(g:fac, 'Vencido el '~Fecha(Val(o:FAC)))
    else
      ACT(g:fac, 'Vigente')
    endif
  else
    ACN(f:fac, 0)
    ACT(g:fac, 'No Asignado')
  endif
  if Val(e:FAC)>Val(f:FAC)
    ACN(h:FAC, Val(e:FAC)-Val(f:FAC))
  endif
Proximo

If FAC>Val(w:1)
  SetFont(a:Val(w:1)+1..a:FAC, 2)
  SetFont(b:Val(w:1)+1..p:FAC, 1)
else
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay Limites de Posicion consumidos')
  SetFont(a:FAC, 2)
endif

ACO(1,8)
ACO(2,12)
ACO(3,10)
ACO(4,8)
ACO(5,10)
ACO(6,10)
ACO(7,15)
ACO(8,10)

Ifa
Ifa

ACT(a:fac,'FIN LISTADO')
SetFont(a:fac, 2)

LimitesVision(h:fac)
Impresion(1,2)
Rangotitulo(a:1..h:7,2)

SetPrintFit(3, 60)
