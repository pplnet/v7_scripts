HOJAVISIBLE(SI)
ModoReproceso(SinDialogo)
CrearDialogo
   NrTrans1:'Boleto'                       ;;1;;;;NoVacio(Dialogo.NrTrans1) y Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans', Dialogo.NrTrans1), 'BOBCRA');'Boleto BCRA Invalido';NO;;;;;;" TipoTr2='BOBCRA' and RB1=1 ";
   Radio5  :'Salida|Impresion|Pantalla'    ;;1;;;;;;;1
