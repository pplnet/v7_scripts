   AgregarMarco(f:fac+10..h:fac+11,1,0)
   SetFont(f:fac+10..h:fac+11,1)
   AlinearCeldas(f:fac+10..h:fac+11,'C')

   ACT(i:fac+10, '        TIPO DE CAMBIO') 
   ACN(j:fac+11, FBN['TipoCambio']) 
   AgregarMarco(i:fac+10..j:fac+11,1,0)
   SetFont(i:fac+10..j:fac+11,1)
   AlinearCeldas(i:fac+11..j:fac+11,'I')
   FormatoCeldas(J:fac+11, Exe('F6'))
   *----- 
   ACT(b:fac+12, 'BENEFICIARIO DEL EXTERIOR' ) 
   ACT(b:fac+13, FBN['Beneficiario']) 
   AgregarMarco(b:fac+12..j:fac+13,1,0)
   SetFont(b:fac+12..j:fac+13,1)
   AlinearCeldas(b:fac+12..j:fac+13,'I')

   ACT(i:fac+12, '        CUENTA Nr.') 
   ACT(I:fac+13, FBN['Cuenta1']) 
   AgregarMarco(i:fac+12..j:fac+13,1,0)
   SetFont(i:fac+12..j:fac+13,1)
   AlinearCeldas(i:fac+13..j:fac+13,'I')

   *----
   ACT(b:fac+14, 'DOMICILIO' ) 
   ACT(b:fac+15, FBN['DomicilioBenef']) 
   AgregarMarco(b:fac+14..j:fac+15,1,0)
   SetFont(b:fac+14..j:fac+15,1)
   AlinearCeldas(b:fac+14..j:fac+15,'I')

   ACT(i:fac+14, '        CODIGO PAIS') 
   ACT(j:fac+15, FBN['PaisPagador']) 
   AgregarMarco(i:fac+14..j:fac+15,1,0)
   SetFont(i:fac+14..j:fac+15,1)
   AlinearCeldas(i:fac+15..j:fac+15,'I')

   *----
   ACT(b:fac+16, 'BANCO RECIBIDOR DEL EXTERIOR' ) 
   ACT(b:fac+17, FBN['BancoRecibidor'] )

   AgregarMarco(b:fac+16..j:fac+17,1,0)
   SetFont(b:fac+16..j:fac+17,1)
   AlinearCeldas(b:fac+16..j:fac+17,'I')

   ACT(i:fac+16, '        Codigo Swift') 
   ACT(j:fac+17, FBN['CodSwifRec']) 
   AgregarMarco(i:fac+16..j:fac+17,1,0)
   SetFont(i:fac+16..j:fac+17,1)
   AlinearCeldas(i:fac+17..j:fac+17,'I')
   *---- 
   ACT(b:fac+18, 'Declaro bajo juramento que las informaciones consignadas son exactas y verdaderas, en el termino previsto en el Regimen Penal Cambiario, del cual ')
   ACT(b:fac+19, 'tengo pleno conocimiento de sus normas y sanciones' )

   ACT(b:fac+22, '        ______________________________' )
   ACT(b:fac+23, '                              Firma     ' )


   ACT(g:fac+22, '______________________________' )
   ACT(g:fac+23, '   Aclaracion y Nro. de Documento' )


   AgregarMarco(b:fac+18..j:fac+23,1,0)
   SetFont(b:fac+18..j:fac+23,4)
   AlinearCeldas(b:fac+18..j:fac+23,'I')


   ACT(b:fac+24, 'Certificamos que la/s firma/s que anteceden concuerdan con las registradas en nuestros libros (***)')


   ACT(b:fac+28, '        ______________________________' )
   ACT(b:fac+29, '                              Fecha   ' )


   ACT(g:fac+28, '______________________________' )
   ACT(g:fac+29, '                        Firma y Sello ' )


   ACT(b:fac+31, '(*)   -Cuando se trate de un turista debe registrarse fecha de ingreo al pais, codigo de pais de origen y numero de pasaporte o documento habilitado para ingresar al pais.')
   ACT(b:fac+32, '(**)  -Cuando se trate de un turista debe registrarse fecha de ingreo al pais, codigo de pais de origen y numero de pasaporte o documento habilitado para ingresar al pais.')
   ACT(b:fac+33, '(***) -Cuando el solicitante no tenga firma registrada en la entidad por tratarse de un particular, la certificacion se refiere a que la firma fue puesta en presencia del funcionario')
   ACT(b:fac+34, '      -certificante y que se constato su identidad mediante verificacion del documento de identidad')

   AgregarMarco(b:fac+24..j:fac+36,1,0)
   SetFont(b:fac+24..j:fac+36,4)
   AlinearCeldas(b:fac+24..j:fac+36,'I')

   *- Imprimo EL ESTADO 
   ACT(h:fac+36, FBN['Estado'])
   SetFont(h:fac+36..h:fac+36,6)

