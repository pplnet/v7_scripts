SetMargins(0,0,0,0)

CrearFont(1, "Arial,6,")
CrearFont(2, "Arial,6,B")
CrearFont(6, "Arial,9,B")
CrearFont(7, "Arial,11,B")
CrearFont(4, "Arial,5,")

SQL.ADD("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie,")
SQL.ADD("T.Cliente1,C.CUIT as NrCUIT,C.Direccion,C.Localidad,")
SQL.ADD("C.Provincia,C.CodigoPostal as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
SQL.ADD("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstComprado,")
SQL.ADD("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as Instrumento,")
SQL.ADD("T.Ley2 as Beneficiario,T.Ley3 as Cuenta1,T.Ley1 as DomicilioBenef,T.CEmpresa4 as PaisPagador,T.Ley5 as CodSwifRec,")
SQL.ADD("CB.Descripcion,'Vigente' as Estado,C.RazonSocial,T.Vehiculo1, ")
SQL.ADD("C.CodigoBCRA, T.Ley4 BancoRecibidor, C.Direccion Domicilio ")
*-i
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN  "~DBO~".OPERACIONES OP  ON  T.NrOperacionRef1 = OP.NrOperacion ,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB")
*SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB, "~DBO~".OPERACIONES OP ")
*-f
SQL.ADD("WHERE ")
SQL.ADD(" T.Cliente1 = C.Codigo AND ")
SQL.ADD(" T.NrTrans = '"~Dialogo.NrTrans1~"' AND ")
SQL.ADD(" T.TipoTr2 = 'BOBCRA' AND ")
*-i
*SQL.ADD(" T.NrOperacionRef1 *= OP.NrOperacion AND ")
*-f
SQL.ADD(" T.Cambio1 = CB.Codigo AND T.RB1=1")
SQL.ADD(" Union All ")
SQL.ADD("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie,")
SQL.ADD("T.Cliente1,C.CUIT as NrCUIT,C.Direccion,C.Localidad,")
SQL.ADD("C.Provincia,C.CodigoPostal as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
SQL.ADD("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstComprado,")
SQL.ADD("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as Instrumento,")
SQL.ADD("T.Ley2 as Beneficiario,T.Cuenta1,T.Ley1 as DomicilioBenef,T.CEmpresa4 as PaisPagador,T.Ley5 as CodSwifRec,")
SQL.ADD("CB.Descripcion,'Anulado' as Estado,C.RazonSocial,T.Vehiculo1, ")
SQL.ADD("C.CodigoBCRA, T.Ley4 BancoRecibidor, C.Direccion Domicilio ")
*-I
SQL.ADD("FROM "~DBO~".BTRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".OPERACIONES OP ON   T.NrOperacionRef1 = OP.NrOperacion  ,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB ")
*SQL.ADD("FROM "~DBO~".BTRANSACCIONES2 T,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB, "~DBO~".OPERACIONES OP ")
*-F
SQL.ADD("WHERE ")
SQL.ADD(" T.Cliente1 = C.Codigo AND ")
SQL.ADD(" T.NrTrans = '"~Dialogo.NrTrans1~"' AND ")
SQL.ADD(" T.TipoTr2 = 'BOBCRA' AND ")
*-I
*SQL.ADD(" T.NrOperacionRef1 *= OP.NrOperacion AND ")
*-F
SQL.ADD(" T.Cambio1 = CB.Codigo AND T.RB1=1")

Recorrer SQL 
   Message('Recuperando '~FBN['NrTrans'])

   dfa 
   SQL.ADD("SELECT VE.Cliente,VE.Descripcion,C.CodigoBCRA,C.CUIT ")
   SQL.ADD("FROM "~DBO~".VEHICULOS VE,"~DBO~".CLIENTES C ")
   SQL.ADD("WHERE VE.Codigo='"~FBN['Vehiculo1']~"' and VE.Cliente=C.Codigo ")

   Recorrer SQL
       dfa
       ACT(x2, FBN['Cliente'])
       ACT(x3, FBN['CUIT'])
       ACT(x4, FBN['Descripcion'])
       ACT(x5, FBN['CodigoBCRA'])
   Proximo

   SetFilaActual(6)
   ACT(b:fac,  '  BANCO CENTRAL DE LA REPUBLICA ARGENTINA')
   ACT(b:fac+1,'          GERENCIA  DE  EXTERIOR  Y  CAMBIOS')
   AgregarMarco(b:fac..c:fac+1,1,0)
   SetFont(b:fac..c:fac+1,1)

   ACT(d:fac,  '     MERCADO  LIBRE  DE  CAMBIOS')
   IF FBN['Tipo']=1
      ACT(d:fac+1,'     VENTA DE  CAMBIO A CLIENTES' )
   ELSE
      ACT(d:fac+1,'    COMPRA DE  CAMBIO A  CLIENTES' )
   ENDIF

   AgregarMarco(d:fac..f:fac+1,1,0)
   SetFont(d:fac..f:fac,2)
   SetFont(d:fac+1..f:fac+1,1)

   ACT(g:fac,  'F e c h a ')
   ACT(g:fac+1,FBN['Fecha1'] )
   AgregarMarco(g:fac..h:fac+1,1,0)
   SetFont(g:fac..h:fac+1,1)
   AlinearCeldas(g:fac ..g:fac+1,'D')

   ACT(i:fac,  '            N. DE BOLETO')
   IF Vacio(fbn('Operacion'))
       ACT(j:fac+1,FBN['NrTrans'] )
   ELSE
       ACT(J:fac+1, Copy(fbn('NrTrans'), 3, 6))
   ENDIF
   AgregarMarco(i:fac..j:fac+1,1,0)
   SetFont(i:fac..j:fac+1,1)
   AlinearCeldas(j:fac+1 ..j:fac+1,'I')
   
   ACT(b:fac+2, 'ENTIDAD       '~val(x4)) 
   SetFont(b:fac+2..h:fac+3,1)
   AgregarMarco(b:fac..h:fac+3,1,0)
   

   ACT(i:fac+2, '  CODIGO   DE  ENTIDAD')
   ACT(J:fac+3, val(x5))
   SetFont(i:fac+2..j:fac+3,1)
   AgregarMarco(i:fac+2..j:fac+3,1,0)

   ACT(b:fac+4, 'SOLICITANTE') 
   SetFont(b:fac+4..g:fac+4,1)
   AgregarMarco(b:fac+4..g:fac+4,1,0)
   ACT(b:fac+5,FBN['RazonSocial']) 
   SetFont(b:fac+5..g:fac+5,2)
   AgregarMarco(b:fac+5..g:fac+5,1,0)

   ACT(i:fac+4, 'CUIT/CUIL/DNI') 
   ACT(i:fac+5, FBN['NrCUIT']) 
   AgregarMarco(h:fac+4..j:fac+5,1,0)
   SetFont(h:fac+4..j:fac+5,1)

   *-----
   ACT(b:fac+6, 'DOMICILIO') 
   ACT(b:fac+7, FBN['Domicilio']~' '~FBN['Localidad']) 
   AgregarMarco(b:fac+6..f:fac+7,1,0)
   SetFont(b:fac+6..f:fac+7,1)
   AlinearCeldas(b:fac+6..f:fac+7,'I')

   ACT(g:fac+6, 'Codigo Postal') 
   ACT(g:fac+7, FBN['CP']) 
   AgregarMarco(g:fac+6..g:fac+7,1,0)
   SetFont(g:fac+6..g:fac+7,1)
   AlinearCeldas(g:fac+6..g:fac+7,'C')

   ACT(h:fac+6, 'C.PAIS ORIG') 
   ACT(i:fac+7, FBN['PaisOrigen']) 
   AgregarMarco(h:fac+6..i:fac+7,1,0)
   SetFont(h:fac+6..i:fac+7,1)
   AlinearCeldas(i:fac+7..i:fac+7,'C')

   ACT(j:fac+6, 'F.DE INGRESO') 
   ACT(j:fac+7, '') 
   IF FBN['Tipo']=0
      *- Compra
      ACT(j:fac+7, FBN['FIngreso']) 
   EndIf

   AgregarMarco(j:fac+6..j:fac+7,1,0)
   SetFont(j:fac+6..j:fac+7,1)
   AlinearCeldas(j:fac+6..j:fac+7,'C')
   *-----
   ACT(b:fac+8, 'CONCEPTO DE LA OPERACION') 
   ACT(b:fac+9, FBN['Descripcion']) 
   AgregarMarco(b:fac+8..f:fac+9,1,0)
   SetFont(b:fac+8..f:fac+9,1)
   AlinearCeldas(b:fac+8..f:fac+9,'I')

   ACT(g:fac+8, '         COD.CONCEPTO') 
   ACT(g:fac+9, '         '~FBN['Concepto']) 
   AgregarMarco(g:fac+8..h:fac+9,1,0)
   SetFont(g:fac+8..h:fac+9,1)
   AlinearCeldas(g:fac+8..h:fac+9,'C')

   ACT(i:fac+8, '     FECHA EMBARQUE') 
   ACT(j:fac+9, '') 

   IF FBN['Tipo']=1
      *- Venta
      ACT(j:fac+9, FBN['FIngreso']) 
   EndIf

   AgregarMarco(i:fac+8..j:fac+9,1,0)
   SetFont(i:fac+8..j:fac+9,1)
   AlinearCeldas(i:fac+9..j:fac+9,'I')
   *-----
   ACT(b:fac+10, 'COD. INSTR. VENDIDO') 
   ACT(b:fac+11, Pad0(FBN['InstVendido'], 2))
   AgregarMarco(b:fac+10..b:fac+11,1,0)
   SetFont(b:fac+10..b:fac+11,1)
   AlinearCeldas(b:fac+10..b:fac+11,'C')

   ACT(c:fac+10, 'COD. INSTR. RECIBIDO') 
   ACT(c:fac+11, Pad0(FBN['InstComprado'], 2))
   AgregarMarco(c:fac+10..d:fac+11,1,0)
   SetFont(c:fac+10..d:fac+11,1)
   AlinearCeldas(c:fac+11..d:fac+11,'D')

   ACT(e:fac+10, 'COD. MONEDA') 
   ACT(e:fac+11, FBN['Especie']) 
   AgregarMarco(e:fac+10..e:fac+11,1,0)
   SetFont(e:fac+10..e:fac+11,1)
   AlinearCeldas(e:fac+10..e:fac+11,'C')

   ACT(g:fac+10, 'IMPORTE') 
