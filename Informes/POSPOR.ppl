SQL.ADD("from "~DBO~".POSICIONES P   ")
SQL.ADD("      inner join "~DBO~".cuentas  CTA  on P.Estrategia = CTA.Codigo   ")
SQL.ADD("      inner join "~DBO~".especies ESP  on ESP.Codigo = Especie      ")
SQL.ADD("where P.Fecha      <= "~IDXDATE2(Dialogo.Fecha1)~" ")
If dialogo.Radio1=0
  SQL.ADD("and NrSaldo = 121  ")
else
  SQL.ADD("and NrSaldo = 122  ")
endif
