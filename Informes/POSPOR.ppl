** FJL 24/09/24 - Issue EXTBOFA-7593 Mostraba lineas con casi 0
*SQL.ADD("  and CantidadFin <> 0  ")
SQL.ADD("  and (CantidadFin >= 0.01 or CantidadFin <= -0.01)  ")
SQL.ADD("  AND P.Fecha IN (SELECT MAX(Fecha) from "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie    = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo   = P.Vehiculo ")
SQL.ADD("                   AND   P1.NrSaldo    = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Cliente    = P.Cliente  ")
SQL.ADD("                   AND   P1.Book       = P.Book     ")
** FJL 02/03/21 - Tomaba como distinto NULL de Vacio
*SQL.ADD("                   AND  (P1.Sector     = P.Sector     OR (P1.Sector     IS NULL AND P.Sector     IS NULL) ) ")
*SQL.ADD("                   AND  (P1.CallPut    = P.CallPut    OR (P1.CallPut    IS NULL AND P.CallPut    IS NULL) ) ")
*SQL.ADD("                   AND  (P1.Cupon      = P.Cupon      OR (P1.Cupon      IS NULL AND P.Cupon      IS NULL) ) ")
*SQL.ADD("                   AND  (P1.Estrategia = P.Estrategia OR (P1.Estrategia IS NULL AND P.Estrategia IS NULL) ) ")
*SQL.ADD("                   AND  (P1.FechaEj    = P.FechaEj    OR (P1.FechaEj    IS NULL AND P.FechaEj    IS NULL) ) ")
*SQL.ADD("                   AND  (P1.PrecioEj   = P.PrecioEj   OR (P1.PrecioEj   IS NULL AND P.PrecioEj   IS NULL) ) ")
** Se crea la funcion CampoIgual para comparar dos campos y evitar diferencias entre vacio y Null
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Unidad,P.Unidad)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Centro,P.Centro)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Sector,P.Sector)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Sucursal,P.Sucursal)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.FechaEj,P.FechaEj)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.PrecioEj,P.PrecioEj)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.CallPut,P.CallPut)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Estrategia,P.Estrategia)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Cartera,P.Cartera)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Trader,P.Trader)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.TipoNegocio,P.TipoNegocio)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Cupon,P.Cupon)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Responsable,P.Responsable)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.TipoPosicion,P.TipoPosicion)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.Producto,P.Producto)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.GrupoEspecie,P.GrupoEspecie)=1 ")
SQL.ADD("                   AND  "~DBO~".CampoIgual(P1.CarteraBCRA,P.CarteraBCRA)=1 ")
SQL.ADD("                   AND  P1.Fecha      <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                 ) ")

