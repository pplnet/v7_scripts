  ACN(h:FAC, SQL("SELECT Precio1 FROM "~DBO~".COTIZACIONES WHERE Fecha= "~IDXDATE2(Dialogo.Fecha1)~" and Codigo='"~Val(b:fac)~"' and Moneda='"~Val(f:fac)~"' and PlazoLiq = '"~BuscarCampo('ESPECIES','PlazoLiq','Codigo',Val(b:FAC))~"' "))
