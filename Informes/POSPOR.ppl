Recorrer SQL
  if Dialogo.Check2=1
    * Corte por Portfolio
    if Not EqStr(fbn('Portfolio'),Val(v:1)) o Not EqStr(fbn('Sec_Currency'),Val(v:2))
    ACT(i:FAC, 'Total '~Val(v:2))
      ACN(j:FAC, Val(x:1))
      ACN(k:FAC, Val(x:2))
      SCN(x:4, Val(k:FAC))
      SetFont(a:FAC..k:FAC,2)
      ACN(x:1, 0)
      ACN(x:2, 0)
      ACN(y:1, 0)
      if FAC>9
        AgregarMarco(i:Fac..k:fac,0,0,EXE('COLOR8'))
        IFA
      endif
      if Not EqStr(fbn('Portfolio'),Val(v:1))
        ACT(j:FAC, 'Total '~Val(v:1))
        ACN(k:FAC, Val(x:3))
        SetFont(a:FAC..k:FAC,2)
        ACN(x:3, 0)
        if FAC>9
          AgregarMarco(j:Fac..k:fac,0,0,EXE('COLOR8'))
          IFA
        endif
      endif
    endif
  else
    * Corte por Especie
    if Not EqStr(fbn('Sec_Currency'),Val(v:2))
    ACT(i:FAC, 'Total '~Val(v:2))
      ACN(j:FAC, Val(x:1))
      ACN(k:FAC, Val(x:2))
      SCN(x:4, Val(k:FAC))
      SetFont(a:FAC..k:FAC,2)
      ACN(x:1, 0)
      ACN(x:2, 0)
      ACN(y:1, 0)
      if FAC>9
        AgregarMarco(i:Fac..k:fac,0,0,EXE('COLOR8'))
        IFA
      endif
    endif
  endif
  if Dialogo.Check2=1
    ACT(v:1,fbn('Portfolio'))
  endif
  ACT(v:2, fbn('Sec_Currency'))

  SCN(y:1, 1)
  If Dialogo.Check2 = 1
    ACT(a:fac,fbn('Cuenta'))
    ACT(l:fac,fbn('Portfolio'))
  endif    
  ACT(b:fac,fbn('Security'))
  If Dialogo.Check1 = 1
    ACT(c:fac,fbn('MAE Code'))
    ACT(d:fac,fbn('ML Code'))
    ACT(e:fac,fbn('Maturity'))
  endif    
  ACT(f:fac,fbn('Sec_Currency'))
  ACN(g:fac,fbn('Face_Value'))

** AA 26-12-2025 Bofa (Price) valuacion por moneda de cotizacion y plazo liquidacion
