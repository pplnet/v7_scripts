If Dialogo.Check4 = 1
  SQL.ADD("Union All ")
  SQL.ADD("select ")
  If Dialogo.Check2=1
  SQL.ADD(" Plaza1 Estrategia, ")
  Endif
  SQL.ADD("   Cotiza, ")
  SQL.ADD("   Especie, ")
  SQL.ADD("   CASE WHEN  O.TipoOp = 'TIC' THEN Cantidad WHEN O.TipoOp = 'TIV' THEN Cantidad*-1 ELSE Cantidad END Cantidad ")
  If Dialogo.Check2=1
    SQL.ADD(" , Cta.Nombre  ")
  Endif
  If Dialogo.Check1 = 1
    SQL.ADD(" , ESP.CodMaeContado ")
    SQL.ADD(" , ESP.Codigo4       ")
    SQL.ADD(" , ESP.Fecha         ")
  endif
  SQL.ADD("from "~DBO~".OPERACIONES O   ")
  SQL.ADD("      inner join "~DBO~".cuentas  CTA  on O.Plaza1 = CTA.Codigo   ")
  SQL.ADD("      inner join "~DBO~".especies ESP  on ESP.Codigo = O.Especie,      ")
  SQL.ADD("      "~DBO~".OPERACIONESBITS OB ")
  If dialogo.Radio1=0
    SQL.ADD("where O.FechaOp      <= "~IDXDATE2(Dialogo.Fecha1)~"  and opesp <> '' ")
  else
    SQL.ADD("where O.FechaVto     <= "~IDXDATE2(Dialogo.Fecha1)~"  and opesp <> '' ")
  endif
  SQL.ADD(" and OB.NrOperacion = O.NrOperacion and OB.NrBit = 31 and OB.Valor = 1  ")
    SQL.ADD("Union All ")
  SQL.ADD("select ")
  If Dialogo.Check2=1
  SQL.ADD(" Plaza1 Estrategia, ")
  Endif
  SQL.ADD("   Cotiza, ")
  SQL.ADD("   Especie, ")
  SQL.ADD("   CASE WHEN  O.TipoOp = 'TIC' THEN Cantidad WHEN O.TipoOp = 'TIV' THEN Cantidad*-1 ELSE Cantidad END Cantidad ")
  If Dialogo.Check2=1
    SQL.ADD(" , Cta.Nombre  ")
  Endif
  If Dialogo.Check1 = 1
    SQL.ADD(" , ESP.CodMaeContado ")
    SQL.ADD(" , ESP.Codigo4       ")
    SQL.ADD(" , ESP.Fecha         ")
  endif
  SQL.ADD("from "~DBO~".BOPERACIONES O   ")
  SQL.ADD("      inner join "~DBO~".cuentas  CTA  on O.Plaza1 = CTA.Codigo   ")
  SQL.ADD("      inner join "~DBO~".especies ESP  on ESP.Codigo = O.Especie      ")
  If dialogo.Radio1=0
     SQL.ADD("where O.FechaOp      <= "~IDXDATE2(Dialogo.Fecha1)~"  and opesp <> '' and FechaDel >= "~IDXDATE2(Dialogo.Fecha1)~" ")
  else
     SQL.ADD("where O.FechaVto     <= "~IDXDATE2(Dialogo.Fecha1)~"  and opesp <> '' and FechaDel >= "~IDXDATE2(Dialogo.Fecha1)~" ")
  endif
Endif

