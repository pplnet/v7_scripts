ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  TipoOp1  : 'TipoOp'      ;;;;;;;;;'DPOS'
  Precio1  : 'Precio'      ;;;;;;;;;18
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Planilla de Cobertura - Det. Operaciones')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)

if NoVacio(Dialogo.Lista1)
   ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
   ACT(a:4, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.TipoOp1)
   ACT(a:4, 'TipoOp : '~Dialogo.TipoOp1)
else
   ACT(a:4, 'TipoOp : Todos')
endif

ACT(a:5, 'Precio : '~FStr(Dialogo.Precio1,0,7)~' ' )

ACT(a6, 'Producto')
ACT(b6, 'Nro.Op.')
ACT(c6, 'Dealer')
ACT(d6, 'Tipo')
ACT(e6, 'P.Strike')
ACT(f6, 'Volumen')
ACT(g6, 'Un.M.')
ACT(h6, 'F.Inicio')
ACT(i6, 'F.Fin')
ACT(j6, 'Vol. Total')
ACT(k6, 'Vol. Periodo')
ACT(l6, 'Vol. Resul.')
ACT(m6, 'Precio Resul.')
 
AgregarMarco(a6..m6, 2,0,Exe('COLOR'))

SetFilaActual(6)

*- Se lista todo petroleo menos caption, floortion y swaption
SQL.ADD("Select * from "~DBO~".OPERACIONES Where ")
SQL.ADD("( ")
SQL.ADD(" (TipoOp Not In ('DPOS','DPBOS','DPOGS') and FechaOp2<='"~IdxDate(Dialogo.Fecha2)~"' and FechaEj>'"~IdxDate(Dialogo.Fecha1)~"') or ") 
SQL.ADD(" (TipoOp In ('DPOS','DPBOS','DPOGS') and FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' and FechaEj>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(") ")
SQL.ADD(" and UMedida <> 'ONZAS' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.TipoOp1)
   SQL.ADD("and TipoOp='"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD("and TipoOp Like 'DP%' and TipoOp Not in ('DPSN','DPC','DPF') ")
SQL.ADD("order by Vehiculo1, TipoOp, NrOperacion")

BorrarCeldas(z1..z1)

Recorrer SQL

   if Not EQstr(fbn('Vehiculo1'),Val(z1))
      *-- cambia Tipo Op.
      if NoVacio(Val(z7))
         act(a:fac,'Total Tipo Op.' )
         acn(j:fac, Val(w5))
         acn(k:fac, Val(w6))

         *- Celda para linkear
         acn(ba1,val(k:fac))           

         acn(l:fac, Val(w7))
         acn(m:fac, Val(w8)/Val(w7))
         BorrarCeldas(w5..w8)
         AgregarMarco(a:fac..m:fac,1)
         SetFont(a:fac..m:fac,1)
         ifa
      endif
      *-- cambia empresa
      if NoVacio(Val(z1))
         act(a:fac,'Total Empresa '~Val(z1) )
         acn(j:fac, Val(w1))
         acn(k:fac, Val(w2))
         acn(l:fac, Val(w3))
         acn(m:fac, Val(w4)/Val(w3))
         BorrarCeldas(w1..w4)
         AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..m:fac,1)
         ifa
      endif

      *-- Asignar Empresa
      act(z1, fbn('Vehiculo1'))
      act(a:fac,'Empresa '~Val(z1) )
      AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..m:fac,1)
      ifa

      *-- Asignar Tipo Op.
      act(z7, fbn('TipoOp'))
      act(a:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
      AgregarMarco(a:fac..m:fac,1)
      SetFont(a:fac..m:fac,1)
      ifa
   else
      if Not EQstr(fbn('TipoOp'),Val(z7))
         * cambia Tipo Op.
         if NoVacio(Val(z7))
            act(a:fac,'Total Tipo Op.' )
            acn(j:fac, Val(w5))
            acn(k:fac, Val(w6))

            *- Celda para linkear
            acn(ba1,val(k:fac))           

            acn(l:fac, Val(w7))
            acn(m:fac, Val(w8)/Val(w7))
            BorrarCeldas(w5..w8)
            AgregarMarco(a:fac..m:fac,1)
            SetFont(a:fac..m:fac,1)
            ifa
         endif
         * Asignar Tipo Op.
         act(z7, fbn('TipoOp'))
         act(a:fac, BuscarCampo('TIPOSOPERACION','Nombre','Codigo',fbn('TipoOp')))
         AgregarMarco(a:fac..m:fac,1)
         SetFont(a:fac..m:fac,1)
         ifa
      endif
   endif

   act(b:fac, fbn('NrOperacion'))
   aclo(b:fac, fbn('NrOperacion'))
   act(c:fac, fbn('Cliente1'))

   if Incluido(fbn('TipoOp'),'DPRS|DPRRS')
      act(e:fac, fbn('TipoCambio2'))
   else
      if Incluido(fbn('TipoOp'),'DPRC')
         act(e:fac, fbn('TipoCambio2')~'/'~fbn('TipoCambio3'))
      else
         act(e:fac, fbn('PrecioEj'))
      endif
   endif

   If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
      if fbn('FechaOp') > Dialogo.Fecha1 
         ACD(z2, fbn('FechaOp'))
      else
         ACD(z2, Dialogo.Fecha1)
      endif
   Else 
      if fbn('FechaOp2') > Dialogo.Fecha1 
         ACD(z2, fbn('FechaOp2'))
      else
         ACD(z2, Dialogo.Fecha1)
      endif
   EndIf

   if fbn('FechaEj') <= Dialogo.Fecha2
      ACD(z3, fbn('FechaEj'))
   else
      ACD(z3, Dialogo.Fecha2)
   endif

   *  dif dias
   ACN(z4, (Val(z3)-Val(z2))+1)

   * dif meses
   ACN(z6, DifMeses(Val(z3),Val(z2))+1)

   * determinar el signo
   if Incluido(fbn('TipoOp'),'DPS|DPRS|DPRRS|DPRC|DPDSO|DPDSS')
      if EqStr(fbn('MB1'),'1')
         act(d:fac,'Producer')
         acn(z5,1)
      else
         act(d:fac,'Consumer')
         acn(z5,-1)
      endif
   endif
   if Incluido(fbn('TipoOp'),'DPOS|DPOD|DPOA|DPOAV|DPBOS|DPBOD|DPBOA|DPOGA|DPOGD|DPOGS')
      if [Not EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
         act(d:fac,'Compra PUT')
         acn(z5,1)
      endif
      if [EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
         act(d:fac,'Venta CALL')
         acn(z5,1)
      endif
      if [EqStr(fbn('MB3'),'1') y EqStr(fbn('MB1'),'1')]
         act(d:fac,'Venta PUT')
         acn(z5,-1)
      endif
      if [Not EqStr(fbn('MB3'),'1') y Not EqStr(fbn('MB1'),'1')]
         act(d:fac,'Compra CALL')
         acn(z5,-1)
      endif
   endif
   if EqStr(fbn('TipoOp'),'DPFW')
      if EqStr(fbn('MB3'),'1') 
         act(d:fac,'Venta')
         acn(z5,1)
      endif
      if EqStr(fbn('MB3'),'0') 
         act(d:fac,'Compra')
         acn(z5,-1)
      endif
   endif

   acn(f:fac, fbn('Cantidad'))
   act(g:fac, fbn('UMedida'))

   If Incluido(FBN['TipoOp'],'DPOS|DPBOS|DPOGS')
      acd(h:fac, fbn('FechaOp'))
      acd(i:fac, fbn('FechaEj'))
      acn(j:fac, fbn('Cantidad'))
      acn(k:fac, fbn('Cantidad'))
   else 
      acd(h:fac, fbn('FechaOp2'))
      acd(i:fac, fbn('FechaEj'))
      acn(j:fac, fbn('TotalAux2')*Val(z5))
  
      If EqStr(fbn('UMedida'),'BBLSD')
         * Barriles por dia
         acn(k:fac, fbn('Cantidad')*Val(z4)*Val(z5))
      Else
         If Incluido(fbn('UMedida'),'BBLSM|TN/MES')
            * por meses
            acn(k:fac, fbn('Cantidad')*Val(z6)*Val(z5))
         Endif
      Endif
   EndIf

   * acn(l:fac, fbn('TotalAux1')*Val(z5))
   * acn(m:fac, (fbn('TotalAux1')*ABS(Val(k:fac))/fbn('TotalAux2'))*Val(z5))

   act(z8,FBN['MB1'])
   acn(z9,FBN['PrecioEj'])

   *- Operaciones Con Cuotas
   If Incluido(fbn('TipoOp'),'DPBOA|DPBOD|DPDSO|DPDSS|DPOA|DPOAV|DPOD|DPOGA|DPOGD|DPRC|DPRRS|DPRS|DPS|DPSV')
      *- Recupero las cuotas vigentes para el periodo
      SQL.ADD("Select C.Fecha1, C.Fecha2,C.Plazo1, C.Cantidad1,C.Cantidad2,")
      SQL.ADD("C.Precio1,C.Precio2,C.Precio3,C.Precio4,C.Total1 ")
      SQL.ADD("from "~DBO~".CUOTAS C ")
      SQL.ADD("where C.NrOperacion = '"~FBN['NrOperacion']~"' ")
      SQL.ADD("and C.Fecha2 >'"~IdxDate(Dialogo.Fecha1)~"' ")

      Recorrer SQL
         * dfa

         If Incluido(val(z7),'DPOA|DPOD')
            acn(k:fac, fbn('Cantidad1')*Val(z5))
            acn(l:fac,val(k:fac))

            *- Precio1: Precio Real
            If FBN['Precio1']<>0
               acn(m:fac,FBN['Precio1'])
            Else 
               IF [EqStr(val(z8),'0') y Dialogo.Precio1>=val(z9)] o [EqStr(val(z8),'1') y Dialogo.Precio1<=val(z9) ]
                  *- Call y Precio Real>=PrecioEj o Put Precio Real<=PrecioEj -> Strike
                  acn(m:fac,val(z9))            
               Else 
                  acn(l:fac,0)
               EndIf
            EndIf     
         EndIf     
      Proximo   
   Else 
      If Incluido(fbn('TipoOp'),'DPOS')
         *- Volumen Resultante es el volumen
         acn(l:fac,val(k:fac))

         *- Precio2: Precio Real
         If FBN['Precio2']<>0
            acn(m:fac,FBN['Precio2'])
         Else 
            IF [EqStr(FBN['MB1'],'0') y Dialogo.Precio1>=FBN['PrecioEj']] o [EqStr(FBN['MB1'],'1') y Dialogo.Precio1<=FBN['PrecioEj'] ]
               *- Call y Precio Real>=PrecioEj o Put Precio Real<=PrecioEj -> Strike
               acn(m:fac,FBN['PrecioEj'])            
            Else 
               acn(l:fac,0)
            EndIf
         EndIf     
      EndIf      
   EndIf

   scn(w1,Val(j:fac))
   scn(w2,Val(k:fac))
   scn(w3,Val(l:fac))
   scn(w4,Val(l:fac)*Val(m:fac))

   scn(w5,Val(j:fac))
   scn(w6,Val(k:fac))
   scn(w7,Val(l:fac))
   scn(w8,Val(l:fac)*Val(m:fac))

   scn(w9,Val(j:fac))
   scn(w10,Val(k:fac))
   scn(w11,Val(l:fac))
   scn(w12,Val(l:fac)*Val(m:fac))
 
   SetFont(a:fac..m:fac,2)
proximo

* ultimo total tipo Op.
ifa
if NoVacio(Val(z7))
  act(a:fac,'Total Tipo Op.' )
  acn(j:fac, Val(w5))
  acn(k:fac, Val(w6))

  *- Celda para linkear
  acn(ba1,val(k:fac))           

  acn(l:fac, Val(w7))
  acn(m:fac, Val(w8)/Val(w7))
  BorrarCeldas(w5..w8)
  AgregarMarco(a:fac..m:fac,1)
  SetFont(a:fac..m:fac,1)
endif

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
  act(a:fac,'Total Empresa '~Val(z1) )
  acn(j:fac, Val(w1))
  acn(k:fac, Val(w2))
  acn(l:fac, Val(w3))
  acn(m:fac, Val(w4)/Val(w3))
  BorrarCeldas(w1..w4)
  AgregarMarco(a:fac..m:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..m:fac,1)
endif

* total gral
ifa
acn(j:fac, Val(w9))
acn(k:fac, Val(w10))
acn(l:fac, Val(w11))
acn(m:fac, Val(w12)/Val(w11))
BorrarCeldas(w1..w12)
AgregarMarco(a:fac..m:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..m:fac,2)

ACO(1,19)
ACO(3,10)
ACO(4,9)
ACO(5,5)
ACO(6,6)
ACO(7,4)
ACO(8,6)
ACO(9,6)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)

SetFont(a1..z6, 1)
SetFont(a7..z:fac, 2)
FormatoCeldas(e7..e:fac, Exe('F7'))
FormatoCeldas(f7..f:fac, Exe('F2N'))
FormatoCeldas(j7..m:fac, Exe('F2N'))
AlinearCeldas(e:6..f:fac+1,'D')
AlinearCeldas(j:6..m:fac+1,'D')
LimitesVision(n:fac+1)
Impresion(1,2)

*CrearFont(6,"Arial,6,B")
*RangoTitulo(a:5..m:FAC, 2)