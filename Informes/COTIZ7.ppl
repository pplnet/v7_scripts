SQL.ADD(" SELECT E.Codigo, C.Fecha, C.Cotizacion, E.Nombre, E.Cotiza, C.Moneda, C.CodigoValuacion  ")
SQL.ADD(" FROM "~DBO~".COTIZACIONESESP C, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE C.Especie = E.Codigo ")
SQL.ADD(" AND   C.Fecha >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   C.Fecha <= "~IdxDate2(Dialogo.Fecha2)~" ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND  E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
SQL.ADD(" ORDER BY E.Codigo, C.Fecha ")
