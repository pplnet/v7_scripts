ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo1  : "Vehiculo"                   ;  ; ;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Radio1     : "Moneda|Pesos|Dolares"       ;  ; ;;;;;;;0;
   Lista1     : "Especies"                   ; 3; ;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");
   ListaTabla2: 'Clientes'                   ;-3;2;;;;;;;;;;;;;'Codigo' ; 'Codigo;RazonSocial' ; 'vCLIENTES01'
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(d1, "Movimientos Pendientes por Cliente/Especie ")
ACT(d2, "           Expresado en "~IIf(Dialogo.Radio1=0,VAR('MONELOCA'),VAR('MONEEXTR'))~" ")
ACT(h2, "Fecha: "~Var('FECHASYS'))
SetFont(d1, 3)
AlinearCeldas(d1,'C')
AlinearCeldas(h2,'D')

If NoVacio(Dialogo.Lista1)
   ACT(a4, "Especies: "~Dialogo.Lista1)
EndIf
If NoVacio(Dialogo.ListaTabla2)
   ACT(a5, "Clientes: "~Dialogo.ListaTabla2)
EndIf

ACT(a6, "Cliente")
ACT(b6, "Especie")
ACT(c6, "Fecha Op.")
ACT(d6, "NrTrans")
ACT(e6, "Estado")
ACT(f6, "V.N.")
ACT(g6, "V.R.")
ACT(h6, "Valuacion")
ACT(i6, "Descripcion")

SetFont(a2..i6, 2)
AgregarMarco(a6..i6,2,2,Exe('COLOR'))
AlinearCeldas(a6..i6,'C')

*- Saldo Inicial 
ACN(aa1,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')) )

SQL.ADD("SELECT M.Cliente, M.Especie, M.FechaMov Fecha1, T.NrTrans, M.Cantidad Cantidad1, ")
SQL.ADD("       C.RazonSocial, T.TipoTr2, 'DIR' Tipo, T.RB1, T.CB1, T.CB2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente,'PEN' Ejecutado,M.Leyenda, E.InteresesC, E.Nombre ")
SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M ")
SQL.ADD("WHERE M.NrOperacion = T.NrTrans AND ")
SQL.ADD("      (M.NrSaldo="~Fstr(val(aa1),0,0)~" or M.NrSaldo>201) AND ")
SQL.ADD("      M.Cliente = C.Codigo AND ")
SQL.ADD("      T.TipoTr2 In ('DTP','RTP','CUPON','CCUPON','PCUPON','PDIVID','DRT') AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   C.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("ORDER BY 1,2,3,4 ")

ACN(fi1, 7)
SetFilaActual(Val(fi1)-1)

* Cliente
ACT(x1, '')
* Especie
ACT(x2, '')

* Total Gral
ACN(z1, 0)
* Total Especie VN
ACN(z2, 0)
* Total Especie VR
ACN(z3, 0)
* Total Especie Valuacion
ACN(z4, 0)

* Marca para saber si listo algun registro
ACT(z5, 'NO')

Recorrer SQL
   IF Not EqStr(FBN['Cliente'], Val(x1))
      * para que la primera vez no entre
      IF NoVacio(Val(x1))
         ACT(b:fac, '---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------')
         SetFilaActual(fac+2)
      ENDIF
      ACT(z5, 'SI')
      ACT(a:fac, FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(x1, FBN['Cliente'])
      ACT(b:fac, FBN['Especie']~' - '~FBN['Nombre'])
      ACT(x2, FBN['Especie'])
      ACN(x4, BUSCARCAMPO('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACN(x3, BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')))
      SetFont(a:fac..i:fac, 2)
      ifa
   ENDIF

   IF Not EqStr(FBN['Especie'], Val(x2))
      ACT(b:fac, '---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------')
      ifa
      ACT(z5, 'SI')
      ACT(b:fac, FBN['Especie']~' - '~FBN['Nombre'])
      ACT(x2, FBN['Especie'])
      ACN(x4, BUSCARCAMPO('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACN(x3, BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')))
      SetFont(a:fac..i:fac, 2)
      ifa
   ENDIF

   ***If Not EqStr(FBN['TipoTr2'],'SALINI')
      ACD(c:fac, FBN['Fecha1'])
      ACT(d:fac, FBN['NrTrans'])
      ACLT(d:fac, FBN['NrTrans'])
      ACN(f:fac, FBN['Cantidad1'])
      ACN(g:fac, FBN['Cantidad1']*VALORTEORICO2(FBN['Especie'],FBN['Fecha1']))

      IF Dialogo.Radio1 = 0
         ACN(cf:fac, CotizacionC(FBN['Especie'],,,,FBN['Fecha1'],1,SI,VAR('MONELOCA')))
      ELSE
         ACN(cf:fac, CotizacionC(FBN['Especie'],,,,FBN['Fecha1'],1,SI,VAR('MONEEXTR')))
      ENDIF

      ACN(yt1, fac)
      ACD(yu:fac, FBN['Fecha1'])
      ACT(yv:fac, FBN['Especie'])
      ACN(yw:fac, Val(f:fac))

      ACD(yx:fac, FBN['FechaCambioTasa'])
      ACN(yy:fac, FBN['TasaIntAnterior'])
      ACN(yz:fac, FBN['TasaIntVigente'])
      (.'INTERESCLE'.)

      IF EqStr(FBN['InteresesC'],'CLE')
         IF Val(x4) = 1585
            ACN(h:fac, Val(g:fac)*Val(cf:fac)+(Val(zz:fac)*Val(cf:fac)))
         ELSE
            ACN(h:fac, Val(g:fac)*Val(cf:fac)+Val(zz:fac))
         ENDIF
      ELSE
         ACN(h:fac, Val(f:fac)*Val(cf:fac)+Val(zz:fac))
      ENDIF

      ACT(i:fac, FBN['Leyenda'])

      IF FBN['CB1'] = 1
         ACT(i:fac, val(i:fac)~' Transferencia ')
         IF FBN['CB2'] = 1
            ACT(i:fac, Val(i:fac)~'Interna')
         ELSE
            IF EqStr(FBN['TipoTr2'], 'DTP')
               ACT(i:fac, Val(i:fac)~'Receptora ')
            ELSE  
               ACT(i:fac, Val(i:fac)~'Emisora ')
            ENDIF
            IF FBN['RB1'] = 0
               ACT(i:fac, Val(i:fac)~'Conformada')
            ENDIF
            IF FBN['RB1'] = 1
               ACT(i:fac, Val(i:fac)~'Diferida')
            ENDIF
            IF FBN['RB1'] = 2
               ACT(i:fac, Val(i:fac)~'Inmediata')
            ENDIF
         ENDIF
      ENDIF
      
      ACT(e:fac, FBN['Ejecutado'])

      If EqStr(FBN['Ejecutado'],'EJE')
         ColorCeldas(e:fac, clGREEN)
      Else
         ColorCeldas(e:fac, clRED)
      ENDIF

      ACN(z1, Val(z1)+Val(h:fac))
      ACN(z2, Val(z2)+Val(f:fac))
      ACN(z3, Val(z3)+Val(g:fac))
      ACN(z4, Val(z4)+Val(h:fac))
      SetFont(a:fac..i:fac, 1)

Proximo

IF EqStr(Val(z5),'SI')
   ifa
   ACT(b:fac, '---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------')
   ifa
   ifa
   ifa
ENDIF

FormatoCeldas(f:Val(fi1)..f:fac,Exe('F2'))
FormatoCeldas(g:Val(fi1)..g:fac,Exe('F8'))
FormatoCeldas(h:Val(fi1)..h:fac,Exe('F2'))

Ifa
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac..a:fac, 2)

ACO(1,22)
ACO(2, 15)
ACO(3, 7)
ACO(4, 7)
ACO(5, 4)
ACO(6,10)
ACO(7,10)
ACO(8,10)
ACO(9,35)

FijarFila(Val(fi1))

LimitesVision(i:fac)
Impresion(1,2)
SetPrintFit(3,80)
RangoTitulo(a:1..i:fac, 6)