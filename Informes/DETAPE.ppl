ModoReproceso(SinDialogo)
CrearDialogo
  Especie1     : "Especie"   ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO
  Fecha1       : "F.Desde"   ;;;;;;Dialogo.Fecha1>0;'Debe Ingresar la Fecha Desde';NO;FSys-90
  Fecha2       : "F.Hasta"   ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Hasta valida';NO;FSys
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


ACT(m:2,'Fecha : '~Fecha(FSys))
SetFont(m:2..m:2,1)

SetFilaActual(4)
ACT(a:FAC, "Movimientos Parking por Especie")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

ACT(a:fac, 'Especie:')
ACT(a:FAC+1, 'Fecha Desde:')
ACT(a:FAC+2, 'Fecha Hasta:')

ACT(b:fac, Dialogo.Especie1)
ACD(b:FAC+1, Dialogo.Fecha1)
ACD(b:FAC+2, Dialogo.Fecha2)
SetFont(a:fac..a:fac+2,2)
SetFont(b:fac..b:fac+2,1)

SetFilaActual(FAC+4)
ACN(w1,FAC)

ACT(a:FAC, 'Estado')
ACT(b:FAC, 'Nro Op.')
ACT(c:FAC, 'Tipo Op.')
ACT(d:FAC, 'F.Mov.')
ACT(e:FAC, 'F.Ejer')
ACT(f:FAC, 'Cliente')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cantidad')
ACT(i:FAC, 'Leyenda')
ACT(j:FAC, 'NrSaldo')
ACT(k:FAC, 'Moneda')
ACT(l:FAC, 'TipoDol')
ACT(m:FAC, 'Mercado')
ACT(n:FAC, 'Saldo')

SetFont(a:FAC..z:FAC,2)
AgregarMarco(a:FAC..n:FAC,2,0,Exe('COLOR6'))

SetFilaActual(FAC+2)

ACT(l:FAC, 'Disponible Anterior')
SetFont(l:fac,2)
ACN(n:FAC, SQL("Select SUM(Cantidad) from "~DBO~".MOVEJECUTADOS where Especie='"~Dialogo.Especie1~"' and NrSaldo in (131,132,133) and FechaMov < '"~IdxDate(Dialogo.Fecha1)~"'  ") )
SetFont(n:fac,1)


SQL.ADD("SELECT 'Pend' Estado, *  ")  
SQL.ADD("from "~DBO~".MOVPENDIENTES")
SQL.ADD("where Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("  and NrSaldo in (131,132,133) ")
SQL.ADD("  and FechaMov  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("Union All ")
SQL.ADD("SELECT 'EJEC' Estado, *  ")  
SQL.ADD("from "~DBO~".MOVEJECUTADOS")
SQL.ADD("where Especie='"~Dialogo.Especie1~"' ")
SQL.ADD("  and NrSaldo in (131,132,133) ")
SQL.ADD("  and FechaMov  Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")

SQL.ADD("order by FechaMov ")
watch(SQL.BATCH())

Recorrer SQL
    SCN(y:1, 1)
    ACT(a:FAC, FBN['Estado'])
    ACT(b:FAC, FBN['NrOperacion'])
    if EqStr(Copy(FBN['NrOperacion'],1,2),'TE')
      ACT(c:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',FBN['NrOperacion']))
      ACLT(b:fac, FBN['NrOperacion'])
    else
      ACT(c:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',FBN['NrOperacion']))
      ACLO(b:fac, FBN['NrOperacion'])
    ENDIF
    ACD(d:FAC, FBN['FechaMov'])
    ACD(e:FAC, FBN['FechaEje'])
    ACT(f:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))
    if Vacio(Val(f:FAC))
      ACT(f:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
    endif
    ACT(g:FAC, FBN['Especie'])
    ACN(h:FAC, FBN['Cantidad'])
    ACT(i:FAC, Copy(FBN['Leyenda'],1,17))
    ACN(j:FAC, FBN['NrSaldo'])
    if FBN['NrSaldo']=131
      ACT(k:FAC, 'ARP')
    endif
    if FBN['NrSaldo']=132
      ACT(k:FAC, 'USD')
      ACT(l:FAC, 'MEP')
    endif
    if FBN['NrSaldo']=133
      ACT(k:FAC, 'USD')
      ACT(l:FAC, 'Cable')
    endif
    ACT(m:FAC, FBN['Mercado'])
    ACN(n:FAC, Val(n:FAC-1)+FBN['Cantidad'])

    SetFont(a:FAC..z:FAC,1)

    FormatoCeldas(g:fac..g:fac,Exe('F2'))
    FormatoCeldas(i:fac..i:fac,"0")

proximo

IF Val(y:1)=0
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay Movimientos para la especie+fechas solicitadas')
  SetFont(a:fac,2)
else
  FormatoCeldas(h:Val(w1)+1..h:fac,Exe('F2'))
  FormatoCeldas(j:Val(w1)+1..j:fac,Exe('F0'))
  FormatoCeldas(n:Val(w1)+1..n:fac,Exe('F2'))
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:fac,2)

ACO(6,15)
ACO(8,10)
ACO(9,15)
ACO(14,10)

LimitesVision(n:FAC)
