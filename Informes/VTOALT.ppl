HOJAVISIBLE(SI)
ModoReproceso(ConDialogo)
CrearDialogo
*--  Label1       : ''             ;1;1;;NO;;;;;'Con F2 muestra lista para seleccion'
  Vehiculo1    : "Vehiculo"     ;1;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1     : "Banco"        ;2;;
  Fecha1       : "F.Desde"      ;3;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2       : "F.Hasta"      ;4;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  NrOperacion1 : "Nr.Operacion" ;5;;;;;;;;;;;
  Radio2  : "Expresado|ARP  |USD         "  ;5;2;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif


if Not Vacio(Dialogo.Vehiculo1) Y Not Vacio(UsrVehiculos(UsuarioActivo))
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)
ACN(fi1,0)
ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)
ACT(a:FAC,'Vencimientos de la deuda del periodo')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(a:FAC+1, 'Expresado en '~Val(mo1))
SetFont(a:fac..a:fac+1,3)
SetFilaActual(4)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Banco : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Banco : Todos')
endif

ACT(a:FAC+3, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Fecha Hasta: '~Dialogo.Fecha2)
SetFont(a:fac..N:FAC+4,2)

SetFilaActual(FAC+6)
ACN(z11, FAC+1)

ACT(a:FAC,'Banco')
ACT(b:FAC,'Tipo Op')
ACT(c:FAC,'Numero Op.')
ACT(d:FAC,'Fecha Op.')
ACT(e:FAc,'Mon.')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(g:FAC,'Importe')
ACT(f:FAC,'Fecha Vto.')
ACT(h:FAC,'Interes')
ACT(i:FAC,'WH')
ACT(j:FAC,'Interes + WH')
ACT(k:FAC,'Amort. + Int. + WH')

AlinearCeldas(a:FAC..b:FAC,'I')
AlinearCeldas(d:FAC..d:FAC,'I')
AlinearCeldas(f:FAC..f:FAC,'I')
AlinearCeldas(c:FAC..c:FAC,'C')
AlinearCeldas(e:FAC..g:FAC,'C')
AlinearCeldas(h:FAC..k:FAC,'C')
SetFont(a:fac..k:FAC,2)
AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))

act(t1,'')
act(t2,'')
act(t3,'')
BorrarCeldas(w11..w15)
BorrarCeldas(w21..w25)
BorrarCeldas(w31..w35)
BorrarCeldas(w91..w95)

SetFilaActual(10)
SQL.ADD("Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha3 FechaVto, C.Total1 Importe, C.Cantidad4 Cantidad ")
SQL.ADD(" , O.FechaOp, C.Cantidad3 Interes, C.Precio3 WH from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha3 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
*--SQL.ADD(" and C.Cantidad4 > 0 ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Else
   if Not Vacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ")
   endif
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha2 FechaVto, C.Total1 Importe, C.Cantidad1 Cantidad ")
SQL.ADD(" , O.FechaOp, C.Cantidad3 Interes, C.Total7 WH from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha2 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Cantidad1 > 0 ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Else
   if Not Vacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ")
   endif
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPCLM','MMLEAS') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha2 FechaVto, C.Total1 Importe, C.Cantidad1 Cantidad ")
SQL.ADD(" , O.FechaOp, C.Cantidad3 Interes, C.Total7 WH from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha2 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Cantidad1 > 0 ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Else
   if Not Vacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ")
   endif
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPEM','MMPIM','MMPOSM') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalNetoCli1 Importe, O.Cantidad ")
SQL.ADD(" , O.FechaOp, O.TotalIntereses Interes, O.TotalAux3 WH from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Else
   if Not Vacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ")
   endif
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPCCV','MMPCL','MMPCOS','MMPE','MMFRP','MMPSI') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalBrutoCli1 Importe,O.Cantidad ")
SQL.ADD(" , O.FechaOp, O.TotalIntereses Interes, O.TotalAux3 WH from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaVto between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Else
   if Not Vacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ")
   endif
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPLME') ")
SQL.ADD("order by 1,3,5,2,4 ")

Recorrer SQL


if Eqstr(Val(t1),'') y eqstr(Val(t2),'') y eqstr(Val(t3),'')
   act(t1, fbn('Vehiculo1'))
   act(t2, fbn('TipoOp'))
   act(t3, fbn('Especie'))
   act(a:fac,fbn('Vehiculo1'))
   AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR6'))
   SetFont(a:fac..k:fac,2)
   ifa
else
*-- Preparo corte de control
  if Not Eqstr(fbn('Vehiculo1'),Val(t1)) y NoVacio(Val(t1))
     act(a:fac,'Total Esp. '~Val(t3) )
     act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
     acn(g:fac, Val(w31))
     acn(h:fac, Val(w32))
     acn(i:fac, Val(w33))
     acn(j:fac, Val(w34))
     acn(k:fac, Val(w35))
     BorrarCeldas(w31..w35)
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..k:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
     acn(g:fac, Val(w21))
     acn(h:fac, Val(w22))
     acn(i:fac, Val(w23))
     acn(j:fac, Val(w24))
     acn(k:fac, Val(w25))
     BorrarCeldas(w21..w25)
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..k:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
     acn(g:fac, Val(w11))
     acn(h:fac, Val(w12))
     acn(i:fac, Val(w13))
     acn(j:fac, Val(w14))
     acn(k:fac, Val(w15))

     SCN(w91, Val(w11))
     SCN(w92, Val(w12))
     SCN(w93, Val(w13))
     SCN(w94, Val(w14))
     SCN(w95, Val(w15))
     
     BorrarCeldas(w11..w15)
     AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..k:fac,2)
     ifa
     act(t1, fbn('Vehiculo1'))
     act(t2, fbn('TipoOp'))
     act(t3, fbn('Especie'))
     ifa
     act(a:fac,fbn('Vehiculo1'))
     AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..k:fac,2)
     ifa
  Else 
   If [Not Eqstr(fbn['TipoOp'],Val(t2))] y NoVacio(Val(t2))
        * Cambia El Tipo de Operacion
        act(a:fac,'Total Esp. '~Val(t3) )
        act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
        acn(g:fac, Val(w31))
        acn(h:fac, Val(w32))
        acn(i:fac, Val(w33))
        acn(j:fac, Val(w34))
        acn(k:fac, Val(w35))
        BorrarCeldas(w31..w35)
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,2)
        ifa
        act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
        acn(g:fac, Val(w21))
        acn(h:fac, Val(w22))
        acn(i:fac, Val(w23))
        acn(j:fac, Val(w24))
        acn(k:fac, Val(w25))
        BorrarCeldas(w21..w25)
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,2)
        ifa
        * Asignar Tipo Operacion
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('TipoOp'))
        act(t3, fbn('Especie'))
  Else
   If [Not Eqstr(fbn('Especie'),Val(t3))] y NoVacio(Val(t3))
*-- Cambia el Especie(Moneda)
        act(a:fac,'Total Esp. '~Val(t3) )
        act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
        acn(g:fac, Val(w31))
        acn(h:fac, Val(w32))
        acn(i:fac, Val(w33))
        acn(j:fac, Val(w34))
        acn(k:fac, Val(w35))
        BorrarCeldas(w31..w35)
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,2)
        ifa
        *va desde aca
        act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1))
        acn(g:fac, Val(w21))
        acn(h:fac, Val(w22))
        acn(i:fac, Val(w23))
        acn(j:fac, Val(w24))
        acn(k:fac, Val(w25))
        BorrarCeldas(w21..w25)
        AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
        SetFont(a:fac..k:fac,2)
        ifa
        *hasta aca
      * Asignar Especie
        act(t1, fbn('Vehiculo1'))
        act(t2, fbn('TipoOp'))
        act(t3, fbn('Especie'))
   EndIf
  EndIf
 Endif
Endif
      *-- A: Cliente(Banco)
      *-- B: TipoOp
      *-- C: NrOperacion 
      *-- D: Fecha Op.
      *-- E: Especie(Moneda)
      *-- g: Importe del Capital o de Amort
      *-- f: Fecha Vto.
      *-- H: Interes
      *-- I: Interes WH
      *-- J: Interes Total
      *-- K: Importe al Vto.
      *-- az1: Cotizacion 
      ACT(a:fac,FBN['Cliente1'])  
      ACT(b:fac,FBN['TipoOp'])   
      ACT(c:fac,FBN['NrOperacion'])
      ACLO(c:fac,FBN['NrOperacion'])
      ACT(d:fac,FBN['FechaOp'])
      ACT(e:fac,FBN['Especie'])
      ACN(az1,CotizacionC(fbn['Especie'],,,,Fsys,1,SI, IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR')))^IIF(EqStr(Modo(fbn['Especie'],IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))),'INV'),-1,1))
      ACN(az2,CotizacionC(fbn['Especie'],,,,Fsys,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
      ACN(g:fac,FBN['Cantidad'])
      ACT(f:fac,FBN['FechaVto'])
      ACN(h:fac,FBN['Interes'])
      ACN(i:fac,FBN['WH'])
      ACN(j:fac,(FBN['Interes']+FBN['WH']))
      ACN(k:fac,(FBN['Interes']+FBN['WH']+FBN['Cantidad']))

      SCN(w11,val(g:fac)*Val(az2))
      SCN(w21,val(g:fac)*Val(az2))
      SCN(w31,val(g:fac))
      SCN(w12,val(h:fac)*Val(az2))
      SCN(w22,val(h:fac)*Val(az2))
      SCN(w32,val(h:fac))
      SCN(w13,val(i:fac)*Val(az2))
      SCN(w23,val(i:fac)*Val(az2))
      SCN(w33,val(i:fac))
      SCN(w14,val(j:fac)*Val(az2))
      SCN(w24,val(j:fac)*Val(az2))
      SCN(w34,val(j:fac))
      SCN(w15,val(k:fac)*Val(az2))
      SCN(w25,val(k:fac)*Val(az2))
      SCN(w35,val(k:fac))
      SetFont(a:FAC..k:FAC,1)
SCN(fi1,1)
Proximo
*-- Veo si hay algo para listar
if Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else
*-- Listo ultimo total
     ifa
     act(a:fac,'Total Esp. '~Val(t3) )
     act(c:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az1))
     acn(g:fac, Val(w31))
     acn(h:fac, Val(w32))
     acn(i:fac, Val(w33))
     acn(j:fac, Val(w34))
     acn(k:fac, Val(w35))
     BorrarCeldas(w31..w35)
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..k:fac,2)
     ifa
     act(a:fac,'Total Op. '~Val(t2)~' en '~Val(mo1) )
     acn(g:fac, Val(w21))
     acn(h:fac, Val(w22))
     acn(i:fac, Val(w23))
     acn(j:fac, Val(w24))
     acn(k:fac, Val(w25))
     BorrarCeldas(w21..w25)
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..k:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(t1)~' en '~Val(mo1))
     acn(g:fac, Val(w11))
     acn(h:fac, Val(w12))
     acn(i:fac, Val(w13))
     acn(j:fac, Val(w14))
     acn(k:fac, Val(w15))

     SCN(w91, Val(w11))
     SCN(w92, Val(w12))
     SCN(w93, Val(w13))
     SCN(w94, Val(w14))
     SCN(w95, Val(w15))
   
     BorrarCeldas(w11..w15)
     AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..k:fac,2)
     ifa
     ifa
     act(a:fac,'Total General en '~Val(mo1))
     acn(g:fac, Val(w91))
     acn(h:fac, Val(w92))
     acn(i:fac, Val(w93))
     acn(j:fac, Val(w94))
     acn(k:fac, Val(w95))
     BorrarCeldas(w91..w95)
     AgregarMarco(a:fac..k:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..k:fac,3)
FormatoCeldas(g:val(z11)..k:fac,Exe('F2'))

ACO(1,10)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,3)
ACO(6,7)
ACO(7,11)
ACO(8,11)
ACO(9,11)
ACO(10,11)
ACO(11,11)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)

*
*    Esto es lo que agrega Silvia
*
RangoTitulo(a:1..k:FAC, 10)

Endif









