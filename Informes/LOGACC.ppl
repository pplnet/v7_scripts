CrearDialogo
  Fecha1:'F.Desde';;;;;;Dialogo.Fecha1>0;'Debe ingresar una fecha valida';NO;Hoy
  Fecha2:'F.Hasta';;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha hasta debe ser mayor o igual a Fecha Desde';NO;Hoy
  Radio1: 'Consolida Dia|Si|No';;;;;;;;;0
  Check2  : 'Exporta PDF' ;;;;NO;NO;;;;0;
FinDialogo
if Not OK
  cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:fac, 'FPA V6')
ACT(d:FAC, 'Log de Accesos Fallidos')
if Dialogo.Radio1 = 0
ACT(d:FAC+1, 'Consolidado por Dia')
endif
AlinearCeldas(d:FAC..d:FAC+1,'C')
ACT(a:FAC+1, 'Desde Fecha : '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Hasta Fecha : '~Dialogo.Fecha2)

ACT(a:FAC+4, 'Fecha')
ACT(b:FAC+4, 'Hora')
ACT(c:FAC+4, 'Usuario')
ACT(d:FAC+4, 'Nombre')
ACT(e:FAC+4, 'Falla')
ACT(f:FAC+4, 'Cant.Intentos')
*ACT(g:FAC+4, 'Usr.Sybase')
SetFont(a:FAC..g:FAC+4,2)
AgregarMarco(a:FAC+4..g:fac+4, 2, 1, Exe('COLOR'))

SetFilaActual(FAC+4)
SQL.ADD("Select *,Convert(Float,ValorActual),Convert(date,Fecha) from "~DBO~".PMAUDIT ")
SQL.ADD(" WHERE Tabla ='USUARIOS' ")
SQL.ADD("   and Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Fecha <  '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD("   and Accion = 'M' ")
SQL.ADD("   and Campo = 'CantIntentos' ")
SQL.ADD("   and Convert(Float,ValorActual) > 0 ")
SQL.ADD(" Union ")
SQL.ADD("Select *,Convert(Float,ValorActual),Convert(date,Fecha) from "~DBO~".PMAUDIT2 ")
SQL.ADD(" WHERE Tabla ='USUARIOS' ")
SQL.ADD("   and Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Fecha <  '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD("   and Accion = 'M' ")
SQL.ADD("   and Campo = 'CantIntentos' ")
SQL.ADD("   and Convert(Float,ValorActual) > 0 ")
SQL.ADD(" Order by Convert(date,Fecha) Asc,Codigo Asc, Convert(Float,ValorActual) Desc")

act(xa1,'')
Recorrer SQL

If Dialogo.Radio1 = 0
  if not EqStr(val(xa1),Fecha(fbn('Fecha'))~fbn('Codigo'))
     act(xa1,Fecha(fbn('Fecha'))~fbn('Codigo'))
     SCN(x1,1)
     ACD(a:fac, Fecha(fbn('Fecha')))
     ACT(b:fac, Hora(fbn('Fecha')))
     ACT(c:fac, fbn('Codigo'))
     ACT(d:fac, BuscarCampo('USUARIOS','Nombre','Codigo',fbn('Codigo')))
     ACT(e:fac, 'Intento fallido')
     ACN(f:fac, Num(fbn('ValorActual')))
     AlinearCeldas(a:fac..a:fac,'I')
     FormatoCeldas(f:fac..f:fac,Exe('F0'))
     SetFont(a:fac..g:fac,1)
  else
     dfa
  endif
else
     SCN(x1,1)
     ACD(a:fac, Fecha(fbn('Fecha')))
     ACT(b:fac, Hora(fbn('Fecha')))
     ACT(c:fac, fbn('Codigo'))
     ACT(d:fac, BuscarCampo('USUARIOS','Nombre','Codigo',fbn('Codigo')))
     ACT(e:fac, 'Intento fallido')
     ACN(f:fac, Num(fbn('ValorActual')))
     AlinearCeldas(a:fac..a:fac,'I')
     FormatoCeldas(f:fac..f:fac,Exe('F0'))
     SetFont(a:fac..g:fac,1)
Endif
proximo

if Val(x1)=0
  SetFilaActual(FAC+2)
  ACT(d:FAC, 'N I L')
  AlinearCeldas(d:FAC,'C')
  SetFont(d:FAC,2)
endif

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,15)
ACO(5,10)
ACO(6,6)
ACO(7,7)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))
ACT(g:2, 'CONFIDENCIAL')
AlinearCeldas(g:2,'D') 
SetFont(g:2,2)
act(ar:1,VAR('PATHLOGAUD')~'Log_de_accesos_fallidos_'~Fecha(FECHASYS,'YYYYMMDD')~'.pdf')

LimitesVision(g:FAC)
RangoTitulo(a:1..g:FAC, Val(w1)+4)

SetMargins(0.5,0.5,0.5,1.5)
Impresion(1,1)
Impresion(2,1)
Impresion(3,1)
Impresion(4,2)

if Dialogo.Check2=1
   HojaVisible(NO)
   *act(ho:1,Hora(AHORA))
   *act(ho:2,Copy(val(ho:1),1,2)~Copy(val(ho:1),4,2)~Copy(val(ho:1),7,2))
   *   act(ar:1,VAR('PATHLOGAUD')~'Log_de_accesos_fallidos_'~Fecha(FECHASYS,'YYYYMMDD')~'.pdf')
   BorrarArchivo(val(ar:1))
   ExportarPdf(val(ar:1))
endif
