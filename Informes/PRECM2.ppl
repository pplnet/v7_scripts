**--PRECM2 - Auxiliar 2 Prec.Mutos (Aprueba)
*ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1:'Op Precan'       ;;;;  ;;SQL("Select 1 From "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"' and TipoOp = 'MMPREC' and MB3 = 1 and CB6 = 0 ") = 1;'Operacion Invalida';NO;;;;;;" TipoOp = 'MMPREC' and MB3 = 1 and CB6 = 0 "
  Check1      :'Procesa'         ;;;;NO;;;;;0
  Check2      :'Automatico'      ;;;;NO;;;;;0
FinDialogo
If not Ok
  Cancelar
EndIf
if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(a:1, 'Op.Precan')
ACT(a:2, 'Op.Original')
ACT(a:3, 'Op.Afectada')
ACT(a:4, 'Tipo Op')
ACT(a:5, 'Tipo Canc.')
ACT(a:6, 'Mon Orig.')
ACT(a:7, 'Mon Canc.')
ACT(a:8, 'T.C.')
ACT(a:9, 'Cuotas')
ACT(a:10, 'Cuota Vig.')
ACT(a:11, 'Fecha Precan')
ACT(a:12, 'Plazo a Dev')
ACT(a:13, 'F.Fin Cuota Vig')
ACT(a:14, 'Ord.Can.Capital')
ACT(a:15, 'Ord.Can.')
ACT(a:16, 'Capital Vigente')
ACT(a:17, 'RB8')
ACT(a:18, 'RB6')

ACT(b:20, 'Mon.Can.')
ACT(c:20, 'Mon.Orig.')

ACT(a:21, 'Int.')
ACT(a:22, 'Imp.s/Int')
ACT(a:23, 'Gastos')
ACT(a:24, 'Imp.s/Gtos')
ACT(a:25, 'Capital')
ACT(a:26, 'Total')

ACT(a:29, 'Cap.Restante')
ACT(a:30, 'Cap.a Asignar')

ACT(a:32, 'TasaPrecan')
ACT(a:33, 'Tasa WH')
ACT(a:35, 'Op Vinculada')

SetFont(a:1..a:35, 2)

SQL.ADD("Select * from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
recorrer SQL
  ACT(b:1, fbn('NrOperacion'))
  ACT(c:1, fbn('TipoOp'))
  ACT(b:2, fbn('NrOperacion6'))
  ACT(c:2, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion6')))
  ACT(b:3, fbn('NrOperacion5'))
  ACT(c:3, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacion5')))
  ACN(b:4, fbn('MB3'))
  if fbn('MB3')=0
    ACT(c:4, 'Prestamo')
  else
    if fbn('MB3')=1
      ACT(c:4, 'Colocacion')
    else
      ACT(c:4, 'Indefinido')
      ACN(y:1, 1)
    endif
  endif
  ACN(b:5, fbn('RB7'))
  if fbn('RB7')=0
    ACT(c:5, 'Parcial')
  else
    if fbn('RB7')=1
      ACT(c:5, 'Total')
    else
      ACT(c:5, 'Indefinido')
      ACN(y:1, 1)
    endif
  endif
  ACT(b:6, fbn('ContraEspecie2'))
  ACT(b:7, fbn('Especie'))
  ACN(b:8, fbn('TipoCambio'))
  ACN(c:8, fbn('TipoCambio')^iif(EqStr(Modo(fbn('Especie'),fbn('ContraEspecie2')),'DIR'),1,-1))
  ACN(b:9, fbn('Cuotas1'))
  ACN(b:10, fbn('Cuotas2'))
  ACD(b:11, fbn('FechaPrecan'))
  ACN(b:12, fbn('Plazo2'))
  ACN(b:14, fbn('RB12'))
  if fbn('RB12')=0
    ACT(c:14, 'PEPS')
  else
    if fbn('RB12')=1
      ACT(c:14, 'UEPS')
    else
      if fbn('RB12')=2
        ACT(c:14, 'Prorrateo')
      else
        ACT(c:14, 'Indefinido')
        ACN(y:1, 1)
      endif
    endif
  endif
  ACN(b:15, fbn('RB7'))
  if fbn('RB7')=0
    ACT(c:15, 'Ints + Gtos')
  else
    if fbn('RB7')=1
      ACT(c:15, 'Gtos + Ints')
    else
      ACT(c:15, 'Indefinido')
      ACN(y:1, 1)
    endif
  endif
  ACN(b:16, fbn('TotalNetoCli1'))
  ACN(b:17, fbn('RB8'))
  ACN(b:18, fbn('RB6'))
  ACN(b:32, fbn('TasaPrecan'))
  ACN(b:33, fbn('TotalAux1'))
  ACT(b:35, fbn('NrOperacion3'))

  * Intereses
  ACN(b:21, Round(fbn('IntDevengados1')/Val(c:8),2))
  ACN(c:21, Round(fbn('IntDevengados1'),2))

  * impuestos Sobre Intereses
  ACN(b:22, 0)
  ACN(c:22, 0)

  if fbn('RB9')=0
    ACN(b:23, 0)
    ACN(c:23, 0)
    ACT(d:23, 'Sin Gastos')
  else
    ACN(b:23, Round(fbn('TotalGastos'),2))
    ACN(c:23, Round(fbn('TotalGastos')*Val(c:8),2))
  endif

  * impuestos Sobre Gastos
  ACN(b:24, 0)
  ACN(c:24, 0)

  if fbn('RB7')=0
    * Cancelacion Parcial
    * Monto Total
    ACN(b:26, Round(fbn('Cantidad'),2))
    ACN(c:26, Round(fbn('TotalNEtoCli2'),2))
    ACT(d:26, 'Dato')
    * Capital
    ACN(b:25, Round(Val(b:26)-Sum(b:21..b:24),2))
    ACN(c:25, Round(Val(c:26)-Sum(c:21..c:24),2))
    ACT(d:25, 'Calculo')
  else
    * Cancelacion Total
    * Capital
    ACN(b:25, Round(fbn('TotalNetoCli1')*Val(c:8),2))
    ACN(c:25, Round(fbn('TotalNetoCli1'),2))
    ACT(d:25, 'Dato')
    * Monto Total
    ACN(b:26, Round(Sum(b:21..b:25),2))
    ACN(c:26, Round(Sum(c:21..c:25),2))
    ACT(d:26, 'Suma')
  endif

proximo

ACN(c:29, Val(b:16)-Val(c:25))
ACN(b:30, Val(b:25))
ACN(c:30, Val(c:25))

SetFont(b:1..c:35, 1)
SetFont(b:20..c:20, 2)

FormatoCeldas(b:8..c:8,Exe('F8'))
FormatoCeldas(b:9..c:10,Exe('F0'))
FormatoCeldas(b:12..c:12,Exe('F2'))
FormatoCeldas(b:21..c:26,Exe('F2'))

ACT(f:1, 'Datos Actuales')
ACT(f:2, 'NrOperacion')
ACT(g:2, 'NrCuota')
ACT(h:2, 'F.Inicio')
ACT(i:2, 'F.Fin')
ACT(j:2, 'Plazo')
ACT(k:2, 'Cantidad')
ACT(l:2, 'Tasa')
ACT(m:2, 'Spread')
ACT(n:2, 'Intereses')
ACT(o:2, '% Amort.')
ACT(p:2, 'Amort.')
ACT(q:2, 'Prorrog.')
ACT(r:2, 'x Precan.')

ACT(s:1, 'Datos Nuevos')

ACT(u:1, 'Fecha1')
ACT(v:1, 'Plazo1')
ACT(aa:1, 'Cantidad2')
ACT(ab:1, 'Cantidad1')
ACT(ae:1, 'Cantidad3')
ACT(af:1, 'Total2')
ACT(ag:1, 'Total3')
ACT(ah:1, 'Total1')
ACT(bc:1, 'Total7')
ACT(be:1, 'Cantidad4')

ACT(s:2, '# Cuota')
ACT(t:2, 'F.Inicio')
ACT(u:2, 'F.Fin')
ACT(v:2, 'Plazo')
ACT(w:2, 'Estado')
ACT(aa:2, 'Capital')
ACT(ab:2, 'Amort')
ACT(ac:2, 'Cap.Post')
ACT(ad:2, '% Amort')
ACT(ae:2, 'Interes')
ACT(af:2, 'Monto')
ACT(ag:2, 'Int. Neto')
ACT(ah:2, 'Monto Neto')
ACT(ak:2, 'Accion')
ACT(ba:2, 'Int.Neto')
ACT(bb:2, 'WH a Liq')
ACT(bc:2, 'WH a Liq')
ACT(bd:2, 'Inp.Imp.Extr.')
ACT(be:2, 'Inp.Imp.Extr.')
ACT(bf:2, 'Tasa Int WH')
SetFont(f:1..bz:2, 2)

SetFilaActual(2)
SQL.ADD("Select * from "~DBO~".CUOTAS where NrOperacion = '"~Val(b:3)~"' order by NrCuota")
recorrer SQL
  ACT(f:FAC, fbn('NrOperacion'))
  ACN(g:FAC, fbn('NrCuota'))
  ACD(h:FAC, fbn('Fecha1'))
  ACD(i:FAC, fbn('Fecha2'))
  ACN(j:FAC, fbn('Plazo1'))
  ACN(k:FAC, fbn('Cantidad2'))
  ACN(l:FAC, fbn('Precio2'))
  ACN(m:FAC, fbn('Precio4'))
  ACN(n:FAC, fbn('Cantidad3'))
  ACN(o:FAC, fbn('Tasa1'))
  ACN(p:FAC, fbn('Cantidad1'))
  ACN(q:FAC, fbn('Radio1'))
  ACN(r:FAC, fbn('Check1'))
  ACN(ba:FAC, fbn('Total3'))
  ACN(bb:FAC, fbn('Total7'))
  ACN(bd:FAC, fbn('Cantidad4'))
  ACN(bf:FAC, fbn('Total6'))
  if fbn('NrCuota')<Val(b:10)
    ACT(w:FAC, 'Vencida')
  endif
  if fbn('NrCuota')=Val(b:10)
    ACN(s:FAC, fbn('NrCuota'))
    ACD(t:FAC, fbn('Fecha1'))
    ACD(u:FAC, Val(b:11))
    ACN(v:FAC, Val(b:11)-fbn('Fecha1'))
    ACT(w:FAC, 'Mod x Prec')
    ACD(b:13, fbn('Fecha2'))
    SetFont(b:13, 1)
    IFA
    ACT(f:FAC, Val(b:3))
    ACN(l:FAC, fbn('Precio2'))
    ACN(m:FAC, fbn('Precio4'))

    ACN(p:FAC-1, 0)
    ACN(p:FAC, fbn('Cantidad1'))

    ACN(s:FAC, fbn('NrCuota')+1)
    ACD(t:FAC, Val(b:11))
    ACD(u:FAC, Val(b:13))
    ACN(v:FAC, Val(u:FAC)-Val(t:FAC))
    ACT(w:FAC, 'Nueva')
  endif
  if fbn('NrCuota')>Val(b:10)
    ACN(s:FAC, fbn('NrCuota')+1)
    ACD(t:FAC, fbn('Fecha1'))
    ACD(u:FAC, fbn('Fecha2'))
    ACN(v:FAC, fbn('Plazo1'))
    ACT(w:FAC, 'Vigente')
  endif
Proximo

if FAC>2
  ACN(y:2, FAC-2)
  ACN(y:3, FAC+1)
  ************************************
  ** Distribucion de Capital Cancelado
  ************************************
  recorrer&i 3,FAC
    if Val(s:&i)=Val(b:10)
      ACN(ab:&i, Val(c:25))
    endif
    if Val(s:&i)>Val(b:10)
      if Val(b:14)=0
        ** PEPS
        if Val(c:30)>0
          if Val(p:&i)>Val(c:30)
            ACN(ab:&i, Val(p:&i)-Val(c:30))
            ACN(c:30, 0)
          else
            ACN(ab:&i, 0)
            SCN(c:30, -Val(p:&i))
          endif
        else
          ACN(ab:&i, Val(p:&i))
        endif
      endif
      if Val(b:14)=1
        ** UEPS
        ACN(y:4, FAC-&i+4)
        if Val(c:30)>0
          if Val(p:Val(y:4))>Val(c:30)
            ACN(ab:Val(y:4), Val(p:Val(y:4))-Val(c:30))
            ACN(c:30, 0)
          else
            ACN(ab:Val(y:4), 0)
            SCN(c:30, -Val(p:Val(y:4)))
          endif
        else
          ACN(ab:Val(y:4), Val(p:Val(y:4)))
        endif
      endif
      if Val(b:14)=2
        ** Prorrat
        ACN(ad:&i, Val(p:&i)/Val(b:16))
        ACN(ab:&i, Val(c:29)*Val(ad:&i))
        SCN(c:30, -Val(c:25)*Val(ad:&i))
      endif
    endif

  proximo
  recorrer&i 3,FAC
    if Val(s:&i)>=Val(b:10)
      * Capital (Cantidad2)
      if Val(s:&i)=Val(b:10)
        ACN(aa:&i, Val(k:&i))
      else
        ACN(aa:&i, Val(ac:&i-1))
      endif
      ACN(ac:&i, Val(aa:&i)-Val(ab:&i))
    endif
    * Intereses (Cantidad3)
    ACN(ae:&i, Val(aa:&i)*((Val(m:&i)+Val(l:&i))/100)*FACTORDIAS(Val(t:&i),Val(u:&i),Val(b:17)+1))
    * Monto (Total2)
    ACN(af:&i, Val(ab:&i)+Val(ae:&i))

    * WH a Liq (Total7)
    ACN(bc:&i, iif(Val(b:18)=2 y Val(b:4)=0,( ( (Val(aa:&i)  * Val(bf:&i)  / 100) * FactorDias(Val(t:&i),Val(u:&i),Val(b:17)+1) ) * (Val(b:33)/100)), 0))
    * Imp.Imp_Extr. (Cantidad4)
    ACN(be:&i, iif(Val(b:18)=3 o [Val(b:18)=4 y Val(b:4)=0],Val(ae:&i)*Val(b:32)/100,0))
    * Interes Neto (Total3)
    ACN(ag:&i, Val(ae:&i)+Val(bc:&i)+iif(Val(b:18)=4 y Val(b:4)=0,Val(be:&i),0))
    * Monto Neto (Total1)
    ACN(ah:&i, Val(ab:&i)+Val(ag:&i))

  proximo
  if Val(y:1)=0
    * no Hubo errores
    recorrer&i 1,Val(y:2)
      SCN(y:5, 1)
      ACN(y:4, Val(y:3)-&i)
      if EqStr(Val(w:Val(y:4)),'Vigente')
        ACT(ak:Val(y:4), 'Actualiza')
        if Dialogo.Check1=1
          * Procesa
          SQL.ADD("Update "~DBO~".CUOTAS  ")
          SQL.ADD("   Set NrCuota   = "~FStr(Val(s:Val(y:4)),1,0)~", ")
          * Importe Amortizacion
          SQL.ADD("       Cantidad1 = "~FStr(Val(ab:Val(y:4)),1,0)~", ")
          * Valor Nominal
          SQL.ADD("       Cantidad2 = "~FStr(Val(aa:Val(y:4)),1,0)~", ")
          * Interes
          SQL.ADD("       Cantidad3 = "~FStr(Val(ae:Val(y:4)),1,0)~", ")
          * Monto
          SQL.ADD("       Total2    = "~FStr(Val(af:Val(y:4)),1,0)~", ")
          * WH a Liq
          SQL.ADD("       Total7    = "~FStr(Val(bc:Val(y:4)),1,0)~", ")
          * Inpp.Imp.Extr.
          SQL.ADD("       Cantidad4 = "~FStr(Val(be:Val(y:4)),1,0)~", ")
          * Interes Neto
          SQL.ADD("       Total3    = "~FStr(Val(ag:Val(y:4)),1,0)~", ")
          * Monto Neto
          SQL.ADD("       Total1    = "~FStr(Val(ah:Val(y:4)),1,0)~" ")
          SQL.ADD(" where NrOperacion = '"~Val(b:3)~"' ")
          SQL.ADD("   and NrCuota     = "~FStr(Val(g:Val(y:4)),1,0)~" ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
      if EqStr(Val(w:Val(y:4)),'Nueva')
        ACT(ak:Val(y:4), 'Crea')          
        if Dialogo.Check1=1
          SQL.ADD("INSERT INTO "~DBO~".CUOTAS ( ")
          SQL.ADD("  NrOperacion, NrCuota,      Cliente1,     Cliente2,     Vehiculo1, ")
          SQL.ADD("  Vehiculo2,   Especie1,     Especie2,     Especie3,     Especie4, ")
          SQL.ADD("  Check1,      Check2,       Check3,       Check4,       Check5, ")
          SQL.ADD("  Check6,      Check7,       Check8,       Check9,       Check10, ")
          SQL.ADD("  Radio1,      Radio2,       Radio3,       Radio4,       Radio5, ")
          SQL.ADD("  Radio6,      Radio7,       Radio8,       Radio9,       Radio10, ")
          SQL.ADD("  Fecha1,      Fecha2,       Fecha3,       Fecha4,       Fecha5, ")
          SQL.ADD("  Fecha6,      Fecha7,       Fecha8,       Fecha9,       Fecha10, ")
          SQL.ADD("  Mercado1,    Mercado2,     Plazo1,       Plazo2,       Plazo3, ")
          SQL.ADD("  Plazo4,      Cantidad1,    Cantidad2,    Cantidad3,    Cantidad4, ")
          SQL.ADD("  Precio1,     Precio2,      Precio3,      Precio4,      Total1, ")
          SQL.ADD("  Total2,      Total3,       Total4,       Total5,       Total6, ")
          SQL.ADD("  Total7,      Total8,       Tasa1,        Tasa2,        PrecioRef1, ")
          SQL.ADD("  PrecioRef2,  Cantidad5,    Cantidad6,    Precio5,      Precio6, ")
          SQL.ADD("  Precio7,     Precio8,      Tasa3,        Total9,       Cotizacion1, ")
          SQL.ADD("  Cotizacion2, Tasa4,        Tasa5,        Cantidad7,    Cantidad8, ")
          SQL.ADD("  Coeficiente, Cantidad1Ori, Cantidad2Ori, Cantidad3Ori, ResultadoIndice, ")
          SQL.ADD("  Cantidad9,   Cantidad10,   Cantidad11,   Cantidad12,   Total10, ")
          SQL.ADD("  Total11,     Total12 ")
          SQL.ADD(" )")
          
          SQL.ADD("SELECT NrOperacion, ")
          SQL.ADD("       "~FStr(Val(s:Val(y:4)),1,0)~" as NrCuota, ")
          SQL.ADD("       Cliente1, ")
          SQL.ADD("       Cliente2, ")
          SQL.ADD("       Vehiculo1, ")

          SQL.ADD("       Vehiculo2, ")
          SQL.ADD("       Especie1, ")
          SQL.ADD("       Especie2, ")
          SQL.ADD("       Especie3, ")
          SQL.ADD("       Especie4, ")

          SQL.ADD("       Check1, ")
          SQL.ADD("       Check2, ")
          SQL.ADD("       Check3, ")
          SQL.ADD("       Check4, ")
          SQL.ADD("       Check5, ")

          SQL.ADD("       Check6, ")
          SQL.ADD("       Check7, ")
          SQL.ADD("       Check8, ")
          SQL.ADD("       Check9, ")
          SQL.ADD("       Check10, ")

          SQL.ADD("       Radio1, ")
          SQL.ADD("       Radio2, ")
          SQL.ADD("       Radio3, ")
          SQL.ADD("       Radio4, ")
          SQL.ADD("       Radio5, ")

          SQL.ADD("       Radio6, ")
          SQL.ADD("       Radio7, ")
          SQL.ADD("       Radio8, ")
          SQL.ADD("       Radio9, ")
          SQL.ADD("       Radio10, ")

          SQL.ADD("       "~IdxDate2(Val(t:Val(y:4)))~" as Fecha1, ")
          SQL.ADD("       Fecha2, ")
          SQL.ADD("       Fecha3, ")
          SQL.ADD("       Fecha4, ")
          SQL.ADD("       Fecha5, ")

          SQL.ADD("       Fecha6, ")
          SQL.ADD("       Fecha7, ")
          SQL.ADD("       Fecha8, ")
          SQL.ADD("       Fecha9, ")
          SQL.ADD("       Fecha10, ")

          SQL.ADD("       Mercado1, ")
          SQL.ADD("       Mercado2, ")
          SQL.ADD("       "~FStr(Val(v:Val(y:4)),1,0)~" as Plazo1, ")
          SQL.ADD("       Plazo2, ")
          SQL.ADD("       Plazo3, ")

          SQL.ADD("       Plazo4, ")
          SQL.ADD("       "~FStr(Val(ab:Val(y:4)),1,2)~" as Cantidad1, ")
          SQL.ADD("       "~FStr(Val(aa:Val(y:4)),1,2)~" as Cantidad2, ")
          SQL.ADD("       "~FStr(Val(ae:Val(y:4)),1,2)~" as Cantidad3, ")
          SQL.ADD("       "~FStr(Val(be:Val(y:4)),1,2)~" as Cantidad4, ")

          SQL.ADD("       Precio1, ")
          SQL.ADD("       Precio2, ")
          SQL.ADD("       Precio3, ")
          SQL.ADD("       Precio4, ")
          SQL.ADD("       "~FStr(Val(ah:Val(y:4)),1,2)~" as Total1, ")

          SQL.ADD("       "~FStr(Val(af:Val(y:4)),1,2)~" as Total2, ")
          SQL.ADD("       "~FStr(Val(ag:Val(y:4)),1,2)~" as Total3, ")
          SQL.ADD("       Total4, ")
          SQL.ADD("       Total5, ")
          SQL.ADD("       Total6, ")

          SQL.ADD("       "~FStr(Val(bc:Val(y:4)),1,2)~" as Total7, ")
          SQL.ADD("       Total8, ")
          SQL.ADD("       Tasa1, ")
          SQL.ADD("       Tasa2, ")
          SQL.ADD("       PrecioRef1, ")

          SQL.ADD("       PrecioRef2, ")
          SQL.ADD("       Cantidad5, ")
          SQL.ADD("       Cantidad6, ")
          SQL.ADD("       Precio5, ")
          SQL.ADD("       Precio6, ")

          SQL.ADD("       Precio7, ")
          SQL.ADD("       Precio8,  ")
          SQL.ADD("       Tasa3, ")
          SQL.ADD("       Total9, ")
          SQL.ADD("       Cotizacion1, ")

          SQL.ADD("       Cotizacion2, ")
          SQL.ADD("       Tasa4, ")
          SQL.ADD("       Tasa5, ")
          SQL.ADD("       Cantidad7, ")
          SQL.ADD("       Cantidad8, ")

          SQL.ADD("       Coeficiente, ")
          SQL.ADD("       Cantidad1Ori, ")
          SQL.ADD("       Cantidad2Ori, ")
          SQL.ADD("       Cantidad3Ori, ")
          SQL.ADD("       ResultadoIndice, ")

          SQL.ADD("       Cantidad9, ")
          SQL.ADD("       Cantidad10, ")
          SQL.ADD("       Cantidad11, ")
          SQL.ADD("       Cantidad12, ")
          SQL.ADD("       Total10, ")

          SQL.ADD("       Total11, ")
          SQL.ADD("       Total12 ")
          SQL.ADD("  FROM "~DBO~".CUOTAS ")
          SQL.ADD(" WHERE NrOperacion = '"~Val(b:3)~"' ")
          SQL.ADD("   and NrCuota     = "~FStr(Val(b:10),1,0)~" ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
      if EqStr(Val(w:Val(y:4)),'Mod x Prec')
        ACT(ak:Val(y:4), 'Modifica')          
        if Dialogo.Check1=1
          * Procesa
          SQL.ADD("Update "~DBO~".CUOTAS  ")
          SQL.ADD("   Set NrCuota   = "~FStr(Val(s:Val(y:4)),1,0)~", ")
          SQL.ADD("       Fecha2    = "~IdxDate2(Val(u:Val(y:4)))~", ")
          SQL.ADD("       Fecha3    = "~IdxDate2(Val(u:Val(y:4)))~", ")
          SQL.ADD("       Plazo1    = "~FStr(Val(v:Val(y:4)),1,0)~", ")
          * Importe Amortizacion
          SQL.ADD("       Cantidad1 = "~FStr(Val(ab:Val(y:4)),1,2)~", ")
          * Valor Nominal
          SQL.ADD("       Cantidad2 = "~FStr(Val(aa:Val(y:4)),1,2)~", ")
          * Interes
          SQL.ADD("       Cantidad3 = "~FStr(Val(ae:Val(y:4)),1,2)~", ")
          * Monto
          SQL.ADD("       Total2    = "~FStr(Val(af:Val(y:4)),1,2)~", ")
          * WH a Liq
          SQL.ADD("       Total7    = "~FStr(Val(bc:Val(y:4)),1,2)~", ")
          * Imp.Imp.Extr.
          SQL.ADD("       Cantidad4 = "~FStr(Val(be:Val(y:4)),1,2)~", ")
          * Interes Neto
          SQL.ADD("       Total3    = "~FStr(Val(ag:Val(y:4)),1,2)~", ")
          * Monto Neto
          SQL.ADD("       Total1    = "~FStr(Val(ah:Val(y:4)),1,2)~", ")
          SQL.ADD("       Check1    = '1' ")
          SQL.ADD(" where NrOperacion = '"~Val(b:3)~"' ")
          SQL.ADD("   and NrCuota     = "~FStr(Val(g:Val(y:4)),1,0)~" ")
          SQL.NEW
          SQL.EXEC
        endif
      endif
      ACN(al:Val(y:4), Val(y:5))
    proximo
    if Dialogo.Check1=1
      SQL.ADD("Update "~DBO~".OPERACIONES ")
      SQL.ADD("   Set CB6 = '1', ")
      if Val(b:5)=0
        * Prec.Parcial 
        * Actualizo Capital
        SQL.ADD("       TotalBrutoCli1 = "~FStr(Val(c:25),1,2)~", ")
        SQL.ADD("       TotalBrutoCli2 = "~FStr(Val(b:25),1,2)~", ")
      else
        * Prec.Total
        * Actualizo Capital
        SQL.ADD("       TotalBrutoCli1 = TotalNetoCli1, ")
        SQL.ADD("       TotalBrutoCli2 = "~FStr(Val(b:25),1,2)~", ")
        * Actualizo Monto Total
        SQL.ADD("       TotalNetoCli2 = "~FStr(Val(c:26),1,2)~", ")
        SQL.ADD("       Cantidad      = "~FStr(Val(b:26),1,2)~", ")
      endif
      SQL.ADD("       IntDevengados2 = "~FStr(Val(b:21),1,2)~" ")
      SQL.ADD(" where NrOperacion = '"~Val(b:1)~"' ")
      SQL.NEW
      SQL.EXEC

      *** Actualiza movimientos, posiciones y limites Y Devengados ****
      *** De la Precancelacion (MMPREC)
      SQL.ActualizarMovimientos3(Val(b:1),SI,NO,NO,SI,SI)
      SQL.EXEC
      *** De la Precancelada (MMPCCM o MMPRCO)
      SQL.ActualizarMovimientos3(Val(b:3),SI,NO,NO,SI,SI)
      SQL.EXEC
    endif
  endif

  SetFilaActual(FAC+2)
  ACN(n:FAC, Sum(n:3..n:FAC-1))
  ACN(p:FAC, Sum(p:3..p:FAC-1))
  ACN(ab:FAC, Sum(ab:3..ab:FAC-1))
  ACN(ae:FAC, Sum(ae:3..ae:FAC-1))
  
  SetFont(f:3..bz:FAC, 1)
  FormatoCeldas(g:3..g:FAC,Exe('F0'))
  FormatoCeldas(j:3..j:FAC,Exe('F0'))
  FormatoCeldas(k:3..k:FAC,Exe('F2'))
  FormatoCeldas(l:3..m:FAC,Exe('F8'))
  FormatoCeldas(n:3..n:FAC,Exe('F2'))
  FormatoCeldas(o:3..o:FAC,Exe('F8'))
  FormatoCeldas(p:3..p:FAC,Exe('F2'))
  FormatoCeldas(q:3..s:FAC,Exe('F0'))
  FormatoCeldas(v:3..v:FAC,Exe('F0'))
  FormatoCeldas(aa:3..ah:FAC,Exe('F2'))
  FormatoCeldas(ad:3..ad:FAC,Exe('F8'))
  FormatoCeldas(ba:3..be:FAC,Exe('F2'))
  FormatoCeldas(bf:3..bf:FAC,Exe('F8'))
else
  ACN(y:1, 1)
endif

if Dialogo.Check2=0 y Dialogo.Check1=1
  if NoVacio(Val(b:35))
    EjecutarEvento('PRECM2',NrOperacion1=Val(b:35),Check1=Dialogo.Check1,Check2=1)
    ACT(c:35, 'Llama a PRECM2')
  endif
endif

ACO(1,10)
ACO(2,10)
ACO(3,10)
