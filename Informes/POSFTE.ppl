MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'          ;;;;;;;;;fsys  
  Cliente1 : 'Cliente'        ;;;;;;
  Especie1 : 'Especie'        ;;;;;;Vacio(Dialogo.Especie1) O [DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y EsTerminal(Dialogo.Especie1, Especie)];'Debe ingresar un titulo';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "
  Lista1   : 'Cartera'        ;0;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')
CrearFont(5, 'Arial,12,B')

SetFilaActual(1)

ACT(D:fac, 'Posiciones de Futuros Terceros')
SetFont(D:fac, 5)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ACT(A:fac+1, 'Cliente: '~IIF(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(B:fac, 'Especies: '~IIF(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ACT(B:fac+1, 'Carteras: '~IIF(NoVacio(Dialogo.Lista1),Dialogo.Lista1,'Todas'))
ifa
ifa

SetFont(a:1, 4)
SetFont(a:2..z:7, 2)

SetFilaActual(fac+2)
ACT(A:fac, 'Especie')
ACT(B:fac, 'Cliente')
ACT(C:fac, 'Origen')

ACT(D:fac, 'Inicio')
ACT(D:fac+1, 'Posicion')
ACT(E:fac+1, 'Precio Mercado')

ACT(F:fac, 'Compras')
ACT(F:fac+1, 'Posicion')
ACT(G:fac+1, 'PPPC')

ACT(H:fac, 'Ventas')
ACT(H:fac+1, 'Posicion')
ACT(I:fac+1, 'PPPV')

ACT(H:fac, 'Ventas')
ACT(H:fac+1, 'Posicion')
ACT(I:fac+1, 'PPPV')

ACT(J:fac, 'Neto')
ACT(J:fac+1, 'Posicion')
ACT(K:fac+1, 'Precio')

ACT(L:fac, 'Fin')
ACT(L:fac+1, 'Posicion')
ACT(M:fac+1, 'Precio Mercado')

AgregarMarco(a:fac..a:fac+1,0,0,EXE('COLOR'))
AgregarMarco(b:fac..b:fac+1,0,0,EXE('COLOR'))
AgregarMarco(c:fac..c:fac+1,0,0,EXE('COLOR'))
AgregarMarco(d:fac..e:fac+1,0,0,EXE('COLOR'))
AgregarMarco(f:fac..g:fac+1,0,0,EXE('COLOR'))
AgregarMarco(h:fac..i:fac+1,0,0,EXE('COLOR'))
AgregarMarco(j:fac..k:fac+1,0,0,EXE('COLOR'))
AgregarMarco(l:fac..m:fac+1,0,0,EXE('COLOR'))
SetFont(a:fac..z:fac+1, 2)
ifa

*INICIAL
SQL.ADD(" SELECT Especie, Cliente1, FechaVto, ContraEspecie, 'INICIO' TiOp, SUM(CASE WHEN TipoOp = 'TICF' THEN Cantidad ELSE -Cantidad END) Can, Mercado")
SQL.ADD(", 0 PPP")
SQL.ADD(" FROM "~DBO~".OPERACIONES ")
SQL.ADD(" WHERE TipoOp IN ('TICF','TIVF')")
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"'")
EndIf
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" AND Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND Book1 IN ( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" AND FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND FechaOp < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Cliente1 <> Vehiculo1 ")
SQL.ADD(" GROUP BY Especie, Cliente1, FechaVto, ContraEspecie, Mercado")
*EL DIA
SQL.ADD(" UNION ALL")
SQL.ADD(" SELECT Especie, Cliente1, FechaVto, ContraEspecie, TipoOp TiOp, SUM(CASE WHEN TipoOp = 'TICF' THEN Cantidad ELSE -Cantidad END) Can, Mercado ")
SQL.ADD(", SUM(Cantidad*Precio1)/SUM(Cantidad) PPP")
SQL.ADD(" FROM "~DBO~".OPERACIONES P")
SQL.ADD(" WHERE TipoOp IN ('TICF','TIVF')")
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"'")
EndIf
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" AND Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND Book1 IN ( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" AND FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Cliente1 <> Vehiculo1 ")
SQL.ADD(" GROUP BY Especie, Cliente1, FechaVto, ContraEspecie, TipoOp, Mercado")
SQL.ADD(" ORDER BY Especie, Cliente1, FechaVto, ContraEspecie, TiOp")

*Parcial
ACN(PI:1,0)
ACN(CO:1,0)
ACN(VE:1,0)
*Totales vehiculo
ACN(PF:1,0)
ACN(CF:1,0)
ACN(VF:1,0)

recorrer SQL
  *Especie
  If Eqstr(Val(ES:1),'')
    ACT(A:Fac,Fbn['Especie'])
    AgregarMarco(a:fac..m:fac,0,0,EXE('COLOR6'))
  EndIf
  If Not Eqstr(Fbn['Especie'],Val(ES:1)) Y Not Eqstr(Val(ES:1),'')
    ACT(B:Fac,'Total '~val(CL:1)~' ')
    ACN(D:Fac, val(PI:1))
    ACN(F:Fac, val(CO:1))
    ACN(H:Fac, val(VE:1))
    ACN(J:Fac, val(CO:1)+val(VE:1))
    ACN(L:Fac, val(PI:1)+val(CO:1)+val(VE:1)) 
    ACN(PF:1,val(PF:1)+val(PI:1))
    ACN(CF:1,val(CF:1)+val(CO:1))
    ACN(VF:1,val(VF:1)+val(VE:1))       
    ACN(PI:1,0)
    ACN(CO:1,0)
    ACN(VE:1,0)    
    AgregarMarco(b:fac..m:fac,0,0,EXE('COLOR8'))
    ifa
    ACT(A:Fac,'Total '~val(ES:1)~' ')
    ACN(D:Fac, val(PF:1))
    ACN(F:Fac, val(CF:1))
    ACN(H:Fac, val(VF:1))
    ACN(J:Fac, val(CF:1)+val(VF:1))
    ACN(L:Fac, val(PF:1)+val(CF:1)+val(VF:1))
    ACN(PF:1,0)
    ACN(CF:1,0)
    ACN(VF:1,0)
    AgregarMarco(a:fac..m:fac,0,0,EXE('COLOR8'))    
    ifa
    ACT(A:Fac,Fbn['Especie'])
    AgregarMarco(a:fac..m:fac,0,0,EXE('COLOR6'))
    ifa
    ACT(B:Fac,Fbn['Cliente1'])
    AgregarMarco(b:fac..m:fac,0,0,EXE('COLOR6'))
    IFA
    ACT(C:Fac,Fbn['FechaVto'])
    ACL(C:Fac, 'DPOSTE', Fecha1=Dialogo.Fecha1, Fecha2=Fbn['FechaVto'], Especie1=Fbn['Especie'],Cliente1=Fbn['Cliente1'],Lista1=Dialogo.Lista1,Especie2=Fbn['ContraEspecie'])
  Else
    *Cliente
    If Eqstr(Val(CL:1),'')
      ifa
      ACT(B:Fac,Fbn['Cliente1'])
      AgregarMarco(b:fac..m:fac,0,0,EXE('COLOR6'))
    EndIf
    If Not Eqstr(Fbn['Cliente1'],Val(CL:1)) Y Not Eqstr(Val(CL:1),'')
      ACT(B:Fac,'Total '~Val(CL:1)~' ')
      ACN(D:Fac, val(PI:1))
      ACN(F:Fac, val(CO:1))
      ACN(H:Fac, val(VE:1))
      ACN(J:Fac, val(CO:1)+val(VE:1))
      ACN(L:Fac, val(PI:1)+val(CO:1)+val(VE:1))
      ACN(PF:1,val(PF:1)+val(PI:1))
      ACN(CF:1,val(CF:1)+val(CO:1))
      ACN(VF:1,val(VF:1)+val(VE:1))        
      ACN(PI:1,0)
      ACN(CO:1,0)
      ACN(VE:1,0)
      AgregarMarco(b:fac..m:fac,0,0,EXE('COLOR8'))
      ifa     
      ACT(B:Fac,Fbn['Cliente1'])
      AgregarMarco(b:fac..m:fac,0,0,EXE('COLOR6'))
      IFA
      ACT(C:Fac,Fbn['FechaVto'])
      ACL(C:Fac, 'DPOSTE', Fecha1=Dialogo.Fecha1, Fecha2=Fbn['FechaVto'], Especie1=Fbn['Especie'],Cliente1=Fbn['Cliente1'],Lista1=Dialogo.Lista1, Especie2=Fbn['ContraEspecie'])
    Else
      *FechaVto
      If Eqstr(Val(ES:1),'')
        ifa
        ACT(C:Fac,Fbn['FechaVto'])
        ACL(C:Fac, 'DPOSTE', Fecha1=Dialogo.Fecha1, Fecha2=Fbn['FechaVto'], Especie1=Fbn['Especie'],Cliente1=Fbn['Cliente1'],Lista1=Dialogo.Lista1, Especie2=Fbn['ContraEspecie'])
      EndIf
      *If Not Eqstr(Fbn['FechaVto'],Val(FE:1)) Y Not Eqstr(Val(FE:1),'')
        ACT(C:Fac,Fbn['FechaVto'])
        ACL(C:Fac, 'DPOSTE', Fecha1=Dialogo.Fecha1, Fecha2=Fbn['FechaVto'], Especie1=Fbn['Especie'],Cliente1=Fbn['Cliente1'],Lista1=Dialogo.Lista1, Especie2=Fbn['ContraEspecie'])
        *EndIf
    EndIf
  EndIf
  IF EqStr(Fbn['TiOp'],'INICIO')
    *INICIO
    ACN(D:Fac,Fbn['Can'])
    ACN(PI:1,val(PI:1)+val(D:Fac))
    ACN(E:fac, SQL(" Select Precio1 From "~DBO~".COTIZACIONESFUT CF Where CF.Codigo = '"~fbn('Especie')~"' and CF.Moneda = '"~fbn('ContraEspecie')~"' AND CF.FechaFut = '"~IdxDate(fbn('FechaVto'))~"' AND CF.Mercado = '"~fbn('Mercado')~"' AND CF.CallPut = 'FUT' and CF.Fecha = (select MAX(C.Fecha) FROM "~DBO~".COTIZACIONESFUT C where CF.Fecha=C.Fecha AND CF.Codigo= C.Codigo AND CF.Moneda=C.Moneda AND CF.FechaFut=C.FechaFut AND CF.Mercado=C.Mercado AND CF.CallPut=C.CallPut AND CF.PrecioEj=C.PrecioEj AND C.Fecha < '"~IdxDate(Dialogo.Fecha1)~"')"))
  ELSE
    If EqStr(Fbn['FechaVto'],Val(FE:1)) Y EqStr(Fbn['Cliente1'],Val(CL:1)) Y EqStr(Fbn['Especie'],Val(ES:1))
      dfa
    EndIf
    If EqStr(Fbn['TiOp'],'TICF')
      *COMPRAS
      ACN(F:Fac,Fbn['Can'])
      ACN(CO:1,val(CO:1)+val(F:Fac))
      ACN(G:Fac,Fbn['PPP'])
    Else
      *VENTAS
      ACN(H:Fac,Fbn['Can'])
      ACN(VE:1,val(VE:1)+val(H:Fac))
      ACN(I:Fac,Fbn['PPP'])
    EndIf
    
    *NETO
    ACN(J:Fac,val(f:fac)+val(h:fac))
    ACN(NE:1,val(NE:1)+val(J:Fac))
    ACN(K:fac, SQL(" Select Precio4 From "~DBO~".COTIZACIONESFUT CF Where CF.Codigo = '"~fbn('Especie')~"' and CF.Moneda = '"~fbn('ContraEspecie')~"' AND CF.FechaFut = '"~IdxDate(fbn('FechaVto'))~"' AND CF.Mercado = '"~fbn('Mercado')~"' AND CF.CallPut = 'FUT' and CF.Fecha = (select MAX(C.Fecha) FROM "~DBO~".COTIZACIONESFUT C where CF.Fecha=C.Fecha AND CF.Codigo= C.Codigo AND CF.Moneda=C.Moneda AND CF.FechaFut=C.FechaFut AND CF.Mercado=C.Mercado AND CF.CallPut=C.CallPut AND CF.PrecioEj=C.PrecioEj AND C.Fecha < '"~IdxDate(Dialogo.Fecha1)~"')"))
    *FIN
    ACN(L:Fac,val(d:fac)+val(j:fac))
    ACN(FI:1,val(FI:1)+val(L:Fac))
    ACN(M:fac, SQL(" Select Precio1 From "~DBO~".COTIZACIONESFUT CF Where CF.Codigo = '"~fbn('Especie')~"' and CF.Moneda = '"~fbn('ContraEspecie')~"' AND CF.FechaFut = '"~IdxDate(fbn('FechaVto'))~"' AND CF.Mercado = '"~fbn('Mercado')~"' AND CF.CallPut = 'FUT' and CF.Fecha = (select MAX(C.Fecha) FROM "~DBO~".COTIZACIONESFUT C where CF.Fecha=C.Fecha AND CF.Codigo= C.Codigo AND CF.Moneda=C.Moneda AND CF.FechaFut=C.FechaFut AND CF.Mercado=C.Mercado AND CF.CallPut=C.CallPut AND CF.PrecioEj=C.PrecioEj AND C.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"')"))    
  EndIf
  
  **Cliente
  ACT(CL:1,Fbn['Cliente1'])
  **Especie
  ACT(ES:1,Fbn['Especie'])
  **FechaVto
  ACT(FE:1,Fbn['FechaVto'])
  **ContraEspecie
  ACT(N:Fac,Fbn['ContraEspecie'])
  If Vacio(Val(d:Fac)) Y Vacio(Val(e:fac))
    ACN(d:fac,0)  
    ACN(e:fac,0)  
  EndIf
  If Vacio(Val(f:Fac)) Y Vacio(Val(g:fac))
    ACN(f:fac,0)  
    ACN(g:fac,0)  
  EndIf  
  If Vacio(Val(h:Fac)) Y Vacio(Val(h:fac))
    ACN(h:fac,0)  
    ACN(i:fac,0)  
  EndIf    
  If Vacio(Val(j:Fac)) Y Vacio(Val(k:fac))
    ACN(j:fac,0)  
    ACN(k:fac,0)  
  EndIf    
  If Vacio(Val(l:Fac)) Y Vacio(Val(m:fac))
    ACN(l:fac,0)  
    ACN(m:fac,0)  
  EndIf    
proximo
