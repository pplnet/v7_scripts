** Muestra el estado de Conexion con el MAE

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

SetFilaActual(4)
ACT(a:FAC, 'Estado Conexion MAE')
SetFont(a:FAC, 3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fecha Real')
ACT(a:FAC+1, 'Hora Real')
ACT(a:FAC+2, 'Fecha Sistema')
ACT(b:FAC, Hoy())
ACT(b:FAC+1, Hora(Ahora()))
ACT(b:FAC+2, VAR('FECHASYS'))

SetFilaActual(FAC+4)
ACT(a:FAC, 'ProxyMAE')
ACT(a:FAC+1, 'Corriendo')
ACT(a:FAC+2, 'Logueado MAE')
ACT(a:FAC+3, 'Ultimo ID recibido')
ACT(b:FAC+1, VAR('PROXYOK'))
ACT(b:FAC+2, VAR('LOGINOK'))
ACT(b:FAC+3, SQL("Select Max(IdMensaje) UltMenRec from "~DBO~".MENSAJESMAERECIBIDOS "))
SetFont(a:FAC..a:FAC+3, 2)
SetFont(b:FAC+1..b:FAC+3, 1)

SetFilaActual(FAC+5)
ACT(a:FAC, 'Evento OnLIne MAE')
ACT(a:FAC+1, 'Corriendo')
ACT(a:FAC+2, 'Ultimo ID Procesado')
ACT(a:FAC+3, 'Ultima Sec. Procesada')
ACT(a:FAC+4, 'Ultimo Inicio')
ACT(a:FAC+5, 'Ultima vuelta')
ACT(a:FAC+6, 'Ultimo fin')

ACT(b:FAC+1, VAR('ONLINEMAE'))
ACT(b:FAC+2, VAR('MAECLIENT'))
ACT(b:FAC+3, VAR('ULTSECMAE'))
ACT(b:FAC+4, VAR('ONLIMAAL'))
ACT(b:FAC+5, VAR('ONLIMAUL'))
ACT(b:FAC+6, VAR('ONLIMABA'))
SetFont(a:FAC..a:FAC+6, 2)
SetFont(b:FAC+1..b:FAC+6, 1)

SetFilaActual(FAC+8)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:FAC, 2)

ACO(1,15)
ACO(2,15)
ACO(3,20)

LimitesVision(c:fac+2)
