      ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
      SetFont(a:fac..z:fac, 3)
      AgregarMarco(a:fac..z:fac,1,0)
      SCN(tt:1, Val(j:fac))
      SCN(tt:2, Val(l:fac))
