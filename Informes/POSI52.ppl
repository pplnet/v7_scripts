SQL.ADD(" SELECT M.*, O.TipoOp, O.FechaOp, O.FechaVto, O.TotalNetoCli1,  ")
SQL.ADD(" O.TotalBrutoCli1, O.Cliente1, O.Precio1, O.Especie EspecieO, O.ContraEspecie, E.Tipo TipoM ")
SQL.ADD(" FROM "~DBO~".MOVPOSEJE M, "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E  ")
SQL.ADD(" WHERE O.NrOperacion = M.NrOperacion                 ")
SQL.ADD(" AND   M.Especie     = E.Codigo                      ")
SQL.ADD(" AND   M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"' ")
If Dialogo.Check1=0
   SQL.ADD(" AND   O.TipoOp <> 'IEXP'  ")
Endif
If Dialogo.Radio2=0
   SQL.ADD(" AND   M.NrSaldo IN (31,41,42,43,44,45)  ")
Else
   SQL.ADD(" AND   M.NrSaldo = 171  ")
Endif
If dialogo.Radio1=0
   SQL.ADD(" AND   M.Cantidad>0 ")
Endif
If dialogo.Radio1=1
   SQL.ADD(" AND   M.Cantidad<0 ")
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Endif
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND M.Book IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Endif
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" AND M.Book NOT IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Endif
If NoVacio(Dialogo.Lista4)
   SQL.ADD(" AND M.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
If NoVacio(Dialogo.Lista5)
   SQL.ADD(" AND M.Especie NOT IN ("~Pipe2Comillas(Dialogo.Lista5)~")  ")
Endif
If Dialogo.Fecha2>0
   SQL.ADD(" AND   M.FechaEj = '"~IdxDate(Dialogo.Fecha2)~"' ")
Endif
If Dialogo.Entero1>0
   SQL.ADD(" AND   M.NrSaldo = "~fstr(Dialogo.Entero1,0,0)~" ")
Endif
SQL.ADD(" AND  M.NrSaldo IN (31,171,41,42,43,44,45) ")

* FJL 28/04/22 - Para agregar DTP/RTP solo en Securities
If Dialogo.Radio2=1

  SQL.ADD(" Union All ")

  SQL.ADD(" SELECT M.*, T.TipoTr2 TipoOp, T.Fecha1 FechaOp, T.Fecha1 FechaVto, T.Cantidad1 TotalNetoCli1,  ")
  SQL.ADD(" T.Cantidad2 TotalBrutoCli1, T.Cliente1, T.Precio1, T.Especie EspecieO, T.Especie1 ContraEspecie, E.Tipo TipoM ")
  SQL.ADD(" FROM "~DBO~".MOVPOSEJE M, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E  ")
  SQL.ADD(" WHERE T.NrTrans = M.NrOperacion ")
  SQL.ADD(" AND   M.Especie     = E.Codigo                      ")
  SQL.ADD(" AND   M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" AND   M.NrSaldo = 171  ")
  If dialogo.Radio1=0
    SQL.ADD(" AND   M.Cantidad>0 ")
  Endif
  If dialogo.Radio1=1
    SQL.ADD(" AND   M.Cantidad<0 ")
  Endif
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Endif
  If NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND M.Book IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
  Endif
  If NoVacio(Dialogo.Lista3)
    SQL.ADD(" AND M.Book NOT IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
  Endif
  If NoVacio(Dialogo.Lista4)
    SQL.ADD(" AND M.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
  Endif
  If NoVacio(Dialogo.Lista5)
    SQL.ADD(" AND M.Especie NOT IN ("~Pipe2Comillas(Dialogo.Lista5)~")  ")
  Endif
  If Dialogo.Fecha2>0
    SQL.ADD(" AND   M.FechaEj = '"~IdxDate(Dialogo.Fecha2)~"' ")
  Endif
  If Dialogo.Entero1>0
    SQL.ADD(" AND   M.NrSaldo = "~fstr(Dialogo.Entero1,0,0)~" ")
  Endif
Endif

SQL.ADD(" ORDER BY M.Vehiculo, M.Book, M.Especie ")
ACT(vh:1, '')
ACT(ba:1, '')
ACT(es:1, '')
ACN(fi:1, fac)
ACN(fi:2, fac)
Recorrer SQL
   If Not EQSTR(Val(vh:1), fbn('Vehiculo')) y Not eqstr(Val(vh:1),'')
      ACT(a:fac, 'Total Especie '~Val(es:1))
