CrearDialogo
   Fecha1   : 'Fecha'       ;1;1;;;;;;;fsys
   Especie2 : 'Valuadas en' ;1;2;;;;NoVacio(Dialogo.Especie2);'Moneda Invalida';NO;Var('MONELOCA');;Var('MONELOCA')~'|'~Var('MONEEXTR')~'|';;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
   Radio1   : 'Tipo|Compras|Ventas|Ambas' ;2;1;;;;;;;2
   Radio2   : 'Tipo Posicion|Foreign Exchange|Securities'; 3;1;;;;;;;1
   Lista1   : 'Vehiculos'        ; 4;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".VEHICULOS ")
   Lista2   : 'Incluye Books'    ;  ;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
   Lista3   : 'Excluye Books'    ;-1;2;;;;;;;VAR('BOOKCONTRA')~'|';;SQLSet("Select Codigo from "~DBO~".BOOKS ")
   Lista4   : 'Incluye Especies' ;  ;1;;;;;;;;;IIF(Dialogo.Radio2=0,SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo='MON' "), SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo<>'MON' ")) 
   Lista5   : 'Excluye Especies' ;-6;2;;;;;;;;;IIF(Dialogo.Radio2=0,SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo='MON' "), SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo<>'MON' ")) 
   Entero1  : 'NrSaldo'     ;1;1;1;NO;NO;
   Fecha2   : 'FechaEj'     ;1;1;1;NO;NO;
   Check1   : 'Lista IEXP'  ;1;1;1;NO;NO;;;;0;
FinDialogo

If Not OK 
