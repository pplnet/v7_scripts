      ifa
      ACN(tt:1, 0)
      ACN(tt:2, 0)
      ACT(ba:1, '')
      ACT(es:1, '')
      ACN(fi:1, fac)
      ACN(fi:2, fac)
   Endif
   If not EQSTR(Val(ba:1), fbn('Book')) y Not eqstr(Val(ba:1),'')
      ACT(a:fac, 'Total Especie '~Val(es:1))
      ACN(h:fac, SUM(h:Val(fi:2)..h:fac) )
      SetFont(a:fac..z:fac, 3)
      ifa
      ACT(a:fac, 'Total Book '~Val(ba:1))
      ACN(j:fac, SUM(j:Val(fi:1)..j:fac) )
      ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
      SetFont(a:fac..z:fac, 3)
      AgregarMarco(a:fac..z:fac,1,0)
      SCN(tt:1, Val(j:fac))
      SCN(tt:2, Val(l:fac))
      ACT(es:1, '')
      ifa
      IFA
      ACN(fi:1, fac)
      ACN(fi:2, fac)
   Endif

   If not EQSTR(Val(es:1), fbn('Especie')) y Not eqstr(Val(es:1),'')
      ACT(a:fac, 'Total Especie '~Val(es:1))
      ACN(h:fac, SUM(h:Val(fi:2)..h:fac) )
      SetFont(a:fac..z:fac, 3)
      ifa
      ACN(fi:2, fac)
   Endif

   message(FBN['NrOperacion'])
   ACT(a:Fac, FBN['NrOperacion'] )
   if Not Incluido(FBN['TipoOp'],'DTP|RTP|DRT')
     ACLO(a:Fac,FBN['NrOperacion'] )
   endif
   ACT(b:Fac, FBN['TipoOp'] )
   ACT(c:Fac, FBN['Cliente1'] )
   ACD(d:Fac, FBN['FechaOp'] )
   ACD(e:Fac, FBN['FechaVto'] )
   ACT(f:Fac, FBN['Especie'] )
   ACD(g:Fac, fbn('FechaEj') )
   ACN(h:Fac, FBN['Cantidad'] )
   ACN(i:Fac, FBN['Precio'] )
   ACN(j:Fac, Val(h:fac)*Val(i:fac))

***/// FJL 31-01-18 Cambio todo a CotizacionC(1)
IF NO
   If Eqstr(Dialogo.Especie2, VAR('MONELOCA'))
      * Si la moneda que piden es pesos, traigo la cotizacion5
      If NoVacio(fbn('FechaEj'))
*         ACN(kk:fac, Cotizacion(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,5,SI) )
         ACN(kk:fac, Cotizacion(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI) )
      Else
*         ACN(kk:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,5,SI) )
         ACN(kk:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI) )
      Endif
      IF Eqstr(MODO(fbn('Especie'),Dialogo.Especie2),'INV') 
         ACN(k:fac,1/Val(kk:fac))
      Else
         ACN(k:fac,Val(kk:fac))
      Endif
   Else
      If Eqstr(Dialogo.Especie2, VAR('MONEEXTR')) y Eqstr(CotizaEn(fbn('Especie')), VAR('MONEEXTR'))
         * Si la moneda que piden es usd y la esp cotiza en USD, traigo la cotizacion1 para monedas y 25 para titulos.
         If NoVacio(fbn('FechaEj'))
            ACN(k:fac, Cotizacion(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI) )
         Else
            If Eqstr(fbn('Tipo'),'MON')
               ACN(k:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI) )
            Else
*               ACN(k:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,25,SI) )
               ACN(k:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI) )
            Endif
         Endif
      Else
         * Si piden otra moneda
         If NoVacio(fbn('FechaEj'))
            If Eqstr(fbn('Tipo'),'MON')
               ACN(kk:fac, CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI, Dialogo.Especie2) )
            Else
*               ACN(kk:fac, CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,25,SI, Dialogo.Especie2) )
               ACN(kk:fac, CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI, Dialogo.Especie2) )
            Endif
         else
            If Eqstr(fbn('Tipo'),'MON')
               ACN(kk:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI, Dialogo.Especie2) )
            Else
*               ACN(kk:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,25,SI, Dialogo.Especie2) )
               ACN(kk:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI, Dialogo.Especie2) )
            Endif
         Endif
         IF Eqstr(MODO(fbn('Especie'),Dialogo.Especie2),'INV') 
            ACN(k:fac,1/Val(kk:fac))
         Else
            ACN(k:fac,Val(kk:fac))
         Endif
      Endif
   Endif
ELSE
   If NoVacio(fbn('FechaEj'))
** FJL 28-04-22 Cambio todo a Cotizacion 25 (PrecioContable)
*     ACN(k:fac, CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI, Dialogo.Especie2) )
     ACN(k:fac, CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,25,SI, Dialogo.Especie2) )
   else
** FJL 28-04-22 Cambio todo a Cotizacion 25 (PrecioContable)
*     ACN(k:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI, Dialogo.Especie2) )
     ACN(k:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,25,SI, Dialogo.Especie2) )
   endif
ENDIF
   ACN(l:Fac, Val(h:fac)*Val(k:fac))

   ACT(m:Fac, FBN['Book'] )
   ACT(n:Fac, FBN['Vehiculo'] )

   ACT(vh:1, FBN['Vehiculo'])
   ACT(ba:1, FBN['Book'])
   ACT(es:1, FBN['Especie'])
