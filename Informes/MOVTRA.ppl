ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;
  Fecha1     : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2     : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  NrTrans1   : "Nr.Trans"
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Movimientos por Transaccion")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)

SetFilaActual(FAC+5)

ACT(a:FAC, 'Tipo Tr.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'F.Operacion')
ACT(d:FAC, 'F.Vto.')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio / Tasa N.A.')

ACT(c:FAC+1, 'F.Ejecucion')
ACT(d:FAC+1, 'F.Mov.')
ACT(e:FAC+1, 'Cliente Afectado')
ACT(f:FAC+1, 'Especie Afectada')
ACT(g:FAC+1, 'Cantidad')
ACT(h:FAC+1, 'Leyenda')
ACT(i:FAC+1, 'Saldo/NrMov')
ACT(j:FAC+1, 'Cuenta')
ACT(k:FAC+1, 'Nr.Comp.')

AlinearCeldas(a:FAC+1..f:FAC+1,'I')
AlinearCeldas(g:FAC+1..g:FAC+1,'D')
AlinearCeldas(h:FAC+1..k:FAC+1,'I')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
SetFont(a:Val(w1)..N:FAC+1,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
AgregarMarco(b:FAC+1..k:FAC+1,2,0,Exe('COLOR6'))

SetFilaActual(FAC+1)

ACT(X1, "O.Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
if NoVacio(Dialogo.Vehiculo1)
   ACT(x1, Val(X1)~" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif

SQL.ADD("SELECT ")
SQL.ADD("O.TipoTr2, O.NrTrans, O.Fecha1, O.Fecha2, O.Especie, ")
SQL.ADD("O.Cantidad1, O.Precio1, O.Vehiculo1, M.NrOperacion, M.Cliente, ")
SQL.ADD("M.FechaMov, M.FechaEje, M.Especie esp, M.Leyenda, M.NrSaldo, ")
SQL.ADD("M.Cuenta, M.Transaccion, M.NrComprob, 'EJEC' est, M.Cantidad, ")
SQL.ADD("O.Cliente1,M.NrMov")  
SQL.ADD("from "~DBO~".TRANSACCIONES2 O, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD("where O.NrTrans = M.NrOperacion ")
SQL.ADD("and "~Val(X1))
If NoVacio(Dialogo.NrTrans1)
   SQL.ADD("and NrTrans='"~Dialogo.NrTrans1~"' ")
EndIf
SQL.ADD("union ALL ")
SQL.ADD("SELECT ")
SQL.ADD("O.TipoTr2, O.NrTrans, O.Fecha1, O.Fecha2, O.Especie, ")
SQL.ADD("O.Cantidad1, O.Precio1, O.Vehiculo1, M.NrOperacion, M.Cliente, ")
SQL.ADD("M.FechaMov, M.FechaEje, M.Especie esp, M.Leyenda, M.NrSaldo, ")
SQL.ADD("M.Cuenta, M.Transaccion, M.NrComprob, 'PEND' est, M.Cantidad, ")
SQL.ADD("O.Cliente1,M.NrMov")  
SQL.ADD("from "~DBO~".TRANSACCIONES2 O, "~DBO~".MOVPENDIENTES M ")
SQL.ADD("where O.NrTrans = M.NrOperacion ")
SQL.ADD("and "~Val(X1))
If NoVacio(Dialogo.NrTrans1)
   SQL.ADD("and NrTrans='"~Dialogo.NrTrans1~"' ")
EndIf
SQL.ADD("union ALL ")
SQL.ADD("SELECT ")
SQL.ADD("O.TipoTr2, O.NrTrans, O.Fecha1, O.Fecha2, O.Especie, ")
SQL.ADD("O.Cantidad1, O.Precio1, O.Vehiculo1, M.NrOperacion, M.Cliente, ")
SQL.ADD("M.FechaMov, M.FechaEj as FechaEje, M.Especie esp, TipoNegocio as Leyenda, M.NrSaldo, ")
SQL.ADD("'' as Cuenta, '' as Transaccion, 0 as NrComprob, 'POSI' est, M.Cantidad can, ")
SQL.ADD("O.Cliente1,0 NrMov")  
SQL.ADD("from "~DBO~".TRANSACCIONES2 O, "~DBO~".MOVPOSEJE M ")
SQL.ADD("where O.NrTrans = M.NrOperacion ")
SQL.ADD("and "~Val(X1))
If NoVacio(Dialogo.NrTrans1)
   SQL.ADD("and NrTrans='"~Dialogo.NrTrans1~"' ")
EndIf
SQL.ADD("order by 2, 19, 15, 13 ")

Recorrer SQL
  IF Not EqStr(FBN['NrTrans'],Val(z1))
     ifa
     ACT(z1, FBN['NrTrans'])
     ACT(a:FAC, FBN['TipoTr2'])
     ACT(b:FAC, FBN['NrTrans'])
     ACLT(b:FAC, FBN['NrTrans'])
     ACD(c:FAC, FBN['Fecha1'])
     ACD(d:FAC, FBN['Fecha2'])
     ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
     ACT(f:FAC, FBN['Especie'])
     ACN(g:FAC, FBN['Cantidad1'])
     ACN(h:FAC, FBN['Precio1'])
     SetFont(a:FAC..y:FAC,2)
     ifa
  endif
  ACT(b:FAC,FBN['est'])
  ACD(c:FAC, FBN['FechaEje'])
  ACD(d:FAC, FBN['FechaMov'])
  ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))
  ACT(f:FAC, FBN['esp'])
  ACN(g:FAC, FBN['Cantidad'])
  ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
  ACT(i:FAC, Fstr(FBN['NrSaldo'],0,0)~"/"~Fstr(FBN['NrMov'],0,0))
  ACT(j:FAC, FBN['Cuenta'])
  ACT(k:FAC, FBN['NrComprob'])
  SetFont(a:FAC..k:FAC,1)
  IF EqStr(FBN['est'],'PEND')
     BorrarCeldas(c:FAC..c:FAC)
     ColorCeldas(a:FAC..L:FAC,clGREEN)
  endif 
  FormatoCeldas(i:fac..i:fac,"0")
proximo

ACO(1,5)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,18)
ACO(6,10)
ACO(7,8)
ACO(8,10)
ACO(9,10)
ACO(10,9)
ACO(11,7)
ACO(12,7)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)
RangoTitulo(a1..k:8,36)

