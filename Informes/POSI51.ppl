CrearDialogo
   Fecha1   : 'Fecha'            ; 1;;;;;;;;fsys
   Radio1   : 'Tipo Posicion|Foreign Exchange|Securities'; 2;1;;;;;;;0
   Especie1 : 'Valuadas en'      ; 4;1;;;;NoVacio(Dialogo.Especie1);'Moneda Invalida';NO;Var('MONELOCA');;Var('MONELOCA')~'|'~Var('MONEEXTR')~'|';;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
   Check1   : 'Incluy.$ NDF'     ;6;1;1;;;;;;0;
   Check2   : 'Incluy.$ Rofex'   ;7;1;1;;;;;;0;
   Check3   : 'Incluy.$ OCT'     ;8;1;1;;;;;;0;
   Lista1   : 'Vehiculos'        ; 3;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".VEHICULOS ")
   Lista2   : 'Incluye Books'    ;  ;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
   Lista3   : 'Excluye Books'    ;-2;2;;;;;;;VAR('BOOKCONTRA')~'|';;SQLSet("Select Codigo from "~DBO~".BOOKS ")
   Lista4   : 'Incluye Especies' ;  ;1;;;;;;;;;IIF(Dialogo.Radio1=0,SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo='MON' "), SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo<>'MON' ")) 
   Lista5   : 'Excluye Especies' ;-7;2;;;;;;;;;IIF(Dialogo.Radio1=0,SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo='MON' "), SQLSet("Select Codigo from "~DBO~".ESPECIES WHERE Tipo<>'MON' ")) 
   Entero1  :'Saldo'   ;1;1;1;NO;NO;
   Fecha2   :'FechaEj' ;1;1;1;NO;NO;
FinDialogo

If Not OK 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')

ACT(ls1,'171|Titulos|31|FX|41|FXDF|42|FX NDF|43|OCT|44|Rofex|45|Internal FX Exposure|' )


ACT(a:2, 'Posicion por TipoPosicion / Especie - '~Dialogo.Fecha1~' - '~iif(Dialogo.Radio1=0, 'Foreign Exchange','Securities') )
ACT(a:4, 'Valuadas en : '~Dialogo.Especie1 )
ACT(a:5, 'Vehiculos: '~IIF(NOVACIO(Dialogo.Lista1),Dialogo.Lista1,'Todos') )
ACT(a:6, 'Incluye Books: '~IIF(NOVACIO(Dialogo.Lista2),Dialogo.Lista2,'Todos') )
ACT(a:7, 'Excluye Books: '~IIF(NOVACIO(Dialogo.Lista3),Dialogo.Lista3,'Ninguno') )
ACT(a:8, 'Incluye Especies: '~IIF(NOVACIO(Dialogo.Lista4),Dialogo.Lista4,'Todas') )
ACT(a:9, 'Excluye Especies: '~IIF(NOVACIO(Dialogo.Lista5),Dialogo.Lista5,'Ninguna') )

SetFont(a:2, 4)
SetFont(a:4..c:9, 2)

SetFilaActual(10)

ACT(a:fac,   'Especie')
ACT(b:fac,   'FechaEj')
ACT(c:fac,   'Posicion')
ACT(c:fac+1, 'Inicial')
ACT(d:fac,   'PPP')
ACT(d:fac+1, 'Inicial')
ACT(e:fac,   'Compras')
ACT(f:fac,   'Ventas')
