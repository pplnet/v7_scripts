ifa
ifa

SQL.ADD(" SELECT P.Fecha, P.CantidadIni, P.CantidadFin, P.Cantidad1, P.Cantidad2, P.Precio1, P.PrecioIni, ")
SQL.ADD(" P.Precio2, P.PrecioFin, P.Especie, P.FechaEj, P.Book, P.Vehiculo, E.MonedaEmision, E.Tipo,      ")
SQL.ADD(" E.TamanioLote,P.NrSaldo                                                                         ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E                                                   ")
SQL.ADD(" WHERE P.Especie = E.Codigo                                                                      ")
*SQL.ADD(" AND   (P.CantidadIni<>0 OR P.Cantidad1<>0 OR P.Cantidad2<>0 OR P.CantidadFin<>0)                ")
SQL.ADD(" AND   (P.CantidadFin <> 0 OR (P.Cantidad1<>0 OR P.Cantidad2<>0 AND P.Fecha= "~idxdate2(Dialogo.Fecha1)~" ) )")
SQL.ADD(" AND   P.Fecha < = "~idxdate2(Dialogo.Fecha1)~"                                                  ")
If Dialogo.Check1=0
   SQL.ADD(" AND   (P.Especie <> '"~VAR('MONELOCA')~"' OR NrSaldo <> 42)  ")
Endif
If Dialogo.Check2=0
   SQL.ADD(" AND   (P.Especie <> '"~VAR('MONELOCA')~"' OR NrSaldo <> 44)  ")
Endif
If Dialogo.Check3=0
   SQL.ADD(" AND   (P.Especie <> '"~VAR('MONELOCA')~"' OR NrSaldo <> 43)  ")
Endif
If Dialogo.Entero1>0
   SQL.ADD(" AND   P.NrSaldo = "~FSTR(Dialogo.Entero1,0,0)~" ")
Endif
If Dialogo.Fecha2>0
   SQL.ADD(" AND   P.FechaEj = "~idxdate2(Dialogo.Fecha2)~" ")
Endif
If Dialogo.Radio1=0
   SQL.ADD(" AND   P.NrSaldo IN (31,41,42,43,44,45)  ")
Else
   SQL.ADD(" AND   P.NrSaldo = 171  ")
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Endif
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND P.Book IN ("~Pipe2Comillas(Dialogo.Lista2)~")  ")
Endif
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" AND P.Book NOT IN ("~Pipe2Comillas(Dialogo.Lista3)~")  ")
Endif
If NoVacio(Dialogo.Lista4)
   SQL.ADD(" AND P.Especie IN ("~Pipe2Comillas(Dialogo.Lista4)~")  ")
Endif
If NoVacio(Dialogo.Lista5)
   SQL.ADD(" AND P.Especie NOT IN ("~Pipe2Comillas(Dialogo.Lista5)~")  ")
Endif
SQL.ADD(" AND P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.Book, P.NrSaldo, E.MonedaEmision, P.Especie  ")

acn(ok1,0)

Recorrer SQL
   if Val(ok1) = 0
      ACN(ok1,1)
      ACN(cs1,FBN['NrSaldo'] )
      ACT(co1,FBN['Book'] )
      ACT(cv1,FBN['Vehiculo'] )
      ACN(cs2,1)
      ACN(co2,1)
      ACN(cv2,1)
   Endif

   * Corte por NrSaldo 
   If not [Eqstr(FBN['Vehiculo'],Val(cv1)) y FBN['NrSaldo'] = Val(cs1)  y  Eqstr(FBN['Book'],Val(co1)) ]
      ifa      
      ACT(f:fac, 'Total '~itemLista(Val(ls1),BuscarLista(Fstr(Val(cs1),1,0),Val(ls1))+1) )

      ACN(g:fac, Val(ts2) )
      ACN(i:fac, Val(ts3) )
      ACN(k:fac, Val(ts4) )
      SetFont(a:fac..z:fac, 3)

      ifa
      ifa
      ACN(cs2,1)
      ACN(cs:1,FBN['NrSaldo'] )

      SCN(to2, Val(ts2) )   
      SCN(to3, Val(ts3) )   
      SCN(to4, Val(ts4) )   

      ACN(ts2, 0 )   
      ACN(ts3, 0 )   
      ACN(ts4, 0 )   
   Endif

   * Corte por BOOK
   If not [Eqstr(FBN['Vehiculo'],Val(cv1)) y  Eqstr(FBN['Book'],Val(co1)) ]
      ACT(f:fac, 'Total Book '~Val(co1) )
      ACN(g:fac, Val(to2) )
      ACN(i:fac, Val(to3) )
      ACN(k:fac, Val(to4) )
      AgregarMarco(a:fac..z:fac,0,0)
      SetFont(a:fac..z:fac, 2)

      ifa 
      ifa 
      ACN(co2,1)
      ACT(co:1,FBN['Book'] )

      SCN(tv2, Val(to2) )   
      SCN(tv3, Val(to3) )   
      SCN(tv4, Val(to4) )   

      ACN(to2, 0 )   
      ACN(to3, 0 )   
      ACN(to4, 0 )   
   Endif

   * Corte por Vehiculo
   If not Eqstr(FBN['Vehiculo'],Val(cv1)) 
      ACT(f:fac, 'Total Vehiculo ' )
      ACN(g:fac, Val(tv2) )
      ACN(i:fac, Val(tv3) )
      ACN(k:fac, Val(tv4) )
      AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR8'))
      SetFont(a:fac..z:fac, 2)
      ifa
      ifa
      ACT(cv:1,FBN['Vehiculo'] )
      ACN(cv2,1)
      ACN(tv2, 0 )   
      ACN(tv3, 0 )   
      ACN(tv4, 0 )   
   Endif 

   ******** Titulos ***************
   if Val(cv2) = 1
      ACT(a:fac, FBN['Vehiculo']~' - '~BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Vehiculo']))
      message(Val(a:fac))
      SetFont(a:fac..z:fac, 2)
      AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR8'))
      ACN(cv2,0)
      ifa
   endif

   if Val(co2) = 1
      ACT(a:fac, 'Book: '~FBN['Book'])
      message(Val(a:fac))
      SetFont(a:fac..z:fac, 3)
      AgregarMarco(a:fac..z:fac,0,0)
      ACN(co2,0)
      ifa
   endif

   if Val(cs2) = 1
      ACT(a:fac, ItemLista(Val(ls1),BuscarLista(Fstr(Val(cs1),1,0),Val(ls1))+1)  )
      SetFont(a:fac..z:fac, 3)
      ACN(cs2,0)
      ifa
   Endif
   *********************************

   ACT(a:fac,   fbn('Especie'))
   IF NoVacio(fbn('FechaEj'))
      ACD(b:fac, fbn('FechaEj'))
   Endif

   If Dialogo.Fecha1=fbn('Fecha')
      ACN(c:fac,   fbn('CantidadIni'))
      ACN(d:fac,   fbn('PrecioIni'))
      ACN(e:fac,   fbn('Cantidad1'))
      ACL(e:fac,   'POSI52',Fecha1=fbn['Fecha'],Especie2=Dialogo.Especie1,Radio1=0,Radio2=Dialogo.Radio1,Entero1=fbn['NrSaldo'],Fecha2=Val(b:fac),Lista1=FBN['Vehiculo'],Lista2=fbn['Book'],Lista3='',Lista4=fbn('Especie'),Lista5='',Check1=1)
      ACN(f:fac,   -fbn('Cantidad2'))
      ACL(f:fac,   'POSI52',Fecha1=fbn['Fecha'],Especie2=Dialogo.Especie1,Radio1=1,Radio2=Dialogo.Radio1,Entero1=fbn['NrSaldo'],Fecha2=Val(b:fac),Lista1=FBN['Vehiculo'],Lista2=fbn['Book'],Lista3='',Lista4=fbn('Especie'),Lista5='',Check1=1)
   Else
      ACN(c:fac,   fbn('CantidadFin'))
      ACN(d:fac,   fbn('PrecioFin'))
      ACN(e:fac,   0)
      ACN(f:fac,   0)
   Endif

   ACN(g:fac,   fbn('CantidadFin'))
   ACN(h:fac,   fbn('PrecioFin'))
   ACN(i:fac,   fbn('CantidadFin')*fbn('PrecioFin'))

** FJL 28/04/22 Cambio todo a CotizacionC(25) para dejarlo igual que POSI52
IF NO
   If Eqstr(Dialogo.Especie1, VAR('MONELOCA'))
      * Si la moneda que piden es pesos, traigo la cotizacion5
      If NoVacio(fbn('FechaEj'))
         ACN(jj:fac, Cotizacion(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,5,SI) )
      Else
         ACN(jj:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,5,SI) )
      Endif
      IF Eqstr(MODO(fbn('Especie'),Dialogo.Especie1),'INV') 
         ACN(j:fac,1/Val(jj:fac))
      Else
         ACN(j:fac,Val(jj:fac))
      Endif
   Else
      If Eqstr(Dialogo.Especie1, VAR('MONEEXTR')) y Eqstr(CotizaEn(fbn('Especie')), VAR('MONEEXTR'))
         * Si la moneda que piden es usd y la esp cotiza en USD, traigo la cotizacion1 para monedas y 25 para titulos.
         If NoVacio(fbn('FechaEj'))
            ACN(j:fac, Cotizacion(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI) )
         Else
            If Eqstr(fbn('Tipo'),'MON')
               ACN(j:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI) )
            Else
               ACN(j:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,25,SI) )
            Endif
         Endif
      Else
         * Si piden otra moneda
         If NoVacio(fbn('FechaEj'))
            If Eqstr(fbn('Tipo'),'MON')
               ACN(jj:fac,   CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,1,SI, Dialogo.Especie1) )
            Else
               ACN(jj:fac,   CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,25,SI, Dialogo.Especie1) )
            Endif
         else
            If Eqstr(fbn('Tipo'),'MON')
               ACN(jj:fac,   CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI, Dialogo.Especie1) )
            Else
               ACN(jj:fac,   CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,25,SI, Dialogo.Especie1) )
            Endif
         Endif
         IF Eqstr(MODO(fbn('Especie'),Dialogo.Especie1),'INV') 
            ACN(j:fac,1/Val(jj:fac))
         Else
            ACN(j:fac,Val(jj:fac))
         Endif
      Endif
   Endif
ELSE
   If NoVacio(fbn('FechaEj'))
     ACN(j:fac, CotizacionC(fbn('Especie'),'FUT',fbn('FechaEj'),,Dialogo.Fecha1,25,SI, Dialogo.Especie1) )
   else
     ACN(j:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,25,SI, Dialogo.Especie1) )
   endif
ENDIF

   ACN(k:fac,   fbn('CantidadFin')*Val(j:fac))

