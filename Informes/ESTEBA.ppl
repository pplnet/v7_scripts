**Ejercicio 1: Consultas por Especies de TIPO Publicas.

** Crear los campos a completar:
CrearDialogo
   Especie1 : 'Especie' ;1;1;;;;Vacio(Dialogo.Especie1) O Eqstr(BuscarCampo('ESPECIES','Tipo','Codigo', Dialogo.Especie1), 'PUB');'Debe ingresar un Titulo Publico';NO;;;;;;" Tipo = 'PUB' ";;;;
   Fecha1 : 'Fecha de inicio' ;1;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
   Fecha2 : 'Fecha de fin' ;2;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

** Para cerrar el informe sin devolver resultado:
IF Not Ok
  Cancelar
ENDIF

** Crear fuentes:
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

** Darle formato al Informe:

SetFilaActual(1)

ACT(A:fac, 'Informe de Especies Publicas')
SetFont(A:fac, 3)

SetFilaActual(fac+2)

ACT(A:fac, 'Fecha de inicio:')
ACD(B:fac, Dialogo.Fecha1)
SetFont(A:fac..B:fac, 1)
AlinearCeldas(B:fac, 'C')
ifa

ACT(A:fac, 'Fecha de fin:')
ACD(B:fac, Dialogo.Fecha2)
SetFont(A:fac..B:fac, 1)
AlinearCeldas(B:fac, 'C')

SetFilaActual(fac+2)

ACT(A:fac, 'Especie')
ACT(B:fac, 'Tipo')
ACT(C:fac, 'Fecha')

SetFont(A:fac..C:fac, 2)
AlinearCeldas(A:fac..C:fac, 'C')

AgregarMarco(A:fac..C:fac,2,2,Exe('COLOR'))

** Completar informe:
SQL.ADD(" Select Codigo, Nombre, Fecha ")
SQL.ADD(" From "~DBO~".ESPECIES ")

IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" Where Codigo = '"~Dialogo.Especie1~"' ")
ELSE
   SQL.ADD(" Where Tipo = 'PUB' ")
ENDIF

SQL.ADD(" order by Fecha ")

Recorrer SQL
   AgregarMarco(A:fac..C:fac,2,2)

   ACT(A:fac, fbn('Codigo'))
   ACT(B:fac, fbn('Nombre'))
   ACD(C:fac, fbn('Fecha'))

   SetFont(A:fac..C:fac, 1)
   AlinearCeldas(A:fac..C:fac, 'C')

   ACN(P:1, Val(P:1) + 1)
Proximo

SetFilaActual(fac+2)

AgregarMarco(A:fac..B:fac,2,2,Exe('COLOR'))
ACT(A:fac, 'Total de analizado:')
ACN(B:fac, Val(P:1))
FormatoCeldas(B:fac, Exe('F0'))
SetFont(A:fac..B:fac, 3)
AlinearCeldas(B:fac, 'C')

SetFilaActual(fac+2)

ACT(A:fac, 'FIN DEL INFORME')
SetFont(A:fac, 2)
AlinearCeldas(A:fac, 'C')