* Bajas en instancias de anulacion
SQL.ADD(" SELECT 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, OP.ObservacDoc, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE, OP.NroBajaMAE, OP.CB5, C.NrMAE, C.CUIT, ")
SQL.ADD(" OP.TipoCambio2, E.CotizaMAE, E.InteresesC, E.VTeorico, E.CodMAEContado, E.Nombre, E.Cupon ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Especie   = E.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OP.Mercado4  in ('"~VAR('MENEFTI')~"') AND ")
SQL.ADD("      OPB.NrBit IN (30,31) AND ")
SQL.ADD("      OPB.Valor = 1  ")
* Altas no carga trader ni anulacion
SQL.ADD(" UNION ")
SQL.ADD(" SELECT 'Alta' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ") 
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, OP.ObservacDoc,")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE, OP.NroBajaMAE, OP.CB5, C.NrMAE, C.CUIT, ")
SQL.ADD(" OP.TipoCambio2, E.CotizaMAE, E.InteresesC, E.VTeorico, E.CodMAEContado, E.Nombre, E.Cupon ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Especie   = E.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OP.Mercado4 in ('"~VAR('MENEFTI')~"') AND ")
SQL.ADD("      OPB.NrBit not IN (1,30,31) AND ")
SQL.ADD("      OPB.Valor = 1     ")
* bajas de BOPERACIONES
SQL.ADD(" UNION ")
SQL.ADD(" SELECT 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE,OP.NrOperacion3, OP.ObservacDoc,")
SQL.ADD(" '0' Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE, OP.NroBajaMAE, OP.CB5 ,C.NrMAE, C.CUIT, ")
SQL.ADD(" OP.TipoCambio2, E.CotizaMAE, E.InteresesC, E.VTeorico, E.CodMAEContado, E.Nombre, E.Cupon ")
SQL.ADD(" from "~DBO~".BOPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("where OP.FechaCargaSys     >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("      and OP.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("      and OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'   ")
SQL.ADD("      and OP.Cliente1  = C.Codigo ")
SQL.ADD("      AND OP.Especie   = E.Codigo                  ")
SQL.ADD("      AND (OP.NrBoleto is not null or OP.NrBoleto<>'' or OP.NrBoleto <>' ') ")
SQL.ADD("      AND OP.Mercado4  in ('"~VAR('MENEFTI')~"') ")
SQL.ADD("      AND OP.TipoOp   In ('FXCF','FXVF') ")
SQL.ADD("ORDER BY OP.FechaOp, OP.NrOperacion  ")
WATCH(sql.batch())

