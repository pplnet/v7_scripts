* ---> Impresion Del Informe De Preliquidacion
ModoReproceso(SinDialogo)
GrillaVisible(SI)

CrearDialogo
   Vehiculo1  : "Vehiculo"             ;1;1;1;SI;SI;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar El Vehiculo';NO;Var('VEHICULODE')
   Cliente1   : "Cliente"              ;2;1;1;SI;SI;
   Mercado1   : 'C.Custodia'           ;3;1;1;SI;SI;;;SI;
   Especie3   : 'Especie'              ;1;2;1;SI;SI;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3, 'TITULO') y EsTerminal(Dialogo.Especie3, Especie);'Debe Ingresar Una Especie Valida'; NO;;;;;;"Status = 'HAB' "
   Especie1   : 'Cupon'                ;2;2;1;NO;SI;;;SI;BuscarCampo('ESPECIES', 'Alias9', 'Codigo', Dialogo.Especie3);BuscarCampo('ESPECIES', 'Alias9', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB' "
   Entero1    : 'Nro.Cupon'            ;3;2;1;SI;SI;;;;0;BuscarCampo('ESPECIES', 'Cupon',  'Codigo', Dialogo.Especie1)                                                                                
   Fecha1     : 'F.Corte'              ;4;2;1;SI;SI;
* FJL 27/04/20 - Se agrega opcion todos
*   Radio1     : 'Pago|Normal|Bloqueos_CV|Garantias' ;5;1;;;;;;;0
   Radio1     : 'Pago|Normal|Bloqueos_CV|Garantias|Todos' ;5;1;;;;;;;3
   Radio2     : 'Por|Pantalla|Impresora'  ;;1;;;;;;;0      
FinDialogo
If Not OK
  Cancelar
EndIf

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,9,B")

If [[NoVacio(DIALOGO.VEHICULO1)] y [Not Incluido(DIALOGO.VEHICULO1, UsrVehiculos(UsuarioActivo))] y [Not Vacio(UsrVehiculos(UsuarioActivo))]]
   Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
EndIf

*- Busco la Cantidad de Decimales para sacar el VR
ACN(vr2, BuscarCampo('ESPECIES','Alias5','Codigo',Dialogo.Especie3))

SetFilaActual(1)
ACT(J:FAC, " Fecha:  "~Fecha(FSys))
AlinearCeldas(J:FAC, 'D')
SetFont(J:FAC, 3)

SetFilaActual(FAC+1)
ACN(w:1, FAC+1)
ACT(A:FAC, 'Informe De Preliquidacion de Corte De Cupon ')
* FJL - Saco el vehiculo de aca y lo pongo abajo
*ACT(A:FAC, Val(a:FAC)~' - '~iif(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1))
SetFont(A:FAC..C:FAC+6, 3)

SetFilaActual(FAC+2)
ACN(w:1, FAC)
ACT(a:FAC, 'Vehiculo:  '~IIF(NoVacio(Dialogo.Vehiculo1), Dialogo.Vehiculo1, 'Todos'))
*4
ACT(A:FAC+1, "Especie:  "~Dialogo.Especie3~' - '~BuscarCampo('Especies', 'Extendido', 'Codigo', Dialogo.Especie3))
*5
ACT(A:FAC+2, "Cupon:    "~IIF(Dialogo.Entero1<>0,FStr(Dialogo.Entero1, 1, 0), '-'))
*c5
ACT(a:FAC+3, "C. Custodia:  "~IIF(NoVacio(Dialogo.Mercado1), Dialogo.Mercado1, 'Todos'))
* FJL 27/04/20 - Se agrega opcion todos
*ACT(A:07, 'Pago: '~IIF(Dialogo.Radio1=0, 'Normal',IIF(Dialogo.Radio1=1, 'Bloqueos_CV', 'Garantias')) )
*7
ACT(a:FAC+4, 'Pago: '~IIF(Dialogo.Radio1=0, 'Normal',IIF(Dialogo.Radio1=1, 'Bloqueos_CV',IIF(Dialogo.Radio1=2, 'Garantias', 'Todos'))) )
*8
If NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+5, 'Cliente: '~Dialogo.Cliente1)
Else
   ACT(a:FAC+5, 'Cliente: Todos')
Endif
*2 a 8
SetFont(A:FAC..C:FAC+5, 2)

*11
SetFilaActual(FAC+7)
ACT(A:FAC, "Sucursal")
ACT(B:FAC, " Cliente")
ACT(C:FAC, " Razon Social")
ACT(D:FAC, " Cuenta")
ACT(E:FAC, "Tenencia V.N. ")
ACT(F:FAC, "Tenencia V.R. ")
ACT(G:FAC, "Mto. Renta ")
ACT(H:FAC, "Mto. Amort. ")
ACT(I:FAC, "Mto. Total ")
ACT(j:FAC, " Estado     ")
ACT(k:FAC, " NrCupon ")

AgregarMarco (A:FAC..k:FAC, 2, 1, Exe('COLOR6'))
AlinearCeldas(A:FAC..A:FAC, 'C')
AlinearCeldas(B:FAC..D:FAC, 'I')
AlinearCeldas(E:FAC..O:FAC, 'D')
SetFont(A:FAC..Q:FAC, 2)
ACN(w:2, FAC+1)

* ---> Impresion De Lineas Del Informe
ACN(z:1, FAC)
ACN(vr:1, SQL("SELECT VTeoricoAnt FROM "~DBO~".AGENDACUPONES Where NrCupon= '"~FStr(Dialogo.Entero1, 1, 0)~"' and Especie = '"~Dialogo.Especie3~"' "))

ACN(ZA:02, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU'))+100)

SQL.Add(" SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie2,T2.Cupon1,T2.Fecha1, T2.Especie5, T2.Fecha2, ")
SQL.Add("        T2.Precio1,T2.Precio2,T2.Precio3,M.*, T2.CB5, T2.Precio5, ")
SQL.Add("        C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal, C.CUIT, C.CondicionIVA, ")
SQL.Add("        C.TipoInscripcion, C.Sucursal, M.Vehiculo, ")
SQL.Add("        CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ")
SQL.Add(" FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS M ")
SQL.Add(" WHERE  T2.Especie2  =  '"~Dialogo.Especie1~"' ")
SQL.Add(" AND    T2.TipoTr2   = 'CUPON' ")
If Dialogo.Fecha1>0
   SQL.Add(" AND T2.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif
watch(SQL.BATCH())
If Dialogo.Entero1 > 0
   SQL.Add(" AND T2.Cupon1    =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
Endif
SQL.Add("    AND M.Concepto   <> '"~FStr(Val(ZA:02),1,0)~"' ")
SQL.Add("    AND M.NrOperacion = T2.NrTrans ")
SQL.Add("    AND M.Cliente     = C.Codigo ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" AND M.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND M.Cliente = '"~Dialogo.Cliente1~"' ")
Endif
* FJL 27/04/20 - Se agrega opcion todos
*If Dialogo.Radio1=0
*   SQL.ADD(" AND (M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") AND M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQGARA'))~"))  ")
*Else
*   If Dialogo.Radio1=1
*      SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") ") 
*   Else
*      SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQGARA'))~") ")
*   Endif
*Endif
If Dialogo.Radio1=0
  SQL.ADD(" AND (M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") AND M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQGARA'))~"))  ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") ") 
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQGARA'))~") ")
Endif
SQL.Add("UNION ALL ")
SQL.Add(" SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie2,T2.Cupon1,T2.Fecha1, T2.Especie5, T2.Fecha2,")
SQL.Add("        T2.Precio1,T2.Precio2,T2.Precio3,M.*, T2.CB5, T2.Precio5, ")
SQL.Add("        C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal, C.CUIT, C.CondicionIVA, ")
SQL.Add("        C.TipoInscripcion, C.Sucursal, M.Vehiculo, ")
SQL.Add("        CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ")
SQL.Add(" FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M ")
SQL.Add(" WHERE  T2.Especie2  =  '"~Dialogo.Especie1~"' ")
SQL.Add(" AND    T2.TipoTr2   = 'CUPON' ")
If Dialogo.Fecha1 > 0
   SQL.Add(" AND T2.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif
If Dialogo.Entero1 > 0
   SQL.Add(" AND T2.Cupon1    =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
Endif
SQL.Add(" AND    M.Concepto  <> '"~FStr(Val(ZA:02),1,0)~"' ")
SQL.Add(" AND    M.NrOperacion = T2.NrTrans ")
SQL.Add(" AND    M.Cliente     = C.Codigo ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" AND M.Mercado     = '"~Dialogo.Mercado1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND M.Cliente     = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
Endif
* FJL 27/04/20 - Se agrega opcion todos
*If Dialogo.Radio1=0
*   SQL.ADD(" AND (M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") AND M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQGARA'))~"))  ")
*Else
*   If Dialogo.Radio1=1
*      SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") ") 
*   Else
*      SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQGARA'))~") ")
*   Endif
*Endif
If Dialogo.Radio1=0
  SQL.ADD(" AND (M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") AND M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQGARA'))~"))  ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") ") 
Endif
If Dialogo.Radio1=2
  SQL.ADD(" AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQGARA'))~") ")
Endif
SQL.Add(" ORDER BY M.Cliente, T2.NrTrans, NrMov2, M.NrMov                                    ")
Recorrer SQL
   ACN(SG:1, 1)
   IF Incluido(fbn('CallPut'), 'PAS|PEN|PRE')
      ACN(SG:1, -1)
   ENDIF
   If val(z1)=12
      *- Recupero los datos para mostrar en el encabezado
      ACT(e:Val(w:1)+1, 'Fecha de Corte: '~fbn('Fecha1'))
      ACT(e:Val(w:1)+2, '% Amortizacion: '~Fstr(FBN['Precio1'],0,8))
      ACT(e:Val(w:1)+3, '% Renta:  '~Fstr(FBN['Precio2'],0,8))
      ACT(e:Val(w:1)+4, '% Ints.Capit.:  '~Fstr(FBN['Precio3'],0,8))
      ACT(h:Val(w:1)+1, 'Fecha De Pago: '~fbn('Fecha2')) 
      ACT(h:Val(w:1)+2, 'Moneda de Pago: '~fbn('Especie5'))
      SetFont(e:Val(w:1)..h:Val(w:1)+4, 2)
   EndIf
**************25/8/23
*si alguno es 0 no muestro esa fila
   IF (FBN('Precio1')*FBN('Precio2')*FBN('Precio3') = 0)
   ELSE
****************
       If Not EqSTr(val(aa2),FBN['Cliente']~FBN['NrTrans']~FBN['NrMov2']~fbn('CallPut'))
          scn(z1,1)

          act(aa2,FBN['Cliente']~FBN['NrTrans']~FBN['NrMov2']~fbn('CallPut'))
          ACT(a:val(z1),FBN('Sucursal'))
          ACN(BD:1, 0)
     
              IF Eqstr(fbn('CallPut'), 'Fal') Y Incluido(fbn('Mercado'), 'EU|CRYL|')
                   ACT(MT:1, BuscarCampo('TRANSACCIONES2','NrOperacionRef1','NrTrans', fbn('NrTrans2')))
                   ACT(b:val(z1), BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans', Val(MT:1)))
                   ACT(c:val(z1),COPY(BuscarCampo('CLIENTES','RazonSocial','Codigo', Val(B:Val(Z:1))),1,25))
    *          IF Incluido(fbn('Mercado'), 'EU|CRYL')
    *             ***---Busco Tr.Match de donde obtengo el cliente.
    *              ACT(MT:1, BuscarCampo('TRANSACCIONES2','NrOperacionRef1','NrTrans', fbn('NrTrans2')))
    *              ACT(b:val(z1), BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans', Val(MT:1)))
    *              ACT(c:val(z1),COPY(BuscarCampo('CLIENTES','RazonSocial','Codigo', Val(B:Val(Z:1))),1,25))
    *          ELSE
    *              ***---Busco la contraparte
    *              IF NoVacio(fbn('NrTrans2'))
    *                  SQL.ADD(" Select NrTrans, NrOperacionRef1, Cliente2 From "~DBO~".TRANSACCIONES2 Where NrOperacionRef3 = '"~fbn('NrTrans')~"' AND TipoTr2 IN ('DTP','RTP') AND NrTrans = '"~fbn('NrTrans2')~"' ")
    *              ELSE
    *                  SQL.ADD(" Select NrTrans, NrOperacionRef1, Cliente2 From "~DBO~".TRANSACCIONES2 Where NrOperacionRef3 = '"~fbn('NrTrans')~"' AND TipoTr2 IN ('DTP','RTP') ")
    *              ENDIF
    *              Recorrer SQL
    *                  DFA
    *                  ACT(RF:3, fbn('NrTrans'))
    *                  ACT(RF:4, fbn('NrOperacionRef1'))
    *                  ACT(CL:77, fbn('Cliente2'))
    *              Proximo
    *              ACT(b:val(z1), BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans', Val(RF:4)))
    *              ACT(c:val(z1),COPY(BuscarCampo('CLIENTES','RazonSocial','Codigo', Val(B:Val(Z:1))),1,25))
    *          ENDIF
          ELSE
              ACT(b:val(z1),FBN('Cliente'))
              ACT(c:val(z1),COPY(FBN('RazonSocial'),1,25))
          ENDIF
          ACT(d:val(z1), FBN('Cuenta'))
          ACN(e:val(z1),FBN('NrGrupo2'))
          ACN(f:val(z1),val(e:val(z1)) * Val(vr1) )
          FormatoCeldas(f:val(z1),Exe('F7'))
          * RENTA 
          ACN(g:Val(z1), val(e:val(z1)) * FBN('Precio2')/100 * Val(SG:1)) 
          * AMORTIZACION
          ACN(h:Val(z1), val(e:val(z1))*FBN('Precio1')/100  * Val(SG:1))
          SCN(h:Val(z1), val(e:val(z1))*FBN('Precio3')/100  * Val(SG:1))
          FormatoCeldas(h:val(z1),Exe('F7'))

          ACN(i:Val(z1), val(g:val(z1)) + val(h:val(z1)))
          IF fbn('CB5') = 1
              ACN(PR:5, fbn('Precio5'))
          ELSE
              ACN(PR:5, 1)
          ENDIF
          ACN(I:Val(Z:1), Val(I:Val(Z:1)) * Val(PR:5))
          ACN(ns1, Num(FBN('Concepto')) )

          If VAL(ns1)>=200
             ACN(ns1,VAL(ns1)-100)
          EndIf

          ACT(j:val(z1), BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',val(ns1)) )
          SetFont(a:val(z1)..Q:val(z1), 1)
       EndIf

       ACT(k:Val(z1), FBN['Cupon1'])
       SetFont(a:val(z1)..Q:val(z1), 1) 
   ENDIF
Proximo

SCN(z1, 2)

IF NO
ACT(A:val(z1), "Total .... ")

ACN(E:val(z1), Sum(e:Val(w:2)..e:val(z1)-1) )
ACN(F:val(z1), Sum(f:Val(w:2)..f:val(z1)-1) )
FormatoCeldas(f:val(z1),Exe('F2'))
ACN(G:val(z1), Sum(g:Val(w:2)..g:val(z1)-1) )
ACN(H:val(z1), Sum(h:Val(w:2)..h:val(z1)-1) )
FormatoCeldas(h:val(z1),Exe('F2'))
ACN(I:val(z1), Sum(i:Val(w:2)..i:val(z1)-1) )
SetFont(a:val(z1)..Q:val(z1), 2)
ENDIF
SCN(z1, 1)

ACO(01, 06)
ACO(02, 12)
ACO(03, 20)
ACO(04, 08)
ACO(05, 09)
ACO(06, 09)
ACO(07, 09)
ACO(08, 09)
ACO(09, 09)
ACO(10, 08)
ACO(11, 6)

RangoTitulo(a:1..k:Val(z1), Val(w:2)-1)
SetMargins(0,0,0,2)
LimitesVision(k:Val(z1)-1)

ACT(a:Val(z1)-1, 'Fin del listado')
SetFont(a:Val(z1)-1, 2)

Impresion(1,2)
Impresion(4,1)
SetPrintFit(3, 90)
