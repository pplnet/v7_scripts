ACT(ar:FAC+2, 'NMV')


SetFont(a:FAC..az:FAC+2,2)
AlinearCeldas(e:FAC+1..m:FAC+2,'D')
AlinearCeldas(r:FAC+1..a:FAC+2,'D')
AgregarMarco(a:FAC..m:FAC,1,0,Exe('COLOR'))
AgregarMarco(n:FAC..z:FAC,1,0,Exe('COLOR'))
AgregarMarco(a:FAC+1..z:FAC+2,2,0,Exe('COLOR'))

SetFilaActual(FAC+3)
ACN(ax:1, FAC)
ACN(ay:1, 1)

SQL.ADD("Select O.FechaVto, O.TipoOp,        O.NrOperacion,  O.Vehiculo1,  ")
SQL.ADD("       O.Cliente1, O.Cantidad,      O.Plazo,        O.Especie,    ")
SQL.ADD("       O.FechaOp,  O.ContraEspecie, O.PrecioRef,    O.PrecioRef4, ")
SQL.ADD("       O.Precio1,  O.TipoCambio3,   O.FechaUltCupon ")
SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".BOOKS B ")
SQL.ADD(" where O.TipoOp   In ('FXCT','FXVT') ")
SQL.ADD("   and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.Book1    =  B.Codigo ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(Val(az:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(az:2))
*  SQL.ADD(" and O.Book1 in ("~Pipe2Comillas(Val(az:2))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD(" order by FechaVto,Cliente1,Precio1 ")
recorrer SQL
  if fbn['FechaVto']=Val(av:1)
    if EqStr(fbn['TipoOp'],'FXCT')
      SCN(bd:Val(ay:1), 1)
      if Val(bd:Val(ay:1))>1
        SCN(bc:Val(ay:1), 1)
      endif
    else
      SCN(cd:Val(ay:1), 1)
      if Val(cd:Val(ay:1))>1
        SCN(cc:Val(ay:1), 1)
      endif
    endif
  else
    SCN(ay:1, 1)
    ACD(ba:Val(ay:1), fbn['FechaVto'])
    * Plazo Residual
    ACN(bg:Val(ay:1), fbn['FechaVto']-Dialogo.Fecha1)
    * Precio Futuro Hoy
    ACN(bh:Val(ay:1), CotizacionC(FBN['Especie'],'FUT',fbn['FechaVto'],,Dialogo.Fecha1, 1, SI,'ARP',SI))
    * Precio Spot Hoy
    ACN(bi:Val(ay:1), CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI,'ARP'))

    ACD(ca:Val(ay:1), fbn['FechaVto'])
    * Plazo Residual
    ACN(cg:Val(ay:1), fbn['FechaVto']-Dialogo.Fecha1)
    * Precio Futuro Hoy
    ACN(ch:Val(ay:1), CotizacionC(FBN['Especie'],'FUT',fbn['FechaVto'],,Dialogo.Fecha1, 1, SI,'ARP',SI))
    * Precio Spot Hoy
    ACN(ci:Val(ay:1), CotizacionC(FBN['Especie']  ,,,, Dialogo.Fecha1, 1, SI,'ARP'))

    * Tasa Implicita Falta
    ACN(bf:Val(ay:1), 0)
    ACN(cf:Val(ay:1), 0)

    if EqStr(fbn['TipoOp'],'FXCT')
      SCN(bd:Val(ay:1), 1)
    else
      SCN(cd:Val(ay:1), 1)
    endif
    if Val(ax:2)=0
      ACN(bb:Val(ay:1), Val(ax:1))
      ACN(bc:Val(ay:1), Val(ax:1))
      ACN(cb:Val(ay:1), Val(ax:1))
      ACN(cc:Val(ay:1), Val(ax:1))
    else
      if Val(bc:Val(ay:1)-1)>=Val(cc:Val(ay:1)-1)
        ACN(bb:Val(ay:1), Val(bc:Val(ay:1)-1)+1)
        ACN(bc:Val(ay:1), Val(bc:Val(ay:1)-1)+1)
        ACN(cb:Val(ay:1), Val(bc:Val(ay:1)-1)+1)
        ACN(cc:Val(ay:1), Val(bc:Val(ay:1)-1)+1)
      else
        ACN(bb:Val(ay:1), Val(cc:Val(ay:1)-1)+1)
        ACN(bc:Val(ay:1), Val(cc:Val(ay:1)-1)+1)
        ACN(cb:Val(ay:1), Val(cc:Val(ay:1)-1)+1)
        ACN(cc:Val(ay:1), Val(cc:Val(ay:1)-1)+1)
      endif
    endif
    ACD(av:1,  fbn['FechaVto'])
  endif
  ACN(ax:2, 1)

  if EqStr(fbn['TipoOp'],'FXCT')
    SetFilaActual(Val(bc:Val(ay:1)))
    ACN(aa:FAC, 1)
    ACN(ab:FAC, 52)
    ACN(ac:FAC, 0)
    ACN(ai:FAC, 1)
  else
    SetFilaActual(Val(cc:Val(ay:1)))
    ACN(aa:FAC, 14)
    ACN(ab:FAC, 78)
    ACN(ac:FAC, 7)
    ACN(ap:FAC, -1)
  endif
  * Cotizacion Spot
  ACN(ad:FAC, CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI,FBN['ContraEspecie']))
  * Fecha Vto        (a: Compras / n: Ventas)
  ACD(Val(aa:FAC)  :FAC, fbn['FechaVto'])
  * Nro Operacion    (b: Compras / o: Ventas)
  ACT(Val(aa:FAC)+1:FAC, fbn['NrOperacion'])
  * Vehiculo         (c: Compras / p: Ventas)
  ACT(Val(aa:FAC)+2:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',fbn['Vehiculo1']),1,14))
  * Contraparte      (d: Compras / q: Ventas)
  ACT(Val(aa:FAC)+3:FAC, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1']))
  * Nominales        (e: Compras / r: Ventas)
  ACN(Val(aa:FAC)+4:FAC, fbn['Cantidad'])
  * Precio Op      (f: Compras / s: Ventas)
  if Dialogo.radio3=0
    ACN(Val(aa:FAC)+5:FAC, fbn['Precio1'])
  else
    if fbn('FechaUltCupon')>0 y fbn('FechaUltCupon')<Dialogo.Fecha1
      ACN(Val(aa:FAC)+5:FAC, fbn['TipoCambio3'])
    else
      ACN(Val(aa:FAC)+5:FAC, fbn['Precio1'])
    endif
  endif
*  * Precio Hoy       (g: Compras / t: Ventas)
*  ACN(Val(aa:FAC)+6:FAC, Val(ad:FAC))
*  ACN(Val(aa:FAC)+6:FAC, Val(Val(ab:FAC)+8:Val(ay:1)))
  * Plazo Original   (h: Compras / u: Ventas)
  ACN(Val(aa:FAC)+7:FAC, fbn['Plazo'])
  * Plazo Residual   (i: Compras / v: Ventas)
  ACN(Val(aa:FAC)+8:FAC, Val(Val(ab:FAC)+7:Val(ay:1)))
  * Tasa Implicita   (j: Compras / w: Ventas)
  ACN(Val(aa:FAC)+9:FAC, Val(Val(ab:FAC)+6:Val(ay:1)))

  * ae: compras / al: ventas
  ACD(31+Val(ac:FAC):FAC, Dialogo.Fecha1)
  SQL.ADD("Select Max(TD1.Fecha) AS Max ")
  SQL.ADD("  from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 ")
  SQL.ADD(" Where TD1.TipoTasa  =  TT1.Codigo ")
  SQL.ADD("   and TT1.PrecioRef =  '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("   AND TD1.Fecha     <= '"~IdxDate(Dialogo.Fecha1)~"' ")
  Recorrer SQL
    dfa
    * ae: compras / al: ventas
    ACD(31+Val(ac:FAC):FAC, FBN['Max'])
  Proximo

  * af: compras / am: ventas
  ACD(32+Val(ac:FAC):FAC, Dialogo.Fecha1)
  SQL.ADD("Select Max(TD1.Fecha) AS Max ")
  SQL.ADD("  from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 ")
  SQL.ADD(" Where TD1.TipoTasa  =  TT1.Codigo ")
  SQL.ADD("   and TT1.PrecioRef =  '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("   AND TD1.Fecha     <= '"~IdxDate(Dialogo.Fecha1)~"' ")
  Recorrer SQL
    dfa
    * af: compras / am: ventas
    ACD(32+Val(ac:FAC):FAC, FBN['Max'])
  Proximo

  ACD(fe:1, Dialogo.Fecha1)
  *- Obtiene los FD(t,Tj-t) en fd1  y tasa implicita en ti1  
  ACD(fe:2,FBN['FechaVto'])
  *- fe3 es el plazo a interpolar 
  ***---Se lo divide por 365 y multiplica por 360 para expresarlo en 360 como el plazohasta
  ***---de tasasdia
  ACN(fe:3, (val(fe:2)-val(fe:1)) / 365 * 360)

  ACN(ff:1,0)
  ACN(fd:1,0)
  ACN(fd:2,0)
  ACN(fd:3,0)
  ACN(fd:4,0)
  ACN(fd:5,0)

  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD(" Where TD.Especie  = '"~FBN['Especie']~"' ")
  SQL.ADD("   and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("   and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("   AND TD.Fecha      = '"~IdxDate(val(31+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("   and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
  SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                         Where TD.Especie             = '"~FBN['Especie']~"' ")
  SQL.ADD("                           and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                           and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("                           AND TD.Fecha               = '"~IdxDate(val(31+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("                           and "~Fstr(val(fe:3),0,0)~" <= PlazoHasta ")
  SQL.ADD("                       ) ")
  SQL.ADD(" Union All ")
  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD(" Where TD.Especie    = '"~FBN['Especie']~"' ")
  SQL.ADD("   and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("   and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("   AND TD.Fecha      = '"~IdxDate(val(31+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
  SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                         Where TD.Especie             = '"~FBN['Especie']~"' ")
  SQL.ADD("                           and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                           and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("                           AND TD.Fecha               = '"~IdxDate(val(31+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("                           and "~Fstr(val(fe:3),0,0)~" > PlazoHasta ")
  SQL.ADD("                       ) ")
  SQL.ADD("ORDER BY TD.PlazoHasta  ")
  Recorrer SQL
    dfa
    IF val(ff:1)<=val(fe:3) y val(fe:3)<=FBN['PlazoHasta']
      * Este es el plazo a interpolar  
      ACN(fd:3, val(fd:1)/FBN['Valor4'] -1 )
      ACN(fd:4, (val(fd:3)/(FBN['Valor3']-val(fd:2)))*100 )
      ACN(fd:5, (FBN['Valor3']-(val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd:2))*val(fd:1)+((val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd:2))/(FBN['Valor3']-val(fd:2))*FBN['Valor4']) 
    EndIf
    ACN(ff:1,FBN['PlazoHasta'])
    ACN(fd:1,FBN['Valor4'])
    ACN(fd:2,FBN['Valor3'])
  Proximo
  * ag: compras / an: ventas
  ACN(33+Val(ac:FAC):fac, Val(fd:5))

  ACN(ff:1,0)
  ACN(fd:1,0)
  ACN(fd:2,0)
  ACN(fd:3,0)
  ACN(fd:4,0)
  ACN(fd:5,0)

  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("Where TD.Especie  = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("AND TD.Fecha      = '"~IdxDate(val(32+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
  SQL.ADD("                       from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                      Where TD.Especie             = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("                        and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                        and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("                        AND TD.Fecha               = '"~IdxDate(val(32+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("                        and "~Fstr(val(fe:3),0,0)~" <= PlazoHasta ")
  SQL.ADD("                    ) ")
  SQL.ADD(" Union All")
  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD(" Where TD.Especie    = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("   and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("   and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("   AND TD.Fecha      = '"~IdxDate(val(32+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
  SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                         Where TD.Especie             = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("                           and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                           and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("                           AND TD.Fecha               = '"~IdxDate(val(32+Val(ac:FAC):FAC))~"' ")
  SQL.ADD("                           and "~Fstr(val(fe:3),0,0)~" > PlazoHasta ")
  SQL.ADD("                       ) ")
  SQL.ADD("ORDER BY TD.PlazoHasta  ")
  Recorrer SQL
    dfa
    IF val(ff:1)<=val(fe:3) y val(fe:3)<=FBN['PlazoHasta']
      * Este es el plazo a interpolar  
      ACN(fd:3, val(fd:1)/FBN['Valor4'] -1 )
      ACN(fd:4, (val(fd:3)/(FBN['Valor3']-val(fd:2)))*100 )
      ACN(fd:5, (FBN['Valor3']-(val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd:2))*val(fd:1)+((val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd:2))/(FBN['Valor3']-val(fd:2))*FBN['Valor4']) 
    EndIf
    ACN(ff:1,FBN['PlazoHasta'])
    ACN(fd:1,FBN['Valor4'])
    ACN(fd:2,FBN['Valor3'])
  Proximo
  * ah: compras / ao: ventas
  ACN(34+Val(ac:FAC):fac, Val(fd:5))

  if EqStr(fbn['TipoOp'],'FXCT')
    * Precio Hoy
    ACN(bu:Val(ay:1), Val(ad:FAC) *  Val(33+Val(ac:FAC):FAC) / val(34+Val(ac:FAC):FAC) )
  else
    * Precio Hoy
    ACN(cu:Val(ay:1), Val(ad:FAC) *  Val(33+Val(ac:FAC):FAC) / val(34+Val(ac:FAC):FAC) )
  endif

  * Precio Hoy
  * aj: compras / aq: ventas
  ACN(36+Val(ac:FAC):fac, Val(ad:FAC) *  Val(33+Val(ac:FAC):FAC) / val(34+Val(ac:FAC):FAC) )
  * Net market Value
  * ak: compras / ar: ventas
  ACN(37+Val(ac:FAC):fac, Val(35+Val(ac:FAC):FAC) * fbn['Cantidad'] * Val(36+Val(ac:FAC):fac))

  * Net market Value  (k: Compras / x: Ventas)
  ACN(Val(aa:FAC)+10:FAC, (Val(35+Val(ac:FAC):FAC) * fbn['Cantidad'] *  Val(ad:FAC) *  Val(33+Val(ac:FAC):FAC)) / val(34+Val(ac:FAC):FAC) )
  *   11 (k) o 24 (x)      35 (ai) o 42 (ap)                                           33 (ag) o 40 (an) FD Esp   34 (ah) o 41 (ao)  FD Mon

  * P&L en ARP        (l: Compras / y: Ventas)
*  ACN(Val(aa:FAC)+11:FAC, Val(35+Val(ac:FAC):FAC) * fbn['Cantidad'] * ( val(ad:FAC) * ( val(33+Val(ac:FAC):FAC) / val(34+Val(ac:FAC):FAC) ) - FBN['Precio1'] ) * val(34+Val(ac:FAC):FAC) )
  ACN(Val(aa:FAC)+11:FAC, Val(35+Val(ac:FAC):FAC) * fbn['Cantidad'] * ( val(ad:FAC) * ( val(33+Val(ac:FAC):FAC) / val(34+Val(ac:FAC):FAC) ) - Val(Val(aa:FAC)+5:FAC) ) * val(34+Val(ac:FAC):FAC) )
  *   12 (l) o 25 (y)      35 (ai) o 42 (ap)                                            33 (ag) o 40 (an) FD Esp  34 (ah) o 41 (ao) FD Mon                               34 (ah) o 41 (ao) FD Mon

  * P&L en USD        (m: Compras / z: Ventas)
*  ACN(Val(aa:FAC)+12:FAC, Val(Val(aa:FAC)+11:FAC)/Val(Val(aa:FAC)+6:FAC))
*  *   13 (m) o 26 (z)     12 (l) o 25 (y)         7 (g) o 20 (t)
  ACN(Val(aa:FAC)+12:FAC, Val(Val(aa:FAC)+11:FAC)/Val(ad:FAC))
  *   13 (m) o 26 (z)     12 (l) o 25 (y)

  * Precio Hoy       (g: Compras / t: Ventas)
  ACN(Val(aa:FAC)+6:FAC, Val(Val(aa:FAC)+10:FAC)*Val(35+Val(ac:FAC):FAC)/fbn['Cantidad'])
  *                      (k: Cpras / x: Vtas)    35 (ai) o 42 (ap)

  if EqStr(fbn['TipoOp'],'FXCT')
    * Precio Hoy
    ACN(bt:Val(ay:1), Val(Val(aa:FAC)+6:FAC))
    * Para Formula 1
    SCN(bj:Val(ay:1), fbn['Cantidad']*Val(bg:Val(ay:1)))
    SCN(bk:Val(ay:1), fbn['Cantidad'])
    * Para Formula 2
    SCN(bl:Val(ay:1), fbn['Cantidad']*fbn['Plazo']*Val(Val(aa:FAC)+5:FAC))
    SCN(bm:Val(ay:1), fbn['Cantidad']*fbn['Plazo'])
    * Para Formula 3
*    SCN(bn:Val(ay:1), fbn['Cantidad']*Val(bg:Val(ay:1))*Val(bi:Val(ay:1)))
*    SCN(bn:Val(ay:1), fbn['Cantidad']*Val(bg:Val(ay:1))*Val(bh:Val(ay:1)))
    SCN(bn:Val(ay:1), fbn['Cantidad']*Val(bg:Val(ay:1))*Val(bt:Val(ay:1)))
    * Para Formula 4
    SCN(bo:Val(ay:1), fbn['Cantidad']*Val(bg:Val(ay:1))*Val(bf:Val(ay:1)))
    * Suma Nominal
    SCN(bp:Val(ay:1), Val(Val(aa:FAC)+4:FAC))
    * Suma Net Market value
    SCN(bq:Val(ay:1), Val(Val(aa:FAC)+10:FAC))
    * Suma P&L en ARP
    SCN(br:Val(ay:1), Val(Val(aa:FAC)+11:FAC))
    * Suma P&L en USD
    SCN(bs:Val(ay:1), Val(Val(aa:FAC)+12:FAC))
  else
    * Precio Hoy
    ACN(ct:Val(ay:1), Val(Val(aa:FAC)+6:FAC))
    * Para Formula 1
    SCN(cj:Val(ay:1), fbn['Cantidad']*Val(cg:Val(ay:1)))
    SCN(ck:Val(ay:1), fbn['Cantidad'])
    * Para Formula 2
    SCN(cl:Val(ay:1), fbn['Cantidad']*fbn['Plazo']*Val(Val(aa:FAC)+5:FAC))
    SCN(cm:Val(ay:1), fbn['Cantidad']*fbn['Plazo'])
    * Para Formula 3
*    SCN(cn:Val(ay:1), fbn['Cantidad']*Val(cg:Val(ay:1))*Val(ci:Val(ay:1)))
*    SCN(cn:Val(ay:1), fbn['Cantidad']*Val(cg:Val(ay:1))*Val(ch:Val(ay:1)))
    SCN(cn:Val(ay:1), fbn['Cantidad']*Val(cg:Val(ay:1))*Val(ct:Val(ay:1)))
    * Para Formula 4
    SCN(co:Val(ay:1), fbn['Cantidad']*Val(cg:Val(ay:1))*Val(cf:Val(ay:1)))
    * Suma Nominal
    SCN(cp:Val(ay:1), Val(Val(aa:FAC)+4:FAC))
    * Suma Net Market value
    SCN(cq:Val(ay:1), Val(Val(aa:FAC)+10:FAC))
    * Suma P&L en ARP
    SCN(cr:Val(ay:1), Val(Val(aa:FAC)+11:FAC))
    * Suma P&L en USD
    SCN(cs:Val(ay:1), Val(Val(aa:FAC)+12:FAC))
  endif
proximo

SetFont(a:Val(ax:1)..ar:FAC,1)
FormatoCeldas(e:Val(ax:1)..e:FAC,Exe('F2'))
FormatoCeldas(f:Val(ax:1)..g:FAC,Exe('F7'))
FormatoCeldas(h:Val(ax:1)..i:FAC,Exe('F0'))
FormatoCeldas(j:Val(ax:1)..j:FAC,Exe('F7'))
FormatoCeldas(k:Val(ax:1)..m:FAC,Exe('F2'))
FormatoCeldas(r:Val(ax:1)..r:FAC,Exe('F2'))
FormatoCeldas(s:Val(ax:1)..t:FAC,Exe('F7'))
FormatoCeldas(u:Val(ax:1)..v:FAC,Exe('F0'))
FormatoCeldas(w:Val(ax:1)..w:FAC,Exe('F7'))
FormatoCeldas(x:Val(ax:1)..z:FAC,Exe('F2'))

FormatoCeldas(ad:Val(ax:1)..ad:FAC,Exe('F7'))

FormatoCeldas(ag:Val(ax:1)..ah:FAC,Exe('F7'))
FormatoCeldas(aj:Val(ax:1)..aj:FAC,Exe('F7'))
FormatoCeldas(ak:Val(ax:1)..ak:FAC,Exe('F2'))

FormatoCeldas(an:Val(ax:1)..ao:FAC,Exe('F7'))
FormatoCeldas(aq:Val(ax:1)..aq:FAC,Exe('F7'))
FormatoCeldas(ar:Val(ax:1)..ar:FAC,Exe('F2'))

SetFont(ba:2..cz:Val(ay:1),1)
FormatoCeldas(bf:2..bf:Val(ay:1),Exe('F7'))
FormatoCeldas(bg:2..bg:Val(ay:1),Exe('F0'))
FormatoCeldas(bh:2..bi:Val(ay:1),Exe('F7'))
FormatoCeldas(bt:2..bu:Val(ay:1),Exe('F7'))

FormatoCeldas(cf:2..cf:Val(ay:1),Exe('F7'))
FormatoCeldas(cg:2..cg:Val(ay:1),Exe('F0'))
FormatoCeldas(ch:2..ci:Val(ay:1),Exe('F7'))
FormatoCeldas(ct:2..cu:Val(ay:1),Exe('F7'))

ACN(ax:3, 14)
(.'AUXREPFXF'.)

ACT(a:FAC, 'Fin del Listado')
SetFont(a:FAC,2)

SetFont(av:1..az:3,1)

ACO(1,6)
ACO(2,6)
ACO(3,8)
ACO(4,18)
ACO(5,7)
ACO(11,7)
ACO(12,7)
ACO(13,7)

ACO(14,6)
ACO(15,6)
ACO(16,8)
ACO(17,18)
ACO(18,7)
ACO(24,7)
ACO(25,7)
ACO(26,7)

LimitesVision(z:FAC)
Impresion(1,2)
SetMargins(0.5,1,0.2,1)
