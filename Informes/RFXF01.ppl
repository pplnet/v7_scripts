ACT(n:FAC, 'V E N T A S')
ACT(n:FAC+1, 'Fecha de')
ACT(n:FAC+2, 'Vencim.')
ACT(o:FAC+1, 'Nro. de')
ACT(o:FAC+2, 'Operacion')
ACT(p:FAC+1, 'Vehiculo')
