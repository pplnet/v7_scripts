ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: "Operacion"        ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar operacion';NO;;;;;;" TipoOp In ('FCS') ";
FinDialogo

If Not OK
  Cancelar
Endif

CrearFont(1,"Arial,11,")
CrearFont(2,"Arial,11,B")
CrearFont(3,"Arial,11,BU")
CrearFont(4,"Arial,11,U")
CrearFont(5,"Arial,7,")
CrearFont(6,"Arial,10,")
CrearFont(7,"Arial,10,B")
CrearFont(8,"Arial,11,BI")
CrearFont(9,"Arial,8,")

SQL.ADD("Select O.TipoOp,O.TotalNetoCli1, O.Cliente1,O.Especie,O.Vehiculo1,O.NrOperacion,O.Cuenta2,O.Cuenta1,O.TotalNetoCli1,O.ContraEspecie, ")
SQL.ADD("C.Localidad, C.Telefono, C.Fax, C.CUIT, C.RazonSocial, C.Direccion,C.CodigoPostal,C.PaisDir,C.Provincia, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C   ")
SQL.ADD(" Where NrOperacion ='"~Dialogo.NrOperacion1~"' and O.Vehiculo1=C.Codigo  ")
Recorrer SQL
  ACT(zd:99,fbn['TipoOp'])
  ACT(zz:98,fbn['ContraEspecie'])
  ACT(zd:88,fbn['Cliente1'])  
  ACT(za:99,fbn['Cuenta2']) 
  ACN(zb:99,fbn['TotalNetoCli1'])
  ACT(zy:99,fbn['Localidad'])
  ACT(zz:99,fbn['Vehiculo1'])
  ACT(aa:99,fbn['NrOperacion'])
  ACT(ab:99,fbn['Cuenta2']) 
  ACN(ac:99,fbn['TotalNetoCli1'])   
  ACT(ab:1,fbn['RazonSocial'])
  ACD(FE:1, fbn('FechaOp'))
  ACT(ac:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ]))
  ACT(aa:1,BuscarCampo('ESPECIES','Extendido'     ,'Codigo',Fbn['Especie']))
  ACT(aa:2,BuscarCampo('ESPECIES','Nombre'     ,'Codigo',Fbn['Especie']))
  ACT(cc:1,BuscarCampo('ESPECIES','Codigo'     ,'Codigo',Fbn['Especie']))
  ACT(ad:1, BuscarCampo('CLIENTES','CUIT','Codigo',Fbn['Vehiculo1']))
  ACT(ee:1, BuscarCampo('CLIENTES', 'RazonSocial','Codigo', BuscarCampo('CUENTAS','Comitente'   ,'Codigo',Fbn['Cuenta2'])))
  ACT(af:1,BuscarCampo('CUENTAS','Alias9'      ,'Codigo',Fbn['Cuenta1']))
  ACT(cu:99,BuscarCampo('CUENTAS','Numero','Codigo',fbn['Cuenta2'])) 
  ACT(ta:1,fbn['Telefono'])
  ***---ACT(tb:1,fbn['Fax'])
  ACT(TB:1, BuscarCampo('CLIENTES','Fax','Codigo',Fbn['Vehiculo1']))
  ACT(tc:1,fbn['Direccion'])
  ACT(td:1,fbn['CodigoPostal'])
  ACT(te:1,BuscarCampo('PAISES','Nombre','Codigo',fbn['PaisDir']))
  ACT(tf:1,BuscarCampo('PROVINCIAS','Nombre','Codigo',fbn['Provincia']))
Proximo
if EqStr(val(zz:98),var('MONEEXTR')) 
   ACT(cc:88,'u$s' ) 
   ACT(cc:66,'dolares' ) 
   else
   if EqStr(val(zz:98),var('MONELOCA'))    
      ACT(cc:88,'$' )
      ACT(cc:66,'pesos' ) 
      else     
      ACT(cc:88,val(zz:98) )
   endif  
endif
If EqStr(val(cc:1),var('AHORROPL'))
   SetFilaActual(5) 
   ACT(g:fac, val(zy:99)~', '~FStr(Dia(Val(FE:1)),2,0)~' de '~Meses(Mes(Val(FE:1)))~' de '~FStr(Anio(Val(FE:1)),4,0)~'.')
   ACT(a:fac+1, UsuarioActivo~'-'~val(aa:99))
   AFI(fac+2,8)
   ACT(a:fac+3,'Sres.')
   ACT(a:fac+4,val(ac:1))
   AFI(fac+5,8)
   ACT(a:fac+6,'Presente')
   ACT(A:fac+8,'De nuestra consideracion:')
   SetFont(a:fac..g:fac+8,1)
   SetFont(a:fac+6,4)
   AFI(fac+9,8)
   SetFilaActual(fac+10)
   ACT(c:fac,'         Por intermedio de la presente les solicitamos a ustedes SUSCRIBIR la')
   SetFont(c:fac,1)
   AFI(FAC+1,8)
   SetFilaActual(FAC+2)
   ACN(fi:1,FAC)
   ACT(TX:1,'cantidad de '~val(cc:88)~PYC(val(zb:99),0,2)~' al fondo '~val(aa:2)~' clase B de la cuenta Nº '~val(cu:99)~' a nombre de '~val(ab:1)~' y el importe sera transferido desde el banco de Valores.') 
   ACN(CR:1, 90)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ACT(A:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa
      IF &k < Val(FI:2)
        AFI(fac, 8)
      ENDIF
      Ifa
   Proximo
   SetFont(a:VAL(fi:1)..a:fac,1)
   ACT(c:fac,'         Asimismo nos comprometemos a enviar el original de la presente nota a')
   AFI(fac+1, 8)
   ACT(a:fac+2,'vuestras oficinas y a retirar los formularios de liquidación correspondientes dentro de las 24 horas')
   AFI(FAC+3,8)
   ACT(a:FAC+4,'habiles.')
   SetFont(a:fac..c:fac+4,1)
   SetFilaActual(FAC+6)
   AFI(FAC-1,8)
   ACT(a:fac,'Dejamos constancia que hemos recibido conocemos y adherimos al Reglamento de Gestion del Fondo Comun de')
   ACT(a:fac+1,'Inversion respectivo.')
   AFI(fac+2, 8)   
   ACT(a:fac+3,'Asimismo:')
   SetFont(a:fac..a:fac+3,6)
   AFI(fac+4, 3)
   SetFilaActual(fac+5)  
   ACN(dd:99,FAC)
   ACT(a:FAC,'             ·')
   SETFONT(a:Fac,7) 
   ACT(tx:1,var('PIEAHORRO1')~var('PIEAHORRO2')~var('PIEAHORRO3')~var('PIEAHORRO4'))
   ACN(CR:1,100)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ACT(B:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa     
   Proximo
   AFI(FAC,3)
   ACN(FI:80,Val(FI:2))
   ACT(a:FAC+1,'             ·')
   SETFONT(a:Fac+1,7)     
   ifa
   ACT(tx:1,var('PIEAHORRO5')~var('PIEAHORRO6'))
   ACN(CR:1,115)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ACT(B:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa     
   Proximo
   ACN(FI:90,Val(FI:2)+VAL(FI:80) )
   SetFont(b:VAL(dd:99)..b:VAL(dd:99)+Val(FI:90),9)
   SetFilaActual(fac+1)
   ACT(d:fac,'Sin otro particular, los saludamos a ustedes muy atte.-')
   Setfont(d:fac,1)
   SetFilaActual(fac+2)
   ACT(a:fac,'La firma esta verificada:')
   Setfont(a:fac,1)

Else
                   **otra carta**

   SetFilaActual(5) 
   ***---ACT(g:fac, val(zy:99)~', '~FStr(Dia(Fsys),2,0)~' de '~Meses(Mes(Fsys))~' de '~FStr(Anio(Fsys),4,0))
   ACT(g:fac, val(zy:99)~', '~FStr(Dia(Val(FE:1)),2,0)~' de '~Meses(Mes(Val(FE:1)))~' de '~FStr(Anio(Val(FE:1)),4,0)~'.')
   ACT(a:fac+2, UsuarioActivo~'-'~val(aa:99))
   ACT(a:fac+4,'Señores')
   ACT(a:fac+6,val(ac:1))
   ACT(a:fac+8,'Presente')
   ACT(A:fac+10,'Ref.: Suscripcion Fondos')
   setfont(a:Fac..g:Fac+2,1)
   setfont(a:fac+4..a:fac+6,2)
   setfont(a:fac+8,3)
   SetFont(a:fac+10,8)
   ACN(fi:1,FAC+13)
   ACT(A:fac+13,'De mi mayor consideracion:')
   ACT(C:fac+16,'         Por intermedio de la presente solicito a Uds. tengan a bien suscribir '~val(cc:66))
   AFI(fac+17, 8) 
   SetFilaActual(FAC+18)
   ACT(TX:1,Minusculas2(letras(val(ac:99),0,100))~' ('~val(cc:88)~PYC(val(ac:99),0,0) ~'.-) a '~val(ab:1)~' cuenta cuotapartista Nº '~val(af:1)~' en el fondo '~val(aa:1)~'.') 
   ACN(CR:1, 90)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ACT(A:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa
      IF &k < Val(FI:2)
        AFI(fac, 8)
      ENDIF
      Ifa
   Proximo
   AFI(fac+1, 8)   
   ACT(A:fac+4,'Los fondos provienen del '~val(ee:1))
   ACT(A:fac+9,'                                                           Sin otro motivo, saludo a Uds., muy atentamente.')
   setfont(a:VAL(fi:1)..d:fac+10,1)
   SetFilaActual(fac+15)
Endif
ACT(h:fac+1,val(ab:1))
ACT(h:fac+2,'CUIT: '~val(ad:1) )
SetFont(h:fac+1..h:fac+2,1)
AFI(FAC+3,4)
*AgregarBMP(a:1,Var('PATHLOGO')~val(zz:99)~'.bmp',80)   
let &filaLogo 1
@Logo

If EqStr(val(cc:1),var('AHORROPL'))
   ACT(h:54,'Tel: '~val(ta:1))
   ACT(h:55,'Fax: '~val(tb:1))
   ACT(h:56,val(tc:1))
   ACT(h:57,val(td:1)~'-'~val(tf:1)~'-'~val(te:1)) 
   SetFont(h:54..h:57,5)
   LimitesVision(l:58)
   Recorrer&I 54,57
     AFI(&I,7)
   Proximo
else
   ACT(h:49,'Tel: '~val(ta:1))
   ACT(h:50,'Fax: '~val(tb:1))
   ACT(h:51,val(tc:1))
   ACT(h:52,val(td:1)~' - '~val(tf:1)~' - '~val(te:1)) 
   SetFont(h:49..h:52,5)
   LimitesVision(l:53)
   Recorrer&I 49,52
     AFI(&I,7)
   Proximo
endif
SetMargins(1.5,1,1.5,1)
Impresion(2,0)
Impresion(3,0)