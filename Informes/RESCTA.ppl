         SQL.ADD("select Especie,Mercado,Sum(Saldo) Saldo from ")
         SQL.ADD("(select Especie,Mercado,Saldo from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E")
         **SQL.ADD("   where S.Cuenta in (select Codigo from CUENTAS where Cliente='"~Dialogo.Cliente1~"' and TipoCuenta = 'VIS' and (Especies like '%'+S.Especie+'%' or Especies like '%MONEDA%')) ")
         SQL.ADD("   where S.Cuenta in (select Codigo from CUENTAS where Cliente='"~Dialogo.Cliente1~"' and TipoCuenta = 'VIS')  ")
         SQL.ADD("     and S.Especie = E.Codigo ")
         SQL.ADD("     and S.NrSaldo = 81 ")
         SQL.ADD("     and Cliente = '"~Dialogo.Cliente1~"' ")
         SQL.ADD("     and S.Mercado  in ("~Pipe2Comillas(VAR('RESCTAMERM'))~")  ")
         SQL.ADD("     and E.Jerarquia like '"~VAR('JERMONEDA')~"%' ")         
         SQL.ADD("     and S.Fecha = (SELECT MAX(S2.Fecha) ")
         SQL.ADD("                   FROM "~DBO~".SALDOSDIA S2 ")
         SQL.ADD("                   WHERE S2.Cliente = S.Cliente  AND ")
         SQL.ADD("                         S2.Especie = S.Especie  AND ")
         SQL.ADD("                         S2.EnteCustodia = S.EnteCustodia AND ")
         SQL.ADD("                         S2.Mercado = S.Mercado AND ")
