SQL.ADD("Select FechaOp, FechaVto, ContraEspecie, Cantidad, Precio1, TotalBrutoCli1, TotalAux1 as Comision, TotalIVA as IVAComision, ")
SQL.ADD("  TotalGastos as Derechos, TotalIvaAdi as IVADerechos, TotalNetoCli1, NrOperacion, ")
SQL.ADD("  Case When Mercado = '"~VAR('MERROFEX')~"' then ObservacDoc else Especie end Especie, ")   
SQL.ADD("  Case When TipoOp = 'FXCF' then 'Venta Futuro' When TipoOp = 'FXVF' then 'Compra Futuro' When TipoOp = 'DDC' then 'Documento Compra' else 'Documento Venta' end TipoOper, /* TotalNetoCli1 as SaldoFinal */")
**SQL.ADD("  Case When TipoOp = 'FXCF' then TotalBrutoCli1-TotalAux1-TotalIVA-TotalGastos-TotalIVAADI else TotalBrutoCli1+TotalAux1+TotalIVA+TotalGastos+TotalIVAADI end SaldoFinal")
SQL.ADD("  TotalBrutoCli1  SaldoFinal")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where O.Especie=E.Codigo  ")
SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and TipoOp in ('FXCF','FXVF') ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("order by Especie,FechaOp ")    
