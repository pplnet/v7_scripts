         SQL.ADD("                         S2.Cuenta  = S.Cuenta   AND ")
         SQL.ADD("                         S2.NrSaldo = S.NrSaldo) ")
         SQL.ADD(" ) AUX")    
         SQL.ADD("Group by Especie,Mercado ") 
         SQL.ADD("Order by Especie,Mercado ")           
