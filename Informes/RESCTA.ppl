SQL.ADD("Select RazonSocial,Direccion,CodigoPostal,Localidad,CUIT,CondicionIVA,NrIngBrutos, ")
#ifdef BIND
   SQL.ADD(" P.Nombre as Pais, Telefono, Fax, CodigoCNV,CodDepCajaValores as Depositante ")
#else
   SQL.ADD(" P.Nombre as Pais, Telefono, Fax, CodigoCNV,CodComitente as Depositante ")
#endif
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".PAISES P ")
SQL.ADD(" Where C.Codigo = '"~VAR('VEHICULODE')~"' ")
SQL.ADD("   and P.Codigo = C.Pais ")
**watch(sql.batch)

Recorrer SQL
   ACT(aa2,FBN['Depositante'])
   ACT(aa7,FBN['RazonSocial'])
   ACT(aa8,FBN['Direccion'])
   ACT(aa9,FBN['CodigoPostal'])
   ACT(aa10,FBN['Localidad'])   
   #ifdef BACS
     ACT(aa11,FBN['CUIT']) 
     ACT(aa12,'IVA ')
     If EqStr(fbn('CondicionIVA'),'INS')
     ACT(aa12,Val(aa12)~'R.Inscripto')
     Else
        if EqStr(fbn('CondicionIVA'),'NOI')
           ACT(aa12,Val(aa12)~'R. No Inscripto')
        else
           if EqStr(fbn('CondicionIVA'),'EXE')
              ACT(aa12,Val(aa12)~'Exento')
           else
              if EqStr(fbn('CondicionIVA'),'FIN')
                 ACT(aa12,Val(aa12)~'Cons.Final')
              else
                 if EqStr(fbn('CondicionIVA'),'MON')
                    ACT(aa12,Val(aa12)~'Monotributo')
                 else
                    ACT(aa12,Val(aa12)~'Otro')
                 endif
              endif
           endif
        endif
     Endif
     ACT(aa13,'Ing.Brutos '~FBN['NrIngBrutos']) 
   #else
      ACT(aa11,FBN['Pais'])   
      ACT(aa12,'T '~FBN['Telefono'])   
      ACT(aa13,'F '~FBN['Fax']) 
   #endif
   ACT(aa20,FBN['CodigoCNV'])
Proximo

