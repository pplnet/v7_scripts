SQL.ADD("Select FechaOp, FechaOp2 FechaVto, TipoDoc, ContraEspecie, Cantidad, TotalIntereses, TotalBrutoCli1, ImpGastos1,TotalGastos,MAVAdmGtiaVdr,  ")
SQL.ADD("  ImpGastos2,TotalAux1,MAVAdmGtiaVdrIVA,TotalRetenciones, TotalDerechos,TotalComisiones, TotalIva, TotalNetoCli1, NrOperacion, ")
SQL.ADD("  Case When Mercado = '"~VAR('MERROFEX')~"' then ObservacDoc else Especie end Especie, ")   
SQL.ADD("  Case When TipoOp = 'DDC' then 'Dto.Documento Compra' else 'Dto.Documento Venta' end TipoOper,")
SQL.ADD("  TotalBrutoCli1  SaldoFinal")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E where O.Especie=E.Codigo  ")
SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and TipoOp in ('DDC','DDV') ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("order by Especie,FechaOp ")    
ACN(fi19,fac)
ACN(xy1,0)
watch(sql.batch)
Recorrer SQL
   if Val(xy1)=0
   ACT(a:fac, 'DTO. de DOCUMENTOS')
      SetFont(a:fac, 3)
      ACN(fi19,fac)
      ifa
      
         ACT(a:fac,'Fecha Op.')
         ACT(b:fac,'Fecha Liq.')
         ACT(c:fac,'Tipo Op.')
         ACT(d:fac,'Tipo Doc.')
         ACT(e:fac,'Moneda')
         ACT(f:fac,'Moneda Liq.')
         ACT(g:fac,'Capital') 
         ACT(h:fac,'Intereses/Dto')
         ACT(i:fac,'Comisiones')
         ACT(j:fac,'IVA Comisiones')
         ACT(k:fac,'Derechos')
         ACT(l:fac,'IVA Derechos')
         ACT(m:fac,'Nro.Op.')      
         ACT(n:fac,'Monto') 
      
      
      SetFont(a:fac..1:fac, 2)      
      ACN(xy1,1)
      ACN(xy2,1)
      ACN(xy10,1)      
      ifa
   endif
 
   ACT(a:fac,FBN['FechaOp'])
   ACT(b:fac,FBN['FechaVto'])
   ACT(c:fac,FBN['TipoOper']) 
   ACT(d:fac,FBN['TipoDoc'])
   ACT(e:fac,FBN['Especie'])
   ACT(f:fac,FBN['ContraEspecie'])
   ACT(g:fac,PYC(FBN['Cantidad'], 0, 2))
   ACT(h:fac,PYC(FBN['TotalIntereses'], 0, 2))
   ACT(i:fac,PYC(FBN['ImpGastos1']+FBN['TotalGastos']+FBN['MAVAdmGtiaVdr'], 0, 2))
   ACT(j:fac,PYC(FBN['ImpGastos2']+FBN['TotalAux1']+FBN['MAVAdmGtiaVdrIVA']+FBN['TotalRetenciones'], 0, 2))
   ACT(k:fac,PYC(FBN['TotalDerechos']+FBN['TotalComisiones'], 0, 2))
   ACT(l:fac,PYC(FBN['TotalIva'], 0, 2))
   ACT(m:fac, FBN['NrOperacion'])
   ACT(n:fac,PYC(FBN['SaldoFinal'], 0, 2))
   
Proximo
ACN(fi20,fac)
If Val(xy1)=0
   ifa
   ACN(fi19,fac)
   ACN(fi20,fac)   
Endif   
