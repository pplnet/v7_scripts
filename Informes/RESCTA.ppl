SQL.ADD("Select FechaOp, FechaVto, Especie, ContraEspecie, Cantidad, Precio1, TotalBrutoCli1, TotalAux2 Comision, TotalIVA, TotalNetoCli1, NrOperacion, ")
SQL.ADD("  Case When TipoOp = 'TIC' then 'Venta' else 'Compra' end TipoOper, Case when E.InteresesC = 'CLE' Then TotalIntereses else 0 end Intereses ")
SQL.ADD("  , TotalNetoCli1 as SaldoFinal, UDN2 Rueda, Mercado, TotalGastos,TotalIvaAdi ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E ")
SQL.ADD(" where O.Especie=E.Codigo  ")
SQL.ADD("and (select Top(1) CT.Comitente from "~DBO~".CUENTAS CT Where CT.Codigo = O.Cuenta1 and TipoCuenta = 'CUS' and Comitente is not Null) = '"~VAR('VEHICULODE')~"' ")
SQL.ADD("and O.Mercado in ("~Pipe2Comillas(VAR('RESCTAMERT'))~") ")
SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and TipoOp in ('TIC','TIV') ")
**SQL.ADD("and Especie = 'AY24' ")
SQL.ADD("and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and E.Jerarquia like '"~VAR('JERTITULOS')~"%' ")
SQL.ADD("and CB4 <> 1 ")
SQL.ADD(" UNION ")
