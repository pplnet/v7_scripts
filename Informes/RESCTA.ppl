SQL.ADD("select  fecha1 FechaOp, Fecha1 FechaVto, Especie,'' ContraEspecie, Cantidad1 Cantidad,Precio1, cambio1 totalbrutocli1, 0 Comision, 0 TotalIVA, cambio1 totalnetocli1, Nrtrans NrOperacion, ")
SQL.ADD("  Case When TipoTr2 = 'DTP' then 'Deposito' when TipoTr2 = 'RTP' then 'Retiro' else 'Transf.' end TipoOper, 0 Intereses, Cambio1 as SaldoFinal, '' Rueda, Mercado1 Mercado ,0 TotalGastos, 0 TotalIvaAdi")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T where TipoTr2 in ('DTP','RTP','DRT') ")
SQL.ADD("and (select Top(1) CT.Comitente from "~DBO~".CUENTAS CT Where CT.Codigo = T.Cuenta1 and TipoCuenta = 'CUS' and Comitente is not Null) = '"~VAR('VEHICULODE')~"' ")
SQL.ADD("and (Mercado1 in ("~Pipe2Comillas(VAR('RESCTAMERT'))~") or Mercado2 in ("~Pipe2Comillas(VAR('RESCTAMERT'))~"))")
SQL.ADD("    and (NrOperacionRef1 = '' or NrOperacionRef1 is Null) and (NrOperacionRef2 = '' or NrOperacionRef2 is Null) ")
SQL.ADD("    and Cliente1 = '"~Dialogo.Cliente1~"' ")
*SQL.ADD("and Especie = 'AY24' ")
SQL.ADD("    and Fecha1 >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha1 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" union ")
SQL.ADD("select  T.Fecha1 FechaOp, M.FechaMov FechaVto,M.Especie, '' ContraEspecie, M.Cantidad ,1 Precio, Cantidad Totalbruto1, 0 Comision, 0 TotalIVA, Cantidad TotalnetoCli1, Nrtrans NrOperacion, ")
SQL.ADD("  Case When TipoTr2 = 'CANJE' then 'Canje' when TipoTr2 = 'STOCK' then 'Split' when TipoTr2 = 'PDIVID' then 'Dividendos' else 'Transf.' end TipoOper, 0 Intereses,Cambio1 as SaldoFinal, '' Rueda, Mercado ,0 TotalGastos, 0 TotalIvaAdi")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C , "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E ")
SQL.ADD("where TipoTr2 in ('CANJE','STOCK','PDIVID') ")
SQL.ADD("and (select Top(1) CT.Comitente from "~DBO~".CUENTAS CT Where CT.Codigo = T.Cuenta1 and TipoCuenta = 'CUS' and Comitente is not Null) = '"~VAR('VEHICULODE')~"' ")
SQL.ADD("and (Mercado1 in ("~Pipe2Comillas(VAR('RESCTAMERT'))~") or Mercado2 in ("~Pipe2Comillas(VAR('RESCTAMERT'))~"))")
SQL.ADD("    and (NrOperacionRef1 = '' or NrOperacionRef1 is Null) and (NrOperacionRef2 = '' or NrOperacionRef2 is Null) ")
SQL.ADD("    and M.NrOperacion = T.NrTrans ")
SQL.ADD("    and M.Especie  =  E.Codigo and E.Jerarquia not like '"~VAR('JERMONEDA')~"%' ")
SQL.ADD("    and T.Cambio5 = 101 ")
SQL.ADD("    and Cliente1 = C.Codigo ")
**SQL.ADD("and M.Especie = 'AY24' ")
SQL.ADD("    and Cliente1 = '"~Dialogo.Cliente1~"' ")
SQL.ADD("    and M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("Order by 3,mercado,1  ")
**SQL.ADD("Order by 3,17,1  ")
*watch(sql.batch)

