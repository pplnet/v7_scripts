SQL.ADD("Select S.Especie, E.Nombre, S.Mercado, sum(S.Saldo) as VN, S.NrSaldo, EC.Descripcion DescEst, ")
SQL.ADD(" ISNULL((Select Top(1) PrecioContable From "~DBO~".COTIZACIONES C Where Codigo = S.Especie AND Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' Order By Fecha Desc),1) as PrecioARP ")
SQL.ADD("from "~DBO~".SALDOSDIA S ")
SQL.ADD("     INNER JOIN  "~DBO~".ESPECIES E WITH (NOLOCK) ON S.Especie=E.Codigo ")
SQL.ADD("     INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("           ON (S.NrSaldo>201 or S.NrSaldo=101) AND (S.NrSaldo not in(121,227)) AND ((S.NrSaldo-100=EC.NrSaldo AND S.NrSaldo>201) or (S.NrSaldo=EC.NrSaldo AND S.NrSaldo=101)) ")
SQL.ADD("where S.Cliente = '"~Dialogo.Cliente1~"' AND ")
SQL.ADD("      S.EnteCustodia = '"~VAR('VEHICULODE')~"' AND ")
**22-08-2023 AA se igualan estados Nrsaldos a informe SLCUFP "Saldo de Custodia a Fecha Posicion" inner join
**SQL.ADD("      ((S.NrSaldo = "~Fstr(val(SL:1),0,0)~" AND S.NrSaldo = EC.NrSaldo) OR (S.NrSaldo > "~Fstr(val(SL:1),0,0)~"+100 AND S.NrSaldo-100 = EC.NrSaldo)) AND  " )
SQL.ADD("      S.Saldo <> 0 AND ")
SQL.ADD("      S.Especie = E.Codigo AND ")
SQL.ADD("      S.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente = S.Cliente  AND ")
SQL.ADD("                        S2.Especie = S.Especie  AND ")
SQL.ADD("                        S2.EnteCustodia = S.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' AND ")
SQL.ADD("                        S2.Cuenta  = S.Cuenta   AND ")
SQL.ADD("                        S2.NrSaldo = S.NrSaldo) ")
**22-08-2023 AA se igualan estados Nrsaldos a informe SLCUFP "Saldo de Custodia a Fecha Posicion" 
***---Excluyo Saldos Bloqueados por venta
***SQL.ADD(" AND S.NrSaldo <> "~Val(SB:1)~"+100 AND S.NrSaldo <> "~Val(SB:2)~"+100")
SQL.ADD(" Group by Especie, Nombre, Mercado, S.NrSaldo, EC.Descripcion  ")
*watch(sql.batch)

