#ifdef MLASA
      ACN(fi11,fac)
      ACN(xy1,0)
#else
        ** AA 28-07-2023 se incorporar corte por mercado como STD

        SQL.ADD("Select FechaMov,Mercado,M.Especie,NrMov,MonedaEmision,Cantidad,NrTrans2,isnull(T.ConceptoPago,'') Concepto,  ")
        SQL.ADD("       NrOperacion,Cantidad as SaldoFinal,")
        SQL.ADD("       Case when T.Observaciones like '%pr:%' then T.Observaciones else M.Leyenda end Leyenda, ")
        SQL.ADD("Case when SUBSTRING(NrOperacion,1,1)='T' then (select TipoOp from OPERACIONES O where O.NrOperacion=M.NrOperacion) ")
        SQL.ADD("     when SUBSTRING(NrOperacion,1,2)='DD' then (select TipoOp from OPERACIONES O where O.NrOperacion=M.NrOperacion) else 'OTRO' end TipoOP, ")
        SQL.ADD("Case when SUBSTRING(NrOperacion,1,1)='T' then (select CB4 from OPERACIONES O where O.NrOperacion=M.NrOperacion) else 0 end Bilateral, '1' Movi, ")
        SQL.ADD("(select TipoOp from OPERACIONES O where O.NrOperacion=M.NrOperacion) TipoOpx ")
        SQL.ADD(" from "~DBO~".MOVEJECUTADOS M ")
        SQL.ADD(" left join "~DBO~".TRANSACCIONES2 T on M.NrOperacion =T.NrTrans ")
        SQL.ADD(" left join "~DBO~".ESPECIES E on M.Especie=E.Codigo ")
        SQL.ADD(" where Cliente = '"~Dialogo.Cliente1~"' ")
        SQL.ADD("and NrSaldo = 1 ")
        SQL.ADD("and Mercado in ("~Pipe2Comillas(VAR('RESCTAMERM'))~") ")
        SQL.ADD("and FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD("and E.Jerarquia like '"~VAR('JERMONEDA')~"%' ")
        SQL.ADD(" union ")
        SQL.ADD("Select FechaMov,Mercado,M.Especie,NrMov,MonedaEmision,Cantidad,NrTrans2,isnull(T.ConceptoPago,'') Concepto,  ")
        SQL.ADD("       NrOperacion,Cantidad as SaldoFinal,")
        ** AA 8-05-2026  Pendiente se incorpora pegado a la leyenda
        **SQL.ADD("       Case when T.Observaciones like '%pr:%' then T.Observaciones+' - Pendiente' else M.Leyenda+' - Pendiente' end Leyenda, ")        
        SQL.ADD("       Case when T.Observaciones like '%pr:%' then T.Observaciones else M.Leyenda end Leyenda, ")        
        SQL.ADD("Case when SUBSTRING(NrOperacion,1,1)='T' then (select TipoOp from OPERACIONES O where O.NrOperacion=M.NrOperacion)  ")
        SQL.ADD("     when SUBSTRING(NrOperacion,1,2)='DD' then (select TipoOp from OPERACIONES O where O.NrOperacion=M.NrOperacion) else 'OTRO' end TipoOP, ")
        SQL.ADD("Case when SUBSTRING(NrOperacion,1,1)='T' then (select CB4 from OPERACIONES O where O.NrOperacion=M.NrOperacion) else 0 end Bilateral, '2' Movi, ")
        SQL.ADD("(select TipoOp from OPERACIONES O where O.NrOperacion=M.NrOperacion) TipoOpx ")
        SQL.ADD(" from "~DBO~".MOVPENDIENTES M ")
        SQL.ADD(" left join "~DBO~".TRANSACCIONES2 T on M.NrOperacion =T.NrTrans ")
        SQL.ADD(" left join "~DBO~".ESPECIES E on M.Especie=E.Codigo ")
        SQL.ADD(" where Cliente = '"~Dialogo.Cliente1~"' ")
        SQL.ADD("and NrSaldo = 1 ")
        SQL.ADD("and Mercado in ("~Pipe2Comillas(VAR('RESCTAMERM'))~") ")
        SQL.ADD("and FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' ")
        SQL.ADD("and E.Jerarquia like '"~VAR('JERMONEDA')~"%' ")
        SQL.ADD("order by 2,3,1,4,12,8 ")     
        **watch(sql.batch)
    ACN(fi11,fac)
    ACN(xy1,0)
    ACT(mo:1,'')
    
    Recorrer SQL
      if Val(xy1)=0
         ACT(a:fac,'MONEDAS')
         SetFont(a:fac, 3)
         ACN(fi11,fac)
         ifa
         ACT(a:fac,'Fecha Movimiento')
         ACT(b:fac,'Concepto')
         * ACT(c:fac,'Especie')
         ACT(d:fac,'Moneda')
         ACT(e:fac,'Cantidad')
         ACT(f:fac,'Nro.Op.')
         ACT(g:fac,'Saldo Final')

         SetFont(a:fac..g:fac, 2)      
         ACN(xy1,1)
         ACN(xy2,1)
         ifa
         
         ** AA 28-07-2023 corte por mercado especie  es STD
         **#ifdef BACS
             ACT(mo:1,FBN['Especie']~FBN['Mercado'])
             ACT(mo:2,FBN['Especie'])
             ACT(mo:3,FBN['Mercado'])
             SQL.ADD("select Sum(Saldo) Saldo from ")
             SQL.ADD("(select Saldo from "~DBO~".SALDOSDIA S ")
             SQL.ADD("   where S.Cuenta in (select Codigo from CUENTAS where Cliente='"~Dialogo.Cliente1~"' and TipoCuenta = 'VIS' /*and (Especies like '%"~FBN['Especie']~"%' or Especies like '%MONEDA%')*/) ")
             SQL.ADD("     and S.Cliente = '"~Dialogo.Cliente1~"'  ")
             SQL.ADD("     and S.NrSaldo = 81 ")
             SQL.ADD("     and S.Especie = '"~FBN['Especie']~"'")
             SQL.ADD("     and S.Mercado = '"~FBN['Mercado']~"'")
             SQL.ADD("     and S.Fecha = (SELECT MAX(S2.Fecha) ")
             SQL.ADD("                   FROM "~DBO~".SALDOSDIA S2 ")
             SQL.ADD("                   WHERE S2.Cliente = S.Cliente  AND ")
             SQL.ADD("                         S2.Especie = S.Especie  AND ")
             SQL.ADD("                         S2.EnteCustodia = S.EnteCustodia AND ")
             SQL.ADD("                         S2.Mercado = S.Mercado AND ")
             ** AA 07-09-2023  cambio solicitado PZ
             * SQL.ADD("                         S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' AND ")
             SQL.ADD("                         S2.Fecha < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
             SQL.ADD("                         S2.Cuenta  = S.Cuenta   AND ")
             SQL.ADD("                         S2.NrSaldo = S.NrSaldo) ")
             SQL.ADD(" ) AUX")    
            *watch(sql.batch)
         Recorrer SQL
           dfa
           ACN(sa:1,FBN['Saldo'])
         Proximo
            if EqStr(VAR('RESCTAMOVS'),'SI')
               ACT(b:fac,'Saldo Inicial - '~ BuscarCampo('MERCADOS','Descripcion','Codigo',FBN['Mercado']))
               ACT(d:fac,FBN['Especie']) 
               ACT(g:fac,PYC(val(sa:1), 0, 2))
            else   
               ACT(b:fac,BuscarCampo('MERCADOS','Descripcion','Codigo',FBN['Mercado']))
            endif
            if Val(mn:1)=0
               ACN(mm:1,1)
            else
               ACN(mm:1,val(mn:1))
            endif            
            Recorrer&i 1,Val(mm:1)
               if Not EqStr(Val(mo:1),Val(ma:&i)~Val(mb:&i))
                  SCN(mn:1,1)
                  ACT(ma:val(mn:1),Val(mo:2))
                  ACT(mb:val(mn:1),Val(mo:3))
                  ACT(mc:val(mn:1),val(sa:1))
                  break
               Else
                  ACT(mc:&i,val(sa:1))
                  break
               Endif
            Proximo
         ifa
      endif
      
        if Not EqStr(Val(mo:1),FBN['Especie']~FBN['Mercado'])
         ACT(mo:1,FBN['Especie']~FBN['Mercado'])
         ACT(mo:2,FBN['Especie'])
         ACT(mo:3,FBN['Mercado'])         
         ACN(mc:val(mn:1),val(sa:1))
         *#else
         *if Not EqStr(Val(mo:1),FBN['Especie'])
         *ACT(mo:1,FBN['Especie'])
         *#endif
         SQL.ADD("select Sum(Saldo) Saldo from ")
         SQL.ADD("(select Saldo from "~DBO~".SALDOSDIA S ")
         SQL.ADD("   where S.Cuenta in (select Codigo from CUENTAS where Cliente='"~Dialogo.Cliente1~"' and TipoCuenta = 'VIS' /*and (Especies like '%"~FBN['Especie']~"%' or Especies like '%MONEDA%')*/) ")
         SQL.ADD("     and S.Especie = '"~FBN['Especie']~"'")
         SQL.ADD("     and S.Cliente = '"~Dialogo.Cliente1~"' ")
         SQL.ADD("     and S.NrSaldo = 81 ")
         *#ifdef BACS
          SQL.ADD("    and S.Mercado = '"~FBN['Mercado']~"'")
          *#endif
         SQL.ADD("     and S.Fecha = (SELECT MAX(S2.Fecha) ")
         SQL.ADD("                   FROM "~DBO~".SALDOSDIA S2 ")
         SQL.ADD("                   WHERE S2.Cliente = S.Cliente  AND ")
         SQL.ADD("                         S2.Especie = S.Especie  AND ")
         SQL.ADD("                         S2.EnteCustodia = S.EnteCustodia AND ")
         SQL.ADD("                         S2.Mercado = S.Mercado AND ")
         ** AA 07-09-2023  cambio solicitado PZ
         *  SQL.ADD("                         S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' AND ")
         SQL.ADD("                         S2.Fecha < '"~IdxDate(Dialogo.Fecha1)~"' AND ")
         SQL.ADD("                         S2.Cuenta  = S.Cuenta   AND ")
         SQL.ADD("                         S2.NrSaldo = S.NrSaldo) ")
         SQL.ADD(" ) AUX")    
         *watch(sql.batch)   
         Recorrer SQL
           dfa
           ACN(sa:1,FBN['Saldo'])
         Proximo
         IFA
            if EqStr(VAR('RESCTAMOVS'),'SI')
               ACT(b:fac,'Saldo Inicial - '~ BuscarCampo('MERCADOS','Descripcion','Codigo',FBN['Mercado']))
               ACT(d:fac,FBN['Especie']) 
               ACT(g:fac,PYC(val(sa:1), 0, 2))
            else   
               ACT(b:fac,BuscarCampo('MERCADOS','Descripcion','Codigo',FBN['Mercado']))
            endif
            ACN(mm:1,val(mn:1))
            Recorrer&i 1,Val(mm:1)
               if Not EqStr(Val(mo:1),Val(ma:&i)~Val(mb:&i))
                  SCN(mn:1,1)
                  ACT(ma:val(mn:1),Val(mo:2))
                  ACT(mb:val(mn:1),Val(mo:3))
                  ACT(mc:val(mn:1),val(sa:1))
                  break
               Else
                  ACT(mc:&i,val(sa:1))
                  break
               Endif
            Proximo
         ifa
      Endif
      ACT(a:fac,FBN['FechaMov'])
      if Vacio(FBN['Concepto'])
      ** buscar si es VFONDOS %pr: %
         ACN(xx0,Posicion('Vis Fond',FBN['Leyenda'], 18))
         if Val(xx0) > 0
            ACT(b:fac,Copy(FBN['Leyenda'],1,Val(xx0)-1))
         else
            ACT(b:fac,FBN['Leyenda'])
         endif
           if EqStr(FBN['Movi'],'2')
              ACT(b:fac,TRIM(Val(b:fac))~' - Pendiente')
           endif   
      else
         ACT(b:fac, BuscarCampo('CNCONCEPTOSPAGOCOBRO','Descripcion','Codigo',FBN['Concepto']))
      endif
      ACN(xy101,FBN['Cantidad'])
      ACN(xy105,0)
      ** AA 10-11-2023  solo se cambian TIC/TIV y TCOPRI
      **if Not Incluido(FBN['TipoOp'], 'TIDE|TIPO|TICO|TICT|OTRO|')
      if Incluido(FBN['TipoOp'], 'TIC|TIV|TCOPRI|')
         ACN(xy105,SQL("select CB4 from OPERACIONES O where O.NrOperacion='"~FBN['NrOperacion']~"'"))
         ACN(xy101,FBN['Cantidad']*-1)
      Endif   
      IF Val(xy105)=0  y not Incluido(fbn('NrMov'), '11|12|13|14')
      
      If Incluido(FBN['TipoOp'], 'TIC|TIFC')
         ACT(b:FAC, 'Venta'~Copy(Val(b:FAC),Longitud('Compra')+1,Longitud(Val(b:FAC))) )
         if FBN['Bilateral']=0 y EqStr(FBN['TipoOp'], 'TIC')
            ACN(xy101,FBN['Cantidad'])
         endif         
      Endif
      If Incluido(FBN['TipoOp'], 'TIV|TIFV')
         ACT(b:FAC, 'Compra'~Copy(Val(b:FAC),Longitud('Venta')+1,Longitud(Val(b:FAC))) )
         if FBN['Bilateral']=0 y EqStr(FBN['TipoOp'], 'TIV')
            ACN(xy101,FBN['Cantidad'])
         endif
      Endif
      If Incluido(FBN['TipoOp'], 'OTRO')
         If EqStr(FBN['TipoOpx'], 'FXV')
            ACT(b:FAC, 'Compra'~Copy(Val(b:FAC),Longitud('Venta')+1,Longitud(Val(b:FAC))) )
         Else
            ACT(b:FAC, 'Venta'~Copy(Val(b:FAC),Longitud('Compra')+1,Longitud(Val(b:FAC))) )
         endif
      Endif      
      If Incluido(FBN['TipoOp'], 'TICT|')
         ACN(xy100, Posicion('Tomado',Val(b:fac), 1, Longitud(Val(b:fac))) -1)
         ACT(xy102, Copy(val(b:fac),1,val(xy100))~'Otorgado '~Copy(val(b:fac),8+Val(xy100),Longitud(Val(b:fac))))
         ACT(b:FAC, Val(xy102))
         **ACN(xy101,FBN['Cantidad']*-1)
      Endif
      If Incluido(FBN['TipoOp'], 'TICO|')
         ACN(xy100, Posicion('Otorgado',Val(b:fac), 1, Longitud(Val(b:fac))) -1)
         ACT(xy102, Copy(val(b:fac),1,val(xy100))~'Tomado '~Copy(val(b:fac),10+Val(xy100),Longitud(Val(b:fac))))
         ACT(b:FAC, Val(xy102))
         **ACN(xy101,FBN['Cantidad']*-1)
      Endif
      If Incluido(FBN['TipoOp'], 'TIPO|')
         ACN(xy100, Posicion('Otorgado',Val(b:fac), 1, Longitud(Val(b:fac))) -1)
         ACT(xy102, Copy(val(b:fac),1,val(xy100))~''~Copy(val(b:fac),10+Val(xy100),Longitud(Val(b:fac))))
         ACT(b:FAC, Val(xy102))
         **ACN(xy101,FBN['Cantidad']*-1)
      Endif
      If Incluido(FBN['TipoOp'], 'DDC|DDV')
      If EqStr(FBN['TipoOp'], 'DDC')
            ACT(b:FAC, Val(b:FAC) )
         Else
            ACT(b:FAC, Val(b:FAC) )
         endif
      Endif            
      ENDIF   
      *ACT(c:fac,FBN['Especie']) 
      ACT(d:fac,FBN['MonedaEmision'])
      ACT(e:fac,PYC(Val(xy101), 0, 2))
      ACT(f:fac, FBN['NrOperacion'])
      ACN(sa:1,val(sa:1)+Val(xy101))
      ACT(g:fac,PYC(val(sa:1), 0, 2))
    Proximo
    ** Ultimo saldo
    ACN(mm:1,val(mn:1))
    Recorrer&i 1,Val(mm:1)
       if Not EqStr(Val(mo:1),Val(ma:&i)~Val(mb:&i))
          SCN(mn:1,1)
          ACT(ma:val(mn:1),Val(mo:2))
          ACT(mb:val(mn:1),Val(mo:3))
          ACT(mc:val(mn:1),val(sa:1))
          break
       Else
          ACT(mc:&i,val(sa:1))
          break
       Endif
    Proximo
    
#endif

if  val(xy2)= 0
    ifa
    ACT(ab3,'Sin Movimientos para el Periodo')
    ACN(xy2,0)
endif
    
ACN(fi12,fac)


** Posicion Final Tabla6
