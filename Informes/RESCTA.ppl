   ACT(g:fac,PYC(FBN['Precio1'], 0, 5))
   ACT(h:fac, FBN['NrOperacion'])
   ACT(i:fac,PYC(FBN['SaldoFinal'], 0, 2))
   endif
   
   ACT(a:fac,FBN['FechaOp'])
   ACT(b:fac,FBN['FechaVto'])
   ACT(c:fac,FBN['TipoOper']) 
   ACT(d:fac,FBN['Especie'])
