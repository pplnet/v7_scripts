      ACT(e:fac,'V.N.')
      ACT(f:fac,'Precio')
      ACT(g:fac,'Valor ARP')
      ACT(h:fac,'Valor USD')
      SetFont(a:fac..h:fac, 2)      
      ACN(xy1,1)
      ACN(xy10,1)
      ifa
   endif
   
   ACT(a:fac,FBN['Especie'])
   ACT(b:fac,FBN['Nombre'])
   ACT(c:fac,FBN['Mercado']) 
   ACT(d:fac,FBN['DescEst']) 
   ACT(e:fac,PYC(FBN['VN'], 0, 2))
   *ACT(e:fac,PYC(FBN['PrecioARP'], 0, 5))
   ACT(f:fac,PYC(FBN['PrecioARP'], 0, 8))
   ACT(g:fac,PYC((FBN['VN']*FBN['PrecioARP']), 0, 2))
   ACT(h:fac,PYC((FBN['VN']*FBN['PrecioARP'])/Val(co2), 0, 2))
   
