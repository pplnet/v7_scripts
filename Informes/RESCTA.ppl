   endif
   
      if Not EqStr(Val(es:1),FBN['Especie']~FBN['Mercado'])
         ACN(sa:1,0)
         ACT(es:1,FBN['Especie']~FBN['Mercado'])
         IFA
         recorrer&i 1,Val(xy3)
           if Eqstr(Val(es:1),val(ea:&i)~val(ec:&i))
              ACN(sa:1,val(eb:&i)) 
              Break
           endif
