         ACT(i:fac,'IVA Comisiones')
         ACT(j:fac,'Derechos')
         ACT(k:fac,'IVA Derechos')
         ACT(l:fac,'Nro.Op.')      
         ACT(m:fac,'Saldo Final') 
      
      
      SetFont(a:fac..1:fac, 2)      
