      ACT(e:fac,FBN['ContraEspecie'])
      ACT(f:fac,PYC(ABS(FBN['Cantidad']), 0, 2))
      ACT(g:fac,PYC(ABS(FBN['Precio1']), 0, 6))
      ACT(h:fac,PYC(ABS(FBN['TotalBrutoCli1']), 0, 2))
      ACT(i:fac,PYC(ABS(FBN['Comision']), 0, 2))
      ACT(j:fac,PYC(ABS(FBN['TotalIVA']), 0, 2))
      ACT(k:fac,PYC(ABS(FBN['TotalGastos']), 0, 2))
      ACT(l:fac,PYC(ABS(FBN['TotalIvaAdi']), 0, 2))      
      ACT(m:fac,PYC(ABS(FBN['TotalNetoCli1']), 0, 2))
      ACT(n:fac, FBN['NrOperacion'])
      if Incluido(FBN['TipoOper'],'Compra|Deposito|Vto Plazo Fijo Tit.|Dividendos|Call Tomado|Compra Col.Primaria')
         ACN(sa:1,val(sa:1)+ABS(FBN['Cantidad']))
      Else
         if Incluido(FBN['TipoOper'],'Venta|Retiro|Call Otorgado|Vto Call Tomado|Vto Prestamo|Plazo Fijo Tit.')
            ACN(sa:1,val(sa:1)-ABS(FBN['Cantidad']))
         Else
           **  Falta definir  Split Canje y Transferencia
           ACN(sa:1,val(sa:1)+ABS(FBN['Cantidad']))
         Endif
      Endif   
      ACT(o:fac,PYC(val(sa:1), 0, 2))
    #endif
    ACN(fi8,fac)
Proximo
