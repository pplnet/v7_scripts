      ACT(i:fac,PYC(ABS(FBN['TotalBrutoCli1']), 0, 2))
      ACT(j:fac,PYC(ABS(FBN['Intereses']), 0, 2))
      ACT(k:fac,PYC(ABS(FBN['Comision']), 0, 2))
      ACT(l:fac,PYC(ABS(FBN['TotalIVA']), 0, 2))
      ACT(m:fac,PYC(ABS(FBN['TotalNetoCli1']), 0, 2))
      ACT(n:fac, FBN['NrOperacion'])
      if Incluido(FBN['TipoOper'],'Compra|Vto Deposito|Dividendos|Call Tomado|Compra Col.Primaria')
         ACN(sa:1,val(sa:1)+ABS(FBN['Cantidad']))
      Else
      if Incluido(FBN['TipoOper'],'Venta|Retiro|Call Otorgado|Vto Call Tomado|Vto Prestamo|Deposito')
           ACN(sa:1,val(sa:1)-ABS(FBN['Cantidad']))
