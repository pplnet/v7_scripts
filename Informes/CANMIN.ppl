*proximo
if Val(x1)>0
  recorrer&i 1,Val(x1)
   ACT(26+&i:1, Val(y:10+&i))
 proximo
  BorrarCeldas(y:11..y:10+Val(x1))
endif

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Cantidad de Minutas por Tipo')
ACT(a:FAC+1, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Fecha Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+3, 'Vehiculo : '~Dialogo.Vehiculo1)
else
  ACT(a:FAC+3, 'Vehiculo : Todos')
endif
ACT(a:FAC+6, '# Operacion')
ACT(b:FAC+6, 'Tipo Op.')
ACT(c:FAC+6, 'Fecha Op.')
ACT(d:FAC+6, 'Fecha Vto.')
ACT(e:FAC+6, 'Entidad')
ACT(f:FAC+6, 'Especie')
ACT(g:FAC+6, 'Cantidad')
ACT(h:FAC+6, 'Precio/Tasa')
ACT(i:FAC+6, ' Observaciones')
AlinearCeldas(c:FAC+6..d:FAC+6,'D')
AlinearCeldas(g:FAC+6..h:FAC+6,'D')
SetFont(a:FAC..i:FAC+6,2)
AgregarMarco(a:FAC+6..i:FAC+6, 2,0,Exe('COLOR'))

SetFilaActual(FAC+6)
if Val(x1)>0
  recorrer&i 1,Val(x1)
    ACN(y1,0)
    ACN(y2,0)
    ACN(z2,0)
    ACN(w2,FAC+1)

     SQL.ADD("Select * From "~DBO~".OPERACIONES where FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
     SQL.ADD(" and Substring(NrOperacion,1,1) = '"~Val(26+&i:1)~"' ")
     if NoVacio(Dialogo.Vehiculo1)
       SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
     endif
     SQL.ADD(" order by NrOperacion")
     recorrer SQL
      SCN(z1,1)
      SCN(z2,1)
      ACT(a:FAC, FBN['NrOperacion'])
      ACLO(a:fac, fbn('NrOperacion'))
      ACT(b:FAC, FBN['TipoOp'])
      if Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV') y FBN['PaseCB']=1
       ACT(b:FAC, Val(b:FAC)~' Pase')
      endif
      ACD(c:FAC, FBN['FechaOp'])
      if FBN['FechaVto'] = NoFecha
        ACD(d:FAC, FBN['FechaPago'])
      else
        ACD(d:FAC, FBN['FechaVto'])
      endif
      ACT(e:FAC, FBN['Cliente1'])
      ACT(f:FAC, FBN['Especie'])
      ACN(g:FAC, FBN['Cantidad'])
      if Incluido(FBN['TipoOp'],'TIPA|TIPP')
        ACN(h:FAC, FBN['Precio3'])
      else
        ACN(h:FAC, FBN['Precio1'])
      endif

    proximo

*    recorrer LogFile, 102, Val(26+&i:1)
*      SCN(z1,1)
*      SCN(z2,1)
*      ACT(a:FAC, LogFile.NrOperacion)
*      ACT(b:FAC, LogFile.TipoOp)
*      if Incluido(LogFile.TipoOp,'TIC|TIV|TIFC|TIFV') y NoVacio(LogFile.Operacionref)
*        ACT(b:FAC, Val(b:FAC)~' Pase')
*      endif
*      ACN(c:FAC, LogFile.FechaOp)
*      if LogFile.FechaVto = NoFecha
*        ACN(d:FAC, LogFile.FechaPago)
*      else
*        ACN(d:FAC, LogFile.FechaVto)
*     endif
*      ACT(e:FAC, LogFile.Cliente1)
*      ACT(f:FAC, LogFile.Especie)
*      ACN(g:FAC, LogFile.Cantidad)
*      if Incluido(LogFile.TipoOp,'TIPA|TIPP')
*        ACN(h:FAC, LogFile.Precio3)
*      else
*        ACN(h:FAC, LogFile.Precio1)
*     endif
*      ACT(i:FAC, ' Anulada')
*    proximo

    ACN(w3,FAC)
    SetFont(a:Val(w2)..i:FAC,1)
    SetFilaActual(FAC+2)
    ACT(a:FAC,'Cant. Minutas: '~Fstr(Val(z2),1,0))
    SetFont(a:FAC,2)
    IFA
    if Val(w3)>Val(w2)
      ACN(26+&i:2, Num(Copy(Val(a:Val(w2)),2,7))+1)
      recorrer&j Val(w2)+1,Val(w3)
        ACN(26+&i:3, Num(Copy(Val(a:&j),2,7)))
        if Val(26+&i:2)=Val(26+&i:3)
          SCN(26+&i:2,1)
        else
          recorrer&k Val(26+&i:2),Val(26+&i:3)-1
            if Val(y1)=0
              IFA
              ACT(a:FAC, 'Operaciones Faltantes:')
              SetFont(a:FAC,2)
              IFA
            endif
            SCN(y1,1)
            SCN(y2,1)
            if Val(y2)>8
              SetFont(a:FAC,1)
              ACN(y2,1)
              IFA
            endif
            if Val(y2)>1
              ACT(a:FAC, Val(a:FAC)~' - ')
            endif
            ACT(a:FAC, Val(a:FAC)~Val(26+&i:1)~Pad0(FStr(&k,1,0),7))
          proximo
          ACN(26+&i:2, Val(26+&i:3)+1)
        endif
      proximo
      if Val(y1)>0
        SetFont(a:FAC,1)
        IFA
      endif
    endif
  proximo
endif

ACT(a:Val(w1)+4,'Cant. Minutas: '~Fstr(Val(z1),1,0))

SetFont(a:Val(w1)+4,2)

FormatoCeldas(g:Val(w1)+6..g:FAC,Exe('F2'))
FormatoCeldas(h:Val(w1)+6..h:FAC,Exe('F6'))

SetFont(w1..26+Val(x1):4,1)

ACO(1,7)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,8)
ACO(6,6)
ACO(8,8)
ACO(9,12)

IFA
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:FAC, 2)
LimitesVision(j:FAC)

CrearFont(6,"Arial,6,B")
RangoTitulo(a:Val(w1)+6..j:FAC, 3)
Impresion(1, 2)
