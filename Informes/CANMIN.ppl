ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'F.Desde'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO; FSys
  Fecha2   : 'F.Hasta'  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO; FSys
  Vehiculo1: 'Vehiculo' ;;;;;;;;NO;VAR('VEHICULODE')
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

*CrearClave(101)
ACN(x1, 0)

SQL.ADD("Select * From "~DBO~".OPERACIONES where")
SQL.ADD("FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" order by NrOperacion ")
recorrer SQL
  if Val(x1)>0
    ACN(x2,0)
    recorrer&i 1,Val(x1)
      if EqStr(Copy(FBN['NrOperacion'],1,1),Val(y:10+&i))
        ACN(x2,&i)
        Break
      endif
    proximo
    if Val(x2)=0
      SCN(x1,1)
      ACT(y:10+Val(x1), Copy(FBN['NrOperacion'],1,1))
    endif
  else
    ACN(x1,1)
    ACT(y:10+Val(x1), Copy(FBN['NrOperacion'],1,1))
  endif
proximo

