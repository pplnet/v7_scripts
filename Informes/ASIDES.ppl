MostrarCuadrodeMensajes
CrearDialogo
 Fecha1  :'D.F.Gener.'    ;;;;;;;;;FSYS
 Fecha2  :'H.F.Gener.'    ;;;;;;;;;Fsys
 NrUnicoAsiento1 : 'Asiento'  ;;;;;;;;;
 Lista1: 'Operacion'     ;;;;NO;NO;
 Lista2: 'Transaccion'   ;;;;NO;NO;
FinDialogo

If Not Ok
  Cancelar
Endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,12,B')
CrearFont(4, 'Arial,8,BI')

***encabezado
AgregarBMP(a1,Exe('LOGO'))
 
ACT(a:2, 'Asientos con errores' )
ACT(a:3, 'Desde Fecha Generacion: '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
ACT(a:4, 'Tipos de Asientos   : '~IIF(NoVacio(Dialogo.Lista1),Pipe2Coma(Copy(Dialogo.Lista1,1,Longitud(Dialogo.Lista1)-1)) ,'Todos'))
ACT(a:5, 'Tipos de Operaciones: '~IIF(NoVacio(Dialogo.Lista2),Pipe2Coma(Copy(Dialogo.Lista2,1,Longitud(Dialogo.Lista2)-1)) ,'Todas'))
SetFont(a:2, 3)
SetFont(a:3..f:5, 2)
ACT(a:6,'NrUnicoAsiento')
ACT(b:6, 'Cantidad1')
ACT(c:6, 'Cantidad2')
ACT(d:6, 'Cantidad3')
ACT(e:6, 'Especie1')
ACT(f:6, 'Debito/Credito')
ACT(g:6, 'Cuenta')
ACT(h:6, 'Cantidad1')
ACT(i:6, 'Cantidad2')
ACT(j:6, 'Cantidad3')
ACT(k:6, 'Especie1')
ACT(l:6, 'Debito/Credito')
ACT(m:6, 'Cuenta')
ACT(n:6, 'Motivo')
ACT(o:6, 'Modelo')
ACT(p:6, 'Nro Operacion')
ACT(q:6, 'Nro Transaccion')
ACT(ar:6, 'Tipo')

AgregarMarco(a:6..q:6,0,0,EXE('COLOR6'))
SetFilaActual(6)
SetFont(a:6..q:6, 2)

SQL.ADD(" SELECT A.NrUnicoAsiento, A1.Especie1, '' Cuenta, SUM(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, ")
SQL.ADD(" Sum(A1.Cantidad3) Cantidad3, A1.DebitoCredito,A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion DesModelo, 'IMP' Tipo ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1,  ")
SQL.ADD("      "~DBO~".MODELOSASIENTO M ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
SQL.ADD("   and A.Modelo=M.Codigo ") 

IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
IF Vacio(Dialogo.Lista1) Y Vacio(Dialogo.Lista2)
   SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
   SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and A1.DebitoCredito = 'DEB' ")

IF NoVacio(Dialogo.NrUnicoAsiento1)
   SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" group by A.NrUnicoAsiento, A1.Especie1, A1.DebitoCredito, A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion")
SQL.ADD(" UNION ")

SQL.ADD(" SELECT A.NrUnicoAsiento, A1.Especie1, '' Cuenta, SUM(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, ")
SQL.ADD(" Sum(A1.Cantidad3) Cantidad3, A1.DebitoCredito,A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion DesModelo, 'IMP' Tipo ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1,  ")
SQL.ADD("      "~DBO~".MODELOSASIENTO M ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
SQL.ADD("   and A.Modelo = M.Codigo ") 
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
IF Vacio(Dialogo.Lista1) Y Vacio(Dialogo.Lista2)
   SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
   SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and A1.DebitoCredito = 'CRE' ")

IF NoVacio(Dialogo.NrUnicoAsiento1)
   SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" group by A.NrUnicoAsiento, A1.Especie1, A1.DebitoCredito, A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT A.NrUnicoAsiento, A1.Especie1, A1.Cuenta, SUM(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, ")
SQL.ADD(" Sum(A1.Cantidad3) Cantidad3, A1.DebitoCredito,A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion DesModelo, 'CTA' Tipo ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1,  ")
SQL.ADD("      "~DBO~".MODELOSASIENTO M ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
SQL.ADD("   and A.Modelo=M.Codigo ") 
SQL.ADD("   and A1.Cuenta is Null ") 

IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
IF Vacio(Dialogo.Lista1) Y Vacio(Dialogo.Lista2)
   SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
   SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and A1.DebitoCredito = 'DEB' ")

IF NoVacio(Dialogo.NrUnicoAsiento1)
   SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" group by A.NrUnicoAsiento, A1.Especie1, A1.DebitoCredito, a1.cuenta ,A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion")
SQL.ADD(" UNION ")

SQL.ADD(" SELECT A.NrUnicoAsiento, A1.Especie1, A1.Cuenta, SUM(A1.Cantidad1) Cantidad1, Sum(A1.Cantidad2) Cantidad2, ")
SQL.ADD(" Sum(A1.Cantidad3) Cantidad3, A1.DebitoCredito,A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion DesModelo, 'CTA' Tipo ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1,  ")
SQL.ADD("      "~DBO~".MODELOSASIENTO M ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ") 
SQL.ADD("   and A.Modelo = M.Codigo ") 
SQL.ADD("   and A1.Cuenta is Null ") 

IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND A.NrOperacion IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND A.NrTrans2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
IF Vacio(Dialogo.Lista1) Y Vacio(Dialogo.Lista2)
   SQL.ADD("   and A.Fecha1 >= "~IdxDate2(Dialogo.Fecha1) )
   SQL.ADD("   and A.Fecha1 <= "~IdxDate2(Dialogo.Fecha2) )
ENDIF
SQL.ADD("   and A1.DebitoCredito = 'CRE' ")

IF NoVacio(Dialogo.NrUnicoAsiento1)
   SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
ENDIF
SQL.ADD(" group by A.NrUnicoAsiento, A1.Especie1, A1.DebitoCredito, a1.cuenta, A.Modelo,A.NrOperacion,A.NrTrans2, M.Descripcion ")


* Asiento , Especie
SQL.ADD(" order by 1,2 ")
watch(SQL.BATCH())
* Asiento anterior
ACT(aa:1,'')
* Primera vuelta
acn(ab:1,0)
* Hay mensajes de error
acn(ac:1,0)
Recorrer SQL

    If val(ab:1) = 1 
        If Eqstr(fbn('NrUnicoAsiento')~fbn('Especie1'),Val(aa:1))
           dfa
        Else
           acn(ac:1,0)
           if Round(val(b:fac-1),2) <> Round(val(h:fac-1),2) o Round(val(c:fac-1),2) <> Round(val(i:fac-1),2) o Round(val(d:fac-1),2) <> Round(val(j:fac-1),2)       
              Message('El asiento '~Val(aa:1)~' no balancea.')
              ACT(n:fac-1, 'Desbalanceado')
              acn(ac:1,1)
           endif
           if [vacio(val(g:fac-1)) o vacio(val(m:fac-1))] y Eqstr(val(ar:fac-1),'CTA')
              Message('Cuenta inexistente')
              ACT(n:fac-1, val(n:fac-1)~' '~'Cuenta inexistente')
              acn(ac:1,1)
           endif
           if vacio(val(e:fac-1)) o vacio(val(k:fac-1))
           Message('Especie no coincide')
           ACT(n:fac-1,  val(n:fac-1)~' '~'Especie no coincide')
               acn(ac:1,1)
           endif
           if val(ac:1)=0
              dfa
              BorrarCeldas(a:fac..n:fac)
           endif
        endif   
    Endif   
    
    ACT(a:fac, fbn('NrUnicoAsiento'))
    IF  Eqstr(fbn('DebitoCredito'),'DEB')
        ACN(b:fac, NUM(FSTR(fbn('Cantidad1'),0,8)))
        ACN(c:fac, NUM(FSTR(fbn('Cantidad2'),0,8)))
        ACN(d:fac, NUM(FSTR(fbn('Cantidad3'),0,8)))
        ACT(e:fac, fbn('Especie1'))
        ACT(f:fac, fbn('DebitoCredito'))
        ACT(g:fac, fbn('Cuenta'))
    Else
        ACN(h:fac, NUM(FSTR(fbn('Cantidad1'),0,8)))
        ACN(i:fac, NUM(FSTR(fbn('Cantidad2'),0,8)))
        ACN(j:fac, NUM(FSTR(fbn('Cantidad3'),0,8)))
        ACT(k:fac, fbn('Especie1'))
        ACT(l:fac, fbn('DebitoCredito'))
        ACT(m:fac, fbn('Cuenta'))
    Endif
    ACT(o:fac, fbn('Modelo')~' '~FBN('DesModelo'))
    ACT(p:fac, fbn('NrOperacion'))
    if Novacio(fbn('NrOperacion'))
        ACLO(p:fac, fbn('NrOperacion'))
    endif
    ACT(q:fac, fbn('NrTrans2'))
    if Eqstr(fbn('Tipo'),'CTA')
       ACT(ar:fac, fbn('Tipo'))
    endif
    if Novacio(fbn('NrTrans2'))
        ACLT(q:fac, fbn('NrTrans2')) 
    endif
    ACT(aa:1, fbn('NrUnicoAsiento')~fbn('Especie1'))
    ACN(ab:1,1)
 
Proximo
acn(ac:1,0)
if Round(val(b:fac),2) <> Round(val(h:fac),2) o Round(val(c:fac),2) <> Round(val(i:fac),2) o Round(val(d:fac),2) <> Round(val(j:fac),2)       
  Message('El asiento '~Val(aa:1)~' no balancea.')
  ACT(n:fac, 'Desbalanceado')
  acn(ac:1,1)
endif
if [vacio(val(g:fac)) o vacio(val(m:fac))] y Eqstr(val(ar:fac),'CTA')
  Message('Cuenta inexistente')
  ACT(n:fac, val(n:fac)~' '~'Cuenta inexistente')
  acn(ac:1,1)
endif
if vacio(val(e:fac)) o vacio(val(k:fac))
   Message('Especie no coincide')
   ACT(n:fac,  val(n:fac)~' '~'Especie no coincide')
   acn(ac:1,1)
endif


acn(az:1,fac)
if val(ac:1)=0
   BorrarCeldas(a:fac..Q:fac)
endif
