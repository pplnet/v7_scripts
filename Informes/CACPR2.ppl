ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")

ACT(ml:99, var('MONELOCA'))
ACT(me:99, var('MONEEXTR'))

SQL.ADD("Select TipoOp, Cliente1, Cantidad, Especie, Cuenta1, Vehiculo1, FechaOp, FechaVto, Precio1, Plazo ")
SQL.ADD("From "~DBO~".OPERACIONES  where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Especie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACN(zd:98, fbn['Cantidad'])
   ACT(ze:99, fbn['Cuenta1'])
   ACT(zf:99, fbn['Vehiculo1'])
   ACD(zg:99, fbn['FechaOp'])
   ACD(zh:99, fbn['FechaVto'])
   ACN(zi:99, fbn['Plazo'])
   ACT(zj:99, fbn['Precio1'])
Proximo

If Not Incluido(val(za:99), 'MMPCL|MMPCLM|MMPCOS|MMPOSM|MMFCMV|MMFRN|MMPE|MMPEM|MMPI|MMPIM|MMPSC|MMSCMV|MMON|MMONM|')
    Cancelar
Endif


*If EqStr(val(zc:99),val(ml:99))
*    act(mo:99, 'Pesos')
*else
*    act(mo:99, 'Dolares')
*Endif
ACT(mo:99, BuscarCampo('ESPECIES','Nombre','Codigo',val(zc:99)))

If EqStr(val(zc:99),val(ml:99))
    act(ms:99, '$')
else
    If EqStr(val(zc:99),val(me:99))
       act(ms:99, 'u$s')
    Else
       act(ms:99, Val(zc:99)~' ')
    Endif
Endif

SetFilaActual(10)
ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zg:99)),1,0)~' de '~Meses(Mes(val(zg:99)))~' de '~FStr(Anio(val(zg:99)),4,0)~'.')

SetFilaActual(fac+3)
ACT(a:fac,'Señores:')
SetFont(a:10..a:fac,1)

SetFilaActual(fac+1)
ACT(a:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)))
SetFont(a:fac,2)

SetFilaActual(fac+1)
ACT(a:fac,'Presente.')
SetFont(a:fac,3)

SetFilaActual(fac+3)
acn(zz:99,fac)
ACT(a:fac,'De nuestra consideraci'~Chr(243)~'n:')
SetFilaActual(fac+2)


If Eqstr(val(za:99), 'MMFCMV') o Eqstr(val(za:99), 'MMFRN')
   ACT(PX:99, 'un Floating rate note (FRN)')
Else
   If Eqstr(val(za:99), 'MMPE') o Eqstr(val(za:99), 'MMPEM')  
      ACT(PX:99, 'una Prefinanciaci'~Chr(243)~'n de exportaciones')
   Else   
      If Eqstr(val(za:99), 'MMPI') o Eqstr(val(za:99), 'MMPIM')  
         ACT(PX:99, 'una PostFinanciaci'~Chr(243)~'n de importaciones')
      Else
         If Eqstr(val(za:99), 'MMPSC') o Eqstr(val(za:99), 'MMSCMV')  
            ACT(PX:99, 'un Pr'~Chr(233)~'stamo sindicado')
         Else
            If Eqstr(val(za:99), 'MMON') o Eqstr(val(za:99), 'MMONM')  
               ACT(PX:99, 'una Obligaci'~Chr(243)~'n negociable')
            Else
               If Incluido(val(za:99),'MMPCL|MMPCLM|MMPCOS|MMPOSM|')
                  ACT(PX:99, 'un pr'~Chr(233)~'stamo financiero')
               EndIf
            EndIf
         EndIf
      EndIf
   EndIf
EndIf


If Incluido(val(za:99),'MMPCL|MMPCOS|MMFRN|MMPE|MMPI|MMPSC|MMON|')

   ACT(TX:1,'Por medio de la presente, confirmamos a Uds. haberles tomado '~Val(PX:99)~' por la suma de '~IIF(EqStr(val(zc:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zc:99),val(me:99)),val(ms:99),val(zc:99) ) )~' '~val(zd:99)~' ('~val(mo:99)~': '~Letras(val(zd:98),0,100)~') con fecha de inicio '~FStr(Dia(val(zg:99)),1,0)~' de '~Meses(Mes(val(zg:99)))~' de '~FStr(Anio(val(zg:99)),4,0)~' por '~Fstr(val(zi:99), 0, 0)~' d'~Chr(237)~'as, cuyo vencimiento se producir'~Chr(225)~' el '~FStr(Dia(val(zh:99)),1,0)~' de '~Meses(Mes(val(zh:99)))~' de '~FStr(Anio(val(zh:99)),4,0)~' a una T.N.A. de '~val(zj:99) ~'%. ')
   ACN(CR:1, 80)
   (.'LINEAS'.)
**--   Forma de usar a esta funcion desde donde se la llame
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo

   SetFilaActual(fac+2)

   ACT(TX:1,'Con los '~val(mo:99)~' a nuestra disposici'~Chr(243)~'n en vuestro Banco por la suma de '~val(ms:99)~' '~val(zd:99)~' solicitamos a Uds. acreditarlo en nuestra cuenta corriente en '~val(mo:99)~' en vuestro Banco, Cuenta Nro. '~BuscarCampo('CUENTAS','Numero','Codigo',val(ze:99))~'. ')
   ACN(CR:1, 80)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo
Else
   ACT(TS:1, Fstr(SQL(" Select Precio2 From "~DBO~".CUOTAS Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND NrCuota = 1 "), 0, 2))

   ACT(TX:1,'Por medio de la presente, confirmamos a Uds. haberles tomado '~Val(PX:99)~' por la suma de '~IIF(EqStr(val(zc:99),val(ml:99)),val(ms:99),IIF(EqStr(val(zc:99),val(me:99)),val(ms:99),val(zc:99) ) )~' '~val(zd:99)~' ('~val(mo:99)~': '~Letras(val(zd:98),0,100)~') con fecha de inicio '~FStr(Dia(val(zg:99)),1,0)~' de '~Meses(Mes(val(zg:99)))~' de '~FStr(Anio(val(zg:99)),4,0)~' por '~Fstr(val(zi:99), 0, 0)~' d'~Chr(237)~'as, a una T.N.A. de '~val(ts:1)~'% para el primer per'~Chr(237)~'odo cuyo vencimiento se producir'~Chr(225)~' seg'~Chr(250)~'n el siguiente cronograma ')
   ACN(CR:1, 80)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo
   

   SetFilaActual(fac+1)
   If Eqstr(val(za:99), 'MMONM')
      ACT(MT:99, 'Cantidad4')
   Else
      ACT(MT:99, 'Cantidad1')
   Endif
   SQL.ADD(" Select Fecha2, "~Val(MT:99)~" From "~DBO~".CUOTAS Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
   Recorrer SQL
      ACD(a:fac, FBN['Fecha2'])
      ACT(c:fac, val(ms:99)~FBN[Val(MT:99)])
   Proximo

   SetFilaActual(fac+2)

   ACT(TX:1,'Con los '~val(mo:99)~' a nuestra disposici'~Chr(243)~'n en vuestro Banco por la suma de '~val(ms:99)~' '~val(zd:99)~' solicitamos a Uds. acreditarlo en nuestra cuenta corriente en '~val(mo:99)~' en vuestro Banco, Cuenta Nro. '~BuscarCampo('CUENTAS','Numero','Codigo',val(ze:99))~'. ')
   ACN(CR:1, 80)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo
EndIf

SetFilaActual(fac+3)
ACT(a:Fac,'Sin otro particular, lo saludamos a Uds. muy atte.')
SetFont(a:val(zz:99)..a:fac,1)

*-SetFilaActual(fac+3)
*-ACT(d:Fac,'            '~val(zf:99) )
*-SetFont(d:fac,2)

*-SetFilaActual(fac+3)
*-ACT(d:Fac,'APODERADO')
*-ACT(f:Fac,'       '~'APODERADO')
*-SetFont(d:fac..f:fac,4)

AgregarBMP(a:3,Var('PATHLOGO')~val(zf:99)~'.bmp',80)  
Impresion(2, 0) 
Impresion(3, 0)

SetMargins(3, 0, 0, 0)

LimitesVision(m:FAC+1)