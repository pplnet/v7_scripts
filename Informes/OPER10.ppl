        ACT(l:fac, 'Monto')
        ACT(m:fac, 'Monto Total')     
        AgregarMarco(a:fac..m:fac,2,0,0)
        SetFont(a:fac-1..m:fac+1,2)
        AlinearCeldas(b:fac..m:fac,'D')
        ifa
        ACN(fa1, fac)
     ENDIF
      
     IF Incluido(fbn('TipoOp'), 'MMCPM|MMCPMG|MMPLME|MMCDIA|MMFCMV|MMFIMV|MMONM|MMPOCM|MMPCCM|MMPCLM|MMSELN|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSCMV|MMSIMV|MMDCA|MMCCR|MMCP') o Incluido(fbn('TipoOp'), 'MMCDP|MMD|MMFRN|MMFRNP|MMO|MMON|MMPCCV|MMPCL|MMPCOS|MMPE|MMPI|MMPSC|MMPSI') o Incluido(fbn('TipoOp'), 'FXCT|FXCTV|FXVT|FXVTV') o Incluido(fbn('TipoOp'), 'VIMIND|VIMINM|TEMIND|TEMINM')  o Incluido(fbn('TipoOp'), 'FXAS|FXASV|FXAT|FXATV')
                      
        IF Incluido(fbn('TipoOp'), 'MMCDIA|MMFIMV|MMONM|MMPOCM|MMPCCM|MMPCLM|MMSELN|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSIMV|')
           *-- Descuento los totales de items : MMFCMV, MMSIMV 
                      
           ACT(a:fac, fbn('TipoOp'))
           ACN(b:fac, LINKH(Val(ba1),bj:1))
           ACN(e:fac, LINKH(Val(ba1),bk:1))
           ACN(h:fac, LINKH(Val(ba1),bo:1))
