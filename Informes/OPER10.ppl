CrearDialogo
   Fecha1     : "Fecha"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
   Vehiculo2  : "Grupo"      ;;;;Vacio(Dialogo.Lista1);;Not EsTerminal(Dialogo.Vehiculo2, Vehiculos);'Debe ingresar un Grupo';NO;;;;;;"TipoVehiculo <> 'DIV'";
   Lista1     : "Vehiculo"   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   Lista2     : "Tipo Op."   ;;;;;;;;;;;SQLSET("Select Codigo from "~DBO~".TIPOSOPERACION  ")
FinDialogo

If Not Ok
   Cancelar
Endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf


SQL.ADD("SELECT Distinct O.Vehiculo1, O.TipoOp ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O ")
SQL.ADD("WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and (  ((O.TipoOp NOT LIKE 'DP%' OR O.TipoOp NOT LIKE 'DT%') AND (O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' OR O.FechaVto2 > '"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD("       OR (O.TipoOp IN ('DPBOS','DPFW','DPOGS','DPOS') AND O.FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' ) ")       
SQL.ADD("       OR (O.TipoOp LIKE 'DT%' AND O.TipoOp NOT IN ('DTO','DTOV') AND O.FechaEj > '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("       OR (O.TipoOp LIKE 'MR%' AND O.FechaEx4 > '"~IdxDate(Dialogo.Fecha1)~"')) ")
If NoVacio(VAL(zz6))
   SQL.ADD("    and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Endif
If NOVACIO(Dialogo.Lista2)
   SQL.ADD("    and O.TipoOp    In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD("UNION ")
SQL.ADD("SELECT Distinct O.Vehiculo1, O.TipoOp ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("WHERE  O.FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and (O.TipoOp IN ('DTO','DTOV','DTOVM','DPBOA','DPBOD','DPC','DPDSO','DPDSS','DPF','DPOA','DPOAV','DPOD','DPOGA','DPOGD','DPRC','DPRRS','DPRS','DPS','DPSF','DPSN','DPSV','DTK','DTKVI','DTOM','DTOMV') ")
SQL.ADD("       or O.TipoOp IN ('DTC','DTF','DTSFVM','DTSFFM','DTSVVM','DTSFVX','DTSFVV','DTCAP','DTFLO')) ")
SQL.ADD("       and O.NrOperacion = C.NrOperacion ") 
SQL.ADD("       and C.Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("       and C.Fecha2 <= (SELECT MAX(C.Fecha2) FROM "~DBO~".OPERACIONES O,"~DBO~".CUOTAS C WHERE O.NrOperacion = C.NrOperacion )")
if NoVacio(VAL(zz6))
   SQL.ADD("    and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
If NOVACIO(Dialogo.Lista2)
   SQL.ADD("    and O.TipoOp    In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
SQL.ADD("order by Vehiculo1, TipoOp ")

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Cartera de Operaciones Financieras Vigentes")
SetFont(a:fac..a:fac,3)

