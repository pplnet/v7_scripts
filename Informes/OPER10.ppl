acn(ba1,1)
Recorrer SQL


  IF Incluido(fbn('TipoOp'), 'TEMIND|TEMINM|VIMIND|VIMINM|MMCDP|MMD|MMFRN|MMFRNP|MMO|MMON|MMPCCV|MMPCL|MMPCOS|MMPE|MMPI|MMPLME|MMPCCM|MMP|') o Incluido(fbn('TipoOp'),'MMPSC|MMPSI|MMCDIA|MMFCMV|MMFIMV|MMONM|MMPOCM|MMPCLM|MMSELN|MMPCVM|MMPEM|MMPIM|MMPOSM|MMSCMV') o Incluido(fbn('TipoOp'),'MMSIMV|MRF|MRO|DTO|DTOV|DTSFV|DTSFVV|DTSFF|DTSVV|DTK|DTKVI|DTOM|DTOMV|DTSFVM|DTSFVX|DTCAP|DTFLO') o Incluido(fbn('TipoOp'),'DTSNFF|DTSNVV|DTC|DTF|DFXO|DSEO|DPBOD|DPDSO|DPDSS|DPOA|DPOAV|DPOD|DPRC|DPRRS|DPRS|DPS|DPSN') o Incluido(fbn('TipoOp'),'DPBOA|DPBOS|DPC|DPF|DPFW|DPOGA|DPOGD|DPOGA|DPOGS|DPOS|DPSF|DPSV|MMDCA|MMCCR|MMDC|MMCP|') o Incluido(fbn('TipoOp'),'MMDC|MMCPR|MMCPRV|MMCP|MMCPM|MMCPMG|MMCPVM|MMCPV|FCR|FCS|GA|GAMV|GAMV|CC|CCMV|CCMV|SEABD|SEABP') o Incluido(fbn('TipoOp'),'SERA|SERAV|SECT|SECTV|SEVT|SEVTV|SERP|SERPV|SEABD|SEABP|SECT|SECTV|SEVT|SEVTV|SERA|SERAV') o Incluido(fbn('TipoOp'),'|DTSFFM|DTSVVM|DTSNFV|SERP|SERPV|FXAS|FXASV|FXAT|FXATV|FXCT|FXCTV|FXVT|FXVTV|FXREPO|FXREPV')
     Message(fbn['Vehiculo1']~'  '~fbn['TipoOp'])

     IF Not Eqstr(Val(ve1), fbn('Vehiculo1'))
        ACN(ba1,1)
     ENDIF

********************
     ACN(ba1,1)
********************

    * LinkearHoja('OPE10A',val(ba1),Fecha1=Dialogo.Fecha1,Vehiculo1=fbn['Vehiculo1'],TipoOp1=fbn['TipoOp'])
