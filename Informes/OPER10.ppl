     IF Not Eqstr(Val(ve1), fbn('Vehiculo1'))
        IF Val(fa1)<>0
           ifa 
           ACT(a:fac, 'Totales: ')
           ACN(b:fac, SUM(b:Val(fa1)..b:fac))
           ACN(c:fac, SUM(c:Val(fa1)..c:fac))
