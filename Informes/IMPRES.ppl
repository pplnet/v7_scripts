CrearDialogo
  NrTrans1:'Operacion' ;;;;;;NOVACIO(Dialogo.NrTrans1);;NO;;;;;;"TipoTr2 IN ('RESCAT')"
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,B")
CrearFont(2,"Arial,8,I")
CrearFont(3,"Arial,8,")

SQL.ADD(" SELECT C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal, C.CUIT, P.Nombre Pais, ")
SQL.ADD(" C.CondicionIVA, C.Codigo, T.NrTrans, T.Cantidad1, T.Precio5, E.Nombre NomEsp, ")
SQL.ADD(" T.Cantidad2, T.TipoTr2, T.Precio1, T.Fecha1, T.Especie, T.Especie1, T.RB8, T.Cantidad5, ")
SQL.ADD(" T.Cantidad6, T.Cantidad7, T.Cantidad8, T.TotalImpuesto1, T.Especie4 ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".PAISES P, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE C.Codigo = T.Cliente1 ")
SQL.ADD(" AND T.NrTrans = '"~Dialogo.NrTrans1~"' ")
SQL.ADD(" AND C.PaisDir = P.Codigo ")
SQL.ADD(" AND T.Especie = E.Codigo ")

SetFilaActual(2)

ACN(BD:1, 0)

RECORRER SQL
    IF Eqstr(fbn('Especie4'), Var('MONELOCA'))
        ACT(MA:1, '$')
    ELSE
        ACT(MA:1, 'U$S')
    ENDIF
    ACN(BD:1, 1)
    ACT(D:fac, '                           COMPROBANTE')
    IFA
    ACT(D:fac, '                               DE PAGO')
    SetFont(D:fac-1..D:fac, 1)
    IFA
    IFA
    IF Not Eqstr(fbn('RB8'), '0') Y NoVacio(fbn('RB8'))
        ACT(D:fac, '                           REIMP. ORIGINAL')
    ELSE
        ACT(D:fac, '                               ORIGINAL')
    ENDIF

    SetFont(D:fac, 1)
    AlinearCeldas(D:fac..D:fac+1, 'I')
    SetFilaActual(fac+3)    
    ACT(A:fac-1, 'Sres.: '~fbn('RazonSocial'))
    SetFont(A:fac-1, 1)
    ACT(C:fac, fbn('Codigo') )
    ACT(C:fac, '                             Fecha Rescate: '~fbn('Fecha1') )
    ACT(E:fac, '       '~fbn('NrTrans') )
    IFA
    ACT(C:fac, '                             Fecha Emision: '~Fecha(Fsys) )
    AlinearCeldas(D:fac-2..D:fac, 'I')

    ACT(A:fac, fbn('Direccion')~' '~fbn('Localidad')~' ('~fbn('CodigoPostal')~')')
    SetFont(a:fac, 1)
    SetFilaActual(fac+2)
    ACT(a:fac,BuscarCampo('TIPOSIMPUESTO','Descripcion','Codigo',fbn('CondicionIVA')))
    SetFont(a:fac, 1)
    ifa
    ACT(a:fac,'CUIT: '~fbn('CUIT'))
    SetFont(a:fac, 1)
    SetFilaActual(fac+3)
    AFI(fac, 10)
    ifa
    IF Eqstr(fbn('Especie1'), Var('MONELOCA'))
        ACT(EZ:1, '$')
        ACT(EZ:2, 'Pesos')
    ELSE
        ACT(EZ:1, 'U$S')
        ACT(EZ:2, 'Dolares')
    ENDIF

*    SetFilaActual(Fac + 5)
    ACT(A:fac, 'Rescate de '~fbn('Cantidad1')~' '~fbn('Especie')~' al '~fbn('Precio1')~'%')
    ACN(E:fac, fbn('Cantidad2'))
    ACT(D:fac, Val(EZ:1))
    AlinearCeldas(D:fac, 'D')
    ACN(CF:1, fac)
    IF fbn('Cantidad8') > 0
        ifa
        ACT(A:fac, 'Gastos')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('Cantidad8'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('Cantidad6') > 0
        ifa
        ACT(A:fac, 'With Holding Tax')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('Cantidad6'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('Cantidad5') > 0
        ifa
        ACT(A:fac, 'Arancel')
        ACT(D:fac, Val(MA:1))
        ACN(E:fac, fbn('Cantidad5'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('Cantidad7') > 0
        ifa
        ACT(A:fac, 'IVA Arancel')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('Cantidad7'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('TotalImpuesto1') > 0
        ifa
        ACT(A:fac, 'Per. Ing. Brutos')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('TotalImpuesto1'))
        AlinearCeldas(D:fac, 'D')
    ENDIF

    SetFilaActual(Val(CF:1)+17)

    SetFont(F:fac, 2)
***---Duplico Codigo para la copia
    ACN(BD:1, 1)
    AFI(fac-1, 3)
    ACT(D:fac, '                           COMPROBANTE')
    IFA
    ACT(D:fac, '                               DE PAGO')
    SetFont(D:fac-1..D:fac, 1)
    IFA
    IFA

    IF Not Eqstr(fbn('RB8'), '0') Y NoVacio(fbn('RB8'))
        ACT(D:fac, '                             REIMP. COPIA')
    ELSE
        ACT(D:fac, '                                COPIA')
    ENDIF
    SetFont(D:fac, 1)
    AlinearCeldas(D:fac..D:fac+1, 'I')
    SetFilaActual(fac+3)    
    ACT(A:fac-1, 'Sres.: '~fbn('RazonSocial'))
    SetFont(A:fac-1, 1)
    ACT(C:fac, fbn('Codigo') )
    ACT(C:fac, '                             Fecha Rescate: '~fbn('Fecha1') )
    ACT(E:fac, '       '~fbn('NrTrans') )
    IFA
    ACT(C:fac, '                             Fecha Emision: '~Fecha(Fsys) )
    AlinearCeldas(D:fac-2..D:fac, 'I')

    ACT(A:fac, fbn('Direccion')~' '~fbn('Localidad')~' ('~fbn('CodigoPostal')~')')
    SetFont(a:fac, 1)
    SetFilaActual(fac+2)
    ACT(a:fac,BuscarCampo('TIPOSIMPUESTO','Descripcion','Codigo',fbn('CondicionIVA')))
    SetFont(a:fac, 1)
    ifa
    ACT(a:fac,'CUIT: '~fbn('CUIT'))
    SetFont(a:fac, 1)
    SetFilaActual(fac+3)
    AFI(fac, 10)
    ifa

    ACT(A:fac, 'Rescate de '~fbn('Cantidad1')~' '~fbn('Especie')~' al '~fbn('Precio1')~'%')
    ACN(E:fac, fbn('Cantidad2'))
    ACT(D:fac, Val(EZ:1))
    AlinearCeldas(D:fac, 'D')
    IF fbn('Cantidad8') > 0
        ifa
        ACT(A:fac, 'Gastos')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('Cantidad8'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('Cantidad6') > 0
        ifa
        ACT(A:fac, 'With Holding Tax')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('Cantidad6'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('Cantidad5') > 0
        ifa
        ACT(A:fac, 'Arancel')
        ACT(D:fac, Val(MA:1))
        ACN(E:fac, fbn('Cantidad5'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('Cantidad7') > 0
        ifa
        ACT(A:fac, 'IVA Arancel')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('Cantidad7'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
    IF fbn('TotalImpuesto1') > 0
        ifa
        ACT(A:fac, 'Per. Ing. Brutos')
        ACT(D:fac, '$')
        ACN(E:fac, fbn('TotalImpuesto1'))
        AlinearCeldas(D:fac, 'D')
    ENDIF
PROXIMO

IF Val(BD:1)=0
    MessageBox('No hay Rescates que concuerden con los Datos Ingresados')
    Cancelar
ENDIF

ACO(1, 23)
ACO(2, 13)
ACO(3, 12)
ACO(4, 12)
ACO(5, 12)

Impresion(1,1)
Impresion(2,0)
Impresion(3,0)
SetMargins(0,0,0,0)

EstadoVentana(2)
LimitesVision(f:fac)
ImprimirHoja(SI)