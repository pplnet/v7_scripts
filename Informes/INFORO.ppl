CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Listado de Instancias')
ACT(a:FAC+2,'Tabla')
ACT(b:FAC+2,'Instancia')
ACT(c:FAC+2,'Numero')
ACT(d:FAC+2,'Agregar')
ACT(e:FAC+2,'Editar')
ACT(f:FAC+2,'Borrar')
ACT(g:FAC+2,'FWD')
ACT(h:FAC+2,'REW')

AgregarMarco(a:FAC+2..h:FAC+2,2,0,Exe('COLOR'))
SetFont(a:FAC..h:FAC+2,2)

SetFilaActual(FAC+2)

SQL.ADD("Select * From "~DBO~".INSTANCIAS")
SQL.ADD(" ORDER BY Tabla, NrInstancia ")
Recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN('Tabla'))
  ACT(b:FAC, FBN('Nombre'))
  ACT(c:FAC, FBN('NrInstancia'))
  ACT(d:FAC, FBN('Agregar'))
  ACT(e:FAC, FBN('Editar'))
  ACT(f:FAC, FBN('Borrar'))
  ACT(g:FAC, FBN('FWD'))
  ACT(h:FAC, FBN('REW'))
proximo

AgregarMarco(a:Val(w1)+3..h:FAC+1,1)
SetFont(a:Val(w1)+3..c:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(1,12)
ACO(2,15)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC, 2)
AgregarBMP(a1,'logo.bmp',60)
AlinearCeldas(c:3,'D')
LimitesVision(h:FAC)
RangoTitulo(a:1..h:FAC,Val(w1)+2)



