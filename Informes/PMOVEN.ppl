ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'F.Desde';;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;FSys
  Fecha2   : 'F.Hasta';;;;;;NoVacio(Dialogo.Fecha2);'Debe ingresar la Fecha Hasta';NO;FSys
  Vehiculo1: 'Vehiculo'  
  Especie1 : 'Especie';;;;;;VACIO(DIALOGO.ESPECIE1) o [DesciendeDeEspecie(DIALOGO.ESPECIE1,'MONEDA') y EsTerminal(DIALOGO.ESPECIE1, Especie) y Incluido(DIALOGO.ESPECIE1,Var('LISESPMO'))];'Debe Ingresar una Moneda Valida';NO
  Cliente1 : 'Cliente1'
  TipoOp1  : 'Tipo Op.';;;;;;;;;;;;;;" Codigo in ('PMU','PME')"
  Check1   : 'Impagas' ;;;;;;;;;0
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

ACT(f3,'Filtro: ')

SetFilaActual(4)

ACT(e:fac,'Facility Type / Commited / Contract SubType')
ACT(f:fac,'Operacion')
ACT(g:fac,'Cuota')
ACT(h:fac,'F.Inicio')
ACT(i:fac,'TNA')
ACT(j:fac,'Capital')
ACT(k:fac,'Int.Normal')
ACT(l:fac,'Comisiones')
ACT(m:fac,'Impuestos')
ACT(n:fac,'Total')

AlinearCeldas(i:fac..n:fac,'D')

SQL.ADD("Select FechaVto, ")
SQL.ADD(" Vehiculo1, ")
SQL.ADD(" Especie, ")
SQL.ADD(" Cliente1, ")
SQL.ADD(" RazonSocial, ")
SQL.ADD(" O.NrOperacion, RB1, RB2, ")
SQL.ADD(" 1 as NrCuota, ")
SQL.ADD(" FechaOp as FechaInicio, ")
SQL.ADD(" Precio1, ")
SQL.ADD(" Cantidad as Capital, ")
SQL.ADD(" TotalIntereses as Intereses,  ")
SQL.ADD(" TotalComisiones as Comisiones, ")
SQL.ADD(" Sublimite, ")
SQL.ADD(" RB5, ")
SQL.ADD(" Centro2, ")
SQL.ADD(" C.CondicionIVA, ")
SQL.ADD(" C.AgPercepcionIVA, ")
SQL.ADD(" C.ExIVA, ")
SQL.ADD(" C.PorcExIVA, ")
SQL.ADD(" C.FDesdeExIVA, ")
SQL.ADD(" C.FHastaExIVA ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("where Cliente1 = C.Codigo and TipoOp='PMU' and CB6<>'1' ")
SQL.ADD("and O.NrOperacion=OB.NrOperacion and NrBit in ('70','10') and Valor='1' ")
SQL.ADD("and (FechaVto between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")

ACT(f3,val(f3)~"Desde: "~Dialogo.Fecha1~" Hasta: "~Dialogo.Fecha2~"  ")

if Dialogo.Check1=1
  SQL.ADD("or FechaVto<="~IdxDate2(FSYS)~") ")
  ACT(f3,val(f3)~"Incluye operaciones impagas ")
  else
  SQL.ADD(") ")
endif

if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and TipoOp = '"~Dialogo.TipoOp1~"' ")
  ACT(f3,val(f3)~"TipoOp: "~Dialogo.TipoOp1~"  ")
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
  ACT(f3,val(f3)~"Vehiculo: "~Dialogo.Vehiculo1~"  ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and Especie = '"~Dialogo.Especie1~"' ")
  ACT(f3,val(f3)~"Especie: "~Dialogo.Especie1~"  ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and Cliente1 = '"~Dialogo.Cliente1~"' ")
  ACT(f3,val(f3)~"Cliente: "~Dialogo.Cliente1~"  ")
endif

SQL.ADD("UNION ALL ")

SQL.ADD("Select C.Fecha2 as FechaVto, ")
SQL.ADD(" O.Vehiculo1, ")
SQL.ADD(" O.Especie, ")
SQL.ADD(" O.Cliente1, ")
SQL.ADD(" Cl.RazonSocial, ")
SQL.ADD(" O.NrOperacion, isnull(O.RB1,'0'), isnull(O.RB2,'0'), ")
SQL.ADD(" C.NrCuota, ")
SQL.ADD(" C.Fecha1 as FechaInicio, ")
SQL.ADD(" C.Tasa1 as Precio1, ")
SQL.ADD(" C.Cantidad5 as Capital, ")
SQL.ADD(" C.Cantidad2 as Intereses, ")
SQL.ADD(" C.Total7 as Comisiones, ")
SQL.ADD(" O.Sublimite, ")
SQL.ADD(" O.RB5, ")
SQL.ADD(" O.Centro2, ")
SQL.ADD(" Cl.CondicionIVA, ")
SQL.ADD(" Cl.AgPercepcionIVA, ")
SQL.ADD(" Cl.ExIVA, ")
SQL.ADD(" Cl.PorcExIVA, ")
SQL.ADD(" Cl.FDesdeExIVA, ")
SQL.ADD(" Cl.FHastaExIVA ")
SQL.ADD("from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES Cl, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD("where C.NrOperacion=O.NrOperacion and TipoOp='PME' and isnull(C.Radio6,'0')<>'1' ")
SQL.ADD("and O.NrOperacion=OB.NrOperacion and NrBit in ('70','10') and Valor='1' ")
SQL.ADD("and O.Cliente1 = Cl.Codigo ")
SQL.ADD("and (C.Fecha2 between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")

if Dialogo.Check1=1
  SQL.ADD("or C.Fecha2<="~IdxDate2(FSYS)~") ")
  ACT(f3,val(f3)~"Incluye operaciones impagas ")
  else
  SQL.ADD(") ")
endif

if NoVacio(Dialogo.TipoOp1)
  SQL.ADD("and O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
SQL.ADD(" order by 1,2,3,4")

ACT(ac1,'ww')
ACT(ac2,'ww')
ACT(ac3,'ww')
ACD(ac4,0)

ACN(pz1,0)
ACN(pz2,0)
ACN(pz3,0)
ACN(pz4,0)

ACN(x1,0)

recorrer SQL
SCN(x1,1)

if not EQSTR(fbn('Cliente1'),val(ac1)) o not EQSTR(fbn('Especie'),val(ac2)) o not EQSTR(fbn('Vehiculo1'),val(ac3)) o fbn('FechaVto')<>val(ac4)
  if val(pz1)=1
    ACT(d:fac,'Total Cliente: ')
    ACN(e:fac,val(t1))        
    ifa    
    ACN(t1,0)
  else
    ACN(pz1,1)
  endif
endif

if not EQSTR(fbn('Especie'),val(ac2)) o not EQSTR(fbn('Vehiculo1'),val(ac3)) o fbn('FechaVto')<>val(ac4)
  if val(pz4)=1       
    ACT(a:fac,'Total: ')
    ACN(b:fac,val(t4))
    AgregarMarco(a:Val(w1)..p:fac,1) 
    ifa
    ACN(t4,0)
  else
    ACN(pz4,1)
  endif
endif

if not EQSTR(fbn('Especie'),val(ac2)) o not EQSTR(fbn('Vehiculo1'),val(ac3)) o fbn('FechaVto')<>val(ac4)
  ACN(w1,fac)
  ACT(a:fac,'Fecha: '~fbn('FechaVto')~' - Vehiculo: '~fbn('Vehiculo1')~' - Especie: '~fbn('Especie'))  
  ifa  
endif

if not EQSTR(fbn('Cliente1'),val(ac1)) o not EQSTR(fbn('Especie'),val(ac2)) o not EQSTR(fbn('Vehiculo1'),val(ac3)) o fbn('FechaVto')<>val(ac4)
  ACT(d:fac,'Cliente: '~fbn('Cliente1')~" - "~fbn('RazonSocial'))
  ifa
endif

if EQSTR(fbn('RB2'),'1')
  ACT(e:fac,'Gar.2412')
endif
  ACT(e:fac, fbn('Sublimite')~' / '~IIF(EqStr(fbn('RB5'),'0'),'SI','NO')~' / '~fbn('Centro2'))
  ACT(f:fac,fbn('NrOperacion'))
  ACT(g:fac,fbn('NrCuota'))
  ACT(h:fac,fbn('FechaInicio'))
  if fbn('Precio1')=0 y not EQSTR(fbn('RB2'),'1')  
    ACT(i:fac,'A definir')
    AlinearCeldas(i:fac..i:fac,'D')
  else
    ACN(i:fac,fbn('Precio1'))
  endif
  * Si es 2412 no sumo el Capital
  if EQSTR(fbn('RB2'),'1')
    ACN(j:fac,0)
  else
    ACN(j:fac,fbn('Capital'))
  endif
  ACN(k:fac,fbn('Intereses'))
  ACN(l:fac,fbn('Comisiones'))

  ACN(ha:val(x1),0)
  ACN(hb:val(x1),0)
  ACN(hc:val(x1),0)

     *** IVA ****
     if Not[Eqstr(fbn('Vehiculo1'),'INGCURA')] 
       ACT(j1,FBN['CondicionIVA'])
       ACT(k1,FBN['AgPercepcionIVA'])
       ACT(l1,FBN['ExIVA'])
       ACN(m1,FBN['PorcExIVA'])
       ACD(n1,FBN['FDesdeExIVA'])
       ACD(o1,FBN['FHastaExIVA'])

       *--- IVA / INTERES NORMAL
       ACN(pm1,fbn('Intereses'))
       ACN(pf1,fbn('FechaVto'))
       ACT(pt1,'INT')
       (.'CANPREIVA'.)
       ACN(ga:val(x1),val(pr1))
       ACN(gb:val(x1),val(pr2))
       ACN(gc:val(x1),val(pr3))
 
       *--- IVA / COMISION
       ACN(pm1,fbn('Comisiones'))
       ACN(pf1,fbn('FechaVto'))
       ACT(pt1,'COM')
       (.'CANPREIVA'.)
       ACN(nb:val(x1),val(pr1))
       ACN(nc:val(x1),val(pr2))
       ACN(nd:val(x1),val(pr3))

       *** TOTAL IVANOR
       ACN(ha:val(x1),Round(val(ga:val(x1))+val(nb:val(x1)),2))
   
       *** TOTAL IVAADI
       ACN(hb:val(x1),Round(val(gb:val(x1))+val(nc:val(x1)),2))

       *** TOTAL IVAPER
       ACN(hc:val(x1),Round(val(gc:val(x1))+val(nd:val(x1)),2))

       * Si IVAPER es menor al Valor Minimo el Impuesto es 0
       if val(hc:val(x1)) < Var('IVAPERMIN')
         ACN(gc:val(x1),0)
         ACN(nd:val(x1),0)
         ACN(hc:val(x1),0)
       endif
     endif   
 
  *--- FIN IVA

  ACN(m:fac,val(ha:val(x1))+val(hb:val(x1))+val(hc:val(x1)))

  ACN(n:fac,sum(j:fac..m:fac))

  ACD(ac4,fbn('FechaVto'))
  ACT(ac3,fbn('Vehiculo1'))
  ACT(ac2,fbn('Especie'))
  ACT(ac1,fbn('Cliente1'))

  SCN(t1, val(n:fac) )      
  SCN(t4, val(n:fac) )      
proximo

ifa
ACT(d:fac,'Total Cliente: ')
ACN(e:fac, val(t1))        
ifa
ACT(a:fac,'Total Fecha: ')    
ACN(b:fac, val(t4))

AgregarMarco(a:Val(w1)..p:fac,1)

BorrarCeldas(a1..t1)

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
ACT(p1,VAR('TITULO'))
ACT(p2, 'Listado de Vencimientos')
AlinearCeldas(p1..p2,'D')
SetFont(p1..p2, 1)

ACT(a3,'Sistema: FPA')
ACT(c3,'Fecha de Proceso: '~Fecha(FSYS))

ACT(a4,'Usuario: '~USUARIOACTIVO )
AlinearCeldas(p4..p4,'D')

AlinearCeldas(g:5..g:fac,'D')
FormatoCeldas(n5..n:fac,Exe('F2'))
FormatoCeldas(a5..e:fac,Exe('F2'))
FormatoCeldas(g5..g:fac,Exe('F0'))


*-------------------------------------

*Landscape
Impresion(1,2)
*Fecha
Impresion(2,1)
*Pagina
Impresion(3,1)

*ACO(4,10)
ACO(5,22)
ACO(7,4)

ACO(10,8.5)
ACO(11,8.5)
ACO(12,8.5)
ACO(13,8.5)
ACO(14,8.5)

ACN(zz1,fac+3)

* Reduzco el alto de todas las filas
recorrer&k 1,val(zz1)
*  ACN(zz2, &k)
*  AFI(val(zz2),1)
  AFI(&k,1)
proximo

*ACT(a:UFila,'Fin')
LimitesVision(p:Val(zz1))

* Encabezado
RangoTitulo(a:1..p:Val(zz1),4)
SetMargins(0,0,0,1.0)
SetPrintFit(3,85)




