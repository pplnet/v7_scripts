SetFilaActual(7)

SQL.ADD(" SELECT /*+ RULE */ M.Cantidad*(-1) Cantidad, M.Especie, M.FechaMov, M.EnteCustodia Cliente, ")
SQL.ADD(" T.FechaOp, B.RazonSocial Banco, C.Numero, M.Leyenda, T.NrOperacion, M.Cuenta, T.TipoOp, ")
SQL.ADD(" TOPER.Nombre DescripcionTipo, T.Cliente1, B.Codigo, '9' RB1 ")
SQL.ADD(" FROM   "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B,  ")
SQL.ADD(" "~DBO~".OPERACIONES T, "~DBO~".ESPECIES E, "~DBO~".TIPOSOPERACION TOPER ")
SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.NrOperacion = T.NrOperacion ")
SQL.ADD(" AND    M.Especie     = E.Codigo  ")
SQL.ADD(" AND    E.Tipo        = 'MON'     ")
SQL.ADD(" AND    T.TipoOp      = TOPER.Codigo ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    M.Especie   = '"~Dialogo.Especie1~"' ")
If Dialogo.Check1=0
  SQL.ADD(" AND  T.TipoOp NOT IN ('MMPCCM','MMPCCV') ")
Else
  SQL.ADD(" AND  T.TipoOp IN ('MMPCCM','MMPCCV') ")
Endif
If Dialogo.Check2=0
  SQL.ADD(" AND    M.Cantidad > 0 ")
Else
  SQL.ADD(" AND    M.Cantidad < 0 ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.EnteCustodia  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad*(-1) Cantidad, M.Especie, M.FechaMov, M.EnteCustodia Cliente, ")
SQL.ADD(" T.FechaOp, B.RazonSocial Banco, C.Numero, M.Leyenda, T.NrOperacion, M.Cuenta, T.TipoOp, ")
SQL.ADD(" TOPER.Nombre DescripcionTipo, T.Cliente1, B.Codigo, '9' RB1 ")
SQL.ADD(" FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B,  ")
SQL.ADD(" "~DBO~".OPERACIONES T, "~DBO~".ESPECIES E, "~DBO~".TIPOSOPERACION TOPER ")
SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.NrOperacion = T.NrOperacion ")
SQL.ADD(" AND    M.Especie     = E.Codigo  ")
SQL.ADD(" AND    E.Tipo        = 'MON'     ")
SQL.ADD(" AND    T.TipoOp      = TOPER.Codigo ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    M.Especie   = '"~Dialogo.Especie1~"' ")
If Dialogo.Check1=0
  SQL.ADD(" AND  T.TipoOp NOT IN ('MMPCCM','MMPCCV') ")
Else
  SQL.ADD(" AND  T.TipoOp IN ('MMPCCM','MMPCCV') ")
Endif
If Dialogo.Check2=0
  SQL.ADD(" AND    M.Cantidad > 0 ")
Else
  SQL.ADD(" AND    M.Cantidad < 0 ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.EnteCustodia  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT /*+ RULE */ M.Cantidad1 Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
SQL.ADD(" M.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, M.Observaciones Leyenda, M.NrTrans NrOperacion, M.Cuenta2 Cuenta, M.TipoTr2 TipoOp,  ")
SQL.ADD(" TOPER.Nombre DescripcionTipo, ' ' Cliente1, B.Codigo, M.RB1 ")
SQL.ADD(" FROM   "~DBO~".TRANSACCIONES2 M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E, "~DBO~".TIPOSTRANSACCION2 TOPER ")
SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
SQL.ADD(" AND    M.Fecha2   >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.Fecha2   <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    M.TipoTr2   = 'PROYEC' ")
SQL.ADD(" AND    M.TipoTr2   = TOPER.Codigo ")
SQL.ADD(" AND    M.Especie   = '"~Dialogo.Especie1~"' ")
If Dialogo.Check1=0 y Dialogo.Check2=0
  SQL.ADD(" AND  M.RB1 = '3' ")
Endif
If Dialogo.Check1=0 y Dialogo.Check2=1
  SQL.ADD(" AND  M.RB1 = '2' ")
Endif
If Dialogo.Check1=1 y Dialogo.Check2=1
  SQL.ADD(" AND  M.RB1 = '4' ")
Endif
If Dialogo.Check1=1 y Dialogo.Check2=0
  SQL.ADD(" AND  M.RB1 = '5' ")
Endif
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY 4, 14, 11, 3 ")
*VEHICULO, BANCO, TIPOOP, FechaMov

