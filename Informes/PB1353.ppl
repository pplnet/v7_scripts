CrearDialogo
   Fecha1:  'D.Fecha'   ;1;1;;;;;;;FSYS
   Fecha2:  'H.Fecha'   ;2;1;;;;;;;FSYS
   Especie1: 'Moneda'
   Radio2:  'Tipo Cuenta|Cta.Cte|Intermedia|Recaudadora|Todos' ;4;1;;;;;;;3
   Lista1:  'Vehiculos'    ; 5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
   Check1:  'Intercompany' ;
   Check2:  'Ingresos'     ;
FinDialogo

