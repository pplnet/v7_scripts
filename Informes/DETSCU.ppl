CrearDialogo
  Fecha1: 'Fecha Desde'  ;;;;;;;;;
  Fecha2: 'Fecha Hasta'  ;;;;;;;;;
  String1: 'Especie'     ;;;;;;;;;
  String2: 'Cuenta'      ;;;;;;;;;
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,BU')

ACT(a:2,'Detalle Saldos por Cuenta')
SetFont(a:2,3)

SetFilaActual(4)

ACT(a:fac, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:fac+1, 'Fecha Hasta: '~Dialogo.Fecha2)
ACT(a:fac+2, 'Especie: '~Dialogo.String1)
ACT(a:fac+3, 'Cuenta: '~Dialogo.String2)

SetFont(a:fac..a:fac+3, 2)

SetFilaActual(fac+5)

ACT(a:fac, 'NrOperacion')
ACT(b:fac, 'NrAsiento')
ACT(c:fac, 'DebitoCredito')
ACT(d:fac, 'Cantidad')
ACT(e:fac, 'CentroCosto')

AgregarMarco(a:fac..e:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..e:fac, 2)
AlinearCeldas(a:fac..e:fac, 'C')

SQL.ADD(" Select A1.DebitoCredito, A1.Cantidad1, A1.NrOperacion, A1.NrUnicoAsiento, A1.CentroCosto From "~DBO~".ASIENTOSCON A, "~DBO~".ASIENTOSCON1 A1 ")
SQL.ADD(" Where A.NrUnicoAsiento = A1.NrUnicoAsiento ")
SQL.ADD("   And A.FechaValor Between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("   And A1.Alias1 = '"~Dialogo.String1~"' ")
SQL.ADD("   And A1.Cuenta = '"~Dialogo.String2~"' ")

ACN(TO:1,0)

Recorrer SQL
  ACT(a:fac,FBN['NrOperacion'])
  ACLO(a:fac,FBN['NrOperacion'])
  ACT(b:fac,FBN['NrUnicoAsiento'])
  ACL(b:fac, 'DETASI', String1=FBN['NrUnicoAsiento'])
  ACT(c:fac,FBN['DebitoCredito'])
  If EqStr(FBN['DebitoCredito'],'CRE')
     ACN(d:fac,FBN['Cantidad1'])
  Else
     ACN(d:fac,-FBN['Cantidad1'])
  EndIf
  ACT(e:fac,FBN['CentroCosto'])

  FormatoCeldas(d:fac, EXE('F2'))
  SetFont(a:fac..f:fac, 1)
  SCN(TO:1,Val(d:fac))
Proximo

SetFilaActual(fac+1)

ACN(d:fac,Val(TO:1))
FormatoCeldas(d:fac, EXE('F2'))
SetFont(d:fac, 2)

LimitesVision(f:fac+1)

ACO(3,10)
ACO(4,15)
ACO(5,10)
