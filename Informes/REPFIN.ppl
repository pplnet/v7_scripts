CrearDialogo
  Fecha2     : "Fecha Desde"         ;1;1;;;;Dialogo.Fecha2 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, NO, 'ARG');
  Fecha3     : "Fecha Hasta"         ;1;2;;;;Dialogo.Fecha3 >= Dialogo.Fecha2;'Fecha Hasta Invalida';NO;FinDeMes(Fsys, NO, 'ARG');
  Fecha1     : "Fecha Vigencia"      ;2;1;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Radio2     : 'Expresado|ARP|USD'   ;2;2;;NO;;;;;1;
  Radio4     : "Consolidado|NO|SI"   ;3;1;;;;;;;0
  Radio1     : 'Vehiculos|Todos|Algunos' ;3;2;;;;;;;0;
  Label3     : ''                    ;5;1;;;;;;;'__________CAIDAS_______________';;;;;;;
  Check1     : "Capital"             ;6;1;;;;;;;1
  Check2     : "Interes"             ;7;1;;;;;;;1
  Check3     : "Impuestos"           ;8;1;;;;;;;1
  Label2     : ''                    ;9;1;;;;;;;'__________Ctas.Ctes.Remun._______';
  Cliente2   : "Entidad"             ;10;1;;;;;;;;;;;
  Lista1     : "Vehiculo"            ;4;2;;Dialogo.Radio1=1;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Label4     : ''                    ;5;1;;;;;;;'________________________________       ______________________________';;;
  Label1     : ''                    ;6;1;;NO;;;;;'Prest.Fin.,ON-Prest.Sindic.,Caidas                 Inv/Toma Fondos,Ctas.Ctes.Remun.,';
  Label2     : ''                    ;7;1;;NO;;;;;'                                                                  Detalle Oper. de Titulos';
  Especie3   : "Especie"             ;7;1;;;;;;;;;;;
  Cliente1   : "Entidad"             ;8;1;;;;;;;;;;;
  Lista2     : "TipoOp"              ;9;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' ")
  Lista3     : "Moneda Oper."        ;2;2;;;;;;;;;LeerObjeto('Monedas');
  Label1     : ''                    ;3;1;;;;;;;'________________________________       ______________________________';;;
  Label5     : ''                    ;4;1;;;;;;;'Prest.Fin, ON-Prest.Sindic';;
  NrOperacion1: "Operacion"          ;5;1;;;;;;;;;;;;" TipoOp In ('MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME','MMONM','MMON','MMSIMV','MMPSI')"
  Label5     :''                     ;4;2;;;;;;;'Resumen Oper.Financieras';
  Precio2    : 'Cot.USD/ARP'         ;5;2;;;;Dialogo.Precio2>0;'La cotizacion del USD contra el peso debe ser mayor a cero';NO;CotizacionC(Var('MONEEXTR'),,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA'));;;;'###,###.########';
FinDialogo

If Not Ok
  Cancelar
EndIf

ACT(LS:1, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
ACT(LS:2, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMFIMV','MMPCLM','MMPEM','MMPIM','MMPOSM','MMFRNP','MMPCL','MMPE','MMPI','MMPCOS','MMPLME') "))
ACT(LS:5, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' "))
IF NoVacio(Dialogo.Lista2)
    ***---Armo lista con TipoOp que necesitan los informes <> a CAIDA8
    Recorrer&k 1, Elementos(Dialogo.Lista2)
        IF Incluido(ItemLista(Dialogo.Lista2, &k), 'MMFIMV|MMPCLM|MMPEM|MMPIM|MMPOSM|MMFRNP|MMPCL|MMPE|MMPI|MMPCOS|MMPLME')
            ACT(LS:4, Val(LS:4)~ItemLista(Dialogo.Lista2, &k)~'|')
        ENDIF
    Proximo
ENDIF
ACT(LS:3, LeerObjeto('Monedas'))

ACD(FE:1, Dialogo.Fecha1)
ACD(FE:2, Dialogo.Fecha2)
ACD(FE:3, Dialogo.Fecha3)
ACN(R:1, Dialogo.Radio1)
ACN(R:2, Dialogo.Radio2)
ACN(R:4, Dialogo.Radio4)
ACN(CH:1, Dialogo.Check1)
ACN(CH:2, Dialogo.Check2)
ACN(CH:3, Dialogo.Check3)
ACT(CL:1, Dialogo.Cliente1)
ACT(CL:2, Dialogo.Cliente2)
ACT(LS:10, Dialogo.Lista1)
ACT(LS:20, Dialogo.Lista2)
ACT(LS:30, Dialogo.Lista3)
ACT(ES:3, Dialogo.Especie3)
ACN(PR:2, Dialogo.Precio2)
ACT(NR:1, Dialogo.NrOperacion1)
ACN(BD:1, 0)
ACN(BD:2, 0)

IF Vacio(Dialogo.Lista3)
    ACN(EL:3, Elementos(Val(LS:3)))
ELSE
    ACN(EL:3, Elementos(Dialogo.Lista3))
ENDIF

Recorrer&k 1, Val(EL:3)
    IF Vacio(Dialogo.Lista3)
        IF Not Eqstr(ItemLista(Val(LS:3), &k), Var('MONELOCA'))
            ACN(BD:2, 1)
            ifa
            ACT(A:fac, ItemLista(Val(LS:3), &k))
            ACN(B:fac, CotizacionC(ItemLista(Val(LS:3), &k),,,,Fsys,1,SI,Var('MONEEXTR')))
        ELSE
            ACN(BD:1, 1)
        ENDIF
    ELSE
        IF Not Eqstr(ItemLista(Dialogo.Lista3, &k), Var('MONELOCA'))
            ACN(BD:2, 1)
            ifa
            ACT(A:fac, ItemLista(Dialogo.Lista3, &k))
            ACN(B:fac, CotizacionC(ItemLista(Dialogo.Lista3, &k),,,,Fsys,1,SI,Var('MONEEXTR')))
        ELSE
            ACN(BD:1, 1)
        ENDIF
    ENDIF
Proximo

IF Val(BD:2) = 1
    CrearDialogo
        ListBox; 'Arial,8,N';500;400
         'Especie'            ;A:1..A:fac;NO;;;;80;STRING
         'Cotizacion USD'     ;B:1..B:fac;SI;[Not Eqstr(Val(A:FLB), Var('MONEEXTR')) Y Val(B:FLB) > 0] O [Eqstr(Val(A:FLB), Var('MONEEXTR')) Y Val(B:FLB) = 1];'Cotizacion Invalida';;100;NUMERO;'###,###,###.########';
        FinListBox
    FinDialogo

    IF Not Ok
        Cancelar
    ENDIF
ENDIF

Recorrer&k 1, fac
    ACT(LM:1, Val(LM:1)~Val(A:&k)~'|')
    ACT(LP:1, Val(LP:1)~Val(B:&k)~'|')
Proximo

IF Val(BD:1) = 1
    ***---Se incluye moneda local. Pongo la cotizacion ingresada en el dialogo
    ACT(LM:1, Val(LM:1)~Var('MONELOCA')~'|')
    ACT(LP:1, Val(LP:1)~Fstr(1/Val(PR:2), 0, 8)~'|')
ENDIF

ACN(EL:1, Elementos(Val(LM:1)))

***---Resumen de Operaciones Financieras (Corto Plazo/Largo Plazo)
LinkearHoja('ROPFI0', 1, Fecha1 = Val(FE:1), Radio1 = Val(R:1), Precio1 = Val(PR:2), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)), Radio2 = Val(R:4), Vehiculo1='' )

***---Detalle de Inversiones/Toma de Fondos
Recorrer&k 1, Val(EL:1)
    LinkearHoja('INVFON', 1, Fecha1 = Val(FE:1), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)), Especie1 = ItemLista(Val(LM:1), &k), Radio1 = IIF(Val(R:4) = 0, 1, 0),  Radio3=4, Radio2 = 1, Precio1 = Num(ItemLista(Val(LP:1), &k)), Especie2 = Var('MONEEXTR'))

    LinkearHoja('TOMFON', 1, Fecha1 = Val(FE:1), Especie1 = ItemLista(Val(LM:1), &k), Radio1 = IIF(Val(R:4) = 0, 1, 0), Radio2 = 1, Precio1 = Num(ItemLista(Val(LP:1), &k)), Especie2 = Var('MONEEXTR'), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)),Lista2='')

    ***---Detalle de Cuentas Corrientes Remuneradas
    LinkearHoja('CCREMU', 1, Fecha1 = Val(FE:2), Fecha2 = Val(FE:3), Especie1 = ItemLista(Val(LM:1), &k), Cliente1 = Val(CL:2), Radio4 = Val(R:4), Precio1 = Num(ItemLista(Val(LP:1), &k)), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)), Radio1 = IIF(Val(R:2) = 0, 1, 0))
    ***---Detalle de Operaciones en Titulos Publicos y Privados
    LinkearHoja('DETOPE', 1, Fecha1 = Val(FE:2), Fecha2 = Val(FE:3), Especie1 = ItemLista(Val(LM:1), &k), Radio4 = Val(R:4), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)),Especie2='')
Proximo

***---Detalle de Prestamos Financieros
LinkearHoja('PRESTF', 1, Fecha1 = Val(FE:1), Especie1 = Val(ES:3), Cliente1 = Val(CL:1), Radio1 = 1, Radio3 = Val(R:4),vehiculo1='', NrOperacion1 = Val(NR:1), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)), Lista2 = IIF(NoVacio(Val(LS:20)), Val(LS:4), Val(LS:2)))

***---Detalle de O.N. / Prestamos Sindicados
LinkearHoja('POONSI', 1, Fecha1 = Val(FE:1), Especie1 = Val(ES:3), Cliente1 = Val(CL:1), Radio1 = 1, Radio3 = Val(R:4), NrOperacion1 = Val(NR:1), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)), Lista2 = IIF(NoVacio(Val(LS:20)), Val(LS:4), Val(LS:2)))

***---Detalle de Operaciones Derivadas (Swaps)
LinkearHoja('PPOSWA', 1, Fecha1 = Val(FE:1), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)), Radio1 = IIF(Val(R:4) = 0, 1, 0), Radio2 = 1)

Message('***---Detalle de Caidas de Deuda Mensuales 1')
LinkearHoja('CAIDA8', 1, Fecha1 = Val(FE:1), Fecha2 = Val(FE:2), Fecha3 = Val(FE:3), Especie1=Val(ES:3), Cliente1 = Val(CL:1), Check1 = Val(CH:1), Check2 = Val(CH:2), Check3 = Val(CH:3), Radio1 = 1, Radio3 = 1, Radio5=1, Radio4 = Val(R:4), Lista2 = IIF(NoVacio(Val(LS:20)), Val(LS:20), Val(LS:5)),Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)) ) 

Message('***---Detalle de Caidas de Deuda Mensuales 2')
***---Detalle de Caidas de Deuda Diarias
LinkearHoja('CAIDA8', 1, Fecha1 = Val(FE:1), Fecha2 = Val(FE:2), Fecha3 = Val(FE:3), Especie1=Val(ES:3), Cliente1 = Val(CL:1), Check1 = Val(CH:1), Check2 = Val(CH:2), Check3 = Val(CH:3), Radio1 = 1, Radio3 = 0, Radio5=1, Radio4 = Val(R:4), Lista2 = IIF(NoVacio(Val(LS:20)), Val(LS:20), Val(LS:5)), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)) )

Message('***---Detalle de Caidas de Deuda Mensuales 3')
***---Detalle de Caidas de Deuda Anual
LinkearHoja('CAIDA8', 1, Fecha1 = Val(FE:1), Fecha2 = Val(FE:2), Fecha3 = Val(FE:3), Especie1 = Val(ES:3), Cliente1 = Val(CL:1), Check1 = Val(CH:1), Check2 = Val(CH:2), Check3 = Val(CH:3), Radio1 = 1, Radio3 = 2, Radio5=1, Radio4 = Val(R:4),Lista2 = IIF(NoVacio(Val(LS:20)), Val(LS:20), Val(LS:5)), Lista1 = IIF(Val(R:1)=0, Val(LS:1), Val(LS:10)) )

HojaVisible(NO)