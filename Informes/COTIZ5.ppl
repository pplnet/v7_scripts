MostrarCuadroDeMensajes
CrearDialogo
  Fecha1: 'D.Fecha'    ;;;;;;;;;fsys
  Fecha2: 'H.Fecha'    ;;;;;;;;;fsys
  Lista2: 'Especies' ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES ");
Findialogo

If not OK 
  Cancelar
Endif

CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial, 8,I")
CrearFont(4,"Arial, 8,")
CrearFont(5,"Arial, 8,BI")

ACT(A:1, 'Pizarra por rango de fechas:  '~Fecha(Dialogo.Fecha1)~' al '~Fecha(Dialogo.Fecha2))
ACT(a:2, 'Especies: '~iif(vacio(Dialogo.Lista2),'Todas',Pipe2Comillas(Dialogo.Lista2)))
SetFont(A:1..a:2,2)

SetFilaActual(4)

ACT(a:fac,   'Fecha')
ACT(b:fac,   'Especie')
ACT(c:fac,   'Nombre')
ACT(d:fac,   'Moneda')
*ACT(d:fac,   'Expresada en')
*ACT(d:fac+1, '(Oper.y Contab)')
ACT(e:fac,   'Precio')
ACT(e:fac+1, 'Operativo')
ACT(f:fac,   'Precio')
ACT(f:fac+1, 'Contable')
ACT(g:fac,   'Precio')
ACT(g:fac+1, 'Revaluo $')
SetFont(a:fac..g:fac+1,2)
AlinearCeldas(a:fac..g:fac+1,'C')
AgregarMarco(a:fac..g:fac+1,1,0,Exe('COLOR6'))
ifa

SQL.ADD(" SELECT E.Codigo, C.Fecha, C.Precio1, C.PrecioContable, E.Nombre, C.Precio5, C.FechaEj, E.Cotiza, c.Moneda  ")
SQL.ADD(" FROM "~DBO~".PIZARRACOTIZACIONES C, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE C.Codigo = E.Codigo ")
SQL.ADD(" AND   C.Fecha >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   C.Fecha <= "~IdxDate2(Dialogo.Fecha2)~" ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND  E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
SQL.ADD(" ORDER BY E.Codigo, C.FechaEj, C.Fecha ")
ACN(z:1, 0)

Recorrer SQL

  message(fbn('Codigo'))
  ACN(z:1, 1)
  ACD(a:fac, fbn('Fecha'))
  ACT(b:fac, fbn('Codigo'))
  ACT(c:fac, fbn('Nombre'))
  IF NOVACIO(fbn('FechaEj'))
     ACT(c:fac, vAL(c:fac)~' - '~fbn('FechaEj'))
  Endif
  ACT(d:fac, fbn('Moneda'))
  ACN(e:fac, fbn('Precio1'))
  ACN(f:fac, fbn('PrecioContable'))
  ACN(g:fac, fbn('Precio5'))
  SetFont(a:fac..z:fac,4)
  FormatoCeldas(e:fac..g:fac,EXE('F9'))

