ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"                          ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
  Fecha1     : "Fecha"                             ; ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Mercado1   : "Ubicacion"                         ; ; ;;;;Vacio(Dialogo.MERCADO1) o [NoVacio(Dialogo.MERCADO1) y NoVacio(BuscarCampo('Mercados','Codigo','Codigo',Dialogo.MERCADO1))];'Error en Ubicacion';NO;;;
  Radio1     : "Tipo Cliente|"~VAR('LABEL')~"|Caja|Todos" ;  ; ;;NO;NO;;;;2;
  Radio2     : "Moneda|Pesos|Dolares"              ; ; ;;;;;;;0;
  Lista1     : "Especies"                          ; ; ;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");
  ListaTabla3: "Oficial de Cta."                   ;0;2;;;;;;;;;;;;;'Descripcion' ; 'Codigo;Descripcion' ; 'OFICIALESCUENTA'
  ListaTabla2: 'Clientes'                          ;1;1;;;;;;;;;;;;IIF(Dialogo.Radio1<>2," "~IIF(Dialogo.Radio1=0," TipoCliente='"~VAR('CLISUD')~"' or TipoCliente Is Null"," TipoCliente='"~VAR('CLICAJA')~"' "),"1=1" );'Codigo' ; 'Codigo;RazonSocial' ; 'vCLIENTES01'
  Check1     : "Otro programa"                     ;1;3;;NO;NO;;;;0;
*  Lista3     : "Oficial de Cta."                   ; 0;2;;;;;;;;;SQLSet("SELECT Descripcion FROM "~DBO~".OFICIALESCUENTA ORDER BY Descripcion ");
FinDialogo

IF Not Ok
  Cancelar
ENDIF

IF Vacio(Dialogo.Lista1) y Dialogo.Check1 = 0
   IF MessageBox('Selecciono todas las Especies, ¨Continua?',0,2) = 7
      Cancelar
   ENDIF
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT C.OficialCuenta, O.Descripcion DescOfic, S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, ")
SQL.ADD("       S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       M.Descripcion DescMerc, EC.Descripcion DescEst, SUM(S1.Saldo) Saldo, E.InteresesC, S1.Cupon ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".MERCADOS M, "~DBO~".ESTADOSCUSTODIA EC, "~DBO~".OFICIALESCUENTA O ")
SQL.ADD("WHERE ")
SQL.ADD("      S1.Cliente = C.Codigo AND ")
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      E.Codigo = S1.Especie AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla3)
   SQL.ADD("   O.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla3)~") AND ")
ENDIF
SQL.ADD("      O.Codigo = C.OficialCuenta AND ")
IF Dialogo.Radio1 = 0
   *- Solamente Clientes SUDAMERIS
   SQL.ADD("   (C.TipoCliente = '"~VAR('CLISUD')~"' OR ")
   SQL.ADD("    C.TipoCliente IS NULL OR ")
   SQL.ADD("    C.TipoCliente = '      ') AND ")
EndIf
IF Dialogo.Radio1 = 1
   *- Solamente Clientes CAJA
   SQL.ADD(" C.TipoCliente = '"~VAR('CLICAJA')~"' AND ")
EndIf
SQL.ADD("      (S1.NrSaldo > 201  or S1.NrSaldo=101) AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Mercado = M.Codigo AND ")
SQL.ADD("      ((S1.NrSaldo-100=EC.NrSaldo and S1.NrSaldo>201) or (S1.NrSaldo= EC.NrSaldo and S1.NrSaldo=101)) AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE ")
SQL.ADD("                        S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon) ")
SQL.ADD("GROUP BY C.OficialCuenta, O.Descripcion, S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, ")
SQL.ADD("         S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, M.Descripcion, EC.Descripcion, E.InteresesC, S1.Cupon ")
SQL.ADD("ORDER BY C.OficialCuenta, S1.Especie, S1.Cupon, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo ")

ACT(d1, 'Saldo de Custodia por Oficial')
ACD(d2, Dialogo.Fecha1)
SetFont(d1..d2,3)
AlinearCeldas(d1..d2,'C')

ACT(i4, 'Fecha: '~Var('FECHASYS'))
ACT(a5, 'Moneda: '~IIF(Dialogo.Radio2=0, 'Pesos','Dolares'))
ACT(d5, "TipoCliente: "~IIF(Dialogo.Radio1=0, "~VAR('LABEL')~", IIF(Dialogo.Radio1=1, "Caja","Todos")))
IF NoVacio(Dialogo.VEHICULO1)
   ACT(a6, "Vehiculo: "~Dialogo.VEHICULO1)
ENDIF
IF NoVacio(Dialogo.MERCADO1)
   ACT(d6, "Ubicacion: "~Dialogo.MERCADO1)
ENDIF
If NoVacio(Dialogo.Lista1)
   ACT(a7, "Especies: "~Dialogo.Lista1)
EndIf
If NoVacio(Dialogo.ListaTabla3)
   ACT(a8, "Oficiales Cta.: "~Dialogo.ListaTabla3)
EndIf
If NoVacio(Dialogo.ListaTabla2)
   ACT(a9, "Clientes: "~Dialogo.ListaTabla2)
EndIf

SetFont(a4..i9,2)

ACT(a:10, 'Oficial')
ACT(b:10, 'Especie')
ACT(c:10, 'Cupon')
ACT(D:10, 'Ubic')
ACT(E:10, 'Cliente')
ACT(F:10, 'Cuenta')
ACT(G:10, 'Estado')
ACT(H:10, 'V.N.')
ACT(I:10, 'V.R.')
ACT(J:10, 'Valuacion')

SetFont(a:10..J:10,2)
AlinearCeldas(a:10..J:10,'C')
AgregarMarco(a:10..J:10,2,2,Exe('COLOR'))


* Variable Oficial
ACT(az4, '')
* Variable Especie
ACT(az2, '')
* Variable Mercado
ACT(az3, '')
* Variable Cliente
ACT(az5, '')
* Variable Cuenta
ACT(az6, '')

* Acumulador Oficial VN
ACN(ay4, 0)
* Acumulador Especie VN
ACN(ay2, 0)
* Acumulador Mercado VN
ACN(ay3, 0)

* Acumulador Oficial VR
ACN(ax4, 0)
* Acumulador Especie VR
ACN(ax2, 0)
* Acumulador Mercado VR
ACN(ax3, 0)

* Acumulador General Valuacion
ACN(aw1, 0)
* Acumulador Oficial Valuacion
ACN(aw4, 0)
* Acumulador Especie Valuacion
ACN(aw2, 0)
* Acumulador Mercado Valuacion
ACN(aw3, 0)

ACN(fi1, 11)
SetFilaActual(Val(fi1)-1)
Recorrer SQL

   IF Not EqStr(FBN['OficialCuenta'], Val(az4))
      IF Val(ay4) <> 0
         ACT(G:fac, 'Total Ubicacion --->')
         ACN(H:fac, Val(ay3))
         ACN(I:fac, Val(ax3))
         ACN(J:fac, Val(aw3))
         SetFont(G:fac..J:fac,2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         ifa
         ACT(G:fac, 'Total Especie --->')
         ACN(H:fac, Val(ay2))
         ACN(I:fac, Val(ax2))
         ACN(J:fac, Val(aw2))
         SetFont(G:fac..J:fac,2)
         ACN(ax2, 0)
         ACN(ay2, 0)
         ACN(aw2, 0)
         ifa
         ACT(G:fac, 'Total Oficial --->')
         ACN(H:fac, Val(ay4))
         ACN(I:fac, Val(ax4))
         ACN(J:fac, Val(aw4))
         SetFont(G:fac..J:fac,2)
         ACN(ax4, 0)
         ACN(ay4, 0)
         ACN(aw4, 0)
         SetFilaActual(fac+2)
      ENDIF
      ACT(a:fac, FBN['DescOfic'])
      ACT(az4, FBN['OficialCuenta'])
      ACT(b:fac, FBN['Especie']~' - '~FBN['Nombre'])
      ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACT(az2, FBN['Especie']~FBN['Cupon'])
      ACT(c:fac, FBN['Cupon'])
      ACT(D:fac, FBN['Mercado'])
      ***ACT(D:fac, FBN['DescMerc'])
      ACT(az3, FBN['Mercado'])
      ACT(E:fac, FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az5, FBN['Cliente'])
      ACT(F:fac, FBN['Cuenta'])
      ACT(az6, FBN['Cuenta'])
      SetFont(a:fac..D:fac,2)
   ENDIF

   IF Not EqStr(FBN['Especie']~FBN['Cupon'], Val(az2))
      IF Val(ay4) <> 0
         ACT(G:fac, 'Total Ubicacion --->')
         ACN(H:fac, Val(ay3))
         ACN(I:fac, Val(ax3))
         ACN(J:fac, Val(aw3))
         SetFont(G:fac..J:fac,2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         ifa
         ACT(G:fac, 'Total Especie --->')
         ACN(H:fac, Val(ay2))
         ACN(I:fac, Val(ax2))
         ACN(J:fac, Val(aw2))
         SetFont(G:fac..J:fac,2)
         ACN(ax2, 0)
         ACN(ay2, 0)
         ACN(aw2, 0)
         ifa
      ENDIF
      ACT(b:fac, FBN['Especie']~' - '~FBN['Nombre'])
      ACT(az2, FBN['Especie']~FBN['Cupon'])
      ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACT(c:fac, FBN['Cupon'])
      ACT(D:fac, FBN['Mercado'])
      ***ACT(D:fac, FBN['DescMerc'])
      ACT(az3, FBN['Mercado'])
      ACT(E:fac, FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az5, FBN['Cliente'])
      ACT(F:fac, FBN['Cuenta'])
      ACT(az6, FBN['Cuenta'])
      SetFont(b:fac..D:fac,2)
   ENDIF

   IF Not EqStr(FBN['Mercado'], Val(az3))
      IF Val(ay4) <> 0
         ACT(G:fac, 'Total Ubicacion --->')
         ACN(H:fac, Val(ay3))
         ACN(I:fac, Val(ax3))
         ACN(J:fac, Val(aw3))
         SetFont(G:fac..J:fac,2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         ifa
      ENDIF
      ACT(D:fac, FBN['Mercado'])
      ***ACT(D:fac, FBN['DescMerc'])
      ACT(az3, FBN['Mercado'])
      ACT(E:fac, FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az5, FBN['Cliente'])
      ACT(F:fac, FBN['Cuenta'])
      ACT(az6, FBN['Cuenta'])
      SetFont(D:fac,2)
   ENDIF

   IF Not EqStr(FBN['Cliente'], Val(az5))
   ACT(E:fac, FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
      ACT(az5, FBN['Cliente'])
      ACT(F:fac, FBN['Cuenta'])
      ACT(az6, FBN['Cuenta'])
   ENDIF

   IF Not EqStr(FBN['Cuenta'], Val(az6))
      ACT(F:fac, FBN['Cuenta'])
      ACT(az6, FBN['Cuenta'])
   ENDIF

   ACT(G:fac, FBN['DescEst'])
   ACN(H:fac, FBN['Saldo'])

   * (yu:fac..yz:fac)parametros para la funcion INTERESCLE 
   ACN(yt1, fac)
   ACD(yu:fac, Dialogo.Fecha1)
   ACT(yv:fac, FBN['Especie'])
   ACN(yw:fac, FBN['Saldo'])
   ACD(yx:fac, FBN['FechaCambioTasa'])
   ACN(yy:fac, FBN['TasaIntAnterior'])
   ACN(yz:fac, FBN['TasaIntVigente'])
   (.'INTERESCLE'.)
   ACN(ca:fac, Val(zz:fac))
   ACN(cb:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
   IF Dialogo.Radio2 = 0
      ACN(cD:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   ELSE
      ACN(cD:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   ENDIF

   ACN(I:fac, Val(H:fac)*Val(cb:fac))

   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(J:fac, Val(I:fac)*Val(cD:fac)+(Val(ca:fac)*Val(cD:fac)))
      ELSE
         ACN(J:fac, Val(I:fac)*Val(cD:fac)+Val(ca:fac))
      ENDIF      
   ELSE
      ACN(J:fac, Val(H:fac)*Val(cD:fac)+Val(ca:fac))
   ENDIF

   SCN(ay4, Val(H:fac))
   SCN(ax4, Val(I:fac))
   SCN(aw4, Val(J:fac))
   SCN(ay3, Val(H:fac))
   SCN(ax3, Val(I:fac))
   SCN(aw3, Val(J:fac))
   SCN(ay2, Val(H:fac))
   SCN(ax2, Val(I:fac))
   SCN(aw2, Val(J:fac))
   SCN(aw1, Val(J:fac))
Proximo

IF Val(ay4) <> 0
   ifa
   ACT(G:fac, 'Total Ubicacion --->')
   ACN(H:fac, Val(ay3))
   ACN(I:fac, Val(ax3))
   ACN(J:fac, Val(aw3))
   SetFont(G:fac..J:fac,2)
   ifa
   ACT(G:fac, 'Total Especie --->')
   ACN(H:fac, Val(ay2))
   ACN(I:fac, Val(ax2))
   ACN(J:fac, Val(aw2))
   SetFont(G:fac..J:fac,2)
   ifa
   ACT(G:fac, 'Total Oficial --->')
   ACN(H:fac, Val(ay4))
   ACN(I:fac, Val(ax4))
   ACN(J:fac, Val(aw4))
   SetFont(G:fac..J:fac,2)
   SetFilaActual(fac+2)
   ACT(G:fac, 'Total Valuacion --->')
   ACN(J:fac, Val(aw1))
   SetFont(G:fac..J:fac,2)
   SetFilaActual(fac+2)
ENDIF

FormatoCeldas(I:Val(fi1)..I:fac,Exe('F8'))

SetFilaActual(fac+4)
ACT(a:fac, 'Fin del Listado')

ACO(1,15)
ACO(2, 12)
ACO(3, 5)
ACO(4, 3)
ACO(5,20)
ACO(6, 8)
ACO(7,20)
ACO(8,10)
ACO(9,10)
ACO(10,10)

FijarFila(Val(fi1))
FijarCol(4)

LimitesVision(J:fac)
Impresion(1,2)
SetPrintFit(3,80)
RangoTitulo(a:1..J:fac, 10)