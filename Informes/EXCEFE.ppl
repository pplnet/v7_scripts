ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:   'Fecha' ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSYS
  Fecha2:   'Fecha' ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha Hasta Incorrecta';NO;FSYS
FinDialogo

If Not OK
  Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(f:2,'Fecha : '~Var('FECHASYS'))
SetFont(f:2..f:2,1)

ACT(a:FAC, 'Excepciones por Fecha')
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(A:FAC+1, 'Fechas : '~Dialogo.Fecha1~'/ '~Dialogo.Fecha2)
ACT(x1, "E.Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")

SetFilaActual(fac+3)

ACT(a:FAC, 'Tipo Op.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Cliente')
ACT(e:FAC, 'Tipo Excepcion')
ACT(f:FAC, 'Descripcion Excepcion')
ACT(g:FAC, 'Autorizado')
ACT(h:FAC, 'F.Excepcion')

AlinearCeldas(a:FAC..h:FAC,'I')
SetFont(a:Val(w1)..h:FAC,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select O.TipoOp, O.NrOperacion, Especie, Cliente1, Tipo, Fecha, Descripcion, ")
SQL.ADD(" Autorizado, E.NrOperacion No, O.PrecioEj, O.FechaEj")
SQL.ADD("From "~DBO~".OPERACIONES O, "~DBO~".EXCEPCIONES E ")
SQL.ADD("where O.NrOperacion = E.NrOperacion and "~Val(x1))
SQL.ADD(" order by E.Fecha,O.TipoOp, O.NrOperacion")

recorrer SQL
  IF Not EqStr(FBN['NrOperacion'],Val(M1))
     ACT(a:FAC, FBN['TipoOp'])
     ACT(b:FAC, FBN['NrOperacion'])
     ACLO(b:FAC, FBN['NrOperacion'])
     SetFont(a:fac..b:FAC,2)
     ACT(c:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     ACT(d:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
     ACT(m1,FBN['NrOperacion'])
  endif
  ACT(e:FAC, FBN['Tipo'])
  ACT(f:FAC, FBN['Descripcion'])
  ACT(g:FAC, FBN['Autorizado'])
  ACT(h:FAC, FBN['Fecha'])
proximo

SetFont(c:Val(w1)+4..H:FAC,1)

ACO(1,5)
ACO(2,6)
ACO(3,11)
ACO(4,16)
ACO(5,9)
ACO(6,35)
ACO(7,10)
ACO(8,7)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(h:FAC)
RangoTitulo(a:1..l:FAC, Val(w1)+5)
