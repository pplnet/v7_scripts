AlinearCeldas(a:fac..j:fac+1,'C')
AgregarMarco(a:fac..j:fac+1,0,0,Exe('COLOR6'))

ifa
ACT(z:1,'')
ACN(z:2,0)
ACN(z:3,0)

SQL.ADD("select DISTINCT T.Cliente1, C.RazonSocial, T.NrTrans, T.Fecha1, T.Fecha2, T.Especie, E1.Nombre NomEsp, T.Cantidad1, T.Especie1, E2.Nombre NomEsp1, T.Precio1, T.Cantidad2 ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E2, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where T.TipoTr2  = 'RESCAT' ")
SQL.ADD(" AND B.NrOperacion = T.NrTrans ")
SQL.ADD(" AND B.NrBit <> 40 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD("  and  T.Cliente1 = C.Codigo ")
SQL.ADD("  and  T.Especie  = E1.Codigo ")
SQL.ADD("  and  T.Especie1 = E2.Codigo ")
if NoVacio(Dialogo.Fecha3)
 SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Dialogo.Fecha1) )
endif
if NoVacio(Dialogo.Fecha4)
 SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha2) )
endif
if NoVacio(Dialogo.Fecha1)
 SQL.ADD("  and  T.Fecha2    >= "~IdxDate2(Dialogo.Fecha3) )
endif
if NoVacio(Dialogo.Fecha2)
 SQL.ADD("  and  T.Fecha2    <= "~IdxDate2(Dialogo.Fecha4) )
endif
if NoVacio(Dialogo.Especie1)
 SQL.ADD("  and  T.Especie    = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.CLiente1)
 SQL.ADD("  and  T.Cliente1   = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
 SQL.ADD("  and  T.Mercado1   = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("  and  T.RB1        = '0' ")
SQL.ADD("  and  T.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" order by T.Cliente1, T.NrTrans ")

recorrer SQL
 if not EqStr(fbn('Cliente1'),Val(z:1)) 
  ACT(z:1,fbn('Cliente1'))
  ACT(a:fac, fbn('RazonSocial'))
 endif
 ACT(b:fac, fbn('NrTrans'))
 ACLT(b:fac, fbn('NrTrans'))
 ACT(c:fac, fbn('Fecha1'))
 ACT(d:fac, fbn('Fecha2'))
 AlinearCeldas(c:fac..d:fac,'C')
 ACT(e:fac, fbn('NomEsp'))
 ACN(f:fac, fbn('Cantidad1'))
 FormatoCeldas(f:fac,Exe('F0'))
 ACT(g:fac, fbn('NomEsp1'))
 ACN(h:fac, fbn('Precio1'))
 FormatoCeldas(h:fac,Exe('FP4'))
 ACN(i:fac, fbn('Cantidad2'))
 FormatoCeldas(i:fac,Exe('F2'))
 if Num(SQL("select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~fbn('NrTrans')~"' ")) = 0
  ACT(j:fac,'Pendiente')
 else
  ACT(j:fac,'Confirmado')
 endif
 SetFont(a:fac..j:fac,4)
 if NoVacio(Dialogo.Especie1)
  ACT(aa:2,fbn('NomEsp'))
  SCN(z:2,fbn('Cantidad1'))
  ACT(aa:3,fbn('NomEsp1'))
  SCN(z:3,fbn('Cantidad2'))
 endif
proximo

if NoVacio(Dialogo.Especie1)
 ifa
 ACT(e:fac,Val(aa:2))
 ACN(f:fac,Val(z:2))
 FormatoCeldas(f:fac,Exe('F0'))
 ACT(g:fac,Val(aa:3))
 ACN(i:fac,Val(z:3))
 FormatoCeldas(i:fac,Exe('F2'))
 SetFont(e:fac..i:fac,2)
 AgregarMarco(e:fac..i:fac,0,0,Exe('COLOR6'))
endif

