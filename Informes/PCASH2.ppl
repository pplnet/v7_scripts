*HojaVisible(SI)
MostrarCuadroDeMensajes
CrearDialogo
   Vehiculo1 : 'Vehiculo'       ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo' ;NO;var('VEHICULODE')
   Especie1  : 'Especie'        ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;'USD';;;;;;;;;;
   Fecha1    : 'Desde Fecha'    ;;;;SI;;;;NO;FSys
   Fecha2    : 'Hasta Fecha'    ;;;;  ;;;;NO;Dialogo.Fecha1;Dialogo.Fecha1
   Lista1    : 'Mercados'       ;;;;;;NoVacio(Dialogo.Lista1);'Debe ingresar al menos un mercado';NO;;;SQLSet("Select Codigo from "~DBO~".MERCADOS Where Observaciones like '%M%' OR Observaciones like '%A%' ")
   Entero1   : 'Nrotipo'        ;;;;;;NoVacio(Dialogo.Entero1);'Debe ingresar un Nro Tipo';NO; 
FinDialogo
* Messagebox(Dialogo.Entero1)

if not Ok
   Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,10,')
CrearFont(5, 'Arial,12,B')

ACT(ac:1, VAR('MERCAACMC'))

********************************************************************************
** Ajustes No Operativos
********************************************************************************

If Dialogo.Entero1 = 102

    SetFilaActual(11)
    
    ACT(a:fac, 'Numero de Op.')
    ACT(b:fac, 'Cliente')
    ACT(c:fac, 'Fecha Mov.')
    ACT(d:fac, 'Leyenda')
    ACT(e:fac, 'Especie')
    ACT(f:fac, 'Bruto/Importe')
    ACT(g:fac, 'Cantidad Mov.'  )
    ACT(h:fac, 'Cuenta')
    ACT(i:fac, 'Mercado')
    ACT(b:9, 'Otros')
    ACO(1,  10)
    ACO(2,  20)
    ACO(3,  10)
    ACO(4,  25)
    ACO(5,  20)
    ACO(6,  10)
    ACO(7,  10)
    ACO(8,  10)
    ACO(9,  10)
    
    (.'QRYAJUSTEO'.)
    Recorrer SQL
        ACT(a:fac, fbn['NrOperacion'])
        ACLT(a:fac, fbn['NrOperacion'])
        ACT(b:fac, fbn['Cliente']~' - '~Copy(FBN['RazonSocial'],1,25))
        ACD(c:fac, fbn['FechaOp'])
        ACT(d:fac, fbn['Leyenda'])
        ACT(e:fac, fbn['Especie']~' - '~FBN['Nombre'])
        ACN(f:fac, fbn['Cantidad'])
        ACN(g:fac, fbn['Cantidad'])
        ACT(h:fac, fbn['Cuenta'])
        ACT(i:fac, fbn['Mercado'])
        SCN(xx:1,  fbn['Cantidad'])
    Proximo
    
    ACN(g:fac+2, val(xx:1))
    
    AgregarMarco(c:11..i:11,1,0,EXE('COLOR'))
    SetFont(c:12..c:fac, 2)
    SetFont(d:12..d:fac, 2)
    SetFont(e:12..e:fac, 2)
    SetFont(f:12..f:fac, 2)
    SetFont(g:12..g:fac, 2)
    SetFont(h:12..h:fac, 2)
    SetFont(i:12..i:fac, 2)
    SetFont(j:12..j:fac+2, 2)
    FormatoCeldas(f:12..g:fac+2,Exe('F2'))
    FormatoCeldas(h:12..h:fac,Exe('F8'))
    
Endif

