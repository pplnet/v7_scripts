SQL.Add("SELECT M.FechaMov, Sum(M.Cantidad) as Cantidad                               ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVEJECUTADOS M WITH (NOLOCK)      ")
SQL.Add("WHERE  T2.TipoTr2  in ('LCUPON','PDIVID')                                    ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo = 1                                                         ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" AND   M.Cliente = '"~Dialogo.Vehiculo1~"'                                   ")
SQL.ADD(" Group By M.FechaMov                                                         ")
SQL.Add("UNION ALL ")
SQL.Add("SELECT M.FechaMov, Sum(M.Cantidad)  as Cantidad                              ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVPENDIENTES M WITH (NOLOCK)      ")
SQL.Add("WHERE  T2.TipoTr2  in ('LCUPON','PDIVID')                                     ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo = 1                                                         ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" AND   M.Cliente = '"~Dialogo.Vehiculo1~"'                                   ")
SQL.ADD(" Group By M.FechaMov       ")      

Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:116, fbn['Cantidad'])
Proximo


********************************************
***** Intereses de CALL DE TITULOS 
********************************************
SQL.ADD(" Select   Case TipoOp                                   ")
SQL.ADD("          When 'TICO' then  O.TotalBrutoCli3            ")
SQL.ADD("          When 'TICT' then -O.TotalBrutoCli3            ")
** FJL 05/07/22 - Se Agregan Prestamos de Titulos
SQL.ADD("          When 'TIPO' then  O.TotalBrutoCli3            ")
SQL.ADD("          When 'TIDE' then -O.TotalBrutoCli3            ")
SQL.ADD("          END as  Cantidad, O.FechaVto                 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" where O.FechaVto   >= '"~IdxDate(Dialogo.Fecha1)~"'    ")
SQL.ADD(" and   O.FechaVto   <= '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" and   O.ContraEspecie = '"~Dialogo.Especie1~"'         ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion                  ")
SQL.ADD(" and   OB.Valor =  '1'                                  ")
SQL.ADD(" and   OB.NrBit <>  30                                  ")
SQL.ADD(" and O.Mercado2 in ("~pipe2comillas(Dialogo.Lista1)~")  ")
SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'              ")
** FJL 05/07/22 - Se Agregan Prestamos de Titulos
*SQL.ADD(" and O.TipoOp in ('TICO','TICT')                        ")
SQL.ADD(" and O.TipoOp in ('TICO','TICT','TIPO','TIDE')                        ")
Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaVto'],'ARG',SI)+1:116, fbn['Cantidad'])
Proximo

********************************************
* --- Movimientos de Cta Cte 
********************************************
SQL.ADD(" Select M.Cantidad, M.FechaMov  ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS OB, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" where M.FechaMov   >= '"~IdxDate(Dialogo.Fecha1)~"'    ")
SQL.ADD(" and   M.FechaMov   <= '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" and   O.Especie      = '"~Dialogo.Especie1~"'          ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion                  ")
SQL.ADD(" and   O.NrOperacion  = M.NrOperacion                   ")
SQL.ADD(" and   OB.Valor =  '1'                                  ")
SQL.ADD(" and   OB.NrBit <>  30                                  ")
SQL.ADD(" and   M.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and   M.Cliente   = '"~Dialogo.Vehiculo1~"'            ")
SQL.ADD(" and   O.TipoOp in ('CCDEP','CCRET')                    ")
SQL.ADD(" and   M.NrSaldo = 1 ")
Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:113, fbn['Cantidad'])
Proximo


****
**** Fallas del dia 
****
*** SOLO LAS FALLAS MATCH
SQL.ADD(" Select   Case TipoTr2                                                     ")
SQL.ADD("               When 'COMP' then 0                                          ")
SQL.ADD("               When 'MATCH' then Cantidad2                                 ")
SQL.ADD("               Else Cantidad1                                              ")
SQL.ADD("          END as  Cantidad1,                                               ")
SQL.ADD(" T2.Cantidad3 as Cantidad3, T2.TipoTr2                                     ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T2                                            ")
SQL.ADD(" where  T2.Fecha3 = '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" and T2.TipoTr2 in ('MATCH') and (T2.CB9='0' or T2.CB9 is NUll)            ")
SQL.ADD(" and ((T2.Especie = '"~Dialogo.Especie1~"' and T2.TipoTr2 != 'MATCH') or   ")
SQL.ADD("      (T2.Especie1 = '"~Dialogo.Especie1~"' and T2.TipoTr2 = 'MATCH'))     ")
SQL.ADD(" and  T2.CB3 = '1'                                                         ")
SQL.ADD(" and T2.Mercado1 in ("~pipe2comillas(Dialogo.Lista1)~")                    ")
SQL.ADD(" and T2.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                ")
Recorrer SQL
   if Vacio(fbn['Cantidad3'])
      if Incluido(fbn['TipoTr2'], 'RET|MATCH')
         SCN(AA115, fbn['Cantidad1'] * -1) 
      else
         SCN(AA115, fbn['Cantidad1'] )
      Endif
   else
      SCN(AA115, fbn['Cantidad3'])
   endif 
Proximo

IF NO
****Fallas, saco la resta de las fallas en el saldo de inicio
****MB 27/2/2006
****Vuelvo a Aplicar, la falla debe restar al saldo de inicio.
* --- FO 28/04/2006 --------------------------------------------------------------- *
* --- Esto ya no va porque ahora se corrigen los saldos en la generacion de fallas
SCN(AA101, -Val(AA115) )
* --------------------------------------------------------------------------------- * 
ENDIF

***** TODAS LAS FALLAS MENOS LAS MATCH
SQL.ADD(" Select   Case When TipoTr2 = 'COMP' then 0           ") 
SQL.ADD("               When TipoTr2 = 'MATCH' then Cantidad2  ")
SQL.ADD("               Else Cantidad1                         ")
SQL.ADD("          END as  Cantidad1,                          ")
SQL.ADD(" T2.Cantidad3 as Cantidad3, T2.TipoTr2, T2.Mercado1   ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T2                       ")
SQL.ADD(" where T2.Vehiculo1 = '"~Dialogo.Vehiculo1~"'         ")
SQL.ADD(" and   T2.TipoTr2 in ('DEP','RET','COMP', 'TRANSP')   ")
SQL.ADD(" and  ((T2.Especie  = '"~Dialogo.Especie1~"' and T2.TipoTr2 != 'MATCH') or ")
SQL.ADD("       (T2.Especie1 = '"~Dialogo.Especie1~"' and T2.TipoTr2 = 'MATCH'))    ")
SQL.ADD(" and   T2.Mercado1 in ("~pipe2comillas(Dialogo.Lista1)~")                  ")
* --- FO 28/04/2006 Ahora considera fallas AC si las hubiera
SQL.ADD(" and   (T2.CB9='0' or T2.CB9 is NUll OR T2.Mercado1 in("~pipe2comillas(Dialogo.Lista1)~") )     ")
SQL.ADD(" and   ( (T2.CB3 = '1' AND T2.Mercado1 not in("~Pipe2Comillas(Val(ac:1))~") ) OR (T2.RB6='2' AND T2.Mercado1 in("~Pipe2Comillas(Val(ac:1))~") ) ) ")
SQL.ADD(" and   ( (T2.Fecha3 = '"~IdxDate(Dialogo.Fecha1)~"' AND T2.Mercado1 Not in("~pipe2comillas(Dialogo.Lista1)~") ) OR    ")
SQL.ADD("         (T2.FechaTransp = '"~IdxDate(Dialogo.Fecha1)~"' AND T2.Mercado1 in("~pipe2comillas(Dialogo.Lista1)~") ) ) ")
* ---------------------------------------------------------------------------------- *
Recorrer SQL
   if Vacio(fbn['Cantidad3'])
      * --- FO 28/04/2006 - Los vouchers de AC son inversos al resto
      if [Incluido(fbn['TipoTr2'], 'RET|MATCH') y Not Incluido(fbn['Mercado1'],Dialogo.Lista1)] o [Incluido(fbn['TipoTr2'], 'DEP') y Incluido(fbn['Mercado1'], Dialogo.Lista1)]
         SCN(AA115, fbn['Cantidad1'] * -1) 
      else
         SCN(AA115, fbn['Cantidad1'] )
      Endif
   else
   If [Incluido(fbn['TipoTr2'], 'DEP') y Incluido(fbn['Mercado1'], Dialogo.Lista1)]
         SCN(AA115, -fbn['Cantidad3'])
      Else
         SCN(AA115, fbn['Cantidad3'])
      Endif
   endif 
Proximo

