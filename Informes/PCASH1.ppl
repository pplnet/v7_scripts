******************* CASHFLOW *************************************************
*
* (const) AA1: posicion del primer cuadro
* (const) AA2: posicion del segundo cuadro
* (const) AA3: cantidad de columnas (dias) por hoja
* (int)   AA5: cantidad de dias seleccionados
* (int)   AB1: EuroClear(1), No EuroClear(2) o Normal(3)
*
******************************************************************************
* MB FPA
* Falta la query de "Liquidados" - Mayo 2017 - JFB
******************************************************************************
 
HojaVisible(SI)

ACN(aa1, 8)
ACN(aa2, 30)
ACN(aa3, 5)

MostrarCuadroDeMensajes
CrearDialogo
   Vehiculo1 : 'Vehiculo'       ;;;;  ;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo' ;NO;var('VEHICULODE')
   Especie1  : 'Especie'        ;;;;  ;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;;;;;;;;;;;
   Fecha1    : 'Desde Fecha'    ;;;;SI;;DIALOGO.FECHA1 <=  DIALOGO.FECHA2 y EsHabil(DIALOGO.FECHA1,VAR('FERIDEF'));'La fecha hasta debe ser mayor a la fecha desde y debe ser habil';NO;FSys
   Fecha2    : 'Hasta Fecha'    ;;;;  ;;(DifDias(Dialogo.Fecha1, Dialogo.Fecha2,'ARG', SI)+1) <= 10;'El plazo no puede ser mayor a 10 dias habiles';NO;Habiles(DIALOGO.FECHA1,9,VAR('FERIDEF'));Habiles(DIALOGO.FECHA1,9,VAR('FERIDEF'))
   Lista1    : 'Mercados'       ;;;;  ;;NoVacio(Dialogo.Lista1);'Debe ingresar al menos un mercado';NO;;;SQLSet("Select Codigo from "~DBO~".MERCADOS Where Observaciones like '%M%' OR Observaciones like '%A%' ")
FinDialogo

if not Ok
   Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,10,')
CrearFont(5, 'Arial,12,B')

ACN(aa5, DifDias(Dialogo.Fecha1, Dialogo.Fecha2,'ARG', SI)+1)

ACT(ac:1, VAR('MERCAACMC'))

*****
* COPIADO DE DATOS AL FONDO DE LA PLANILLA
*****
*******************************************************************************************
**** Nueva busqueda por SaldosDia
********************************************************************************************

SQL.ADD("SELECT SUM(S1.Saldo) Saldo                                                          ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK)                                             ")
SQL.ADD("WHERE  S1.Especie = '"~Dialogo.Especie1~"'                                          ")
SQL.ADD("  AND  S1.EnteCustodia = '"~Dialogo.Vehiculo1~"'                                    ")
SQL.ADD("  AND  S1.Cliente = '"~Dialogo.Vehiculo1~"'                                         ")
SQL.ADD("  AND  S1.Mercado   in ("~pipe2comillas(Dialogo.Lista1)~")                          ")
SQL.ADD("  AND  S1.NrSaldo in (1,5,100)                                                      ")
SQL.ADD("  AND  S1.Fecha = (SELECT MAX(S2.Fecha) FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK)     ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND                                 ")
SQL.ADD("                        S2.Especie = S1.Especie AND                                 ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND                       ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND                                 ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND                                 ")
SQL.ADD("                       (S2.Cuenta = S1.Cuenta   OR ((S1.Cuenta IS NULL OR S1.Cuenta  ='' OR S1.Cuenta  =' ') AND (S2.Cuenta   IS NULL OR S2.Cuenta  ='' OR S2.Cuenta  =' ' )) ) AND ")
SQL.ADD("                       (S2.Cupon  = S1.Cupon    OR ((S1.Cupon  IS NULL OR S1.Cupon   ='' OR S1.Cupon   =' ') AND (S2.Cupon    IS NULL OR S2.Cupon   ='' OR S2.Cupon   =' ' )) ) AND ")
SQL.ADD("                         S2.Fecha < '"~IdxDate(Dialogo.Fecha1)~"' )                  ")

Recorrer SQL
   SCN(AA101, fbn['Saldo'])
   Message('Saldo Inicial '~Val(aa:101))
Proximo


********************************************************************************
************* Ajustes No Operativos ********************************************
********************************************************************************

SQL.Add("SELECT M.FechaMov, Sum(M.Cantidad) as Cantidad                               ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVEJECUTADOS M WITH (NOLOCK)      ")
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" AND   M.Mercado in ("~pipe2comillas(Dialogo.Lista1)~")                      ")
SQL.ADD(" Group By M.FechaMov                                                         ")
SQL.ADD(" UNION ALL                                                                      ")
SQL.Add("SELECT M.FechaMov, Sum(M.Cantidad) as Cantidad                               ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".MOVPENDIENTES M WITH (NOLOCK)      ")
SQL.Add("WHERE  T2.TipoTr2  in ('TRNOP','DENOP','RENOP')                              ")
SQL.Add(" AND   T2.NrTrans = M.NrOperacion                                            ")
SQL.Add(" AND   M.Especie  =  '"~Dialogo.Especie1~"'                                  ")
SQL.ADD(" AND   M.FechaMov  >= '"~IdxDate(Dialogo.Fecha1)~"'                          ")
SQL.ADD(" AND   M.FechaMov  <= '"~IdxDate(Dialogo.Fecha2)~"'                          ")
SQL.ADD(" AND   M.NrSaldo  = 1                                                        ")
SQL.ADD(" AND   M.EnteCustodia = '"~Dialogo.Vehiculo1~"'                              ")
SQL.ADD(" AND   M.Mercado in ("~pipe2comillas(Dialogo.Lista1)~")                      ")
SQL.ADD(" Group By M.FechaMov                                                         ")
Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaMov'],'ARG',SI)+1:102, fbn['Cantidad'])
Proximo

