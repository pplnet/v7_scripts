SQL.ADD(" where O.FechaOp  >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" and   O.FechaOp  <= '"~IdxDate(Dialogo.Fecha2)~"'  ")
SQL.ADD(" and   O.Especie   = '"~Dialogo.Especie1~"'         ")
SQL.ADD(" and   O.NrOperacion  = OB.NrOperacion              ")
SQL.ADD(" and   OB.Valor =  '1'                              ")
SQL.ADD(" and   OB.NrBit <>  30                              ")
SQL.ADD(" and   O.Mercado in ("~pipe2comillas(Dialogo.Lista1)~") ")
SQL.ADD(" and   O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'        ")
SQL.ADD(" and   O.TipoOp in ('PMU','PME','MMPICO')           ")

Recorrer SQL
   SCN(26+DifDias(Dialogo.Fecha1, fbn['FechaOp'],'ARG',SI)+1:108, fbn['Cantidad'])
