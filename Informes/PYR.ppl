MostrarCuadroDeMensajes
GrillaVisible(NO)
CrearDialogo
 Fecha1   : 'Fecha'                         ;;;;;;;;;fsys
 Especie1 : 'Especie'                       ;;;;;;Vacio(Dialogo.Especie1) O [DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y EsTerminal(Dialogo.Especie1, Especie)];'Debe ingresar un Titulo';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "
 Especie2 : 'Moneda E.'                     ;;;;;;Vacio(Dialogo.Especie2) O [DesciendeDeEspecie(Dialogo.Especie2,'MONEDA') y EsTerminal(Dialogo.Especie2, Especie)];'Debe ingresar una Moneda';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' " 
 Vehiculo1: 'Vehiculo'
 Check3   : 'Inc.Resultados'                ;;;;;;;;;1
 Lista1   : 'Book'                          ;0;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
FinDialogo
 
IF NOT OK
  Cancelar
Endif
CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')
CrearFont(5, 'Arial,12,B')

 

SetFilaActual(1)
ACT(D:fac, 'Posiciones y Resultados de Titulos')
SetFont(D:fac, 5)

ACD(FF:1,Habiles(Dialogo.Fecha1,-1,'ARG'))
ACD(GG:1,Habiles(Dialogo.Fecha1,-2,'ARG'))
ACN(TA:1,SQL("Select top 1 Valor1 from "~DBO~".TASASDIA where TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and Especie='ARP'  order by Fecha desc "))
ACN(TA:2,SQL("Select top 1 Valor1 from "~DBO~".TASASDIA where TipoTasa='TRANSF' and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and Especie='USD'  order by Fecha desc "))
ACN(US:1,SQL("Select top 1 Precio1 from "~DBO~".COTIZACIONES where Fecha<='"~IdxDate(Val(FF:1))~"' and Codigo='USD' and CallPut='CON'  order by Fecha desc "))
ACN(US:2,SQL("Select top 1 Precio1 from "~DBO~".COTIZACIONES where Fecha<='"~IdxDate(Val(GG:1))~"' and Codigo='USD' and CallPut='CON'  order by Fecha desc "))


SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ACT(A:fac+1, 'Especie: '~iif(novacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ACT(A:fac+2, 'Moneda: '~iif(novacio(Dialogo.Especie1),Dialogo.Especie2,'Todas'))
ACT(A:fac+3, 'Vehiculo: '~iif(novacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
If NoVacio(Dialogo.Lista1)
  ACT(B:fac+3, 'Book : '~Pipe2Comillas(Dialogo.Lista1))
Else
  ACT(B:fac+3, 'Book : Todos')
Endif

ACT(b:Fac, 'Dolar Ref.: '~Val(US:1))

ACT(b:Fac+1, 'Transfer en Pesos%: '~Val(TA:1))

ACT(b:Fac+2, 'Transfer en Dolares%: '~Val(TA:2))


IFA
SetFont(A:fac-1..B:fac+2, 2)
 
SetFilaActual(Fac+4)
ACT(A:Fac,'Especie')
ACT(B:Fac,'Book')
ACT(C:Fac,'Cuenta')
ACT(D:Fac,'')
ACD(E:Fac,Habiles(Dialogo.Fecha1,0,'ARG'))
ACD(F:Fac,Habiles(Dialogo.Fecha1,1,'ARG'))
ACD(G:Fac,Habiles(Dialogo.Fecha1,2,'ARG'))
ACT(H:Fac,'Garantias')
ACT(I:Fac,'Posicion Concertada')
ACT(J:Fac,'PPC')
ACT(K:Fac,'P.Merc/TIR')
ACT(L:Fac,'PPP')
ACT(M:Fac,'Monto Invertido')
ACT(N:Fac,'Valor Hoy')
ACT(P:Fac-1,'Analisis de Resultado del dia')
ACT(O:Fac,'Resultado Bruto')
ACT(P:Fac,'C. de Fondeo')
ACT(Q:Fac,'Resultado Neto')
*ACT(R:Fac,'Por Variacion de TC USD')
*ACT(S:Fac,'Rdo Neto + Var TC')
ACT(U:Fac-1,'Analisis de Resultado del Mes')
ACT(T:Fac,'Resultado Bruto')
ACT(U:Fac,'C. de Fondeo')
ACT(V:Fac,'Resultado Neto')
*ACT(W:Fac,'Por Variacion de TC USD')
*ACT(X:Fac,'Rdo Neto + Var TC')

SetFont(A:fac-1..X:fac, 2)
AgregarMarco(A:fac..N:fac,0,0,EXE('COLOR6'))
AgregarMarco(O:fac..S:fac,0,0,EXE('COLOR6'))
AgregarMarco(T:fac..X:fac,0,0,EXE('COLOR6'))
AgregarMarco(O:fac-1..S:fac-1,0,0,EXE('COLOR6'))
AgregarMarco(T:fac-1..X:fac-1,0,0,EXE('COLOR6'))
AlinearCeldas(A:fac..X:fac, 'C')

ACN(US:3,Val(US:1)-Val(US:2))

SQL.ADD(" SELECT  DISTINCT P.Especie,'T0' as Instancia, P.Estrategia, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, E.Fecha,E.Cupon, E.Extendido, ")
SQL.ADD(" P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, P.Precio2, P.Precio1, ")
SQL.ADD(" P.PrecioIni, E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion,")
SQL.ADD("  E.MonedaEmision, P.Book, P.PrecioFin, P.Fecha, P.TipoNegocio ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V  ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   E.Jerarquia like ('"~Jerarquia('ESPECIES','TITULO')~"%') ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Val(E:Fac))~" and P.NrSaldo in ('121','122') AND Estrategia not in ("~Pipe2Comillas(VAR('CTAGARANT'))~") ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
If NoVacio(Dialogo.Lista1)
 SQL.ADD(" and P.Book in( "~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif

SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
 SQL.ADD("                  AND   P1.Estrategia = P.Estrategia  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.TipoNegocio = P.TipoNegocio OR ((P1.TipoNegocio IS NULL OR P1.TipoNegocio  ='' OR P1.TipoNegocio  =' ') AND (P.TipoNegocio IS NULL OR P.TipoNegocio ='' OR P.TipoNegocio =' ' ))) ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Val(E:Fac))~" ")
SQL.ADD("                  ) ")
SQL.ADD(" UNION ")
 
SQL.ADD(" SELECT  DISTINCT P.Especie,'T1' as Instancia,P.Estrategia, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, E.Fecha,E.Cupon, E.Extendido, ")
SQL.ADD(" P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, P.Precio2, P.Precio1, ")
SQL.ADD(" P.PrecioIni, E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion,")
SQL.ADD("  E.MonedaEmision, P.Book, P.PrecioFin, P.Fecha, P.TipoNegocio ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   E.Jerarquia like ('"~Jerarquia('ESPECIES','TITULO')~"%') ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Val(F:Fac))~" and P.NrSaldo in ('122') AND Estrategia not in ("~Pipe2Comillas(VAR('CTAGARANT'))~") ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
if NoVacio(Dialogo.Lista1)
 SQL.ADD(" and P.Book in( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES  P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
 SQL.ADD("                  AND   P1.Estrategia = P.Estrategia  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.TipoNegocio = P.TipoNegocio OR ((P1.TipoNegocio IS NULL OR P1.TipoNegocio  ='' OR P1.TipoNegocio  =' ') AND (P.TipoNegocio IS NULL OR P.TipoNegocio ='' OR P.TipoNegocio =' ' ))) ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Val(F:Fac))~" ")
SQL.ADD("                  ) ")
SQL.ADD(" UNION ")
SQL.ADD(" SELECT  DISTINCT P.Especie,'T2' as Instancia, P.Estrategia, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, E.Fecha,E.Cupon, E.Extendido,")
SQL.ADD(" P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, P.Precio2, P.Precio1, ")
SQL.ADD(" P.PrecioIni, E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion,")
SQL.ADD("  E.MonedaEmision, P.Book, P.PrecioFin, P.Fecha, P.TipoNegocio ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   E.Jerarquia like ('"~Jerarquia('ESPECIES','TITULO')~"%') ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Val(G:Fac))~" and P.NrSaldo in ('122')  AND Estrategia not in ("~Pipe2Comillas(VAR('CTAGARANT'))~") ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
if NoVacio(Dialogo.Lista1)
 SQL.ADD(" and P.Book in( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
 SQL.ADD("                  AND   P1.Estrategia = P.Estrategia  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.TipoNegocio = P.TipoNegocio OR ((P1.TipoNegocio IS NULL OR P1.TipoNegocio  ='' OR P1.TipoNegocio  =' ') AND (P.TipoNegocio IS NULL OR P.TipoNegocio ='' OR P.TipoNegocio =' ' ))) ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Val(G:Fac))~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo,P.Especie, P.Book,P.Estrategia, P.NrSaldo,Instancia")
Watch(SQL.Batch())
RECORRER SQL
  ACT(AA:Fac,Fbn['Especie'])
  If EqStr(Fbn['Especie'],Val(ES:1)) Y EqStr(Fbn['Estrategia'],Val(ET:1)) Y EqStr(Fbn['Book'],Val(BO:1))
     DFA
     If Fbn['NrSaldo'] = 122
        If EQSTR(Fbn['Instancia'],'T0')
            ACN(E:Fac,Fbn['CantidadFin'] + SQL(" Select Sum(Cantidad) From "~DBO~".MOVPOSPEN Where Especie = '"~fbn('Especie')~"' AND NrSaldo = 122 AND Cliente = '"~fbn('Vehiculo')~"' AND Estrategia = '"~fbn('Estrategia')~"' AND Book = '"~fbn('Book')~"' AND FechaMov <= '"~IdxDate(Val(E:8))~"' "))
           ACN(EE:Fac,Fbn['CantidadIni'])
           ACN(II:Fac,Fbn['PrecioIni'])
           ACT(AA:Fac,Fbn['Especie'])
           ACT(BB:Fac,Fbn['Book'])
           ACT(CC:Fac,Fbn['Estrategia'])
           Watch(Val(E:9))
           IF 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSEJE where FechaMov='"~IdxDate(Val(E:8))~"' and Especie= '"~Val(AA:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=122  ")) O 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSPEN where FechaMov='"~IdxDate(Val(E:8))~"' and Especie= '"~Val(AA:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=122  "))
            ACL(E:fac, 'DPYR',Fecha1 =Val(E:8), Especie1=Val(AA:FAC),Book1=Val(BB:FAC),Radio2=2, String1=Val(C:FAC),Entero1=Val(EE:FAC),Entero2=Val(II:FAC))
           EndIf
        EndIf
        If EQSTR(Fbn['Instancia'],'T1')
           ACN(F:Fac,Fbn['CantidadFin'] + SQL(" Select Sum(Cantidad) From "~DBO~".MOVPOSPEN Where Especie = '"~fbn('Especie')~"' AND NrSaldo = 122 AND Cliente = '"~fbn('Vehiculo')~"' AND Estrategia = '"~fbn('Estrategia')~"' AND Book = '"~fbn('Book')~"' AND FechaMov <= '"~IdxDate(Val(F:8))~"' "))
           ACN(EE:Fac,Fbn['CantidadIni'])
           ACN(II:Fac,Fbn['PrecioIni'])
           ACT(AA:Fac,Fbn['Especie'])
           ACT(BB:Fac,Fbn['Book'])
           ACT(CC:Fac,Fbn['Estrategia'])
           IF 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSEJE where FechaMov='"~IdxDate(Val(F:8))~"' and Especie= '"~Val(AA:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=122  ")) O 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSPEN where FechaMov='"~IdxDate(Val(F:8))~"' and Especie= '"~Val(AA:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=122  "))
            ACL(F:fac, 'DPYR',Fecha1 =Val(F:8), Especie1=Val(AA:FAC),Book1=Val(BB:FAC),Radio2=2, String1=Val(C:FAC),Entero1=Val(EE:FAC),Entero2=Val(II:FAC))
           EndIf
        EndIf
        If EQSTR(Fbn['Instancia'],'T2')
        ACN(G:Fac,Fbn['CantidadFin'] + SQL(" Select Sum(Cantidad) From "~DBO~".MOVPOSPEN Where Especie = '"~fbn('Especie')~"' AND NrSaldo = 122 AND Cliente = '"~fbn('Vehiculo')~"' AND Estrategia = '"~fbn('Estrategia')~"' AND Book = '"~fbn('Book')~"' AND FechaMov <= '"~IdxDate(Val(G:8))~"'"))
           ACN(EE:Fac,Fbn['CantidadIni'])
           ACN(II:Fac,Fbn['PrecioIni'])
           ACT(AA:Fac,Fbn['Especie'])
           ACT(BB:Fac,Fbn['Book'])
           ACT(CC:Fac,Fbn['Estrategia'])
           IF 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSEJE where FechaMov='"~IdxDate(Val(G:8))~"' and Especie= '"~Val(AA:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=122  ")) O 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSPEN where FechaMov='"~IdxDate(Val(G:8))~"' and Especie= '"~Val(AA:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=122  "))
            ACL(G:fac, 'DPYR',Fecha1 =Val(G:8), Especie1=Val(AA:FAC),Book1=Val(BB:FAC),Radio2=2, String1=Val(C:FAC),Entero1=Val(EE:FAC),Entero2=Val(II:FAC))
           EndIf
        EndIf
      EndIf
  Else
     IF (not EqStr(Fbn['Especie'],Val(ES:1))) o Val(FL:2)=0
        ACN(FL:2,1)
         **Distinta Especie
         *DFA
        ACT(A:Fac,Fbn['Especie']~'- Cupon '~Fbn['Cupon'])
        ACT(AA:Fac,Fbn['Especie'])
        SetFont(A:fac..A:fac, 2)
        IFA
        ACT(A:Fac,Fbn['Extendido'])
        AgregarMarco(A:fac-1..X:fac,0,0,EXE('COLOR9'))
        IFA
        ACT(B:Fac,Fbn['Book'])
        AgregarMarco(B:fac..X:fac,0,0,EXE('COLOR9'))
        IFA
        ACT(C:Fac,Fbn['Estrategia'])
        If Fbn['NrSaldo'] = 121
           ACN(J:Fac,Fbn['Precio1']) 
           ACN(L:Fac,Fbn['PrecioFin']) 
           ACN(I:Fac,Fbn['CantidadFin'])
           ACT(AA:Fac,Fbn['Especie'])
           ACT(BB:Fac,Fbn['Book'])
           ACT(CC:Fac,Fbn['Estrategia'])
           ACN(EE:Fac,Fbn['CantidadIni'])
           ACN(II:Fac,Fbn['PrecioIni'])
           IF 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSEJE where FechaMov='"~IdxDate(Dialogo.Fecha1)~"' and Especie= '"~Val(AA:FAC)~"' and Book='"~Val(BB:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and NrSaldo=121  "))
              ACL(I:fac, 'DPYR',Fecha1 =Dialogo.Fecha1, Especie1=Val(AA:FAC),Book1=Val(BB:FAC),Radio2=0, String1=Val(CC:FAC),Entero1=Val(EE:FAC),Entero2=Val(II:FAC))
           EndIf
           ACN(K:fac, COTIZACIONC(fbn['Especie'],'CON',,,Dialogo.Fecha1,1,SI,'ARP'))
           ACN(M:Fac,Val(L:Fac)*Val(I:Fac))
           ACN(N:Fac,Val(K:Fac)*Val(I:Fac))
        EndIf
     Else
        IF not EqStr(Fbn['Book'],Val(BO:1))
           **Distinto Book
           ACT(B:Fac,Fbn['Book'])
           AgregarMarco(B:fac..X:fac,0,0,EXE('COLOR9'))
           IFA
           ACT(C:Fac,Fbn['Estrategia'])
           If Fbn['NrSaldo'] = 121
             ACN(J:Fac,Fbn['Precio1']) 
             ACN(L:Fac,Fbn['PrecioFin']) 
             ACN(I:Fac,Fbn['CantidadFin'])
             ACT(AA:Fac,Fbn['Especie'])
             ACT(BB:Fac,Fbn['Book'])
             ACT(CC:Fac,Fbn['Estrategia'])
             ACN(EE:Fac,Fbn['CantidadIni'])
             ACN(II:Fac,Fbn['PrecioIni'])
             IF 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSEJE where FechaMov='"~IdxDate(Dialogo.Fecha1)~"' and Especie= '"~Val(AA:FAC)~"' and Book='"~Val(BB:FAC)~"' and Estrategia='"~Val(CC:FAC)~"' and NrSaldo=121  "))
                ACL(I:fac, 'DPYR',Fecha1 =Dialogo.Fecha1, Especie1=Val(AA:FAC),Book1=Val(BB:FAC),Radio2=0, String1=Val(CC:FAC),Entero1=Val(EE:FAC),Entero2=Val(II:FAC))
             EndIf
             ACN(K:fac, COTIZACIONC(fbn['Especie'],'CON',,,Dialogo.Fecha1,1,SI,'ARP'))
             ACN(M:Fac,Val(L:Fac)*Val(I:Fac))
             ACN(N:Fac,Val(K:Fac)*Val(I:Fac))
           EndIf
        Else
           **Distinta Estrategia
           ACT(C:Fac,Fbn['Estrategia'])
           If Fbn['NrSaldo'] = 121
              ACN(J:Fac,Fbn['Precio1']) 
              ACN(L:Fac,Fbn['PrecioFin']) 
              ACN(I:Fac,Fbn['CantidadFin'])
              ACT(AA:Fac,Fbn['Especie'])
              ACT(BB:Fac,Fbn['Book'])
              ACT(CC:Fac,Fbn['Estrategia'])
              ACN(EE:Fac,Fbn['CantidadIni'])
              ACN(II:Fac,Fbn['PrecioIni'])
              IF 1= NUM(SQL(" Select  Top 1 1 from "~DBO~".MOVPOSEJE where FechaMov='"~IdxDate(Dialogo.Fecha1)~"' and Especie= '"~Val(AA:FAC)~"' and Book='"~Val(BB:FAC)~"' and NrSaldo=121  "))
                 ACL(I:fac, 'DPYR',Fecha1 =Dialogo.Fecha1, Especie1=Val(AA:FAC),Book1=Val(BB:FAC),Radio2=0, String1=Val(CC:FAC),Entero1=Val(EE:FAC),Entero2=Val(II:FAC))
              EndIf
              ACN(K:fac, COTIZACIONC(fbn['Especie'],'CON',,,Dialogo.Fecha1,1,SI,'ARP'))
              ACN(M:Fac,Val(L:Fac)*Val(I:Fac))
              ACN(N:Fac,Val(K:Fac)*Val(I:Fac))
           EndIf
        EndIf
      EndIf  
   EndIf
   SQL.ADD(" SELECT SUM(Day) as Diario, SUM(MTD) as Mensual FROM "~DBO~".RESULTADOS R  ")
   SQL.ADD(" WHERE Especie   = '"~Fbn['Especie']~"'     ")
   SQL.ADD(" AND   NrSaldo   = 121  ")
   SQL.ADD(" AND   Vehiculo  = '"~Fbn['Vehiculo']~"'    ")
   SQL.ADD(" AND   Book      = '"~Fbn['Book']~"'        ")
   SQL.ADD(" AND   Estrategia = '"~Fbn['Estrategia']~"'        ")
   SQL.ADD(" AND   Fecha   = '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND   TipoResultado IN ('TRADE','REALIZ','REVAL') ")
   SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS R1 ")
   SQL.ADD("                 WHERE R.Especie  = R1.Especie  ")
   SQL.ADD("                 AND   R.NrSaldo  = R1.NrSaldo  ")
   SQL.ADD("                 AND   R.Vehiculo = R1.Vehiculo ")
   SQL.ADD("                 AND   R.Book     = R1.Book     ")
   SQL.ADD("                 AND   R.TipoResultado  = R1.TipoResultado    ")
   SQL.ADD("                 AND   (R.Sector   = R1.Sector   OR (R.Sector   IS NULL AND R1.Sector   IS NULL) ) ")
   SQL.ADD("                 AND   (R.CallPut  = R1.CallPut  OR (R.CallPut  IS NULL AND R1.CallPut  IS NULL) ) ")
   SQL.ADD("                 AND   (R.Cupon    = R1.Cupon    OR (R.Cupon    IS NULL AND R1.Cupon    IS NULL) ) ")
   SQL.ADD("                 AND   (R.FechaEj  = R1.FechaEj  OR (R.FechaEj  IS NULL AND R1.FechaEj  IS NULL) ) ")
   SQL.ADD("                 AND   (R.PrecioEj = R1.PrecioEj OR (R.PrecioEj IS NULL AND R1.PrecioEj IS NULL) ) ")
   SQL.ADD("                 AND   R1.Fecha  < = '"~IdxDate(Dialogo.Fecha1)~"' ) ")
   Watch(SQL.Batch())
   Recorrer SQL
      dfa
      ACN(O:Fac,Fbn['Diario']) 
      ACN(T:Fac,Fbn['Mensual'])  
   Proximo
   ***---ACN(H:Fac,SQL(" Select top 1 CantidadFin from "~DBO~".POSICIONES where NrSaldo=121 and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and Especie='"~Fbn['Especie']~"' and  Book='"~Fbn['Book']~"' and Estrategia in ("~Pipe2Comillas(VAR('CTAGARANT'))~") order by Fecha desc   "   ) )
   *ACN(H:fac, SQL(" Select Top 1 Saldo From "~DBO~".SALDOSDIA where NrSaldo=121 and Fecha<='"~IdxDate(Dialogo.Fecha1)~"' and Especie='"~Fbn['Especie']~"' and  Book='"~Fbn['Book']~"' and Estrategia in ("~Pipe2Comillas(VAR('CTAGARANT'))~") order by Fecha desc    "))
   SQL.ADD(" Select Sum(S.Saldo) SaldoGar From "~DBO~".SALDOSDIA S ")
   SQL.ADD(" Where S.Especie = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND S.Cliente = '"~fbn('Vehiculo')~"' ")
   SQL.ADD(" AND S.NrSaldo > 108 ")
   SQL.ADD(" AND S.Cuenta = '"~Fbn('Estrategia')~"' ")
   SQL.ADD(" AND S.Fecha = (Select Max(S1.Fecha) From "~DBO~".SALDOSDIA S1 ")
   SQL.ADD("                Where S.Especie = S1.Especie ")
   SQL.ADD("                AND S.Cliente = S1.Cliente ")
   SQL.ADD("                AND S.NrSaldo = S1.NrSaldo ")
   SQL.ADD("                AND S.Cuenta = S1.Cuenta) ")
   *SQL.ADD(" Group By  ")
   SQL.ADD("  ")
   SQL.ADD("  ")
   SQL.ADD("  ")
   Recorrer SQL
    DFA
    ACN(H:fac, fbn('SaldoGar'))
   Proximo
  IF EqStr('ARP',Fbn['MonedaEmision'])
     ACN(TT:Fac,Val(TA:1))
  Else
     ACN(TT:Fac,Val(TA:2))
