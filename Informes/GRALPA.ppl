*GrillaVisible(NO)
CrearDialogo:2
  Vehiculo1  : 'Vehiculo'                           ;2;;;;;;;NO;VAR('VEHICULODE')
  Fecha1     : 'Fecha'                              ;3;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;FSys;
  Radio2     : 'Tipo|Por Concert.|Por Vto.|Vigente' ;5;;;;;;;;0;
FinDialogo

If Not OK
  Cancelar
Endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(2)
ACN(w1,FAC)

*-- Encabezado
ACT(a:FAC, 'Listado de Pases Extrabursatiles')
SetFont(a:FAC..a:FAC, 3)
ACT(a:FAC+2, 'Fecha : '~Dialogo.Fecha1)

If Dialogo.Radio2=0
   ACT(d:FAC+3, 'Tipo : Por Concertacion')
Endif

If Dialogo.Radio2=1
   ACT(d:FAC+3, 'Tipo : Por Vencimiento')
Endif

If Dialogo.Radio2=2
   ACT(d:FAC+3, 'Tipo: Vigente Ordenado por Fecha De Vencimiento.')
Endif

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+3, 'Vehiculo : '~Dialogo.Vehiculo1)
else
  ACT(a:FAC+3, 'Vehiculo : Todos')
endif

SetFont(a:FAC+2..d:FAC+5,2)
SetFilaActual(FAC+7)

*-- Rotulos del listado
ACT(a:FAC, '# Oper.')
ACT(b:FAC, 'Fecha Op.')
ACT(c:FAC, 'F.Liq.Spot')
ACT(d:FAC, 'Fecha Vto.')
ACT(e:FAC, 'Entidad')
ACT(f:FAC, 'T.Op.')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cant.Nominal')
ACT(i:FAC, 'Tasa')
ACT(j:FAC, 'Precio')
ACT(k:FAC, '% Af')
ACT(l:FAC, 'Prec.Af.')
ACT(m:FAC, 'Monto')
ACT(n:FAC, 'Monto Int.')
ACT(o:FAC, 'C.Cust.')
ACT(p:FAC, 'Liq')
ACT(q:FAC, 'Plazo')
ACT(r:FAC, 'Cartera')
ACT(s:FAC, 'Book')

AlinearCeldas(b:FAC..c:FAC,'D')
AlinearCeldas(h:FAC..n:FAC,'D')

SetFont(a:FAC..z:FAC,2)
AgregarMarco(a:FAC..s:FAC, 2,0,Exe('COLOR'))

*-- Seleccion de los pases segun los parametros de seleccion
SQL.ADD("SELECT NrOperacion, FechaOp, FechaVto, Cliente1, TipoOp, Cantidad, Precio3, Precio1, Precio2, TotalBrutoCli1, TotalBrutoCli2, Book1,FechaPago,")
SQL.ADD("       Especie, Mercado, Plazo, MB1, FormaLiquidacion1, FormaLiquidacion2, Cartera, TotalDerechos, TotalAux1, PorAforo, EsAforado,TotalCaucion, TotalGastos  ")
SQL.ADD("FROM "~DBO~".OPERACIONES ")
SQL.ADD("WHERE TipoOp In ('TIPA', 'TIPP') ")

If Dialogo.Radio2=0
   *-- Por Cencertacion
   SQL.ADD(" and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif

If Dialogo.Radio2=1
   *-- Por Vto
   SQL.ADD(" and FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif

If Dialogo.Radio2=2
   *-- Vigente
   SQL.ADD(" and FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto >=  '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif

If NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif

If Dialogo.Radio2<>2
  SQL.ADD("ORDER BY NrOperacion ")
Else
  SQL.ADD("ORDER BY FechaVto, NrOperacion ")
Endif

ACN(z1,0)

Recorrer SQL
  SCN(z1,1)
  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN('NrOperacion'))
  ACD(b:FAC, FBN['FechaOp'])
  ACD(d:FAC, FBN['FechaVto'])
  ACT(e:FAC, FBN['Cliente1'])
  ACT(f:FAC, FBN['TipoOp'])
  ACT(g:FAC, FBN['Especie'])
  ACN(h:FAC, FBN['Cantidad'])
  ACN(i:FAC, FBN['Precio3'])

  if EqStr(FBN('EsAforado'),'1')
    ACN(m:FAC,   FBN('TotalCaucion'))
    ACN(m:FAC+1, FBN('TotalGastos'))
  else
    ACN(m:FAC,   FBN('TotalBrutoCli1')+FBN('TotalDerechos'))
    ACN(m:FAC+1, FBN('TotalBrutoCli2')+FBN('TotalAux1'))
  endif

  ACN(j:FAC,   (FBN('TotalBrutoCli1')+FBN('TotalDerechos'))/Val(h:FAC))
  ACN(j:FAC+1, (FBN('TotalBrutoCli2')+FBN('TotalAux1'))/Val(h:FAC))
  ACN(k:FAC,   FBN('PorAforo'))
  ACN(l:FAC,   Val(j:FAC)*(1-(Val(k:FAC)/100)))
  ACN(l:FAC+1, Val(j:FAC+1)*(1-(Val(k:FAC)/100)))
  ACN(n:FAC,   Val(m:FAC+1)-Val(m:FAC))

  ACT(o:FAC, FBN('Mercado'))
  ACT(s:FAC, FBN('Book1'))
  ACT(c:FAC, FBN('FechaPago'))

  if FBN('FormaLiquidacion1')=1
    ACT(p:FAC, 'DVP')
  endif
  if FBN('FormaLiquidacion1')=2
    ACT(p:FAC, 'RVP')
  endif
  if FBN('FormaLiquidacion2')=0
    ACT(p:FAC+1, 'STD')
  endif
  if FBN('FormaLiquidacion2')=1
    ACT(p:FAC+1, 'DVP')
  endif
  if FBN('FormaLiquidacion2')=2
    ACT(p:FAC+1, 'RVP')
  endif

  ACN(q:FAC+1, FBN('Plazo'))
  if FBN('MB1')=0
    ACT(q:FAC, '0 hs.')
  endif
  if FBN('MB1')=1
    ACT(q:FAC, '72 hs.')
  endif
  if FBN('MB1')=2
    ACT(q:FAC, '24 hs.')
  endif
  if FBN('FormaLiquidacion1')=0
    ACT(p:FAC, 'STD')
  endif

  if Incluido(FBN('TipoOp'), 'TIPP')
    if FBN('Cartera')=0
      ACT(r:FAC, 'Trading')
    endif
    if FBN('Cartera')=1
      ACT(r:FAC, 'Invest.')
    endif
    if FBN('Cartera')=2
      ACT(r:FAC, 'Dispon.')
    endif
  endif
  IFA
proximo

ACT(a:Val(w1)+5,'Cant. Minutas: '~Fstr(Val(z1),1,0))
SetFont(a:Val(w1)+5,2)

FormatoCeldas(h:Val(w1)+5..h:FAC,Exe('F2'))
FormatoCeldas(m:Val(w1)+5..n:FAC,Exe('F2'))
FormatoCeldas(i:Val(w1)+5..j:FAC,Exe('F7'))
FormatoCeldas(l:Val(w1)+5..l:FAC,Exe('F7'))
FormatoCeldas(q:Val(w1)+5..q:FAC,Exe('F0R'))
FormatoCeldas(k:Val(w1)+5..k:FAC,Exe('F#'))
AlinearCeldas(h:Val(w1)+5..n:FAC,'D')
AlinearCeldas(q:Val(w1)+5..q:FAC,'D')

SetFont(a:Val(w1)+8..z:FAC,1)

ACO(1,6)
ACO(2,6)
ACO(3,6)
ACO(4,6)
ACO(5,7)
ACO(6,3)
ACO(7,5)
ACO(8,8)
ACO(9,6)
ACO(10,5)
ACO(11,3)
ACO(12,5)
ACO(13,8)
ACO(14,7)
ACO(15,4)
ACO(16,4)
ACO(17,3)
ACO(18,5)
ACO(19,5)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC, 2)
SetFont(n:3,2)
LimitesVision(s:FAC)
CrearFont(6,"Arial,6,B")
RangoTitulo(a:Val(w1)+7..s:FAC, 1)
SetPrintFit(3,95)
