*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     :'D.FechaOp'   ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2     :'H.FechaOp'   ; 1;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
  Fecha3     :'D.FechaValor'; 2;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha4     :'H.FechaValor'; 2;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
  Vehiculo1  :'Vehiculo'    ; 4;1;;;;;;;Var('VEHICULODE')
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(a:FAC, 'Movimientos no operativos MULC')
SetFont(a:FAC..a:FAC,3)

SetFilaActual(FAC+1)

ACT(a:FAC+1, 'Desde F.Op: '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Hasta F.Op: '~Dialogo.Fecha2)
ACT(c:FAC+1, 'Desde F.Op: '~Dialogo.Fecha3)
ACT(c:FAC+2, 'Hasta F.Op: '~Dialogo.Fecha4)

If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+3, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
   ACT(a:FAC+3, 'Vehiculo: Todos')
EndIf

SetFilaActual(FAC+5)
ACN(w1,FAC)

ACT(a:FAC, 'Fecha Ingreso')
ACT(b:FAC, 'Fecha Valor')
ACT(c:FAC, 'Plazo Liq.')
ACT(d:FAC, 'Tipo')
ACT(e:FAC, 'Numero')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Vehiculo')
ACT(i:FAC, 'Cliente')
ACT(j:FAC, 'Mercado')
ACT(k:FAC, 'Confirmada')
ACT(l:FAC, 'Fecha Confirmacion')
ACT(m:FAC, 'Operador')

AlinearCeldas(g:FAC..g:FAC,'D')
SetFont(a:5..m:FAC,2)
AgregarMarco(a:FAC..m:FAC,1,0,Exe('COLOR6'))

SQL.ADD("Select T.Fecha2, T.Fecha1, T.Cantidad10, T.TipoTr2, T.NrTrans, T.Especie, T.Cantidad1, T.Vehiculo1, T.Cliente1, C.RazonSocial, T.Mercado1, T.CB5, T.Fecha3, T.UsrInput ")
SQL.ADD("From "~DBO~".TRANSACCIONES2 T,"~DBO~".CLIENTES C                                 ")
SQL.ADD("Where T.Fecha2 between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("  and T.Fecha1 between "~IdxDate2(Dialogo.Fecha3)~" and "~IdxDate2(Dialogo.Fecha4))
SQL.ADD("  and T.Cliente1 = C.Codigo                                                      ")
SQL.ADD("  and T.TipoTr2 in ('TRNOP','RENOP','DENOP')                                     ")
SQL.ADD("  and CB10 = 1                                                                   ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"'                                    ")  
EndIf

Recorrer SQL
   Message(fbn('NrTrans')      )
   ACD(a:fac, FBN['Fecha2']    )
   ACD(b:fac, FBN['Fecha1']    )
   ACN(c:fac, FBN['Cantidad10'])
   ACT(d:fac, FBN['TipoTr2']   )
   ACT(e:fac, FBN['NrTrans']   )
   ACT(f:fac, FBN['Especie']   )
   ACN(g:fac, FBN['Cantidad1'] )
   ACT(h:fac, FBN['Vehiculo1'] )
   ACT(i:fac, FBN['Cliente1']~'-'~Copy(FBN['RazonSocial'],1,25))
   ACT(j:fac, FBN['Mercado1'] )
   ACT(k:fac, IIF(Incluido(FBN['CB5'],'1'),'Si','No'))
   ACD(l:fac, FBN['Fecha3']   )
   ACT(m:FAC, FBN['UsrInput'] )

   AlinearCeldas(g:FAC,'D')
   FormatoCeldas(c:fac,Exe('F0'))
   FormatoCeldas(g:fac,Exe('F2'))   
   
   ACN(xy1,SQL(" Select Count(*) From  "~DBO~".OPERACIONES O  Where O.NrTrans1 =   '"~Val(e:fac)~"'") )
   
   If val(xy1)=0
      ifa
      ACT(d:fac,'Sin Operacionres asociadas')
      ifa
   Else
      ACT(xy2,Val(e:fac))
      ifa
      ifa
      ACT(b:fac,'Tipo Op.')
      ACT(c:fac,'Nro. Op.')
      ACT(d:fac,'Fecha Op.')
      ACT(e:fac,'Fecha Vto.')
      ACT(f:fac,'Cliente')
      ACT(g:fac,'Nombre')
      ACT(h:fac,'Especie')
      ACT(i:fac,'Cantidad')
      ACT(j:fac,'Precio')
      ACT(k:fac,'Plazo')
      ACT(l:fac,'C.Esp.')
      ACT(m:fac,'Total')
      AgregarMarco(b:FAC..m:FAC,1,0,Exe('COLOR6'))
      
      SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1, C.RazonSocial CliNom, ")
      SQL.ADD(" O.Especie, O.Cantidad, O.Precio1, O.Precio4, O.Plazo, O.ContraEspecie,  O.TotalBrutoCli1 ")
      SQL.ADD(" From  "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
      SQL.ADD(" Where O.NrTrans1 = '"~Val(xy2)~"' ")
      SQL.ADD(" and   O.Cliente1 = C.Codigo ")      
   
      Recorrer SQL

         ACT(b:fac,fbn('TipoOp'))
         ACT(c:fac,fbn('NrOperacion'))
         ACLO(c:fac,fbn('NrOperacion'))
         ACT(d:fac,fbn('FechaOp'))
         ACT(e:fac,fbn('FechaVto'))
         AlinearCeldas(c:fac..e:fac,'C')
     
         ACT(f:fac,fbn('Cliente1'))
         ACT(g:fac,Copy(fbn('CliNom'), 1, 25))
     
         ACT(h:fac,fbn('Especie'))
         ACN(i:fac,fbn('Cantidad')  )
         FormatoCeldas(i:fac,EXE('F2'))
     
         ACN(j:fac,fbn('Precio1'))
         FormatoCeldas(j:fac,EXE('F9'))
     
         ACN(k:fac,fbn('Plazo'))
         FormatoCeldas(k:fac,EXE('F0'))
         ACT(l:fac,fbn('ContraEspecie'))
         ACN(m:fac,fbn('TotalBrutoCli1'))
         FormatoCeldas(m:fac,EXE('F2'))
         
         ifa
         
      Proximo
      
   Endif   
   
Proximo

SetFont(a:Val(w1)+1..m:fac,1)

ACO(1,8)
ACO(2,8)
ACO(3,8)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,15)
ACO(9,18)
ACO(10,9)
ACO(11,9)
ACO(12,12)
ACO(13,12)

Impresion(1,2)
SetFilaActual(fac+2)
ACT(a:fac,'FIN DEL INFORME')
SetFont(a:fac,2)
SetPrintFit(3,65)
LimitesVision(m:FAC+1)
RangoTitulo(a:1..p:fac+1, 10)
