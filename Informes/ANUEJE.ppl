CrearDialogo 
  Fecha1     :'F.Ord.Desde';1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2     :'F.Ord.Hasta';2;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
  Cliente1   :'Cliente'    ; ;1;;;;;
  Lista1     : "Tipos Ordenes" ; ;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSORDEN where Codigo in ('OTIC','OTIV') ");  
FinDialogo


AgregarBMP(a1, Exe('LOGO'), Exe('ESCALOGO'))

If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
