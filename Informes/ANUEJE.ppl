SetFilaActual(9)

ACT(A:Fac+1,'F. Ord. Desde: '~Dialogo.Fecha1)
ACT(B:Fac+1,'F. Ord. Hasta: '~Dialogo.Fecha2)

If Vacio(Dialogo.Cliente1)
   ACT(A:Fac+2,'Cliente: Todos ')
Else
   ACT(A:Fac+2,'Cliente: '~Dialogo.Cliente1)
EndIf

If Vacio(Dialogo.Lista1)
   ACT(A:Fac+3,'Tipos de Orden: Todos ')
Else
   ACT(A:Fac+3,'Tipos de Orden: '~Dialogo.Lista1)
EndIf
SetFont(A:Fac+1..D:Fac+4,2)

ACT(A:fac+5,'Ejecuciones Pendientes de Anulacion')
SetFont(A:Fac+5,4)

SetFilaActual(Fac+6)

ACT(A:Fac,'Tipo Orden')
