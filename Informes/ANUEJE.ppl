SetFilaActual(Fac)

SQL.ADD(" Select 1 Tipo, O.TipoOrden, O.NrOrden, O.Especie, O.Cliente, O.CantidadTotalOrden, O.Cantidad2, O.PrecioLimite, O.Mercado3, O.Mercado, O.Mercado2, O.Mercado4, O.RB10, O.Cantidad3, NrOperacion2, O.FechaCarga, O.Operador1,  ")
SQL.ADD(" O.Vehiculo, O.ContraEspecie, O.FechaOrden, O.Plazo1, O.RB5, O.FechaVto, O.TipoCambio2, O.Book1, O.Operador, O.CB6, O.CB7, O.NroAltaMAE, OB.NrBit,   ")
SQL.ADD(" O.UDN1, O.Cantidad1, O.Cantidad4      ")
SQL.ADD(" From   "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB          ")
SQL.ADD(" Where FechaOrden between'"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" And OB.Valor='1'  and NrBit = 33 and O.NrOrden= OB.NrOperacion  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and Cliente='"~Dialogo.Cliente1~"' ")  
EndIf

If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and TipoOrden in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" and TipoOrden in ('OTIC','OTIV') ")
EndIf
SQL.ADD("UNION ")
SQL.ADD(" Select 2 Tipo, O.TipoOrden, O.NrOrden, O.Especie, O.Cliente, O.CantidadTotalOrden, O.Cantidad2, O.PrecioLimite, O.Mercado3, O.Mercado, O.Mercado2, O.Mercado4, O.RB10, O.Cantidad3, NrOperacion2, O.FechaCarga, O.Operador1,  ")
SQL.ADD(" O.Vehiculo, O.ContraEspecie, O.FechaOrden, O.Plazo1, O.RB5, O.FechaVto, O.TipoCambio2, O.Book1, O.Operador, O.CB6, O.CB7, O.NroAltaMAE, OB.NrBit,   ")
SQL.ADD(" O.UDN1, O.Cantidad1, O.Cantidad4      ")
SQL.ADD(" From   "~DBO~".ORDENES O, "~DBO~".OPERACIONESBITS OB          ")
SQL.ADD(" Where FechaOrden between'"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" And OB.Valor='1' and O.NrOrden= OB.NrOperacion  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and Cliente='"~Dialogo.Cliente1~"' ")  
EndIf

If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and TipoOrden in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD(" and TipoOrden in ('OTIC','OTIV') ")
EndIf

SQL.ADD(" and (NrBit <> 33 and (Select top 1 1 from "~DBO~".EJECUCIONES E where E.NrOrden = O.NrOrden and Fecha2 is not null)=1) ")  
SQL.ADD(" Order by Tipo ")
watch(sql.batch)

