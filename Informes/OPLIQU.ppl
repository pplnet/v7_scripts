CrearDialogo
  Fecha1  : 'F.Desde';;;;;;;;;FSYS
  Fecha2  : 'F.Hasta';;;;;;;;;FSYS
  Cliente1: 'Cliente';
  Mercado1: 'Mercado';
  Radio1   : 'Filtro|Titulos|FX|MMkts|Todas';;;;;;;;;3
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')

SetFilaActual(4)
ACN(w1,fac)

ACT(A:FAC,'Operaciones Liquidadas')
ACT(A:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
ACT(A:FAC+2,'Fecha Hasta: '~Dialogo.Fecha2)
ACT(A:FAC+3,'Cliente: '~Iif(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(A:FAC+4,'Mercado: '~Iif(NoVacio(Dialogo.Mercado1),Dialogo.Mercado1,'Todos'))
IF Dialogo.Radio1 = 0
   ACT(A:FAC+5,'Modulo: Titulos') 
ENDIF
IF Dialogo.Radio1 = 1
   ACT(A:FAC+5,'Modulo: Foreign ExChange') 
ENDIF
IF Dialogo.Radio1 = 2
   ACT(A:FAC+5,'Modulo: Money Market') 
ENDIF
IF Dialogo.Radio1 = 3
   ACT(A:FAC+5,'Modulo: Todos') 
ENDIF


ACT(A:FAC+6,'Cliente')
ACT(B:FAC+6,'Especie')
ACT(C:FAC+6,'Voucher')
ACT(D:FAC+6,'Merc.')
ACT(E:FAC+6,'Mod.Liq.')
ACT(F:FAC+6,'Fecha')
ACT(G:FAC+6,'Cant.Especie')
ACT(H:FAC+6,'Cant.Moneda')
ACT(i:FAC+6,'Cta.Esp.Cli')
ACT(j:FAC+6,'Cta.Mon.Cli')
ACT(k:FAC+6,'Cta.Esp.'~Var('VEHICULODE'))
ACT(l:FAC+6,'Cta.Mon.'~Var('VEHICULODE'))
ACT(m:FAC+6,'Nr.Operacion')

AlinearCeldas(f:fac+6..h:fac+6,'D')
SetFont(a:fac..m:fac+6,2)
AgregarMarco(a:fac+6..m:fac+6,2,0,EXE('COLOR'))
SetFilaActual(fac+6)

Message('Procesando Transacciones')

SQL.ADD(" SELECT Distinct T.* FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M WHERE ")
SQL.ADD(" T.NrTrans = M.NrTrans2  AND ")
SQL.ADD(" M.NrSaldo = 1  AND ")

IF Dialogo.Radio1 = 0
   SQL.ADD(" M.Concepto = 'TI'  AND ")
ENDIF
IF Dialogo.Radio1 = 1
   SQL.ADD(" M.Concepto = 'FX'  AND ")
ENDIF
IF Dialogo.Radio1 = 2
   SQL.ADD(" M.Concepto = 'MM'  AND ")
ENDIF

IF NoVacio(Dialogo.Cliente1)
   SQL.ADD(" Cliente1='"~Dialogo.Cliente1~"' AND ")
ENDIF

IF NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Mercado1='"~Dialogo.Mercado1~"' AND ")
ENDIF

SQL.ADD(" (Fecha1 Between '"~IdxDate(DIALOGO.FECHA1)~"' AND '"~IdxDate(DIALOGO.FECHA2)~"') AND ")
SQL.ADD(" TipoTr2 in ('DEP','RET','COMP','MATCH','TRACTA') ")
SQL.ADD(" ORDER BY NrTrans ")

Recorrer SQL   
    Message(fbn('NrTrans'))
    If Not EqStr(FBN['Cliente1'],Val(V1)) o Not EqStr(FBN['Especie'],Val(V2)) o Not EqStr(FBN['Especie1'],Val(V2))
        If fac > Val(w1)+7
            IFA
        EndIf
        If Not EqStr(FBN['Cliente1'], Val(V1))
            ACT(v1,    FBN['Cliente1'])
            ACT(a:fac, Val(V1))
        Else
            DFA
        EndIf
        ACT(v2   ,FBN['Especie'])
        ACT(v3   ,' ')
        ACT(v3   , FBN['Especie1'])
        ACT(b:fac, Val(v2))
        If EqStr(FBN['TipoTr2'],'MATCH')
            ACT(b:fac, Val(b:fac)~'/'~Val(v3))
        EndIf
        SetFont(a:fac..b:fac,2)
    EndIf
    ACT(c:fac, FBN['NrTrans'])
    ACLT(c:fac, FBN['NrTrans'])
    ACT(d:fac, FBN['Mercado1'])

    If EqStr(FBN['TipoTr2'],'MATCH')
        ACT(e:fac, 'Match')
    EndIf

    If Incluido(FBN['TipoTr2'],'DEP|RET')
        If Incluido(FBN['Mercado1'],'CE|CRYL')
            If EqStr(Copy(FBN['NrOperacionRef1'],1,1),'I')
                ACT(e:fac, 'STD')
            Else
                BorrarCeldas(R1..R3)
                ACT(R1,SQL(" Select TipoOp FROM "~DBO~".OPERACIONES WHERE NrOperacion = '"~FBN['NrOperacionRef1']~"' "))
                If CeldaVacia(r1)
                    If Incluido(Val(r1),'TIC|TIV')
                        ACT(r2,SQL(" Select FormaLiquidacion2 FROM "~DBO~".OPERACIONES WHERE NrOperacion = '"~FBN['NrOperacionRef1']~"' ") )
                        If VAL(r2)=0
                            ACT(e:fac, 'FD&P')
                        EndIf
                        If VAL(r2)=2
                            ACT(e:fac, 'FOP')
                        EndIf
                    EndIf
                    If Incluido(Val(R1),'TIFC|TIFV')
                        ACT(R3,SQL(" Select FormaLiquidacion1 FROM "~DBO~".OPERACIONES WHERE NrOperacion = '"~FBN['NrOperacionRef1']~"' "))
                        If VAL(R3)=0
                            ACT(E:FAC, 'FD&P')
                        EndIf
                        If VAL(R3)=2
                            ACT(E:FAC, 'FOP')
                        EndIf
                    EndIf
                EndIf
            EndIf
        Else
            If FBN['CB6']=1
                ACT(E:FAC, 'DVP')
            EndIf
            If FBN['CB7']=1
                ACT(E:FAC, 'RVP')
            EndIf
            If FBN['CB8']=1
                ACT(E:FAC, 'Conf.')
            EndIf
            If CeldaVacia(E:FAC)
                ACT(E:FAC, 'STD')
            EndIf
        EndIf
    EndIf
    ACD(f:fac, FBN['Fecha2'])
    If DesciendeDeEspecie(FBN['Especie'],'TITULO')
        ACN(X2,7)
      Else
        ACN(X2,8)
    EndIf
    If Incluido(FBN['TipoTr2'],'RET')
        ACN(Val(X2):FAC, -FBN['Cantidad1'])
    EndIf
    If Incluido(FBN['TipoTr2'],'DEP|COMP')
        ACN(Val(X2):FAC, FBN['Cantidad1'])
    EndIf
    If Incluido(FBN['TipoTr2'],'MATCH')
        ACN(g:fac, FBN['Cantidad1']*(-1))
        ACN(h:fac, FBN['Cantidad2']*(-1))
    EndIf
    ACT(i:FAC, FBN['Cuenta1'] ~'-'~BuscarCampo('CUENTAS', 'Numero', 'Codigo', FBN['Cuenta1']))
    ACT(j:FAC, FBN['Cuenta3'] ~'-'~BuscarCampo('CUENTAS', 'Numero', 'Codigo', FBN['Cuenta3']))  
    ACT(k:FAC, FBN['Cuenta2'] ~'-'~BuscarCampo('CUENTAS', 'Numero', 'Codigo', FBN['Cuenta2']))
    ACT(l:FAC, FBN['Cuenta4'] ~'-'~BuscarCampo('CUENTAS', 'Numero', 'Codigo', FBN['Cuenta4']))
    ACT(m:fac, FBN['NrOperacionRef1'])
    if EqStr(Copy(FBN['NrOperacionRef1'],1,1),'V')
      ACLT(m:fac, FBN['NrOperacionRef1'])
    else
      ACLO(m:fac, FBN['NrOperacionRef1'])
    endif
    SetFont(c:FAC..m:FAC,1)
PROXIMO

FormatoCeldas(G:Val(W1)+7..H:FAC,EXE('F2'))

ACO(1,6)
ACO(2,8)
ACO(3,7)
ACO(4,4)
ACO(5,5)
ACO(6,6)
ACO(7,8)
ACO(8,8)
ACO(9,17)
ACO(10,17)
ACO(11,17)
ACO(12,17)
ACO(13,8)

SetFont(V1..Z3,1)
If Val(W2)>0
  SetFont(AA:1..AE:Val(W2),1)
EndIf

SetFilaActual(FAC+2)
ACT(a:fac, 'Fin del informe')
SetFont(a:fac, 2)
AgregarBMP(A1,EXE('LOGO'),EXE('ESCALOGO'))
SetFont(i:3,2)
Impresion(1,2)
LimitesVision(m:FAC)
RangoTitulo(a:1..l:FAC, Val(W1)+6)
