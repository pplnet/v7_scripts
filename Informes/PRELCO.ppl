* ---> Impresion Del Informe De Preliquidacion
ModoReproceso(SinDialogo)
GrillaVisible(SI)

CrearDialogo
   Vehiculo1  : "Vehiculo"             ;1;1;1;SI;SI;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar El Vehiculo';NO;Var('VEHICULODE')
   Cliente1   : "Cliente"              ;2;1;1;SI;SI;
   Mercado1   :  'C.Custodia'           ;3;1;1;SI;SI;;;SI;
   Especie3   : 'Especie'              ;1;2;1;SI;SI;NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3, 'TITULO') y EsTerminal(Dialogo.Especie3, Especie);'Debe Ingresar Una Especie Valida';;;;;;;"Status = 'HAB' "
   Especie1   : 'Cupon'                ;2;2;1;NO;SI;;;SI;BuscarCampo('ESPECIES', 'Alias9', 'Codigo', Dialogo.Especie3);BuscarCampo('ESPECIES', 'Alias9', 'Codigo', Dialogo.Especie3);;;;"Status = 'HAB' "
   Entero1    : 'Nro.Cupon'            ;3;2;1;SI;SI;Dialogo.Entero1 >= 0;'Debe Ingresar El Numero De Cupon';NO;0;BuscarCampo('ESPECIES', 'Cupon',  'Codigo', Dialogo.Especie1)                                                                                
   Fecha1     : 'F.Pago/Cob.'          ;4;2;1;SI;SI;
   Radio1     : 'Pago|Normal|Bloqueos_CV|Garantias' ;5;1;;;;;;;0
   Radio2     : 'Por|Pantalla|Impresora'  ;;1;;;;;;;0      
   Lista1     : 'Sucursal'             ;1;1;;NO;NO;;;;;;SQLSet("Select Codigo FROM "~DBO~".SUCURSALES ORDER BY Codigo ");SI 
FinDialogo

If [Not OK]
   Cancelar
EndIf

If [[NoVacio(DIALOGO.VEHICULO1)] y [Not Incluido(DIALOGO.VEHICULO1, UsrVehiculos(UsuarioActivo))] y [Not Vacio(UsrVehiculos(UsuarioActivo))]]
   Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
EndIf

* ---> Seleccion De La Informacion A Listar

ACN(ZA:02, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU'))+100)

* ---> Seleccion De La Informacion A Listar
SQL.Add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie1,T2.Cupon1,T2.Fecha1,")
SQL.Add("       T2.Precio1,T2.Precio2,T2.Precio3,M.*, T2.CB5, T2.Precio5, ")
SQL.Add("       C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal,  ")
SQL.Add("       C.CUIT, C.CondicionIVA, C.TipoInscripcion, C.Sucursal,    ")
SQL.Add("       CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ,T2.NrTransRef4     ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVEJECUTADOS M WITH (NOLOCK) ")
SQL.Add(" WHERE  T2.Especie =  '"~Dialogo.Especie1~"' ")
*SQL.Add(" AND    M.Especie  <> T2.Especie             ")
*SQL.Add(" AND    T2.TipoTr2  =  'LCUPON'              ")
If Dialogo.Fecha1 > 0
 *  SQL.Add("       AND T2.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif
If Dialogo.Entero1 >= 0
  * SQL.Add("       AND T2.Cupon1   =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
Endif
*SQL.Add("       AND M.Concepto <> '"~FStr(Val(ZA:02),1,0)~"' ")
*SQL.Add("       AND M.NrOperacion= T2.NrTrans ")
SQL.Add("       AND M.Cliente = C.Codigo ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD("    AND M.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("    AND M.Cliente = '"~Dialogo.Cliente1~"' ")
Endif
If Dialogo.Radio1=0
   *SQL.ADD("    AND (M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") AND M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQGARA'))~"))  ")
Else
   If Dialogo.Radio1=1
 *     SQL.ADD("    AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") ") 
   Else
  *    SQL.ADD("    AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQGARA'))~") ")
   Endif
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       AND C.Sucursal in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.Add("UNION ALL ")
SQL.Add("SELECT T2.NrTrans,T2.Vehiculo1,T2.Especie,T2.Especie1,T2.Cupon1,T2.Fecha1,")
SQL.Add("       T2.Precio1,T2.Precio2,T2.Precio3,M.*, T2.CB5, T2.Precio5, ")
SQL.Add("       C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal, C.CUIT, ")
SQL.Add("       C.CondicionIVA, C.TipoInscripcion, C.Sucursal, ")
SQL.Add("       CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) NrMov2 ,T2.NrTransRef4    ")
SQL.Add("FROM   "~DBO~".TRANSACCIONES2 T2, "~DBO~".CLIENTES C, "~DBO~".MOVPENDIENTES M WITH (NOLOCK) ")
SQL.Add(" WHERE  T2.Especie  =  '"~Dialogo.Especie1~"' ")
*SQL.Add(" AND    M.Especie  <> T2.Especie              ")
*SQL.Add(" AND    T2.TipoTr2  =  'LCUPON'               ")
If Dialogo.Fecha1 > 0
 *  SQL.Add("       AND T2.Fecha1   >= '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif
If Dialogo.Entero1 >= 0
  * SQL.Add("       AND T2.Cupon1   =  '"~FStr(Dialogo.Entero1, 1, 0)~"' ")
Endif
*SQL.Add("       AND M.Concepto <> '"~FStr(Val(ZA:02),1,0)~"' ")
*SQL.Add("       AND M.NrOperacion= T2.NrTrans ")
*SQL.Add("       AND M.Cliente = C.Codigo ")
If NoVacio(Dialogo.Mercado1)
   SQL.ADD("    AND M.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("    AND M.Cliente = '"~Dialogo.Cliente1~"' ")
Endif
If Dialogo.Radio1=0
   *SQL.ADD("    AND (M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") AND M.Concepto NOT IN ("~Pipe2Comillas(VAR('BLOQGARA'))~"))  ")
Else
   If Dialogo.Radio1=1
   *   SQL.ADD("    AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQDOMINC'))~") ") 
   Else
    *  SQL.ADD("    AND M.Concepto IN ("~Pipe2Comillas(VAR('BLOQGARA'))~") ")
   Endif
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD("       AND C.Sucursal in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
*SQL.Add("  ORDER BY T2.NrTrans, M.CallPut, M.Cliente, NrMov2, M.NrMov   ")
SQL.Add("  ORDER BY T2.NrTrans, M.Vehiculo, M.Cliente, NrMov2, M.NrMov   ")

