If NoVacio(Dialogo.Cliente1)
   ACT(a:8, 'Cliente: '~Dialogo.Cliente1)
Else
   ACT(a:8, 'Cliente: Todos')
Endif
ACT(c:05, "C. Custodia:  " ~ IIF(NoVacio(Dialogo.Mercado1), Dialogo.Mercado1, 'Todos'))
ACT(E:02, "Sucursal:  " ~ IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, 'Todas'))
SetFont(A:02..E:10, 3)

 
ACT(A:11, "Sucursal")
