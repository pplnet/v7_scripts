AlinearCeldas(E:11..R:11, 'D')
AlinearCeldas(S:11..S:11, 'I')
SetFont(A:11..T:11, 2)

ACN(Z2,0)
ACN(Z3,0)

* ---> Impresion De Lineas Del Informe
ACN(z1, 11)
ACN(vr1,SQL("SELECT VTeoricoAnt FROM "~DBO~".AGENDACUPONES Where NrCupon= '"~FStr(Dialogo.Entero1, 1, 0)~"' and Especie = '"~Dialogo.Especie3~"' "))

ACT(aa3,'LLENO')

Recorrer SQL
   If val(z1)=11
      *- Recupero los datos para mostrar en el encabezado
      ACT(A:07, "% Amortizacion:  "~Fstr(FBN['Precio1'],0,8))
      ACT(A:08, "% Renta:  "~Fstr(FBN['Precio2'],0,8))
      ACT(A:09, "% Ints.Capit.:  "~Fstr(FBN['Precio3'],0,8))

      SetFont(A:02..A:10, 3)
   EndIf
* FO 15/03  If Not EqSTr(val(aa3),FBN['CallPut']) 
* FO 15/03      act(aa3,FBN['CallPut'])
  If Not EqSTr(val(aa3),FBN['Vehiculo']) 
      act(aa3,FBN['Vehiculo'])
      scn(z1,2)
      ACN(SG:1, 1)
*      If Vacio(FBN['CallPut'])
      If Vacio(FBN['Vehiculo'])
         ACT(a:val(z1),'Saldos y Movimientos') 
      EndIf
      If EqStr(val(aa3),'PAS')
         ACT(a:val(z1),'Pases, Pendientes y Diferidos') 
         ***---Los mov.ptes. de moneda se ven desde el pto. de vista del banco
         ACN(SG:1, -1)
      Endif
      If EqStr(val(aa3),'PRE')
         ACT(a:val(z1),'Prestamos y Depositos') 
         ACN(SG:1, -1)
      Endif
      If EqStr(val(aa3),'Fal')
         ACT(a:val(z1),'Fallas y no Confirmados') 
         ACN(SG:1, 1)
      Endif
      If EqStr(val(aa3),'PEN')
         ACT(a:val(z1),'Pendientes y Diferidos') 
         ***---Los mov.ptes. de moneda se ven desde el pto. de vista del banco
         ACN(SG:1, -1)
      Endif

      SetFont(A:val(z1)..A:val(z1), 3) 
      scn(z1,1)
   EndIf

   If Not EqSTr(val(aa2),FBN['Cliente']~FBN['NrTrans']~FBN['NrMov2'])
      scn(z1,1)
      ACN(K:Val(z1),0)
      ACN(L:Val(Z:1),0)
      ACN(O:Val(z1),0)
      ACN(P:Val(z1),0)

      act(aa2,FBN['Cliente']~FBN['NrTrans']~FBN['NrMov2'])

      ACT(a:val(z1),FBN('Sucursal'))
      If EqStr(val(aa3),'Fal') Y Incluido(BuscarCampo('CUENTAS','Mercado','Codigo', fbn('Book')), 'EU|CRYL')
         ACN(BD:1, 0)
*         IF Incluido(BuscarCampo('CUENTAS','Mercado','Codigo', fbn('Book')), 'EU|CRYL')
             ***---Busco la DTP/RTP del Corte para obtener la MATCH
             ACT(RF:5, SQL(" Select NrTrans2 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~fbn('NrTransRef4')~"' AND Cuenta = '"~fbn('Book')~"' AND Especie = '"~fbn('Especie')~"' "))
             ***---Tr.Match
             ACT(MT:1, BuscarCampo('TRANSACCIONES2','NrOperacionRef1','NrTrans', Val(RF:5)))
             ACT(b:val(z1), BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans', Val(MT:1)))
             ACT(c:val(z1),COPY(BuscarCampo('CLIENTES','RazonSocial','Codigo', Val(B:Val(Z:1))),1,25))
*         ELSE
*             IF NoVacio(fbn('NrTrans2'))
*                 SQL.ADD(" Select NrTrans, NrOperacionRef1, Cliente2 From "~DBO~".TRANSACCIONES2 Where NrOperacionRef3 = '"~fbn('NrTransRef4')~"' AND TipoTr2 IN ('DTP','RTP') AND NrTrans = '"~fbn('NrTrans2')~"' ")
*             ELSE
*                 SQL.ADD(" Select NrTrans, NrOperacionRef1, Cliente2 From "~DBO~".TRANSACCIONES2 Where NrOperacionRef3 = '"~fbn('NrTransRef4')~"' AND TipoTr2 IN ('DTP','RTP') ")
*             ENDIF
*             Recorrer SQL
*                 ***---Datos de la DTP/RTP
*                 DFA
*                 ACT(RF:3, fbn('NrTrans'))
*                 ACT(RF:4, fbn('NrOperacionRef1'))
*                 ACT(CL:77, fbn('Cliente2'))
*             Proximo
*             ***---Busco la contraparte
*             ACT(b:val(z1), BuscarCampo('TRANSACCIONES2','Cliente1','NrTrans', Val(RF:4)))
*             ACT(c:val(z1),COPY(BuscarCampo('CLIENTES','RazonSocial','Codigo', Val(B:Val(Z:1))),1,25))
*         ENDIF
      else
         ACT(b:val(z1),FBN('Cliente'))
         ACT(c:val(z1),COPY(FBN('RazonSocial'),1,25))
      Endif

*      ACT(d:val(z1), FBN('Book'))
      ACT(d:val(z1), FBN('Vehiculo'))
      ACN(e:val(z1),FBN('NrGrupo2'))
      ACN(f:val(z1),Round( val(e:val(z1)) * Val(vr1),val(vr2)) )
      ACN(g:Val(z1), val(e:val(z1)) * FBN('Precio2')/100 * Val(SG:1))
      ACN(h:Val(z1), Round(val(e:val(z1)) * FBN('Precio1')/100,val(vr2)) * Val(SG:1))
      ACN(i:Val(z1), Round(val(e:val(z1)) * FBN('Precio3')/100,val(vr2)) * Val(SG:1))
      ACN(J:Val(z1), val(g:val(z1)) + val(h:val(z1)) + val(i:val(z1)) * Val(SG:1))

      IF fbn('CB5') = 1
          ACN(PR:5, fbn('Precio5'))
      ELSE
          ACN(PR:5, 1)
      ENDIF

      ACN(J:Val(Z:1), Val(J:Val(Z:1)) * Val(PR:5))
      ACN(ns1, Num(FBN('Concepto')))

      If VAL(ns1)>=200
         ACN(ns1,VAL(ns1)-100)
      EndIf

      ACT(S:val(z1), BuscarCampo('ESTADOSCUSTODIA','Descripcion','NrSaldo',val(ns1)) )
      SetFont(a:val(z1)..T:val(z1), 1)

   EndIf

***---   If FBN['NrSaldo']=4 
      *- Impresion de La Comision 
      If FBN['NrGrupo']=41
         *- Impresion Monto Comision
         ACN(K:Val(z1), FBN['Cantidad'] * Val(SG:1))
         ACN(L:Val(Z:1), (FBN['Cantidad']-FBN['NrInstan']) * Val(SG:1))
      EndIf
      If FBN['NrGrupo']=42
         *- Impresion Del Iva
         ACN(O:Val(z1), FBN['Formula'])
         ACN(P:Val(z1), fbn('NrInstan') * Val(SG:1))
      EndIf
***---   EndIf

   *- Comision CV
   ACN(Z2,0)
   If Val(Z2)=0 y FBN['NrGrupo']=51
      ACN(Z2, FBN['Cantidad'])
      ACN(M:Val(z1), Val(Z2) * Val(SG:1))
   EndIf

   *- IVA CV
   ACN(Z3,0)
   If Val(Z3)=0 y FBN['NrGrupo']=52
      ACN(Z3, FBN['Cantidad'])
      ACN(N:Val(z1), Val(Z3) * Val(SG:1))
   EndIf

   ACN(q:Val(z1), val(J:val(z1)) - (( val(K:val(z1)) - val(L:val(z1)) ) + val(P:val(z1)) + val(M:val(z1)) + val(N:val(z1)) )  )

***---   If FBN['NrSaldo']=5
      *- Cuenta Acreditacion
      ACT(R:Val(z1), FBN['Cuenta'])
***---   EndIf

   ACT(T:Val(z1), FBN['Cupon1'])
   SetFont(a:val(z1)..T:val(z1), 1)
Proximo

SCN(z1, 2)
if no
ACT(A:val(z1), "Total .... ")

