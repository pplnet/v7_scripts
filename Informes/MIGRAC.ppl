** MIGRAC - Testing migración
* MIGRAC - Avisa en que entorno (sigla del cliente) se esta corriendo.
* La sigla la resuelve el preprocesador con #ifdef: cada bloque
* solo queda vivo si la instalacion tiene definida esa sigla.
* El informe es únicamente a modo de prueba para testear la funcionalidad de migración. More.

let &Sigla ''

#ifdef STD
  let &Sigla 'STD'
#endif

#ifdef BACS
  let &Sigla 'BACS'
#endif

#ifdef BIND
  let &Sigla 'BIND'
#endif

#ifdef CMF
  let &Sigla 'CMF'
#endif

#ifdef BFSA
  let &Sigla 'BFSA'
#endif

* Ninguna de las siglas previstas esta definida
if Vacio(&Sigla)
  let &Sigla 'DESCONOCIDO'
  MessageBox('No se reconoce el entorno: la sigla del cliente no es STD, BACS, BIND, CMF ni BFSA.')
else
  MessageBox('Usted esta en el entorno '~&Sigla)
endif

* --- Lo mismo, en la grilla ---
CrearFont(1, 'Arial,10,')
CrearFont(2, 'Arial,12,B')

ACT(a1, 'Entorno actual')
ACT(a3, 'Sigla del cliente:')
ACT(b3, &Sigla)

SetFont(a1..b1, 2)
SetFont(a3..b3, 1)
SetFont(b3..b3, 2)
ACO(1,25)
ACO(2,20)
LimitesVision(b3)
