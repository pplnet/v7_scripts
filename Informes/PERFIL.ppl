CrearDialogo
  Perfil1 : 'Perfil a listar' ;;;;;;NoVacio(Dialogo.Perfil1);'Debe ingresar un perfil';NO
FinDialogo

if not Ok
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),90)

CrearFont(1, 'Arial,10,B')
CrearFont(2, 'Arial,10,')
CrearFont(3, 'Arial,12,B')

ACT(h1, 'Fecha: '~Fecha(Fsys))
SetFont(h1,2)
ACT(d3, 'Detalle del perfil '~Dialogo.Perfil1)
SetFont(d3,3)

SetFilaActual(5)

* DetallePerfil(perfil, NrGrupo)
** 1: ImprimeItems;
** 2: ImprimeTablas;
** 3: ImprimeTiposOp;
** 4: ImprimeInformes;
** 5: ImprimeEventos;
** 6: ImprimeExtras;
** 7: ImprimeVariables;
** 8: ImprimeInstancias;

let &perfil STR(Dialogo.Perfil1)

** NrGrupo = 1 (Items de menu)
let &items_menu DetallePerfil(&perfil, 1)
IFA
ACT(a:fac, "Items de menu")
SetFont(a:fac,1)
Recorrer&i 1, Elementos(&items_menu)
    IFA
    ACT(a:fac, ItemLista(&items_menu, &i))
    SetFont(a:fac,2)
Proximo
IFA

** NrGrupo = 2 (Tablas)
let &tablas DetallePerfil(&perfil, 2)
IFA
ACT(a:fac, "Tablas")
SetFont(a:fac,1)
Recorrer&i 1, Elementos(&tablas)
    IFA
    ACT(a:fac, ItemLista(&tablas, &i))
    SetFont(a:fac,2)
Proximo
IFA

** NrGrupo = 3 (TiposOperacion)
let &tablas DetallePerfil(&perfil, 3)
IFA
ACT(a:fac, "Tipos de Operacion")
SetFont(a:fac,1)
Recorrer&i 1, Elementos(&tablas)
    IFA
