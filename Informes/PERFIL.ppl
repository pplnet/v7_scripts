    SetFont(a:fac,2)
Proximo
IFA

** NrGrupo = 4 (Informes)
let &tablas DetallePerfil(&perfil, 4)
IFA
ACT(a:fac, "Informes")
SetFont(a:fac,1)
Recorrer&i 1, Elementos(&tablas)
    IFA
    ACT(a:fac, ItemLista(&tablas, &i))
    ACT(a:fac, val(a:fac) ~ ' - '~SQL("Select Nombre from "~dbo~".INFORMES Where Codigo = '"~val(a:fac)~"'"))
    SetFont(a:fac,2)
Proximo
IFA

