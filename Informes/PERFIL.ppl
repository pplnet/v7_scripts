IFA
IFA


** TipoTr (PPL way)
ACT(a:fac, "Tipos Transaccion")
SetFont(a:fac,1)
let &script SQL("Select Script from "~dbo~".PERFILES2 Where Codigo = '"~&perfil~"'")
Repetir
    ** +2 para omitir el "TT"
    let &pos_ini Posicion("TT", STR(&script)) + 2
    if(&pos_ini <= 2) 
        break
    endif
    let &script Copy(&script, &pos_ini, Longitud(&script))
    let &length Posicion(" ",  STR(&script)) -1
    if(&length < 0)
        ** No quedan mas espacios, se termino de recorrer el script
        let &tr &script
    else
        let &tr Copy(&script, 1, &length)
    endif
    let &nombre SQL("Select Nombre from "~dbo~".TIPOSTRANSACCION2 Where Codigo = '"~&tr~"'")
    if(NoVacio(&nombre))
        ** Es un tipo transaccion valido
        IFA
        ACT(a:fac, &tr~' - '~&nombre)
        SetFont(a:fac,2)
    endif
Proximo
ACT(a:Fac+3,'Fin de informe')
SetFont(a:Fac+3,2)
