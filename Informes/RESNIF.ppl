        SCN(tt:13, Val(y:fac) )

        * --- Suma totales para vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(n:fac) )
        SCN(tv:3, Val(o:fac) )
        SCN(tv:4, Val(p:fac) )
        SCN(tv:5, Val(q:fac) )
        SCN(tv:6, Val(r:fac) )
        SCN(tv:7, Val(s:fac) )
        SCN(tv:8, Val(t:fac) )
        SCN(tv:9, Val(u:fac) )
        SCN(tv:10, Val(v:fac) )
        SCN(tv:11, Val(w:fac) )
        SCN(tv:12, Val(x:fac) )
        SCN(tv:13, Val(y:fac) )

        ifa
        ifa
        ACN(fi:1, fac)
     Endif
  Endif

  ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
  message(Val(a:fac))
  ACT(b:fac, fbn('Cupon'))
  ACD(c:fac, fbn('FechaEj'))

  If Dialogo.Fecha1=fbn('Fecha')
     ACN(d:fac, fbn('CantidadIni'))
     ACN(e:fac, fbn('Cantidad1'))
     ACN(f:fac, -fbn('Cantidad2'))
  Else
     ACN(d:fac, fbn('CantidadFin'))
     ACN(e:fac, 0)
     ACN(f:fac, 0)
  Endif
  ACN(g:fac, fbn('CantidadFin'))
  ACN(h:fac, fbn('PrecioFin'))
  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
     ACN(i:fac, 1)
  Else
     ACN(i:fac, SQL(" Select Precio from "~DBO~".COTIZADORNIIF where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Especie = '"~fbn('Especie')~"' and Cartera = '"~fbn('Book')~"' "))
  Endif

  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
     ACN(j:fac, 1)
  Else
     ACN(j:fac, SQL(" Select Precio from "~DBO~".COTIZADORNIIF where Fecha = '"~IdxDate(habiles(Dialogo.Fecha1,-1,'ARG'))~"' and Especie = '"~fbn('Especie')~"' and Cartera = '"~fbn('Book')~"' "))
  Endif
  FormatoCeldas(h:fac..j:fac, EXE('F9'))

  ACN(k:fac, Val(g:fac)-Val(d:fac))
  ACN(l:fac, Val(i:fac)*Val(g:fac))
  ACT(m:fac,SQL(" Select TipoValuacion from "~DBO~".COTIZADORNIIF where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Especie = '"~fbn('Especie')~"' and Cartera = '"~fbn('Book')~"' "))

  SetFont(a:fac..z:fac, 1)

  SQL.ADD(" SELECT Day, MTD, YTD, TipoResultado, Fecha FROM "~DBO~".RESULTADOS R  ")
  SQL.ADD(" WHERE Especie   = '"~fbn('Especie')~"'     ")
  SQL.ADD(" AND   NrSaldo   = "~fstr(fbn('NrSaldo'),0,0)~" ")
  SQL.ADD(" AND   Vehiculo  = '"~fbn('Vehiculo')~"'    ")
  SQL.ADD(" AND   Book      = '"~fbn('Book')~"'        ")
  IF Novacio(FBN('FechaEj'))
     SQL.ADD(" AND   FechaEj  = "~idxdate2(FBN('FechaEj'))~" ")
  Endif
  SQL.ADD(" AND   Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   TipoResultado IN ('TRADE','REALIZ','REVAL','RIEXP') ")
  SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS R1 ")
  SQL.ADD("                 WHERE R.Especie  = R1.Especie  ")
  SQL.ADD("                 AND   R.NrSaldo  = R1.NrSaldo  ")
  SQL.ADD("                 AND   R.Vehiculo = R1.Vehiculo ")
  SQL.ADD("                 AND   R.Book     = R1.Book     ")
  SQL.ADD("                 AND   R.TipoResultado  = R1.TipoResultado    ")
  SQL.ADD("                 AND   (R.Sector   = R1.Sector   OR (R.Sector   IS NULL AND R1.Sector   IS NULL) ) ")
  SQL.ADD("                 AND   (R.CallPut  = R1.CallPut  OR (R.CallPut  IS NULL AND R1.CallPut  IS NULL) ) ")
  SQL.ADD("                 AND   (R.Cupon    = R1.Cupon    OR (R.Cupon    IS NULL AND R1.Cupon    IS NULL) ) ")
  SQL.ADD("                 AND   (R.FechaEj  = R1.FechaEj  OR (R.FechaEj  IS NULL AND R1.FechaEj  IS NULL) ) ")
  SQL.ADD("                 AND   (R.PrecioEj = R1.PrecioEj OR (R.PrecioEj IS NULL AND R1.PrecioEj IS NULL) ) ")
  SQL.ADD("                 AND   R1.Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ) ")
  Recorrer SQL
    dfa
    If Eqstr(fbn('TipoResultado'),'TRADE')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(n:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(o:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(p:fac, fbn('YTD'))
       Endif
    Endif
    If Eqstr(fbn('TipoResultado'),'REALIZ')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(q:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(r:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(s:fac, fbn('YTD'))
       Endif
    Endif
    If Eqstr(fbn('TipoResultado'),'REVAL')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(t:fac, Val(g:fac)*(Val(i:fac)-Val(h:fac)))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(u:fac, 0)
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(v:fac, 0)
       Endif
    Endif
    If Eqstr(fbn('TipoResultado'),'RIEXP')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(w:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(x:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(y:fac, fbn('YTD'))
       Endif
    Endif

    SetFont(a:fac..z:fac, 1)
    FormatoCeldas(k:fac..z:fac, EXE('F2'))
  Proximo

  FormatoCeldas(d:fac..g:fac, EXE('F2'))
  FormatoCeldas(H:fac..j:fac, EXE('F9'))
  SetFont(a:fac..z:fac, 1)

  ACN(xx:1, fbn('NrSaldo'))
  ACT(xx:2, fbn('Vehiculo'))
  ACT(xx:3, fbn('Book'))
Proximo

