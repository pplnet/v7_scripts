        SCN(tt:11, Val(w:fac) )
        SCN(tt:12, Val(x:fac) )
        SCN(tt:13, Val(y:fac) )

        * --- Sumo totales para vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(n:fac) )
        SCN(tv:3, Val(o:fac) )
        SCN(tv:4, Val(p:fac) )
        SCN(tv:5, Val(q:fac) )
        SCN(tv:6, Val(r:fac) )
        SCN(tv:7, Val(s:fac) )
        SCN(tv:8, Val(t:fac) )
        SCN(tv:9, Val(u:fac) )
        SCN(tv:10, Val(v:fac) )
        SCN(tv:11, Val(w:fac) )
        SCN(tv:12, Val(x:fac) )
        SCN(tv:13, Val(y:fac) )
        ifa

        ACT(a:fac,  'Total Book: '~Val(xx:3))
        * --- Imprimo Totales para Book
        ACN(l:fac,Val(tt:1))
        ACN(n:fac,Val(tt:2))
        ACN(o:fac,Val(tt:3))
        ACN(p:fac,Val(tt:4))
        ACN(q:fac,Val(tt:5))
        ACN(r:fac,Val(tt:6))
        ACN(s:fac,Val(tt:7))
        ACN(t:fac,Val(tt:8))
        ACN(u:fac,Val(tt:9))
        ACN(v:fac,Val(tt:10))
        ACN(w:fac,Val(tt:11))
        ACN(x:fac,Val(tt:12))
        ACN(y:fac,Val(tt:13))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0)
        ifa
        ifa
        ACT(a:fac, 'Total Vehiculo '~Val(xx:2))
        ACN(l:fac,Val(tv:1))
        ACN(n:fac,Val(tv:2))
        ACN(o:fac,Val(tv:3))
        ACN(p:fac,Val(tv:4))
        ACN(q:fac,Val(tv:5))
        ACN(r:fac,Val(tv:6))
        ACN(s:fac,Val(tv:7))
        ACN(t:fac,Val(tv:8))
        ACN(u:fac,Val(tv:9))
        ACN(v:fac,Val(tv:10))
        ACN(w:fac,Val(tv:11))
        ACN(x:fac,Val(tv:12))
        ACN(y:fac,Val(tv:13))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR8'))
        ifa
        ifa
        IFA
        ACN(fi:1, fac)
        * --- Limpia Totales por Book
        ACN(tt:1, 0 )
        ACN(tt:2, 0 )
        ACN(tt:3, 0 )
        ACN(tt:4, 0 )
        ACN(tt:5, 0 )
        ACN(tt:6, 0 )
        ACN(tt:7, 0 )
        ACN(tt:8, 0 )
        ACN(tt:9, 0 )
        ACN(tt:10, 0 )
        ACN(tt:11, 0 )
        ACN(tt:12, 0 )
        ACN(tt:13, 0 )

        * --- Limpia Totales por vehiculo
        ACN(tv:1, 0 )
        ACN(tv:2, 0 )
        ACN(tv:3, 0 )
        ACN(tv:4, 0 )
        ACN(tv:5, 0 )
        ACN(tv:6, 0 )
        ACN(tv:7, 0 )
        ACN(tv:8, 0 )
        ACN(tv:9, 0 )
        ACN(tv:10, 0 )
        ACN(tv:11, 0 )
        ACN(tv:12, 0 )
        ACN(tv:13, 0 )
     Endif
     ACN(xx:1, 0)
     ACT(xx:3, '')
  Endif

  If Not Eqstr(fbn('Book'), Val(xx:3))
     If Not Eqstr('', Val(xx:3))
        If Val(xx:1)=121 o Val(xx:1)=172
           ACT(a:fac, 'Total Titulos')
        Endif
        If Val(xx:1)=31 o Val(xx:1)=51
           ACT(a:fac, 'Total FX')
        Endif
        If Val(xx:1)=43
           ACT(a:fac, 'Total OCT')
        Endif
        If Val(xx:1)=44
           ACT(a:fac, 'Total Rofex')
        Endif
        If Val(xx:1)=45
           ACT(a:fac, 'Total Internal FX Exposure')
        Endif
        If Val(xx:1)=42
           ACT(a:fac, 'Total FX NDF')
        Endif
        If Val(xx:1)=41
           ACT(a:fac, 'Total FX DF')
        Endif
        * --- Imprime totales por tipo 
        ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
        ACN(n:fac, SUM(n:Val(fi:1)..n:fac) )
        ACN(o:fac, SUM(o:Val(fi:1)..o:fac) )
        ACN(p:fac, SUM(p:Val(fi:1)..p:fac) )
        ACN(q:fac, SUM(q:Val(fi:1)..q:fac) )
        ACN(r:fac, SUM(r:Val(fi:1)..r:fac) )
        ACN(s:fac, SUM(s:Val(fi:1)..s:fac) )
        ACN(t:fac, SUM(t:Val(fi:1)..t:fac) )
        ACN(u:fac, SUM(u:Val(fi:1)..u:fac) )
        ACN(v:fac, SUM(v:Val(fi:1)..v:fac) )
        ACN(w:fac, SUM(w:Val(fi:1)..w:fac) )
        ACN(x:fac, SUM(x:Val(fi:1)..x:fac) )
        ACN(y:fac, SUM(y:Val(fi:1)..y:fac) )
        SetFont(a:fac..z:fac, 3)

        * --- Suma totales para Book
        SCN(tt:1, Val(l:fac) )
        SCN(tt:2, Val(n:fac) )
        SCN(tt:3, Val(o:fac) )
        SCN(tt:4, Val(p:fac) )
        SCN(tt:5, Val(q:fac) )
        SCN(tt:6, Val(r:fac) )
        SCN(tt:7, Val(s:fac) )
        SCN(tt:8, Val(t:fac) )
        SCN(tt:9, Val(u:fac) )
        SCN(tt:10, Val(v:fac) )
        SCN(tt:11, Val(w:fac) )
        SCN(tt:12, Val(x:fac) )
        SCN(tt:13, Val(y:fac) )

        * --- Suma totales para Vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(n:fac) )
        SCN(tv:3, Val(o:fac) )
        SCN(tv:4, Val(p:fac) )
        SCN(tv:5, Val(q:fac) )
        SCN(tv:6, Val(r:fac) )
        SCN(tv:7, Val(s:fac) )
        SCN(tv:8, Val(t:fac) )
        SCN(tv:9, Val(u:fac) )
        SCN(tv:10, Val(v:fac) )
        SCN(tv:11, Val(w:fac) )
        SCN(tv:12, Val(x:fac) )
        SCN(tv:13, Val(y:fac) )

        ifa
        ACT(a:fac,  'Total Book: '~Val(xx:3))
        * --- Imprime Totales paar Book
        ACN(l:fac,Val(tt:1))
        ACN(n:fac,Val(tt:2))
