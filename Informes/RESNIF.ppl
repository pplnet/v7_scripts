        ACN(x:fac, SUM(x:Val(fi:1)..x:fac) )
        ACN(y:fac, SUM(y:Val(fi:1)..y:fac) )
        SetFont(a:fac..z:fac, 3)
        * --- Sumo totales para Book
        SCN(tt:1, Val(l:fac) )
        SCN(tt:2, Val(n:fac) )
        SCN(tt:3, Val(o:fac) )
        SCN(tt:4, Val(p:fac) )
        SCN(tt:5, Val(q:fac) )
        SCN(tt:6, Val(r:fac) )
        SCN(tt:7, Val(s:fac) )
        SCN(tt:8, Val(t:fac) )
