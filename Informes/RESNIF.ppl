        ACN(y:fac,Val(tt:13))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0)
        ifa
        ifa
        ACN(fi:1, fac)
        * --- Limpia totales para Book
        ACN(tt:1, 0 )
        ACN(tt:2, 0 )
        ACN(tt:3, 0 )
        ACN(tt:4, 0 )
        ACN(tt:5, 0 )
        ACN(tt:6, 0 )
