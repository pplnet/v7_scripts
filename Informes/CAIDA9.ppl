CrearDialogo
  Fecha1     : "Fecha Vigencia"    ;;;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Fecha2     : "Fecha Desde"       ;;;;;;[Dialogo.Fecha2 = Dialogo.Fecha1] O [Dialogo.Fecha2 = PriDeMes(Dialogo.Fecha2, NO, 'ARG') Y Dialogo.Fecha2 >= Dialogo.Fecha1];'Fecha Desde Invalida';NO;Fsys;
  Fecha3     : "Fecha Hasta"       ;;;;;;[Dialogo.Fecha3 >= Dialogo.Fecha2 Y Dialogo.Fecha3 = FinDeMes(Dialogo.Fecha3, NO, 'ARG')];'Fecha Hasta Invalida';NO;FinDeMes(Fsys, NO, 'ARG');
  Especie1   : "Especie"           ;;;;;;;;;;;;;
  Cliente1   : "Entidad"           ;;;;;;;;;;;;;
  Check1     : "Capital|Inter|Imp" ;1;2;;;;;;;1
  Radio1     : "Expresado|ARP|USD" ;;;;;;;;;1
  Lista1     : "Vehiculo"          ;8;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Lista2     : 'Tipo Op.'          ;2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' ");
  String1    : 'Grupo'             ;;;;NO;NO;
  String2    : 'DescImp'           ;;;;NO;NO;
  Entero1    : 'Unidades Expr.'    ;;;;NO;NO;
  String3    : "Especie ON"        ;;;;NO;NO;
  String4    : 'DescImp'           ;;;;NO;NO;
  Radio5     : 'Tasa Ficticia'     ;;;;NO;NO;
FinDialogo

if Not Ok
  Cancelar
endif


CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,7,")
CrearFont(5,"Arial,12,BI")

ACT(LS:1, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
ACT(LS:2, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' "))

SetFilaActual(2)

ACT(a:FAC," Detalle Caida de Deuda al "~Dialogo.Fecha1 )
SetFont(a:fac..a:fac,3)

SetFilaActual(3)

ACT(A:fac+1, 'Fecha Desde: '~Dialogo.Fecha2)
if Elementos(Dialogo.Lista2) < Elementos(Val(LS:2))
  ACT(D:FAC+1, 'Tipo Op.: '~Dialogo.Lista2)
else
  ACT(D:FAC+1, 'Tipo Op.: Todas')
endif
ACT(A:fac+2, 'Fecha Hasta: '~Dialogo.Fecha3)
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+3, 'Entidad : Todos')
endif
if Elementos(Dialogo.Lista1) < Elementos(Val(LS:1))
  ACT(D:FAC+4, 'Vehiculos : '~Dialogo.Lista1)
else
  ACT(D:FAC+4, 'Vehiculos : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+4, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+4, 'Especie : Todas')
endif
ACT(D:fac+3, 'Concepto: '~Dialogo.String1~' '~Dialogo.String3)

act(D:fac+2,'Expresado en Miles de '~IIF(Dialogo.Radio1=0, Var('MONELOCA'), Var('MONEEXTR')))
If Dialogo.Check1=0
   act(a:fac+6, 'CAPITAL')
EndIf
If Dialogo.Check1=1
   act(a:fac+6, 'INTERES')
EndIf
If Dialogo.Check1=2
   act(a:fac+6, Dialogo.String4)
EndIf

SetFont(a:fac..N:FAC+6,2)
SetFilaActual(FAC+7)

ACT(a:FAC, 'Fecha Op.')
ACT(b:FAC, 'Plazo')
ACT(c:FAC, 'Vehiculo')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Importe')
ACT(F:FAC, 'Fecha Vto.')
ACT(G:FAC, 'Tipo Op.')
ACT(H:FAC, 'Numero Op.')
ACT(I:FAC, 'Cliente')

***---MV:1 se usa para compratir las funciones con informe Anticuacion de Deuda
ACN(MV:1, 0)

AgregarMarco(a:FAC..I:FAC,2,0,Exe('COLOR6'))

SetFont(a:FAC..J:FAC,2)

IF Dialogo.Check1 = 0
    (.'CAIDA8A'.)
    SQL.ADD(" UNION ")
    (.'CAIDA8AS'.)
ENDIF
IF Dialogo.Check1 = 1
    (.'CAIDA8B'.)
*    SQL.ADD(" UNION ")
*    (.'CAIDA8BS'.)
*    SQL.ADD(" UNION ")
*    (.'CAIDA8B-CF'.)
ENDIF
IF Dialogo.Check1 = 2
    (.'CAIDA8C'.)
ENDIF


SQL.ADD(" Order By 1, 9, 8, 10, 5, 6 ")

ACN(CX:1, CotizacionC(Var('MONELOCA'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
ACN(CX:2, CotizacionC(Var('MONEEXTR'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
ACN(EX:1, Dialogo.Entero1)
ACN(TO:1, 0)
ACN(FI:1, fac+1)

Recorrer SQL
    IF Eqstr(fbn('Grupo'), Dialogo.String1)
       Message(' ***---Grupo de Operaciones pedidas')


        IF [Dialogo.Check1 = 2 Y Eqstr(fbn('DescImp'), Dialogo.String2)] O [Dialogo.Check1 <> 2] 
           Message('***---No es impuesto o el impuesto pedido')
            ACN(IM:2, fbn('Importe'))
            IF [Dialogo.Radio5 = 1] Y [fbn('BD1') = 1 O [fbn('BD1') = 2 Y Not Eqstr(fbn('DescImp'), 'COMISIONES')]]  Y [Not Eqstr(fbn('TipoTasa'), 'FIJA')] Y fbn('NrCuota') > 0 y FBN['Tasa']=0
               Message('***---Tasa = 0, pidio ficticia y no es fija. (Interes o impuesto) ')
               IF Incluido(fbn('Tipo'),'SWAP|SCAP/FLOOR')
                    ACT(NT:1, fbn('OperacionRef'))
                ELSE
                    ACT(NT:1, fbn('NrOperacion'))
                ENDIF

                *--- Swaps y Caps/Floor ts2: Si hay que calcular vehiculo o contraparte
                ACT(ts2,FBN['Pata'])

                (.'MONTOTOMV'.)
                DFA
                IF fbn('BD1') = 1
                    ACN(IM:2, Val(MT:2))
                ELSE
                    IF Eqstr(fbn('DescImp'), 'WHT')
                        ACN(IM:2, Val(MT:4))
                    ELSE
                        ***---Impuesto al interes
                        ACN(IM:2, Val(MT:5))
                    ENDIF
                ENDIF
            ENDIF
            IF Val(IM:2) <> 0
                IF Dialogo.Radio1 = 0
                    ***---Expresado en $
                    IF Eqstr(fbn('Especie'), Var('MONELOCA'))
                        ACN(IM:1, Val(IM:2))
                    ELSE
                        IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
                            ACN(IM:1, Val(IM:2) * Val(CX:2))
                        ELSE
                            ACN(CX:3, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
                            ACN(IM:1, Val(IM:2) * Val(CX:3))
                        ENDIF
                    ENDIF
                ELSE
                    ***---Expresado en U$S
                    IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
                        ACN(IM:1, Val(IM:2))
                    ELSE
                        IF Eqstr(fbn('Especie'), Var('MONELOCA'))
                            ACN(IM:1, Val(IM:2) * Val(CX:1))
                        ELSE
                            ACN(CX:3, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
                            ACN(IM:1, Val(IM:2) * Val(CX:3))
                        ENDIF
                    ENDIF
                ENDIF
                ACD(A:fac, fbn('FechaOp'))
                ACN(B:fac, fbn('FechaVto') - Dialogo.Fecha1)
                ACT(C:fac, fbn('Clave'))
                ACT(D:fac, fbn('Especie'))
                ACN(E:fac, Val(IM:1)/Val(EX:1))
                SCN(TO:1, Val(E:fac))
                ACD(F:fac, fbn('Vto'))
                ACT(G:fac, fbn('TipoOp'))
                IF Incluido(fbn('Tipo'), 'SWAP|SCAP/FLOOR')
                    ACT(H:fac, fbn('OperacionRef'))
                    ACLO(H:fac, fbn('OperacionRef'))
                ELSE
                    ACT(H:fac, fbn('NrOperacion'))
                    ACLO(H:fac, fbn('NrOperacion'))
                ENDIF
                ACT(I:fac, fbn('Cliente1'))
            ELSE
                DFA
            ENDIF
        ELSE
            DFA
        ENDIF
    ELSE
        DFA
    ENDIF
Proximo

SetFont(A:Val(FI:1)..J:fac, 1)
AgregarMarco(A:Val(FI:1)..I:fac, 2, 0)

FormatoCeldas(B:Val(FI:1)..B:fac, Exe('F0'))
ifa
ACT(A:fac, 'TOTAL')
ACN(E:fac, Val(TO:1))
SetFont(A:fac..E:fac, 2)
FormatoCeldas(E:Val(FI:1)..E:fac, Exe('F2'))
AgregarMarco(A:fac..I:fac, 2, 0,Exe('COLOR6'))

SetFilaActual(fac+2)
ACT(A:fac, 'FIN DEL LISTADO')
SetFont(A:fac, 2)
LimitesVision(n:fac+1)