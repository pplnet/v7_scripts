CrearDialogo
  Fecha1 : 'Fecha';;;;;;;;;FSys
FinDialogo


ACT(a1, 'Money Markets - Operaciones de Call pactadas en el dia')
ACT(a2, 'Fecha : '~Dialogo.Fecha1)
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SQL.ADD("Select * from "~DBO~".OPERACIONES where TipoOp in ('MMCO','MMCT')")
SQL.ADD("and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("order by TipoOp, NrOperacion")

SetFont(a1..p4, 1)
SetFilaActual(2)
recorrer SQL
  if Not EqStr(fbn('TipoOp'), Val(z1))
    ifa
    ACT(a:fac, 'Tipo : '~fbn('TipoOp')~" - "~BuscarCampo('TIPOSOPERACION', 'Nombre', 'Codigo', fbn('TipoOp')))
    ACT(z1, fbn('TipoOp'))
    ifa
    ACT(a:fac, 'Nro.Oper.')
    ACT(b:fac, 'Moneda')
    ACT(c:fac, 'Cliente')
    ACT(d:fac, 'Cantidad')
    ACT(e:fac, 'Tasa')
    ACT(f:fac, 'Plazo')
    ACT(g:fac, 'Fecha Vto.')
    ACT(h:fac, 'Intereses')
    ACT(i:fac, 'Total')
    ACT(j:fac, 'Numerales')
    ACT(k:fac, 'Operador')
    AlinearCeldas(d:fac..f:fac, 'D')
    AlinearCeldas(h:fac..j:fac, 'D')
    AgregarMarco(a:fac-1..k:fac,2,0,Exe('COLOR'))
    SetFont(a:fac-1..p:fac, 1)
    ifa
  endif
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente1'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Precio1'))
  ACN(f:fac, fbn('Plazo'))
  ACT(g:fac, fbn('FechaVto'))
  ACN(h:fac, fbn('TotalIntereses'))
  ACN(i:fac, fbn('TotalBrutoCli1'))
* MB - ESTA VARIABLE NO EXISTE EN NUESTRA INSTALACION DE ING, POR ESO LO DESHABILITE
*  if Incluido(fbn('TipoOp'), Exe('RENUEVANUM'))
*    ACN(j:fac, Val(d:fac)*(FinDeMes(Dialogo.Fecha1)-fbn('FechaOp')))
*  else
    ACN(j:fac, Val(d:fac)*(Min(FinDeMes(Dialogo.Fecha1),fbn('FechaVto'))-fbn('FechaOp')))
*  endif
  ACT(k:fac, fbn('Operador'))
  SetFont(a:fac..o:fac, 2)
proximo

FormatoCeldas(e:5..e:fac, Exe('F7'))
FormatoCeldas(f:5..f:fac, Exe('F0'))
FormatoCeldas(h:5..j:fac, Exe('F2'))
*Impresion(1,2)
ACO(12,9)
ACO(6,6)
LimitesVision(l:fac+1)