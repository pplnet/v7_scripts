MostrarCuadroDeMensajes
CrearDialogo
  Cliente1 : 'Cliente' ;;;;;;NoVacio(Dialogo.Cliente1) y EsTerminal(Dialogo.Cliente1, Cliente);'Debe Ingresar un Cliente Valido';NO;Dialogo.Cliente1
  Vehiculo1: 'Vehiculo';;;;;;;;;VAR('VEHICULODE')
  Fecha1   : 'Fecha '  ;;;;;;;;;FSys
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

ACT(a:4, 'Limites de Credito por Contraparte')
ACT(a:5, 'Cliente: '~Dialogo.Cliente1)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:6, 'Vehiculo: '~Dialogo.Vehiculo1)
else
  ACT(a:6, 'Vehiculo: Todos (Consolidado)')
endif
ACT(a:7, 'Fecha: '~Fecha(Dialogo.Fecha1))
ACT(a:9, 'Fecha Revision Cliente: '~BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1))

ACT(a:11, 'Tipo Limite')
*ACT(b:11,'Plazo')
ACT(c:11,'Asignado')
ACT(d:11,'Utilizado')
*ACT(e:11,'Revaluado')
ACT(f:11,'Disponible')
ACT(g:11,'Estado')
AlinearCeldas(c:11..f:11, 'D')
SetFont(a:1..z:11, 1)

ACT(a:12,'Due From Currency')
*ACT(a:17,'Due From Securities')
ACT(a:13,'PreSettlement')
*ACT(a:27,'PreSettlement Repos')
*ACT(a:32,'Asistencia BCRA')
ACT(a:14,'Settlement hoy')

recorrer&i 12,14
  ACT(g:&i,'No Asignado')
proximo
ACT(g:14,'No Asignado')
ColorCeldas(g:12..g14,clRED)

AgregarMarco(a:11..g:11, 1,0, Exe('COLOR6'))
AgregarMarco(a:11..g:14, 1)

* FJL 14/8/18 - En V6 no se carga LimOperativo en la tabla LIMASIGNADOS
*ACN(c:12, LimOperativo(Dialogo.Cliente1, 'DFROM','USD',Dialogo.Vehiculo1))
*ACN(c:13, LimOperativo(Dialogo.Cliente1, 'PRESETTLEM','USD',Dialogo.Vehiculo1))
*ACN(c:14, LimOperativo(Dialogo.Cliente1, 'SETTLEMENT','USD',Dialogo.Vehiculo1))
act(aa:12,'DFROM')
act(aa:13,'PRESETTLEM')
act(aa:14,'SETTLEMENT')
ACN(c:12, LimAsignado(Dialogo.Cliente1, 'DFROM','USD',Dialogo.Vehiculo1))
ACN(c:13, LimAsignado(Dialogo.Cliente1, 'PRESETTLEM','USD',Dialogo.Vehiculo1))
ACN(c:14, LimAsignado(Dialogo.Cliente1, 'SETTLEMENT','USD',Dialogo.Vehiculo1))

ACN(d:12, LimConsumido(Dialogo.Cliente1,'DFROM','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))
ACN(d:13, LimConsumido(Dialogo.Cliente1,'PRESETTLEM','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))

ACN(d:14, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Dialogo.Fecha1,Dialogo.Vehiculo1))
SCN(d:14, LimConsumido(Dialogo.Cliente1,'SETCRE','USD',0,Dialogo.Vehiculo1,,,,Dialogo.Fecha1))
recorrer&i 12,31
  if Val(c:&i)>0
    ACT(g:&i, 'OK')
    ColorCeldas(g:&i,clGREEN)
  endif
  ACN(f:&i, Val(c:&i)-Val(d:&i))
proximo

if Val(c:14)>0
  ACT(g:14, 'OK')
  ColorCeldas(g:14,clGREEN)
endif
ACN(f:14, Val(c:14)-Val(d:14))

ACD(i:15, Habiles(Dialogo.Fecha1,1,'ARG',SI))
ACD(i:16, Habiles(Dialogo.Fecha1,2,'ARG',SI))
ACD(i:17, Habiles(Dialogo.Fecha1,3,'ARG',SI))

ACT(a:15, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,1,'ARG',SI)))
ACT(a:16, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,2,'ARG',SI)))
ACT(a:17, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,3,'ARG',SI)))

ACN(c:15, Val(c:14))
ACN(c:16, Val(c:14))
ACN(c:17, Val(c:14))

ACN(d:15, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Habiles(Dialogo.Fecha1,1,'ARG',SI),Dialogo.Vehiculo1))
ACN(d:16, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Habiles(Dialogo.Fecha1,2,'ARG',SI),Dialogo.Vehiculo1))
ACN(d:17, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Habiles(Dialogo.Fecha1,3,'ARG',SI),Dialogo.Vehiculo1))

SCN(d:15, LimConsumido(Dialogo.Cliente1,'SETCRE','USD',0,Dialogo.Vehiculo1,,,,Habiles(Dialogo.Fecha1,1,'ARG',SI)))
SCN(d:16, LimConsumido(Dialogo.Cliente1,'SETCRE','USD',0,Dialogo.Vehiculo1,,,,Habiles(Dialogo.Fecha1,2,'ARG',SI)))
SCN(d:17, LimConsumido(Dialogo.Cliente1,'SETCRE','USD',0,Dialogo.Vehiculo1,,,,Habiles(Dialogo.Fecha1,3,'ARG',SI)))

