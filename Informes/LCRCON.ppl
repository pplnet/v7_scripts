SetFilaActual(17)
SQL.ADD("Select Distinct Fecha from "~DBO~".LIMCONSUMIDOS ")
SQL.ADD("where Cliente='"~Dialogo.Cliente1~"' ")
SQL.ADD("and Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and Limite='SETTLEMENT' ")
SQL.ADD("and Monto<>0 ")
SQL.ADD("and Fecha >'"~IdxDate(Habiles(Dialogo.Fecha1,3,'ARG',SI))~"'") 
Recorrer SQL
  ACT(g:fac,'No Asignado')
  ColorCeldas(g:fac,clRED)
  ACD(i:fac, fbn('Fecha'))
  ACT(a:fac, 'Settlement '~fbn('Fecha'))
  ACN(c:fac, Val(c:14))
  if BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)<Val(i:fac) y BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)>0
    ACN(c:fac, 0)
  endif
  if Val(c:fac)>0
    ACT(g:fac, 'OK')
    ColorCeldas(g:fac,clGREEN)
  endif
  ACN(d:fac, LimSumado(Dialogo.Cliente1,'SETTLEMENT',fbn('Fecha'),Dialogo.Vehiculo1))
  SCN(d:fac, LimConsumido(Dialogo.Cliente1,'SETCRE','USD',0,Dialogo.Vehiculo1,,,,fbn('Fecha')))
  ACN(e:fac, LimTotalizado3(Dialogo.Cliente1,'SETTLEMENT',fbn('Fecha'),Dialogo.Vehiculo1,,,,,,,,,,,,,'USD'))
  SCN(e:fac, LimTotalizado3(Dialogo.Cliente1,'SETCRE',0,Dialogo.Vehiculo1,,,,fbn('Fecha'),,,,,,,,,'USD'))
  ACN(f:fac, Val(c:fac)-Val(d:fac))
  if Val(d:fac)<>0
** FJL 8/8/18 - V6 No acepta TipoLimite1
*    ACL(d:fac, 'DETLCR', Cliente1=Dialogo.Cliente1, TipoLimite1='SETTLEMENT', Vehiculo1=Dialogo.Vehiculo1, Fecha1=Val(i:fac))
    ACL(d:fac, 'DETLCR', Cliente1=Dialogo.Cliente1, String1='SETTLEMENT', Vehiculo1=Dialogo.Vehiculo1, Fecha1=Val(i:fac))
  endif
proximo

recorrer&i 12, fac
  if Val(f:&i) < 0
    ACT(g:&i, 'Excedido')
    ColorCeldas(g:&i,clRED)
    if &i<15
    *      if BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)<Dialogo.Fecha1 y BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)>0
      if VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD')<Dialogo.Fecha1 y VtoLimite('DFROM',Dialogo.Cliente1,'USD') >0
        ACT(g:&i, 'Vencido - '~Val(g:&i))
        ColorCeldas(g:&i,clRED)
      endif
    else
    *      if BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)<Val(i:&i) y BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)>0
      if VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD')<Val(i:&i) y VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD') >0
        ACT(g:&i, 'Vencido - '~Val(g:&i))
        ColorCeldas(g:&i,clRED)
      endif
    endif
  else
    if Val(c:&i) > 0
       if &i<14
       *          if BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)<Dialogo.Fecha1 y BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)>0
          if VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD')<Dialogo.Fecha1 y VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD')>0
             ACT(g:&i, 'Vencido')
             ColorCeldas(g:&i,clRED)
          endif
       else
       *          if BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)<Val(i:&i) y BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)>0
          if VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD')<Val(i:&i) y VtoLimite(val(aa:&i),Dialogo.Cliente1,'USD')>0
            ACT(g:&i, 'Vencido')
            ColorCeldas(g:&i,clRED)
          endif
       endif
    endif
  endif
proximo

