recorrer&i 15,17
  ACT(g:&i,'No Asignado')
  ColorCeldas(g:&i,clRED)
  if BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)<Val(i:&i) y BuscarCampo('CLIENTES','Fecha1','Codigo',Dialogo.Cliente1)>0
    ACN(c:&i, 0)
  endif
  if Val(c:&i)>0
    ACT(g:&i, 'OK')
    ColorCeldas(g:&i,clGREEN)
  endif
  ACN(f:&i, Val(c:&i)-Val(d:&i))
  if Val(d:&i)<>0
** FJL 8/8/18 - V6 No acepta TipoLimite1
*    ACL(d:&i, 'DETLCR', Cliente1=Dialogo.Cliente1, TipoLimite1='SETTLEMENT', Vehiculo1=Dialogo.Vehiculo1, Fecha1=Val(i:&i))
    ACL(d:&i, 'DETLCR', Cliente1=Dialogo.Cliente1, String1='SETTLEMENT', Vehiculo1=Dialogo.Vehiculo1, Fecha1=Val(i:&i))
