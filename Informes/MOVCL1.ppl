                        ACT(xy2, Copy(val(e:fac),1,val(xy1))~''~Copy(val(e:fac),10+Val(xy1),Longitud(Val(e:fac))))
                        ACT(e:FAC, Val(xy2))
                      Endif                       
                   Endif
                Else 
                   ACT(e:FAC, FBN['Leyenda'])
                Endif
             Endif
          Endif
          **-- Cotizacion de Especie contra moneda del reporte 
