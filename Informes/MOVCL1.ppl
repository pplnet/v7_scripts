          ACT(v10, 'SI')
          ACT(v11, 'SI')
       Endif
       **-- Corte por Estado (se chequea el NrSaldo)
       If FBN['NrSaldo'] <> Val(v4)
          If EqStr(Val(v11),'SI')
*             If Not DesciendedeEspecie(Val(v2), 'MONEDA')
             If Not Incluido(Val(V:2), Val(MN:1))
             ACT(a:FAC, 'Total Estado')
