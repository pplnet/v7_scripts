*   ACT(e:FAC+2, Val(e:FAC+2)~'Pesos')
*Else
*   ACT(e:FAC+2, Val(e:FAC+2)~'Dolares')
*Endif

ACT(g:FAC+2, 'Listado '~iif(Dialogo.Check1=1,'con ','sin ')~'movimientos de Comisiones e IVA ')

ACT(g:FAC+3, 'Movs Ejecutados: Azul')
ACT(g:FAC+4, 'Movs Pendientes: Verde')

SetFont(a:FAC+2..g:FAC+5, 2)
SetFilaActual(FAC+7)

**-- Encabezado
ACT(a:FAC, 'EJE/PEN')
ACT(b:FAC, 'Fecha Vto')
ACT(c:FAC, 'Fecha Conc')
ACT(d:FAC, 'Nro. Op.')
ACT(e:FAC, 'Concepto')
ACT(f:FAC, 'Debito VN')
ACT(g:FAC, 'Debito VR')
ACT(h:FAC, 'Debito $/U$S')
ACT(i:FAC, 'Credito VN')
ACT(j:FAC, 'Credito VR')
ACT(k:FAC, 'Credito $/U$S')
ACT(l:FAC, 'Saldo VN')
ACT(m:FAC, 'Saldo VR')
*ACT(n:FAC, 'Saldo $/U$S')
ACT(N:FAC, 'Precio')
ACT(O:FAC, 'VR a la Fecha')

SetFont(a:FAC..O:FAC, 2)
AlinearCeldas(a:FAC..O:FAC, 'C')
AgregarMarco(a:FAC..O:FAC,0,1,EXE('COLOR'))

ACO(1, 5)
