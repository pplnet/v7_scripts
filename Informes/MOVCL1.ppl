*          If Not DesciendedeEspecie(Val(v2), 'MONEDA')
             If Not Incluido(Val(V:2), Val(MN:1))
          **-- Saldo Inicial de cada estado
          If EqStr(FBN['TipoOp'],'SALINI')
             ACN(l:FAC, FBN['Cantidad'])
** FJL 29/06/23 - Issue 6041 - Tomaba 0 cuando el bono estaba madurado
*             ACN(m:FAC, FBN['Cantidad']*VALORTEORICO2(FBN['Especie'],Dialogo.Fecha2-1))
              ACN(m:FAC, FBN['Cantidad']*VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1-1))
