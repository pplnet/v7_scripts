          ACT(v11, 'SI') 
       Endif
       **-- Proceso todos los movs. de transacciones y operaciones
       If Not EqStr(FBN['TipoOp'],'SALINI')
          ACT(a:FAC, FBN['Auxiliar'])
          ACD(b:FAC, FBN['FechaMov'])
          ACD(c:FAC, FBN['FechaOp'])
          ACT(d:FAC, FBN['NrOperacion'])
          **-- Plazo de la Operacion en Horas 
          If FBN['Plazo'] MOD2(24) = 0
             ACN(pl1, FBN['Plazo'])
          Else
             ACN(pl1, FBN['Plazo2'])
          Endif
          If Incluido(FBN['TipoOp'], 'DTP|RTP|CAMEST|PDIVID|CUPON|LCUPON|DRT|CANJE|STOCK|DENOP|RENOP|TRNOP')
             ACLT(d:FAC, FBN['NrOperacion'])
             ACT(e:FAC, FBN['Leyenda'])
             ACT(v5, CotizaEn(FBN['Especie']))
             ** Sumo las comisiones (comision e IVA) de pago de dividendos y liq. corte cupon
             If Incluido(FBN['TipoOp'], 'PDIVID|LCUPON|')
                ACN(zz1,SQL("SELECT Sum(Cantidad) FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Cliente='"~FBN['Cliente']~"' and NrSaldo=4 AND Mercado='"~FBN['Mercado']~"'") )
             Endif
          Else
             ACT(pf1, COPY(FBN['NrOperacion'],1,2))
             if EqStr(Val(pf1),'OR')
                ACLR(d:FAC, FBN['NrOperacion'])
                ACT(e:FAC, FBN['Leyenda'])
                ACT(v5, CotizaEn(FBN['Especie']))
             Else
                if Incluido(Val(pf1),'DV|CA|CJ')
                   ACLT(d:FAC, FBN['NrOperacion'])
                else
                   ACLO(d:FAC, FBN['NrOperacion'])
                endif
                If Incluido(FBN['TipoOp'], 'TIC|TIV|CTC|CTP|VTC|VTP|TCC|VFTP|CFTP|TIPO|TIDE|TICO|TICT|TCP|TVC|TVP|TIFC|TIFV|')
                   ACT(e:FAC, FBN['Leyenda']~'/'~FStr(Val(pl1),0,0)~' Hs.')
                   ACT(v5, CotizaEn(FBN['Especie']))
                   **** Invierto la Leyenda para ponerla en cara del cliente
                   IF EqStr(FBN['CPC1'],'NO')   y not Incluido(fbn('NrMov'), '11|12|13|14')
                      IF Incluido(FBN['TipoOp'], 'TIC|TIFC')
                         ACT(e:FAC, 'Venta'~Copy(Val(e:FAC),Longitud('Compra')+1,Longitud(Val(e:FAC))) )
                      Endif
                      IF Incluido(FBN['TipoOp'], 'TIV|TIFV')
                         ACT(e:FAC, 'Compra'~Copy(Val(e:FAC),Longitud('Venta')+1,Longitud(Val(e:FAC))) )
                      Endif
                      IF Incluido(FBN['TipoOp'], 'TICT|')
                        ACN(xy1, Posicion('Tomado',Val(e:fac), 1, Longitud(Val(e:fac))) -1)
                        ACT(xy2, Copy(val(e:fac),1,val(xy1))~'Otorgado '~Copy(val(e:fac),8+Val(xy1),Longitud(Val(e:fac))))
                        ACT(e:FAC, Val(xy2))
                      Endif
                      IF Incluido(FBN['TipoOp'], 'TICO|')
                        ACN(xy1, Posicion('Otorgado',Val(e:fac), 1, Longitud(Val(e:fac))) -1)
                        ACT(xy2, Copy(val(e:fac),1,val(xy1))~'Tomado '~Copy(val(e:fac),10+Val(xy1),Longitud(Val(e:fac))))
                        ACT(e:FAC, Val(xy2))
                      Endif
                      IF Incluido(FBN['TipoOp'], 'TIPO|')
