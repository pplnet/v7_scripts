          *Endif
          *If Dialogo.Radio1 = 1 y EqStr(Val(v5), VAR('MONEEXTR'))   
          *   ACN(cg:FAC, 1)
          *Endif
          *If Dialogo.Radio1 = 1 y EqStr(Val(v5), VAR('MONELOCA'))   
          *   ACN(cg:FAC, CotizacionC(Val(v5),,,,FBN['FechaMov'],1,SI,VAR('MONEEXTR')))
          *Endif
          ******ACN(cf:FAC, 1)
          ACN(cg:FAC, 1)
          
          *- Debito o Credito 
          if Incluido(Val(V:2), Val(MN:1)) y Incluido(fbn('NrMov'), '11|12|13|14')
             ACN(co1, 9)
             ACN(co2,10)
             ACN(co3, 8)
          Else          
             IF EqStr(FBN['CPC1'],'SI') 
                if Incluido(FBN['TipoOp'], 'TIC|')
                   ACN(co1, 9)
                   ACN(co2,10)
                   ACN(co3, 8)
                else
                   ACN(co1, 6)
                   ACN(co2, 7)
                   ACN(co3,11)
                endif
         Else
          If [EqStr(FBN['Origen'],'OP') y Incluido(FBN['TipoOp'],'CBC|CFTC|CFTP|CTC|CTP|PABC|TIV|TIFV|TCOPRI')] o [EqStr(FBN['Origen'],'OR') y Incluido(FBN['TipoOp'],'CBC|CTC|CTP|PABC|TIC|')] o [EqStr(FBN['Origen'],'OR') y Incluido(FBN['TipoOp'],'VTP|') y FBN['NrSaldo']=207]
             *** COMPRAS DE CLIENTE: Acredita Titulos y Debita Moneda ***
             ACN(co1, 9)
             ACN(co2,10)
             ACN(co3, 8)
          Else
          If [EqStr(fbn('Origen'),'OP') y Incluido(fbn('TipoOp'),'CBT|VFTC|VFTP|VTC|VTP|PABT|TIC|TIFC')] o [EqStr(fbn('Origen'),'OR') y Incluido(fbn('TipoOp'),'CBT|VTC|PABT|TIV|')] o [EqStr(FBN['Origen'],'OR') y Incluido(FBN['TipoOp'],'VTP|') y FBN['NrSaldo']<>207]
                *** VENTAS DE CLIENTE: Acredita Moneda y Debita Titulos ***
                ACN(co1, 6)
                ACN(co2, 7)
                ACN(co3,11)
             Else
                If [EqStr(FBN['Origen'],'OP') y Incluido(FBN['TipoOp'],'TIPO|TIDE|TICT|TICO')] y Not Incluido(FBN['Especie'], Val(MN:1))
                   if FBN['Cantidad'] < 0
                      ACN(co1, 6)
                      ACN(co2, 7)
                      ACN(co3,11)
                   else 
                      ACN(co1, 9)
                      ACN(co2,10)
                      ACN(co3, 8)
                   endif   
                Else
                   *** Lo demas sigue como se definio originalmente
                   If FBN['Cantidad'] < 0
                      ACN(co1, 6)
                      ACN(co2, 7)
                      ACN(co3, 8)
                   Else
                      ACN(co1, 9)
                      ACN(co2,10)
                      ACN(co3,11)
                   Endif
                Endif
             Endif
          Endif
          endif
         ENDIF
          *- Si es debito saco el teorico de fecha anterior al corte
          *- Si es credito saco teorico de fecha posterior al corte
          If FBN['Cantidad'] < 0
             ACN(vt1,ValorTeorico2(val(v2),FBN['FechaMov']-1))
          Else
             ACN(vt1,ValorTeorico2(val(v2),FBN['FechaMov']) )
          Endif
          ACN(co4,15)
          If Not EqStr(Val(zz5),FBN['NrOperacion'])
             ACT(zz5,FBN['NrOperacion'])
          Endif
*          If DesciendedeEspecie(FBN['Especie'], 'MONEDA')
          If Incluido(fbn('Especie'), Val(MN:1))
          *If Incluido(FBN['TipoOp'], 'LCUPON')
          *      ACN(Val(co1):FAC, ABS(FBN['Cantidad']))
          *      ACN(Val(co2):FAC, ABS(FBN['Cantidad']))
          *   Endif
             ACN(Val(co3):FAC, ABS(FBN['Cantidad'])*Val(cf:FAC)-Val(zz1))
             *- La moneda no lleva valor residual
*             If Dialogo.Check1=0
                If Incluido(FBN['TipoOp'], 'CTC|CTP|VTC|CBT') 
                   ACN(Val(co3):FAC,Val(Val(co3):FAC)+Round(FBN['TotalAux3'],2)+Round(FBN['TotalIVA'],2)) 
                Else
                   If Incluido(FBN['TipoOp'], 'VFTP|VTP|CBC') 
                      ACN(Val(co3):FAC,Round(Val(Val(co3):FAC),2)-Round(FBN['TotalAux3'],2)-Round(FBN['TotalIVA'],2))       
                   Else
                      If Incluido(FBN['TipoOp'], 'VFTC')
                         ACN(Val(co3):FAC,Round(FBN['TotalBrutoCli1'],2)+Round(FBN['TotalIntereses'],2))
                      Else
                         If Incluido(FBN['TipoOp'], 'TCOPRI,TIC,TIFC,TIFV,TIV')
                            ACN(Val(co3):FAC,FBN['TotalNetoCli1'])       
                         Endif
                      Endif
                   Endif
                Endif
*             Endif
             IF Val(CO:3) = 8
                 SCN(TH:1, Val(Val(CO:3):fac))
             ELSE
                 SCN(TK:1, Val(Val(CO:3):fac))
             ENDIF
          Else
          If Incluido(FBN['TipoOp'], 'CTC|CTP|TCOPRI|TIC|TIFC|TIFV|TIV|VFTC|VFTP|VTC|VTP|CBT|CBC|TICO|TICT|TIPO|TIDE')
                ACN(Val(co1):FAC, ABS(FBN['Cantidad']))
                ACN(Val(co2):FAC, ABS(FBN['Cantidad'])*ValorTeorico2(val(v2),FBN['FechaMov']))
                ACN(Val(co3):FAC, ABS(FBN['TotalNetoCli1'])*Val(cg:FAC))   
                ACN(Val(co4):FAC, FBN['Cantidad']*ValorTeorico2(val(v2),Dialogo.Fecha1))
             Endif
             If Incluido(FBN['TipoOp'], 'DTP|RTP|DRT')
                ACN(Val(co1):FAC, ABS(FBN['Cantidad']))
                ACN(Val(co2):FAC, ABS(FBN['TotalNetoCli2']))
                ACN(Val(co3):FAC, ABS(FBN['TotalNetoCli1'])*Val(cg:FAC))      
                ACN(Val(co4):FAC, FBN['TotalNetoCli2'])
             Endif
             **AA  29-09-22
             **If Incluido(FBN['TipoOp'], 'CAMEST|CUPON|PDIVID|LCUPON')
             If Incluido(FBN['TipoOp'], 'CAMEST|CUPON|PDIVID|LCUPON|CANJE|STOCK')
                ACN(yt1, FAC)
                ACD(yu:FAC, FBN['FechaMov'])
                ACT(yv:FAC, FBN['Especie'])
                ACN(yw:FAC, FBN['Cantidad'])
                ACD(yx:FAC, FBN['FechaCambioTasa'])
                ACN(yy:FAC, FBN['TasaIntAnterior'])
                ACN(yz:FAC, FBN['TasaIntVigente'])
                (.'INTERESCLE'.)
                ACN(Val(co1):FAC, ABS(FBN['Cantidad']))
                If Incluido(FBN['TipoOp'], 'CUPON')
                   * Si es cupon
                   ACN(Val(co2):FAC, ABS(FBN['Cantidad'])*Val(vt1))
                Else
                **AA  29-09-22
                **If Not Incluido(FBN['TipoOp'], 'PDIVID|LCUPON')
                   If Not Incluido(FBN['TipoOp'], 'PDIVID|LCUPON|CANJE|STOCK')
                      ACN(Val(co2):FAC, ABS(FBN['Cantidad'])*ValorTeorico2(val(v2),FBN['FechaMov']))
                    Endif
                Endif
                ACN(Val(co4):FAC, FBN['Cantidad']*ValorTeorico2(val(v2),Dialogo.Fecha1))
                If EqStr(FBN['InteresesC'],'CLE')
                   If Incluido(Val(al4), '1585')
                      ACN(Val(co3):FAC, Val(Val(co2):FAC)*Val(cf:FAC)+(Val(zz:FAC)*Val(cf:FAC)) )
                   Else
                      ACN(Val(co3):FAC, Val(Val(co2):FAC)*Val(cf:FAC)+Val(zz:FAC))
                   Endif
                Else
                   ACN(Val(co3):FAC, Val(Val(co1):FAC)*Val(cf:FAC))
                Endif    
                ** Resto las comisiones de liquid. corte cupon
                If Incluido(FBN['TipoOp'], 'LCUPON')
                   ACN(Val(co3):FAC,Val(Val(co3):FAC)-Val(zz1))
                Endif
             Endif
             If Incluido(FBN['TipoOp'], 'TCC|TVC|TCP|TVP')
                ACN(Val(co1):FAC, ABS(FBN['Cantidad']))
                ACN(Val(co2):FAC, ABS(FBN['Cantidad'])*ValorTeorico2(val(v2),FBN['FechaMov']))
                ACN(Val(co3):FAC, ABS(FBN['TotalBrutoCli1'])*Val(cg:FAC))      
                ACN(Val(co4):FAC, FBN['Cantidad']*ValorTeorico2(val(v2),Dialogo.Fecha1))
             Endif
          Endif
          ** Formateo el VR de acuerdo a la cantidad de decimales definidos en la especie
*          If Not DesciendedeEspecie(Val(v2), 'MONEDA')      
          If Not Incluido(Val(V:2), Val(MN:1))
             ACN(de1,FBN['Alias5'])
             If Not Incluido(FBN['TipoOp'], 'PDIVID|LCUPON')
                ACN(Val(co2):FAC, Round(Val(Val(co2):FAC),Val(de1) ) )
             Endif
             ACN(Val(co4):FAC, Round(Val(Val(co4):FAC),Val(de1) ) )
             ACN(l:FAC, Val(l:(FAC-1)) - Val(f:FAC) + Val(i:FAC))
             ACN(m:FAC, Val(m:(FAC-1)) - Val(g:FAC) + Val(j:FAC))
*          ACN(n:FAC, Val(n:(FAC-1)) - Val(h:FAC) + Val(k:FAC))
             SCN(z5,Val(Val(co4):FAC) )
             SCN(z6,Val(Val(co4):FAC) )
             If [Not EqStr(FBN['TipoOp'], 'CAMEST')] y [FBN['Precio1'] <> 0]
                ACN(N:FAC, FBN['Precio1'])
             Endif
          endif      
          If EqStr(FBN['Auxiliar'],'EJE')
             ColorCeldas(a:FAC..O:FAC, clBLUE)
          Else
             ColorCeldas(a:FAC..O:FAC, clGREEN)
          Endif      
          SetFont(a:FAC..O:FAC, 3)
          FormatoCeldas(e:FAC..M:FAC, Exe('F2'))
          FormatoCeldas(g:FAC..g:FAC, Exe('F8'))
          FormatoCeldas(j:FAC..j:FAC, Exe('F8'))       
          FormatoCeldas(m:FAC..m:FAC, Exe('F8'))
          FormatoCeldas(N:FAC..N:FAC, Exe('F9'))
          FormatoCeldas(O:FAC..O:FAC, Exe('F7'))
*          If DesciendedeEspecie(FBN['Especie'], 'MONEDA')
          If Incluido(fbn('Especie'), Val(MN:1))
             FormatoCeldas(g:FAC..g:FAC, Exe('F2'))
             FormatoCeldas(j:FAC..j:FAC, Exe('F2'))
          ENDIF
       Else
          DFA
       Endif
** AA 03-10-2022 van las comisiones del banco al cliente???
**   ELSE
**   DFA
**   ENDIF
Proximo  

IFA
*If Not DesciendedeEspecie(Val(v2), 'MONEDA')
If Not Incluido(Val(V:2), Val(MN:1))
    ACT(a:FAC, 'Total Estado')
    ACN(l:FAC, Val(l:(FAC-1)))
    ACN(m:FAC, Val(m:(FAC-1)))
*    ACN(n:FAC, Val(n:(FAC-1)))
    ACN(O:FAC, Val(z5) )
    SCN(z2, Val(l:FAC))
    SCN(z3, Val(m:FAc))
*    SCN(z4, Val(n:FAc))
    SCN(z5, Val(O:FAc))
    SetFont(a:FAC..O:FAC, 2)
    FormatoCeldas(e:FAC..M:FAC, Exe('F2'))
    FormatoCeldas(g:FAC..g:FAC, Exe('F8'))
    FormatoCeldas(j:FAC..j:FAC, Exe('F8'))       
    FormatoCeldas(m:FAC..m:FAC, Exe('F8'))
    FormatoCeldas(O:FAC..O:FAC, Exe('F7'))
    IFA
    ACT(a:FAC, 'Total Especie '~Val(v2))
    AgregarMarco(a:FAC..O:FAC,2,0,Exe('COLOR8'))
    ACN(l:FAC, Val(z2))
    ACN(m:FAC, Val(z3))
*    ACN(n:FAC, Val(z4))
    ACN(O:FAC, Val(z6))
*    SCN(z1, Val(n:FAC))
    ACN(z2, 0)
    ACN(z3, 0)
    ACN(z4, 0)
    ACN(z5, 0)
    SetFont(a:FAC..O:FAC, 2)
    FormatoCeldas(e:FAC..M:FAC, Exe('F2'))
    FormatoCeldas(g:FAC..g:FAC, Exe('F8'))
    FormatoCeldas(j:FAC..j:FAC, Exe('F8'))       
    FormatoCeldas(m:FAC..m:FAC, Exe('F8'))
    FormatoCeldas(O:FAC..O:FAC, Exe('F7'))
    IFA
ELSE
    ACT(A:fac, 'Total Especie '~Val(V:2))
    AgregarMarco(A:fac..O:fac,2,0,Exe('COLOR8'))
    IF Val(TH:1) <> 0
        ACN(H:fac, Val(TH:1))
    ENDIF
    IF Val(TK:1) <> 0
        ACN(K:fac, Val(TK:1))
    ENDIF
    ACN(TH:1, 0)
    ACN(TK:1, 0)
    SetFont(A:fac..O:fac, 2)
    FormatoCeldas(H:fac..H:fac, Exe('F2'))
    FormatoCeldas(K:fac..K:fac, Exe('F2'))
    ifa
Endif
ACT(a:FAC, 'Total Cliente')
*ACN(n:FAC, Val(z1))
ACN(z1, 0)
SetFont(a:FAC..O:FAC+2, 2)
FormatoCeldas(e:FAC..M:FAC+2, Exe('F2'))
FormatoCeldas(g:FAC..g:FAC+2, Exe('F8'))
FormatoCeldas(j:FAC..j:FAC+2, Exe('F8'))       
FormatoCeldas(m:FAC..m:FAC+2, Exe('F8'))
FormatoCeldas(O:FAC..O:FAC+2, Exe('F7'))

SetFilaActual(FAC+2)

ACT(a:FAC+2, 'FIN DEL LISTADO')
SetFont(a:FAC+2..a:FAC, 2)    

SetMargins(0,0,0,2)
Impresion(1,2)
SetPrintFit(3,65)
RangoTitulo(a1..O:FAC, 9)
LimitesVision(O:FAC+2)
FijarFila(10)
