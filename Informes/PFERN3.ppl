SetFilaActual(3)
ACT(c:fac, 'Descripcion Tabla Movimientos Pendientes')
SetFont(c:fac..c:fac,1)

SetFilaActual(5)
ACT(a:fac+1,'Operacion :' ~iif(NoVacio(Dialogo.NrOperacion1), Dialogo.NrOperacion1, 'Todos'))
ACT(a:fac+2,'Fecha1 :' ~iif(NoVacio(Dialogo.Fecha1), Dialogo.Fecha1, 'Todos'))
ACT(a:fac+3,'Cliente1 :' ~iif(NoVacio(Dialogo.Cliente1), Dialogo.Cliente1, 'Todos'))
ACT(a:fac+4,'Especie1 :' ~iif(NoVacio(Dialogo.Especie1), Dialogo.Especie1, 'Todos'))
ACT(a:fac+5,'Mercado1 :' ~iif(NoVacio(Dialogo.Mercado1), Dialogo.Mercado1, 'Todos'))
ACT(a:fac+6,'Cantidad1 :' ~iif(NoVacio(Dialogo.Cantidad1), Dialogo.Cantidad1, 'Todos'))
ACT(a:fac+7,'Cuenta1 :' ~iif(NoVacio(Dialogo.Cuenta1), Dialogo.Cuenta1, 'Todos'))
SetFont(a:fac+1..a:fac+7, 2)

SetFilaActual(14)
AgregarMarco(a:fac..g:fac,2,0,Exe('COLOR'))
ACT(a:fac, 'Operac')
ACT(b:fac, 'FechaMov')
ACT(c:fac, 'Codigo')
ACT(d:fac, 'Especie')
ACT(e:fac, 'Mercado')
ACT(f:fac, 'Cantidad')
ACT(g:fac, 'Cuenta')
SetFont(a:fac..g:fac, 2)
AlinearCeldas(a:fac..e:fac, 'C')
AlinearCeldas(f:fac..f:fac, 'D')
AlinearCeldas(g:fac..g:fac, 'C')


SQL.ADD("Select NrOperacion, FechaMov, Cliente, Especie, Mercado, EnteCustodia, Cantidad, Cuenta ")
SQL.ADD("From "~DBO~".MOVPENDIENTES ")
SQL.ADD("Where Cliente='"~Dialogo.Cliente1~"' ")
SQL.ADD(" Order By NrOperacion asc")

Recorrer SQL

    AgregarMarco(a:fac..g:fac,2,2,0) 
    ACT(a:fac, fbn('NrOperacion'))
