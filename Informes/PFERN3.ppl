    ACT(g:fac, fbn('Cuenta'))         

Proximo


Recorrer&j 1, 1
   
   ACT(r:&j+1,'SI')
   AgregarMarco(k:&j..q:&j,2,0,Exe('COLOR')) 
   ACT(k:&j, 'Operac')
   ACT(l:&j, 'FechaMov')
   ACT(m:&j, 'Codigo')
   ACT(n:&j, 'Especie')
   ACT(o:&j, 'Mercado')
   ACT(p:&j, 'Cantidad')
   ACT(q:&j, 'Cuenta')

  
   If NoVacio(Dialogo.Especie1)  
      AgregarMarco(k:&j+1..q:&j+1,1,0,0) 
      ACT(k:&j+1, Val(a:fac))
      ACT(l:&j+1, Val(b:fac))
      ACT(m:&j+1, Val(c:fac))
      ACT(n:&j+1, Val(d:fac))       
      ACT(o:&j+1, Val(e:fac))
      ACN(p:&j+1, Val(f:fac))
      ACT(q:&j+1, Val(g:fac)) 
   else
      ACT(r:&j+1,'NO')              
      ColorCeldas(r:&j+1..r:&j+1,clRED)
   Endif
 
