*- Selecciono las operaciones de Swap, los titulos, los cambios y las opciones de titulos
HojaVisible(No)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'             ;;;;;;;;;FSys
  Lista1   : 'Vehiculo'          ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
  Radio1   : 'Consolidado|Si|No' ;;;;;;;;;0
  Radio2   : 'Expresado|ARP|USD' ;;;;;;;;;0
FinDialogo

if not OK
  Cancelar
endif

*- Control de Vehiculo Habilitado
ACT(zz6, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")) )
 
if Dialogo.Radio1=1
   *** SELECCIONO SWAPS DE INTERES
   *************** Selecciono operaciones con Vto Simple *****
   SQL.ADD("Select DISTINCT O.Vehiculo1 ")
   SQL.ADD("from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.Especie=O.ContraEspecie AND ")
   SQL.ADD(" (TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"')   ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif

   SQL.ADD("  Union ")

   *************** Selecciono operaciones con Vto Multiple
   SQL.ADD("Select DISTINCT O.Vehiculo1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion AND O.Especie=O.ContraEspecie ")
   SQL.ADD("  and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("  or (TipoOp IN ('DTSNFV') and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif

   SQL.ADD("Union ")

   *** SELECCIONO SWAPS DE TIPO DE CAMBIO
   *************** Selecciono operaciones con Vto Simple *****
   SQL.ADD("Select DISTINCT O.Vehiculo1 ")
   SQL.ADD("from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.Especie<>O.ContraEspecie AND ")
   SQL.ADD(" (TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"')   ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif

   SQL.ADD("  Union ")

   *************** Selecciono operaciones con Vto Multiple
   SQL.ADD(" Select DISTINCT O.Vehiculo1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where O.NrOperacion = C.NrOperacion AND O.Especie<>O.ContraEspecie ")
   SQL.ADD("  and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("  or (TipoOp IN ('DTSNFV') and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif

   SQL.ADD("Union ")

   SQL.ADD(" Select DISTINCT O.Vehiculo1 ")
   SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD("where O.NrOperacion = C.NrOperacion ")
   SQL.ADD("and TipoOp IN ('DTCAP','DTFLO') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")

   SQL.ADD("Union ")

   *------- Operaciones de Cambio 
   SQL.ADD(" Select DISTINCT O.Vehiculo1 ")
   SQL.ADD(" from "~DBO~".OPERACIONES O ")
   SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("  and ((O.FechaVto >= O.FechaPago and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"') ")
   SQL.ADD("   or  (O.FechaPago > O.FechaVto and O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"')) ")
   SQL.ADD("  and O.TipoOp IN ('FXCT','FXVT') ")
   if NoVacio(Dialogo.Lista1)
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
   Else
      SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
   endif
   SQL.ADD(" order by 1 ")
   ACN(ba1,0)
   Recorrer SQL
      SCN(ba1,1)
      LinkearHoja('IRSA1', Val(ba1), Fecha1=Dialogo.Fecha1, Lista1=FBN['Vehiculo1'], Radio1=Dialogo.Radio1, Radio2=Dialogo.Radio2)
   Proximo
else
   LinkearHoja('IRSA1', 1, Fecha1=Dialogo.Fecha1,Lista1=IIF(NoVacio(Dialogo.Lista1),Dialogo.Lista1,Val(zz6)),Radio2=Dialogo.Radio2)
endif
