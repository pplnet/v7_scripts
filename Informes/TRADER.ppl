   ACT(a:fac, 'Total Derivados Tasas')
EndIf
If Incluido(VAL(Z4),'DP')
   ACT(a:fac, 'Total Derivados Petroleo')
EndIf
If EqStr(VAL(Z4),'FX')
   ACT(a:fac, 'Total Foreing Exchange')
EndIf
If Incluido(VAL(Z4),'SE|CU|DI')
   ACT(a:fac, 'Total Securities')
EndIf
If Incluido(VAL(Z4),'CC|GA')
   ACT(a:fac, 'Total Cartas Cred y Garantias')
EndIf
If Incluido(VAL(Z4),'VI|')
   ACT(a:fac, 'Total Ops.Vinculadas')
EndIf
If Incluido(VAL(Z4),'TE|')
   ACT(a:fac, 'Total Ops.Terceros')
EndIf

acn(c:fac,val(z3))
ACN(d:fac,VAL(t1))

SetFont(a:fac..d:fac,2)
AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR6'))      
scn(z5,val(z3))
SCN(z7,VAL(d:fac))
acn(z3,0)

ifa
ACT(a:fac, 'Total Agrupado')
acn(c:fac,val(z5))
acn(d:fac,val(z8))
SetFont(a:fac..d:fac,2)
AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR6'))

ACO(1,20)
