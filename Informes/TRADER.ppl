*-- TRADER: Cantidad Operaciones Concertadas por Trader
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2     : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
  Vehiculo1  : 'Vehiculo'     ;1;2;;;;
  Lista1     : 'Trader'       ;3;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".USUARIOS")
  Lista2     : 'Operacion'    ; ; ;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where Codigo not in ('POSOPE','VIMD','TEMD','PRESUP') and  Codigo Not Like 'AJU%'") 
FinDialogo



*-- Veo solamente los tipos seleccionados
SetListaClaves(2)
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:fac,"Cantidad de Operaciones Concertadas por Trader")

SetFont(a:fac..a:fac,2)
SetFilaActual(5)

ACN(w1,fac)

IF NoVacio(Dialogo.Vehiculo1)
   ACT(a:fac+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:fac+1, 'Vehiculo : Todos')
endif

ACT(a:fac+2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:fac+3, 'Fecha Hasta: '~Dialogo.Fecha2)

ACT(X1, "O.FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")

IF NoVacio(Dialogo.Vehiculo1)
   ACT(x1, Val(x1)~" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif


IF NoVacio(Dialogo.Lista1)
   ACT(A:fac+4, 'Traders : '~Pipe2Comillas(Dialogo.Lista1))
   ACT(x2," and Operador In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
else
   ACT(A:fac+4, 'Traders : Todos')
endif

IF NoVacio(Dialogo.Lista2)
   ACT(A:fac+5, 'Tipo Op. : '~Pipe2Comillas(Dialogo.Lista2))
   ACT(x3," and TipoOp In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
else 
   ACT(A:fac+5, 'Tipo Op. : Todas')
endif

SetFilaActual(fac+7)


*-1er. Nivel del Listado Cantidad de Operaciones por Operador para Fecha, Vehiculo y Tipos de Operacion
ACT(a:fac, 'Operador')
ACT(b:fac, 'Tipo Op.')
ACT(c:fac, 'Cantidad')
ACT(d:fac, 'Volumen '~VAR('MONEEXTR'))

AlinearCeldas(a:fac..b:fac,'I')
AlinearCeldas(c:fac..d:fac,'D')

SetFont(a:Val(w1)..N:fac,2)
AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR6'))

SQL.ADD("SELECT O.Operador,O.TipoOp,COUNT(*) as Cant ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where "~Val(X1)~" ")
SQL.ADD(Val(X2)~" ")
SQL.ADD(Val(X3)~" ")
SQL.ADD(" and TipoOp not in ('POSOPE','VIMD','TEMD','PRESUP') and TipoOp Not Like 'AJU%' ")
SQL.ADD(" group by O.Operador,O.TipoOp ")
SQL.ADD(" order by O.Operador,O.TipoOp ")

ACN(w1,fac+1)
ACN(z2,0)
ACN(z3,0)
ACN(z6,0)
acn(z7,0)
ACN(ba1,1)

Recorrer SQL

   *-- Calculo el Total por Trader
   IF Not EqStr(VAL(Z1),FBN['Operador']) y VAL(Z2)>0
      IFA
      ACT(a:fac,'T O T A L   de   '~Val(z1)~':  ...')
      ACN(c:fac, VAL(Z3))
      ACN(d:fac, VAL(Z6))
      SCN(Z7,VAL(Z6))
      ACN(z3,0)
      ACN(z6,0)
      SetFont(a:fac..d:fac,2)
      IFA
      IFA
   EndIf

   ACT(Z1,FBN['Operador'])

   ACT(a:fac,FBN['Operador']~" "~Copy(BuscarCampo('USUARIOS','Nombre','Codigo',FBN['Operador']),1,30))
   ACT(b:fac, FBN['TipoOp'])
   ACN(c:fac, FBN['Cant'])

   * ACL(b:fac,'OPETRA',Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=Dialogo.Vehiculo1,Operador=FBN['Operador'],TipoOp1=FBN['TipoOp'])
   LinkearHoja('OPETRA',val(ba1),Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Vehiculo1=Dialogo.Vehiculo1,Operador=FBN['Operador'],TipoOp1=FBN['TipoOp'], Vehiculo2='')
   ACN(d:fac, LINKH(Val(ba1),z4) )     

   * CerrarLink(Val(ba1))
   SCN(z2,VAL(c:fac))
   SCN(z3,VAL(c:fac))   
   SCN(z6,VAL(d:fac))   

   SCN(ba1,1)
   SetFont(a:fac..d:fac,1)
Proximo

IFA
ACT(a:fac,'T O T A L   de   '~Val(z1)~':  ...')
ACN(c:fac, VAL(Z3))
ACN(d:fac, VAL(Z6))
SCN(Z7,VAL(Z6))
SetFont(a:fac..d:fac,2)

ACT(a:fac+2,'Total: ')
ACN(c:fac+2,VAL(z2))
ACN(d:fac+2,VAL(z7))

AgregarMarco(a:fac+2..d:fac+2,2,0,0)

SetFont(a:fac+2..d:fac+2,1)

FormatoCeldas(c:Val(w1)..c:fac+2,Exe('F0'))
FormatoCeldas(d:Val(w1)..d:fac+2,Exe('F2'))

SetFilaActual(fac+4)
ACT(a:fac, 'Grupo Operaciones')
ACT(b:fac, 'Tipo Op.')
ACT(c:fac, 'Cantidad')
ACT(d:fac, 'Volumen '~VAR('MONEEXTR'))

AlinearCeldas(a:fac..b:fac,'I')
AlinearCeldas(c:fac..d:fac,'D')

SetFont(a:fac..N:fac,2)
AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR6'))
ifa

SQL.ADD("SELECT Case SubString(O.TipoOp,1,2) WHEN 'CU' Then 'SE' WHEN 'DI' THEN 'SE' ELSE SubString(O.TipoOp,1,2) End Grupo,O.TipoOp,COUNT(*) as Cant ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where "~Val(X1)~" ")
SQL.ADD(" and TipoOp not in ('POSOPE','VIMD','TEMD','PRESUP') and TipoOp Not Like 'AJU%' ")
SQL.ADD(" group by O.TipoOp")
SQL.ADD(" order by Grupo,O.TipoOp")

acn(z3,0)
acn(z5,0)

acn(z7,0)
acn(z8,0)
Recorrer SQL

   If Not EqStr(val(z4),FBN['Grupo']) y VAL(Z3)<>0
      IFA
      If EqStr(VAL(Z4),'MM')
         ACT(a:fac, 'Total Money Markets')
      EndIf
      If Incluido(VAL(Z4),'DS|')
         ACT(a:fac, 'Total Derivados Securities')
      EndIf
      If Incluido(VAL(Z4),'DF')
         ACT(a:fac, 'Total Derivados Fx')
      EndIf
      If Incluido(VAL(Z4),'DT')
         ACT(a:fac, 'Total Derivados Tasas')
      EndIf
      If Incluido(VAL(Z4),'DP')
         ACT(a:fac, 'Total Derivados Petroleo')
      EndIf
      If EqStr(VAL(Z4),'FX')
         ACT(a:fac, 'Total Foreing Exchange')
      EndIf
      If Incluido(VAL(Z4),'SE|CU|DI')
         ACT(a:fac, 'Total Securities')
      EndIf
      If Incluido(VAL(Z4),'CC|GA')
         ACT(a:fac, 'Total Cartas Cred y Garantias')
      EndIf
      If Incluido(VAL(Z4),'VI|')
         ACT(a:fac, 'Total Ops.Vinculadas')
      EndIf
      If Incluido(VAL(Z4),'TE|')
         ACT(a:fac, 'Total Ops.Terceros')
      EndIf
      If Incluido(VAL(Z4),'FC|')
         ACT(a:fac, 'Total Fondos Comunes')
      EndIf

      acn(c:fac,val(z3))
      acn(d:fac,val(z7))

      SetFont(a:fac..d:fac,2)
      AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR6'))      

      scn(z5,val(z3))
      scn(z8,val(z7))
      acn(z3,0)
      acn(z7,0)
      ifa
   EndIf

   If Not EqStr(val(z4),FBN['Grupo'])
      act(z4,FBN['Grupo'])
      If EqStr(VAL(Z4),'MM')
         ACT(a:fac, 'Money Markets')
      EndIf
      If Incluido(VAL(Z4),'DS|')
         ACT(a:fac, 'Derivados Securities')
      EndIf
      If Incluido(VAL(Z4),'DF')
         ACT(a:fac, 'Derivados Fx')
      EndIf
      If Incluido(VAL(Z4),'DT')
         ACT(a:fac, 'Derivados Tasas')
      EndIf
      If Incluido(VAL(Z4),'DP')
         ACT(a:fac, 'Derivados Petroleo')
      EndIf
      If EqStr(VAL(Z4),'FX')
         ACT(a:fac, 'Foreing Exchange')
      EndIf
      If Incluido(VAL(Z4),'SE|CU|DI')
         ACT(a:fac, 'Securities')
      EndIf
      If Incluido(VAL(Z4),'FC|')
         ACT(a:fac, 'Fondos Comunes')
      EndIf
      If Incluido(VAL(Z4),'CC|GA')
         ACT(a:fac, 'Cartas Cred y Garantias')
      EndIf
      If Incluido(VAL(Z4),'VI|')
         ACT(a:fac, 'Ops.Vinculadas')
      EndIf
      If Incluido(VAL(Z4),'TE|')
         ACT(a:fac, 'Ops.Terceros')
      EndIf
      SetFont(a:fac..c:fac,2)
      acn(z3,0)
      acn(z7,0)
   EndIf

   * Calculo el Total por Trader
   ACT(b:fac, FBN['TipoOp'])
   ACN(c:fac, FBN['Cant'])

   * Calculo el Volumen por Tipo de Operacion
   (.'VOLOPESUM'.)

   ACN(d:fac,VAL(t1))
   SCN(z3,VAL(c:fac))
   SCN(z7,VAL(d:fac))

   SetFont(a:fac..d:fac,1)
   FormatoCeldas(c:fac..c:fac,Exe('F0'))
   FormatoCeldas(d:fac..d:fac,Exe('F2'))
Proximo

IFA
