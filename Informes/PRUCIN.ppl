***4-   Evento importación de Cotizaciones:
****Dialogo:
***               Directorio Z:\Usr\CPinaud
*++           Archivo Precios.xlsx
***-Validar en el script que el directorio y archivo existan (VER FUNCION VALIDPATH)
***-Si existe la cotización de la especie y el dia se hace un UPDATE
***-Si no existe, se hace un insert

CrearDialogo
Directorio1: 'PATH' ;;;;;
String1:     'Archivo' ;;;;;;
FinDialogo

If Not Ok
    Cancelar
Endif
****VALIDACION
If ExisteDirectorio(Dialogo.Directorio1)
    If EqStr(Copy(Dialogo.Directorio1,Longitud(Dialogo.Directorio1),1),'\')
        If Not ExisteArchivo(Dialogo.Directorio1~Dialogo.String1)
            Cancelar('1.El Archivo '~Dialogo.String1~' no existe en el directorio: '~Dialogo.Directorio1)
        else
            let &Archivo Dialogo.Directorio1~Dialogo.String1
        EndIf
    Else
        If Not ExisteArchivo(Dialogo.Directorio1~'\'~Dialogo.String1)
            Cancelar('2.El Archivo '~Dialogo.String1~' no existe en el directorio: '~Dialogo.Directorio1)
        else
            let &Archivo Dialogo.Directorio1~'\'~Dialogo.String1
        EndIf
    Endif
Else
    Cancelar('El directorio '~Dialogo.Directorio1~' no existe')
EndIf
*****
***IMPORTACION DE ARCHIVO
**1.4.4.1.1.6.32    ImportarXLS(Rango origen,RangoDestino,Ruta y Archivo)
ImportarXLS(A:2..F:15,AA:2..FF:15,&Archivo)
****
Recorrer &j 2,15
IF QUERY('Select 1 from "~DBO~".COTIZACIONES WHERE Codigo=Val(AA:&j) and Fecha=Val(AF:&j)')=1
    SQL.ADD("UPDATE "~DBO~".COTIZACIONES Set Precio1=Val(AE:&j) Where Codigo=Val(AA:&j) and Fecha=Val(AF:&j)")
    SQL.NEW
    SQL.EXEC
Else
    SQL.ADD("INSERT INTO "~DBO~".COTIZACIONES (Fecha,Precio1,Codigo) VALUES (Val(AF:&j),Val(AE:&j),Val(AA:&j)) ")
    SQL.NEW
    SQL.EXEC
Endif

Proximo

