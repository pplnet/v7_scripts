ACT(A1,IIF(Not EsTerminal('', Vehiculos),'Cumple','No cumple'))

ACT(TR:1, Var('TIPORE2NRZ'))
ACT(MI:2, 'ML')
ACN(Z:1,5)
Recorrer&k 1, Elementos(Val(TR:1))
    ACT(A:Val(Z:1),ItemLista(Val(TR:1), &k)~Val(MI:2)~'DAY')
    SCN(Z:1,1)
Proximo
ACT(B5,'Cantidad de elementos Celda')
ACN(B6,Elementos(Val(TR:1)))

ACN(Z:1,13)
Recorrer&k 1, Elementos(Var('TIPORE2NRZ'))
    ACT(A:Val(Z:1),ItemLista(Val(TR:1), &k)~Val(MI:2)~'DAY')
    SCN(Z:1,1)
Proximo
ACT(B13,'Cantidad de elementos Variable')
ACN(B14,Elementos(Var('TIPORE2NRZ')))