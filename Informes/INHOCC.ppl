CrearDialogo
        Fecha1      : 'Fecha desde'           ;1;1;;;;;;;FSYS
        Fecha2      : 'Fecha hasta'           ;2;1;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;"Fecha Hasta tiene tiene que ser mayor a Fecha Desde";;;FSYS
        Radio1      : 'Estado|Pendientes|Ingresados|Rechazado|Supervisado|Todos';3;1;;;;;;;4;
FinDialogo

if not ok
    Cancelar("Informe Cancelado.")
Endif
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
SetFilaActual(0)

CrearFont(1,"Arial,8,B")
CrearFont(2, 'Arial,9,B')
ACT(a:fac+6, 'F.Concertacion Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
If Dialogo.Radio1 =0
    ACT(a:fac+7,"Estado: Pendientes")
Else If Dialogo.Radio1 = 1
        ACT(a:fac+7,"Estado: Ingresados")
    Else If Dialogo.Radio1 = 2 
        ACT(a:fac+7,"Estado: Rechazados")
        Else If Dialogo.Radio1 = 3
            ACT(a:fac+7,"Estado: Supervisados")
            else
                ACT(a:fac+7,"Estado: Todos")
            endif
        endif
    endif
endif
SetFont(a:FAC+6..n:FAC+7,1)
SetFilaActual(fac+9)


ACT(a:fac, 'NrOperacion')
ACT(b:fac, 'Cliente')
ACT(c:fac, 'Fecha Op.')
ACT(d:fac, 'Fecha Liq.')
ACT(e:fac, 'Tipo Op.')
ACT(f:fac, 'Especie')
ACT(g:fac, 'Cantidad')
ACT(h:fac, 'Precio')
ACT(i:fac, 'Bruto')
ACT(j:fac, 'Hora Orden')
ACT(k:fac, 'Usuario Carga')
ACT(l:fac, 'Estado')
ACT(m:fac, 'Usuario Sup.')
ACT(n:fac, 'Instancia')


SetFont(a:FAC..n:FAC,2)
AgregarMarco(a:FAC..n:FAC,1,0,Exe('COLOR6'))

*RECORRER
SQL.ADD("SELECT O.NrOperacion,O.Cliente1,O.FechaOp,O.FechaVto,O.TipoOp,O.Especie,O.Cantidad,O.Precio1, O.TotalBrutoCli1, LIB.HoraOr,")
SQL.ADD("LIB.UsuarioCarga, LIB.Estado, LIB.UsuarioSup, I.Nombre")
SQL.ADD(" FROM "~DBO~".OPERACIONES O")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion AND Valor = 1")
SQL.ADD("INNER JOIN "~DBO~".CLIENTES CL ON O.Cliente1 = CL.Codigo")
SQL.ADD("OUTER APPLY (SELECT TOP 1 L.HoraOr, L.UsuarioCarga, L.Estado, L.UsuarioSup FROM "~DBO~".LIBORDENES L WHERE L.NrOperacionRef = O.NrOperacion ORDER BY L.FechaCarga DESC ) LIB")
SQL.ADD("INNER JOIN "~DBO~".INSTANCIAS I ON OB.NrBit=I.NrInstancia and I.Tabla='OPERACIONES'")
*Filtro Fechas OK
SQL.ADD("WHERE O.FechaOp BETWEEN "~IdxDate2(Dialogo.Fecha1)~" AND "~IdxDate2(Dialogo.Fecha2))
*Filtro TipoOp OK
SQL.ADD("AND TipoOp IN ('TIC','TIV')")
*Instancia Liquidacion 10 o Terminal 70 OK
*SQL.ADD("AND OB.NrBit IN ('10','70') ")
*FILTRO PARA CLIENTES FALTA
SQL.ADD("AND CL.Status = 'HAB' AND CL.NrMae IS NULL")
SQL.ADD("ORDER BY O.FechaOp")


If Dialogo.Radio1 =0
    SQL.ADD("AND LIB.Estado IS NULL")
Else If Dialogo.Radio1 = 1
        SQL.ADD("AND LIB.Estado ='ING'")
    Else If Dialogo.Radio1 = 2 
        SQL.ADD("AND LIB.Estado ='REC'")
        Else If Dialogo.Radio1 = 3
            SQL.ADD("AND LIB.Estado ='SUP'")
            endif
        endif
    endif
endif


Recorrer SQL
    *Recuperar la operacion de titulos
    ACT(a:fac,FBN['NrOperacion'])
    ACLO(a:FAC,Val(a:FAC))
    ACT(b:fac,FBN['Cliente1'])
    ACD(c:fac,FBN['FechaOp'])
    ACD(d:fac,FBN['FechaVto'])
    ACT(e:fac,FBN['TipoOp'])
    ACT(f:fac,FBN['Especie'])
    ACN(g:fac,FBN['Cantidad'])
    ACN(h:fac,FBN['Precio1'])
    ACN(i:fac,FBN['TotalBrutoCli1'])
    ACT(j:fac,FBN['HoraOr'])
    ACT(k:fac,FBN['UsuarioCarga'])
    ACT(l:fac,FBN['Estado'])
    if Eqstr(Val(l:fac),'ING')
        ACT(l:fac,"Ingresado")
        else if Eqstr(Val(l:fac),'REC')
            ACT(l:fac,"Rechazado")
            else if Eqstr(Val(l:fac),'SUP')
                    ACT(l:fac,"Supervisado")
                else
                    ACT(l:fac,"Pendiente")
            endif 
        endif
    endif
    ACT(m:fac,FBN['UsuarioSup'])
    ACT(n:fac,FBN['Nombre'])

