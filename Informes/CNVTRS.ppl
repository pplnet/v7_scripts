*SQL.ADD(" FROM (SELECT ObservacDoc Especie, 5 TipoInst, 3 TipoISIN, 'NO APLICA' ISIN, E.cotiza,'"~VAR('MENEFTI')~"' Issuer, E.Tipo, E.Nombre, E.CodAlfCajaValores, M.CodCNVInf Mercado,  (Select Descripcion From "~DBO~".MERCADOS where Codigo =  M.CodCNVInf) as DescMerc,  ")
SQL.ADD(" FROM (SELECT ObservacDoc Especie, 5 TipoInst, 3 TipoISIN, 'NO APLICA' ISIN, E.cotiza,'"~VAR('MENEFTI')~"' Issuer, E.Tipo, E.Nombre, E.CodAlfCajaValores, O.Mercado4, M.CodCNVInf Mercado, M.CodCNVInf DescMerc, E.CodNumCajaValores CodigoCV, E.Extendido NomEspec,  ")
SQL.ADD("    O.TotalBrutoCli3,E.Alias5, E.InteresesC, E.MonedaEmision, Vehiculo1 EnteCustodia,Case When TipoOp= 'FXCF' Then 'C-' Else 'V-' End TipoOp , M1.TamanioLote, O.FechaVto,   ")
SQL.ADD("    (SELECT sum (MO.MTM)  FROM "~DBO~".MTMDIARIO MO where MO.NrOperacion= O.NrOperacion and MO.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' )  as rendimiento, ")
SQL.ADD("    (Select PrecioHoy From "~DBO~".MTMDIARIO M2 where M2.NrOperacion = O.NrOperacion and M2.Fecha = ")
SQL.ADD("      (Select Max(M3.Fecha) from "~DBO~".MTMDIARIO M3 where M3.NrOperacion = M2.NrOperacion and M3.Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' )) PrecioHoy ")
SQL.ADD("    FROM "~DBO~".OPERACIONES O , "~DBO~".ESPECIES E WITH (NOLOCK), "~DBO~".MERCADOS M WITH (NOLOCK), "~DBO~".MERCADOS M1 WITH (NOLOCK), "~DBO~".CLIENTES C  ")
SQL.ADD("    WHERE E.Codigo = O.Especie AND ")
SQL.ADD("          C.Codigo = O.Cliente1 AND ")
SQL.ADD("          E.Jerarquia like ('"~VAR('JERTITULOS')~"%')  and E.Codigo not in ("~Pipe2Comillas(VAR('ESPNOCNV'))~") AND ") 
SQL.ADD("          (O.Cliente1 = '"~Dialogo.Vehiculo1~"' OR  (C.Jerarquia like  ('"~VAR('JERDIRECT')~"%') OR C.Jerarquia like  ('"~VAR('JERVINCULA')~"%') OR C.Vinculado ='SI')) AND ")
SQL.ADD("          '"~VAR('MERCARGC')~"' = M.Codigo AND ")
*SQL.ADD("          O.Mercado4 = M.Codigo AND ")
SQL.ADD("          O.Mercado4 = M1.Codigo AND ")
SQL.ADD("          O.Mercado4 = '"~VAR('MENEFTI')~"' AND ")
SQL.ADD("          FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' AND  ")
*SQL.ADD("          FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("          FechaVto >= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
SQL.ADD("          TipoOP in ('FXCF','FXVF') ")
SQL.ADD(" ) as Aux ")
SQL.ADD(" Where Rendimiento is not Null ")
SQL.ADD("    GROUP BY Especie,TipoInst,TipoISIN,ISIN,Cotiza,Issuer,Tipo,Nombre,CodAlfCajaValores,Mercado4,Mercado,DescMerc,CodigoCV,NomEspec, Alias5,InteresesC,MonedaEmision,EnteCustodia,TipoOp,FechaVto,TamanioLote,PrecioHoy ")
