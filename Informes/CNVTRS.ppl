          ACT(xy10,'')
          **ACN(m:fac,CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,SI,VAR('MONELOCA')))
          #ifdef BIND
             ACN(m:fac,SQL("Select Top(1) Precio1 From "~DBO~".COTIZACIONES Where Codigo = '"~FBN['Especie']~"' AND Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"'  Order By Fecha Desc ") )
             if val(m:fac)=0
                ACN(m:fac,SQL("Select Top(1) Precio1 From "~DBO~".COTIZACIONES Where Codigo = '"~FBN['Especie']~"' AND Moneda = '"~VAR('MONEEXTR')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"'  Order By Fecha Desc ") )
                ACT(xy10,'USD')
             endif
          #else
             ACN(m:fac,SQL("Select Top(1) Precio1 From "~DBO~".COTIZACIONES Where Codigo = '"~FBN['Especie']~"' AND Moneda = '"~VAR('MONELOCA')~"' AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"'  AND CallPut = 'CON'  Order By Fecha Desc ") )
          #endif
          ACN(p:fac, Dialogo.Precio1)      
          ACN(o:fac, FBN['Saldo']*Val(m:fac)*Val(l:fac))
          SCN(aw1,Val(o:fac))
       Endif
         
       #ifdef BIND
          if EqStr(val(xy1),'USD')
             ACN(p:fac,1)
             ACN(q:fac, Val(o:fac))
          else
            ACN(p:fac, Dialogo.Precio1)      
            ACN(q:fac, Val(o:fac)/Dialogo.Precio1)      
          endif
          SCN(aw2,Val(q:fac))            
       #else
       If EqStr(FBN['MonedaEmision'],Var('MONEEXTR'))
          ACN(p:fac,1)
          if FBN['TipoInst']=5
             ACN(q:fac, Val(o:fac))
              ** AA 17-01-22 solo se suman los valores positivos
              **SCN(aw2,ABS(Val(q:fac)))
              SCN(aw2,iif(Val(q:fac)>0,Val(q:fac),0))          
          Else
            *ACN(q:fac, Val(n:fac)*Val(l:fac))
             ACN(q:fac, Val(o:fac))
             SCN(aw2,Val(q:fac))
          Endif
       Else
       ** ACN(p:fac, Val(n:fac)*Val(l:fac)/Dialogo.Precio1)
          ACN(q:fac, Val(o:fac)/Dialogo.Precio1)      
          SCN(aw2,Val(q:fac))
       Endif
       #endif

       
       ** Registro CNV TRIM
          *Tipo Cartera
           ACT(rr2,Copy(Val(a:fac),1,1)~';')
          *Instrumento/Especie
           ACT(rr2,Val(rr2)~Copy(val(b:fac),1,longitud(val(b:fac)))~';')
          *Tipo de identificador del instrumento
           ACT(rr2,Val(rr2)~Copy(FBN['TipoISIN'],1,1)~';')
          *Codigo de ISIN/CUSIP
          ACT(rr2,Val(rr2)~Copy(val(e:fac),1,longitud(val(e:fac)))~';')
          *Tipo de instrumento 
           ACT(rr2,Val(rr2)~Copy(FBN['TipoInst'],1,1)~';')
          *Central Depositaria/Agente de Custodia
           ACT(rr2,Val(rr2)~Copy(FBN['Mercado'],1,longitud(FBN['Mercado']))~';')
          *Jurisdiccion de la Central depositaria
           ACT(rr2,Val(rr2)~'ARG;')
          *Moneda de emision
           ACT(rr2,Val(rr2)~Copy(val(k:fac),1,longitud(val(k:fac)))~';')
          *Valor Nominal
           * if FBN['TipoInst']=5
              ** Cambiar si piden cambio de alcance
              **ACT(rr2,Val(rr2)~Fstr(Copy(val(l:fac),1,longitud(val(l:fac))),1,2)~';') 
              *   ACT(rr2,Val(rr2)~'0.00;')
              *Else
              ** AA 14-01-21 se vuelve a version anterior  de Tamaño Lote
              ACT(rr2,Val(rr2)~Fstr(Copy(val(l:fac),1,longitud(val(l:fac))),1,2)~';') 
              **con 2 decimales en vez de 0
              * Endif         
          *Precio (ultimo registrado) en moneda de emision
           ACT(rr2,Val(rr2)~Fstr(Round2(val(m:fac),2),1,2)~';') 
             **con 2 decimales en vez de 8 
          *Cantidad
           ACT(rr2,Val(rr2)~Fstr(val(n:fac),1,2)~';')         
          *Monto en moneda de emision
           if Val(o:fac) < 0
              ACT(rr2,Val(rr2)~'('~Fstr(Abs(val(o:fac)),1,2)~');')
           Else       
              ACT(rr2,Val(rr2)~Fstr(val(o:fac),1,2)~';')         
           Endif
          *Tipo de cambio a Dolar
           If EqStr(FBN['MonedaEmision'],Var('MONEEXTR'))
              ACT(rr2,Val(rr2)~'1.00;')  
           Else
              ACT(rr2,Val(rr2)~Fstr(Round2(Dialogo.Precio1,2),1,2)~';') 
              **con 2 decimales en vez de 8 
           Endif
          *Monto en Dolares
           If Val(p:fac) < 0
              ACT(rr2,Val(rr2)~'('~Fstr(Abs(val(q:fac)),1,2)~')')  
           Else
              ACT(rr2,Val(rr2)~Fstr(val(q:fac),1,2))  
           Endif
           ACT(rr6,Val(rr2))
           EscribirASCII(Val(rr6))
           
