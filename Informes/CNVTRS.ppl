SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK) ")
SQL.ADD("     INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK)")
SQL.ADD("           ON S1.Cliente = C.Codigo ")
SQL.ADD("     INNER JOIN "~DBO~".CUENTAS CU WITH (NOLOCK) ")
SQL.ADD("           ON CU.Codigo = S1.Cuenta ")
SQL.ADD("     INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("           ON E.Codigo = S1.Especie ")
SQL.ADD("     INNER JOIN "~DBO~".MERCADOS M WITH (NOLOCK) ")
SQL.ADD("           ON M.Codigo = S1.Mercado ")
SQL.ADD("     INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("           ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND (S1.NrSaldo not in(121,227)) AND ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
