AgregarMarco(a8..a:fac,1)
AgregarMarco(b8..b:fac,1)
AgregarMarco(c8..e:fac,1)
AgregarMarco(f8..h:fac,1)
AgregarMarco(d8..d8,1)
AgregarMarco(g8..g8,1)
AgregarMarco(j8..j8,1)
AgregarMarco(m8..m8,1)
AgregarMarco(i8..k:fac,1)
AgregarMarco(l8..n:fac,1)
AgregarMarco(a:fac+1..n:fac+1,1,0,Exe('COLOR'))

recorrer&i 9, fac+1
  ACN(c:&i, Val(b:&i)/Val(b:fac+1)*100)
  if Vacio(Dialogo.Vehiculo1)
    if Val(d:&i) > 0 
      if Val(c:&i)>Val(d:&i)
        ACT(e:&i, 'Excedido')
        ColorCeldas(e:&i,clRED)
      else
        ACT(e:&i, 'OK')
        ColorCeldas(e:&i,clGREEN)
      endif
    endif
  endif
  if Vacio(Val(f:&i))
     if &i<fac
        if &i>=Val(w4)
           ACN(f:&i,Val(b:&i)/Val(b:Val(w4))*100)
        else
           if &i>=17
              ACN(f:&i, Val(b:&i)/Val(b17)*100)
           else
              ACN(f:&i, Val(b:&i)/Val(b9)*100)
           endif
        endif
     endif  
  endif

  if Vacio(Dialogo.Vehiculo1)
    if Val(g:&i) > 0
      if Val(f:&i)>Val(g:&i)
        ACT(h:&i, 'Excedido')
        ColorCeldas(h:&i,clRED)
      else
        ACT(h:&i, 'OK')
        ColorCeldas(h:&i,clGREEN)
      endif
    endif
  endif
  ACN(i:&i, Val(q:&i)/(Val(q:&i)+Val(r:&i))*100)
  ACN(l:&i, Val(r:&i)/(Val(q:&i)+Val(r:&i))*100)
  if Vacio(Dialogo.Vehiculo1)
    if Val(j:&i) > 0
      if Val(i:&i)>Val(j:&i)
        ACT(k:&i, 'Excedido')
        ColorCeldas(k:&i,clRED)
      else
        ACT(k:&i, 'OK')
        ColorCeldas(k:&i,clGREEN)
      endif
    endif
    if Val(m:&i) > 0
      if Val(l:&i)>Val(m:&i)
        ACT(n:&i, 'Excedido')
        ColorCeldas(n:&i,clRED)
      else
        ACT(n:&i, 'OK')
        ColorCeldas(n:&i,clGREEN)
      endif
    endif
  endif
proximo



