CrearDialogo
  Fecha1    : 'Fecha'   ;;;;;;;;;FSys
  Vehiculo1 : 'Vehiculo';;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if not Ok 
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

ACT(a4, 'Limites de Posicion - por Activo')
if NoVacio(Dialogo.Vehiculo1)
  ACT(a5, 'Vehiculo: '~Dialogo.Vehiculo1)
  ACT(z10, Descendientes('Vehiculos', Dialogo.Vehiculo1))
  if NoVacio(Val(z10))
    ACT(z11, "'"~Dialogo.Vehiculo1~"',"~Pipe2Comillas(Val(z10)))
  else
    ACT(z11, "'"~Dialogo.Vehiculo1~"'")
  endif
else
  ACT(a5, 'Vehiculo: Todos')
endif
ACT(a6, 'Fecha: '~Dialogo.Fecha1)


ACT(a8, 'Activo')
ACT(b8, 'Valor(000s)')
ACT(c8, '% Tot.Activos')
ACT(d8, '% Max. T.A.')
ACT(e8, 'Estado')
ACT(f8, '% Tot.Grupo')
ACT(g8, '% Max. Grupo')
ACT(h8, 'Estado')
ACT(i8, '% ARP')
ACT(j8, '% Max. ARP')
ACT(k8, 'Estado')
ACT(l8, '% USD')
ACT(m8, '% Max. USD')
ACT(n8, 'Estado')
AlinearCeldas(b8..d8, 'D')
AlinearCeldas(f8..g8, 'D')
AlinearCeldas(i8..j8, 'D')
AlinearCeldas(l8..m8, 'D')

AgregarMarco(a8..n8,1,0,Exe("COLOR"))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z8, 1)

ACT(a9, 'Depositos a plazo')
ACT(a10, '     Certif.Dep.plazo')
ACT(a11, '          Plazo fijo')
ACT(a12, '          Caja Ahorro')
ACT(a13, '          Overnight')
ACT(a14, '     Otros')
ACT(a15, '          FCI')
ACT(a16, '          Otros')
ACT(a17, 'Titulos Publicos')
ACT(a18, '     Nacionales')

AgregarMarco(a9..n9,1,0,RGB(192,192,192))
AgregarMarco(a17..n17,1,0,RGB(192,192,192))

*ACT(f9, 'N/A')
*ACT(g9, 'N/A')
*ACT(h9, 'N/A')
if Vacio(Dialogo.Vehiculo1)
  ACN(d9, LimAsignado('VINCULADOS', 'PDP', 'USD'))
  ACN(j9, LimAsignado('VINCULADOS', 'DPPORMON', 'ARP'))
  ACN(m9, LimAsignado('VINCULADOS', 'DPPORMON', 'USD'))
endif

*ACT(d10, 'N/A')
*ACT(e10, 'N/A')
if Vacio(Dialogo.Vehiculo1)
  ACN(g10, LimAsignado('VINCULADOS', 'PPFIJO', 'USD'))
endif
if Vacio(Dialogo.Vehiculo1)
  ACN(g13, LimAsignado('VINCULADOS', 'POVER', 'USD'))
endif
if Vacio(Dialogo.Vehiculo1)
