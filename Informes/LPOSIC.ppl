ifa

*- Plazos Fijos
SQL.ADD("Select O.Vehiculo1,O.Especie,C.Fecha2 Vto,C.Cantidad1 Cantidad,O.NrOperacion,O.TipoOp ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.TipoOp In ('MMCPM') ")
SQL.ADD(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and O.Vehiculo1 in ("~Val(z11)~")")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie,O.FechaVto Vto,O.Cantidad Cantidad, O.NrOperacion,O.TipoOp ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCP','MMDCA','MMCCR','MMO') ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and O.Vehiculo1 in ("~Val(z11)~")")
endif
*- FXVT 
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.Especie, ")
SQL.ADD(" O.FechaVto Vto,  ")
SQL.ADD(" -O.Cantidad Cantidad, O.NrOperacion,TipoOp ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('FXVT') ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.Vehiculo1, O.ContraEspecie Especie, ")
SQL.ADD(" O.FechaPago Vto,  ")
SQL.ADD(" O.TotalBrutoCli1 Cantidad, O.NrOperacion,TipoOp")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('FXVT') ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif

SQL.ADD("order by 5")


Recorrer SQL
  dfa
  if Incluido(fbn('TipoOp'),'MMCP|MMCPM')
     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, fbn('Cantidad')/1000)
        ACN(y1, 1)
     else
        ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif
     SCN(b11, Val(z3))

     acl(b11,'DELIAC',Fecha1=Dialogo.Fecha1,Lista1='MMCPM|MMCP|',Vehiculo1=Dialogo.Vehiculo1)

     SCN(b10, Val(z3))
     SCN(b9, Val(z3))
     SCN(17+Val(y1):11, Val(z3))
     SCN(17+Val(y1):10, Val(z3))
     SCN(17+Val(y1):9,  Val(z3))
  endif
  if Incluido(fbn('TipoOp'),'MMDCA|MMCCR')
     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, fbn('Cantidad')/1000)
        ACN(y1, 1)
     else
        ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif
     SCN(b12, Val(z3))
     acl(b12,'DELIAC',Fecha1=Dialogo.Fecha1,Lista1='MMDCA|MMCCR',Vehiculo1=Dialogo.Vehiculo1)
     SCN(b10, Val(z3))
     SCN(b9, Val(z3))
     SCN(17+Val(y1):12, Val(z3))
     SCN(17+Val(y1):10, Val(z3))
     SCN(17+Val(y1):9,  Val(z3))
  endif
  If Incluido(fbn('TipoOp'),'MMO')
     if Incluido(fbn('Especie'), 'USD|USB') 
        ACN(z3, fbn('Cantidad')/1000)
        ACN(y1, 1)
     else
        ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif
     SCN(b13, Val(z3))
     acl(b13,'DELIAC',Fecha1=Dialogo.Fecha1,Lista1='MMO|',Vehiculo1=Dialogo.Vehiculo1)
     SCN(b10, Val(z3))
     SCN(b9, Val(z3))
     SCN(17+Val(y1):13, Val(z3))
     SCN(17+Val(y1):10, Val(z3))
     SCN(17+Val(y1):9,  Val(z3))
  Endif

  *- Calculo los montos de las fx solamente para mostrar los %ARP y %USD 
  If Incluido(fbn('TipoOp'),'FXVT')
     if Incluido(fbn('Especie'), 'USD|USB') 
        *- Los Usd restan a los pf
        ACN(z3, fbn('Cantidad')/1000)
        ACN(y1, 1)
     else
        *- Los Arp suman a los pf
        ACN(z3, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
        ACN(y1, 0)
     endif
     *- (Columnas 17 y Columnas 18)      
     SCN(17+Val(y1):11, Val(z3))
     SCN(17+Val(y1):10, Val(z3))
     SCN(17+Val(y1):9,  Val(z3))
  Endif
proximo

*- Fondos
SQL.ADD("Select E.Cotiza, E.Issuer, S.Especie, S.EnteCustodia,E.Alias2, S.Saldo ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("where  S.Especie = E.Codigo  ")
SQL.ADD("  and  S.NrSaldo = 2 ")
SQL.ADD("  and  S.Saldo <> 0 ")
SQL.ADD("  and  E.Tipo = 'FON' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and S.Cliente in ("~Val(z11)~") and S.Cliente=S.EnteCustodia")
endif
SQL.ADD("and   S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = 2 ")
SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by E.Cotiza, E.Issuer, S.Especie, S.EnteCustodia ")

Recorrer SQL

  dfa
  ACN(z1, 0)
  ACN(z5, 0)

  SCN(z5, fbn['Saldo']*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)

  if EqStr(fbn('Cotiza'), 'ARP') 
     ACN(y1, 0)
  else
     ACN(y1, 1)
  endif

  if EqStr(fbn('Alias2'), '0')
     SCN(b15, Val(z5))
     acl(b15,'DELIA1',Fecha1=Dialogo.Fecha1,String='FON',Vehiculo1=Dialogo.Vehiculo1,String1=" Alias2='0'",String2='Fondos Money Market' )
     SCN(b14, Val(z5))
     SCN(b9, Val(z5))
     SCN(17+Val(y1):15, Val(z5))
     SCN(17+Val(y1):14, Val(z5))
     SCN(17+Val(y1):9,  Val(z5))
  else
     SCN(b:Val(w3), Val(z5))
     acl(b:val(w3),'DELIA1',Fecha1=Dialogo.Fecha1,String='FON',Vehiculo1=Dialogo.Vehiculo1,String1=" Alias2<>'0'",String2='Fondos Securities' )
     SCN(b17, Val(z5))
     SCN(17+Val(y1):17, Val(z5))
     SCN(17+Val(y1):Val(w3), Val(z5))
  endif
proximo

ACT(a:fac+1, 'Total')
ACN(b:fac+1, Val(b9)+Val(b17)+Val(b:Val(w4)))
ACN(q:fac+1, Val(q9)+Val(q17)+Val(q:Val(w4)))
ACN(r:fac+1, Val(r9)+Val(r17)+Val(r:Val(w4)))
if Vacio(Dialogo.Vehiculo1)
  ACN(j:fac+1, LimAsignado('VINCULADOS', 'TOTPORMON', 'ARP'))
  ACN(m:fac+1, LimAsignado('VINCULADOS', 'TOTPORMON', 'USD'))
endif
ACN(v1, fac+1)

ACO(1, 17)
ACO(2, 10)
ACO(3, 9)
ACO(4, 9)
ACO(5, 9)
ACO(6, 9)
ACO(7, 9)
ACO(8, 9)
ACO(9, 9)
ACO(10, 9)
ACO(11, 9)
ACO(12, 9)
