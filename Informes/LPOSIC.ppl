endif
if Vacio(Dialogo.Vehiculo1)
  ACN(d17, LimAsignado('VINCULADOS', 'PSE', 'USD'))
  ACN(j17, LimAsignado('VINCULADOS', 'SEPORMON', 'ARP'))
  ACN(m17, LimAsignado('VINCULADOS', 'SEPORMON', 'USD'))
endif
if Vacio(Dialogo.Vehiculo1)
  ACN(g18, LimAsignado('VINCULADOS', 'PSENAC', 'USD'))
