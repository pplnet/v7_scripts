SetFilaActual(18)

SQL.ADD("Select Codigo, Cotiza,InteresesC,VTeorico from "~DBO~".ESPECIES where Security='0' and Tipo='PUB'")

recorrer SQL

  ACN(z1, 0)
  ACN(z7, 0)
  ACN(z8, 0)

  (.'LPOSSPOTTT'.)
  (.'LPOSFUTURO'.)
  (.'LPOSSREPO'.)

  if Val(z1)>0 o Val(z8)>0
    ACT(a:fac, '            '~fbn('Codigo'))

    acn(v2,CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD'))

    ACT(ab:fac,FBN['InteresesC'])
    ACN(ac:fac,FBN['VTeorico'])

    if EqStr(Val(ab:fac),'CLE')
       * ensuciar el precio 
       ** calcular la tasa (%) x95:Dif. de dias x96:Especie x97:Fecha de Liquidacion   x98:Tasa Base x99:Tasa 
       ACT(x96,fbn('Codigo'))
       ACD(x97,Dialogo.Fecha1)
       ACN(x98,0)
       ACN(x99,0)

       (.'CALCINT'.)
       *TotalIntereses
       ACN(y98,Val(ac:fac)*(Val(z8)+Val(z1))*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Codigo')),Fsys)/100*Val(x95))
       * Total Neto
       ACN(y99,(Val(ac:fac)*(Val(z8)+Val(z1))*Val(v2))+Val(y98))
       * Precio Sucio
       ACN(v2, Val(y99)/(Val(z8)+Val(z1)))
    endif

    ACN(b:fac, (Val(z8)+Val(z1))*val(v2)/1000)

    if EqStr(fbn('Cotiza'), 'ARP') 
      ACN(y1, 0)
    else
      ACN(y1, 1)
    endif
    if Val(b:fac) < 0
      ACN(b:fac, 0)
    endif
    SCN(b17, Val(b:fac))
    acl(b18,'DELIA1',Fecha1=Dialogo.Fecha1,String='PUB',Vehiculo1=Dialogo.Vehiculo1,String1=" Security='0' ",String2='Titulos Publicos Nacionales')
    SCN(b18, Val(b:fac))
    SCN(17+Val(y1):fac, Val(b:fac))
    SCN(17+Val(y1):17,  Val(b:fac))
    SCN(17+Val(y1):18,  Val(b:fac))
  else
    dfa
  endif
proximo

ifa
