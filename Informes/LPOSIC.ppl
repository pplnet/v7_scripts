    endif
    if Val(b:fac) < 0
      ACN(b:fac, 0)
    endif
    SCN(b:Val(w4), Val(b:fac))
    SCN(b:Val(w5), Val(b:fac))
    acl(b:Val(w5),'DELIA1',Fecha1=Dialogo.Fecha1,String='ONE',Vehiculo1=Dialogo.Vehiculo1,String1="(PaisOrigen='ARG' or PaisOrigen is NULL) ",String2='Privados B.Corp.Local' )
    SCN(17+Val(y1):fac, Val(b:fac))
    SCN(17+Val(y1):Val(w4),  Val(b:fac))
    SCN(17+Val(y1):Val(w5),  Val(b:fac))
  else
    dfa
  endif

