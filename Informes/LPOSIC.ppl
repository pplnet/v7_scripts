**-- Selecciono aquellos repos que alguna pata esta activa
SQL.ADD("Select O.*,E.VTeorico,E.InteresesC,E.Cotiza  ")  
SQL.ADD("from "~DBO~".OPERACIONES O,"~DBO~".ESPECIES E ")
SQL.ADD("where O.Especie=E.Codigo ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and O.Vehiculo1 in ("~Val(z11)~")")
endif
SQL.ADD(" and  FechaOp2<= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  (FechaVto>= '"~IdxDate(Dialogo.Fecha1)~"' or FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD(" and  TipoOp In ('SERA','SERAV','SERP','SERPV') ") 
SQL.ADD(" Order By NrOperacion ")
 
ACN(y1,0)

Recorrer SQL
   dfa
   acn(v2,CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD'))
   ACT(ab:fac,FBN['InteresesC'])
   ACN(ac:fac,FBN['VTeorico'])

   if EqStr(Val(ab:fac),'CLE')
      * ensuciar el precio 
      ACT(x96,fbn('Especie'))
      ACD(x97,Dialogo.Fecha1)
      ACN(x98,0)
      ACN(x99,0)
      (.'CALCINT'.)
      ACN(y98,Val(ac:fac)*FBN['Cantidad']*Val(x99)*100/DIASA(EspecieDiasAnio(fbn('Especie')),Fsys)/100*Val(x95))
      ACN(y99,(Val(ac:fac)*FBN['Cantidad']*Val(v2))+Val(y98))
      ACN(v2, Val(y99)/FBN['Cantidad'])
   endif

   ACN(z3, FBN['Cantidad']*val(v2)/1000)
   ACN(z4, FBN['TotalNetoCli2']*CotizacionC(fbn('ContraEspecie'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)

   If Incluido(FBN['TipoOp'],'SERP|SERPV')
      ACN(z3,val(z4)-val(z3))
   Else 
      ACN(z3,val(z3)-val(z4))
   EndIf

   ACN(y1, 1)
   if EqStr(fbn('Cotiza'), 'ARP') 
      ACN(y1, 0)    
   endif

   SCN(b:fac,val(z3))
   SCN(b:17 ,val(z3))
   acl(b:fac,'DELIA2',Fecha1=Dialogo.Fecha1,Vehiculo1=Dialogo.Vehiculo1)
   SCN(17+Val(y1):fac    , Val(z3))
   SCN(17+Val(y1):17, Val(z3))
Proximo

