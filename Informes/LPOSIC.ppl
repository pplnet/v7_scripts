    ACN(b:fac, (Val(z8)+Val(z1))*CotizacionC(fbn('Codigo'),,,,Dialogo.Fecha1,1,SI,'USD')/1000)
    if EqStr(fbn('Cotiza'), 'ARP') 
      ACN(y1, 0)
    else
