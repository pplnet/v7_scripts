*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Desde'    ;;;;;;Dialogo.Fecha1 <> 0;'FechaVto Desde Invalida';NO;Fsys
  Fecha2    : 'Hasta'    ;;;;;;Dialogo.Fecha2 <> 0;'FechaVto Hasta Invalida';NO;Fsys
  Cliente1  : 'Agente'   ;;;;;;Vacio(Dialogo.Cliente1) O Incluido(Dialogo.Cliente1, SQLSet(" Select Codigo From "~DBO~".CLIENTES Where NrMAE Is Not Null AND NrMAE <> '0' "));'Agente Invalido';NO;;;;;;" NrMAE Is Not Null AND NrMAE <> '0' ";
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

SetFilaActual(2)
act(a:fac,'Listado de Garantias OCT')
ifa
act(a:fac,'Fecha Desde '~Dialogo.Fecha1)
ifa
act(a:fac,'Fecha Hasta '~Dialogo.Fecha2)
ifa
ifa

act(a:fac,'Fecha')
act(b:fac,'Cliente')
act(c:fac,'Tipo Gar.')
act(d:fac,'T.Neg.')
act(e:fac,'Especie')
act(f:fac,'Plazo')
act(g:fac,'Monto')
act(h:fac,'CV Pre.Cie.')
act(i:fac,'CC Pre.Cie.')
act(j:fac,'CV Post Cie.')
act(k:fac,'CC Post Cie.')
act(l:fac,'Suma/Neto')

AlinearCeldas(a:fac..z:fac, 'C')
AgregarMarco(a:fac..l:fac,2,0,Exe('COLOR'))
SetFont(a:2..z:fac,2)

SQL.ADD(" Select *  ")
SQL.ADD(" From "~DBO~".GARANTIASOCT ")
SQL.ADD(" Where Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
IF NoVacio(Dialogo.Cliente1)
  SQL.ADD(" AND Cliente = '"~Dialogo.Cliente1~"' ")
ENDIF
SQL.ADD(" Order By Fecha,Cliente,TipoNegociacion,Especie,NroPlazo ")

Recorrer SQL
  ACD(a:fac,fbn('Fecha'))
  act(b:fac, fbn('Cliente'))
*  if EqStr(fbn('TipoGar'),'O')
*    act(c:fac, 'Otorgada')
*  else
*    act(c:fac, 'Recibida')
*  endif
  act(d:fac, fbn('TipoNegociacion'))
  act(e:fac, fbn('Especie'))
  acn(f:fac, fbn('NroPlazo'))
  FormatoCeldas(f:FAC..f:FAC,Exe('F0'))

  acn(g:fac,fbn('Monto'))
  acn(h:fac,fbn('CVPreCierre'))
  acn(i:fac,fbn('CCPreCierre'))
  acn(j:fac,fbn('CVPostCierre'))
  acn(k:fac,fbn('CCPostCierre'))
  FormatoCeldas(g:FAC..k:FAC,Exe('F2'))

  act(l:fac,fbn('TotalNeto'))
  if Vacio(Val(l:fac))
    act(l:fac,'-')
  endif
  SetFont(a:FAC..l:FAC,1)
Proximo

ACO(1,6)
ACO(2,6)
ACO(3,6)
ACO(4,4)
ACO(5,5)
ACO(6,3)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,8)
ACO(11,8)
ACO(12,6)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(l:fac)
*Impresion(1,2)
SetPrintFit(3,90)
