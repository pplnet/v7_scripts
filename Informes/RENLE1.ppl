
CrearDialogo
    Fecha1: 'Fecha Desde'          ;;;;;;;;;Fecha(FStr(Anio(Fsys),4,0)~'-01-01')
    Fecha2:'Fecha Hasta'           ;;;;;;;;;FSys
    Especie1 : 'Especie'           ;3;1;;;;Vacio(Dialogo.Especie1) o DesciendeDeEspecie(Dialogo.Especie1, 'LETRA');'Especie invalida';NO;;;;;;" dbo.DESCIENDEDEESPECIE(Codigo,'LETRA') = 1 "
    Radio1: 'Filtra Book|SI|NO'    ;4;;;;;;;;1;
    Vehiculo1: 'Vehiculo'          ;5;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
    Lista1: 'Books'                ;6;1;;;Dialogo.Radio1=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo ='"~Dialogo.Vehiculo1~"' ");;
    Lista2:  'Vehiculo'            ;-1;1;;;Dialogo.Radio1=1;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
    Radio2: 'Expresado en|ARP|USD' ;;;;;NO;;;;0
    Fecha3:'Fecha Emision'         ;;;;;NO;;;;FSys
FinDialogo

IF Not Ok
    Cancelar
ENDIF

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,14,B')

**insertar logo
let &filaLogo 1
@LOGO

**TC
let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa CotizacionBNA(&monedaExtr,Dialogo.Fecha2,1,NO,NO)
let &cotDolBillete CotizacionBNA(&dolBillete,Dialogo.Fecha2,1,NO,NO)
IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF
**Header
SetFilaActual(1)
ACT(F:fac, 'Rentabilidad de Letras')
SetFont(F:fac, 3)
SetFilaActual(fac+2)
ifa
ifa
ACN(FI:1, fac)
ACT(A:fac, 'Fecha Desde: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Fecha Hasta: '~Dialogo.Fecha2)
ifa
IF NoVacio(Dialogo.Especie1)
    ACT(A:fac, 'Especie/s: '~Dialogo.Especie1)
ELSE
    ACT(A:fac, 'Especie/s: Todos')
ENDIF
ifa
IF Dialogo.Radio1 = 0
    IF NoVacio(Dialogo.Lista1)
        ACT(A:fac, 'Book/s: '~Dialogo.Lista1)
        ifa
        ACT(A:fac, 'Vehiculo/s:'~Dialogo.Vehiculo1)
    ELSE
        ACT(A:fac, 'Book/s: Todos')
        ifa
        ACT(A:fac, 'Vehiculo/s:'~Dialogo.Vehiculo1)
    ENDIF
ELSE 
    IF NoVacio(Dialogo.Lista2)
        ACT(A:fac, 'Vehiculo/s:'~Dialogo.Lista2)
    ELSE
        ACT(A:fac, 'Vehiculo/s: Todos')
    ENDIF
ENDIF
ifa
ACT(A:fac, 'Fecha Emision: '~Dialogo.Fecha3)
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: ARP')
ELSE
    ACT(A:fac, 'Expresado en: USD')
ENDIF
ifa
ACT(A:fac, 'TC Divisa:')
ACN(B:fac, &cotDolDivisa)
ifa
ACT(A:fac, 'TC Billete:')
ACN(B:fac, &cotDolBillete)
FormatoCeldas(B:fac-1..B:fac,Exe('F8'))
ifa
ifa
**Columnas
ACT(A:fac, 'Fideicomiso')
ACT(B:fac, 'Cartera')
ACT(C:fac, 'Letras')
ACT(D:fac, 'Moneda')
ACT(E:fac, 'Fecha Suscrip.')
ACT(F:fac, 'Vto. Original')
ACT(G:fac, 'Plazo Efect/')
ACT(G:fac+1, 'Transcurrido')
ACT(H:fac, 'Valor Nominal')
ACT(I:fac, 'Capital Inicial')
ACT(J:fac, 'Monto Cobrado/')
ACT(J:fac+1, ' A Cobrar')
ACT(K:fac, 'Renta')
ACT(L:fac, 'Renta%')
ACT(M:fac, 'TNA')
ACT(N:fac, 'Nr Operacion')
ifa
SetFont(A:Val(FI:1)..N:fac, 1)
AlinearCeldas(A:fac-1..N:fac, 'C')
AgregarMarco(A:fac-1..N:fac, 0, 0, Exe('COLOR'))

ACN(FI:2,fac)

**Query
SQL.ADD(" Select O.Cantidad, O.Vehiculo1, O.Especie, O.FechaOp, O.FechaVto, O.NrOperacion, O.TipoOp, O.Book1, O.Precio1,O.ContraEspecie, ")
SQL.ADD(" E.Nombre, E.Codigo, E.Fecha FechaMad, E.MonedaEmision, E.VTeorico ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E")
SQL.ADD(" Where O.Especie = E.Codigo ")
SQL.ADD(" AND O.TipoOp = 'SECS' ")
SQL.ADD(" AND E.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(Codigo,'LETRA') = 1 ")
IF NoVacio(Dialogo.Especie1)
        SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF Dialogo.Radio1 = 0    
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Book1 IN("~Pipe2Comillas(Dialogo.Lista1)~") ")
        SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    ELSE
        SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    ENDIF
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
ENDIF
SQL.ADD(" Order By O.FechaOp, E.Fecha ")
Recorrer SQL
    IF EspecieDiasAnio(fbn('Especie')) = 0
        let &diasAnio 360
    ELSE
        IF EspecieDiasAnio(fbn('Especie')) = 1
            let &diasAnio 365
        ELSE
            let &diasAnio DiasA(2,fbn('FechaMad'))
        ENDIF
    ENDIF
    IF Incluido(fbn('Vehiculo1'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
        let &dolVehiculo &dolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
        let &dolVehiculo &monedaExtr
    ENDIF
    IF Incluido(&monedaInforme, fbn('Contraespecie'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF fbn('FechaMad') <= Dialogo.Fecha2
        let &espVen 1
    ELSE
        let &espVen 0
    ENDIF
    let &tcFechaOp CotizacionBNA(&dolVehiculo,fbn('FechaOp'),1,NO,NO)
    IF Eqstr(fbn('NrOperacion'), 'C1000760')
    ENDIF
    let &tcFechaEmision CotizacionBNA(&dolVehiculo,Dialogo.Fecha3,1,NO,NO)
    let &precioVigente Cotizacion(fbn('Especie'),,,,Dialogo.Fecha3,1,SI)
    ACT(A:fac, fbn('Vehiculo1'))
    ACT(B:fac, fbn('Book1'))
    ACT(C:fac, fbn('Codigo')~'-'~fbn('Nombre'))
    ACT(D:fac, fbn('MonedaEmision'))
    ACD(E:fac, fbn('FechaOp'))
    ACD(F:fac, fbn('FechaMad'))
    *para letras vencidas
    IF &espVen = 1
        ACN(G:fac, fbn('FechaMad')-fbn('FechaOp'))
        ***---Busco el Precio del cupon cobrado
        SQL.ADD(" Select Precio1, Especie1 MonedaCupon, Fecha1 FechaCobro From "~DBO~".TRANSACCIONES2 ")
        SQL.ADD(" Where TipoTr2 = 'CCUPON' ")
        SQL.ADD(" AND Especie2 = '"~fbn('Especie')~"' ")
        SQL.ADD("  ")
        Recorrer SQL
            DFA
            IF Eqstr(fbn('MonedaCupon'), &monedaInforme)
                let &precioCupon fbn('Precio1')
            ELSE
            let &precioCupon fbn('Precio1') * CotizacionBNA(&dolVehiculo,fbn('FechaCobro'),1,NO,NO)
            ENDIF
        Proximo
        ACN(J:fac, fbn('Cantidad') * fbn('VTeorico') * &precioCupon)
    ELSE
        **para letras vigentes
        ACN(G:fac, Dialogo.Fecha3-fbn('FechaOp'))
        IF Eqstr(fbn('MonedaEmision'), &monedaInforme)
            ACN(J:fac, fbn('Cantidad') * fbn('VTeorico') * &precioVigente)
        ELSE
            ACN(J:fac, fbn('Cantidad') * fbn('VTeorico') * &precioVigente * &tcFechaEmision)
        ENDIF
    ENDIF    
    ACN(H:fac, fbn('Cantidad'))
    IF Eqstr(fbn('ContraEspecie'), &monedaInforme)
    ACN(I:fac, fbn('Cantidad') * fbn('VTeorico') * fbn('Precio1'))
    ELSE
        ACN(I:fac, fbn('Cantidad') * fbn('VTeorico') * fbn('Precio1') * &tcFechaOp)
    ENDIF
    ACN(K:fac, Val(J:fac)-Val(I:fac))
    ACN(L:fac, Val(K:fac)/Val(I:fac))
    ACN(M:fac, (Val(L:fac)* &diasAnio)/Val(G:fac))
    ACT(N:fac, fbn('NrOperacion'))
    ACLO(N:fac, fbn('NrOperacion'))
    
Proximo
FormatoCeldas(G:Val(FI:2)..G:fac,Exe('F0'))
FormatoCeldas(H:Val(FI:2)..J:fac,Exe('F2'))
FormatoCeldas(K:Val(FI:2)..M:fac,Exe('F8'))
FormatoCeldas(L:Val(FI:2)..L:fac,Exe('F2%'))

let &conVentas 0
SetFilaActual(fac+4)
ACN(FI:3,fac)
**Para VENTAS efectuadas en el período
SQL.ADD(" Select O.Cantidad, O.Vehiculo1, O.Especie, O.FechaOp,  O.Book1, O.Precio1, O.TipoOp, O.NrOperacion, ")
SQL.ADD(" E.Nombre, E.Codigo, E.Fecha, E.MonedaEmision, E.VTeorico ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E")
SQL.ADD(" Where O.Especie = E.Codigo ")
SQL.ADD(" AND O.TipoOp = 'SEVS' ")
SQL.ADD(" AND E.Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(Codigo,'LETRA') = 1 ")
IF NoVacio(Dialogo.Especie1)
        SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF Dialogo.Radio1 = 0    
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Book1 IN("~Pipe2Comillas(Dialogo.Lista1)~") ")
        SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    ELSE
        SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
    ENDIF
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
ENDIF
SQL.ADD(" Order By FechaOp ")
Recorrer SQL
    let &conVentas 1
    ACT(A:fac, fbn('Vehiculo1'))
    ACT(B:fac, fbn('Book1'))
    ACT(C:fac, fbn('Codigo')~'-'~fbn('Nombre'))
    ACT(D:fac, fbn('MonedaEmision'))
    ACD(E:fac, fbn('FechaOp'))
    ACN(F:fac, fbn('Cantidad'))
    ACN(G:fac, fbn('Precio1'))
    ACN(H:fac,  fbn('Precio1')*fbn('Cantidad') * fbn('VTeorico'))
    ACT(I:fac, fbn('NrOperacion'))
    ACLO(I:fac, fbn('NrOperacion'))
    
Proximo
IF &conVentas = 1
    *Header
    ACT(A:Val(FI:3)-1, 'Ventas en el período')
    SetFont(A:Val(FI:3)-1..B:Val(FI:3)-1, 1)
    
    *Columnas
    ACT(A:Val(FI:3), 'Fideicomiso')
    ACT(B:Val(FI:3), 'Cartera')
    ACT(C:Val(FI:3), 'Letras')
    ACT(D:Val(FI:3), 'Moneda')
    ACT(E:Val(FI:3), 'Fecha Op.')
    ACT(F:Val(FI:3), 'Nominal')
    ACT(G:Val(FI:3), 'Precio')
    ACT(H:Val(FI:3), 'Monto Cobrado')
    ACT(I:Val(FI:3), 'NrOperacion')
    SetFont(A:Val(FI:3)..I:Val(FI:3), 1)
    AlinearCeldas(A:Val(FI:3)..I:Val(FI:3), 'C')    
    AgregarMarco(A:Val(FI:3)..I:Val(FI:3), 0, 0, Exe('COLOR'))
    FormatoCeldas(G:Val(FI:3)..G:fac,Exe('F8'))
    
ENDIF

ACO(1, 10)
ACO(2, 10)
ACO(3, 15)
ACO(4, 5)
