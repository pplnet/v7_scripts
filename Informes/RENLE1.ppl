ACO(7, 8)
ACO(8, 14)
ACO(9, 14)
ACO(10, 14)
ACO(11, 14)
ACO(12, 8)
ACO(13, 10)
ACO(14, 10)
ifa
ifa
ifa
ACT(A:fac,'Fin del Informe')
SetFont(A:fac,1)
LimitesVision(O:fac+1)