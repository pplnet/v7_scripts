*SQL.ADD(" AND    T.Fecha5 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Fecha1 >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1 in ("~Pipe2Comillas(VAR('MERCAACMC'))~")")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" AND  O.NrOperacion NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
SQL.ADD(" UNION ")
*- Vouchers No Neteados
* FJL 21/8/18 - Alcira pidio que se agrupen por fecha real de liquidacion y no por fecha de confirmacion
*SQL.ADD(" SELECT T.Fecha3 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" SELECT O.Cantidad as VN, T.Fecha1 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, O.ContraEspecie, -M1.Cantidad, O.TotalCaucion, O.PaseCB, CU.Numero, O.TipoComprobante1 Cheque, ")
SQL.ADD(" CU.Comitente, M1.Leyenda, TP.Nombre, M1.NrSaldo, M1.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, O.Mercado4  ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS m1, "~DBO~".MOVEJECUTADOS m2, "~DBO~".OPERACIONES O,  "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION TP,  "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo ")
SQL.ADD(" where  t.NrTrans      = m1.nroperacion ")
SQL.ADD(" and    m2.NrTrans2    = t.NrTrans ")
SQL.ADD(" and    m2.NrOperacion = o.NrOperacion ")
** FJL 21/12/18 - Para desccartar Movimietnos duplicados por Mercados regulados de Futuro de Monedas
SQL.ADD(" AND    m1.Leyenda    Not like 'INVERTIR%'    ")
SQL.ADD(" and    O.Cliente1    = C.Codigo      ")  
SQL.ADD(" AND    O.Especie     = E.Codigo      ")
SQL.ADD(" AND    O.EsTBills    <> 'SI'         ")
SQL.ADD(" AND    O.TipoOp      = TP.Codigo ")    
SQL.ADD(" AND    O.ContraEspecie = m1.Especie ")
* FJL 21/8/18 - Alcira pidio que se filtre por fecha real de liquidacion y no por fecha de confirmacion
*SQL.ADD(" AND    T.Fecha3 >= "~idxdate2(Dialogo.Fecha1)~" ")
*SQL.ADD(" AND    T.Fecha3 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Fecha3 >= 0 ")
SQL.ADD(" AND    T.Fecha1 >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1 NOT in ("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
** FJL 21/12/18 - Para excluir Movimientos por Mercados regulados de Futuro de Monedas
SQL.ADD(" AND    T.Mercado1 NOT in ("~Pipe2Comillas(VAR('MERROFEX'))~") ")
SQL.ADD(" AND    T.Mercado1 NOT in ("~Pipe2Comillas(VAR('MERCTRANS'))~") ")
If Novacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND  O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla1)
  SQL.ADD(" AND  O.NrOperacion NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF

SQL.ADD(" UNION ")

*- Vouchers Neteo de MTM
SQL.ADD(" SELECT T.Cantidad1 as VN, T.Fecha1 FechaMov, 'Neto' NrOperacion, '' NrBoleto, T.Cliente1, C.RazonSocial, 'Neto' TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, T.Especie ContraEspecie, -M.Cantidad Cantidad, 0 TotalCaucion, 0 PaseCB, CU.Numero, '0' Cheque, ")
SQL.ADD(" CU.Comitente, M.Leyenda, 'MTM' Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, T.Mercado1 Mercado4  ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo ")
SQL.ADD(" where  T.NrTrans       = M.NrOperacion ")
SQL.ADD(" AND    M.Leyenda       Not like 'INVERTIR%' ")
SQL.ADD(" and    T.Cliente1      = C.Codigo    ")  
SQL.ADD(" AND    T.Especie       = M.Especie ")
SQL.ADD(" AND    T.Fecha3        >= 0 ")
SQL.ADD(" AND    T.Fecha1        >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1        <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1      in ("~Pipe2Comillas(VAR('MERROFEX'))~") ")
If Novacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND  T.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif

SQL.ADD(" UNION ")

SQL.ADD(" SELECT DISTINCT M.Cantidad as VN, M.FechaMov, T.NrTrans NrOperacion, ' ' NrBoleto, M.Cliente Cliente1, C.RazonSocial, T.TipoTr2 TipoOp, M.Mercado Mercado1, ")
SQL.ADD(" M.Cuenta Cuenta1, ' ' Cuenta2, M.Especie ContraEspecie, M.Cantidad, 0 TotalCaucion, '0' PaseCB, CU.Numero, '0' Cheque, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, 'MAE' Mercado4  ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M LEFT OUTER JOIN "~DBO~".CUENTAS CU ON M.Cuenta = CU.Codigo, ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".TIPOSTRANSACCION2 TP ")
SQL.ADD(" WHERE  M.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND    M.Cliente  = C.Codigo      ")
SQL.ADD(" AND    M.Especie  = E.Codigo      ")
SQL.ADD(" AND    T.TipoTr2  = TP.Codigo     ")
SQL.ADD(" AND    E.Tipo     = 'MON'         ")
SQL.ADD(" AND    T.TipoTr2  = 'LCUPON'      ")
SQL.ADD(" AND    M.NrSaldo  IN (5,4)        ")
SQL.ADD(" AND    C.Alias3   = 'CP'          ")
SQL.ADD(" AND    M.FechaMov >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD(" AND  T.NrTrans NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF
SQL.ADD(" UNION ")
SQL.ADD(" SELECT DISTINCT M.Cantidad as VN, M.FechaMov, T.NrTrans NrOperacion, ' ' NrBoleto, M.Cliente Cliente1, C.RazonSocial, T.TipoTr2 TipoOp, M.Mercado Mercado1, ")
SQL.ADD(" M.Cuenta Cuenta1, ' ' Cuenta2, M.Especie ContraEspecie, M.Cantidad, 0 TotalCaucion, '0' PaseCB, CU.Numero, '0' Cheque, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, 'MAE' Mercado4  ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M LEFT OUTER JOIN "~DBO~".CUENTAS CU ON M.Cuenta = CU.Codigo , ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".TIPOSTRANSACCION2 TP ")
SQL.ADD(" WHERE  M.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND    M.Cliente  = C.Codigo      ")
SQL.ADD(" AND    M.Especie  = E.Codigo      ")

SQL.ADD(" AND    T.TipoTr2  = TP.Codigo     ")
SQL.ADD(" AND    E.Tipo     = 'MON'         ")
SQL.ADD(" AND    T.TipoTr2  = 'LCUPON'      ")
SQL.ADD(" AND    M.NrSaldo  IN (5,4)        ")
SQL.ADD(" AND    M.Cliente  <> T.Vehiculo1  ")
SQL.ADD(" AND    M.FechaMov >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD(" AND  T.NrTrans NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF

SQL.ADD(" ORDER BY 2,3 ")
watch(sql.batch())
ACD(fe:1, 0)
ACN(me:1, 100)
ACN(zz:1, 0)
ACN(zz:2, 0)

Recorrer SQL
   ACN(zz:2, 0)
   If Val(fe:1)<>fbn('FechaMov')
      message('Fecha: '~fbn('FechaMov'))
      If Val(fe:1)<>0
         ACT(e:fac, 'Total '~Val(fe:1)~' --> ')
         ACN(o:fac, Val(fe:2))
         ACN(fe:2, 0)
         SetFont(a:fac..z:fac,2)
         AgregarMarco(a:fac..o:fac,0,0)
         FormatoCeldas(o:fac, EXE('F2'))
         ifa
         If Val(me:1)<>mes(fbn('FechaMov'))
            ifa
            ACT(e:fac, 'Total '~Meses(Val(me:1))~' --> ')
            ACN(o:fac, Val(me:2))
            ACN(me:2, 0)
            SetFont(a:fac..z:fac,2)
            AgregarMarco(a:fac..o:fac,0,0,EXE('COLOR8'))
            FormatoCeldas(o:fac, EXE('F2'))
            ifa
            ifa
         Endif
         ifa
      Endif
   Endif

   ACT(a:fac, fbn('NrOperacion'))
   Message(Val(a:fac))
   If Not Eqstr(fbn('TipoOp'),'LCUPON')
     If Not Eqstr(fbn('TipoOp'),'Neto')
       ACLO(a:fac, fbn('NrOperacion'))
     Endif
   Else
      ACLT(a:fac, fbn('NrOperacion'))
   Endif
   ACT(b:fac, fbn('NrBoleto'))
   ACT(d:fac, fbn('RazonSocial'))
   ACT(e:fac, fbn('TipoOp')~' - '~fbn('Nombre'))

   If Eqstr(fbn('TipoOp'), 'LCUPON') 
      IF fbn('NrGrupo')=41
      ACT(f:fac, 'Comision '~VAR('VEHICULODE'))
      Endif
      If fbn('NrGrupo')=42
      ACT(f:fac, 'IVA Com. '~VAR('VEHICULODE'))
      Endif
      If fbn('NrGrupo')=51
      ACT(f:fac, 'Comision CV')
      Endif
   Else
      ACT(f:fac, fbn('Leyenda'))
   Endif

 ** g - h  
    ACN(g:fac,fbn('VN'))
   ** AA 16/07/2025 inclusion A3C se toma descripcion del mercado incorporando variable MERLICAJ
   ACT(ai:fac,BuscarCampo('MERCADOS','Descripcion','Codigo',fbn('Mercado1')))
   ACT(h:fac, fbn('Mercado1')~' - '~Val(ai:fac))
 **
   
 If Not Incluido(fbn('Mercado1'),Pipe2Comillas(VAR('MERLICAJ')))
      If NoVacio(fbn('Corresponsal'))
      ACT(i:fac, BuscarCampo('CORRESPONSALES','Nombre','Codigo',fbn('Corresponsal')))
      else
        If NoVacio(fbn('Alias3'))
           ACT(i:fac, fbn('Alias3'))
        else
           ACT(i:fac, fbn('Codigo'))
        Endif
      Endif
   Else
      ** AA 16/07/2025 inclusion A3C se toma descripcion del mercado
      ACT(i:fac,val(ai:fac))
      *If Incluido(fbn('Mercado1'),'AC')
      *   ACT(i:fac, 'Argenclear')
      *Endif
      *If Incluido(fbn('Mercado1'),'MC')
      *   ACT(i:fac, 'MAEclear')
      *Endif
      *If Incluido(fbn('Mercado1'),'EU')
      *   ACT(i:fac, 'Euroclear')
      *Endif
      *If Incluido(fbn('Mercado1'),'CE')
      *   ACT(i:fac, 'Cedel')
      *Endif
   Endif
   ACT(j:fac, fbn('Numero'))
   If Not EqStr(fbn('TipoOp'),'MOVMON')
   If EqStr(fbn('Cheque'),'1')
         ACT(k:fac, 'Cheque ')
      Else
         ACT(k:fac, 'Trf. Bancaria')
      Endif
   Endif

   ACT(l:fac,  fbn('ContraEspecie'))
   If Not Eqstr(fbn('TipoOp'), 'LCUPON') o fbn('NrSaldo')=4 
      * Estas comisiones las paga el vehiculo
        ACN(m:fac,  -fbn('Cantidad'))

      If Eqstr(fbn('TipoOp'), 'LCUPON') y fbn('NrSaldo')=4 y Not Eqstr(fbn('Cliente1'),fbn('Vehiculo1'))
      * Estas comisiones las cobra el vehiculo
        ACN(m:fac,  fbn('Cantidad'))
      Endif
   Endif

   If Eqstr(fbn('ContraEspecie'),VAR('MONELOCA'))
      ACN(n:fac, 1)
   Else
   *     ACN(k:fac, Cotizacionn:(fbn('ContraEspecie'),fbn('FechaMov')-1,2,SI,SI) )
      ACN(n:fac, CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaMov')-1,25,SI,val(es:1)) )
   Endif
   ACN(o:fac, Val(m:fac)*Val(n:fac))
** FJL 21/12/18 - Se saca de la operacion
*   ACT(p:fac,'MAE')
   ACT(p:fac, fbn('Mercado4'))
   ACT(q:fac, iif(vacio(BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Cliente1'))),'Propio','Contraparte'))

   If Eqstr(fbn('TipoOp'), 'LCUPON') y fbn('NrSaldo')=5
      SQL.ADD(" SELECT T.Precio1, T.Precio2, T.Precio3, M.NrGrupo2     ")
      SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
      SQL.ADD(" WHERE T.NrTrans = M.NrOperacion ")
      SQL.ADD(" AND   M.Cliente = '"~fbn('Cliente1')~"' ")
      SQL.ADD(" AND   T.NrTrans = '"~fbn('NrOperacion')~"' ")
      Recorrer SQL
         dfa
         * AMORT
         ACN(pr:1, fbn('Precio1'))
         * RENTA  
         ACN(pr:2, fbn('Precio2'))
         * INT CAPITALIZ.
         ACN(pr:3, fbn('Precio3'))
         ACN(ng:2, fbn('NrGrupo2'))
         Break
      Proximo
      If Val(pr:1)<>0
         ACT(e:fac, Val(e:fac)~' - Renta')
         ACN(m:fac,  Val(ng:2)*Val(pr:1)/100)
         ACN(o:fac, Val(m:fac)*Val(n:fac))
         SetFont(a:fac..z:fac,1)
         FormatoCeldas(m:fac, EXE('F2'))
         FormatoCeldas(n:fac, EXE('F9'))
         FormatoCeldas(o:fac, EXE('F2'))
         AlinearCeldas(l:fac..l:fac, 'C')
         AlinearCeldas(p:fac..p:fac, 'C')
      Endif
      If Val(pr:2)<>0 o Val(pr:3)<>0
         If Val(pr:1)<>0
            ifa
            ACN(zz:2, 1)
            ACT(a:fac, Val(a:fac-1))
            ACLT(a:fac, Val(a:fac-1))
            ACT(b:fac, Val(b:fac-1))
*            ACT(c:fac, Val(c:fac-1))
            ACT(d:fac, Val(d:fac-1))
            ACT(e:fac, fbn('TipoOp')~' - '~fbn('Nombre'))
            ACT(i:fac, Val(i:fac-1))
            ACT(j:fac, Val(j:fac-1))
            ACT(k:fac, Val(k:fac-1))
            ACT(l:fac, Val(l:fac-1))
            ACN(n:fac, Val(n:fac-1))
         Endif
         ACT(e:fac, Val(e:fac)~' - Amortizacion')
         ACN(m:fac,  Val(ng:2)*(Val(pr:2)+Val(pr:3))/100)
         ACN(o:fac, Val(m:fac)*Val(n:fac))
      Endif
   Endif

   SetFont(a:fac..z:fac,1)
   AlinearCeldas(l:fac..l:fac, 'C')
   FormatoCeldas(m:fac, EXE('F2'))
   FormatoCeldas(n:fac, EXE('F9'))
   FormatoCeldas(o:fac, EXE('F2'))
   AlinearCeldas(p:fac..p:fac, 'C')

   If Val(zz:2)=1
      SCN(fe:2, Val(o:fac-1))
      SCN(me:2, Val(o:fac-1))
      SCN(tg:1, Val(o:fac-1))
   Endif

   SCN(fe:2, Val(o:fac))
   SCN(me:2, Val(o:fac))
   SCN(tg:1, Val(o:fac))
   ACD(fe:1, fbn('FechaMov'))
   ACN(me:1, Mes(fbn('FechaMov')))
   ACN(zz:1, 1)
Proximo

If Val(zz:1)<>0
   ifa
   ifa
   ACT(e:fac, 'Total '~Val(fe:1)~' --> ')
   ACN(o:fac, Val(fe:2))
   SetFont(a:fac..z:fac,2)
   AgregarMarco(a:fac..o:fac,0,0)
   FormatoCeldas(o:fac, EXE('F2'))
   ifa
   ifa
   ACT(e:fac, 'Total '~Meses(Val(me:1))~' --> ')
   ACN(o:fac, Val(me:2))
   SetFont(a:fac..z:fac,2)
   AgregarMarco(a:fac..o:fac,0,0,EXE('COLOR8'))
   FormatoCeldas(o:fac, EXE('F2'))
Endif
ifa

If Dialogo.Check1=1
   ifa
   ACT(e:fac, 'Total General del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2~' --> ')
   ACN(o:fac, Val(tg:1))
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..o:fac,0,0,EXE('COLOR6'))
   FormatoCeldas(o:fac, EXE('F2'))
   ifa
Endif

