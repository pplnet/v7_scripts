** Vouchers CPC1
SQL.ADD(" SELECT DISTINCT O.Cantidad as VN, T.Fecha1 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, O.ContraEspecie, M.Cantidad, O.TotalCaucion, O.PaseCB, CU.Numero, O.TipoComprobante1 Cheque, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, O.Mercado4 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta1 = CU.Codigo, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M  , "~DBO~".TIPOSOPERACION TP,  "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND    M.NrTrans2    = T.NrTrans     ")
SQL.ADD(" AND    O.Cliente1    = C.Codigo      ")
SQL.ADD(" AND    O.Especie     = E.Codigo      ")
SQL.ADD(" AND    O.EsTBills   <> 'SI'         ")
*SQL.ADD(" AND    O.UDN2        = 'CPC1'        ")
SQL.ADD(" AND    O.TipoOp IN ('TIV','TIC') and (O.CB4=1 OR (O.Cliente1='"~Var('VEHICULO')~"' and O.CB4=0))")
SQL.ADD(" AND    O.TipoOp      = TP.Codigo     ")
SQL.ADD(" AND    O.ContraEspecie = M.Especie   ")
SQL.ADD(" AND    T.Fecha1 >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1 in ("~Pipe2Comillas(VAR('MERCTRANS'))~") ")
If Novacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND  O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla1)
  SQL.ADD(" AND  O.NrOperacion NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
SQL.ADD(" UNION ")
SQL.ADD(" SELECT DISTINCT O.Cantidad as VN, T.Fecha1 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, O.ContraEspecie, M.Cantidad, O.TotalCaucion, O.PaseCB, CU.Numero, O.TipoComprobante1 Cheque, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, O.Mercado4 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M  , "~DBO~".TIPOSOPERACION TP,  "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND    M.NrTrans2    = T.NrTrans     ")
SQL.ADD(" AND    O.Cliente1    = C.Codigo      ")
SQL.ADD(" AND    O.Especie     = E.Codigo      ")
SQL.ADD(" AND    E.Tipo       <> 'TBL'         ")
*SQL.ADD(" AND    O.UDN2       <> 'CPC1'        ")
SQL.ADD(" AND    NOT (O.TipoOp IN ('TIV','TIC') and (O.CB4=1 OR (O.Cliente1='"~Var('VEHICULO')~"' and O.CB4=0))) ")
SQL.ADD(" AND    O.TipoOp      = TP.Codigo     ")
SQL.ADD(" AND    O.ContraEspecie = M.Especie   ")
SQL.ADD(" AND    T.Fecha1 >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha1 <= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    T.Mercado1 in ("~Pipe2Comillas(VAR('MERCTRANS'))~") ")
If Novacio(Dialogo.Vehiculo1)
  SQL.ADD(" AND  O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif
IF NoVacio(Dialogo.ListaTabla1)
  SQL.ADD(" AND  O.NrOperacion NOT IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
SQL.ADD(" UNION ")
*- Vouchers Neteados
* FJL 21/8/18 - Alcira pidio que se agrupen por fecha real de liquidacion y no por fecha de confirmacion
*SQL.ADD(" SELECT DISTINCT T.Fecha5 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" SELECT DISTINCT O.Cantidad as VN, T.Fecha1 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, O.ContraEspecie, M.Cantidad, O.TotalCaucion, O.PaseCB, CU.Numero, O.TipoComprobante1 Cheque, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1, CU.Codigo, CU.Corresponsal, CU.Alias3, O.Mercado4 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON T.Cuenta2 = CU.Codigo, ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M  , "~DBO~".TIPOSOPERACION TP,  "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND    M.NrTrans2    = T.NrTrans     ")
SQL.ADD(" AND    O.Cliente1    = C.Codigo      ")
SQL.ADD(" AND    O.TipoOp      = TP.Codigo     ")
SQL.ADD(" AND    O.Especie     = E.Codigo      ")
SQL.ADD(" AND    O.EsTBills    <> 'SI'         ")
SQL.ADD(" AND    (T.RB6         = '1'   OR   T.TipoTr2 = 'COMP')           ")
SQL.ADD(" AND    (O.ContraEspecie = M.Especie   Or (T.Mercado1 in ("~Pipe2Comillas(VAR('MENEFFX'))~") AND O.TasaEspecie = M.Especie))   ")
* FJL 21/8/18 - Alcira pidio que se filtre por fecha real de liquidacion y no por fecha de confirmacion
