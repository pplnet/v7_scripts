** Datos de Cliente Vehiculo
SQL.ADD("SELECT CUIT, NrIngBrutos, RazonSocial, CodigoCNV, Direccion, CodigoPostal, Localidad,Pais,Telefono,Fax ")
SQL.ADD("FROM   "~DBO~".CLIENTES ")
SQL.ADD("WHERE  Codigo  = '"~Var('VEHICULO')~"'")
Recorrer SQL
 
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 02)~'-'~Copy(FBN('CUIT'), 03, 08)~'-'~Copy(FBN('CUIT'), 11, 01))
         EndIf      
      EndIf
      ACT(vh:1,Val(ZB:10))
   Else
      ACT(ZB:10, '')
      ACT(vh:1,Var('VEHICULO'))
   EndIf
   
   ACT(vh:2,MIRT(BuscarCampo('PAISES','Nombre','Codigo',FBN['Pais'])))
   ACT(vh:3,FBN['RazonSocial'])
   ACT(vh:4,FBN['CodigoCNV'])
   ACT(vh:5,FBN['CodigoPostal'])
   ACT(vh:6,FBN['Localidad'])
   ACT(vh:7,FBN['Direccion'])
   ACT(vh:8,FBN['Telefono'])
   ACT(vh:9,FBN['Fax'])
Proximo



SQL.ADD(" Select O.TipoOp, O.Especie, O.Plazo, O.Contraespecie, O.Cantidad, O.Precio1, O.TotalBrutoCli1, O.Mercado MercadoEsp, O.CB8, O.FechaCarga, ")
SQL.ADD("        O.Mercado2 MercadoMon,O.FechaOp, O.FechaVto, O.FechaPago, O.NrOperacion, O.Formaliquidacion1, O.Formaliquidacion2, O.Cliente1, O.NrOrden, O.FechaAltaMAE, ")
*SQL.ADD(" C.RazonSocial, C.Cuit, E.Codigo, E.Nombre NomEsp, E.ISIN, E.CodNumCajaValores, E.Codigo4 MLCode, E2.Nombre NomContra,  IsNull(OD.FechaOrden,'19990404') FechaOrden, OD.HoraOrden,")
SQL.ADD(" C.RazonSocial, C.Cuit, E.Codigo, E.Nombre NomEsp, E.ISIN, E.CodNumCajaValores, E.Codigo4 MLCode, E2.Nombre NomContra,  E2.Alias2 NomContraMEP, OD.FechaOrden, OD.HoraOrden,")
SQL.ADD(" Case  When  O.NrOperacion3 Like 'T%' Then 'PorCuenta'  Else 'Cartera' End TipoCartera, O.TotalComisiones ")
SQL.ADD("  From "~DBO~".OPERACIONES O ")
SQL.ADD("  Left JOIN ORDENES OD WITH (NOLOCK) ON  OD.NrOperacion = O.NrOperacion ")
SQL.ADD("  , "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".ESPECIES E2, "~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("Where O.NrOperacion ='"~Dialogo.NrOperacion1~"'")
SQL.ADD("  and O.Cliente1=C.Codigo ")
SQL.ADD("  and O.Especie=E.Codigo ")
SQL.ADD("  and O.ContraEspecie=E2.Codigo ")
SQL.ADD("  and O.TipoOp in ('TIC','TIV') ")
SQL.ADD("  and (C.Jerarquia like ('"~VAR('JERVINCULA')~"%') or C.Jerarquia like ('"~VAR('JERCLIENTE')~"%')  OR C.Vinculado ='SI' )")
SQL.ADD("  and OB.NrOperacion=o.NrOperacion and OB.Valor=1 ")
SQL.ADD("  and OB.NrBit in(10,70) ")
SQL.ADD("  ORDER BY O.TipoOp, C.RazonSocial, O.Especie, O.Plazo, O.Contraespecie, O.Mercado2 ")
watch(SQL.BATCH())
ACN(cr:1,0)
Recorrer SQL

   SCN(cr:1,1)
   
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 02)~'-'~Copy(FBN('CUIT'), 03, 08)~'-'~Copy(FBN('CUIT'), 11, 01))
         EndIf      
      EndIf
      ACT(CU:1,Val(ZB:10))
   Else
      ACT(ZB:10, '')
      ACT(CU:1,FBN['Cliente1'])
   EndIf
   ACT(op:1,FBN['NrOperacion'])

   AgregarBMP(b:2,EXE('LOGO'))
   AlinearCeldas(b:2,'D')

   ACT(a:4, 'ATTN:')
   ACT(a:5, FBN['RazonSocial'])
   IF Dialogo.Radio1=0
   ACT(a:6, 'CUIT :')   
   Else
   ACT(a:6, 'Tax ID :')      
   Endif   
   *   ACT(a:6, Val(a6)~' '~FBN['CUIT'])   
   ACT(a:6, Val(a6)~' '~Val(ZB:11))   
   ACT(b:7, 'Ref. Nro: '~FBN['NrOperacion']~' '~Fecha(FSYS) )
   AlinearCeldas(b:7,'D')

   ACT(a:9, '_____________________________________________________________________________________________________'  )

   Setfont(a:5..a:6, 4)
   Setfont(a:4, 6)
   Setfont(b:7, 6)
   Setfont(a:9, 4)

   if Incluido(FBN['MercadoEsp'],VAR('MERCADOCV'))
      if FBN['FormaLiquidacion1']=0
         act(ba:fac,'STD')
      else   
         if FBN['FormaLiquidacion1']=1
            act(ba:fac,'DVP')
         else   
            act(ba:fac,'RVP')
         endif
      endif
   else 
      if FBN['FormaLiquidacion2']=0
         act(ba:fac,'FD&&P')
      else   
         if FBN['FormaLiquidacion2']=1
            act(ba:fac,'DVP')
         else   
            act(ba:fac,'FOP')
         endif
      endif
   endif

 if Incluido(fbn['TipoOp'],'TIC|')
    act(z1,'comprado a')
    act(z2,'para')
    act(z3,'vendido de')
    act(z11,'bought from')
    act(z12,'for')
    act(z13,'sold')
 else
    act(z1,'vendido a')
    act(z2,'de')
    act(z3,'comprado de')
    act(z11,'sold to')
    act(z12,'from ')
    act(z13,'bought')
 endif
 
 If Eqstr(fbn('TipoCartera'),'Cartera')
    if Incluido(fbn['TipoOp'],'TIC|')
       ACT(z4,'para nuestra cartera propia')
    else
       ACT(z4,'de nuestra cartera propia')
    Endif    
    ACT(z14,'on behalf of our own portfolio')
 Else
    ACT(z4,'por vuestra cuenta y orden')
    ACT(z14,'on your behalf')
 Endif

 ACN(xy1,11) 
 
 IF Dialogo.Radio1=0
    * Espanol
    ACT(a:Val(xy1),'Por medio de la presente confirmamos que hemos '~Val(z1)~' ustedes '~Val(z4)~' los')
    SCN(xy1,1)
    ACT(a:Val(xy1),'valores que a continuacion se detallan:')
    SCN(xy1,3)
    ACT(a:Val(xy1),'Bono: '~FBN['Especie']~' - '~FBN['NomEsp'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Fecha de la Orden del Cliente:  ')
    If Vacio(FBN['FechaOrden'])
       ACT(a:Val(xy1), Val(a:Val(xy1))~Fecha(FBN['FechaCarga'])) 
    Else
       ACT(a:Val(xy1), Val(a:Val(xy1))~Fecha(FBN['FechaOrden'])) 
    Endif
    SCN(xy1,2)    
    If Eqstr(fbn('TipoCartera'),'PorCuenta')
       ACT(a:Val(xy1), 'Hora de la Orden del Cliente: '~FBN['HoraOrden'])
       SCN(xy1,2)
    Endif
    ACT(a:Val(xy1),'Fecha Concertacion:  '~Fecha(FBN['FechaOp']))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Hora de Concertacion:  ')
    IF NoVacio(fbn('FechaAltaMAE'))
       ACT(a:Val(xy1), Val(a:Val(xy1))~Hora(fbn['FechaAltaMAE']))
    ELSE
       ACT(a:Val(xy1), Val(a:Val(xy1))~HORA(FBN['FechaCarga']))
    ENDIF
    SCN(xy1,2)
* FJL 25/10/20 - Issue 4603 - Fecha post-diferimiento
*    ACT(a:Val(xy1),'Fecha Liquidacion: '~Fecha(FBN['FechaVto']))
    if fbn('FechaPago')>0
      ACT(a:Val(xy1),'Fecha Liquidacion: '~Fecha(FBN['FechaPago']))
    else
      ACT(a:Val(xy1),'Fecha Liquidacion: '~Fecha(FBN['FechaVto']))
    endif
    SCN(xy1,2)
    ACT(a:Val(xy1),'ISIN: '~FBN['ISIN'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Codigo CV: '~FSTR(FBN['CodNumCajaValores'],1,0))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Cantidad: '~PYC(FBN['Cantidad'],0,2))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Precio: '~FSTR(FBN['Precio1'],0,8))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Monto Bruto: '~FBN['ContraEspecie']~' '~PYC(FBN['TotalBrutoCli1'],0,2))
    SCN(xy1,2)
    ACT(a:Val(xy1),FBN['ContraEspecie']~' = '~FBN['NomContra'])
    If (Incluido(FBN['MercadoMon'],VAR('MERMCMEP')) o Incluido(FBN['MercadoMon'],VAR('MERCBCRA')) ) y Novacio(FBN['NomContraMEP'])
       ACT(a:Val(xy1),FBN['ContraEspecie']~' = '~FBN['NomContraMEP'])
    Endif
    SCN(xy1,2)
    ** Verificar cuando este comisiones en que moneda liquida y convertir si es necesario
    If FBN['TotalComisiones']<>0
       ACT(a:Val(xy1),'Aranceles,derechos,comisiones e impuestos: '~VAR('MONELOCA')~' '~PYC(FBN['TotalComisiones'],0,2))
       SCN(xy1,2)
    Endif
    ACT(a:Val(xy1),'ML Sec Code = '~' '~FBN['MLCode'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Camara compensadora = '~FBN['MercadoEsp'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Liquidacion = '~val(ba:fac))
 Else
    * Inglés
    ACT(a:Val(xy1),'We hereby confirm that we have '~Val(z11)~' you '~Val(z14)~' securities detailed below:')
    SCN(xy1,3)
    ACT(a:Val(xy1),'Bond/Security: '~FBN['Especie']~' - '~FBN['NomEsp'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Client Order Date:  ')
    If Vacio(FBN['FechaOrden'])
       ACT(xy10,Pad0(Fstr(Mes(FBN['FechaCarga']),0,0),2)~'/'~Pad0(Fstr(Dia(FBN['FechaCarga']),2,0),2)~'/'~Pad0(Fstr(Anio(FBN['FechaCarga']),4,0),4)) 
       ACT(a:Val(xy1), Val(a:Val(xy1))~Val(xy10)) 
    Else
       ACT(xy10,Pad0(Fstr(Mes(FBN['FechaOrden']),0,0),2)~'/'~Pad0(Fstr(Dia(FBN['FechaOrden']),2,0),2)~'/'~Pad0(Fstr(Anio(FBN['FechaOrden']),4,0),4)) 
       ACT(a:Val(xy1), Val(a:Val(xy1))~Val(xy10)) 
    Endif
    SCN(xy1,2)    
    If Eqstr(fbn('TipoCartera'),'PorCuenta')
       ACT(a:Val(xy1), 'Client Order Time: '~FBN['HoraOrden'])
       SCN(xy1,2)
    Endif
    ACT(xy10,Pad0(Fstr(Mes(FBN['FechaOp']),0,0),2)~'/'~Pad0(Fstr(Dia(FBN['FechaOp']),2,0),2)~'/'~Pad0(Fstr(Anio(FBN['FechaOp']),4,0),4)) 
    ACT(a:Val(xy1),'Trade Date:  '~Val(xy10))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Trade Time:  ')
    IF NoVacio(fbn('FechaAltaMAE'))
       ACT(a:Val(xy1), Val(a:Val(xy1))~Hora(fbn['FechaAltaMAE']))
    ELSE
       ACT(a:Val(xy1), Val(a:Val(xy1))~HORA(FBN['FechaCarga']))
    ENDIF
    SCN(xy1,2)
* FJL 25/10/20 - Issue 4603 - Fecha post-diferimiento
*    ACT(xy10,Pad0(Fstr(Mes(FBN['FechaVto']),0,0),2)~'/'~Pad0(Fstr(Dia(FBN['FechaVto']),2,0),2)~'/'~Pad0(Fstr(Anio(FBN['FechaVto']),4,0),4)) 
    if fbn('FechaPago')>0
      ACT(xy10,Pad0(Fstr(Mes(FBN['FechaPago']),0,0),2)~'/'~Pad0(Fstr(Dia(FBN['FechaPago']),2,0),2)~'/'~Pad0(Fstr(Anio(FBN['FechaPago']),4,0),4)) 
    else
      ACT(xy10,Pad0(Fstr(Mes(FBN['FechaVto']),0,0),2)~'/'~Pad0(Fstr(Dia(FBN['FechaVto']),2,0),2)~'/'~Pad0(Fstr(Anio(FBN['FechaVto']),4,0),4)) 
    endif
    ACT(a:Val(xy1),'Settlement Date: '~Val(xy10))
    SCN(xy1,2)
    ACT(a:Val(xy1),'ISIN: '~FBN['ISIN'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'CV Code: '~FSTR(FBN['CodNumCajaValores'],1,0))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Quantity: '~PYC(FBN['Cantidad'],0,2))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Price: '~FSTR(FBN['Precio1'],0,8))
    SCN(xy1,2)
    ACT(a:Val(xy1),'Gross Amount: '~FBN['ContraEspecie']~' '~PYC(FBN['TotalBrutoCli1'],0,2))
    SCN(xy1,2)
    ACT(a:Val(xy1),FBN['ContraEspecie']~' = '~FBN['NomContra'])
    If EqStr(FBN['MercadoMon'],VAR('MERMCMEP')) y Novacio(FBN['NomContraMEP'])
       ACT(a:Val(xy1),FBN['ContraEspecie']~' = '~FBN['NomContraMEP'])
    Endif
    SCN(xy1,2)
    ** Verificar cuando este comisiones en que moneda liquida y convertir si es necesario
    If FBN['TotalComisiones']<>0
       ACT(a:Val(xy1),'Tariffs,duties,fees and taxes: '~VAR('MONELOCA')~' '~PYC(FBN['TotalComisiones'],0,2))
       SCN(xy1,2)
    Endif
    ACT(a:Val(xy1),'ML Sec Code = '~' '~FBN['MLCode'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Clearing House = '~FBN['MercadoEsp'])
    SCN(xy1,2)
    ACT(a:Val(xy1),'Settlement = '~val(ba:fac))
  Endif
  
  ACN(xy2,56)
  ACT(a:Val(xy2), '_____________________________________________________________________________________________________'  )
  
  Setfont(a:11..a:12, 1) 
  Setfont(a:13..a:Val(xy2)-1, 7)    
  Setfont(a:Val(xy2), 4)  

  SCN(xy2,1)
  ACN(xy1,Val(xy2))
  ACT(a:Val(xy2), Val(vh:3))
  ACT(b:Val(xy2), 'Agente ALyC y AN PROPIO')  

  SCN(xy2,1)
  ACT(a:Val(xy2), Val(vh:7))
   ACT(b:Val(xy2), 'Registro bajo el Nº'~Val(vh:4)~' de la CNV')

  SCN(xy2,1)
  ACT(a:Val(xy2), Val(vh:5)~' - '~Val(vh:6))
  ACT(b:Val(xy2), '')  

  SCN(xy2,1)
  ACT(a:Val(xy2), Val(vh:2))
  ACT(b:Val(xy2), 'BofA Securities es una marca utilizada')

  SCN(xy2,1)
  ACT(a:Val(xy2), 'T '~Val(vh:8))
  ACT(b:Val(xy2), 'por '~Val(vh:3))  

  SCN(xy2,1)
  ACT(a:Val(xy2), 'F '~Val(vh:9))
  ACT(b:Val(xy2), '')  

  AlinearCeldas(b:Val(xy1)..b:Val(xy2),'D')
  
Proximo

ACO(1, 50)
ACO(2, 25)

* La Asignacion del nombre del archivo para generar PDF debe estar previo a la definicion de LimiteVision
IF Dialogo.Radio1=0
   act(ar:1,VAR('PATHCONFI')~'Confirmacion_Cliente_'~Val(cu:1)~'_'~Val(op:1)~'SP.pdf')
Else
   act(ar:1,VAR('PATHCONFI')~'Confirmacion_Cliente_'~Val(cu:1)~'_'~Val(op:1)~'EN.pdf')
Endif


SetPrintFit(3,98)
*SetPrintFit(1)
Impresion(1)
Impresion(2,0)
Impresion(3,0)
Impresion(4,0)
SetMargins(1,0,0,0)
LimitesVision(b:Val(xy2))

if val(cr:1)>0 o SI
   If Dialogo.Radio2 = 0
      ImprimirHoja(SI)
   Else
      If Dialogo.Radio2 = 2
         HojaVisible(NO)
         BorrarArchivo(val(ar:1))
         ExportarPdf(val(ar:1))
      endif
   Endif 
Else
   HojaVisible(NO)
Endif