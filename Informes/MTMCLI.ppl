            ifa
            ACT(A:FAC,FBN['Cliente1'])
            SetFont(a:FAC..a:FAC,2)
            IFA
        endif   
    endif
    if Not Eqstr(Val(me:11),FBN['Cliente1']~FBN['Mercado']) 
       if Eqstr(Val(cl:1),FBN['Cliente1']) 
          ACT(B:FAC,'Total '~Val(ME:1))
          ACL(B:FAC,'MTMDCL', Fecha1=Dialogo.Fecha1, Cliente1=Val(CL:1), Mercado1=Val(ME:1), Especie1=Val(ES:1)) 
          ACN(F:FAC,Val(me:2))
          ACN(G:FAC,Val(me:3))
          ACN(H:FAC,Val(me:4))
          ACN(I:FAC,Val(me:5))
          AgregarMarco(B:FAC..I:FAC,0,0)
          SetFont(B:FAC..I:FAC,2)
          ACN(me:2,0)
          ACN(me:3,0)
          ACN(me:4,0)
          ACN(me:5,0)
          IFA
          IFA
       endif          
    
       ACT(B:FAC,FBN['Mercado'])
       SetFont(b:FAC..b:FAC,2)
       IFA
    endif                    
    
    if Eqstr(val(c:fac-1),FBN['Especie']) y Eqstr(val(me:11),FBN['Cliente1']~FBN['Mercado']) 
       dfa
    endif   
    ACT(C:FAC,FBN['Especie'])
    SCN(F:FAC,FBN['ValorMTM'])
    SCN(G:FAC,FBN['AcumuladoMTM'])
    SCN(H:FAC,FBN['ValorMTMEspecie'])
    SCN(I:FAC,FBN['AcuMTMEspecie'])
    If Incluido(Fbn['TipoOp'],('TICF|FXCF'))
       SCN(D:FAC,FBN['Cantidad'])
    Else
       SCN(E:FAC,FBN['Cantidad'])
    EndIf
    ACT(CL:1,FBN['Cliente1'])
    ACT(ME:1,FBN['Mercado'])
    ACT(ME:11,FBN['Cliente1']~FBN['Mercado'])
    ACT(ES:1,FBN['Especie'])
    ACT(ES:11,FBN['Cliente1']~FBN['Mercado']~FBN['Especie'])

    SCN(me:2,FBN['ValorMTM'])
    SCN(me:3,FBN['AcumuladoMTM'])
    SCN(me:4,FBN['ValorMTMEspecie'])
    SCN(me:5,FBN['AcuMTMEspecie'])

    SCN(cl:2,FBN['ValorMTM'])
    SCN(cl:3,FBN['AcumuladoMTM'])
    SCN(cl:4,FBN['ValorMTMEspecie'])
    SCN(cl:5,FBN['AcuMTMEspecie'])
    
    SCN(TO:2,FBN['ValorMTM'])
    SCN(TO:3,FBN['AcumuladoMTM'])
    SCN(TO:4,FBN['ValorMTMEspecie'])
    SCN(TO:5,FBN['AcuMTMEspecie'])
