CrearDialogo
  Fecha1:   'Fecha'    ;1;1;;;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1>0;'Fecha invalida';NO;FSys;
  Cliente1: 'Cliente'  ;2;1;;;;
  Mercado1: 'Mercado'  ;3;1;;;;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

ACT(A:4,'Calculo de MTM por Cliente')
SetFont(A:4,1)

SetFilaActual(6)

ACT(A:FAC,'Fecha: '~Dialogo.Fecha1)
If NoVacio(Dialogo.Cliente1)
   ACT(A:FAC+1,'Cliente: '~Dialogo.Cliente1)
Else
   ACT(A:FAC+1,'Cliente: Todos')
EndIf
If NoVacio(Dialogo.Mercado1)
   ACT(A:FAC+2,'Origen: '~Dialogo.Mercado1)
Else
   ACT(A:FAC+2,'Origen: Todos')
EndIf

SetFont(A:FAC..A:FAC+2,2)

SetFilaActual(FAC+4)

ACT(A:FAC,'Cliente')
ACT(B:FAC,'Operatoria')
ACT(C:FAC,'Especie')
ACT(D:FAC,'Compras')
ACT(E:FAC,'Ventas')
ACT(F:FAC,'Valor MTM')
ACT(G:FAC,'Acumulado MTM')
ACT(H:FAC,'Valor MTM Especie')
ACT(I:FAC,'Acum. MTM Especie')
AlinearCeldas(A:FAC..I:FAC,'C')
AgregarMarco(A:FAC..I:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..I:FAC,2)
SQL.ADD(" Select O.Cliente1, O.Mercado4 Mercado, O.Especie, O.TipoOp, SUM(O.Cantidad) Cantidad, ")
SQL.ADD(" (Select SUM(M1.MTM) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and O1.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and O1.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"') ValorMTM, ")
SQL.ADD(" (Select SUM(M1.MTMEspecie) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and O1.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and O1.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"') ValorMTMEspecie, ")
SQL.ADD(" (Select SUM(M1.MTM) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"'and O1.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and O1.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"') AcumuladoMTM, ")
SQL.ADD(" (Select SUM(M1.MTMEspecie) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"'and O1.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' and O1.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"') AcuMTMEspecie ")
SQL.ADD("   From "~DBO~".OPERACIONES O   ")
SQL.ADD("  Where O.TipoOp in ('TICF','TIVF','FXCF','FXVF')     ")
SQL.ADD("    And O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'       ")
SQL.ADD("    And O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'       ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" And O.Cliente1= '"~Dialogo.Cliente1~"'           ")
EndIf
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" And O.Mercado4= '"~Dialogo.Mercado1~"'            ")
EndIf
SQL.ADD(" Group By O.Cliente1, O.Mercado4, O.Especie, O.TipoOp ")
SQL.ADD(" Order By O.Cliente1, O.Mercado4, O.Especie, O.TipoOp ")
watch(SQL.BATCH())
ACN(Z:1,FAC+1)
act(cl:1,'*')
act(me:11,'*')
act(es:11,'*')
Recorrer SQL
    if Not Eqstr(Val(cl:1),FBN['Cliente1']) 
