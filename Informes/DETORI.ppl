CrearDialogo
  Fecha1: 'Fecha';;;;;;;;;PriDeMes(FSys)
  Book1: 'Book'
  Especie1: 'Especie'
  Vehiculo1: 'Vehiculo'
  Especie2: 'Moneda Expr.'
FinDialogo

if not OK
  Cancelar
endif

SetFilaActual(1)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

ACT(B:fac, '               Detalle Ordenes de Inversion ')
SetFont(B:fac, 3)
SetFilaActual(fac+2)
ACN(FI:1, fac)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
ifa
ACT(A:fac, 'Book: '~Dialogo.Book1)
ifa
ACT(A:fac, 'Moneda: '~Dialogo.Especie1)
SetFont(A:Val(FI:1)..A:fac, 1)
SetFilaActual(fac+2)

ACT(A:fac, 'Operacion')
ACT(B:fac, 'TipoOp')
ACT(C:fac, 'Fecha')
ACT(D:fac, 'Cantidad')
*ACT(E:fac+1, 'Mon.Ori')
*ACT(F:fac, 'Cantidad')
*ACT(F:fac+1, 'Mon.Expr.')
*ifa
SetFont(A:fac..D:fac, 1)
AgregarMarco(A:fac..D:fac, 0, 0, Exe('COLOR6'))
ACN(FI:1, fac+1)
SQL.ADD(" Select NrOperacion, FechaMov, Especie, Cantidad, Leyenda ")
SQL.ADD(" From "~DBO~".MOVEJECUTADOS ")
SQL.ADD(" Where EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND Book = '"~Dialogo.Book1~"' ")
SQL.ADD(" AND NrSaldo = 50 ")
SQL.ADD(" AND FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    *ACT(B:fac, BuscarCampo('OPERACIONES','TipoOp','NrOperacion', fbn('NrOperacion')))
    ACT(B:fac, fbn('Leyenda'))
    ACD(C:fac, fbn('FechaMov'))
    ACN(D:fac, fbn('cantidad'))
    SCN(SL:1, fbn('Cantidad'))
Proximo
SetFont(A:Val(FI:1)..D:fac, 2)
ifa
ACT(A:fac, 'Saldo')
ACN(D:fac, Val(SL:1))
FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
SetFont(A:fac..D:fac, 1)
AgregarMarco(A:fac..D:fac, 0, 0, Exe('COLOR6'))
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 1)
LimitesVision(E:fac+1)
ACO(2, 20)