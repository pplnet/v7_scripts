ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo1  : "Vehiculo"                          ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1     : "Fecha"                             ;  ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
   Mercado1   : "Ubicacion"                         ;  ; ;;;;Vacio(Dialogo.MERCADO1) o [NoVacio(Dialogo.MERCADO1) y NoVacio(BuscarCampo('Mercados','Codigo','Codigo',Dialogo.MERCADO1))];'Error en Ubicacion';NO;;;
   Sucursal1  : "Sucursal"                          ; 3;2;
   Radio2     : "Moneda|Pesos|Dolares"              ; 4;1;;;;;;;0;
   Lista4     : "Estados"                           ;  ; ;;;;;;;;;SQLSet("SELECT Descripcion FROM "~DBO~".ESTADOSCUSTODIA WHERE Habilitado <> 'NO' ORDER BY NrSaldo ASC ");SI
   Lista1     : "Especies"                          ;-1;2;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");SI
   ListaTabla1: 'Clientes'                          ;  ;1;;;;;;;;;;;;;'Codigo' ; 'Codigo;RazonSocial' ; 'vCLIENTES01'
   Lista2     : "Excluye Especies"                  ;-6;2;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");SI
FinDialogo

IF Not Ok
   Cancelar
ENDIF

IF Vacio(Dialogo.Lista1) 
   IF MessageBox('Selecciono todas las Especies, #Continua?',0,2) = 7
      Cancelar
   ENDIF
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(xz1, Hora(Ahora))

SQL.ADD("SELECT S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, CU.NrDepositante, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion DescEst, ")
SQL.ADD("       EC.Codigo,SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, C.Sucursal ")
SQL.ADD("FROM   "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".ESTADOSCUSTODIA EC, ")
SQL.ADD(        DBO~".CUENTAS CU ")
SQL.ADD("WHERE  S1.Cliente = C.Codigo AND ")
SQL.ADD("       CU.Codigo = S1.Cuenta AND ")
SQL.ADD("       (C.CategDepositante = 'CLI' OR C.Alias1='CP') AND ")
IF NoVacio(Dialogo.Sucursal1)
   SQL.ADD("    C.Sucursal='"~Dialogo.Sucursal1~"' AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD("       S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") AND ")
ENDIF
SQL.ADD("       E.Codigo = S1.Especie AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("       S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("       S1.Especie Not IN ("~Pipe2Comillas(Dialogo.Lista2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista4)
   SQL.ADD("   EC.Descripcion IN ("~Pipe2Comillas(Dialogo.Lista4)~") AND ")
ENDIF
SQL.ADD("       S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("       S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
SQL.ADD("       ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) and ")
SQL.ADD("       (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
SQL.ADD("       S1.Saldo <> 0 AND ")
SQL.ADD("       S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                   FROM   "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                   WHERE  S2.Cliente = S1.Cliente AND ")
SQL.ADD("                          S2.Especie = S1.Especie AND ")
SQL.ADD("                          S2.Cupon = S1.Cupon AND ")
SQL.ADD("                          S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                          S2.Mercado = S1.Mercado AND ")
SQL.ADD("                          S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                          S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                          S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, CU.NrDepositante, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion, EC.Codigo,E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, C.Sucursal ")
SQL.ADD("ORDER BY S1.Especie, S1.Cupon, S1.Mercado, S1.Cliente, S1.Cuenta, CU.NrDepositante, S1.NrSaldo, C.Sucursal ")

ACT(g1, 'Saldo de Especies y Clientes')
ACD(g2, Dialogo.Fecha1)

SetFont(g1..g2,3)
AlinearCeldas(g1..g2,'C')

ACT(k4, 'Fecha: '~IdxDate(Fsys))
ACT(a5, 'Moneda: '~IIF(Dialogo.Radio2=0, 'Pesos','Dolares'))
IF NoVacio(Dialogo.Mercado1)
   ACT(a6, "Ubicacion: "~Dialogo.Mercado1)
ELSE
   ACT(a6, "Ubicacion: Todos ")
ENDIF
If NoVacio(Dialogo.ListaTabla1)
   ACT(a7, "Clientes: "~Dialogo.ListaTabla1)
Else
   ACT(a7, "Clientes: Todos ")
EndIf
If NoVacio(Dialogo.Lista1)
   ACT(a8, "Especies: "~Dialogo.Lista1)
Else
   ACT(a8, "Especies: Todas ")
EndIf
If NoVacio(Dialogo.Lista2)
   ACT(a9, "Excluye Especies: "~Dialogo.Lista2)
Else
   ACT(a9, "Excluye Especies: Ninguna ")
EndIf
If NoVacio(Dialogo.Lista4)
   ACT(a10, "Estados: "~Dialogo.Lista4)
Else
   ACT(a10, "Estados: Todos ")
EndIf

SetFont(a4..k10,2)

SetFilaActual(12)

ACT(a:fac, 'Especie')
ACT(b:fac, 'Cupon')
ACT(c:fac, 'Ubic.')
ACT(d:fac, 'Cliente')
ACT(e:fac, 'Nombre Cliente')
ACT(f:fac, 'Sucursal')
ACT(g:fac, 'Cuenta')
ACT(h:fac, 'Comitente')
ACT(i:fac, 'Estado')
ACT(j:fac, 'V.N.')
ACT(k:fac, 'V.R.')
ACT(l:fac, 'Valuacion')
AlinearCeldas(j:fac..l:fac,'D')

ACO(1, 15)
ACO(2, 5)
ACO(3, 5)
ACO(4, 8)
ACO(5, 20)
ACO(6, 8)
ACO(7, 8)
ACO(8, 8)
ACO(9,10)
ACO(10,10)
ACO(11,10)

SetFont(a:fac..l:fac,2)
AgregarMarco(a:fac..l:fac,0,0,Exe('COLOR8'))

Recorrer SQL
   ACT(a:fac, FBN['Especie']~'-'~FBN['Nombre'])
   ACT(b:fac, FBN['Cupon'])
   ACT(c:fac, FBN['Mercado'])
   ACT(d:fac, FBN['Cliente'])
   ACT(e:fac, Copy(FBN['RazonSocial'],1,25))
   ACT(f:fac, FBN['Sucursal'])
   ACT(g:fac, FBN['Cuenta'])
   ACT(h:fac, FBN['NrDepositante'])
   ACT(i:fac, FBN['DescEst'])
   SetFont(a:fac..h:fac,2)
 
   *- VN
   ACN(j:fac, FBN['Saldo'])

   ACN(vr2,FBN['Alias5'])

   *- Parametros para la funcion INTERESCLE 
   *- (yu:fac..yz:FAC)
   ACN(yt1, FAC)
   ACD(yu:FAC, Dialogo.Fecha1)
   ACT(yv:FAC, FBN['Especie'])
   ACN(yw:FAC, FBN['Saldo'])
   ACD(yx:FAC, FBN['FechaCambioTasa'])
   ACN(yy:FAC, FBN['TasaIntAnterior'])
   ACN(yz:FAC, FBN['TasaIntVigente'])
   (.'INTERESCLE'.)

   ACN(ca:FAC, Val(zz:FAC))

   ACN(cb:FAC, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))

   If Dialogo.Radio2 = 0
      ACN(cc:FAC, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   Else
      ACN(cc:FAC, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   Endif

   *- VR
   ACN(k:FAC, Round(Val(j:FAC)*Val(cb:FAC),val(vr2)) )

   *- Valuacion
   If EqStr(FBN['InteresesC'],'CLE')
      If Incluido(Val(al4), '1585')
         ACN(l:FAC, Val(k:FAC)*Val(cc:FAC)+(Val(ca:FAC)*Val(cc:FAC)) ) 
      Else
         ACN(l:FAC, Val(k:FAC)*Val(cc:FAC)+Val(ca:FAC) )
      Endif
   Else
      ACN(l:FAC, Val(j:FAC)*Val(cc:FAC)+Val(ca:FAC) )
   Endif
   SetFont(j:FAC..l:FAC, 1)
   FormatoCeldas(j:FAC,Exe('F2'))
   FormatoCeldas(k:FAC,Exe('F8'))
   FormatoCeldas(l:FAC,Exe('F2'))
Proximo

IFA
IFA

ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC, 2)
IFA
IFA

SetMargins(0,1,0,2)
LimitesVision(l:FAC)
Impresion(1,1)
SetPrintFit(3,61)
RangoTitulo(a:1..l:FAC, 12)