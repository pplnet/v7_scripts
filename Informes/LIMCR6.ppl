MostrarCuadroDeMensajes
CrearDialogo
   Fecha1   : 'Fecha '  ;;;;;;Dialogo.Fecha1>=FSys-4;'La fecha debe ser menor o igual a la fecha actual';NO;FSys
   Cliente1 : 'Cliente' ;;;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

ACT(a4, 'Limites de Credito')
ACT(a5, 'Fecha:   '~Fecha(Dialogo.Fecha1))

If NoVacio(Dialogo.Cliente1)
   ACT(a6, 'Cliente: '~Dialogo.Cliente1)
EndIf

ACT(a7, 'Entidad')

** Fechas Futuro para limites consumidos **
ACD(fe1,Habiles(Dialogo.Fecha1,1,'ARG'))
ACD(fe2,Habiles(Dialogo.Fecha1,2,'ARG'))
ACD(fe3,Habiles(Dialogo.Fecha1,3,'ARG'))
ACD(fe4,Habiles(Dialogo.Fecha1,4,'ARG'))

*-- A partir de la C muestro los tipos de limites asignados
ACN(cl1,3)

** Selecciono las clases de limites de credito que existenten **
SQL.ADD(" SELECT Distinct L.Limite as Limite, T.Descripcion ")
SQL.ADD(" FROM   "~DBO~".LIMASIGNADOS L, "~DBO~".TIPOSLIMITE T ")
SQL.ADD(" WHERE  L.Limite = T.Codigo  ")
SQL.ADD(" and    T.Clase  = 'C'       ")
SQL.ADD(" AND    L.Limite LIKE 'MAX%' ")
SQL.ADD(" and   (L.Limite<>'SETTCRE' OR L.Cliente='"~VAR('VEHICULODE')~"')  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("    and L.Cliente='"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD(" UNION ")
SQL.ADD(" SELECT Distinct M.Limite as Limite, T.Descripcion ")
SQL.ADD(" FROM   "~DBO~".MOVLIMITES M, "~DBO~".TIPOSLIMITE T ")
SQL.ADD(" WHERE  M.Limite = T.Codigo ")
SQL.ADD(" and    T.Clase  = 'C'      ")
SQL.ADD(" AND    M.Limite LIKE 'MAX%' ")
SQL.ADD(" and   (M.Limite<>'SETTCRE' OR M.Cliente='"~VAR('VEHICULODE')~"')  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("    and M.Cliente='"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD("ORDER BY 1")

Recorrer SQL
  DFA
  ACT(val(cl1)  :7, FBN['Limite'])
  ACT(val(cl1)+1:7, fbn('Descripcion'))
  ACT(val(cl1)  :8, 'Asignado')
  ACT(val(cl1)+1:8, 'Consumido hoy')
  If NOT EqStr(FBN['Limite'],'VOLUMENCON')
     ACT(val(cl1)+2:8, 'Cons.'~val(fe1))
     ACT(val(cl1)+3:8, 'Cons.'~val(fe2))
     ACT(val(cl1)+4:8, 'Cons.'~val(fe3))
     ACT(val(cl1)+5:8, 'Mas de 72 hs')
     ACT(val(cl1)+6:8, 'Disponible Hoy')
  ELSE
     ACT(val(cl1)+2:8, 'Disponible Hoy')
  ENDIF

  AgregarMarco(val(cl1):7..val(cl1)+6:8,1)
  AgregarMarco(val(cl1):8..val(cl1)+6:8,1)
  If NOT EqStr(FBN['Limite'],'VOLUMENCON')
     SCN(cl1,7)
  ELSE
     SCN(cl1,3)
  ENDIF
Proximo

AgregarMarco(a7..val(cl1):7,1,0,Exe('COLOR'))
AgregarMarco(A8..val(cl1):8,1,0,Exe('COLOR6'))

SetFilaActual(8)


** Limites asignado para el cliente solicitado **
SQL.ADD(" SELECT  Distinct L.Cliente as Codigo, L.Limite ")
SQL.ADD(" FROM    "~DBO~".LIMASIGNADOS L, "~DBO~".TIPOSLIMITE T ")
SQL.ADD(" WHERE   L.Limite = T.Codigo ")
SQL.ADD(" and     T.Clase  = 'C'      ")
SQL.ADD(" AND     L.Limite LIKE 'MAX%' ")
SQL.ADD(" and    (L.Limite<>'SETTCRE' OR L.Cliente='"~VAR('VEHICULODE')~"')  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and  L.Cliente='"~Dialogo.Cliente1~"'  ")
EndIf
SQL.ADD(" and L.Monto <> 0 ")
SQL.ADD(" and L.FVencimiento = (SELECT Max(L1.FVencimiento) ")
SQL.ADD("                       FROM  "~DBO~".LIMASIGNADOS L1, "~DBO~".TIPOSLIMITE T1 ")
SQL.ADD("                       WHERE L1.Limite=T1.Codigo and T1.Clase='C'  ")
SQL.ADD("                       and   L1.Monto <> 0 ")
SQL.ADD("                       and   L1.Limite=L.Limite and L1.Cliente=L.Cliente ) ")
SQL.ADD(" UNION ")
SQL.ADD(" SELECT  Distinct M.Cliente as Codigo, M.Limite ")
SQL.ADD(" FROM    "~DBO~".MOVLIMITES M, "~DBO~".TIPOSLIMITE T ")
SQL.ADD(" WHERE  M.Limite = T.Codigo ")
SQL.ADD(" and    T.Clase  = 'C'      ")
SQL.ADD(" AND    M.Limite LIKE 'MAX%' ")
SQL.ADD(" and   (M.Limite<>'SETTCRE' OR M.Cliente='"~VAR('VEHICULODE')~"')  ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("   and M.Cliente='"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD("ORDER BY 1,2")

Recorrer SQL
  DFA
  If Not EqStr(Val(z1), FBN('Codigo'))
     ACT(z1, FBN('Codigo'))
     IFA
     ACT(a:FAC, fbn('Codigo'))
     ACT(b:FAC, BuscarCampo('CLIENTES','RazonSocial','Codigo', FBN['Codigo']))
     message(Val(b:fac))
     ACN(cl2,3)
  EndIf

  Recorrer&j 1,val(cl1) 
    If Not EqStr(FBN('Limite'),val(val(cl2):7))
       message(FBN('Limite'))
       SCN(cl2, 7)
    Endif
  Proximo

  ACN(Val(cl2):FAC, LimAsignado(fbn('Codigo'), FBN['Limite'],VAR('MONEEXTR')) )

  ACN(al1, 0)  

  If EqStr(Copy(FBN['Limite'],1,3),'MAX')
     ACN(Val(cl2)+1:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),Dialogo.Fecha1,VAR('VEHICULODE')),2))    
     ACN(Val(cl2)+2:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),Val(fe1)      ,VAR('VEHICULODE')),2))
     ACN(Val(cl2)+3:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),Val(fe2)      ,VAR('VEHICULODE')),2))
     ACN(Val(cl2)+4:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),Val(fe3)      ,VAR('VEHICULODE')),2))   

     SQL.ADD("SELECT SUM(Monto) as Total FROM "~DBO~".MOVLIMITES L1 ")
     SQL.ADD("WHERE Limite = '"~FBN['Limite']~"' ")
     SQL.ADD("and Especie  = '"~VAR('MONEEXTR')~"' and Cliente = '"~FBN['Codigo']~"' ")
     SQL.ADD("and FechaLim >="~IdxDate2(Val(fe4))~" and FechaLim <= (SELECT MAX(L2.FechaLim) ")
     SQL.ADD("FROM   "~DBO~".MOVLIMITES L2 ")
     SQL.ADD("WHERE L2.Cliente  = L1.Cliente and ")
     SQL.ADD("      L2.Limite   = L1.Limite  and ")
     SQL.ADD("      L2.Especie  = L1.Especie and ")
     SQL.ADD("      L2.FechaLim >= "~IdxDate2(Val(fe4))~" ) ")
     SQL.ADD("HAVING SUM(Monto) <> 0 ")     
     Recorrer SQL
        dfa
        SCN(Val(cl2)+5:fac, FBN['Total'])
     Proximo
  EndIf
  


  If EqStr(FBN['Limite'],'MAXROFEX')
     ACN(Val(cl2)+1:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),0,VAR('VEHICULODE')),2))    
     ACN(Val(cl2)+2:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),0,VAR('VEHICULODE')),2))
     ACN(Val(cl2)+3:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),0,VAR('VEHICULODE')),2))
     ACN(Val(cl2)+4:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),0,VAR('VEHICULODE')),2))   
     ACN(Val(cl2)+5:FAC, Round(LimConsumido(FBN('Codigo'),FBN['Limite'],VAR('MONEEXTR'),0,VAR('VEHICULODE')),2))   
  EndIf


  If NOT EqStr(FBN['Limite'],'VOLUMENCON')
     ** Disponible Hoy **
     ACN(Val(cl2)+6:fac, VAL(Val(cl2):fac) - VAL(Val(cl2)+1:fac) )
     FormatoCeldas(b9..q:fac, Exe('F2'))
  ELSE
     ** Disponible Hoy **
     ACN(Val(cl2)+2:fac, VAL(Val(cl2):fac) - VAL(Val(cl2)+1:fac) )
     FormatoCeldas(b9..q:fac, Exe('F2'))
  ENDIF

  ** Detalle de limite de credito **
  If Val(Val(cl2)+1:fac) <> 0
     AsignarLink(Val(cl2)+1:fac,'DETLIM',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),TipoLimite1=FBN['Limite'],Check1=0)
  Endif

  If NOT EqStr(FBN['Limite'],'VOLUMENCON')
     If Val(Val(cl2)+2:fac) <> 0
        AsignarLink(Val(cl2)+2:fac,'DETLIM',Fecha1=Val(fe1),Cliente1=Val(a:fac),TipoLimite1=FBN['Limite'],Check1=0)
     Endif
     If Val(Val(cl2)+3:fac) <> 0
        AsignarLink(Val(cl2)+3:fac,'DETLIM',Fecha1=Val(fe2),Cliente1=Val(a:fac),TipoLimite1=FBN['Limite'],Check1=0)
     Endif
     If Val(Val(cl2)+4:fac) <> 0
        AsignarLink(Val(cl2)+4:fac,'DETLIM',Fecha1=Val(fe3),Cliente1=Val(a:fac),TipoLimite1=FBN['Limite'],Check1=0)
     Endif
     If ABS(Val(Val(cl2)+5:fac)) <> 0
        AsignarLink(Val(cl2)+5:fac,'DETLIM',Fecha1=Val(fe4),Cliente1=Val(a:fac),TipoLimite1=FBN['Limite'],Check1=1)
     Endif
  Endif

Proximo

AgregarMarco(a9..b:fac,1)
FormatoCeldas(c9..r:fac, Exe('F2'))

ACN(cl2,3)

Recorrer&j 1,((val(cl1) -3)/3) +1
  AgregarMarco(val(cl2):9..val(cl2)+6:fac,1)
  SCN(cl2, 7)
Proximo

SetFont(a1..az:8, 1)
SetFont(a9..az:fac, 2)

ACO(1,7)
ACO(2,9)

Recorrer&j 3,val(cl2)+5
   ACO(&j,10)
Proximo
Ifa
Ifa
ACO(2,25)

ACT(a:fac,'Fin del Informe.')
SetFont(a:fac, 1)

LimitesVision(val(cl1)-1:fac)
Impresion(1,2)
RangoTitulo(a:1..Val(cl1)-1:fac, 7)

SetPrintFit(3, 67)

