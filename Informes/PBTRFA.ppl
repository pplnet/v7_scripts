GrillaVisible(NO)
CrearDialogo
  Fecha1:   'Fecha Emision' ;;;;;;;;;fsys
  NrTrans1: 'Transferencia'
FinDialogo

If Not Ok 
  Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,BU")


SQL.ADD(" SELECT /*+ RULE */ T.NrTrans, T.Cuenta1, T.Cuenta2, T.Fecha1, T.Fecha2, T.Cliente1, T.Cliente2, ")
SQL.ADD(" T.Vehiculo1, T.Vehiculo2, T.Proveedor, T.RB1, T.ConceptoPago, T.Especie, T.Cantidad1, ")
SQL.ADD(" T.Cliente3, T.CNCuentaProveedor1, C1.Numero Numero1, C2.Numero Numero2, CP.Numero Numero3, ")
SQL.ADD(" B1.RazonSocial Banco1, B1.Localidad LocalidadB1, B3.RazonSocial Banco3, V.Descripcion VehiculoN, ")
SQL.ADD(" B3.Localidad LocalidadB3,B2.RazonSocial Banco2, B2.Localidad LocalidadB2,E.Nombre, ")
SQL.ADD(" PR.Nombre ProveedorN, PR.CUIT CUITP, V2.CUIT CUITV, B2.Alias2 Alias2B2, B3.Alias2 Alias2B3, C2.CBU CBU2, CP.Alias1 CBU3 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CUENTAS C1, "~DBO~".CUENTAS C2, "~DBO~".CLIENTES B1, ")
SQL.ADD(" "~DBO~".CLIENTES B2, "~DBO~".CLIENTES B3, "~DBO~".CNCUENTASPROVEEDOR CP, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".VEHICULOS V, "~DBO~".CNPROVEEDORES PR, "~DBO~".CLIENTES V2 ")
SQL.ADD(" WHERE T.Cuenta1   = C1.Codigo ")
SQL.ADD(" AND   T.Cliente1  = B1.Codigo ")
SQL.ADD(" AND   T.Especie   = E.Codigo ")
SQL.ADD(" AND   T.Vehiculo2 *= V.Codigo  ")
SQL.ADD(" AND   T.Vehiculo2 *= V2.Codigo  ")
SQL.ADD(" AND   T.Proveedor *= PR.Codigo  ")
SQL.ADD(" AND   T.Cuenta2 *= C2.Codigo  ")
SQL.ADD(" AND   T.CNCuentaProveedor1 *= CP.Codigo  ")
SQL.ADD(" AND   T.Cliente2 *= B2.Codigo  ")
SQL.ADD(" AND   T.Cliente3 *= B3.Codigo  ")
SQL.ADD(" AND   T.NrTrans = '"~Dialogo.NrTrans1~"' ")
Recorrer SQL
  ACT(b:5, 'Senores')
  ACT(b:6, fbn('Banco1'))
  ACT(b:7, fbn('LocalidadB1'))

  ACT(g:7, 'Buenos Aires, '~FSTR(Dia(Dialogo.Fecha1),0,0)~' de '~Meses(Mes(Dialogo.Fecha1))~' de '~FSTR(Anio(Dialogo.Fecha1),0,0))

  ACT(b:9, 'De nuestra mayor consideracion:') 
  ACT(b:10, 'Por medio de la presente solicitamos se sirvan transferir con fecha valor '~FSTR(Dia(fbn('Fecha2')),0,0)~' de '~Meses(Mes(fbn('Fecha2')))~' de '~FSTR(Anio(fbn('Fecha2')),0,0))
  ACT(b:11, 'la suma de '~fbn('Nombre')~' '~PYC(fbn('Cantidad1'),0,2)~' ('~Letras(fbn('Cantidad1'),0,100)~') ' )
 
  If Eqstr(fbn('RB1'),'0')
    ACT(b:12, 'a la cuenta en el Banco Central N§ '~fbn('Alias2B2')~' del '~fbn('Banco2')~', a traves de MEP,')
    ACT(b:13, 'para ser acreditados en nuestra cuenta N§ '~fbn('Numero2')~' CBU: '~fbn('CBU2')~'.')
  Else
    ACT(b:12, 'a la cuenta en el Banco Central N§ '~IIf(Eqstr(fbn('RB1'),'1'),fbn('Alias2B3'),fbn('Alias2B2'))~' del '~IIf(Eqstr(fbn('RB1'),'1'),fbn('Banco3'),fbn('Banco2'))~', a traves de MEP, ')
    ACT(b:13, 'para ser acreditados en la cuenta N§ '~IIf(Eqstr(fbn('RB1'),'1'),fbn('Numero3')~' CBU: '~fbn('CBU3'),fbn('Numero2')~' CBU: '~fbn('CBU2'))~', ')
    ACT(b:14, 'perteneciente a '~IIF(Eqstr(fbn('RB1'),'1'), fbn('ProveedorN'),fbn('VehiculoN'))~' (CUIT: '~IIF(Eqstr(fbn('RB1'),'1'),fbn('CUITP'),fbn('CUITV'))~').')
  Endif

  ACT(b:15, 'Asimismo solicitamos se sirvan debitar con fecha valor '~FSTR(Dia(fbn('Fecha2')),0,0)~' de '~Meses(Mes(fbn('Fecha2')))~' de '~FSTR(Anio(fbn('Fecha2')),0,0))
  ACT(b:16, ' nuestra cuenta N§ '~fbn('Numero1')~' por el mencionado importe.')

  ACT(b:18, 'Sin otro particular saludamos a ustedes muy atentamente.')

  SetFilaACtual(20)

  SaltarHoja

  IFA
  IFA
  IFA
  IFA
  ACN(fi:1,fac)
  ACT(b:fac, 'Senores')
  ifa
  If Eqstr(fbn('RB1'),'1')
    ACT(b:fac, fbn('Banco3'))
    ifa
    ACT(b:fac, fbn('LocalidadB3'))
  Else
    ACT(b:fac, fbn('Banco2'))
    ifa
    ACT(b:fac, fbn('LocalidadB2'))
  Endif
  ACN(fi:2,fac)
  ACT(g:fac, 'Buenos Aires, '~FSTR(Dia(Dialogo.Fecha1),0,0)~' de '~Meses(Mes(Dialogo.Fecha1))~' de '~FSTR(Anio(Dialogo.Fecha1),0,0))
  ifa
  ifa
  ACT(b:fac, 'De nuestra mayor consideracion:') 
  ifa
  ACT(b:fac, 'Por medio de la presente les informamos que con fecha valor '~FSTR(Dia(fbn('Fecha2')),0,0)~' de '~Meses(Mes(fbn('Fecha2')))~' de '~FSTR(Anio(fbn('Fecha2')),0,0))
  ifa
  ACT(b:fac, 'hemos transferido la suma de '~fbn('Nombre')~' '~PYC(fbn('Cantidad1'),0,2)~' ('~Letras(fbn('Cantidad1'),0,100)~') ' )
  ifa
  ACT(b:fac, 'a vuestra cuenta N§ '~iif(Incluido(fbn('RB1'),'0|2'),fbn('Alias2B2'),fbn('Alias2B3'))~' en el Banco Central de la Republica Argentina, a traves de MEP, ')
  ifa
  ACT(b:fac, 'por medio del '~fbn('Banco1')~' de '~fbn('LocalidadB1')~'. ' )
  ifa
  If Eqstr(fbn('RB1'),'0')
    ACT(b:fac, 'Asimismo solicitamos se sirvan acreditar los mencionados '~fbn('Nombre')~' en nuestra cuenta N§ '~fbn('Numero2'))
  Else
    ACT(b:fac, 'Asimismo solicitamos se sirvan acreditar los mencionados '~fbn('Nombre')~' en la cuenta N§ '~ IIf(Eqstr(fbn('RB1'),'1'),fbn('Numero3'),fbn('Numero2'))~', ')
    ifa
    ACT(b:fac, 'perteneciente a '~IIF(Eqstr(fbn('RB1'),'1'), fbn('ProveedorN'),fbn('VehiculoN'))~' (CUIT: '~IIF(Eqstr(fbn('RB1'),'1'),fbn('CUITP'),fbn('CUITV'))~').')
  Endif

  ifa
  ifa
  ACT(b:fac, 'Sin otro particular saludamos a ustedes muy atentamente.')
Proximo

SetFont(a:1..z:fac+2,1)
SetFont(a:1..b:7,2)
SetFont(b:7,3)
SetFont(a:Val(fi:1)..b:Val(fi:2),2)
SetFont(b:Val(fi:2),3)

LimitesVision(l:fac+2)