*ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : 'Grupo'                   ; 1;1;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : 'Vehiculos'               ; 2;1;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Lista2     : 'Tipos Book'              ; 3;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".TIPOSBOOK");
  Lista3     : 'Books'                   ;-3;2;;;;;;;;;iif(Vacio(Dialogo.Lista2),SQLSET("Select Codigo From "~DBO~".BOOKS"),SQLSET("Select Codigo From "~DBO~".BOOKS where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "));
  Fecha1     : 'Fecha'                   ;-2;1;;  ;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Especie1   : 'Especie'                 ;-1;1;;  ;;NoVacio(Dialogo.Especie1) y Incluido(Dialogo.Especie1,'ARP|USD');'La especie debe ser ARP o USD';NO;
  Radio1     : 'Expresado|Pesos|Dolares' ; 0;1;;  ;;;;;0;
  Radio2     : 'Tipo Op|Todas|PF|Rem'    ; 1;1;;  ;;;;;0;
  Check1     : 'Link'                    ; 2;1;;NO;;;;;0;
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
  ACT(r:1,Dialogo.Lista1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(r:1, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  EndIf
EndIf

if Dialogo.Radio1=0
  ACT(r:2, 'ARP')
else
  ACT(r:2, 'USD')
endif

If NoVacio(Dialogo.Lista2)
  If NoVacio(Dialogo.Lista3)
    ACT(r:3, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  else
    ACT(r:3, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "))
  endif
Else
  If NoVacio(Dialogo.Lista3)
    ACT(r:3, SQLSET("Select Codigo From "~DBO~".BOOKS Where Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  EndIf
EndIf

ACN(r:4, 0)
ACN(r:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
if Val(r:4)=0
  ACN(r:5, 1)
else
  ACN(r:5, VAR('MESINIEJE'))
endif
if Val(r:5)<1 or Val(r:5)>12
  ACN(r:5, 1)
endif
if Mes(Dialogo.Fecha1)>=Val(r:5)
  ACT(r:6, '01/'~Pad0(FStr(Val(r:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1),4,0))
else
  ACT(r:6, '01/'~Pad0(FStr(Val(r:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1)-1,4,0))
endif
ACD(r:7, Fecha(Val(r:6)))

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)
SetFilaActual(FAC+3)

ACT(i:2,'Fecha : '~Var('FECHASYS'))
SetFont(i:2..i:2,1)

ACT(a:FAC, "Calculo TIR Time Deposits Reporte de Cartera")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

if NoVacio(Dialogo.Vehiculo2)
  ACT(a:FAC, 'Grupo :')
  ACT(b:FAC, Pipe2Comillas(Dialogo.Vehiculo2))
else
  if NoVacio(Dialogo.Lista1)
    ACT(a:FAC, 'Vehiculo/s :') 
    ACT(b:FAC, Dialogo.Lista1) 
  else 
    ACT(a:FAC, 'Vehiculos :')
    ACT(b:FAC, 'Todos')
  endif
endif

ACT(a:FAC+1, 'Especies :')
ACT(b:FAC+1, Dialogo.Especie1)

*ACT(a:FAC+2, 'Books :')
*if NoVacio(Val(r:3))
*  ACT(b:FAC+2, Val(r:3))
*else
*  ACT(b:FAC+2, 'Todos')
*endif
ACT(a:FAC+2, 'Tipos Book :')
If NoVacio(Dialogo.Lista2)
  ACT(b:FAC+2, Dialogo.Lista2)
else
  ACT(b:FAC+2, 'Todos')
endif
ACT(a:FAC+3, 'Books:')
if NoVacio(Dialogo.Lista3)
  ACT(b:FAC+3, Dialogo.Lista3)
else
  ACT(b:FAC+3, 'Todos')
endif

ACT(a:FAC+4, 'Expresado en :')
ACT(b:FAC+4, IIF(Dialogo.Radio1=0,'Pesos','Dolares'))

ACT(a:FAC+5, 'Fecha :')
ACT(b:FAC+5, Dialogo.Fecha1)

ACT(a:FAC+6, 'Tipo Op :')
ACT(b:FAC+6, iif(Dialogo.Radio2=0,'P.Fijos y Remuneradas',iif(Dialogo.Radio2=1,'P.Fijos','Remuneradas')))
SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Vehiculo')
ACT(c:FAC, 'Book')
ACT(d:FAC, 'Especie')
ACT(e:FAC, '# Oper.')
ACT(f:FAC, 'Concepto')
ACT(g:FAC, 'Importe')

ACT(k:FAC, 'Fecha Num')
ACT(l:FAC, '# Oper.')
ACT(m:FAC, 'Tipo Op.')
ACT(n:FAC, 'Linea Ini')
ACT(o:FAC, 'Cant.Vtos')

SetFont(a:FAC..s:FAC,2)
AgregarMarco(a:FAC..g:FAC,1,2,Exe('COLOR'))

ACN(w1, FAC)

SQL.ADD("Select O.NrOperacion, O.TipoOp,   O.Especie,        O.FechaOp,  ")
SQL.ADD("       O.FechaVto,    O.Cantidad, O.TotalBrutoCli1, O.Cliente1, ")
SQL.ADD("       O.Vehiculo1,   O.Book1, ")
SQL.ADD("       CASE O.Especie When 'ARP'   Then '0' Else '1' End Tipo1, ")
SQL.ADD("       CASE O.TipoOp  When 'MMCPM' Then '0' Else '1' End Tipo2, ")
SQL.ADD("       '0' Tipo3 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".BOOKS B ")
SQL.ADD(" where O.FechaOp   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaVto  >  '"~IdxDate(Val(r:7))~"' ")
SQL.ADD("   and O.Book1     =  B.Codigo ")
if Dialogo.Radio2=0
  SQL.ADD("   and O.TipoOp    In ('MMCPM','MMCCR') ")
else
  if Dialogo.Radio2=1
    SQL.ADD(" and O.TipoOp  = 'MMCPM' ")
  else
    SQL.ADD(" and O.TipoOp  = 'MMCCR' ")
  endif
endif
SQL.ADD("     and O.Especie   = '"~Dialogo.Especie1~"' ")
If NoVacio(Dialogo.Lista1)
  SQL.ADD("   and O.Vehiculo1 in ("~Pipe2Comillas(val(r:1))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD(" and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
endif
*if NoVacio(Val(r:3))
*  SQL.ADD("    and Book1     in ("~Pipe2Comillas(val(r:3))~") ")
*endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD("  and B.TipoBook             in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD("  and B.Codigo               in ("~Pipe2Comillas(Dialogo.Lista3)~") ")
endif
SQL.ADD(" order by Tipo1, Tipo2, Tipo3, NrOperacion ")

recorrer SQL
  ACT(aa:FAC, fbn('NrOperacion'))
  ACT(ab:FAC, fbn('TipoOp'))
  ACT(ac:FAC, fbn('Especie'))
  ACD(ad:FAC, fbn('FechaOp'))
  ACD(ae:FAC, fbn('FechaVto'))
  ACN(af:FAC, fbn('Cantidad'))

  ACT(b:FAC, fbn('Vehiculo1'))
  ACT(c:FAC, fbn('Book1'))
  ACT(d:FAC, fbn('Especie'))
  ACT(e:FAC, fbn('NrOperacion'))

  if fbn('FechaOp')<Val(r:7)
    * Empezo en el ejercicio anterior
    ACD(a:FAC, Val(r:7))
    ACN(k:FAC, Val(r:7))
    ACT(f:FAC, 'NTV Inicio Ejercicio')
    LinkearHoja('RCAR03',1,Fecha1=Val(r:7),NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
    ACN(n:FAC, LinkH(1,az:6))
    ACN(o:FAC, LinkH(1,az:7))
    ACN(g:FAC, -LinkH(1,k:Val(n:FAC)))
    CerrarHoja('RCAR03',1,Fecha1=Val(r:7),NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
  else
    * Empezo en este ejercicio
    ACD(a:FAC, fbn('FechaOp'))
    ACN(k:FAC, fbn('FechaOp'))
    ACT(f:FAC, 'Desembolso Inicial')
    ACN(g:FAC, -fbn('Cantidad')*CotizacionC(Val(d:FAC),,,,fbn('FechaOp')-1,1,SI,Val(r:2)))
  endif

  if EqStr(fbn('TipoOp'),'MMCCR')
    if fbn('FechaVto')<=Dialogo.Fecha1
      IFA
      ACT(aa:FAC, fbn('NrOperacion'))
      ACT(ab:FAC, fbn('TipoOp'))
      ACD(ae:FAC, fbn('FechaVto'))
      ACN(af:FAC, fbn('TotalBrutoCli1'))
      ACD(a:FAC, fbn('FechaVto'))
      ACN(k:FAC, fbn('FechaVto'))
      ACT(b:FAC, fbn('Vehiculo1'))
      ACT(c:FAC, fbn('Book1'))
      ACT(d:FAC, fbn('Especie'))
      ACT(e:FAC, fbn('NrOperacion'))
      ACT(f:FAC, 'Vto. Final')
      ACN(g:FAC, fbn('TotalBrutoCli1')*CotizacionC(fbn('Especie'),,,,FBN['FechaVto']-1,1,SI,Val(r:2)))
    endif
  else
    SQL.ADD("SELECT C.Total2 as Monto, C.Fecha2, C.NrCuota, ")
    SQL.ADD("       O.NrOperacion, O.TipoOp, O.Especie, ")
    SQL.ADD("       O.Vehiculo1, O.Book1, O.FechaVto ")
    SQL.ADD("  FROM "~DBO~".CUOTAS C, "~DBO~".OPERACIONES O ")
    SQL.ADD(" WHERE O.NrOperacion =  '"~fbn('NrOperacion')~"' ")
    SQL.ADD("   and O.NrOperacion =  C.NrOperacion ")
    SQL.ADD("   and C.Fecha2      >= '"~IdxDate(Val(r:7))~"' ")
    SQL.ADD("   and C.Fecha2      <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" order by C.Fecha2 ")
    Recorrer SQL
      ACT(aa:FAC, fbn('NrOperacion'))
      ACT(ab:FAC, fbn('TipoOp'))
      ACN(ad:FAC, fbn('NrCuota'))
      ACD(ae:FAC, fbn('Fecha2'))
      ACN(af:FAC, fbn('Monto'))
      ACD(a:FAC, fbn('Fecha2'))
      ACN(k:FAC, fbn('Fecha2'))
      ACT(b:FAC, fbn('Vehiculo1'))
      ACT(c:FAC, fbn('Book1'))
      ACT(d:FAC, fbn('Especie'))
      ACT(e:FAC, fbn('NrOperacion'))
      if fbn('Fecha2')=fbn('FechaVto')
        ACT(f:FAC, 'Vto. Final')
      else
        ACT(f:FAC, 'Vto. Cuota')
      endif
      ACN(g:FAC, FBN['Monto']*CotizacionC(fbn('Especie'),,,,FBN['Fecha2']-1,1,SI,Val(r:2)))
    Proximo
  endif
  if fbn('FechaVto')>Dialogo.Fecha1
    IFA
    ACD(a:FAC, Dialogo.Fecha1)
    ACN(k:FAC, Dialogo.Fecha1)
    ACT(b:FAC, fbn('Vehiculo1'))
    ACT(c:FAC, fbn('Book1'))
    ACT(d:FAC, fbn('Especie'))
    ACT(e:FAC, fbn('NrOperacion'))
    LinkearHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
    ACN(n:FAC, LinkH(1,az:6))
    ACN(o:FAC, LinkH(1,az:7))
    ACT(f:FAC, 'NMV Actual')
    ACN(g:FAC, LinkH(1,k:Val(n:FAC)))
    if Dialogo.Radio2>0 o Dialogo.Check1=0
      CerrarHoja('RCAR03',1,Fecha1=Dialogo.Fecha1,NrOperacion1=fbn('NrOperacion'),Radio2=Dialogo.Radio1,Radio3=0)
    endif
  endif
proximo

ACT(f:FAC+2, 'T.I.R.')
if FAC>Val(w1)
  OrdenarFilas(Val(w1)+1,FAC,1,'A')
  SetFont(a:Val(w1)+1..af:FAC, 1)
  FormatoCeldas(g:Val(w1)+1..g:FAC, Exe('F2'))
  FormatoCeldas(af:Val(w1)+1..af:FAC, Exe('F2'))
  ACN(g:FAC+2, Tir2(k:Val(w1)+1..k:FAC,g:Val(w1)+1..g:FAC)*100)
else
  ACN(g:FAC+2, 0)
endif
SetFont(f:FAC+2..g:FAC+2, 2)
FormatoCeldas(g:FAC+2..g:FAC+2, Exe('F7'))
ACN(z:1, Val(g:FAC+2))

SetFilaActual(FAC+4)
ACT(a:FAC, 'Fin del listado')
SetFont(a:FAC,2)

SetFont(r:1..z:7, 1)

ACO(1,9)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,8)
ACO(6,12)
ACO(7,9)
ACO(8,8)
ACO(9,10)

LimitesVision(g:FAC)
Impresion(1,1)
SetMargins(1,1,0.5,1)
