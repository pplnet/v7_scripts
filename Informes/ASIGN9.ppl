ModoReproceso(SinDialogo)
CrearDialogo
*  Especie1 :'Especie'  ;;;
  Fecha1   :'Fecha'    ; 1;1;;;;Dialogo.Fecha1<>0 ;'Debe Ingresar la Fecha';NO;FSys
  Lista1   :'Vehiculo' ; 2;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
  Lista2   :'Especie'  ;-4;2;;;;;;;;;SQLSET("Select Codigo from "~DBO~".ESPECIES where Status='HAB' Order by Codigo ");
FinDialogo

if Not Ok
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha: '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC,'Planilla de Asignacion de Fondos Diaria')
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

If NoVacio(VAL(ZZ6))
   ACT(a:FAC+1,'Vehiculo: '~VAL(ZZ6))
Else
   ACT(a:FAC+1,'Vehiculo: Todos')
EndIf


If NoVacio(Dialogo.Lista2)
  ACT(a:FAC+2,'Especies: '~Dialogo.Lista2)
Else
  ACT(a:FAC+2,'Especies: Todos')
EndIf

ACT(a:FAC+3,'Fecha: '~Dialogo.Fecha1)
SetFont(a:fac..N:FAC+3,2)

SetFilaActual(FAC+5)

SQL.ADD("Select M.EnteCustodia, M.Cliente, M.Especie, M.FechaMov, M.NrOperacion, ")
SQL.ADD("O.TipoOp, Sum(M.Cantidad) Cant, M.NrMov ")
SQL.ADD("from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where  M.NrOperacion = O.NrOperacion ")
SQL.ADD("   and  M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and M.EnteCustodia in ("~Pipe2Comillas(val(zz6))~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and M.Especie in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD("and M.NrSaldo = 1 ")
*SQL.ADD("and O.TipoOp Not In ('FXASV','FXATV','FXCSV','FXCTV','FXREPV','FXVSV','FXVTV','VIMINM','TEMINM') ")
*SQL.ADD("and Not (O.TipoOp In ('MMPCCV','MMPCCM') and M.Leyenda Like ' WH %') ")
SQL.ADD("group by M.EnteCustodia, M.Cliente, M.Especie, M.FechaMov, M.NrOperacion, O.TipoOp,M.NrMov   ")

SQL.ADD("Union ")
SQL.ADD("Select M.EnteCustodia, M.Cliente, M.Especie, M.FechaMov, M.NrOperacion, ")
SQL.ADD("O.TipoOp, Sum(M.Cantidad) Cant, M.NrMov ")
SQL.ADD(" from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where  M.NrOperacion = O.NrOperacion ")
SQL.ADD("   and  M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and M.EnteCustodia in ("~Pipe2Comillas(val(zz6))~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and M.Especie in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD("and M.NrSaldo = 1 ")
*SQL.ADD("and O.TipoOp Not In ('FXASV','FXATV','FXCSV','FXCTV','FXREPV','FXVSV','FXVTV','VIMINM','TEMINM') ")
*SQL.ADD("and Not (O.TipoOp In ('MMPCCV','MMPCCM') and M.Leyenda  Like ' WH %') ")
SQL.ADD("group by M.EnteCustodia, M.Cliente, M.Especie, M.FechaMov, M.NrOperacion, O.TipoOp,M.NrMov ")

*--- Adiciono los Movimientos de Ajustes 
SQL.ADD("Union ")
SQL.ADD("Select O.Vehiculo1 EnteCustodia, A.Cliente, A.Especie, A.FechaGen, A.NrOperacion, ")
SQL.ADD("O.TipoOp, Sum(A.Cantidad) Cant, A.NrMov ")
SQL.ADD("from "~DBO~".MOVAJUSTE A,"~DBO~".OPERACIONES O ")
SQL.ADD("Where  A.NrOperacion=O.NrOperacion and A.NrMov IN ")
SQL.ADD(" (Select M.NrMov from "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O ")
SQL.ADD(" Where  M.NrOperacion = O.NrOperacion ")
SQL.ADD("   and  M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("and O.TipoOp Not In ('FXASV','FXATV','FXCSV','FXCTV','FXREPV','FXVSV','FXVTV','VIMINM','TEMINM') ")
*SQL.ADD("and Not (O.TipoOp In ('MMPCCV','MMPCCM') and M.Leyenda Like ' WH %') ")
SQL.ADD("and A.NrOperacion=M.NrOperacion) ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD("group by Vehiculo1, A.Cliente, A.Especie, A.FechaGen,A.NrOperacion,O.TipoOp,A.NrMov ")

SQL.ADD("Union ")
SQL.ADD("Select O.Vehiculo1 EnteCustodia, O.Cliente1, O.Especie, O.FechaOp, O.NrOperacion, ")
SQL.ADD("O.TipoOp, (CASE WHEN O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' THEN -O.Cantidad ELSE O.Cantidad END) Cant, 0 NrMov ")
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("Where (O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' or O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("  and O.TipoOp='MMDPAC' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.Especie in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif

SQL.ADD("Union ")
SQL.ADD("Select M.EnteCustodia, M.Cliente, M.Especie, M.FechaMov, M.NrOperacion, ")
SQL.ADD(" T.TipoTr2 TipoOp, Sum(M.Cantidad) Cant, M.NrMov ")
SQL.ADD(" from "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" Where  M.NrOperacion = T.NrTrans ")
SQL.ADD("   and  M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and M.EnteCustodia in ("~Pipe2Comillas(val(zz6))~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and M.Especie in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD("and M.NrSaldo = 1 and M.NrMov in (1,2) ")
SQL.ADD("and T.TipoTr2 in ('CCUPON','PCUPON') ")
SQL.ADD("group by M.EnteCustodia, M.Cliente, M.Especie, M.FechaMov, M.NrOperacion, T.TipoTr2, M.NrMov ")

SQL.ADD("Union ")
SQL.ADD("Select O.Vehiculo1 EnteCustodia, O.Cliente1, O.Especie, O.FechaOp, O.NrOperacion, ")
SQL.ADD("O.TipoOp, C.Cantidad4 Cant, 0 NrMov ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD("Where O.NrOperacion=C.NrOperacion ") 
SQL.ADD("  and C.Fecha2 = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and C.Cantidad4>0 ")
SQL.ADD("  and O.TipoOp in ('MMCPM','MMCPMG') ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
if NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.Especie in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif

SQL.ADD("order by 1, 3, 4 ")

ACT(X1,' ')
ACT(X3,' ')
acn(ca2,fac)
acn(ca3,0)
acn(ca5,0)
acn(ca4,fac)
acn(x2,0)
acn(ca6,1)
Recorrer SQL
if DesciendeDeCliente(fbn['Cliente'],'EMPRESAS') y Incluido(fbn['TipoOp'],'FXAS|FXAT|FXCS|FXCT|FXREPO|FXVS|FXVT')
   dfa
else
   if Not EqStr(val(x1),fbn['EnteCustodia'])
      if val(x2) <> 0
         act(a:val(ca2)+val(ca3)+3,'Saldo')
         Recorrer&i 1, (val(ca1) DIV 4)+1
           acn(&i*4:val(ca2)+val(ca3)+3,Sum(&i*4:val(ca2)+2..&i*4:val(ca2)+val(ca3)+2))
         Proximo
         SetFont(a:val(ca2)+val(ca3)+3..val(ca1)+3:val(ca2)+val(ca3)+3,2)
         FormatoCeldas(c:val(ca2)+val(ca3)+3..val(ca1)+3:val(ca2)+val(ca3)+3,Exe('F2'))
         AgregarMarco(a:val(ca2)+val(ca3)+3..val(ca1)+3:val(ca2)+val(ca3)+3,2,1)
         acn(ca4,val(ca2)+val(ca3)+6)
         acn(ca2,val(ca2)+val(ca3)+6)
      endif
      acn(ca1,1)
      ACT(a:val(ca4), 'Vehiculo: '~fbn['EnteCustodia'])
      SetFont(a:val(ca4)..g:val(ca4),2)
      AgregarMarco(a:val(ca4)..d:val(ca4),2,0,Exe('COLOR'))
      act(x1,fbn['EnteCustodia'])
      ifa
      scn(ca4,1)
      ACT(a:val(ca4), 'Especie: '~fbn['Especie'])
      SetFont(a:val(ca4)..g:val(ca4),2)
      AgregarMarco(a:val(ca4)..d:val(ca4),2,0)
      act(x3,fbn['Especie'])
      ifa
      scn(ca4,1)
      ACT(val(ca1):val(ca4), 'Tipo Mov.')
      ACT(val(ca1)+1:val(ca4), 'Nr.Mov.')
      ACT(val(ca1)+2:val(ca4), 'Contrap.')
      ACT(val(ca1)+3:val(ca4), 'Cantidad')
      SetFont(val(ca1):val(ca4)..val(ca1)+3:val(ca4),2)
      AgregarMarco(val(ca1):val(ca4)..val(ca1)+3:val(ca4),2,0)
      ifa
      scn(ca4,1)
      scn(x2,1)
      acn(ca3,0)
      acn(ca5,0)
   endif
   if Not EqStr(val(x3),fbn['Especie'])
      scn(ca1,4)
      ACT(val(ca1):val(ca2)+1, 'Especie: '~fbn['Especie'])
      SetFont(val(ca1):val(ca2)+1..val(ca1)+3:val(ca2)+1,2)
      AgregarMarco(val(ca1):val(ca2)+1..val(ca1)+3:val(ca2)+1,2,0)
      act(x3,fbn['Especie'])
      ifa
      ACT(val(ca1):val(ca2)+2, 'Tipo Mov.')
      ACT(val(ca1)+1:val(ca2)+2, 'Nr.Mov.')
      ACT(val(ca1)+2:val(ca2)+2, 'Contrap.')
      ACT(val(ca1)+3:val(ca2)+2, 'Cantidad')
      SetFont(val(ca1):val(ca2)+2..val(ca1)+3:val(ca2)+2,2)
      AgregarMarco(val(ca1):val(ca2)+2..val(ca1)+3:val(ca2)+2,2,0)
      ifa
      acn(ca4,val(ca2)+3)
      acn(ca5,0)
   endif
   act(val(ca1)+1:val(ca4),fbn['NrOperacion'])
   If Incluido(FBN['TipoOp'],'CCUPON|PCUPON')
      aclt(val(ca1)+1:val(ca4),fbn['NrOperacion'])
   Else
      aclo(val(ca1)+1:val(ca4),fbn['NrOperacion'])
   EndIf
*   acn(val(ca1)+2:val(ca4),fbn['Cantidad'])
   act(val(ca1)+2:val(ca4),fbn['Cliente'])
   
   * Imprime los Valores
   if Incluido(fbn['TipoOp'],'POSOPE|CCUPON|PCUPON')
      acn(val(ca1)+3:val(ca4),  fbn['Cant'])
   else
      *if Incluido(fbn['TipoOp'],'MMPE|MMPEM|MMPI|MMPIM|MMPCL|MMPCLM|MMPCOS|MMPOSM') y fbn['Cant'] < 0
      *   acn(val(ca1)+3:val(ca4), -(fbn['Cant']+BuscarCampo('Operaciones','TotalComisiones','NrOperacion',fbn['NrOperacion'])))
      *else
         acn(val(ca1)+3:val(ca4), -fbn['Cant'])
      *endif
   endif
   
   * Por Cada Movimiento Ejecutado verifico  si hay ajustes
   If no
   If FBN['NrMov']<>0 
      SQL.ADD("Select * from "~DBO~".MOVAJUSTE where ")
      SQL.ADD("NrOperacion='"~fbn('NrOperacion')~"' and NrMov="~Fstr(FBN['NrMov'],0,0)~" Order By FechaValor ")
      
      Recorrer SQL
        DFA
        SCN(val(ca1)+3:val(ca4), -fbn('Cantidad'))
      Proximo 
   EndIf
   EndIf
   
   if Incluido(fbn['TipoOp'],'POSOPE')
      if Not EqStr(BuscarCampo('Operaciones','Observac2','NrOperacion',fbn['NrOperacion']),'')
         act(val(ca1):val(ca4),BuscarCampo('Operaciones','Observac2','NrOperacion',fbn['NrOperacion']))
      else
         act(val(ca1):val(ca4),BuscarCampo('Operaciones','TipoOp','NrOperacion',fbn['NrOperacion']))
      endif
   else
      act(val(ca1):val(ca4),BuscarCampo('Operaciones','TipoOp','NrOperacion',fbn['NrOperacion']))
   endif
   SetFont(val(ca1):val(ca4)..val(ca1)+3:val(ca4),1)
   FormatoCeldas(val(ca1)+2:val(ca4)..val(ca1)+3:val(ca4),Exe('F2'))
   scn(ca4,1)
   scn(ca5,1)
   acn(ca3,iif(val(ca3)<val(ca5),val(ca5),val(ca3)))
   acn(ca6,iif(val(ca6)<val(ca1),val(ca1),val(ca6)))
endif
Proximo

if val(x2) > 0
   act(a:val(ca2)+val(ca3)+3,'Saldo')
   Recorrer&i 1, (val(ca1) DIV 4)+1
     acn(&i*4:val(ca2)+val(ca3)+3,Sum(&i*4:val(ca2)+2..&i*4:val(ca2)+val(ca3)+2))
   Proximo
   SetFont(a:val(ca2)+val(ca3)+3..val(ca1)+3:val(ca2)+val(ca3)+3,2)
   FormatoCeldas(d:val(ca2)+val(ca3)+3..val(ca1)+3:val(ca2)+val(ca3)+3,Exe('F2'))
   AgregarMarco(a:val(ca2)+val(ca3)+3..val(ca1)+3:val(ca2)+val(ca3)+3,2,1)
endif

SetFilaActual(val(ca2)+val(ca3)+3+2)

ACO(1,8)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,7)
ACO(6,7)
ACO(7,12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(val(ca6)+3:FAC)
*RangoTitulo(a1..k:8,36)

