CrearDialogo
  NrOperacion1: 'NrOperacion';1;1;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.Nroperacion1),'MMONM|MMPCCM|MMPCLM|MMPOSM');'Tipo de Operacion invalido';NO;
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,'Arial,9,B')
CrearFont(2,'Arial,8,')
CrearFont(3,'Arial,8,B')
CrearFont(4,'Arial,10,B')

SQL.ADD(" Select 'FIJA' as TipoTasa, O.Cantidad, O.Spread, O.FechaOp, O.FechaVto, C.Precio2, C.Precio4 ")
SQL.ADD(" From "~DBO~".OPERACIONES O")
SQL.ADD(" Left Join "~DBO~".CUOTAS C ")
SQL.ADD(" on O.NrOperacion=C.NrOperacion ")
SQL.ADD(" where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" and C.NrCuota = 1 ")

Recorrer SQL
  ACT(i:1,'Flujo de '~IIF(EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.Nroperacion1),'MMONM'),'ON','Prestamo'))
  SetFont(i:1,4)
  SetFilaActual(FAC+2)
  ACT(a:fac, 'Vehiculo')
  ACT(b:fac,BuscarCampo('VEHICULOS','Descripcion','Codigo',BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)))
  ACT(a:fac+1, 'NrOperacion')
  ACT(b:fac+1,Dialogo.NrOperacion1) 
  ACLO(b:fac+1,Dialogo.NrOperacion1)
  ACT(a:fac+2,'Capital')
  ACT(b:fac+2,fbn('Cantidad'))
  ACT(a:fac+3, 'Intereses')
  ***---ACT(b:fac+3, IIF(EqStr(fbn('TipoTasa'),'FIJA'),FStr(fbn('Precio2'),0,0)~'% Fijo',fbn('TipoTasa')~' + '~FStr(fbn('Precio4')*100,0,0)~'  bp'))
  ACT(b:fac+3, BuscarCampo('OPERACIONES','TipoTasa','NrOperacion', Dialogo.NrOperacion1)~' + '~FStr(fbn('Precio4')*100,0,0)~'  bps')
  ACT(a:fac+4,'Plazo')
  ACT(me:1,FStr(DifMeses(fbn('FechaVto'),fbn('FechaOp')),0,0))
  ACT(b:fac+4, VAL(me:1)~IIF(EqStr(VAL(me:1),'1'), ' mes',' meses'))
  ACT(a:fac+5,'Inicio')
  ACT(b:fac+5, fbn('FechaOp'))
  ACT(a:fac+6, 'Fin')
  ACT(b:fac+6, fbn('FechaVto'))
  ACD(fe:1, SQL("Select Fecha3 From "~DBO~".CUOTAS where Fecha1 = '"~IdxDate(fbn('FechaOp'))~"' and NrOperacion= '"~Dialogo.NrOperacion1~"' "))
  ***---ACT(a:fac+7,'Plazo Gracia')
  ACT(me:1,FStr(DifMeses(VAL(fe:1),fbn('FechaOp')),0,0))
  ***---ACT(b:fac+7, VAL(me:1)~IIF(EqStr(VAL(me:1),'1'), ' mes',' meses'))
  ***---ACT(a:fac+8,'Primer Pago')
  ACT(a:fac+7,'Primer Pago')
  ***---ACT(b:fac+8, VAL(fe:1))
  ACT(b:fac+7, VAL(fe:1))
  SetFont(a:fac..c:fac+8,3)
  ***---SetFilaActual(FAC+10)
  SetFilaActual(FAC+9)

  ***Obtengo el Tipotasa de la operacion***
  ACT(ta:1,fbn('TipoTasa'))
  ***Guardo la columna de la tasa***
  ACN(az:1,6)
  ***Sumador de importe amort por FechaPago***
  ACN(su:1,0)
  ***Sumador de total por FechaPago***
  ACN(su:2,0)
  ***Sumador de Total TAX***
  ACN(su:3,0)
  ***Sumador de IVA***
  ACN(iv:1,0)
Proximo

***Titulos***
ACT(a:fac, 'Periodo')
ACT(b:fac, 'Fecha')
ACT(b:fac+1,'Reset')
ACT(c:fac, 'Fecha')
ACT(c:fac+1,'Pago')
ACT(d:fac, 'Capital')
ACT(d:fac+1,'Remanente')
ACT(e:fac, 'Amort.')
If EqStr(VAL(ta:1),'FIJA')
  ACT(f:fac, 'Tasa')
  ACT(f:fac+1,'Total')
  SCN(az:1,1)
  ACN(fi:1,1)
***Si la tasa es variable la tasa ocupa 3 columnas***
Else
  ACT(g:fac, 'Tasa '~VAL(ta:1)~' BP prom. ')
  ACT(g:fac+1,VAR('DIASTASAPR')~' días hábiles anteriores')
  SCN(az:1,3)
  ACN(fi:1,5)
Endif
ACT(VAL(az:1):fac, 'Spread')
ACT(VAL(az:1)+1:fac, 'Tasa')
ACT(VAL(az:1)+1:fac+1,'Final')
ACT(VAL(az:1)+2:fac, 'Dias')
ACT(VAL(az:1)+3:fac, 'Intereses')
ACT(VAL(az:1)+4:fac, 'Pago')
ACT(VAL(az:1)+4:fac+1, 'Comision')
ACT(VAL(az:1)+5:fac,'Total')
ACT(VAL(az:1)+5:fac+1,'(sin TAX)')
ACT(VAL(az:1)+6:fac,'Pago Total')
ACT(VAL(az:1)+6:fac+1,'(sin TAX)')
AlinearCeldas(a:fac..VAL(az:1)+6:fac+1,'C')
SetFont(a:fac..VAL(az:1)+6:(fac+1),1)
AgregarMarco(a:fac..VAL(az:1)+6:fac+1,1,0,EXE('COLOR'))
ACT(VAL(az:1)+8:fac,'IVA')
ACT(VAL(az:1)+8:fac+1,'Intereses')
ACT(VAL(az:1)+9:fac,'IVA')
ACT(VAL(az:1)+9:fac+1,'Comision')
ACT(VAL(az:1)+10:fac,'IVA')
ACT(VAL(az:1)+10:fac+1,'Percepcion')
ACT(VAL(az:1)+11:fac,'IDC')
ACT(VAL(az:1)+12:fac,'Sellos')
ACT(VAL(az:1)+13:fac,'TotalTax')
ACT(VAL(az:1)+15:fac,'Pago Total')
AlinearCeldas(VAL(az:1)+8:fac..VAL(az:1)+15:fac+1,'C')
SetFont(VAL(az:1)+8:fac..VAL(az:1)+15:(fac+1),1)
AgregarMarco(VAL(az:1)+8:fac..VAL(az:1)+13:fac+1,1,0,EXE('COLOR'))
AgregarMarco(VAL(az:1)+15:fac..VAL(az:1)+15:fac+1,1,0,EXE('COLOR'))

IFA

***Consulta de las comisiones en la FechaOp***
SQL.ADD(" Select C.Fecha1,Sum(C.Importe1) Comision,Sum(C.Importe2) IVAComision")
SQL.ADD(" FROM "~DBO~".COMISIONES2 C")
SQL.ADD(" JOIN "~DBO~".OPERACIONES O ")
SQL.ADD(" on C.NrOperacion=O.NrOperacion ")
SQL.ADD(" where C.NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" and O.FechaOp=C.Fecha1 ")
SQL.ADD(" Group by C.Fecha1 ")

Recorrer SQL
  If fbn('Comision')<>0
    ACT(A:FAC,'0')
    ACD(B:FAC,fbn('Fecha1'))
    ACD(C:FAC,fbn('Fecha1'))
    ACN(VAL(az:1)+4:FAC,fbn('Comision'))
    ACN(VAL(az:1)+6:FAC,fbn('Comision'))
    ACN(VAL(az:1)+9:FAC,fbn('IVAComision'))
    ACN(VAL(az:1)+13:FAC,fbn('IVAComision'))
    ACN(VAL(az:1)+15:FAC,fbn('Comision')+fbn('IVAComision'))
    SetFont(a:FAC,3)
    SetFont(VAL(az:1)+6:FAC,3)
    AlinearCeldas(a:FAC..C:FAC,'C')
    SetFont(b:FAC..VAL(az:1)+4:FAC,2)
    SetFont(VAL(az:1)+9:FAC..VAL(az:1)+15:FAC,2)
    SetFont(c:FAC,3)
    AgregarMarco(a:fac..VAL(az:1)+6:fac,1,0)
    AgregarMarco(VAL(az:1)+8:fac..VAL(az:1)+13:fac,1,0)
    AgregarMarco(VAL(az:1)+15:fac..VAL(az:1)+15:fac,1,0)
  Else
    DFA
  Endif
Proximo


***Consulta de las cuotas de la operacion***
SQL.ADD(" Select C.NrCuota, C.Fecha1 FechaIni, C.Fecha2 FechaReset, C.Fecha3 FechaPago, C.Cantidad2 Remanente, ")
SQL.ADD(" CASE when O.TipoOp='MMONM' THEN C.Cantidad4 ELSE C.Cantidad1 END Amort,  ")
SQL.ADD(" C.Precio2 TasaInteres, C.Precio4 Spread, C.Cantidad3 Interes, O.RB8, O.PlazoGracia, ")
SQL.ADD(" CASE when O.TipoOp='MMONM' THEN C.Precio1 ELSE C.Total4 END IVAIntereses, C.Plazo1")
SQL.ADD(" From "~DBO~".CUOTAS C")
SQL.ADD(" Left Join "~DBO~".OPERACIONES O")
SQL.ADD(" on C.NrOperacion = O.NrOperacion ")
SQL.ADD(" where C.NrOperacion = '"~Dialogo.NrOperacion1~"' ")

***Guardo la fila actual***
ACN(fa:1,FAC+1)

Recorrer SQL
  ACT(a:fac,fbn('NrCuota'))
  ACD(b:fac,fbn('FechaIni'))
  ACN(d:fac,fbn('Remanente'))
  ACN(am:fac,fbn('Amort'))
  If EqStr(VAL(ta:1),'FIJA')
    AgregarMarco(a:fac..VAL(az:1)+6:fac,1,0)
    AgregarMarco(VAL(az:1)+8:fac..VAL(az:1)+13:fac,1,0)
    AgregarMarco(VAL(az:1)+15:fac..VAL(az:1)+15:fac,1,0)
    ACN(f:fac,fbn('TasaInteres'))
  Else
    ***Si la tasa no es fija se calcula el promedio de las tasas de 5 dias habiles anteriores al vencimiento***
    AgregarMarco(a:fac..VAL(az:1)+6:fac+VAR('DIASTASAPR')-1,1,0)
    AgregarMarco(VAL(az:1)+8:fac..VAL(az:1)+13:fac+VAR('DIASTASAPR')-1,1,0)
    AgregarMarco(VAL(az:1)+15:fac..VAL(az:1)+15:fac+VAR('DIASTASAPR')-1,1,0)
    ACN(pr:1,0)
    ACT(li:1,'')
    ACD(fe:2,fbn('FechaIni',0)-1)
    ***Se buscan los dias habiles antes del inicio de la cuota***
    Repetir
      If EsHabil(VAL(fe:2),'ARG')
        ACT(li:1,Val(li:1)~VAL(fe:2)~'|')
      Endif
      ACD(fe:2,Val(fe:2)-1)
      If Elementos(Val(li:1))=VAR('DIASTASAPR')
        Break
      Endif
    Proximo
    ***Se muestran la tasa y el dia***
    Recorrer&i 1,VAR('DIASTASAPR')
      ACD(f:fac,Fecha(ItemLista(Val(li:1),VAR('DIASTASAPR')-&i+1)))
      ACN(g:fac,SQL(" Select Valor1 From "~DBO~".TASASDIA where TipoTasa = '"~VAL(ta:1)~"' and Especie = '"~BuscarCampo('OPERACIONES','Especie','NrOperacion',Dialogo.NrOperacion1)~"' and Fecha = '"~IdxDate(Val(f:fac))~"' "))
      SCN(pr:1,VAL(g:fac))
      IFA
    Proximo
    SetFilaActual(FAC-VAR('DIASTASAPR'))
    ACN(h:fac,VAL(pr:1)/VAR('DIASTASAPR'))
  Endif
  ACN(VAL(az:1):fac,fbn('Spread'))
  ACN(VAL(az:1)+1:fac,VAL(VAL(az:1)-1:fac)+VAL(VAL(az:1):fac))
  ACN(VAL(az:1)+2:fac,fbn('Plazo1'))
  ***Si la tasa no es fija, el interes se calcula con la tasa promedio calculada mas el spread (Tasa Final)***
  If Not EqStr(VAL(ta:1),'FIJA')
    ACN(VAL(az:1)+3:fac,IIF(fbn('NrCuota')<fbn('PlazoGracia'),0,fbn('Remanente')*(Val(VAL(az:1)+1:fac)/100)*FactorDias(fbn('FechaIni'),fbn('FechaReset'),fbn('RB8')+1)))
  Else
    ACN(VAL(az:1)+3:fac,fbn('Interes'))
  Endif
  ***Si las FechaPago son distintas se muestran los totales, después de la primer cuota***
  If fbn('NrCuota')>1 y fbn('FechaPago')<>Val(Fe:3)
      ACN(co:1,SQL("Select Sum(Importe1) From "~DBO~".COMISIONES2 where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 = '"~IdxDate(VAL(fe:3))~"' "))
      ACN(VAL(az:1)+9:fac-1,SQL("Select Sum(Importe2) From "~DBO~".COMISIONES2 where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 = '"~IdxDate(VAL(fe:3))~"' "))
      SCN(su:3,VAL(VAL(az:1)+9:fac-1))
      ***Fecha pago***
      ACD(c:fac-1,Val(fe:3))
      ***Amortizacion***
      ACN(e:fac-1,Val(su:1))
      ***Comisiones de la operacion para FechaPago**
      ACN(VAL(az:1)+4:fac-1,Val(co:1))
      ***Pago Total(sin TAX)***
      ACN(VAL(az:1)+6:fac-1,Val(su:2)+Val(VAL(az:1)+4:fac-1)+Val(su:1))
      ***IVA Intereses***
      ACN(VAL(az:1)+8:fac-1,Val(iv:1))
      ***Total TAX***
      ACN(VAL(az:1)+13:fac-1,Val(su:3))
      ***Pago total = Total sin Tax + Total Tax***
      ACN(VAL(az:1)+15:fac-1,VAL(su:3)+VAL(VAL(az:1)+6:fac-1))
      ACN(su:1,0)
      ACN(su:2,0)
      ACN(su:3,0)
      ACN(iv:1,0)
  Endif
  ***Se suman la amortizacion y el total por FechaPago***
  SCN(su:1,VAL(am:fac))
  SCN(su:2,Val(VAL(az:1)+3:fac))
  If fbn('NrCuota')>1
  ***Total = Amort + Intereses + Comision***
    ACN(VAL(az:1)+5:fac-VAL(fi:1),Val(e:fac-1)+Val(VAL(az:1)+3:fac-VAL(fi:1))+VAL(VAL(az:1)+4:fac-1))
  Endif
  ACD(fe:3,fbn('FechaPago'))
  ***Si la tasa es variable, la proxima cuota empieza mas abajo***
  If Not EqStr(VAL(ta:1),'FIJA')
    SetFilaActual(FAC+VAR('DIASTASAPR')-1)
  Endif
  ***Se suma el IVA por FechaPago***
  SCN(iv:1,fbn('IVAIntereses'))
  SCN(su:3,fbn('IVAIntereses'))
Proximo
IFA
***Valores de la ultima cuota***
ACD(c:fac-1,Val(fe:3))
ACN(e:fac-1,Val(su:1))
ACN(VAL(az:1)+4:fac-1,SQL("Select Sum(Importe1) From "~DBO~".COMISIONES2 where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 = '"~IdxDate(VAL(fe:3))~"' "))
ACN(VAL(az:1)+5:fac-VAL(fi:1),Val(e:fac-1)+Val(VAL(az:1)+3:fac-VAL(fi:1))+VAL(VAL(az:1)+4:fac-1))
ACN(VAL(az:1)+6:fac-1,Val(su:2)+Val(VAL(az:1)+4:fac-1)+Val(su:1))
ACN(VAL(az:1)+9:fac-1,SQL("Select Sum(Importe2) From "~DBO~".COMISIONES2 where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 = '"~IdxDate(VAL(fe:3))~"' "))
ACN(VAL(az:1)+8:fac-1,Val(iv:1))
ACN(VAL(az:1)+13:fac-1,VAL(su:3)+SQL("Select Sum(Importe2) From "~DBO~".COMISIONES2 where NrOperacion = '"~Dialogo.NrOperacion1~"' and Fecha1 = '"~IdxDate(VAL(fe:3))~"' "))
ACN(VAL(az:1)+15:fac-1,VAL(VAL(az:1)+13:fac-1)+VAL(VAL(az:1)+6:fac-1))

FormatoCeldas(VAL(az:1)+2:VAL(fa:1)..VAL(az:1)+2:fac,EXE('F0'))
AlinearCeldas(a:VAL(fa:1)..c:fac,'C')
SetFont(a:VAL(fa:1)..VAL(az:1)+6:fac,2)
SetFont(a:VAL(fa:1)..a:fac,3)
SetFont(c:VAL(fa:1)..c:fac,3)
SetFont(VAL(az:1)+6:VAL(fa:1)..VAL(az:1)+6:fac,3)
SetFont(VAL(az:1)+8:VAL(fa:1)..VAL(az:1)+15:fac,2)

***Ajusto el ancho de las columnas***
ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,10)
ACO(5,10)
ACO(6,7)
ACO(7,7)
ACO(8,7)
ACO(VAL(az:1)+2,4)
ACO(VAL(az:1)+4,9)
ACO(VAL(az:1)+5,9)
ACO(VAL(az:1)+6,9)
ACO(VAL(az:1)+10,9)

LimitesVision(VAL(az:1)+17:fac+3)