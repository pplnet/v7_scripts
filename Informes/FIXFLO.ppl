ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1  : 'Desde'          ;1;1;;;;;;;;Fsys
   Fecha2  : 'Hasta'          ;2;1;;;;;;;;FinDeMes(Fecha('31/12/'~FStr(Anio(Fsys)+5,4,0)),SI)
   Radio1  : 'Clientes|Todos|Vinculados|Terceros';;;;;;;;;0;
   Lista1  : 'Vehiculo'       ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))   
FinDialogo
if Not Ok
  Cancelar
endif

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")
CrearFont(5,"Arial,10,B")

ACT(g:1,'Fecha : '~Var('FECHASYS'))
SetFont(c:1..c:1,5)

SetFilaActual(2)

ACT(a:FAC, "Mix de Deuda Fix-Floating ")
SetFont(a:fac..a:fac,5)

SetFilaActual(3)

ACT(a:FAC+1, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Fecha Hasta : '~Dialogo.Fecha2)

if Vacio(val(zz6))
  ACT(a:FAC+3, 'Empresa : Todas ')
 else
  ACT(a:FAC+3, 'Empresa : '~val(zz6))
endif
ACT(a:FAC+4, 'Clientes : '~Iif(Dialogo.Radio1=0,'Todos',Iif(Dialogo.Radio1=2,'Terceros','Vinculados')))

SetFont(a:fac..n:FAC+4,4)
SetFilaActual(9)

* ac1: Contador de Columnas
ACT(a:fac,'PERIODOS')
SetFont(a:fac..a:FAC,5)  

ACN(ac1,2)
ACT(val(ac1):fac,'CONSOLIDADO')
SetFont(val(ac1):fac..val(ac1):FAC,2)  

SQL.ADD("Select Distinct O.Vehiculo1 From "~DBO~".OPERACIONES O ")
If Dialogo.Radio1>0 
   SQL.ADD(","~DBO~".CLIENTES C")
Endif
SQL.ADD("where O.FechaOp2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp In ('MMFRN','MMON','MMPCCV','MMPCL','MMPCOS','MMPE','MMPI','MMPLME','MMPSC','MMFCMV','MMONM','MMPCCM','MMPCLM','MMPOSM','MMPEM','MMPIM','MMSCMV') ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
If Dialogo.Radio1 = 1
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)='"~VAR('JERVINCUL')~"' ")
EndIf
If Dialogo.Radio1 = 2
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)<>'"~VAR('JERVINCUL')~"' ")
Endif
SQL.ADD("  Union ")
SQL.ADD("Select Distinct  O.Vehiculo1 from "~DBO~".OPERACIONES O ")
If Dialogo.Radio1>0 
   SQL.ADD(","~DBO~".CLIENTES C")
Endif
SQL.ADD("where ")
SQL.ADD(" ((TipoOp IN ('DTSFV','DTSFVV') and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"')   ")
SQL.ADD(" or (TipoOp IN ('DTO','DTOV') and MB3='0' and MB1='0' and O.FechaEx1<='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaEx2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
If Dialogo.Radio1 = 1
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)='"~VAR('JERVINCUL')~"' ")
EndIf
If Dialogo.Radio1 = 2
   SQL.ADD(" and C.Codigo=O.Cliente1 and SubString(C.Jerarquia,1,3)<>'"~VAR('JERVINCUL')~"' ")
Endif
SQL.ADD("  Union ")
SQL.ADD("Select Distinct O.Vehiculo1 ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
If Dialogo.Radio1>0 
   SQL.ADD(","~DBO~".CLIENTES L")
Endif
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("  and ((TipoOp IN ('DTK','DTKVI','DTSFVM','DTSFVX') and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("  or (TipoOp IN ('DTOM','DTOMV') and MB3='0' and MB1='0' and C.Fecha5<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha6>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("  or (TipoOp IN ('DTSNFV') and MB3='0' and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"')) ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
If Dialogo.Radio1 = 1
   SQL.ADD(" and L.Codigo=O.Cliente1 and SubString(L.Jerarquia,1,3)='"~VAR('JERVINCUL')~"' ")
EndIf
If Dialogo.Radio1 = 2
   SQL.ADD(" and L.Codigo=O.Cliente1 and SubString(L.Jerarquia,1,3)<>'"~VAR('JERVINCUL')~"' ")
Endif
SQL.ADD(" Order By 1")

Recorrer  SQL
   dfa
   SCN(ac1,1)
   ACT(val(ac1):fac,FBN['Vehiculo1'])
   SetFont(val(ac1):fac..val(ac1):FAC,2)  
   ACO(val(ac1),13)
Proximo 

SetFilaActual(fac+2)

*-- Periodos de medicion Trimestral para el 1er. año y despues anual (fines de mes).
acd(af1,FinDeMes(Dialogo.Fecha1+90,SI))

Recorrer&i 1,10    
   acd(a:fac,VAL(af1))
   SetFont(a:fac..a:FAC,2)  
   AgregarMarco(a:fac..a:fac,2,0,Exe('COLOR6'))
   AlinearCeldas(a8..a:fac, 'C')
   Ifa  
   
   (.'MARCOMIX'.)

   *- Recorro los Vehiculos 
   Recorrer&j 3,val(ac1)    

       *-- Por Cada Fecha de Medicion y Cada Vehiculo Obtengo los Valores 
       Message('F.Valuacion '~Dialogo.Fecha1~', F.Medicion '~val(a:val(a:200)-3)~',Cliente '~IIf(Dialogo.Radio1=0,'Todos',Iif(Dialogo.Radio1=2,'Terceros','Vinculados'))~', Vehiculo '~Val(&j:9)~',Nro.Med '~Fstr(&i,0,0)~' ')

       LinkearHoja('MXFIFL',1,Fecha1=Dialogo.Fecha1,Fecha2=val(a:val(a:200)-3),Radio1=Dialogo.Radio1,Vehiculo1=Val(&j:9),Entero1=&i)

       * Linkeo los valores 14,23 rango de valores
       Recorrer&k 14,23

          If NoVacio(val(a:val(a:200)+&k-14))
             ACN(&j:val(a:200)+&k-14, LinkH(1,b:&k))
             SetFont(&j:val(a:200)+&k-14..&j:val(a:200)+&k-14,3)

             *- Incremento el Consolidado col. b
             SCN(b:val(a:200)+&k-14, LinkH(1,b:&k))
             SetFont(b:val(a:200)+&k-14..b:val(a:200)+&k-14,3)

             If EqStr(val(a:val(a:200)+&k-14),'  TOTAL PASIVOS')
                SetFont(&j:val(a:200)+&k-14..&j:val(a:200)+&k-14,3)
                AgregarMarco(&j:val(a:200)+&k-14..&j:val(a:200)+&k-14,2,0,Exe('COLOR6'))

                SetFont(b:val(a:200)+&k-14..b:val(a:200)+&k-14,3)
                AgregarMarco(b:val(a:200)+&k-14..b:val(a:200)+&k-14,2,0,Exe('COLOR6'))
             EndIf
          EndIf
       Proximo 

       *--- Calculo los % para el Consolidado
       *-- Pasivos Floating sin Hedge => Pasivos a Tasa Flotante -Pasivos Floating Hedgeados
       ACN(b:val(c:200)+1, val(b:val(a:200)+3) - val(b:val(c:200)) )           

       *-- % Pasivos Floating Sin Hedge => Pasivos Floating sin Hedge/Pasivos a Tasa Flotante 
       ACN(b:val(c:200)+2, val(b:val(c:200)+1)/val(b:val(a:200)+3) )           

       *-- % Pasivos Pasivos a Tasa Fija (Fix+Hedge) => (Pasivos Floating Hedgeados + Pasivos a Tasa Fija)/Total Pasivos 
       ACN(b:val(c:200)+4, (val(b:val(c:200))+val(b:val(a:200)+2))/val(b:val(a:200)) )           
       SetFont(b:val(c:200)+1..b:val(c:200)+4,3)

       *CerrarrHoja('MXFIFL',1,Fecha1=Dialogo.Fecha1,Fecha2=val(a:val(a:200)-3),Radio1=Dialogo.Radio1,Vehiculo1=Val(&j:9),Entero1=&i)
       *CerrarLink(1)
   Proximo

   If &i<=3
      acd(af1,FinDeMes(val(af1)+90,SI) )
   Else 
      acd(af1,FinDeMes(val(af1)+365,SI) )
   EndIf

   If Val(af1)>Dialogo.Fecha2
      Break
   EndIf
Proximo

AlinearCeldas(a8..a:fac, 'I')
FormatoCeldas(b:8..val(ac1):fac,Exe('F2'))

ACO(1,20)
ACO(2,13)
FijarCol(2)
FijarFila(10)
Impresion(1,2)
LimitesVision(val(ac1):fac)
SetPrintFit(3,60)
RangoTitulo(a1..val(ac1):fac,9)
* AgregarMarco(a:12..val(ac1):12,1,3)     