ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha desde"     ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2     : "Fecha hasta"     ;1;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys  
  Fecha3     : "Fecha Fut"       ;2;1;;;; ; ; ;
  Mercado1   : "Mercado"         ;3;1;;;;;;;;;;;;"TipoNegocio Like '%FT%' or TipoNegocio Like '%FM%' "
  Lista1     : "Especies"        ;4;1;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES ORDER BY Codigo ");

  
FinDialogo

if Not Ok
  Cancelar
endif
AgregarBMP(a1,Exe('LOGO'),80)
CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(3)

ACT(a:FAC, 'Cotizciones de futuros por especie')
SetFont(a:fac,3)

SetFilaActual(4)
ACN(ab:1,Dialogo.Fecha3)
ACT(a:FAC, 'Especies : '~IIF(NoVacio(Dialogo.Lista1), Pipe2Coma(Dialogo.Lista1), 'Todas') )
ACT(a:FAC+1, 'Fecha Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2 )
ACT(a:FAC+2, 'Fecha Futuro: '~iif(Val(ab:1)<>0,Dialogo.Fecha3,'Todas') )
SetFont(a:fac..a:fac+2,2)

SetFilaActual(FAC+4)

ACT(a:fac, 'Mercado')
ACT(b:fac, 'Especie')
ACT(c:fac, 'Nombre')
ACT(d:fac, 'Fecha')
ACT(e:fac, 'Fecha Fut')
ACT(f:fac, 'Close')
*ACT(g:fac, 'Bid')
*ACT(h:fac, 'Ask')
ACT(g:fac, 'Promedio')
*ACT(j:fac, 'Tipo')
ACT(h:fac, 'Moneda')
ACN(w1,fac)

*SetFont(a:FAC..k:FAC,2)
*AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))
*AlinearCeldas(d:FAC..i:FAC,'C')

SetFont(a:FAC..k:FAC,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))
AlinearCeldas(d:FAC..g:FAC,'C')

SetFilaActual(FAC)

*close    precio1
*bid      precio2
*ask      precio3
*promedio precio4

SQL.ADD("SELECT C1.Fecha, C1.Codigo,C1.Precio1, C1.Precio2, E.Extendido Nombre, C1.Precio4 , C1.Precio3, C1.CallPut,C1.Moneda,C1.FechaFut,C1.Mercado ")
SQL.ADD("FROM "~DBO~".COTIZACIONESFUT C1, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE C1.Codigo = E.Codigo AND C1.CallPut='FUT' ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("    AND  C1.Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
ENDIF

SQL.ADD("  AND (C1.Fecha>="~IdxDate2(Dialogo.Fecha1)~" and C1.Fecha<="~IdxDate2(Dialogo.Fecha2)~")   ")

IF Val(ab:1)<> 0  
SQL.ADD("  AND C1.FechaFut = '"~IdxDate(Dialogo.Fecha3)~"' ")
endif
if Novacio(Dialogo.Mercado1)
SQL.ADD("  AND C1.Mercado = '"~ Dialogo.Mercado1 ~"' ")
endif

SQL.ADD("ORDER BY C1.Codigo, C1.Fecha ")
WATCH(sql.batch())
Recorrer SQL
   ACT(b:fac, FBN['Codigo'])
   ACD(aa:fac,FBN['FechaFut'])

   IF Not CeldaVacia(aa:fac) 
   ACD(e:fac, FBN['FechaFut'])
   ENDIF
   
   IF NoVacio(FBN['Mercado'])
      ACT(a:fac, FBN['Mercado'])
   ENDIF
   ACD(d:fac, FBN['Fecha'])
   ACT(c:fac, FBN['Nombre'])
   ACN(f:fac, FBN['Precio1'])
   *IF FBN['Precio2'] <> 0   
   *ACN(g:fac, FBN['Precio2'])
   *Endif
   *IF FBN['Precio3'] <> 0
   *ACN(h:fac, FBN['Precio3'])
   *Endif
   IF FBN['Precio4'] <> 0
      ACN(g:fac, FBN['Precio4'])
   ENDIF
   *   ACT(j:fac, FBN['CallPut'])
   ACT(h:fac, FBN['Moneda'])
Proximo

ACO(1,6)
ACO(2,6)
ACO(3,20)
ACO(4,7)
ACO(6,9)
ACO(7,9)
ACO(8,9)
ACO(9,6)
*ACO(10,6)
*ACO(11,6)

SetFilaActual(fac+3)

Impresion(1,1)
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:FAC,2)
FormatoCeldas(f:Val(w1)+1..f:fac, Exe('F9'))
FormatoCeldas(g:Val(w1)+1..g:fac, Exe('F9'))
*FormatoCeldas(h:Val(w1)+1..h:fac, Exe('F9'))
*FormatoCeldas(i:Val(w1)+1..i:fac, Exe('F9'))
*LimitesVision(k:FAC)
LimitesVision(h:FAC)
RangoTitulo(a:1..h:FAC, Val(w1) )
