HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'    ;;;;  ;  ;Incluido(Dialogo.TipoOp1, 'FXOCTC|FXOCTV');'Operacion Invalida';NO;;;;;;" TipoOp IN ('FXOCTC','FXOCTV') ";
  TipoOp1     :                ;;;;NO;  ;;;;;BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1)
  Cliente1    :                ;;;;NO;  ;;;;;BuscarCampo('OPERACIONES','Cliente1','NrOperacion',Dialogo.NrOperacion1)
  Vehiculo1   :                ;;;;NO;  ;;;;;BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.NrOperacion1)
  String1     : 'Desc.Vehiculo';;;;NO;  ;;;;;BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1)
  Check1      : 'Impresora'    ;;;;  ;  ;;;;1;
FinDialogo
if not Ok
  Cancelar
endif

CrearFont(1, "Arial,6,")
CrearFont(2, "Arial,8,B")
CrearFont(4, "Arial,5,")
CrearFont(5, "Arial,8,")
CrearFont(6, "Arial,9,B")
CrearFont(7, "Arial,11,B")

ACT(VH:1, Dialogo.Vehiculo1)
ACT(CL:1, Dialogo.Cliente1)
ACT(DS:1, Dialogo.String1)

SQL.ADD(" Select CUIT, NrMAE, Direccion, CodigoPostal, Localidad, PaisDir, Telefono ")
SQL.ADD(" From "~DBO~".CLIENTES ")
SQL.ADD(" Where Codigo = '"~Val(VH:1)~"' ")

Recorrer SQL
    ACT(CT:1, fbn('CUIT'))
    ACT(NM:1, fbn('NrMAE'))
    ACT(DR:2, fbn('Direccion'))
    ACT(CP:1, fbn('CodigoPostal'))
    ACT(LC:2, fbn('Localidad'))
    ACT(PD:1, fbn('PaisDir'))
    ACT(TL:1, fbn('Telefono'))
Proximo

ACT(NP:1, BuscarCampo('PAISES','Nombre','Codigo', Val(PD:1)))

SetFilaActual(0)
SQL.ADD(" Select NrBoleto,       FechaOp,          FechaVto,      FechaEnvioMAE, NroAltaMAE,  ")
SQL.ADD("        Cliente1,       Especie,          Cantidad,      Precio1,       NrOperacion, ")
SQL.ADD("        TotalBrutoCli1, CantImpresiones1, NrBoleto,      ObsErrorMAE,   ContraEspecie2, ")
SQL.ADD("        MB3,            FechaAltaMAE,     TotalBrutoCli3 ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
    Recorrer&k 1, 2
        IF &k = 1
            SQL.ADD(" Select RazonSocial, Direccion, Localidad ")
            SQL.ADD(" From "~DBO~".CLIENTES ")
            SQL.ADD(" Where Codigo = '"~fbn('Cliente1')~"' ")
            Recorrer SQL
                DFA
                ACT(RZ:1, fbn('RazonSocial'))
                ACT(DR:1, fbn('Direccion'))
                ACT(LC:1, fbn('Localidad'))
            Proximo
        ELSE
            SetFilaActual(fac+4)
        ENDIF
        ACN(BD:1, fac)
        AgregarBMP(A:fac, Exe('LOGO'), Exe('ESCALOGO'))
        IF Eqstr(Dialogo.TipoOp1, 'FXOCTC')
            ACT(I:fac, 'Boleto de COMPRA OCT')
        ELSE
            ACT(I:fac, 'Boleto de VENTA OCT')
        ENDIF    
        SetFont(I:fac, 7)
        ifa
*        IF fbn('CantImpresiones1') = 0
*            IF &k = 1
*                ACT(BL:1, GetNumerador(89))
*            ENDIF
*        ELSE
            ACT(BL:1, fbn('NrBoleto'))
*        ENDIF
        ACT(I:fac, 'Boleto Nro.    : '~Val(BL:1))
        ifa
        ACT(A:fac, Val(DS:1))
        SetFont(A:fac, 6)
        ACT(I:fac, 'Fecha Operación: '~fbn('FechaOp'))
        ifa

        ACT(A:fac, 'C.U.I.T. Nro. ')
        ACT(A:fac, Val(A:fac)~Copy(Val(CT:1), 1, 2)~'-'~Copy(Val(CT:1), 3, 8)~'-'~Copy(Val(CT:1), 11, 1))
        ACT(A:fac, Val(A:fac)~' / Ag.Mercado Abierto Nro. '~Val(NM:1))
        SetFont(A:fac, 1)
        AgregarMarco(A:fac-3..D:fac, 1, 0)

        ACT(I:fac, 'Fecha Liquidación: '~fbn('FechaVto'))
        ifa
        ACT(I:fac, 'Hora MAE       : '~Hora(fbn('FechaAltaMAE')))
        ifa
        ACT(A:fac, 'Sr./es:')
        ACT(I:fac, 'Nro. MAE       : '~fbn('NroAltaMAE'))
        SetFont(I:fac-4..I:fac, 5)
        ifa
        ACT(A:fac, '              '~Val(RZ:1))
        ifa
        ACT(A:fac, '              '~Val(DR:1))
        ifa
        ACT(A:fac, '              '~Val(LC:1))
        SetFont(A:fac-3..A:fac, 6)
        SetFilaActual(fac+2)
*        IF fbn('CantImpresiones1') > 0
*            ACT(J:fac, 'REIMPRESION')
*            SetFont(J:fac, 2)
*        ENDIF
        SetFilaActual(fac+2)
        ACT(A:fac, 'Especie')
        ACT(C:fac, 'Fixing')
        ACT(e:fac, 'Contratos')
        ACT(g:fac, 'Cantidad')
        ACT(i:fac, 'Precio $')
        ACT(k:fac, 'Importe $')
        AlinearCeldas(e:fac..k:fac, 'D')
        SetFont(A:fac..K:fac, 6)
        AgregarMarco(A:fac..K:fac, 1, 0)
        ifa
*        ACT(A:fac, BuscarCampo('EQUIVALENCIA_ESPECIES','EspecieDestino2','EspecieDestino1', fbn('Especie'))~' '~fbn('FechaVto'))
        ACT(A:fac, SQL("Select EspecieDestino2 from "~DBO~".EQUIVALENCIA_ESPECIES where TipoCotizacion='O' and EspecieDestino1='"~fbn('Especie')~"' and TipoNegociacion='"~Copy(fbn('ObsErrorMAE'),1,1)~"' and EspecieOrigen='"~Copy(fbn('ObsErrorMAE'),2,5)~"' "))
        if Vacio(Val(a:FAC))
          ACT(A:fac, fbn('Especie'))
        endif
        ACT(A:fac, Val(a:FAC)~' '~fbn('FechaVto'))
**        ACT(c:fac, fbn('ContraEspecie2'))
        ACT(c:fac, BuscarCampo('ESPECIES','Nombre','Codigo',FBN['ContraEspecie2']))
        ACN(e:fac, fbn('TotalBrutoCli3'))
        ACN(g:fac, fbn('Cantidad'))
        ACN(i:fac, fbn('Precio1'))
        ACN(k:fac, fbn('TotalBrutoCli1'))
        FormatoCeldas(i:fac, Exe('F9'))
        ifa
        AgregarMarco(A:fac-1..K:fac, 1, 0)

        ifa
        ifa
        if EqStr(fbn('MB3'),'1')
           act(a:fac, 'Operación Con Garantía')
          else
           act(a:fac, 'Operación Sin Garantía')        
        endif
        SetFilaActual(fac+3)
        ACT(A:fac, 'Minuta: '~fbn('NrOperacion'))
        SetFont(A:fac-6..K:fac, 5)
        SetFilaActual(fac+3)
        ACT(H:fac, '____________________________________')
        ifa
        ACT(H:fac, '               Por Standard Bank')
        ifa
        IF &k = 1
            ACT(A:fac, 'Original Para el Cliente')
        ELSE
            ACT(A:fac, 'Copia Para el Banco')
        ENDIF
        SetFont(A:fac-9..K:fac, 5)
        ACT(D:fac, Val(DR:2)~' - '~Val(CP:1)~' '~Val(LC:2)~' - '~Val(NP:1)~' - Tel: '~Val(TL:1))
        SetFont(D:fac, 4)
        AgregarMarco(A:Val(BD:1)..K:fac, 1, 0)
        ifa
        IF &k = 1
if no
* fo 27/09/2006
            ACT(A:fac, 'En caso de que los terminos contenidos en la presente no coincidan con los de la operacion de referencia, toda observacion o solicitud de rectificacion solo sera valida si es efectuada mediante nota')
            ifa
            ACT(A:fac, 'por escrito dirigida por Uds. a Standard Bank -Suc. Argentina Dpto. de Compliance, o por e-mail a XXXXX dentro de las 24 horas habiles bancarias de concertada tal operacion.')
            ifa
            AgregarMarco(A:fac-2..K:fac, 1, 0)
            SetFont(A:fac-2..A:fac, 1)
endif
*
           ABT(a:FAC..J:FAC+2, LeerLeyenda('','','','CLIENTES'),1)
           SetFilaActual(FAC+3)
           Recorrer&i 1,10
              ACT(&i:FAC, ' ')
           Proximo
           AgregarMarco(A:fac-3..K:fac, 1, 0)
*
        ENDIF
        
        SaltarHoja(fac)
    Proximo
    SQL.ADD(" Update "~DBO~".OPERACIONES ")
    SQL.ADD(" Set CantImpresiones1 = "~fbn('CantImpresiones1')~" + 1 ")
    IF fbn('CantImpresiones1') = 0 O Vacio(fbn('CantImpresiones1'))
      SQL.ADD(" , NrBoleto = '"~Val(BL:1)~"' ")
    ENDIF
    SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
    SQL.NEW
    SQL.EXEC
Proximo

ACO(10,5)
ACO(11,8)
SetMargins(0,0,0,0)
LimitesVision(K:fac)

if Dialogo.Check1=1
  ImprimirHoja
endif
