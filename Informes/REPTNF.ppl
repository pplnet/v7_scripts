**PRECIO
HojaVisible(no)
CrearDialogo
**Hay algo raro en las fechas
  Fecha1 : 'Desde';1;1;;;;Dialogo.Fecha1>0 and Dialogo.Fecha1<=Dialogo.Fecha2;'Fecha Desde debe de ser menor a la Fecha Hasta';NO;Habiles(FSys,-1,'ARG');
  Fecha2 : 'Hasta';2;1;;;;Dialogo.Fecha2 <= FSYS;'Fecha Hasta debe ser menor a la Fecha Actual';NO;Habiles(FSys,-1,'ARG')
  Lista1 : 'Tipo de operación';3;1;;;;;;;;;VAR('PYLOPPRECI');SI
  Cliente1 : 'Cliente';4;1;;;;;;;;;;SI
  OficialCuenta:    'Oficial'    ;;;;;;;;;;;;;;  
  Radio1: 'Tipo|General|Tipo Operacion|Cliente|Detalle';;;;;;;;;0;
  Radio2: 'Origen|Precio|Tasa';;;;;NO;;;;;0;
Findialogo
If not OK 
Cancelar
EndIf
If Dialogo.Radio1 =0
    LinkearHoja('REPGEN',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2)
Else 
    If Dialogo.Radio1 = 1
        LinkearHoja('REPTOP',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2)
    Else
        If Dialogo.Radio1 = 2 
            LinkearHoja('REPCLI',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2)
        Else
            If Dialogo.Radio1 = 3
            LinkearHoja('REPDPR',0,Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2,Lista1 = Dialogo.Lista1,Cliente1 = Dialogo.Cliente1, OficialCuenta = dialogo.OficialCuenta, Radio1= Dialogo.Radio1, Radio2 = Dialogo.Radio2)
            EndIf
        EndIf
    EndIf
EndIf
    