ACT(ml1,var('MONELOCA'))
CrearDialogo
  Fecha1:    'Fecha'             ;;;;;;;;;FSYS
  Especie1 : 'Moneda'            ;;;;;;;;;;;;;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Especie2 : 'Expresado en'      ;;;;;;NoVacio(Dialogo.Especie2);'Moneda Invalida';NO;Var('MONELOCA');;Var('MONELOCA')~'|'~Var('MONEEXTR')~'|';;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Vehiculo1: 'Vehiculo'          ;;;;;;[NoVacio(Dialogo.Vehiculo1)] Y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) O Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;Var('VEHICULODE');;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo))," Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");;;;;
  Book1    : 'Book'              ;;;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Check1   : 'Excluye '~val(ml1) ;;;;;;;;;IIf(EqStr(BuscarCampo('VEHICULOS','Alias4','Codigo',Dialogo.Vehiculo1),'EXC$POSI'),1,0);IIf(EqStr(BuscarCampo('VEHICULOS','Alias4','Codigo',Dialogo.Vehiculo1),'EXC$POSI'),1,0);;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,8,BI")

AgregarBMP(a1,Exe('LOGO'),100)

ACT(b:3, 'Detalle Caja del dia por Moneda Expresado en '~IIF(Eqstr(Dialogo.Especie2,VAR('MONELOCA')),'$','U$S') )

SetFont(b:3, 3)
ACT(a:4, 'Fecha: '~Dialogo.Fecha1)
ACT(a:5, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
SetFont(a:3..z:6, 2)

SetFilaActual(7)
ACT(A:fac, 'Expresado en: '~Dialogo.Especie2)
ifa
IF NoVacio(Dialogo.Book1)
    ACT(A:fac, 'Book: '~Dialogo.Book1)
ELSE
    ACT(A:fac, 'Book: Todos')
ENDIF
SetFont(A:fac-1..A:fac, 2)

SetFilaActual(fac+2)
ACN(FI:1, fac)

ACT(a:fac, 'Moneda')
ACT(b:fac, 'Caja')
ACT(c:fac, 'Cotizacion')
ACT(d:fac, 'Monto')
ACT(e:fac, 'PPP')
ACT(f:fac, 'Caja Diaria')
ACT(g:fac, 'PPPDiario')


SetFont(a:fac..z:fac, 2)
AgregarMarco(a:fac..g:fac,0,0,Exe('COLOR6'))

SQL.ADD(" SELECT SUM(P.CantidadIni) CantidadIni, SUM(P.CantidadFin) CantidadFin, SUM(P.CantidadFin*P.PrecioFin) PPP,")
SQL.ADD(" SUM(P.Cantidad1*P.Precio1-P.Cantidad2*P.Precio2) PPPHoy, E.Nombre, P.NrSaldo, P.Especie, P.CallPut, ")
SQL.ADD(" P.PrecioEj, P.FechaEj, P.Book ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND    P.Especie  = E.Codigo ")
IF NoVacio(Dialogo.Book1)
    SQL.ADD(" AND P.Book = '"~Dialogo.Book1~"' ")
ENDIF
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND  P.Especie  = '"~Dialogo.Especie1~"' ")
Endif
IF Dialogo.Check1=1
   *- Excluye posicion de pesos del informe
    SQL.ADD(" AND P.Especie <> '"~val(ml1)~"' ")
ENDIF

SQL.ADD(" AND P.NrSaldo IN (51) ")
SQL.ADD(" AND    P.Cliente  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND    P.Fecha <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES  ")
SQL.ADD("                    WHERE  Especie  = P.Especie ")
                             If NoVacio(Dialogo.Especie1)
                                SQL.ADD(" AND Especie = '"~Dialogo.Especie1~"' ")
                             Endif
SQL.ADD("                    AND    Vehiculo = P.Vehiculo ")
SQL.ADD("                    AND    Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("                    AND    Cliente  = P.Cliente ")
SQL.ADD("                    AND    Cliente  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("                    AND    NrSaldo  = P.NrSaldo ")
SQL.ADD("                    AND    Book     = P.Book ")
SQL.ADD("                    AND    TipoNegocio = P.TipoNegocio ")
SQL.ADD("                    AND    (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL)) ")
SQL.ADD("                    AND    (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL)) ")
SQL.ADD("                    AND    (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL)) ")
SQL.ADD("                    AND    Fecha <= "~IdxDate2(Dialogo.Fecha1)~" ) ")
SQL.ADD(" GROUP BY P.NrSaldo, P.Especie, E.Nombre, P.PrecioEj, P.FechaEj, P.CallPut, P.CantidadFin, P.Book ")
SQL.ADD(" ORDER BY P.Book, P.NrSaldo, P.Especie, P.CallPut, P.FechaEj, P.PrecioEj ")

ACN(sa:1, 0)
ACT(ea:1, '')
ACN(FI:2, 0)

Recorrer SQL
 If fbn('CantidadFin')<>0
   ACN(BD:1, 0)
   IF Not Eqstr(fbn('Book'), Val(BK:1))
      ifa
      ACT(A:fac, 'Book: '~fbn('Book'))
      ACT(BK:1, fbn('Book'))
      SCN(FI:2, 1)
      ACT(BB:Val(FI:2), fbn('Book'))
      ACN(BD:1, 1)
      SetFont(A:fac, 4)
      AgregarMarco(a:fac..g:fac,0,0,EXE('COLOR8'))
      IF Not CeldaVacia(BK:1)
          
      ENDIF
   ENDIF
   If fbn('NrSaldo')<>Val(sa:1) O Val(BD:1) = 1
     ifa
     ACN(sa:1, fbn('NrSaldo'))
     ifa
     ACD(fj:1, 0)
     ACN(pj:1, 0)
     ACT(cp:1, '')
     ACT(ea:1, '')
   Endif

   If Eqstr(fbn('Especie'), Val(ea:1)) y Eqstr(fbn('CallPut'), Val(cp:1)) y fbn('PrecioEj')=Val(pj:1) y fbn('FechaEj')=Val(fj:1) Y Eqstr(fbn('Book'), Val(BK:1))
     dfa
   Else
     message(fbn('Especie'))
     ACD(fj:1, fbn('FechaEj'))
     ACN(pj:1, fbn('PrecioEj'))
     ACT(cp:1, fbn('CallPut'))
     ACT(ea:1, fbn('Especie'))
     ACT(BK:1, fbn('Book'))
   Endif

   If NoVacio(fbn('CallPut'))
     ACT(a:fac, fbn('Especie')~'/'~fbn('CallPut')~'/'~fbn('FechaEj')~'/'~PyC(fbn('PrecioEj'),1,8) ) 
   Else
     ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre')~' - '~fbn('FechaEj')) 
   Endif

   ACN(b:fac, fbn('CantidadFin'))
   ACN(e:fac, fbn('PPP') )
   ACN(e:fac, val(e:fac)/val(b:fac))

   If NoVacio(fbn('CallPut'))
      ACN(c:fac, CotizacionC(fbn('Especie'),fbn('CallPut'),fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
   Else
      ACN(c:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
   Endif
   ACN(d:fac, Val(b:fac)*Val(c:fac))

   *- Recupero de movposeje la caja de hoy
   SQL.ADD(" SELECT SUM(Cantidad1-Cantidad2) as Cantidad,")
   SQL.ADD("        SUM(Cantidad1*Precio1-Cantidad2*Precio2)/SUM(Cantidad1-Cantidad2) PPP ")
   SQL.ADD(" FROM "~DBO~".POSICIONES P ")
   SQL.ADD(" WHERE  P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" AND    P.Book = '"~fbn('Book')~"' ")
   SQL.ADD(" AND    P.Especie  = '"~fbn('Especie')~"' ")
   SQL.ADD(" AND    P.NrSaldo IN (51) ")
   SQL.ADD(" AND    P.Cliente  = '"~Dialogo.Vehiculo1~"' ")
   SQL.ADD(" AND    P.Fecha = "~IdxDate2(Dialogo.Fecha1)~" ") 
   If val(fj:1)>0
      SQL.ADD(" AND    P.FechaEj  ='"~fbn('FechaEj')~"'   ")
   EndIf
   If val(pj:1)>0
      SQL.ADD(" AND    P.PrecioEj = '"~fbn('PrecioEj')~"' ")
   EndIf
   If Not EqStr('',val(cp:1))
      SQL.ADD(" AND    P.CallPut  = '"~fbn('CallPut')~"'  ")
   EndIf
   Recorrer SQL
      dfa
      ACN(f:fac, fbn('Cantidad'))
      ACN(g:fac, fbn('PPP'))
   Proximo

   SCN(BC:Val(FI:2), Val(D:fac))
   SetFont(a:fac..g:fac,1)

   *-- CK1: Para linkear en pantalla ppal de posicion cantidad
   *-- CK2: Para linkear en pantalla ppal de posicion Precio Promedio
   SCN(ck1,val(f:fac))
   SCN(ck2,val(f:fac)*val(g:fac))
 Else
   dfa
 Endif

Proximo

ACN(XY1,FAC)

ACN(ck2,val(ck2)/val(ck1))

ifa
ifa
ACN(d:fac, SUM(d:9..d:fac-1))
ACT(e:fac, IIF(Eqstr(Dialogo.Especie2,VAR('MONELOCA')),'$','U$S') )
SetFont(d:fac..e:fac,4)

FormatoCeldas(b:9..d:fac, EXE('F2'))
FormatoCeldas(c:9..c:fac, EXE('F9'))
FormatoCeldas(e:9..e:fac, EXE('F9'))
FormatoCeldas(g:9..g:fac, EXE('F9'))

ACO(1,18)
ACO(2,12)
ACO(3,12)
ACO(4,12)
ACO(5,12)

ifa
ifa
ifa
ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac,2)

Impresion(4, 1)
LimitesVision(g:fac+2)
RangoTitulo(A:1..E:fac+1, Val(FI:1))


