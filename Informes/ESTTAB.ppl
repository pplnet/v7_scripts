ModoReproceso(SinDialogo)
CrearDialogo
  String : 'Tabla'
  Radio1 : 'Orden|Nombre|Tipo';;;;;;;;;0
FinDialogo

If Not Ok
   Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:2,'ESTRUC')
SetFont(a:2..a:2,1)

ACT(e:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))

SetFont(e:2..e:2,1)

SetFilaActual(4)
ACN(w1,fac)
ACT(a:fac, "Estructura de una Tabla")
SetFont(a:fac..a:fac,3)

SetFilaActual(fac+2)

ACT(a:fac,   'Tabla: '~Dialogo.String)
SetFont(a:fac..b:fac+1,2)

SetFilaActual(fac+2)
ACT(a:fac,   'Nombre')
SetFont(a:fac..a:fac,3)

ACT(b:fac,   'Tipo')
SetFont(a:fac..a:fac,3)

ACT(c:fac,   'Longitud')
SetFont(a:fac..a:fac,3)

AgregarMarco(a:fac..h:fac,2,0,Exe('COLOR'))
SetFont(a:fac..m:fac,2)

ACN(w1,fac)

Recorrer ("sp_columns  "~Dialogo.String)
    ACT(a:FAC, FBN['COLUMN_NAME'])
    ACT(b:FAC, FBN['TYPE_NAME'])
    ACT(c:FAC, FBN['LENGTH'])
    SetFont(a:FAC..C:FAC,1)
proximo

If Dialogo.Radio1=0
   *-  Radio1 : 'Orden|ID|Nombre|Tipo';;;;;;;;;0
   OrdenarFilas(val(w1)+1,FAC,1,'A')
Else 
   OrdenarFilas(val(w1)+1,FAC,2,'A')
EndIf




ACO(1, 20)
ACO(2, 15)
ACO(3, 12)

SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac..a:fac,2)
LimitesVision(val(w1):fac)
SetPrintFit(2)
