* Control del Cotizaciones Actualizadas por el MAE
ModoReproceso(ConDialogo)
GrillaVisible(SI)
CrearDialogo
   Fecha1   : 'Fecha';;;;;;;;;FSys
*  Fecha1     : "F.Desde"    ;;;;;;Dialogo.Fecha1<=FSys Y Dialogo.Fecha1<>0 ;"Fecha Desde Incorrecta";NO;;PriDeMes(Dialogo.Fecha2,NO)
*  Fecha2     : "F.Hasta"    ;;;;;;Dialogo.Fecha2<=Habiles(FSys,1) Y Dialogo.Fecha2>=Dialogo.Fecha1 ;"Fecha Hasta Incorrecta";NO;FSYS
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Cotizaciones de Especies con SALDO ')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)
*ACT(a2, 'Fecha desde: '~Dialogo.Fecha1)
*ACT(a3, 'Fecha hasta: '~Dialogo.Fecha2)

ACT(a5, 'Especie')
ACT(b5, 'Nombre')
ACT(c5, 'Fecha')
ACT(D5, 'Cotizacion')
ACT(E5, 'Moneda')

SetFilaActual(5)

SQL.ADD("Select CO.Codigo, CO.Precio1, CO.Fecha from "~DBO~".COTIZACIONES CO        ")
*SQL.ADD(" where CO.Codigo in  (select Distinct Especie from "~DBO~".SALDOS )        ")
SQL.ADD(" where CO.Codigo in  (select distinct Especie from dbo.SALDOSDIA S1         ")
SQL.ADD("                      where 0 not in(select SUM(Saldo) from dbo.SALDOSDIA S2 ")
SQL.ADD("                      where S1.Especie = S2.Especie and S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD("       AND CO.Codigo <> '"~VAR('MONELOCA')~"'                              ")            
SQL.ADD("       AND CO.Fecha  >=  (select Max(C.Fecha) from "~DBO~".COTIZACIONES C  ")
SQL.ADD("                          Where  C.Codigo = CO.Codigo)                     ")
SQL.ADD("       AND  CO.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"'                      ")
SQL.ADD(" Order By CO.Codigo                                                        ")

*SQL.ADD("select Distinct Especie from "~DBO~".SALDOSDIA                 ")
*SQL.ADD(" Where Especie in (select Codigo from "~DBO~".ESPECIES )       ")
*SQL.ADD("  and   Fecha <= '"~IdxDate(Dialogo.Fecha2)~"'                 ")
*SQL.ADD("  and   Fecha >= '"~IdxDate(Dialogo.Fecha1)~"'                 ")
*SQL.ADD(" Order By Especie                                              ")

recorrer SQL
*     If DesciendeDeEspecie(fbn('Especie'),'TITULO')
      ACT(a:fac, fbn('Codigo'))
      ACT(b:fac, BuscarCampo('ESPECIES','Nombre','Codigo',Val(a:fac)))

      SQL.ADD("Select CO.Codigo, CO.Precio1, CO.Fecha, CO.Moneda from "~DBO~".COTIZACIONES CO       ")
      SQL.ADD(" where CO.Codigo = '"~Val(a:fac)~"'   and                                 ")
      SQL.ADD("       CO.Fecha =   (select Max(C.Fecha) from "~DBO~".COTIZACIONES C      ")
      SQL.ADD("                      Where  C.Codigo = '"~Val(a:fac)~"'   AND            ")
      SQL.ADD("                             C.Fecha <=  '"~IdxDate(Dialogo.Fecha1)~"' )  ")
      SQL.ADD(" Order By CO.Codigo                                                       ")

      Recorrer SQL
         dfa
         ACD(c:fac, fbn('Fecha'))
         ACN(D:fac, fbn('Precio1'))
         ACT(e:fac, fbn('Moneda'))
      Proximo

      if Val(d:fac) = 0.0
         ColorCeldas(a:fac..c:fac,clRED)
         SetFont(a:fac..e:fac, 1)
      else
         SetFont(a:fac..e:fac, 2)
      endif

*    else
*      DFA
*    endif
proximo

ACO(2,20)
ACO(3,15)
ACO(4,15)

SetFont(a1..z5, 1)


AgregarMarco(a5..e5,1,0,Exe('COLOR'))
AgregarMarco(a5..a:fac,1,0)
AgregarMarco(b5..b:fac,1,0)
AgregarMarco(c5..c:fac,1,0)
AgregarMarco(d5..d:fac,1,0)
AgregarMarco(e5..e:fac,1,0)
AgregarMarco(a5..e:fac,1,0)

FormatoCeldas(d6..d:fac,Exe('F7'))

ACT(a:FAC+2, 'FIN DEL LISTADO')
SetFont(a:FAC+2..a:FAC+2, 1)

Impresion(1,1)
LimitesVision(F:FAC+3)
RangoTitulo(a:1..e:fac+3,3)

