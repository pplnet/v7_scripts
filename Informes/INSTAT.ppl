HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
   Operador1    : "Usuario"              ;;;;;;;;;;;
   NrTrans1     : 'Nr.Transacc.'         ;;;;;;;;;;;;;;;;
   Fecha2       : "F.Desde"              ;;;;;;Vacio(Dialogo.Fecha2) o Dialogo.Fecha2<=Dialogo.Fecha1;'Fecha Desde Vacia o Inferior a Fecha Hasta';NO;;
   Fecha1       : "F.Hasta"              ;;;;;;Dialogo.Fecha1>0;'Debe ingresar una Fecha Hasta';NO;FSys;
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


  SetFilaActual(1)
  ACT(a:1,'SIAF Auditoria - CONFIDENCIAL')
  SetFont(a:1,1)


SetFilaActual(fac+2)
ACT(b:fac, 'Listado de Auditor¡a de Instancias de Aprobaci¢n')
SetFont(b:fac, 3)

SetFilaActual(fac+1)
if NoVacio(Dialogo.Operador1)
  ACT(a:fac+1, 'Usuario: '~Dialogo.Operador1)
else
  ACT(a:fac+1, 'Usuario: Todos')
endif

SetFilaActual(fac+1)

if NoVacio(Dialogo.NrTrans1)
  ACT(a:fac+1, 'Nro.Operacion: '~Dialogo.NrTrans1)
else
  ACT(a:fac+1, 'Nro.Operacion: Todos')
endif

if Dialogo.Fecha2 > 0
  SetFilaActual(fac+1)
  ACT(a:fac+1, 'Fecha Desde: '~Dialogo.Fecha2)
endif

SetFilaActual(fac+1)
ACT(a:fac+1, 'Fecha Hasta: '~Dialogo.Fecha1)


SetFilaActual(fac+3)


ACT(A:fac,'Nro.Transacc')
ACT(B:fac,'Instancia')
ACT(C:fac,'Descripcion')
ACT(D:fac,'Usuario')
ACT(E:fac,'Nombre')
ACT(F:fac,'Mensaje')
ACT(G:fac,'Fecha')
ACT(h:fac,'Estado')
ACT(i:fac,'Actual')

AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))
Setfont(a2..i:fac, 1)
AlinearCeldas(A:fac..i:fac, 'C')

*--  Vehiculos permitidos por el usuario
   ACT(z1,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

*--  Select

  SQL.ADD(" Select a.nroperacion,  a.nrinstancia, a.usuario, a.mensaje, a.fecha, b.nombre Descr, c.nombre, substring(a.nroperacion, 1, 1) TAAA  " )
  SQL.ADD("   from   "~DBO~".Instanciasop a, "~DBO~".Instancias b, "~DBO~".Usuarios c  " )
  SQL.ADD("        ,  "~DBO~".transacciones2 d  " )
  SQL.ADD("   where a.NrInstancia = b.NrInstancia ")
  SQL.ADD("     and b.tabla = 'TRANSACCIONES2'       ")
  SQL.ADD("     and a.nroperacion = d.nrtrans       ")
  SQL.ADD("     and c.codigo = a.usuario          ")
*  SQL.ADD("     and substring(a.nroperacion, 1, 1) in ('A', 'C', 'D', 'E', 'P', 'R', 'T') ")


If NoVacio(Dialogo.Operador1)
     SQL.ADD("and a.usuario ='"~Dialogo.Operador1~"' ")
Endif

If NoVacio(Dialogo.NrTrans1)
     SQL.ADD("and a.nroperacion ='"~Dialogo.NrTrans1~"' ")
Endif

If Dialogo.Fecha2 > 0
     SQL.ADD("and a.fecha >= '"~idxdate(Dialogo.Fecha2)~"' ")
Endif

If NoVacio(Dialogo.Fecha1)
     SQL.ADD("and a.fecha < '"~idxdate(Dialogo.Fecha1+1)~"' ")
Endif

SQL.ADD("order by a.nroperacion, a.fecha desc, a.usuario")

acn(z3,0)
acn(z2,0)
ACT(Z4, 'O')

ACN(FI:1, fac+1)
Recorrer SQL
    ACT(a:fac,FBN['Nroperacion'])
    ACLT(a:fac,Val(a:fac))
    ACT(b:fac,FBN['Nrinstancia'])
    ACT(c:fac,FBN['Descr'])
    ACT(d:fac,FBN['Usuario'])
    ACT(e:fac,FBN['Nombre'])
    ACT(f:fac,FBN['Mensaje'])
    ACT(g:fac,FBN['Fecha'])
    IF eqstr(val(Z4),FBN['Nroperacion'])
    else
         ACN(z2,SQL("Select NrBit from "~DBO~".OPERACIONESBITS where nroperacion ='"~FBN['Nroperacion']~"' and valor = '1' "))
         ACT(z3,SQL("Select Nombre from "~DBO~".Instancias     where NrInstancia = '"~val(z2)~"' and tabla = 'TRANSACCIONES2' "))
         ACN(h:fac,val(z2))
         ACT(i:fac,val(z3))
         ACT(z4,FBN['Nroperacion'])
    endif
    SetFont(a:fac..i:fac, 2)
Proximo
Ifa
Ifa

