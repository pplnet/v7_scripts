CrearDialogo
  #ifdef STD_CORP
    Radio4:       'Valuacion|Oficial|USD Alternativo'               ;1;2;;;;;;;0;;;
  #endif
  Fecha1     : "Fecha :"              ;1;1;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Especie1   : "Especie"              ;2;1;
  Radio2     : 'Expresado en|ARP|USD' ;3;1;;;;;;;0
  Radio1     : 'Filtra Book|SI|NO'    ;4;1;;;;;;;1;
  Lista1     : 'Vehiculos'            ;5;1;;;Dialogo.Radio1=1;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Vehiculo1  : 'Vehiculo'             ;0;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O NoVacio(Dialogo.Vehiculo1) ;'Vehiculo Invalido';NO;;;;;;;
  Lista2     : 'Books'                ;1;1;;;Dialogo.Radio1=0;;;;;;SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' ");;
  Radio5     : 'TipoEsp|Letra|Titulo' ;;;;;;;;;1;;;;;;;;;;
  Radio3     : 'Expresado en|Millones|ImporteOri'      ;;;;;;;;;1
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

****Si No se filtra por books
    IF Dialogo.Radio1 = 1
    ****Si se eligen Vehiculos (lista1)    
        If NoVacio(Dialogo.Lista1)
            Let &Vehiculo Dialogo.Lista1
        Else
            Let &Vehiculo SQLSET("Select V.Codigo from "~DBO~".VEHICULOS V,"~DBO~".USRVEHICULO U where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') ")
                If Vacio(&Vehiculo)
                    Let &Vehiculo SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')")
                EndIf
        EndIf
    Else
***Si se filtra por books, Vehiculo pasa a ser Vehiculo1
        let &Vehiculo Dialogo.Vehiculo1
        ****Si se eligen Books (lista2)
            If NoVacio(Dialogo.Lista2)
                Let &Book Dialogo.Lista2
            Else
                Let &Book SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~&Vehiculo~"' ")
            EndIf    
    EndIf
****Si se selecciona Especie
    If NoVacio(Dialogo.Especie1)
        let &Especie Dialogo.Especie1
    Else
        let &Especie SQLSET("Select Codigo from "~DBO~".ESPECIES Where (Status='HAB' or Status Is Null or Status='')")
    EndIf

CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,15,B")

***Insertar Logo
let &filaLogo 1
@LOGO

let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa CotizacionBNA(&monedaExtr,Dialogo.Fecha1-1,1,NO,NO)
let &cotDolBillete CotizacionBNA(&dolBillete,Dialogo.Fecha1-1,1,NO,NO)
IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF

SetFilaActual(fac+1)
ACT(D:FAC, "Posición de Titulos")
SetFont(D:fac..D:fac,3)

SetFilaActual(fac+5)
let &Inicio FAC

ACT(a:FAC, 'Fecha: '~Dialogo.Fecha1)

***Si no se filtra por book
    If Dialogo.Radio1=1
       if NoVacio(Dialogo.Lista1)
            ACT(a:FAC+1, 'Vehiculo : '~&Vehiculo)
            ACT(A:FAC+2,'Book : Todos')
        else
            ACT(a:FAC+1, 'Vehiculo : Todos')
            ACT(A:FAC+2,'Book : Todos')
            
        Endif
***Si se filtra por book
    Else
        IF NoVacio(Dialogo.Lista2)
            ACT(a:FAC+1, 'Vehiculo : '~&Vehiculo)
            ACT(A:FAC+2,'Book : ' ~&Book)
        Else
            ACT(a:FAC+1, 'Vehiculo : '~&Vehiculo)
            ACT(A:FAC+2,'Book : Todos')
        Endif
    EndIf

SetFilaActual(FAC+3)

****Si selecciona especie:
    If NoVacio(Especie1)
        ACT(A:FAC, 'Especie : '~&Especie)
    Else
        ACT(A:FAC,'Especie : Todas')
    Endif
SetFilaActual(FAC+1)
****Expresado en:
    If Radio2=0
        ACT(A:FAC, '(Expresado en ARP)')
    Else
        ACT(A:FAC, '(Expresado en USD)')
    Endif

****Divisa y Billete
SetFilaActual(fac+1)

ACT(A:fac, 'TC Divisa:')
ACN(B:fac, &cotDolDivisa)
ifa
ACT(A:fac, 'TC Billete:')
ACN(B:fac, &cotDolBillete)
ifa
IF Dialogo.Radio3 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF

#ifdef STD_CORP
    ifa
    ACT(A:fac, 'Valuacion: ')
    IF Dialogo.Radio4 = 0
        ACT(A:fac, Val(A:fac )~'Oficial')
        ifa
        ACT(A:fac, 'BNA')
        ACN(B:fac, &cotDolDivisa)
    ELSE
        ACT(A:fac, Val(A:fac )~'Alternativa')
        ifa
        ACT(A:fac, 'USMEP')
        ACN(B:fac, CotizacionBNA('USMEP',Dialogo.Fecha1-1,1,NO,NO))
        ifa
        ACT(A:fac, 'USCCL')
        ACN(B:fac, CotizacionBNA('USCCL',Dialogo.Fecha1-1,1,NO,NO))
    ENDIF
#endif
FormatoCeldas(A:fac-3..B:fac, Exe('F8'))
FormatoCeldas(A:fac..B:fac, Exe('F8'))
SetFont(A:&Inicio..A:FAC,2)
SetFont(B:&Inicio..B:FAC,2)
ifa

SetFilaActual(FAC+2)

act(a:fac,'FideiComiso')
act(b:fac,'Cartera')
act(c:fac,'Especie')
act(d:fac,'Moneda')
act(e:fac,'Nominales')
act(f:fac,'Precio')
act(g:fac,'Posicion')
act(h:fac,'Posicion en '~&monedaLocal)

SetFont(a:fac..i:fac,2)
AgregarMarco(a:fac..H:fac,2,0,Exe('COLOR'))
AgregarMarco(b:fac..b:fac,2,0,Exe('COLOR'))
AgregarMarco(c:fac..c:fac,2,0,Exe('COLOR'))
AgregarMarco(d:fac..d:fac,2,0,Exe('COLOR'))
AgregarMarco(e:fac..e:fac,2,0,Exe('COLOR'))
AgregarMarco(f:fac..f:fac,2,0,Exe('COLOR'))
AgregarMarco(g:fac..g:fac,2,2,Exe('COLOR'))
AgregarMarco(h:fac..h:fac,2,2,Exe('COLOR'))
*********************SENTENCIA SQL********************************

*2) Deberá buscar las posiciones (tabla POSICIONES2) con NrSaldo = 1,
*de todas las especies que descienden de TITULO

SQL.ADD(" Select P.Book, P.Especie, P.NrSaldo, P.CantidadFin /"~Fstr(&unidad, 0, 0)~" Nominales , P.Vehiculo, E.Codigo, E.MonedaEmision Moneda, ")
SQL.ADD(" E.Cotiza, E.Alias6 EspecieVinculada, E.MonedaEmision, E.Alias4 TCValuacion ")
SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
SQL.ADD(" Where E.Codigo = P.Especie ")
SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(E.Codigo,'TITULO') = 1")
IF Dialogo.Radio5 = 0
    SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(E.Codigo,'LETRA') = 1")
ELSE
    SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(E.Codigo,'LETRA') <> 1")
ENDIF
****Filtro por vehiculo
    If Dialogo.Radio1=1
       SQL.ADD(" AND P.Vehiculo in ("~Pipe2Comillas(&Vehiculo)~")")
    Else
       SQL.ADD(" AND P.Vehiculo in ("~Pipe2Comillas(&Vehiculo)~")")
       SQL.ADD(" AND P.Book in ("~Pipe2Comillas(&Book)~")")
    EndIf
****Filtro por Especie, si no hay filtro traigo todas.
    If NoVacio(Dialogo.Especie1)
        SQL.ADD(" AND E.Codigo = '"~&Especie~"'")
    EndIf
SQL.ADD(" AND P.NrSaldo = 1")
SQL.ADD(" AND P.Fecha = '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" Order By P.Book, Moneda ")

*****************************************************************
*** Variables para control
let &BookCheck ''
let &Moneda1 ''
let &Moneda2 ''
**** Variables para subtotales:
let &SubtotalM1 0
let &SubtotalM2 0
**** Variables para totales por book:
let &TotalBookM1 0
let &TotalBookM2 0
**** Variables para totales generales:
let &TotalInformeM1 0
let &TotalInformeM2 0
*** Variables para formato de Celdas
let &FilaInicialFormato fac+1
let &FilaFinalFormato fac+1

Recorrer SQL
    let &precioEspecie Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    #ifdef STD_CORP
        IF Dialogo.Radio4 = 1 Y NoVacio(fbn('TCValuacion'))
            ***---Hay que tomar TC Valuacion
            let &cotVehiculo CotizacionBNA(fbn('TCValuacion'),Dialogo.Fecha1-1,1,NO,NO)
        ENDIF
    #endif
    ***---Determino TC a utilizar
    IF Not Eqstr(fbn('MonedaEmision'), &monedaLocal)
        ***---USD
        IF NoVacio(fbn('EspecieVinculada'))
            ***---Bono en USD que tiene cotizaciones en ARP y en USD, 
            IF Eqstr(&monedaInforme, &monedaLocal)
                IF Eqstr(fbn('Cotiza'), &monedaLocal)
                    ***---Moneda del informe ARP y Cotiza en ARP => Tomo precio del bono
                    let &tc 1
                ELSE
                    ***---Moneda del informe = ARP y Cotiza en USD => Tomo precio del bono "Vinculado", que estará en ARP
                    let &tc 1
                    let &precioEspecie Cotizacion(fbn('EspecieVinculada'),,,,Dialogo.Fecha1,1,SI)
                ENDIF
            ELSE
                IF Eqstr(fbn('Cotiza'), &monedaLocal)
                    ***---Moneda del informe = USD y Cotiza en ARP, se toma precio del bono y se pasa a USD con BNA
                    let &tc 1/&cotVehiculo
                ELSE
                    ***---Moneda del informe = USD y Cotiza en USD => se toma el precio en ARP del bono "Vinculado" y se lo pasa a USD con BNA
                    let &tc 1/&cotVehiculo
                    let &precioEspecie Cotizacion(fbn('EspecieVinculada'),,,,Dialogo.Fecha1,1,SI)
                ENDIF
            ENDIF
        ELSE
            ***---Caso DNU 668 => se pasa a ARP con BNA
            IF Eqstr(&monedaInforme, fbn('Cotiza'))
                let &tc 1
            ELSE
                IF Eqstr(&monedaInforme, &monedaLocal)
                    let &tc &cotVehiculo
                ELSE
                    let &tc 1/&cotVehiculo
                ENDIF
            ENDIF
        ENDIF
    ELSE
        ***---ARP. Incluye bonos DNU 668
        IF Eqstr(&monedaInforme, fbn('Cotiza'))
            let &tc 1
        ELSE
            IF Eqstr(&monedaInforme, &monedaLocal)
                let &tc &cotVehiculo
            ELSE
                let &tc 1/&cotVehiculo
            ENDIF
        ENDIF   
    ENDIF
    

    
****Chequeo si la cartera/book es el igual al anterior, o si está en blanco
    if EqStr(&BookCheck, FBN['Book'] ) O EqStr(&BookCheck, '')
    ****Chequeo si la Especie es la misma del registro anterior, o si es el primer registro. 
    ****No es necesario chequear subtotales en otras monedas porque el query viene en orden
        if EqStr(&Moneda1, FBN['Moneda'] ) O EqStr(&Moneda1, '')
        ****Muestro datos
            ACT(A:Fac, FBN['Vehiculo'])
            ACT(B:Fac, FBN['Book'])
            ACT(C:Fac, FBN['Especie'])
            ACT(D:Fac, FBN['Moneda'])
            ACN(E:Fac, FBN['Nominales'])
            ***--- ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,&monedaInforme))
            ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,fbn('Cotiza')))
            ACN(F:fac, &precioEspecie)
            ACN(G:Fac, (FBN ['Nominales'] * Val(F:FAC)))
            ACN(H:Fac, (Val(G:Fac) * &tc))
        ****Flags 
            let &BookCheck FBN['Book']
            let &Moneda1 FBN['Moneda']
        ****Sumatorias
            let &SubtotalM1 &SubtotalM1+Val(H:Fac)
            let &TotalBookM1 &TotalBookM1+Val(H:Fac)
            let &TotalInformeM1 &TotalInformeM1+Val(H:Fac)
       Else
            let &Moneda2 FBN['Moneda']
       EndIf
       ****Si el registro actual no usa Especie 1, se procesa como Especie 2.
           If EqStr(&Moneda2, FBN['Moneda'] ) Y NoVacio(&Moneda1)
           ****chequea si hay subtotal en Moneda 1
               If &SubtotalM1 <> 0
                  ACT(B:Fac, 'Subtotal '~&Moneda1~ ': ')
                  ACN(H:Fac,  &SubtotalM1)
                  AgregarMarco(a:fac..H:fac,0,0,Exe('COLOR'))
                  SetFont(A:fac..H:fac,2)
                  ifa
                  let &SubtotalM1 0
            EndIf
       ****Muestro datos     
           ACT(A:Fac, FBN['Vehiculo'])
           ACT(B:Fac, FBN['Book'])
           ACT(C:Fac, FBN['Especie'])
           ACT(D:Fac, FBN['Moneda'])
           ACN(E:Fac, FBN['Nominales'])
           ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,&monedaInforme))
           ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,fbn('Cotiza')))
           ACN(F:fac, &precioEspecie)
           ACN(G:Fac, (FBN ['Nominales'] * Val(F:FAC)))
           ACN(H:Fac, (Val(G:Fac) * &tc))
       ****Flags 
           let &BookCheck FBN['Book']
           let &Moneda2 FBN['Moneda']
       ****Sumatorias
           let &SubtotalM2 &SubtotalM2+Val(H:Fac)
           let &TotalBookM2 &TotalBookM2+Val(H:Fac)
           let &TotalInformeM2 &TotalInformeM2+Val(H:Fac)
       EndIf
       ****Aquí se pueden seguir agregando más monedas, en caso de ser necesario.
          
****Si el Book es distinto, primero proceso los subtotales y totales del anterior:    
    else
    ****Chequea si hay Subtotal en Moneda 1
        If &SubtotalM1 <> 0
            ACT(B:Fac, 'Subtotal '~&Moneda1~ ': ')
            ACN(H:Fac,  &SubtotalM1)
            AgregarMarco(a:fac..H:fac,0,0,Exe('COLOR'))
            SetFont(A:fac..H:fac,2)
            ifa
            let &SubtotalM1 0
        EndIf
    ****chequea si hay Subtotal en Moneda 2
        If &SubtotalM2 <> 0
           ACT(B:Fac, 'Subtotal '~&Moneda2~ ': ')
           ACN(H:Fac,  &SubtotalM2)
           AgregarMarco(a:fac..H:fac,0,0,Exe('COLOR'))
           SetFont(A:fac..H:fac,2)
           ifa
           Let &SubtotalM2 0
        EndIf
    ****Total por Book  
        If &TotalBookM1+&TotalBookM2 <> 0
           ACT(a:Fac, 'TOTAL ' ~&BookCheck~ ' :')
           ACN(H:Fac,  &TotalBookM1+&TotalBookM2)
           AgregarMarco(a:fac..H:fac,2,0)
           SetFont(A:fac..H:fac,2)
           let &TotalBookM2 0
           let &TotalBookM1 0
        EndIf
        ****Flags 
           let &BookCheck FBN['Book']
        ****Chequeo si el nuevo book comienza con Moneda 1
        if EqStr(&Moneda1, FBN['Moneda'] )
        ****Muestro datos
            ifa
            ACT(A:Fac, FBN['Vehiculo'])
            ACT(B:Fac, FBN['Book'])
            ACT(C:Fac, FBN['Especie'])
            ACT(D:Fac, FBN['Moneda'])
            ACN(E:Fac, FBN['Nominales'])
            ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,&monedaInforme))
            ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,fbn('Cotiza')))
            ACN(F:fac, &precioEspecie)
            ACN(G:Fac, (FBN ['Nominales'] * Val(F:FAC)))
            ACN(H:Fac, (Val(G:Fac) * &tc))
        ****Sumatorias
            let &SubtotalM1 &SubtotalM1+Val(H:Fac)
            let &TotalBookM1 &TotalBookM1+Val(H:Fac)
            let &TotalInformeM1 &TotalInformeM1+Val(H:Fac)
       EndIf
        ****Si el registro actual no usa Moneda 1, se procesa como Moneda 2.
           If EqStr(&Moneda2, FBN['Moneda'])
       ****Muestro datos     
           ifa
           ACT(A:Fac, FBN['Vehiculo'])
           ACT(B:Fac, FBN['Book'])
           ACT(C:Fac, FBN['Especie'])
           ACT(D:Fac, FBN['Moneda'])
           ACN(E:Fac, FBN['Nominales'])
           ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,&monedaInforme))
           ***---ACN(F:Fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,fbn('Cotiza')))
           ACN(F:fac, &precioEspecie)
           ACN(G:Fac, (FBN ['Nominales'] * Val(F:FAC)))
           ACN(H:Fac, (Val(G:Fac) * &tc))
       ****Sumatorias
           let &SubtotalM2 &SubtotalM2+Val(H:Fac)
           let &TotalBookM2 &TotalBookM2+Val(H:Fac)
           let &TotalInformeM2 &TotalInformeM2+Val(H:Fac)
       EndIf
   EndIf
let &FilaFinalFormato &FilaFinalFormato+1
proximo
ifa

**** Totales
****chequea si hay subtotal en Moneda 1
    If &SubtotalM1 <> 0
        ACT(B:Fac, 'Subtotal '~&Moneda1~ ': ')
        ACN(H:Fac,  &SubtotalM1)
        AgregarMarco(a:fac..H:fac,0,0,Exe('COLOR'))
        SetFont(A:fac..H:fac,2)
        ifa
        let &SubtotalM1 0
    EndIf
****chequea si hay Subtotal en Moneda 2
    If &SubtotalM2 <> 0
    ACT(B:Fac, 'Subtotal '~&Moneda2~ ': ')
        ACN(H:Fac,  &SubtotalM2)
        AgregarMarco(a:fac..H:fac,0,0,Exe('COLOR'))
        SetFont(A:fac..H:fac,2)
        ifa
        let &SubtotalM2 0
    EndIf
  ****Total por Book    
    If &TotalBookM1+&TotalBookM2 <> 0
           ACT(a:Fac, 'TOTAL ' ~&BookCheck~ ' :')
           ACN(H:Fac,  &TotalBookM1+&TotalBookM2)
           AgregarMarco(a:fac..H:fac,2,0)
           SetFont(A:fac..H:fac,2)
           let &TotalBookM2 0
           let &TotalBookM1 0
        EndIf
***Formato Celdas
    FormatoCeldas(E:&FilaInicialFormato..E:fac,Exe('F2'))
    FormatoCeldas(F:&FilaInicialFormato..F:fac,Exe('F8'))
    FormatoCeldas(G:&FilaInicialFormato..G:fac,Exe('F2'))
    FormatoCeldas(H:&FilaInicialFormato..H:fac,Exe('F2'))
    ****Totales Informe:
    SetFilaActual(fac+2)
****Total Moneda 1    
        let &FilaInicialFormatoTotal fac
        ACT(A:Fac, 'TOTAL '~&Moneda1~': ' )
        ACN(B:Fac,  &TotalInformeM1)
        AgregarMarco(a:fac..B:fac,2,0)
        SetFont(A:fac..H:fac,2)
        ifa
        ****Total Moneda 2    
        ACT(A:Fac, 'TOTAL '~&Moneda2~': ' )
        ACN(B:Fac,  &TotalInformeM2)
        AgregarMarco(a:fac..B:fac,2,0)
        SetFont(A:fac..H:fac,2)
        ****Formato Totales
        FormatoCeldas(B:&FilaInicialFormatoTotal..B:fac,Exe('F2'))
        ifa
        
ACO(1, 10)
ACO(2, 10)
ACO(3, 7)
ACO(4, 7)
ACO(5, 10)
ACO(6, 10)
ACO(7, 10)
ACO(8, 10)

SetFilaActual(fac+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(h:fac)
RangoTitulo(a1..h:fac,13)