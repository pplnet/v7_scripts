CrearDialogo
   Fecha1:      'Fecha'    ;;;;;;;;;FSYS
   Book1:       'Book'     ;;;;;;;;;
   Especie1:    'Especie'  ;;;;;;;;;
FinDialogo

If not OK
   Cancelar
Endif

IFA
ACT(a:fac, "Fecha")
ACD(b:fac, Dialogo.Fecha1)
IFA
ACT(a:fac, "Book")
ACT(b:fac, Dialogo.Book1)
IFA
IFA
ACT(a:fac, "Codigo")
ACT(b:fac, "Nombre")
ACT(c:fac, "Moneda")
ACT(d:fac, "TipoValuacionActual")
ACT(e:fac, "FechaUltimaCotizacion")
ACT(f:fac, "PrecioContadoCierreDirty")
ACT(g:fac, "PrecioCotizacionDeterminada")
ACT(h:fac, "PlazoLiquidacion")
ACT(i:fac, "CodigoBook")
ACT(j:fac, "ModeloNegocio")

AgregarMarco(a:fac..j:fac, 2,2, Exe('COLOR'))

IFA

let &especie CotizacionNIIF(Dialogo.Especie1, Dialogo.Fecha1, Dialogo.Book1)
if(Vacio(&especie))
    ACT(a:fac, "SIN DATOS")
else
    ACT(a:fac, Dialogo.Especie1)
    ACT(b:fac, &especie.Nombre)
    ACT(c:fac, &especie.Moneda)
    ACT(d:fac, &especie.TipoValuacionActual)
    ACD(e:fac, &especie.FechaUltimaCotizacion)
    ACT(f:fac, &especie.PrecioContadoCierreDirty)
    ACN(g:fac, &especie.PrecioCotizacionDeterminada)
    FormatoCeldas(g:FAC, EXE('F8'))
    ACT(h:fac, &especie.PlazoLiquidacion)
    ACT(i:fac, &especie.CodigoBook)
    ACT(j:fac, &especie.ModeloNegocio)
endif


ACO(1, 10)
ACO(4, 12)
