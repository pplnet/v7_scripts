HojaVisible(Si)
MostrarCuadroDeMensajes
ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: 'Operacion'        ;;;;;;EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TRANTI');'El TipoOp debe ser TRNATI';NO;;;;;;" TipoOp IN ("~Pipe2Comillas(Var('CACTRA'))~") " 
  Fecha1      : 'Fecha'            ;;;;;;;;;Fsys 
  Directorio1: 'Path cartas'       ;;;;;;NoVacio(Dialogo.Directorio1);'Debe ingresar un path';NO;Var('PATHCARTA')
  String1:    'File carta'         ;;;;;;NoVacio(Dialogo.String1) Y EqStr(Dialogo.String1,Var('FILECACTRA'));'Debe ingresar un documento';NO;Var('FILECACTRA')
FinDialogo

if Not OK
  Cancelar
endif

(.'VALIDPATH'.)


Recorrer&i 1, 2
   SQL.ADD("Select NrOperacion,TipoOp,Vehiculo1,Especie,Cantidad,FechaOp,FechaVto,ContraEspecie,FechaPago,Precio1,Cliente1,Cliente2,Cuenta4,Cuenta1 from "~DBO~".OPERACIONES")
   SQL.ADD(" WHERE NrOperacion = '"~Dialogo.NrOperacion1~"'")
   Recorrer SQL
      let &nombre_especie BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie'])
      let &desc_vehiculo BuscarCampo('Vehiculos','Descripcion','Codigo',FBN['Vehiculo1'])
      If &i=1
         let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente1'])
         let &cuenta BuscarCampo('CUENTAS', 'Numero', 'Codigo',FBN['Cuenta4'])
         let &cod_comitente BuscarCampo('CLIENTES','CodComitente','Codigo',fbn['Cliente1'])
         let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Cliente1'])
      Else
         let &razon_social BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn['Cliente2'])
         let &cuenta BuscarCampo('CUENTAS', 'Numero', 'Codigo',FBN['Cuenta1'])    
         let &localidad BuscarCampo('CLIENTES','Localidad','Codigo',fbn['Cliente2'])
      ENDIF
      let &fecha_larga FStr(Dia(Dialogo.Fecha1),1,0)~' de '~Val(aa:Mes(Dialogo.Fecha1))~' de '~FStr(Anio(Dialogo.Fecha1),4,0)
      let &oracion 'Por medio de la presente, solicitamos a UDS, transferir la cantidad de VN '
      IF &i = 2
         let &oracion 'Por medio de la presente, confirmamos a UDS, haberles transferido la cantidad de VN '
      ENDIF
      Message(&cod_comitente)
      Message(&cuenta)
      
      EmitirCartaVisible(Dialogo.Directorio1~Dialogo.String1,Copy(Directorio.String1,1,Longitud(Directorio.String1)-5)~'_'~Dialogo.NrOperacion1, localidad = &localidad, fecha_larga = &fecha_larga, razon_social = &razon_social, oracion = &oracion, monto = Fstr(fbn['Cantidad'],1,2), nombre_especie = &nombre_especie, cod_comitente = &cod_comitente, desc_vehiculo = &desc_vehiculo, cuenta = &cuenta)
   Proximo 
Proximo


