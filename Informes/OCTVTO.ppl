*ModoReproceso(ConDialogo)
ACD(x1, SQL("Select Max(Fecha) from "~DBO~".PLAZOSOCT where Habilitado='SI' "))
if Val(x1)<1
  ACD(x1, FSys)
endif

CrearDialogo
  Fecha1    : 'D.FechaVto' ;1;1;;;;Dialogo.Fecha1 <> 0;'FechaVto Desde Invalida';NO;Fsys
  Radio1    : 'Hasta|Hoy|Fin mes|Sig.mes|Ult.Vto.|otro';2;1;;;;;;;3;
  Fecha2    : 'H.FechaVto' ;3;1;;Dialogo.Radio1=4;;Dialogo.Fecha2 <> 0;'FechaVto Hasta Invalida';NO;;iif(Dialogo.Radio1=0,Dialogo.Fecha1,iif(Dialogo.Radio1=1,FinDeMes(Dialogo.Fecha1,NO,'ARG'),iif(Dialogo.Radio1=2,FinDeMes(FinDeMes(Dialogo.Fecha1)+7,NO,'ARG'),iif(Dialogo.Radio1=3,Val(x1),Dialogo.Fecha1))));
  Vehiculo1 : 'Vehiculo'   ;3;2;;NO;;NoVacio(DIalogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Lista1    : 'Fixing'     ;4;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where SUBSTRING(Jerarquia,10,3)<>'000' AND SUBSTRING(Jerarquia,1,9)= (Select SUBSTRING(Jerarquia,1,9) from "~DBO~".ESPECIES where Codigo='OCTFIX') ")
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

**AgregarBMP(A:1, Exe('LOGO'), 60)
ACT(a:2, CodigoInforme)
SetFilaActual(4)
ACT(a:fac, 'Vencimientos OCT')
ACT(a:fac+2, 'Desde: '~Dialogo.Fecha1)
ACT(d:fac+2, 'Hasta: '~Dialogo.Fecha2)
ACT(a:fac+3, 'Vehiculo: '~Dialogo.Vehiculo1)
if NoVacio(Dialogo.Lista1)
   act(d:fac+3, 'Fixing :  ' ~Dialogo.Lista1)
else
   act(d:fac+3, 'Fixing :  Todos')
endif
SetFont(a:fac, 3)
SetFont(a:fac+2..d:fac+3, 2)

SetFilaActual(fac+5)
ACT(a:fac, 'Operacion')
ACT(b:fac, 'TipoOp')
ACT(c:fac, 'Cliente')
ACT(d:fac, 'FechaOp')
ACT(e:fac, 'FechaPrecan')
ACT(f:fac, 'FechaVto')
ACT(g:fac, 'Fixing')
ACT(h:fac, 'Cantidad')
ACT(i:fac, 'PrecioOp')
ACT(j:fac, 'Resultado')
AlinearCeldas(a:fac..j:fac, 'C')
SetFont(a:fac..j:fac, 2)
AgregarMarco(a:fac..j:fac, 0, 0, Exe('COLOR'))
ACN(FI:1, fac+2)
ACN(FI:2, fac+1)

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.Cantidad, O.CB6, O.Precio1, O.PrecioEj, O.ContraEspecie, ")
SQL.ADD(" Case When O.CB6 = '1' Then O.FechaPrecan Else O.FechaVto END As FechaVto, O.FechaPrecan, O.FechaVto FechaVto2, ")
SQL.ADD(" O.TotalAux1, O.FechaEj, O.ContraEspecie2 ")
*SQL.ADD(" Select O.NrOperacion,   O.TipoOp,    O.Cliente1, O.FechaOp,     ")
*SQL.ADD("        O.Cantidad,      O.CB6,       O.Precio1,  O.PrecioEj,    ")
*SQL.ADD("        O.ContraEspecie, O.TotalAux1, O.FechaEj,  O.FechaPrecan, ")
*SQL.ADD("        O.FechaVto FechaVto2,         ")
*SQL.ADD("        Case When O.CB6 = '1' Then O.FechaPrecan Else O.FechaVto END As FechaVto ")
SQL.ADD("   From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("  Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("    and OB.NrBit = 30 ")
SQL.ADD("    and OB.Valor <> '1' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and O.ContraEspecie2 In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
SQL.ADD("    and O.TipoOp IN ('FXOCTC','FXOCTV') ")
SQL.ADD("    and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    and ((O.CB6 = '1' AND O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaPrecan <= '"~IdxDate(Dialogo.Fecha2)~"') OR ((O.CB6 <> '1' OR O.CB6 Is Null OR O.CB6 = '') AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"')) ")
SQL.ADD("  Order By 10, 4, 1 ")
Recorrer SQL
  IF fbn('FechaVto') <> Val(FV:1)
    IF Val(FV:1) <> 0
      SetFont(A:Val(FI:1)..J:fac, 1)
    ELSE
      IFA
    ENDIF
    ACT(A:fac, 'Vencimiento:')
    ACD(B:fac, fbn('FechaVto'))
    ACD(FV:1, fbn('FechaVto'))
    SetFont(A:fac..B:fac, 2)
    AgregarMarco(A:fac..J:fac, 0, 0, Exe('COLOR10'))
    IFA
    ACN(FI:1, fac)
  ENDIF
  ACT(A:fac, fbn('NrOperacion'))
  ACLO(A:fac, fbn('NrOperacion'))
  ACT(B:fac, fbn('TipoOp'))
  ACT(C:fac, fbn('Cliente1'))
  ACD(D:fac, fbn('FechaOp'))
  IF fbn('CB6') = 1 Y fbn('FechaPrecan') >= Dialogo.Fecha1 Y fbn('FechaPrecan') <= Dialogo.Fecha2
    ACD(E:fac, fbn('FechaPrecan'))
  ENDIF
  ACD(F:fac, fbn('FechaVto2'))
  ACT(G:fac, fbn('ContraEspecie2'))
  ACN(H:fac, fbn('Cantidad'))
  ACN(I:fac, fbn('Precio1'))
  IF Val(FV:1) = Val(E:fac) O Val(FV:1) = fbn('FechaEj')
    ***---Precancelada o vencida => muestro el resultado de total de la operacion
    ACN(J:fac, fbn('TotalAux1'))
  ENDIF
Proximo

SetFont(A:Val(FI:1)..J:fac, 1)
FormatoCeldas(I:Val(FI:2)..I:fac, Exe('F9'))
FormatoCeldas(J:Val(FI:2)..J:fac, Exe('F2'))

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

ACO(1, 10)
ACO(5, 8)
ACO(7, 6)
ACO(8, 10)
ACO(9, 9)
ACO(10, 10)

LimitesVision(K:fac+1)
