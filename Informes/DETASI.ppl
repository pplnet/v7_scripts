CrearDialogo
  String1: 'NrAsiento'  ;;;;;;;;;
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,BU')

ACT(a:2,'Detalle Asiento Contable')
SetFont(a:2,3)

SetFilaActual(4)

ACT(a:fac, 'NrAsiento: '~Dialogo.String1)
ACT(a:fac+1, 'Moneda: '~VAR('MONELOCA'))

SetFont(a:fac..a:fac+1, 2)

SetFilaActual(fac+3)

ACT(a:fac, 'Cuenta')
ACT(b:fac, 'NrItem')
ACT(c:fac, 'Especie')
ACT(d:fac, 'NrOperacion')
ACT(e:fac, 'Debe')
ACT(f:fac, 'Haber')
ACT(g:fac, 'Voucher')
ACT(h:fac, 'CentroCosto')

AgregarMarco(a:fac..h:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..h:fac, 2)
AlinearCeldas(a:fac..h:fac, 'C')

SQL.ADD(" Select Cuenta, DebitoCredito, Alias1 Especie, NrOperacion, Cantidad1, NrTrans2, CentroCosto, NrItem From "~DBO~".ASIENTOSCON1 ")
SQL.ADD(" Where NrUnicoAsiento = '"~Dialogo.String1~"' ")

Recorrer SQL
  ACT(a:fac,FBN['Cuenta'])
  ACT(b:fac,FBN['NrItem'])
  ACT(c:fac,FBN['Especie'])
  ACT(d:fac,FBN['NrOperacion'])
  ACLO(d:fac,FBN['NrOperacion'])
  If EqStr(FBN['DebitoCredito'],'DEB')
     ACN(e:fac,FBN['Cantidad1'])
  Else
     ACN(f:fac,FBN['Cantidad1'])
  EndIf
  ACT(g:fac,FBN['NrTrans2'])
  If NoVacio(Val(g:fac))
     ACLT(g:fac,FBN['NrTrans2'])
  EndIf
  ACT(h:fac,FBN['CentroCosto'])

  FormatoCeldas(e:fac..f:fac, EXE('F2'))
  SetFont(a:fac..h:fac, 1)
Proximo

LimitesVision(i:fac+1)

ACO(2,5)
ACO(3,8)
ACO(4,8)
ACO(5,10)
ACO(6,10)
ACO(7,8)
ACO(8,10)
