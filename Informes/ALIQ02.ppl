 MostrarCuadroDeMensajes
CrearDialogo
   Fecha1:    'Fecha'    ;;;;;;;;;fsys
   Cliente1:  'Cliente'  ;
   Especie1:  'Especie'  ;
   Mercado1:  'MercadoOp';  
   Vehiculo1: 'Vehiculo' ;
   cHECK1: 'Incluye Anteriores';1;2;;;;;;;1
FinDialogo

If not OK
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BI")

If Dialogo.Check1=0
   ACT(a:1, 'Operaciones Pendientes de Confirmacion de Liquidacion para el '~Dialogo.Fecha1)
Else
   ACT(a:1, 'Operaciones Pendientes de Confirmacion de Liquidacion hasta el '~Dialogo.Fecha1)
Endif
SetFont(a:1, 3)

ACT(a:3, 'Cliente:  '~iif(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(a:4, 'Especie:  '~iif(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todos'))
ACT(a:5, 'Vehiculo: '~iif(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
ACT(d:3, 'Mercado:  '~iif(NoVacio(Dialogo.Mercado1),Dialogo.Mercado1,'Todos'))
SetFont(a:3..d:5, 2)

SetFilaActual(5)

SQL.ADD(" SELECT M.Leyenda, M.Cuenta, M.Especie, M.Cantidad, M.FechaMov, M.Cuenta, M.NrOperacion, M.Mercado, O.TipoOp, ")
SQL.ADD(" O.FechaOp, O.FechaVto, O.Vehiculo1, O.Especie EspecieO, O.ContraEspecie, C.RazonSocial, M.Cliente, ")
SQL.ADD(" O.Cantidad Nominales, O.Precio1, CASE C.CategDepositante WHEN 'CLI' THEN 'Clientes' ELSE 'Contrapartes' END CategDepositante, M.NrTrans2, O.ObservacDoc, O.ConceptoEmp, O.CodErrorCV, O.CodErrorMAE ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE  O.NrOperacion = M.NrOperacion ")
*SQL.ADD(" AND    O.Cliente1   = C.Codigo      ")
SQL.ADD(" AND    M.Cliente     = C.Codigo      ")
 
SQL.ADD(" AND    M.NrSaldo     = 31            ")


*** MB 11/01/06 Solo para TITULOS
*SQL.ADD(" AND    M.Concepto =  'TI'            ")

If Dialogo.Check1=0
   SQL.ADD(" AND  O.FechaVto = "~Idxdate2(Dialogo.Fecha1)~" ")
Else
   SQL.ADD(" AND  O.FechaVto <= "~Idxdate2(Dialogo.Fecha1)~" ")
Endif
 
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" AND O.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND M.Especie = '"~Dialogo.Especie1~"' ")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" AND M.Cliente = '"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD("  ORDER BY O.Vehiculo1, C.CategDepositante, M.Especie, M.FechaMov, M.NrOperacion ")

ACT(ve:1, '')
ACT(cd:1, '')
ACT(es:1, '')
ACN(to:1,0)

Recorrer SQL
  If Not eqstr(fbn('Vehiculo1'), Val(ve:1))
     ifa
     ifa
     ACT(a:fac, 'Vehiculo: '~fbn('Vehiculo1'))
     message(Val(a:fac))
     AgregarMarco(a:fac..Q:fac,0,0)
     SetFont(a:fac, 3)
     ifa
     ACN(to:1, 0)
  Endif

  If Not eqstr(fbn('CategDepositante'), Val(cd:1))
     ifa
     ACT(a:fac, 'Tipo de Cliente: '~fbn('CategDepositante'))
     message(Val(a:fac))
     AgregarMarco(a:fac..Q:fac,0,0,EXE('COLOR6'))
     SetFont(a:fac, 4)
     ifa
     ACN(to:1, 0)
  Endif

  If Not eqstr(fbn('Especie'), Val(es:1))
     ifa
     ACT(a:fac, fbn('Especie')~' - '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
     message(Val(a:fac))
     ACT(b:fac, 'FechaMov')
     ACT(c:fac, 'Cantidad')
     ACT(d:fac, 'NrOperacion')
     ACT(e:fac, 'TipoOp')
     ACT(f:fac, 'FechaOp')
     ACT(g:fac, 'FechaVto')
     ACT(h:fac, 'Cliente/Contraparte')
     ACT(i:fac, 'Especie')
     ACT(j:fac, 'Nominales')
     ACT(k:fac, 'Precio')
     ACT(l:fac, 'Moneda')
     ACT(m:fac, 'Mercado')
     ACT(n:fac, 'Cuenta')
     ACT(o:fac, 'Acumulado')
     ACT(p:fac, 'Voucher')
     ACT(q:fac, 'Observaciones')
     SetFont(a:fac..z:fac, 2)
     AlinearCeldas(a:fac..z:fac, 'C')
     AgregarMarco(a:fac..q:fac,0,0,EXE('COLOR8'))
     ifa
     ACN(to:1, 0)
  Endif

  ACT(a:fac, fbn('Leyenda'))
  ACD(b:fac, fbn('FechaMov'))
  ACT(e:fac, fbn('TipoOp'))
  If Incluido(fbn('TipoOp'), 'TIC|TIV|TIFC|TIFV|TIDE|TIPO|TICO|TICT|TVC|TVP|TCC|TCP')
     ACT(e:fac, Val(e:fac)~' (Mov del banco)')
     ACN(c:fac, fbn('Cantidad')*(-1))
  Else
     ACN(c:fac, fbn('Cantidad'))
  Endif
  ACT(d:fac, fbn('NrOperacion'))
  ACLO(d:fac, fbn('NrOperacion'))
  ACD(f:fac, fbn('FechaOp'))
  ACD(g:fac, fbn('FechaVto'))
  ACT(h:fac, fbn('Cliente')~' - '~Copy(FBN['RazonSocial'],1,25))
  ACT(i:fac, fbn('EspecieO')~' - '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn('Especie')))
  ACN(j:fac, fbn('Nominales'))
  ACN(k:fac, fbn('Precio1'))
  ACT(l:fac, fbn('ContraEspecie'))
  ACT(m:fac, fbn('Mercado'))
  ACT(n:fac, BuscarCampo('CUENTAS','Numero','Codigo',fbn('Cuenta')))
  If CeldaVacia(n:fac)
     ACT(n:fac, fbn('Cuenta'))
  Endif
  SCN(to:1, fbn('Cantidad'))
  ACN(o:fac, Val(to:1))
  ACT(p:fac, fbn('NrTrans2'))
  ACLT(p:fac, fbn('NrTrans2'))
  ACT(q:fac, fbn('ObservacDoc')~' '~fbn('ConceptoEmp')~' '~fbn('CodErrorCV')~' '~fbn('CodErrorMAE'))

  SetFont(a:fac..z:fac, 1)
  FormatoCeldas(c:fac,EXE('F2'))
  FormatoCeldas(j:fac,EXE('F2'))
  FormatoCeldas(k:fac,EXE('F9'))
  FormatoCeldas(o:fac,EXE('F2'))

  ACT(ve:1, fbn('Vehiculo1'))
  ACT(cd:1, fbn('CategDepositante'))
  ACT(es:1, fbn('Especie'))
