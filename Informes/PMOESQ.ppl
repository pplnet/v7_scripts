ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1: 'Nr.Operacion' ; 1;1;;;;;;;;;;;;" TipoOp in ('PME')"
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,6,')

ACN(z5,SQL("Select 1 from "~DBO~".OPERACIONESBITS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrBit in ('70','10') and Valor='1' "))
if val(z5)<>1
  Cancelar('La operacion no esta en instancia terminal')
endif


SetFilaActual(3)

SQL.ADD("Select O.FechaOp,O.Especie,O.Cliente1,O.Cantidad,O.Plazo,O.FechaVto,O.DiasAnio,O.MB3, ")
SQL.ADD("O.TasaInteresesCupon,O.Vehiculo1,O.Mercado,O.RB9,O.RB10,O.PorComision,O.TipoOp, ") 
SQL.ADD("O.Book1, O.RB1, O.NrOperacion3, O.RB2, O.TotalAux8, ")
SQL.ADD("O.NrOperacion, O.Precio1, O.TotalComisiones, O.Cuotas1, ")
SQL.ADD("O.Sublimite, O.RB5, O.Centro2, ")
SQL.ADD("C.CondicionIVA, C.AgPercepcionIVA, C.ExIVA, C.PorcExIVA, C.FDesdeExIVA, C.FHastaExIVA, C.IVAPISE ") 
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("where O.NrOperacion='"~Dialogo.NrOperacion1~"' ")
SQL.ADD("and C.Codigo = O.Cliente1 ")

ACN(x1,0)
ACD(z2,FSYS)
                                                                                                                      
recorrer SQL  
ACN(tt1,fac)
  ACT(a1,FBN['Especie'])
  ACT(b1,FBN['Cliente1'])
  ACN(c1,FBN['Cantidad'])
  ACD(d1,FBN['FechaOp'])
  ACN(e1,FBN['Plazo'])
  ACD(f1,FBN['FechaVto'])
  if FBN['DiasAnio']=0
    ACN(g1,36000)
  else
    ACN(g1,36500)
  endif
  ACN(h1,FBN['TasaInteresesCupon'])
         
  ACT(j1,FBN['CondicionIVA'])
  ACT(k1,FBN['AgPercepcionIVA'])
  ACT(l1,FBN['ExIVA'])
  ACN(m1,FBN['PorcExIVA'])
  ACD(n1,FBN['FDesdeExIVA'])
  ACD(o1,FBN['FHastaExIVA'])
  ACT(p1,FBN['Vehiculo1'])
  ACT(q1,FBN['Mercado'])
  ACT(r1,FBN['IVAPISE'])
  ACT(s1,FBN['MB3'])
  ACN(t1,FBN['RB9'])
  ACN(u1,FBN['RB10'])
  ACN(v1,FBN['PorComision'])
  ACT(w1,FBN['TipoOp'])
  ACT(bo1,FBN['Book1'])
  ACT(bo2,FBN['RB1'])
  ACT(bo3,FBN['NrOperacion3'])
  ACT(bo4,FBN['RB2'])

*  ACT(a:fac-4,BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Vehiculo1')))
*  ACT(a:fac-3,BuscarCampo('CLIENTES', 'Direccion', 'Codigo', fbn('Vehiculo1')))
*  ACT(a:fac-2,BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Vehiculo1')))
*  ACT(a:fac-1,BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Vehiculo1')))

  SetFont(a:fac-4..a:fac-1, 1)

  ACT(a:fac+1, 'Cliente: ')  
  ACT(b:fac+1, BuscarCampo('CLIENTES', 'RazonSocial', 'Codigo', fbn('Cliente1')))  

  ACT(a:fac+2, 'CUIT/CUIL: ')
  ACT(b:fac+2, BuscarCampo('CLIENTES', 'CUIT', 'Codigo', fbn('Cliente1')))
  ACT(a:fac+3, 'Categoria IVA: ')
  ACT(w1,BuscarCampo('CLIENTES', 'CondicionIVA', 'Codigo', fbn('Cliente1')))
  (.'DESCONDIVA'.)
  ACT(b:fac+3, val(w2))
  ACT(a:fac+4, 'Domicilio: ')
  ACT(b:fac+4, BuscarCampo('CLIENTES', 'Direccion', 'Codigo', fbn('Cliente1'))~' '~BuscarCampo('CLIENTES', 'CodigoPostal', 'Codigo', fbn('Cliente1'))~' '~BuscarCampo('CLIENTES', 'Localidad', 'Codigo', fbn('Cliente1')))

  ACT(a:fac+5, 'Fecha de emision: ')
  ACT(b:fac+5, Fecha(FSYS))

  ACT(a:fac+6, 'Operacion: ')
  ACT(b:fac+6, fbn('NrOperacion'))
  ACT(d:fac+6, 'Tipo de Operacion: ')
  ACT(e:fac+6, fbn('TipoOp'))
  ACT(g:fac+6, 'Vehiculo: ')
  ACT(h:fac+6, fbn('Vehiculo1'))


  ACT(a:fac+7, 'Fecha de Inicio: ')
  ACD(b:fac+7, fbn('FechaOp'))
  ACT(d:fac+7, 'Fecha Final.: ')
  ACD(e:fac+7, fbn('FechaVto'))

  ACT(a:fac+8, 'Moneda: ')
  ACT(b:fac+8, fbn('Especie'))
  ACT(d:fac+8, 'Cant de Cuotas: ')
  ACT(e:fac+8, fbn('Cuotas1'))

  * Si es 2412
  if EQSTR(val(bo4),'1')
    ACT(g:fac+7, 'Comision 2412')
  endif
 
  ACT(a:fac+9, 'Importe del prestamo: ')
  ACN(b:fac+9, fbn('Cantidad'))
*  ACT(g:fac+9, 'Facility Type: ')
*  ACT(h:fac+9, fbn('Sublimite'))


  ACT(a:fac+10, 'Plazo: ')
  ACT(b:fac+10, fbn('Plazo'))
*  ACT(g:fac+10, iif(EqStr(fbn('RB5'),'0'),'Commited','Uncommited'))

  ACT(a:fac+11, 'Proximo Vencimiento: ')
*  ACT(g:fac+11, 'Contract SubType: ')
*  ACT(h:fac+11, fbn('Centro2'))


SetFilaActual(fac+13)

ACT(a:fac,'Cuota')
ACT(b:fac,'Fecha')
ACT(c:fac,'Tasa')
ACT(d:fac,'Amortizacion')
ACT(e:fac,'Interes')
ACT(f:fac,'Comision')
ACT(g:fac,'Impuestos')
ACT(h:fac,'Importe')
ACT(i:fac,'Importe')
ACT(j:fac,'Saldo de')
ifa
ACT(b:fac,'de Vto.')
ACT(c:fac,'Cliente')
ACT(d:fac,'de Capital')
ACT(e:fac,'de Cuota')
ACT(h:fac,'de Cuota')
ACT(i:fac,'cancelado')
ACT(j:fac,'capital')

AlinearCeldas(b:fac..j:fac,'D')
AlinearCeldas(b:fac-1..j:fac-1,'D')

AgregarMarco(a:fac-1..j:fac,2,2,EXE('COLOR10'))

ACN(w1,fac+1)

if EQSTR(fbn('TipoOp'),'PME')
  SQL.ADD("select * from "~DBO~".CUOTAS ")
  SQL.ADD("where NrOperacion='"~Dialogo.NrOperacion1~"' ")
  Recorrer SQL
    SCN(x1,1)
    ACT(a:fac, fbn('NrCuota'))    
    ACD(b:fac, fbn('Fecha2'))
    ACN(c:fac, fbn('Tasa1'))

    if EQSTR(val(bo4),'1')
      ACN(d:fac, 0)
    else
      ACN(d:fac, fbn('Cantidad1'))
    endif

    ACN(e:fac, fbn('Cantidad2'))
    ACN(f:fac, fbn('Total7'))


   *** IVA ****
     if Not[Eqstr(val(p1),'INGCURA')]     

       if fbn('Fecha4')>0          
         *--- IVA / INTERES NORMAL
         ACN(pm1,fbn('Cantidad2'))
         ACN(pf1,fbn('Fecha2'))
         ACT(pt1,'INT')
         (.'CANPREIVA'.)
         ACN(ga:val(x1),val(pr1))
         ACN(gb:val(x1),val(pr2))
         ACN(gc:val(x1),val(pr3))
 
         *--- IVA / COMISION
         ACN(pm1,fbn('Total7'))
         ACN(pf1,fbn('Fecha2'))
         ACT(pt1,'COM')
         (.'CANPREIVA'.)
         ACN(nb:val(x1),val(pr1))
         ACN(nc:val(x1),val(pr2))
         ACN(nd:val(x1),val(pr3))

         *** TOTAL IVANOR
         ACN(ha:val(x1),Round(val(ga:val(x1))+val(nb:val(x1)),2))
   
         *** TOTAL IVAADI
         ACN(hb:val(x1),Round(val(gb:val(x1))+val(nc:val(x1)),2))

         *** TOTAL IVAPER
         ACN(hc:val(x1),Round(val(gc:val(x1))+val(nd:val(x1)),2))

         * Si IVAPER es menor al Valor Minimo el Impuesto es 0
         if val(hc:val(x1)) < Var('IVAPERMIN')
           ACN(gc:val(x1),0)
           ACN(nd:val(x1),0)
           ACN(hc:val(x1),0)
         endif
         ACN(g:fac, val(ha:val(x1))+val(hb:val(x1))+val(hc:val(x1)))
         
       else
         ACN(g:fac,fbn('Cantidad9')+fbn('Cantidad10')+fbn('Cantidad11')+fbn('Cantidad13')+fbn('Cantidad14')+fbn('Cantidad15'))   
       endif
     else
       ACN(g:fac,0)
     endif   
 
  *--- FIN IVA

    ACN(h:fac, sum(d:fac..g:fac))
    ACN(i:fac, SQL("select sum(Cantidad) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~Dialogo.NrOperacion1~"' and NrSaldo in (30,40,50,60,80,85,90,41,42,43,51,52,53,61,62,63,81,82,83,86,87,88,91,92,93) and FechaMov<="~IdxDate2(FSYS)~" and NrGrupo2="~fbn('NrCuota')))

    if EQSTR(val(bo4),'1')
      ACN(j:fac, 0)     
      else
      if fbn('NrCuota')=1
        ACN(j:fac, val(c1))
        else
        ACN(j:fac, val(j:fac-1)-val(d:fac-1)) 
      endif
    endif

    if FSYS>=fbn('Fecha1') y FSYS<fbn('Fecha2')
      ACD(b:val(tt1)+11, fbn('Fecha2'))
    endif
  Proximo

endif

Proximo

ifa
ACT(b:fac,'Total')
ACN(d:fac,sum(d:val(w1)..d:fac-1))
ACN(e:fac,sum(e:val(w1)..e:fac-1))
ACN(f:fac,sum(f:val(w1)..f:fac-1))
ACN(g:fac,sum(g:val(w1)..g:fac-1))
ACN(h:fac,sum(h:val(w1)..h:fac-1))
ACN(i:fac,sum(i:val(w1)..i:fac-1))

AgregarMarco(a:val(w1)..j:fac-1,1,3)

*FormatoCeldas(d:fac..i:fac,Exe('F0R'))
AgregarMarco(b:fac..j:fac,1,2)

BorrarCeldas(a1..z1)

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
ACT(k1,VAR('TITULO'))
ACT(k2, 'Desarrollo de Cuotas')
AlinearCeldas(k1..k2,'D')
SetFont(k1..k2, 1)

ACT(a3,'Sistema: FPA')
ACT(c3,'Fecha de Proceso: '~Fecha(FSYS))

