ModoReproceso(SinDialogo)
MostrarCuadroDeMensajes
CrearDialogo
  Fecha1     : "Fecha Vigencia"    ;;;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Fecha2     : "Fecha Desde"       ;;;;;;[Dialogo.Fecha2 = Dialogo.Fecha1] O [Dialogo.Fecha2 = PriDeMes(Dialogo.Fecha2, NO, 'ARG') Y Dialogo.Fecha2 >= Dialogo.Fecha1];'Fecha Desde Invalida';NO;Fsys;
  Fecha3     : "Fecha Hasta"       ;;;;;;[Dialogo.Fecha3 >= Dialogo.Fecha2 Y Dialogo.Fecha3 = FinDeMes(Dialogo.Fecha3, NO, 'ARG')];'Fecha Hasta Invalida';NO;FinDeMes(Fsys, NO, 'ARG');
  Especie1   : "Especie"           ;1;2;;;;;;;;;;;
  Cliente1   : "Entidad"           ;2;2;;;;;;;;;;;
  Radio1     : "Expresado|ARP|USD" ;3;2;;;;;;;1
  Radio2     : "Consolidado|NO|SI" ;4;2;;;;;;;0
  Lista2     : 'Tipo Op.'          ;5;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' Order By Codigo ");
  Lista1     : "Vehiculo"          ;-1;2;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,6,")
CrearFont(5,"Arial,12,BI")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

ACT(LS:1000, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))
ACT(LS:1100, SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo Like 'MM%' "))

***---Armo una lista por cada grupo de operaciones a informar
IF Vacio(Dialogo.Lista2)
    ACT(LS:11, 'MMFIMV|MMFRNP')
    ACT(LS:12, 'MMON|MMONM')
    ACT(LS:13, 'MMPCL|MMPCLM')
    ACT(LS:14, 'MMPCOS|MMPOSM')
    ACT(LS:15, 'MMPE|MMPEM')
    ACT(LS:16, 'MMPI|MMPIM')
    ACT(LS:17, 'MMPLME')
    ACT(LS:18, 'MMPSI|MMSCMV|MMSIMV')
ELSE
    ACT(LS:1, 'MMFIMV|MMFRNP')
    ACT(LS:2, 'MMON|MMONM')
    ACT(LS:3, 'MMPCL|MMPCLM')
    ACT(LS:4, 'MMPCOS|MMPOSM')
    ACT(LS:5, 'MMPE|MMPEM')
    ACT(LS:6, 'MMPI|MMPIM')
    ACT(LS:7, 'MMPLME')
    ACT(LS:8, 'MMPSI|MMSCMV|MMSIMV')
    Recorrer&k 1, 8
        Recorrer&j 1, Longitud(Val(LS:&k))
            IF Incluido(ItemLista(Val(LS:&k), &j), Dialogo.Lista2)
                ACT(LS:&k+10, Val(LS:&k+10)~ItemLista(Val(LS:&k), &j)~'|')
            ENDIF
        Proximo
    Proximo
ENDIF
Recorrer&k 1, 8
    IF Not CeldaVacia(LS:&k+10)
        LinkearHoja('ANTDE1', 1, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Fecha3=Dialogo.Fecha3, Especie1 = Dialogo.Especie1, Cliente1 = Dialogo.Cliente1, Radio1 = Dialogo.Radio1, Radio2 = Dialogo.Radio2, Lista1 = IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, Val(LS:1000)), Lista2 = Val(LS:&k+10))
    ENDIF
Proximo

HojaVisible(NO)