CrearDialogo
  Fecha1   :'F.Desde'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;PriDeMes(FSys)
  Fecha2   :'F.Hasta'  ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FinDeMes(Dialogo.Fecha1);
FinDialogo


If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


ACT(A:2, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(A:3, 'Fecha Hasta: '~Dialogo.Fecha2)


ACT(A:5,'Estado')
ACT(B:5,'Fecha')
ACT(C:5,'Usuario')
AgregarMarco(A:5..C:5,2,0,Exe('COLOR'))
SetFont(A:1..C:5,2)

SetFilaActual(5)

SQL.ADD(" Select Datos, Fecha, Usuario ")
SQL.ADD(" From "~DBO~".LOGINFORMES  ")
SQL.ADD(" where Codigo='CONT24' and Datos <>''  and Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" order by Fecha ")
Recorrer SQL
   ACT(A:Fac,FBN['Datos'])
   ACT(B:Fac,FBN['Fecha'])
   ACT(C:Fac,FBN['Usuario'])
Proximo


SetFont(A:6..C:Fac+1,1)

ACT(A:Fac+2,'Fin del Listado')
SetFont(A:Fac+2,2)

LimitesVision(C:Fac+2)

ACO(2,15)

