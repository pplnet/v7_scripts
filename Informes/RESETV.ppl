ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1: 'Fecha'  ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha No debe ser superior a la Fecha del Sistema';NO;FSys
  Check1: 'Procesa';;;;NO;;;;;0;
FinDialogo
If not Ok
   Cancelar
Endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(y1, 'Fin de Mes')
ACT(y2, 'OK')
ACT(y4, 'Mes Inicio')
ACT(y5, 'Mes Cierre')

* Fin de mes del mes actual
ACD(z:1, FinDeMes(Dialogo.Fecha1,NO,'ARG'))

ACT(z:2, 'SI')
if Val(z:1)<>Dialogo.Fecha1
  MessageBox('La fecha indicada no es fin de mes')
  ACT(z:2, 'NO')
endif

IF EqStr(Val(z:2),'SI')
  ACN(z:4, 0)
  ACN(z:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
  if Val(z:4)=0
    ACN(z:5, 12)
  else
    ACN(z:5, VAR('MESINIEJE')-1)
  endif
  if Val(z:5)<1 or Val(z:5)>12
    ACN(z:5, 12)
  endif
  if Mes(Dialogo.Fecha1)<>Val(z:5)
    MessageBox('La fecha indicada no es fin de Ejercicio')
    ACT(z:2, 'NO')
  endif
endif

if EqStr(Val(z:2),'NO')
   Cancelar('No es posible Resetear Posicion en esta Fecha: '~Dialogo.Fecha1)
endif

SetFilaActual(1)
ACT(a:FAC, 'Orden')
ACT(b:FAC, 'Fecha')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'NrSaldo')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cupon')
ACT(h:FAC, 'Book')
ACT(i:FAC, 'TipoNegocio')
ACT(j:FAC, 'CantidadIni')
ACT(k:FAC, 'PrecioIni')
ACT(l:FAC, 'CantidadFin')
ACT(m:FAC, 'PrecioFin')
ACT(n:FAC, 'PrecioHist')
ACT(o:FAC, 'PrecioReset')
ACT(p:FAC, 'Accion')
ACT(r:FAC, 'PrecioMer')
SetFont(a:FAC..x:FAC, 2)

SQL.ADD("Select '1' Orden, P.* ")
SQL.ADD("  From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.TipoNegocio  = 'SEC' ")
SQL.ADD("   and P.CantidadFin  <> 0 ")
SQL.ADD("   and P.NrSaldo in (120,130) ")
SQL.ADD("   and P.Fecha = (Select MAX(P1.Fecha) ")
SQL.ADD("                    From "~DBO~".POSICIONES P1 ")
SQL.ADD("                   Where P1.Vehiculo    = P.Vehiculo ")
SQL.ADD("                     and P1.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                     and P1.Cliente     = P.Cliente ")
SQL.ADD("                     and P1.Especie     = P.Especie ")
SQL.ADD("                     and P1.Cupon       = P.Cupon ")
SQL.ADD("                     and P1.NrSaldo     = P.NrSaldo ")
SQL.ADD("                     and P1.Book        = P.Book ")
SQL.ADD("                     and P1.Fecha       <= '"~IdxDate(Dialogo.Fecha1)~"') ")

SQL.ADD("Union all ")

SQL.ADD("Select '2' Orden, P.* ")
SQL.ADD("  From "~DBO~".POSICIONES P ")
SQL.ADD(" Where P.TipoNegocio  = 'FC' ")
SQL.ADD("   and P.CantidadFin  <> 0 ")
SQL.ADD("   and P.NrSaldo in (121,131) ")
SQL.ADD("   and P.Fecha = (Select MAX(P1.Fecha) ")
SQL.ADD("                    From "~DBO~".POSICIONES P1 ")
SQL.ADD("                   Where P1.Vehiculo    = P.Vehiculo ")
SQL.ADD("                     and P1.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                     and P1.Cliente     = P.Cliente ")
SQL.ADD("                     and P1.Especie     = P.Especie ")
SQL.ADD("                     and IsNull(P1.Cupon,'') = IsNull(P.Cupon,'') ")
SQL.ADD("                     and P1.NrSaldo     = P.NrSaldo ")
SQL.ADD("                     and P1.Book        = P.Book ")
SQL.ADD("                     and P1.Fecha       <= '"~IdxDate(Dialogo.Fecha1)~"') ")

SQL.ADD("ORDER BY Orden, P.Especie, P.Cupon, P.Vehiculo, P.NrSaldo, P.Book ")

Recorrer SQL
  ACT(a:FAC, fbn('Orden'))
  ACD(b:FAC, fbn('Fecha'))
  ACT(c:FAC, fbn('Cliente'))
  ACT(d:FAC, fbn('Vehiculo'))
  ACN(e:FAC, fbn('NrSaldo'))
  ACT(f:FAC, fbn('Especie'))
  ACT(g:FAC, fbn('Cupon'))
  ACT(h:FAC, fbn('Book'))
  ACT(i:FAC, fbn('TipoNegocio'))
  ACN(j:FAC, fbn('CantidadIni'))
  ACN(k:FAC, fbn('PrecioIni'))
  ACN(l:FAC, fbn('CantidadFin'))
  ACN(m:FAC, fbn('PrecioFin'))
  ACN(n:FAC, fbn('PrecioHist'))
  ACN(o:FAC, fbn('PrecioReset'))

  IF FBN['Fecha'] = Dialogo.Fecha1
    ACT(p:FAC, 'Update')
  else
    ACT(p:FAC, 'Insert')
  endif

  if EqStr(fbn('Orden'),'1')
    ** Saldos de Titulos
    if fbn('Nrsaldo')=120
      ** Saldo en ARP
      ACN(r:FAC, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'ARP'))
    else
      ** Saldo en USD
      ACN(r:FAC, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD'))
    endif
  endif
  if EqStr(fbn('Orden'),'2')
    ** Saldos de Fondos
    if fbn('Nrsaldo')=121
      ** Saldo en ARP
      ACN(r:FAC, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'ARP'))
    else
      ** Saldo en USD
      ACN(r:FAC, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD'))
    endif
  endif

  if Dialogo.Check1=1
    *** si Existe la posicion se modifica el campo de reseteo ***
    IF FBN['Fecha'] = Dialogo.Fecha1
      SQL.ADD("UPDATE "~DBO~".POSICIONES ")
      SQL.ADD("   Set PrecioReset = "~FStr(Val(r:FAC),0,10)~" ")
      SQL.ADD(" where Fecha                   = '"~IdxDate(Dialogo.Fecha1)~"' ")
      SQL.ADD("   and Cliente                 = '"~FBN['Cliente']~"' ")
      SQL.ADD("   and Vehiculo                = '"~FBN['Vehiculo']~"' ")
      SQL.ADD("   and IsNull(Unidad,'')       = '"~FBN['Unidad']~"' ")
      SQL.ADD("   and IsNull(Centro,'')       = '"~FBN['Centro']~"' ")
      SQL.ADD("   and IsNull(Sector,'')       = '"~FBN['Sector']~"' ")
      SQL.ADD("   and IsNull(Sucursal,'')     = '"~FBN['Sucursal']~"' ")
      SQL.ADD("   and NrSaldo                 = "~FStr(FBN['NrSaldo'],0,0)~" ")
      SQL.ADD("   and Especie     = '"~FBN['Especie']~"' ")
      IF NoVacio(FBN['PrecioEj'])
         SQL.ADD("and PrecioEj    = "~FBN['PrecioEj']~" ")
      ENDIF
      IF NoVacio(FBN['FechaEj'])
         SQL.ADD("and FechaEj     = '"~IdxDate(FBN['FechaEj'])~"' ")
      ENDIF
      SQL.ADD("   and IsNull(CallPut,'')      = '"~FBN['CallPut']~"' ")
      SQL.ADD("   and IsNull(Estrategia,'')   = '"~FBN['Estrategia']~"' ")
      SQL.ADD("   and IsNull(Cartera,'')      = '"~FBN['Cartera']~"' ")
      SQL.ADD("   and Book                    = '"~FBN['Book']~"' ")
      SQL.ADD("   and IsNull(Trader,'')       = '"~FBN['Trader']~"' ")
      SQL.ADD("   and TipoNegocio             = '"~FBN['TipoNegocio']~"' ")
      SQL.ADD("   and Cupon                   = '"~FBN['Cupon']~"' ")
      SQL.NEW
      SQL.EXEC
    ELSE
      SQL.ADD("INSERT "~DBO~".POSICIONES ( ")
      SQL.ADD("Fecha,        Cliente,     Vehiculo,  Unidad,    Centro, ")
      SQL.ADD("Sector,       Sucursal,    NrSaldo,   Especie,   PrecioEj, ")
      SQL.ADD("FechaEj,      CallPut,     Precio1,   Precio2,   ValorUSD, ")
      SQL.ADD("ValorARP,     Estrategia,  Cartera,   Book,      Trader, ")
      SQL.ADD("TipoNegocio,  Cantidad1,   Cantidad2, Cantidad3, Cantidad4, ")
      SQL.ADD("Cantidad5,    Precio3,     Precio4,   Precio5,   CantidadIni, ")
      SQL.ADD("PrecioIni,    CantidadFin, PrecioFin, Cupon,     PrecioReset, ")
      SQL.ADD("PrecioHist   ")
      SQL.ADD(") Values ( ") 
      SQL.ADD("  '"~IdxDate(Dialogo.Fecha1)~"', ") 
      SQL.ADD("  '"~FBN['Cliente']~"', ") 
      SQL.ADD("  '"~FBN['Vehiculo']~"', ") 
      SQL.ADD("  '"~FBN['Unidad']~"', ") 
      SQL.ADD("  '"~FBN['Centro']~"', ")
      SQL.ADD("  '"~FBN['Sector']~"', ") 
      SQL.ADD("  '"~FBN['Sucursal']~"', ") 
      SQL.ADD("  "~FStr(FBN['NrSaldo'],0,0)~", ") 
      SQL.ADD("  '"~FBN['Especie']~"', ")
      IF Val(j:fac)=0
        SQL.ADD(" NULL, ")
      ELSE
        SQL.ADD(" "~FStr(FBN['PrecioEj'],15,8)~", ")
      ENDIF
      IF Vacio(FBN['FechaEj'])
        SQL.ADD(" NULL, ")
      ELSE
        SQL.ADD(" '"~IdxDate(FBN('FechaEj'))~"', ")
      ENDIF
      SQL.ADD("   '"~FBN['CallPut']~"', ") 
      SQL.ADD("  "~FStr(0,0,10)~", ") 
      SQL.ADD("  "~FStr(0,0,10)~", ") 
      SQL.ADD("  "~FStr(FBN['ValorUSD'],0,10)~", ")
      SQL.ADD("  "~FStr(FBN['ValorARP'],0,10)~", ") 
      SQL.ADD("  '"~FBN['Estrategia']~"', ") 
      SQL.ADD("  '"~FBN['Cartera']~"', ") 
      SQL.ADD("  '"~FBN['Book']~"', ") 
      SQL.ADD("  '"~FBN['Trader']~"', ")
      SQL.ADD("  '"~FBN['TipoNegocio']~"', ") 
      SQL.ADD("  "~FStr(0,0,2)~", ") 
      SQL.ADD("  "~FStr(0,0,2)~", ") 
      SQL.ADD("  "~FStr(0,0,2)~", ") 
      SQL.ADD("  "~FStr(0,0,2)~", ")
      SQL.ADD("  "~FStr(0,0,2)~", ") 
      SQL.ADD("  "~FStr(0,0,10)~", ") 
      SQL.ADD("  "~FStr(0,0,10)~", ") 
      SQL.ADD("  "~FStr(0,0,10)~", ") 
      SQL.ADD("  "~FStr(FBN['CantidadFin'],0,10)~", ")
      SQL.ADD("  "~FStr(FBN['PrecioFin'],0,10)~", ") 
      SQL.ADD("  "~FStr(FBN['CantidadFin'],0,10)~", ") 
      SQL.ADD("  "~FStr(Val(r:FAC),0,10)~", ") 
      SQL.ADD("  '"~FBN['Cupon']~"', ") 
      SQL.ADD("  "~FStr(Val(r:FAC),0,10)~", ")
      SQL.ADD("  "~FStr(FBN['PrecioHist'],0,10)~" ") 
      SQL.ADD(" ) ")
      SQL.NEW
      SQL.EXEC
    ENDIF    

    SQL.ADD("EXEC "~DBO~".RecalculaPosiciones ")
    SQL.ADD(" '"~IdxDate(Dialogo.Fecha1)~"', ")
    SQL.ADD(" '"~FBN['Cliente']~"', ")
    SQL.ADD(" '"~FBN['Vehiculo']~"', ")
    SQL.ADD(" '"~FBN['Unidad']~"', ")

    SQL.ADD(" '"~FBN['Centro']~"', ")
    SQL.ADD(" '"~FBN['Sector']~"', ")
    SQL.ADD(" '"~FBN['Sucursal']~"', ")
    SQL.ADD(" "~Fstr(FBN['NrSaldo'],3,0)~", ")

    SQL.ADD(" '"~FBN['Especie']~"', ")
    If FBN['PrecioEj']=0
      SQL.ADD(" NULL,")
    Else
      SQL.ADD(" "~Fstr(FBN['PrecioEj'],15,8)~", ")
    Endif
    If Vacio(FBN['FechaEj'])
      SQL.ADD(" NULL,")
    Else
      SQL.ADD(" "~IdxDate2(FBN['FechaEj'])~", ")
    Endif
    SQL.ADD(" '"~FBN['CallPut']~"', ")

    SQL.ADD(" '"~FBN['Cupon']~"', ")
    SQL.ADD(" '"~FBN['Estrategia']~"', ")
    SQL.ADD(" '"~FBN['Cartera']~"', ")
    SQL.ADD(" '"~FBN['Book']~"', ")

    SQL.ADD(" '"~FBN['Trader']~"', ")
    SQL.ADD(" '"~FBN['TipoNegocio']~"' ")
    SQL.NEW
    SQL.EXEC
  endif

Proximo

if FAC>1
  SetFont(a:2..x:FAC, 1)
  FormatoCeldas(e:2..e:FAC, Exe('F0'))
  FormatoCeldas(j:2..j:FAC, Exe('F2'))
  FormatoCeldas(k:2..k:FAC, Exe('F8'))
  FormatoCeldas(l:2..l:FAC, Exe('F2'))
  FormatoCeldas(m:2..r:FAC, Exe('F8'))
endif
