MostrarCuadroDeMensajes
CrearDialogo
    Fecha1           : 'Fecha'   ;;;;;;;;;FSys
    Lista1           : 'Especie' ;;;;;;;;;;;SQLSET("SELECT DISTINCT Especie FROM "~DBO~".DETITOFIN  where Fecha= '"~IdxDate(Dialogo.Fecha1)~"' ORDER BY Especie ") 
FinDialogo

If Not Ok 
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(a:1, "INFORME TITOFIN/AJUSTES")
SetFont(a:1,3)

let &fecha Dialogo.Fecha1

ACT(a:3, "Fecha : "~&fecha)
SetFont(c:1..c:3,2)

ACT(a:5, "Fecha Valor")
ACT(b:5, "Especie")
ACT(c:5, "CuentaContable")
ACT(d:5, "Fecha Ini. tenencia")
ACT(e:5, "Valor Residual")
ACT(f:5, "Valor Contable")
ACT(g:5, "Valor Cont Valuado")
ACT(h:5, "Oper/Trans")


*AlinearCeldas(a4..h4,'C')
SetFont(a5..h5,2)
AgregarMarco(a5..h5,2,0,Exe('COLOR'))

SQL.ADD("select DT.Fecha1 Fecha, DT.Especie, DT.Cantidad1 Valorresidual, DT.CuentaContable1 CuentaContable, DT.Cantidad2 ValorContable, ")
SQL.ADD("DT.Cantidad3 ValorContValuado, DT.Fecha2 FecIncorporacion, DT.Fecha2 FechaInicioTenencia, ")
SQL.ADD("Nrtrans NrOperacion ")
SQL.ADD(" From "~DBO~".TRANSACCIONES2 DT  ")
SQL.ADD("  Where  DT.TipoTr2='AJUTFI'")
SQL.ADD("  and cantidad2 <> 0  ")
SQL.ADD("  and DT.Fecha1 = "~IdxDate2(&fecha)~" ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") ") 
endif
SQL.ADD("UNION ")
SQL.ADD("SELECT D.Fecha, D.Especie,D.Valorresidual,D.CuentaContable, D.ValorContable, ")
SQL.ADD(" D.ValorContValuado, D.FecIncorporacion,IsNull(E.FechaInicioTenencia,D.FecIncorporacion) FechaInicioTenencia,  ")
SQL.ADD(" NrOperacion ")
SQL.ADD(" FROM "~DBO~".DETITOFIN D,"~DBO~".ESPECIES E ")
SQL.ADD(" WHERE D.Fecha = '"~IdxDate(&fecha)~"' and  E.Codigo=D.Especie ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") ") 
endif
SQL.ADD("Order By Fecha, Especie, CuentaContable")
watch(SQL.Batch)

let &zz 6

Recorrer SQL
    ACD(a:&zz, fbn('Fecha'))
    ACT(b:&zz, fbn('Especie'))
    ACT(c:&zz, fbn('CuentaContable'))
    ACT(d:&zz, fbn('FechaInicioTenencia'))
    ACN(e:&zz, fbn('ValorResidual'))
    ACN(f:&zz, fbn('ValorContable'))
    ACN(g:&zz, fbn('ValorContValuado'))
    ACT(h:&zz, fbn('NrOperacion'))
    if EqStr(Copy(fbn('NrOperacion'),1,1),'A')
       ACLT(h:&zz, fbn('NrOperacion'))
    else
       ACLO(h:&zz, fbn('NrOperacion'))    
    endif   
    let &zz &zz+1
Proximo

ACO(1, 10)
ACO(2, 10)
ACO(3, 10)
ACO(4, 10)
ACO(5, 12)
ACO(6, 12)
ACO(7, 12)
ACO(8, 10)

LimitesVision(h:&zz)
