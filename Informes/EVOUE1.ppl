CrearDialogo
  NrTrans1:'Voucher'   ;
  Check1  :'Re-Emision';
  Check3  :'Impresora' ;
  Mercado1: 'Mercado'
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,12,B')
CrearFont(5, "Arial,5,")
If Eqstr(dialogo.Mercado1,'CRYL')
   act(a:3,'Emision Vouchers CRYL')
Else
   act(a:3,'Emision Vouchers Euroclear')
Endif
act(a:4,'Fecha :'~Fecha(FSys))

AgregarBMP(A:1,EXE('LOGO'),EXE('ESCALOGO'))

*-----------------------------
If Dialogo.Check1 = 0
  ACT(e:1, 'ORIGINAL')
else
  ACT(e:1, 'COPIA')
endif
SetFont(e:1..e:1,3)

*------------------------------

SetFont(a:1..z:4,2)
SQL.ADD("SELECT * FROM "~DBO~".TRANSACCIONES2 ")
SQL.ADD("WHERE NrTrans='"~Dialogo.NrTrans1~"'")
Recorrer SQL
  acn(l:1,0)
  IF [EqStr(Fbn['Mercado1'],'CE') o EqStr(Fbn['Mercado1'],'EU') o EqStr(Fbn['Mercado1'],'CRYL')] 
    scn(l:1,1)
    SetFilaActual(1)
    SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES ")
    SQL.ADD("WHERE NrOperacion='"~Copy(fbn['NrOperacionRef1'],1,8)~"'")
    acn(z:1,0)
    Recorrer SQL
    
      if (EqStr(FBN['FormaLiquidacion2'], '0'))
        *FD&P no se sabe
        ACT(u1,'0')
        ACT(u2,'FD&P')
      else 
        if (EqStr(FBN['Formaliquidacion2'], '1'))
            ACT(u1,'1')
            ACT(u2,'DVP')
        else 
            if (EqStr(FBN['Formaliquidacion2'], '2'))
              ACT(u1,'F')
              ACT(u2,'FOP')
            endif
        endif
       endif
         
      ACT(g:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
      ACT(g:2, 'C.U.I.T. No '~BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Vehiculo1')))    
      *if BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Vehiculo1')) > 0
      *  ACT(g:3, 'Agente de Mercado Abierto No '~BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Vehiculo1')))
      *endif
      if BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')) > 0
        ACT(g:4, 'Cuenta en Caja de Valores No '~BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')))
      endif
      SetFont(g:1..g:1,2)
      SetFont(g:2..g:4,2)

      *act(a:5, 'No MAE: ' ~fbn('NroAltaMAE'))
       
      *messagebox(val(A:FAC))
      ACT(ii:FAC, BuscarCampo('OPERACIONES','MERCADO4','NrOperacion',fbn['NrOperacion']) )
      
      if Eqstr(val(ii:FAC), VAR('AMBMAE'))

      *ACT(a:5, 'N°MAE '~ BuscarCampo('ESPECIES', 'CodMAEContado', 'Codigo', fbn['Especie']))
           ACT(a:5, 'N°MAE '~ BuscarCampo('OPERACIONES', 'NroAltaMAE', 'NrOperacion', fbn['NrOperacion']))
           ACT(g:3, 'Agente Mercado Abierto ' ~ BuscarCampo('CLIENTES','NrMAE','Codigo', VAR('VEHICULODE')))
      else
            if Eqstr(val(ii:FAC), VAR('AMBBYMA'))
                 ACT(a:5, 'N°BYMA'~ BuscarCampo('OPERACIONES', 'NroAltaMAE', 'NrOperacion', fbn['NrOperacion']))
                 ACT(g:3, 'Agente BYMA ' ~ BuscarCampo('CLIENTES','NrBYMA','Codigo', VAR('VEHICULODE')))
             endif       
      endif 
           
      
      scn(z:1,1)
      ACT(v1,BuscarCampo('TiposOperacion','Nombre','Codigo',fbn['TipoOp']))
      if Incluido(fbn['TipoOp'],'TIC|TIV|TIFC|TIFV|TIADJ|TIRES|')
        *i*f [Incluido(fbn['TipoOp'],'TIC|TIV') y fbn['FormaLiquidacion2']>0] o [Incluido(fbn['TipoOp'],'TIFC|TIFV') y fbn['FormaLiquidacion2']>0]
        if [Incluido(fbn['TipoOp'],'TIC|TIV|TIADJ|TIRES') y fbn['FormaLiquidacion2']>0] o [Incluido(fbn['TipoOp'],'TIFC|TIFV|')]
          ACN(w1,1)
        endif
        if Incluido(fbn['TipoOp'],'TIC|TIFC|TIADJ|TIRES|')
          ACT(v2, '4')
          ACT(v3, 'Compra')
          ACN(v4, 1)
        endif
        if Incluido(fbn['TipoOp'],'TIV|TIFV')
          ACT(v2, '5')
          ACT(v3, 'Venta')
          ACN(v4, -1)
        endif
      endif
      if Incluido(fbn['TipoOp'],'TICT|TIDE|TICO|TIPO')
        ACN(w1,3)
      endif
      ACT(Z:2,FBN['TipoOp'])
      act(z:3,fbn['PaseCB'])
      act(z:4,fbn['OperacionRef'])
    Proximo

    if Incluido(val(z:2),'TIC|TIV|TIFC|TIFV|TIADJ|TIRES') y EqStr(VAL(Z:3),'1')
      SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES")
      SQL.ADD("WHERE NrOperacion='"~val(z:4)~"'")
    else
      SQL.ADD("SELECT * FROM "~DBO~".OPERACIONES ")
      SQL.ADD("WHERE NrOperacion='"~Copy(fbn['NrOperacionRef1'],1,8)~"'")
    endif

    Recorrer SQL
      act(q:1,SQL("SELECT NrOperacion FROM "~DBO~".INSTANCIASOP WHERE NrOperacion='"~fbn['OperacionRef']~"'AND NrInstancia = 90 "))
      Act(q:2,BuscarCampo('Operaciones','Observac2','NrOperacion',FBN['OperacionRef']))     
      act(q:3,SQL("SELECT NrOperacion FROM "~DBO~".INSTANCIASOP WHERE NrOperacion='"~fbn['OperacionRef']~"'AND NrInstancia = 81"))
      act(m:1,SQL("SELECT NrOperacion FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~FBN['NrOperacion']~"' AND (NrBit=95 OR NrBit=90) AND Valor='1'"))
      *if [Not CeldaVacia(Q:1) o Not CeldaVacia(q:2) o Not CeldaVacia(q:3)] y Not CeldaVacia(m:1)
      *   ACT(v6,'OK')
      *else
      *   ACT(v6,'Falta')
         ACN(w2,1)
      *endif

      *--- Esta confirmado si/no?  
      *act(n:1,SQL("SELECT NrOperacion FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~fbn['NrOperacion']~"' AND (NrBit=95 OR NrBit=80) AND Valor='1'"))
      act(n:1,SQL("SELECT Distinct NrOperacion FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~fbn['NrOperacion']~"' AND NrBit=4 AND Valor='1'"))
      if NoVacio(fbn['Observac3']) y Not CeldaVacia(n:1)
*        ACT(v7,'OK')
      else
*        ACT(v7,'Falta')
        ACN(w2,1)
      endif
    Proximo
    ACT(T:1,Copy(fbn['NrOperacionRef1'],1,8))
  endif
Proximo

if val(l:1)>0
  SetFilaActual(FAC+2)

  if val(z:1)=0
    ACN(w1,2)
  endif

  SQL.ADD(" SELECT O.*, T.Especie TESP, T.Cliente1 TCL1, T.TipoTr2, T.NrTrans, T.Cuenta1 TCUE1, ")
  SQL.ADD(" T.Cantidad1, T.NrOperacionRef1, T.UsrInput, T.Fecha2, T.CB1, T.CB2, T.Mercado1, T.Cantidad1, ")  
  SQL.ADD(" E.InteresesC, E.EuroClear, E.ISIN, E.VTeorico, ")
  
  *Se agregan columnas para verificar transacciones falladas. CAL 24/11/2022
  SQL.ADD("T.Cantidad4 as CantPagada, T.CB3 as CBFallas")
  
  SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E ")
  SQL.ADD(" WHERE O.NrOperacion = '"~Val(T:1)~"' ")
  SQL.ADD(" AND   T.NrTrans     = '"~Dialogo.NrTrans1~"'")
  SQL.ADD(" AND   T.Especie     = E.Codigo  ")
  Recorrer SQL
    if Val(w1)=1
      ACT(a:FAC+4, 'Voucher de liquidacion Nro. : '~fbn['NrTrans'])
      ACT(g:FAC+4, 'Liquidacion del : '~fbn['Fecha2'])
      SetFont(a:FAC..i:FAC+4,2)
      SetFilaActual(FAC+4)
      if EqStr(fbn['TipoTr2'],'MATCH')
         If Eqstr(dialogo.Mercado1,'CRYL')
            ACT(c:FAC+2, 'Liquidar por CRYL - DVP')
         Else
            ACT(c:FAC+2, 'Liquidar por Euroclear - DVP')
         Endif
         ACT(u1, '1')
         ACT(u2, 'DVP')
      else
            
*Preguntar SI Formaliquidacion2 de Operaciones es 
*0 u1=0 u2=FD&P (comentar que FD&P no se sabe)
*1 u1= 1 u2=DVP
*2 u1= F u2=FOP

*Anterior
*ACT(u1, 'F')
*ACT(u2, 'FOP')

         if EqStr(fbn['TipoTr2'],'RET')
            ACT(c:FAC+2, 'Pagar ')
         else
            ACT(c:FAC+2, 'Cobrar ')
         endif
         if DesciendeDeEspecie(fbn['TESP'],'TITULO')
            ACT(c:FAC+2, Val(c:FAC+2)~'Titulos')
         else
            ACT(c:FAC+2, Val(c:FAC+2)~fbn['TESP'])
         endif
         If Eqstr(dialogo.Mercado1,'CRYL')
            ACT(c:FAC+2, Val(c:FAC+2)~' por CRYL - '~VAl(u:2))
         Else
            ACT(c:FAC+2, Val(c:FAC+2)~' por Euroclear - '~VAl(u:2))
         Endif
      endif

      AgregarMarco(a:FAC+2..k:FAC+3, 2,0)
      SetFont(c:FAC+2,4)
      SetFilaActual(FAC+4)
      
      ACT(a:FAC, 'Cliente : '~BuscarCampo('Clientes','RazonSocial','Codigo',fbn['TCL1']))  
      ACT(a:FAC+1, 'Nombre Cta. : ')
      ACT(a:FAC+2, 'Depositario : ')
      ACT(a:FAC+3, 'Nro de Cuenta : ')
      ACT(a:FAC+1, Val(a:FAC+1)~BuscarCampo('Cuentas','Nombre','Codigo',fbn['TCUE1']))
      ACT(a:FAC+3, Val(a:FAC+3)~BuscarCampo('Cuentas','Numero','Codigo',fbn['TCUE1']))
      ACT(a:FAC+4, 'Common Code : '~FStr(fbn('EuroClear'),1,0))
      ACT(a:FAC+5, 'Nro ISIN : '~fbn('ISIN'))
      ACT(g:FAC, 'Tipo de Operacion : '~Val(v1))
      If Eqstr(dialogo.Mercado1,'CRYL')
         ACT(g:FAC+1, 'Instruccion CRYL : '~Val(v2)~Val(u1)~' - '~Val(v3)~' '~Val(u2))
      Else
         ACT(g:FAC+1, 'Instruccion Euroclear : '~Val(v2)~Val(u1)~' - '~Val(v3)~' '~Val(u2))
      Endif
      ACT(g:FAC+2, 'Especie : '~fbn['Especie'])
      ACT(g:FAC+3, 'Fecha Concertacion : '~fbn['FechaOp'])
      ACT(g:FAC+4, 'Fecha Liquidacion : '~fbn['FechaVto'])
      SetFont(a:FAC..g:FAC+5,2)
      SetFilaActual(FAC+7)
      
      ACT(a:FAC, 'Nro.Op.')
      ACT(b:FAC, 'Descripcion')
      ACT(c:FAC, 'Cantidad')
      ACT(d:FAC, 'Precio')
      ACT(e:FAC, 'Moned.')
      ACT(f:FAC, 'Monto')
      ACT(g:FAC, 'Intereses')
      ACT(h:FAC, 'Monto')
      *ACT(i:FAC, 'Compl.')
      ACT(j:FAC, 'Confir.')
      ACT(c:FAC+1, 'Val.Nom.')
      ACT(d:FAC+1, 'Limpio')
      ACT(h:FAC+1, 'Total')
      AgregarMarco(a:FAC..k:FAC+1, 2,2,EXE('COLOR'))
      AlinearCeldas(c:FAC..j:FAC+1, 'C')
      SetFont(a:FAC..j:FAC+3,2)
      ACT(k:FAC, '|')
      ACT(k:FAC+1, '|')
      SetFont(k:FAC..k:FAC+1,4)
      SetFilaActual(FAC+2)
      ACT(a:FAC, fbn['NrOperacion'])

      ACN(BD:1, 0)
      SQL.ADD("Select Leyenda, NrMov From "~DBO~".MOVEJECUTADOS ")
      SQL.ADD("where  NrTrans2 = '"~fbn['NrTrans']~"' ")
      SQL.ADD("and  NrOperacion <> '"~fbn['NrTrans']~"' ")
      SQL.ADD(" AND NrMov = 1000 ")
      SQL.ADD(" AND Leyenda Like '%Corte de Cupon%' ")
      Recorrer SQL
          DFA
          ACN(BD:1, 1)
      Proximo
      IF Val(BD:1) = 1
          ACT(b:FAC, 'Corte de '~fbn['Especie'])
      ELSE
          ACT(b:FAC, Val(v3)~' de '~fbn['Especie'])
      ENDIF
    
      *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
      If(FBN['CBFallas'] = 1)
        ACN(c:FAC, fbn['CantPagada']*Val(v4))
      else
        ACN(c:FAC, fbn['Cantidad']*Val(v4))
      endif

      If Eqstr(FBN['PaseCB'],'1')
         ACN(d:FAC, fbn['TipoCambio2'])
      else
         ACN(d:FAC, fbn['Precio1'])
      endif
      FormatoCeldas(d:FAC..d:FAC,EXE('F8'))
      
      ACT(e:FAC, fbn['ContraEspecie'])
      
      ********************************************************************
      *CALCULAMOS EL FACTOR EN CASO DE QUE LA TRANSACCIÓN ESTÉ FALLADA
      *DE LO QUE SE PAGÓ VERSUS LO QUE HABÍA QUE PAGAR - CAL 28/11/2022
      ********************************************************************

      IF Val(BD:1) = 0
         If Eqstr(FBN['PaseCB'],'1')
            *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(f:FAC, -fbn['CantPagada'] * Val(v4) * Val(d:fac))
                ACN(h:FAC, -fbn['CantPagada'] * Val(v4) * Val(d:fac))
            Else
                ACN(f:FAC, -fbn['TotalCaucion']*Val(v4))
                ACN(h:FAC, -fbn['TotalCaucion']*Val(v4))
            EndIf
         else 
            *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(f:FAC, -fbn['CantPagada']*Val(v4) * Val(D:FAC))
                ACN(h:FAC, -fbn['CantPagada']*Val(v4) * Val(D:FAC))
            Else
                ACN(f:FAC, -fbn['TotalBrutoCli1']*Val(v4))
                ACN(h:FAC, -fbn['TotalNetoCli1']*Val(v4))
            EndIf
            
         endif 
         If Eqstr(fbn('InteresesC'),'CLE')
            ACN(g:FAC, -fbn['TotalIntereses']*Val(v4))
         Endif
      ELSE
        *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
          If(FBN['CBFallas'] = 1)
            ACN(f:FAC, fbn('CantPagada') * Val(D:FAC))
            ACN(h:FAC, fbn('CantPagada') * Val(D:FAC))
          Else
            ACN(f:FAC, fbn('Cantidad1'))
            ACN(h:FAC, fbn('Cantidad1'))
          Endif
          
      ENDIF

      ACT(j:FAC, Val(v7))
      AlinearCeldas(e:FAC, 'C')
      AlinearCeldas(i:FAC..j:FAC, 'C')
      AgregarMarco(a:FAC..k:FAC, 2,0)
      SetFont(a:FAC..j:FAC,1)
      FormatoCeldas(c:FAC..c:FAC,EXE('F2'))
      FormatoCeldas(f:FAC..h:FAC,EXE('F2'))
      ACT(k:FAC, '|')
      SetFont(k:FAC,4)
      SetFilaActual(FAC+1)

      If EqStr(fbn['TipoTr2'],'MATCH')
         IF EqStr(Val(v3),'Compra')
            ACT(C:FAC+1, 'Total a Pagar: ')
         ELSE
            ACT(C:FAC+1, 'Total a Cobrar: ')
         ENDIF
      Else
         If EqStr(fbn['TipoTr2'],'RET')
            ACT(C:FAC+1, 'Total a Pagar: ')
         Else
            ACT(C:FAC+1, 'Total a Cobrar: ')
         Endif
      Endif

      if EqStr(val(z:6),fbn['Especie'])
        ACT(f:FAC, 'Val.Nom.')
        ACT(g:FAC, 'Val.Res.')
        *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
        If(FBN['CBFallas'] = 1)
            ACN(f:FAC+1, fbn['CantPagada']*Val(v4))
            ACN(g:FAC+1, fbn['CantPagada']*Val(v4)*fbn('VTeorico'))
        Else
            ACN(f:FAC+1, fbn['Cantidad']*Val(v4))
            ACN(g:FAC+1, fbn['Cantidad']*Val(v4)*fbn('VTeorico'))
        Endif
        
      endif
      
      If EqStr(FBN['TipoTr2'],'MATCH') o EqStr(fbn['TESP'],fbn['ContraEspecie'])
         ACT(h:FAC, fbn['ContraEspecie'])
         IF Val(BD:1) = 0
            If Eqstr(FBN['PaseCB'],'1')
                
            *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
                If(FBN['CBFallas'] = 1)
                ACN(h:FAC+1, -fbn['CantPagada'] * Val(v4) * Val(d:fac-1))
                Else
                    ACN(h:FAC+1, -fbn['TotalCaucion']*Val(v4))
                Endif
         
            else
               *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
               If(FBN['CBFallas'] = 1)
                  ACN(h:FAC+1, -fbn['CantPagada']*Val(v4))
               Else
                ACN(h:FAC+1, -fbn['TotalNetoCli1']*Val(v4) * Val(d:fac-1))
               Endif
               
            endif
         ELSE
            *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(h:FAC+1, fbn('CantPagada'))
            Else
                ACN(h:FAC+1, fbn('Cantidad1'))
            Endif
            
         ENDIF
      Else
         *Si es una falla, se muestra solo lo que se pagó. Si no, el total. CAL 24/11/2022
            If(FBN['CBFallas'] = 1)
                ACN(h:FAC+1, fbn('CantPagada'))
            Else
                ACN(h:FAC+1, fbn('Cantidad1'))
            Endif
      Endif
      AlinearCeldas(f:FAC..h:FAC, 'D')
      SetFont(C:FAC+1,2)
      SetFont(f:FAC..h:FAC+1,2)
      FormatoCeldas(f:FAC+1..h:FAC+1,EXE('F2'))
      FormatoCeldas(d:FAC+1..d:FAC+1,EXE('F8'))
      AgregarMarco(C:FAC..H:FAC+2, 2,0,EXE('COLOR'))
      SetFilaActual(FAC+3)

      ACT(h:FAC+5, 'Por '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
      AgregarMarco(a:FAC+1..j:FAC+5,2,0)
      SetFont(h:FAC+5,2)
   
      SetFilaActual(FAC+8)
      ACT(A:FAC, 'Preparado por : '~BuscarCampo('Usuarios','Nombre','Codigo',USUARIOACTIVO))
      SetFont(A:FAC,2)
      SetFilaActual(FAC+4)
      if Not EqStr(FBN['TipoTr2'],'MATCH') y Not DesciendeDeEspecie(fbn['TESP'],'TITULO')
        ACT(a:FAC, 'Realizar ')
        if EqStr(FBN['TipoTr2'],'RET')
           ACT(a:FAC, Val(a:FAC)~'Pago ')
        else
           ACT(a:FAC, Val(a:FAC)~'Cobro ')
        endif
        ACT(a:FAC, Val(a:FAC)~'por Mercado Alternativo')
        AgregarMarco(a:FAC..f:FAC+5,2,0)
        SetFont(a:FAC..a:FAC+1,2)
        ACT(g:FAC, 'Supervisado por :')
        SetFont(g:FAC,2)
        SetFilaActual(FAC+5)
        ACT(a:FAC,' ')
      endif
      
      ACT(c:fac+8,'   '~BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Telefono','Codigo',fbn('Vehiculo1')))
      SetFont(c:fac+8..c:fac+8,1)
      SetFilaActual(FAC+8)
      SetFont(A:FAC,2)
      *FormatoCeldas(c:1..f:FAC,Exe('F2'))
      SetFont(x1..z2,1)
      
      ACO(1,5)
      ACO(2,9)
      ACO(3,7)
      ACO(4,8)
      ACO(5,4)
      ACO(6,6)
      ACO(7,7)
      ACO(8,7)
      ACO(9,1)
      ACO(10,9)  
    endif
*************************************************************
    if Val(w1)=2
      SetFilaActual(FAC+4)
      ACT(a:FAC, 'Error en los datos del Voucher Nr. '~Dialogo.NrTrans1)
      SetFont(a:FAC,2)
      SetFilaActual(FAC+4)
      LimitesVision(e:FAC)
    endif
*************************************************************
    if Val(w1)=3
      ACT(a:FAC+4, 'Voucher de liquidacion Nro. : '~FBN['NrTrans'])
      ACT(d:FAC+4, 'Liquidacion del : '~FBN['Fecha2'])
      SetFont(a:FAC..f:FAC+4,2)
      SetFilaActual(FAC+4)
      if EqStr(FBN['TipoTr2'],'RET')
        ACT(v2, '5')
        ACT(b:FAC+2, 'Pagar ')
        ACT(u1, 'Entregar')
        ACN(u2, -1)
      else
        ACT(v2, '4')
        ACT(b:FAC+2, 'Cobrar  ')
        ACT(u1, 'Recibir ')
        ACN(u2, 1)
      endif
      if DesciendeDeEspecie(FBN['TESP'], 'TITULO')
         ACT(b:FAC+2, Val(b:FAC+2)~'Titulos')
      else
         ACT(b:FAC+2, Val(b:FAC+2)~FBN['TESP'])
      endif
      If Eqstr(dialogo.Mercado1,'CRYL')
         ACT(b:FAC+2, Val(b:FAC+2)~'  por CRYL  -  FOP')
      Else
         ACT(b:FAC+2, Val(b:FAC+2)~'  por Euroclear  -  FOP')
      Endif
      AgregarMarco(a:FAC+2..h:FAC+3, 2)
      SetFont(a:FAC+2,4)
      SetFilaActual(FAC+4)

      ACT(a:FAC, 'Cliente : '~BuscarCampo('Clientes','RazonSocial','Codigo',fbn['TCL1']))
      ACT(a:FAC+1, 'Nombre de la Cta : ')
      ACT(a:FAC+2, 'Depositario : ')
      ACT(a:FAC+3, 'Nro de Cuenta : ')
      ACT(a:FAC+1, Val(a:FAC+1)~BuscarCampo('Cuentas','Nombre','Codigo',fbn['TCUE1']))
      ACT(a:FAC+3, Val(a:FAC+3)~BuscarCampo('Cuentas','Numero','Codigo',fbn['Cuenta1']))     
      ACT(a:FAC+4, 'Common Code : '~FStr(FBN('EuroClear'),1,0))
      ACT(a:FAC+5, 'Nro ISIN : '~FBN('ISIN'))
      ACT(c:FAC, 'Tipo de Operacion : '~Val(v1))
      If Eqstr(dialogo.Mercado1,'CRYL')
         ACT(c:FAC+1, 'Instruccion  CRYL : '~Val(v2)~'F - '~FBN['TipoOp']~' FOP')
      Else
         ACT(c:FAC+1, 'Instruccion  Euroclear : '~Val(v2)~'F - '~FBN['TipoOp']~' FOP')
      Endif
      ACT(c:FAC+2, 'Especie : '~fbn['TESP'])
      ACT(c:FAC+3, 'Fecha Concertacion : '~FBN['FechaOp'])
      ACT(c:FAC+4, 'Fecha Liquidacion : '~fbn['Fecha2'])
      SetFont(a:FAC..e:FAC+5,2)
      SetFilaActual(FAC+7)

      ACT(a:FAC, 'Nro.Op.')
      ACT(b:FAC, 'Descripcion')
      ACT(C:FAC, 'Cantidad')
      *ACT(D:FAC, 'Compl.')
      ACT(E:FAC, 'Confir.')
      AgregarMarco(a:FAC..A:FAC, 2,2,EXE('COLOR'))
      AgregarMarco(b:FAC..B:FAC, 2,2,EXE('COLOR'))
      AgregarMarco(C:FAC..C:FAC, 2,2,EXE('COLOR'))
      AgregarMarco(D:FAC..D:FAC, 2,2,EXE('COLOR'))
      AgregarMarco(E:FAC..E:FAC, 2,2,EXE('COLOR'))
      AlinearCeldas(C:FAC, 'D')
      AlinearCeldas(D:FAC..E:FAC, 'C')
      SetFont(a:FAC..g:FAC,2)
      ACT(h:FAC, '|')
      SetFont(h:FAC,4)
      SetFilaActual(FAC+1)
      ACT(a:FAC, fbn['NrOperacion'])
      ACT(b:FAC, Val(v1)~' '~fbn['Especie'])
      ACN(C:FAC, fbn['Cantidad1']*Val(u2))

      ACT(E:FAC, Val(v7))
      AlinearCeldas(D:FAC..E:FAC, 'C')
      AgregarMarco(a:FAC..e:FAC, 2)
      SetFont(a:FAC..g:FAC,1)
      FormatoCeldas(C:FAC,EXE('F2'))
      ACT(h:FAC, '|')
      SetFont(h:FAC,4)
      SetFilaActual(FAC+1)
      ACT(C:FAC, 'Val.Nominal Resid.')
      ACT(d:FAC, 'Val.Resid.')
      AlinearCeldas(d:FAC..e:FAC, 'D')
      ACT(b:FAC+1, 'Total:')
      ACN(c:FAC+1, fbn['Cantidad1']*Val(u2))
      ACN(d:FAC+1, fbn['Cantidad1']*fbn('VTeorico')*Val(u2))
      SetFont(b:FAC+1,2)
      SetFont(b:FAC..F:FAC+1,2)
      FormatoCeldas(c:FAC+1..c:FAC+1,EXE('F2'))
      FormatoCeldas(d:FAC+1..d:FAC+1,EXE('F8'))
      AgregarMarco(b:FAC..c:FAC+2, 2,0,EXE('COLOR'))
      SetFilaActual(FAC+3)
      if EqStr(FBN['TipoTr2'],'RET')
        ACT(a:FAC+1, 'Aprobacion desembolso')
        AgregarMarco(a:FAC+1..b:FAC+6,2,0)
        SetFont(a:FAC+1,2)
      endif
      if Val(w2)=1
        ACT(c:FAC+1, 'Regularizacion Excepciones')
        AgregarMarco(c:FAC+1..e:FAC+6,2,0)
        SetFont(c:FAC+1,2)
      endif 
      ACT(A:FAC, 'Preparado por : '~BuscarCampo('Usuarios','Nombre','Codigo',FBN['UsrInput']))

      ACT(c:fac+8,'   '~BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Telefono','Codigo',fbn('Vehiculo1')))
      SetFont(c:fac+8..c:fac+8,1)
      SetFilaActual(FAC+8)
      SetFont(A:FAC,2)

      *FormatoCeldas(c:1..f:FAC,Exe('F2'))
      
      SetFont(x1..z2,1)
      ACO(1,7)
      ACO(2,20)
      ACO(3,10)
      ACO(4,20)
      ACO(5,9)      
      ACO(10,9)      

    endif
    SetFont(u1..z7,1)    
  Proximo

  if val(w:1)=3
    LimitesVision(e:FAC)
  else
    if val(w:1)=1
      LimitesVision(j:FAC)
    endif
  endif
  if Dialogo.Check3=1
    ImprimirHoja
  endif
else
  Cancelar('El Voucher '~Dialogo.NrTrans1~' no puede imprimirse')
endif
