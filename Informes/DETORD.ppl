* Revisar tope de fechas
CrearDialogo 
  Fecha1:   'Fecha'       ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Cliente1: 'Cliente'     ;2;1;;;;;
  Especie1: 'Especie'     ;3;1;;;;Vacio(Dialogo.Especie1) O [DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y EsTerminal(Dialogo.Especie1, Especie)];'Debe ingresar un Titulo';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "
  NrOrden: 'Nro. Orden'  ;4;1;;;;;;;
FinDialogo

If Not Ok
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BU")

SetFilaActual(3)

ACT(A:FAC,'Detalle de Ordenes Ejecutadas')
SetFont(A:FAC,4)

SetFilaActual(FAC+2)

ACT(A:FAC,'Fecha: '~Dialogo.Fecha1)

If Vacio(Dialogo.Cliente1)
   ACT(A:FAC+1,'Cliente: Todos ')
Else
   ACT(A:FAC+1,'Cliente: '~Dialogo.Cliente1)
EndIf

If Vacio(Dialogo.Especie1)
   ACT(C:FAC,'Especie: Todos')
Else
   ACT(C:FAC,'Especie: '~Dialogo.Especie1)
EndIf

If Vacio(Dialogo.NrOrden)
   ACT(C:FAC+1,'Nro. Orden: Todos')
Else
   ACT(C:FAC+1,'Nro. Orden: '~Dialogo.NrOrden)
EndIf
SetFont(A:FAC..C:FAC+1,3)

SetFilaActual(FAC+3)

ACT(A:FAC,'Tipo Orden')
ACT(B:FAC,'Nro. Orden')
ACT(C:FAC,'Especie')
ACT(D:FAC,'Moneda')
ACT(E:FAC,'Cantidad')
ACT(F:FAC,'Precio Limite')
ACT(G:FAC,'Nro. Secuencia')
ACT(H:FAC,'Cantidad VN')
ACT(I:FAC,'Precio')
ACT(J:FAC,'Fecha')

SetFont(A:FAC..J:FAC,2)
AlinearCeldas(A:FAC..J:FAC,'C')
AgregarMarco(A:FAC..J:FAC,2,0,EXE('COLOR'))

SQL.ADD(" Select O.TipoOrden, O.NrOrden, O.Especie, O.ContraEspecie, O.CantidadTotalOrden, O.PrecioLimite, O.NroAltaMAE, O.Cantidad4, E.Cantidad, E.Precio, E.Fecha ")
SQL.ADD(" From  "~DBO~".ORDENES O, "~DBO~".EJECUCIONES E ")
* Si le pegan la hora a la fechaorden hay que hacer esto
*SQL.ADD(" Where O.NrOrden = E.NrOrden and O.FechaOrden >= '"~IdxDate(Dialogo.Fecha1)~"' and O.FechaOrden < '"~IdxDate(Dialogo.Fecha1+1)~"' ")
SQL.ADD(" Where O.NrOrden = E.NrOrden and O.FechaOrden = '"~IdxDate(Dialogo.Fecha1)~"' ")

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente='"~Dialogo.Cliente1~"' ")  
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie='"~Dialogo.Especie1~"' ")  
EndIf
If NoVacio(Dialogo.NrOrden)
   SQL.ADD(" and O.NrOrden = '"~Dialogo.NrOrden~"' ")  
EndIf
SQL.ADD(" Order by O.NrOrden ")

ACN(CO:1,FAC)
ACT(OR:1,'')
ACN(X:1,0)
ACN(X:2,0)

Recorrer SQL
  If Not EqStr(FBN['NrOrden'],Val(OR:1)) Y Not Eqstr(Val(OR:1),'')
     ACT(G:FAC,'Total Cantidad VN, Precio Promedio:')
     AlinearCeldas(G:FAC,'D')
     ACN(H:FAC,Val(X:2))
     ACN(I:FAC,Val(OR:2))
     AgregarMarco(A:FAC..J:FAC,0,0)
     SetFont(G:FAC..I:FAC,2)
     IFA
     ACN(X:1,0)
     ACN(X:2,0)
  EndIf
  If Val(X:1)=0
     ACT(A:FAC,FBN['TipoOrden'])
     ACT(B:FAC,FBN['NrOrden'])
     ACLR(B:FAC,FBN['NrOrden'])
     ACT(C:FAC,FBN['Especie'])
     ACT(D:FAC,FBN['ContraEspecie'])
     ACN(E:FAC,FBN['CantidadTotalOrden'])
     ACN(F:FAC,FBN['PrecioLimite'])
     ACT(G:FAC,FBN['NroAltaMAE'])
     SetFont(A:FAC..G:FAC,2)
     AgregarMarco(A:FAC..J:FAC,0,0,EXE('COLOR8'))
     IFA
     ACN(X:1,1)
  EndIf
  If Val(X:1)=1
     ACN(H:FAC,FBN['Cantidad'])
     ACN(I:FAC,FBN['Precio'])
     ACT(J:FAC,Fecha(FBN['Fecha'])~' '~Hora(FBN['Fecha']))
     SetFont(H:FAC..J:FAC,1)
  EndIf
  ACT(OR:1,FBN['NrOrden'])
  ACN(OR:2,FBN['Cantidad4'])
  SCN(X:2,FBN['Cantidad'])
Proximo

ACT(G:FAC+1,'Total Cantidad VN, Precio Promedio:')
AlinearCeldas(G:FAC+1,'D')
ACN(H:FAC+1,Val(X:2))
ACN(I:FAC+1,BuscarCampo('ORDENES','Cantidad4','NrOrden',Val(OR:1)))
AgregarMarco(A:FAC+1..J:FAC+1,0,0)
SetFont(G:FAC+1..I:FAC+1,2)

FormatoCeldas(E:Val(CO:1)..E:FAC+1,Exe('F2'))
FormatoCeldas(F:Val(CO:1)..F:FAC+1,Exe('F9'))
FormatoCeldas(H:Val(CO:1)..H:FAC+1,Exe('F2'))
FormatoCeldas(I:Val(CO:1)..I:FAC+1,Exe('F9'))

ACT(A:FAC+3,'FIN DEL INFORME')
SetFont(A:FAC+3,2)

LimitesVision(K:FAC+4)

ACO(6,8)
ACO(7,9)
ACO(8,10)
ACO(9,8)
ACO(10,12)

