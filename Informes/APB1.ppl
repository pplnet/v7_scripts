CrearDialogo
  Fecha1:   'D.Fecha'   ;1;1;;;;;;;fsys
  Fecha2:   'H.Fecha'   ;1;2;;;;;;;fsys
  Radio1:   'Tipo|Ingresos|Egresos|Transf|Operaciones|Todo'  ;2;1;;;;;;;0
  Lista2:   'Bancos'    ; 3;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Monedas'   ;-3;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES WHERE Tipo='MON' ");
  Lista1:   'Vehiculos' ;  ;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Lista4:   'Cuentas'   ;-8;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS ");
  Check1: 'F.Valor';1;1;1;NO;NO;;;;0
  Radio2: 'Tipo|Pendientes|Ejecutados|Ambos';1;1;1;NO;NO;;;;2
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,")
CrearFont(5,"Arial, 8,BI")

ACT(a:3, 'Monedas: '~iif(vacio(Dialogo.Lista3),'Todas',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:4, 'Vehiculos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:5, 'Bancos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
SetFont(a:2..a:5,2)

ACT(b:6, 'Detalle de Movimientos de Posicion Bancaria del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
SetFont(b:6,3)

SetFilaActual(7)

ACT(ea:1,'')
ACT(ba:1,'')
ACT(ca:1,'')
ACN(xx:1,0)

If Dialogo.Radio1=3 o Dialogo.Radio1=4
  If Dialogo.Radio2=0 o Dialogo.Radio2=2
    ACN(xx:1,1)
    SQL.ADD(" SELECT M.Especie, M.Cantidad*(-1) Cantidad, O.TipoOp, C.Comitente, E.Nombre, ")
    SQL.ADD(" CL.RazonSocial, M.Cuenta, M.FechaMov, M.NrOperacion, M.EnteCustodia, C.Numero, O.Cliente1, M.Leyenda, ' ' ConceptoPago ")
    SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
    SQL.ADD(" WHERE  M.NrOperacion = O.NrOperacion ")
    SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
    SQL.ADD(" AND    M.Especie     = E.Codigo ")
    SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
    SQL.ADD(" AND    M.NrSaldo     = 1 ")
    SQL.ADD(" AND    E.Tipo        = 'MON' ")
    SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
    If NoVacio(Dialogo.Lista3)
      SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
    Endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
    If NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    Endif
    If NoVacio(Dialogo.Lista4)
      SQL.ADD(" AND   M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
    Endif
  Endif
  If VAl(xx:1)=1 y [Dialogo.Radio2=1 o Dialogo.Radio2=2]
    SQL.ADD(" UNION ALL ")
  Endif
  If Dialogo.Radio2=1 o Dialogo.Radio2=2
    ACN(xx:1,1)
    SQL.ADD(" SELECT M.Especie, M.Cantidad, O.TipoOp, C.Comitente, E.Nombre, ")
    SQL.ADD(" CL.RazonSocial, M.Cuenta, M.FechaMov, M.NrOperacion, M.EnteCustodia, C.Numero, O.Cliente1, M.Leyenda, ' ' ConceptoPago ")
    SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
    SQL.ADD(" WHERE  M.NrOperacion = O.NrOperacion ")
    SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
    SQL.ADD(" AND    M.Especie     = E.Codigo ")
    SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
    SQL.ADD(" AND    M.NrSaldo     = 1 ")
    SQL.ADD(" AND    E.Tipo        = 'MON' ")
    SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
    If NoVacio(Dialogo.Lista3)
      SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
    Endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
    If NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    Endif
    If NoVacio(Dialogo.Lista4)
      SQL.ADD(" AND   M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
    Endif
  Endif
Endif

If Dialogo.Radio1=4 y [Dialogo.Radio1<>3 o Dialogo.Radio1=4] y [Dialogo.Radio2=0 o Dialogo.Radio2=2]
  SQL.ADD(" UNION ALL ")
Endif

If Dialogo.Radio1<>3 o Dialogo.Radio1=4
  If Dialogo.Radio2=0 o Dialogo.Radio2=2
    ACN(xx:1,1)
    SQL.ADD(" SELECT M.Especie, M.Cantidad, O.TipoTr2 TipoOp, C.Comitente, E.Nombre, ")
    SQL.ADD(" CL.RazonSocial, M.Cuenta, M.FechaMov, M.NrOperacion, M.EnteCustodia, C.Numero, O.Proveedor Cliente1, M.Leyenda, O.ConceptoPago ")
    SQL.ADD(" FROM "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
    SQL.ADD(" WHERE  M.NrOperacion = O.NrTrans ")
    SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
    SQL.ADD(" AND    M.Especie     = E.Codigo ")
    SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
    SQL.ADD(" AND    M.NrSaldo     = 1 ")
    SQL.ADD(" AND    E.Tipo        = 'MON' ")
    If Dialogo.Radio1=0 
      SQL.ADD(" AND    O.TipoTr2 IN ('CRVM') ")
    Endif
    If Dialogo.Radio1=1 
      SQL.ADD(" AND    O.TipoTr2 IN ('DEVM') ")
    Endif
    If Dialogo.Radio1=2 
      SQL.ADD(" AND    O.TipoTr2 IN ('TRANSF') ")
    Endif
    If Dialogo.Radio1=4
      SQL.ADD(" AND    O.TipoTr2 IN ('TRANSF','DEVM','CRVM','TRANSF') ")
    Endif
    If Dialogo.Check1=1
*      SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov < "~IdxDate2(Dialogo.Fecha2)~"  AND O.Fecha1 >= "~Idxdate2(Dialogo.Fecha2)~" ")
      SQL.ADD(" AND     M.FechaMov < "~IdxDate2(Dialogo.Fecha2)~"  AND O.Fecha1 >= "~Idxdate2(Dialogo.Fecha2)~" ")
    Else
*      SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
      SQL.ADD(" AND     M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
    Endif
    If NoVacio(Dialogo.Lista3)
      SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
    Endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
    If NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    Endif
    If NoVacio(Dialogo.Lista4)
      SQL.ADD(" AND   M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
    Endif
  Endif
  If VAl(xx:1)=1 y [Dialogo.Radio2=1 o Dialogo.Radio2=2]
    SQL.ADD(" UNION ALL ")
  Endif 
  If Dialogo.Radio2=1 o Dialogo.Radio2=2
    ACN(xx:1,1)
    SQL.ADD(" SELECT M.Especie, M.Cantidad, O.TipoTr2 TipoOp, C.Comitente, E.Nombre, ")
    SQL.ADD(" CL.RazonSocial, M.Cuenta, M.FechaMov, M.NrOperacion, M.EnteCustodia, C.Numero, O.Proveedor Cliente1, M.Leyenda, O.ConceptoPago ")
    SQL.ADD(" FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 O, "~DBO~".CUENTAS C, "~DBO~".ESPECIES E, "~DBO~".CLIENTES CL ")
    SQL.ADD(" WHERE  M.NrOperacion = O.NrTrans ")
    SQL.ADD(" AND    M.Cuenta      = C.Codigo ")
    SQL.ADD(" AND    M.Especie     = E.Codigo ")
    SQL.ADD(" AND    C.Comitente   = CL.Codigo ")
    SQL.ADD(" AND    M.NrSaldo     = 1 ")
    SQL.ADD(" AND    E.Tipo        = 'MON' ")
    If Dialogo.Radio1=0
      SQL.ADD(" AND    O.TipoTr2 IN ('CRVM') ")
    Endif
    If Dialogo.Radio1=1
      SQL.ADD(" AND    O.TipoTr2 IN ('DEVM') ")
    Endif
    If Dialogo.Radio1=2
      SQL.ADD(" AND    O.TipoTr2 IN ('TRANSF') ")
    Endif
    If Dialogo.Radio1=4
      SQL.ADD(" AND    O.TipoTr2 IN ('TRANSF','DEVM','CRVM','TRANSF') ")
    Endif
    If Dialogo.Check1=1
      SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov < "~IdxDate2(Dialogo.Fecha2)~"  AND O.Fecha1 >= "~Idxdate2(Dialogo.Fecha2)~" ")
    Else
      SQL.ADD(" AND    M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" AND M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~"  ")
    Endif
    If NoVacio(Dialogo.Lista3)
      SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
    Endif
    If NoVacio(Dialogo.Lista2)
      SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
    Endif
    If NoVacio(Dialogo.Lista1)
      SQL.ADD(" AND   M.EnteCustodia IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    Endif
    If NoVacio(Dialogo.Lista4)
      SQL.ADD(" AND   M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
    Endif
  Endif
Endif
SQL.ADD(" ORDER BY 1, 4, 3 ")

Recorrer SQL
 If Not Eqstr(fbn('Especie'), Val(ea:1))
    message('Moneda: '~fbn('Nombre'))
    If Not Eqstr(Val(ea:1),'')
      ACN(g:fac, SUM(g:Val(fi:1)..g:fac) )
      SetFont(g:fac,5) 
      FormatoCeldas(g:fac,EXE('F2')) 
      ifa
      SaltarHoja
    Endif

    ifa
    ACT(a:fac, 'Moneda: '~fbn('Nombre'))
    SetFont(a:fac,5)
    ifa
    ACT(a:fac,   'Banco')
    ACT(b:fac,   'Cuenta')
    ACT(c:fac,   'Vehiculo')
    ACT(d:fac,   'Fecha del')
    ACT(d:fac+1, 'Movimiento')
    ACT(e:fac,   'Numero de ')
    ACT(e:fac+1, 'Operacion')
    ACT(f:fac,   'Contraparte  //')
    ACT(f:fac+1, 'Proveedor')
    ACT(g:fac,   'Importe')
    ACT(h:fac,   'Concepto')
    ACT(i:fac,   'Observaciones')

    AlinearCeldas(b:fac..z:fac+1, 'C')
    SetFont(a:fac..z:fac+1,2)
    AgregarMarco(a:fac..i:fac+1,0,0,EXE('COLOR6'))
    ifa
    ifa
    ACN(fi:1, fac)
 Endif

 If Not Eqstr(fbn('Comitente'), Val(ba:1))
    ACT(a:fac, fbn('RazonSocial'))
    SetFont(a:fac,5)
    ACT(ca:1, '')
 Endif

 If Not Eqstr(fbn('Cuenta'), Val(ca:1))
    ACT(b:fac, fbn('Cuenta')~' - '~fbn('Numero'))
    SetFont(a:fac,5)
 Endif

 ACT(c:fac, fbn('EnteCustodia'))
 ACT(d:fac, fbn('FechaMov'))
 ACT(e:fac, fbn('NrOperacion'))
 If Dialogo.radio1=3
   ACLO(e:fac, fbn('NrOperacion'))
 Else
   ACLT(e:fac, fbn('NrOperacion'))
 Endif
 ACT(f:fac, fbn('Cliente1'))
 ACN(g:fac, fbn('Cantidad'))
 ACT(h:fac, fbn('ConceptoPago'))
 ACT(i:fac, fbn('Leyenda'))

 SetFont(b:fac..z:fac,1) 
 FormatoCeldas(g:fac,EXE('F2')) 

 ACT(ea:1, fbn('Especie'))
 ACT(ba:1, fbn('Comitente'))
 ACT(ca:1, fbn('Cuenta'))

Proximo

ifa

ACN(g:fac, SUM(g:Val(fi:1)..g:fac) )
SetFont(b:fac..g:fac,5) 
FormatoCeldas(g:fac,EXE('F2')) 

ifa
ifa
ifa

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac,2)

ACO(1,20)
ACO(2,18)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,12)
ACO(8, 8)
ACO(9,18)


Impresion(1,2)
Impresion(4,1)
LimitesVision(j:fac+2)
SetPrintFit(3,85)
SetMargins(0,0,0,2)
