ACT(VH:1, SQLSet(" Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

(.'DNLISTA'.)
ACT(ll:1, Val(l:1))
ACT(l:1, '')
* esto es para vaciar l que se usa en la funcion proque se ve en el informe

MostrarCuadroDeMensajes
CrearDialogo
 Fecha1 : 'D.FechaBajada' ;1;1;;;;;;;FSYS
 Fecha2 : 'H.FechaBajada' ;2;1;;;;;;;fsys

 Check1 : 'Incluye INI'   ;1;2;;;;;;;0

 Fecha3 : 'D.FechaValor'  ;3;1;;;;;;;habiles(fsys,-7,'ARG')
 Fecha4 : 'H.FechaValor'  ;4;1;;;;;;;fsys

 Fecha5 : 'D.FechaProceso' ;3;2;;;;;;;habiles(fsys,-7,'ARG')
 Fecha6 : 'H.FechaProceso' ;4;2;;;;;;;fsys

 Radio1 : 'Estado|Pendientes|OK|Ingr.Pen|Ingr.Ejec|Todos' ;5;1;;;;;;;4
 Radio3 : 'Estado Aprobacion|Pendientes|OK|Todos'         ;6;1;;;;;;;2
 Radio2 : 'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;7;1;;;;;;;4
 Check2:  'Incluye Pagadoras';8;1;;;;;;;1
* Lista1 : 'Archivo'  ; 9;1;;;;;;;;;'DNCTAS|DNAHMS|DNCCDO|DNCADO|DNCOBR|DNOTRO'
 Lista1 : 'Archivo'  ; 9;1;;;;;;;;;Val(ll:1)
 Lista2 : 'Vehiculos'; 3;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
 Lista3:  'Bancos'   ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
 Lista4:  'Cuentas'  ;-2;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista3)~") "~IIF(NOVACIO(Dialogo.Lista2)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista2)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial, 8,")
CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial, 8,BI")

ACT(a:1, 'Estado de Conciliaciones')
ACT(a:3, 'Desde Fecha Bajada: '~Dialogo.Fecha1~' Hasta Fecha Bajada: '~Dialogo.Fecha2)
ACT(a:4, 'Desde Fecha Valor: '~Dialogo.Fecha3~' Hasta Fecha Valor: '~Dialogo.Fecha4)
ACT(a:5, 'Desde Fecha Proceso: '~Dialogo.Fecha5~' Hasta Fecha Proceso: '~Dialogo.Fecha6)
ACT(a:6, 'Estado de Movimientos: '~iif(Dialogo.Radio1=0,'Pendientes',IIf(Dialogo.Radio1=1,'Matcheados',iif(Dialogo.Radio1=2,'No Matcheados-Ingresaron Pendientes',iif(Dialogo.Radio1=3,'No Matcheados-Ingresaron Ejecutados','Todos')))))
ACT(a:7, 'Tipo de Cuenta: '~iif(Dialogo.Radio2=0,'Cuenta Corriente',IIf(Dialogo.Radio2=1,'Intermedia',iif(Dialogo.Radio2=2,'Recaudadora',iif(Dialogo.Radio2=3,'Caja de Ahorro','Todas')))))
If Dialogo.Check2=0
   ACT(a:7, Val(a:7)~' - No incluye Cuentas Pagadoras.')
Else
   ACT(a:7, Val(a:7)~' - Incluye Cuentas Pagadoras.')
Endif
ACT(a:8, 'Archivos: '~iif(vacio(Dialogo.Lista1),'Todos',Pipe2Comillas(Dialogo.Lista1)))
ACT(a:9, 'Vehiculos: '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:10, 'Bancos: '~iif(vacio(Dialogo.Lista3),'Todos',Pipe2Comillas(Dialogo.Lista3)))
ACT(a:11, 'Cuentas: '~iif(vacio(Dialogo.Lista4),'Todas',Pipe2Comillas(Dialogo.Lista4)))
IF Dialogo.Check1 = 0
   ACT(A:12, '(NO Incluye Movimientos de la Bajada Inicial)')
ELSE
   ACT(A:12, '(Incluye Movimientos de la Bajada Inicial)')
ENDIF
SetFont(a:1,3)
SetFont(a:3..a:12,2)

SetFilaActual(13)

ACT(a:fac,   'Banco')
ACT(b:fac,   'Cuenta')
ACT(c:fac,   'Moneda')
ACT(d:fac,   'Importe')
ACT(e:fac,   'Codigo de')
ACT(e:fac+1, 'Operacion')
ACT(f:fac,   'Tipo de')
ACT(f:fac+1, 'Operacion')
ACT(g:fac,   'Fecha')
ACT(g:fac+1, 'Ingreso')
ACT(h:fac,   'Fecha')
ACT(h:fac+1, 'Valor')
ACT(i:fac,   'Comprobante')
ACT(j:fac,   'Estado')
ACT(k:fac,   'Transaccion')
ACT(l:fac,   'Fecha')
ACT(l:fac+1, 'Conciliacion')
ACT(m:fac,   'Banco')
ACT(m:fac+1,   'FPA')
ACT(n:fac,   'Cuenta')
ACT(n:fac+1,   'FPA')
ACT(o:fac,   'Importe')
ACT(o:fac+1,   'FPA')
SetFont(a:fac..z:fac+1,2)
AlinearCeldas(a:fac..z:fac+1,'C')
AgregarMarco(a:fac..o:fac+1,0,0,RGB(162,222,251))

SQL.ADD(" SELECT M.*, D.Archivo, D.Estado, V.Codigo CodigoV, C.NrOperacion NrOperacionC, ")
SQL.ADD(" C.NrMovimiento NrMovC, C.Fecha FechaC, ME.Cuenta CuentaM, CU.Comitente, CU.Numero, ")
SQL.ADD(" ME.Cantidad, CD.Descripcion DescripcionCodigo, TCD.Codigo Tipo, ")
SQL.ADD(" TCD.Descripcion DescripcionTCD, D.EstadoAprobacion, D.FechaBajada ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M, "~DBO~".DATANET D, "~DBO~".VEHICULOS V, ")
SQL.ADD(" "~DBO~".CONCILIACIONES C, "~DBO~".MOVEJECUTADOS ME, "~DBO~".CUENTAS CU, ")
SQL.ADD(" "~DBO~".CLIENTES B, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TCD ")
SQL.ADD(" WHERE M.NrDatanet    = D.NrDatanet ")
SQL.ADD(" AND   M.Vehiculo     = V.Codigo    ")
SQL.ADD(" AND   M.NrDatanet    = C.NrDataNet    ")
SQL.ADD(" AND   M.NrMovDatanet = C.NrMovDataNet  ")
SQL.ADD(" AND   C.NrOperacion  = ME.NrOperacion  ")
SQL.ADD(" AND   C.NrMovimiento = ME.NrMov   ")
SQL.ADD(" AND   M.Cuenta       = CU.Numero  ")
SQL.ADD(" AND   M.TipoMov      = CD.Codigo   ")
SQL.ADD(" AND   CD.Tipo        = TCD.Codigo  ")
SQL.ADD(" AND   CU.Comitente   = B.Codigo   ")
SQL.ADD(" AND   D.FechaBajada  >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   D.FechaBajada  <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND   M.FechaAcreditacion  >= "~IdxDate2(Dialogo.Fecha3)~" ")
SQL.ADD(" AND   M.FechaAcreditacion  <= "~IdxDate2(Dialogo.Fecha4)~" ")
SQL.ADD(" AND   M.FechaIngreso  >= "~IdxDate2(Dialogo.Fecha5)~" ")
SQL.ADD(" AND   M.FechaIngreso  <= "~IdxDate2(Dialogo.Fecha6)~" ")
If Dialogo.Radio3=0
   SQL.ADD(" AND  (D.EstadoAprobacion = 'P' OR D.EstadoAprobacion IS NULL)")
Endif
If Dialogo.Radio3=1
   SQL.ADD(" AND  D.EstadoAprobacion = 'OK' ")
Endif
If Dialogo.Radio2=0
   SQL.ADD(" AND CU.TipoCuenta IN ('CC','CCE','CCD')")
Endif
If Dialogo.Radio2=1
   SQL.ADD(" AND CU.TipoCuenta IN ('INT')")
Endif
If Dialogo.Radio2=2
   SQL.ADD(" AND CU.TipoCuenta IN ('REC')")
Endif
If Dialogo.Radio2=3
   SQL.ADD(" AND CU.TipoCuenta IN ('CA')")
Endif
If Dialogo.Check2=0
   SQL.ADD(" AND (CU.Pagadora <>'SI' OR CU.Pagadora IS NULL) ")
Endif
If Dialogo.Radio1=0
   SQL.ADD(" AND  M.EstadoConciliacion = 'P' ")
Endif
If Dialogo.Radio1=1
   SQL.ADD(" AND  M.EstadoConciliacion = 'OK' ")
Endif
If Dialogo.Radio1=2
   SQL.ADD(" AND  M.EstadoConciliacion = 'IP' ")
Endif
If Dialogo.Radio1=3
   SQL.ADD(" AND  M.EstadoConciliacion = 'IE' ")
Endif
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND V.Codigo IN ("~Pipe2Comillas(Val(VH:1))~") ")
   Endif
Endif
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" AND  D.Archivo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" AND  B.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista4)
   SQL.ADD(" AND  CU.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
IF Dialogo.Check1 = 0
   SQL.ADD(" AND M.TipoMov <> 'INI' ")
ENDIF
SQL.ADD(" ORDER BY M.Vehiculo, D.Archivo, M.NrDatanet, M.Banco, M.Cuenta, M.Moneda ")

ACT(va:1, '')
ACT(aa:1, '')

Recorrer SQL
 If Not Eqstr(fbn('CodigoV'), Val(va:1))
   Message('Vehiculo: '~fbn('CodigoV'))
   ifa
   ifa
   ACT(a:fac, fbn('CodigoV'))
   ACT(aa:1, '')
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..o:fac,0,0,EXE('COLOR8'))
   ifa
 Endif

 If Not Eqstr(fbn('Archivo'), Val(aa:1)) o Not Eqstr(fbn('NrDatanet'), Val(na:1))
   Message('NrDatanet: '~fbn('NrDatanet')~'  Archivo: '~fbn('Archivo')~' - Estado: '~IIF(Eqstr(fbn('Estado'),'A'),'Abierto','Cerrado') )
   ifa
   ACT(a:fac, 'NrDatanet: '~fbn('NrDatanet')~'  Archivo: '~fbn('Archivo')~' FechaBajada: '~fbn('FechaBajada')~' - Estado: '~IIF(Eqstr(fbn('Estado'),'A'),'Abierto','Cerrado') )
   ACT(a:fac, Val(a:fac)~' - '~iif(eqstr(fbn('EstadoAprobacion'),'OK'),'Aprobado por Supervisor.','Aprobacion de Supervisor Pendiente.') )
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..o:fac,0,0,0)
   ACT(aa:1, '')
   ifa
 Endif
 ACT(a:fac, fbn('Banco'))
 ACT(b:fac, fbn('Cuenta'))
 ACT(c:fac, fbn('Moneda'))
 ACN(d:fac, fbn('Importe')*IIF(Eqstr(fbn('DC'),'C'),1,-1))
 ACT(e:fac, fbn('TipoMov')~' - '~fbn('DescripcionCodigo'))
 ACT(f:fac, fbn('Tipo')~' - '~fbn('DescripcionTCD'))
 ACD(g:fac, fbn('FechaIngreso'))
 ACD(h:fac, fbn('FechaAcreditacion'))
 ACT(i:fac, fbn('Comprobante'))
 ACT(j:fac, fbn('EstadoConciliacion'))
 If Eqstr(Val(j:fac), 'OK')
   ColorCeldas(j:fac,clGREEN)
 Endif
 If Eqstr(Val(j:fac), 'P')
   ColorCeldas(j:fac,clRED)
 Endif
 If Incluido(Val(j:fac), 'IE|IP')
   ColorCeldas(j:fac,clBLUE)
 Endif

 ACT(k:fac, fbn('NrOperacionC'))
 ACLT(k:fac, fbn('NrOperacionC'))
 ACD(l:fac, fbn('FechaC'))
 ACT(m:fac, fbn('Comitente'))
 ACT(n:fac, fbn('CuentaM')~'-'~fbn('Numero'))
 ACN(o:fac, fbn('Cantidad'))

 SetFont(a:fac..z:fac,1)
 FormatoCeldas(d:fac,EXE('F2'))
 FormatoCeldas(f:fac,EXE('F2'))
 
 ACT(va:1, fbn('CodigoV'))
 ACT(aa:1, fbn('Archivo'))
 ACT(na:1, fbn('NrDatanet'))
