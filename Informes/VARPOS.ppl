CrearDialogo
  Fecha1   : 'Fecha'                         ;;;;;;;;;fsys
  Lista1    : 'Especies' ;;;;;;NoVacio(Dialogo.Lista1);;;;;SQLSet("Select Codigo  from "~DBO~".ESPECIES where Status = 'HAB' and (Fecha> '"~IdxDate(Dialogo.Fecha1)~"' or Fecha is null   ) and  "~DBO~".EsTerminalEspecie(Codigo)=1   ")
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')
CrearFont(5, 'Arial,12,B')

ACN(FA:1,SQL("Select Top 1 FactorK  from "~DBO~".METODOSVOLATILIDAD where Formula='STD' and  FechaVigencia>='"~IdxDate(Dialogo.Fecha1)~"' order by FechaVigencia "))
ACN(FA:2,SQL("Select Top 1 FactorRiesgo  from "~DBO~".METODOSVOLATILIDAD where Formula='STD' and  FechaVigencia>='"~IdxDate(Dialogo.Fecha1)~"' order by FechaVigencia "))



SetFilaActual(1)
ACT(D:fac, 'VAR Spot')
SetFont(D:fac, 5)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
SetFont(A:fac..A:fac, 2)

SetFilaActual(fac+2)
ACT(a:fac, 'Alias')
ACT(b:fac, 'Posic. Inicial')
ACT(c:fac, 'Pr. Inicial')
ACT(d:fac, 'Compras')
ACT(e:fac, 'PPP Compras')
ACT(f:fac, 'Ventas')
ACT(g:fac, 'PPP Ventas')
ACT(h:fac, 'Posic.Actual')
ACT(i:fac, 'Pr.May.Act.')
ACT(j:fac, 'Volat%')

ACT(k:fac, 'I')
ACT(l:fac, 'Factor')
ACT(m:fac, 'Mto.VaR $')
ACT(n:fac, 'Af.Utilidad Día')
ACT(o:fac, 'Posic. Act $.')
ACT(p:fac, 'Util.Acum.Mes')

AgregarMarco(a:fac..p:fac,0,0,EXE('COLOR6'))
SetFont(a:fac..p:fac+1, 2)
AlinearCeldas(a:fac..p:fac, 'C')

SQL.ADD(" SELECT DISTINCT P.Especie, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, ")
SQL.ADD(" P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, P.Precio2, P.Precio1, ")
SQL.ADD(" P.PrecioIni, E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion,")
SQL.ADD("  E.MonedaEmision, P.Book, P.PrecioFin, P.Fecha, P.TipoNegocio, VAR.Volatilidad ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V,"~DBO~".VOLATILIDADESPECIE VAR ")
SQL.ADD(" WHERE P.Especie = E.Codigo and VAR.Especie=P.Especie and VAR.Fecha="~idxdate2(Dialogo.Fecha1)~"  ")
SQL.ADD(" AND   P.Cliente = V.Codigo   ")
IF NoVacio(Dialogo.Lista1)
SQL.ADD("  and E.Codigo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
*SQL.ADD(" AND   (E.Jerarquia like ('"~Jerarquia('ESPECIES','TITULO')~"%') or P.Especie='USD' ) ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   P.CantidadFin <> 0 ")
SQL.ADD(" AND P.NrSaldo IN (121,31) ")  
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.TipoNegocio = P.TipoNegocio OR ((P1.TipoNegocio IS NULL OR P1.TipoNegocio  ='' OR P1.TipoNegocio  =' ') AND (P.TipoNegocio IS NULL OR P.TipoNegocio ='' OR P.TipoNegocio =' ' ))) ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo,P.Especie, P.Book, P.NrSaldo, E.Tipo ")
Watch(SQL.Batch())
Recorrer SQL
   If EqStr(FBN['Especie'], VAL(ES:1)) 
      DFA
      ACT(A:Fac,FBN['Especie'])
      SCN(B:Fac,FBN['CantidadIni'])
      SCN(CC:Fac,FBN['PrecioIni']* FBN['CantidadIni'])
      SCN(D:Fac,FBN['Cantidad1'])
      SCN(EE:Fac,FBN['Precio1']*FBN['Cantidad1'])
      SCN(F:Fac,FBN['Cantidad2'])
      SCN(GG:Fac,FBN['Precio2']*FBN['Cantidad2'])
      SCN(H:Fac,FBN['CantidadFin']) 
      SCN(II:Fac,FBN['PrecioFin']*FBN['CantidadFin'])
      ACN(j:fac,FBN['Volatilidad'])
      ACN(k:fac, Val(FA:1))
      ACN(l:fac, Val(FA:2))
   Else
      ACT(A:Fac,FBN['Especie'])
      ACN(B:Fac,FBN['CantidadIni'])
      SCN(CC:Fac,FBN['PrecioIni']* FBN['CantidadIni'])
      ACN(D:Fac,FBN['Cantidad1'])
      SCN(EE:Fac,FBN['Precio1']*FBN['Cantidad1'])
      ACN(F:Fac,FBN['Cantidad2'])
      SCN(GG:Fac,FBN['Precio2']*FBN['Cantidad2'])   
      ACN(H:Fac,FBN['CantidadFin'])
      SCN(II:Fac,FBN['PrecioFin']*FBN['CantidadFin'])
      ACN(j:fac,FBN['Volatilidad'])
      ACN(k:fac, Val(FA:1))
      ACN(l:fac, Val(FA:2))
      If Val(MM:1)=1
         ACN(C:Fac-1,Val(CC:Fac-1)/Val(B:Fac-1))
         ACN(E:Fac-1,Val(EE:Fac-1)/Val(D:Fac-1))
         ACN(G:Fac-1,Val(GG:Fac-1)/Val(F:Fac-1))
         ACN(I:Fac-1,Val(II:Fac-1)/Val(H:Fac-1))
         ACN(o:fac-1, Val(H:Fac-1)*Val(I:Fac-1))
         ACN(m:fac-1, Val(J:Fac-1)*Val(K:Fac-1)*Val(K:Fac-1)*Val(L:Fac-1)*Val(O:Fac-1)/100)
  
       EndIf
   EndIf
 
   SQL.ADD(" SELECT SUM(Day) as Diario, SUM(MTD) as Mensual FROM "~DBO~".RESULTADOS R  ")
   SQL.ADD(" WHERE Especie   = '"~Fbn['Especie']~"'     ")
   SQL.ADD(" AND   NrSaldo   = 171 AND   Estrategia not in ("~Pipe2Comillas(VAR('CTAGARANT'))~")  ")
   SQL.ADD(" AND   Fecha   = '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" AND   TipoResultado IN ('TRADE','REALIZ','REVAL') ")
   SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS R1 ")
   SQL.ADD("                 WHERE R.Especie  = R1.Especie  ")
   SQL.ADD("                 AND   R.NrSaldo  = R1.NrSaldo  ")
   SQL.ADD("                 AND   R.Vehiculo = R1.Vehiculo ")
   SQL.ADD("                 AND   R.Estrategia = R1.Estrategia ")
   SQL.ADD("                 AND   R1.Estrategia not in ("~Pipe2Comillas(VAR('CTAGARANT'))~") ")
   SQL.ADD("                 AND   R.Book     = R1.Book     ")
   SQL.ADD("                 AND   R.TipoResultado  = R1.TipoResultado    ")
   SQL.ADD("                 AND   (R.Sector   = R1.Sector   OR (R.Sector   IS NULL AND R1.Sector   IS NULL) ) ")
   SQL.ADD("                 AND   (R.CallPut  = R1.CallPut  OR (R.CallPut  IS NULL AND R1.CallPut  IS NULL) ) ")
   SQL.ADD("                 AND   (R.Cupon    = R1.Cupon    OR (R.Cupon    IS NULL AND R1.Cupon    IS NULL) ) ")
   SQL.ADD("                 AND   (R.FechaEj  = R1.FechaEj  OR (R.FechaEj  IS NULL AND R1.FechaEj  IS NULL) ) ")
   SQL.ADD("                 AND   (R.PrecioEj = R1.PrecioEj OR (R.PrecioEj IS NULL AND R1.PrecioEj IS NULL) ) ")
   SQL.ADD("                 AND   R1.Fecha  < = '"~IdxDate(Dialogo.Fecha1)~"' ) ")
   Watch(SQL.Batch())
   Recorrer SQL
      dfa
      ACN(n:Fac,Fbn['Diario']) 
      ACN(p:Fac,Fbn['Mensual'])  
   Proximo
   
   ACT(ES:1,FBN['Especie'])
   ACN(MM:1,1)
Proximo

ACN(C:Fac,Val(CC:Fac)/Val(B:Fac))
ACN(E:Fac,Val(EE:Fac)/Val(D:Fac))
ACN(G:Fac,Val(GG:Fac)/Val(F:Fac))
ACN(I:Fac,Val(II:Fac)/Val(H:Fac))
ACN(O:fac, Val(H:Fac)*Val(I:Fac))
ACN(m:fac, Val(J:Fac)*Val(K:Fac)*Val(K:Fac)*Val(L:Fac)*Val(O:Fac)/100)

