CrearFont(4,"Arial,8,")
AgregarBMP(a1,Exe('LOGO'),VAR('ESCALOGO'))

ACT(a:3,'Chequeo de Transacciones')
SetFont(d:fac..d:fac,2)
SetFilaActual(5)
ACT(a:fac,'Operacion')
ACT(b:fac,'Instancia')
ACT(c:fac,'Valor')
ACT(d:fac,'Nombre')
SetFont(a:fac..d:fac,3)
AgregarMarco(a:fac..d:fac,2,0,EXE('COLOR6'))
act(w:1,fac+1)
SQL.ADD("Select B.NrOperacion, B.NrBit, B.Valor, I.Nombre ")
SQL.ADD("  from "~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I ")   
SQL.ADD(" WHERE B.NrBit=I.NrInstancia ")
SQL.ADD("   AND NrOperacion='"~Dialogo.NrTrans1~"' ")
SQL.ADD("   and tabla='TRANSACCIONES2'")
SQL.ADD("   AND Valor='1' ")
Recorrer SQL

   ACT(a:fac, fbn['NrOperacion'])
   ACT(b:fac, fbn['NrBit'])
   ACT(c:fac, fbn['Valor'])
   ACT(d:fac, fbn['Nombre'])

Proximo
*SetFont(a:val(w:1)..d:fac,4)

SetFilaActual(fac+2)
ACT(a:fac,'Operacion')
ACT(b:fac,'Instancia')
ACT(c:fac,'Valor')
ACT(d:fac,'Nombre')

SQL.ADD("SELECT Transaccion,B.NrBit, T.Fecha1, T.NrTrans  ")
SQL.ADD("  from "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("  where M.NrTrans2 = T.NrTrans      ")                  
SQL.ADD("  and   T.NrTrans  = B.NrOperacion  ")
*SQL.ADD("  and   B.NrBit In (1,11,3,6,70,8)  ")                 
SQL.ADD("  and   B.Valor = '1'               ")               
SQL.ADD("  and   M.NrSaldo = 1               ")              
SQL.ADD("  and   M.Especie='"~Dialogo.Especie1~"'              ")              
*SQL.ADD("  and   T.Fecha1 = '2019-04-12'     ") 
SQL.ADD(" and   T.Cliente1 = 'MAECLEAR'      ") 
SQL.ADD("  and T.Cliente1 Not In (SELECT C.Codigo FROM  dbo.AGENTES Ag, dbo.CLIENTES C WHERE Ag.Codigo = C.NrAgenteBolsa)  ")
SQL.ADD("  and   T.Cliente1='MAECLEAR'       ")
SQL.ADD("  and   T.NrTrans='"~Dialogo.NrTrans1~"'  ")
*SQL.ADD("  and (M.Transaccion is Null or M.Transaccion = ' ')  ")
Recorrer SQL

   ACT(a:fac, fbn['Transaccion'])
   ACT(b:fac, fbn['NrBit'])
   ACT(c:fac, fbn['Fecha1'])
   ACT(d:fac, fbn['NrTrans'])

Proximo
