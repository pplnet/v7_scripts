*- Tomo de Cotizaciones desde el archivo BLOOMBERGS.XLS
*- Bid es compra, Ask es venta, Last el de ayer y close es el ultimo
ACT(a1, 'Cotizaciones desde Bloombergs')
ACT(a3, 'Especie')
ACT(b3, 'Cotizacion')
ACT(c3, 'Moneda')
ACT(d3, 'Fecha')
ACT(e3, 'Valuacion')

AlinearCeldas(a3..i3, 'D')

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

AgregarMarco(a3..e3,2,0,Exe('COLOR'))

ACT(yy:2, HORA(AHORA))
ACT(zz:2, Copy(Val(yy:2),1,2)~Copy(Val(yy:2),4,2)~Copy(Val(yy:2),7,2))
ACD(yy:3, Fsys)
ACT(zz:3, Copy(Val(yy:3),1,2)~Copy(Val(yy:3),4,2)~Copy(Val(yy:3),9,2))

*Limite de precios tomados
ACN(x1, VAR('ACTCONFILA')+1)


**Valida si existe el directorio para crear el txt
If ExisteDirectorio(VAR('PATLGESP'))
   **Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATLGESP'),Longitud(VAR('PATLGESP')),1),'\')
      ACT(pl:1, VAR('PATLGESP')~'PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   Else
      ACT(pl:1, VAR('PATLGESP')~'\PREBLOO'~Val(zz:3)~Val(zz:2)~'.txt')
   EndIf
   **
Else
    Message('El directorio '~VAR('PATLGESP')~' no existe')
EndIf

**Valida si existe el directorio y el archivo xls para importarlo
If ExisteDirectorio(VAR('PATLOESP'))
   **Valida si el directorio cuenta con '\'
   If EqStr(Copy(VAR('PATLOESP'),Longitud(VAR('PATLOESP')),1),'\')
   ACT(vb:1, VAR('PATLOESP'))
   Else
   ACT(vb:1, VAR('PATLOESP')~'\')
   EndIf
   **
   If Not ExisteArchivo(Val(vb:1)~VAR('ARCCOTESP'))
        act(er2,'El Archivo '~VAR('ARCCOTESP')~' no existe en el directorio: '~Val(vb:1))
        Cancelar('El Archivo '~VAR('ARCCOTESP')~' no existe en el directorio: '~Val(vb:1))
   Else
        ImportarXLS(a:1..J:Val(x1),aa:1..ae:Val(x1),Val(vb:1)~VAR('ARCCOTESP'))
        If Not Ok 
            AbrirAscii(Val(pl:1),0)
            EscribirASCII(FECHA(HOY)~' '~HORA(AHORA)~' ACTCON')
            EscribirASCII('No se pudo abrir la planilla '~Val(vb:1)~VAR('ARCCOTESP')~' o se ha importado con errores')
            act(er2,'No se pudo abrir la planilla '~Val(vb:1)~VAR('ARCCOTESP')~' o se ha importado con errores')
            CerrarASCII
            MessageBox('No se pudo abrir el archivo '~Val(vb:1)~VAR('ARCCOTESP')~' Err:' ~ Reemplazar(GetError(),"'"," "))
       EndIf
   EndIf
Else
    act(er2,'El directorio '~Val(vb:1)~' no existe')
    Cancelar('El directorio '~Val(vb:1)~' no existe')
EndIf

*- Variables
* z2 : Primera fila con contenido
* z3 : Ultima fila con contenido
* z4 : Primera Celda asignada
* z5 : Ultima Celda asignada
* z6 : Celda corriente

ACN(z2,2)
ACN(z3,Val(x1))

SetFilaActual(4)
ACN(z4,fac)
ACN(z5,fac)

*- Recorrer valores
Recorrer&i Val(z2),Val(z3)
   If Vacio(VAL(aa:&i))
      Break
   EndIf

   Message('Especie '~VAL(aa:&i))
   *****Especie
   If (QUERY("select count (*) from "~DBO~".especies where Codigo =upper('"~Val(aa:&i)~"')")) > 0
       ACT(a:Val(z5), Mayusculas2(Val(aa:&i)))
   EndIf
   
   ACN(de1, 1)
   ACN(h:Val(z5), 1)
   
   ******Cotizacion
   if Val(ab:&i) >=0 
       ACN(b:Val(z5), Val(ab:&i)*val(de1))
   endif
   
   ******Moneda
   If (QUERY("select count (*) from "~DBO~".especies where Codigo =upper('"~Val(ac:&i)~"')")) > 0
      ACT(c:Val(z5), Mayusculas2(Val(ac:&i)))
   EndIf
   ******Fecha
   ACD(d:Val(z5), Val(ad:&i))
   ******Valuacion
   ACT(e:Val(z5), Val(ae:&i))
   
   Message('Cotizacion Cotizacion '~Val(b:Val(z5)) )

   SCN(z5,1)
Proximo

CerrarASCII

SetFont(a1..z3, 1)
SetFont(a4..z:Val(z5), 2)
*LimitesVision(i:Val(z5)+2)

FormatoCeldas(b1..F:Val(z5)+2,Exe('F7'))
