**--Recorro los meses, el primer mes es fijo
ACT(A:fac, Meses(Mes(Dialogo.Fecha1))~'-'~Fstr(Anio(Dialogo.Fecha1)))
ACN(B:fac, CotizacionBNA(&monedaExtr,FinDeMes(Dialogo.Fecha1),1,NO,NO))
ACN(C:fac, CotizacionBNA(&dolBillete,FinDeMes(Dialogo.Fecha1),1,NO,NO))
ifa
let &SigMes Habiles(FinDeMes(Dialogo.Fecha1),+1)
Recorrer&i 1, &CantMes
        
    ACT(a:fac, Meses(Mes(&SigMes))~'-'~Fstr(Anio(&SigMes)))        
    ACN(B:fac, CotizacionBNA(&monedaExtr,FinDeMes(&SigMes),1,NO,NO))
    ACN(C:fac, CotizacionBNA(&dolBillete,FinDeMes(&SigMes),1,NO,NO))
    **Utilizo la misma variable para ir recorriendo los meses
   let &SigMes Habiles(FinDeMes(&SigMes),+1)
   ifa
   
Proximo
