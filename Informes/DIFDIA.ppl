CrearDialogo
   Especie1   :'Especie'      ;1;1;;;;NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y Not DesciendeDeEspecie(Dialogo.Especie1,'CUPON');'Especie Invalida';NO;'BXGL27';;;;;"Status = 'HAB' "
   Fecha1     :'F.Corte'      ;2;1;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1 >= Fsys;'Fecha de Corte Invalida';NO;IIF(Dialogo.Check1=1,FechaMaduracion(Dialogo.Especie1),ProxCupon2(Dialogo.Especie1, Fsys));IIF(Dialogo.Check1=1,FechaMaduracion(Dialogo.Especie1),ProxCupon2(Dialogo.Especie1, Fsys))
   Precio10   :'DiasMes'      ;3;1;;NO;;;;;;IIF(EspecieDiasAnio(Dialogo.Especie1)=0 y EspecieDiasMes(Dialogo.Especie1)=0,30*DifMes(Dialogo.Fecha6,Dialogo.Fecha5),DifDias(Dialogo.Fecha6,Dialogo.Fecha5,'USA',NO))
   Fecha5     :'FechaAnt'     ;4;1;;NO;Dialogo.Check1=0;;;;;UltCupon2(Dialogo.Especie1,Dialogo.Fecha1-1)
   Fecha6     :'FechaProx'    ;5;2;;NO;Dialogo.Check1=0;;;;;ProxCupon2(Dialogo.Especie1,Dialogo.Fecha1)
   Check1     :'ZeroCoupon'   ;1;1;;NO;NO;;;;;IIF(EqStr('SI',BuscarCampo('ESPECIES','ZeroCoupon','Codigo',Dialogo.Especie1)),1,0)
FinDialogo

If Not Ok
   Cancelar
Endif

