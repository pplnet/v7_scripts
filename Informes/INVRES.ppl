ACO(1,14)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,6)
ACO(6,9)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,8)
ACO(11,8)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,10)
ACO(17,10)
ACO(18,10)

FormatoCeldas(k:Val(FA1)..k:fac,Exe('F7'))
Impresion(1,2)
SetFilaACTual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC..a:FAC,2)
LimitesVision(S:fac)

SetPrintFit(3,73)

CrearFont(6,"Arial,6,B")
RangoTitulo(a:10..l:FAC, 1)
Impresion(2, 1) 
Impresion(3, 1) 
Impresion(4, 1) 

If val(ch1)=1
   GrabarGrilla('INVRES',val(fe1))
EndIf
