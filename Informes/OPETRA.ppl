*Operaciones con Detalle de Trans.- BKB
*OPETRA

ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1      :'Fecha Desde'       ;2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar Fecha Desde';NO;FSys
  Fecha2      :'Fecha Hasta'       ;3;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar Fecha Hasta';NO;FSys
  Fecha3      :"F.Vto.Desde" ;4;1;;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4      :"F.Vto.Hasta" ;5;1;;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+30;
  Especie1    :'Especie'     ;6;1;
  Cliente1    :'Cliente'     ;7;1;
  NrOperacion1:'Nro. Op.'    ;8;1;
  Book1      : "Book"        ;9;1;
  Vehiculo1   : "Vehiculo"   ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Lista1     : "Tipos Op."  ;10;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION ")  
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(a:2, 'OPETRA')
SetFont(a:2..a:2,1)
ACT(q:2,'Fecha y Hora : '~Var('FECHASYS')~' '~HORA(AHORA))
SetFont(q:2..q:2,1)
AlinearCeldas(q2..q2,'D')

ACT(a:3, 'Operaciones con Detalle de Transacciones')
SetFont(a:3,3)
ACT(a:4, 'Ordenado por Tipo de Operacion, Especie, Nro. de Operacion, Tipo y Nro. de Transaccion.')
SetFont(a:4,2)

SetFilaActual(5)
ACN(w1,FAC)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
*  else
*   ACT(a:FAC+1, 'Vehiculo :  Todos')
endif
ACT(a:FAC+2, 'Fecha Desde:  '~Dialogo.Fecha1)
ACT(d:FAC+2, 'Fecha Hasta:  '~Dialogo.Fecha2)
ACT(a:FAC+3, 'Fecha Vto. Desde:  '~Dialogo.Fecha3)
ACT(d:FAC+3, 'Fecha Vto. Hasta:  '~Dialogo.Fecha4)

if NoVacio(Dialogo.Especie1)
   ACT(a:FAC+4, 'Especie :  '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
  else
   ACT(a:FAC+4, 'Especie :  Todas')
endif

if NoVacio(Dialogo.Cliente1)
   ACT(d:FAC+4, 'Cliente :  '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
  else
   ACT(d:FAC+4, 'Cliente :  Todos')
endif

if NoVacio(Dialogo.NrOperacion1)
   ACT(a:FAC+5, 'Nr.Operacion :  '~Dialogo.NrOperacion1)
  else
   ACT(a:FAC+5, 'Nr.Operacion :  Todas')
endif

if NoVacio(Dialogo.Book1)
   ACT(d:FAC+5, 'Book : '~Dialogo.Book1~'  '~BuscarCampo('BOOKS','Descripcion','Codigo',Dialogo.Book1))
  else
   ACT(d:FAC+5, 'Book : Todos')
endif


if NoVacio(Dialogo.Lista1)
  ACT(a:FAC+6, 'Tipo de Operaciones : '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(a:FAC+6, 'Tipo de Operaciones : Todos')
endif


SetFilaActual(FAC+7)
ACT(a:FAC, 'Numero Op.')
ACT(b:FAC, 'Codigo')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Cantidad')
ACT(f:FAC, 'Ctra.Esp.')
ACT(g:FAC, 'Monto')
ACT(h:FAC, 'Fecha Mov.')
ACT(i:FAC, 'Tipo Tr.')
ACT(j:FAC, 'Numero')
ACT(k:FAC, 'Especie')
ACT(l:FAC, 'Importe Liq.')
ACT(m:FAC, 'Estado')
ACT(n:FAC, 'Fecha Voucher')
ACT(o:FAC, 'Cuenta')
ACT(p:FAC, 'Cta. Propia')
ACT(q:FAC, 'F.Carga')
ACT(r:FAC, 'Concepto')
ACT(s:FAC, 'Nr.Cta.Cli.')
ACT(t:FAC, 'SW Address')
ACT(u:FAC, 'Fecha Conf.')
*ACT(u:FAC, 'Nr.Cta.Propia')
acn(vx8,fac)

AlinearCeldas(a:FAC..d:FAC,'I')
AlinearCeldas(e:FAC..e:FAC,'D')
AlinearCeldas(s:FAC..s:FAC,'D')
AlinearCeldas(f:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
AlinearCeldas(i:FAC..k:FAC,'I')
AlinearCeldas(l:FAC..l:FAC,'D')
AlinearCeldas(m:FAC..q:FAC,'I')
SetFont(a:5..z:FAC,2)
AgregarMarco(a:FAC..u:FAC,2,0,Exe('COLOR'))
AlinearCeldas(a:FAC..u:FAC,'C')

SetFilaActual(FAC)
SQL.ADD("Select O.TipoOp, O.NrOperacion, O.Cliente1, O.FechaEj, O.PrecioEj, O.Cantidad, O.TotalNetoCli1, O.ContraEspecie, O.Especie, O.FechaVto, ")
SQL.ADD(" T.TipoTr2, T.NrTrans, T.Fecha1, M.Especie espe, T.Ley1, T.Cuenta1 Cta1, T.Cuenta2 Cta2, ")
SQL.ADD(" M.FechaMov, M.Cantidad cant, T.Fecha2, M.NrOperacion, M.Leyenda, T.Fecha5               ")
SQL.ADD("From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T          ")
SQL.ADD("where T.NrTrans = M.NrTrans2                                                           ") 
SQL.ADD("and   M.NrOperacion = O.NrOperacion                                                    ") 
SQL.ADD("and O.FechaOp  between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")

if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
endif

if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
   SQL.ADD("and O.Cliente1 = M.Cliente ")
endif

if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
endif

if NoVacio(Dialogo.Book1)
   SQL.ADD("and O.Book1 = '"~Dialogo.Book1~"' ")
endif

if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
endif

SQL.ADD("order by O.TipoOp, O.Especie, O.NrOperacion, T.TipoTr2, T.NrTrans ")

acn(z4,0)
recorrer SQL
  IF Not EqStr(FBN['TipoOp'], Val(Z2))
     ifa
     ACT(a:FAC,FBN['TipoOp'])
     SetFont(a:fac..a:FAC,2)
     ACT(Z2,FBN['TipoOp'])
     ifa
  endif
  acn(z4,1)

  IF Not EqStr(FBN['NrOperacion'], Val(Z11))
     ACT(Z11,FBN['NrOperacion'])
     ACT(a:FAC, FBN['NrOperacion'])
     ACLO(a:FAC, FBN['NrOperacion'])
     ACT(b:FAC, FBN['Cliente1'])
     ACT(c:FAC, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']),1,30))
     ACT(az1,Val(c:FAC))
     ACT(s:FAC, FBN['Cta1'])
if no
*-i
*     SQL.ADD("Select Numero, Corresponsal, Comitente  from "~DBO~".CUENTAS C, "~DBO~".CLIENTES L ")
*     SQL.ADD(" where C.Comitente *= L.Codigo ")
*     SQL.ADD("   and C.Codigo     = '"~fbn['Cta1']~"'  ")
     SQL.ADD("Select Numero, Corresponsal, Comitente  from "~DBO~".CUENTAS C LEFT OUTER JOIN "~DBO~".CLIENTES L  ON  C.Comitente = L.Codigo")
     SQL.ADD("   where C.Codigo     = '"~fbn['Cta1']~"'  ")
*-f
     Recorrer SQL
       dfa
*       if Not EqStr(fbn['Comitente'],Dialogo.Vehiculo1)
          ACT(t:FAC, BuscarCampo('CORRESPONSALES','SWIFTAddress','Codigo',fbn('Corresponsal')))
*       endif
     Proximo
endif
     if vacio(fbn['PrecioEj']) o fbn['PrecioEj'] = 0
        ACT(d:FAC,FBN['Especie'])
       else
        ACT(d:FAC,FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     endif
     ACN(e:FAC, FBN['Cantidad'])
     ACT(f:FAC, FBN['ContraEspecie'])
     ACN(g:FAC, FBN['Totalnetocli1'])
     ACD(h:FAC, FBN['FechaMov'])
  endif
  ACT(i:FAC, FBN['TipoTr2'])
  ACT(j:FAC, FBN['NrTrans'])
  ACLT(j:fac,FBN['NrTrans'])
  ACT(k:FAC, FBN['espe'])
  ACN(l:FAC, FBN['Cant']*(-1))
  ACT(m:FAC, FBN['Ley1'])
  ACD(n:FAC, FBN['Fecha1'])
  ACT(o:FAC, FBN['Cta1'])
  ACT(p:FAC, FBN['Cta2'])
  ACD(q:FAC, FBN['Fecha2'])
  ACT(r:FAC, FBN['Leyenda']~' '~Val(az1))
  ACD(u:FAC, FBN['Fecha5'])

  AlinearCeldas(h:FAC..h:FAC,'D')
  AlinearCeldas(s:FAC..s:FAC,'D')
  AlinearCeldas(n:FAC..n:FAC,'D')


  formatoCeldas(l:FAC..l:FAC,exe('F2'))
  formatoCeldas(e:FAC..e:FAC,exe('F5'))
  SetFont(a:fac..z:FAC,1)
proximo

ACO(1,6)
ACO(2,6)
ACO(3,18)
ACO(4,5)
ACO(5,8)
ACO(6,5)
ACO(7,9)
ACO(8,6)
ACO(9,5)
ACO(10,6)
ACO(11,5)
ACO(12,9)
ACO(13,5)
ACO(14,6)
ACO(15,7)
ACO(16,7)
ACO(17,6)
ACO(18,25)
ACO(19,7)
ACO(20,7)
ACO(21,7)

Impresion(1,2)
SetFilaActual(FAC+3)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC,2)
LimitesVision(u:FAC)
SetPrintFit(2)
RangoTitulo(a:1..t:fac+1, val(vx8))

