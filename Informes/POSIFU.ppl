ACT(b2, 'Total compras')
ACT(c2, 'PPP Compras')
ACT(d2, 'Total Ventas')
ACT(e2, 'PPP Ventas')
ACT(f2, 'Posicion')
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..f2, 1)
