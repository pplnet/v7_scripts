SetFilaActual(1)
SQL.ADD("SELECT TipoOp, Cantidad, Especie, Precio1, FechaVto, Vehiculo1 ")
SQL.ADD("FROM   "~DBO~".OPERACIONES ")
SQL.ADD("WHERE  TipoOp in ('TIFC','TIFV') and FechaVto >= '"~IdxDate(FSys)~"' ")
SQL.ADD("        and (PaseCB <> '1' or PaseCB is NULL)")
SQL.ADD("       and Vehiculo1 = '"~VAR('VEHICULODE')~"' ")
SQL.ADD("ORDER BY Especie, FechaVto, Cliente1")

