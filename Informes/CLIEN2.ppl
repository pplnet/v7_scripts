AgregarMarco(c:fac+2..n:fac+2,2,1,Exe('COLOR'))
ACN(z:1,fac+2)

SetFilaActual(fac+2)
SQL.ADD("Select * ")
SQL.ADD(" from "~DBO~".CLIENTES ")
SQL.ADD("where Codigo >= '"~Dialogo.Cliente1~"' ")
SQL.ADD("  and Codigo <= '"~Dialogo.Cliente2~"' ")
SQL.ADD("order by Codigo")

recorrer SQL
