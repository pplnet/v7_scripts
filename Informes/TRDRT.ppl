MostrarCuadroDeMensajes
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;1;;;;;;;;VAR('VEHICULODE')
  Especie1   : "Especie"    ;2;;;;;;;;
  Fecha1     : "D.Fecha"    ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar D.Fecha';NO;FSys-30;
  Fecha2     : "H.Fecha"    ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar H.Fecha';NO;FSys;
  Radio1     : 'Estado|Todas|Confirmadas|Pendientes';;;;;;;;;0
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Transferencias entre Cuentas de Titulos del Vehiculo")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Especie1)
   ACT(a:FAC+2, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
   ACT(a:FAC+2, 'Especies : Todas')
endif
ACT(a:FAC+3, 'Desde Fecha: '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Hasta Fecha: '~Dialogo.Fecha2)


SetFilaActual(FAC+6)

ACT(A:FAC-1, "Especie")
ACT(B:FAC-1, "Fecha Op.")
ACT(c:FAC-1," ------------- D E S T I N O ------------- ")
ACT(c:FAC, "Cliente")
ACT(d:FAC, "Mercado")
ACT(e:FAC, "Cuenta")
ACT(f:FAC-1," ---------- O R I G E N  ---------- ")
ACT(f:FAC, "Cliente")
ACT(g:FAC, "Mercado")
ACT(h:FAC, "Cuenta")
ACT(i:FAC-1, "Cantidad")
ACT(j:FAC-1, "Numero")
ACT(k:FAC-1, "Estado")
ACT(l:FAC-1, "FechaConf")
ACT(m:FAC-1, "Instancia")
ACT(n:FAC-1, "F.Carga")

AlinearCeldas(a:FAC..h:FAC,'I')
AlinearCeldas(i:FAC..i:FAC,'D')
AlinearCeldas(j:FAC..l:FAC,'I')
SetFont(a5..n:FAC,2)
AgregarMarco(a:FAC-1..n:FAC,2,0,Exe('COLOR'))

ACN(w1,FAC)
SetFilaActual(FAC)

SQL.ADD(" SELECT T.Vehiculo1, T.Fecha1, T.Cliente1, T.Cuenta1, T.Cuenta2, T.PrecioEj, T.RB2, T.Fecha5, ")
SQL.ADD(" T.Especie, T.FechaEj, T.TipoTr2, T.Cantidad1, T.NrTrans, T.ConceptoCA, T.Ley1, T.Fecha2, T.FechaCarga, ")
SQL.ADD(" T.FechaCargaSys, 1 Tip, T.CB1, T.CB2, T.Precio2,T.Mercado1,T.Mercado2,T.Cliente2  from "~DBO~".TRANSACCIONES2 T")
SQL.ADD(" where T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND TipoTr2 IN ('DRT') ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD("  and T.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
If dialogo.rADIO1=1
   SQL.ADD("  and T.RB2 = '1' ")
Endif
If dialogo.rADIO1=2
   SQL.ADD("  and (T.RB2 = '0' OR T.RB2='-1' OR T.RB2 IS NULL OR T.RB2='' )")
Endif

SQL.ADD("order by T.Fecha1 ")

Recorrer SQL
  ACN(in2, fac)
  ACT(es:fac, BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',FBN['Especie'])))

  If Vacio(FBN['PrecioEj']) o FBN['PrecioEj'] = 0
     ACT(a:FAC, FBN['Especie']~IIF(NoVacio(Val(es:fac)) y FBN['CB1']=1 y FBN['CB2']=1,'/'~Val(es:fac),''))
    else
     ACT(a:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj']~IIF(NoVacio(Val(es:fac)) y FBN['CB1']=1 y FBN['CB2']=1,'/'~Val(es:fac),''))
  endif


  ACT(b:fac, FBN['Fecha1'])
 
  ACT(c:fac, FBN['Cliente1'])
  ACT(d:fac, FBN['Mercado1'])
  ACT(e:fac, FBN['Cuenta1'])


  ACT(f:fac, FBN['Cliente2'])
  ACT(g:fac, FBN['Mercado2'])
  ACT(h:fac, FBN['Cuenta2'])

  ACN(i:fac, FBN['Cantidad1'])
  If eqstr(fbn('TipoTr2'),'CAMEST')
     ACN(i:fac, FBN['Precio2'])
  Endif
  ACT(j:fac, FBN['NrTrans'])

  If Eqstr(fbn('RB2'),'1') o fbn('Fecha1')<fbn('FechaCargaSys')
     ACT(k:fac, 'Confirmada')
  Else
     ACT(k:fac, 'Pendiente')
  Endif

  ACd(l:fac, fbn('Fecha5'))

  ACD(n:fac,fbn['FechaCargaSys'])

  SQL.ADD("SELECT I.NrInstancia, I.Nombre ")
  SQL.ADD("FROM "~DBO~".OPERACIONESBITS OB, "~DBO~".INSTANCIAS I ")
  SQL.ADD("WHERE OB.NrOperacion = '"~Val(j:fac)~"' AND ")
  SQL.ADD("      OB.Valor = '1' AND ")
  SQL.ADD("      I.Tabla = 'TRANSACCIONES2' AND ")
  SQL.ADD("      OB.NrBit = I.NrInstancia ")
  SQL.ADD("ORDER BY NrInstancia ")

  ACT(in1, 'SI')
  Recorrer SQL
     IF EqStr(Val(in1), 'SI')
        dfa
     ENDIF
     ACT(m:fac, FBN['Nombre'])
     ACT(in1, 'NO')
  Proximo
  IF EqStr(Val(in1), 'SI')
     dfa
  ENDIF

  if FBN['Tip'] = 2
     ColorCeldas(a:Val(in2)..m:fac,RGB(128,0,0))
  else
     ACLT(j:Val(in2), FBN['NrTrans'])
     ColorCeldas(m:Val(in2)..m:fac,clBlue)
  endif

proximo

SetFont(a:Val(w1)+1..N:FAC,1)
ACO(1,7)
ACO(2,6)
ACO(3,7)
ACO(4,6)
ACO(5,6)
ACO(6,5)
ACO(7,7)
ACO(8,5)
ACO(9,10)
ACO(10,6)
ACO(11,10)
ACO(12,6)
ACO(13,12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC,2)
LimitesVision(n:FAC)
RangoTitulo(a:1..N:FAC, Val(w1))
SetPrintFit(3,86)
