         IF Val(v6) = 1585
            ACN(j:fac, Val(h:fac)*Val(cf:fac)+(Round(Val(zz:fac),2)*Val(cf:fac)))
         ELSE
            ACN(j:fac, Val(h:fac)*Val(cf:fac)+Round(Val(zz:fac),2))
            *messagebox('2')
         ENDIF
      ELSE
         ACN(j:fac, Val(g:fac)*Val(cf:fac) )
      ENDIF
      ACT(l:fac, FBN['NrTrans'])
      IF Buscar('OR',FBN['NrTrans'])
          ACLR(l:fac, FBN['NrTrans'])
      ELSE
          ACLT(l:fac, FBN['NrTrans'])
      ENDIF
