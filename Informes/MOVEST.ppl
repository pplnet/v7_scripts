ModoReproceso(SinDialogo)
CrearDialogo
  Lista4     : "Estados"                           ;  ; ;;;;;;;;;SQLSet("SELECT Descripcion FROM "~DBO~".ESTADOSCUSTODIA WHERE Habilitado <> 'NO' ORDER BY NrSaldo ASC ");SI
  Lista1     : "Especies"                          ;-5;2;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");SI
  Mercado1   : "Ubicacion"                         ;  ;1;;;;;;;;;;;
  Radio1     : "Moneda|Pesos|Dolares"              ;  ; ;;;;;;;0;
  Fecha1     : "Fecha Desde"                       ;  ;1;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2     : "Fecha Hasta"                       ;  ; ;;;;Dialogo.Fecha2>=Dialogo.Fecha1 y Dialogo.Fecha2<=Fsys;'Debe Ingresar la Fecha';NO;FSys
  ListaTabla2: "Clientes"                          ;  ; ;;;;;;;;;;;;;'Codigo' ; 'Codigo;RazonSocial' ; 'vCLIENTES01'
  Vehiculo1  : "Vehiculo"                          ;  ;2;;NO;NO;;;;VAR('VEHICULODE');;;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

*- Saldo Inicial 
ACN(sl1,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')) )

SQL.ADD("SELECT S1.Cliente, S1.Cuenta, S1.Especie, S1.Mercado, S1.NrSaldo, 1 Orden, '"~IdxDate(Dialogo.Fecha1)~"' FechaMov, Sum(S1.Saldo) as Cantidad, ")
SQL.ADD("       C.RazonSocial, 'SALINI' TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ") 
SQL.ADD("       E.Nombre, E.InteresesC, 'Saldo Inicial' Leyenda, EC.Descripcion, '00000000' NrTrans, '' Auxiliar, S1.Cupon ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK) INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ")
SQL.ADD("              ON S1.Cliente = C.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK)  ")
SQL.ADD("              ON S1.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK) ")
SQL.ADD("              ON ((S1.NrSaldo = "~Fstr(val(sl1),0,0)~" AND S1.NrSaldo = EC.NrSaldo) OR (S1.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND S1.NrSaldo-100 = EC.NrSaldo)) ")
SQL.ADD("WHERE  ")
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista4)
   SQL.ADD("   EC.Descripcion IN ("~Pipe2Comillas(Dialogo.Lista4)~") AND ")
ENDIF
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK)  ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente  AND ")
SQL.ADD("                        S2.Especie = S1.Especie  AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' AND ")
SQL.ADD("                        S2.Cuenta  = S1.Cuenta   AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon )")
SQL.ADD("GROUP BY S1.Cliente, S1.Cuenta, S1.Especie, S1.Mercado, S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, ")
SQL.ADD("         E.TasaIntAnterior, E.TasaIntVigente, E.Nombre, E.InteresesC, EC.Descripcion, S1.Cupon ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT M.Cliente, M.Cuenta, M.Especie, M.Mercado, M.NrSaldo, 2 Orden, M.FechaMov, M.Cantidad, ")
SQL.ADD("       C.RazonSocial, T.TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, T.NrTrans, 'EJE' Auxiliar, M.Cupon ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M WITH (NOLOCK)  INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK)  ")
SQL.ADD("             ON  M.Cliente = C.Codigo ")
SQL.ADD("         INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("             ON ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)) ")
SQL.ADD("         INNER JOIN  "~DBO~".ESPECIES E WITH (NOLOCK)  ")
SQL.ADD("             ON M.Especie = E.Codigo    ")
SQL.ADD("         INNER JOIN "~DBO~".TRANSACCIONES2 T WITH (NOLOCK) ") 
SQL.ADD("             ON M.NrOperacion = T.NrTrans ")
SQL.ADD("WHERE  ")
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   M.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista4)
   SQL.ADD("   EC.Descripcion IN ("~Pipe2Comillas(Dialogo.Lista4)~") AND ")
ENDIF
SQL.ADD("      T.TipoTr2 In ('DTP','RTP','CAMEST','CUPON','LCUPON','PDIVID','DRT') ")

SQL.ADD("UNION ALL ")
SQL.ADD("SELECT M.Cliente, M.Cuenta, M.Especie, M.Mercado, M.NrSaldo, 2 Orden, M.FechaMov, M.Cantidad, ")
SQL.ADD("       C.RazonSocial, O.TipoOrden TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, O.NrOperacion NrTrans, 'EJE' Auxiliar, M.Cupon ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M WITH (NOLOCK)  INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ")
SQL.ADD("            ON  M.Cliente = C.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("            ON ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)) ")
SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("            ON  M.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".ORDENES O WITH (NOLOCK) ")
SQL.ADD("            ON  M.NrOperacion = O.NrOrden ")
SQL.ADD("WHERE  ")
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   M.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista4)
   SQL.ADD("   EC.Descripcion IN ("~Pipe2Comillas(Dialogo.Lista4)~") AND ")
ENDIF
SQL.ADD("      O.TipoOrden In ('VTC','VTP','CBC','CBT','TIV','VTSUC') ")
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT M.Cliente, M.Cuenta, M.Especie, M.Mercado, M.NrSaldo, 2 Orden, M.FechaMov, M.Cantidad, ")
SQL.ADD("       C.RazonSocial, O.TipoOp TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, O.NrOrden NrTrans, 'EJE' Auxiliar, M.Cupon ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M WITH (NOLOCK)  INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK) ")
SQL.ADD("            ON  M.Cliente = C.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("            ON ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)) ")
SQL.ADD("       INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("            ON  M.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN "~DBO~".OPERACIONES O WITH (NOLOCK) ")
SQL.ADD("            ON  M.NrOperacion = O.NrOperacion ")
SQL.ADD("WHERE  ")
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   M.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista4)
   SQL.ADD("   EC.Descripcion IN ("~Pipe2Comillas(Dialogo.Lista4)~") AND ")
ENDIF
SQL.ADD("      O.TipoOp In ('TIDE','TIPO','TICT','TICO') ")
SQL.ADD("UNION ALL ")

SQL.ADD("SELECT M.Cliente, M.Cuenta, M.Especie, M.Mercado, M.NrSaldo, 2 Orden, M.FechaMov, M.Cantidad, ")
SQL.ADD("       C.RazonSocial, T.TipoTr2, E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, ")
SQL.ADD("       E.Nombre, E.InteresesC, M.Leyenda, EC.Descripcion, T.NrTrans, 'PEN' Auxiliar, M.Cupon ")
SQL.ADD("FROM "~DBO~".MOVPENDIENTES M WITH (NOLOCK)  INNER JOIN  "~DBO~".CLIENTES C WITH (NOLOCK)  ON M.Cliente = C.Codigo ")
SQL.ADD("       INNER JOIN  "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ON ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)) ")
SQL.ADD("       INNER JOIN  "~DBO~".ESPECIES E WITH (NOLOCK)  ON M.Especie = E.Codigo ")
SQL.ADD("       INNER JOIN  "~DBO~".TRANSACCIONES2 T WITH (NOLOCK)  ON M.NrOperacion = T.NrTrans ")
SQL.ADD("WHERE  ")
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"' AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   M.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista4)
   SQL.ADD("   EC.Descripcion IN ("~Pipe2Comillas(Dialogo.Lista4)~") AND ")
ENDIF
SQL.ADD("      T.TipoTr2 In ('DTP','RTP','CAMEST','CUPON','LCUPON','PDIVID','DRT') ")
SQL.ADD("ORDER BY 1, 3, 20, 4, 2, 5, 6, 7, 8 ")

ACT(e1, "Listado de Movimientos con Estados")
ACT(h2, "Fecha: "~Var('FECHASYS'))
SetFont(e1, 3)
SetFont(h2, 2)
AlinearCeldas(e1,'C')
AlinearCeldas(h2,'I')

ACT(a3, "Desde: "~Dialogo.Fecha1)
ACT(a4, "Hasta: "~Dialogo.Fecha2)

*If NoVacio(Dialogo.Lista4)
 *  ACT(a3, "Estados: "~Dialogo.Lista4)
*EndIf
*If NoVacio(Dialogo.Lista1)
 *  ACT(a4, "Especies: "~Dialogo.Lista1)
*EndIf
If NoVacio(Dialogo.ListaTabla2)
   ACT(a5, "Clientes: "~SQLSET("SELECT RazonSocial FROM "~DBO~".CLIENTES WHERE Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") "))
ELSE
   ACT(a5, "Clientes: Todos")
EndIf

SetFont(a3..a7, 2)

ACT(a7, "Cliente")
ACT(b7, "Especie")
ACT(c7, "Ubic.")
ACT(d7, "Cuenta")
ACT(e7, "Estado")
ACT(f7, "Fecha")
ACT(g7, "Cant. VN")
ACT(h7, "Cant. VR")
ACT(i7, "VR al Mov")
ACT(j7, "Valuacion")
ACT(k7, "Saldo Dia V.R.")
ACT(l7, "Numero")
ACT(m7, "Leyenda")
ACT(n7, "Ejec/Pend")

SetFont(a6..n7, 2)
AgregarMarco(a7..n7,0,0,Exe('COLOR'))
AlinearCeldas(a7..n7,'C')

* Primera vez
ACT(v0, 'NO')
* Variable de Cliente
ACT(v1, '')
* Variable de Especie
ACT(v2, '')
* Variable de Ubicacion
ACT(v3, '')
* Variable de Estado
ACN(v4, 0)
* Variable de Fecha
ACD(v5, Dialogo.Fecha1-10)
* Resolucion 1585
ACN(v6, 0)
* Variable de Cuenta
ACT(v7, '')

* Acumulador Val Cliente
ACN(z1, 0)
* Acumulador VN Especie
ACN(x2, 0)
* Acumulador VR Especie
ACN(y2, 0)
* Acumulador Val Especie
ACN(z2, 0)

* Acumulador VN Ubicacion
ACN(x3, 0)
* Acumulador VR Ubicacion
ACN(y3, 0)
* Acumulador Val Ubicacion
ACN(z3, 0)

* Acumulador VN Estado
ACN(x4, 0)
* Acumulador VR Estado
ACN(y4, 0)
* Acumulador Val Estado
ACN(z4, 0)

* Acumulador VN Cuenta
ACN(x6, 0)
* Acumulador VR Cuenta
ACN(y6, 0)
* Acumulador Val Cuenta
ACN(z6, 0)

* Acumulador VR FechaMov
ACN(y5, 0)

ACN(fi1, 8)
SetFilaActual(Val(fi1)-1)
Recorrer SQL

   * Corte por Cliente
   IF Not EqStr(FBN['Cliente'], Val(v1))
      IF EqStr(Val(v0),'SI')
         * Total de Fecha Ant
         ACN(k:fac-1, Val(y5))
         SetFont(j:fac-1, 1)
         ACN(y5, 0)
         ACT(e:fac, 'Total Estado')
         ACN(g:fac, Val(x4))
         ACN(h:fac, Val(y4))
         ACN(j:fac, Val(z4))
         ACN(x4, 0)
         ACN(y4, 0)
         ACN(z4, 0)
         SetFont(a:fac..j:fac, 2)
         ifa
         ACT(d:fac, 'Total Cuenta')
         ACN(g:fac, Val(x6))
         ACN(h:fac, Val(y6))
         ACN(j:fac, Val(z6))
         ACN(x6, 0)
         ACN(y6, 0)
         ACN(z6, 0)
         SetFont(a:fac..j:fac, 2)
         ifa
         ACT(c:fac, 'Total Ubicacion')
         ACN(g:fac, Val(x3))
         ACN(h:fac, Val(y3))
         ACN(j:fac, Val(z3))
         ACN(x3, 0)
         ACN(y3, 0)
         ACN(z3, 0)
         SetFont(a:fac..j:fac, 2)
         ifa
         ACT(b:fac, 'Total Especie')
         ACN(g:fac, Val(x2))
         ACN(h:fac, Val(y2))
         ACN(j:fac, Val(z2))
         ACN(x2, 0)
         ACN(y2, 0)
         ACN(z2, 0)
         SetFont(a:fac..j:fac, 2)
         ifa
         ACT(a:fac, 'Total Cliente')
         ACN(j:fac, Val(z1))
         ACN(z1, 0)
         SetFont(a:fac..j:fac, 2)
         SetFilaActual(fac+2)
      ENDIF
      ACT(v0, 'SI')
      
      ACT(a:fac, FBN['Cliente']~' - '~Copy(FBN['RazonSocial'],1,20))
      ifa
      ACT(v1, FBN['Cliente'])
      ACN(cp1, FBN['Cupon'])
      If FBN['Cupon'] > 0
         ACT(b:fac, FBN['Especie']~' - Cupon '~FBN['Cupon'])
      Else
         ACT(b:fac, FBN['Especie'])
      Endif
      ACT(v2, FBN['Especie'])
      ACN(v6, BUSCARCAMPO('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACT(c:fac, FBN['Mercado'])
      ACT(v3, FBN['Mercado'])
      ACT(d:fac, FBN['Cuenta']~' - ' ~Copy(BUSCARCAMPO('CUENTAS', 'Nombre', 'Codigo', FBN['Cuenta']),1,20))
      ACT(v7, FBN['Cuenta'])
      ACT(e:fac, FBN['Descripcion'])
      ACN(v4, FBN['NrSaldo'])
      ACD(v5, Dialogo.Fecha1-10)
      ACN(g:fac, 0)
      ACN(h:fac, 0)
      ACN(j:fac, 0)

      IF EqStr(FBN['TipoTr2'],'SALINI')
         ACN(g:fac, FBN['Cantidad'])
         ACN(h:fac, FBN['Cantidad']*VALORTEORICO2(FBN['Especie'],Dialogo.Fecha2))
         ACN(i:fac, FBN['Cantidad']*VALORTEORICO2(FBN['Especie'],FBN['FechaMov']))

         IF Dialogo.Radio1 = 0
            ACN(cf:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaMov'],1,SI,VAR('MONELOCA')))
         ELSE
            ACN(cf:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaMov'],1,SI,VAR('MONEEXTR')))
         ENDIF

         ACN(yt1, fac)
         ACD(yu:fac, FBN['FechaMov'])
         ACT(yv:fac, FBN['Especie'])
         ACN(yw:fac, FBN['Cantidad'])

         ACD(yx:fac, FBN['FechaCambioTasa'])
         ACN(yy:fac, FBN['TasaIntAnterior'])
         ACN(yz:fac, FBN['TasaIntVigente'])
         (.'INTERESCLE'.)
         
         IF EqStr(FBN['InteresesC'],'CLE')
            IF Val(v6) = 1585
               ACN(j:fac, Val(h:fac)*Val(cf:fac)+(Round(Val(zz:fac),2)*Val(cf:fac)))
            ELSE
               ACN(j:fac, Val(h:fac)*Val(cf:fac)+Round(Val(zz:fac),2))
            ENDIF
         ELSE
            ACN(j:fac, Val(g:fac)*Val(cf:fac))
         ENDIF
      ENDIF

      AgregarMarco(a:fac..n:fac,1,1,Exe('COLOR6'))
      ACN(y5, Val(h:fac))
      ACN(x6, Val(g:fac))
      ACN(y6, Val(h:fac))
      ACN(z6, Val(j:fac))
      ACN(x4, Val(g:fac))
      ACN(y4, Val(h:fac))
      ACN(z4, Val(j:fac))
      ACN(x3, Val(g:fac))
      ACN(y3, Val(h:fac))
      ACN(z3, Val(j:fac))
      ACN(x2, Val(g:fac))
      ACN(y2, Val(h:fac))
      ACN(z2, Val(j:fac))
      ACN(z1, Val(j:fac))
      SetFont(a:fac-1..j:fac, 2)
      ifa
   ENDIF

   * Corte por especie
   IF [Not EqStr(FBN['Especie'], Val(v2))] o [Eqstr(FBN['Especie'], Val(v2)) y FBN['Cupon'] <> Val(cp1)]

*   IF Not EqStr(FBN['Especie'], Val(v2))
      * Total de Fecha Ant
      ACN(k:fac-1, Val(y5))
      SetFont(j:fac-1, 1)
      ACN(y5, 0)
      ACT(e:fac, 'Total Estado')
      ACN(g:fac, Val(x4))
      ACN(h:fac, Val(y4))
      ACN(j:fac, Val(z4))
      ACN(x4, 0)
      ACN(y4, 0)
      ACN(z4, 0)
      SetFont(a:fac..j:fac, 2)
      ifa
      ACT(d:fac, 'Total Cuenta')
      ACN(g:fac, Val(x6))
      ACN(h:fac, Val(y6))
      ACN(j:fac, Val(z6))
      ACN(x6, 0)
      ACN(y6, 0)
      ACN(z6, 0)
      SetFont(a:fac..j:fac, 2)
      ifa
      ACT(c:fac, 'Total Ubicacion')
      ACN(g:fac, Val(x3))
      ACN(h:fac, Val(y3))
      ACN(j:fac, Val(z3))
      ACN(x3, 0)
      ACN(y3, 0)
      ACN(z3, 0)
      SetFont(a:fac..j:fac, 2)
      ifa
      ACT(b:fac, 'Total Especie')
      ACN(g:fac, Val(x2))
      ACN(h:fac, Val(y2))
      ACN(j:fac, Val(z2))
      ACN(x2, 0)
      ACN(y2, 0)
      ACN(z2, 0)
      SetFont(a:fac..j:fac, 2)
      ifa
      ACT(b:fac, '-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------')
      SetFilaActual(fac+2)

      ACN(cp1, FBN['Cupon'])
      If FBN['Cupon'] > 0
         ACT(b:fac, FBN['Especie']~' - Cupon '~FBN['Cupon'])
      Else
         ACT(b:fac, FBN['Especie'])
      Endif
      ACT(v2, FBN['Especie'])
      ACN(v6, BUSCARCAMPO('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACT(c:fac, FBN['Mercado'])
      ACT(v3, FBN['Mercado'])
      ACT(d:fac, FBN['Cuenta']~' - ' ~Copy(BUSCARCAMPO('CUENTAS', 'Nombre', 'Codigo', FBN['Cuenta']),1,20))
      ACT(v7, FBN['Cuenta'])
      ACT(e:fac, FBN['Descripcion'])
