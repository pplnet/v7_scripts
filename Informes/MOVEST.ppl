      ACN(x6, Val(g:fac))
      ACN(y6, Val(h:fac))
      ACN(z6, Val(j:fac))
      ACN(x4, Val(g:fac))
      ACN(y4, Val(h:fac))
      ACN(z4, Val(j:fac))
