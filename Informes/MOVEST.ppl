         ACN(i:fac, FBN['Cantidad']*VALORTEORICO2(FBN['Especie'],FBN['FechaMov']))

         IF Dialogo.Radio1 = 0
            ACN(cf:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaMov'],1,SI,VAR('MONELOCA')))
         ELSE
            ACN(cf:fac, CotizacionC(FBN['Especie'],,,,FBN['FechaMov'],1,SI,VAR('MONEEXTR')))
         ENDIF

         ACN(yt1, fac)
         ACD(yu:fac, FBN['FechaMov'])
         ACT(yv:fac, FBN['Especie'])
         ACN(yw:fac, FBN['Cantidad'])

         ACD(yx:fac, FBN['FechaCambioTasa'])
         ACN(yy:fac, FBN['TasaIntAnterior'])
         ACN(yz:fac, FBN['TasaIntVigente'])
         (.'INTERESCLE'.)

         IF EqStr(FBN['InteresesC'],'CLE')
            IF Val(v6) = 1585
               ACN(j:fac, Val(h:fac)*Val(cf:fac)+(Round(Val(zz:fac),2)*Val(cf:fac)))
            ELSE
               ACN(j:fac, Val(h:fac)*Val(cf:fac)+Round(Val(zz:fac),2))
            ENDIF
         ELSE
            ACN(j:fac, Val(g:fac)*Val(cf:fac))
         ENDIF
      ENDIF
