**Realizar un informe de la tabla OPEXTERNAS que dada un fecha y un Estado o varios liste todos los registros de la tabla. Los estados posibles son INGresado / DUPlicado / GENerada
**Se pueden listar uno o varios estados

CrearDialogo
  Fecha1: 'Fecha Carga'  ;1;1; ;;;;;;Fecha(Ahora)
  Check1: 'Ingresada'    ;2; ; ;;;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check5+Dialogo.Check6>=1;'Debe seleccionar al menos una opcion';NO;1;
  Check2: 'Duplicada'    ;3; ; ;;;;;;1;
  Check3: 'Generada'     ;4; ; ;;;;;;1;  
  Check4: 'Procesada'    ;5; ; ;;;;;;1;  
  Check5: 'Rechazada'    ;6; ; ;;;;;;1;  
  Check6: 'Eliminadas'   ;7; ; ;;;;;;1;  
FinDialogo

if Not OK
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

ACT(f2, 'Informe de Operaciones Externas del '~Dialogo.Fecha1)
SetFont(f2,3)
*AlinearCeldas(d2, 'D')
ACT(a4, 'Estados: ' )
If Dialogo.Check1=1
   ACT(a4, Val(a4)~' - Ingresadas')
   ACT(xy1,'ING|')
Endif
If Dialogo.Check2=1
   ACT(a4, Val(a4)~' - Duplicadas')
   ACT(xy1,Val(xy1)~'DUP|')
Endif
If Dialogo.Check3=1
   ACT(a4, Val(a4)~' - Generadas')
   ACT(xy1,Val(xy1)~'GEN|')
Endif
If Dialogo.Check4=1
   ACT(a4, Val(a4)~' - Procesada')
   ACT(xy1,Val(xy1)~'PRO|')
Endif
If Dialogo.Check5=1
   ACT(a4, Val(a4)~' - Rechazadas')
   ACT(xy1,Val(xy1)~'REC|ERR')
Endif
If Dialogo.Check1=0 y Dialogo.Check2=0 y Dialogo.Check3=0 y Dialogo.Check4=0 y Dialogo.Check5=0 
   ACT(a4, Val(a4)~' Todas')
   ACT(xy1,'ING|GEN|DUP|PRO|REC|ERR')
Endif   

SetFont(a4,1)
SetFilaActual(5)
ACN(w1,FAC)

ACT(a:fac, 'IDSisExterno')
ACT(b:fac, 'CodSisExterno')
ACT(c:fac, 'NrExterno')
ACT(d:fac, 'TipoOp')
ACT(e:fac, 'TipoEspecie')
ACT(f:fac, 'Especie')
ACT(g:fac, 'TipoCliente')
ACT(h:fac, 'Cliente')
ACT(i:fac, 'Cantidad')
ACT(j:fac, 'Precio')
ACT(k:fac, 'TipoContraEspecie')
ACT(l:fac, 'ContraEspecie')
ACT(m:fac, 'FechaOp')
ACT(n:fac, 'Plazo')
ACT(o:fac, 'Operador')
ACT(p:fac, 'Book')
ACT(q:fac, 'FechaCarga')
ACT(r:fac, 'Estado')
ACT(s:fac, 'NrOperacion')
ACT(t:fac, 'Tipo')

AgregarMarco(a:FAC..t:FAC,2,0,Exe('COLOR'))
SetFont(a:fac..t:fac, 1)

ifa
act(a:fac,'Pedidos '~VAR('SISEXT1'))
SetFont(a:fac..a:fac, 1)
SQL.ADD("Select * from "~DBO~".OPEXTERNAS ")
SQL.ADD("  where FechaCarga  >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("    and FechaCarga  < '"~IdxDate(Dialogo.Fecha1+1)~"' ")
SQL.ADD("    and IsNull(Estado,'ING') in ("~Pipe2Comillas(Val(xy1))~")        ")
SQL.ADD("order by IDSisExterno,Cliente ")

Recorrer SQL
  ACT(a:fac, fbn('IDSisExterno'))
  ACT(b:fac, fbn('CodSisExterno'))
  ACT(c:fac, fbn('NrExterno'))
  ACT(d:fac, fbn('TipoOp'))
  ACT(e:fac, fbn('TipoEspecie'))
  ACT(f:fac, fbn('Especie'))
  ACT(g:fac, fbn('TipoCliente'))
  ACT(h:fac, fbn('Cliente'))
  ACN(i:fac, fbn('Cantidad'))
  ACN(j:fac, fbn('Precio'))
  ACT(k:fac, fbn('TipoContraEspecie'))
  ACT(l:fac, fbn('ContraEspecie'))
  ACD(m:fac, fbn('FechaOp'))
  ACN(n:fac, fbn('Plazo'))
  ACT(o:fac, fbn('Operador'))
  ACT(p:fac, fbn('Book'))
  ACD(q:fac, fbn('FechaCarga'))
  ACT(r:fac, fbn('Estado'))
  ACT(s:fac, fbn('NrOperacion'))
  ACT(t:fac, fbn('TipoAbm'))
  
  FormatoCeldas(j:fac, Exe('F8'))
  FormatoCeldas(n:fac, Exe('F0'))
proximo

ifa
ifa
act(a:fac,'Operaciones Eliminadas')
SetFont(a:fac..a:fac, 1)

If Dialogo.Check6=1
    SQL.ADD("Select * from "~DBO~".BOPERACIONES ")
    SQL.ADD("  where FechaDel  >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
    SQL.ADD("    and FechaDel  < '"~IdxDate(Dialogo.Fecha1+1)~"' ")
    SQL.ADD("    and IsNull(NrExterno,'')<>'' ")
    SQL.ADD("order by NrOperacion ")

    Recorrer SQL
      ACT(c:fac, fbn('NrExterno'))
      ACT(d:fac, fbn('TipoOp'))
      ACT(f:fac, fbn('Especie'))
      ACT(h:fac, fbn('Cliente1'))
      ACN(i:fac, fbn('Cantidad'))
      ACN(j:fac, fbn('Precio1'))
      ACT(l:fac, fbn('ContraEspecie'))
      ACD(m:fac, fbn('FechaOp'))
      ACN(n:fac, fbn('Plazo'))
      ACT(o:fac, fbn('Operador'))
      ACT(p:fac, fbn('Book1'))
      ACD(q:fac, fbn('FechaDel'))
      ACT(s:fac, fbn('NrOperacion'))
      
      FormatoCeldas(j:fac, Exe('F8'))
      FormatoCeldas(n:fac, Exe('F0'))
    proximo
endif


ACO(1, 7)
ACO(2, 10)  
ACO(3, 8)  
ACO(6, 15)
ACO(9, 10)
ACO(10, 10)
ACO(11,12)
ACO(12,12)  
ACO(20,6)
ACO(21,1)  
SetMargins(0,0,0,2)
Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,1)

LimitesVision(u:fac)
RangoTitulo(a:1..t:fac, Val(w1)+2)
SetPrintFit(3,60)
