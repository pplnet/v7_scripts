* ---> Impresion De La Carta De Aviso De Corte De Cupon

*ModoReproceso(ConDialogo)
CrearDialogo
   Cliente1  : "Cliente"   ; 01;1;1;SI;SI; NoVacio(Dialogo.Cliente1)                                                                                                     ; 'Debe Ingresar El Cliente'                     ; NO; 
   Especie1  : 'Especie'   ; 02;1;1;SI;SI; NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1, 'TITULO') y Not DesciendeDeEspecie(Dialogo.Especie1, 'CUPON'); 'Debe Ingresar Una Especie Valida'             ; NO;                               ;                                                                                                                                                         ; ; ; ; "Status = 'HAB' "
   Fecha1    : 'F.Corte'   ; 03;1;1;SI;SI; Dialogo.Fecha1  <> 0      y Dialogo.Fecha1 >= Fsys                                                                            ; 'Debe Ingresar una Fecha Valida'               ; NO; Fsys                          ; ProxCupon2(Dialogo.Especie1, Fsys)
   Entero1   : 'Nr.Cupon'  ; 04;1;1;SI;SI; Dialogo.Entero1 >= 0                                                                                                          ; 'Debe Ingresar El Numero de Cupon'             ; NO; 0                             ; BuscarCampo('Especies', 'Cupon', 'Codigo', Dialogo.Especie1)
   Precio1   : '% Amort.'  ; 05;1;1;SI;SI; Dialogo.Precio1 >= 0                                                                                                          ; 'El % De Amortizacion Debe Ser Positivo'       ; NO;                               ; SQL("SELECT PorAmCapital FROM " ~ DBO ~ ".AGENDACUPONES WHERE Especie = '" ~ Dialogo.Especie1 ~ "' AND NrCupon = '" ~ FStr(Dialogo.Entero1, 1, 0) ~ "'")
   Precio2   : '% Renta'   ; 06;1;1;SI;SI; Dialogo.Precio2 >= 0                                                                                                          ; 'El % De Renta Debe Ser Positivo'              ; NO;                               ; SQL("SELECT PorRenta     FROM " ~ DBO ~ ".AGENDACUPONES WHERE Especie = '" ~ Dialogo.Especie1 ~ "' AND NrCupon = '" ~ FStr(Dialogo.Entero1, 1, 0) ~ "'")
   Precio5   : 'V.T.Actual'; 07;1;1;SI;SI; Dialogo.Precio5 >  0                                                                                                          ; 'El % De V. Teorico Al Corte Debe Ser Positivo'; NO; ValorTeorico(Dialogo.Especie1); ValorTeorico(Dialogo.Especie1)
   Vehiculo1 : 'Vehiculo'  ; 08;1;1;NO;NO;                                                                                                                               ;                                                ;   ; Var('VEHICULODE')
   Mercado1  : 'C.Custodia';   ;1;1;  ;  ;;;SI
   Precio6   : '% Capit'   ; 10;1;1;SI;SI;Dialogo.Precio6>=0; 'El % De Capitalizacion Debe Ser Positivo';NO;SQL("SELECT TasaCapInt FROM "~DBO~".AGENDACUPONES WHERE Especie = '"~Dialogo.Especie1~"' AND NrCupon = '"~FStr(Dialogo.Entero1,1,0) ~"'")
FinDialogo

If [Not OK]
   Cancelar
EndIf

If [[NoVacio(Dialogo.Vehiculo1)] y [Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo))] y [Not Vacio(UsrVehiculos(UsuarioActivo))]]
   Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
EndIf

(.'LOGO'.)

 
* ---> Seleccion De La Informacion A Listar

ACN(X:02, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU')))

SQL.Add("SELECT DISTINCT S.Cuenta, ")
SQL.Add("                S.Mercado, ")
SQL.Add("                S.EnteCustodia, ")
SQL.Add("                S.CallPut, ")
SQL.Add("                S.FechaEj, ")
SQL.Add("                S.PrecioEj, ")
SQL.Add("                S.Cliente, ")
SQL.Add("                S.NrSaldo, ")
SQL.Add("                C.RazonSocial, ")
SQL.Add("                C.Direccion, ")
SQL.Add("                C.CodigoPostal, ")
SQL.Add("                C.Localidad, ")
SQL.Add("                C.RecibePreaviso ")
SQL.Add("FROM " ~ DBO ~ ".SALDOS S, ")
SQL.Add("     " ~ DBO ~ ".CLIENTES C ")
SQL.Add("WHERE S.EnteCustodia   = '" ~ Dialogo.Vehiculo1           ~ "' ")
SQL.Add("AND   S.Especie        = '" ~ Dialogo.Especie1            ~ "' ")
SQL.Add("AND   S.Cupon          = '" ~ FStr(Dialogo.Entero1, 1, 0) ~ "' ")
SQL.Add("AND   S.Cliente        = '" ~ Dialogo.Cliente1            ~ "' ")
SQL.Add("AND   S.NrSaldo        = '" ~ FStr(Val(X:02), 1, 0)       ~ "' ")
SQL.Add("AND   S.Cliente        = C.Codigo ")
SQL.Add("AND   C.RecibePreaviso = 'SI' ")
IF NoVacio(Dialogo.Mercado1)
   SQL.Add("  AND S.Mercado='"~Dialogo.Mercado1~"' ")
EndIf

* ---> Preparacion De La Impresion De La Carta
CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,12,B")

* ---> Impresion De Lineas De La Carta
Recorrer SQL

   * ---> Calculo Del Saldo A La Fecha

   ACN(X:01, SaldoD(FBN['Cliente'], Dialogo.Especie1, FBN['CallPut'], FBN['FechaEj'], FBN['PrecioEj'], FBN['Mercado'], FBN('EnteCustodia'), FBN['Cuenta'], FBN['NrSaldo'], Dialogo.Fecha1, FStr(Dialogo.Entero1, 1, 0)))

   If [Val(X:01) <> 0]

      SetFilaActual(15)

      * ---> Impresion Del Titulo De Referencia

      ACT(H:FAC, "Aviso de Corte de Cupon")
      SetFont(H:FAC, 3)

      * ---> Impresion De La Fecha De Emision De La Carta

      SetFilaActual(FAC + 2)
      ACD(ZB:09, FSys)
      (.'ARMAFECH'.) 
      ACT(H:FAC, "Buenos Aires, " ~ Val(ZB:10))
      SetFont(H:FAC, 1)

      * ---> Impresion De Una Linea De Texto

      SetFilaActual(FAC + 6)
      ACD(ZB:09, Dialogo.Fecha1)
      (.'ARMAFECH'.) 
      ACT(A:FAC, Pad('', 11) ~ "El dia " ~ Val(ZB:10) ~ ", se procedera  al Corte de Cupon correspondiente a la Especie " ~ Dialogo.Especie1 ~ " (" ~ BuscarCampo('Especies', 'Nombre', 'Codigo', Dialogo.Especie1) ~ "),")
      SetFont(A:FAC, 1)

      * ---> Impresion De Una Linea De Texto

      IFA
      ACT(A:FAC, "numero de cupon " ~ FStr(Dialogo.Entero1, 1, 0) ~ ", con los siguientes porcentajes:")
      SetFont(A:FAC, 1)

      * ---> Impresion Del Porcentaje De Amortizacion

      SetFilaActual(FAC + 2)
      ACT(F:FAC, "% Amort.")
      ACN(G:FAC, Dialogo.Precio1)
      FormatoCeldas(G:FAC, Exe('F6')) 
      SetFont(F:FAC..G:FAC, 1)

      * ---> Impresion Del Porcentaje De Renta

      IFA
      ACT(F:FAC, "% Renta")
      ACN(G:FAC, Dialogo.Precio2)
      FormatoCeldas(G:FAC, Exe('F6')) 
      SetFont(F:FAC..G:FAC, 1)

      IFA
      ACT(F:FAC, "% Cap.de Interes")
      ACN(G:FAC, Dialogo.Precio6)
      FormatoCeldas(G:FAC, Exe('F6')) 
      SetFont(F:FAC..G:FAC, 1)


      * ---> Impresion De Una Linea De Texto

      SetFilaActual(FAC + 2)
      ACT(A:FAC, Pad('', 11) ~ "El nuevo valor residual es " ~ FStr(Dialogo.Precio5, 0, 5) ~ ".")
      SetFont(A:FAC, 1)

      * ---> Impresion De Una Linea De Texto

      SetFilaActual(FAC + 6)
      ACT(H:FAC, "Sres.:")
      SetFont(H:FAC, 2)

      * ---> Impresion De La Razon Social

      IFA
      ACT(ZB:01, copy(FBN('RazonSocial'),1,25))
      (.'ELIBLANCOS'.)
      ACT(H:FAC, Val(ZB:03))
      SetFont(H:FAC, 2)

      * ---> Impresion De La Direccion

      IFA
      ACT(ZB:01, FBN('Direccion'))
      (.'ELIBLANCOS'.)
      ACT(H:FAC, Val(ZB:03))
      SetFont(H:FAC, 2)

      * ---> Impresion Del Codigo Postal Y La Localidad
 
      IFA
      If [NoVacio(FBN('CodigoPostal')) y Not EqStr(FBN('CodigoPostal'), '000000')]
         If [EqStr(Copy(FBN('CodigoPostal'), 01, 02), '00')]
            ACT(H:FAC, "(" ~ Copy(FBN('CodigoPostal'), 03, 04) ~ ')')
         Else  
            ACT(H:FAC, "(" ~ Copy(FBN('CodigoPostal'), 01, 04) ~ ')')
         EndIf
      Else
         ACT(H:FAC, "(    )")
      EndIf      
      If [NoVacio(FBN('Localidad'))]
         ACT(ZB:01, FBN('Localidad'))
         (.'ELIBLANCOS'.)
         ACT(H:FAC, Val(H:FAC) ~ " - " ~ Val(ZB:03))
      EndIf      
      SetFont(H:FAC, 2)

      SetFilaActual(FAC + 5)

   EndIf

Proximo

ACO(1,2)
ACO(6,8)

LimitesVision(K:FAC)