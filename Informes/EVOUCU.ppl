CrearDialogo
  NrTrans1:'Voucher'   ;
  Cliente1:'Cliente'   ;
  Cuenta1 :'Cuenta'    ;  
  Check1  :'Re-Emision';
  Check3  :'Impresora' ;
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,12,B')
CrearFont(5, "Arial,5,")

ACT(a:4,'Fecha :'~Fecha(FSys))
AgregarBMP(A:1,EXE('LOGO'),EXE('ESCALOGO'))
SetFont(a:1..z:4,2)

If Dialogo.Check1 = 0
  ACT(d:1, 'ORIGINAL')
else
  ACT(d:1, 'COPIA')
endif
AlinearCeldas(d:1,'C')
SetFont(d:1,3)

SQL.ADD(" Select T.*, E.Nombre, E.CodNumCajaValores, E.ClaseCajaValores,C.RazonSocial, E.VTeorico, E.InteresesC ")
SQL.ADD(" from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
**SQL.ADD(" from "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E ")
SQL.ADD(" where  C.Codigo = '"~Dialogo.Cliente1~"' ")
SQL.ADD(" and    T.Especie  = E.Codigo ")
SQL.ADD(" and    T.NrTrans  = '"~Dialogo.NrTrans1~"' ")
watch(sql.batch)
acn(aa1,0)

Recorrer SQL

  ACT(f:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
  ACT(f:2, 'C.U.I.T. Nº '~BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Vehiculo1')))    
  if BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Vehiculo1')) > 0
    ACT(f:3, 'Agente de Mercado Abierto Nº '~BuscarCampo('CLIENTES','NrMAE','Codigo',fbn('Vehiculo1')))
  endif
  if BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')) > 0
    ACT(f:4, 'Cuenta en Caja de Valores Nº '~BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')))
  endif
  SetFont(f:1..f:1,2)
  SetFont(f:2..f:4,4)

 act(a:3,'Emision Vouchers '~Val(zz:1))

  acn(aa1,1)
  SetFilaActual(FAC+6)
  ACT(a:fac, 'Voucher Nro. : '~fbn['NrTrans'])
  ACT(f:fac, 'Fecha Op. : '~fbn['Fecha1'])

    if DesciendeDeEspecie(fbn['Especie'], 'TITULO')
      ACT(a:FAC+4, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']) ~' - Cupon N# ' ~ fbn('Cupon1') ~ ' (CV: '~fbn['CodNumCajaValores']~')')
    else
      ACT(a:FAC+4, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',fbn['Especie']))
    endif    
    * ACT(a:FAC+5, 'Nombre Cta. : ' ~ BuscarCampo('CUENTAS','Nombre'   ,'Codigo',fbn['Cuenta1']))
    *ACT(a:FAC+6, 'Numero      : ' ~ BuscarCampo('CUENTAS','Numero'   ,'Codigo',fbn['Cuenta1']))
    ACT(a:FAC+5, 'Depositante : ' ~ BuscarCampo('CUENTAS','Comitente','Codigo',fbn['Cuenta1']))
    ACT(a:FAC+6, 'Comitente   : ' ~ BuscarCampo('CUENTAS','NrDepositante','Codigo',fbn['Cuenta1']))
  
  ACN(es:1,FAC+7)
    
  if Eqstr(FBN['Mercado1'],VAR('MERSWIFT') )
     ACT(a:FAC+9,  'Corresponal : ' ~ BuscarCampo('CUENTAS','Corresponsal','Codigo',fbn['Cuenta1']))
     ACT(a:FAC+10,  'SWIFT / Fedwire : ' ~ BuscarCampo('CUENTAS','Alias3','Codigo',fbn['Cuenta1']))
     ACT(a:FAC+11, 'Cta. Banco : ' ~ BuscarCampo('CUENTAS','Alias1','Codigo',fbn['Cuenta1']))
     ACT(a:FAC+12, 'Subcuenta : ' ~ BuscarCampo('CUENTAS','Alias2','Codigo',fbn['Cuenta1']))
  Endif


  AgregarMarco(a:FAC+1..j:FAC+2, 2)
  ACT(a:FAC+3, 'Cliente : '~fbn['RazonSocial'])
  SetFilaActual(FAC+13)
  ACT(a:FAC, 'Fecha Op.')
  ACT(b:FAC, 'Nro. Op.')
  ACT(c:FAC, 'T.Op.')
  ACT(d:FAC, 'Descripcion')
  ACT(e:FAC, 'N.Cobros')
  ACT(f:FAC, 'N.Pagos')
  * ACT(g:FAC, 'Obs.')
  * ACT(h:FAC, 'Confir.')
  if DesciendeDeEspecie(fbn['Especie'], 'TITULO')
    ACT(i:FAC, 'Nº MAE')
  Endif
  AlinearCeldas(e:FAC..f:FAC,'D')

  AgregarMarco(a:FAC..j:FAC+1, 2,0,Exe('COLOR'))
  IFA
  ACT(aa3,fbn['NrTrans'])
  ACN(jj1,0)

  ACN(to1,0)
  ACN(to2,0)
 
  SQL.ADD("Select M.*,E.Nombre from "~DBO~".MOVEJECUTADOS M, "~DBO~".ESPECIES E ")
  SQL.ADD("where  NrOperacion = '"~fbn['NrTrans']~"' ")
  SQL.ADD("  and  E.Codigo = M.Especie ")
  SQL.ADD("  and  Nrsaldo = 1 ")
  SQL.ADD("  and  Cliente = '"~Dialogo.Cliente1~"' ")
  SQL.ADD("  and  Book    = '"~Dialogo.Cuenta1~"' ")  
  watch(sql.batch)
  Recorrer SQL
  
  ACT(es:2,fbn['Especie'])
  ACT(es:3,fbn['Nombre'])
  ACT(ml:1,fbn['Mercado'])
    ACN(z1, fbn['NrGrupo'])
    ACT(b:FAC, fbn['NrOperacion'])
    ACT(d:FAC, fbn['Leyenda'])

    if Incluido(Copy(fbn['NrOperacion'],1,2),'VT|I0|LO|C0')
      ACT(a:FAC, BuscarCampo('TRANSACCIONES2','Fecha1','NrTrans',fbn['NrTrans2']))
      ACT(c:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',fbn['NrTrans2']))
      if fbn('Cantidad')<0
        ACN(e:fac, -fbn('Cantidad'))
        SCN(to:1, ABS(fbn('Cantidad')))
      else
        if Incluido(Copy(fbn['NrOperacion'],1,2),'VT|LO')
          ACN(f:fac, -fbn('Cantidad'))
        else
          ACN(f:fac, fbn('Cantidad'))
        endif
        SCN(to:2, ABS(fbn('Cantidad')))
      endif
    else
      ACT(a:FAC, BuscarCampo('OPERACIONES','FechaOp','NrOperacion',fbn['NrOperacion']))
      ACT(c:FAC, BuscarCampo('OPERACIONES','TipoOp','NrOperacion', fbn['NrOperacion']))
      * Compras de Titulos
      IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'TIC|TIFC|TIADJ')
        IF Eqstr(fbn('Mercado'), 'CV') o fbn['Cantidad'] <= 0
          ACN(e:FAC, -fbn['Cantidad'])
          SCN(to:1, ABS(fbn['Cantidad']))
        Else
          ACN(f:fac, -fbn['Cantidad'])
          SCN(to:2, ABS(fbn['Cantidad']))
        Endif
      Endif
      * Ventas de Titulos
     IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'TIV|TIFV|TIRES')
        IF Eqstr(fbn('Mercado'), 'CV') o fbn['Cantidad'] > 0
          ACN(f:fac, -fbn['Cantidad'])
          SCN(to:2, ABS(fbn['Cantidad']))
        else
          ACN(e:fac, -fbn['Cantidad'])
          SCN(to:1, ABS(fbn['Cantidad']))
        Endif
      ENDIF
      * Money Market y FX
      IF Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'TICO|TICT|MMCO|MMCT|MMPF|MMPFCE|FXA|FXAT|FXV|FXVT|FXC|FXCT|PMU|PME|FXCTC|FXVTC')
        if fbn['Cantidad'] > 0
          ACN(f:FAC, -fbn['Cantidad'])
          SCN(to:2, ABS(fbn['Cantidad']))
        ELSE
          ACN(e:fac, -fbn['Cantidad'])
          SCN(to:1, ABS(fbn['Cantidad']))
        ENDIF
      ENDIF
      ACT(g:FAC, fbn('Status'))
      ACT(i:FAC, BuscarCampo('OPERACIONES', 'NroAltaMAE','NrOperacion',fbn['NrOperacion']))
      ACT(aa:4,fbn['NrOperacion'])
      if Incluido(Val(c:fac),'TIC|TIV|TIFC|TIFV|FXA|FXAT|FXC|FXCT|FXV|FXVT') y BuscarCampo('Operaciones','PaseCB','NrOperacion',fbn['NrOperacion'])=1
        ACT(d:FAC, Val(d:FAC)~' x Pase')
        ACT(aa:4, BuscarCampo('OPERACIONES','OperacionRef','NrOperacion',fbn['NrOperacion']))
      endif
    endif

    *--- Esta confirmado si/no?
    ACN(aa:5,0)
    SQL.ADD("Select Distinct * FROM "~DBO~".OPERACIONESBITS B ")
    SQL.ADD("where B.NrOperacion = '"~FBN('NrTrans2')~"' ")
    SQL.ADD("  and B.NrBit In (70) and B.Valor = '1' ")
    Recorrer SQL
      dfa
      ACN(aa5, 1)
    Proximo

    if Val(aa:5) = 1 o Incluido(BuscarCampo('OPERACIONES', 'TipoOp', 'NrOperacion', fbn['NrOperacion']),'PMU|PME')
**      ACT(h:FAC, 'OK')
    else
**      ACT(h:FAC, 'Falta')
      ACN(jj1,1)
    endif

  proximo
  
  ACT(a:Val(es:1), 'Especie Moneda : '~Val(es:2)~' '~Val(es:3) )
  
  ACT(a:Val(es:1)+1, 'Amortizacion : '~ FBN['Precio1']~'%')
  ACT(a:Val(es:1)+2, 'Renta : '~FBN['Precio2']~'%')
  ACT(a:Val(es:1)+3, 'Ints. Cap. : '~FBN['Precio3']~'%')
   
   
  IFA
  IFA
  ACT(a:FAC, 'Total')
  ACN(e:FAC, Sum(e:21..e:FAC-1))
  ACN(f:FAC, Sum(f:21..f:FAC-1))

  *** Agregado el 8.8.2000 por pedido de Cristina Segato
  if fbn['VTeorico'] <> 1
    act(a:fac+1, 'VR')
    ACN(e:FAC+1, Val(e:fac)*fbn['VTeorico'])    
    ACN(f:FAC+1, Val(f:fac)*fbn['VTeorico'])
    ACN(fa:2, FAC+1)
  endif

  ACN(fa1, fac)
  ACN(z3, Val(e:FAC) + Val(f:FAC))
  
  *AgregarMarco(g:20..j:FAC+1, 1)
  AgregarMarco(a:20..j:FAC, 1)
  AgregarMarco(a:FAC..j:FAC+1, 2,0,Exe('COLOR'))
  SetFilaActual(FAC+3)

  ACT(zz:1,BuscarCampo('MERCADOS','Descripcion','Codigo',Val(ml:1)))
  if DesciendeDeEspecie(Val(es:1), 'TITULO')
     ACT(b:9, 'Titulos por Caja de Valores')
  else
  ACT(b:9, Val(es:1)~' por '~Val(zz:1))
  endif
  
  ** AA 10-11-2022 se cambia el detalle del pago
  ACT(b:9,'Cupones de Titulos')
  
  if Val(to:1)>Val(to:2)
     ACT(d:FAC+1, 'Total a Cobrar :')
     ACN(e:FAC+1, ABS(Val(to:1)-Val(to:2)))
     ACT(b:9, 'Cobrar - '~Val(b:9))
  else
     ACT(d:FAC+1, 'Total a Pagar :')
     ACN(f:FAC+1, ABS(Val(to:2)-Val(to:1)))
     ACT(b:9, 'Pagar - '~Val(b:9))
  endif
  
  ACN(x1,0)
  AlinearCeldas(e:FAC..f:FAC,'D')
  AgregarMarco(c:FAC..7+Val(x1):FAC+2,2,0,Exe('COLOR'))

  ACT(f:FAC+9, 'Por '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
  AgregarMarco(a:FAC+5..i:FAC+9,2,0)
      
  ACT(a:FAC+11, 'Preparado por : '~BuscarCampo('Usuarios','Nombre','Codigo',USUARIOACTIVO))
  ACT(e:FAC+11, ' ')

  SetFont(a:1..j:FAC,2)
  SetFont(a:21..j:FAC-4,1)
  SetFont(b:9,4)
  SetFont(a:FAC..f:FAC+10,3)
*  SetFont(e:FAC..f:FAC+9,2)
  SetFilaActual(FAC+11)

  ACT(c:fac+10, '   '~BuscarCampo('CLIENTES','Direccion','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','CodigoPostal','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Localidad','Codigo',fbn('Vehiculo1'))~' - '~BuscarCampo('CLIENTES','Telefono','Codigo',fbn('Vehiculo1')))
  SetFont(d:fac+7..d:fac+7,1)
  SetFilaActual(FAC+7)

  FormatoCeldas(d:1..f:FAC,Exe('F2'))
  if Val(fa:2)<>0
    FormatoCeldas(d:Val(fa:2)..f:Val(fa:2),"0,.0000;(0,.0000)R")
  endif
  SetFont(x1..z2,1)

  ACO(1,6)
  ACO(2,6)
  ACO(3,4)
  ACO(4,22)
  ACO(5,10)
  ACO(6,10)
  ACO(7,4)
  ACO(8,4)
  ACO(9,6)
  ACO(10,4)

  LimitesVision(i:FAC)

  if Dialogo.Check3=1
      ImprimirHoja
  endif
Proximo

If Val(aa1) = 0
  Cancelar('El Voucher '~Dialogo.NrTrans1~' no existe')
endif
