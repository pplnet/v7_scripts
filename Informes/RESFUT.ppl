ModoReproceso(ConDialogo)
CrearDialogo
  Radio2    : 'Desde|Hoy|Mes|Anio|Siempre|otro';;;;;;;;;1;
  Fecha1    : 'Fecha Desde';;;;Dialogo.Radio2=4;  ;Dialogo.Fecha1>0 o Dialogo.Radio2=3;'Fecha desde Invalida';NO;;iif(Dialogo.Radio2=0,Dialogo.Fecha2,iif(Dialogo.Radio2=1,PriDeMes(Dialogo.Fecha2,SI),iif(Dialogo.Radio2=2,SumarMeses(Dialogo.Fecha2,-(Mes(Dialogo.Fecha2)-1),1),iif(Dialogo.Radio2=3,-1,Dialogo.Fecha1))));
  Fecha2    : 'Fecha Hasta';;;;  ;  ;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha hasta Invalida';NO;Fsys
  Vehiculo1 : 'Vehiculo'   ;;;;NO;  ;NoVacio(DIalogo.Vehiculo1)    ;'Vehiculo Invalido'   ;NO;Var('VEHICULODE');
  Radio1    : 'Agrupado|Sin|x Cli|x Vto';;;;;;;;;;2;
  Check1    : 'Detalle Ops';;;;  ;Dialogo.Radio1>0;;;;0;
  Cliente1  : 'Cliente'    ;;;;NO;NO;
  Fecha3    : 'Fecha Fix'  ;;;;NO;NO;
  Lista1   : 'Fixing'      ;8;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where SUBSTRING(Jerarquia,10,3)<>'000' AND SUBSTRING(Jerarquia,1,9)= (Select SUBSTRING(Jerarquia,1,9) from "~DBO~".ESPECIES where Codigo='OCTFIX') ")
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))

SetFilaActual(5)
ACN(w1, FAC)
ACT(a:FAC, 'Resultados de Operaciones Futuros')
ACT(a:FAC+2, 'Vehiculo: '~Dialogo.Vehiculo1)
if Dialogo.Fecha1>0
  ACT(a:FAC+3, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
Else
  ACT(a:FAC+3, 'Hasta: '~Dialogo.Fecha2)
Endif
SetFont(a:FAC..a:FAC+3, 2)
SetFont(a:FAC, 3)
SetFilaActual(FAC+3)
if Dialogo.Radio1=1
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'Totales x Cliente')
  SetFont(a:FAC, 2)
  if NoVacio(Dialogo.Cliente1)
    IFA
    ACT(a:FAC, 'Cliente: '~Dialogo.Cliente1)
    SetFont(a:FAC, 2)
  endif
endif
if Dialogo.Radio1=2
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'Totales x fecha de Fixing')
  SetFont(a:FAC, 2)
  if Dialogo.Fecha3>0
    IFA
    ACT(a:FAC, 'Fecha Fixing: '~Dialogo.Fecha3)
    SetFont(a:FAC, 2)
  endif
endif
if Dialogo.Radio1>0 y Dialogo.Check1=1
  IFA
  ACT(a:FAC, 'Con detalle de Operaciones')
  SetFont(a:FAC, 2)
endif
ifa
if NoVacio(Dialogo.Lista1)
  ACT(A:FAC, 'Fixing: '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(A:FAC, 'Fixing: Todos')
endif
SetFont(a:FAC, 2)

SetFilaActual(FAC+2)
if Dialogo.Radio1=0 o Dialogo.Check1=1
  ACT(a:FAC, 'Operacion')
  ACT(b:FAC, 'TipoOp')
  ACT(c:FAC, 'Cliente')
  ACT(d:FAC, 'FechaOp')
  ACT(e:FAC, 'FechaPrecan')
  ACT(f:FAC, 'FechaVto')
  ACT(g:FAC, 'Cantidad')
  ACT(h:FAC, 'PrecioOp')
  ACT(i:FAC, 'Res. del Periodo')
  SetFont(a:FAC..i:FAC, 2)
  AgregarMarco(a:FAC..i:FAC, 0, 0, Exe('COLOR'))

  ACN(w2, FAC+1)
  ACN(w3, FAC+1)

  SQL.ADD("Select NrOperacion, TipoOp,    Cliente1,  FechaOp,       Cantidad, ")
  SQL.ADD("       CB6,         Precio1,   PrecioEj,  ContraEspecie, FechaPrecan, ")
  SQL.ADD("       FechaVto,    TotalAux1, FechaEj,   ")
  SQL.ADD("       Case When CB6 = '1' Then FechaPrecan Else FechaVto End as FechaFixing ")
  SQL.ADD("  From "~DBO~".OPERACIONES ")
  SQL.ADD(" Where TipoOp   in  ('FXCF','FXVF') ")
  SQL.ADD("   and Vehiculo1 =  '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("   and NrOperacion in (Select NrOperacion from "~DBO~".MTMDIARIO ")
  SQL.ADD("                        where TipoMTM = 'MTM' ")
  SQL.ADD("                          and Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ) ")  
  *  SQL.ADD("   and NrOperacion in (Select NrOperacion from "~DBO~".MOVEJECUTADOS ")
  *SQL.ADD("                        where NrSaldo = 1 ")
  *SQL.ADD("                          and FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ) ")
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD(" and Cliente1 =  '"~Dialogo.Cliente1~"' ")
  endif
  if NoVacio(Dialogo.Lista1)
     SQL.ADD(" and ContraEspecie2 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
  endif
  if Dialogo.Fecha3>0
    SQL.ADD(" and ((IsNull(CB6,'0') = '1' and FechaPrecan='"~IdxDate(Dialogo.Fecha3)~"') or (IsNull(CB6,'0')='0' and FechaVto='"~IdxDate(Dialogo.Fecha3)~"')) ")
  endif
  if Dialogo.Radio1=0
    SQL.ADD(" Order By NrOperacion ")
  endif
  if Dialogo.Radio1=1
    SQL.ADD(" Order By Cliente1, NrOperacion ")
  endif
  if Dialogo.Radio1=2
    SQL.ADD(" Order By FechaFixing, NrOperacion ")
  endif
watch(SQL.Batch())

  recorrer SQL
    if Dialogo.Radio1=1
      if Not EqStr(fbn('Cliente1'),Val(v1))
        if FAC>Val(w2)
          SetFont(a:Val(w3)..u:FAC-1, 1)
          FormatoCeldas(g:Val(w3)..i:FAC-1, Exe('F2'))
          FormatoCeldas(h:Val(w3)..h:FAC-1, Exe('F9'))
          ACT(a:FAC, 'Total '~Val(v1))
          ACN(d:FAC, Val(x2))
          SetFont(a:FAC..d:FAC, 2)
          FormatoCeldas(d:FAC, Exe('F2'))
          AgregarMarco(a:FAC..d:FAC,0,0,Exe('COLOR8'))
          SetFilaActual(FAC+2)
        endif
        ACN(w3, FAC)
        ACT(v1, fbn('Cliente1'))
        ACN(x2, 0)
      endif
    endif
    if Dialogo.Radio1=2
      if fbn('FechaFixing')<>Val(v1)
        if FAC>Val(w2)
          SetFont(a:Val(w3)..u:FAC-1, 1)
          FormatoCeldas(g:Val(w3)..i:FAC-1, Exe('F2'))
          FormatoCeldas(h:Val(w3)..h:FAC-1, Exe('F9'))
          ACT(a:FAC, 'Total '~Fecha(Val(v1)))
          ACN(d:FAC, Val(x2))
          SetFont(a:FAC..d:FAC, 2)
          FormatoCeldas(d:FAC, Exe('F2'))
          AgregarMarco(a:FAC..d:FAC,0,0,Exe('COLOR8'))
          SetFilaActual(FAC+2)
        endif
        ACN(w3, FAC)
        ACD(v1, fbn('FechaFixing'))
        ACN(x2, 0)
      endif
    endif
    ACT(a:FAC, fbn('NrOperacion'))
    ACLO(a:FAC, fbn('NrOperacion'))
    ACT(b:FAC, fbn('TipoOp'))
    ACT(c:FAC, fbn('Cliente1'))
    ACD(d:FAC, fbn('FechaOp'))
    if fbn('CB6') = 1 Y fbn('FechaPrecan') >= Dialogo.Fecha1 Y fbn('FechaPrecan') <= Dialogo.Fecha2
      ACD(e:FAC, fbn('FechaPrecan'))
    endif
    ACD(f:FAC, fbn('FechaVto'))
    ACN(g:FAC, fbn('Cantidad'))
    ACN(h:FAC, fbn('Precio1'))
    *    ACN(i:FAC, SQL("Select Sum(Cantidad) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~Val(a:FAC)~"' and FechaMov Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'"))
    ACN(i:FAC, SQL("Select Sum(MTM) from "~DBO~".MTMDIARIO where NrOperacion = '"~Val(a:FAC)~"' and TipoMTM = 'MTM' and Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'"))    
    ACL(i:FAC, 'DETVIG', NrOperacion1 = Val(a:FAC), Vehiculo1 = Dialogo.Vehiculo1, Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2, Cantidad1 = Val(i:FAC), Radio1 = 2)
    SCN(x1, Val(i:FAC))
    SCN(x2, Val(i:FAC))
    ACN(k:FAC, fbn('CB6'))
    ACD(l:FAC, fbn('FechaFixing'))
  proximo
  if FAC>Val(w2)-1
    SetFont(a:Val(w3)..u:FAC, 1)
    FormatoCeldas(g:Val(w3)..i:FAC, Exe('F2'))
    FormatoCeldas(h:Val(w3)..h:FAC, Exe('F9'))
    if Dialogo.Radio1>0
      IFA
      ACT(a:FAC, 'Total '~Val(v1))
      ACN(d:FAC, Val(x2))
      SetFont(a:FAC..d:FAC, 2)
      FormatoCeldas(d:FAC, Exe('F2'))
      AgregarMarco(a:FAC..d:FAC,0,0,Exe('COLOR8'))
    endif
    SetFilaActual(FAC+2)
    ACT(a:FAC, 'Resultado del Perido')
    ACN(d:FAC, Val(x1))
    SetFont(a:FAC..d:FAC, 2)
    FormatoCeldas(d:FAC, Exe('F2'))
    AgregarMarco(a:FAC..d:FAC,0,0,Exe('COLOR6'))
  else
    SetFilaActual(FAC+2)
    ACT(c:FAC, 'NO HAY RESULTADOS EN EL PERIODO')
    SetFont(c:FAC, 2)
  endif

  ACO(1, 10)
  ACO(2, 8)
  ACO(3, 8)
  ACO(4, 8)
  ACO(5, 8)
  ACO(6, 8)
  ACO(7, 10)
  ACO(8, 9)
  ACO(9, 10)

  SetPrintFit(3,95)
else
  if Dialogo.Radio1=1
    ACT(a:FAC, 'Cliente')
    ACT(d:FAC, 'Res. del Periodo')
    SetFont(a:FAC..d:FAC, 2)
    AgregarMarco(a:FAC..d:FAC, 0, 0, Exe('COLOR'))
    ACN(w2, FAC+1)

    SQL.ADD("Select O.Cliente1, Sum(M.MTM) as SubTotal ")
    SQL.ADD("  From "~DBO~".MTMDIARIO M, "~DBO~".OPERACIONES O ")
    SQL.ADD(" where M.NrOperacion = O.NrOperacion ")
    SQL.ADD("   and M.TipoMTM = 'MTM' ")
    SQL.ADD("   and M.Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
    if NoVacio(Dialogo.Lista1)
       SQL.ADD(" and O.ContraEspecie2 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    endif
    SQL.ADD(" Group by O.Cliente1")
watch(SQL.Batch())
    recorrer SQL
      ACT(a:FAC, fbn('Cliente1'))
      ACN(d:FAC, fbn('SubTotal'))
      ACL(d:FAC, 'RESFUT', Radio2=Dialogo.Radio2, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Vehiculo1=Dialogo.Vehiculo1, Radio1 = Dialogo.Radio1, Check1=1, Cliente1=Val(a:FAC), Fecha3=0, Lista1=Dialogo.Lista1)
      SCN(x1, Val(d:FAC))
    proximo

    if FAC>Val(w2)-1
      SetFont(a:Val(w2)..u:FAC, 1)
      FormatoCeldas(d:Val(w2)..d:FAC, Exe('F2'))
      SetFilaActual(FAC+2)
      ACT(a:FAC, 'Total del Perido')
      ACN(d:FAC, Val(x1))
      SetFont(a:FAC..d:FAC, 2)
      FormatoCeldas(d:FAC, Exe('F2'))
      AgregarMarco(a:FAC..d:FAC,0,0,Exe('COLOR6'))
    else
      SetFilaActual(FAC+2)
      ACT(c:FAC, 'NO HAY RESULTADOS EN EL PERIODO')
      SetFont(c:FAC, 2)
    endif
  endif
  if Dialogo.Radio1=2
    ACT(a:FAC, 'Vencimiento')
    ACT(d:FAC, 'Res. del Periodo')
    SetFont(a:FAC..d:FAC, 2)
    AgregarMarco(a:FAC..d:FAC, 0, 0, Exe('COLOR'))

    SQL.ADD("Select NrOperacion, TipoOp,    Cliente1,  FechaOp,       Cantidad, ")
    SQL.ADD("       CB6,         Precio1,   PrecioEj,  ContraEspecie, FechaPrecan, ")
    SQL.ADD("       FechaVto,    TotalAux1, FechaEj,   ")
    SQL.ADD("       Case When CB6 = '1' Then FechaPrecan Else FechaVto End as FechaFixing ")
    SQL.ADD("  From "~DBO~".OPERACIONES ")
    SQL.ADD(" Where TipoOp    IN ('FXCF','FXVF') ")
    SQL.ADD("   and Vehiculo1 =  '"~Dialogo.Vehiculo1~"' ")
    if NoVacio(Dialogo.Lista1)
       SQL.ADD(" and ContraEspecie2 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    endif
    SQL.ADD("   and NrOperacion in (Select NrOperacion from "~DBO~".MTMDIARIO ")
    SQL.ADD("                        where TipoMTM = 'MTM' ")
    SQL.ADD("                          and Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ) ")
    SQL.ADD(" Order By FechaFixing, NrOperacion ")
    watch(SQL.Batch())
    recorrer SQL
      DFA
      if fbn('FechaFixing')<>Val(v1)
        if Val(w2)>0
          IFA
          ACT(a:FAC, Fecha(Val(v1)))
          ACN(d:FAC, Val(x2))
          ACL(d:FAC, 'RESFUT', Radio2=Dialogo.Radio2, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Vehiculo1=Dialogo.Vehiculo1, Radio1 = Dialogo.Radio1, Check1=1, Cliente1='', Fecha3=Val(v1), Lista1=Dialogo.Lista1)
          SetFont(a:FAC..d:FAC, 1)
          FormatoCeldas(d:FAC, Exe('F2'))
        endif
        ACN(w2, 1)
        ACD(v1, fbn('FechaFixing'))
        ACN(x2, 0)
      endif
      ACN(xy10,SQL("Select Sum(MTM) from "~DBO~".MTMDIARIO where NrOperacion = '"~fbn('NrOperacion')~"' and Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'"))
      SCN(x1, Val(xy10))
      SCN(x2, Val(xy10))
    proximo
    if FAC>Val(w2)-1
      IFA
      ACT(a:FAC, Val(v1))
      ACN(d:FAC, Val(x2))
      ACL(d:FAC, 'RESFUT', Radio2=Dialogo.Radio2, Fecha1=Dialogo.Fecha1, Fecha2=Dialogo.Fecha2, Vehiculo1=Dialogo.Vehiculo1, Radio1 = Dialogo.Radio1, Check1=1, Cliente1='', Fecha3=Val(v1), Lista1=Dialogo.Lista1)
      SetFont(a:FAC..d:FAC, 1)
      FormatoCeldas(d:FAC, Exe('F2'))
      SetFilaActual(FAC+2)
      ACT(a:FAC, 'Total del Perido')
      ACN(d:FAC, Val(x1))
      SetFont(a:FAC..d:FAC, 2)
      FormatoCeldas(d:FAC, Exe('F2'))
      AgregarMarco(a:FAC..d:FAC,0,0,Exe('COLOR6'))
    else
      SetFilaActual(FAC+2)
      ACT(c:FAC, 'NO HAY RESULTADOS EN EL PERIODO')
      SetFont(c:FAC, 2)
    endif
  endif

  ACO(1, 10)
  ACO(2, 8)
  ACO(3, 8)
  ACO(4, 10)
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe')
SetFont(a:FAC, 2)
LimitesVision(i:FAC)
