           ACN(z2,SQL("Select NrBit from "~DBO~".OPERACIONESBITS where NrOperacion ='"~FBN['NrOperacion']~"' and valor = '1' "))
           ACT(z3,SQL("Select Nombre from "~DBO~".INSTANCIAS where NrInstancia = "~val(z2)~" and Tabla = 'TRANSACCIONES2' "))
           ACN(h:fac,val(z2))
