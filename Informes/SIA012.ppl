  SQL.ADD(" Select  a.*  " )
  SQL.ADD("   from   "~DBO~".OPERACIONES a " )
  SQL.ADD(" where ")
  IF NoVacio(Dialogo.Lista2)
      SQL.ADD("     a.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista2)~") and ")
  endif
  SQL.ADD("     a.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"'  ")
  SQL.ADD("   and  a.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
  If NoVacio(Val(VH:3))
    SQL.ADD(" AND a.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  ELSE
  Endif
  SQL.ADD("order by a.NrOperacion ")


