ACN(z:5,0)

SQL.ADD("select T.TipoTr2, T.NrTrans, T.Cliente1, T.Especie, T.Cupon1, T.Fecha1, T.Mercado1, ")
sql.add(" T.Cantidad1, T.Especie1, T.Precio1, T.Cantidad2, T.Cantidad4, T.Cuenta6, ")
sql.add(" T.Cuenta2, T.Cliente2, T.Precio2, T.Cantidad5, T.Precio3, T.Cantidad6 ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where T.TipoTr2 IN ('CCUPON','PCUPON') ")
SQL.ADD(" AND B.NrOperacion = T.NrTrans ")
SQL.ADD(" AND B.NrBit <> 40 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD("  and  T.Fecha1 BETWEEN "~IdxDate2(Dialogo.Fecha3)~" and "~IdxDate2(Dialogo.Fecha4) )
SQL.ADD("  and  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
if NoVacio(Dialogo.Especie1)
 SQL.ADD("  and  T.Especie   = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
 SQL.ADD("  and  T.Cliente1  = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
 SQL.ADD("  and  T.Mercado1  = '"~Dialogo.Mercado1~"' ")
endif

recorrer SQL
 ACT(a:fac,iif(EqStr(fbn('TipoTr2'),'CCUPON'),'COMPRA','VENTA'))
