ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo1  : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   Cliente1   : "Entidad"      ;;;
   Especie1   : "Especie"      ;;;
   TipoOp1    : "Tipo Op."     ;;;
   Radio1     : "Valuacion|ARP|USD" ;;;;;;;;;0
   Fecha1     : "F.In.Desde"   ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Inicio Desde';NO;FSys
   Fecha2     : "F.In.Hasta"   ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Inicio Hasta';NO;FSys
   Fecha3     : "F.Vto.Desde"  ;;;;;;Dialogo.Fecha3<>0;'Debe Ingresar la Fecha Vto. Desde';NO;FSys
   Fecha4     : "F.Vto.Hasta"  ;;;;;;Dialogo.Fecha4<>0;'Debe Ingresar la Fecha Vto. Hasta';NO;FSys+365
FinDialogo

If Not Ok
   Cancelar
Endif

If Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Endif
Else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   Endif
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Informe de Operaciones de Comercio Exterior/Garantias")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

If NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
Else
  ACT(a:FAC+1, 'Vehiculo : Todos')
Endif
If NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
Else
  ACT(a:FAC+2, 'Entidad : Todos')
Endif
If NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
  ACT(a:FAC+3, 'Especie : Todos')
Endif
If NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+4, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
Else
  ACT(a:FAC+4, 'Tipo Op. : Todos')
Endif
ACT(a:fac+5, 'Valuacion  '~iif(Dialogo.Radio1=0,'ARP','USD'))
ACT(a:FAC+6, 'Fecha Inicio Desde: '~Dialogo.Fecha1)
ACT(a:FAC+7, 'Fecha Inicio Hasta: '~Dialogo.Fecha2)
ACT(a:FAC+8, 'Fecha Vto. Desde: '~Dialogo.Fecha3)
ACT(a:FAC+9, 'Fecha Vto. Hasta: '~Dialogo.Fecha4)
SetFont(a:fac..N:FAC+9,2)

SetFilaActual(FAC+11)
ACT(a:FAC, 'Numero Op.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'Caracteristica')
ACT(d:FAC, 'Empresa')
ACT(e:FAC, 'Monto')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'F.Concert.')
ACT(h:FAC, 'F.Inicio')
ACT(i:FAC, 'F.Vto.')
ACT(j:FAC, 'Plazo')
ACT(k:FAC, 'Costo(TNA)')
ACT(l:FAC, 'Costo(Flat)')
ACT(m:FAC, 'Costo($)')
ACT(n:FAC, 'Plaza')
ACT(o:FAC, 'Pais')
ACT(p:FAC, 'Beneficiario/Prov.')
ACT(q:FAC, 'Obra/Mercaderia')
ACT(r:FAC, 'Contravalor')
ACT(s:FAC, 'Entidad')

SetFont(a:fac..s:fac,2)
AgregarMarco(a:FAC..s:fac,2,0,Exe('COLOR'))

SetFilaActual(FAC)

SQL.ADD("SELECT O.* ")
SQL.ADD("FROM   "~DBO~".OPERACIONES  O ")
SQL.ADD("WHERE  O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("       and O.FechaEx2 between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("       and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Endif
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("       and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD("       and O.Especie = '"~Dialogo.Especie1~"'")
Endif
SQL.ADD("       and  (O.TipoOp Like 'CC%' or O.TipoOp Like 'GA%')")
If NoVacio(Dialogo.TipoOp1)
   SQL.ADD("       and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
Endif
SQL.ADD("ORDER BY O.Vehiculo1, O.FechaOp, O.NrOperacion ")

Recorrer SQL
   ACT(a:FAC, FBN['NrOperacion'])
   ACLO(a:FAC, FBN['NrOperacion'])
   ACT(b:FAC, FBN['TipoOp'])  
   
   If Incluido(val(b:fac),'CC|CCMV')
      ACT(c:fac, iif(fbn['RB7']=0,' ','Transfer.')~' '~iif(fbn['RB10']=0,' ','Confirm.')~' '~iif(fbn['RB9']=0,' ','Revocable'))
   Else 
      *- Garantias MO|FCC|CIA|FB|SBLC|CF|Otro
      If FBN['RB7']=0
         ACT(c:fac,'Mantenimiento de Oferta')
      EndIf
      If FBN['RB7']=1
         ACT(c:fac,'Fiel cumplimiento de contrato')
      EndIf
      If FBN['RB7']=2
         ACT(c:fac,'Correcta inversion de anticipo')
      EndIf
      If FBN['RB7']=3
         ACT(c:fac,'Fianza bancaria')
      EndIf
      If FBN['RB7']=4
         ACT(c:fac,'Stand by letter of credit')
      EndIf
      If FBN['RB7']=5
         ACT(c:fac,'Carta de fianza')
      EndIf
      If FBN['RB7']=6
         ACT(c:fac,'Otro')
      EndIf
   EndIf
   
   ACT(d:FAC, FBN['Vehiculo1'])
   ACN(e:FAC, FBN['Cantidad'])
   ACT(f:FAC, FBN['Especie'])
   ACD(g:FAC, FBN['FechaOp2'])
   ACD(h:FAC, FBN['FechaOp'])
   ACD(i:FAC, FBN['FechaEx2'])
   ACN(j:FAC, FBN['Plazo'])
   ACN(m:FAC, FBN['Precio4'])
   ACT(n:FAC, FBN['Plaza1'])
   ACT(o:FAC, FBN['Pais'])
   
   If Incluido(val(b:fac),'CC|CCMV')
      ACT(p:FAC, FBN['Observac2']) 
      ACT(q:FAC, FBN['Observac3'])
   Else 
      ACT(p:FAC, FBN['Observac3'])
      ACT(q:FAC, FBN['ObservacDoc'])
   EndIf
   
   ACN(r:fac,FBN['Cantidad']) 
    
   If Not EqStr(FBN['Especie'],VAR('MONEEXTR'))
      ACN(r:fac,val(r:fac)*(FBN['Cotizacion1']^IIf(EqStr(Modo(FBN['Especie'],VAR('MONEEXTR')),'DIR'),1,-1) ))
   EndIf
   
   If Dialogo.Radio1 = 0
      ACN(r:FAC, val(r:fac)*COTIZACIONC(VAR('MONEEXTR'),,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   EndIf
    
   *- Costo(flat)
   ACN(l:FAC, (val(m:fac)/val(r:fac))*100)
    
   *- Costo(TNA)
   ACN(k:FAC, (val(l:fac)/val(j:fac))*365)
    
   ACT(s:FAC, FBN['Cliente1']) 
   
   SetFont(a:FAC..s:fac,1)
   FormatoCeldas(j:fac..j:fac,"0")
   FormatoCeldas(e:fac..e:fac,Exe('F2'))
   FormatoCeldas(r:fac..r:fac,Exe('F2'))
Proximo

SetFilaActual(FAC+3)
ACT(a:FAC, 'Entidad')
ACT(b:FAC, 'Monto Total')
ACT(c:FAC, 'Porcentaje')
SetFont(a:fac..s:fac,2)
AgregarMarco(a:FAC..c:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select O.Cliente1, O.Especie, Cotizacion1, Sum(O.Cantidad) Cantidad ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and O.FechaEx2 between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
  else
   SQL.ADD(" and  (O.TipoOp Like 'CC%' or O.TipoOp Like 'GA%')")
endif
SQL.ADD("group by O.Cliente1, O.Especie,O.Cotizacion1 ")
SQL.ADD("order by O.Cliente1, O.Especie,O.Cotizacion1 ")

act(x1,' ')
acn(x2,0)
acn(x3,0)
acn(x4,fac)

Recorrer SQL

 if Not EqStr(val(x1),fbn['Cliente1'])
    act(x1,fbn['Cliente1'])
    act(a:fac,fbn['Cliente1'])
    scn(x2,1)
 else
    dfa    
 endif

 ACN(aa1,FBN['Cantidad'])

 If Not EqStr(FBN['Especie'],VAR('MONEEXTR'))
    ACN(aa1,val(aa1)*(FBN['Cotizacion1']^IIf(EqStr(Modo(FBN['Especie'],VAR('MONEEXTR')),'DIR'),1,-1) ))
 EndIf
 If Dialogo.Radio1 = 0
    ACN(aa1, val(aa1)*COTIZACIONC(VAR('MONEEXTR'),,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
 EndIf

 SCN(b:FAC, val(aa1))
 SetFont(a:FAC..s:fac,1)
Proximo

acn(x3,Sum(b:val(x4)+1..b:fac))

if val(x2) <> 0
   act(a:fac+1,'Total')
   acn(b:fac+1,val(x3))

   Recorrer&i 1, val(x2)
     acn(c:val(x4)+&i,val(b:val(x4)+&i)*100/val(x3))
     SetFont(c:val(x4)+&i..c:val(x4)+&i,1)
   Proximo
   acn(c:fac+1,Sum(c:val(x4)..c:fac))
   SetFont(a:FAC+1..s:fac+1,2)
   AgregarMarco(a:FAC+1..c:FAC+1,2,0)
   GraficarCeldas(e:val(x4)+1..j:val(x4)+11, Torta|c3d|legend,,,,,,,a:val(x4)+1..a:val(x4)+val(x2),c:val(x4)+1..c:val(x4)+val(x2))
endif


SetFilaActual(FAC+5)

ACO(1,8)
ACO(2,8)
ACO(3,15)
ACO(4,8)
ACO(5,12)
ACO(6,8)
ACO(7,7)
ACO(8,7)
ACO(9,7)
ACO(10,7)
ACO(11,8)
ACO(12,8)
ACO(13,8)
ACO(14,15)
ACO(15,8)
ACO(16,15)
ACO(17,15)
ACO(18,12)
ACO(19,8)

Impresion(1,2)
SetFilaActual(FAC+5)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(s:fac)
*RangoTitulo(a1..k:8,36)
RangoTitulo(a1..s:fac,15)
