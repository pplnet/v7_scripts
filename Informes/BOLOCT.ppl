HojaVisible(NO)
CrearDialogo
  Radio1      : 'Por|Fecha|Boleto'  ;;;;;;;;;0;
  Fecha1      : 'Desde'             ;2;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;Fsys;
  Fecha2      : 'Hasta'             ;3;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1=1 O Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Cliente1    : 'Agente'            ;4;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;;;;;;;;;" NrMAE Is Not Null AND NrMAE <> 0 ";
  Entero1     : 'D.Boleto'          ;2;1;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 O Dialogo.Entero1 > 0;'Boleto Desde Invalido';NO;;;;;'########';
  Entero2     : 'H.Boleto'          ;3;1;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 O Dialogo.Entero2 >= Dialogo.Entero1;'Boleto Hasta Invalido';NO;;;;;'########';
  Vehiculo1   : 'Vehiculo'          ;6;1;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Check1      : 'Por Impresora'     ;;;;;;;;;0;
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, "Arial,6,")
CrearFont(2, "Arial,8,B")
CrearFont(4, "Arial,5,")
CrearFont(5, "Arial,8,")
CrearFont(6, "Arial,9,B")
CrearFont(7, "Arial,11,B")

ACT(VH:1, Dialogo.Vehiculo1)

ACN(BD:1, 0)
SQL.ADD(" Select Cliente, Descripcion ")
SQL.ADD(" From "~DBO~".VEHICULOS ")
SQL.ADD(" Where Codigo = '"~Val(VH:1)~"' ")
Recorrer SQL
    ACT(CL:1, fbn('Cliente'))
    ACT(DS:1, fbn('Descripcion'))
Proximo

SQL.ADD(" Select O.NrOperacion, O.TipoOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS OB  ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion AND OB.NrBit = 30 AND OB.Valor <> '1' ")
IF Dialogo.Radio1 = 0
    SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
    IF NoVacio(Dialogo.Cliente1)
        SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
    ENDIF
ELSE
    SQL.ADD(" AND O.NrBoleto >= '"~Pad0(Fstr(Dialogo.Entero1, 0, 0), 8)~"' ")
    SQL.ADD(" AND O.NrBoleto <= '"~Pad0(Fstr(Dialogo.Entero2, 0, 0), 8)~"' ")
ENDIF
SQL.ADD(" AND O.TipoOp IN ('FXOCTC','FXOCTV') ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Recorrer SQL
    ACN(BD:1, 1)
    LinkearHoja('BOLOC2', 1, NrOperacion1=fbn('NrOperacion'), Cliente1=Val(CL:1), String1=Val(DS:1), TipoOp1=fbn('TipoOp'), Vehiculo1=Val(VH:1),Check1=Dialogo.Check1)
Proximo

IF Val(BD:1) = 0
    Cancelar('No Hay Boletos que Concuerden con los Datos Solicitados')
ENDIF