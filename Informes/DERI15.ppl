ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : "Especie"      ;;;;;;NoVacio(Dialogo.Especie1);'Debe Ingresar una Especie';NO;
  TipoOp1    : "Tipo Op."     ;;;
  Fecha1     : "F.Ejer.Desde" ;;;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Fecha2     : "F.Ejer.Hasta" ;;;;;;Dialogo.Fecha2<>0;'Fecha Incorrecta';NO;Fsys
FinDialogo
if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Fecha de Ejercicio de las Opciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Extendido','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+2, 'Especie : Todos')
endif
if NoVacio(Dialogo.TipoOp1)
  ACT(a:FAC+3, 'Tipo Op. : '~Dialogo.TipoOp1~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',Dialogo.TipoOp1))
else
  ACT(a:FAC+3, 'Tipo Op. : Todos')
endif
ACT(a:FAC+4, 'Fecha Ejercicio Desde : '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Ejercicio Hasta : '~Dialogo.Fecha2)
SetFont(a:fac..N:FAC+5,2)

SetFilaActual(FAC+7)

ACT(a:FAC, 'Opciones Compradas')
SetFont(a:fac..l:FAC,2)
ifa
ACT(a:FAC, 'F.Ejer.')
ACT(b:FAC, 'Contraparte')
ACT(c:FAC, 'Tipo Operacion')
ACT(d:FAC, 'Tipo Opcion')
ACT(e:FAC, 'Euro/Amer')
ACT(f:FAC, 'F.Inicio')
ACT(g:FAC, 'F.Final')
ACT(h:FAC, 'Volumen')
ACT(i:FAC, 'Vol.Total')
ACT(j:FAC, 'Un.M.')
ACT(k:FAC, 'Strike')
ACT(l:FAC, 'NrOperacion')

SetFont(a:fac..l:FAC,2)
AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR'))


SQL.ADD("Select FechaPrecan, Cliente1, TipoOp, MB1, MB3,  FechaOp2, FechaEj, Cantidad, PrecioEj, NrOperacion, TipoOpcion, UMedida, TotalAux2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaPrecan between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  O.TipoOp ='DPSN' and O.MB3='0' and (CB8='0' or CB8 IS NULL) ")
if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif
SQL.ADD("order by O.FechaPrecan ")

Recorrer SQL

  ACD(a:FAC, fbn['FechaPrecan'])
  act(b:fac, fbn['Cliente1'])
  act(c:fac, BuscarCampo('TiposOperacion','Nombre','Codigo',fbn['TipoOp']))

  if Incluido(fbn['TipoOp'],'DPDSS')
     if EqStr(fbn('MB1'),'1')
        act(d:fac,'Comsumer Swaption')
       else    
        act(d:fac,'Producer Swaption')
     endif
    else
     if EqStr(fbn('MB1'),'1')
        act(d:fac,'Producer')
       else    
        act(d:fac,'Consumer')
     endif
  endif

  if EqStr(Fbn['TipoOpcion'],'0')
     act(e:fac,'Europea')
    else
     if EqStr(fbn['TipoOpcion'],'1')
        act(e:fac,'Americana')
     endif
  endif

  acd(f:fac,fbn['FechaOp2'])
  acd(g:fac,fbn['FechaEj'])
  acn(h:fac,fbn['Cantidad'])
  acn(i:fac,fbn['TotalAux2'])
  act(j:fac,fbn['UMedida'])
  acn(k:fac,fbn['PrecioEj'])
  act(l:fac,fbn['NrOperacion'])
  aclo(l:fac,fbn['NrOperacion'])
  SetFont(a:FAC..r:FAC,1)
  FormatoCeldas(h:fac..i:fac,Exe('F0'))
  FormatoCeldas(k:fac..k:fac,Exe('F4'))
Proximo

SetFilaActual(fac+2)
ACT(a:FAC, 'Opciones Vendidas')
SetFont(a:fac..j:FAC,2)
ifa
ACT(a:FAC, 'F.Ejer.')
ACT(b:FAC, 'Contraparte')
ACT(c:FAC, 'Tipo Operacion')
ACT(d:FAC, 'Tipo Opcion')
ACT(e:FAC, 'Euro/Amer')
ACT(f:FAC, 'F.Inicio')
ACT(g:FAC, 'F.Final')
ACT(h:FAC, 'Volumen')
ACT(i:FAC, 'Vol.Total')
ACT(j:FAC, 'Un.M.')
ACT(k:FAC, 'Strike')
ACT(l:FAC, 'NrOperacion')

SetFont(a:fac..l:FAC,2)
AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select FechaPrecan, Cliente1, TipoOp, MB1, MB3,  FechaOp2, FechaEj, Cantidad, PrecioEj, NrOperacion, TipoOpcion, UMedida, TotalAux2 ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.FechaPrecan between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")

if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif

SQL.ADD(" and  (O.TipoOp In ('DPDSS') ")
SQL.ADD(" or (O.TipoOp In ('DPSN') and ")
SQL.ADD(" (CB8='0' or CB8 IS NULL))) and (O.MB3<>'0' or O.MB3 is Null) ")

if NoVacio(Dialogo.TipoOp1)
   SQL.ADD(" and  O.TipoOp = '"~Dialogo.TipoOp1~"' ")
endif

SQL.ADD("order by O.FechaPrecan ")

Recorrer SQL
  ACD(a:FAC, fbn['FechaPrecan'])
  act(b:fac, fbn['Cliente1'])
  act(c:fac, BuscarCampo('TiposOperacion','Nombre','Codigo',fbn['TipoOp']))
  if Incluido(fbn['TipoOp'],'DPDSS')
     if EqStr(fbn('MB1'),'1')
        act(d:fac,'Comsumer Swaption')
       else    
        act(d:fac,'Producer Swaption')
     endif
    else
     if EqStr(fbn('MB1'),'1')
        act(d:fac,'Producer')
       else    
        act(d:fac,'Consumer')
     endif
  endif
  if EqStr(fbn['TipoOpcion'],'0')
     act(e:fac,'Europea')
    else
     if EqStr(fbn['TipoOpcion'],'1')
        act(e:fac,'Americana')
     endif
  endif

  acd(f:fac,fbn['FechaOp2'])
  acd(g:fac,fbn['FechaEj'])
  acn(h:fac,fbn['Cantidad'])
  acn(i:fac,fbn['TotalAux2'])
  act(j:fac,fbn['UMedida'])
  acn(k:fac,fbn['PrecioEj'])
  act(l:fac,fbn['NrOperacion'])
  aclo(l:fac,fbn['NrOperacion'])
  SetFont(a:FAC..r:FAC,1)
  FormatoCeldas(h:fac..i:fac,Exe('F0'))
  FormatoCeldas(k:fac..k:fac,Exe('F4'))
proximo

ACO(1,6)
ACO(2,12)
ACO(3,18)
ACO(4,12)
ACO(5,6)
ACO(6,6)
ACO(7,6)
ACO(8,10)
ACO(9,10)
ACO(10,4)
ACO(11,6)
ACO(12,8)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(m:FAC)
*RangoTitulo(a1..k:8,36)

