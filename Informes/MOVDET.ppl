*ModoReproceso(ConDialogo)
CrearDialogo
  Radio1      : '|x Fecha|x Trans.|x Cliente';1;1;;;;;;;1;
  Fecha1      : 'F.Desde'         ;2;1;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1<>0 o Dialogo.Fecha1>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2      : 'F.Hasta'         ;2;2;;Dialogo.Radio1=0;Dialogo.Radio1=0;Dialogo.Radio1<>0 o [Dialogo.Fecha2>0 y Dialogo.Fecha2>=Dialogo.Fecha1];'Debe Ingresar la Fecha Hasta';NO;FSys
  NrTrans1: '#Tr.Desde'           ;2;1;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1<>1 o NoVacio(Dialogo.NrTrans1);'Debe Ingresar una operacion Desde';NO;
  NrTrans2: '#TR.Hasta'           ;2;2;;Dialogo.Radio1=1;Dialogo.Radio1=1;
  Cliente1    : 'Cliente'         ;2;1;;Dialogo.Radio1=2;Dialogo.Radio1=2;Dialogo.Radio1<>2 o NoVacio(Dialogo.Cliente1);'Debe Ingresar un Cliente';NO;
  Vehiculo1   : 'Vehiculo'        ;3;1;
  Radio2      : 'Tipo|Todos|Pmos' ;4;1;;;;;;;1;
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Movimientos Devengados por Transaccion")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if Dialogo.Radio1=0
  ACT(a:FAC+2, 'Fecha Desde: '~Dialogo.Fecha1)
  ACT(a:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)
else
  if Dialogo.Radio1=1
    if Vacio(Dialogo.NrTrans2)
      ACT(a:FAC+2, 'Operacion: '~Dialogo.NrTrans1)
    else
      ACT(a:FAC+2, 'Operacion Desde: '~Dialogo.NrTrans1)
      ACT(a:FAC+3, 'Operacion Hasta: '~Dialogo.NrTrans2)
    endif
  else
    ACT(a:FAC+2, 'Cliente: '~Dialogo.Cliente1)
  endif
endif

SetFilaActual(FAC+5)

ACT(a:FAC, 'Tipo Tr.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'F.Transaccion')
ACT(d:FAC, 'F.Vto.')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
*ACT(g:FAC, 'Cantidad')
*ACT(h:FAC, 'Precio / Tasa N.A.')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')

ACT(b:FAC+1, 'Tipo Dev.')
ACT(c:FAC+1, 'Nr.Saldo')
ACT(d:FAC+1, 'Fecha')
ACT(e:FAC+1, 'Especie Afectada')
ACT(f:FAC+1, 'Monto Afectado')
ACT(g:FAC+1, 'Cliente')
ACT(h:FAC+1, 'Book')
ACT(i:FAC+1, 'EspecieRef')
ACT(j:FAC+1, 'Cuota')

AlinearCeldas(b:FAC+1..i:FAC+1,'I')
AlinearCeldas(c:FAC+1..d:FAC+1,'D')
AlinearCeldas(f:FAC+1..f:FAC+1,'D')
SetFont(a:Val(w1)..N:FAC+1,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
AgregarMarco(b:FAC+1..j:FAC+1,2,0,Exe('COLOR6'))

SetFilaActual(FAC+1)

SQL.ADD("SELECT O.TipoTr2 TipoOp, M.NrOperacion, O.Fecha1 FechaOp, O.Fecha1 FechaVto, O.Cliente1, ")
SQL.ADD("       O.Especie      , 0 Cantidad   , 0 Precio1   , O.Vehiculo1  , M.NrOperacion, ")
SQL.ADD("       M.TipoDevengado, M.NrSaldo    , M.Fecha     , M.Especie Esp, M.Monto, ")
SQL.ADD("       M.Cliente      , M.Book       , M.EspecieRef, M.Cupon ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 O, "~DBO~".MOVDEVENGADOS M ")
SQL.ADD("where O.NrTrans = M.NrOperacion ")
if Dialogo.Radio1=0
  SQL.ADD("and O.Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
else
  if Dialogo.Radio1=1
    if Vacio(Dialogo.NrTrans2)
      SQL.ADD("and O.NrTrans = '"~Dialogo.NrTrans1~"' ")
    else
      SQL.ADD("and O.NrTrans Between '"~Dialogo.NrTrans1~"' and '"~Dialogo.NrTrans2~"' ")
    endif
  else
    SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
  endif
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
endif
SQL.ADD(" and O.TipoTr2 = 'INTCCA' ")
SQL.ADD(" and O.RB10    = '0' ")
SQL.ADD("order by 2, 11, 12, 17, 13")

Recorrer SQL
  if Not EqStr(FBN['NrOperacion'], Val(z1))
    ifa
    ACT(z1, FBN['NrOperacion'])
    ACT(a:FAC, FBN['TipoOp'])
    ACT(b:FAC, FBN['NrOperacion'])
    ACD(c:FAC, FBN['FechaOp'])
    ACD(d:FAC, FBN['FechaVto'])
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
    ACT(f:FAC, FBN['Especie'])
    ACN(g:FAC, FBN['Cantidad'])
    ACN(h:FAC, FBN['Precio1'])
    SetFont(a:FAC..h:FAC,2)
    AlinearCeldas(a:FAC..b:FAC,'I')
    AlinearCeldas(c:FAC..d:FAC,'D')
    AlinearCeldas(e:FAC..f:FAC,'I')
    AlinearCeldas(g:FAC..h:FAC,'D')
    ifa
  endif
  ACT(b:FAC, FBN['TipoDevengado'])
  ACN(c:FAC, FBN['NrSaldo'])
  ACD(d:FAC, FBN['Fecha'])
  ACT(e:FAC, FBN['Esp'])
  ACN(f:FAC, FBN['Monto'])
  ACT(g:FAC, FBN['Cliente'])
  ACT(h:FAC, FBN['Book'])
  ACT(i:FAC, FBN['EspecieRef'])
  ACT(j:FAC, FBN['Cupon'])
  SetFont(a:FAC..l:FAC,1)
proximo

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,18)
ACO(6,10)
ACO(7,10)
ACO(8,10)
ACO(9,8)
ACO(10,5)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe.')
ACT(a:fac+1, USUARIOACTIVO)
SetFont(a:FAC, 2)
LimitesVision(I:FAC+1)
RangoTitulo(a:1..i:FAC, Val(w1)+3)
