Recorrer SQL
 If DesciendeDeEspecie(fbn('Especie'), 'MONEDA')
   IF NOT Eqstr(fbn('Cuenta'), Val(ca:1)) o NOT Eqstr(fbn('Especie'), Val(ea:1)) o NOT Eqstr(fbn('Mercado'), Val(ma:1)) o NOT Eqstr(fbn('EnteCustodia'), Val(ec:1)) o NOT Eqstr(fbn('Cupon'), Val(cu:1))
      IF Val(z:1)<>0
         ACT(a:fac, 'Total Pendiente ...' )
         ACN(E:fac, Val(TP:1))
         ifa
         ACT(a:fac, 'Total Ejecutado ...' )
         ACN(E:fac, Val(TE:1))
         ifa
         ACT(a:fac, 'Total Cuenta ...' )
         ACN(e:fac, Val(TE:1) + Val(TP:1) + Val(SU:1))
         SetFont(a:fac-2..z:fac,4)
         Formatoceldas(e:fac-2..E:fac, EXE('F2'))
         AgregarMarco(a:fac-2..f:fac,1,1,0)
         ACN(TE:1, 0)
         ACN(TP:1, 0)
         ifa
      ENDIF
      ACN(z:1,1)
      ifa
      ACT(a:fac,'Banco: '~fbn('EnteCustodia')~' - Cuenta: '~fbn('Cuenta')~' '~fbn('Numero'))
      ACT(a:fac,Val(a:fac)~' - Moneda: '~ fbn('Nombre'))
      ACN(SU:1, SaldoC(Dialogo.Vehiculo1, fbn('Especie'),,,,,,fbn('Cuenta') ,1,Dialogo.Fecha1-1,fbn('Cupon')))
      ACT(E:fac, 'Saldo Inicial: '~Fstr(Val(SU:1), 0, 2))
      SetFont(a:fac..z:fac,2)
      AgregarMarco(a:fac..f:fac,1,1,EXE('COLOR6'))
      ifa
      ACN(fi:1,fac)
      ACT(ca:1,fbn('Cuenta'))
      ACT(cu:1,fbn('Cupon'))
      ACT(ea:1,fbn('Especie'))
      ACT(ma:1,fbn('Mercado'))
      ACT(ec:1,fbn('EnteCustodia'))
   ENDIF
   ACD(a:fac, fbn('FechaMov'))
   ACT(b:fac, fbn('Concepto'))
   ACT(c:fac, fbn('NrOperacion'))
   IF Eqstr(fbn('Tipo'), 'O')
      ACLO(c:fac, fbn('NrOperacion'))
   ENDIF
   IF Eqstr(fbn('Tipo'), 'T')
      ACLT(c:fac, fbn('NrOperacion'))
   ENDIF
   IF Eqstr(fbn('Tipo'), 'F')
      ACLF(c:fac, fbn('NrOperacion'))
   ENDIF
   ACT(d:fac, fbn('Leyenda'))
   ACN(e:fac, fbn('Cantidad'))
   ACT(f:fac, fbn('Estado'))
   IF Eqstr(fbn('Estado'), 'Pendiente')
      SCN(TP:1, fbn('Cantidad'))
      ColorCeldas(f:fac,clBlue)
   ELSE
      SCN(TE:1, fbn('Cantidad'))
      ColorCeldas(f:fac,clGreen)
   ENDIF

   SetFont(a:fac..z:fac,1)
   Formatoceldas(e:fac, EXE('F2'))
 Else
   dfa
 Endif
Proximo

ifa

ACT(a:fac, 'Total Pendiente ...' )
ACN(E:fac, Val(TP:1))
ifa
ACT(a:fac, 'Total Ejecutado ...' )
ACN(E:fac, Val(TE:1))
ifa

ACT(a:fac, 'Total Cuenta ...' )
ACN(e:fac, Val(TE:1) + Val(TP:1) + Val(SU:1))
SetFont(a:fac-2..z:fac,4)
Formatoceldas(e:fac-2..E:fac, EXE('F2'))
AgregarMarco(a:fac-2..f:fac,1,1,0)

ifa
ifa

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac,2)

ACO(1,10)
ACO(2,10)
ACO(4,20)
ACO(5,10)

LimitesVision(g:fac+2)
SetMargins(0,0,0,2)
