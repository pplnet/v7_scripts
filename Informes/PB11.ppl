    SQL.ADD(" SELECT M.FechaMov, M.Concepto, M.Cantidad*(-1) Cantidad, M.Cuenta, M.Mercado, M.Especie, M.Leyenda, ")
    SQL.ADD(" C.Numero, E.Nombre, 'Pendiente' Estado, M.NrOperacion, T.Nombre Descripcion, M.EnteCustodia, 'O' Tipo, M.Cupon  ")
