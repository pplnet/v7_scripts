ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  :'Fecha'  ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys
  Book1   :'Book'   ;;;;;;;;;UsuarioActivo
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, 'Volumen Operado en el Dia')
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1)
if NoVacio(Dialogo.Book1)
   ACT(a:FAC+2, 'Book: '~Dialogo.Book1)
  else
   ACT(a:FAC+2, 'Book: Todos')
endif

ACT(a:FAC+4, 'Especie')
ACT(b:FAC+4, 'Compra Contado')
ACT(c:FAC+4, 'Precio Pro.')
ACT(d:FAC+4, 'Venta Contado')
ACT(e:FAC+4, 'Precio Pro.')
ACT(f:FAC+4, 'Neto Contado')
ACT(g:FAC+4, 'Compra Futuro')
ACT(h:FAC+4, 'Precio Pro.')
ACT(i:FAC+4, 'Venta Futuro')
ACT(j:FAC+4, 'Precio Pro.')
ACT(k:FAC+4, 'Neto Futuro')

AlinearCeldas(a:FAC+4..a:FAC+4,'I')
AlinearCeldas(b:FAC+4..k:FAC+4,'D')
SetFont(a:FAC..k:FAC+4,2)
AgregarMarco(a:FAC+4..k:FAC+4,2,0,Exe('COLOR'))

SetFilaActual(FAC+4)
ACN(z1,0)

if NoVacio(Dialogo.Book1)
   ACT(x1, " and Book1='"~Dialogo.Book1~"'")
endif

SQL.ADD("Select * From "~DBO~".OPERACIONES where")
SQL.ADD("FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and TipoOp in "~Var('ECOMVTA')~Val(x1))
SQL.ADD("order by Especie, FechaEj, PrecioEj")

recorrer SQL
  DFA
  if Not EqStr(FBN['Especie'], Val(z9)) o FBN['FechaEj']<>Val(z10) o FBN['PrecioEj']<>Val(z11)
     if Val(z1) > 0
        ACN(c:FAC, Val(c:FAC)/Val(b:FAC))
        ACN(e:FAC, Val(e:FAC)/Val(d:FAC))
        ACN(f:FAC, Val(b:FAC)-Val(d:FAC))
        ACN(h:FAC, Val(h:FAC)/Val(g:FAC))
        ACN(j:FAC, Val(j:FAC)/Val(i:FAC))
        ACN(k:FAC, Val(g:FAC)-Val(i:FAC))
     endif
     IFA
     ACT(a:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
     ACT(Z9,FBN['Especie'])
     ACD(Z10,FBN['FechaEj'])
     ACN(Z11,FBN['PrecioEj'])
     ACN(z1,1)
  endif
  if Incluido(FBN['TipoOp'],'CTE|CCE|CPE')
      SCN(b:FAC, FBN['Cantidad'])
      SCN(c:FAC, FBN['Cantidad']*FBN['Precio1'])
  endif
  if Incluido(FBN['TipoOp'],'VTE|VCE|VPE')
      SCN(d:FAC, FBN['Cantidad'])
      SCN(e:FAC, FBN['Cantidad']*FBN['Precio1'])
  endif
  if Incluido(FBN['TipoOp'],'CFTE')
      SCN(g:FAC, FBN['Cantidad'])
      SCN(h:FAC, FBN['Cantidad']*FBN['Precio1'])
  endif
  if Incluido(FBN['TipoOp'],'VFTE')
      SCN(i:FAC, FBN['Cantidad'])
      SCN(j:FAC, FBN['Cantidad']*FBN['Precio1'])
  endif
proximo

if Val(z1) > 0
   ACN(c:FAC, Val(c:FAC)/Val(b:FAC))
   ACN(e:FAC, Val(e:FAC)/Val(d:FAC))
   ACN(f:FAC, Val(b:FAC)-Val(d:FAC))
   ACN(h:FAC, Val(h:FAC)/Val(g:FAC))
   ACN(j:FAC, Val(j:FAC)/Val(i:FAC))
   ACN(k:FAC, Val(g:FAC)-Val(i:FAC))
endif

FormatoCeldas(b:Val(w1)+4..b:FAC,Exe('F2'))
FormatoCeldas(d:Val(w1)+4..d:FAC,Exe('F2'))
FormatoCeldas(f:Val(w1)+4..f:FAC,Exe('F2'))
FormatoCeldas(g:Val(w1)+4..g:FAC,Exe('F2'))
FormatoCeldas(i:Val(w1)+4..i:FAC,Exe('F2'))
FormatoCeldas(k:Val(w1)+4..k:FAC,Exe('F2'))
FormatoCeldas(c:Val(w1)+4..c:FAC,Exe('F6'))
FormatoCeldas(e:Val(w1)+4..e:FAC,Exe('F6'))
FormatoCeldas(h:Val(w1)+4..h:FAC,Exe('F6'))
FormatoCeldas(j:Val(w1)+4..j:FAC,Exe('F6'))
AgregarMarco(a:Val(w1)+4..a:FAC, 1)
AgregarMarco(b:Val(w1)+4..c:FAC, 1)
AgregarMarco(d:Val(w1)+4..e:FAC, 1)
AgregarMarco(f:Val(w1)+4..f:FAC, 1)
AgregarMarco(g:Val(w1)+4..h:FAC, 1)
AgregarMarco(i:Val(w1)+4..j:FAC, 1)
AgregarMarco(k:Val(w1)+4..k:FAC, 1)
SetFont(a:Val(w1)+4..k:FAC,1)

ACO(1,10)
ACO(2,9)
ACO(3,7)
ACO(4,9)
ACO(5,7)
ACO(6,10)
ACO(7,9)
ACO(8,7)
ACO(9,9)
ACO(10,7)
ACO(11,10)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)
RangoTitulo(a:1..k:FAC, Val(w1)+3)

