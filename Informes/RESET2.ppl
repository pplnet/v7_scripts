*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1: 'Fecha'  ;;;;;;Dialogo.Fecha1<=Fsys;'Fecha No debe ser superior a la Fecha del Sistema';NO;FSys
  Check1: 'Procesa';;;;NO;;;;;0;
FinDialogo
If not Ok
   Cancelar
Endif

if Dialogo.Check1=0
  HojaVisible(SI)
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

ACT(y1, 'Fin de Mes')
ACT(y2, 'OK')
ACT(y4, 'Mes Inicio')
ACT(y5, 'Mes Cierre')

* Fin de mes del mes actual
ACD(z:1, FinDeMes(Dialogo.Fecha1,NO,'ARG'))

ACT(z:2, 'SI')
if Val(z:1)<>Dialogo.Fecha1
  MessageBox('La fecha indicada no es fin de mes')
  ACT(z:2, 'NO')
endif

IF EqStr(Val(z:2),'SI')
  ACN(z:4, 0)
  ACN(z:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
  if Val(z:4)=0
    ACN(z:5, 12)
  else
    ACN(z:5, VAR('MESINIEJE')-1)
  endif
  if Val(z:5)<1 or Val(z:5)>12
    ACN(z:5, 12)
  endif
  if Mes(Dialogo.Fecha1)<>Val(z:5)
    MessageBox('La fecha indicada no es fin de Ejercicio')
    ACT(z:2, 'NO')
  endif
endif

if EqStr(Val(z:2),'NO')
   Cancelar('No es posible Resetear Posicion en esta Fecha: '~Dialogo.Fecha1)
endif

*****************************
** RESET de Precio en FX FWD
*****************************
SetFilaActual(1)
ACT(a:FAC, 'TipoOp')
ACT(b:FAC, 'NrOperacion')
ACT(c:FAC, 'Vehiculo')
ACT(d:FAC, 'Book1')
ACT(e:FAC, 'Cliente1')
ACT(f:FAC, 'FechaOp')
ACT(g:FAC, 'Plazo')
ACT(h:FAC, 'FechaVto')
ACT(i:FAC, 'Especie')
ACT(j:FAC, 'Cantidad')
ACT(k:FAC, 'ContraEspecie')
ACT(l:FAC, 'TotalBrutoCli1')
ACT(m:FAC, 'Precio1')
ACT(n:FAC, 'PrecioRef')
ACT(o:FAC, 'PrecioRef4')
ACT(p:FAC, 'Cot.Spot')
ACT(q:FAC, 'FD PrRef')
ACT(r:FAC, 'FD PrRef4')
ACT(s:FAC, 'Pre.Hoy')
ACT(t:FAC, 'Max F.PrRef')
ACT(u:FAC, 'Max F.PrRef4')
SetFont(a:FAC..x:FAC, 2)

SQL.ADD("Select O.FechaVto, O.TipoOp,         O.NrOperacion, O.Vehiculo1,  ")
SQL.ADD("       O.Cliente1, O.Cantidad,       O.Plazo,       O.Especie,    ")
SQL.ADD("       O.FechaOp,  O.ContraEspecie,  O.PrecioRef,   O.PrecioRef4, ")
SQL.ADD("       O.Precio1,  O.TotalBrutoCli1, O.Book1 ")
SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.TipoOp In ('FXCT','FXVT') ")
SQL.ADD("   and O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" order by FechaVto,Cliente1,Precio1 ")
recorrer SQL
  ACT(a:FAC, fbn('TipoOp'))
  ACT(b:FAC, fbn('NrOperacion'))
  ACT(c:FAC, fbn('Vehiculo1'))
  ACT(d:FAC, fbn('Book1'))
  ACT(e:FAC, fbn('Cliente1'))
  ACD(f:FAC, fbn('FechaOp'))
  ACN(g:FAC, fbn('Plazo'))
  ACD(h:FAC, fbn('FechaVto'))
  ACT(i:FAC, fbn('Especie'))
  ACN(j:FAC, fbn('Cantidad'))
  ACT(k:FAC, fbn('ContraEspecie'))
  ACN(l:FAC, fbn('TotalBrutoCli1'))
  ACN(m:FAC, fbn('Precio1'))
  ACT(n:FAC, fbn('PrecioRef'))
  ACT(o:FAC, fbn('PrecioRef4'))
  * Cotizacion Spot
  ACN(p:FAC, CotizacionC(FBN['Especie'],,,, Dialogo.Fecha1, 1, SI,FBN['ContraEspecie']))


  ACD(t:FAC, Dialogo.Fecha1)
  SQL.ADD("Select Max(TD1.Fecha) AS Max ")
  SQL.ADD("  from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 ")
  SQL.ADD(" Where TD1.TipoTasa  =  TT1.Codigo ")
  SQL.ADD("   and TT1.PrecioRef =  '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("   AND TD1.Fecha     <= '"~IdxDate(Dialogo.Fecha1)~"' ")
  Recorrer SQL
    dfa
    * ae: compras / al: ventas
    ACD(t:FAC, FBN['Max'])
  Proximo

  * af: compras / am: ventas
  ACD(u:FAC, Dialogo.Fecha1)
  SQL.ADD("Select Max(TD1.Fecha) AS Max ")
  SQL.ADD("  from "~DBO~".TASASDIA TD1, "~DBO~".TIPOSTASA TT1 ")
  SQL.ADD(" Where TD1.TipoTasa  =  TT1.Codigo ")
  SQL.ADD("   and TT1.PrecioRef =  '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("   AND TD1.Fecha     <= '"~IdxDate(Dialogo.Fecha1)~"' ")
  Recorrer SQL
    dfa
    * af: compras / am: ventas
    ACD(u:FAC, FBN['Max'])
  Proximo

  ACD(fe:1, Dialogo.Fecha1)
  *- Obtiene los FD(t,Tj-t) en fd1  y tasa implicita en ti1  
  ACD(fe:2,FBN['FechaVto'])
  *- fe3 es el plazo a interpolar 
  ***---Se lo divide por 365 y multiplica por 360 para expresarlo en 360 como el plazohasta
  ***---de tasasdia
  ACN(fe:3, (val(fe:2)-val(fe:1)) / 365 * 360)

  ACN(ff:1,0)
  ACN(fd:1,0)
  ACN(fd:2,0)
  ACN(fd:3,0)
  ACN(fd:4,0)
  ACN(fd:5,0)

  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD(" Where TD.Especie  = '"~FBN['Especie']~"' ")
  SQL.ADD("   and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("   and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("   AND TD.Fecha      = '"~IdxDate(val(t:FAC))~"' ")
  SQL.ADD("   and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
  SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                         Where TD.Especie             = '"~FBN['Especie']~"' ")
  SQL.ADD("                           and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                           and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("                           AND TD.Fecha               = '"~IdxDate(val(t:FAC))~"' ")
  SQL.ADD("                           and "~Fstr(val(fe:3),0,0)~" <= PlazoHasta ")
  SQL.ADD("                       ) ")
  SQL.ADD(" Union All ")
  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD(" Where TD.Especie    = '"~FBN['Especie']~"' ")
  SQL.ADD("   and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("   and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("   AND TD.Fecha      = '"~IdxDate(val(t:FAC))~"' ")
  SQL.ADD("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
  SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                         Where TD.Especie             = '"~FBN['Especie']~"' ")
  SQL.ADD("                           and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                           and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef']))~"' ")
  SQL.ADD("                           AND TD.Fecha               = '"~IdxDate(val(t:FAC))~"' ")
  SQL.ADD("                           and "~Fstr(val(fe:3),0,0)~" > PlazoHasta ")
  SQL.ADD("                       ) ")
  SQL.ADD("ORDER BY TD.PlazoHasta  ")
  Recorrer SQL
    dfa
    IF val(ff:1)<=val(fe:3) y val(fe:3)<=FBN['PlazoHasta']
      * Este es el plazo a interpolar  
      ACN(fd:3, val(fd:1)/FBN['Valor4'] -1 )
      ACN(fd:4, (val(fd:3)/(FBN['Valor3']-val(fd:2)))*100 )
      ACN(fd:5, (FBN['Valor3']-(val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd:2))*val(fd:1)+((val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd:2))/(FBN['Valor3']-val(fd:2))*FBN['Valor4']) 
    EndIf
    ACN(ff:1,FBN['PlazoHasta'])
    ACN(fd:1,FBN['Valor4'])
    ACN(fd:2,FBN['Valor3'])
  Proximo
  ACN(q:fac, Val(fd:5))

  ACN(ff:1,0)
  ACN(fd:1,0)
  ACN(fd:2,0)
  ACN(fd:3,0)
  ACN(fd:4,0)
  ACN(fd:5,0)

  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("Where TD.Especie  = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("AND TD.Fecha      = '"~IdxDate(val(u:FAC))~"' ")
  SQL.ADD("and TD.PlazoHasta = (Select Min(TD.PlazoHasta) ")
  SQL.ADD("                       from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                      Where TD.Especie             = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("                        and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                        and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("                        AND TD.Fecha               = '"~IdxDate(val(u:FAC))~"' ")
  SQL.ADD("                        and "~Fstr(val(fe:3),0,0)~" <= PlazoHasta ")
  SQL.ADD("                    ) ")
  SQL.ADD(" Union All")
  SQL.ADD("Select TD.*,TT.DayCount ")
  SQL.ADD("  from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD(" Where TD.Especie    = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("   and TD.TipoTasa   = TT.Codigo ")
  SQL.ADD("   and TT.PrecioRef  = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("   AND TD.Fecha      = '"~IdxDate(val(u:FAC))~"' ")
  SQL.ADD("   and TD.PlazoHasta = (Select Max(TD.PlazoHasta) ")
  SQL.ADD("                          from "~DBO~".TASASDIA TD, "~DBO~".TIPOSTASA TT ")
  SQL.ADD("                         Where TD.Especie             = '"~FBN['ContraEspecie']~"' ")
  SQL.ADD("                           and TD.TipoTasa            = TT.Codigo ")
  SQL.ADD("                           and TT.PrecioRef           = '"~Trim(Mirt(FBN['PrecioRef4']))~"' ")
  SQL.ADD("                           AND TD.Fecha               = '"~IdxDate(val(u:FAC))~"' ")
  SQL.ADD("                           and "~Fstr(val(fe:3),0,0)~" > PlazoHasta ")
  SQL.ADD("                       ) ")
  SQL.ADD("ORDER BY TD.PlazoHasta  ")
  Recorrer SQL
    dfa
    IF val(ff:1)<=val(fe:3) y val(fe:3)<=FBN['PlazoHasta']
      * Este es el plazo a interpolar  
      ACN(fd:3, val(fd:1)/FBN['Valor4'] -1 )
      ACN(fd:4, (val(fd:3)/(FBN['Valor3']-val(fd:2)))*100 )
      ACN(fd:5, (FBN['Valor3']-(val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365))/(FBN['Valor3']-val(fd:2))*val(fd:1)+((val(fe:2)-val(fe:1))/IIF(Not Incluido(FBN['DayCount'],'ACT|365|'),360,365)-val(fd:2))/(FBN['Valor3']-val(fd:2))*FBN['Valor4']) 
    EndIf
    ACN(ff:1,FBN['PlazoHasta'])
    ACN(fd:1,FBN['Valor4'])
    ACN(fd:2,FBN['Valor3'])
  Proximo
  * ah: compras / ao: ventas
  ACN(r:fac, Val(fd:5))

  ACN(s:FAC, Val(p:FAC)*Val(q:FAC)/Val(r:FAC))

  ACT(v:FAC, 'OK')
  if Dialogo.Check1=1
    ACT(w:FAC, 'Update')
    SQL.ADD("Update "~DBO~".OPERACIONES ")
    SQL.ADD("   Set TipoCambio3 = "~FStr(Val(s:FAC),1,8)~", FechaUltCupon = '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" where NrOperacion = '"~Val(b:FAC)~"' ")
    SQL.NEW
    SQL.EXEC
  endif
proximo

if FAC>1
  SetFont(a:2..x:FAC, 1)
  FormatoCeldas(j:2..l:FAC, Exe('F2'))
  FormatoCeldas(m:2..m:FAC, Exe('F8'))
  FormatoCeldas(p:2..s:FAC, Exe('F8'))
endif
SetFont(y:1..z:5, 1)

ACO(10,12)
ACO(12,12)
