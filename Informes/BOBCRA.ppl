HOJAVISIBLE(SI)
ModoReproceso(SinDialogo)
***pendiente de revisar campo de 100 caracteres en razon social
CrearDialogo
  Fecha1 : 'Fecha Desde'                   ;1;1;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;Fsys;
  Fecha2 : 'Fecha Hasta'                   ;1;2;;;;Dialogo.Fecha2 <> 0;'Fecha Hasta Invalida';NO;Fsys;
  Radio6 : 'Estado|Todas|Vig|Anul'         ;2;1;;;;;;;0 
  NrTrans1:'Boleto'                        ; ;1;;;;Vacio(Dialogo.NrTrans1) o [NoVacio(Dialogo.NrTrans1) y Incluido(BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans', Dialogo.NrTrans1), 'BOBCRA')];'Boleto BCRA Invalido';NO;;;;;;" TipoTr2='BOBCRA' ";
  Especie1:'Especie'                       ; ;1;;;;;;;;;;;;" Tipo = 'MON' "
  Cliente1:'Cliente'                       ; ;1;;;;;;;;;;;;
FinDialogo

if Not Ok
  Cancelar
endif


CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(6, "Arial,9,B")
CrearFont(7, "Arial,11,B")
CrearFont(4, "Arial,5,")

SetFilaActual(1)

ACT(A:FAC,'BOLETOS BCRA '~IIF(Dialogo.Radio6=1,'(Vigentes)',IIF(Dialogo.Radio6=2,'(Anulados)')))

ACT(A:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
ACT(D:FAC+1,'Fecha Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
   ACT(A:FAC+2,'Cliente: '~Dialogo.Cliente1) 
else
   ACT(A:FAC+2,'Cliente: Todas') 
endif
if NoVacio(Dialogo.Especie1)
   ACT(A:FAC+3,'Moneda: '~Dialogo.Especie1) 
else
   ACT(A:FAC+3,'Moneda: Todas') 
endif
if NoVacio(Dialogo.NrTrans1)
   ACT(A:FAC+4,'Nro.Boleto: '~Dialogo.NrTrans1) 
Else
   ACT(A:FAC+4,'Nro.Boleto: Todos') 
EndIf

SetFilaActual(FAC+5)
If Dialogo.Radio6=0 o Dialogo.Radio6=1
   SQL.ADD("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie,")
   SQL.ADD("T.Cliente1,C.CUIT as NrCUIT,C.Direccion,C.Localidad,")
   SQL.ADD("C.Provincia,C.CodigoPostal as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
   SQL.ADD("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstRecibido,")
   SQL.ADD("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as InstComprado,")
   SQL.ADD("T.Ley2 as Pagador,T.Cuenta1,T.Ley1 as DomicilioPag,T.CEmpresa4 as PaisPagador,T.Ley5 as CodSwifPag,")
   SQL.ADD("CB.Descripcion,'Vigente' as Estado,C.RazonSocial,T.Vehiculo1, ")
   SQL.ADD("C.CodigoBCRA, T.Ley4 BancoPagador, C.Direccion Domicilio, T.RB1, T.Especie1, T.Fecha3 ")
 *-I  
 *   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB, "~DBO~".OPERACIONES OP ")
     SQL.ADD("FROM  "~DBO~".BTRANSACCIONES2 T LEFT OUTER JOIN  "~DBO~".OPERACIONES OP ON T.NrOperacionRef1 = OP.NrOperacion  , "~DBO~".CLIENTES C, "~DBO~".CONCEPTOSBCRA CB ")
*-F
   
   SQL.ADD("WHERE ")
   SQL.ADD(" T.Cliente1 = C.Codigo AND T.Fecha1 Between "~IdxDate2(Dialogo.Fecha1)~" and  "~IdxDate2(Dialogo.Fecha2)~" ")
   If NoVacio(Dialogo.NrTrans1)
      SQL.ADD(" AND T.NrTrans = '"~Dialogo.NrTrans1~"' ")
   EndIf
   SQL.ADD(" AND T.TipoTr2 = 'BOBCRA' ")
*-I 
*   SQL.ADD(" AND T.NrOperacionRef1 *= OP.NrOperacion ")
*-F   
   SQL.ADD(" AND T.Cambio1 = CB.Codigo ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" AND T.Cliente1 = '"~Dialogo.Cliente1~"' ")
   EndIf
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" AND T.Especie1 = '"~Dialogo.Especie1~"' ")
   EndIf
EndIf
If Dialogo.Radio6=0 
   SQL.ADD(" Union All ")
EndIf
If Dialogo.Radio6=0 o Dialogo.Radio6=2
   SQL.ADD("SELECT T.NrTrans,T.RB1 as Tipo,T.NrOperacionRef1 as Operacion, T.Fecha1,T.Especie,")
   SQL.ADD("T.Cliente1,C.CUIT as NrCUIT,C.Direccion,C.Localidad,")
   SQL.ADD("C.Provincia,C.CodigoPostal as CP,T.Cantidad1 as Importe,T.Precio1 as TipoCambio,")
   SQL.ADD("T.Cambio1 as Concepto,T.CEmpresa3 as PaisOrigen,T.Cantidad2 as InstVendido,T.Cantidad3 as InstRecibido,")
   SQL.ADD("T.Fecha2 as FIngreso,T.NrOfic as NrOficializ,T.Cambio3 as InstComprado,")
   SQL.ADD("T.Ley2 as Pagador,T.Cuenta1,T.Ley1 as DomicilioPag,T.CEmpresa4 as PaisPagador,T.Ley5 as CodSwifPag,")
   SQL.ADD("CB.Descripcion,'Anulado' as Estado,C.RazonSocial,T.Vehiculo1, ")
   SQL.ADD("C.CodigoBCRA, T.Ley4 BancoPagador, C.Direccion Domicilio, T.RB1, T.Especie1, T.Fecha3 ")   
*-i   
*   SQL.ADD("FROM "~DBO~".BTRANSACCIONES2 T,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB, "~DBO~".OPERACIONES OP ")
      SQL.ADD("FROM "~DBO~".BTRANSACCIONES2 T,"~DBO~".CLIENTES C,"~DBO~".CONCEPTOSBCRA CB, "~DBO~".OPERACIONES OP ")
*-f   
   SQL.ADD("WHERE ")
   SQL.ADD(" T.Cliente1 = C.Codigo AND T.Fecha1 Between "~IdxDate2(Dialogo.Fecha1)~" and  "~IdxDate2(Dialogo.Fecha2)~" ")
   If NoVacio(Dialogo.Cliente1)
      SQL.ADD(" AND T.Cliente1 = '"~Dialogo.Cliente1~"' ")
   EndIf
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" AND T.Especie1 = '"~Dialogo.Especie1~"' ")
   EndIf
   If NoVacio(Dialogo.NrTrans1)
      SQL.ADD(" AND T.NrTrans = '"~Dialogo.NrTrans1~"' ")
   EndIf
   SQL.ADD(" AND T.TipoTr2 = 'BOBCRA' ")
*-i   
*   SQL.ADD(" AND T.NrOperacionRef1 *= OP.NrOperacion ")
*-f
   SQL.ADD(" AND T.Cambio1 = CB.Codigo ")
EndIf
SQL.ADD(" Order by 1")
ACT(a:fac,'NrTrans')
ACT(b:fac,'Fecha')
ACT(c:fac,'Tipo') 
ACT(d:fac,'Solicitante') 
ACT(e:fac,'Especie')
ACT(f:fac,'Cuit/Cuil/Dni') 
ACT(G:fac,'Concepto') 
ACT(H:fac,'N.Oficializ') 
ACT(I:fac,'Importe') 
ACT(J:fac,'TipoCambio') 
ACT(K:fac,'Pagador/Beneficiario' ) 
ACT(L:fac,'Swift Pais Pag/Benf') 
ACT(M:fac,'Bco.Pagador Recibidor Exterior' ) 
ACT(N:fac,'Swift Bco. Pag/Rec') 
ACT(O:fac,'Estado') 
ACT(P:fac,'Op.Rel') 
ACT(Q:fac, 'F.Ult.Modif.')

AlinearCeldas(a:FAC..Q:FAC,'C')
SetFont(a:1..Q:FAC,2)
AgregarMarco(a:FAC..Q:FAC, 1,0,Exe('COLOR6'))


Recorrer SQL 
   Message('Recuperando '~FBN['NrTrans'])

   IF Vacio(fbn('Operacion'))
       ACT(a:fac,FBN['NrTrans'])
   ELSE
       ACT(A:fac, Copy(fbn('NrTrans'), 3, 6))
   ENDIF
   If EqStr(FBN['Estado'],'Vigente')
      ACLT(a:fac,FBN['NrTrans'] )
   EndIf

   ACT(b:fac,FBN['Fecha1'] )
   ACT(c:fac,IIf(FBN['Tipo']=0,'Compra','Venta') )
   ACT(d:fac,FBN['Cliente1']~' '~FBN['RazonSocial'])
   ACT(e:fac,FBN['Especie1'])
   ACT(f:fac,FBN['NrCUIT']) 
   ACT(G:fac,FBN['Concepto']) 
   ACT(H:fac,FBN['NrOficializ']) 
   ACN(I:fac,Round(FBN['Importe'],0)) 
   ACN(J:fac,FBN['TipoCambio']) 
   ACT(K:fac,FBN['Pagador']) 
   ACT(L:fac,FBN['PaisPagador']) 
   ACT(M:fac,FBN['BancoPagador'] )
   ACT(N:fac,FBN['CodSwifPag']) 
   ACT(O:fac,FBN['Estado'] )
   ACT(P:fac,FBN['Operacion'] )
   ACLO(P:fac,FBN['Operacion'] )
   ACT(Q:fac, fbn('Fecha3'))

   SetFont(a:fac..z:fac,1)
Proximo
FormatoCeldas(J:1..J:fac, Exe('F8'))
Ifa 
Ifa

ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)


ACO(1, 6)
ACO(2, 6)
ACO(3, 5)
ACO(4, 68)
ACO(5,5)
ACO(6,10)
ACO(7,6)
ACO(8, 7)
ACO(9, 9)
ACO(10, 7)
ACO(11,20)
ACO(12, 11)
ACO(13, 19)
ACO(14,12)
ACO(15,6 )
ACO(16,6)
ACO(17, 12)

Impresion(1,2)
Impresion(2,0)
Impresion(3,0)
Impresion(4,0)
SetPrintFit(3, 60)
LimitesVision(Q:fac)
