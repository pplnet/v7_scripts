MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'D.FechaVto' ;;;;;;;;;FSYS
  Fecha2   : 'H.FechaVto' ;;;;;;;;;FSYS
  Cliente1 : 'Cliente'    ;;;;;;;;;;;;;;"Status ='HAB'"
  Vehiculo1: 'Vehiculo'   ;;;;;;;;NO;VAR('VEHICULODE')
  Especie1 : 'Moneda'     ;;;;;;[NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA') y EsTerminal(Dialogo.Especie1, Especie)] o Vacio(Dialogo.Especie1);'Debe Ingresar una Moneda Valida';;;;;;;"Tipo='MON' AND Status = 'HAB' "
  Book1    : 'Book'       ;;;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Operador : 'Operador'   ;;;;;;;;;UsuarioActivo;
FinDialogo

If Not Ok
  Cancelar
EndIF

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

SetFilaActual(1)
ACT(A:FAC,'Vencimiento de Cartera - FX ')
ACT(A:FAC+1,'Fecha Desde: '~Dialogo.Fecha1)
ACT(D:FAC+1,'Fecha Hasta: '~Dialogo.Fecha2)
if NoVacio(Dialogo.Cliente1)
   ACT(A:FAC+2,'Cliente: '~Dialogo.Cliente1) 
else
   ACT(A:FAC+2,'Cliente: Todas') 
endif
if NoVacio(Dialogo.Vehiculo1)
   ACT(D:FAC+2,'Vehiculo: '~Dialogo.Vehiculo1) 
else
   ACT(D:FAC+2,'Vehiculo: Todas') 
endif
if NoVacio(Dialogo.Especie1)
   ACT(A:FAC+3,'Moneda: '~Dialogo.Especie1) 
else
   ACT(A:FAC+3,'Moneda: Todas') 
endif
if NoVacio(Dialogo.Operador)
  ACT(D:FAC+3,'Operador: '~Dialogo.Operador) 
else
  ACT(D:FAC+3,'Operador: Todos') 
endif
if NoVacio(Dialogo.Book1)
  ACT(D:FAC+4,'Book: '~Dialogo.Book1) 
else
  ACT(D:FAC+4,'Book: Todos') 
endif

ACN(w1,4)
SetFilaActual(FAC+5)

ACT(a:FAC, 'TipoOp')
ACT(b:FAC, 'Operacion')
ACT(c:FAC, 'FechaOp')
ACT(d:FAC, 'FechaVto')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'Mon.Pago')
ACT(h:FAC, 'Importe')
ACT(i:FAC, 'T.Cambio')
ACT(j:FAC, 'Monto')
ACT(k:FAC, 'Mercado')
ACT(L:FAC, 'Book')
ACT(M:FAC, 'Plazo')
ACT(N:FAC, 'Puesto')
ACT(O:FAC, 'Tipo')
ACT(P:FAC, 'Fecha Carga')
AlinearCeldas(a:FAC..P:FAC,'C')
SetFont(a:1..P:FAC,2)
AgregarMarco(a:FAC..P:FAC, 1,0,Exe('COLOR6'))

SQL.ADD(" Select NrOperacion, FechaOp, FechaVto, Cliente1, TipoOp,                  ")
SQL.ADD("       Cantidad, Precio1, Precio2, TotalBrutoCli1, TotalBrutoCli2,         ")
SQL.ADD("       FechaCarga,Especie, ContraEspecie, MercadoRB, Plazo, Puesto,        ")
SQL.ADD("       ValorRB1,FormaLiquidacion2, RB10, Alias1, Book1, Mercado, Mercado2  ")
SQL.ADD(" from  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O                           ")
SQL.ADD(" where                                                                     ")
SQL.ADD(" FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'   ")
****
****No Tiene en cuenta las operaciones que son generadas por pases o por arbitrajes
****
SQL.ADD(" and ((TipoOp = 'FXAT' and (PaseCB <> '1'or PaseCB is NULL))  or                    ")
SQL.ADD(" (TipoOp in ('FXCT','FXVT') and (PaseCB <> '1'or PaseCB is NULL) and                ")
SQL.ADD(" (Arbitraje <> '1'or Arbitraje is NULL)) or                   ")
SQL.ADD(" (TipoOp = 'FXA' and (PaseCB <> '1'or PaseCB is NULL)) or                           ")
SQL.ADD(" (TipoOp in ('FXC','FXV') and (PaseCB <> '1'or PaseCB is NULL)  and                 ")
SQL.ADD(" (Arbitraje <> '1'or Arbitraje is NULL)))                                           ")
SQL.ADD("  and E.Codigo = O.Especie                                                          ")
****Condicionales
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Book1)
   SQL.ADD("and Book1 = '"~Dialogo.Book1~"' ")
endif
if NoVacio(Dialogo.Operador)
   SQL.ADD("and Operador = '"~Dialogo.Operador~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and Especie = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD("order by TipoOp,Especie,FechaVto,Book1 ")
BorrarCeldas(w1..w8)
ACN(z1,0)

Recorrer SQL
    if Not EqStr(fbn('TipoOp'),Val(w3))
      if NoVacio(Val(w7))
         * Cambio Fecha
         ACT(a:fac, 'Total por Vencimiento ')
         ACT(d:fac,Val(w7))
         ACN(h:fac, Val(w5))
         AgregarMarco(a:fac..P:fac,1)
         SetFont(a:fac..O:fac, 2)
         BorrarCeldas(w5..w5) 
         ifa
      endif

      if NoVacio(Val(w4))
         * Cambio Moneda
         ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
         ACN(h:fac, Val(w8))
         AgregarMarco(a:fac..P:fac,1)
         SetFont(a:fac..O:fac, 2)
         BorrarCeldas(w8..w8) 
         ifa
      endif

      ifa      
      ACT(w3, fbn('TipoOp'))  
      ACT(a:fac, Val(w3)~' - '~BuscarCampo('TIPOSOPERACION','Nombre','Codigo',Val(w3)))
      AgregarMarco(a:fac..P:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..P:fac, 2)
      ifa

      * Asignar Especie
      ACT(w4, fbn('Especie'))  
      ACT(w1, fbn('Alias1'))  
      ACT(w7, fbn('FechaVto'))  
      ACT(a:fac, Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
      AgregarMarco(a:fac..P:fac,1)
      SetFont(a:fac..P:fac, 2)
      ifa
    else
      if Not EqStr(fbn('Especie'),Val(w4))
        if NoVacio(Val(w7))
           * Cambio Fecha
           ACT(a:fac, 'Total por Vencimiento ')
           ACT(d:fac,Val(w7))
           ACN(h:fac, Val(w5))
           AgregarMarco(a:fac..P:fac,1)
           SetFont(a:fac..O:fac, 2)
           BorrarCeldas(w5..w5) 
           ifa
        endif
        if NoVacio(Val(w4))
           * Cambio Moneda
           ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
           ACN(h:fac, Val(w8))
           AgregarMarco(a:fac..P:fac,1)
           SetFont(a:fac..P:fac, 2)
           BorrarCeldas(w8..w8) 
           ifa
        endif
        * Asignar Especie
        ACT(w4, fbn('Especie'))  
        ACT(w1, fbn('Alias1'))  
        ACT(w7, fbn('FechaVto'))  
        ACT(a:fac, Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
        AgregarMarco(a:fac..P:fac,1)
        SetFont(a:fac..P:fac, 2)
        ifa
      else 
      if Not EqStr(fbn('FechaVto'),Val(w7))
        if NoVacio(Val(w7))
          * Cambio Fecha
          ACT(a:fac, 'Total por Vencimiento ')
          ACT(d:fac,Val(w7))
          ACN(h:fac, Val(w5))
          AgregarMarco(a:fac..P:fac,1)
          SetFont(a:fac..O:fac, 2)
          BorrarCeldas(w5..w5) 
          ifa
        endif
        * Asignar Especie
        ACT(w4, fbn('Especie'))  
        ACT(w1, fbn('Alias1'))  
        ACT(w7, fbn('FechaVto'))  
        ifa
      endif
      endif
    endif

  SCN(z1,1)
  ACT(z2, Fbn('NrOperacion'))
  ACT(a:FAC, Fbn('TipoOp'))
  ACT(b:FAC, Fbn('NrOperacion'))
  ACLO(b:fac, fbn('NrOperacion'))
  ACD(c:FAC, Fbn('FechaOp'))
  ACD(d:FAC, Fbn('FechaVto'))
  ACT(e:FAC, fbn('Cliente1'))
  ACT(f:FAC, fbn('Especie'))
  ACT(g:FAC, fbn('ContraEspecie'))
  ACN(h:FAC, fbn('Cantidad'))

  ACN(i:FAC, fbn('Precio1'))
  ACN(j:FAC, fbn('TotalBrutoCli1'))
  if Eqstr(Fecha(fbn('FechaCarga'),'dd/mm/yyyy'),'00/00/0000')
     ACT(P:FAC, ' ')
  else
     ACT(P:FAC, Fecha(fbn('FechaCarga'),'dd/mm/yyyy'))
  endif

  ACT(k:fac, fbn('Mercado')~'/'~fbn('Mercado2'))
  ACT(L:fac, fbn('Book1'))
  if fbn('Puesto')=0
     ACT(N:fac, 'No')
  endif
  if fbn('Puesto')=1
     ACT(N:fac, 'Si')
  endif

  if fbn('RB10')=0
     ACT(O:fac, 'Delivery')
  endif
  if fbn('RB10')=1
     ACT(O:fac, 'Non Delivery')
  endif

  if Incluido(fbn('TipoOp'),'FXAT|FXCT|FXVT')
    ACN(M:fac, fbn('Plazo'))
  else 
    if fbn('MercadoRB')=1
       if fbn('FormaLiquidacion2')=0
         ACT(M:FAC, 'Tomorrow')
       endif
       if fbn('FormaLiquidacion2')=1
         ACT(M:FAC, 'Spot')
       endif
    else
      if fbn('ValorRB1')=0
        ACT(M:FAC, '0 hs.')
      endif
      if fbn('ValorRB1')=1
        ACT(M:FAC, '24 hs.')
      endif
      if fbn('ValorRB1')=2
        ACT(M:FAC, '48 hs.')
      endif
      if fbn('ValorRB1')=3
       ACT(M:FAC, '72 hs.')
      endif
      if fbn('ValorRB1')=4
       ACT(M:FAC, 'Otro')
      endif
    endif 
  endif

  SCN(w5,fbn('Cantidad'))
  SCN(w8,fbn('Cantidad'))
  SetFont(a:fac..P:fac+1,1)


  * buscar operaciones relacionadas
  SQL.ADD("Select NrOperacion, FechaOp, FechaVto, Cliente1, TipoOp, Cantidad, Precio1, TotalBrutoCli1,FechaCarga, ")
  SQL.ADD("Especie, ContraEspecie, MercadoRB, Plazo, Puesto, ValorRB1, FormaLiquidacion2, RB10 ")
  SQL.ADD("from "~DBO~".OPERACIONES ")
  SQL.ADD(" Where OperacionRef = '"~Val(z2)~"' ")
  SQL.ADD(" Order by NrOperacion")
  Recorrer SQL
    ACT(a:FAC, fbn('TipoOp'))
    ACT(b:FAC, fbn('NrOperacion'))
    ACLO(b:fac, fbn('NrOperacion'))
    ACD(d:FAC, fbn('FechaVto'))
    ACT(f:FAC, fbn('Especie'))
    ACT(g:FAC, fbn('ContraEspecie'))
    ACN(h:FAC, fbn('Cantidad'))
    ACN(i:FAC, fbn('Precio1'))
    ACN(j:FAC, fbn('TotalBrutoCli1'))
    if Eqstr(Fecha(fbn('FechaCarga'),'dd/mm/yyyy'),'00/00/0000')
       ACT(P:FAC, ' ')
    else
       ACT(P:FAC, Fecha(fbn('FechaCarga'),'dd/mm/yyyy'))
    endif
    SetFont(a:fac..P:fac,1)

    If Incluido(fbn('TipoOp'), 'FXA|FXAT') 
      * Es un Arb que viene de un Pase
      SQL.ADD("Select NrOperacion, FechaOp, FechaVto, Cliente1, TipoOp, Cantidad, Precio1, TotalBrutoCli1,FechaCarga, ")
      SQL.ADD("Especie, ContraEspecie, MercadoRB, Plazo, Puesto, ValorRB1, FormaLiquidacion2, RB10 ")
      SQL.ADD("from "~DBO~".OPERACIONES ")
      SQL.ADD(" Where OperacionRef = '"~fbn('NrOperacion')~"' ")
      SQL.ADD(" Order by NrOperacion")
      Recorrer SQL
        ACT(a:FAC, fbn('TipoOp'))
        ACT(b:FAC, fbn('NrOperacion'))
        ACLO(b:fac, fbn('NrOperacion'))
        ACD(d:FAC, fbn('FechaVto'))
        ACT(f:FAC, fbn('Especie'))
        ACT(g:FAC, fbn('ContraEspecie'))
        ACN(h:FAC, fbn('Cantidad'))
        ACN(i:FAC, fbn('Precio1'))
        ACN(j:FAC, fbn('TotalBrutoCli1'))
        if Eqstr(Fecha(fbn('FechaCarga'),'dd/mm/yyyy'),'00/00/0000')
           ACT(P:FAC, ' ')
        else
           ACT(P:FAC, Fecha(fbn('FechaCarga'),'dd/mm/yyyy'))
        endif
        SetFont(a:fac..P:fac,1)
      Proximo
      IFA
    EndIf
  Proximo
  IFA
proximo

if NoVacio(Val(w7))
  *Cambio Fecha
  ACT(a:fac, 'Total por Vencimiento ')
  ACT(d:fac,Val(w7))
  ACN(h:fac, Val(w5))
  AgregarMarco(a:fac..P:fac,1)
  SetFont(a:fac..O:fac, 2)
  BorrarCeldas(w5..w5) 
  ifa
endif
if NoVacio(Val(w4))
  * ultima Moneda
  ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
  ACN(h:fac, Val(w8))
  AgregarMarco(a:fac..P:fac,1)
  SetFont(a:fac..P:fac, 2)
  BorrarCeldas(w8..w8) 
  ifa
endif

ACT(a:Val(w1)+5,'Cant. Minutas: '~Fstr(Val(z1),1,0))

SetFont(a:Val(w1)+5,2)

FormatoCeldas(j:Val(w1)+5..j:FAC,Exe('F2'))
FormatoCeldas(i:Val(w1)+5..i:FAC,Exe('F7'))
FormatoCeldas(M:Val(w1)+5..M:FAC,Exe('F0R'))

ACO(1,5)
ACO(2,6)
ACO(3,6)
ACO(4,6)
ACO(5,7)
ACO(6,5)
ACO(7,6)
ACO(8,6)
ACO(9,9)
ACO(10,6)
ACO(11,7)
ACO(12,7)
ACO(13,5)
ACO(14,5)
ACO(15,7)
ACO(16,7)

Impresion(1,2)
Impresion(4,1)
SetMargins(0,0,0,2)
SetFilaActual(FAC+2)

ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC, 2)
SetFont(N:3,2)
LimitesVision(p:FAC)
CrearFont(6,"Arial,6,B")
RangoTitulo(a:Val(w1)+5..p:FAC, 1)
