*Intereses devengados por periodo para operaciones de pase
CrearDialogo
  Fecha1   : 'F.Desde';;;;;;;;;PriDeMes(FSys)
  Fecha2   : 'F.Hasta';;;;;;;;;FinDeMes(FSys)
  Vehiculo1: 'Vehiculo' ;;;;;;;;NO;VAR('VEHICULODE')
  Radio1   : 'Cartera|Trading|Investment|Disponible|Todas';;;;NO;NO;;;;3
FinDialogo

if not OK
  Cancelar
endif

ACT(a1, 'Intereses devengados por periodo - Pases')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a4, 'Vehiculo : '~Dialogo.Vehiculo1)
else
  ACT(a4, 'Vehiculo : Todos')
endif
if Dialogo.Radio1 = 0 
  ACT(a5, 'Cartera : Trading')
else
  if Dialogo.Radio1 = 1 
    ACT(a5, 'Cartera : Investment')
  else
    ACT(a5, 'Cartera : Disponible')
  endif
endif

ACT(a6, 'Nro.Op.')
ACT(b6, 'Especie')
ACT(c6, 'Cliente')
ACT(d6, 'Cantidad')
ACT(e6, 'Pl')
ACT(f6, 'Fec Pago')
ACT(g6, 'Fec Vto.')
ACT(h6, 'Ds')
ACT(i6, 'Intereses en Pesos')
ACT(i7, 'Total')
ACT(j7, 'Acum.')
ACT(k7, 'Deveng.')
ACT(l7, 'Saldo')
ACT(m6, 'Intereses en Dolares')
ACT(m7, 'Total')
ACT(n7, 'Acum.')
ACT(o7, 'Deveng.')
ACT(p7, 'Saldo')
ACT(q7, 'Book')


AgregarMarco(a6..q7,1,0,Exe('COLOR6'))

SetFilaActual(7)
SQL.ADD("Select NrOperacion, TipoOp, Especie, ContraEspecie, FechaOp, FechaVto, FechaPago, Cliente1, Cantidad, TotalBrutoCli1, ")
SQL.ADD("TotalDerechos, TotalBrutoCli2, TotalAux1, Plazo, EsAforado, TotalCaucion,Book1,TotalGastos from "~DBO~".OPERACIONES" )
SQL.ADD("where FechaPago <= '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and TipoOp in ('TIPA','TIPP')")

if Dialogo.Radio1 <> 3
  if Dialogo.Radio1 = 0
    SQL.ADD("and (Cartera = "~Dialogo.Radio1~" or Cartera is null)")
  else
    SQL.ADD("and Cartera = "~Dialogo.Radio1~" ")
  endif
endif

if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif

SQL.ADD("order by TipoOp, NrOperacion")

recorrer SQL

  if Not EqStr(Val(z1),fbn('TipoOp'))
    if NoVacio(Val(z1))
      ACT(a:fac, 'Total')
      ACN(m:fac, Sum(m:Val(z4)..m:fac-1))
      ACN(o:fac, Sum(o:Val(z4)..o:fac-1))
      ACN(n:fac, Sum(n:Val(z4)..n:fac-1))
      ACN(p:fac, Sum(p:Val(z4)..p:fac-1))
      ACN(i:fac, Sum(i:Val(z4)..i:fac-1))
      ACN(j:fac, Sum(j:Val(z4)..j:fac-1))
      ACN(k:fac, Sum(k:Val(z4)..k:fac-1))
      ACN(l:fac, Sum(l:Val(z4)..l:fac-1))
      AgregarMarco(a:fac..q:fac,1)
      ifa
    endif

    ACT(a:fac, fbn('TipoOp'))
    ACT(z1, fbn('TipoOp'))
    AgregarMarco(a:fac..q:fac,1,0,RGB(192,192,192))
    ifa
    ACN(z4, fac)

  endif

  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente1'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Plazo'))
  ACT(f:fac, fbn('FechaPago'))
  ACT(g:fac, fbn('FechaVto'))
  ACT(q:fac, fbn('Book1'))
  
  if fbn('FechaPago') > Dialogo.Fecha1
    ACN(z2, fbn('FechaPago'))
  else
    ACN(z2, Dialogo.Fecha1)
  endif

  if fbn('FechaVto') <= Dialogo.Fecha2
    ACN(z3, fbn('FechaVto'))
  else
    ACN(z3, Dialogo.Fecha2+1)
  endif

  ACN(h:fac, Val(z3)-Val(z2))

  if Incluido(fbn('TipoOp'), 'TIPA|')
    ACN(z5, 1)
  else
    ACN(z5, 1)
  endif

  * intereses
  if EqStr(fbn('EsAforado'),'1')
     ACN(w:FAC,fbn('TotalCaucion'))
     ACN(x:FAC,fbn('TotalGastos'))
  else
     ACN(w:FAC,fbn('TotalBrutoCli1')+fbn('TotalDerechos'))
     ACN(x:FAC,fbn('TotalBrutoCli2')+fbn('TotalAux1'))
  endif

  ACN(y:FAC, Val(x:FAC)-Val(w:FAC))

  if EqStr(fbn('ContraEspecie'),'ARP')

    ACN(i:fac, Val(y:fac)*Val(z5))
    ACN(k:fac, Val(i:fac)/(fbn('FechaVto') - fbn('FechaPago'))*Val(h:fac))

    if fbn('FechaPago') < Dialogo.Fecha1 
      ACN(j:fac, Val(y:fac)*Val(z5) / (fbn('FechaVto') - fbn('FechaPago')) * ((Dialogo.Fecha1) - fbn ('FechaPago')))
    else
      ACN(j:fac, 0)
    endif

    ACN(l:fac, Val(i:fac)-Val(j:fac)-Val(k:fac))

  else

    ACN(m:fac, Val(y:fac)*Val(z5))
    ACN(o:fac, Val(m:fac)/(fbn('FechaVto') - fbn('FechaPago'))*Val(h:fac))
    scn(v1,val(o:fac))
    if fbn('FechaPago') < Dialogo.Fecha1 
      ACN(n:fac, Val(y:fac)*Val(z5) / (fbn('FechaVto') - fbn('FechaPago')) * ((Dialogo.Fecha1) - fbn ('FechaPago')))
    else
      ACN(n:fac, 0)
    endif

    ACN(p:fac, Val(m:fac)-Val(n:fac)-Val(o:fac))
  endif

proximo

if NoVacio(Val(z1))

  ifa
  ACT(a:fac, 'Total')
  ACN(m:fac, Sum(m:Val(z4)..m:fac-1))
  ACN(o:fac, Sum(o:Val(z4)..o:fac-1))
  ACN(n:fac, Sum(n:Val(z4)..n:fac-1))
  ACN(p:fac, Sum(p:Val(z4)..p:fac-1))
  ACN(i:fac, Sum(i:Val(z4)..i:fac-1))
  ACN(j:fac, Sum(j:Val(z4)..j:fac-1))
  ACN(k:fac, Sum(k:Val(z4)..k:fac-1))
  ACN(l:fac, Sum(l:Val(z4)..l:fac-1))
  AgregarMarco(a:fac..q:fac,1)

  ifa
  ACT(a:fac, 'Total General')
  ACN(m:fac, Sum(m8..m:fac-1)/2)
  ACN(o:fac, Sum(o8..o:fac-1)/2)
  ACN(n:fac, Sum(n8..n:fac-1)/2)
  ACN(p:fac, Sum(p8..p:fac-1)/2)
  ACN(i:fac, Sum(i8..i:fac-1)/2)
  ACN(j:fac, Sum(j8..j:fac-1)/2)
  ACN(k:fac, Sum(k8..k:fac-1)/2)
  ACN(l:fac, Sum(l8..l:fac-1)/2)
  AgregarMarco(a:fac..q:fac,1,0,Exe('COLOR6'))
endif

ifa
ifa
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,7,')

SetFont(a1..z7, 1)
SetFont(a7..z:fac, 2)
SetFont(a:fac..z:fac, 1)

FormatoCeldas(d7..d:fac, Exe('F2'))
FormatoCeldas(e7..e:fac, Exe('F0'))
FormatoCeldas(h7..p:fac, Exe('F0'))
FormatoCeldas(i7..p:fac, Exe('F2'))

AlinearCeldas(d7..e:fac, 'D')
AlinearCeldas(h7..p:fac, 'D')
