ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1: 'Fecha '                  ;;;;;;;;;FSys
   Radio1: 'Vehiculos:|Todos|Algunos';;;;;;;;;0;
   Radio3: 'Especies:|Todas|Algunas' ;;;;;;;;;0;
   Lista1: 'Vehiculos'               ;5;1;;Dialogo.Radio1=1;;;;;;;SQLSet("Select Codigo from "~DBO~".VEHICULOS ")
   Lista3: 'Especies'                ;-1;2;;Dialogo.Radio3=1;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where Jerarquia Like '"~Var('JERTITULOS')~"%'  or  Jerarquia Like '"~Var('JERMONEDA')~"%' ")
   Radio2: "Expresado|ARP|USD"       ;;;;;;;;;1
   Check1: 'Automatico'              ;;;;;;;;;0
   Entero1: 'Refresh'                ;;;;;;;;;5;;;;'###';;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3, 'Arial,10,B')

LimitesVision(h:30000)

act(mo1,VAR('MONEEXTR'))

If Dialogo.Radio2=0
   act(mo1,VAR('MONELOCA'))
EndIf

If Dialogo.Check1=1
   MostrarVentana(SI)
EndIf


ACT(a3, 'Posicion y Resultados Totales -  Expresado en '~VAL(mo1))
SetFont(a3..a3, 3)

ACT(a5, 'Fecha:')
ACT(a6, 'Vehiculos:')
ACT(d6, 'Especies:')

SetFont(a5..a6, 2)
SetFont(d5..d6, 2)

ACT(b5,Dialogo.Fecha1)
If Dialogo.Radio1 = 1 y NoVacio(Dialogo.Lista1)
  ACT(b6,Pipe2coma(Dialogo.Lista1))   
Else
  ACT(b6,'TODOS' )   
endif
If Dialogo.Radio3 = 1 y NoVacio(Dialogo.Lista3)
  ACT(e6,Pipe2coma(Dialogo.Lista3))   
Else
  ACT(e6,'TODAS' )   
endif
SetFont(b5..b6, 1)
SetFont(e5..e6, 1)

SetFilaActual(8)

act(a:fac,'Concepto')
act(b:fac,'Especie')
act(c:fac,'Posicion')
act(d:fac,'Precio')
act(e:fac,'Cash')
act(f:fac,'Daily')
act(g:fac,'Mth')
act(h:fac,'Ytd')
SetFont(a:fac..h:fac,2)

AgregarMarco(a:fac..h:fac,2,0,Exe('COLOR'))
ifa

If Dialogo.Check1=1
   Recorrer&i 1,500000

      (.'POSRESULT'.)
  
      Recorrer&i 1,Dialogo.Entero1
         Esperar(1)
      Proximo

      BorrarCeldas(a:9..h:fac)

   Proximo
   *-------
Else
   (.'POSRESULT'.)
EndIf


