AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
CrearDialogo
  Fecha1 : 'Desde';1;1;;;;Dialogo.Fecha1>0 and Dialogo.Fecha1<=Dialogo.Fecha2;'Fecha Desde debe de ser menor o igual a fecha Hasta';NO;PriDeMes(FSys,NO,'ARG');
  Fecha2 : 'Hasta';2;1;;;;Dialogo.Fecha2 <= FSYS;'Fecha Hasta debe ser menor o igual la fecha Actual';NO;FSys
  Lista1 : 'Tipo de operación';3;1;;;;;;;;;IIF(Dialogo.Radio2 = 0,VAR('PYLOPPRECI'),VAR('PYLOPTASA'));SI
  Cliente1 : 'Cliente';4;1;;;;;;;;;;SI
  OficialCuenta:    'Oficial'    ;;;;;;;;;;;;;;  
  Radio1: 'Tipo|Global|Tipo Operacion|Cliente|Detalle';;;;;NO;;;;0;
  Radio2: 'Origen|Precio|Tasa';;;;;SI;;;;;1;
Findialogo
If not OK 
    Cancelar
EndIf
*AA Saldos
    *AA:1  Saldo para MMCREM a ese dia(pesificado)
    *AA:2  SNC suma de saldos MMCREM
    *AA:3  Promedio de saldos dividido en la cantidad de fechas que 
    *AA:4 Pivote para guardar la cantidad para las operaciones de Tipo MMCO/MMCT/MMPF
*BB P&L
    *BB:1  SNC suma de P&LMMCREM ese dia(pesificado)
*CC Fechas para operaciones de Tipo MMCO/MMCT/MMPF
    *CC:1 FechaDesde
    *CC:2 FechaHasta    
            
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

If Dialogo.Radio2 = 0
    ACT(a:fac+5, 'P&L Precio de Transferencia - Global')
Else
    ACT(a:fac+5, 'P&L Tasa de Transferencia - Global')
EndIf
SetFont(a:fac+5, 3)
ACT(a:fac+6, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:fac+7, 'Fecha Hasta: '~Dialogo.Fecha2)

If Vacio(Dialogo.Lista1)
    ACT(a:fac+8,'Tipo de operacion: '~VAR('PYLOPTASA'))
ELSE
    ACT(a:fac+8,'Tipo de operacion: '~Pipe2Coma(Dialogo.Lista1))
    
ENDIF

IF Vacio(Dialogo.Cliente1) 
    ACT(a:fac+9,'Cliente: Todos')
ELSE
    ACT(a:fac+9,'Cliente: '~Dialogo.Cliente1)
ENDIF

IF Vacio(Dialogo.OficialCuenta)
    ACT(a:fac+10,'Oficial: Todos')
ELSE
    ACT(a:fac+10,'Oficial: '~Dialogo.OficialCuenta)
ENDIF

ACT(a:fac+11,'Tipo: Global ')

IF Vacio(SQL("SELECT Nroperacion FROM "~DBO~".SALDOSREM  WHERE Fecha = '"~IdXDate(Dialogo.Fecha2)~"'"))
    ACT(a:12,"No se encuentran volcados los saldos del dia "~Dialogo.Fecha2~" para las cuentas remuneradas ")
ENDIF

SetFilaActual(13)

ACT(a:fac, 'Capital')
ACT(b:fac, 'P&L')
SetFont(a:6..b:FAC,1)
AgregarMarco(a:FAC..b:FAC,1,0,Exe('COLOR6'))
AlinearCeldas(a:FAC..b:fac,'D')

(.'CONSPRETSA'.)

&DifDias := DifDias(Dialogo.Fecha2,Dialogo.Fecha1,no,no)

Recorrer SQL
    &TipoOp  := FBN['TipoOp']

    IF Dialogo.Radio2 = 0
        *PRECIO
        
    ELSE
        *TASA
        *Tasa de la op
        &TasaOP := Num(FBN['Precio1'])
        *Tasa de transf 
        &TasaTransf := Num(FBN['Precio4'])
        *Fecha Vencimiento de la operacion
        &FechaVto := FBN['FechaVto']
        *Fecha de la Operacion
        &FechaOp := FBN['FechaOp']
        *CAPITAL
        *Tasa MMCREM a mas de un dia
        If EqStri(&TipoOp, 'MMCREM')
            Recorrer&i 0, Num(&DifDias)
                *Capital 
                *Busca fecha por fecha por el tiempo que fue habil la OP 
                    ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'") * CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1 + &i,1,,'ARP'))
                    SCN(AA:2,Val(AA:1))
                    SCN(BB:1,(((&TasaTransf-&TasaOP) / 365) *  Val(AA:1))/100)
            Proximo            
            ACN(AA:3,(Val(AA:2) / (&DifDias+1)))
            SCN(A:14, Val(AA:3))
            SCN(B:14,Val(BB:1))
            *Seteo en 0 los pivotes
            ACN(AA:1,0)
            ACN(AA:2,0)
            ACN(AA:3,0)
            ACN(BB:1,0)
        Else
            (.'FECHAP&L'.)
            *Capital
            ACN(AA:4,FBN['Cantidad'] * CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2 ,1,,'ARP'))
            IF  Buscar(&TipoOp, Pipe2Comillas(Var('TIPOOPACTI')))
                *ACTIVO
                SCN(B:14,((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100) 
            Else 
                *Pasivo
                SCN(B:14,((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100) 
            EndIf
            ACN(AA:4,Val(AA:4)* &DifDias2) 
            SCN(A:14,(Val(AA:4)/(&DifDias+1)))
                           
        EndIf    
    EndIF
Proximo
FormatoCeldas(A:14..A:fac,Exe('F2'))
FormatoCeldas(B:14..B:fac,Exe('F2'))

ACO(1,16)
ACO(2,16)
ACO(3,14)
IF CeldaVacia(A:14)
    ACT(a:15,'FIN DEL INFORME')
    SetFont(a:15, 1)
    LimitesVision(C:15)
ELSE    
    ACT(a:16,'FIN DEL INFORME')
    SetFont(a:16, 1)
    LimitesVision(C:16)
ENDIF 
