MostrarCuadroDeMensajes
CrearDialogo
  Fecha1     : "Fecha"             ;;;;;;NoVacio(Dialogo.Fecha1);'Fecha Invalida';NO;Fsys;
  Especie1   : "Especie"           ;;;
  TipoOp1    : "Tipo Op."          ;;;
  Cliente1   : "Entidad"           ;;;
  Check1     : "Capital"           ;1;2;;;;Dialogo.Check1 = 1 O Dialogo.Check2 = 1 O Dialogo.Check3 = 1;'Debe Seleccionar al menos Capital, Intereses O Impuestos';NO;1
  Check2     : "Interes"           ;;;;;;;;;1
  Check3     : "Impuestos"         ;;;;;;;;;1
  Radio4     : "Expresado|"~Var('MONELOCA')~"|"~Var('MONEEXTR') ;5;1;;;;;;;0
  Radio2     : 'Expresado|Miles|Millones'     ;6;1;;;;;;;0
  Vehiculo1  : 'Vehiculo'          ;7;1;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

IF Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo))
*    Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,BU")
CrearFont(4,"Arial,12,B")
CrearFont(5,"Arial,12,BU")
CrearFont(6,"Arial,10,B")

ACO(1, 3)
ACO(2, 24)
ACO(3, 6)
ACO(4, 9)
ACO(5, 6)
ACO(6, 6)
ACO(7, 6)
ACO(8, 6)
ACO(9, 6)
ACO(10, 6)
ACO(11, 8)
ACO(12, 3)

***---FI:1 - Control Filas LONG TERM
***---FI:2 - Control Filas SHORT TERM
***---FI:3 - Fila Inicial SHORT TERM
***---CI:&k - Total Intereses por mes
***---CS:&k - Total Impuestos Internos por mes
***---CW:&k - Total WHT por mes
***---CC:&k - Total Comisiones por mes
***---CE:&k - Total Comisiones CEC por mes
***---CV:&k - Total IVA por mes
***---CL:1 - Cotizacion $ en U$S
***---CX:1 - Cotizacion U$S en $

ACD(FE:2, Dialogo.Fecha1)
ACD(FE:3, FinDeMes(SumarMeses(Fecha(Val(FE:2)), 5, 0), SI))
ACN(BD:1, 0)
ACN(BD:2, 0)
ACT(X:2, '')
ACN(CT:1, 0)
ACN(LG:1, 0)
ACT(NR:1, '')
***---Genero filas para poder bajar con insertarfila()
ACT(X:500, '')
Recorrer&k 1, 7
    ACN(CO:&k, 0)
    ACN(CI:&k, 0)
    ACN(CS:&k, 0)
    ACN(CW:&k, 0)
    ACN(CC:&k, 0)
    ACN(CE:&k, 0)
    ACN(CV:&k, 0)
Proximo

IF Dialogo.Radio2 = 0
    ACN(R:2, 1000)
ELSE
    ACN(R:2, 1000000)
ENDIF

ACN(CL:1, CotizacionC(Var('MONELOCA'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
ACN(CX:1, CotizacionC(Var('MONEEXTR'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))

SetFilaActual(2)

IF Dialogo.Check1 = 1 Y Dialogo.Check2 = 1
    ***---Capital e Intereses
    ACT(D:fac, 'FINANCIAL DEBT')
ELSE
    IF Dialogo.Check1 = 1
        ***---Capital
        ACT(D:fac, 'REPAYMENTS')
    ELSE
        ***---Intereses O Impuestos
        ACT(D:fac, 'INTEREST EXPENSES')
    ENDIF
ENDIF
SetFont(D:fac, 4)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
IF NoVacio(Dialogo.TipoOp1)
    ACT(C:fac, 'Operacion: '~Dialogo.TipoOp1)
ELSE
    ACT(C:fac, 'Operaciones: Todas')
ENDIF
ifa
IF Dialogo.Radio4 = 0
    ACT(A:fac, 'Expresado en: '~Var('MONELOCA'))
ELSE
    ACT(A:fac, 'Expresado en: '~Var('MONEEXTR'))
ENDIF
IF NoVacio(Dialogo.Especie1)
    ACT(C:fac, 'Especie: '~Dialogo.Especie1)
ELSE
    ACT(C:fac, 'Especies: Todas')
ENDIF
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: Miles')
ELSE
    ACT(A:fac, 'Expresado en: Millones')
ENDIF
IF NoVacio(Dialogo.Cliente1)
    ACT(C:fac, 'Entidad: '~Dialogo.Cliente1)
ELSE
    ACT(C:fac, 'Entidades: Todas')
ENDIF
SetFont(A:fac-2..C:fac, 2)

SetFilaActual(fac+2)

ACN(FX:1, fac)
Recorrer&k 0, 5
    ACT(&k+5:fac, Copy(Meses(Mes(SumarMeses(Dialogo.Fecha1,&k))), 1, 3)~'-'~IIF(Mes(SumarMeses(Dialogo.Fecha1, &k)) >= Mes(Dialogo.Fecha1), Copy(Fstr(Anio(Dialogo.Fecha1), 0, 0), 3, 2), Copy(Fstr(Anio(Dialogo.Fecha1)+1, 0, 0), 3, 2)))
Proximo
ACT(K:fac, 'TOTAL')
SetFont(C:fac..K:fac, 2)
AlinearCeldas(A:fac..K:fac, 'C')
AgregarMarco(A:fac..A:fac, 1, 0, Exe('COLOR6'))
AgregarMarco(B:fac..D:fac, 1, 0, Exe('COLOR6'))
AgregarMarco(E:fac..K:fac, 1, 2, Exe('COLOR6'))
IF Dialogo.Check1 = 1
    (.'FINDEB1'.)
ENDIF

IF Dialogo.Check2 = 1
    IF Dialogo.Check1 = 1
        SQL.ADD(" UNION ")
    ENDIF
    (.'FINDEB2'.)
ENDIF
IF Dialogo.Check3 = 1
    IF Dialogo.Check1 = 1 O Dialogo.Check2 = 1
        SQL.ADD(" UNION ")
    ENDIF
    (.'FINDEB3'.)
ENDIF

SQL.ADD(" Order By 1, 7, 5, 8 Desc, 10 ")
Message('                Buscando Informacion Vehiculo '~Reemplazar(Mayusculas2(Dialogo.vehiculo1),"'"," ")~'......')
ACN(XX:1, fac)
Recorrer SQL
    Message('Procesando Operacion: '~fbn('NrOperacion'))
    IF Dialogo.Radio4 = 0
        ***---Expresado en $
        IF Eqstr(fbn('Especie'), Var('MONELOCA'))
            ACN(IM:1, fbn('Importe'))
        ELSE
            IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
                ACN(IM:1, fbn('Importe') * Val(CX:1))
            ELSE
                ACN(CX:2, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONELOCA')))
                ACN(IM:1, fbn('Importe') * Val(CX:2))
            ENDIF
        ENDIF
    ELSE
        ***---Expresado en U$S
        IF Eqstr(fbn('Especie'), Var('MONEEXTR'))
            ACN(IM:1, fbn('Importe'))
        ELSE
            IF Eqstr(fbn('Especie'), Var('MONELOCA'))
                ACN(IM:1, fbn('Importe') * Val(CL:1))
            ELSE
                ACN(CX:2, CotizacionC(fbn('Especie'),,,, Dialogo.Fecha1, 1, SI, Var('MONEEXTR')))
                ACN(IM:1, fbn('Importe') * Val(CX:2))
            ENDIF
        ENDIF
    ENDIF
    IF Val(BD:1) = 0 Y Val(BD:2) = 0
        ***---Primer Registro
        ACT(B:fac, Reemplazar(Mayusculas2(Dialogo.Vehiculo1), "'", " "))
        SetFont(B:fac, 5)
        SetFilaActual(fac+2)
    ENDIF
    IF fbn('Plazo') > 365
        IF Val(BD:1) = 0
            ***---Primer registro LONG TERM
            IF Val(BD:2) = 1
                ***---Ya hubo registros Short Terms
                InsertarFila(Val(XX:1)+2)
                InsertarFila(Val(XX:1)+2)
                InsertarFila(Val(XX:1)+2)
                SCN(FI:2, 3)
                SCN(FI:3, 3)
            ENDIF
            ACT(B:Val(XX:1)+3, 'LONG TERM LOANS')
            ACN(FI:1, Val(XX:1)+4)
            SetFont(B:Val(XX:1)+3, 3)
        ENDIF
        IF Not Eqstr(fbn('NrOperacion'), Val(NR:1))
            ***---Cambio de Operacion
            ACT(X:1, fbn('BD1'))
            IF Dialogo.Check3 = 1
                ACT(X:2, fbn('DescImp'))
            ENDIF
            SCN(CT:1, 1)
            IF Val(BD:1) = 1
                InsertarFila(Val(FI:1)+1)
                SCN(FI:1, 1)
                SCN(FI:2, 1)
                SCN(FI:3, 1)
            ENDIF
            ACN(BD:1, 1)
            ACN(K:Val(FI:1), 0)
            ACT(NR:1, fbn('NrOperacion'))
            ACN(A:Val(FI:1), Trunc(Val(CT:1)))
            ACN(LG:1, 15 - Longitud(Copy(fbn('Cliente1'), 1, 15)))
            ACT(B:Val(FI:1), Copy(fbn('Cliente1'), 1, 15)~' '~Copy(fbn('Observaciones'), 1, 22+Val(LG:1)))
            ACT(C:Val(FI:1), fbn('NrOperacion'))
            ACLO(C:Val(FI:1), fbn('NrOperacion'))
        ELSE
            IF [Eqstr(fbn('DescImp'), Val(X:2)) Y Eqstr(fbn('BD1'), 'Imp')] O [Not Eqstr(fbn('BD1'), 'Imp') Y Eqstr(Val(X:1), fbn('BD1'))]
                ***---Escribo en fila anterior
                DFA
            ELSE
                InsertarFila(Val(FI:1)+1)
                SCN(FI:1, 1)
                SCN(FI:2, 1)
                SCN(FI:3, 1)
                ACN(K:Val(FI:1), 0)
                ACT(X:1, fbn('BD1'))
                IF Dialogo.Check3 = 1
                    ACT(X:2, fbn('DescImp'))
                ENDIF
            ENDIF
        ENDIF
        IF Eqstr(fbn('BD1'), 'Imp')
            ACT(D:Val(FI:1), fbn('DescImp'))
            IF fbn('Tasa') > 0
                ACT(D:Val(FI:1), Val(D:Val(FI:1))~' '~Fstr(fbn('Tasa'), 0, 2)~'%')
            ENDIF
        ELSE
            ACT(D:Val(FI:1), fbn('BD1'))
        ENDIF
        ***---Determino columna del semestre
        Recorrer&k 0, 5
            IF Mes(fbn('Vto')) = Mes(SumarMeses(Dialogo.Fecha1, &k))
                SCN(5+&k:Val(FI:1), Val(IM:1))
                SCN(CO:&k+1, Val(IM:1))
                SCN(K:Val(FI:1), Val(IM:1))
                IF Dialogo.Check2 = 1 O Dialogo.Check3 = 1
                    ***---Totalizadores por Intereses e Impuestos
                    IF Eqstr(fbn('BD1'), 'Ints')
                        SCN(CI:&k+1, Val(IM:1))
                    ELSE
                        IF Eqstr(fbn('DescImp'), 'Impto.Int')
                            SCN(CS:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'whith tax')
                            SCN(CW:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'Comisiones')
                            SCN(CC:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'Comisiones CEC')
                            SCN(CE:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'IVA')
                            SCN(CV:&k+1, Val(IM:1))
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        Proximo
    ELSE
        IF Val(BD:2) = 0
            ***---Primer registro SHORT TERM
            IF Val(BD:1) = 1
                ***---Ya hubo registros LONG TERM
                ACN(FI:2, Val(FI:1)+2)
                ACT(B:Val(FI:2), 'TRADE LOANS')
                ACN(BD:2, 1)
                SCN(FI:2, 1)
                ACT(B:Val(FI:2), 'Short Term')
                ACN(FI:3, Val(FI:2))
            ELSE
                ACT(B:fac, 'TRADE LOANS')
                ACN(BD:2, 1)
                ifa
                ACT(B:fac, 'Short Term')
                ACN(FI:2, fac)
                ACN(FI:3, fac)
            ENDIF
        ENDIF
        IF Not Eqstr(fbn('NrOperacion'), Val(NR:1))
            ***---Cambio de Operacion
            ACT(NR:1, fbn('NrOperacion'))
            ACT(X:3, fbn('BD1'))
            IF Dialogo.Check3 = 1
                ACT(X:4, fbn('DescImp'))
            ENDIF
            SCN(FI:2, 1)
            ACN(K:Val(FI:2), 0)
            ACN(LG:1, 15 - Longitud(Copy(fbn('Cliente1'), 1, 15)))
            ACT(B:Val(FI:2), Copy(fbn('Cliente1'), 1, 15)~' '~Copy(fbn('Observaciones'), 1, 22+Val(LG:1)))
            ACT(C:Val(FI:2), fbn('NrOperacion'))
            ACLO(C:Val(FI:2), fbn('NrOperacion'))
        ELSE
            IF [Eqstr(fbn('DescImp'), Val(X:4)) Y Eqstr(fbn('BD1'), 'Imp')] O [Not Eqstr(fbn('BD1'), 'Imp') Y Eqstr(Val(X:3), fbn('BD1'))]
                ***---Escribo en fila anterior
                DFA
            ELSE
                SCN(FI:2, 1)
                ACN(K:Val(FI:2), 0)
                ACT(X:3, fbn('BD1'))
                IF Dialogo.Check3 = 1
                    ACT(X:4, fbn('DescImp'))
                ENDIF
            ENDIF
        ENDIF
        IF Eqstr(fbn('BD1'), 'Imp')
            ACT(D:Val(FI:2), fbn('DescImp'))
            IF fbn('Tasa') > 0
                ACT(D:Val(FI:2), Val(D:Val(FI:2))~' '~Fstr(fbn('Tasa'), 0, 2)~'%')
            ENDIF
        ELSE
            ACT(D:Val(FI:2), fbn('BD1'))
        ENDIF
        ***---Determino columna del semestre
        Recorrer&k 0, 5
            IF Mes(fbn('Vto')) = Mes(SumarMeses(Dialogo.Fecha1, &k))
                SCN(5+&k:Val(FI:2), Val(IM:1))
                SCN(CO:&k+1, Val(IM:1))
                SCN(K:Val(FI:2), Val(IM:1))
                IF Dialogo.Check2 = 1 O Dialogo.Check3 = 1
                    ***---Totalizadores por Intereses e Impuestos
                    IF Eqstr(fbn('BD1'), 'Ints')
                        SCN(CI:&k+1, Val(IM:1))
                    ELSE
                        IF Eqstr(fbn('DescImp'), 'Impto.Int')
                            SCN(CS:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'whith tax')
                            SCN(CW:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'Comisiones')
                            SCN(CC:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'Comisiones CEC')
                            SCN(CE:&k+1, Val(IM:1))
                        ENDIF
                        IF Eqstr(fbn('DescImp'), 'IVA')
                            SCN(CV:&k+1, Val(IM:1))
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        Proximo
    ENDIF
Proximo
IF Val(BD:2) = 1
    ***---Numero los registros Short Term
    Recorrer&k Val(FI:3), Val(FI:2)
        IF Not CeldaVacia(C:&k)
            SCN(CT:1, 1)
            ACN(A:&k, Trunc(Val(CT:1)))
        ENDIF
        SetFont(B:Val(FI:3)-1, 3)
        SetFont(B:Val(FI:3), 2)
    Proximo
ENDIF
IF Val(FI:1) > Val(FI:2)
    ACN(FI:2, Val(FI:1))
ENDIF
IF Val(BD:1) = 0 Y Val(BD:2) = 0
    ***---No hay registros
    ACN(FI:2, Val(FX:1))
    ACT(B:Val(FI:2)+1, Reemplazar(Mayusculas2(Dialogo.Vehiculo1), "'", " "))
    SetFont(B:Val(FI:2)+1, 5)
ENDIF
FormatoCeldas(A:Val(XX:1)..A:Val(FI:2), Exe('F0'))
AlinearCeldas(A:Val(XX:1)..A:Val(FI:2), 'C')
SCN(FI:2, 1)
AgregarMarco(A:Val(XX:1)..A:Val(FI:2), 1, 0)
AgregarMarco(B:Val(XX:1)..D:Val(FI:2), 1, 0)
AgregarMarco(E:Val(XX:1)..K:Val(FI:2), 1, 2)
SCN(FI:2, 1)
ACT(C:Val(FI:2), 'TOTAL')
Recorrer&k 1, 6
    ACN(4+&k:Val(FI:2), Val(CO:&k))
    SCN(CO:7, Val(CO:&k))
Proximo
ACN(K:Val(FI:2), Val(CO:7))
SetFont(C:Val(FI:2)..K:Val(FI:2), 2)
SetFont(K:9..K:Val(FI:2), 2)
AgregarMarco(A:Val(FI:2)..A:Val(FI:2), 1, 2, Exe('COLOR6'))
AgregarMarco(B:Val(FI:2)..D:Val(FI:2), 1, 0, Exe('COLOR6'))
AgregarMarco(E:Val(FI:2)..K:Val(FI:2), 1, 2, Exe('COLOR6'))

IF Dialogo.Check1 = 0
    ***---Cuadro para informe INTEREST EXPENSES
    ACN(FI:5, Val(FI:2))
    IF Dialogo.Check2 = 1 Y Dialogo.Check3 = 1
        SCN(FI:2, 2)
        ACT(C:Val(FI:2), 'INTERESES')
        Recorrer&K 1, 6
            ACN(4+&k:Val(FI:2), Val(CI:&k))
            SCN(CI:7, Val(CI:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CI:7))
        SetFont(C:Val(FI:2), 2)
        SetFont(K:Val(FI:2), 2)
    ENDIF
    IF Dialogo.Check3 = 1
        IF Dialogo.Check2 = 1
            SCN(FI:2, 1)
        ELSE
            SCN(FI:2, 2)
        ENDIF
        ACT(C:Val(FI:2), 'Impuestos Internos')
        Recorrer&K 1, 6
            ACN(4+&k:Val(FI:2), Val(CS:&k))
            SCN(CS:7, Val(CS:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CS:7))
        SCN(FI:2, 1)
        ACT(C:Val(FI:2), 'With. TAX')
        Recorrer&K 1, 6
            ACN(4+&k:Val(FI:2), Val(CW:&k))
            SCN(CW:7, Val(CW:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CW:7))
        SCN(FI:2, 1)
        ACT(C:Val(FI:2), 'I.V.A.')
        Recorrer&K 1, 6
            ACN(4+&k:Val(FI:2), Val(CV:&k))
            SCN(CV:7, Val(CV:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CV:7))
        SCN(FI:2, 1)
        ACT(C:Val(FI:2), 'Comisiones')
        Recorrer&K 1, 6
            ACN(4+&k:Val(FI:2), Val(CC:&k))
            SCN(CC:7, Val(CC:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CC:7))
        SCN(FI:2, 1)
        ACT(C:Val(FI:2), 'Comisiones CEC')
        Recorrer&K 1, 6
            ACN(4+&k:Val(FI:2), Val(CE:&k))
            SCN(CE:7, Val(CE:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CE:7))
        SetFont(C:Val(FI:2)-4..C:Val(FI:2), 2)
        SetFont(K:Val(FI:2)-4..K:Val(FI:2), 2)
        SCN(FI:2, 1)
        Recorrer&k 1, 6
            ACN(4+&k:Val(FI:2), Val(CO:&k))
        Proximo
        ACN(K:Val(FI:2), Val(CO:7))
        AgregarMarco(E:Val(FI:2)..K:Val(FI:2), 1, 2, Exe('COLOR6'))
        SetFont(E:Val(FI:2)..K:Val(FI:2), 2)
    ENDIF
    AgregarMarco(A:Val(FI:5)..D:Val(FI:2), 1, 0)
    AgregarMarco(E:Val(FI:5)..K:Val(FI:2), 1, 2)
ENDIF
SetMargins(0, 1, 0, 1)
RangoTitulo(A:1..L:Val(FI:2)+1, 8)
LimitesVision(L:Val(FI:2)+1)
SetPrintFit(3, 86)