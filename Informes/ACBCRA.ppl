*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha '  ;;;;;;;;;FSys
  Radio1   : '|Total|Consumido|Excesos';;;;;;;;;0
  Cliente1 : 'Cliente' ;
  VEHICULO1: 'Vehiculo' ;;;;;;;;;var('VEHICULODE')
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

ACT(a:4, 'Asistencia Crediticia BCRA')
ACT(a:5, 'Fecha: '~Fecha(Dialogo.Fecha1))
if Dialogo.Radio1=1
  ACT(a:6, 'Solo Consumidos')
endif
if Dialogo.Radio1=2
  ACT(a:6, 'Solo Excedidos')
endif
ACT(a:8, 'RPC:')
*ACN(c:8, BuscarCampo('CLIENTES','RPC','Codigo','INGBA'))
ACN(c:8, BuscarCampo('CLIENTES','RPC','Codigo',Dialogo.Vehiculo1))

ACT(a:10, 'Entidad')
ACT(b:10, '%')
ACT(c:10, 'Limite')
ACT(d:10, 'Consumido')
ACT(e:10, 'Disponible')
AlinearCeldas(b:10..e:10,'D')
AgregarMarco(a:10..e:10,1,2,Exe('COLOR6'))

SetFilaActual(10)
SQL.ADD("Select Codigo, RazonSocial, Vinculado from "~DBO~".CLIENTES")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" Where Codigo = '"~Dialogo.Cliente1~"' ")
endif
Recorrer SQL
  if EsTerminal(fbn('Codigo'), Cliente)
       ACT(a:fac, fbn('Codigo'))
       ACN(b:fac, iif(DesciendeDeCliente(FBN['Codigo'],'BLOCAL'),Var('RPCBLOC'),iif((DesciendeDeCliente(FBN['Codigo'],'VINCULADOS') o EqStr(FBN['Vinculado'],'SI')),Var('RPCVIN'),Var('RPCCLI'))))
       ACN(c:fac, BuscarCampo('CLIENTES','RPC','Codigo',Dialogo.vehiculo1)*iif(DesciendeDeCliente(FBN['Codigo'],'BLOCAL'),Var('RPCBLOC'),iif((DesciendeDeCliente(FBN['Codigo'],'VINCULADOS') o EqStr(FBN['Vinculado'],'SI')),Var('RPCVIN'),Var('RPCCLI')))/100)
       ACN(d:fac, LimConsumido(fbn('Codigo'), 'BCRAN'     ,'ARP',0,Dialogo.vehiculo1,,,,Dialogo.Fecha1))
       SCN(d:fac, LimConsumido(fbn('Codigo'), 'ACROFEX' ,'ARP',0,Dialogo.vehiculo1,,,,Dialogo.Fecha1))
       SCN(d:fac, LimConsumido(fbn('Codigo'), 'ACMAN' ,'ARP',0,Dialogo.vehiculo1,,,,Dialogo.Fecha1))
       ACN(e:fac, Val(c:fac)-Val(d:fac))

       if Val(d:fac)<>0
**          if Eqstr(Val(a:fac),VAR('CLIROFEX'))
             AsignarLink(d:fac,'DETLC2',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),Vehiculo1=Dialogo.vehiculo1,TipoLimite1='')
**          else
**             AsignarLink(d:fac,'DETLC2',Fecha1=Dialogo.Fecha1,Cliente1=Val(a:fac),Vehiculo1=Dialogo.vehiculo1,TipoLimite1='BCRAN')
**          endif
       endif
       
       if Dialogo.Radio1=1 y Val(d:fac)=0
          BorrarCeldas(a:FAC..s:FAC)
          DFA
       endif

       if Dialogo.Radio1=2 y Val(d:fac)>=0
          BorrarCeldas(a:FAC..s:FAC)
          DFA
       endif
  else
    dfa
  endif
proximo

AgregarMarco(a:11..a:fac,1)
AgregarMarco(b:11..e:fac,1)

SetFont(a:1..az:10, 1)
SetFont(a:11..az:fac, 2)
FormatoCeldas(b:11..b:fac, Exe('F0'))
FormatoCeldas(c:8..e:fac, Exe('F2'))

ACO(1,8)
ACO(2,3)
ACO(3,9)
ACO(4,9)
ACO(5,9)

LimitesVision(e:fac+1)
