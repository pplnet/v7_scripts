ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1: "Operacion"        ;;;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar operacion';NO;;;;;;" TipoOp In ('FCR') ";
FinDialogo

If Not OK
  Cancelar
Endif
CrearFont(1,"Arial,11,")
CrearFont(2,"Arial,11,B")
CrearFont(3,"Arial,11,BU")
CrearFont(4,"Arial,11,U")
CrearFont(5,"Arial,8,")
CrearFont(6,"Arial,10,")
CrearFont(7,"Arial,9,")
CrearFont(8,"Arial,12,B")
CrearFont(9,"Arial,11,I")
CrearFont(10,"Arial,7,")
SQL.ADD("Select O.TipoOp, O.Cliente1,O.Especie,O.Vehiculo1,O.NrOperacion,O.Cuenta1,O.Cuenta2,O.TotalNetoCli1,O.ContraEspecie, ")
SQL.ADD("C.Localidad, C.Telefono, C.Fax,C.CUIT, C.RazonSocial, C.Direccion,C.CodigoPostal,C.PaisDir,C.Provincia, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O ,"~DBO~".CLIENTES C   ")
SQL.ADD(" Where NrOperacion ='"~Dialogo.NrOperacion1~"' and O.Vehiculo1=C.Codigo  ")
Recorrer SQL
  ACT(zd:99, fbn['TipoOp'])
  ACT(zz:98, fbn['ContraEspecie'])  
  ACT(za:99, fbn['Cuenta2']) 
  ACN(zb:99, fbn['TotalNetoCli1'])
  ACT(zy:99, fbn['Localidad'])
  ACT(zz:99, fbn['Vehiculo1'])
  ACT(aa:99, fbn['NrOperacion'])
  ACT(ab:99, fbn['Cuenta1'])    
  ACT(ab:1,fbn['RazonSocial'])
  ACT(ac:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Cliente1' ]))
  ACT(aa:1, BuscarCampo('ESPECIES','Nombre'     ,'Codigo',Fbn['Especie']))
  ACT(or:1, BuscarCampo('ESPECIES','Extendido'  ,'Codigo',Fbn['Especie']))
  ACT(ad:1,fbn['CUIT'])
  ACT(af:1, BuscarCampo('CUENTAS','CBU'         ,'Codigo',Fbn['Cuenta1']))
  ACT(af:2, BuscarCampo('CUENTAS','CBU'         ,'Codigo',Fbn['Cuenta2']))
  ACT(cc:1, BuscarCampo('ESPECIES','Codigo'     ,'Codigo',Fbn['Especie']))
  ACT(mm:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CUENTAS','Cliente','Codigo',Fbn['Cuenta1'])))
  ACT(mm:2, BuscarCampo('CLIENTES','RazonSocial','Codigo',BuscarCampo('CUENTAS','Cliente','Codigo',Fbn['Cuenta2'])))
  ACT(af:99,BuscarCampo('CUENTAS','Alias9'       ,'Codigo',Fbn['Cuenta1']))
  ACT(ta:1,fbn['Telefono'])
  ACT(tb:1,fbn['Fax'])
  ACT(tc:1,fbn['Direccion'])
  ACT(td:1,fbn['CodigoPostal'])
  ACT(te:1,BuscarCampo('PAISES','Nombre','Codigo',fbn['PaisDir']))
  ACT(tf:1,BuscarCampo('PROVINCIAS','Nombre','Codigo',fbn['Provincia']))
  ACD(FE:1, fbn('FechaOp'))
if EqStr(val(zz:98),var('MONEEXTR')) 
   ACT(cc:88,'u$s' )
   ACT(cc:66,'dolares') 
   else
   if EqStr(val(zz:98),var('MONELOCA'))    
      ACT(cc:88,'$' )
      ACT(cc:66,'pesos')
      else     
      ACT(cc:88,val(zz:98) )
   endif  
endif
Proximo
If EqStr(val(cc:1),var('AHORROPL'))
   SetFilaActual(5) 
   ***---ACT(g:fac, val(zy:99)~', '~FStr(Dia(Fsys),2,0)~' de ' ~ Meses(Mes(Fsys))~' de ' ~ FStr(Anio(Fsys),4,0)~'.')
   ACT(g:fac, val(zy:99)~', '~FStr(Dia(Val(FE:1)),2,0)~' de '~Meses(Mes(Val(FE:1)))~' de '~FStr(Anio(Val(FE:1)),4,0)~'.')
   ACT(a:fac+1, UsuarioActivo~'-'~val(aa:99))
   AFI(fac+2,8)
   ACT(a:fac+3,'Sres.')
   ACT(a:fac+4,val(ac:1))
   ACT(a:fac+5,'Presente')
   ACT(A:fac+7,'De nuestra consideracion:')
   SetFont(a:fac..g:fac+7,1)
   SetFont(a:fac+5,4)
   SetFilaActual(fac+8)
   ACN(Fh:1,Fac)   
   ACT(TX:1,'       Por intermedio de la presente les solicitamos a ustedes RESCATE de la totalidad de cuotapartes del fondo '~val(aa:1)~' a nombre de '~val(ab:1)) 
   ACN(CR:1, 90)
   (.'LINEAS'.)   
   Recorrer&k 1, Val(FI:2)
      ACT(A:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa
      AFI(fac, 8)
      Ifa
   Proximo
   SetFont(a:val(Fh:1)..a:val(Fh:1)+val(Fi:2),1)
   SetFilaActual(fac)
   ACN(Fh:1,Fac)
   ACT(TX:1,'       Asimismo solicitamos que el producido de este rescate sea transferidos a nuestra cuenta '~val(za:99)~' CBU: '~val(af:2)~'  en '~val(mm:2)~' y nos comprometemos a enviar el original de la presente nota a vuestras oficinas y a retirar los formularios de liquidacion correspondientes dentro de las 24 horas habiles.') 
   ACN(CR:1, 90)
   (.'LINEAS'.)   
   Recorrer&k 1, Val(FI:2)
      ACT(A:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa
      IF &k < Val(FI:2)
      AFI(fac, 8)
      ENDIF
      Ifa
   Proximo
   SetFont(a:val(Fh:1)..a:val(Fh:1)+val(Fi:2)+2,1)
   SetFilaActual(fac)   
   ACT(a:fac,'Dejamos constancia que hemos recibido, conocemos y adherimos al Reglamento de Gestion del Fondo Comun')
   Ifa
   ACT(a:fac,'de Inversion respectivo.')
   SetFont(a:fac-1..a:fac+1,7)
   ACT(a:fac+1,'Asimismo declaramos que:')
   SetFont(a:fac+1,7)
   IFA
   AFI(FAC,2)
   IFA   
   ACN(dd:99,FAC)
   ACT(a:FAC,'             ·')
   SETFONT(a:Fac,8) 
   ACT(tx:1,var('PIEAHORRO1')~var('PIEAHORRO2')~var('PIEAHORRO3')~var('PIEAHORRO4'))
   ACN(CR:1, 100)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ACT(B:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa     
   Proximo
   ACT(a:FAC+1,'             ·')
   SETFONT(a:Fac+1,8) 
   ACN(FI:80,Val(FI:2))     
   ifa
   ACT(tx:1,var('PIEAHORRO5')~var('PIEAHORRO6'))
   ACN(CR:1, 110)
   (.'LINEAS'.)
   Recorrer&k 1, Val(FI:2)
      ACT(B:Fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
      Ifa     
   Proximo
   ACN(FI:90,Val(FI:2)+VAL(FI:80) )
   SetFont(b:VAL(dd:99)..b:VAL(dd:99)+Val(FI:90),5)
   SetFilaActual(fac+1)   
   ACT(b:fac,'Sin otro particular, los saludamos a ustedes muy atte.-')
   SetFont(b:fac,1)
   SetFilaActual(fac+4)
Else

   **otra carta**

   SetFilaActual(5) 
   ***---ACT(j:fac, val(zy:99)~', '~FStr(Dia(Fsys),2,0)~' de ' ~ Meses(Mes(Fsys))~' de ' ~ FStr(Anio(Fsys),4,0)~'.')
   ACT(j:fac, val(zy:99)~', '~FStr(Dia(Val(FE:1)),2,0)~' de '~Meses(Mes(Val(FE:1)))~' de '~FStr(Anio(Val(FE:1)),4,0)~'.')
   AlinearCeldas(J:FAC,'D')
   ACT(a:fac+2, UsuarioActivo~'-'~val(aa:99))
   ACT(a:fac+4,'Señores')
   ACT(a:fac+6,val(ac:1))
   ACT(a:fac+8,'Presente')
   ACT(j:fac+10,'Ref.: Rescate Fondos Comun de Inversion')
   AlinearCeldas(j:fac+10,'D')   
   ACT(a:fac+12,val(ab:1))
   ACT(a:fac+13,'Cuenta cuotapartista nº '~val(af:99))
   ACT(a:fac+15,'De nuestra consideracion:')
   AFI(fac+16,8) 
   ACT(d:fac+17,'Por medio de la presente les solicitamos tengan a bien de rescatar')
   AFI(fac+18,8)
   ACT(a:fac+19,'pesos del Fondo Comun de Inversion que detallamos a continuacion:')   
   ACT(a:fac+21,val(or:1)~' FCI por un total de ' ~val(cc:66)~' '~val(cc:88)~PYC(val(zb:99),0,0) ~'.-')
   ACT(d:fac+23,'Asimismo, les solicitamos y autorizamos a acreditar el total a') 
   AFI(fac+24,8)   
   ACT(a:fac+25,'nuestra Cuenta Corriente en pesos numero ' ~val(ab:99) ~' del '~val(mm:1)~'') 
   AFI(fac+26,8)
   ACT(a:fac+27,' C.B.U. '~val(af:1))
   AFI(fac+28,8)   
   ACT(d:fac+30,'Sin otro motivo, saludo a Uds., muy atentamente.')       
   setfont(a:fac..j:fac+32,1)
   setfont(a:fac+4,2)
   setfont(a:fac+8,3)
   setfont(j:fac+10,9)
   SetFilaActual(fac+34)   
Endif
AgregarBMP(a:1,Var('PATHLOGO')~val(zz:99)~'.bmp',80)
ACT(h:fac,val(ab:1))
ACT(h:fac+1,'CUIT:'~val(ad:1) )
SetFont(f:fac..h:fac+1,1)
ACT(h:50,'Tel: '~val(ta:1))
ACT(h:51,'Fax: '~val(tb:1))
ACT(h:52,val(tc:1))
ACT(h:53,val(td:1)~'-'~val(tf:1)~'-'~val(te:1)) 
SetFont(h:50..h:53,10)
LimitesVision(l:53)
  Recorrer&I 50,53
     AFI(&I,7)
  Proximo
SetMargins(1.5,1,1.5,1)
Impresion(2,0)
Impresion(3,0)
