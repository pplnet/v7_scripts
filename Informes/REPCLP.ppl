AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
(.'DIALOGOPNL'.)
&DifDias := DifDias(Dialogo.Fecha2,Dialogo.Fecha1,no,no) + 1
********************************************ANOTACIONES****************************************************************
*AA Saldos
    *AA:1  Saldo para MMCREM a ese dia(pesificado)
    *AA:2  SNC suma de saldos MMCREM
    *AA:3  Promedio de saldos dividido en la cantidad de fechas que 
    *AA:4 Pivote para guardar la cantidad para las operaciones de Tipo MMCO/MMCT/MMPF
*BB P&L
    *BB:1  SNC suma de P&LMMCREM ese dia(pesificado)
*CC Fechas para operaciones de Tipo MMCO/MMCT/MMPF
    *CC:1 FechaDesde
    *CC:2 FechaHasta     
*DD Controles de igualdad
    *DD:1 Valor de FAC donde se guardara el mismo Cliente
    *DD:2 Valor de FAC donde se guardara el mismo Cliente pero diferente Operacion
    *DD:3 Valor de FAC donde se guardara el mismo Cliente pero diferente Cuenta
*EE Tasa Promedio Ponderada
    *EE:1 Cantidad 
*****************************************FIN ANOTACIONES****************************************************************
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

*********************************************ENCABEZADOS****************************************************************
ACT(a:fac+6,'P&L Tasa de Transferencia- Por Cliente y Producto')
SetFont(a:fac+6,1)
(.'ENCABEPNL'.)
*****************************************FIN ENCABEZADOS****************************************************************
*SetFilaActual(13)
ACN(w1,FAC)


ACT(a:fac, 'Codigo del Cliente')
ACT(b:fac, 'Tipo y numero de documento')
ACT(c:fac, 'Razon social')
ACT(d:fac, 'Tipo de Operación')
ACT(e:fac, 'Tasa Promedio Ponderada')
ACT(f:fac, 'Capital Promedio')
ACT(g:fac, 'P&L Período')
ACT(h:fac, 'Oficial')
SetFont(a:FAC..h:FAC,1)
AgregarMarco(a:FAC..h:FAC,1,0,Exe('COLOR6'))
AlinearCeldas(e:FAC..g:fac,'D')

*Recorrer SQL operaciones 
(.'CONSPRETSA'.)
SQL.ADD("Order BY O.Cliente1,  O.TipoOp,O.Cuenta1 ")



Recorrer SQL
    DFA
    &TipoOp := FBN['TipoOp']
    
    *validacion check
    IF Dialogo.Radio2 = 0
        *PRECIO
        
    ELSE
        &DifDiasMMCREM := &DifDias
        &AuxDia :=&DifDiasMMCREM
        &CodigoCliente := FBN['Cliente1']
        &TasaOP := Num(FBN['Precio1'])
        *Tasa de transf 
        &TasaTransf := Num(FBN['Precio4'])
        *Fecha Vencimiento de la operacion
        &FechaVto := FBN['FechaVto']
        *Fecha de la Operacion
        &FechaOp := FBN['FechaOp']
        &CodigoCuenta : = FBN['Cuenta1']
        &CuentaEspCliente : = FBN['Cuenta3']
*        If EqStri(&TipoOp, 'MMCT') O EqStri(&TipoOp, 'MMCO')
*             &CodigoCuenta := FBN['Cuenta3']
*        Endif
        
        *Saber si el cliente es el mismo
        IF NOT Eqstr(&CodigoCliente, Val(A:Val(DD:1)))
            IFA
            ACN(DD:1,FAC)
            ACT(A:VAL(DD:1),&CodigoCliente)
            *TASA
            *CodigoCliente
            ACT(A:VAL(DD:1),FBN['Codigo'])
            
            if EqStri(FBN['CategDepositante'], 'FON')
                ACT(B:VAL(DD:1),FBN['TipoDocum']~" "~FBN['NrDocum'])
            else
                ACT(B:VAL(DD:1),FBN['TipoInscripcion']~" "~FBN['CUIT'])
            endif
            *Razon social
            ACT(C:VAL(DD:1),FBN['RazonSocial'])
            ACT(D:VAL(DD:1),'TOTAL')
            ACL(D:VAL(DD:1), 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=Dialogo.Lista1,Cliente1= Val(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            ACT(H:VAL(DD:1),FBN['OficialCuenta']~" - "~SQL("SELECT Descripcion FROM "~DBO~".OFICIALESCUENTA WHERE Codigo ='"~FBN['OficialCuenta']~"'"))
            AgregarMarco(b:VAL(DD:1)..g:VAL(DD:1),1,0,Exe('COLOR13'))
            SetFont(D:VAL(DD:1), 1)
            ACN(ZZ:1,0)
            ACN(ZZ:2,0)
            ACN(ZZ:3,0)
            ACN(ZZ:4,0)
        ENDIF
      
         IF NOT Eqstr(&TipoOp, Val(D:FAC))
            IFA
            ACN(DD:2,FAC)
            ACT(D:FAC,&TipoOp)
            if Eqstr(&TipoOp, 'MMCREM')
                ACL(D:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=&TipoOp,Cliente1=  Val(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)              
            else
                ACL(D:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=&TipoOp,Cliente1=  Val(A:VAL(DD:1)), OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico)
            endif

            ACN(DD:2,FAC)
            ACN(ZZ:1,0)
            ACN(ZZ:2,0)
            ACN(ZZ:3,0)
            ACN(ZZ:4,0)
*            ACT(D:FAC,&TipoOp)
*            ACL(D:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=&TipoOp,Cliente1= Dialogo.Cliente1, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
            *ACT(DD:3, &CodigoCuenta)
            *         Else If Eqstr(&TipoOp, 'MMCREM') Y NOT Eqstr(&CodigoCuenta, Val(DD:3))
*                IFA
*                ACN(DD:2,FAC)
*                ACT(D:FAC,&TipoOp)
*                ACL(D:FAC, 'REPDET', Fecha1= Dialogo.Fecha1, Fecha2= Dialogo.Fecha2,Lista1=&TipoOp,Cliente1= Dialogo.Cliente1, OficialCuenta=Dialogo.OficialCuenta,Radio1=Dialogo.Radio1,Radio2=Dialogo.Radio2,Radio3=Dialogo.Radio3,Radio4=Dialogo.Radio4,GrupoEconomico = Dialogo.GrupoEconomico,Cuenta1 = Dialogo.Cuenta1)
*                ACT(DD:3, &CodigoCuenta)
*            ENDIF
        Else
            ACN(ZZ:1,Val(ZZ:1))
            ACN(ZZ:2,Val(ZZ:2))
            ACN(ZZ:3,Val(ZZ:3))
            ACN(ZZ:4,Val(ZZ:4))
            If EqStri(&TipoOp, 'MMCREM')
                ACN(E:Val(DD:2),Val(ZZ:1)/Val(ZZ:2))
            else
                ACN(E:Val(DD:2),Val(ZZ:3)/Val(ZZ:4))
            endif
        ENDIF

        If EqStri(&TipoOp, 'MMCREM')
            &TasaOpPonderada := &TasaOpPonderada + &TasaOP
             If DifDias(Dialogo.Fecha1,FBN['FechaVto'],no,no) = 0
            ELSE
                Recorrer&i 0, Num(&DifDiasMMCREM)
                    *Capital 
                    ACN(AA:5,SQL("SELECT CASE WHEN NOT EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"') THEN 1 WHEN EXISTS (SELECT 1 FROM "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"' AND SALDO < 0) THEN 2 ELSE 3 END AS CodigoResultado;"))
                    *Val(AA:5) = 2 El saldo existe pero es negativo
                    IF Dialogo.Fecha1+&i >= &FechaOp Y   ((Dialogo.Fecha1+&i) < &FechaVto) Y Dialogo.Fecha1+&i <= Dialogo.Fecha2
                        IF Val(AA:5) = 2
                            &DifDiasMMCREM := &DifDiasMMCREM - 1
                            ELSE IF  DifDias(Dialogo.Fecha1 + &i,FBN['FechaVto'],no,no) = 0
                                *Val(AA:5) = 1 El saldo NO existe para ese dia
                                ELSE IF Val(AA:5) = 1
                                        If Dialogo.Radio4 =0
                                            ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
                                        else 
                                            ACN(AA:1,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                        endif
                                    ELSE
                                        *El saldo existe y no es negativo para ese dia
                                        If Dialogo.Radio4 =0
                                            ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
                                        else 
                                            ACN(AA:1,SQL("Select SALDO from "~DBO~".SALDOSREM WHERE Fecha = '"~IDxDate(Dialogo.Fecha1+&i)~"' AND NrOperacion = '"~FBN['NrOperacion']~"'")* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
                                        endif
                                ENDIF
                            endif
                        ENDIF   
                    endif
                    SCN(AA:2,Val(AA:1))
                    SCN(BB:1,(((&TasaTransf-&TasaOP) / 365 *  Val(AA:1) ))/100)
                    SCN(AA:4,Val(AA:1)*&TasaOP)
                    ACN(AA:1,0)
                Proximo
                    
            ACN(AA:3,(Val(AA:2) / (&AuxDia)))
            SCN(F:Val(DD:1), Val(AA:3))
            SCN(G:Val(DD:1),Val(BB:1))
            SCN(F:Val(DD:2), Val(AA:3))
            SCN(G:Val(DD:2) ,Val(BB:1))
            *Tasa Promedio Ponderada
*            sCN(E:Val(DD:2),((Val(AA:4)/((Val(AA:2))))))
            *SCN(E:Val(DD:1),Val(E:Val(DD:2)))
            SCN(ZZ:1,Val(AA:4))
            SCN(ZZ:2,Val(AA:2))
            *Seteo en 0 los pivotes
            ACN(AA:1,0)
            ACN(AA:2,0)
            ACN(AA:3,0)
            ACN(BB:1,0)
            ACN(AA:4,0)
            ACN(E:Val(DD:2),(Val(ZZ:1)/Val(ZZ:2)))
            ENDIF
        Else
        (.'FECHAP&L'.)
            *Capital

            If Dialogo.Radio4 =0
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'ARP'))                
            else 
                ACN(AA:4,FBN['Cantidad']* CotizacionC(FBN['Especie'],,,,Dialogo.Fecha2,1,,'USD'))
            endif
            IF  Buscar(&TipoOp, Pipe2Comillas(Var('TIPOOPACTI')))
                *ACTIVO
                SCN(G:Val(DD:1),((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100)
                SCN(G:Val(DD:2),((((&TasaOP-&TasaTransf)/365)*Num(&DifDias2)) * Val(AA:4))/100) 
            Else 
                *Pasivo
                SCN(G:Val(DD:1),((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100)
                SCN(G:Val(DD:2),((((&TasaTransf-&TasaOP)/365)*Num(&DifDias2)) * Val(AA:4))/100)
            EndIf
            *Tasa Promedio Ponderada
            SCN(ZZ:3,((Val(AA:4)* &DifDias2)* &TasaOp))
            SCN(ZZ:4,(Val(AA:4)*&DifDias2))
            ACN(E:Val(DD:2),Val(ZZ:3)/Val(ZZ:4))
            *SCN(E:Val(DD:1),(((Val(AA:4)* &DifDias2)* &TasaOp)/(Val(AA:4)*&DifDias2)))
            
            ACN(AA:4,Val(AA:4)*&DifDias2)
            SCN(F:Val(DD:1),(Val(AA:4)/(&DifDias)))
            SCN(F:Val(DD:2),(Val(AA:4)/(&DifDias)))
            ACN(AA:4,0)
         ENDIF   
    EndIF
Proximo

*If NoVacio(Val(DD:2))
*    SetFilaActual(Val(DD:2))
*ENDIF

FormatoCeldas(E:14..E:FAC,Exe('F2'))
FormatoCeldas(F:14..F:FAC,Exe('F2'))
FormatoCeldas(G:14..G:FAC,Exe('F2'))
