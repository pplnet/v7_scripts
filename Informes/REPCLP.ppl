ACO(4,14)
ACO(5,14)
ACO(6,14)
ACO(7,14)
ACO(8,20)
RangoTitulo(a:1..h:fac, Val(w1))
SetPrintFit(3, 99)
Impresion(1, 2)

LimitesVision(I:FAC+2)
