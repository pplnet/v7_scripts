* CAIMO2 Caida de Deposito segun Moneda - Auxiliar
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1     : 'Fecha'    ;;;;;;NoVacio(Dialogo.Fecha1);'La Fecha Desde es invalida';NO;Fsys
  Lista1     : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Especie1   : 'Especie' ;;;;;;NoVacio(Dialogo.Especie1);'La Especie Es Invalida';NO;VAR('MONELOCA')
FinDialogo

if Not Ok
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC,"Caida de Depositos segun Moneda - Detalle de Operaciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Fecha Hasta : '~Dialogo.Fecha1)

If NoVacio(VAL(ZZ6))
   ACT(a:FAC+3, 'Vehiculo : '~VAL(ZZ6))
Else
   ACT(a:FAC+3, 'Vehiculo : Todos')
EndIf
ACT(a:FAC+4, 'Operaciones : Plazos Fijos')
ACT(a:FAC+5, 'Especie : '~Dialogo.Especie1)

SetFont(a:fac..N:FAC+5,2)

SetFilaActual(fac+7)

ACT(a:FAC, 'Numero Op.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'F.Carga')
ACT(d:FAC, 'F.Inicio')
ACT(e:FAC, 'F.Concert.')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Capital')
ACT(i:FAC, 'Plazo')
ACT(j:FAC, 'F.Vto.')
ACT(k:FAC, 'Tasa')
ACT(l:FAC, 'Monto')
ACT(m:FAC, 'Entidad')

SetFont(a:fac..m:FAC,2)
AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))

SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, C.Total2 Capital ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.TipoOp In ('MMCPM') ")
SQL.ADD(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, O.TotalNetoCli1 Capital ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD(" where O.TipoOp In ('MMCP') ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, O.Cantidad Capital ")
SQL.ADD(" from  "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCDIA') ")
If NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Union All")
SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, C.Cantidad3 Capital ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and  O.TipoOp In ('MMCDIA') ")
If NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Endif
SQL.ADD(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Union All")
SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, CASE Plazo2 WHEN 0 THEN O.TotalBrutoCli1 ELSE O.TotalAux3 END Capital ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCDP') ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" and ((Plazo2=0 and O.FechaVto>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto<='"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("     or (Plazo2<>0 and O.FechaVto2>='"~IdxDate(Dialogo.Fecha1)~"' and O.FechaVto2<='"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Union All")
SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, O.Cantidad Capital ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMDCA','MMCCR') ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" Union All")
SQL.ADD(" Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1, ")
SQL.ADD(" O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.TotalNetoCli1,O.Cliente1,O.Especie, O.TotalBrutoCli1 Capital ")
SQL.ADD(" from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMO') ")
if NoVacio(VAL(zz6))
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
endif
SQL.ADD(" and  O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("order by 6,1 ")
acn(x1,fac)

Recorrer SQL

  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp'])
  ACD(e:FAC, FBN['FechaOp2'])
  ACT(f:FAC, FBN['Vehiculo1'])
  ACT(g:FAC, FBN['Especie'])
  ACN(h:FAC, FBN['Capital'])
  ACN(i:FAC, FBN['Plazo'])
  ACD(j:FAC, FBN['FechaVto'])
  ACN(k:FAC, FBN['Precio1'])
  ACN(l:FAC, FBN['TotalNetoCli1'])
  ACT(m:FAC, FBN['Cliente1'])
  SetFont(a:FAC..n:FAC,1)
  FormatoCeldas(i:fac..i:fac,"0")
  FormatoCeldas(h:fac..h:fac,Exe('F2'))
  FormatoCeldas(l:fac..l:fac,Exe('F2'))
Proximo
Ifa

ACT(a:fac,'Total ')
ACN(h:fac, Sum(h:val(x1)..h:fac))
ACN(l:fac, Sum(l:val(x1)..l:fac))
SetFont(a:FAC..n:FAC,2)
FormatoCeldas(h:fac..l:fac,Exe('F2'))

