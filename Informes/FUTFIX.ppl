*ModoReproceso(ConDialogo)
ACD(x1, SQL("Select Max(FechaVto2) from "~DBO~".OPERACIONES where TipoOp in ('FXCF','FXVF')  "))
if Val(x1)<1
  ACD(x1, FSys)
endif

CrearDialogo
  Fecha1    : 'D.FechaFix' ;1;1;;;;Dialogo.Fecha1 <> 0;'FechaFix Desde Invalida';NO;Fsys
  Radio1    : 'Hasta|Hoy|Fin mes|Sig.mes|Ult.Fix.|otro';2;1;;;;;;;3;
  Fecha2    : 'H.FechaFix' ;3;1;;Dialogo.Radio1=4;;Dialogo.Fecha2 <> 0;'FechaFix Hasta Invalida';NO;;iif(Dialogo.Radio1=0,Dialogo.Fecha1,iif(Dialogo.Radio1=1,FinDeMes(Dialogo.Fecha1,NO,'ARG'),iif(Dialogo.Radio1=2,FinDeMes(FinDeMes(Dialogo.Fecha1)+7,NO,'ARG'),iif(Dialogo.Radio1=3,Val(x1),Dialogo.Fecha1))));
  Vehiculo1 : 'Vehiculo'   ;3;2;;NO;;NoVacio(DIalogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Lista1    : 'Fixing'     ;4;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where SUBSTRING(Jerarquia,7,3)<>'000' AND SUBSTRING(Jerarquia,1,6)= (Select SUBSTRING(Jerarquia,1,6) from "~DBO~".ESPECIES where Codigo='OCTFIX') ")  
  Lista2    : 'Books'      ;-2;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS  ")
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))

SetFilaActual(5)

ACT(a:fac, 'Fixing Futuros de Moneda')
ACT(a:fac+2, 'Desde: '~Dialogo.Fecha1)
ACT(d:fac+2, 'Hasta: '~Dialogo.Fecha2)
ACT(a:fac+3, 'Vehiculo: '~Dialogo.Vehiculo1)
if NoVacio(Dialogo.Lista1)
   act(d:fac+3, 'Fixing :  ' ~Dialogo.Lista1)
else
   act(d:fac+3, 'Fixing :  Todos')
endif
if NoVacio(Dialogo.Lista2)
   act(a:fac+4, 'Books :  ' ~Dialogo.Lista2)
else
   act(a:fac+4, 'Books :  Todos')
endif
SetFont(a:fac, 3)
SetFont(a:fac+2..d:fac+4, 2)

SetFilaActual(fac+6)
ACT(a:fac, 'Operacion')
ACT(b:fac, 'TipoOp')
ACT(c:fac, 'Cliente')
ACT(d:fac, 'Book')
ACT(e:fac, 'Mercado')
ACT(f:fac, 'FechaOp')
ACT(g:fac, 'FechaPrecan')
ACT(h:fac, 'FechaVto')
ACT(i:fac, 'Fixing')
ACT(j:fac, 'Cantidad')
ACT(k:fac, 'PrecioOp')
ACT(l:fac, 'Resultado')
AlinearCeldas(a:fac..l:fac, 'C')
SetFont(a:fac..l:fac, 2)
AgregarMarco(a:fac..l:fac, 0, 0, Exe('COLOR'))

* fac = 11, entonces FI:1 = 13 y FI:2 = 12
ACN(FI:1, fac+2)
ACN(FI:2, fac+1)
ACT(tp:1,'OPERACION')

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.Cantidad, O.CB6, O.Precio1, O.PrecioEj, O.ContraEspecie, ")
SQL.ADD(" Case When O.CB6 = '1' Then O.FechaPrecan Else O.FechaVto END As FechaVto, O.FechaPrecan, O.FechaVto2, ")
SQL.ADD(" O.TotalAux1, O.FechaEj, O.ContraEspecie2, O.Book1, O.Mercado4, ")
SQL.ADD(" (Select sum(MTM) from "~DBO~".MTMDIARIO MD Where MD.NrOperacion = O.NrOperacion and MD.TipoMTM = 'MTM' ) as MTMTotal ")
SQL.ADD("   From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS OB  ")
SQL.ADD("  Where O.NrOperacion = OB.NrOperacion ")
SQL.ADD("    and OB.NrBit = 30 ")
SQL.ADD("    and OB.Valor <> '1' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and O.ContraEspecie2 In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD("and O.Book1 In ("~Pipe2Comillas(Dialogo.Lista2)~")")
Endif
SQL.ADD("    and O.TipoOp IN ('FXCF','FXVF') ")
SQL.ADD("    and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("    and ((O.CB6 = '1' AND O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaPrecan <= '"~IdxDate(Dialogo.Fecha2)~"') OR ((O.CB6 <> '1' OR O.CB6 Is Null OR O.CB6 = '') AND O.FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto2 <= '"~IdxDate(Dialogo.Fecha2)~"')) ")
SQL.ADD("  Order By 12, 2, 1 ")
watch(SQL.Batch)

ACN(tp:2, 0)  
* Acumulador para Cantidad de FXCF (Compras)
ACN(tp:3, 0)  
* Acumulador para Resultado de FXCF (Compras)
ACN(tq:2, 0)  
* Acumulador para Cantidad de FXVF (Ventas)
ACN(tq:3, 0)  
* Acumulador para Resultado de FXVF (Ventas)

Recorrer SQL
  IF fbn('FechaVto2') <> Val(FV:1)
    IF Val(FV:1) <> 0
      * Imprimir totales de Compras (FXCF) si no se imprimieron
      IF Val(tp:2) > 0 OR Val(tp:3) > 0
        ACT(c:fac, 'Total Compras :')
        ACN(j:fac, Val(tp:2))
        ACN(l:fac, Val(tp:3))
        AgregarMarco(c:fac..l:fac, 0, 0, Exe('COLOR6'))
        IFA
       
      ENDIF

      * Imprimir totales de Ventas (FXVF) si no se imprimieron
      IF Val(tq:2) > 0 OR Val(tq:3) > 0
        ACT(c:fac, 'Total Ventas :')
        ACN(j:fac, Val(tq:2))
        ACN(l:fac, Val(tq:3))
        AgregarMarco(c:fac..l:fac, 0, 0, Exe('COLOR6'))
        IFA
       
      ENDIF
      
      * Calcular y mostrar el Total Neto
      
      ACT(h:fac, 'Total Neto al ')
      ACD(i:fac,Val(FV:1))
      ACN(j:fac, Val(tn:1)-Val(tn:2))
      AgregarMarco(h:fac..l:fac, 0, 0, Exe('COLOR6'))
      IFA
      IFA
      * Reiniciar acumuladores
      ACN(tp:2, 0)
      ACN(tp:3, 0)
      ACN(tq:2, 0)
      ACN(tq:3, 0) 
      ACN(tn:1, 0)
      ACN(tn:2, 0) 
      
    ENDIF
    
    * Actualizar el vencimiento actual
    ACT(A:fac, 'Vencimiento fixing:')
    ACD(B:fac, fbn('FechaVto2'))
    ACD(FV:1, fbn('FechaVto2'))
    SetFont(A:fac..B:fac, 2)
    AgregarMarco(A:fac..L:fac, 0, 0, Exe('COLOR6'))
    IFA
    ACN(FI:1, fac)
  ENDIF

  * Detectar cambio de tipo de operación dentro del mismo vencimiento
  IF EqStr(fbn('TipoOp'), 'FXVF') AND (Val(tp:2) > 0 OR Val(tp:3) > 0)
    * Imprimir totales de Compras (FXCF) antes de procesar Ventas
    ACT(c:fac, 'Total Compras :')
    ACN(j:fac, Val(tp:2))
    ACN(l:fac, Val(tp:3))
    AgregarMarco(c:fac..l:fac, 0, 0, Exe('COLOR6'))
    IFA

    * Reiniciar acumuladores de Compras
    ACN(tp:2, 0)
    ACN(tp:3, 0)
  ENDIF

  * Acumular valores según el tipo de operación
  IF EqStr(fbn('TipoOp'), 'FXCF') 
    SCN(tp:2, fbn('Cantidad'))
    SCN(tp:3, fbn('MTMTotal'))
    SCN(tn:1, fbn('Cantidad'))
    ELSE IF EqStr(fbn('TipoOp'), 'FXVF')  
    SCN(tq:2, fbn('Cantidad'))
    SCN(tq:3, fbn('MTMTotal'))
    SCN(tn:2, fbn('Cantidad'))
    ENDIF
  ENDIF

  * Imprimir detalles de la operación
  ACT(A:fac, fbn('NrOperacion'))
  ACLO(A:fac, fbn('NrOperacion'))
  ACT(B:fac, fbn('TipoOp'))
  ACT(C:fac, fbn('Cliente1'))
  ACT(d:fac, fbn('Book1'))
  ACT(e:fac, fbn('Mercado4'))
  ACD(f:fac, fbn('FechaOp'))
  ACD(g:fac, fbn('FechaPrecan'))
  ACD(h:fac, fbn('FechaVto'))
  ACT(i:fac, fbn('ContraEspecie2'))
  ACN(j:fac, fbn('Cantidad'))
  ACN(k:fac, fbn('Precio1'))
  ACN(l:fac, fbn('MTMTotal'))
Proximo

* Imprimir totales finales para el último vencimiento
IF Val(tp:2) > 0 OR Val(tp:3) > 0
  IFA
  ACT(c:fac, 'Total Compras :')
  ACN(j:fac, Val(tp:2))
  ACN(l:fac, Val(tp:3))
  AgregarMarco(c:fac..l:fac, 0, 0, Exe('COLOR6'))
  IFA
ENDIF

IF Val(tq:2) > 0 OR Val(tq:3) > 0
  IFA
  ACT(c:fac, 'Total Ventas :')
  ACN(j:fac, Val(tq:2))
  ACN(l:fac, Val(tq:3))
  AgregarMarco(c:fac..l:fac, 0, 0, Exe('COLOR6'))
  IFA
ENDIF

* Calcular y mostrar el Total Neto
ACT(h:fac, 'Total Neto al ')
ACD(i:fac,Val(FV:1))
ACN(j:fac, Val(tn:1)-Val(tn:2))
AgregarMarco(h:fac..l:fac, 0, 0, Exe('COLOR6'))
IFA

SetFont(A:Val(FI:1)..l:fac, 1)
FormatoCeldas(k:Val(FI:2)..k:fac, Exe('F9'))
FormatoCeldas(l:Val(FI:2)..l:fac, Exe('F2'))
FormatoCeldas(j:Val(FI:2)..j:fac, Exe('F2'))

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

ACO(1, 10)

ACO(7, 8)
ACO(9, 6)

ACO(10, 10)
ACO(11, 9)
ACO(12, 10)

LimitesVision(l:fac+1)