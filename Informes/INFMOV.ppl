SQL.ADD("WHERE ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo) ")
SQL.ADD(" OR (M.NrSaldo+100 =EC.NrSaldo  AND EC.NrSaldo="~Fstr(val(sl1),0,0)~")) AND  "  )
