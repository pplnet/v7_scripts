ModoReproceso(SinDialogo)

CrearDialogo
   Lista1     : "Especies"                          ;;;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB'  ORDER BY Codigo ");SI
   Radio1     : "Moneda|Pesos|Dolares"              ;  ; ;;;;;;;0;
   Fecha1     : "Fecha Desde"                       ;  ;1;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
   Fecha2     : "Fecha Hasta"                       ;  ; ;;;;Dialogo.Fecha2>=Dialogo.Fecha1 y Dialogo.Fecha2<=Fsys;'Debe Ingresar la Fecha';NO;FSys;
   ListaTabla2: 'Clientes'                          ;;;;;;                       ;;;;;              ;;;" Status = 'HAB' and  "~DBO~".EsTerminalcliente(Codigo)=1";'Codigo';'Codigo;RazonSocial';'CLIENTES'
   Vehiculo1  : "Vehiculo"                          ;  ;2;;NO;NO;;;;VAR('VEHICULODE');;;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

*ListaTabla2: 'Clientes'                          ;;;;;;;;;;;;;;EsTerminal("JERARQUIA",CLIENTES)"=SI;'Codigo';'Codigo;RazonSocial';'CLIENTES'

**- 'Codigo' ; 'Codigo;RazonSocial' ; 'vClientes01'

SetFilaActual(2)

CrearFont(1, 'Arial,10,B')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,')

If Vacio(Dialogo.ListaTabla2)
   If MessageBox('Selecciono todos los Clientes, #Continua?',0,2) = 7
      Cancelar
   Endif
Endif

ACT(a:FAC, 'Extracto Unificado de Movimientos del Cliente')
ACT(o:FAC, 'AUXMOV')
SetFont(a:FAC..a:FAC, 1)
SetFont(o:FAC..o:FAC, 3)
AlinearCeldas(o:FAC..o:FAC, 'D')

ACD(fh1, Habiles(Dialogo.Fecha2,3,'ARG',SI))

ACT(a:FAC+2, 'Vehiculo: '~Dialogo.Vehiculo1)
ACT(a:FAC+3, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(e:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)

If NoVacio(Dialogo.ListaTabla2)
   ACT(a:FAC+4, 'Cliente: '~Dialogo.ListaTabla2~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.ListaTabla2))
Else
   ACT(a:FAC+4, 'Cliente: Todos')
Endif

If NoVacio(Dialogo.Lista1)
   ACT(e:FAC+4, 'Especies: '~Pipe2Coma(Dialogo.Lista1))
Else
   ACT(e:FAC+4, 'Especies: Todas')
Endif

ACT(g:FAC+3, 'Movs Ejecutados: Azul')
ACT(g:FAC+4, 'Movs Pendientes: Verde')

SetFont(a:FAC+2..g:FAC+4, 2)
SetFilaActual(FAC+6)

**-- Encabezado
ACT(a:FAC, 'Estado')
ACT(b:FAC, 'Fecha Vto')
ACT(c:FAC, 'Fecha Conc')
ACT(d:FAC, 'Nro. Op.')
ACT(e:FAC, 'Concepto')
ACT(f:FAC, 'Debito VN')
ACT(g:FAC, 'Debito VR')
ACT(h:FAC, 'Debito $/U$S')
ACT(i:FAC, 'Credito VN')
ACT(j:FAC, 'Credito VR')
ACT(k:FAC, 'Credito $/U$S')
ACT(l:FAC, 'Saldo VN')
ACT(m:FAC, 'Saldo VR')
ACT(n:FAC, 'Saldo $/U$S')
ACT(o:FAC, 'Precio')

SetFont(a:FAC..o:FAC, 2)
AlinearCeldas(a:FAC..o:FAC, 'C')
AgregarMarco(a:FAC..o:FAC,0,1,EXE('COLOR6'))

