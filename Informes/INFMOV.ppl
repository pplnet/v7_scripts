*- Saldo Inicial 
ACN(sl1,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALLIBRECU')) )
***---Saldo Bloq. x ventas
ACN(SB:1,BuscarCampo('EstadosCustodia','NrSaldo','Codigo',VAR('SALBLOQVTA')) )

SQL.ADD("SELECT S1.Cliente, '' as A, '' as B, '' as C, '' as D, '' as E, '' as F, ")
SQL.ADD("       '' as G, '' as H, '' as I, '' as J, '' as K, ") 
SQL.ADD("       '' as L, '' as M, '' as N, '' as O, '' as P, '' as Q ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1,"~DBO~".CLIENTES C, "~DBO~".ESPECIES E, "~DBO~".ESTADOSCUSTODIA EC ")
SQL.ADD("WHERE S1.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND")
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   S1.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      ((S1.NrSaldo = "~Fstr(val(sl1),0,0)~" AND S1.NrSaldo = EC.NrSaldo) OR (S1.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND S1.NrSaldo-100 = EC.NrSaldo)) AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Especie = E.Codigo AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente  AND ")
SQL.ADD("                        S2.Especie = S1.Especie  AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' AND ")
SQL.ADD("                        S2.Cuenta  = S1.Cuenta   AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo) ")
***---Excluyo Saldos Bloqueados por venta
SQL.ADD(" AND S1.NrSaldo <> "~Val(SB:1)~"+100 ")
SQL.ADD("GROUP BY S1.Cliente, S1.Especie, S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, ")
SQL.ADD("         E.TasaIntAnterior, E.TasaIntVigente, E.Nombre, E.InteresesC, EC.Descripcion ")

SQL.ADD("UNION  ")

SQL.ADD("SELECT DISTINCT M.Cliente, '' as A, '' as B, '' as C, '' as D, '' as E, '' as F, ")
SQL.ADD("       '' as G, '' as H, '' as I, '' as J, '' as K, ")
SQL.ADD("       '' as L, '' as M, '' as N, '' as O, '' as P, '' as Q ")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESTADOSCUSTODIA EC, "~DBO~".ESPECIES E, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("WHERE ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo) ")
SQL.ADD(" OR (M.NrSaldo+100 =EC.NrSaldo  AND EC.NrSaldo="~Fstr(val(sl1),0,0)~")" )
SQL.ADD(" OR (M.NrSaldo=5 and T.TipoTr2='LCUPON' AND EC.NrSaldo=101)) AND  "  )
SQL.ADD("      M.Cliente = C.Codigo AND ")
*SQL.ADD(" C.CategDepositante='CLI'  AND ")
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
ENDIF
SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
SQL.ADD("      M.Especie = E.Codigo AND ")
SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
SQL.ADD("      ((T.TipoTr2 IN ('DTP', 'RTP','DRT') and (T.CB6 = 0 OR T.CB6 Is Null)) or T.TipoTr2 In ('CAMEST','CUPON','LCUPON','PDIVID')) ")
***---Excluyo Saldos Bloqueados por venta
SQL.ADD(" AND M.NrSaldo <> "~Val(SB:1)~"+100 ")

IF NO
    SQL.ADD("UNION  ")
    **- Ordenes de Bloqueo por Ventas
    SQL.ADD("SELECT DISTINCT M.Cliente, '' as A, '' as B, '' as C, '' as D, '' as E, '' as F, ")
    SQL.ADD("       '' as G, '' as H, '' as I, '' as J, '' as K, ")
    SQL.ADD("       '' as L, '' as M, '' as N, '' as O, '' as P, '' as Q ")
    SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M, "~DBO~".CLIENTES C, "~DBO~".ESTADOSCUSTODIA EC, "~DBO~".ESPECIES E, "~DBO~".ORDENES O ")
    SQL.ADD("WHERE ((M.NrSaldo > "~Fstr(val(sl1),0,0)~"+100 AND M.NrSaldo-100 = EC.NrSaldo) OR (M.NrSaldo = "~Fstr(val(sl1),0,0)~" AND M.NrSaldo = EC.NrSaldo)) AND ")
    SQL.ADD("      M.Cliente = C.Codigo AND ")
    SQL.ADD(" C.CategDepositante='CLI'  AND")
    IF NoVacio(Dialogo.Lista1)
       SQL.ADD("   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
    ENDIF
    IF NoVacio(Dialogo.ListaTabla2)
       SQL.ADD("   M.Cliente IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") AND ")
    ENDIF
    SQL.ADD("      M.FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
    SQL.ADD("      M.FechaMov <= '"~IdxDate(Val(fh1))~"' AND ")
    SQL.ADD("      M.Especie = E.Codigo AND ")
    SQL.ADD("      M.NrOperacion = O.NrOrden AND ")
    SQL.ADD("      O.TipoOrden In ('VTC','VTP','CBC','CBT','TIV','VTSUC') ")
ENDIF

SQL.ADD("UNION ")

SQL.ADD("SELECT DISTINCT M.Cliente, '' as A, '' as B, '' as C, '' as D, '' as E, '' as F, ")
SQL.ADD("       '' as G, '' as H, '' as I, '' as J, '' as K, ")
SQL.ADD("       '' as L, '' as M, '' as N, '' as O, '' as P, '' as Q ")
