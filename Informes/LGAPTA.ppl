ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Fecha'         ;;;;;;;;;FSys
  Entero1   : 'Plazo Maximo'  ;;;;;;;;;365
  Entero2   : 'Plazo Analisis';;;;;;;;;30
  Radio2    : 'Grupo|Terceros|Vinculados|Todos'  ;;;;;;;;;0
  Lista2    : 'Especies'                         ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
FinDialogo

if not Ok 
  Cancelar
endif

ACT(a2, 'Limites - Descalce de plazos '~Iif(Dialogo.Radio2=0,' Terceros ',IIf(Dialogo.Radio2=1,'Vinculadas','Todas')) )
ACT(a3, 'Vigentes al   : '~Dialogo.Fecha1)
ACT(a4, 'Plazo Maximo  : '~Fstr(Dialogo.Entero1,0,0))
ACT(a5, 'Plazo Analisis: '~Fstr(Dialogo.Entero2,0,0))
If NoVacio(Dialogo.Lista2)
   ACT(a6,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
   ACT(a6,'Especies: TODAS' )   
endif

ACT(a8, 'Empresa')
ACT(b8, 'Activos')
ACT(b9, 'Capital')
ACT(c9, 'Pl.Outstanding')
ACT(d9, 'Tasa Promedio')
ACT(e8, 'Pasivos')
ACT(e9, 'Capital')
ACT(f9, 'Pl.Outstanding')
ACT(g9, 'Tasa Promedio')
ACT(h8, 'Gap ')
ACT(h9, 'Capital')
ACT(i9, 'Plazo')
ACT(j9, 'Tasa')

AgregarMarco(a8..j9, 1, 0, Exe('COLOR'))
AgregarMarco(b8..d8, 1)
AgregarMarco(b9..b9, 1)
AgregarMarco(c9..c9, 1)
AgregarMarco(d9..d9, 1)
AgregarMarco(e8..g8, 1)
AgregarMarco(e9..e9, 1)
AgregarMarco(f9..f9, 1)
AgregarMarco(g9..g9, 1)
AgregarMarco(h8..j8, 1)
AgregarMarco(h9..h9, 1)
AgregarMarco(i9..i9, 1)
AgregarMarco(j9..j9, 1)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

Setfont(a1..z9, 1)
SetFilaActual(9)

*---- Lista las operaciones de MM (activas y pasivas), los fondos de MM, Los FX 
*-- Operaciones Unico Vencimiento 
SQL.ADD("Select Distinct O.Vehiculo1 ")
SQL.ADD("from "~DBO~".OPERACIONES  O ")
SQL.ADD("where (")
If Dialogo.Radio2<>1 
   *- Terceros
   SQL.ADD(" O.TipoOp In ('MMCP','MMCDP','MMCDIA','MMDCA','MMCCR','MMO','MMFRN','MMON','MMPCL','MMPCOS','MMPE','MMPI','MMPSC','MMPLME') ")
EndIf
If Dialogo.Radio2=2
   *- Todas
   SQL.ADD(" or  ")
EndIf
If Dialogo.Radio2<>0 
   *- Vinculadas
   SQL.ADD(" O.TipoOp In ('MMPCCV')  ")
EndIf

SQL.ADD(") and O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.Plazo  <= "~Fstr(Dialogo.Entero1,0,0)~" ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD("    and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD("  Union  ")
*- Operaciones Multiple Vencimiento  para todos los periodos desde el vigente hasta los futuros
SQL.ADD("Select Distinct O.Vehiculo1 ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion and (")
If Dialogo.Radio2<>1 
   *- Terceros
   SQL.ADD(" O.TipoOp In ('MMCPM','MMFCMV','MMONM''MMPCLM','MMPCVM','MMPEM','MMPIM','MMPOSM','MMSCMV') ")
EndIf
If Dialogo.Radio2=2
   *- Todas
   SQL.ADD(" or  ")
EndIf
If Dialogo.Radio2<>0 
   *- Vinculadas
   SQL.ADD(" O.TipoOp In ('MMPCCM')  ")
EndIf
SQL.ADD(") and C.Fecha2  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and O.Plazo   <= "~Fstr(Dialogo.Entero1,0,0)~" ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD("    and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
SQL.ADD(" Union  ")
*- Fondos de Money Market a FechaDesde
SQL.ADD("Select Distinct S.EnteCustodia Vehiculo1 ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("where  S.Especie = E.Codigo  ")
SQL.ADD("  and  S.NrSaldo = 2 ")
SQL.ADD("  and  Round(S.Saldo,2) <> 0 ")
SQL.ADD("  and  E.Tipo = 'FON' ")
SQL.ADD("  and  E.Alias2 = '0' ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD("    and S.Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif
SQL.ADD("  and  S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = 2 ")
SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by 1")

*- z1: Filas para el ListBox
acn(z1,100)

Recorrer SQL

  ACT(a:fac, fbn('Vehiculo1'))

  *- Obtengo los valores de ACTIVOS
  LinkearHoja('LGAPT1',40,Fecha1=Dialogo.Fecha1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Vehiculo1=val(a:fac), Radio1=0,Radio2=Dialogo.Radio2,Lista2=Dialogo.Lista2)

  * aa:Capital ab: Tasa ac: Dias Prom. ad: Interes
  ACN(aa:fac, LinkH(40,  aa:1))
  ACN(ab:fac, LinkH(40,  ab:1))
  ACN(ac:fac, LinkH(40,  ac:1))
  ACN(ad:fac, LinkH(40,  ad:1))

  *CerrarHoja('LGAPT1',40,Fecha1=Dialogo.Fecha1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Vehiculo1=val(a:fac), Radio1=0,Radio2=Dialogo.Radio2,Lista2=Dialogo.Lista2)
  *CerrarLink(40)

  *- Obtengo los valores de PASIVOS
  LinkearHoja('LGAPT1',41,Fecha1=Dialogo.Fecha1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Vehiculo1=val(a:fac), Radio1=1,Radio2=Dialogo.Radio2,Lista2=Dialogo.Lista2)

  * ba:Capital bb: Tasa bc: Dias Prom. bd: Interes
  ACN(ba:fac, LinkH(41,  aa:1))
  ACN(bb:fac, LinkH(41,  ab:1))
  ACN(bc:fac, LinkH(41,  ac:1))
  ACN(bd:fac, LinkH(41,  ad:1))

  *CerrarHoja('LGAPT1',41,Fecha1=Dialogo.Fecha1,Entero1=Dialogo.Entero1,Entero2=Dialogo.Entero2,Vehiculo1=val(a:fac), Radio1=1,Radio2=Dialogo.Radio2,Lista2=Dialogo.Lista2)
  *CerrarLink(41)

  *- Cuerpo Principal
  ACN(b:fac,val(aa:fac))
  ACN(c:fac,val(ac:fac))
  ACN(e:fac,val(ba:fac))
  ACN(f:fac,val(bc:fac))

  *- Por cada vehiculo verifico si ambas tasas (activas y pasivas) son menores a Dialogo.Entero2
  If val(ac:fac)<Dialogo.Entero2 y val(bc:fac)<Dialogo.Entero2  y val(ba:fac)<>0 y val(aa:fac)<>0
     *--ACTIVOS
     ACN(cy:val(z1),fac)

     ACT(cz:val(z1),val(a:fac))
     ACN(da:val(z1),val(aa:fac))      
     ACN(db:val(z1),val(ab:fac))      
     ACN(dc:val(z1),val(ac:fac))      

     *--PASIVOS
     ACN(de:val(z1),val(ba:fac))      
     ACN(df:val(z1),val(bb:fac))      
     ACN(dg:val(z1),val(bc:fac))      

     SCN(z1,1)
  Else 
     *- Se hace el calculo de tasa en forma simple
     *- Utilizo como capital comun el minimo de ambos capitales
     If val(aa:fac)*val(ba:fac)<>0 
        ACN(dn:fac,Min(val(aa:fac),val(ba:fac)))

        *- Numerales Activos
        acn(di:fac,val(dn:fac)*val(ab:fac)*val(ac:fac))            

        *- Numerales Pasivos
        acn(dj:fac,val(dn:fac)*val(bb:fac)*val(bc:fac))            

        acn(dk:fac,Abs(val(di:fac)-val(dj:fac)) )

        *- Pasivo es el Plazo Menor -> Calculo Tasa Pasivo (El activo es igual al minimo)
        If val(ac:fac)>val(bc:fac)
           acn(dl:fac,val(ab:fac))
           acn(dm:fac,(val(dk:fac)/(val(dn:fac)*(val(ac:fac)-val(bc:fac)))) )          

           *- Tasa del Gap
           ACN(j:fac,val(dm:fac))
        Else 
           *-  Calculo Tasa Activos (El pasivo es igual al minimo)
           acn(dl:fac,(val(dk:fac)/(val(dn:fac)*(val(bc:fac)-val(ac:fac)))) )
           acn(dm:fac,val(bb:fac))          

           *- Tasa del Gap
           ACN(j:fac,val(dl:fac))
        EndIf
     Else 
        If val(aa:fac)<>0 
           ACN(dn:fac,val(aa:fac))
        Else 
           ACN(dn:fac,val(ba:fac))
        EndIf
     EndIf

     *- Cuerpo Principal
     ACN(d:fac,val(ab:fac))
     ACN(g:fac,val(bb:fac))

     *- Datos del Gap 
     *- Capital (El igualado)
     ACN(h:fac,val(dn:fac))     
 
     *- Plazo: El abs de la diferencia 
     ACN(i:fac,Abs(VAL(c:fac)-VAL(f:fac)))                 
  EndIf
Proximo

IF VAL(z1)>100
   SCN(z1,-1)
   Recorrer&j 1,1000
      acd(z2,Dialogo.Fecha1)
      acd(z3,Dialogo.Entero1)
      acd(z4,Dialogo.Entero2)

      * ba:Capital bb: Tasa bc: Dias Prom. bd: Interes
      CrearDialogo
         Fecha1    : 'Fecha'         ;;;;NO;;;;;val(z2)
         Entero1   : 'Plazo Maximo'  ;;;;NO;;;;;val(z3)
         Entero2   : 'Plazo Analisis';;;;NO;;;;;val(z4)
         ListBox; 'Arial,8,N'; 560; 180
            'Vehiculo'   ;cz100..cz:val(z1);NO;;;;80;STRING
            'Cap  ACT'   ;da100..da:val(z1);NO;;;;80;NUMERO;'##,###,###.##'
            'Tasa ACT'   ;db100..db:val(z1);NO;;;;60;NUMERO;'##,###.##'
            'Pzo  ACT'   ;dc100..dc:val(z1);NO;;;;40;NUMERO;'###'
            '%Proy'      ;dd100..dd:val(z1);;VAL(dd:FLB)>=0;'Tasa Proyectada ACTIVO Incorrecta';;60;NUMERO;'##,###.##'
            'Cap  PAS'   ;de100..de:val(z1);NO;;;;80;NUMERO;'##,###,###.##'
            'Tasa PAS'   ;df100..df:val(z1);NO;;;;60;NUMERO;'##,###.##'
            'Pzo  PAS'   ;dg100..dg:val(z1);NO;;;;40;NUMERO;'###'
            '%Proy'      ;dh100..dh:val(z1);;VAL(dd:FLB)>=0;'Tasa Proyectada PASIVO Incorrecta';;60;NUMERO;'##,###.##'
         FinListBox  
      FinDialogo

      IF Not OK
         Cancelar
      EndIf

      ACN(k2,0)
      ACN(k1,0)

      Recorrer&i 100,val(z1)

         Message('Validando Renglon '~Fstr(&i-1,2,0))

         If Val(dd:&i)=0 y Val(dh:&i)=0
            ACN(k1,0)
            SCN(k2,1)                                                                                                                                                                                                                                              
            ACN(k1,MessageBox("Tasas Proyectadas para "~Val(cz:&i)~" Incorrectas. Continua? ",2,1))

            IF VAL(k1)=2
               Break
            EndIf 
         Else 
            *- di: Numerales Activos  dj: Numerales Pasivos dk: Diferencia de Numerales   
            *- dl: Tasa Calculada Activos dm: Tasa Calculada Pasivos dn:Capital Igualado
            acn(di:&i,0)            
            acn(dj:&i,0)            

            *- Utilizo como capital comun el minimo de ambos capitales
            IF val(da:&i)*val(de:&i)<>0
               ACN(dn:&i,Min(val(da:&i),val(de:&i)))
            Else
               If val(da:&i)<>0
                  ACN(dn:&i,val(da:&i) )
               Else 
                  ACN(dn:&i,val(de:&i) )
               EndIF
            EndIf

            *- Sensibiliza Activos Cap*Tasa*Plazo+(Cap*Proyec*(Entero2-Plazo))
            acn(di:&i,val(dn:&i)*val(db:&i)*val(dc:&i)+(val(dn:&i)*val(dd:&i)*(Dialogo.Entero2-val(dc:&i))) )            

            *- Sensibiliza Pasivos Cap*Tasa*Plazo+(Cap*Proyec*(Entero2-Plazo))
            acn(dj:&i,val(dn:&i)*val(df:&i)*val(dg:&i)+(val(dn:&i)*val(dh:&i)*(Dialogo.Entero2-val(dg:&i))) )            

            acn(dk:&i,Abs(val(di:&i)-val(dj:&i)) )

            *- Si Sensibiliza Activos -> Calculo Tasa Pasivo
            If val(dc:&i)<>0
               acn(dl:&i,val(db:&i))
               acn(dm:&i,val(dk:&i)/(val(dn:&i)*(Dialogo.Entero2-val(dg:&i))) )          

               *- Tasas del Gap
               ACN(j:val(cy:&i),val(dm:&i))     

               *- Plazo del Gap
               ACN(i:val(cy:&i),Dialogo.Entero2-val(dg:&i) )                 
            EndIf

            *- Si Sensibiliza Pasivos -> Calculo Tasa Activos
            If val(dh:&i)<>0
               acn(dl:&i,val(dk:&i)/(val(dn:&i)*(Dialogo.Entero2-val(dc:&i))) )
               acn(dm:&i,val(df:&i))          

               *- Tasas del Gap
               ACN(j:val(cy:&i),val(dl:&i))     

               *- Plazo del Gap
               ACN(i:val(cy:&i),Dialogo.Entero2-val(dc:&i))                 
            EndIf

            *- Cuerpo Principal
            ACN(d:val(cy:&i),val(db:&i))
            ACN(g:val(cy:&i),val(df:&i))

            *- Datos del Gap 
            *- Capital (El igualado)
            ACN(h:val(cy:&i),val(dn:&i))     
         EndIf
      Proximo

      IF VAL(k1)<>1 
         Break
      EndIf 
   Proximo
EndIf

ACT(a8, 'Empresa')
ACT(b8, 'Activos')
ACT(b9, 'Capital')
ACT(c9, 'Pl.Outstanding')
ACT(d9, 'Tasa Promedio')
ACT(e8, 'Pasivos')
ACT(e9, 'Capital')
ACT(f9, 'Pl.Outstanding')
ACT(g9, 'Tasa Promedio')
ACT(h8, 'Diferencia')
ACT(h9, 'Capital')
ACT(i9, 'Plazo')
ACT(j9, 'Tasa')

ACT(a:fac+1, 'Total')

AgregarMarco(a:fac+1..n:fac+1,1,0,Exe('COLOR'))

Recorrer&i 10, fac+1

  *- Calculo de Diferencias
  ACN(h:&i,VAL(b:&i)-VAL(e:&i))
  ACN(i:&i,VAL(c:&i)-VAL(f:&i))
  ACN(j:&i,VAL(d:&i)-VAL(g:&i))  

  *- Calculo de totales 
  *- Capital
  SCN(b:fac+1,VAL(b:&i))
  SCN(e:fac+1,VAL(e:&i))
  SCN(h:fac+1,VAL(h:&i))

  *- Plazo Promedio -> Capital*Plazo/Capital
  SCN(c:fac+1,VAL(b:&i)*VAL(c:&i))
  SCN(f:fac+1,VAL(e:&i)*VAL(f:&i))
  SCN(i:fac+1,VAL(h:&i)*VAL(i:&i))

  *- Tasa Promedio -> Capital*Plazo*Tasa/Capital*Plazo
  SCN(d:fac+1,VAL(b:&i)*VAL(c:&i)*VAL(d:&i))
  SCN(g:fac+1,VAL(e:&i)*VAL(f:&i)*VAL(g:&i))
  SCN(j:fac+1,VAL(h:&i)*VAL(i:&i)*VAL(j:&i))
Proximo

*- 
ACN(d:fac+1,VAL(d:fac+1)/VAL(c:fac+1))
ACN(g:fac+1,VAL(g:fac+1)/VAL(f:fac+1))
ACN(j:fac+1,VAL(j:fac+1)/VAL(i:fac+1))

ACN(c:fac+1,VAL(c:fac+1)/VAL(b:fac+1))
ACN(f:fac+1,VAL(f:fac+1)/VAL(e:fac+1))
ACN(i:fac+1,VAL(i:fac+1)/VAL(h:fac+1))

ACO(1,9)
ACO(2,9)
ACO(3,9)
ACO(4,9)
ACO(5,9)
ACO(6,9)
ACO(7,9)
ACO(8,9)
ACO(9,9)
ACO(10,9)
ACO(11,9)
ACO(12,9)
ACO(13,9)
ACO(14,9)
SetFont(a10..z:fac, 2)
SetFont(a:fac+1..z:fac+1, 1)
*LimitesVision(o:fac+2)
SetPrintFit(3, 75)
Impresion(1,2)
