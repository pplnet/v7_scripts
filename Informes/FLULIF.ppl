CrearDialogo
  Fecha1   : 'F.Desde'     ;;;;;;;;;PriDeMes(FSys,SI)
  Fecha2   : 'F.Hasta'     ;;;;;;;;;FinDeMes(FSys,SI)
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if not OK
  Cancelar
endif

If NoVacio(UsrVehiculos(UsuarioActivo))
   ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
Else
   ACT(zz6,SQLSET("Select V.Codigo FROM "~DBO~".VEHICULOS V where (Status='HAB' or Status Is Null or Status='') ") )
EndIf

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a1, 'Flujo Historico de Liquidaciones por Fecha')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista1)
  ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
 ACT(a:4, 'Vehiculo : Todos')
endif

ACT(a6, 'Fecha')
ACT(b6, 'Contraparte')
ACT(c6, 'Importe')

AgregarMarco(a6..c6, 2,0,Exe('COLOR'))

SetFilaActual(6)

SQL.ADD("Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.UMedida, C.Fecha2, C.Total1  ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' and C.Total1 <> 0 ")
SQL.ADD("and O.Vehiculo1 In ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and O.TipoOp in ('DPSS','DPSO','DPBOA','DPBOD','DPDSO','DPDSS','DPS','DPOA','DPOD','DPRC','DPRS','DPRRS','DPSN','DPOAV','DPOGD','DPOGA') ")
SQL.ADD("Union ")
SQL.ADD("Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.UMedida, O.FechaVto, O.Precio4  ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where  ")
SQL.ADD(" O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and O.FechaVto  <= '"~IdxDate(Dialogo.Fecha2)~"' and O.Precio4<>0 ")
SQL.ADD("and O.Vehiculo1 In ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD("and O.TipoOp in ('DPBOS','DPFW','DPOS','DPOGS') ")
SQL.ADD("order by 1, 5, 2")
BorrarCeldas(z1..z1)

Recorrer SQL
  if Not EQstr(fbn('Vehiculo1'),Val(z1))
    * cambia Fecha
    if NoVacio(Val(z7))
      act(a:fac,'Total '~Val(z7) )
      acn(c:fac, Val(w8))
      BorrarCeldas(w8..w8)
      AgregarMarco(a:fac..c:fac,1)
      SetFont(a:fac..c:fac,1)
      ifa
    endif
    * cambia empresa
    if NoVacio(Val(z1))
      act(a:fac,'Total Empresa '~Val(z1) )
      acn(c:fac, Val(w4))
      BorrarCeldas(w4..w4)
      AgregarMarco(a:fac..c:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..c:fac,1)
      ifa
    endif
    * Asignar Empresa
    act(z1, fbn('Vehiculo1'))
    act(a:fac,'Empresa '~Val(z1) )
    AgregarMarco(a:fac..c:fac,1,0,RGB(192,192,192))
    SetFont(a:fac..c:fac,1)
    ifa
    * Asignar Fecha
    acd(z7, fbn('Fecha2'))
    act(a:fac,Val(z7) )
    AgregarMarco(a:fac..c:fac,1)
    SetFont(a:fac..c:fac,1)
    ifa
  else
    if fbn('Fecha2') <> Val(z7)
      * cambia Fecha
      if NoVacio(Val(z7))
        act(a:fac,'Total '~Val(z7) )
        acn(c:fac, Val(w8))
        BorrarCeldas(w8..w8)
        AgregarMarco(a:fac..c:fac,1)
        SetFont(a:fac..c:fac,1)
        ifa
      endif
      * Asignar Fecha
      acd(z7, fbn('Fecha2'))
      act(a:fac,Val(z7) )
      AgregarMarco(a:fac..c:fac,1)
      SetFont(a:fac..c:fac,1)
      ifa
    endif
  endif
  act(b:fac, fbn('Cliente1'))
  acn(c:fac, fbn('Total1'))

  scn(w4,Val(c:fac))
  scn(w8,Val(c:fac))
  scn(w12,Val(c:fac))

  SetFont(a:fac..c:fac,2)

proximo
* ultimo total Fecha
ifa
if NoVacio(Val(z7))
  act(a:fac,'Total '~Val(z7) )
  acn(c:fac, Val(w8))
  BorrarCeldas(w5..w8)
  AgregarMarco(a:fac..c:fac,1)
  SetFont(a:fac..c:fac,1)
endif

* ultimo total Empresa
ifa
if NoVacio(Val(z1))
  act(a:fac,'Total Empresa '~Val(z1) )
  acn(c:fac, Val(w4))
  BorrarCeldas(w1..w4)
  AgregarMarco(a:fac..c:fac,1,0,RGB(192,192,192))
  SetFont(a:fac..c:fac,1)
endif

* total gral
ifa
acn(c:fac, Val(w12))
BorrarCeldas(w1..w12)
AgregarMarco(a:fac..c:fac, 2,0,Exe('COLOR'))
SetFont(a:fac..c:fac,2)


ACO(1,10)
ACO(2,10)
ACO(3,10)

SetFont(a1..z6, 1)
SetFont(a7..z:fac, 2)
FormatoCeldas(c7..c:fac, Exe('F2N'))
AlinearCeldas(c:7..c:fac+1,'D')
LimitesVision(n:fac+1)
Impresion(1,2)

