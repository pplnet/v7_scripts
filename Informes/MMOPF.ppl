*Desarrollo de Informe

*Operaciones de Plazo Fijo pactadas en el día
******************************
CrearDialogo
  Fecha1   : 'Fecha ';;;;;;;;;FSys
FinDialogo

if not Ok 
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

ACT(a:fac+5, 'Operaciones de Plazo Fijo pactadas en el día')
SetFont(a:fac+5, 3)

ACT(a:fac+7, 'Fecha: '~Dialogo.Fecha1)
SetFont(a:fac+7, 1)
ACT(a:fac+9, 'Tipo MMPF - Plazo Fijo')
SetFont(a:fac+9, 1)

SetFilaActual(10)

ACT(a:fac, 'Nro. Oper.')
ACT(b:fac, 'Moneda')
ACT(c:fac, 'Cliente')
ACT(d:fac, 'Razón Social')
ACT(e:fac, 'Cliente Operación')
ACT(f:fac, 'Nombre Cliente Oper.')
ACT(g:fac, 'Cantidad')
ACT(h:fac, 'Tipo Tasa')
ACT(i:fac, 'Tasa')
ACT(j:fac, 'Plazo')
ACT(k:fac, 'Tasa de Transferencia')
ACT(l:fac, 'Fecha Vto.')
ACT(m:fac, 'Intereses')
ACT(n:fac, 'Base')
ACT(o:fac, 'Total')
ACT(p:fac, 'Operador')
AlinearCeldas(a:fac..p:fac, 'C')
SetFont(a:fac..p:fac, 1)
AgregarMarco(a:fac..p:fac, 0, 0, Exe('COLOR'))

*seleccionar las operaciones que son Plazos fijos -> MMPF
SQL.ADD("Select O.NrOperacion, O.Especie, O.Cliente1, C.RazonSocial, O.Cantidad, O.TasaBase, O.Plazo, O.TasaBase, ") 
SQL.ADD("O.FechaVto, O.DiasAnio, O.TotalIntereses, O.Precio1, O.TotalBrutoCli1, O.Operador, O.FechaOp") 
SQL.ADD("from "~DBO~".OPERACIONES O LEFT JOIN "~DBO~".CLIENTES C ON O.Cliente1 = C.Codigo")
SQL.ADD("where O.TipoOp = 'MMPF' and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("order by O.NrOperacion")


*TBD --> TO BE DEFINED
recorrer SQL
    ACT(a:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(b:fac, fbn('Especie'))
    ACT(c:fac, fbn('Cliente1'))
    ACT(d:fac, fbn('RazonSocial'))
    ACT(e:fac, 'TBD')
    ACT(f:fac, 'TBD')
    ACN(g:fac, fbn('Cantidad'))
    ACT(h:fac, 'TBD')     
    *La Tasa se almacena en Precio1
    ACN(i:fac, Trunc(fbn('Precio1'),2))
    ACN(j:fac, fbn('Plazo'))
    ACT(k:fac, 'TBD')
    ACT(l:fac, fbn('FechaVto'))
    ACN(m:fac, fbn('TotalIntereses'))
    *DiasAnio me guarda el valor de la base
    IF fbn('DiasAnio') = 1 THEN
        ACT(n:fac, '365')
    ELSE
        ACT(n:fac, '360')
    ENDIF    
    ACN(o:fac, fbn('TotalBrutoCli1'))
    ACT(p:fac, fbn('Operador'))
    SetFont(a:fac..p:fac, 2)
proximo

