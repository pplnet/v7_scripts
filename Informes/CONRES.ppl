ModoReproceso(ConDialogo)
ACT(ax:1, UsuarioActivo)
if Vacio(UsrVehiculos(Val(ax:1)))
  ACT(ax:2, SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"))
else
  ACT(ax:2, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~Val(ax:1)~"'"))
endif

CrearDialogo
  Fecha1   : 'Fecha Desde'               ; 1;1;;                        ;                ;Dialogo.Fecha1>0              ;'Fecha desde Invalida';NO;FSys-7
  Fecha2   : 'Fecha Hasta'               ; 1;2;;                        ;                ;Dialogo.Fecha2>=Dialogo.Fecha1;'Fecha hasta Invalida';NO;FSys
  Vehiculo1: 'Grupo'                     ; 2;1;;                        ;                ;                              ;                      ;  ;;                                                                                                                                                                                                                                                              ;;;;"TipoVehiculo <> 'DIV'";
  Lista1   : 'Vehiculos'                 ; 3;1;;Vacio(Dialogo.Vehiculo1);                ;                              ;                      ;  ;;iif(Vacio(Dialogo.Vehiculo1) , Dialogo.Lista1 , SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV' and Codigo in ("~Pipe2Comillas(Descendientes('VEHICULOS',Dialogo.Vehiculo1))~") and Codigo in ("~Pipe2Comillas(Val(ax:2))~")") );Val(ax:2);
  Lista2   : 'Tipos Book'                ; 4;1;;                        ;                ;                              ;                      ;  ;;                                                                                                                                                                                                                                                              ;SQLSET("Select Codigo From "~DBO~".TIPOSBOOK");
  Lista3   : 'Books'                     ;-2;2;;                        ;                ;                              ;                      ;  ;;                                                                                                                                                                                                                                                              ;iif(Vacio(Dialogo.Lista2),iif(Vacio(Dialogo.Lista1),SQLSET("Select Codigo From "~DBO~".BOOKS where Vehiculo in ("~Pipe2Comillas(Val(ax:2))~") "),SQLSET("Select Codigo From "~DBO~".BOOKS where Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")),iif(Vacio(Dialogo.Lista1),SQLSET("Select Codigo From "~DBO~".BOOKS where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Vehiculo in ("~Pipe2Comillas(Val(ax:2))~") "),SQLSET("Select Codigo From "~DBO~".BOOKS where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~") and Vehiculo in ("~Pipe2Comillas(Val(ax:2))~") ")));
  Especie1 : 'Especie'                   ;-1;1;;                        ;                ;                              ;                      ;  ;
  Radio1   : 'Saldos|Todos|Nuevos|Solo 1'; 0;1;;                        ;                ;;;;0
  Entero1  : 'Saldo'                     ; 0;2;;Dialogo.Radio1=2        ;Dialogo.Radio1=2;;;;0
  Radio2   : 'Reultados|Todos|Algunos'   ; 1;1;;                        ;                ;;;;0
  Lista4   : 'Tipos Resultados'          ; 2;1;;Dialogo.Radio2=1        ;Dialogo.Radio2=1;;;;'1-REALIZ|2-TRADE|3-Cupones|4-Dividendos|';iif(Dialogo.Radio2=1,Dialogo.Lista4,''));'1-REALIZ|2-TRADE|3-Cupones|4-Dividendos|5-INTLEN|6-CONT|7-REVAL';
  Check1   : 'Solo Errores'              ; 3;1;;NO                      ;NO              ;;;;0
FinDialogo
If Not Ok
   Cancelar
Endif

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,10,B')

ACT(av:1, '1-REALIZ')
ACT(aw:1, 'REALIZ')
ACT(av:2, '2-TRADE')
ACT(aw:2, 'TRADE')
ACT(av:3, '3-Cupones')
ACT(aw:3, 'CUPAMO|CUPREN')
ACT(av:4, '4-Dividendos')
ACT(aw:4, 'DIVEFV|DIVACC|DIVFON|DIVFEF')
ACT(av:5, '5-Intereses')
ACT(aw:5, 'INTLEN|INTWHT')
ACT(av:6, '6-CONT')
ACT(aw:6, 'CONT')
ACT(av:7, '7-REVAL')
ACT(aw:7, 'REVAL')

ACT(ax:4, Dialogo.Lista4)
if Dialogo.Radio2=1
  recorrer&i 1,7
    if Incluido(Val(av:&i),Dialogo.Lista4)
      if NoVacio(Val(ax:3))
        ACT(ax:3, Val(ax:3)~'|')
      endif
      ACT(ax:3, Val(ax:3)~Val(aw:&i))
    endif
  proximo
endif

ACN(at:1, 0)
ACN(at:1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
if Val(at:1)=0
  ACN(at:2, 1)
else
  ACN(at:2, VAR('MESINIEJE'))
endif
if Val(at:2)<1 or Val(at:2)>12
  ACN(at:2, 1)
endif

SetFilaActual(1)
ACT(a:FAC, 'Control de Resultados')
ACT(a:FAC+1, 'Desde Fecha '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Hasta Fecha '~Dialogo.Fecha2)
SetFont(a:FAC..a:FAC+2, 2)

SetFilaActual(FAC+4)
*ACT(a:FAC, 'A')
*ACT(b:FAC, 'B')
*ACT(c:FAC, 'C')
*ACT(d:FAC, 'D')
*ACT(e:FAC, 'E')
*ACT(f:FAC, 'F')
*ACT(g:FAC, 'G')
*ACT(h:FAC, 'H')
*ACT(i:FAC, 'I')
*ACT(j:FAC, 'J')
*ACT(k:FAC, 'K')
*ACT(l:FAC, 'L')
*ACT(m:FAC, 'M')
*ACT(n:FAC, 'N')
*ACT(o:FAC, 'O')
*ACT(p:FAC, 'P')
*ACT(q:FAC, 'Q')
*ACT(r:FAC, 'R')
*ACT(s:FAC, 'S')
*ACT(t:FAC, 'T')
*ACT(u:FAC, 'U')
*ACT(v:FAC, 'V')
*ACT(w:FAC, 'W')
*ACT(x:FAC, 'X')
*ACT(y:FAC, 'Y')
*ACT(z:FAC, 'Z')
*ACT(aa:FAC, 'AA')
*SetFont(a:FAC..aa:FAC, 3)

SetFilaActual(FAC+1)
ACT(a:FAC, 'Vehiculo')
ACT(b:FAC, 'Book')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Result.')
ACT(e:FAC, 'TNeg.')
ACT(f:FAC, 'Trader')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Saldo')
ACT(i:FAC, 'FechaEj')
ACT(j:FAC, 'Fecha')
ACT(k:FAC, 'Day')
ACT(l:FAC, 'MTD')
ACT(m:FAC, 'YTD')
ACT(n:FAC, 'Mes')
ACT(o:FAC, 'MTD Calc')
ACT(p:FAC, 'MTD')
ACT(q:FAC, 'Inicio Eje')
ACT(r:FAC, 'Eje')
ACT(s:FAC, 'YTD Calc')
ACT(t:FAC, 'YTD')
ACT(u:FAC, 'Nro.Linea')
ACT(v:FAC, 'Max.Fecha')
ACT(w:FAC, 'Cant.Reg')
ACT(x:FAC, 'Ini.Eje.')
ACT(y:FAC, 'Cant.Reg')
ACT(z:FAC, 'MTD Ant')
ACT(aa:FAC, 'YTD Ant')
AlinearCeldas(g:FAC..l:FAC,'D')
AlinearCeldas(n:FAC..n:FAC,'D')
AlinearCeldas(p:FAC..p:FAC,'D')
SetFont(a:FAC..aa:FAC, 2)
Agregarmarco(a:FAC..m:FAC,1,0,Exe('COLOR'))
Agregarmarco(n:FAC..p:FAC,1,0,Exe('COLOR'))
Agregarmarco(q:FAC..t:FAC,1,0,Exe('COLOR'))
ACN(az:1, FAC)

SQL.ADD("Select * from "~DBO~".RESULTADOS ")
SQL.ADD(" where Fecha         >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("   and Fecha         <= "~IdxDate2(Dialogo.Fecha2)~" ")
if NoVacio(Val(ax:3))
*  MessageBox('Filtra TipoResultado')
  SQL.ADD(" and TipoResultado in ("~Pipe2Comillas(Val(ax:3))~") ")
endif
if Dialogo.Radio1=1
*  MessageBox('Filtra Saldo')
  SQL.ADD(" and NrSaldo       >= 120 ")
  SQL.ADD(" and NrSaldo       <= 139 ")
endif
if Dialogo.Radio1=2
*  MessageBox('Filtra un Saldo')
  SQL.ADD(" and NrSaldo       = "~Dialogo.Entero1~" ")
endif
if NoVacio(Dialogo.Especie1)
*  MessageBox('Filtra Especie')
  SQL.ADD(" and Especie       =  '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and Vehiculo      in ("~Pipe2Comillas(Val(ax:2))~") ")
if NoVacio(Dialogo.Lista1)
*  MessageBox('Filtra Vehiculo')
  SQL.ADD("   and Vehiculo    in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
if NoVacio(Dialogo.Lista3)
*  MessageBox('Filtra Book')
  SQL.ADD("   and Book        in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" order by Vehiculo,Book,TipoResultado,TipoNegocio,Trader,Especie,NrSaldo,FechaEj,Fecha ")
recorrer SQL
  SCN(az:2, 1)
  if Not EqStr(fbn('Vehiculo'),Val(au:1)) o Not EqStr(fbn('Book'),Val(au:2)) o Not EqStr(fbn('Cliente'),Val(au:3)) o Not EqStr(fbn('TipoResultado'),Val(au:4)) o Not EqStr(fbn('TipoNegocio'),Val(au:5)) o Not EqStr(fbn('Trader'),Val(au:6)) o Not EqStr(fbn('Especie'),Val(au:7)) o fbn('NrSaldo')<>Val(au:8) o fbn('FechaEj')<>Val(au:9)
    IFA
    ACT(au:1, fbn('Vehiculo'))
    ACT(au:2, fbn('Book'))
    ACT(au:3, fbn('Cliente'))
    ACT(au:4, fbn('TipoResultado'))
    ACT(au:5, fbn('TipoNegocio'))
    ACT(au:6, fbn('Trader'))
    ACT(au:7, fbn('Especie'))
    ACN(au:8, fbn('NrSaldo'))
    ACD(au:9, fbn('FechaEj'))
    ACN(ay:1, 0)
  endif
  ACT(a:FAC, fbn('Vehiculo'))
  ACT(b:FAC, fbn('Book'))
  ACT(c:FAC, fbn('Cliente'))
  ACT(d:FAC, fbn('TipoResultado'))
  ACT(e:FAC, fbn('TipoNegocio'))
  ACT(f:FAC, fbn('Trader'))
  ACT(g:FAC, fbn('Especie'))
  ACN(h:FAC, fbn('NrSaldo'))
  if fbn('FechaEj')>0
    ACD(i:FAC, fbn('FechaEj'))
  endif
  ACD(j:FAC, fbn('Fecha'))
  ACN(k:FAC, fbn('Day'))
  ACN(l:FAC, fbn('MTD'))
  ACN(m:FAC, fbn('YTD'))
  SCN(ay:1, 1)
  ACN(u:FAC, Val(ay:1))

  if Mes(fbn('Fecha'))>=Val(at:2)
    ACD(q:FAC, Fecha('01/'~Pad0(FStr(Val(at:2),1,0),2)~'/'~FStr(Anio(fbn('Fecha')),4,0)))
  else
    ACD(q:FAC, Fecha('01/'~Pad0(FStr(Val(at:2),1,0),2)~'/'~FStr(Anio(fbn('Fecha'))-1,4,0)))
  endif

  if Val(u:FAC)=1
    ** Primer registro listado
    SQL.ADD("Select Max(Fecha) as MaxFecha from "~DBO~".RESULTADOS ")
    SQL.ADD(" where Fecha         < "~IdxDate2(fbn('Fecha'))~" ")
    SQL.ADD("   and FechaEj       = "~IdxDate2(fbn('FechaEj'))~" ")
    SQL.ADD("   and Vehiculo      = '"~fbn('Vehiculo')~"' ")
    SQL.ADD("   and Cliente       = '"~fbn('Cliente')~"' ")
    SQL.ADD("   and Book          = '"~fbn('Book')~"' ")
    SQL.ADD("   and Especie       = '"~fbn('Especie')~"' ")
    SQL.ADD("   and TipoNegocio   = '"~fbn('TipoNegocio')~"' ")
    SQL.ADD("   and TipoResultado = '"~fbn('TipoResultado')~"' ")
    SQL.ADD("   and Trader        = '"~fbn('Trader')~"' ")
    SQL.ADD("   and NrSaldo       = "~fbn('NrSaldo')~" ")
    recorrer SQL
      DFA
      SCN(w:FAC, 1)
      if fbn('MaxFecha')>0
        ACD(v:FAC, fbn('MaxFecha'))
      endif
    proximo
    if Val(v:FAC)>0
      * Hay registro anterior
      if Mes(Val(v:FAC))>=Val(at:2)
        ACD(x:FAC, Fecha('01/'~Pad0(FStr(Val(at:2),1,0),2)~'/'~FStr(Anio(Val(v:FAC)),4,0)))
      else
        ACD(x:FAC, Fecha('01/'~Pad0(FStr(Val(at:2),1,0),2)~'/'~FStr(Anio(Val(v:FAC))-1,4,0)))
      endif
      if Val(x:FAC)=Val(q:FAC)
        ** Mismo Ejercicio
        SQL.ADD("Select MTD,YTD from "~DBO~".RESULTADOS ")
        SQL.ADD(" where Fecha         = "~IdxDate2(Val(v:FAC))~" ")
        SQL.ADD("   and FechaEj       = "~IdxDate2(fbn('FechaEj'))~" ")
        SQL.ADD("   and Vehiculo      = '"~fbn('Vehiculo')~"' ")
        SQL.ADD("   and Cliente       = '"~fbn('Cliente')~"' ")
        SQL.ADD("   and Book          = '"~fbn('Book')~"' ")
        SQL.ADD("   and Especie       = '"~fbn('Especie')~"' ")
        SQL.ADD("   and TipoNegocio   = '"~fbn('TipoNegocio')~"' ")
        SQL.ADD("   and TipoResultado = '"~fbn('TipoResultado')~"' ")
        SQL.ADD("   and Trader        = '"~fbn('Trader')~"' ")
        SQL.ADD("   and NrSaldo       = "~fbn('NrSaldo')~" ")
        recorrer SQL
          DFA
          SCN(y:FAC, 1)
          ACN(z:FAC, fbn('MTD'))
          ACN(aa:FAC, fbn('YTD'))
        proximo
        if Mes(Val(j:FAC))=Mes(Val(v:FAC)) y Anio(Val(j:FAC))=Anio(Val(v:FAC))
          ACT(n:FAC, '= Mes 1')
          ACN(o:FAC, Val(z:FAC)+Val(k:FAC))
        else
          ACT(n:FAC, '<> Mes 1')
          ACN(o:FAC, Val(k:FAC))
        endif
        ACT(r:FAC, '= Ejer. 1')
        ACN(s:FAC, Val(aa:FAC)+Val(k:FAC))
      else
        ** Ejercicio anterior
        ACT(n:FAC, '<> Mes 2')
        ACN(o:FAC, Val(k:FAC))
        ACT(r:FAC, '<> Ejer.2')
        ACN(s:FAC, Val(k:FAC))
      endif
    else
      ACT(n:FAC, '1er Reg.')
      ACN(o:FAC, Val(k:FAC))
      ACT(r:FAC, '1er Reg.')
      ACN(s:FAC, Val(k:FAC))
    endif
  else
    if Mes(Val(j:FAC))=Mes(Val(j:FAC-1)) y Anio(Val(j:FAC))=Anio(Val(j:FAC-1))
      ACT(n:FAC, '= Mes')
      ACN(o:FAC, Val(l:FAC-1)+Val(k:FAC))
    else
      ACT(n:FAC, '<> Mes')
      ACN(o:FAC, Val(k:FAC))
    endif
    if Val(q:FAC)=Val(q:FAC-1)
      ACT(r:FAC, '= Ejer.')
      ACN(s:FAC, Val(m:FAC-1)+Val(k:FAC))
    else
      ACT(r:FAC, '<> Ejer.')
      ACN(s:FAC, Val(k:FAC))
    endif
  endif
  if Val(o:FAC)-Val(l:FAC)>0.01 o Val(o:FAC)-Val(l:FAC)<-0.01
    ACT(p:FAC, 'Error')
  else
    ACT(p:FAC, 'OK')
  endif
  if Val(s:FAC)-Val(m:FAC)>0.01 o Val(s:FAC)-Val(m:FAC)<-0.01
    ACT(t:FAC, 'Error')
  else
    ACT(t:FAC, 'OK')
  endif
proximo

if FAC>Val(az:1)
  if Dialogo.Check1=1
    recorrer&i Val(az:1)+1,FAC
      if EqStr(Val(p:&i),'OK') y EqStr(Val(t:&i),'OK')
        ACT(ab:&i, 'Elimnar')
      endif
    proximo
  endif

  SetFont(a:Val(az:1)+1..aa:FAC, 1)
  FormatoCeldas(h:Val(az:1)+1..h:FAC, Exe('F0'))
  FormatoCeldas(k:Val(az:1)+1..m:FAC, Exe('F2'))
  FormatoCeldas(o:Val(az:1)+1..o:FAC, Exe('F2'))
  FormatoCeldas(s:Val(az:1)+1..s:FAC, Exe('F2'))
  FormatoCeldas(w:Val(az:1)+1..w:FAC, Exe('F0'))
  FormatoCeldas(y:Val(az:1)+1..y:FAC, Exe('F0'))
  FormatoCeldas(z:Val(az:1)+1..aa:FAC, Exe('F2'))
  Agregarmarco(a:Val(az:1)+1..m:FAC,1,0)
  Agregarmarco(n:Val(az:1)+1..p:FAC,1,0)
  Agregarmarco(q:Val(az:1)+1..t:FAC,1,0)
endif

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,5)
ACO(5,4)
ACO(6,7)
ACO(7,5)
ACO(8,4)
ACO(9,6)
ACO(10,6)
ACO(11,9)
ACO(12,9)
ACO(13,9)
ACO(14,5)
ACO(15,9)
ACO(16,3)
ACO(17,6)
ACO(18,5)
ACO(19,9)
ACO(20,3)
ACO(21,7)
ACO(26,10)
ACO(27,10)

SetFont(at:1..az:10, 1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Se lisataron '~FStr(Val(az:2),1,0)~' registos')
SetFont(a:FAC, 2)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
Impresion(1,2)
LimitesVision(t:FAC)
SetPrintFit(3, 80)
