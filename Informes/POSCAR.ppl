CrearDialogo
   Fecha1   : 'Fecha'           ;1;1;;;;;;;FSys
   Vehiculo1: 'Vehiculo'        ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE');;
   Label1   : ''                ;4;;;NO;;;;;'Carteras'
   Check1   : 'Trading'         ;5;;;;;;;;1
   Check2   : 'Invest. <= 6 m.' ;6;;;;;;;;1
   Check3   : 'Invest. > 6 m.'  ;7;;;;;;;;1
   Check4   : 'Otras Soc.'      ;8;;;;;;;;1
   Lista1   : 'Especies'        ;4;2;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' AND Jerarquia LIKE '"~Var('JERTITULOS')~"%' ORDER BY Codigo ");
   Radio2   : 'Expresado|Mon.Local|Mon.Extranjera|';5;1;;;;;;;0
   Label2   : ''                ;;;;NO;NO;Dialogo.CHECK1=1 o Dialogo.CHECK2=1 o Dialogo.CHECK3=1 o Dialogo.CHECK4=1;'Debe seleccionar alguna cartera';NO;
FinDialogo

if not Ok
  Cancelar
endif


IF Dialogo.Radio2 = 0
   ACT(mn1, VAR('MONELOCA'))
ELSE
   ACT(mn1, VAR('MONEEXTR'))
ENDIF

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(d1, 'Posicion y Disponibilidad por Cartera (Teorica)')
ACT(a2, 'Fecha : '~Dialogo.Fecha1)
ACT(a3, 'Cartera: ')
IF Dialogo.Check1 = 1 y Dialogo.Check2 = 1 y Dialogo.Check3 = 1 y Dialogo.Check4 = 1 
   ACT(a3, Val(a3)~'Todas')
   ACT(cr1, '0|1|2|3|')
   ACT(cr2, '107|108|109|110|')
ELSE
   ACT(cr1, '')
   ACT(cr2, '')
   IF Dialogo.Check1 = 1
      ACT(b3, Val(b3)~'Trading| ')
      ACT(cr1, Val(cr1)~'0|')
      ACT(cr2, Val(cr2)~'107|')
   ENDIF
   IF Dialogo.Check2 = 1
      ACT(b3, 'Val(b3)~Investment <= 6 Meses| ')
      ACT(cr1, Val(cr1)~'1|')
      ACT(cr2, Val(cr2)~'108|')
   ENDIF
   IF Dialogo.Check3 = 1
      ACT(b3, Val(b3)~'Investment > 6 Meses| ')
      ACT(cr1, Val(cr1)~'2|')
      ACT(cr2, Val(cr2)~'109|')
   ENDIF
   IF Dialogo.Check4 = 1
      ACT(b3, Val(b3)~'Otras Sociedades| ')
      ACT(cr1, Val(cr1)~'3|')
      ACT(cr2, Val(cr2)~'110|')
   ENDIF
ENDIF
ACT(a4, 'Moneda: '~IIF(Dialogo.Radio2=0,'Local','Extranjera'))

IF NoVacio(Dialogo.Lista1)
   ACT(a5, 'Especie: '~Dialogo.Lista1)
ELSE
   ACT(a5, 'Especie: Todas')
ENDIF

ACT(a6, 'Especie')
ACT(b7, 'Posic Inicial')
ACT(c6, 'Retiros')
   ACT(c7, 'de Hoy')
ACT(d6, 'Depositos')
   ACT(d7, 'de Hoy')
ACT(e6, 'Cpras a')
   ACT(e7, 'Liq. Hoy')
ACT(f6, 'Vtas a')
   ACT(f7, 'Liq. Hoy')
ACT(g6, 'Pases Act')
   ACT(g7, 'Liq. Hoy')
ACT(h6, 'Pases Pas')
   ACT(h7, 'Liq. Hoy')
ACT(i7, 'Posic a Hoy')
ACT(j7, 'Cpras Futuras')
ACT(k7, 'Vtas Futuras')
ACT(l6, 'Pases Act.Vig.')
   ACT(l7, 'no Liq.Hoy')
ACT(m6, 'Pases Pas.Vig.')
   ACT(m7, 'no Liq.Hoy')
ACT(n7, 'Posic a Futuro')

AlinearCeldas(b6..n7, 'C')
AgregarMarco(a6..n7, 2, 0, Exe('COLOR'))

(.'SPOSDISC2'.)

* Especie Anterior
ACT(es0, '')
* Cartera Anterior
ACN(cr0, -1)

ACN(fi1, 8)
ACN(fl1, 0)
ACN(fl2, 0)
ACN(fl3, 0)
SetFilaActual(Val(fi1))

Recorrer SQL
   * Corte por Especie
   IF Not EqStr(FBN['Codigo']~FBN['Cupon'], Val(es0)~Val(es1))
      IF Val(cr0) <> -1
         ACN(i:Val(fl1), Val(b:Val(fl1))-Val(c:Val(fl1))+Val(d:Val(fl1))+Val(e:Val(fl1))-Val(f:Val(fl1))+Val(g:Val(fl1))+Val(h:Val(fl1)))
         ACN(i:Val(fl2), Val(b:Val(fl2))-Val(c:Val(fl2))+Val(d:Val(fl2))+Val(e:Val(fl2))-Val(f:Val(fl2))+Val(g:Val(fl2))+Val(h:Val(fl2)))
         ACN(i:Val(fl3), Val(b:Val(fl3))-Val(c:Val(fl3))+Val(d:Val(fl3))+Val(e:Val(fl3))-Val(f:Val(fl3))+Val(g:Val(fl3))+Val(h:Val(fl3)))

         ACN(n:Val(fl1), Val(i:Val(fl1))+Val(j:Val(fl1))-Val(k:Val(fl1))+Val(l:Val(fl1))+Val(m:Val(fl1)))
         ACN(n:Val(fl2), Val(i:Val(fl2))+Val(j:Val(fl2))-Val(k:Val(fl2))+Val(l:Val(fl2))+Val(m:Val(fl2)))
         ACN(n:Val(fl3), Val(i:Val(fl3))+Val(j:Val(fl3))-Val(k:Val(fl3))+Val(l:Val(fl3))+Val(m:Val(fl3)))

         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(di1, Val(i:Val(fl1)))
            SCN(di2, Val(i:Val(fl2)))
            SCN(di3, Val(i:Val(fl3)))

            SCN(dn1, Val(n:Val(fl1)))
            SCN(dn2, Val(n:Val(fl2)))
            SCN(dn3, Val(n:Val(fl3)))
         ENDIF
         
         Recorrer&i 2, 13
            If Val(&i:Val(fl1))<>0
               IF &i <> 9 y &i <> 2
                  ACL(&i:Val(fl1), 'DPDXC2', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(cr0), Cantidad1=&i, Especie1=Val(es0), Radio2=Dialogo.Radio2, String1=Val(es1))
               ENDIF

               IF &i <> 9 y &i = 2
                  ACL(&i:Val(fl1), 'DETPO2', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(cr0), Especie1=Val(es0), Radio2=Dialogo.Radio2, String1=Val(es1))
               ENDIF
            Endif
         Proximo
      ENDIF

      * Si se listo almenos una Invest.
      IF EqStr(Val(da1),'SI') o EqStr(Val(da2),'SI')
         ACN(fl1, Val(fi1))
         SCN(fi1, 1)

         ACN(fl2, Val(fi1))
         SCN(fi1, 1)

         ACN(fl3, Val(fi1))
         SCN(fi1, 1)

         ACT(a:Val(fl1), '     Total Invest. Nom.')
         ACT(a:Val(fl2), '     Total Invest. Res.')
         ACT(a:Val(fl3), '     Total Invest. Efe.')

         ACN(b:Val(fl1), Val(db1))
         ACN(c:Val(fl1), Val(dc1))
         ACN(d:Val(fl1), Val(dd1))
         ACN(e:Val(fl1), Val(de1))
         ACN(f:Val(fl1), Val(df1))
         ACN(g:Val(fl1), Val(dg1))
         ACN(h:Val(fl1), Val(dh1))
         ACN(i:Val(fl1), Val(di1))
         ACN(j:Val(fl1), Val(dj1))
         ACN(k:Val(fl1), Val(dk1))
         ACN(l:Val(fl1), Val(dl1))
         ACN(m:Val(fl1), Val(dm1))
         ACN(n:Val(fl1), Val(dn1))

         ACN(b:Val(fl2), Val(db2))
         ACN(c:Val(fl2), Val(dc2))
         ACN(d:Val(fl2), Val(dd2))
         ACN(e:Val(fl2), Val(de2))
         ACN(f:Val(fl2), Val(df2))
         ACN(g:Val(fl2), Val(dg2))
         ACN(h:Val(fl2), Val(dh2))
         ACN(i:Val(fl2), Val(di2))
         ACN(j:Val(fl2), Val(dj2))
         ACN(k:Val(fl2), Val(dk2))
         ACN(l:Val(fl2), Val(dl2))
         ACN(m:Val(fl2), Val(dm2))
         ACN(n:Val(fl2), Val(dn2))

         ACN(b:Val(fl3), Val(db3))
         ACN(c:Val(fl3), Val(dc3))
         ACN(d:Val(fl3), Val(dd3))
         ACN(e:Val(fl3), Val(de3))
         ACN(f:Val(fl3), Val(df3))
         ACN(g:Val(fl3), Val(dg3))
         ACN(h:Val(fl3), Val(dh3))
         ACN(i:Val(fl3), Val(di3))
         ACN(j:Val(fl3), Val(dj3))
         ACN(k:Val(fl3), Val(dk3))
         ACN(l:Val(fl3), Val(dl3))
         ACN(m:Val(fl3), Val(dm3))
         ACN(n:Val(fl3), Val(dn3))

         SetFont(a:Val(fl1)..n:Val(fl3), 1)
         ACT(da1, 'NO')
         ACT(da2, 'NO')
         SCN(fi1, 1)
      ENDIF

      * Inicializo celdas donde acumulo los totales de las dos carteras de Investment
      * Valores Nominales
      ACN(db1, 0)
      ACN(dc1, 0)
      ACN(dd1, 0)
      ACN(de1, 0)
      ACN(df1, 0)
      ACN(dg1, 0)
      ACN(dh1, 0)
      ACN(di1, 0)
      ACN(dj1, 0)
      ACN(dk1, 0)
      ACN(dl1, 0)
      ACN(dm1, 0)
      ACN(dn1, 0)
      * Valores Residuales
      ACN(db2, 0)
      ACN(dc2, 0)
      ACN(dd2, 0)
      ACN(de2, 0)
      ACN(df2, 0)
      ACN(dg2, 0)
      ACN(dh2, 0)
      ACN(di2, 0)
      ACN(dj2, 0)
      ACN(dk2, 0)
      ACN(dl2, 0)
      ACN(dm2, 0)
      ACN(dn2, 0)
      * Valores efectivos
      ACN(db3, 0)
      ACN(dc3, 0)
      ACN(dd3, 0)
      ACN(de3, 0)
      ACN(df3, 0)
      ACN(dg3, 0)
      ACN(dh3, 0)
      ACN(di3, 0)
      ACN(dj3, 0)
      ACN(dk3, 0)
      ACN(dl3, 0)
      ACN(dm3, 0)
      ACN(dn3, 0)

      * Estas celdas me van a decir si entro por alguna cartera para hacer el subtotal
      * (da1 -> invest <= 6m.; da2 -> invest > 6m.) 
      ACT(da1, 'NO')
      ACT(da2, 'NO')

      * Especie
      ACT(es0, FBN['Codigo'])

      * Cupon
      ACT(es1, FBN['Cupon'])

      * Resolucion 1585
      ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Codigo']))

      ACT(a:Val(fi1), FBN['Codigo']~' - '~FBN['Nombre']~' - Cup '~FBN['Cupon'])
      ACN(fe1, Val(fi1))
      SetFont(a:Val(fi1), 1)
      AgregarMarco(a:Val(fi1)..n:Val(fi1),2,0,Exe('COLOR'))

      * (yu..yz parametros para la funcion INTERESCLE)
      ACN(yt1, 1)
      ACD(yu:1 , Dialogo.Fecha1)
      ACT(yv:1 , Val(es0))
      ACD(yx:1 , FBN['FechaCambioTasa'])
      ACN(yy:1 , FBN['TasaIntAnterior'])
      ACN(yz:1 , FBN['TasaIntVigente'])

      ACN(vr2,FBN['Alias5'])
      ACT(in1, FBN['InteresesC'])
      ACN(vr1, VALORTEORICO2(Val(es0),Dialogo.Fecha1))
      ACN(cc1, CotizacionC(Val(es0),,,,Dialogo.Fecha1,1,SI,Val(mn1)) ) 
      SCN(fi1, 1)
      ACN(cr0, FBN['Cartera'])
      * Cartera
      IF Val(cr0) = 0
         ACT(a:Val(fi1), '  Trading')
      ENDIF
      IF Val(cr0) = 1
         ACT(a:Val(fi1), '  Invest <= 6 M.')
      ENDIF
      IF Val(cr0) = 2
         ACT(a:Val(fi1), '  Invest > 6 M.')
      ENDIF
      IF Val(cr0) = 3
         ACT(a:Val(fi1), '  Otras Sociedades')
      ENDIF
      SetFont(a:Val(fi1), 1)
      SCN(fi1, 1)

      ACN(fl1, Val(fi1))
      SCN(fi1, 1)

      ACN(fl2, Val(fi1))
      SCN(fi1, 1)

      ACN(fl3, Val(fi1))
      SCN(fi1, 1)

      ACT(a:Val(fl1), '    Valores Nominales')
      ACT(a:Val(fl2), '    Valores Residuales')
      ACT(a:Val(fl3), '    Valores Efectivos')
      SetFont(a:Val(fl1), 2)
      SetFont(a:Val(fl2), 2)
      SetFont(a:Val(fl3), 2)

      ACN(b:Val(fl1), 0)
      ACN(b:Val(fl2), 0)
      ACN(b:Val(fl3), 0)
   ENDIF

   * Corte por Cartera
   IF Val(cr0) <> FBN['Cartera']
      IF Val(cr0) <> -1
         ACN(i:Val(fl1), Val(b:Val(fl1))-Val(c:Val(fl1))+Val(d:Val(fl1))+Val(e:Val(fl1))-Val(f:Val(fl1))+Val(g:Val(fl1))+Val(h:Val(fl1)))
         ACN(i:Val(fl2), Val(b:Val(fl2))-Val(c:Val(fl2))+Val(d:Val(fl2))+Val(e:Val(fl2))-Val(f:Val(fl2))+Val(g:Val(fl2))+Val(h:Val(fl2)))
         ACN(i:Val(fl3), Val(b:Val(fl3))-Val(c:Val(fl3))+Val(d:Val(fl3))+Val(e:Val(fl3))-Val(f:Val(fl3))+Val(g:Val(fl3))+Val(h:Val(fl3)))

         ACN(n:Val(fl1), Val(i:Val(fl1))+Val(j:Val(fl1))-Val(k:Val(fl1))+Val(l:Val(fl1))+Val(m:Val(fl1)))
         ACN(n:Val(fl2), Val(i:Val(fl2))+Val(j:Val(fl2))-Val(k:Val(fl2))+Val(l:Val(fl2))+Val(m:Val(fl2)))
         ACN(n:Val(fl3), Val(i:Val(fl3))+Val(j:Val(fl3))-Val(k:Val(fl3))+Val(l:Val(fl3))+Val(m:Val(fl3)))

         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(di1, Val(i:Val(fl1)))
            SCN(di2, Val(i:Val(fl2)))
            SCN(di3, Val(i:Val(fl3)))

            SCN(dn1, Val(n:Val(fl1)))
            SCN(dn2, Val(n:Val(fl2)))
            SCN(dn3, Val(n:Val(fl3)))
         ENDIF

         Recorrer&i 2, 13
            If Val(&i:Val(fl1))<>0
               IF &i <> 9 y &i <> 2
                  ACL(&i:Val(fl1), 'DPDXC2', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(cr0), Cantidad1=&i, Especie1=Val(es0), Radio2=Dialogo.Radio2, String1=Val(es1))
               ENDIF
            Endif
            IF &i <> 9 y &i = 2
               ACL(&i:Val(fl1), 'DETPO2', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(cr0), Especie1=Val(es0), Radio2=Dialogo.Radio2, String1=Val(es1))
            ENDIF
         Proximo
      ENDIF

      * Si se listo al menos una Invest.
      IF Val(cr0) > 2 y [EqStr(Val(da1),'SI') o EqStr(Val(da2),'SI')]
         ACN(fl1, Val(fi1))
         SCN(fi1, 1)
         ACN(fl2, Val(fi1))
         SCN(fi1, 1)
         ACN(fl3, Val(fi1))
         SCN(fi1, 1)
         ACT(a:Val(fl1), '     Total Invest. Nom.')
         ACT(a:Val(fl2), '     Total Invest. Res.')
         ACT(a:Val(fl3), '     Total Invest. Efe.')
         ACN(b:Val(fl1), Val(db1))
         ACN(c:Val(fl1), Val(dc1))
         ACN(d:Val(fl1), Val(dd1))
         ACN(e:Val(fl1), Val(de1))
         ACN(f:Val(fl1), Val(df1))
         ACN(g:Val(fl1), Val(dg1))
         ACN(h:Val(fl1), Val(dh1))
         ACN(i:Val(fl1), Val(di1))
         ACN(j:Val(fl1), Val(dj1))
         ACN(k:Val(fl1), Val(dk1))
         ACN(l:Val(fl1), Val(dl1))
         ACN(m:Val(fl1), Val(dm1))
         ACN(n:Val(fl1), Val(dn1))

         ACN(b:Val(fl2), Val(db2))
         ACN(c:Val(fl2), Val(dc2))
         ACN(d:Val(fl2), Val(dd2))
         ACN(e:Val(fl2), Val(de2))
         ACN(f:Val(fl2), Val(df2))
         ACN(g:Val(fl2), Val(dg2))
         ACN(h:Val(fl2), Val(dh2))
         ACN(i:Val(fl2), Val(di2))
         ACN(j:Val(fl2), Val(dj2))
         ACN(k:Val(fl2), Val(dk2))
         ACN(l:Val(fl2), Val(dl2))
         ACN(m:Val(fl2), Val(dm2))
         ACN(n:Val(fl2), Val(dn2))

         ACN(b:Val(fl3), Val(db3))
         ACN(c:Val(fl3), Val(dc3))
         ACN(d:Val(fl3), Val(dd3))
         ACN(e:Val(fl3), Val(de3))
         ACN(f:Val(fl3), Val(df3))
         ACN(g:Val(fl3), Val(dg3))
         ACN(h:Val(fl3), Val(dh3))
         ACN(i:Val(fl3), Val(di3))
         ACN(j:Val(fl3), Val(dj3))
         ACN(k:Val(fl3), Val(dk3))
         ACN(l:Val(fl3), Val(dl3))
         ACN(m:Val(fl3), Val(dm3))
         ACN(n:Val(fl3), Val(dn3))

         SetFont(a:Val(fl1)..n:Val(fl3), 1)
         ACT(da1, 'NO')
         ACT(da2, 'NO')
         SCN(fi1, 1)
      ENDIF

      ACN(cr0, FBN['Cartera'])
      * Cartera
      IF Val(cr0) = 0
         ACT(a:Val(fi1), '  Trading')
      ENDIF
      IF Val(cr0) = 1
         ACT(a:Val(fi1), '  Invest <= 6 M.')
      ENDIF
      IF Val(cr0) = 2
         ACT(a:Val(fi1), '  Invest > 6 M.')
      ENDIF
      IF Val(cr0) = 3
         ACT(a:Val(fi1), '  Otras Sociedades')
      ENDIF
      SetFont(a:Val(fi1), 1)
      SCN(fi1, 1)
      ACN(fl1, Val(fi1))
      SCN(fi1, 1)
      ACN(fl2, Val(fi1))
      SCN(fi1, 1)
      ACN(fl3, Val(fi1))
      SCN(fi1, 1)
      ACT(a:Val(fl1), '    Valores Nominales')
      ACT(a:Val(fl2), '    Valores Residuales')
      ACT(a:Val(fl3), '    Valores Efectivos')
      SetFont(a:Val(fl1), 2)
      SetFont(a:Val(fl2), 2)
      SetFont(a:Val(fl3), 2)

      ACN(b:Val(fl1), 0)
      ACN(b:Val(fl2), 0)
      ACN(b:Val(fl3), 0)
   ENDIF
            
   * Si el registro es un saldo de posicion o es una operac. no liq. pero anterior a Dialogo.Fecha1
   IF EqStr(FBN['TipoOp'], 'ASALDOPOSIC') 
      * fac+1 V.N. / fac+2 V.R.
      acn(ca1, FBN['Cantidad'])
      acn(ca2,Round(val(ca1)*val(vr1),val(vr2)))
      ACN(yw:1, val(ca1))
      (.'INTERESCLE'.)
      IF EqStr(Val(in1), 'CLE')
         IF Incluido(Val(al4), '1585')
            ACN(ca3, val(ca2)*val(cc1)+(Val(zz1)*Val(cc1)))
         ELSE
            ACN(ca3, val(ca2)*val(cc1)+Val(zz1))
         ENDIF
      ELSE
         ACN(ca3, val(ca1)*val(cc1))
      ENDIF

      SCN(b:Val(fl1), val(ca1))
      SCN(b:Val(fl2), Val(ca2))
      SCN(b:Val(fl3), Val(ca3))
      IF Val(cr0) = 1 o Val(cr0) = 2
         SCN(db1, Val(ca1))
         SCN(db2, Val(ca2))
         SCN(db3, Val(ca3))
         IF Val(cr0) = 1
            ACT(da1, 'SI')
         ELSE
            ACT(da2, 'SI')
         ENDIF
      ENDIF
   ENDIF

   IF EqStr(Copy(FBN['TipoOp'],1,11), 'BSALDOPOSIC')
      * fac+1 V.N. / fac+2 V.R.
      acn(ca1, FBN['Cantidad'])
      acn(ca2,Round(val(ca1)*val(vr1),val(vr2)))
      ACN(yw:1, val(ca1))
      (.'INTERESCLE'.)
      IF EqStr(Val(in1), 'CLE')
         IF Incluido(Val(al4), '1585')
            ACN(ca3, val(ca2)*val(cc1)+(Val(zz1)*Val(cc1)))
         ELSE
            ACN(ca3, val(ca2)*val(cc1)+Val(zz1))
         ENDIF
      ELSE
         ACN(ca3, val(ca1)*val(cc1))
      ENDIF
     
      IF [EqStr(Copy(FBN['TipoOp'],12,Longitud(FBN['TipoOp'])-11), 'RTP') y Not EqStr(FBN['Inv'],'INV')] o [EqStr(Copy(FBN['TipoOp'],12,Longitud(FBN['TipoOp'])-11), 'DTP') y EqStr(FBN['Inv'],'INV')]
         SCN(b:Val(fl1), -val(ca1))
         SCN(b:Val(fl2), -Val(ca2))
         SCN(b:Val(fl3), -Val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(db1, Val(ca1))
            SCN(db2, Val(ca2))
            SCN(db3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
      
      IF Incluido('PDIVID',FBN['TipoOp']) 
         SCN(b:Val(fl1), val(ca1))
         SCN(b:Val(fl2), Val(ca2))
         SCN(b:Val(fl3), Val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(db1, Val(ca1))
            SCN(db2, Val(ca2))
            SCN(db3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
      
      IF [EqStr(Copy(FBN['TipoOp'],12,Longitud(FBN['TipoOp'])-11), 'DTP') y Not EqStr(FBN['Inv'],'INV')] o [EqStr(Copy(FBN['TipoOp'],12,Longitud(FBN['TipoOp'])-11), 'RTP') y EqStr(FBN['Inv'],'INV')]
         SCN(b:Val(fl1), val(ca1))
         SCN(b:Val(fl2), Val(ca2))
         SCN(b:Val(fl3), Val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(db1, Val(ca1))
            SCN(db2, Val(ca2))
            SCN(db3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
  
      IF Incluido(Copy(FBN['TipoOp'],12,Longitud(FBN['TipoOp'])-11), 'CTC|CTP|TIC|TIFC|') 
         SCN(b:Val(fl1), val(ca1))
         SCN(b:Val(fl2), Val(ca2))
         SCN(b:Val(fl3), Val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(db1, Val(ca1))
            SCN(db2, Val(ca2))
            SCN(db3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      IF Incluido(Copy(FBN['TipoOp'],12,Longitud(FBN['TipoOp'])-11), 'VTC|VTP|TIV|TIFV|') 
         SCN(b:Val(fl1), -val(ca1))
         SCN(b:Val(fl2), -Val(ca2))
         SCN(b:Val(fl3), -Val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(db1, Val(ca1))
            SCN(db2, Val(ca2))
            SCN(db3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
   ENDIF


   * Si el registro no es un saldo de posicion
   IF NOT EqStr(FBN['TipoOp'], 'ASALDOPOSIC') y NOT EqStr(FBN['TipoOp'], 'BSALDOPOSIC')
      *- ca1: Cantidad VN  ca2: VR ca3: Valuacion
      acn(ca1,FBN['Cantidad'])
      acn(ca2,Round(val(ca1)*val(vr1),val(vr2)) )
      ACN(yw:1, val(ca1))
      (.'INTERESCLE'.)
      IF EqStr(Val(in1), 'CLE')
         IF Incluido(Val(al4), '1585')
            ACN(ca3, val(ca2)*val(cc1)+(Val(zz1)*Val(cc1)))
         ELSE
            ACN(ca3, val(ca2)*val(cc1)+Val(zz1))
         ENDIF
      ELSE
         ACN(ca3, val(ca1)*val(cc1))
      ENDIF

      * Retiros
      IF [Incluido(FBN['TipoOp'], 'RTP|') y FBN['FechaVto'] = Dialogo.Fecha1 y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'DTP|') y FBN['FechaVto'] = Dialogo.Fecha1 y EqStr(FBN['Inv'],'INV')]
         SCN(c:Val(fl1), val(ca1))
         SCN(c:Val(fl2), val(ca2))
         SCN(c:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dc1, Val(ca1))
            SCN(dc2, Val(ca2))
            SCN(dc3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
 
      * Depositos
      IF Incluido(FBN['TipoOp'], 'PDIVID|') y FBN['FechaVto'] = Dialogo.Fecha1
         SCN(d:Val(fl1), val(ca1))
         SCN(d:Val(fl2), val(ca2))
         SCN(d:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dd1, Val(ca1))
            SCN(dd2, Val(ca2))
            SCN(dd3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Depositos
      IF [Incluido(FBN['TipoOp'], 'DTP|') y FBN['FechaVto'] = Dialogo.Fecha1 y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'RTP|') y FBN['FechaVto'] = Dialogo.Fecha1 y EqStr(FBN['Inv'],'INV')]
         SCN(d:Val(fl1), val(ca1))
         SCN(d:Val(fl2), val(ca2))
         SCN(d:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dd1, Val(ca1))
            SCN(dd2, Val(ca2))
            SCN(dd3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Compras a liquidar a la Fecha1
      * TIDE/TICT FechaOp=Fys 
      * TIPO/TICO FechaVto=Fys 
      IF [Incluido(FBN['TipoOp'], 'CTC|CTP|TIC|TIFC|') y FBN['FechaVto']=Dialogo.Fecha1 y FBN['PaseCB']=0] o [Incluido(FBN['TipoOp'], 'TIDE|TICT|')  y FBN['FechaOp']=Dialogo.Fecha1] o [Incluido(FBN['TipoOp'], 'TIPO|TICO|')  y FBN['FechaVto']=Dialogo.Fecha1]
         SCN(e:Val(fl1), val(ca1))
         SCN(e:Val(fl2), val(ca2))
         SCN(e:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(de1, Val(ca1))
            SCN(de2, Val(ca2))
            SCN(de3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Ventas a liquidar a la Fecha1
      * TIDE/TICT FechaVto=Fys 
      * TIPO/TICO FechaOp=Fys 
      IF [Incluido(FBN['TipoOp'], 'VTC|VTP|TIV|TIFV|') y FBN['FechaVto'] = Dialogo.Fecha1 y FBN['PaseCB'] = 0] o [Incluido(FBN['TipoOp'], 'TIDE|TICT|')  y FBN['FechaVto']=Dialogo.Fecha1] o [Incluido(FBN['TipoOp'], 'TIPO|TICO|')  y FBN['FechaOp']=Dialogo.Fecha1]
         SCN(f:Val(fl1), val(ca1))
         SCN(f:Val(fl2), val(ca2))
         SCN(f:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(df1, Val(ca1))
            SCN(df2, Val(ca2))
            SCN(df3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Pases Activos Liq. a la Fecha1
      IF Incluido(FBN['TipoOp'], 'TIC|') y FBN['FechaVto'] = Dialogo.Fecha1 y FBN['PaseCB'] = 1
         *- Tic por pase activo que vence hoy, suma la posicion
         SCN(g:Val(fl1), val(ca1))
         SCN(g:Val(fl2), val(ca2))
         SCN(g:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dg1, Val(ca1))
            SCN(dg2, Val(ca2))
            SCN(dg3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
      IF Incluido(FBN['TipoOp'], 'TIFV|') y FBN['FechaVto'] = Dialogo.Fecha1 y FBN['PaseCB'] = 1
         *- Tifv por pase activo que vence hoy, resta la posicion
         SCN(g:Val(fl1), -val(ca1))
         SCN(g:Val(fl2), -val(ca2))
         SCN(g:Val(fl3), -val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dg1, -Val(ca1))
            SCN(dg2, -Val(ca2))
            SCN(dg3, -Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Pases Pasivos Liq. a la Fecha1
      IF Incluido(FBN['TipoOp'], 'TIV|') y FBN['FechaVto'] = Dialogo.Fecha1 y FBN['PaseCB'] = 1
         *- Tiv por Pase Pasivo que vence hoy resta a la posicion
         SCN(h:Val(fl1), -val(ca1))
         SCN(h:Val(fl2), -val(ca2))
         SCN(h:Val(fl3), -val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dh1, -Val(ca1))
            SCN(dh2, -Val(ca2))
            SCN(dh3, -Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      IF Incluido(FBN['TipoOp'], 'TIFC|') y FBN['FechaVto'] = Dialogo.Fecha1 y FBN['PaseCB'] = 1
         *- TiFC por Pase Pasivo que vence hoy SUMA a la posicion
         SCN(h:Val(fl1), val(ca1))
         SCN(h:Val(fl2), val(ca2))
         SCN(h:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dh1, Val(ca1))
            SCN(dh2, Val(ca2))
            SCN(dh3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Compras Futuras (DTP, CTC, CTP, TIC -que sea de un pase o no-, TIFC de no pase)
      *- TIPO/TICO FechaVto> Hoy 

      IF [Incluido(FBN['TipoOp'], 'DTP|CTC|CTP|TIC|') y FBN['FechaVto'] > Dialogo.Fecha1 y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'RTP|') y FBN['FechaVto'] > Dialogo.Fecha1 y EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'TIFC|') y FBN['FechaVto'] > Dialogo.Fecha1 y FBN['PaseCB'] = 0] o [Incluido(FBN['TipoOp'], 'TIPO|TICO|')  y FBN['FechaVto']>Dialogo.Fecha1]
         SCN(j:Val(fl1), val(ca1))
         SCN(j:Val(fl2), val(ca2))
         SCN(j:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dj1, Val(ca1))
            SCN(dj2, Val(ca2))
            SCN(dj3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Ventas Futuras (RTP, VTC, VTP, TIV -que sea de un pase o no-, TIFV de no pase)
      *- TIDE/TICT FechaVto> Hoy 
      IF [Incluido(FBN['TipoOp'], 'RTP|VTC|VTP|TIV|') y FBN['FechaVto'] > Dialogo.Fecha1 y Not EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'DTP|') y FBN['FechaVto'] > Dialogo.Fecha1 y EqStr(FBN['Inv'],'INV')] o [Incluido(FBN['TipoOp'], 'TIFV|') y FBN['FechaVto'] > Dialogo.Fecha1 y FBN['PaseCB'] = 0] o [Incluido(FBN['TipoOp'], 'TIDE|TICT|')  y FBN['FechaVto']>Dialogo.Fecha1]
         SCN(k:Val(fl1), val(ca1))
         SCN(k:Val(fl2), val(ca2))
         SCN(k:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dk1, Val(ca1))
            SCN(dk2, Val(ca2))
            SCN(dk3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Pases Activos no Liq. a la Fecha1
      IF Incluido(FBN['TipoOp'], 'TIFV|') y FBN['FechaVto'] > Dialogo.Fecha1 y FBN['PaseCB'] = 1
         SCN(l:Val(fl1), -val(ca1))
         SCN(l:Val(fl2), -val(ca2))
         SCN(l:Val(fl3), -val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dl1, -Val(ca1))
            SCN(dl2, -Val(ca2))
            SCN(dl3, -Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF

      * Pases Pasivos no Liq. a la Fecha1
      IF Incluido(FBN['TipoOp'], 'TIFC|') y FBN['FechaVto'] > Dialogo.Fecha1 y FBN['PaseCB'] = 1
         SCN(m:Val(fl1), val(ca1))
         SCN(m:Val(fl2), val(ca2))
         SCN(m:Val(fl3), val(ca3))
         IF Val(cr0) = 1 o Val(cr0) = 2
            SCN(dm1, Val(ca1))
            SCN(dm2, Val(ca2))
            SCN(dm3, Val(ca3))
            IF Val(cr0) = 1
               ACT(da1, 'SI')
            ELSE
               ACT(da2, 'SI')
            ENDIF
         ENDIF
      ENDIF
   ENDIF
Proximo

IF Val(cr0) <> -1
   ACN(i:Val(fl1), Val(b:Val(fl1))-Val(c:Val(fl1))+Val(d:Val(fl1))+Val(e:Val(fl1))-Val(f:Val(fl1))+Val(g:Val(fl1))+Val(h:Val(fl1)))
   ACN(i:Val(fl2), Val(b:Val(fl2))-Val(c:Val(fl2))+Val(d:Val(fl2))+Val(e:Val(fl2))-Val(f:Val(fl2))+Val(g:Val(fl2))+Val(h:Val(fl2)))
   ACN(i:Val(fl3), Val(b:Val(fl3))-Val(c:Val(fl3))+Val(d:Val(fl3))+Val(e:Val(fl3))-Val(f:Val(fl3))+Val(g:Val(fl3))+Val(h:Val(fl3)))

   ACN(n:Val(fl1), Val(i:Val(fl1))+Val(j:Val(fl1))-Val(k:Val(fl1))+Val(l:Val(fl1))+Val(m:Val(fl1)))
   ACN(n:Val(fl2), Val(i:Val(fl2))+Val(j:Val(fl2))-Val(k:Val(fl2))+Val(l:Val(fl2))+Val(m:Val(fl2)))
   ACN(n:Val(fl3), Val(i:Val(fl3))+Val(j:Val(fl3))-Val(k:Val(fl3))+Val(l:Val(fl3))+Val(m:Val(fl3)))

   IF Val(cr0) = 1 o Val(cr0) = 2
      SCN(di1, Val(i:Val(fl1)))
      SCN(di2, Val(i:Val(fl2)))
      SCN(di3, Val(i:Val(fl3)))

      SCN(dn1, Val(n:Val(fl1)))
      SCN(dn2, Val(n:Val(fl2)))
      SCN(dn3, Val(n:Val(fl3)))
   ENDIF

   Recorrer&i 2, 13
      If Val(&i:Val(fl1))<>0
         IF &i <> 9 y &i <> 2
            ACL(&i:Val(fl1), 'DPDXC2', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(cr0), Cantidad1=&i, Especie1=Val(es0), Radio2=Dialogo.Radio2, String1=Val(es1))
         ENDIF
      Endif
      IF &i <> 9 y &i = 2
         ACL(&i:Val(fl1), 'DETPO2', Fecha1=Dialogo.Fecha1, Vehiculo1=Dialogo.Vehiculo1, Radio1=Val(cr0), Especie1=Val(es0), Radio2=Dialogo.Radio2, String1=Val(es1))
      ENDIF
   Proximo

   * Si se listo al menos una Invest.
   IF EqStr(Val(da1),'SI') o EqStr(Val(da2),'SI')
      ACN(fl1, Val(fi1))
      SCN(fi1, 1)
      ACN(fl2, Val(fi1))
      SCN(fi1, 1)
      ACN(fl3, Val(fi1))
      SCN(fi1, 1)
      ACT(a:Val(fl1), '     Total Invest. Nom.')
      ACT(a:Val(fl2), '     Total Invest. Res.')
      ACT(a:Val(fl3), '     Total Invest. Efe.')

      ACN(b:Val(fl1), Val(db1))
      ACN(c:Val(fl1), Val(dc1))
      ACN(d:Val(fl1), Val(dd1))
      ACN(e:Val(fl1), Val(de1))
      ACN(f:Val(fl1), Val(df1))
      ACN(g:Val(fl1), Val(dg1))
      ACN(h:Val(fl1), Val(dh1))
      ACN(i:Val(fl1), Val(di1))
      ACN(j:Val(fl1), Val(dj1))
      ACN(k:Val(fl1), Val(dk1))
      ACN(l:Val(fl1), Val(dl1))
      ACN(m:Val(fl1), Val(dm1))
      ACN(n:Val(fl1), Val(dn1))

      ACN(b:Val(fl2), Val(db2))
      ACN(c:Val(fl2), Val(dc2))
      ACN(d:Val(fl2), Val(dd2))
      ACN(e:Val(fl2), Val(de2))
      ACN(f:Val(fl2), Val(df2))
      ACN(g:Val(fl2), Val(dg2))
      ACN(h:Val(fl2), Val(dh2))
      ACN(i:Val(fl2), Val(di2))
      ACN(j:Val(fl2), Val(dj2))
      ACN(k:Val(fl2), Val(dk2))
      ACN(l:Val(fl2), Val(dl2))
      ACN(m:Val(fl2), Val(dm2))
      ACN(n:Val(fl2), Val(dn2))

      ACN(b:Val(fl3), Val(db3))
      ACN(c:Val(fl3), Val(dc3))
      ACN(d:Val(fl3), Val(dd3))
      ACN(e:Val(fl3), Val(de3))
      ACN(f:Val(fl3), Val(df3))
      ACN(g:Val(fl3), Val(dg3))
      ACN(h:Val(fl3), Val(dh3))
      ACN(i:Val(fl3), Val(di3))
      ACN(j:Val(fl3), Val(dj3))
      ACN(k:Val(fl3), Val(dk3))
      ACN(l:Val(fl3), Val(dl3))
      ACN(m:Val(fl3), Val(dm3))
      ACN(n:Val(fl3), Val(dn3))

      SetFont(a:Val(fl1)..n:Val(fl3), 1)
      ACT(da1, 'NO')
      ACT(da2, 'NO')
      SCN(fi1, 1)
   ENDIF
ENDIF

SCN(fi1, 2)
ACT(a:Val(fi1),'FIN DE LISTADO')
SetFont(a:Val(fi1), 1)
FormatoCeldas(b1..n:Val(fi1), Exe('F2'))
SetFont(a1..n7, 1)
SetFont(b8..n:Val(fi1), 2)
Impresion(1,2)
ACO(1, 18)
ACO(2, 8)
ACO(3, 8)
ACO(4, 8)
ACO(5, 8)
ACO(6, 8)
ACO(7, 8)
ACO(8, 8)
ACO(9, 8)
ACO(10, 8)
ACO(11, 8)
ACO(12, 8)
ACO(13, 8)
ACO(14, 8)
FijarCol(2)
FijarFila(8)
SetPrintFit(3, 80)
LimitesVision(n:Val(fi1)+1)
RangoTitulo(a:1..n:Val(fi1)+1, 7)
