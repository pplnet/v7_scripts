CrearDialogo
  Fecha1   :'D.Fecha Op.'  ;;;;;;Dialogo.Fecha1 <> 0;'FechaOp Desde Invalida';NO;FSys
  Fecha2   :'H.Fecha Op.'  ;;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'FechaOp Hasta Invalida';NO;FSys
  Fecha3   :'D.Fecha Anu.' ;1;2;;;;Dialogo.Fecha3 <> 0;'Fecha Anulacion Desde Invalida';NO;FSys
  Fecha4   :'H.Fecha Anu.' ;2;2;;;;Dialogo.Fecha4 >= Dialogo.Fecha4;'Fecha Anulacion Hasta Invalida';NO;FSys
  Mercado1 :'Mercado'      ;3;1;;;;;;;   
  Vehiculo1:'Vehiculo'     ;4;1;;;;;;;Var('VEHICULODE')
  Radio1   : 'Filtro|Titulos|FX|MMkts|Todas';6;1;;;;;;;3
FinDialogo

if Not OK
   Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")
AgregarBMP(a1,Exe('LOGO'),80)

SetFilaActual(3)

ACT(k:2,'Fecha : '~Var('FECHASYS'))
SetFont(k:2..k:2,1)

ACT(e:FAC, 'Operaciones Anuladas')
SetFont(e:FAC..a:FAC,3)

SetFilaActual(FAC+2)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo: '~Dialogo.Vehiculo1)
else
   ACT(a:FAC+1, 'Vehiculo: Todos')
endif

if NoVacio(Dialogo.Mercado1)
   ACT(a:FAC+2, 'Mercado: '~Dialogo.Mercado1)
else
   ACT(a:FAC+2, 'Mercados: Todos')
endif
 
ACT(a:FAC+3, 'F.OP. Desde : '~Dialogo.Fecha1~' Hasta : '~Dialogo.Fecha2)
ACT(a:FAC+4, 'F.ANU. Desde : '~Dialogo.Fecha3~' Hasta : '~Dialogo.Fecha4)
 
SetFilaActual(FAC+6)
ACT(a:FAC, 'Numero')
ACT(b:FAC, 'Fecha Op.')
ACT(c:FAC, 'Fecha Vto.')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Tipo Op.')
ACT(f:FAC, 'Mercado')
ACT(g:FAC, 'Cliente')
ACT(h:FAC, 'Cantidad')
ACT(i:FAC, 'Precio')
ACT(j:FAC, 'Vehiculo')
ACT(k:FAC, 'Operador')
ACT(l:FAC, 'Corredor')
ACT(m:FAC, 'Nr.Boleto')
ACT(n:FAC, 'Nr.Alta MAE')
ACT(o:FAC, 'Nr.Baja MAE')
ACT(p:FAC, 'Anulado por')
ACT(q:FAC, 'Fecha Anulacion')
ACT(r:FAC, 'NrSisExterno')
ACT(s:FAC, 'Observac')

AlinearCeldas(a:FAC..g:FAC,'I')
AlinearCeldas(h:FAC..i:FAC,'D')
AlinearCeldas(j:FAC..s:FAC,'I')
SetFont(a:5..qs:FAC,2)

AgregarMarco(a:FAC..s:FAC,2,0,Exe('COLOR6'))

SetFilaActual(FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(z1, "Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
SQL.ADD(" Select * from ")
SQL.ADD(" (SELECT NrOperacion, FechaOp, FechaVto, Especie, FechaEj, PrecioEj, TipoOp, ")
SQL.ADD(" ContraEspecie, PaseCB, CB5, Arbitraje, Cliente1, Cantidad, Precio1, ")
SQL.ADD(" Vehiculo1, Operador, Corredor, Observaciones, NrBoleto, NroAltaMAE, NroBajaMAE, ")
SQL.ADD(" UsuarioDel, FechaDel, CASE WHEN  TipoOp in ('TICF','TIVF') THEN Mercado ELSE Mercado4 END MercNeg, NrExterno ")
SQL.ADD(" FROM "~DBO~".BOPERACIONES where "~Val(z1) ~"")
if Dialogo.Radio1=0
  SQL.ADD(" AND TipoOp in('TIC','TIV','TIFC','TIFV','TIPP','TIPA','TCC','TVC','TCP','TVP') ")
endif
if Dialogo.Radio1=1
  SQL.ADD(" AND TipoOp in('FXC','FXV','FXCT','FXVT','FXA','FXAT','FXP','FXCTC','FXVTC') ")
endif
if Dialogo.Radio1=2
  SQL.ADD(" AND TipoOp in('MMCO','MMCT','MMCA','MMAD','MMPF','MMPFCE','MMPO','MMDES','MMDIVA','FCS','FCR') ") 
endif
SQL.ADD(" AND (FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ) ")
SQL.ADD(" AND FechaDel >= '"~IdxDate(Dialogo.Fecha3)~"' ")
SQL.ADD(" AND FechaDel <= '"~IdxDate(Dialogo.Fecha4+1)~"' ")
SQL.ADD(" ) as Aux")
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Where MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("order by NrOperacion")

Recorrer SQL
  SCN(z2,1)  
  ACT(z3, ' ')

  ACT(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['FechaOp'])
  ACT(c:FAC, FBN['FechaVto'])
  ACT(d:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  if Incluido(fbn('TipoOp'), 'MMDIVA')
    ACT(d:fac, fbn('Especie')~' ('~fbn('ContraEspecie')~')')
  endif
  ACT(e:FAC, FBN['TipoOp'])
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('PaseCB')=1
    ACT(e:FAC, Val(f:FAC)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV') y fbn('CB5')=1
    ACT(e:FAC, Val(f:FAC)~' (Of.)')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT|FXA|FXAT') y fbn('PaseCB')=1
    ACT(e:FAC, Val(f:FAC)~' x Pase')
  endif
  if Incluido(fbn('TipoOp'),'FXC|FXV|FXCT|FXVT') y fbn('Arbitraje')=1
    ACT(e:FAC, Val(f:FAC)~' x Arb.')
  endif
  if Incluido(fbn('TipoOp'), 'TCC|TVC|TCP|TVP')
    ACT(d:FAC, FBN['Especie']~' '~FBN['PrecioEj'])
    ACN(z6, 1)
  endif
  ACT(f:FAC, FBN['MercNeg'])  
  ACT(g:FAC, FBN['Cliente1'])

  If Incluido(fbn('TipoOp'), 'FXCTC|FXVTC|')  
     ACN(h:FAC, FBN['Cantidad'] *  BuscarCampo('ESPECIES','TamanioLote','Codigo',fbn('Especie')) )
  Else
     ACN(h:FAC, FBN['Cantidad']  )
  ENDIF

  ACN(i:FAC, FBN['Precio1'])
  ACT(j:FAC, FBN['Vehiculo1'])
  ACT(k:FAC, FBN['Operador'])
  ACT(l:FAC, FBN['Corredor'])
  ACT(m:FAC, FBN['NrBoleto'])
  ACT(n:FAC, FBN['NroAltaMAE'])
  ACT(o:FAC, FBN['NroBajaMAE'])
  ACT(p:FAC, FBN['UsuarioDEL'])
  ACT(q:FAC, FBN['FechaDEL'])
  ACT(r:fac, FBN['NrExterno'])
  ACT(s:FAC, FBN['Observaciones'])

  AlinearCeldas(b:FAC..c:FAC,'D')
  FormatoCeldas(i:fac..i:fac,Exe('F7'))
  ACLBO(a:fac, Val(a:fac))
proximo

SetFont(a:Val(w1)+6..s:FAC,1)

ACO(1,7)
ACO(2,7)
ACO(3,7)
if Val(z6)=1
  ACO(4,10)
else
  ACO(4,8)
endif
ACO(5,6)
ACO(6,8)
ACO(7,8)
ACO(8,8)
ACO(9,6)
ACO(10,6)
ACO(11,8)
ACO(12,8)
ACO(13,8)
ACO(14,8)
ACO(15,8)
ACO(16,13)
ACO(17,13)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC,2)
LimitesVision(s:FAC)
RangoTitulo(a:1..l:FAC, Val(w1)+5)
ACT(a5, 'Cantidad de Operaciones anuladas: '~FStr(Val(z2),4,0))
SetFont(a4..a5,2)
SetPrintFit(3,71)
Impresion(1,2)
