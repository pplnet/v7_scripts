ModoReproceso(SinDialogo)
CrearDialogo
   Fecha1    : 'Fecha'    ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha';NO;Fsys
   Vehiculo1 : 'Vehiculo' ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');;;;
FinDialogo


If Not Ok
   Cancelar
EndIf


ACT(A:1, 'Posicion de Opciones - '~Fecha(Dialogo.Fecha1))

ACT(A:2, 'Especie')

ACT(A:3, 'Fecha Ej./Strike')
ACT(B:2, 'Cotizacion')
ACT(B:3, 'Subyacente')
ACT(C:2, 'Calls')
ACT(D:3, 'Compras')
ACT(C:4, 'Cotizacion')

ACT(D:4, 'Total V.N.')
ACT(E:4, 'PPP Prima')
ACT(F:3, 'Ventas')
ACT(F:4, 'Total V.N.')
ACT(G:4, 'PPP Prima')
ACT(H:3, 'Neto')

ACT(I:2, 'Puts')
ACT(I:4, 'Cotizacion')
ACT(J:3, 'Compras')
ACT(J:4, 'Total V.N.')
ACT(K:4, 'PPP Prima')
ACT(L:3, 'Ventas')
ACT(L:4, 'Total V.N.')
ACT(M:4, 'PPP Prima')
ACT(N:3, 'Neto')

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(A:1..N:4, 1)
*AgregarMarco(A:2..N:4,2,0,Exe('COLOR'))

SetFilaActual(3)

SQL.ADD("SELECT  O.TipoOp, O.Cantidad, O.Especie, O.PrecioEj, O.Precio1, O.FechaEj, O.TipoOpcion, O.NrOperacion, O.FechaVto2 ")
SQL.ADD("FROM    "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("WHERE   O.NrOperacion=B.NrOperacion and ")
SQL.ADD("        B.Valor=0 and B.NrBit in ('30') and ")
SQL.ADD("        O.TipoOp in ('OCC','OVC','OCP','OVP') and ")
SQL.ADD("        O.FechaEj > '"~IdxDate(Dialogo.Fecha1)~"' and ")
SQL.ADD("        O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("ORDER BY O.Especie, O.FechaEj, O.PrecioEj, O.Cliente1")

Recorrer SQL

  dfa

  if Not EqStr(fbn('Especie'), Val(z1))
     ACT(z1, fbn('Especie'))
     if Val(E:fac) > 0 o Val(G:fac) > 0 o Val(K:fac) > 0 o Val(M:fac) > 0
        ACN(E:fac, Val(E:fac)/Val(D:fac))
        ACN(G:fac, Val(G:fac)/Val(F:fac))
        ACN(K:fac, Val(K:fac)/Val(J:fac))
        ACN(M:fac, Val(M:fac)/Val(L:fac))
        ACN(H:fac, Val(D:fac)-Val(F:fac))
        ACN(N:fac, Val(J:fac)-Val(L:fac))
        SetFont(a:fac..N:fac, 2)
        if Val(z3) > 0
           SCN(H:Val(z3), Val(H:fac))
           SCN(N:Val(z3), Val(N:fac))
           SetFont(a:Val(z3)..N:Val(z3), 1)
           AgregarMarco(a:Val(z3)..N:Val(z3),1)
        endif
     endif
 
     SetFilaActual(fac+2)
     ACN(z3, fac)
 
     ACT(a:fac, fbn('Especie')~' - '~BuscarCampo('ESPECIES','Nombre','Codigo',FBN['Especie']))
     SetFont(a:fac..N:fac, 1)
     ACT(z2, 'xx')
     ACN(z4, 0)
  endif
  if not [EqStr(fbn('FechaEj'), Val(z2)) y fbn('PrecioEj')=Val(z4)]
     if Val(E:fac) > 0 o Val(G:fac) > 0 o Val(K:fac) > 0 o Val(M:fac) > 0
        ACN(E:fac, Val(E:fac)/Val(D:fac))
        ACN(G:fac, Val(G:fac)/Val(F:fac))
        ACN(K:fac, Val(K:fac)/Val(J:fac))
        ACN(M:fac, Val(M:fac)/Val(L:fac))
        ACN(H:fac, Val(D:fac)-Val(F:fac))
        ACN(N:fac, Val(J:fac)-Val(L:fac))
        SetFont(a:fac..N:fac, 2)
        if Val(z3) > 0
           SCN(H:Val(z3), Val(H:fac))
           SCN(N:Val(z3), Val(N:fac))
        endif
     endif
     ifa
     ACT(z2, fbn('FechaEj'))
     ACN(z4, fbn('PrecioEj'))
     ACT(a:fac, fbn('FechaEj')~' / '~FStr(fbn('PrecioEj'),1,7))
     ACL(a:fac, 'DPOSO3',Especie1 = Val(z1),Vehiculo1=Dialogo.Vehiculo1,Fecha1 = fbn('FechaEj'),Precio1 = fbn('PrecioEj'))
     
     If DesciendeDeEspecie(Val(Z:1),'MONEDA')
        If DesciendeDeEspecie(Val(Z:1),'MROFEX')
           ACN(B:fac, Cotizacion('USD','FUT',fbn('FechaVto2'),,Dialogo.Fecha1,1,SI,NO))
        Else
           ACN(B:fac, Cotizacion('USD','CON',,,Dialogo.Fecha1,1,SI,NO))
        EndIf
     Else
        ACN(B:fac, Cotizacion(Val(Z:1),'CON',,,Dialogo.Fecha1,1,SI,NO))
     EndIf
     
     ACN(C:fac, Cotizacion(Val(Z:1),'CAL',fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,NO))
     ACN(I:fac, Cotizacion(Val(Z:1),'PUT',fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,NO))
     IF Val(C:fac) = 0 O Val(I:fac) = 0
        ***---Parametros B&S
        ***---Precio: numero decimal
        ***---Contado: bool (true: contado, false: futuro)
        ***---PrecioEj: numero decimal
        ***---Plazo: numero entero
        ***---DiasAño: numero entero
        ***---Volatilidad: numero decimal
        ***---TipoTasa: numero entero
        ***---   0: TEA
        ***---   1: TNA
        ***---   2: TIA
        ***---Tasa: numero decimal
        ***---TasaAlq: numero decimal
        ***---Modalidad: bool (true: Europea, false: Americana)

        ***---Subyacente
        ACT(SB:1, Val(Z:1))
        ***---Cotizacion Contado del Subyacente
        ACN(CT:1, Cotizacion(Val(SB:1),'CON',,,Dialogo.Fecha1,1,SI,NO))
        ***---Plazo Remanente en dias
        ACN(PL:1, (fbn('FechaEj') - Dialogo.Fecha1) / 365)
        ACN(PL:1, fbn('FechaEj') - Dialogo.Fecha1)
        ***---Volatilidad. La Cotizacion Nro 20 es que tiene la etiqueta VolatilidadHO, pero se guarda en el campo VolatilidadMercado. VolatilidadBCRA se guarda en
        ***---VolatilidadHistoria. Ver con Juan si puede invertirse.
        ACN(VL:1, Cotizacion(Val(SB:1),'CON',,,Dialogo.Fecha1,20,SI,NO))
        If DesciendeDeEspecie(Val(Z:1),'MROFEX')
           ACN(VL:1, Cotizacion('USD','FUT',fbn('FechaVto2'),,Dialogo.Fecha1,20,SI,NO))
        Else
           ACN(VL:1, Cotizacion(Val(SB:1),'CON',,,Dialogo.Fecha1,20,SI,NO))
        EndIf
        ***---Modalidad
        ACN(TO:1, BuscarCampo('OPERACIONES','TipoOpcion','NrOperacion', fbn('NrOperacion')))
        IF Val(TO:1) = 0
           ACT(TO:2, 'NO')
        ELSE
           ACT(TO:2, 'SI')
        ENDIF

***---MessageBox(Val(CT:1)~','~'SI'~','~fbn('PrecioEj')~','~Val(PL:1)~','~Fstr(365, 0, 0)~','~Val(VL:1)~','~Fstr(1, 0, 0)~','~Var('TASABYS')~','~Fstr(0, 0, 0)~','~Val(TO:2))

        IF Val(C:fac) = 0
            If Val(VL:1)>0
               *ACN(C:fac, BYSPrimaCall(3.5, SI, 3.6, 30, 365, 10.5, 0, 10, 11, SI))
               ACN(C:fac, BYSPrimaCall(Val(CT:1),SI,fbn('PrecioEj'),Val(PL:1),365,Val(VL:1),1,Var('TASABYS'), 0, Val(TO:2)))
            Else
               ACN(C:fac, 0)
            EndIf
        ENDIF
        IF Val(I:fac) = 0
            If Val(VL:1)>0
               *ACN(I:fac, BYSPrimaPut(3.5, SI, 3.6, 30, 365, 10.5, 0, 10, 11, SI))
               ACN(I:fac, BYSPrimaPut(Val(CT:1),SI,fbn('PrecioEj'),Val(PL:1),365,Val(VL:1),1,Var('TASABYS'), 0, Val(TO:2)))
            Else
               ACN(I:fac, 0)
            EndIf
        ENDIF
     ENDIF
   endif
   if Incluido(fbn('TipoOp'), 'OCC')
      SCN(D:fac, fbn('Cantidad'))
      SCN(E:fac, fbn('Cantidad')*fbn('Precio1'))
   endif
   if Incluido(fbn('TipoOp'), 'OVC')
      SCN(F:fac, fbn('Cantidad'))
      SCN(G:fac, fbn('Cantidad')*fbn('Precio1'))
   endif
   if Incluido(fbn('TipoOp'), 'OCP')
      SCN(J:fac, fbn('Cantidad'))
      SCN(K:fac, fbn('Cantidad')*fbn('Precio1'))
   endif
   if Incluido(fbn('TipoOp'), 'OVP')
      SCN(L:fac, fbn('Cantidad'))
      SCN(M:fac, fbn('Cantidad')*fbn('Precio1'))
   endif
Proximo

if fac > 3
   ACN(E:fac, Val(E:fac)/Val(D:fac))
   ACN(G:fac, Val(G:fac)/Val(F:fac))
   ACN(K:fac, Val(K:fac)/Val(J:fac))
   ACN(M:fac, Val(M:fac)/Val(L:fac))
   ACN(H:fac, Val(D:fac)-Val(F:fac))
   ACN(N:fac, Val(J:fac)-Val(L:fac))
   SetFont(a:fac..N:fac, 2)
   if Val(z3) > 0
      SCN(H:Val(z3), Val(H:fac))
      SCN(N:Val(z3), Val(N:fac))
      SetFont(a:Val(z3)..N:Val(z3), 1)
      AgregarMarco(a:Val(z3)..N:Val(z3),1)
  endif
endif

AgregarMarco(B:2..B:4, 1)
AgregarMarco(C:3..C:4, 1)
AgregarMarco(C:2..H:2, 1)
AgregarMarco(I:2..N:2, 1)
AgregarMarco(I:3..I:4, 1)
AgregarMarco(D:3..E:3, 1)
AgregarMarco(D:4..E:4, 1,2)
AgregarMarco(F:3..G:3, 1)
AgregarMarco(F:4..G:4, 1,2)
AgregarMarco(J:3..K:3, 1)
AgregarMarco(J:4..K:4, 1,2)
AgregarMarco(L:3..M:3, 1)
AgregarMarco(L:4..M:4, 1,2)
AgregarMarco(A:2..N:4,2,0,Exe('COLOR'))

*AgregarMarco(A:4..N:fac, 1)
*AgregarMarco(D:4..D:fac, 1)
*AgregarMarco(E:4..E:fac, 1)
*AgregarMarco(F:4..F:fac, 1)
*AgregarMarco(G:4..G:fac, 1)
*AgregarMarco(H:3..H:fac, 1)
*AgregarMarco(I:4..I:fac, 1)
*AgregarMarco(J:4..J:fac, 1)
*AgregarMarco(K:4..K:fac, 1)
*AgregarMarco(L:4..L:fac, 1)
*AgregarMarco(M:4..M:fac, 1)
*AgregarMarco(N:3..N:fac, 1)

FormatoCeldas(A:1..N:fac, Exe('F2'))
FormatoCeldas(B:1..C:fac, Exe('F8'))
FormatoCeldas(C:1..C:fac, Exe('F8'))
FormatoCeldas(E:1..E:fac, Exe('F6'))
FormatoCeldas(F:1..F:fac, Exe('F6'))
FormatoCeldas(I:1..I:fac, Exe('F8'))
FormatoCeldas(K:1..K:fac, Exe('F6'))
FormatoCeldas(M:1..M:fac, Exe('F6'))



ACO(1, 20)
ACO(2, 8)
ACT(A:FAC+2, 'FIN DEL LISTADO')
SetFont(a:fac+2..a:fac+2, 1)

LimitesVision(N:fac+3)
RangoTitulo(A:1..N:fac+3, 4)

