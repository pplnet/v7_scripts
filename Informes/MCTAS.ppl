MostrarCuadroDeMensajes
CrearDialogo
   Fecha1: 'D.Fecha' ;;;;;;;;;fsys
   Fecha2: 'H.Fecha' ;;;;;;;;;fsys
FinDialogo

If NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ifa
ACT(a:fac, 'Movimientos por Cuenta Contable del '~dialogo.fecha1~' al '~dialogo.fecha2)
setfont(a:fac..z:fac,3)

ifa
ifa
ACT(a:fac, 'Cuenta')
ACT(b:fac, 'FechaVal')
ACT(c:fac, 'FechaGen')
ACT(d:fac, 'DebCre')
ACT(e:fac, 'Cantidad')
ACT(f:fac, 'Saldo')
ACT(g:fac, 'Modelo')
ACT(h:fac, 'Item')
ACT(i:fac, 'Operacion')
ACT(j:fac, 'NrTrans')
ACT(k:fac, 'Asiento')
setfont(a:fac..z:fac,2)
AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR6'))
AlinearCeldas(a:fac..z:fac,'C')


SQL.ADD(" SELECT A.FechaValor, A.FechaGeneracion, A1.Cuenta, A1.DebitoCredito, A.Modelo, A1.Alias3, ")
SQL.ADD(" CASE WHEN A1.DebitoCredito = 'DEB' THEN A1.Cantidad1 ELSE -A1.Cantidad1 END Cantidad, ")
SQL.ADD(" A.NrOperacion, A.NrTrans2, A.NrUnicoAsiento ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON1 A1, "~DBO~".ASIENTOSCON A ")
SQL.ADD(" WHERE  A1.NrUnicoAsiento = A.NrUnicoAsiento         ")
SQL.ADD(" AND    A.FechaValor >= "~IDXDATE2(dIALOGO.FECHA1)~" ")
SQL.ADD(" AND    A.FechaValor <= "~IDXDATE2(dIALOGO.FECHA2)~" ")
SQL.ADD(" ORDER BY A1.Cuenta, A.FechaValor ")
ACT(ca:1,'XX')
Recorrer SQL
   If Not eqstr(fbn('Cuenta'),Val(ca:1))
      If Not eqstr('XX',Val(ca:1))
         ACT(a:fac, 'Total al '~Dialogo.Fecha2~'->')
         ACN(e:fac, sum(e:Val(fi:1)..e:fac) )
         setfont(a:fac..z:fac,2)
         IFA
         ifa
      Endif
      ACT(a:fac, 'Cuenta Contable: '~fbn('Cuenta'))
      setfont(a:fac,2)
      AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR8'))
      ifa
      ACN(fi:1, fac)
   Endif
   ACD(b:fac, fbn('FechaValor'))
   ACD(c:fac, fbn('FechaGeneracion'))
   ACT(d:fac, fbn('DebitoCredito'))
   ACN(e:fac, fbn('Cantidad'))
   ACN(f:fac, Val(f:fac-1)+fbn('Cantidad'))
   ACT(g:fac, fbn('Modelo'))
   ACL(g:fac, 'INV005',String=fbn('Modelo'))
   ACT(h:fac, fbn('Alias3'))
   ACT(i:fac, fbn('NrOperacion'))
   ACLO(i:fac, fbn('NrOperacion'))
   ACT(j:fac, fbn('NrTrans2'))
   ACLT(j:fac, fbn('NrTrans2'))
   ACT(k:fac, fbn('NrUnicoAsiento'))
   ACT(ca:1, fbn('Cuenta'))
   setfont(B:Val(fi:1)..z:fac,1)
Proximo
