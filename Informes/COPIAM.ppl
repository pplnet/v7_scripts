*    EndIf

    ACT(z:FAC, fbn('Mercado4'))
    scn(tT2,1)
    SetFont(a:FAC..af:FAC,1)
    FormatoCeldas(k:fac,Exe('F8'))
    AlinearCeldas(g:FAC..g:FAC,'D')
    AlinearCeldas(s:FAC..t:FAC,'D')
    AlinearCeldas(e:FAC..e:FAC,'I')

    ACD(fo:1, fbn('FechaOp'))
    ACN(me:1, mes(fbn['FechaOp']))
