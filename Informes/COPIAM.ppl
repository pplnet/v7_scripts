CrearDialogo
   Vehiculo1  :'Vehiculo'   ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1     :'Desde Fecha' ;;;;;;;;;;FSYS
   Fecha2     :'Hasta Fecha' ;;;;;;;;;;FSYS
   Especie1   :'Moneda Totales' ;;;;NO;NO;noVacio(Dialogo.Especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";
FinDialogo
If not Ok
   Cancelar
endif

CrearFont(1, 'Arial,7,')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,8,B')
CrearFont(4, 'Arial,7,B')

SetFilaActual(1)
ACN(zz1,FAC)

ACT(j:FAC+1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Vehiculo1))
ACT(j:FAC+2, 'Registro de Operaciones desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
AlinearCeldas(j:FAC+1..j:FAC+2,'C')

ACT(q:fac+2, 'Cotizacion USD: '~fstr(Cotizacion('USD',,,,FSYS,1,SI),0,8))

SetFilaActual(fac+4)

ACT(a:FAC, 'Boleto')
ACT(b:FAC, 'Nr.Minuta')
ACT(c:FAC, 'Fecha Op.')
ACT(d:FAC, 'Fecha Liq.')
ACT(e:FAC, 'Tipo Op')
ACT(f:FAC, 'Hora Op')
ACT(g:FAC, 'Nro Mercado')
ACT(h:FAC, 'Comitente')
ACT(i:FAC, 'Especie')
ACT(j:FAC, 'Cantidad VN')
ACT(k:FAC, 'Precio')
ACT(l:FAC, 'Importe Bruto')
ACT(m:FAC, 'Intereses')
ACT(n:FAC, 'Importe Neto')
ACT(o:FAC, 'Comision')
ACT(p:FAC, 'Iva')
ACT(q:FAC, 'Aforo')
ACT(r:FAC, 'Age.')
ACT(s:fac, 'Moneda')
ACT(t:FAC, 'Baja')
ACT(u:FAC, 'Contraparte')
ACT(v:FAC, 'CUIT')
ACT(w:FAC, 'Nro Orden')
ACT(x:FAC, 'Fecha Orden')
ACT(y:FAC, 'Hora Orden')
ACT(z:FAC, 'Mercado')

ACN(ay:1,fac)

AlinearCeldas(a:FAC..af:FAC,'C')
AgregarMarco(a:FAC..af:FAC,2)
SetFont(a:FAC..af:FAC,2)

*ACN(aa:1,FAC)

SQL.ADD(" SELECT 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
SQL.ADD(" OP.FechaPago, OP.FechaCarga, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, Convert(Char(12), OP.FechaAltaMAE, 14) as HoraMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.NrOrden, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE,'O' Tabla, OP.CB5,OP.FechaBajaCV as FechaOrden,OP.Sucursal as HoraOrden, PorAforo")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OPB.NrBit IN (30,31) AND ")
SQL.ADD("      OPB.Valor = 1  ")
SQL.ADD("  AND OP.NroAltaMAE<>'0' ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT 'Alta' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
SQL.ADD(" OP.FechaPago, OP.FechaCarga, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, Convert(Char(12), OP.FechaAltaMAE, 14) as HoraMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.NrOrden, OP.Mercado4, ")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE,'O' Tabla, OP.CB5,OP.FechaBajaCV as FechaOrden,OP.Sucursal as HoraOrden, PorAforo ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OPB.NrBit not IN (1,30,31) AND ")
SQL.ADD("      OPB.Valor = 1 ")
SQL.ADD("  and OP.NroAltaMAE<>'0' ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
SQL.ADD(" OP.FechaPago, OP.FechaCarga, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, Convert(Char(12), OP.FechaAltaMAE, 14) as HoraMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE,OP.NrOperacion3, ")
SQL.ADD(" '0' Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, OP.CB8, OP.NrOrden, OP.Mercado4,")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE,'B' Tabla, OP.CB5,OP.FechaBajaCV as FechaOrden,OP.Sucursal as HoraOrden, PorAforo ")
SQL.ADD(" from "~DBO~".BOPERACIONES OP, "~DBO~".CLIENTES C ")
SQL.ADD("where OP.FechaCargaSys     >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("      and OP.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("      and OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'   ")
SQL.ADD("      and OP.Cliente1  = C.Codigo ")
SQL.ADD("      AND (OP.NrBoleto is not null or OP.NrBoleto<>'' or OP.NrBoleto <>' ') ")
SQL.ADD("      and  OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND OP.NroAltaMAE<>'0'  ")
SQL.ADD("      and (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT 'cBaja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
SQL.ADD(" OP.FechaPago, OP.FechaCarga, ")
SQL.ADD(" OP.Especie, -OP.Cantidad, OP.Precio1, -OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, Convert(Char(12), OP.FechaAltaMAE, 14) as HoraMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, -OP.TotalBrutoCli1, -OP.TotalIntereses, OP.EsAforado, -OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, -OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, ")
SQL.ADD(" OPB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, -OP.TotalAux2, -OP.TotalAux4, OP.CB8, OP.NrOrden, OP.Mercado4,")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE,'O' Tabla, OP.CB5,OP.FechaBajaCV as FechaOrden,OP.Sucursal as HoraOrden, PorAforo ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND  ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND  ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND          ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND          ")
SQL.ADD("      OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ")
SQL.ADD("      (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) AND ")
SQL.ADD("      OPB.NrBit IN (30,31) AND ")
SQL.ADD("      OPB.Valor = 1  ")
SQL.ADD("  AND OP.NroAltaMAE<>'0' ")

SQL.ADD(" UNION ")

SQL.ADD(" SELECT 'cBaja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
SQL.ADD(" OP.FechaPago, OP.FechaCarga, ")
SQL.ADD(" OP.Especie, -OP.Cantidad, OP.Precio1, -OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, Convert(Char(12), OP.FechaAltaMAE, 14) as HoraMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, -OP.TotalBrutoCli1, -OP.TotalIntereses, OP.EsAforado, -OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, -OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE,OP.NrOperacion3, ")
SQL.ADD(" '0' Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, -OP.TotalAux2, -OP.TotalAux4, OP.CB8, OP.NrOrden, OP.Mercado4,")
SQL.ADD(" OP.Convenio, OP.FechaAltaSisExterno, OP.FechaAltaMAE,'B' Tabla, OP.CB5,OP.FechaBajaCV as FechaOrden,OP.Sucursal as HoraOrden, PorAforo ")
SQL.ADD(" from "~DBO~".BOPERACIONES OP, "~DBO~".CLIENTES C ")
SQL.ADD("where OP.FechaCargaSys     >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("      and OP.FechaCargaSys <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("      and OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'   ")
SQL.ADD("      and OP.Cliente1  = C.Codigo ")
SQL.ADD("      AND (OP.NrBoleto is not null or OP.NrBoleto<>'' or OP.NrBoleto <>' ') ")
SQL.ADD("      AND OP.TipoOp   In ('TIC','TIV','TIFC','TIFV','FXCF','FXVF') AND OP.NroAltaMAE<>'0' ")
SQL.ADD("      and (OP.NroAltaMAE <> '' AND OP.NroAltaMAE <> ' ' AND OP.NroAltaMAE IS NOT NULL ) ")

SQL.ADD("ORDER BY OP.FechaOp, OP.NrBoleto, OP.NrOperacion ")


*acn(Tt2,0)
*acn(zu1,0)
*acn(KK1,FAC+1)
*ACD(fo:1, 0)
*ACN(me:1, 0)
*ACN(TQ:1, 0)
*ACN(TQ:2, 0)
*ACN(TT:1, 0)
*ACN(TT:3, 0)
*ACN(TV:1, 0)
*ACN(TV:2, 0)
*ACN(TW:1, 0)
*ACN(TW:2, 0)
*ACN(TX:1, 0)
*ACN(TX:2, 0)

watch(SQL.Batch)

Recorrer SQL

    ACN(CT:1, CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),1,SI,'ARP'))
    IF Not Eqstr(Dialogo.Especie1, 'ARP')        
       ACN(CT:2, CotizacionC(fbn('ContraEspecie'),,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
    ELSE
        ACN(CT:2, Val(CT:1))
    ENDIF
    ACN(zu1,1)
    If fbn('FechaOp')<>Val(fo:1) y val(fo:1)<>0
       ACT(a:fac,'FIN DIA '~VAL(fo:1))
       SetFont(a:FAC..af:FAC,3)
       ifa
    Endif

    If Mes(fbn('FechaOp'))<>Val(me:1) y 0<>Val(me:1)
       ACT(a:fac,'FIN MES')
       SetFont(a:FAC..af:FAC,3)
       ifa
    Endif

    ACT(a:FAC, IIF(longitud(fbn['NrBoleto'])<=6,fbn['NrBoleto'],Copy(fbn['NrBoleto'],longitud(fbn['NrBoleto'])-5,6)) )
    ACT(b:FAC, Copy(fbn['NrOperacion'],1,8))
    If EqStr(FBN['Tabla'],'O') 
       ACLO(b:FAC, Copy(fbn['NrOperacion'],1,8))
    Else
      ACLBO(b:FAC, Copy(fbn['NrOperacion'],1,8))
    EndIF

    message('Operacion '~Val(b:fac))
    ACD(c:FAC, fbn['FechaOp'])
    ACD(FE:1, fbn('FechaOp'))
* FJL 28/06/19 - Issue 3773 - Se modifica para muestre siempre la fecha de Vto Original
*    If Eqstr(fbn('Convenio'),'1')
*       ACD(d:FAC, fbn['FechaAltaSisExterno'])
*    Else
*       ACD(d:FAC, fbn['FechaVto'])
*    Endif
    if Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV|TCOPRI')
      If Eqstr(fbn('Convenio'),'1')
        * Operaciones Diferidas
        ACD(d:FAC, fbn['FechaPago'])
      Else
        ACD(d:FAC, fbn['FechaVto'])
      Endif
    Else
      ACD(d:FAC, fbn['FechaVto'])
    Endif
    If Incluido(fbn['TipoOp'],'TIC')
       ACT(e:FAC, 'Compra')
    EndIf
    If Incluido(fbn['TipoOp'],'TIV')
       ACT(e:FAC, 'Venta')
    Endif
    If Incluido(fbn['TipoOp'],'TIFC')
       ACT(e:FAC, 'Compra Fut')
    EndIf
    If Incluido(fbn['TipoOp'],'TIFV')
       ACT(e:FAC, 'Venta Fut ')
    Endif
    If EqStr(fbn['PaseCB'],'1')
       ACT(e:FAC, val(e:fac)~' Por Pase ')       
    EndIf

* FJL 02/11/18 - Esto se igualo con BOLEXT
*    IF fbn('CB8') = 1 o  fbn('CB5') = 1
*      ACT(f:FAC, Hora(fbn['FechaAltaMAE']))
*    ELSE
*      ACT(f:FAC, Hora(fbn['FechaEnvioMAE']))
*    ENDIF
    * FJL 05/12/18 - Nuevo criterio
    IF NoVacio(fbn('FechaAltaMAE'))
      ACT(f:FAC, Hora(fbn['FechaAltaMAE']))
    ELSE
      ACT(f:FAC, HORA(FBN['FechaCarga']))
    ENDIF

    If Num(fbn['NroAltaMae'])>0
       ACT(g:FAC, fbn['NroAltaMae'])
       SQL.ADD(" Select * from "~DBO~".ESPECIES Where Codigo= '"~FBN['Especie']~"' ") 
       Recorrer SQL
          dfa
          *- Especie
          ACT(i:fac,Pad(FBN['CodMAEContado'],5))
       Proximo
    Else
       ACT(g:FAC, 'N/A')
       ACT(i:FAC,FBN['Especie'])
       *ACT(ac:FAC, fbn['NroAltaMAE'])
    Endif
    SQL.ADD(" Select CodMAEContado, Nombre From "~DBO~".ESPECIES Where Codigo = '"~fbn('Especie')~"' ")
    Recorrer SQL
        DFA
        ACT(i:fac, fbn('CodMAEContado')~' - '~Copy(fbn('Nombre'), 1, 15))
    Proximo
    ACT(H:fac, fbn('Cliente1')~' - '~Copy(fbn('RazonSocial'),1,25))

    ACN(j:FAC, fbn['Cantidad'])

    If Eqstr(FBN['Especie'],'FRB') 
       ACN(k:fac, FBN['Precio1']*BuscarCampo('ESPECIES','VTeorico','Codigo',FBN['Especie']) )
    Else
       ACN(k:fac, FBN['Precio1'])
    Endif
  
    ACN(l:FAC, fbn['TotalBrutoCli1'])

    *- Si la especie es Dirty Clean igualmente calculo los intereses
    IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'CLE') y EqStr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'DIR')
       *- Calculo el precio sacandole los intereses
       ACN(k:fac,(fbn['TotalNetoCli1']-fbn['TotalIntereses'])/fbn['Cantidad'])
       ACN(l:FAC, fbn['TotalBrutoCli1']-fbn['TotalIntereses'])
    EndIf

    * - La especie es CLEAN DIRTY, informo Neto y precio sucio
    IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'DIR') y EqStr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'CLE')
       *- Calculo el precio sacandole los intereses
       ACN(k:fac,(fbn['TotalNetoCli1'])/fbn['Cantidad'])
       ACN(l:FAC, fbn['TotalNetoCli1'])
    EndIf

    IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'CLE')
       ACN(m:FAC, fbn['TotalIntereses'])
    Else
       ACN(m:FAC, 0)
    Endif
    ACN(n:FAC, fbn['TotalNetoCli1'])
    If EqStr(fbn['EsAforado'],'1')
       ACT(e:FAC, val(e:fac)~' Aforado ')       
       ACN(n:FAC, fbn['TotalCaucion'])
       ACN(q:fac,fbn('PorAforo'))
    EndIf

    If Incluido(fbn['TipoOp'],'TIC|TIV')
       ACN(o:fac, fbn('TotalAux2'))
       ACN(p:fac, fbn('TotalAux4'))
       If Incluido(fbn('TipoOp'),'TIC')
         ACN(n:FAC, Val(n:fac)-FBN('TotalAux2')-FBN('TotalAux4'))
       Else
         ACN(n:FAC, Val(n:fac)+FBN('TotalAux2')+FBN('TotalAux4'))
       Endif
    Endif

    ACT(R:FAC, Copy(BuscarCampo('Clientes','NrMAE','Codigo',fbn['Cliente1']),1,25))
    ACN(cp:1, 0)
    ACN(cp:1, SQL("SELECT 1 FROM "~DBO~".OPERACIONES  WHERE NrOperacion3='"~fbn('NrOperacion3')~"' AND NrOperacion3 is not NULL AND NrOperacion3 <> ''  AND NrOperacion3 <> '00000' AND NrOperacion<>'"~fbn('NrOperacion')~"' "))
    SCN(cp:1, SQL("SELECT 1 FROM "~DBO~".BOPERACIONES WHERE NrOperacion3='"~fbn('NrOperacion3')~"' AND NrOperacion3 is not NULL AND NrOperacion3 <> ''  AND NrOperacion3 <> '00000' AND NrOperacion<>'"~fbn('NrOperacion')~"' "))

    ACT(S:fac, fbn('ContraEspecie'))
    ACT(ES:1, fbn('ContraEspecie'))

    If Incluido(fbn('Tipo'),'Baja|cBaja')
       If EqStr(fbn['ObsErrorMAE'],'C')
          ACT(T:FAC, 'Baja por Carta')
       Else
          ACT(T:FAC, 'Baja')
       Endif
    Endif

    ACT(U:FAC, 'Cartera Propia')

    ACT(v:fac, fbn('CUIT'))

    ACT(w:FAC, Pad0(fstr(fbn('NrOrden'),0,0),8))   

*    ACT(x:FAC, SQL("SELECT FechaOp FROM "~DBO~".LIBORDENES WHERE SecuenciaHo = '"~fbn('NrOrden')~"'  and FechaHo = '"~idxdate(FBN['FechaOp'])~"' "))
*    ACT(y:FAC, SQL("SELECT HoraOp FROM "~DBO~".LIBORDENES WHERE SecuenciaHo = '"~fbn('NrOrden')~"'  and FechaHo = '"~idxdate(FBN['FechaOp'])~"' ")) 

    ACT(x:FAC, SQL("SELECT FechaOrden FROM "~DBO~".ORDENES WHERE NrOperacion = '"~fbn['NrOperacion']~"' ") ) 
    
    ACT(y:FAC, Copy(Hora(SQL("SELECT FechaOrden FROM "~DBO~".ORDENES WHERE NrOperacion = '"~fbn['NrOperacion']~"' ")),1,8))

    
** Si No hay Libro de Ordenes va Fecha y Hora de Operacion

* FJL 05/11/18 - Esto se igualo con BOLEXT
*   IF Vacio(Val(x:FAC))
*      IF NoVacio(fbn('FechaAltaMAE'))
*         ACT(x:FAC, Fecha(Trunc2(fbn('FechaAltaMAE'))))
*         ACT(y:FAC,Copy(FBN['HoraMAE'],1,8))
*      ELSE
*         ACT(x:FAC, FBN['FechaOp'])
*         ACT(y:FAC,Copy(HORA(FBN['FechaCarga']),1,8))
*      ENDIF
*   ELSE
*       ACT(x:FAC,Fecha(Trunc2(Val(x:fac))))
*   ENDIF
* FJL 05/12/18 - Nuevo criterio
   IF Vacio(Val(x:FAC))
     IF NoVacio(fbn('FechaAltaMAE'))
       ACT(x:FAC, Fecha(Trunc2(fbn('FechaAltaMAE'))))
       IF fbn('CB5') = 1
         ACT(y:FAC, Hora(fbn['FechaAltaMAE']))
       ELSE
* FJL 05/12/18 - Esto de restar un valor fijo se acordo con Alcira y Gustavo en BofA
         IF fbn['FechaEnvioMAE']<fbn['FechaAltaMAE']
           ACT(y:FAC, Hora(fbn['FechaEnvioMAE']))
         ELSE
           IF fbn['FechaEnvioMAE']-0.001<fbn['FechaAltaMAE']
             ACT(y:FAC, Hora(fbn['FechaEnvioMAE']-0.001))
           ELSE
             ACT(y:FAC, Hora(fbn['FechaAltaMAE']-0.001))
           ENDIF
         ENDIF
       ENDIF
     ELSE
       ACT(x:FAC, FBN['FechaOp'])
       ACT(y:FAC, HORA(FBN['FechaCarga']-0.001))
     ENDIF
   ELSE
     ACT(x:FAC,Copy(Val(x:fac),1,10))       
   ENDIF


