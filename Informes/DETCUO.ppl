CrearDialogo
  NrOperacion: "Partida"      ;2;1;;;;NoVacio(Dialogo.NrOperacion);'Debe ingresar una Partida';NO;;;;;;" TipoOp IN ('PARTID') ";
  Fecha1     : "Fecha"        ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Lista1     : "Especies"         ;;;;;;;;;;;SQLSET("Select Codigo from "~DBO~".ESPECIES WHERE "~DBO~".DesciendeDeEspecie(Codigo,'TITULO') = 1");;;;;
  Especie1   : "Moneda Expresion" ;;;;;;;;;
  Especie2   : "Moneda Emision"   ;;;;;;;;;
FinDialogo 


if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,15,B")

SetFilaActual(1)
ACT(a:fac, 'Devengamientos de la partida '~Dialogo.NrOperacion)
SetFont(a:fac,3)
IFA
if NoVacio(Dialogo.Lista1)
  ACT(a:FAC, 'Especies : '~Dialogo.Lista1)
else
  ACT(a:FAC, 'Especies : Todos')
endif
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
ACT(a:FAC, 'Moneda Expresion : '~Dialogo.Especie2)
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
ACT(a:FAC, 'Moneda Emision : '~Dialogo.Especie1)
FormatoCeldas(b:fac,Exe('F9'))
SetFont(a:FAC..b:FAC,2)
IFA
***---Tipo de Cambio
ACT(EX:1,Dialogo.Especie2)
ACT(EM:1,Dialogo.Especie1)

If EqStr(VAL(EM:1),VAL(EX:1))
    ACN(TC:1,1)
Else
    ACN(TC:1,CotizacionC(val(EM:1),,,,Dialogo.Fecha1,25,SI,VAL(EX:1)))
EndIf
ACT(a:FAC, 'Tipo Cambio : '~val(TC:1))
FormatoCeldas(b:fac,Exe('F2'))
SetFont(a:FAC..b:FAC,2)
IFA
ACT(a:FAC, Dialogo.NrOperacion)
ACLO(a:fac, Dialogo.NrOperacion)
IFA
IFA
ACT(a:FAC, "F.Ini")
ACT(b:FAC, "Dias")
ACT(c:FAC, "F.Hasta")
ACT(d:FAC, "TIR")
ACT(e:FAC, "Precio Ini")
ACT(f:FAC, "Precio Dev")
ACT(g:FAC, "Precio Fin")
ACT(h:FAC, "Cant Disp")
ACT(i:FAC, "Dev Diario")
ACT(j:FAC, "Dev Acumulado")

SetFont(a:FAC..j:FAC,2)
AgregarMarco(a:FAC..j:FAC,2,0,Exe('COLOR'))

SQL.ADD("SELECT * FROM "~DBO~".CUOTAS WHERE NrOperacion = '"~Dialogo.NrOperacion~"' AND Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' Order By NrCuota")
watch(SQL.batch)

ACN(aa:1,0)
Recorrer SQL
    ACD(a:fac,fbn('Fecha1'))
    ACN(b:fac,fbn('Cantidad2'))
    ACD(c:fac,fbn('Fecha2'))
    ACN(d:fac,fbn('Precio4'))
    FormatoCeldas(d:fac,Exe('F9'))
    AlinearCeldas(d:fac,'D')
    **Cintia 240223 - Administracion de Partidas -  Issue 6089
    *ACT(e:fac,fbn('Precio1'))
    ACT(e:fac,fbn('Precio1')*val(TC:1))
    **
    FormatoCeldas(e:fac,Exe('F9'))
    AlinearCeldas(e:fac,'D')
    ACT(f:fac,fbn('Precio3')*val(TC:1))
    FormatoCeldas(f:fac,Exe('F2'))
    AlinearCeldas(f:fac,'D')
    **Cintia 240223 - Administracion de Partidas -  Issue 6089
    *ACT(g:fac,fbn('Precio2'))
    ACT(g:fac,fbn('Precio2')*val(TC:1))
    **
    
    FormatoCeldas(g:fac,Exe('F9'))
    AlinearCeldas(g:fac,'D')
    ACT(h:fac,fbn('Cantidad4'))
    FormatoCeldas(h:fac,Exe('F3'))
    AlinearCeldas(h:fac,'D')
    ACT(i:fac,fbn('Cantidad1')*val(TC:1))
    FormatoCeldas(i:fac,Exe('F2'))
    AlinearCeldas(i:fac,'D')
    ACT(j:fac,fbn('Cantidad3')*val(TC:1))
    FormatoCeldas(j:fac,Exe('F2'))
    AlinearCeldas(j:fac,'D')
Proximo

ACO(1,9)
ACO(2,5)
ACO(3,9)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,8)
ACO(9,9)
ACO(10,9)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL INFORME')
SetFont(a:FAC,2)
LimitesVision(j:FAC)
RangoTitulo(a:1..j:FAC)
