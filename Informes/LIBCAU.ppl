HOJAVISIBLE(NO)
CrearDialogo
  Fecha1     :'Fecha Desde';;;;;;Dialogo.Fecha1<=FSys;'Debe ingresar una fecha';NO;FSys
  Fecha2     :'Fecha Hasta';;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe ingresar una fecha';NO;FSys
  Radio1     :'|Provisorio|Definitivo' ;;;;;NO;;;;;1
  Vehiculo1  : 'Vehiculo'  ;;;;NO;NO;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
FinDialogo

IF NOT OK 
  Cancelar
Endif

Recorrer&k Dialogo.Fecha1, Dialogo.Fecha2

  if EsHabil(&k, 'ARG')
  LinkearHoja('LIBCAX',1,Fecha1 = &k, Radio1 =Dialogo.Radio1, Vehiculo1=Dialogo.Vehiculo1)
  endif
Proximo