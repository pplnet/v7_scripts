ModoReproceso(ConDialogo)
CrearDialogo
    String1     : 'Texto'        ;1;1;;;;NoVacio(Dialogo.String1);'Debe completar el valor';NO;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX';
    Check9      : 'Todos'        ; ; ;;;;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check5+Dialogo.Check6+Dialogo.Check7+Dialogo.Check8+Dialogo.Check9>0;'Debe seleccionar un tipo de script';NO;1;IIF(Dialogo.Check1=1 O Dialogo.Check2=1 O Dialogo.Check3=1 O Dialogo.Check4=1 O Dialogo.Check5=1 O Dialogo.Check6=1 O Dialogo.Check7=1 O Dialogo.Check8=1,0,1)
    Check1      : 'ABMs'         ;4;1;;;;;;;0
    Check2      : 'Informes'     ; ; ;;;;;;;0
    Check3      : 'Eventos'      ; ; ;;;;;;;0
    Check4      : 'Funciones'    ; ; ;;;;;;;0
    Check5      : 'Formulas'     ; ; ;;;;;;;0
    Check6      : 'Operaciones'  ; ; ;;;;;;;0
    Check7      : 'Transacciones'; ; ;;;;;;;0
    Check8      : 'Ordenes'      ; ; ;;;;;;;0
FinDialogo

if Not Ok
   Cancelar
endif   

SetFilaActual(fac+4) 

 ***encabezado  
ACT(a:fac-2 , 'Texto a buscar : '~Dialogo.String1~'' )
ACT(a:fac, 'TIPO SCRIPT')   
ACT(b:fac, 'CODIGO')
ACT(c:fac, 'TIPO')    
ACT(d:fac, 'NOMBRE')    
CrearFont(1,"Arial,8,B")
 

SQL.ADD("Select ' ' as TipoScript, a.Codigo, a.Tipo, a.Nombre")
SQL.ADD("from "~DBO~".ABMS a")
SQL.ADD("Where Script is null")
    

IF Dialogo.Check1=1 o Dialogo.Check9=1
    SQL.ADD("UNION")
    SQL.ADD("Select 'ABMS' as TipoScript, a.Codigo,  a.Tipo, a.Nombre")
    SQL.ADD("from "~DBO~".ABMS a")
    SQL.ADD("Where a.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF

IF  Dialogo.Check2=1 o Dialogo.Check9=1
    SQL.ADD("UNION") 
    SQL.ADD("Select 'INFORMES' as TipoScript, i.Codigo, i.Tipo, i.Nombre")
    SQL.ADD("from "~DBO~".INFORMES i")
    SQL.ADD("Where i.Script like '%'+'"~Dialogo.String1~"'+'%'")
endif
IF  Dialogo.Check3=1 o Dialogo.Check9=1
    SQL.ADD("UNION") 
    SQL.ADD("Select 'EVENTOS' as TipoScript, e.Codigo, e.Tipo, e.Nombre")
    SQL.ADD("from "~DBO~".EVENTOS e")
    SQL.ADD("Where e.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF
IF  Dialogo.Check4=1 o Dialogo.Check9=1
    SQL.ADD("UNION")
    SQL.ADD("Select 'FUNCIONES' as TipoScript, fu.Codigo, '' as Tipo, fu.Descripcion as Nombre")
    SQL.ADD("from "~DBO~".FUNCIONES fu")
    SQL.ADD("Where fu.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF
IF  Dialogo.Check5=1 o Dialogo.Check9=1
    SQL.ADD("UNION")
    SQL.ADD("Select 'FORMULAS' as TipoScript, fo.Codigo, '' as Tipo, fo.Descripcion as Nombre ")
    SQL.ADD("from "~DBO~".FORMULAS fo")
    SQL.ADD("Where fo.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF
IF  Dialogo.Check6=1 o Dialogo.Check9=1
    SQL.ADD("UNION")
    SQL.ADD("Select 'TIPOSOPERACION' as TipoScript, op.Codigo, '' as Tipo, op.Nombre")
    SQL.ADD("from "~DBO~".TIPOSOPERACION op")
    SQL.ADD("Where op.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF
IF  Dialogo.Check7=1 o Dialogo.Check9=1
    SQL.ADD("UNION")
    SQL.ADD("Select 'TIPOSTRANSACCION2' as TipoScript, tr.Codigo,'' as Tipo,  tr.Nombre")
    SQL.ADD("from "~DBO~".TIPOSTRANSACCION2 tr")
    SQL.ADD("Where tr.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF
IF  Dialogo.Check8=1 o Dialogo.Check9=1
    SQL.ADD("UNION")
    SQL.ADD("Select 'TIPOSORDEN' as TipoScript, ord.Codigo, '' as Tipo, ord.Nombre")
    SQL.ADD("from "~DBO~".TIPOSORDEN ord")
    SQL.ADD("Where ord.Script like '%'+'"~Dialogo.String1~"'+'%'")
ENDIF
watch(SQL.BATCH())
Recorrer SQL
    ACT(a:FAC, fbn('TipoScript'))  
    ACT(b:FAC, fbn('Codigo')) 
    ACT(c:FAC, fbn('Tipo')) 
    ACT(d:FAC, fbn('Nombre'))   
proximo 
