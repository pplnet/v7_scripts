ACO( 7, 10)
ACO( 8, 12)
ACO( 9, 10)
ACO(10, 10)
ACO(11, 10)
ACO(12, 12)
ACO(13, 12)
ACO(14, 12)
ACO(15, 1)

Impresion(1,2)
Impresion(2,1)
Impresion(3,1)
Impresion(4,1)

LimitesVision(o:fac)
SetPrintFit(3, 63)
