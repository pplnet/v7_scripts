*PRELIQUIDACION AC
ModoReproceso(SinDialogo)

CrearDialogo
 Fecha1:    'Fecha Liq:';1;;;;;NoVacio(Dialogo.Fecha1);'Ingrese una fecha';NO;FSys;
 Vehiculo1: 'Vehiculo:' ;2;;;;;NOVACIO(Dialogo.Vehiculo1);;;VAR('VEHICULODE')
 Lista1:'Tipos Op.' ;3;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo in ('TIC','TIV','TIFC','TIFV','TCOPRI','EQC','EQV') ")
 Mercado1 : 'Mercado'     ;6;1;;  ;;NoVacio(Dialogo.Mercado1) ;'Debe ingresar un Mercado';NO;VAR('MERNETEODE');;;;;" NETEA='SI' "
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,10,B")

SetFilaActual(1)

**-- Encabezado --**
ACT(a:FAC, 'Neteo - Preliquidación de Operaciones '~Dialogo.Mercado1)
SetFont(a:1..a:FAC, 3)

ACT(a:FAC+2, 'Fecha Liq.: '~Dialogo.Fecha1)

If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+3, 'Tipo Op: '~Pipe2Comillas(Dialogo.Lista1))
Else
   ACT(a:FAC+3, 'Tipo Op: Todas')
Endif

ACN(fa1, FAC+4)

SetFont(a:FAC+2..b:FAC+4, 2) 
SetFilaActual(6)

ACT(a:FAC, 'Nro.Oper.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'Boleto')
ACT(d:FAC, 'Cliente')
ACT(e:FAC, 'Fecha Op.')
ACT(f:FAC, 'Fecha Vto.')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Cant.Total')
ACT(i:FAC, 'Cont.Esp.')
ACT(j:FAC, 'Precio')
ACT(k:FAC, 'Monto Total')
ACT(l:FAC, 'Int. Corr.')
ACT(m:FAC, 'Neto Total')
ACT(n:FAC, 'Pendiente')

SetFont(a:FAc..t:FAC, 2)
AgregarMarco(a:FAC..t:FAC, 2,0,Exe('COLOR6'))
AlinearCeldas(a:FAC..d:FAC, 'I')
AlinearCeldas(h:FAC..h:FAC, 'D')
AlinearCeldas(e:FAC..g:FAC, 'C')
AlinearCeldas(i:FAC..i:FAC, 'C')
AlinearCeldas(j:FAC..n:FAC, 'D')

SetFilaActual(FAC)

SQL.ADD("select E.Jerarquia, M.Especie, Sum(M.Cantidad) as Cant,E.CodMAEContado ")
SQL.ADD(" from  "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O ")
SQL.ADD(" where M.NrOperacion = B.NrOperacion ")
SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
SQL.ADD("  and  M.FechaMov   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Mercado1)
SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("  and  M.Especie     = E.Codigo ")
SQL.ADD("  and  B.NrBit       = 10 ")
SQL.ADD("  and  B.Valor       = '1' ")
if NoVacio(Dialogo.Lista1)
   SQL.ADD("  and  O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
else
   SQL.ADD("  and  O.TipoOp IN ('TIC', 'TIV', 'TIFC', 'TIFV','TCOPRI','EQC','EQV') ")
endif
SQL.ADD(" group by E.Jerarquia, M.Especie,E.CodMAEContado  ")
SQL.ADD(" order by E.Jerarquia, M.Especie                  ")
ACN(fl1, fac+1)

Recorrer SQL
    ACT(ce1, FBN['Especie'])
    ACN(cn:1, FBN['Cant'])

    **-- Rotulo de Total por Especie
    If Val(cn:1)>0
       ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~') :')
       ACN(c:FAC, ABS(Val(cn:1)))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..o:FAC,2)
    Else
       ACT(a:FAC,'Neto '~FBN['Especie']~' (MAE: '~FBN['CodMAEContado']~') :')
       ACN(c:FAC, ABS(Val(cn:1)))
       AgregarMarco(a:FAC..t:FAC,2,0,EXE('COLOR1'))
       SetFont(a:FAC..o:FAC,2)
    Endif

    ACN(fi1, FAC)

    SQL.ADD("Select O.TipoOp, O.NrOperacion, O.NrBoleto, O.Cliente1, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.ContraEspecie, O.Precio1, O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.Cuenta1, U.Nombre NomCta, R.Descripcion, C.RazonSocial, E.Jerarquia,E1.InteresesC,C.NrMAE, ")
    SQL.ADD(" M.Cantidad as CantMov, M.Especie as EspeMov, M.NrMov, M.Mercado, O.PaseCB, O.TotalCaucion ")
    SQL.ADD(" from  "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUENTAS U ON O.Cuenta1 = U.Codigo , "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo and E1.Codigo=O.Especie ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
    SQL.ADD("  and  M.Mercado     = R.Codigo  ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo  ")
    SQL.ADD("  and  M.FechaMov   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"' ")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"' ")
    SQL.ADD("  and  B.NrBit       = 10  ")
    SQL.ADD("  and  B.Valor       = '1' ")
    if NoVacio(Dialogo.Lista1)
       SQL.ADD("  and  O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    else
       SQL.ADD("  and  O.TipoOp IN ('TIC', 'TIV', 'TIFC', 'TIFV','TCOPRI','EQC','EQV') ")
    endif
    SQL.ADD("  and  (O.TipoOp<>'TCOPRI' OR O.Cliente1<>'"~Dialogo.Vehiculo1~"') ")
    SQL.ADD(" UNION ")
    SQL.ADD("Select O.TipoOp, O.NrOperacion, O.NrBoleto, O.Cliente1, O.FechaOp, O.FechaVto, O.Especie, O.Cantidad, O.ContraEspecie, O.Precio1, O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, O.Cuenta1, U.Nombre NomCta, R.Descripcion, C.RazonSocial, E.Jerarquia,E1.InteresesC,C.NrMAE, ")
    SQL.ADD("- M.Cantidad as CantMov, M.Especie as EspeMov, M.NrMov, M.Mercado, O.PaseCB, O.TotalCaucion ")
    SQL.ADD(" from  "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CUENTAS U ON O.Cuenta1 = U.Codigo , "~DBO~".MERCADOS R, "~DBO~".CLIENTES C ")
    SQL.ADD(" where M.Especie     = E.Codigo and E1.Codigo=O.Especie ")
    SQL.ADD("  and  M.NrOperacion = B.NrOperacion ")
    SQL.ADD("  and  M.NrOperacion = O.NrOperacion ")
    SQL.ADD("  and  M.Mercado     = R.Codigo  ")
    SQL.ADD("  and  O.Cliente1    = C.Codigo  ")
    SQL.ADD("  and  M.FechaMov   <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("  and  M.Mercado     = '"~Dialogo.Mercado1~"' ")
    SQL.ADD("  and  M.Especie     = '"~Val(ce1)~"' ")
    SQL.ADD("  and  B.NrBit       = 10  ")
    SQL.ADD("  and  B.Valor       = '1' ")
    SQL.ADD("  and  O.TipoOp='TCOPRI' AND O.Cliente1='"~Dialogo.Vehiculo1~"' ")
    SQL.ADD(" Order By E.Jerarquia, M.Mercado, O.Especie, O.NrOperacion      ")
    Recorrer SQL
        ACT(a:Val(fa1), 'Cuenta: '~FBN['Cuenta1']~' - '~FBN['NomCta'])
        SetFont(a:Val(fa1)..b:Val(fa1), 2)

        If Not EqStr(val(ck1),FBN['NrOperacion'])
           ACT(ck1, FBN['NrOperacion'])           
        EndIf
        
        **-- Linea de Detalle  
        ACT(a:FAC, FBN['NrOperacion'])
        ACLO(a:FAC, FBN['NrOperacion'])
        ACT(b:FAC, FBN['TipoOp'])
        ACT(c:FAC, FBN['NrBoleto'])
        ACT(d:FAC, FBN['Cliente1']~' - '~Copy(FBN['RazonSocial'],1,30)~' Nro.MAE '~FBN['NrMAE'])
        ACD(e:FAC, FBN['FechaOp'])
        ACD(f:FAC, FBN['FechaVto'])
        ACT(g:FAC, FBN['Especie'])
        ACN(h:FAC, FBN['Cantidad'])
        ACT(i:FAC, FBN['ContraEspecie'])
        ACN(j:FAC, FBN['Precio1'])

        If FBN['NrMov']<>1000
           ACN(k:FAC, FBN['TotalBrutoCli1'])

           IF EqStr(FBN['InteresesC'],'CLE')
              ACN(l:FAC, FBN['TotalIntereses'])
           EndIf

           IF fbn('PaseCB') = 1
               ACN(m:FAC, FBN['TotalCaucion'])
           ELSE
               ACN(m:FAC, FBN['TotalNetoCli1'])
           ENDIF
        Else 
            ACN(m:FAC, FBN['CantMov'])
        EndIf
        ACN(n:FAC, -FBN['CantMov'])

        If DesciendedeEspecie(Val(ce1), 'MONEDA')
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)]
                * SCN(tc1, val(m:fac))
                SCN(tc1, val(n:fac))
                acn(m:fac, val(m:fac)*-1 )
                acn(k:fac, val(k:fac)*-1 )
           Else
                * SCN(tp1, val(m:fac))
                SCN(tp1, val(n:fac))
                acn(h:fac, val(h:fac)*-1 )
           Endif
        Else
           If Incluido(FBN['TipoOp'], 'TIC|TIFC') o [Incluido(FBN['TipoOp'], 'TCOPRI') y EQSTR(fbn('Cliente1'),Dialogo.Vehiculo1)]
                *SCN(tc2, val(h:fac))
                SCN(tc2, val(n:fac))
                acn(m:fac, val(m:fac)*-1 )
                acn(k:fac, val(k:fac)*-1 )
           Else
                * SCN(tp2, val(h:fac))
                SCN(tp2, val(n:fac))
                acn(h:fac, val(h:fac)*-1 )
           Endif
        Endif

        * SetFont(a:FAC..s:FAC, 1)
        SetFont(a:FAC..m:FAC, 1)
        SetFont(n:FAC..n:FAC, 2)
        AlinearCeldas(e:FAC..g:FAC, 'C')
        AlinearCeldas(i:FAC..i:FAC, 'C')                
     Proximo

     IFA
     *--Impresion de totales por Especie
     If DesciendedeEspecie(Val(ce1), 'MONEDA')
        ACT(e:Val(fi1),'Total a Pagar '~Val(ce1)~': ')
        * ACN(h:Val(fi1), -Val(tc1))
        ACN(h:Val(fi1), Val(tc1))
        ACT(j:Val(fi1),'Total a Cobrar '~Val(ce1)~': ')
        ACN(l:Val(fi1), Val(tp1))
        IF Val(tc1) > Val(tp1)
           ACN(c:Val(fi1), Val(c:Val(fi1))*-1)
        ENDIF
     Else
        ACT(e:Val(fi1),'Total a Entregar '~Val(ce1)~': ')
        *        ACN(h:Val(fi1), -Val(tp2))
        ACN(h:Val(fi1), Val(tp2))
        ACT(j:Val(fi1),'Total a Recibir '~Val(ce1)~': ')
        ACN(l:Val(fi1), Val(tc2))
        IF Val(tp2) > Val(tc2)
           ACN(c:Val(fi1), Val(c:Val(fi1))*-1)
        ENDIF
     Endif

     SetFont(a:Val(fi1)..o:Val(fi1),2)
     ACN(tc1, 0)
     ACN(tp1, 0)
     ACN(tc2, 0)
     ACN(tp2, 0)

Proximo
FormatoCeldas(c:Val(fl1)..c:fac,Exe('F2'))
FormatoCeldas(h:Val(fl1)..h:fac,Exe('F2'))
FormatoCeldas(j:Val(fl1)..j:fac,Exe('F6'))
FormatoCeldas(k:Val(fl1)..k:fac,Exe('F2'))
FormatoCeldas(m:Val(fl1)..n:fac,Exe('F2'))


IFA

*-- Ajuste de celdas
ACO(1,7)
ACO(2,5)
ACO(3,9)
ACO(4,30)
ACO(5,6)
ACO(6,6)
ACO(7,5)
ACO(8,10)
ACO(9,5)
ACO(10,7)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)


Impresion(1,2)
SetPrintFit(3,80)
SetFilaActual(FAC+3)
ACT(a:fac, 'Fin del Informe.')
LimitesVision(n:fac)
RangoTitulo(a:1..n:FAC, 6)
