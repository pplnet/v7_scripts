CrearDialogo
 Fecha1   :'R.Date Desde';1;1;;;;;;;FSys
 Fecha2   :'R.Date Hasta';2;1;;;;;;;FSys
 Fecha3   :'F.Pago Desde';1;2;;;;;;;FSys
 Fecha4   :'F.Pago Hasta';2;2;;;;;;;FSys
 Especie1 :'Especie'     ;4;1;;;;;;;
 Cliente1 :'Cliente'     ;5;1;;;;;;;
 Mercado1 :'Mercado'     ;4;2;;;;;;;
 Vehiculo1:'Vehiculo'    ;5;2;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;VAR('VEHICULODE')
FinDialogo

if Not Ok
 Cancelar
endif

CrearFont(1,"Arial,10,B")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,U")
CrearFont(4,"Arial,8,")

** FJL 10/08/22 - No mostrar transacciones saldos Parking
ACT(w:1, VAR('SALPARK'))

ACO( 1, 2)
ACO( 2,13)
ACO( 3, 6)
ACO( 4, 6)
ACO( 5, 6)
ACO( 6, 6)
ACO( 7,13)
ACO( 8, 8)
ACO( 9, 7)
ACO(10, 8)
ACO(11,13)
ACO(12, 8)
ACO(13, 8)
ACO(14, 8)

SetFilaActual(1)
ACT(a:fac,'Transacciones Pago de Dividendos')
Setfont(a:fac,1)

SetFilaActual(fac+2)
if NoVacio(Dialogo.Fecha1)
 ACT(a:fac,'R.Date Desde:')
 ACT(c:fac,Dialogo.Fecha1)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
if NoVacio(Dialogo.Fecha2)
 ACT(a:fac,'R.Date Hasta:')
 ACT(c:fac,Dialogo.Fecha2)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
if NoVacio(Dialogo.Fecha3)
 ACT(a:fac,'F.Pago Desde:')
 ACT(c:fac,Dialogo.Fecha3)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
if NoVacio(Dialogo.Fecha4)
 ACT(a:fac,'F.Pago Hasta:')
 ACT(c:fac,Dialogo.Fecha4)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
if NoVacio(Dialogo.Especie1)
 ACT(a:fac,'Especie:')
 ACT(c:fac,Dialogo.Especie1)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
if NoVacio(Dialogo.Cliente1)
 ACT(a:fac,'Cliente:')
 ACT(c:fac,Dialogo.Cliente1)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
if NoVacio(Dialogo.Mercado1)
 ACT(a:fac,'Mercado:')
 ACT(c:fac,Dialogo.Mercado1)
 SetFont(a:fac,4)
 SetFont(c:fac,2)
 ifa
endif
ACT(a:fac,'Vehiculo:')
ACT(c:fac,Dialogo.Vehiculo1)
SetFont(a:fac,4)
SetFont(c:fac,2)

SetFilaActual(fac+2)
ACT(a:fac  ,'Mercado')
ACT(b:fac+1,'Cliente')
ACT(c:fac  ,'NrTrans')
ACT(d:fac  ,'Forma')
ACT(d:fac+1,'de Pago')
ACT(e:fac  ,'Record')
ACT(e:fac+1,'Date')
ACT(f:fac  ,'Fecha')
ACT(f:fac+1,'Pago')
ACT(g:fac  ,'Titulo')
ACT(h:fac  ,'Saldo')
ACT(i:fac  ,'%')
ACT(j:fac  ,'Total')
ACT(k:fac  ,'Moneda')
ACT(l:fac  ,'Precio')
ACT(l:fac+1,'Fraccion')
ACT(m:fac  ,'Total')
ACT(m:fac+1,'Fraccion')
ACT(n:fac  ,'Status')
SetFont(a:fac..n:fac+1,2)
AlinearCeldas(c:fac..n:fac+1,'C')
AgregarMarco(a:fac..n:fac+1,0,0,Exe('COLOR6'))

ifa
ACT(z:1,'')
ACT(z:2,'')
ACN(z:3,0)
ACN(z:4,0)

SQL.ADD("select DISTINCT  T.Mercado1, M.Descripcion NomMer, T.Cliente1, C.RazonSocial, T.NrTrans, T.RB10, T.Fecha1, T.Fecha2, T.Especie, E1.Nombre NomEsp, T.Especie2, E2.Nombre NomEsp2, T.Cantidad1, T.Precio1, T.Cantidad2, T.Precio2, T.Cantidad3, T.Cuenta1, T.Cuenta2, T.Cliente2, T.Cuenta3, T.Cuenta4 ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".MERCADOS M, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E1, "~DBO~".ESPECIES E2, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where T.TipoTr2    = 'PDIVID' ")
SQL.ADD(" AND B.NrOperacion = T.NrTrans ")
SQL.ADD(" AND B.NrBit <> 40 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD("  and  T.Mercado1 = M.Codigo ")
SQL.ADD("  and  T.Cliente1 = C.Codigo ")
SQL.ADD("  and  T.Especie  = E1.Codigo ")
SQL.ADD("  and  T.Especie2 = E2.Codigo ")
if NoVacio(Dialogo.Fecha3)
 SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Dialogo.Fecha3) )
endif
if NoVacio(Dialogo.Fecha4)
 SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha4) )
endif
if NoVacio(Dialogo.Fecha1)
 SQL.ADD("  and  T.Fecha2    >= "~IdxDate2(Dialogo.Fecha1) )
endif
if NoVacio(Dialogo.Fecha2)
 SQL.ADD("  and  T.Fecha2    <= "~IdxDate2(Dialogo.Fecha2) )
endif
if NoVacio(Dialogo.Especie1)
 SQL.ADD("  and  T.Especie    = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.CLiente1)
 SQL.ADD("  and  T.Cliente1   = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
 SQL.ADD("  and  T.Mercado1   = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("  and  Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
** FJL 10/08/22 - No mostrar transacciones saldos Parking
SQL.ADD("  and  Cambio5 not in ("~Pipe2Comillas(Val(w:1))~") ")
SQL.ADD(" order by T.Mercado1, T.Cliente1, T.NrTrans ")
watch(sql.batch)
recorrer SQL
 if not EqStr(fbn('Mercado1'),Val(z:1)) 
  ACT(z:1,fbn('Mercado1'))
  ACT(a:fac, fbn('NomMer'))
  SetFont(a:fac,3)
  ifa
 endif
 if not EqStr(fbn('Cliente1'),Val(z:2)) 
  ACT(z:2,fbn('Cliente1'))
  ACT(b:fac, fbn('RazonSocial'))
 endif
 ACT(c:fac, fbn('NrTrans'))
 ACLT(c:fac, fbn('NrTrans'))
 ACT(e:fac, fbn('Fecha2'))
 ACT(f:fac, fbn('Fecha1'))
 AlinearCeldas(e:fac..f:fac,'C')
 ACT(g:fac, fbn('NomEsp'))
 ACN(h:fac, fbn('Cantidad1'))
 FormatoCeldas(h:fac,Exe('F0'))
 ACN(i:fac, fbn('Precio1'))
 ACN(j:fac, fbn('Cantidad2'))
 ACT(k:fac, fbn('NomEsp2'))
 if EqStr(fbn('RB10'),'0')
  ACT(d:fac,'Efectivo')
 else
  ACT(d:fac,'Acciones')
  ACN(l:fac, fbn('Precio2'))
  FormatoCeldas(l:fac,Exe('F7'))
  ACN(m:fac, fbn('Cantidad3'))
  FormatoCeldas(m:fac,Exe('F2'))
 endif
 FormatoCeldas(i:fac,Exe('FP4'))
 FormatoCeldas(j:fac,Exe('F0'))
 if Num(SQL("select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~fbn('NrTrans')~"' ")) = 0
  ACT(n:fac,'Pendiente')
 else
  ACT(n:fac,'Confirmado')
 endif
 SetFont(b:fac..n:fac,4)
 if NoVacio(Dialogo.Especie1)
  ACT(aa:3,fbn('NomEsp'))
  SCN(z:3,fbn('Cantidad2'))
  ACT(aa:4,fbn('NomEsp2'))
  SCN(z:4,fbn('Cantidad3'))
 endif
proximo

if NoVacio(Dialogo.Especie1)
 ifa
 ACT(g:fac,Val(aa:3))
 ACN(j:fac,Val(z:3))
 FormatoCeldas(j:fac,Exe('F0'))
 ACT(k:fac,Val(aa:4))
 ACN(m:fac,Val(z:4))
 FormatoCeldas(m:fac,Exe('F2'))
 SetFont(b:fac..n:fac,2)
 AgregarMarco(g:fac..m:fac,0,0,Exe('COLOR6'))
endif

Impresion(1,2)
Impresion(2,1)
Impresion(3,0)
SetPrintFit(3,80)
SetMargins(1,2,1,1)

LimitesVision(n:fac+2)
EstadoVentana(1)
