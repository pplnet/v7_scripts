      ACT(a:FAC+1, 'Fecha Orden/Order Date')
   #else
      ACT(a:FAC+1, 'Fecha Orden')
   #endif
   SetFont(a:FAC, 2)
     
   AgregarMarco(a:FAC+2,2,0)

   
   *ACT(a:FAC+2, SQL("SELECT FechaOrden FROM "~DBO~".ORDENES WHERE NrOperacion = '"~fbn['NrOperacion']~"' ")  )
   *ACT(a:FAC+2, Fecha(Trunc2(SQL("SELECT FechaOrden FROM "~DBO~".ORDENES WHERE NrOperacion = '"~fbn('NrOperacion')~"' "))))
   ACT(a:FAC+2, SQL("SELECT top 1 FechaOp FROM "~DBO~".LIBORDENES WHERE NrOperacionRef='"~Dialogo.NrOperacion1~"' "))


   ACD(ZB:09, FSys)
   *-i
   IF NoVacio(FBN['CodMAEContado']) y novacio(fbn('FechaAltaMAE'))
      ACT(xy5, Fecha(Trunc2(fbn('FechaAltaMAE'))))
   ELSE
      ACT(xy5, FBN['FechaOp'])
   ENDIF
   IF Vacio(val(a:fac+2)) o Eqstr(val(a:fac+2),'00/00/0000')
      ACT(a:fac+2, val(xy5))
   endif
   *-f
   ifa
   #ifdef MLASA
      ACT(c:FAC, 'Hora Orden / Time Date')
   #else
      ACT(c:FAC, 'Hora Orden')
   #endif
   SetFont(c:FAC, 2)

   *   ACT(C:FAC+1, Copy(Hora(SQL("SELECT FechaOrden FROM "~DBO~".ORDENES WHERE NrOperacion = '"~fbn['NrOperacion']~"' ")),1,8))
   * Para las TMANIF
