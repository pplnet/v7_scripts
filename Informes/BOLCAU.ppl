* FJL 05/11/18 - Para igualar con Copiativo
*   IF NoVacio(FBN['CodMAEContado'])
*     IF Vacio(FBN['NrOrden1'])
*       ACT(xy6,Copy(FBN['HoraMAE'],1,8))
*     else
*       ACT(xy6, Copy(Hora(SQL("SELECT FechaAltaMae FROM "~DBO~".ORDENES WHERE NrOperacion2 = '"~fbn['NrOperacion']~"' ")),1,8))     
*     endif
*   ELSE
*     ACT(xy6,Copy(HORA(FBN['FechaCarga']),1,8))
*   ENDIF
* FJL 05/12/18 - Nuevo criterio
*   IF NoVacio(fbn('FechaAltaMAE'))
*     ACT(xy:6, Copy(FBN['HoraMAE'],1,8))
*   ELSE
*     ACT(xy:6, Copy(HORA(FBN['FechaCarga']),1,8))
*   ENDIF
   IF NoVacio(FBN['CodMAEContado']) y NoVacio(fbn('FechaAltaMAE'))
     IF fbn('CB5') = 1
       ACT(xy:6, Hora(fbn['FechaAltaMAE']))
     ELSE
* FJL 05/12/18 - Esto de restar un valor fijo se acordo con Alcira y Gustavo en BofA
       IF fbn['FechaEnvioMAE']<fbn['FechaAltaMAE']
         ACT(xy:6, Hora(fbn['FechaEnvioMAE']))
       ELSE
         IF fbn['FechaEnvioMAE']-0.001<fbn['FechaAltaMAE']
           ACT(xy:6, Hora(fbn['FechaEnvioMAE']-0.001))
         ELSE
           ACT(xy:6, Hora(fbn['FechaAltaMAE']-0.001))
         ENDIF
       ENDIF
     ENDIF
   ELSE
     ACT(xy:6, HORA(FBN['FechaCarga']-0.001))
   ENDIF

   IF Vacio(val(c:fac+1)) o Eqstr(val(c:fac+1),'00:00:00')
      ACT(c:fac+1, val(xy6))
   ENDIF

   
   ACT(i:FAC, 'N# Minuta')
   ACT(j:FAC,FBN['NrOperacion'])
   ACLO(j:fac,FBN['NrOperacion'])   
   AgregarMarco(j:FAC,2,0)
   AlinearCeldas(i:fac..j:fac,'D')
   SetFont(a:FAC..i:FAC, 2)
   IFA

   IFA
   **********************
   ** Datos Operacion
   **********************
   **-horadate fecha date 
   #ifdef MLASA
      ACT(a:FAC+1, 'Fecha / Date')
   #else
      ACT(a:FAC+1, 'Fecha')
   #endif
   SetFont(a:FAC+1, 2)
   #ifdef MLASA
      ACT(c:FAC+1, 'Hora / Time')
   #else
      ACT(c:FAC+1, 'Hora')
   #endif
   SetFont(c:FAC+1, 2)
   IF NoVacio(FBN['CodMAEContado']) y novacio(fbn('FechaAltaMAE'))
      ACT(A:FAC+2, Fecha(Trunc2(fbn('FechaAltaMAE'))))
   ELSE
      ACT(A:FAC+2, FBN['FechaOp'])
   ENDIF
   SetFont(a:FAC+2, 1)
   AgregarMarco(a:FAC+2,2,0)

* FJL 02/11/18 - Para igualar con Copiativo
*   IF NoVacio(FBN['CodMAEContado'])
*      ACT(c:FAC+2,Copy(FBN['HoraMAE'],1,8))
*   ELSE
*      ACT(c:FAC+2,Copy(HORA(FBN['FechaCarga']),1,8))
*   ENDIF
* FJL 05/12/18 - Nuevo criterio
*   IF fbn('CB8') = 1 o  fbn('CB5') = 1
*     ACT(c:FAC+2, Hora(fbn['FechaAltaMAE']))
*   ELSE
*     ACT(c:FAC+2, Hora(fbn['FechaEnvioMAE']))
*   ENDIF
   *IF NoVacio(FBN['CodMAEContado']) y NoVacio(fbn('FechaAltaMAE'))
   IF NoVacio(fbn('FechaAltaMAE'))
     ACT(c:FAC+2, Hora(fbn['FechaAltaMAE']))
   ELSE
     ACT(c:FAC+2, HORA(FBN['FechaCarga']))
   ENDIF

   SetFont(c:FAC+2, 1)
   AgregarMarco(c:FAC+2,2,0)
   SetFilaActual(FAC+2)
    
   ifa
   If EqStr(FBN['CategDepositante'],'CLI')
      * ---> Impresion Del Codigo Y Nombre De La Sucursal
      ACT(A:FAC+1, 'Sucursal')
      ACT(C:FAC+1, fbn['Sucursal']~'- '~BuscarCampo('Sucursales', 'Nombre', 'Codigo', FBN('Sucursal')) )
      SetFont(A:FAC+1..C:FAC+1, 2)

      * ---> Impresion Del Numero De  Cuenta
      ACT(A:FAC+2, 'Cuenta Nro. ')
      ACT(C:FAC+2, 'Comitente Nro.')
      SetFont(A:FAC+2..C:FAC+2, 2)
      ACT(A:FAC+3, fbn['Cliente1'])

      ACT(C:FAC+3, BuscarCampo('CUENTAS', 'NrDepositante', 'Codigo', FBN('Cuenta1')))
      AgregarMarco(c:FAC+3,2,0)
      AlinearCeldas(a:fac+3..c:fac+3,'D')
   Endif

   ACT(i:FAC-3, 'Nr. Boleto')
   SetFont(i:FAC-3, 2)
   ACT(j:FAC-3, fbn['NrBoleto'])
   AlinearCeldas(i:fac-3..j:fac-3,'D')
   AgregarMarco(j:FAC-3,2,0)

   SetFilaActual(FAC+2)
   IF NoVacio(FBN['CodMAEContado'])
      if EqStr(fbn['MercadoNeg'],var('AMBMAE'))
         ACT(i:FAC-3,'Referencia M.A.E.')
      else
         if EqStr(fbn['MercadoNeg'],var('AMBBYMA'))
            ACT(i:FAC-3,'Referencia BYMA')
         else
            ACT(i:FAC-3,'Referencia')
         endif  
      endif  
      SetFont(i:FAC-3, 2)
      IF NoVacio(FBN['NroAltaMAE'])
**     Por auditoria MAE secuencia en el formato ddmmaa+hhmmss+secuencia.
* FJL 05/12/18 -Invierto formato fecha
         ACT(xy1, Copy(Fstr(Anio(FBN['FechaAltaMAE']),0,0),3,2)~Pad0(Fstr(Mes(FBN['FechaAltaMAE']),0,0),2)~Pad0(Fstr(Dia(FBN['FechaAltaMAE']),0,0),2) )
         ACT(xy2, Copy(Hora(fbn('FechaAltaMAE')),1,2)~Copy(Hora(fbn('FechaAltaMAE')),4,2)~Copy(Hora(fbn('FechaAltaMAE')),7,2))
         ACT(xy3, Copy(PAD0(fbn('NroAltaMAE'),5),1,5))
         ACT(j:fac-3,Val(xy1)~Val(xy2)~Val(xy3))       
      ENDIF
      AlinearCeldas(i:fac-3..j:fac-3,'D')   
      AgregarMarco(j:FAC-3,2,0)
   ENDIF

   If Eqstr(fbn('CB8'),'1') 
      ACT(cl:1, '')
      SQL.ADD(" SELECT O.Cliente1, C.CategDepositante, C.AFJP, C.Alias2, C.NrCuenta ")
      SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
      SQL.ADD(" WHERE O.Cliente1 = C.Codigo ")
      SQL.ADD(" AND   O.NrOperacion3 = '"~fbn('NrOperacion3')~"' ")
      SQL.ADD(" AND   O.TipoOp IN ('CAUC') AND O.CB8='1'      ")
      SQL.ADD(" AND   O.NrOperacion3 <> null AND O.NrOperacion3 <> ''  ")
      SQL.ADD(" AND   O.NrOperacion3 <> '     ' AND O.NrOperacion3 <> '00000' ")
      SQL.ADD(" AND   O.NrOperacion <> '"~fbn('NrOperacion')~"'  ")
      SQL.ADD(" AND   O.FechaOp = "~idxdate2(fbn('FechaOp'))~" ")
      SQL.ADD(" AND   O.Especie = '"~fbn('Especie')~"' ") 
      Recorrer SQL
         dfa
         ACT(cl:1, fbn('Cliente1'))
         act(cl:3, fbn('CategDepositante'))
         act(cl:4, fbn('AFJP'))
         act(cl:6, fbn('Alias2'))
         act(cl:5, fbn('NrCuenta'))
      Proximo
   Endif

   SetFilaActual(FAC+1)
   If Eqstr(fbn('CB8'),'1') 
      IFA
      ACT(j:FAC, 'Contraparte:')

      If NoVacio(Val(cl:1))
         If novacio(fbn('NrMAE')) y Not eqstr(fbn('NrMAE'),'000')
            * SOLO SE INDICA EL TIPO DE CONTRAPARTE EN EL BOLETO DEL AGENTE MAE
            IF Eqstr(Val(cl3),'BAN') 
               act(k:fac,'Banco') 
            Endif
            IF Eqstr(Val(cl3),'ABO') 
               act(k:fac,'Soc.Bolsa ') 
            Endif
            IF Eqstr(Val(cl3),'AME') 
               act(k:fac,'Age.MAE ') 
            Endif
            IF Eqstr(Val(cl3),'FON') Y [Vacio(Val(cl4)) o  Eqstr(Val(cl4),'NO')]
               act(k:fac,'FCI') 
            Endif
            IF Eqstr(Val(cl3),'FON') Y Eqstr(Val(cl4),'SI')
               act(k:fac,'AFJP Fondo') 
            Endif
            IF [Not Eqstr(Val(cl3),'FON') o Vacio(val(cl3))] Y Eqstr(Val(cl4),'SI')
               act(k:fac,'AFJP Encaje') 
            Endif
            IF Eqstr(Val(cl3),'OTR')
               act(k:fac,'Otros') 
            Endif
            IF Eqstr(Val(cl3),'OTR') y Eqstr(Val(cl4),'SI')
               act(k:fac,'AFJP') 
            Endif
            act(k:fac,Val(k:fac) )  
            act(k:fac+1,Val(cl:6) )  
            Else
              act(k:fac,Val(cl:1))
         Endif
      Else
         ACT(k:FAC, 'Cartera Propia')
      Endif
      SetFont(a:FAC..j:FAC+1, 2)
      AlinearCeldas(K:fac..K:fac+1, 'D')
      AgregarMarco(k:FAC..k:fac+1,2,0)
      ifa
      ifa
   Endif
   
    
   * ---> Impresion De La Razon Social
   SetFilaActual(FAC-3)
   #ifdef MLASA
     ACT(A:FAC, 'Apellido y Nombre/s o Razon Social / Customer ')
   #else
      ACT(A:FAC, 'Apellido y Nombre/s o Razon Social ')
   #endif
   If EqStr(FBN['CategDepositante'],'CLI')
    ACT(j:FAC, 'Documento   (Tipo y Numero)')
   Endif
   SetFont(A:FAC..j:FAC, 2)
   
   IFA
   ACT(ZB:01, FBN('RazonSocial'))
   ACT(ZB:20, FBN('RazonSocial'))
   (.'ELIBLANCOS'.)
   ACT(A:FAC, Val(ZB:03))
   If EqStr(FBN['CategDepositante'],'CLI')
      ACT(i:FAC, BuscarCampo('INTEGRANTESCLI', 'TipoDocumento', 'Codigo', FBN['Cliente1'] ))
      ACT(j:FAC, Val(i:fac))
      If EqStr(Val(i:FAC),'CUI')
          ACT(j:FAC, 'CUIT')
      Endif
      If EqStr(Val(i:FAC),'CIL')
         ACT(j:FAC, 'CUIL')
      Endif

      ACT(j:FAC, Val(j:fac)~'   '~BuscarCampo('INTEGRANTESCLI', 'NrDocumento', 'Codigo', FBN['Cliente1'] ))
      ACT(i:FAC, '')
      SetFont(A:FAC..J:FAC, 1)
      AgregarMarco(j:fac..j:fac,2,0)
   Endif
   AgregarMarco(a:fac..i:fac,2,0)
      
   
   * ---> Impresion Del Numero De CUIT/CUIL
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
         EndIf      
      EndIf
   Else
      ACT(ZB:10, '')
   EndIf
   ACT(ZB:11, FBN('TipoInscripcion'))
   (.'ARMACUIT'.)
   IFA
   ACT(A:FAC, Val(ZB:14))
   * ---> Impresion De La Direccion  - IVA

    If EqStr(fbn('CondicionIVA'),'INS') 
       ACT(xy1,'Inscripto')
    Else
       If EqStr(fbn('CondicionIVA'),'EXE')
          ACT(xy1,'Exento')
       Else
          If EqStr(fbn('CondicionIVA'),'FIN')
             ACT(xy1,'Consumidor Final')
          Else
             If EqStr(fbn('CondicionIVA'),'NRE')
                ACT(xy1,'No Responsable')
             Else
                 If EqStr(fbn('CondicionIVA'),'NOI')
                    ACT(xy1,'No Inscripto')
                 Else
                    If EqStr(fbn('CondicionIVA'),'MON')
                       ACT(xy1,'Monotributista')
                    Else
                       If EqStr(fbn('CondicionIVA'),'NCA')
                          ACT(xy1,'No Categorizado')
                       Else
                          ACT(xy1,'Otra Categorizacion')
                       Endif
                    Endif
                Endif
             Endif
          Endif
       Endif
    Endif


   * ---> Impresion De La Direccion
   #ifdef MLASA
      ACT(e:FAC, 'Domicilio / Address')
   #else
      ACT(e:FAC, 'Domicilio')
   #endif
   ACT(j:FAC, 'Cond. IVA')
   AlinearCeldas(e:fac,'I')
   SetFont(A:FAC..j:FAC, 2)
   IFA
   ACT(A:FAC, Val(ZB:13))
   AgregarMarco(a:FAC..b:FAC,2,0)  
   ACT(ZB:01, FBN('Dire'))
   if Vacio(val(ZB:01))
   *ACT(ZB:01, FBN('Calle')~' '~FBN('Altura')~' '~FSTR(FBN('Piso'),1,0)~' '~FBN('Depto'))
   *AA 05-03-2022 se modifica el piso  Varchar
      ACT(ZB:01, FBN('Calle')~' '~FBN('Altura')~' '~FBN('Piso')~' '~FBN('Depto'))
   endif
   (.'ELIBLANCOS'.)

   ACT(j:FAC, Val(xy:1))
   AgregarMarco(j:FAC..k:FAC,2,0)  
   SetFont(A:FAC..c:FAC, 1)
   
   
   ACT(E:FAC, Val(ZB:03))
   AgregarMarco(e:FAC..h:FAC,2,0)  
   SetFont(A:FAC..j:FAC, 1)
   
   * ---> Impresion Del Codigo Postal Y La Localidad
   IFA
   #ifdef MLASA   
      ACT(A:FAC, 'Localidad / Town')
      ACT(C:FAC, 'Codigo Postal / Zip Code')
      ACT(E:FAC, 'Telefono/s / Telephone/s')
   #else
      ACT(A:FAC, 'Localidad')
      ACT(C:FAC, 'Codigo Postal')
      ACT(E:FAC, 'Telefono/s')
   #endif
   SetFont(A:FAC..E:FAC, 2)
   
   IFA
   If [NoVacio(FBN('Localidad'))]
      ACT(ZB:01, FBN('Localidad'))
      (.'ELIBLANCOS'.)
      ACT(A:FAC, Val(ZB:03))
   EndIf
   AgregarMarco(a:FAC..b:FAC,2,0)     

   If [NoVacio(FBN('CodigoPostal')) y Not EqStr(FBN('CodigoPostal'), '000000')]
      If [EqStr(Copy(FBN('CodigoPostal'), 01, 02), '00')]
         ACT(C:FAC, "(" ~ Copy(FBN('CodigoPostal'), 03, 04) ~ ')')
      Else  
         ACT(C:FAC, "(" ~ Copy(FBN('CodigoPostal'), 01, 04) ~ ')')
      EndIf
   EndIf
   AgregarMarco(c:FAC,2,0)  
   
   ACT(E:FAC, fbn['Telefono'])
   AgregarMarco(e:FAC..h:fac,2,0)  

   SetFont(A:FAC..E:FAC, 1)
   *AgregarMarco(A:Val(w1)..k:FAC,2,0)
   
   SetFilaActual(fac+1)
   acn(w2,FAC)
   
   
    #ifdef MLASA
       if &Apertura
          ACT(A:FAC+1, 'POR MEDIO DE LA PRESENTE CONFIRMAMOS QUE EL '~fbn['FechaOp']~' HEMOS EFECTUADO DE NUESTRA CARTERA PROPIA LA OPERACIÓN DE APERTURA DE CAUCION')
          ACT(A:FAC+2, 'COLOCADORA PARA LIQUIDAR EL DIA '~fbn['FechaOp']~', LOS VALORES QUE SE DETALLAN')
       else
          ACT(A:FAC+1, 'POR MEDIO DE LA PRESENTE CONFIRMAMOS QUE EL '~fbn['FechaOp']~' HEMOS EFECTUADO DE NUESTRA CARTERA PROPIA LA OPERACIÓN DE CIERRE DE CAUCION')
          ACT(A:FAC+2, 'COLOCADORA PARA LIQUIDAR EL DIA '~fbn['FechaVto']~', LOS VALORES QUE SE DETALLAN')
       endif
    #else
       if &Apertura
          ABT(A:FAC+1..J:FAC+1, 'POR MEDIO DE LA PRESENTE CONFIRMAMOS QUE EL '~fbn['FechaOp']~' HEMOS EFECTUADO DE NUESTRA CARTERA PROPIA LA OPERACIÓN DE APERTURA DE CAUCION COLOCADORA PARA LIQUIDAR EL DIA '~fbn['FechaOp']~', LOS VALORES QUE SE DETALLAN',2,'black','pre-wrap')
       else
          ABT(A:FAC+1..J:FAC+1, 'POR MEDIO DE LA PRESENTE CONFIRMAMOS QUE EL '~fbn['FechaOp']~' HEMOS EFECTUADO DE NUESTRA CARTERA PROPIA LA OPERACIÓN DE CIERRE DE CAUCION COLOCADORA PARA LIQUIDAR EL DIA '~fbn['FechaVto']~', LOS VALORES QUE SE DETALLAN',2,'black','pre-wrap')
       endif
    #endif
      
   *ACT(c:FAC+6,'ESPECIE')
   ACT(ZB:21, fbn('ESPECIE'))
   ACT(ZB:22, fbn('CONTRAESPECIE'))
   SetFont(a:fac+1..c:fac+6,2)
   SetFilaActual(fac+5)   

   ACT(c:FAC,'Especie')
   ACT(f:FAC,'Plazo')
   ACT(J:FAC, 'Monto Contado')
   ACT(K:FAC, 'Monto Futuro')
   ACN(W4,FAC)
   AlinearCeldas(A:FAC..L:FAC,'C')
   AlinearCeldas(K:FAC,'D')
   SetFont(a:fac..k:fac,2)
   
   IFA   
   ACT(a:FAC, 'iCA')
   ACT(b:FAC, fbn('ISO'))
   if &Apertura
      ACT(c:FAC, '000'~fbn('CodMAEContado')~'c')
   else
      ACT(c:FAC, Pad0(FStr(FBN['Plazo'],1,0),3)~fbn('CodMAEContado')~'c')
   endif

   ACT(d:FAC, BuscarCampo('Especies', 'Nombre', 'Codigo', fbn['Especie'])) 
   
   ACT(f:FAC, fbn('Plazo'))
   
   FormatoCeldas(d:FAC,Exe('FE'))
   ACN(J:FAC, fbn['Cantidad'])
   ACN(K:FAC, fbn['TotalBrutoCli1'])
   
   if &Apertura
      ACN(Z:11, fbn['Cantidad']) 
      ACT(f:FAC,'0')
   else
      ACN(z:11, fbn['TotalBrutoCli1'])
      ACT(f:FAC, fbn('Plazo'))
   endif   
   
   * ------------------------------------------------- *
   SetFont(a:fac..k:fac,1)
   AgregarMarco(a:fac,2,0)
   AgregarMarco(b:fac,2,0)
   AgregarMarco(c:fac,2,0)
   AgregarMarco(d:fac,2,0)
   AgregarMarco(f:fac,2,0)
   AgregarMarco(j:fac,2,0)
   AgregarMarco(k:fac,2,0)
  
   AlinearCeldas(A:FAC..L:FAC,'C')
   AlinearCeldas(K:FAC,'D')

  SetFilaActual(fac+2) 
 

  *Ver esto 
  AgregarMarco(K:FAC,2,0)
  ACT(J:fac,'SUBTOTAL')
  ACN(k:FAC, Val(z:11))
  
  ACT(J:fac+1,'Aranceles MAE')
  ACT(J:fac+2,'Derechos')
  ACT(J:fac+3,'Comisiones')  
  ACT(J:fac+4,'Impuestos')
  ACT(J:fac+5,'Otros')  

  if not &Apertura
     if fbn('TotalComisiones')<>0
        ACN(k:FAC+1, fbn('TotalComisiones')*-1)
     endif   
     *ACN(k:FAC+2, )
     *ACN(k:FAC+3, )
     *ACN(k:FAC+4, )
     *ACN(k:FAC+5, )
  Endif
  *AgregarMarco(K:FAC+1..K:FAC+5,2,3)  
  

  *Ver esto 
  AgregarMarco(K:FAC+6,2,0)
  ACT(J:FAC+6,'TOTAL NETO')
  ACN(K:FAC+6, VAL(K:FAC)+VAL(K:FAC+1)+VAL(K:FAC+2)+VAL(K:FAC+3)+VAL(K:FAC+4)+VAL(K:FAC+5))
  
  AlinearCeldas(J:FAC..k:FAC+6,'D')
  SetFont(j:fac..k:FAC+6,2)
  
  ACT(b:fac+5,'El monto del IVA no puede computarse como credito fiscal.')     
  SetFont(b:FAC+5,2)
  
  
  SetFilaActual(fac+7)
  

  * ---> Impresion De La Forma De Pago Y De La Cuenta A Acreditar
  
  *Ver contra que validar 13/06/23
  if &Apertura
     act(zb:02,'Credito')
  else
     act(zb:02,'Debito')
  endif

    
  SetFilaActual(fac+1)
  AgregarMarco(A:FAC..C:FAC+4,2,0)
  AgregarMarco(A:FAC..k:FAC+4,2,0)
  
  #ifdef MLASA
     ACT(a:FAC+4,Pad('',12)~'Firma y Sello / Signature ')
  #else
     ACT(a:FAC+4,Pad('',12)~'Firma y Sello ')
  #endif
  
  SetFont(a:fac+4,2)

  
  *Modificacion 14/06/23  
  
  ACT(j:FAC,  'TNA:')
  ACT(k:fac,   FStr(Fbn('Precio1'),4, 2)~"%")
  ACT(j:FAC+1,'TES:')
  ACT(k:fac+1, FStr(Fbn('Precio2'),4, 2)~"%")
  ACT(j:FAC+2,'TEA:')
  ACT(k:fac+2, FStr(Fbn('Precio3'),4, 2)~"%")
  ACT(j:FAC+3,'CFT:')
  ACT(k:fac+3, FStr(Fbn('Precio4'),4, 2)~"%")
  
  AlinearCeldas(J:FAC..k:FAC+4,'D')
  SetFont(j:fac..k:fac+4,2)
  
  
  SetFilaActual(FAC+5)
  SetFont(e:fac-2,2)
  


