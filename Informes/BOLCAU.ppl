    ACT(TX:1, FormatSTR(LeerLeyenda('','','','BOLCAU'),Val(ZB:20),Val(ZB:21),Val(ZB:22)))
    ABT(A:FAC..K:FAC+10,Val(TX1),2,,)
    AgregarMarco(A:FAC..A:FAC, 2, 0)
#endif

