watch(SQL.BATCH())


SetFilaActual(0)
Recorrer SQL
    if(FAC >1)
        SetFilaActual(FAC+11)
        SaltarHoja()
    else
        SetFilaActual(1)
    endif
   
    (.'LOGO2'.)
    
    SetFilaActual(FAC+9)

    If EqStr(Fbn['Qry'],'1')
        *Apertura: Qry 1 -> NrBoleto 
        let &Apertura Si
    Else
        let &Apertura No
        *Cierre:   Qry 2 -> NrBoleto2 
    EndIf
    
   
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
            ACT(ZB:11, Copy(FBN('CUIT'), 01, 02)~'-'~Copy(FBN('CUIT'), 03, 08)~'-'~Copy(FBN('CUIT'), 11, 01))
         EndIf      
      EndIf
      ACT(CU:1,Val(ZB:10))
   Else
      ACT(ZB:10, '')
      ACT(CU:1,FBN['Cliente1'])
   EndIf
   ACT(op:1,FBN['NrOperacion'])
   

   * ---> Impresion Del Titulo De Referencia
   *Ver contra que validar 13/06/23
   IF &Apertura
        ACT(f:FAC, 'Operación de Apertura de Caución Colocadora')
    ELSE 
        ACT(f:FAC, 'Operación de Cierre de Caución Colocadora')
    Endif
    
    AlinearCeldas(f:FAC+&ajustarTitulo, 'C')
    SetFont(f:FAC+&ajustarTitulo, 3)

    If Eqstr(fbn('Convenio'),'1')
        ACD(fv:1, fbn['FechaPago'])
    Else
        ACD(fv:1, fbn['FechaVto'])
    Endif
   

   SetFont(d:FAC-2, 3)
   
    AFI(FAC+2,0.1)
    AFI(FAC+3,0.1)
    AFI(FAC+4,0.1)
    AFI(FAC+5,0.1)
    AFI(FAC+6,0.1)
    
   SetFilaActual(fac+2)   
   
   #ifdef BACS
   
   #else
        ACT(c:fac,  '        Agente de Liquidacion y Compensacion Propio registrado en CNV bajo el Nro. de matricula '~Val(vh:4)~' - ALyC y AN Propio')
        #ifdef MLASA
            ACT(c:fac+1, '                                         ')
            ACT(c:fac+2, '                CUIT '~Val(vh:1)~' - IVA No Responsable - Ingresos Brutos n# '~Val(vh:2))
        #else
            if EqStr(fbn['MercadoNeg'],var('AMBMAE'))
                ACT(d:fac+1, '                              Agente de Mercado Abierto N# '~Val(vh:5)~'  CUIT '~Val(vh:1))
            else
                ACT(d:fac+1, '                              Numero Agente N# '~Val(vh:6)~'  CUIT '~Val(vh:1))
            endif
                ACT(d:fac+2, '                                IVA Resp. Inscripto - Ingresos Brutos n# '~Val(vh:2))
        #endif
    #endif
   
   If FBN['Valor']=1
    Act(d:fac-3,Pad('',16)~'A    N    U    L    A    D    O')    
    SetFont(d:FAC-3, 3)
   Endif
   
      SetFilaActual(fac+3)
   acn(w1,fac)

   **********************
   ** Datos Orden   
   **********************
   ACD(ZB:09, FSys)
   
   #ifdef MLASA
      ACT(a:FAC, 'Orden/Order')
   #else
      ACT(a:FAC, 'Orden')
   #endif
   SetFont(a:FAC, 2)
   IFA
   **iF EQSTR(fbn('TipoOp'), 'TCOPRI')
