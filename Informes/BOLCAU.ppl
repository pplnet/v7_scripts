#ifdef MLASA
    ACT(A:Fac,'Los valores negociables entregados en garantía por este contrato de compraventa quedarán depositados durante su vigencia en el Mercado, el mismo pone a disposición la')
    ACT(A:fac+1,'plataforma MAEClear para el seguimiento de estos activos.')
    AgregarMarco(A:FAC..K:FAC+1, 2, 0)
    SetFilaActual(fac+1)
