if Dialogo.Radio1=0
SQL.ADD("SELECT 1 Qry, 1 TpBoleto,     O.NrOperacion,  C.Codigo Cliente1, O.Cantidad,     O.Especie,       O.ContraEspecie,     O.Precio1,           ")
SQL.ADD("       O.TotalBrutoCli1,      O.TotalNetoCli1,   O.TotalAux2,    O.TotalAux4,     O.TotalIntereses,  O.TotalComisiones,  ") 
SQL.ADD("       O.CB5,          O.CB8,                 O.PorAforo,        O.EsAforado,    O.TipoOp,        O.Convenio,          O.FechaOp,           ")
SQL.ADD("       O.FechaVto,     O.FechaAltaSisExterno, O.FechaEnvioMAE,   O.FechaAltaMAE, O.FechaCarga,    O.Cuenta1,           O.NrBoleto,          ")
SQL.ADD("       O.NrOperacion3, O.Plazo,               O.NroAltaMAE,      O.NrOrden1,     O.NrOrden,       Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE,       ")
SQL.Add("       C.Codigo,       C.RazonSocial,         C.Direccion Dire,  C.Localidad,    C.CodigoPostal,  C.CUIT,              ")
SQL.Add("       C.NrMAE,        C.CondicionIVA,        C.TipoInscripcion, C.Sucursal,     C.Telefono,      C.CategDepositante,  ")
SQL.Add("       C.Calle,        C.Altura,              C.Piso,            C.Depto,        E.ISO,                                ")
SQL.Add("       C.Alias1,       C.NrCuenta,            E.Alias5,          E.InteresesC,   E.Extendido,     E.CodMAEContado,     ")
SQL.ADD("       O.TotalCaucion, E.CotizaMAE,           E.VTeorico,        O.TipoCambio2,  O.PaseCB,        E.CodNumCajaValores, ")
SQL.ADD("       O.FechaPago,    0 Valor,               O.Precio1,         O.Precio2,      O.Precio3,       O.Precio4,           ")
SQL.ADD("       O.Mercado2 MercadoMon,                 O.Mercado MercadoTit,              O.Mercado4 MercadoNeg")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and ((O.Cliente1 = '"~VAR('VEHICULODE')~"' and O.Mercado4='"~VAR('AMBMAE')~"' and '"~VAR('CLIENTEMAE')~"'=C.Codigo) or ((O.Cliente1 <> '"~VAR('VEHICULODE')~"' or O.Mercado4<>'"~VAR('AMBMAE')~"') and O.Cliente1=C.Codigo)) ")
SQL.ADD("       and E.Codigo   = O.Especie ")
*SQL.ADD("       and (O.Mercado4 not in ("~Pipe2Comillas(VAR('AMBBYMA'))~") OR (O.Mercado4 in ("~Pipe2Comillas(VAR('AMBBYMA'))~") )) ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit  NOT IN (30,31) AND OB.Valor=1 ")

****SQL.ADD("  UNION ALL")
