*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  :  'Fecha Desde';;;;;;Dialogo.Fecha1 >= 0;'Fecha Desde Invalida';NO;FSys
  Fecha2  :  'Fecha Hasta';;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;FSys
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

ACT(A:2, Codigoinforme)
SetFilaActual(4)
ACT(a:FAC, 'Mark to Market OCT del MAE')
ACT(a:FAC+1, 'Fecha: '~Dialogo.Fecha1)
if Dialogo.Fecha2>Dialogo.Fecha1
  ACT(a:FAC+1, Val(a:FAC+1)~' hasta '~Dialogo.Fecha2)
endif
SetFont(a:FAC..a:FAC+1,2)

SetFilaActual(FAC+3)
ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Paso')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Tipo')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'Plazo')
ACT(g:FAC, 'Variable')
ACT(h:FAC, 'Fecha Vto')
ACT(i:FAC, 'Monto')
ACT(j:FAC, 'Util.MTM')
ACT(k:FAC, 'Util.Gar')
ACT(l:FAC, 'Excl.')
SetFont(a:fac..l:FAC,2)
AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select * from "~DBO~".MTMOCT ")
SQL.ADD("where Fecha between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("order by Fecha,Paso,Cliente,TipoNegociacion,Especie,NroPlazo ")
Recorrer SQL
  ACD(a:FAC, FBN['Fecha'])
  ACN(b:FAC, FBN['Paso'])
  ACT(c:FAC, FBN['Cliente'])
  ACT(d:FAC, FBN['TipoNegociacion'])
  ACT(e:FAC, FBN['Especie'])
  if FBN['NroPlazo']>0
    ACN(f:FAC, FBN['NroPlazo'])
  endif
  ACT(g:FAC, FBN['Variable'])
  if FBN['FechaVar']>0
    ACD(h:FAC, FBN['FechaVar'])
  endif
  ACN(i:FAC, FBN['Monto'])
  ACN(j:FAC, FBN['UtilizadoMTM'])
  ACN(k:FAC, FBN['UtilizadoGAR'])
  ACT(l:FAC, FBN['Excluido'])
  FormatoCeldas(b:fac..b:fac,Exe('F0'))
  FormatoCeldas(f:fac..f:fac,Exe('F0'))
  FormatoCeldas(i:fac..k:fac,Exe('F2'))
  SetFont(a:fac..l:FAC,1)
Proximo

ACO(1,7)
ACO(2,4)
ACO(3,7)
ACO(4,4)
ACO(5,7)
ACO(6,4)
ACO(7,7)
ACO(8,7)
ACO(9,10)
ACO(10,10)
ACO(11,10)
ACO(12,4)

SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(l:FAC)
