CrearDialogo
  Fecha1: 'D.Fecha'    ;;;;;;;;;fsys
  Fecha2: 'H.Fecha'    ;;;;;;;;;fsys
  Lista2: 'Especies' ;;;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES ");
Findialogo

If not OK 
  Cancelar
Endif
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

CrearFont(2,"Arial, 8,B")
CrearFont(3,"Arial, 8,I")
CrearFont(4,"Arial, 8,")
CrearFont(5,"Arial, 8,BI")

SetFilaActual(5)

ACT(A:fac, 'Cotizaciones por rango de fechas:  '~Fecha(Dialogo.Fecha1)~' al '~Fecha(Dialogo.Fecha2))
ACT(a:fac+1, 'Especies: '~iif(vacio(Dialogo.Lista2),'Todas',Pipe2Comillas(Dialogo.Lista2)))
SetFont(A:fac..a:fac+1,2)

SetFilaActual(fac+2)

ACT(a:fac,   'Fecha')
ACT(b:fac,   'Especie')
ACT(c:fac,   'Nombre')
ACT(d:fac,   'Moneda')
ACT(e:fac,   'Plazo Liq.')
*ACT(d:fac,   'Expresada en')
*ACT(d:fac+1, '(Oper.y Contab)')
ACT(f:fac,   'Precio')
ACT(f:fac+1, 'Operativo')
ACT(g:fac,   'Precio')
ACT(g:fac+1, 'Contable')
ACT(h:fac,   'Precio')
ACT(h:fac+1, 'Revaluo $')
ACT(i:fac,   'Mercado')
ACT(j:fac,   'Fuente')

SetFont(a:fac..j:fac+1,2)
AlinearCeldas(a:fac..j:fac+1,'C')
AgregarMarco(a:fac..j:fac+1,1,0,Exe('COLOR6'))
ifa

SQL.ADD(" SELECT E.Codigo, C.Fecha, C.Precio1, C.PrecioContable, E.Nombre, C.Precio5, C.FechaEj, E.Cotiza, c.Moneda,  ")
SQL.ADD(" Case C.PlazoLiq When '0' then 'Contado' When '24' then '24Hs' When '48' then '48Hs' Else 'Todos' End Plazo, Mercado, Fuente ")
SQL.ADD(" FROM "~DBO~".COTIZACIONES C, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE C.Codigo = E.Codigo ")
SQL.ADD(" AND   C.Fecha >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   C.Fecha <= "~IdxDate2(Dialogo.Fecha2)~" ")
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" AND  E.Codigo IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
SQL.ADD(" ORDER BY E.Codigo, C.FechaEj, C.Fecha ")
ACN(z:1, 0)
ACN(w1,FAC)
Recorrer SQL

  message(fbn('Codigo'))
  ACN(z:1, 1)
  ACD(a:fac, fbn('Fecha'))
  ACT(b:fac, fbn('Codigo'))
  ACT(c:fac, fbn('Nombre'))
  IF NOVACIO(fbn('FechaEj'))
     ACT(c:fac, vAL(c:fac)~' - '~fbn('FechaEj'))
  Endif
  ACT(d:fac, fbn('Moneda'))
  ACT(e:fac, fbn('Plazo'))
  ACN(f:fac, fbn('Precio1'))
  ACN(g:fac, fbn('PrecioContable'))
  ACN(h:fac, fbn('Precio5'))
  ACT(i:fac, iif(Vacio(FBN['Mercado']),'Todos',FBN['Mercado']))
  ACT(j:fac, iif(Vacio(FBN['Fuente']),'Manual',FBN['Fuente']))
  SetFont(a:fac..z:fac,4)
  FormatoCeldas(e:fac..j:fac,EXE('F9'))

