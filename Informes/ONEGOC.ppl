CrearDialogo
*--  Label1      : ''            ;1;1;;NO;;;;;'Con F2 muestra lista para seleccion'
  Fecha1      : "F.Vigencia"  ;1;1;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Especie1    : "Especie"     ;2;1;;;;;;;;;
  Cliente1    : "Entidad"     ;1;2;;;;;;;;;
  NrOperacion1: "Operacion"   ;;;;;;;;;;;;;" TipoOp In ('MMONM','MMON')"
  Radio1      : "Expresado|ARP  |USD      ";3;1;;;;;;;0
  Lista1      : "Vehiculo"    ;4;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
  Lista2      : "TipoOp"      ;-2;2;;;;NoVacio(Dialogo.Lista2);'Seleccionar por lo menos una Operacion';NO;'MMON|MMONM|';;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMONM','MMON') ")
  Radio3      : "Consolidado|SI|NO";;;;SI;SI;;

FinDialogo

if Not Ok
