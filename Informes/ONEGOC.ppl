   ACT(f:fac,FBN['Ffin'])
   ACN(g:fac,FBN['VResidual'])
   ACN(h:fac,FBN['TotalIntereses'])
   ACT(i:fac,FBN['FechaVto'])
   ACN(j:fac,FBN['Tasa']+FBN['Spread'])

   ACN(ZZ:1,FBN['FechaVto']-FBN['FechaOp'])
 
*--K:'Imp.Dev.Acum.'
   IF FBN['FechaVto'] > Dialogo.Fecha1
      ACN(k:fac,(FBN['TotalIntereses']*FACTORDIAS2(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1))/Val(ZZ:1))
   ELSE
      ACN(k:fac,(FBN['TotalIntereses']*FACTORDIAS2(FBN['FechaOp'],FBN['FechaVto']+1,FBN['RB8']+1))/Val(ZZ:1))
   ENDIF

*--L:'Imp. a Dev.'
   ACN(l:fac,FBN['TotalIntereses']-Val(k:fac))

*--M:'Imp.Dev.mes'
   IF FBN['FechaVto'] > Dialogo.Fecha1
      IF FBN['FechaOp']>=PriDeMes(Dialogo.Fecha1,SI)
         ACN(m:fac,(FBN['TotalIntereses']*FACTORDIAS2(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1))/Val(ZZ:1))
      else   
         ACN(m:fac,(FBN['TotalIntereses']*FACTORDIAS2(PriDeMes(Dialogo.Fecha1,SI),Dialogo.Fecha1+1,FBN['RB8']+1))/Val(ZZ:1))
      endif
   ELSE
      IF FBN['FechaOp']>=PriDeMes(Dialogo.Fecha1,SI)
         ACN(m:fac,(FBN['TotalIntereses']*FACTORDIAS2(FBN['FechaOp'],FBN['FechaVto']+1,FBN['RB8']+1))/Val(ZZ:1))
      else   
         ACN(m:fac,(FBN['TotalIntereses']*FACTORDIAS2(PriDeMes(Dialogo.Fecha1,SI),FBN['FechaVto']+1,FBN['RB8']+1))/Val(ZZ:1))
      endif
   ENDIF

   ACN(n:fac,FBN['TasaImpInt'])
   ACN(o:fac,FBN['ImpInt'])

*--P:'Imp.End.Dev.Acum.'
   IF FBN['FechaVto'] > Dialogo.Fecha1
      ACN(p:fac,(FBN['ImpInt']*FACTORDIAS2(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1))/Val(ZZ:1))
   ELSE
      ACN(p:fac,(FBN['ImpInt']*FACTORDIAS2(FBN['FechaOp'],FBN['FechaVto']+1,FBN['RB8']+1))/Val(ZZ:1))
   ENDIF

*--Q:'Imp.End. a Dev.'
   ACN(q:fac,FBN['ImpInt']-Val(p:fac))

*--R:'Imp.End.Dev.mes'
   IF FBN['FechaVto'] > Dialogo.Fecha1
      IF FBN['FechaOp']>=PriDeMes(Dialogo.Fecha1,SI)
         ACN(r:fac,(FBN['ImpInt']*FACTORDIAS2(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1))/Val(ZZ:1))
      else 
         ACN(r:fac,(FBN['ImpInt']*FACTORDIAS2(PriDeMes(Dialogo.Fecha1,SI),Dialogo.Fecha1+1,FBN['RB8']+1))/Val(ZZ:1))  
      endif
   ELSE
      IF FBN['FechaOp']>=PriDeMes(Dialogo.Fecha1,SI)
         ACN(r:fac,(FBN['ImpInt']*FACTORDIAS2(FBN['FechaOp'],FBN['FechaVto']+1,FBN['RB8']+1))/Val(ZZ:1))
      else   
