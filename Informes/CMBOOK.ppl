CrearDialogo
  Fecha1     :'Desde'           ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2     :'Hasta.'          ; 2;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha Hasta';NO;FSys
  Vehiculo1  :'Vehiculo'        ; 1;2;;;;;;;Var('VEHICULODE')
  Especie1   :'Especie'         ; 2;2;;;;;;;  
  Lista1     :'Book Original.'  ; 3;1;;;;;;;;;SqlSet("Select Distinct Codigo from "~DBO~".BOOKS")
  Lista2     :'Book Actual.'    ; -3;2;;;;;;;;;SqlSet("Select Distinct Codigo from "~DBO~".BOOKS")
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(4)
ACT(a:FAC, 'Operaciones con cambio de book')
SetFont(a:4..a:4,3)

ACT(a:FAC+1, 'F.Concertacion Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)

If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+2, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
   ACT(a:FAC+2, 'Vehiculo: Todos')
EndIf

If NoVacio(Dialogo.Especie1)
   ACT(a:FAC+3, 'Especie: '~Dialogo.Especie1)
Else
   ACT(a:FAC+3, 'Especie: Todos')
EndIf
If NoVacio(Dialogo.Lista1)
   ACT(a:FAC+4, 'Book original: '~ Pipe2Comillas(Dialogo.Lista1))
Else
   ACT(a:FAC+4, 'Book original: Todos')
EndIf
If NoVacio(Dialogo.Lista2)
   ACT(a:FAC+5, 'Book actual: '~ Pipe2Comillas(Dialogo.Lista2))
Else
   ACT(a:FAC+5, 'Book actual: Todos')
EndIf

SetFilaActual(FAC+7)

ACT(a:FAC, 'Numero')
ACT(b:FAC, 'Book Original')
ACT(c:FAC, 'Book Actual')
ACT(d:FAC, 'Fecha Mod. book.')
ACT(e:FAC, 'Fecha Anulacion.')
ACT(f:FAC, 'Fecha Op.')
ACT(g:FAC, 'Fecha Vto.')
ACT(h:FAC, 'Especie.')
ACT(i:FAC, 'Moneda')
ACT(j:FAC, 'Tipo Op.')
ACT(k:FAC, 'Mercado')
ACT(l:FAC, 'Merc. Liq. Esp.')
ACT(m:FAC, 'Merc. Liq. Mon.')
ACT(n:FAC, 'Cliente')
ACT(o:FAC, 'Cantidad')
ACT(p:FAC, 'Precio/Tasa')
ACT(q:FAC, 'Vehiculo')
ACT(r:FAC, 'Operador')

AlinearCeldas(l:FAC..m:FAC,'D')
SetFont(a:5..r:FAC,2)
AgregarMarco(a:FAC..r:FAC,1,0,Exe('COLOR6'))

SQL.ADD("Select * from ")
SQL.ADD("(Select O.*,OB.NrBit,I.Nombre,C.RazonSocial, ")
SQL.ADD(" O.Termsheet as TSID, ")
SQL.ADD(" O.Mercado4 MercNeg, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TIC','TIV','TIPA','TIPP','TIFC','TIFV','TICT','TICO','TIPO','TIDE','TCPCEM','TCOPRI') THEN O.Mercado ELSE O.Mercado3 END MercLiqEsp, ")
SQL.ADD(" O.Mercado2  MercLiqMon, ")
SQL.ADD(" cu.codigo + '-' + cu.numero cu_numero ")
SQL.ADD("  From "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CLIENTES C on O.Cliente1=C.Codigo LEFT OUTER JOIN dbo.cuentas cu on O.Cuenta1=Cu.Codigo, "~DBO~".OPERACIONESBITS OB, "~DBO~".INSTANCIAS I")
SQL.ADD("Where O.NrOperacion=OB.NrOperacion and OB.Valor='1' ")
SQL.ADD("  and O.FechaOp between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
SQL.ADD("  and OB.NrBit=I.NrInstancia and I.Tabla='OPERACIONES' ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")  
EndIf
SQL.ADD(" and (O.BookAnterior IS NOT NULL OR ")
SQL.ADD("  O.FechaCambioBook IS NOT NULL) ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.BookAnterior In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.Book1 In ("~Pipe2Comillas(Dialogo.Lista2)~")")
EndIf
SQL.ADD(" ) as Aux")


SQL.ADD("UNION")
*----------------------------
SQL.ADD("Select * from ")
SQL.ADD("(Select O.*, 0 NrBit,'*** Sin Instancia ***' Nombre,C.RazonSocial, ")
SQL.ADD("  O.Termsheet as TSID, ")
SQL.ADD(" O.Mercado4 MercNeg, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TIC','TIV','TIPA','TIPP','TIFC','TIFV','TICT','TICO','TIPO','TIDE','TCPCEM','TCOPRI') THEN O.Mercado ELSE O.Mercado3 END MercLiqEsp, ")
SQL.ADD(" O.Mercado2  MercLiqMon, ")
SQL.ADD(" cu.codigo + '-' + cu.numero cu_numero ")
SQL.ADD("  From "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CLIENTES C on O.Cliente1=C.Codigo LEFT OUTER JOIN dbo.cuentas cu on O.Cuenta1=Cu.Codigo ")
SQL.ADD(" Where Not Exists (SELECT 1 FROM OPERACIONESBITS OB2 WHERE OB2.NrOperacion=O.NrOperacion and OB2.Valor=1 ) ")
SQL.ADD("   and O.FechaOp between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
EndIf
SQL.ADD(" and (O.BookAnterior IS NOT NULL OR ")
SQL.ADD("  O.FechaCambioBook IS NOT NULL) ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")  
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.BookAnterior In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
If NoVacio(Dialogo.Lista2)
   SQL.ADD(" and O.Book1 In ("~Pipe2Comillas(Dialogo.Lista2)~")")
EndIf
SQL.ADD(" ) as Aux")
SQL.ADD(" order by FechaOp,NrOperacion ")

watch(SQL.BATCH())
*----------------------------
Recorrer SQL

   ACT(a:fac, FBN['NrOperacion'])
   ACLO(a:fac, FBN['NrOperacion'])
   ACT(b:FAC, FBN['BookAnterior'])
   ACT(c:FAC, FBN['Book1'])
   ACT(d:FAC, FBN['FechaCambioBook'])
  
   ACT(e:FAC, FBN['FechaAnulacionCambioBook'])
   if CeldaVacia(e:fac)
      ACT(e:FAC,"---------------")
   else
   endif
   ACD(f:FAC, FBN['FechaOp'])
   ACD(g:FAC, FBN['FechaVto'])
   ACT(h:fac, FBN['Especie'])
   ACT(i:fac, FBN['ContraEspecie'])
   ACT(j:fac, FBN['TipoOp'])
   if fbn('PaseCB')=1 y Not Incluido(FBN['TipoOp'],'TIPA|TIPP')
        ACT(j:fac, Val(j:FAC)~' x Pase')
   endif
   ACT(k:fac, FBN['MercNeg'])
   ACT(l:fac, FBN['MercLiqEsp'])
   ACT(m:fac, FBN['MercLiqMon'])
   ACT(n:fac, FBN['Cliente1']~'-'~Copy(FBN['RazonSocial'],1,25))
   
   If Incluido(FBN['TipoOp'],'FXCTC|FXVTC|')
        ACN(o:fac, FBN['Cantidad']* BuscarCampo('ESPECIES','TamanioLote','Codigo',FBN['Especie'])  )
   Else
        ACN(o:fac, FBN['Cantidad'])
   EndIf
   
   ACN(p:fac, FBN['Precio1'])
   ACT(q:fac, FBN['Vehiculo1'])
   ACT(r:fac, FBN['Operador'])
   
Proximo

