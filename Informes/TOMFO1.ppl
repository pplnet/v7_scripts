ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1   : 'Fecha'             ;;;;;;;;;FSys
  Especie1 : 'Especie'           ;;;;;;;;;Var('MONELOCA');;;;;"Tipo='MON' "
  Radio2   : 'Expresado|ARP|USD' ;;;;;;;;;0;
  Precio1  : 'Cotizacion'        ;;;;;Not EqStr(Dialogo.Especie1,Dialogo.Especie2);Dialogo.Precio1<>0 o EqStr(Dialogo.Especie1,Dialogo.Especie2);'Debe ingresar la cotizacion.';NO;;
  Especie2 : 'especie '          ;;;;;NO;;;;IIF(Dialogo.Radio2=0,'ARP','USD');IIF(Dialogo.Radio2=0,'ARP','USD');
  Lista1   : 'Vehiculo'          ;5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Lista2   : 'Tipos Op'          ;-1;2;;;;;;;'MMPCCV|MMPCCM|MMPCLM|MMPCL|';;'MMFIMV|VIMIND|VIMINM|MMSIMV|MMPSI|MMON|MMONM|MMPEM|MMPIM|MMPOSM|MMFRNP|MMPCOS|MMPE|MMPI|MMPLME|'
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')
ACD(fe1,Dialogo.Fecha1)

ACD(fe2,Habiles(Dialogo.Fecha1,-1,'ARG',NO) )

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,1)

SetFilaActual(2)

** Imprimo titulos del cuadro principal
ACN(co3,1)
(.'FCUADR1'.) 

(.'SELTOMFON'.)
ACN(co2,0)
ACN(zz2,0)
ACT(zz1,'')
ACN(fi1,0)
ACN(co4,899)
ACT(re1,'')
Recorrer SQL
   ** Corte por tipo de operacion
   if Not EqStr(FBN['TipoOp'],Val(zz1))
      if Val(zz2)<>0
         ** subtotal
         ** me posiciono en la ultima fila impresa y dibujo los marcos
         SetFilaActual(fac-1)
         ** Imprimo los marcos del cuadro principal
         ACN(co3,0)
         ACN(au1,fac)
         (.'FCUADR1'.)
         ifa    
         ACT(b:fac, 'SUBTOTAL')
         ACN(f:fac,Val(su1))
         ACN(g:fac,Val(su2))
         ACN(m:fac,Val(su3))
         ACN(n:fac,Val(su4))
         ACN(o:fac,Val(su5))
         ACN(s:fac,Val(su6))
         ACN(t:fac,Val(su7))
         ACN(u:fac,Val(su8))
         ACN(w:fac,Val(su9))
         ACN(x:fac,Val(su10))
         ACN(y:fac,Val(su11))
         ACN(z:fac,Val(su12))
         SetFont(b:fac..z:fac,1)
     
         ** inicializo variables de suma
         ACN(co2,0)
         ACN(su1,0)
         ACN(su2,0)
         ACN(su3,0)
         ACN(su4,0)
         ACN(su5,0)
         ACN(su6,0)
         ACN(su7,0)
         ACN(su8,0)
         ACN(su9,0)
         ACN(su10,0)
         ACN(su11,0)
         ACN(su12,0)
         ifa
      else
         ACN(zz2,1)
         ** guardo la primer fila de impresion de datos
         ACN(in1,fac)
      endif
      ACT(zz1,FBN['TipoOp']) 
   endif

   ** Puedo tener dos registros con = NrOperacion porque una tiene Cuotas y la otra no
   IF Not EqStr(FBN['NrOperacion'],Val(a:fac-1))
      ACT(b:fac, FBN['Cliente1'])
      ACD(c:fac, FBN['FechaOp'])
      ACT(i:fac, FBN['TipoOp'])
      ACT(a:fac, FBN['NrOperacion'])
      ACLO(a:fac, FBN['NrOperacion'])
      ACT(b:fac, FBN['Cliente1'])
      ACD(c:fac, FBN['FechaOp'])
      ACD(d:fac, FBN['FechaVto'])
      ACN(e:fac, FBN['FechaVto']-FBN['FechaOp'])
      ACN(f:fac, FBN['Importe'])
      ACN(g:fac, FBN['ImporteVto'])
      ACT(h:fac, BuscarCampo('TIPOSOPERACION', 'Nombre','Codigo', FBN['TipoOp']) )
      ACT(i:fac, FBN['TipoOp'])

      ACN(n:fac, FBN['ImpInt'])

      ** dias restantes para la fecha del vto
      ACN(p:fac, FactorDias2(Dialogo.Fecha1,FBN['FechaVto'],FBN['RB8']+1) )

      ** dias transcurridos desde fecha de origen
      if Not Incluido(FBN['TipoOp'],'VIMIND|VIMINM|TEMIND|')
         ACN(q:fac, FactorDias2(FBN['FechaOp'],Dialogo.Fecha1,FBN['RB8']+1)+1 )
         ACN(tt2, IIF(FBN['RB8']>1,360,365) )
      else
         ACN(q:fac, Dialogo.Fecha1-FBN['FechaOp'] )
         ACN(tt2, IIF(FBN['RB8']=1,365,360) )
      endif

      ** dias mes 
      if FBN['FechaOp'] < PriDeMes(Dialogo.Fecha1,SI)
         ACN(r:fac, Dialogo.Fecha1-PriDeMes(Dialogo.Fecha1,SI)+1 )
      else
         ACN(r:fac, Dialogo.Fecha1-FBN['FechaOp']+1 )
      endif

      ************ Intereses del periodo ****************
      ACN(tt2, IIF(FBN['RB8']=1,365,360) )
      ACN(m:fac, Val(f:fac)*Val(e:fac)*FBN['Tasa']/(Val(tt2)*100) )

      ** Intereses Totales al vto
      ACN(o:fac, Val(m:fac)+Val(n:fac) )

      ** Interes Diario
      ACN(s:fac,Val(o:fac)/Val(e:fac) )

      *- TEM
       ACN(j:fac, ((Val(f:fac)+Val(o:fac))/Val(f:fac))-1)
       ACN(j:fac, ((Val(j:fac)+1)^(30/Val(e:fac))-1)*100 )

      *- TNAA
      if Val(j:fac)>0
         ACN(l:fac, ((Val(j:fac)/100+1)^(Val(e:fac)/30))-1 )
         ACN(l:fac, Val(l:fac)*36500/Val(e:fac) )
      else
         ACN(l:fac,0)
      endif

      ************ Calculo intereses devengados ************
      * Calculo T/UT
      if Incluido(FBN['TipoOp'],'VIMIND|VIMINM|TEMIND|')
         ACN(tt1, FactorDias(FBN['FechaOp'],Dialogo.Fecha1+1,FBN['RB8']+1) )
      else
         ACN(tt1, Dialogo.Fecha1-FBN['FechaOp']+1 )
         ** TIEMPO/UNIDAD DE TIEMPO
         ACN(tt1, Val(tt1)/Val(tt2) )
      endif

      ACN(t:fac, IIF(Val(j:fac)>0, Val(f:fac)*Val(q:fac)*Val(l:fac)/(36500),0)  )

      *- TNA Vencida
      ACN(k:fac, FBN['Tasa'] )

      ******** Tasa Total ***************
      *- Claudia para que costo y plazo promedio de deuda
      *- tome la TTN.
      *--ACN(v:fac, Val(k:fac)*(1+(FBN['TasaImp1']/100)) )
      ACN(v:fac, FBN['TasaTotal'])

      ******** IVA s/intereses ***************
      ACN(u:fac, FBN['IVA'])

      *-Numerales Dias del mes (Importe de la Operacion por los dias transcurridos del mes)
      ACN(w:fac,val(f:fac)*val(r:fac))

      *- Numerales TEM = Numerales dias del mes * TEM
      ACN(x:fac,val(w:fac)*val(j:fac)/100)  

      *- Numerales al Vto: Importe de la Op.*Dias al Vto
      ACN(y:fac,val(f:fac)*val(p:fac))  

      *- Numerales Sin Dias
      ACN(z:fac,val(f:fac)*val(k:fac))  

      *- Numerales TNA Adelantada
      ********ACN(z:fac,val(f:fac)*val(l:fac))  

      *- Numerales Tasa Total
      SCN(bg1, Round(Val(f:fac)*Val(v:fac),2)/100 )
      SCN(co2,1)
      ** sumo subtotales
      SCN(su1,FBN['Importe'])
      SCN(su2,FBN['ImporteVto'])
      SCN(su3,Val(m:fac))
      SCN(su4,Val(n:fac))
      SCN(su5,Val(o:fac))
      SCN(su6,Val(s:fac))
      SCN(su7,Val(t:fac))
      SCN(su8,Val(u:fac))
      SCN(su9,Val(w:fac))
      SCN(su10,Val(x:fac))
      SCN(su11,Val(y:fac))
      SCN(su12,Val(z:fac))
      ** sumo totales generales
      SCN(su21,Val(f:fac))
      SCN(su22,Val(g:fac))
      SCN(su23,Val(m:fac))
      SCN(su24,Val(n:fac))
      SCN(su25,Val(o:fac))
      SCN(su26,Val(s:fac))
      SCN(su27,Val(t:fac))
      SCN(su28,Val(u:fac))
      SCN(su29,Val(w:fac))
      SCN(su30,Val(x:fac))
      SCN(su31,Val(y:fac))
      SCN(su32,Val(z:fac))

      ** guardo datos para vtos por fecha
      SCN(co4,1)
      ACD(aa:Val(co4), FBN['FechaVto'] )
      ACN(ab:Val(co4), Val(f:fac) )
      ACN(ac:Val(co4), Val(o:fac) )
      ACN(ad:Val(co4), Val(g:fac) )
 
      ** guardo datos para vtos por entidad
      ACT(ba:Val(co4), FBN['Cliente1'] )
      ACT(bb:Val(co4), FBN['TipoOp'] )
      ACN(bc:Val(co4), Val(f:fac) )
      ACN(bd:Val(co4), Val(t:fac) )
      ACN(be:Val(co4), Val(g:fac) )
      ACN(bf:Val(co4), (Val(n:fac)*val(q:fac))/val(e:fac))

      SCN(fi1,1)
   else
      dfa
   endif
Proximo

if Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else
   ** Imprimo los marcos del cuadro principal
   ACN(co3,0)
   ACN(au1,fac)
   (.'FCUADR1'.)
   IFA
   ACT(b:fac, 'SUBTOTAL')
   ACN(f:fac,Val(su1))
   ACN(g:fac,Val(su2))
   ACN(m:fac,Val(su3))
   ACN(n:fac,Val(su4))
   ACN(o:fac,Val(su5))
   ACN(s:fac,Val(su6))
   ACN(t:fac,Val(su7))
   ACN(u:fac,Val(su8))
   ACN(w:fac,Val(su9))
   ACN(x:fac,Val(su10))
   ACN(y:fac,Val(su11))
   ACN(z:fac,Val(su12))
   SetFont(b:fac..z:fac,1)
 
   SetFilaActual(fac+2)
   ACT(b:fac, 'TOTAL GENERAL '~IIF(Not EqStr(Dialogo.Especie1,Dialogo.Especie2),'('~Dialogo.Especie1~')','')     )
   ACN(f:fac,Val(su21))
   ACN(g:fac,Val(su22))
   ACN(m:fac,Val(su23))
   ACN(n:fac,Val(su24))
   ACN(o:fac,Val(su25))
   ACN(s:fac,Val(su26))
   ACN(t:fac,Val(su27))
   ACN(u:fac,Val(su28))
   ACN(w:fac,Val(su29))
   ACN(x:fac,Val(su30))
   ACN(y:fac,Val(su31))
   ACN(z:fac,Val(su32))
   ACN(fi1,fac)
  
   ** Si lo desea expresar en otra moneda (ARP o USD)
   if Not EqStr(Dialogo.Especie1,Dialogo.Especie2)
      ifa
      ACT(b:fac, 'TOTAL GENERAL ('~Dialogo.Especie2~' TC: '~FStr(Dialogo.Precio1,1,6)~')' )

      IF EqStr(Modo(Dialogo.Especie1,Dialogo.Especie2),'DIR')
         ACN(f:fac,Val(su21)*Dialogo.Precio1)
         ACN(g:fac,Val(su22)*Dialogo.Precio1)
         ACN(m:fac,Val(su23)*Dialogo.Precio1)
         ACN(n:fac,Val(su24)*Dialogo.Precio1)
         ACN(o:fac,Val(su25)*Dialogo.Precio1)
         ACN(s:fac,Val(su26)*Dialogo.Precio1)
         ACN(t:fac,Val(su27)*Dialogo.Precio1)
         ACN(u:fac,Val(su28)*Dialogo.Precio1)
         ACN(w:fac,Val(su29)*Dialogo.Precio1)
         ACN(x:fac,Val(su30)*Dialogo.Precio1)
         ACN(y:fac,Val(su31)*Dialogo.Precio1)
         ACN(z:fac,Val(su32)*Dialogo.Precio1)
      else
         ACN(f:fac,Val(su21)/Dialogo.Precio1)
         ACN(g:fac,Val(su22)/Dialogo.Precio1)
         ACN(m:fac,Val(su23)/Dialogo.Precio1)
         ACN(n:fac,Val(su24)/Dialogo.Precio1)
         ACN(o:fac,Val(su25)/Dialogo.Precio1)
         ACN(s:fac,Val(su26)/Dialogo.Precio1)
         ACN(t:fac,Val(su27)/Dialogo.Precio1)
         ACN(u:fac,Val(su28)/Dialogo.Precio1)
         ACN(w:fac,Val(su29)/Dialogo.Precio1)
         ACN(x:fac,Val(su30)/Dialogo.Precio1)
         ACN(y:fac,Val(su31)/Dialogo.Precio1)
         ACN(z:fac,Val(su32)/Dialogo.Precio1)
      endif
   endif

   *- PARA LINKEAR EL INTERES DEVENGADO DE LOS FONDOS DEL INFORME DE RESUMEN
   *- fo2: Interes 
   ACN(fo2,val(t:fac))

   SetFont(b:Val(fi1)..z:fac,1)
   AgregarMarco(a:Val(fi1)..z:fac,1,1)
   AgregarMarco(f:Val(fi1)..g:fac,1,2)
   AgregarMarco(m:Val(fi1)..o:fac,1,2)
   AgregarMarco(s:Val(fi1)..z:fac,1,2)

   ** Realizo el formato de todas las celdas
   FormatoCeldas(e:Val(in1)..e:fac,Exe('F0'))
   FormatoCeldas(f:Val(in1)..g:fac,Exe('F2'))
   FormatoCeldas(j:Val(in1)..l:fac,Exe('F5'))
   FormatoCeldas(m:Val(in1)..o:fac,Exe('F2'))
   FormatoCeldas(p:Val(in1)..r:fac,Exe('F0'))
   FormatoCeldas(s:Val(in1)..t:fac,Exe('F2'))
   FormatoCeldas(u:Val(in1)..u:fac,Exe('F2'))
   FormatoCeldas(v:Val(in1)..v:fac,Exe('F5'))
   FormatoCeldas(w:Val(in1)..z:fac,Exe('F2'))

   SetFilaActual(fac+4)

   ** Seccion Indicadores
*   ACT(b:fac-2, 'Capital Promedio:' )
*   ACT(b:fac-1, 'Intereses Devengados:' )
*   ACT(b:fac,   'Dias Prom.(Transcurridos):' )
*   ACT(b:fac+1, 'Dias Prom.(Al Vencimiento):' )
*   ACT(b:fac+2, 'Tasa Promedio:' )
*   ACT(b:fac+3, 'Tasa NA Prom. sin ponderacion de dias (Total):' )
*   ACT(b:fac+4, 'Tasa NA Prom. sin ponderacion de dias (Argend/CA):' )
*   ACT(b:fac+5, 'Tasa NA Prom. sin ponderacion de dias (Fdo Ahorro):' )
*   ACT(b:fac+6, 'Tasa NA Prom. sin ponderacion de dias (Overnight):' )
*   ACT(b:fac+7, 'Tasa NA Prom. sin ponderacion de dias (Total con impuestos):' )
*   ACT(b:fac+8, 'Tasa NA Prom. sin ponderacion de dias (Argend/CA c/impuestos):' )
*   ACT(b:fac+9, 'Tasa NA Prom. sin ponderacion de dias (Fdo Ahorro c/impuestos):' )
*   ACT(b:fac+10, 'Tasa NA Prom. sin ponderacion de dias (Overnight con impuestos):' )
*   ACT(b:fac+11, "(**) La tasa de los Fondos Ahorro u$s es 'Estimada' ")
*   SetFont(b:fac-2..b:fac+11,1)

   ** Seccion Indicadores
   *- Cap.Promedio: Total de Numerales Dias del Mes dividido por la Cantidad de Dias que tiene el Mes de la fecha de reporte)
   ACT(b:fac-2, 'Capital Promedio:' )
   ACN(g:fac-2, val(w:val(fi1))/DiasM(1,Dialogo.Fecha1) )

   ACT(b:fac-1, 'Intereses Devengados:' )
   ACN(g:fac-1, val(t:val(fi1)))

   *- Dias Promedio Transcurridos: Total de Numerales Dias del Mes dividido el Importe Total de Colocaciones
   ACT(b:fac, 'Dias Prom. (Transcurridos):' )
   ACN(g:fac, val(w:val(fi1))/val(f:val(fi1)))

   *- Numerales Dias al Vencimiento dividido el Importe Total de Colocaciones
   ACT(b:fac+1, 'Dias Prom. (Al Vencimiento):' )
   ACN(g:fac+1, val(y:val(fi1))/val(f:val(fi1)))

   *- PARA LINKEAR EN RESUMEN DE OPERACIONES fo3: Dias Transcurridos  
   ACN(fo3,val(g:fac+1))

   *- ((1+Total de Numerales de la Tasa efectiva mensual / Total de Numerales Dias del Mes) ** (Cantidad de Dias del Mes /30))-1
   ACT(b:fac+2, 'Tasa Promedio:' )
*   if val(f:val(fi1))<>0
*      ACN(g:fac+2, ( (1+ val(x:val(fi1))/val(w:val(fi1)))^(DiasM(1,Dialogo.Fecha1)/30) )-1 )
*      ACN(g:fac+2, Val(g:fac+2)*100 )
*   else
*      ACN(g:fac+2, 0)
*   endif

   ACN(g:fac+2, Val(z:Val(fi1))/Val(f:Val(fi1)) )


   *- Numerales Tasa Nominal Anual Vencida dividido el Importe Total de Colocaciones
   ACT(b:fac+3, 'Tasa NA Prom. sin considerar Impuestos:' )
   ACN(g:fac+3, val(z:val(fi1))/val(f:val(fi1)) )

   *- Numerales Tasa Nominal Anual Adelantada dividido el Importe Total de Colocaciones
   ACT(b:fac+4, 'Tasa NA Prom. considerando Impuestos:' )
   ACN(g:fac+4, val(bg1)/Val(f:val(fi1))*100 )

   SetFont(b:fac-2..g:fac+11,1)
   *-  PARA LINKEAR EN RESUMEN DE OPERACIONES fo4: Tasa Promedio para Linkear
   ACN(fo4,val(g:fac+4))


   ** Imprimo Resumen de vtos por entidad a partir de la columna 12 (letra l)
   ACN(co1,12)
   ACN(fi1,fac)
   ACN(fi3,fac)
   (.'RESVTOXFE'.)
 
   ** Imprimo Resumen de vtos por entidad a partir de la columna 21 (letra u)
   ACN(co1,21)
   ACN(fi1,Val(fi3))
   ACT(fi3, 'TOMA')
   (.'RESVTOXCLI'.)

   if Val(co7)>Val(co8)
      SetFilaActual(fac+Val(co7)+6)
   else
      SetFilaActual(fac+Val(co8)+6)
   endif
   ACO(20,6)
   ACO(24,8)
   ACO(25,10)
   ACO(26,10)
   LimitesVision(z:fac)
   Impresion(1,2)
   RangoTitulo(a1..y:8,8)
   SetPrintFit(3,49)
endif 
