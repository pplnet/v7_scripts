MostrarCuadroDeMensajes
CrearDialogo
  NrTrans1:'Operacion' ;;;;;;NOVACIO(Dialogo.NrTrans1);;NO;;;;;;"TipoTr2 = 'CANJE' "
  Check1  :'Re-Emision';
  Check3  :'Impresora' ;  
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,12,B')
CrearFont(5, "Arial,5,")

ACN(BD:1,0)

SetFilaActual(2)
SQL.ADD(" SELECT T.NrTrans, C.Especie1 FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CUOTAS C" )
SQL.ADD(" WHERE  T.NrTrans = '"~Dialogo.NrTrans1~"' ")
SQL.ADD("   and  C.NrOperacion = T.NrTrans ")
watch(SQL.BATCH())
Recorrer SQL
 message(fbn('NrTrans'))
 SCN(nb:1, 1)

 SQL.ADD(" select C.Codigo, C.RazonSocial, C.Direccion, C.Localidad, C.CodigoPostal, C.CondicionIVA, ")
 SQL.ADD(" C.CUIT, P.Nombre Pais, T.Fecha1, T.TipoTr2, T.NrTrans, T.Especie, E.Nombre NomEsp, ")
 SQL.ADD(" CU.Especie1, I.Nombre NomEsp1, T.Especie2, S.Nombre NomEsp2, CU.Cantidad4 Cantidad1, CU.Cantidad1 Cantidad2, ")
 SQL.ADD(" T.Cantidad3, CU.Cantidad2 Cantidad4, CU.Cantidad3 Cantidad5, T.Cantidad6, T.RB8, ")
 SQL.ADD(" T.Cantidad7, T.Especie4, T.Vehiculo1, T.Mercado1, T.Cantidad10, T.Cantidad11, T.Cantidad12, T.Cantidad13,  T.Cantidad14, T.Cantidad15 ")
 SQL.ADD(" from  "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".PAISES P, "~DBO~".ESPECIES E, "~DBO~".ESPECIES I, "~DBO~".ESPECIES S, "~DBO~".CUOTAS CU ")
 SQL.ADD(" where C.Codigo    = T.Cliente1 ")
 SQL.ADD("  and  T.NrTrans   = CU.NrOperacion ")
* SQL.ADD("  and  C.PaisDir   = P.Codigo ")
 SQL.ADD("  and  C.Pais   = P.Codigo ")
 SQL.ADD("  and  T.Especie   = E.Codigo ")
 SQL.ADD("  and  CU.Especie1 = I.Codigo ")
 SQL.ADD("  and  '"~Dialogo.NrTrans1~"' = T.NrTrans   ")
 SQL.ADD("  and  '"~fbn('Especie1')~"'  = CU.Especie1 ")
 SQL.ADD("  and  T.Especie2 = S.Codigo ")

 
    
 Recorrer SQL
   message(fbn('Especie')~' ->'~fbn('Especie1'))

   IF Eqstr(fbn('Especie4'), Var('MONELOCA'))
     ACT(MA:1, '$')
   ELSE
     ACT(MA:1, 'U$S')
   ENDIF
   ACN(BD:1,1)

   
   ACT(f:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Vehiculo1')))
   ACT(f:2, 'C.U.I.T. Nº '~BuscarCampo('CLIENTES','CUIT','Codigo',fbn('Vehiculo1')))    
   if BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')) > 0
    ACT(f:4, 'Cuenta en Caja de Valores Nº '~BuscarCampo('CLIENTES','NrAgenteBolsa','Codigo',fbn('Vehiculo1')))
   endif
   ACT(f:7,'Liquidacion del: '    ~fbn('Fecha1'))
   SetFont(f:1..f:7,2)
   
   ACT(a:3,'Emision Voucher '~BuscarCampo('MERCADOS','Descripcion','Codigo',fbn['Mercado1']))
   ACT(a:4,'Fecha: '~ Fecha(FSYS))
   ACT(a:7,'Voucher de liquidacion Nro: ' ~fbn('NrTrans'))
   SetFont(a:1..a:7,2)
   
   * ORIGINAL -------------------------------------------------------------------------------- *
    AgregarBMP(A:1,EXE('LOGO'),EXE('ESCALOGO'))
   
   SetFilaActual(fac+4)
   IF Not Eqstr(fbn('RB8'), '0') Y NoVacio(fbn('RB8'))
   ACT(D:1, 'REIMP. ORIGINAL')
   ELSE
   ACT(D:1, 'ORIGINAL')
   ENDIF
    
   AlinearCeldas(D:1, 'C')
   SetFont(D:1, 2)

   SetFilaActual(fac+1) 
   ACT(D:FAC,'Voucher de Canje')
   AgregarMarco(a:fac..g:fac,2,0)
   AlinearCeldas(D:FAC,'C')
   SetFont(D:FAC,4)
   
   SetFilaActual(fac+1) 
   ACT(a:fac,'Sres.: '~fbn('RazonSocial'))

   SetFont(a:fac, 2)

   ifa
   
   ACT(a:fac,  'Direccion: '~ fbn('Direccion'))
   ACT(a:fac+1,'('~fbn('CodigoPostal')~') '~fbn('Localidad')~' - '~fbn('Pais'))
   ACT(a:fac+2,'Cliente: '   ~fbn('Codigo'))
   ACT(a:fac+3,BuscarCampo('TIPOSIMPUESTO','Descripcion','Codigo',fbn('CondicionIVA')))
   ACT(a:fac+4,'CUIT: '~fbn('CUIT'))
   
   SetFont(a:fac..a:fac+4, 2)

   SetFilaActual(fac+6)
   
   ACT(a:fac,'Fecha Op.')
   ACT(b:fac,'Nr.Op.')
   ACT(c:fac,'T.Op.')
   ACT(d:fac,'Descripcion')
   ACT(g:fac,'Importes')
   SetFont(a:fac..g:fac,2)
   AgregarMarco(a:fac..g:fac, 2,0,Exe('COLOR')) 
   
   ifa
   
   ACT(a:fac,fbn('Fecha1'))
   ACT(b:fac,fbn('NrTrans'))
   ACLT(b:FAC, fbn['NrTrans'])
   ACT(c:fac,fbn('TipoTr2'))
   
   ACT(d:fac,Mayusculas2(fbn('NomEsp')))
   ACN(g:fac,(-1)*fbn('Cantidad1'))
   ifa
   ACT(d:fac,Mayusculas2(fbn('NomEsp1')))
   ACN(g:fac,fbn('Cantidad2'))
   
   SetFont(a:fac-1..g:fac,2)
   
   
   ACN(CF:1, fac)
   *total
   ACN(CF:2, 0)
   ifa
   If fbn('Cantidad10') > 0
     ifa
     ACT(d:fac,'Comision')
     ACN(g:fac,fbn('Cantidad10'))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ACN(CF:2, Val(CF:2)+fbn('Cantidad10'))
   Endif
   If fbn('Cantidad11') > 0
     ifa
     ACT(d:fac,'IVA Comision' )
     ACN(g:fac,fbn('Cantidad11'))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ACN(CF:2, Val(CF:2)+fbn('Cantidad11'))
   Endif
   If fbn('Cantidad12') > 0
     ifa
     ACT(d:fac,'Com. CV CP')
     ACN(g:fac,fbn('Cantidad12'))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ACN(CF:2, Val(CF:2)+fbn('Cantidad12'))
   Endif
   If fbn('Cantidad13') > 0
     ifa
     ACT(d:fac,'IVA s/Com.CV CP')
     ACN(g:fac,fbn('Cantidad13'))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ACN(CF:2, Val(CF:2)+fbn('Cantidad13'))
   Endif
   If fbn('Cantidad14') > 0
     ifa
     ACT(d:fac,'Com. CV 3ros')
     ACN(g:fac,fbn('Cantidad14'))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ACN(CF:2, Val(CF:2)+fbn('Cantidad14'))
   Endif
   If fbn('Cantidad15') > 0
     ifa
     ACT(d:fac,'IVA s/Com.CV 3ros')
     ACN(g:fac,fbn('Cantidad15'))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ACN(CF:2, Val(CF:2)+fbn('Cantidad15'))
   Endif
   
   If Val(CF:2) > 0
     SetFilaActual(fac+2)
     ACT(d:fac,'Total Gastos e Impuestos')
     ACN(g:fac,Val(CF:2))
     FormatoCeldas(d:fac,Exe('F2'))
     SetFont(d:fac..g:fac, 2)
     ifa
   Endif
   
   SetFilaActual(fac + 2)
   
   ACT(d:fac,Mayusculas2(fbn('NomEsp')))
   ACN(g:fac,(-1)*fbn('Cantidad1'))
   ifa
   ACT(d:fac,Mayusculas2(fbn('NomEsp1')))
   ACN(g:fac,fbn('Cantidad2'))
   
   SetFont(d:fac-1..g:fac,3)
   AgregarMarco(c:fac-2..g:fac+1, 2,0,Exe('COLOR')) 
   
   
   SetFilaActual(fac + 4)
   AFI(fac-1, 8)
   ACT(a:FAC-1, 'Descripcion')
   SetFont(a:FAC-1,3)
   AgregarMarco(a:FAC-1..g:FAC+2+Val(ac:1),2,0) 
   
   ACT(a:fac,'Canje de '~FStr(fbn('Cantidad1'),0,0)~' '~fbn('NomEsp')~' por '~FStr(fbn('Cantidad2'),0,0)~' '~fbn('NomEsp1')~' en una relacion de '~FStr(fbn('Cantidad4'),0,0)~' a '~FStr(fbn('Cantidad5'),0,0)~' respectivamente.')
     
   
   SetFont(a:fac, 2)
   ifa
   If fbn('Cantidad3') > 0
     ACT(a:fac,'Del mismo resulto una fraccion de '~fbn('Especie2')~' '~FStr(fbn('Cantidad3'),0,2)~', habiendose cotizando la fraccion unidad a '~fbn('Especie2')~' '~FStr(fbn('Cantidad6'),0,2)~'.')
     SetFont(a:fac, 2)
   Endif
   
   SetFilaActual(FAC + 4)
   ACT(a:FAC, 'Observaciones Confirmacion')
   SetFont(a:FAC,3)
   AgregarMarco(a:FAC..g:FAC+2+Val(ac:1),2,0)
   setfilaactual(fac+10)
   AFI(fac,8)


  Proximo
Proximo

If Val(BD:1)=0
  MessageBox('No hay Canjes que concuerden con los Datos Ingresados')
  Cancelar
Endif

