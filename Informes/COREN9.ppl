ModoReproceso(ConDialogo)
HojaVisible(SI)
CrearDialogo
   Fecha1: 'Desde'                           ;;;;;;;;;;FSYS-1
   Fecha2: 'Hasta'                           ;;;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error de Fechas';NO;;FSYS-1
   Vehiculo1: "Vehiculo"                     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Radio1: 'Terc y Act|Todos|Dep.Pla|Cta.Cte';;;;NO;;;;;1;
   Check4: 'Imp.Detallado'                   ;;;;;;;;;;0;
FinDialogo

IF NOT OK
   Cancelar
ENDIF

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6,Dialogo.Vehiculo1~'|')
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')") )
   Else 
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*AgregarBMP(a1,Var('LOGO'),Var('ESCALOGO'))

ACT(a:3, 'SISTEMA DE COSTOS Y RENDIMIENTOS - OPERACIONES A TERMINO EN USD')
SetFont(a:fac..a:fac,3)

ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(c5, 'T/C Desde:')
ACT(c6, 'T/C Hasta:')
ACN(d5,CotizacionC('USD',,,,Dialogo.Fecha1,1,SI,'ARP'))
ACN(d6,CotizacionC('USD',,,,Dialogo.Fecha2,1,SI,'ARP'))
ACT(f5,'Dias: '~Fstr(Dialogo.Fecha2-Dialogo.Fecha1,1,0))

If NoVacio(VAL(ZZ6))
   ACT(h5,'Vehiculos: '~val(zz6))   
Else
   ACT(h5,'Vehiculos: Todos')   
EndIf


if Dialogo.Radio1=0
  ACT(k5, 'Terc y Act: Todos')
else
  if Dialogo.Radio1=1
    ACT(k5, 'Terc y Act: Dep.Plazo')
  else
    if Dialogo.Radio1=2
      ACT(k5, 'Terc y Act: Cta.CTe.Terceros')
    endif
  endif
endif


SetFont(a0..z7, 2)

SetFilaActual(9)
ACN(w1,FAC)

ACT(a:fac, 'Empresa')
ACT(b:fac, 'Tip.Op')
ACT(c:fac, 'Nro.Op')
ACT(d:fac, 'Entidad')
ACT(e:fac, 'Moneda')
ACT(f:fac, 'F.Concert.')
ACT(g:fac, 'F.Vto')
ACT(h:fac, 'V.Nominal')
ACT(i:fac, 'Cbio.Conc.')
ACT(j:fac, 'Cbio.Fin')
ACT(k:fac, 'Precio')
ACT(l:fac, 'Plazo')
ACT(m:fac, 'Dev.Ini.$')
ACT(n:fac, 'Dev.Ini.USD')
ACT(o:fac, 'Dias')
ACT(p:fac, 'Dias Acum')
ACT(q:fac, 'Dev.Fin $')
ACT(r:fac, 'Dev.Fin USD')
ACT(s:fac, 'Dev.USD')
ACT(t:fac, 'V.N. x DT')
ACT(u:fac, 'V.N. x P')


AlinearCeldas(h:FAC..u:FAC,'D')

SetFont(a:FAC..uu:FAC,2)
AgregarMarco(a:FAC..u:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

* Verificar si hubo operaciones de Deposito a plazo vigentes de terceros durante ese periodo
ACN(x1,0)

SQL.ADD("Select NrOperacion, FechaOp, FechaVto, Cantidad from "~DBO~".OPERACIONES ")
SQL.ADD(" where ")

if NoVacio(VAL(zz6))
   SQL.ADD("Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
Else 
   SQL.ADD("Vehiculo1=Vehiculo1  ")
Endif

SQL.ADD(" and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and FechaOp2 < '"~IdxDate(Dialogo.Fecha2)~"'    ")
SQL.ADD(" and Especie = 'USD' ")
*-- Para Todo o Deposito a Plazo
if Dialogo.Radio1=0 o Dialogo.Radio1=1
  SQL.ADD(" and TipoOp in ('MMCDIA','MMCDP','MMCP','MMO')")
endif
Recorrer SQL
 DFA
 ACN(x1,1)
 BorrarCeldas(x2..x2)
 * Dias Transcurridos x cada op
 if fbn('FechaVto') <= Dialogo.Fecha2
   if fbn('FechaOp') < Dialogo.Fecha1
     ACN(x2,DifDias(fbn('FechaVto'),Dialogo.Fecha1,'ARG',NO) ) 
   else
     ACN(x2,DifDias(fbn('FechaVto'),fbn('FechaOp'),'ARG',NO) ) 
   endif  
 else
   if fbn('FechaOp')< Dialogo.Fecha1
     ACN(x2,DifDias(Dialogo.Fecha2,Dialogo.Fecha1,'ARG',NO) ) 
    else 
     ACN(x2,DifDias(Dialogo.Fecha2,fbn('FechaOp'),'ARG',NO) ) 
   endif
 endif

 SCN(xx1,fbn('Cantidad')*Val(x2))
Proximo


if Val(x1)<>0
  * Capital Promedio depositos a plazo
  ACN(xx2,  Val(xx1) / (Dialogo.Fecha2 - Dialogo.Fecha1) )

  * buscar ops. fx a termino en dolares
  SQL.ADD("Select * from "~DBO~".OPERACIONES ")
  SQL.ADD(" where ")

  if NoVacio(VAL(zz6))
     SQL.ADD("Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
  Else 
     SQL.ADD("Vehiculo1=Vehiculo1  ")
  endif

  SQL.ADD(" and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
  SQL.ADD(" and FechaOp < '"~IdxDate(Dialogo.Fecha2)~"'    ")
  SQL.ADD(" and Especie = 'USD' ")
  *-- Para Todo o Deposito a Plazo
  if Dialogo.Radio1=0 o Dialogo.Radio1=1
    SQL.ADD(" and TipoOp = 'FXVT' ")
  endif

  Recorrer SQL
    ACT(a:fac, fbn('Vehiculo1'))
    ACT(b:fac, fbn('TipoOp'))
    ACT(c:fac, fbn('NrOperacion'))
    ACT(d:fac, fbn('Cliente1'))
    ACT(e:fac, fbn('Especie'))
    ACD(f:fac, fbn('FechaOp'))
    ACD(g:fac, fbn('FechaVto'))
    ACN(h:fac, fbn('Cantidad'))
    ACN(i:fac, CotizacionC(fbn('Especie'),,,,fbn('FechaOp'),1,SI,'ARP'))
    ACN(j:fac, CotizacionC(fbn('Especie'),,,,fbn('FechaVto'),1,SI,'ARP'))
    ACN(k:fac, fbn('Precio1'))
    ACN(l:fac, fbn('Plazo'))

    * devengado inicial $ y USD
    if Dialogo.Fecha1<=fbn('FechaOp')
      ACN(m:fac, fbn('Cantidad')*Val(i:fac))
      ACN(n:fac, Val(m:fac)/Val(i:fac))
    else
      ACN(m:fac, fbn('Cantidad')*(1+(fbn('Precio1')-Val(i:fac))*(Dialogo.Fecha1-fbn('FechaOp'))/fbn('Plazo')))
      ACN(n:fac, Val(m:fac)/Val(d5))
    endif

    * Dias Transcurridos y dias acumulados
    if fbn('FechaVto') <= Dialogo.Fecha2
      if fbn('FechaOp') < Dialogo.Fecha1
        ACN(o:fac,DifDias(fbn('FechaVto'),Dialogo.Fecha1,'ARG',NO) ) 
      else
        ACN(o:fac,DifDias(fbn('FechaVto'),fbn('FechaOp'),'ARG',NO) ) 
      endif  
      ACN(p:fac,fbn('Plazo'))
    else
      if fbn('FechaOp')< Dialogo.Fecha1
        ACN(o:fac,DifDias(Dialogo.Fecha2,Dialogo.Fecha1,'ARG',NO) ) 
       else 
        ACN(o:fac,DifDias(Dialogo.Fecha2,fbn('FechaOp'),'ARG',NO) ) 
      endif
      ACN(p:fac,DifDias(Dialogo.Fecha2,fbn('FechaOp'),'ARG',NO) )
    endif

    * Devengado final $
    ACN(q:fac,fbn('Cantidad')*(1+(fbn('Precio1')-Val(i:fac))*Val(p:fac)/fbn('Plazo')) )
    * Devengado final USD
    if fbn('FechaVto') <= Dialogo.Fecha2
      ACN(r:fac, Val(q:fac)/Val(j:fac))
    else
      ACN(r:fac, Val(q:fac)/Val(d6))
    endif

    * Devengado usd
    ACN(s:fac, Val(r:fac)-Val(n:fac))   

    ACN(t:fac, fbn('Cantidad')*Val(o:fac))
    ACN(u:fac, fbn('Cantidad')*fbn('Plazo'))

    SetFont(a:FAC..u:FAC,1)
  Proximo
  * Totales 
  ifa
  ACN(h:fac, Sum(h:Val(w1)..h:fac-1))
  ACN(s:fac, Sum(s:Val(w1)..s:fac-1))
  ACN(t:fac, Sum(t:Val(w1)..t:fac-1))
  ACN(u:fac, Sum(u:Val(w1)..u:fac-1))
  AgregarMarco(a:FAC..u:FAC,2,0,Exe('COLOR'))
  SetFont(a:fac..u:fac,2)
  FormatoCeldas(i:Val(w1)..k:fac,EXE('F7'))
  AlinearCeldas(h:Val(w1)..u:FAC,'D')

  * Total Devengado
  ACN(w2,fac+3)
  ACT(k:Val(w2),'Total Devengado')
  ACN(m:Val(w2), Val(s:fac))
  * Capital Promedio Depositos a plazo
  ACT(k:Val(w2)+1,'Cap. Prom. Dep. Plazo')
  ACN(m:Val(w2)+1, Val(xx2))
  * guardar para COREN
  ACN(x98,Val(m:Val(w2)+1))

  * Incremento en la tasa
  ACT(k:Val(w2)+2,'Incremento en la tasa')
  ACN(m:Val(w2)+2, Val(m:Val(w2))/Val(m:(Val(w2)+1))/(Dialogo.Fecha2-Dialogo.Fecha1)*36500 )
  * guardar para COREN
  ACN(x99,Val(m:Val(w2)+2))
  FormatoCeldas(m:Val(w2)+2..m:Val(w2)+2,EXE('F7'))
  * Capital Promedio
  ACT(k:Val(w2)+3,'Capital Promedio')
  ACN(m:Val(w2)+3, Val(t:fac)/(Dialogo.Fecha2-Dialogo.Fecha1))
  * Plazo Promedio
  ACT(k:Val(w2)+4,'Plazo Promedio')
  ACN(m:Val(w2)+4, Val(u:fac)/Val(h:fac))
  AgregarMarco(k:Val(w2)..l:Val(w2)+4,2,0,Exe('COLOR'))
  AgregarMarco(m:Val(w2)..m:Val(w2)+4,1)
  SetFont(a:Val(w2)..p:Val(w2)+4,2)
endif

SetFilaActual(fac+10)
ACT(a:fac, 'Fin del Listado')
SetFont(a:fac..a:fac,2)
Impresion(1,2)
LimitesVision(v:fac+2)

If Dialogo.Check4 = 1 
  ImprimirHoja(NO)
Endif 

