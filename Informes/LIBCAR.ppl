MostrarCuadroDeMensajes
CrearDialogo
   Fecha1:      'Fecha'                  ;;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCAR' "),1,'ARG',SI)
   Vehiculo1:   'Vehiculo'               ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar un Vehiculo';NO;VAR('VEHICULODE');;;;;  
   Radio1:      '|Provisorio|Definitivo' ;2;1;;;;;;;;0
   Radio2:      '|Manual|Evento'         ;;;;NO;NO;;;;;0
FinDialogo

If Not OK
   Cancelar
Endif

ACN(s:1, SQL("Select 1 From "~DBO~".FLAGSMERCADO Where Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and Registro = 'NCAR' "))
if Val(s:1)>0
  if Dialogo.Radio1=0
    MessageBox('El Libro de Cartera del '~Dialogo.Fecha1~' ya fue emitido.')
  else
    Cancelar('El Libro de Cartera del '~Dialogo.Fecha1~' ya fue emitido. Debe utlizar la reimpresion.')
  endif
endif

if Dialogo.Radio1=1
  ACD(t:1,Habiles(SQL("Select Max(Fecha) From "~DBO~".FLAGSMERCADO Where Registro = 'NCAR' "),1,'ARG',SI))
  if Val(t:1) > Fecha('2000/01/01')
  if Dialogo.Radio2=0
     if Val(t:1) >  Habiles(FSys,-1,'ARG',SI)
        Cancelar('LIBCAR - No hay fechas disponibles para impresión.')
     endif
  else
     if Val(t:1) >  Habiles(FSys,1,'ARG',SI)
        Cancelar('LIBCAR - No hay fechas disponibles para impresión.')
     endif
  endif
  if Val(t:1) <> 0  y Val(t:1) <> Dialogo.Fecha1
    Cancelar('LIBCAR - No se permite saltar fechas habiles.')
  endif
  Endif
endif

**---------------------------------------------**

ACN(u:1,0)

(.'AUXLIBCAR'.)
