ACT(Val(co1)+9:fac, 'Int a Recibir')
*if Val(in1)=1
 *  ACT(Val(co1)+9:fac, 'Discount Factors')
ACT(Val(co1)+10:fac, 'Int Resultante')
AgregarMarco(Val(co1)+10:fac,2,1,Exe('COLOR'))
*endif
AgregarMarco(a:fac..Val(co1)-1:fac,2,1,Exe('COLOR6'))
AgregarMarco(Val(co1)+1:fac..T:fac,2,1,Exe('COLOR6'))

AlinearCeldas(a:fac..u:fac,'C')
ACN(fi1,fac)
SetFont(a:fac..Val(co1)+10:fac,1)

SQL.ADD(" SELECT O.NrOperacion NrOperacion, O.Cuotas1,C.NrCuota, C.Cantidad6 as VNotional,O.FechaEx1 as NotionalDate, C.Total3 VSpread, C.Total4 CSpread, C.Cantidad3 InteresV, C.Cantidad4 InteresC, ")
SQL.ADD(" C.Fecha1 FInicioV, C.Fecha5 FInicioC, C.Plazo1, C.Plazo2, C.Fecha2 FFinV, C.Fecha6 FFinC, O.TipoTasa, O.TipoTasa2, ")
SQL.ADD(" C.Cantidad1 ResidualV, C.Precio1 TasaV, C.Precio2 TasaC, C.Cantidad2 ResidualC,C.Precio4 DiscFactor, C.Cantidad5 CNotional ")
if Incluido(Val(op1),'DTSFV|DTSFF|DTSVV|DTSFVV')
    SQL.ADD(" ,O.FechaPago ")
else
    SQL.ADD(" ,C.Fecha3 FechaPago ")
endif
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" WHERE O.NrOperacion = '"~Dialogo.NrOperacion1~"' AND O.NrOperacion = C.NrOperacion ")
Else
  SQL.ADD(" WHERE O.FechaOp > '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaOp < '"~IdxDate(Dialogo.Fecha2)~"' ")
  If Dialogo.Radio1 = 0
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND O.TipoOp = 'DTSFVM' ")  
  Else
    SQL.ADD(" AND O.TipoOp = 'DTSFFM' ")
  EndIf
EndIf
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
*If Dialogo.Radio1 = 0
*  SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
*EndIf

Recorrer SQL
   ACT(a:fac, FBN['NrOperacion'])
   ACLO(a:fac, FBN['NrOperacion'])
   ACN(b:fac, FBN['ResidualV'])
   ACN(c:fac, 0)
   ACD(d:fac, FBN['FInicioV'])
   ACN(e:fac, FBN['Plazo1'])
   ACD(f:fac, FBN['FFinV'])
   ACD(g:fac, FBN['FechaPago'])
   IF Vacio(fbn('TipoTasa'))
       ACT(h:fac, 'FIJA')
   ELSE
       ACT(h:fac, fbn('TipoTasa'))
   ENDIF
   ACN(i:fac, FBN['TasaV']+FBN['VSpread'])
   ACN(j:fac, FBN['InteresV'])
   SCN(J:fac, FBN['CNotional'] )
   *- Le sumo al NPV el V Notional en el periodo que corresponde al FechaEx1
   ***---IF FBN['NotionalDate']>VAL(c:fac) y FBN['NotionalDate']<=VAL(e:fac)
   ***---   SCN(h:fac, FBN['VNotional'] )
   ***---EndIf
   ACN(Val(co1)+1:fac, FBN['ResidualC'])
   ACN(Val(co1)+2:fac, 0)
   ACD(Val(co1)+3:fac, FBN['FInicioC'])
   ACN(Val(co1)+4:fac, FBN['Plazo2'])
   ACD(Val(co1)+5:fac, FBN['FFinC'])
   ACD(Val(co1)+6:fac, FBN['FFinC'])
   IF Vacio(fbn('TipoTasa2'))
       ACT(Val(CO:1)+7:fac, 'FIJA')
   ELSE
       ACT(Val(CO:1)+7:fac, fbn('TipoTasa2'))
   ENDIF
   ACN(Val(co1)+8:fac, FBN['TasaC']+FBN['CSpread'])
   ACN(Val(co1)+9:fac, FBN['InteresC'])
   SCN(Val(co1)+9:fac, FBN['VNotional'] )
   ***---If FBN['NrCuota']=FBN['Cuotas1']
      *- Ultima cuota, sumo el notional al interes de la contraparte
   ***---   SCN(Val(co1)+9:fac, FBN['VNotional'] )
   ***---EndIf

   If Dialogo.Radio1 = 0
       ACN(Val(co1)+10:fac, val(Val(co1)+9:fac) - val(j:fac))
       SCN(xx:2, Val(Val(co1)+10:fac))
   EndIf

   ***---ACN(Val(co1)+9:fac, FBN['DiscFactor'])
   ***---ACN(Val(co1)+10:fac, (val(Val(co1)+8:fac)-val(h:fac))*FBN['DiscFactor'])
   AlinearCeldas(a:fac..a:fac,'C')
   AlinearCeldas(h:fac..h:fac,'C')
   AlinearCeldas(r:fac..r:fac,'C')
Proximo

*- ck1 y ck2 para linkear mtm y p&l desde informe ppal
