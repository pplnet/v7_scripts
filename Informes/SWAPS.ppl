CrearDialogo
  NrOperacion1   : 'Operacion'           ;;;;;;;;;;;;;;IIF(Dialogo.Radio1=0," TipoOp Like 'DTSFVM' "," TipoOp Like 'DTSFFM' ");;;;;;;;
  Radio1         : "Tipo|Tasa|Moneda"    ;;;;;;;;;0
  Fecha1         : 'D. Fecha'            ;;;;;;;;;FSys
  Fecha2         : 'H. Fecha'            ;;;;;;;;;FSys
  Especie1       : 'Moneda'              ;;;;;Dialogo.Radio1 = 0;;;;Var('MONELOCA');;;;;" Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ";
FinDialogo

if not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,1)


***---PRIMERO HAGO UN SELECT PARA OBTENER LOS DATOS DEL ENCABEZADO ****
***---RB9 lo pongo en 0 (cero) para los Caps/Floor para que tome la parte del vehiculo como fija
***---y la de la contraparte como flotante.
SQL.ADD(" SELECT O.NrOperacion, O.Especie, CASE O.TipoOp WHEN 'DTCAP ' THEN  O.RB8 WHEN 'DTFLO ' THEN  O.RB8 ELSE  O.RB5 END RB5, ")
SQL.ADD(" O.RB8, CASE O.TipoOp WHEN  'DTCAP ' THEN 0 WHEN 'DTFLO ' THEN 0 ELSE  O.RB9 END RB9, ")
SQL.ADD(" CASE O.TipoOp WHEN  'DTCAP ' THEN O.Especie WHEN 'DTFLO ' THEN O.Especie ELSE  O.ContraEspecie END ContraEspecie, ")
SQL.ADD(" O.Vehiculo1, C.Fecha1, C.Fecha2, C.Plazo1, O.FechaOp, O.Cliente1, O.TipoOp ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
*SQL.ADD(" Order by 1, ")
If NoVacio(Dialogo.NrOperacion1)
  SQL.ADD(" WHERE O.NrOperacion='"~Dialogo.NrOperacion1~"' AND O.NrOperacion = C.NrOperacion ")
Else
  SQL.ADD(" WHERE O.FechaOp > '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaOp < '"~IdxDate(Dialogo.Fecha2)~"' ")
  If Dialogo.Radio1 = 0
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
    SQL.ADD(" AND O.TipoOp = 'DTSFVM' ")  
  Else
    SQL.ADD(" AND O.TipoOp = 'DTSFFM' ")
  EndIf
EndIf
SQL.ADD(" AND O.NrOperacion = C.NrOperacion ")
*If Dialogo.Radio1 = 0
*  SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
*EndIf

SetFilaActual(2)
ACN(nu1,0)
ACN(in1,0)
ACN(pl1,0)
Recorrer SQL
   if FBN['RB8']=0
      ACT(dc1,'Act Act')
   else
      if FBN['RB8']=1
         ACT(dc1,'Act 365 F')
      else
         if FBN['RB8']=2
            ACT(dc1,'Act 360')
         else
            if FBN['RB8']=3
               ACT(dc1,'360 360')
            else
               if FBN['RB8']=4
                  ACT(dc1,'30E 360')
               endif
            endif
         endif
      endif
   endif

   if FBN['RB5']=0
      ACT(dc2,'Act Act')
   else
      if FBN['RB5']=1
         ACT(dc2,'Act 365 F')
      else
         if FBN['RB5']=2
            ACT(dc2,'Act 360')
         else
            if FBN['RB5']=3
               ACT(dc2,'360 360')
            else
               if FBN['RB5']=4
                  ACT(dc2,'30E 360')
               endif
            endif
         endif
      endif
   endif

   SCN(nu1,1)
   SCN(pl1, FBN['Plazo1'])
   ACN(LG:1, Longitud(fbn('Especie')))
   if Val(nu1)=1
      if EqStr(Copy(FBN['Especie'], 1, Val(LG:1)), Copy(FBN['ContraEspecie'], 1, Val(LG:1)))
          *** Es un swap de tasa de interes o Caps
          ACT(tx1,'TASA DE INTERES')
          ACN(in1,1)
      else
          ACT(tx1,'TIPO DE CAMBIO')
      endif
      IF Eqstr(Copy(fbn('TipoOp'), 1, 5), 'DTSFF')
          ACT(TX:2,'FIJA')
          ACT(TX:3,'FIJA')
      ELSE
          ** Veo como paga el Vehiculo
          if FBN['RB9']=1
              ACT(tx2,'FLOTANTE')
              ACT(tx3,'FIJA')
          else
              ACT(tx2,'FIJA')
              ACT(tx3,'FLOTANTE')
          endif       
      ENDIF
*      ACT(a:fac, 'SWAP DE '~IIF(EqStr(Copy(FBN['Especie'], 1, Val(LG:1)),Copy(FBN['ContraEspecie'], 1, Val(LG:1))),'TASA','MONEDA'))
      ACT(a:fac, 'SWAP DE '~IIF(Dialogo.Radio1=0, 'TASA', 'MONEDA'))
      SetFont(a:fac,3)
If NoVacio(Dialogo.NrOperacion1)
  ACT(a:FAC+2, 'NrOperacion: '~Dialogo.NrOperacion1)
Else
  ACT(a:FAC+2, 'NrOperacion: Todas')
EndIf
If Vacio(Dialogo.NrOperacion1)
  ACT(a:fac+3, 'Desde: '~Dialogo.Fecha1)
  ACT(a:fac+4, 'Hasta: '~Dialogo.Fecha2)
  If Dialogo.Radio1 = 0
    ACT(a:fac+5, 'Moneda: '~Dialogo.Especie1)
  EndIf
EndIf

*      ACT(a:fac,   'MinutaNro: ')
      ACT(xx:1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Fbn['Vehiculo1']))
*      
*      ACT(b:5, fbn['NrOperacion'])
*      ACLO(b:5, fbn['NrOperacion'])
*      ACT(a:fac+1, 'Portafolio: '~FBN['Vehiculo1'])
*      ACT(a:fac+5, 'Fecha de Concertacion: '~FBN['FechaOp'])
*      ACT(a:fac+6, 'Calculo de interes:        Vehiculo: '~Val(dc1))
*      ACT(a:fac+7, '                                    Contraparte: '~Val(dc2))
*      ACT(a:fac+8, 'Contraparte: '~FBN['Cliente1'])
      ACT(mo1, FBN['Especie'])
      ACT(mo2, FBN['ContraEspecie'])
   endif
*   ACT(a:fac+3, 'Fecha Vto: '~FBN['Fecha2'])
*   ACT(a:fac+4, 'Plazo de op: '~FStr(Val(pl1),0,0)~' dias')
   ACT(op1, FBN['TipoOp'] )
   dfa

Proximo


SetFont(a:fac..a:fac+9,1)

** Si el SELECT es vacio no muestro el informe
if Val(nu1)=0
  Messagebox('No dispone de detalle')
  Cancelar
endif

SetFilaActual(fac+8)
ACT(d:fac, val(xx:1)~' PAGA/ PARTE '~Val(tx2))
ACT(e:fac+1, '   ('~Val(mo1)~')')
ACT(n:fac, val(xx:1)~' RECIBE/ PARTE '~Val(tx3))
ACT(o:fac+1, '   ('~Val(mo2)~')')
SetFont(b:fac..n:fac+1,1)


**** EMPIEZO A IMPRIMIR COLUMNAS Y DATOS SOLICITADOS ****

SetFilaActual(fac+3)
ACN(zz:1, fac)
ACT(a:fac, 'Nr. Operación')
ACT(b:fac, 'Cap. Res.')
