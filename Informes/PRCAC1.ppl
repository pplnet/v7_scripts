HojaVisible(SI)

CrearDialogo
   Vehiculo1 : 'Vehiculo'        ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo' ;NO;var('VEHICULODE')
   Especie1  : 'Especie'         ;;;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;'USD'
   Fecha1    : 'Desde Fecha'     ;;;;SI;;;;NO;
   Fecha2    : 'Hasta Fecha'     ;;;;  ;;;;NO;;
   Lista1    : "CtaCorresponsal" ;; ;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE  Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' ORDER BY Codigo ");
   Entero1   : 'Nrotipo'         ;;;;;;NoVacio(Dialogo.Entero1);'Debe ingresar un Nro Tipo';NO;
FinDialogo 
MostrarCuadroDeMensajes

If not Ok
  Cancelar
Endif

ACN(aa1, 8)
ACN(aa2, 30)
ACN(aa3, 5)

CrearFont(1, 'Arial,8,B' )
CrearFont(2, 'Arial,8,'  )
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,10,' )
CrearFont(5, 'Arial,12,B')

If NoVacio(Dialogo.Lista1)
   ACT(li:1,Pipe2comillas(Dialogo.Lista1))
Else
   ACT(li:1,Pipe2Comillas(SQLSet("SELECT CODIGO FROM "~DBO~".CUENTAS WHERE  Estado='HAB' and Cliente='"~Dialogo.Vehiculo1~"' ORDER BY Codigo ")))
EndIf

*message(val(li:1))

ACN(aa:5, DifDias(Dialogo.Fecha1, Dialogo.Fecha2,'ARG', SI)+1)

ACN(ab:1, 2)

SetFilaActual(11)


**************************************************
***** Ajustes No Operativos
**************************************************

If Dialogo.Entero1 = 102 

    (.'QRYAJUSTEN'.)
    
    watch(SQL.BATCH())
    Recorrer SQL
        ACT(a:fac, fbn['NrOperacion'])
        ACLT(a:fac, fbn['NrOperacion'])
        ACT(b:fac, fbn['Cliente']~' - '~FBN['RazonSocial'])
        ACD(c:fac, fbn['FechaOp'])
        ACT(d:fac, fbn['Leyenda'])
        ACT(e:fac, fbn['Especie']~' - '~FBN['Nombre'])
        ACN(f:fac, fbn['Cantidad'])
        ACN(g:fac, fbn['Cantidad'])
        ACT(h:fac, fbn['Cuenta'])
        ACT(i:fac, fbn['Mercado'])
        SCN(xx:1,  fbn['Cantidad'])
    Proximo

    ACN(g:fac+2, val(xx:1))


EndIf

