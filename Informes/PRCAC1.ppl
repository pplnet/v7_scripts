SetFont(k:12..k:fac, 2)
SetFont(l:12..l:fac, 2)
SetFont(m:12..m:fac, 2)
SetFont(n:12..n:fac, 2)

SetPrintFit(3,90)

LimitesVision(n:fac+3)
