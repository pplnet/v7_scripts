**************************************************
***** Fallas del dia | Diferimientos de ArgenClear
**************************************************

If Dialogo.Entero1 = 115 

    ACT(B:9, 'Fallas')

    (.'QRYFALLACC'.)
watch(SQL.BATCH())
    Recorrer SQL
        ACT(a:fac, fbn['NrOperacion'])
        ACLO(a:fac, fbn['NrOperacion'])
        ACT(b:fac, fbn['Cliente']~' - '~FBN['RazonSocial'])
        ACD(c:fac, fbn['FechaMov'])
        ACD(d:fac, fbn['FechaOp'])
        ACD(e:fac, fbn['FechaVto'])
        ACT(f:fac, fbn['Especie']~' - '~FBN['Nombre'])
        ACN(g:fac, fbn['CantOpe'])
        ACN(h:fac, fbn['Precio1'])
        ACN(i:fac, fbn['TotalBrutoCli1'])

        If Vacio(fbn['Cantidad3'])
           If Incluido(fbn['TipoTr2'], 'RET|MATCH')
            ACN(j:fac, fbn['Cantidad1'] * -1)
            SCN(xx:1,  fbn['Cantidad1'])             
           Else
            ACN(j:fac, fbn['Cantidad1'])
            SCN(xx:1,  fbn['Cantidad1'])
           Endif
        Else
           ACN(j:fac, fbn['Cantidad3'])
           SCN(xx:1,  fbn['Cantidad3'])
        Endif 
        ACT(k:fac, fbn['Cuenta'])
        ACT(l:fac, fbn['Mercado'])
       
    Proximo

    SCN(AA101, -Val(AA115) )
    
    (.'QRYARGENCC'.)
watch(SQL.BATCH())

    Recorrer SQL
        ACT(a:fac, fbn['NrOperacion'])
        ACLO(a:fac, fbn['NrOperacion'])
        ACT(b:fac, fbn['Cliente']~' - '~FBN['RazonSocial'])
        ACD(c:fac, fbn['FechaMov'])
        ACD(d:fac, fbn['FechaOp'])
        ACD(e:fac, fbn['FechaVto'])
        ACT(f:fac, fbn['Especie']~' - '~FBN['Nombre'])
        ACN(g:fac, fbn['CantOpe'])
        ACN(h:fac, fbn['Precio1'])
        ACN(i:fac, fbn['TotalBrutoCli1'])
        ACN(j:fac, fbn['Cantidad'])
        ACT(k:fac, fbn['Cuenta'])
        ACT(l:fac, fbn['Mercado'])
        SCN(xx:1,  fbn['Cantidad'])
    Proximo
    
    ACN(j:fac+2, val(xx:1))

EndIf

**************************************************
*** Pago de Cupones | Intereses de Call de títulos -> Otros
**************************************************

If Dialogo.Entero1 = 116

    ACT(B:9, 'Otros')

    (.'QRYPAGOCCC'.)
    

    Recorrer SQL
        ACT(a:fac, fbn['NrOperacion'])
        ACLT(a:fac, fbn['NrOperacion'])
        ACT(b:fac, fbn['Cliente']~' - '~FBN['RazonSocial'])
        ACD(c:fac, fbn['FechaOp'])
        ACT(d:fac, fbn['Leyenda'])
        ACT(e:fac, fbn['Especie']~' - '~FBN['Nombre'])
        ACN(f:fac, fbn['Cantidad'])
        ACN(g:fac, fbn['Cantidad'])
        ACT(h:fac, fbn['Cuenta'])
        ACT(i:fac, fbn['Mercado'])
        SCN(xx:1,  fbn['Cantidad'])
    Proximo

    (.'QRYINTERCC'.)

    Recorrer SQL
        ACT(a:fac, fbn['NrOperacion'])
        ACLO(a:fac, fbn['NrOperacion'])
        ACT(b:fac, fbn['Cliente']~' - '~FBN['RazonSocial'])
        ACD(c:fac, fbn['FechaVto'])
** FJL 05/07/22 - Las columnas con coinciden con los titulos. Igualo a query anterior
*        ACD(d:fac, fbn['FechaOp'])
*        ACD(e:fac, fbn['FechaVto'])
*        ACT(f:fac, fbn['Especie']~' - '~FBN['Nombre'])
*        ACN(g:fac, fbn['CantOpe'])
*        ACN(h:fac, fbn['Precio1'])
*        ACN(i:fac, fbn['TotalBrutoCli1'])
*        ACN(j:fac, fbn['Cantidad'])
*        ACT(k:fac, fbn['Cuenta'])
*        ACT(l:fac, fbn['Mercado'])

        ACT(d:fac, 'Intereses en Moneda '~fbn['TipoOp'])
        ACT(e:fac, fbn['Especie']~' - '~FBN['Nombre'])
        ACN(f:fac, fbn['Cantidad'])
        ACN(g:fac, fbn['Cantidad'])
        ACT(h:fac, fbn['Cuenta'])
        ACT(i:fac, fbn['Mercado2'])

        SCN(xx:1,  fbn['Cantidad'])
    Proximo
    
    ACN(g:fac+2, val(xx:1))

EndIf

