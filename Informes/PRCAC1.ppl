    SetFont(a:11..i:11, 3)
    FormatoCeldas(f:12..g:fac+2,Exe('F2'))
  Endif
Endif

SetFont(a:12..a:fac, 2)
SetFont(b:12..b:fac, 2)
SetFont(c:12..c:fac, 2)
