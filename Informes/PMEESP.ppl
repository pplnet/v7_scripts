CrearDialogo
   Lista1  :      'Especies'   ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES Where Jerarquia LIKE '"~Var('JERTITULOS')~"%' and Cotiza is Not Null and Cotiza <> '' ")  
FinDialogo

If Not Ok
   Cancelar 
EndIf


AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')
ACT(d2, 'PME - Estado de Especies al '~VAR('FECHASYS'))
SetFont(d2,3)
AlinearCeldas(d2, 'D')
If NoVacio(Dialogo.Lista1)
   ACT(a4, 'Especies: '~Dialogo.Lista1)
Else
   ACT(a4, 'Especies: Todas')   
Endif
SetFont(a4,1)
SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC, 'Codigo')
ACT(b:FAC, 'Nomb. Extendido')
ACT(c:FAC, 'ISIN')
ACT(d:FAC, 'Bloomberg')
ACT(e:FAC, 'Estado PME')

AgregarMarco(a:FAC..e:FAC,2,0,Exe('COLOR'))


SQL.ADD("SELECT Codigo, Extendido, ISIN, EstadoOperativo, Codigo2 Bloomberg ")
SQL.ADD("FROM   "~DBO~".ESPECIES")
SQL.ADD("  Where Jerarquia LIKE '"~Var('JERTITULOS')~"%' and Cotiza is Not Null and Cotiza <> '' ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and  Codigo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif

Recorrer SQL
    SCN(w2,1)
    ACT(a:fac, FBN('Codigo'))
    *ACT(b:fac, Copy(FBN('Extendido'),1,27))
    ACT(b:fac, FBN('Extendido'))
    ACT(c:fac, FBN('ISIN'))
    ACT(d:fac, FBN('Bloomberg'))
    if EqStr(FBN('EstadoOperativo'),'SI')
       ACT(e:fac, 'Sancionada')
    Else
       if EqStr(FBN('EstadoOperativo'),'NO')
          ACT(e:fac, 'No Sancionada')
       Else
          ACT(e:fac, 'No Informada')
       Endif
    Endif
Proximo


*SetFont(a:Val(w1)..e:Val(w1)+2,3)
*SetFont(a:Val(w1)+3..e:FAC,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(1, 5)
ACO(2, 40)
ACO(3, 10)
ACO(4, 10)
ACO(5, 10)


SetMargins(0,0,0,2)
Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,1)

LimitesVision(f:fac)
RangoTitulo(a:1..e:fac, Val(w1)+2)
SetPrintFit(3,60)

