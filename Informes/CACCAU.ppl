ModoReproceso(SinDialogo)
HojaVisible(SI)
CrearDialogo
  NrOperacion1: 'Operacion'   ;;;;;;;;;;
FinDialogo

if Not OK
  Cancelar
endif


CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(3,"Arial,10,U")
CrearFont(4,"Arial,8,B")

SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo, O.FechaVto, O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Especie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACT(zf:99, fbn['Cuenta1'])
   ACT(zg:99, fbn['Vehiculo1'])
   ACT(zh:99, fbn['Plazo'])
   ACD(zi:99, fbn['FechaVto'])
   ACT(zj:99, PYC(fbn['Precio1'],1,2))
   ACD(zm:99, fbn['FechaOp'])
Proximo

If Not EqStr(val(za:99), 'MMCAUA') 
    Cancelar
Endif

SetFilaActual(10)
ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zb:99))~', '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~'.')

SetFilaActual(fac+3)
ACT(a:fac,'Señores')
SetFont(a:10..a:fac,1)

SetFilaActual(fac+1)
ACT(a:fac,BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)))
SetFont(a:fac,2)

SetFilaActual(fac+1)
ACT(a:fac,'Presente')
SetFont(a:fac,3)

SetFilaActual(fac+3)
acn(zz:99,fac)
ACT(a:fac,'De nuestra consideraci'~Chr(243)~'n:')

SetFilaActual(fac+2)
ACT(a:fac,'Por medio de la presente, confirmamos a Uds. la constituci'~Chr(243)~'n de una Cauci'~Chr(243)~'n con las')
SetFilaActual(fac+1)
ACT(a:fac,'siguientes condiciones:')

SetFont(a:val(zz:99)..a:fac,1)

SetFilaActual(fac+2)
acn(zz:99, fac)
ACT(a:fac,'Monto total: '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.-')
SetFilaActual(fac+1)
ACT(a:fac,'Plazo: '~val(zh:99)~IIF(num(val(zh:99))>1,' d'~Chr(237)~'as',' d'~Chr(237)~'a') )
SetFilaActual(fac+1)
ACT(a:fac,'Vencimiento: '~val(zi:99))
SetFilaActual(fac+1)
ACT(a:fac,'T.N.A.: '~val(zj:99)~'%')
SetFont(a:val(zz:99)..a:fac,2)



acn(zz:99, fac)
SetFilaActual(fac+2)
ACT(a:fac,'Autorizamos a Uds. a debitar la suma de '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.- de nuestra cuenta en '~BuscarCampo('ESPECIES','Nombre','Codigo',val(zc:99)) ) 
SetFilaActual(fac+1)
ACT(a:fac,'Nro.: '~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99))~', Depositante '~BuscarCampo('CLIENTES','CodComitente','Codigo',val(zb:99))~' para la constituci'~Chr(243)~'n de dicha Cauci'~Chr(243)~'n.')

SetFilaActual(fac+2)
ACT(a:Fac,'Sin otro particular, saludamos a Uds. muy atte.')
SetFont(a:val(zz:99)..a:fac,1)

