MostrarCuadroDeMensajes
CrearDialogo
   Fecha1:    'D.FechaLiq' ;;;;;;;;;fsys
   Fecha2:    'H.FechaLiq' ;;;;;;;;;fsys
   Vehiculo1: 'Vehiculo';;;;;;;;;VAR('VEHICULODE')
   Check1: 'Imp.T.General' ;;;;;;;;;1
FinDialogo

If Not OK
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,BU")
CrearFont(4,"Arial,10,BI")

ACT(e:2, 'LIBRO   CAJA')
SetFont(e:2, 3)
AlinearCeldas(e:2, 'D')

SetFilaActual(4)
ACT(a:fac,   'Numero de')
ACT(a:fac+1, 'Boleto FPA')
ACT(b:fac,   'Numero de')
ACT(b:fac+1, 'Boleto MAE')
*ACT(c:fac,   'Cliente /')
*ACT(c:fac+1, 'Contraparte')
ACT(d:fac,   'Razon Social')
ACT(d:fac+1, 'Cliente/Contraparte')
ACT(e:fac,   'Tipo de')
ACT(e:fac+1, 'Operacion')
ACT(g:fac,   'Forma de Liquidacion ')
ACT(f:fac+1, 'Banco')
ACT(g:fac+1, 'Cuenta')
ACT(h:fac+1, 'Forma de Pago')
ACT(I:fac,   'Tipo de ')
ACT(I:fac+1, 'Moneda')
ACT(j:fac,   'Monto')
ACT(k:fac,   'Tipo de')
ACT(k:fac+1, 'Cambio')
ACT(l:fac,   'Importe')
ACT(l:fac+1, 'Pesos')
SetFont(a:fac..z:fac+1,2)

AgregarMarco(a:fac..l:fac+1,0,0,EXE('COLOR6'))
*AgregarMarco(a:fac..e:fac+1,0,2,EXE('COLOR6'))
*AgregarMarco(f:fac..h:fac,0,0,EXE('COLOR6'))
*AgregarMarco(f:fac+1..h:fac+1,0,2,EXE('COLOR6'))
*AgregarMarco(i:fac..L:fac+1,0,2,EXE('COLOR6'))
AlinearCeldas(a:fac..L:fac+1, 'C')
ifa

SQL.ADD(" SELECT DISTINCT T.Fecha5 FechaMov, O.NrOperacion, O.NrBoleto, O.Cliente1, C.RazonSocial, O.TipoOp, T.Mercado1, ")
SQL.ADD(" T.Cuenta1, T.Cuenta2, O.ContraEspecie, M.Cantidad, O.TotalCaucion, O.PaseCB, CU.Numero, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1 ")
*-I
*SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, ")
*SQL.ADD(" "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS CU, "~DBO~".TIPOSOPERACION TP ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T LEFT OUTER JOIN "~DBO~".CUENTAS CU ON   T.Cuenta2    = CU.Codigo , ")
SQL.ADD(" "~DBO~".MOVEJECUTADOS M , "~DBO~".TIPOSOPERACION TP ")

*F
SQL.ADD(" WHERE  O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND    M.NrTrans2    = T.NrTrans     ")
SQL.ADD(" AND    O.Cliente1    = C.Codigo      ")
*-I
*SQL.ADD(" AND    T.Cuenta2    *= CU.Codigo     ")
*-F
SQL.ADD(" AND    O.TipoOp      = TP.Codigo     ")
SQL.ADD(" AND    T.RB6         = '1'           ")
SQL.ADD(" AND    O.ContraEspecie = M.Especie   ")
SQL.ADD(" AND    T.Fecha5 >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha5 <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" UNION ")
SQL.ADD(" SELECT DISTINCT M.FechaMov, T.NrTrans NrOperacion, ' ' NrBoleto, M.Cliente Cliente1, C.RazonSocial, T.TipoTr2 TipoOp, M.Mercado Mercado1, ")
SQL.ADD(" M.Cuenta Cuenta1, ' ' Cuenta2, M.Especie ContraEspecie, M.Cantidad, 0 TotalCaucion, '0' PaseCB, CU.Numero, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1 ")
*-i
*SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T , "~DBO~".MOVEJECUTADOS M LEFT OUTER JOIN "~DBO~".CUENTAS CU ON  M.Cuenta   = CU.Codigo, ")
SQL.ADD(" "~DBO~".ESPECIES E,"~DBO~".TIPOSTRANSACCION2 TP ")
*SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".CUENTAS CU, "~DBO~".TIPOSTRANSACCION2 TP ")
*-F
SQL.ADD(" WHERE  M.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND    M.Cliente  = C.Codigo      ")
SQL.ADD(" AND    M.Especie  = E.Codigo      ")
*-i
*SQL.ADD(" AND    M.Cuenta   *= CU.Codigo    ")
*-f
SQL.ADD(" AND    T.TipoTr2  = TP.Codigo     ")
SQL.ADD(" AND    E.Tipo     = 'MON'         ")
SQL.ADD(" AND    T.TipoTr2  = 'LCUPON'      ")
SQL.ADD(" AND    M.NrSaldo  IN (5,4)        ")
SQL.ADD(" AND    C.Alias1   = 'CP'          ")
SQL.ADD(" AND    M.FechaMov >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" UNION ")
SQL.ADD(" SELECT DISTINCT M.FechaMov, T.NrTrans NrOperacion, ' ' NrBoleto, M.Cliente Cliente1, C.RazonSocial, T.TipoTr2 TipoOp, M.Mercado Mercado1, ")
SQL.ADD(" M.Cuenta Cuenta1, ' ' Cuenta2, M.Especie ContraEspecie, M.Cantidad, 0 TotalCaucion, '0' PaseCB, CU.Numero, ")
SQL.ADD(" CU.Comitente, M.Leyenda, TP.Nombre, M.NrSaldo, M.NrGrupo, T.Ley5, T.Vehiculo1 ")
*-i
*SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, ")
*SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".CUENTAS CU, "~DBO~".TIPOSTRANSACCION2 TP ")
SQL.ADD(" FROM "~DBO~".CLIENTES C, "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M LEFT OUTER JOIN "~DBO~".CUENTAS CU ON  M.Cuenta   = CU.Codigo  , ")
SQL.ADD(" "~DBO~".ESPECIES E, "~DBO~".TIPOSTRANSACCION2 TP ")
*-f
SQL.ADD(" WHERE  M.NrOperacion  = T.NrTrans ")
SQL.ADD(" AND    M.Cliente  = C.Codigo      ")
SQL.ADD(" AND    M.Especie  = E.Codigo      ")
*-i
*SQL.ADD(" AND    M.Cuenta   *= CU.Codigo    ")
*-f
SQL.ADD(" AND    T.TipoTr2  = TP.Codigo     ")
SQL.ADD(" AND    E.Tipo     = 'MON'         ")
SQL.ADD(" AND    T.TipoTr2  = 'LCUPON'      ")
SQL.ADD(" AND    M.NrSaldo  IN (5,4)        ")
SQL.ADD(" AND    M.Cliente  <> T.Vehiculo1  ")
SQL.ADD(" AND    M.FechaMov >= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.FechaMov <= "~idxdate2(Dialogo.Fecha2)~" ")
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" ORDER BY 1,2 ")

ACD(fe:1, 0)
ACN(me:1, 100)
ACN(zz:1, 0)
ACN(zz:2, 0)

Recorrer SQL
   ACN(zz:2, 0)
   If Val(fe:1)<>fbn('FechaMov')
      message('Fecha: '~fbn('FechaMov'))
      If Val(fe:1)<>0
         ACT(e:fac, 'Total '~Val(fe:1)~' --> ')
         ACN(l:fac, Val(fe:2))
         ACN(fe:2, 0)
         SetFont(a:fac..z:fac,2)
         AgregarMarco(a:fac..l:fac,0,0)
         FormatoCeldas(l:fac, EXE('F2'))
         ifa
         If Val(me:1)<>mes(fbn('FechaMov'))
            ifa
            ACT(e:fac, 'Total '~Meses(Val(me:1))~' --> ')
            ACN(l:fac, Val(me:2))
            ACN(me:2, 0)
            SetFont(a:fac..z:fac,2)
            AgregarMarco(a:fac..l:fac,0,0,EXE('COLOR8'))
            FormatoCeldas(l:fac, EXE('F2'))
            ifa
            ifa
         Endif
         ifa
      Endif
   Endif

   ACT(a:fac, fbn('NrOperacion'))
   Message(Val(a:fac))
   If Not Eqstr(fbn('TipoOp'),'LCUPON')
      ACLO(a:fac, fbn('NrOperacion'))
   Else
      ACLT(a:fac, fbn('NrOperacion'))
   Endif
   ACT(b:fac, fbn('NrBoleto'))
*   ACT(c:fac, fbn('Cliente1'))
   ACT(d:fac,Copy(FBN['RazonSocial'],1,30))
   ACT(e:fac, fbn('TipoOp')~' - '~fbn('Nombre'))

   If Eqstr(fbn('TipoOp'), 'LCUPON') 
      IF fbn('NrGrupo')=41
         ACT(e:fac, Val(e:fac)~' - Comision '~VAR('VEHICULODE'))
      Endif
      If fbn('NrGrupo')=42
         ACT(e:fac, Val(e:fac)~' - IVA Com. '~VAR('VEHICULODE'))
      Endif
      If fbn('NrGrupo')=51
         ACT(e:fac, Val(e:fac)~' - Comision CV')
      Endif
   Else
      ACT(e:fac, Val(e:fac)~' - '~fbn('Leyenda'))
   Endif

   If Not Incluido(fbn('Mercado1'),'AC|EU|CE')
*      ACT(f:fac, fbn('Comitente'))
      ACT(f:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Comitente')))
      ACT(g:fac, fbn('Numero'))
      If Novacio(fbn('Ley5'))
         ACT(h:fac, 'Cheque: '~fbn('Ley5'))
      Else
         ACT(h:fac, 'Trf. Bancaria')
      Endif
   Else
      If Incluido(fbn('Mercado1'),'AC')
         ACT(f:fac, 'Neteo Argenclear')
      Endif
      If Incluido(fbn('Mercado1'),'EU')
         ACT(f:fac, 'Neteo Euroclear')
      Endif
      If Incluido(fbn('Mercado1'),'CE')
         ACT(f:fac, 'Neteo Cedel')
      Endif
   Endif

   ACT(i:fac,  fbn('ContraEspecie'))
   If Not Eqstr(fbn('TipoOp'), 'LCUPON') o fbn('NrSaldo')=4 
      * Estas comisiones las paga el vehiculo
      ACN(j:fac,  -fbn('Cantidad'))

      If Eqstr(fbn('TipoOp'), 'LCUPON') y fbn('NrSaldo')=4 y Not Eqstr(fbn('Cliente1'),fbn('Vehiculo1'))
      * Estas comisiones las cobra el vehiculo
         ACN(j:fac,  fbn('Cantidad'))
      Endif
   Endif

   If Eqstr(fbn('ContraEspecie'),VAR('MONELOCA'))
      ACN(k:fac, 1)
   Else
      ACN(k:fac, CotizacionBNA(fbn('ContraEspecie'),fbn('FechaMov')-1,2,SI,SI) )
   Endif
   ACN(l:fac, Val(j:fac)*Val(k:fac))

   If Eqstr(fbn('TipoOp'), 'LCUPON') y fbn('NrSaldo')=5
      SQL.ADD(" SELECT T.Precio1, T.Precio2, T.Precio3, M.NrGrupo2     ")
      SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
      SQL.ADD(" WHERE T.NrTrans = M.NrOperacion ")
      SQL.ADD(" AND   M.Cliente = '"~fbn('Cliente1')~"' ")
      SQL.ADD(" AND   T.NrTrans = '"~fbn('NrOperacion')~"' ")
      Recorrer SQL
         dfa
         * AMORT
         ACN(pr:1, fbn('Precio1'))
         * RENTA  
         ACN(pr:2, fbn('Precio2'))
         * INT CAPITALIZ.
         ACN(pr:3, fbn('Precio3'))
         ACN(ng:2, fbn('NrGrupo2'))
         Break
      Proximo
      If Val(pr:1)<>0
         ACT(e:fac, Val(e:fac)~' - Renta')
         ACN(j:fac,  Val(ng:2)*Val(pr:1)/100)
         ACN(l:fac, Val(j:fac)*Val(k:fac))
         SetFont(a:fac..z:fac,1)
         FormatoCeldas(j:fac, EXE('F2'))
         FormatoCeldas(k:fac, EXE('F9'))
         FormatoCeldas(l:fac, EXE('F2'))
         AlinearCeldas(i:fac..i:fac, 'C')
      Endif
      If Val(pr:2)<>0 o Val(pr:3)<>0
         If Val(pr:1)<>0
            ifa
            ACN(zz:2, 1)
            ACT(a:fac, Val(a:fac-1))
            ACLT(a:fac, Val(a:fac-1))
            ACT(b:fac, Val(b:fac-1))
*            ACT(c:fac, Val(c:fac-1))
            ACT(d:fac, Val(d:fac-1))
            ACT(e:fac, fbn('TipoOp')~' - '~fbn('Nombre'))
            ACT(f:fac, Val(f:fac-1))
            ACT(g:fac, Val(g:fac-1))
            ACT(h:fac, Val(h:fac-1))
            ACT(i:fac, Val(i:fac-1))
            ACN(k:fac, Val(k:fac-1))
         Endif
         ACT(e:fac, Val(e:fac)~' - Amortizacion')
         ACN(j:fac,  Val(ng:2)*(Val(pr:2)+Val(pr:3))/100)
         ACN(l:fac, Val(j:fac)*Val(k:fac))
      Endif
   Endif

   SetFont(a:fac..z:fac,1)
   AlinearCeldas(i:fac..i:fac, 'C')
   FormatoCeldas(j:fac, EXE('F2'))
   FormatoCeldas(k:fac, EXE('F9'))
   FormatoCeldas(l:fac, EXE('F2'))

   If Val(zz:2)=1
      SCN(fe:2, Val(l:fac-1))
      SCN(me:2, Val(l:fac-1))
      SCN(tg:1, Val(l:fac-1))
   Endif

   SCN(fe:2, Val(l:fac))
   SCN(me:2, Val(l:fac))
   SCN(tg:1, Val(l:fac))
   ACD(fe:1, fbn('FechaMov'))
   ACN(me:1, Mes(fbn('FechaMov')))
   ACN(zz:1, 1)
Proximo

If Val(zz:1)<>0
   ifa
   ifa
   ACT(e:fac, 'Total '~Val(fe:1)~' --> ')
   ACN(l:fac, Val(fe:2))
   SetFont(a:fac..z:fac,2)
   AgregarMarco(a:fac..l:fac,0,0)
   FormatoCeldas(l:fac, EXE('F2'))
   ifa
   ifa
   ACT(e:fac, 'Total '~Meses(Val(me:1))~' --> ')
   ACN(l:fac, Val(me:2))
   SetFont(a:fac..z:fac,2)
   AgregarMarco(a:fac..l:fac,0,0,EXE('COLOR8'))
   FormatoCeldas(l:fac, EXE('F2'))
Endif
ifa

If Dialogo.Check1=1
   ifa
   ACT(e:fac, 'Total General del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2~' --> ')
   ACN(l:fac, Val(tg:1))
   SetFont(a:fac..z:fac,4)
   AgregarMarco(a:fac..l:fac,0,0,EXE('COLOR6'))
   FormatoCeldas(l:fac, EXE('F2'))
   ifa
Endif

ACO(1,8)
ACO(2,8)
*ACO(3,8)
ACO(3,1)
ACO(4,15)
ACO(5,35)
ACO(6,15)
ACO(7,9)
ACO(8,9)
ACO(9,7)
ACO(10,10)
ACO(11,8)
ACO(12,10)
ACO(13,15)

LimitesVision(L:FAC)
iMPRESION(1,2)
iMPRESION(4,1)
SetPrintFit(3,70)
RangoTitulo(a:1..l:fac, 5)
