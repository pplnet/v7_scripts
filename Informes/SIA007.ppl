HojaVisible(SI)

ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:   "F.Acred.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2:   "F.Acred.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys

  Lista2:   'Bancos Datanet'     ;  ; ;;;;;;;;;SQLSet(" Select Distinct Banco   From "~DBO~".MOVDATANET ");
*  Lista4:   'Conceptos'          ;-3;2;;;;;;;;;SQLSet(" Select Distinct TipoMov From "~DBO~".MOVDATANET ");
  Lista4:   'Conceptos'          ;-3;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CODIGOSDATANET ");

FinDialogo


if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


ACT(a1, 'Codigos Movimientos Datanet informados por Banco')
SetFont(A:1, 3)
SetFilaActual(fac+2)

ACT(a:fac+1, 'Cod.Bco.Datanet:  '~iif(vacio(Dialogo.Lista2),'Todos',Pipe2Comillas(Dialogo.Lista2)))
ACT(a:fac+2, 'Conceptos: '~iif(vacio(Dialogo.Lista4),'Todos',Pipe2Comillas(Dialogo.Lista4)))

SetFilaActual(fac+2)

ACT(a:FAC+1, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Fecha Hasta: '~Dialogo.Fecha2)


SetFilaActual(fac+3)

ACT(A:fac,'Banco')
ACT(B:fac,'Tipo Mov.')
ACT(C:fac,'Veces Utilizado')
ACT(D:fac,'Descripcio')
ACT(E:fac,'Clasif.')

AgregarMarco(a:fac..f:fac,1,0,Exe('COLOR'))
Setfont(a2..f:fac, 1)
AlinearCeldas(A:fac..f:fac, 'C')

*--  Codigos Datanet


SQL.ADD(" SELECT  M.Banco, M.TipoMov,count(*) Cantidad ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M ")

SQL.ADD(" WHERE M.FechaAcreditacion >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaAcreditacion <= "~IdxDate2(Dialogo.Fecha2)~" ")

If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND M.Banco IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif

If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND M.TipoMov IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif


SQL.ADD(" GROUP BY M.Banco, M.TipoMov ")






acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
Recorrer SQL

    ACT(a:fac,FBN['Banco'])
    ACt(b:fac,FBN['TipoMov'])
    ACT(c:fac, fbn('Cantidad'))

     ACT(z2,SQL("Select Descripcion from "~DBO~".CodigosDatanet where Codigo ='"~FBN['TipoMov']~"'  "))
     ACT(z3,SQL("Select Tipo        from "~DBO~".CodigosDatanet where Codigo ='"~FBN['TipoMov']~"'  "))
     ACT(d:fac,val(z2))
     ACT(e:fac,val(z3))

    SetFont(a:fac..f:fac, 2)
Proximo
FormatoCeldas(c:Val(FI:1)..c:fac, Exe('F8'))

Ifa
Ifa
AgregarMarco(a:fac..q:fac,1,0,Exe('COLOR'))
SetFont(a:fac..q:fac, 1)

act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)

FormatoCeldas(B:1..B:fac, Exe('F0'))
LimitesVision(f:fac+1)
ACO(2, 7)
ACO(3, 10)
ACO(4, 30)
ACO(5, 7)

SetPrintFit(3, 75)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(f:FAC)
RangoTitulo(a:1..f:FAC, 7)
