MostrarCuadroDeMensajes
CrearDialogo
  Fecha1: 'D.FechaConf'     ;;;;;;;;;fsys
  Fecha2: 'H.FechaConf'     ;;;;;;;;;fsys
  NrOperacion1: 'Operacion'
  Cliente1: 'Cliente'
FinDialogo

If NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(a:2, 'Confirmacion de Operaciones ')
if vacio(Dialogo.NrOperacion1)
   ACT(a:2, Val(a2)~' del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2 )
   if novacio(Dialogo.Cliente1)
      ACT(a:3, 'Cliente: '~Dialogo.Cliente1)
   else
      ACT(a:3, 'Cliente: Todos')
   endif
Else
   ACT(a:3, 'Operacion: '~Dialogo.NrOperacion1)
Endif
SETFONT(A2, 3)
SETFONT(A3, 2)

SetFilaActual(5)
ACT(a:fac, 'Operacion')
ACT(b:fac, 'TipoOp')
ACT(c:fac, 'FechaOp')
ACT(d:fac, 'FechaVto')
ACT(e:fac, 'Cliente1')
ACT(f:fac, 'Especie')
ACT(g:fac, 'FechaConf')
ACT(h:fac, 'Contacto')
ACT(i:fac, 'Observaciones')
ACT(j:fac, 'Usuario')
AgregarMarco(a:fac..z:fac,1,1,EXE('COLOR6'))
AlinearCeldas(a:fac..z:fac,'C')
SETFONT(a:fac..z:fac, 2)
ifa

SQL.ADD(" SELECT CF.* , O.FechaOp, O.FechaVto, O.Especie, O.TipoOp, O.Cliente1, C.Nombre ")
*-i
*SQL.ADD(" FROM "~DBO~".CONFIRMACIONESOP CF, "~DBO~".OPERACIONES O , "~DBO~".CONTACTOS C ")
SQL.ADD(" FROM "~DBO~".CONFIRMACIONESOP CF RIGHT OUTER JOIN  "~DBO~".CONTACTOS C  ON C.Codigo  = CF.Contacto,"~DBO~".OPERACIONES O  ")
*-f
 SQL.ADD(" WHERE CF.NrOperacion = O.NrOperacion ")
 *-i
 *SQL.ADD(" AND   C.Codigo       =* CF.Contacto  ")
*-f
SQL.ADD(" AND   CF.Tabla       = 'OPERACIONES' ")
IF NOVACIO(Dialogo.NrOperacion1)
   SQL.ADD(" AND   O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Else
   SQL.ADD(" AND CONVERT (Char(10), CF.Fecha, 103) >= '"~Fecha(Dialogo.Fecha1,'DD/MM/YYYY')~"' ")
   SQL.ADD(" AND CONVERT (Char(10), CF.Fecha, 103) <= '"~Fecha(Dialogo.Fecha2,'DD/MM/YYYY')~"' ")
   IF NOVACIO(Dialogo.Cliente1)
      SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
   Endif
Endif
SQL.ADD(" ORDER BY CF.Fecha, O.Cliente1, O.NrOperacion ")
Recorrer SQL
   ACT(a:fac, fbn('NrOperacion'))
   ACLO(a:fac, fbn('NrOperacion'))
   ACT(b:fac, fbn('TipoOp'))
   ACD(c:fac, fbn('FechaOp'))
   ACD(d:fac, fbn('FechaVto'))
   ACT(e:fac, fbn('Cliente1'))
   ACT(f:fac, fbn('Especie'))
   ACT(g:fac, fbn('Fecha'))
   ACT(h:fac, fbn('Contacto')~' - '~fbn('Nombre'))
   ACT(i:fac, fbn('Observaciones'))
   ACT(j:fac, fbn('Usuario'))
Proximo
ifa
ifa
SETFONT(a:6..z:fac, 1)
ACT(a:fac, 'Fin del Informe.')
SETFONT(a:fac, 2)
ACO(7,15)
ACO(8,12)
ACO(9,25)

Impresion(1,2)
Impresion(4,1)
SetMargins(0,0,0,2)
