  RazonSocial:'Razon Social';;;;;;NoVacio(Dialogo.Cliente1) o NoVacio(Dialogo.RazonSocial);'Debe ingresar un Cliente';NO;
  Fecha1     :'Vigencia' ;;;;;;Dialogo.Fecha1<>0;'Fecha No Valida';NO;Fsys
FinDialogo

if not Ok
