ACT(a:fac,'Especie')
ACT(b:fac,'Nombre')
ACT(c:fac,'Cupon')
ACT(d:fac,'Saldo')
ACT(e:fac,'Cuenta')
ACT(f:fac,'Tipo')
ACT(g:fac,'Prox.Cupon')

*AlinearCeldas(a:fac..l:fac,'C')
SetFont(a:fac..g:fac,2)
AgregarMarco(a:fac..g:fac,2,0,Exe('COLOR12'))

SQL.ADD("SELECT S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.ZeroCoupon, ")
SQL.ADD("       SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC, '1' Tipo,S1.Cupon ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD("WHERE S1.Cliente = C.Codigo AND ")
SQL.ADD("      S1.Cliente='"~Dialogo.Cliente1~"' AND ")
SQL.ADD("      E.Codigo = S1.Especie AND ")
SQL.ADD("      (E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  OR ")
SQL.ADD("       E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' ) AND ")
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
SQL.ADD("      S1.NrSaldo=1 AND ")
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
 SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.ZeroCoupon, E.Alias5, E.InteresesC, Tipo,S1.Cupon ")
SQL.ADD("ORDER BY S1.Especie, Tipo, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo ")

acn(fi:1,fac+1)

Recorrer SQL

  ACT(a:fac,fbn['Especie'])
  ACT(b:fac,fbn['Nombre'])
  ACT(c:fac,fbn['Cupon'])
  ACN(d:fac,-fbn['Saldo'])
  FormatoCeldas(d:fac,Exe('F2'))

  ACT(e:fac,fbn['Cuenta'])
  if DesciendeDeEspecie(FBN['Especie'],'DEUDA')
     ACT(f:fac,'Renta Fija')
  else
     if DesciendeDeEspecie(FBN['Especie'],'PRIVA')
        ACT(f:fac,'Acciones')
     else
        if DesciendeDeEspecie(FBN['Especie'],'FONDOS')
           ACT(f:fac,'Fondos')
        else
           ACT(f:fac,'Otros')
        endif
     endif
  endif
  if Not Eqstr(fbn['ZeroCoupon'],'SI')
     ACD(g:fac,ProxCupon2(fbn['Especie'],Dialogo.Fecha1))
  endif

Proximo
