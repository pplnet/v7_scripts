SQL.ADD(" Select O.TipoOp, O.NrOperacion, M.FechaMov, M.Especie, M.Cantidad, M.Leyenda ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONESBITS OB, "~DBO~".TIPOSOPERACION T ")
SQL.ADD(" WHERE O.Cliente1='"~Dialogo.Cliente1~"'")
SQL.ADD("   AND O.NrOperacion=M.NrOperacion ")
SQL.ADD("   AND O.NrOperacion=OB.NrOperacion ")
SQL.ADD("   AND O.TipoOp=T.Codigo ")
SQL.ADD("   AND OB.Valor=1 ")
SQL.ADD("   AND M.FechaMov<="~IdxDate2(Dialogo.Fecha1))
SQL.ADD(" ORDER BY M.FechaMov, O.TipoOp, M.Especie ")

