ACT(g:fac,'Precio')
ACT(h:fac,'Plazo')
ACT(i:fac,'C.Esp.')
ACT(j:fac,'Total')
ACT(k:fac,'Custodia')

AlinearCeldas(a:fac..k:fac,'C')
SetFont(a:fac..k:fac,2)
AgregarMarco(a:fac..k:fac,2,0,Exe('COLOR12'))

*- Ops Vigentes
SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1,  ")
SQL.ADD(" O.Especie, O.Cantidad, O.Precio1, O.Plazo, ")
SQL.ADD(" O.ContraEspecie, O.TotalNetoCli1, CB8 Custodia  ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE O.Cliente1='"~Dialogo.Cliente1~"'")
SQL.ADD("   AND O.TipoOp Not IN('FXCT','FXVT') ")
SQL.ADD("   AND ((O.FechaOp<="~IdxDate2(Dialogo.Fecha1)~" AND O.FechaVto>"~IdxDate2(Dialogo.Fecha1)~")")
SQL.ADD("    OR (O.FechaOp=O.FechaVto AND O.FechaOp="~IdxDate2(Dialogo.Fecha1)~"))")
SQL.ADD(" ORDER BY TipoOp, Especie, FechaOp ")

acn(fi:1,fac+1)

Recorrer SQL

   ACT(a:fac,fbn['TipoOp'])
   ACT(b:fac,fbn['NrOperacion'])
   ACLO(b:fac,fbn['NrOperacion'])
   ACT(c:fac,fbn['FechaOp'])
   ACT(d:fac,fbn['FechaVto'])
   AlinearCeldas(b:fac..d:fac,'C')

   ACT(e:fac,fbn['Especie'])

   ACN(f:fac,fbn['Cantidad'])
   FormatoCeldas(f:fac,Exe('F2'))

   ACN(g:fac,fbn['Precio1'])
   FormatoCeldas(g:fac,Exe('F2'))

   ACN(h:fac,fbn['Plazo'])
   FormatoCeldas(h:fac,Exe('F0'))
   ACT(i:fac,fbn['ContraEspecie'])

   ACN(j:fac,fbn['TotalNetoCli1'])
   FormatoCeldas(j:fac,Exe('F2'))
   if Incluido(fbn['TipoOp'],'MMCDA|MMCCDA') y Eqstr(FBN['Custodia'],'1')
      ACT(k:fac,'SI')
   endif

Proximo

SQL.ADD(" Select O.TipoOp, O.Especie, O.Cliente1, O.ContraEspecie, O.FechaVto,   ")
SQL.ADD(" Sum(O.Cantidad) Cantidad, SUM(O.TotalBrutoCli1) TotalBrutoCli1, Sum(Plazo) Plazo, Count(1) Cuantos ")
SQL.ADD("  FROM "~DBO~".OPERACIONES O ")
SQL.ADD(" WHERE O.Cliente1='"~Dialogo.Cliente1~"'")
SQL.ADD("   AND O.TipoOp IN('FXCT','FXVT') ")
SQL.ADD("   AND ((O.FechaOp<="~IdxDate2(Dialogo.Fecha1)~" AND O.FechaVto>"~IdxDate2(Dialogo.Fecha1)~")")
SQL.ADD("    OR (O.FechaOp=O.FechaVto AND O.FechaOp="~IdxDate2(Dialogo.Fecha1)~"))")
SQL.ADD(" GROUP BY O.TipoOp, O.Especie, O.Cliente1, O.ContraEspecie, O.FechaVto ")
SQL.ADD(" ORDER BY TipoOp--, Especie ")
 
Recorrer SQL

   ACT(a:fac,fbn['TipoOp'])
   ACT(d:fac,fbn['FechaVto'])
   AlinearCeldas(b:fac..d:fac,'C')

   ACT(e:fac,fbn['Especie'])

   ACN(f:fac,fbn['Cantidad'])
   FormatoCeldas(f:fac,Exe('F2'))

   ACN(g:fac,fbn['TotalBrutoCli1']/fbn['Cantidad'])
   FormatoCeldas(g:fac,Exe('F2'))

   ACN(h:fac,fbn['Plazo']/FBN['Cuantos'])
   FormatoCeldas(h:fac,Exe('F0'))
   ACT(i:fac,fbn['ContraEspecie'])

   ACN(j:fac,fbn['TotalBrutoCli1'])
   FormatoCeldas(j:fac,Exe('F2'))

Proximo
SetFont(a:val(fi:1)..j:fac,1)

