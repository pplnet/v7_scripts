** Llamador de Operaciones entre Vinculadas
HojaVisible(NO)
* ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo 1"   ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Vehiculo2  : "Vehiculo 2"   ;;;;;;;;;;;
  Especie1   : "Especie"      ;;;;;;;;;
  Fecha1     :'F.Desde'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar Fecha Desde';NO;FSys-Dia(FSys)+1
  Fecha2     :'F.Hasta'       ;;;;;;NoVacio(Dialogo.Fecha2);'Debe Ingresar Fecha Hasta';NO;FinDeMes(FSys,SI,'ARG')
  Radio1     :'Tipo|Todos|Colocacion|Toma' ;;;;;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo1 ')
   endif
endif

acd(zz7,HABILES(Dialogo.Fecha1,-1, VAR('FERIADODEF')))

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

* Recupero las VIMIND que no son FechasValor
SQL.ADD("Select Distinct  O.Vehiculo1,O.Vehiculo2,O.Especie,O.MB3 from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp IN ('VIMIND','VIMINM') ")

If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf

If NoVacio(Dialogo.Vehiculo2)
   SQL.ADD(" and O.Vehiculo2='"~Dialogo.Vehiculo2~"' ")
EndIf

if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif

SQL.ADD(" and  ( ")
SQL.ADD(" (O.FechaOp  >= '"~IdxDate(val(zz7))~"' and O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' ) ")
SQL.ADD(" or ")
SQL.ADD(" (TipoOp='VIMIND' and DateDiff(day,FechaOp,FechaCarga)>0 and FechaVto>='"~IdxDate(val(zz7))~"' and FechaVto<='"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD(" ) ")
If Dialogo.Radio1=1
   * Coloca
   SQL.ADD(" and MB3 ='0' ")
EndIf
If Dialogo.Radio1=2
   * Toma
   SQL.ADD(" and MB3 ='1' ")
EndIf
SQL.ADD("order by O.Vehiculo1,O.Vehiculo2, O.Especie, O.MB3")

Recorrer SQL
   ACN(ba1,1)
   LinkearHoja('CIERME',val(ba1),Vehiculo1=fbn['Vehiculo1'],Vehiculo2=fbn['Vehiculo2'],Especie1=fbn['Especie'],Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio1=IIF(EqStr(fbn['MB3'],'0'),1,2) )
proximo
