*HojaVisible(SI)

CrearDialogo
  Fecha1    : 'F.Desde';2;;;;;;;;PriDeMes(FSys)
  Fecha2    : 'F.Hasta';3;;;;;;;;FinDeMes(FSys)
  Radio2    : 'Vehiculos:|Todos|Algunos';5;;;;;;;;0;
  Radio6    : 'Tip.Fondos:|Todos|MM|Securities';4;2;;;;;;;0;
  Radio7    : 'Fondos:|Todas|Algunas';5;2;;;;;;;0;
  Lista1    : "Vehiculo"     ;7;1;;Dialogo.Radio2=1 ;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
  Lista2    : 'Especies'     ;1;2;;Dialogo.Radio7=1 ;;;;;;;iif(Dialogo.Radio6=0, SQLSet("Select Codigo from "~DBO~".ESPECIES where Tipo = 'FON' "), iif(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".ESPECIES where Alias2='0' "),SQLSet("Select Codigo from "~DBO~".ESPECIES where Alias2='1' ") ));
FinDialogo

if not Ok
  Cancelar
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else 
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"))
   EndIf
EndIf

Crearfont(1, 'Arial,8,B')
Crearfont(2, 'Arial,8,')

ACT(a1, 'Costos y Rendimientos Fondos - Consolidado')
ACT(a2, Dialogo.Fecha1~' al '~Dialogo.Fecha2)

If NoVacio(val(zz6))
   ACT(h5, 'Vehiculo : '~val(zz6))
Else
   ACT(h5, 'Vehiculo : Todos ')
EndIf

If Dialogo.Radio6 = 0 
  ACT(a3,'Tipo Fondos: Todos')
else
  If Dialogo.Radio6 =1 
    ACT(a3,'Tipo Fondos:  MM')
  else
    ACT(a3,'Tipo Fondos:  Securities')
  endif 
endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(a4,'Fondos:  '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(a4,'Fondos: Todas' )   
endif
ACT(a5, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo','USD') )

SetFilaActual(7)
ACT(b:fac, 'Spot')
ACT(a:fac+1, 'Dia')
ACT(b:fac+1, 'Concepto')
ACT(c:fac+1, 'Cob.Cupon')
ACT(d:fac+1, 'VN')
ACT(e:fac+1, 'Precio')
ACT(f:fac+1, 'Inic/cierre')
ACT(g:fac+1, 'F.Fondos')
ACT(h:fac, 'T.F.Fondos')
ACT(i:fac, 'Promedio Numerales')
ACT(i:fac+1, 'Flujo Acum.')
ACT(j:fac+1, 'Dias')
ACT(k:fac+1, 'Numerales')
ACT(a:fac+2, 'Inicio')

AgregarMarco(a:fac..a:fac,1,0,Exe('COLOR'))
AgregarMarco(b:fac..g:fac,1,0,Exe('COLOR'))
AgregarMarco(h:fac..h:fac,1,0,Exe('COLOR'))
AgregarMarco(i:fac..k:fac,1,0,Exe('COLOR'))
AgregarMarco(a:fac+1..k:fac+1,1,3,Exe('COLOR'))
ACN(x:fac+2, 0)
recorrer&i Dialogo.Fecha1, Dialogo.Fecha2-1
  ACD(a:fac+3+&i-Dialogo.Fecha1, &i)
  ACN(g:fac+3+&i-Dialogo.Fecha1, 0)
  ACN(x:fac+3+&i-Dialogo.Fecha1, (Val(a:fac+3+&i-Dialogo.Fecha1)-Dialogo.Fecha1)/365)
proximo
ACN(x:fac+3+Dialogo.Fecha2-Dialogo.Fecha1, (Dialogo.Fecha2-Dialogo.Fecha1)/365)
ACN(z1, Dialogo.Fecha2-Dialogo.Fecha1)
ACT(a:fac+3+Val(z1), 'Fin')
ACT(a:fac+4+Val(z1), 'P/L')
ACT(a:fac+5+Val(z1), 'TIR diaria')
ACT(a:fac+6+Val(z1), 'dias')
ACT(a:fac+7+Val(z1), 'Rendimiento de la tenencia (% p.a.)')
ACT(a:fac+8+Val(z1), 'Capital Promedio Tenencia')
AgregarMarco(b:fac..g:fac+3+Val(z1),1)
AgregarMarco(h:fac..h:fac+3+Val(z1),1)
AgregarMarco(i:fac..k:fac+3+Val(z1),1)
AgregarMarco(a:fac+4+Val(z1)..h:fac+4+Val(z1),1)
AgregarMarco(a:fac+5+Val(z1)..h:fac+5+Val(z1),1)
AgregarMarco(a:fac+6+Val(z1)..h:fac+6+Val(z1),1)
AgregarMarco(a:fac+7+Val(z1)..h:fac+7+Val(z1),1,0,Exe('COLOR'))
AgregarMarco(a:fac+8+Val(z1)..h:fac+8+Val(z1),1,0,Exe('COLOR'))
AgregarMarco(u:fac+4+Val(z1)..k:fac+4+Val(z1),1)

SQL.ADD("Select S.Cliente, S.Especie, S.Saldo, E.Tipo, E.InteresesC, E.VTeorico, E.Alias2 from "~DBO~".ESPECIES E, "~DBO~".SALDOSDIA S  where")
SQL.ADD("E.Tipo = 'FON' ")
SQL.ADD("and S.Especie = E.Codigo")
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  SQL.ADD(" and S.Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Alias2= '0' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Alias2= '1' ")
    endif
  endif
else 
  SQL.ADD("and E.Alias2 in ('0','1') ")
endif
If NoVacio(val(zz6))
   SQL.ADD("and S.Cliente in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD("and S.NrSaldo =2")
SQL.ADD("and S.Saldo <> 0")
SQL.ADD("and S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D where")
SQL.ADD("   D.Cliente = S.Cliente")
SQL.ADD("   and D.Especie = S.Especie")
SQL.ADD("   and D.NrSaldo = S.NrSaldo")
SQL.ADD("   and D.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"') ")
SQL.ADD("order by S.Cliente, S.Especie ")

Recorrer SQL
  dfa
  ACN(ad:fac+2, fbn('Saldo'))

  * Obtengo las Cotizaciones de los Fondos
  * ff1: Parametro de Entrada ff2: Cotizacion Resultante

  *-- Cotizacion de Inicio
  ACD(ff1, Dialogo.Fecha1-1)
  ACT(fe1, fbn('Especie'))
  (.'FONDOCOTI'.)
  
  ACN(af:fac+2, VAL(ff2))

  *-- Cotizacion de Fin 
  ACD(ff1, Dialogo.Fecha2-1)

  (.'FONDOCOTI'.)
  ACN(bf:fac+2, VAL(ff2))

  * si elige una sola especie puede mostrar valor nominal y precio
  if Elementos(Dialogo.Lista2)=1
     SCN(d:fac+2, Val(ad:fac+2))
     SCN(f:fac+2, Val(af:fac+2))
  endif

  SCN(g:fac+2, -Val(ad:fac+2)*Val(af:fac+2))
  SCN(bg:fac+2,-Val(ad:fac+2)*Val(bf:fac+2))
proximo

SQL.ADD("Select O.Especie, O.Cantidad, O.TotalNetoCli1, O.Precio1, O.FechaVto, O.Cotizacion1, O.TipoOp, O.FechaPago, O.ContraEspecie, O.MB4, O.MB3, O.TipoCambio3, O.Cartera, O.FechaOp, O.ContraEspecie2, O.TotalBrutoCli1, E.InteresesC, E.VTeorico, E.Alias2 ")
SQL.ADD(" from "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O  where")
SQL.ADD(" TipoOp in ('FCS','FCR') ")
If NoVacio(val(zz6))
   SQL.ADD("and Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  SQL.ADD("and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If Dialogo.Radio6 > 0 
  If Dialogo.Radio6 = 1 
    SQL.ADD("and E.Alias2= '0' ")
  else
    if Dialogo.Radio6 = 2
     SQL.ADD("and E.Alias2= '1' ")
    endif
  endif
else 
  SQL.ADD("and E.Alias2 in ('0','1') ")
endif
SQL.ADD("and FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto < '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and E.Codigo = O.Especie ")
SQL.ADD("order by Vehiculo1, Especie")

recorrer SQL
  dfa
  if incluido(fbn('TipoOp'), 'FCR')
    ACN(z4, -1)
  else
    ACN(z4, 1)
  endif
  recorrer&i fac+3, fac+3+Val(z1)
    if Val(a:&i)=fbn('FechaVto')
      ACN(z2, &i)
      break
    endif
  proximo
  if Elementos(Dialogo.Lista2)=1
    SCN(d:Val(z2), fbn('Cantidad')*Val(z4))
    SCN(e:Val(z2), fbn('Cantidad')*Val(z4)*fbn('Precio1'))
  endif
  SCN(g:Val(z2), fbn('TotalNetoCli1')*fbn('Cotizacion1')*-Val(z4))

  * ACN(bf:Val(z2), CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,'USD'))

  *-- Cotizacion de Fin 
  ACD(ff1, Dialogo.Fecha2-1)
  ACT(fe1, fbn('Especie'))
  (.'FONDOCOTI'.)

  ACN(bf:val(z2), VAL(ff2))

  ACN(ad:Val(z2), fbn('Cantidad')*-Val(z4))
  SCN(bg:Val(z2), Val(ad:Val(z2))*Val(bf:Val(z2)))
proximo


recorrer&i fac+3, fac+2+Val(z1)
  * si elige una sola especie puede mostrar valor nominal y precio
  if Elementos(Dialogo.Lista2)=1
    ACN(e:&i, Val(e:&i)/Val(d:&i))
  endif
  ACN(h:&i, Val(g:&i))
  ACN(i:&i, Val(h:&i))
  ACN(j:&i, Dialogo.Fecha2-Dialogo.Fecha1+fac+3-&i)
  ACN(k:&i, Val(i:&i)*Val(j:&i))
proximo

* Buscar inicio de TIR
recorrer&i fac+2, fac+3+Val(z1)
  if Val(g:&i)<>0 y Val(z10)=0
    ACN(z10, &i)
    if EqStr(Val(a:&i),'Inicio')
      acn(xx:&i,Val(a:&i+1))
    else
      acn(xx:&i,Val(a:&i))
    endif
    recorrer&j &i, fac+3+Val(z1)
      if EqStr(Val(a:&j),'Inicio')         
         ACN(aw:&j, 0)
      else
         if EqStr(Val(a:&j),'Fin')
            ACN(aw:&j, (Dialogo.Fecha2-Val(xx:&i)))
         else
            ACN(aw:&j, (Val(a:&j)-Val(xx:&i)+1))
        endif
      endif
    proximo
  endif
proximo
ACN(z13, Val(z10))

if EqStr(Val(a:Val(z13)),'Inicio')
  acn(xx:Val(z13),Val(a:Val(z13)+1))
else
  acn(xx:Val(z13),Val(a:Val(z13)))
endif

recorrer&j Val(z13), fac+3+Val(z1)
  if EqStr(Val(a:&j),'Inicio')
    ACN(az:&j, 0 )
  else
    if EqStr(Val(a:&j),'Fin')
      ACN(az:&j, (Dialogo.Fecha2-Val(xx:Val(z13))))
    else
      ACN(az:&j, (Val(a:&j)-Val(xx:Val(z13)))+1)
    endif
  endif
proximo


* Fin Spot
ACN(g:fac+3+Val(z1), -Sum(bg1..bg:fac+2+Val(z1)))

* si elige una sola especie puede mostrar valor nominal y precio
if Elementos(Dialogo.Lista2)=1

   * ACN(f:fac+3+Val(z1), Val(g:fac+3+Val(z1))/Val(d:fac+3+Val(z1)))
   *-- Cotizacion de Fin 
   ACD(ff1, Dialogo.Fecha2-1)
   ACT(fe1, SQL("Select Codigo FROM "~DBO~".ESPECIES Where Codigo In ("~Pipe2Comillas(Dialogo.Lista2)~") "))
   (.'FONDOCOTI'.)

   ACN(d:fac+3+Val(z1), -Sum(d1..d:fac+2+Val(z1))) 
   ACN(f:fac+3+Val(z1),VAL(ff2))
   ACN(g:fac+3+Val(z1),-VAL(d:fac+3+Val(z1))*VAL(f:fac+3+Val(z1)) )
endif

* P&L spot
ACN(g:fac+4+Val(z1), Sum(g1..g:fac+3+Val(z1)))
ACN(g:fac+6+Val(z1), Val(aw:fac+3+Val(z1)))
if Val(g:fac+4+Val(z1))<>0
   * TIR diaria spot
   * ACN(g:fac+5+Val(z1), TIR(aw:Val(z10)..aw:fac+3+Val(z1), g:Val(z10)..g:fac+3+Val(z1))*100)
   ACN(g:fac+5+Val(z1), ((1+TIR2(aw:Val(z10)..aw:fac+3+Val(z1),g:Val(z10)..g:fac+3+Val(z1)))^(1/365)-1)*100  )   
   if Val(z10)=0
     ACN(g:fac+5+Val(z1), 0)
   endif
   * Rendimiento promedio spot
   ACN(g:fac+7+Val(z1), (((1+(Val(g:fac+5+Val(z1))/100))^Val(g:fac+6+Val(z1)))-1)/Val(g:fac+6+Val(z1))*365*100)
   * Capital promedio spot
   ACN(g:fac+8+Val(z1),(Val(g:fac+4+Val(z1))*365)/(Val(g:fac+7+Val(z1))/100*Val(z1)))
else
  * TIR diaria spot
  ACN(g:fac+5+Val(z1), 0)
  * Rendimiento promedio spot
  ACN(g:fac+7+Val(z1),0)
  * Capital promedio spot
  ACN(g:fac+8+Val(z1),Val(k:fac+4+Val(z1))/Val(g:fac+6+Val(z1)))
endif

ACN(h:fac+2, Val(g:fac+2))
ACN(i:fac+2, Val(h:fac+2))
ACN(j:fac+2, Dialogo.Fecha2-Dialogo.Fecha1)
ACN(k:fac+2, Val(i:fac+2)*Val(j:fac+2))
ACN(h:fac+3+Val(z1), Val(g:fac+3+Val(z1)))
ACN(i:fac+3+Val(z1), Val(h:fac+3+Val(z1)))
ACN(j:fac+3+Val(z1), 0)
ACN(k:fac+3+Val(z1), Val(i:fac+3+Val(z1))*Val(j:fac+3+Val(z1)))
ACN(k:fac+4+Val(z1), sum(k:fac+2..k:fac+3+Val(z1)))

* P&L Total
ACN(h:fac+4+Val(z1), Val(g:fac+4+Val(z1)))
ACN(h:fac+6+Val(z1), Val(az:fac+3+Val(z1)))
if Val(h:fac+4+Val(z1))<>0
   * ACN(h:fac+5+Val(z1), TIR(az:Val(z13)..az:fac+3+Val(z1), h:Val(z13)..h:fac+3+Val(z1))*100)
   ACN(h:fac+5+Val(z1), ((1+TIR2(az:Val(z13)..az:fac+3+Val(z1),h:Val(z13)..h:fac+3+Val(z1)))^(1/365)-1)*100  )   
   if Val(z13)=0
      ACN(h:fac+5+Val(z1), 0)
   endif
   * Rendimiento promedio total
   ACN(h:fac+7+Val(z1), (((1+(Val(h:fac+5+Val(z1))/100))^Val(h:fac+6+Val(z1)))-1)/Val(h:fac+6+Val(z1))*365*100)
   * Capital promedio total
   ACN(h:fac+8+Val(z1),(Val(h:fac+4+Val(z1))*365)/(Val(h:fac+7+Val(z1))/100*Val(z1)))
else
  * TIR diaria spot
  ACN(h:fac+5+Val(z1), 0)
  * Rendimiento promedio spot
  ACN(h:fac+7+Val(z1),0)
  * Capital promedio spot
  ACN(h:fac+8+Val(z1),Val(k:fac+4+Val(z1))/Val(h:fac+6+Val(z1))*-1)
endif

Message('* Para linkear')
Message('* capital')
ACN(bv:1, Val(h:fac+8+Val(z1)))

* tasa
ACN(bu:1, Val(h:fac+7+Val(z1)))
* plazo
ACN(bw:1, 1)

SetFont(a1..bz:fac+2,1)
SetFont(a:fac+3..bz:fac+2+val(z1),2)
SetFont(a:fac+3+Val(z1)..bz:fac+8+Val(z1),1)
Impresion(1,2)
FormatoCeldas(c1..d:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(g1..g:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(e1..f:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(h1..h:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(i1..i:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(j1..j:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(k1..k:fac+8+Val(z1), Exe('F2'))
FormatoCeldas(x1..x:fac+8+Val(z1), Exe('F7'))
FormatoCeldas(a:fac+5+Val(z1)..k:fac+5+Val(z1), Exe('F7'))
 LimitesVision(l:fac+9+Val(z1))
SetPrintFit(3, 60)
