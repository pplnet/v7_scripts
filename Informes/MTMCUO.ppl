CrearDialogo
  NrOperacion1: 'Operacion'     ;2;1;;;;NoVacio(Dialogo.NrOperacion1);'Debe ingresar la operacion';NO;;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')

ACT(A:2,'Detalle MTM Por Operacion')
SetFont(A:2,1)

SetFilaActual(4)

ACT(A:FAC,'NrOperacion:')
ACT(B:FAC,Dialogo.NrOperacion1)
ACLO(B:FAC,Val(B:FAC))
ACT(A:FAC+1,'VN:')
ACN(B:FAC+1,BuscarCampo('OPERACIONES','Cantidad','NrOperacion',Dialogo.NrOperacion1))
ACT(A:FAC+2,'Tipo Op:')
ACT(B:FAC+2,BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1))

FormatoCeldas(B:FAC+1, Exe('F2'))
SetFont(A:FAC..B:FAC+2,2)
AlinearCeldas(B:FAC..B:FAC+2,'D')

SetFilaActual(FAC+4)

ACT(A:FAC,'Fecha Hoy')
ACT(B:FAC,'Fecha Ayer')
ACT(C:FAC,'Cot. Hoy')
ACT(D:FAC,'Cot. Ayer')
ACT(E:FAC,'MTM')
AlinearCeldas(A:FAC..E:FAC,'C')
AgregarMarco(A:FAC..E:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..E:FAC,2)

SQL.ADD(" Select Fecha1, Fecha2, Cotizacion1, Cotizacion2, Precio1 ")
SQL.ADD("   from "~DBO~".CUOTAS ")
SQL.ADD("  Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" Order by Fecha1 ")
  
ACN(Z:1,FAC+1)
  
Recorrer SQL
  ACD(A:FAC,FBN['Fecha1'])
  ACD(B:FAC,FBN['Fecha2'])
  ACN(C:FAC,FBN['Cotizacion1'])
  ACN(D:FAC,FBN['Cotizacion2'])
  ACN(E:FAC,FBN['Precio1'])
  SCN(TO:1,Val(E:FAC))
Proximo
  
FormatoCeldas(C:Val(Z:1)..D:FAC, Exe('F8'))
FormatoCeldas(E:Val(Z:1)..E:FAC, Exe('F2'))
SetFont(A:Val(Z:1)..E:FAC,3)
  
IFA
ACT(A:FAC,'Total')
ACN(E:FAC,Val(TO:1))
FormatoCeldas(E:FAC, Exe('F2'))
AgregarMarco(A:FAC..E:FAC,1,0,Exe('COLOR8'))
SetFont(A:FAC..E:FAC,2)

LimitesVision(F:FAC+1)

ACO(1,8)
ACO(2,8)
ACO(3,10)
ACO(4,10)
ACO(5,10)
