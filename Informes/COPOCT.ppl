ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1   : 'Fecha'     ;;;;;;;;;FSys;
  Vehiculo1: 'Vehiculo'  ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar el Vehiculo';NO;Var('VEHICULODE')
FinDialogo
if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,7,')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,8,B')

SetFilaActual(1)
ACN(w1,FAC)

SQL.ADD("Select RazonSocial, Direccion, CodigoPostal from "~DBO~".CLIENTES where Codigo = '"~Dialogo.Vehiculo1~"' ")
Recorrer SQL
  dfa
  ACT(a:FAC, 'Standard Bank Agente MAE Nro. '~VAR('AGESIOP'))
  ACT(a:FAC+1, fbn['Direccion'])
  ACT(a:FAC+2, '('~fbn['CodigoPostal']~') Buenos Aires - Argentina')
  SetFont(a:FAC..h:FAC+2,3)
Proximo
ACT(p:fac, 'Fecha: '~Dialogo.Fecha1)
SetFont(p:FAC,3)

ACT(h:fac, 'Registro de Operaciones OCT')
SetFont(h:FAC,3)

SetFilaActual(fac+4)

ACT(a:FAC, 'Boleto')
ACT(b:FAC, 'Min.Nr.')
ACT(c:FAC, 'Fecha Op.')
ACT(d:FAC, 'Fecha Liq.')
ACT(e:FAC, 'Tipo Op')
ACT(f:FAC, 'Hora')
ACT(g:FAC, 'Nr.MAE')
ACT(h:FAC, 'Comitente')
ACT(i:FAC, 'Especie')
ACT(j:FAC, 'Cant.Cont.')
ACT(k:FAC, 'Cantidad VN')
ACT(l:FAC, 'Precio')
ACT(m:FAC, 'Importe Bruto')
ACT(n:FAC, 'Importe Neto')
ACT(o:FAC, 'Age.')
ACT(p:FAC, 'Oper.')
ACT(q:FAC, 'Baja')
ACT(r:FAC, 'Modo')
ACT(s:FAC, 'Fixing')
AlinearCeldas(a:FAC..s:FAC,'C')
AgregarMarco(a:FAC..s:FAC,2)
SetFont(a:FAC..s:FAC,2)

acn(u2,0)
acn(u1,0)
SQL.ADD(" Select O.NrOperacion,    O.NrBoleto,       O.FechaOp,       O.FechaVto, O.TipoOp, ")
SQL.ADD("        O.FechaAltaMAE,       O.FechaEnvioMAE,  O.NroAltaMAE,    O.Especie,  O.Precio1, ")
SQL.ADD("        O.Cantidad,       O.TotalBrutoCli1, O.TotalNetoCli1, O.Cliente1, O.OpSIOPEL, ")
SQL.ADD("        C.RazonSocial,    C.NrMAE,          O.EnteCus1,      O.MB3,      SUBSTRING(O.NrBoleto,3,6) as Orden, ")
SQL.ADD("        O.ContraEspecie2, O.TotalBrutoCli3  ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where C.Codigo    = O.Cliente1 ")
SQL.ADD("   and OB.NrOperacion =  O.NrOperacion ")
SQL.ADD("   and OB.NrBit       =  30 ")
SQL.ADD("   and OB.Valor       <> '1' ")
*SQL.ADD("   and O.FechaOp      =  '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("   and O.TipoOp       IN ('FXOCTC','FXOCTV') ")
SQL.ADD("   and O.Vehiculo1    =  '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and O.NroAltaMAE   is Not Null ")
SQL.ADD(" Order By Orden ")
Recorrer SQL
    Message(fbn('NrOperacion'))
    acn(u1,1)
    ACT(a:FAC, Copy(fbn('NrBoleto'),3,6))
    ACT(b:FAC, Copy(fbn('NrOperacion'),1,8))
    ACD(c:FAC, fbn('FechaOp'))
    ACD(d:FAC, fbn('FechaVto'))
    if Incluido(fbn('TipoOp'),'FXOCTC')
      ACT(e:FAC, 'Compra OCT')
    else
      ACT(e:FAC, 'Venta OCT')
    endif
    ACT(f:FAC, Hora(fbn('FechaAltaMAE')))
    if Num(fbn('NroAltaMae'))>0
      ACT(g:FAC, fbn('NroAltaMae'))
    else
      ACT(g:FAC, 'N/A')
    endif
    ACT(h:FAC, Copy(fbn('RazonSocial'),1,25))
    if Not Eqstr(fbn('Especie'), Val(ES:1))
      ACT(EQ:1, fbn('Especie'))
      *** ACT(EQ:1, SQL("Select EspecieOrigen from "~DBO~".EQUIVALENCIA_ESPECIES where TipoCotizacion='O' and EspecieDestino1='"~fbn('Especie')~"' and TipoNegociacion='O' "))
    endif
    ACT(I:fac, Val(EQ:1)~' '~fbn('FechaVto'))
    ACN(j:FAC, fbn('TotalBrutoCli3'))
    ACN(k:FAC, fbn('Cantidad'))
    ACN(l:fac, fbn('Precio1'))
    ACN(m:FAC, fbn('TotalBrutoCli1'))
    ACN(n:FAC, fbn('TotalBrutoCli1'))
    ACT(o:FAC, Copy(fbn('NrMAE'),1,25))
    ACT(p:FAC, fbn('OpSIOPEL'))
    if EqStr(fbn('MB3'),'1')
      ACT(r:FAC, 'Con Gtia.')
    else
      ACT(r:FAC, 'Sin Gtia.')
    endif
    ACT(s:FAC, BuscarCampo('ESPECIES','Nombre','Codigo',fbn['ContraEspecie2']))
    scn(u2,1)
    SetFont(a:FAC..s:FAC,1)
    FormatoCeldas(l:fac,Exe('F9'))
    AlinearCeldas(e:FAC..e:FAC,'I')
    AlinearCeldas(g:FAC..g:FAC,'D')
    AlinearCeldas(o:FAC..q:FAC,'D')
    ACT(ES:1, fbn('Especie'))
proximo 

SQL.ADD(" Select O.NrOperacion,    O.NrBoleto,       O.FechaOp,       O.FechaVto, O.TipoOp, ")
SQL.ADD("        O.FechaAltaMAE,       O.FechaEnvioMAE,  O.NroAltaMAE,    O.Especie,  O.Precio1, ")
SQL.ADD("        O.Cantidad,       O.TotalBrutoCli1, O.TotalNetoCli1, O.Cliente1, O.OpSIOPEL, ")
SQL.ADD("        C.RazonSocial,    C.NrMAE,          O.EnteCus1,      O.MB3,      SUBSTRING(O.NrBoleto,3,6) as Orden, ")
SQL.ADD("        O.ContraEspecie2, O.TotalBrutoCli3  ")
SQL.ADD(" From "~DBO~".BOPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD(" Where C.Codigo     =  O.Cliente1 ")
SQL.ADD("   and O.FechaOp    =  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.TipoOp     IN ('FXOCTC','FXOCTV') ")
SQL.ADD("   and O.Vehiculo1  =  '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and O.NroAltaMAE is Not Null ")

SQL.ADD(" UNION ")

SQL.ADD(" Select O.NrOperacion,    O.NrBoleto,       O.FechaOp,       O.FechaVto, O.TipoOp, ")
SQL.ADD("        O.FechaAltaMAE,       O.FechaEnvioMAE,  O.NroAltaMAE,    O.Especie,  O.Precio1, ")
SQL.ADD("        O.Cantidad,       O.TotalBrutoCli1, O.TotalNetoCli1, O.Cliente1, O.OpSIOPEL, ")
SQL.ADD("        C.RazonSocial,    C.NrMAE,          O.EnteCus1,      O.MB3,      SUBSTRING(O.NrBoleto,3,6) as Orden, ")
SQL.ADD("        O.ContraEspecie2, O.TotalBrutoCli3  ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" Where C.Codigo       = O.Cliente1 ")
SQL.ADD("   and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("   and OB.NrBit       = 30 ")
SQL.ADD("   and OB.Valor       = '1' ")
SQL.ADD("   and O.FechaOp      = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.TipoOp       IN ('FXOCTC','FXOCTV') ")
SQL.ADD("   and O.Vehiculo1    = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("   and O.NroAltaMAE   is Not Null ")
SQL.ADD(" Order By Orden ")
Recorrer SQL
    Message(fbn('NrOperacion'))
    acn(u1,1)
    ACT(a:FAC, Copy(fbn('NrBoleto'),3,6))
    ACT(b:FAC, Copy(fbn('NrOperacion'),1,8))
    ACD(c:FAC, fbn('FechaOp'))
    ACD(d:FAC, fbn('FechaVto'))
    if Incluido(fbn('TipoOp'),'FXOCTC')
      ACT(e:FAC, 'Compra OCT')
    else
      ACT(e:FAC, 'Venta OCT')
    endif
    ACT(f:FAC, Hora(fbn('FechaAltaMAE')))
    if Num(fbn('NroAltaMae'))>0
      ACT(g:FAC, fbn('NroAltaMae'))
    else
      ACT(g:FAC, 'N/A')
    endif
    ACT(h:FAC, Copy(fbn('RazonSocial'),1,25))
    if Not Eqstr(fbn('Especie'), Val(ES:1))
      ACT(EQ:1, fbn('Especie'))
      *** ACT(EQ:1, fbn('EnteCus1'))
    endif
    ACT(i:fac, Val(EQ:1)~' '~fbn('FechaVto'))
    ACN(j:FAC, fbn('TotalBrutoCli3'))
    ACN(k:FAC, fbn('Cantidad'))
    ACN(l:fac, fbn('Precio1'))
    ACN(m:FAC, fbn('TotalBrutoCli1'))
    ACN(n:FAC, fbn('TotalBrutoCli1'))
    ACT(o:FAC, Copy(fbn('NrMAE'),1,25))
    ACT(p:FAC, fbn('OpSIOPEL'))
    ACT(q:fac, 'Baja')
    if EqStr(fbn('MB3'),'1')
      ACT(r:FAC, 'Con Gtia.')
    else
      ACT(r:FAC, 'Sin Gtia.')
    endif
    ACT(s:FAC, BuscarCampo('ESPECIES','Nombre','Codigo',fbn['ContraEspecie2']))
    scn(u2,1)
    SetFont(a:FAC..s:FAC,1)
    FormatoCeldas(l:fac,Exe('F9'))
    AlinearCeldas(e:FAC..e:FAC,'I')
    AlinearCeldas(g:FAC..g:FAC,'D')
    AlinearCeldas(o:FAC..q:FAC,'D')
    ACT(ES:1, fbn('Especie'))
proximo 

if Val(u2) >= 1
  OrdenarFilas(6,5+Val(u2),1,'A')
else
  ACT(h:fac+2, 'NO  HAY  OPERACIONES')
  SetFont(h:fac+2,3)
  SetFilaActual(fac+4)
endif

ACO(1,4)
ACO(2,5)
ACO(3,5)
ACO(4,5)
ACO(5,7)
ACO(6,4)
ACO(7,4)
ACO(8,18)
ACO(9,9)
ACO(10,5)
ACO(11,7)
ACO(12,6)
ACO(13,7)
ACO(14,7)
ACO(15,3)
ACO(16,3)
ACO(17,3)
ACO(18,5)
ACO(19,7)

LimitesVision(s:FAC)
RangoTitulo(a:1..s:fac, 5)
Impresion(1,2)
***Impresion(3,1)
SetMargins(0,0,0,1.5)
SetPrintFit(3,85)
