MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'          ;;;;;;;;;fsys
  Cliente1 : 'Cliente'        ;;;;;;
  Especie1 : 'Especie'        ;;;;;;Vacio(Dialogo.Especie1) O [DesciendeDeEspecie(Dialogo.Especie1,'TITULO') y EsTerminal(Dialogo.Especie1, Especie)];'Debe ingresar un titulo';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','TITULO')~"%' "
  Especie2 : 'Contra Especie' ;;;;;;
  Lista1   : 'Cartera'        ;0;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')
CrearFont(5, 'Arial,12,B')

SetFilaActual(1)

ACT(D:fac, 'Detalle Posiciones de Acciones de Terceros')
SetFont(D:fac, 5)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ACT(B:fac, 'Cliente: '~IIF(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(A:fac+1, 'Especies: '~IIF(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ACT(C:fac, 'Carteras: '~IIF(NoVacio(Dialogo.Lista1),Dialogo.Lista1,'Todas'))
ACT(B:fac+1, 'Contra Especie: '~IIF(NoVacio(Dialogo.Especie2),Dialogo.Especie2,'Todas'))
ifa
ifa

SetFont(a:1, 4)
SetFont(a:2..z:7, 2)


SetFilaActual(fac+2)
ACT(A:fac, 'Fecha')
ACT(B:fac, 'Fecha Vto')
ACT(C:fac, 'Moneda')
ACT(D:fac, 'Cantidad')
ACT(E:fac, 'Precio')
ACT(F:fac, 'Nr Operacion')
ACT(G:fac, 'Tipo')
ACT(H:fac, 'Cartera')
AgregarMarco(a:fac..h:fac,0,0,EXE('COLOR'))
SetFont(a:fac..h:fac, 2)

SQL.ADD("SELECT Especie, CASE WHEN TipoOp = 'EQC' THEN Cantidad ELSE -Cantidad END Can, FechaVto, Precio1, NrOperacion, TipoOp, Book1, ContraEspecie")
SQL.ADD("FROM "~DBO~".OPERACIONES ")
SQL.ADD("WHERE TipoOp IN ('EQC','EQV')")
SQL.ADD("AND FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(" AND Cliente1 <> Mercado ")
If NoVacio(Dialogo.Especie1)
  SQL.ADD("AND Especie <= '"~Dialogo.Especie1~"'")
ENDIF
If NoVacio(Dialogo.Cliente1)
  SQL.ADD("AND Cliente1 = '"~Dialogo.Cliente1~"'")
ENDIF
If NoVacio(Dialogo.Lista1)
  SQL.ADD("AND Book1 IN ( "~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
If NoVacio(Dialogo.Especie2)
  SQL.ADD("AND ContraEspecie = '"~Dialogo.Especie2~"'")
ENDIF
ACN(TO:1,0)
recorrer SQL
  ACT(A:Fac, Dialogo.Fecha1)
  ACT(B:Fac, Fbn['FechaVto'])
  ACT(C:Fac, Fbn['Especie'])
  ACN(D:Fac, Abs(Fbn['Can']))
  ACN(DE:Fac, Fbn['Can'])
  ACN(E:Fac, fbn['Precio1'])
  ACT(F:Fac, Fbn['NrOperacion'])
  ACLO(F:Fac, Fbn['NrOperacion'])
  ACT(G:Fac, Fbn['TipoOp'])
  ACT(H:Fac, Fbn['Book1'])
  SCN(TO:1, val(DE:Fac))
  SCN(TO:2, Abs(val(DE:Fac))*val(E:Fac))
