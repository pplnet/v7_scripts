HojaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
   String1     : 'Usuario'         ;;;;;;;;;;;;;;;;
   Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
   Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
   Radio1     : "Tipo|Todos|Informes|Eventos"     ;;;;;;;;;0 
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')


  SetFilaActual(1)
  ACT(a:1,'SIAF Auditoria Operaciones - CONFIDENCIAL')
  SetFont(a:1,1)


SetFilaActual(fac+2)
ACT(b:fac, 'Listado de # Auditor¡a de Usuarios')
SetFont(b:fac, 3)

SetFilaActual(fac+1)

if Vacio(Dialogo.String1)
  ACT(a:fac+1, 'Usuario: Todos')
else
  ACT(a:fac+1, 'Usuario: '~Dialogo.String1)
endif

SetFilaActual(fac+1)
If Dialogo.Radio1=0
     ACT(a:fac+1, 'Informes y Eventos')
else
     If Dialogo.Radio1=1
        ACT(a:fac+1, 'Informes')
     else
        ACT(a:fac+1, 'Eventos')
     endif
endif

if Dialogo.Fecha1 > 0
  SetFilaActual(fac+1)
  ACT(a:fac+1, 'Fecha Desde: '~Dialogo.Fecha1)
endif

if Dialogo.Fecha2 > 0
  SetFilaActual(fac+1)
  ACT(a:fac+1, 'Fecha Hasta: '~Dialogo.Fecha2)
endif


**************   LOGINFORMES  ***********************

SetFilaActual(fac+1)

  ACT(A:fac,'Usuario')
  ACT(B:fac, 'Nombre')
  ACT(C:fac,'Fecha')
  ACT(D:fac,'Tipo')
  ACT(E:fac,'Codigo')
  ACT(F:fac,'Datos')


AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))
Setfont(a2..i:fac, 1)
AlinearCeldas(A:fac..i:fac, 'C')

*--  Vehiculos permitidos por el usuario
   ACT(z1,SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))


*--  Select

  SQL.ADD(" Select  a.Usuario,  a.Fecha, a.Tipo, a.Codigo, a.Datos, c.Nombre   " )
  SQL.ADD("   from   "~DBO~".LOGINFORMES a  " )
  SQL.ADD("        ,  "~DBO~".USUARIOS c  " )
  SQL.ADD("   where a.Usuario = c.Codigo ")

  if NoVacio(Dialogo.String1)
     SQL.ADD("     and a.Usuario = '"~Dialogo.String1~"'  ")
  endif

  if Dialogo.Fecha1 > 0 
     SQL.ADD(" AND a.Fecha >= "~IdxDate2(Dialogo.Fecha1)~" ")
  endif

  if Dialogo.Fecha2 > 0 
     SQL.ADD(" AND a.Fecha <= "~IdxDate2(Dialogo.Fecha2)~" ")
  endif

  If Dialogo.Radio1=2
     SQL.ADD("     and a.Tipo like 'E%'    ")
  endif

  If Dialogo.Radio1=1
     SQL.ADD("     and a.Tipo like 'I%'    ")
  endif


SQL.ADD(" order by a.Usuario, a.Fecha desc, a.Codigo ")

acn(z3,0)
acn(z2,0)
ACT(Z4, 'O')

ACN(FI:1, fac+1)
Recorrer SQL
    ACT(a:fac,FBN['Usuario'])
    ACT(b:fac,FBN['Nombre'])
    ACT(c:fac,FBN['Fecha'])
    ACT(d:fac,FBN['Tipo'])
    ACT(e:fac,FBN['Codigo'])
    ACT(f:fac,FBN['Datos'])

    SetFont(a:fac..i:fac, 2)
Proximo
Ifa

**********************************************************

AgregarMarco(a:fac..i:fac,1,0,Exe('COLOR'))

SetFont(a:fac..i:fac, 1)
Impresion(1,2)
act(a:fac+2,'FIN DE LISTADO')
SetFont(a:fac..a:fac, 1)

LimitesVision(M:fac+2)
ACO(2, 15)
ACO(3, 12)
ACO(4, 10)
ACO(5, 10)
ACO(6, 30)


SetPrintFit(3, 75)
RangoTitulo(a:1..i:fac+2, 8)