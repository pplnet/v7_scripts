ModoReproceso(SINDIALOGO)
CrearDialogo
  Fecha1       : 'Fecha Desde'       ;1;1;;;;Dialogo.Fecha1 <> 0 y (Dialogo.Fecha1 = Dialogo.Fecha2 o Dialogo.Fecha1 < Dialogo.Fecha2);'Fecha Desde Invalida';NO;PriDeMes(Fsys);
  Fecha2       : 'Fecha Hasta'       ;1;2;;;;Dialogo.Fecha2 <> 0 y (Dialogo.Fecha2=Fsys o Dialogo.Fecha2 < Fsys);'Fecha Hasta Invalida';NO;Fsys;
  NrOperacion1 : 'Nro. CONU'         ; ;1;;;;Vacio(Dialogo.NrOperacion1) o Incluido(Dialogo.NrOperacion1, SQLSet(" Select NrOperacion From "~DBO~".OPERACIONES Where NrOperacion = '"~Dialogo.NrOperacion1~"' AND TipoOp='CONU'  "));'Debe ingresar una Operacion Valida';NO;;;;;;"TipoOp  = 'CONU'"
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

SetFilaActual(4)
ACT(e:fac,'ICL - Detalle Interes Diario CONU')
SetFont(e:fac,3)

SetFilaActual(fac+1)
act(a:fac,'Fecha : '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2)

SetFilaActual(fac+1)
if NoVacio(Dialogo.NrOperacion1)
   act(a:fac,'CONU : '~Dialogo.NrOperacion1)
Else   
   act(a:fac,'CONU : Todas')
Endif
SetFont(a:fac-1..b:fac,2)
IFA

ACT(a:fac,   'Operacion')
* FJL 15/01/20 - Se agrega Termsheet ID
ACT(b:FAC, 'TermSheet ID')
ACT(c:fac,   'Fecha ')
ACT(c:fac+1, 'Devengado')
ACT(d:fac  , 'Cantidad')
ACT(e:fac  , 'Utilizado')
ACT(f:fac  , 'Cod Tasa')
ACT(g:fac  , 'Tasa Base')
ACT(h:fac  , 'Cod Spread')
ACT(i:fac  , 'Tasa Spread')
ACT(j:fac  , 'Interes Diario')

AlinearCeldas(a:fac..l:fac+1,'C')
SetFont(a:fac..l:fac+1,2)
AgregarMarco(a:fac..j:fac+1,2,0,EXE('COLOR'))
IFA
ACN(w2,fac)

SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.TipoOp, O.Cantidad, FechaOp, FechaVto, ")
SQL.ADD("  Precio1 as Tasa, TipoTasa as CodTasa, Spread, Especie1 as CodSpread, Plazo, DiasAnio, ")
* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
*SQL.ADD("  O.ObservacDoc as TSID,  ")
* FJL 07/11/20 - Por Issue 4523 se cambia el campo del TS y se agrega TipoCONU
SQL.ADD("  O.Termsheet as TSID, O.TipoCONU,  ")
SQL.ADD("  Case When DiasAnio = '0' Then 36000 Else 36500 End Divisor, M.Fecha, M.Monto, M.Tasa1, M.Tasa2")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".MOVDEVENGADOS M ")
SQL.ADD(" where O.NrOperacion = M.NrOperacion ")
SQL.ADD("   and M.Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("   and O.TipoOp in ('CONU') ")
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("   and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Endif
SQL.ADD("Order by M.Fecha,O.NrOperacion, FechaOp ")
watch(SQL.Batch)

Recorrer SQL
   if Mes(FBN('Fecha')) <> val(x2)
     if Val(x1)>0
       act(g:fac,'Total Mensual')
       acn(j:fac,Val(z3))
       SetFont(g:fac..j:fac,2)
       acn(z3,0)
       ifa
     Endif
     ifa
     acn(x2,Mes(FBN('Fecha')))
   endif

   scn(x1,1)
   ACT(a:fac,FBN['NrOperacion'])
   ACLO(a:fac,FBN['NrOperacion'])
* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
   If Incluido(fbn['TipoOp'],'CONU')
     ACT(b:fac, fbn('TSID'))
   EndIf

   ACD(c:fac,FBN['Fecha'])
   ACN(d:fac,FBN['Cantidad'])
   ACN(e:fac,SQL("Select "~DBO~".SaldoCONU('"~FBN['NrOperacion']~"','"~IdxDate(FBN['Fecha'])~"',2)"))
   AsignarLink(e:fac,'DETICL',Fecha1=Dialogo.Fecha1,Fecha2=FBN['Fecha'],NrOperacion1=fbn('NrOperacion'))
   ACT(f:fac,FBN['CodTasa'])    
   *    if Vacio(FBN['CodTasa'])
   *   ACN(g:fac,FBN['Tasa'])
   *Else
   *   ACN(g:fac,SQL("select Valor1 from "~DBO~".TASASDIA where TipoTasa = '"~FBN['CodTasa']~"' and Especie ='"~FBN['Especie']~"' and Fecha=  (select Max(Fecha) from "~DBO~".TASASDIA where Fecha<= '"~IdxDate(FBN['Fecha'])~"' and TipoTasa = '"~FBN['CodTasa']~"' and Especie ='"~FBN['Especie']~"') "))
   *Endif
   ACN(g:fac,FBN['Tasa1'])
   ACT(h:fac,FBN['CodSpread'])
   *if Vacio(FBN['CodSpread'])
   *    ACN(i:fac,FBN['Spread'])
   *Else
   *    ACN(i:fac,SQL("Select Precio1 from "~DBO~".COTIZACIONES where Codigo = '"~FBN['CodSpread']~"' and Fecha=  (select Max(Fecha) from "~DBO~".COTIZACIONES where Fecha<= '"~IdxDate(FBN['Fecha'])~"' and Codigo = '"~FBN['CodSpread']~"') "))
   *Endif
   ACN(i:fac,FBN['Tasa2'])
   ACN(j:fac,FBN['Monto'])
   scn(z3,FBN['Monto'])
    
Proximo

if Val(x1) > 0
   ifa
   act(g:fac,'Total Mensual')
   acn(j:fac,Val(z3))
   SetFont(g:fac..j:fac,2)
Endif

SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac,2)

LimitesVision(j:fac)
Rangotitulo(a:1..j:fac,Val(w2)+1)
SetPrintFit(3, 90)

