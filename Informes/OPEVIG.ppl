MostrarCuadroDeMensajes
ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo" ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
  Fecha1     : "Fecha"    ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Especie1   : "Especie"  ;
  Mercado1   : 'Mercado'  ;3;2;;;;;;;  
  Cliente1   : "Cliente"  ;;1
  Lista1     : "Tipo Op"  ;;;;;;;;;;;SQLSET("SELECT Codigo FROM "~DBO~".TIPOSOPERACION ORDER BY Codigo");;;;
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),80)

SetFilaActual(4)

ACT(k:2,'Fecha : '~Var('FECHASYS'))
SetFont(k:2..k:2,1)

ACT(f:FAC, "Operaciones Vigentes")
SetFont(f:fac..f:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
ACT(a:FAC+2, 'Fecha: '~Dialogo.Fecha1)
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1)
else
  ACT(a:FAC+3, 'Especies : Todas')
endif
if NoVacio(Dialogo.Mercado1)
  ACT(c:FAC+3, 'Mercado : '~Dialogo.Mercado1)
else
  ACT(c:FAC+3, 'Mercados : Todas')
endif
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+4, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+4, 'Cliente : Todos')
endif
if NoVacio(Dialogo.Lista1)
  ACT(A:FAC+5, 'Tipo Op. : '~Dialogo.Lista1)
else
  ACT(A:FAC+5, 'Tipo Op. : Todas')
endif

SetFilaActual(FAC+7)

ACT(A:FAC, "FechaVto")
ACT(B:FAC, "Especie")
ACT(C:FAC, "Mercado")
ACT(D:FAC, "Cliente")
ACT(E:FAC, "Cantidad")
ACT(F:FAC, "Tasa N.A.")
ACT(G:FAC, "Interes")
ACT(H:FAC, "Precio")
ACT(I:FAC, "Moneda")
ACT(J:FAC, "Monto")
ACT(K:FAC, "Aran/Der")
ACT(L:FAC, "Comisiones")
ACT(M:FAC, "Total en Pesos")
ACT(N:FAC, "Numero")
ACT(O:FAC, "F.Operacion")
ACT(P:FAC, "Operador")

ACN(ha1, fac)
ACN(Z4, Cotizacion('USD',,,,FSYS,1))
ACT(G:9,'Cotizacion USD: '~val(z4))

AlinearCeldas(a:FAC..D:FAC,'I')
AlinearCeldas(E:FAC..H:FAC,'D')
AlinearCeldas(I:FAC..I:FAC,'I')
SetFont(a:Val(w1)..P:FAC,2)
AgregarMarco(a:FAC..P:FAC,1,0,Exe('COLOR6'))

SetFilaActual(FAC)
SQL.ADD(" Select * from ")
SQL.ADD(" (SELECT Distinct O.*, T.Nombre, C.RazonSocial, E.TamanioLote, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TICF','TIVF') THEN O.Mercado ELSE O.Mercado4 END MercNeg ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, ")
SQL.ADD(" "~DBO~".TIPOSOPERACION T, "~DBO~".ESPECIES E, "~DBO~".CLIENTES C ")
SQL.ADD(" WHERE O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND   O.Especie  = E.Codigo ")
SQL.ADD(" AND   O.Cliente1 = C.Codigo ")
SQL.ADD(" AND   O.TipoOp   = T.Codigo ")
IF NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
IF NoVacio(Dialogo.Cliente1)
  SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("and O.TipoOp IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ENDIF
SQL.ADD("and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
* FO 27/09/2006 SQL.ADD("and (O.PaseCB <>1 or O.PaseCB is null) ")
SQL.ADD("and B.NrOperacion = O.NrOperacion ")
SQL.ADD("and B.Valor = '1' ")
SQL.ADD("and B.NrBit not in (30,31) ")
SQL.ADD(" ) as Aux")
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Where MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("ORDER BY TipoOp, MercNeg, FechaVto, Especie, Cliente1")

recorrer SQL
  
  IF Not EqStr(FBN['TipoOp']~FBN['MercNeg'], Val(Z2))
     IFA
     AgregarMarco(a:FAC..p:FAC,1,0, Exe('COLOR6'))
     ACT(a:FAC, FBN['TipoOp'])
     ACT(b:fac, fbn("Nombre"))
     ACT(c:fac, 'Mercado')
     ACT(d:fac, FBN['MercNeg'])
     message(Val(a:fac)~' - '~fbn("Nombre"))
     SetFont(a:FAC..p:FAC,2)
     IFA
     ACT(Z2,FBN['TipoOp']~FBN['MercNeg'])
  ENDIF

  message(fbn('NrOperacion'))
  ACT(A:FAC, FBN['FechaVto'])
  ACT(B:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
  ACT(C:FAC, FBN['MercNeg'])
  ACT(D:FAC, Copy(fbn('RazonSocial'),1,25))

** FJL 13/04/16 - Se cambia la logica para contemplar otros tipos de operacion
*  IF Incluido(FBN['TipoOp'],'TIDE|TICT|CTC|CFTC|CTP|CTC|TIC|CFTP|CCE|CPE|FXCTC')
*     ACN(D:FAC, FBN['Cantidad'])
*    ELSE
*     ACN(D:FAC, FBN['Cantidad']*(-1))
*  ENDIF
  IF Incluido(FBN['TipoOp'],'TIDE|TICT|CTC|CFTC|CTP|CTC|TIC|CFTP|CCE|CPE|FXCTC|FXCF') o Incluido(FBN['TipoOp'],'FXA|FXAT|FXC|FXCT|MMCT|MMCA|MMPF|MMPFCE')
     ACN(E:FAC, FBN['Cantidad'])
  ELSE
     ACN(E:FAC, FBN['Cantidad']*(-1))
  ENDIF

  If Incluido(fbn('TipoOp'), 'FXCTC|FXVTC|')  
     ACN(E:FAC, Val(D:FAC) * fbn('TamanioLote') )
  ENDIF

** FJL 13/04/16 - Se cambia la logica para contemplar otros tipos de operacion
  IF Incluido(FBN['TipoOp'], 'TIDE|TIPO|TICT|TICO') o Incluido(FBN['TipoOp'],'MMCO|MMCT|PMU|PME|MMPF|MMPFCE|MMOVN')
     ACN(F:fac, FBN['Precio1'])
  ENDIF
  IF Incluido(FBN['TipoOp'],'REPO|PAT|PAM|PATC|PPT|PPM|PPTC')
     ACN(F:fac, FBN['Precio3'])
  ENDIF
** FJL 13/04/16 - Se cambia la logica para contemplar otros tipos de operacion
*  IF Incluido(FBN['TipoOp'], 'TIDE|TIPO|TICT|TICO')
*     ACN(f:fac, FBN['TotalIntereses'])
*    else
*     IF Incluido(FBN['TipoOp'], 'TIDE|TICT')
*        ACN(f:fac, FBN['TotalIntereses']*(-1))
*     endif
*  ENDIF
  IF Incluido(FBN['TipoOp'],'TIDE|TICT|CTC|CFTC|CTP|CTC|TIC|CFTP|CCE|CPE|FXCTC|FXCF') o Incluido(FBN['TipoOp'],'FXA|FXAT|FXC|FXCT|MMCT|MMCA|MMPF|MMPFCE')
    ACN(z5, -1)
  else
    ACN(z5, 1)
  endif
  IF Incluido(FBN['TipoOp'], 'TIDE|TIPO|TICT|TICO') o Incluido(FBN['TipoOp'],'MMCO|MMCT|PMU|PME|MMPF|MMPFCE|MMOVN')
     ACN(G:fac, FBN['TotalIntereses']*Val(z:5))
  endif
**********************
** FJL 13/04/16 - Se cambia la logica para contemplar otros tipos de operacion
  IF Not [Incluido(FBN['TipoOp'],'TIDE|TIPO|TICT|TICO') o Incluido(FBN['TipoOp'],'MMCO|MMCT|PMU|PME|MMPF|MMPFCE|MMOVN')]
     ACN(H:fac, FBN['Precio1'])
  ENDIF
  ACT(I:FAC, FBN['Contraespecie'])
** FJL 13/04/16 - Se cambia la logica para contemplar otros tipos de operacion
*  IF EqStr(Copy(FBN['TipoOp'],1,1), 'T')
*     ACN(i:fac, FBN['TotalBrutoCli1'])
*  ELSE
*     ACN(i:fac, FBN['TotalNetoCli1'])
*  ENDIF
   ACN(J:fac, FBN['TotalBrutoCli1']*Val(z:5))
**********************

  *- Derechos (Bolsa+Mercado+IVA Mercado) + Aranceles + IVA Aranceles
  If Incluido(FBN['TipoOp'],'CTP|CTC|CFTP|CBT|CBC|PABC|PABT|VFTP|VTC|VTP')
     ACN(K:FAC, fbn['TotalAux1']+fbn['TotalAux2']+fbn['TotalGastos']+fbn['Comision']+fbn['TotalImpuestos'])
     ACN(K:FAC, Val(K:FAC)*(-1))
  Else
     ACN(K:FAC, 0)
  EndIf

  *- Comision+IVA (IVA para las que tienen, sino solo comision)
  If Incluido(FBN['TipoOp'],'CTP|CTC|CFTP|CBT|CBC|PABC|PABT|VFTP|VTC|VTP')
     ACN(L:FAC, FBN['TotalAux3']+FBN['TotalIVA'])
  Else
     If Incluido(FBN['TipoOp'],'TIC|TIFC|TIFV|TIPA|TIPP|TIV|TVC|TVP|VFTC|CFTC|TCC|TCP')
        ACN(L:FAC, FBN['TotalComisiones'])
     Else
        If EqStr(FBN['TipoOp'],'PFCU')
           ACN(L:FAC, FBN['Precio2'])
        EndIf
     EndIf
  EndIf
  ACN(L:FAC, Val(L:FAC)*(-1))

** FJL 13/04/16 - Se cambia la logica para contemplar otros tipos de operacion
  if Incluido(FBN['TipoOp'],'FXA|FXAT|FXC|FXCT|FXCF|FXV|FXVT|FXVF|MMCO|MMCT|PMU|PME|MMCA|MMPF|MMPFCE|MMOVN')
    if Incluido(FBN['TipoOp'],'MMCO|MMCT|PMU|PME|MMCA|MMPF|MMPFCE|MMOVN')
      if EqStr(fbn('Especie'),'ARP')
      ACN(M:fac, FBN['TotalBrutoCli1']*Val(z:5))
      else
      ACN(M:fac, FBN['TotalBrutoCli1']*Cotizacion(fbn('Especie'),,,,FSYS,1)*Val(z:5))
      endif
    else
      if Incluido(FBN['TipoOp'],'FXC|FXCT|FXCF|FXV|FXVT|FXVF444')
        if EqStr(fbn('ContraEspecie'),'ARP')
        ACN(M:fac, FBN['TotalBrutoCli1']*Val(z:5))
        else
        ACN(M:fac, FBN['TotalBrutoCli1']*Cotizacion(fbn('ContraEspecie'),,,,FSYS,1)*Val(z:5))
        endif
      else
      ACN(M:fac, FBN['TotalBrutoCli1']*Cotizacion(fbn('ContraEspecie'),,,,FSYS,1)*Val(z:5))
      endif
    endif
  else
  ACN(M:fac, FBN['TotalNetoCli1'])
    IF EqStr(Copy(FBN['TipoOp'],1,1), 'C')
      If Incluido(FBN['TipoOp'], 'CTP|CFTP')
        *- Monto + Comision + Iva Comision + DM + DB + IVA DM
        ACN(M:fac, FBN['TotalNetoCli1']-Val(L:FAC)+fbn['TotalAux1']+fbn['TotalAux2']+fbn['TotalGastos'])
      Else
        If EqStr(FBN['TipoOp'], 'CTC')
        ACN(M:fac, FBN['TotalNetoCli1']-Val(L:FAC))
        EndIf
      EndIf
    ELSE
      If Incluido(FBN['TipoOp'], 'VTP|VFTP')
        *- Monto - Comision - Iva Comision - DM - DB - IVA DM
        ACN(M:fac, FBN['TotalNetoCli1']+Val(L:FAC)-fbn['TotalAux1']-fbn['TotalAux2']-fbn['TotalGastos'])
      Else
        If EqStr(FBN['TipoOp'], 'VTC')
        ACN(M:fac, FBN['TotalNetoCli1']+Val(L:FAC))
        EndIf
      EndIf
    ENDIF
  endif
  ACT(N:FAC, FBN['NrOperacion'])
  ACLO(N:fac, fbn('NrOperacion'))
  ACT(O:FAC, FBN['FechaOp'])
  ACT(P:FAC, FBN['Operador'])
  AlinearCeldas(a:FAC..a:FAC,'D')
  AlinearCeldas(O:FAC..O:FAC,'D')
