CrearDialogo
  Fecha1 : 'Desde';;;;;;;;;Hoy
  Fecha2 : 'Hasta';;;;;;;;;Hoy
  Operador: 'Usuario'
  Check1  : 'Resumido'           ;;;;;;;;;0;
  Radio1  : 'Accion|A|B|M|Todos' ;;;;;;;;;3
FinDialogo

if not Ok
   Cancelar
endif


CrearFont(3, 'Arial,11,B')
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a3, 'Log Total de Modificaciones - Scripts')
SetFont(a3..a3, 3)

ACT(a5, 'Fecha : '~Dialogo.Fecha1)
ACT(a6, 'Archivo : Parametrizacion ' )
ACT(a7, 'Usuario')
ACT(b7, 'Fecha')
ACT(c7, 'Accion')
ACT(d7, 'Tabla')
ACT(e7, 'Codigo')
ACT(f7, 'Campo')
ACT(g7, 'Val.Anterior')
ACT(h7, 'Val.Actual')

SetFilaActual(7)
If Dialogo.Check1=1
   SQL.ADD("select Distinct Tabla,Codigo ")
Else
   SQL.ADD("select Tabla,Codigo,Accion,Fecha,ValorAnterior,ValorActual,Operador,Campo ")
Endif
SQL.ADD("from "~DBO~".PMAUDIT where ")
SQL.ADD(" Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha <= '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD(" AND Tabla IN ('INFORMES','EVENTOS','FUNCIONES','FORMULAS','TIPOSOPERACION','TIPOSORDEN','TIPOSMINUTABOLSA','TIPOSTRANSACCION2') ")
IF NoVacio(Dialogo.Operador)
   SQL.ADD(" AND Operador = '"~Dialogo.Operador ~"' ")
ENDIF
If Dialogo.Radio1=0
   SQL.ADD(" AND Accion = 'A' ")
endif
If Dialogo.Radio1=1
   SQL.ADD(" AND Accion = 'B' ")
endif
If Dialogo.Radio1=2
   SQL.ADD(" AND Accion = 'M' ")
endif
If Dialogo.Check1=1
   SQL.ADD("order by  Tabla,Codigo ")
Else
  SQL.ADD("order by  Tabla,Fecha, Codigo, Accion ")
Endif

Recorrer SQL
  acn(x1, 0)

  If Dialogo.Check1 = 0
    If Not EqStr(Val(z1), fbn('Tabla')~fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
       ACT(z1,    fbn('Tabla')~fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
       ACT(a:FAC, fbn('Operador'))
       ACT(b:FAC, fbn('Fecha'))
       ACT(c:FAC, fbn('Accion'))
       ACT(d:FAC, fbn('Tabla'))
       ACT(e:FAC, fbn('Codigo'))
       scn(x1, 1)
    Endif
    If [EqStr(fbn('Accion'),'A') y NoVacio(fbn('ValorActual'))] o [EqStr(fbn('Accion'),'M') y Not EqStr(fbn('ValorActual'),fbn('ValorAnterior'))] o [EqStr(fbn('Accion'),'B') y NoVacio(fbn('ValorAnterior'))]
       ACT(f:FAC, fbn('Campo'))
       ACT(g:FAC, fbn('ValorAnterior'))
       ACT(h:FAC, fbn('ValorActual'))
    Else
      If Val(x1) = 0
         dfa
      Endif
    Endif
  Else
    ACT(d:FAC, fbn('Tabla'))
    ACT(e:FAC, fbn('Codigo'))
  Endif
Proximo


ACO(1,8)
ACO(2,15)
ACO(3,4)
ACO(4,12)
ACO(5,8)
ACO(6,10)
ACO(7,10)
ACO(8,10)

SetFont(a5..z7, 1)
SetFont(a8..z:fac, 2)
AgregarMarco(a7..h7,1,0,Exe('COLOR6'))

LimitesVision(h:fac)
SetPrintFit(3,90)