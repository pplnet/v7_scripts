CrearDialogo
    NROPERACION1: '# Minuta:' ;;;;;;NOVACIO(Dialogo.NROPERACION1);"Debe ingresar un # Minuta";NO
FinDialogo

If not OK
  Cancelar
endif

CrearFont(1,'Arial,10,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')
CrearFont(4,'Arial,7,B')

SQL.ADD("Select  NrAsiento [# Asiento], Cta, FGeneracion [F. Generacion], FValor [F. Valor],  Leyenda, sum(DB) DB, sum(CR) CR, sum(Neto) Neto FROM ")
SQL.ADD("  (Select                                                                ")
SQL.ADD("   Det.NrUnicoAsiento NrAsiento,                                         ")
SQL.ADD("   FechaGeneracion FGeneracion,                                          ")
SQL.ADD("   FechaValor      FValor,                                               ")
SQL.ADD("   rtrim(det.Cuenta) + ' - ' + cc.Nombre  Cta,                           ")
SQL.ADD("   det.Alias4      Leyenda,                                              ")
SQL.ADD("   case when debitocredito = 'DEB' then  1 else 0 end * Cantidad1 DB,    ")
SQL.ADD("   case when debitocredito = 'CRE' then  1 else 0 end * Cantidad1 CR,    ")
SQL.ADD("   case when debitocredito = 'DEB' then  1 else -1 end * Cantidad1 NETO  ")
SQL.ADD("From   "~DBO~".asientoscon cab                                           ")
SQL.ADD("       inner join "~DBO~".asientoscon1 det                               ")
SQL.ADD("           on  cab.NrUnicoAsiento  = det.nrUnicoAsiento                  ")
SQL.ADD("       left  join "~DBO~".modelosasiento mod                             ")
SQL.ADD("           on  cab.Modelo      = mod.codigo                              ")
SQL.ADD("       left  join "~DBO~".tiposasiento tip                               ")
SQL.ADD("           on  tip.codigo      = mod.tipoasiento                         ")
SQL.ADD("       left  join "~DBO~".contabilidad     cc                            ")
SQL.ADD("           on  cc.codigo       = det.Cuenta                              ")
SQL.ADD("where  cab.NrOperacion = '"~Dialogo.NrOperacion1~"'                      ")
SQL.ADD("  ) AS AUX                                                               ")
SQL.ADD("Group by NrAsiento, FGeneracion, FValor, Leyenda, Cta                    ")

ACT(a:1, 'Detalle Contable por Operacion ' ~ Dialogo.NrOperacion1)

ACT(a:3, 'Asientos')

ACT(a:5,'Nro. Asiento')
ACT(b:5,'Cuenta')
ACT(c:5,'F. Generacion')
ACT(d:5,'F. Valor ')
ACT(e:5,'Leyenda ')
ACT(f:5,'DB')
ACT(g:5,'CR')
ACT(h:5,'Neto')

SetFilaActual(6)

Recorrer SQL
    Message(fbn('# Asiento'))
    ACT(a:fac, fbn('# Asiento'))
    ACT(b:fac, fbn('Cta'))
    ACD(c:fac, fbn('F. Generacion'))
    ACD(d:fac, fbn('F. Valor'))
    ACT(e:fac, fbn('Leyenda'))
    ACN(f:fac, fbn('DB'))
    ACN(g:fac, fbn('CR'))
    ACN(h:fac, fbn('Neto'))
Proximo

SetFont(a1,1)
SetFont(a:3,2)
SetFont(a:5..h:5,2)
SetFont(a:6..f:fac,3)

AgregarMarco(a:5..h:5,0,0,RGB(255,255,255))

SetFilaActual(fac+3)

SQL.ADD("Select *  ")
SQL.ADD("from  ")
SQL.ADD("(Select  null [A], Cta, FGeneracion [F. Generacion], FValor [F. Valor],  null [ ], sum(DB) DB, sum(CR) CR, sum(Neto) Neto FROM  ")
SQL.ADD("(Select                                                                  ")
SQL.ADD("   FechaGeneracion FGeneracion,                                          ")
SQL.ADD("   FechaValor      FValor,                                               ")
SQL.ADD("   rtrim(det.Cuenta) + ' - ' + cc.Nombre  Cta,                           ")
SQL.ADD("   case when debitocredito = 'DEB' then  1 else 0 end * Cantidad1 DB,    ")
SQL.ADD("   case when debitocredito = 'CRE' then  1 else 0 end * Cantidad1 CR,    ")
SQL.ADD("   case when debitocredito = 'DEB' then  1 else -1 end * Cantidad1 NETO  ")
SQL.ADD("From   "~DBO~".asientoscon cab                                           ")
SQL.ADD("       inner join "~DBO~".asientoscon1 det                               ")
SQL.ADD("           on  cab.NrUnicoAsiento  = det.nrUnicoAsiento                  ")
SQL.ADD("       left  join "~DBO~".modelosasiento mod                             ")
SQL.ADD("           on  cab.Modelo      = mod.codigo                              ")
SQL.ADD("       left  join "~DBO~".tiposasiento tip                               ")
SQL.ADD("           on  tip.codigo      = mod.tipoasiento                         ")
SQL.ADD("       left  join "~DBO~".contabilidad cc                                ")
SQL.ADD("           on  cc.codigo       = det.Cuenta                              ")
SQL.ADD("where  cab.NrOperacion = '"~Dialogo.NrOperacion1~"'                      ")
SQL.ADD(") AS AUX                                                                 ")
SQL.ADD("Group by Cta, FGeneracion, FValor                                        ")
SQL.ADD("with rollup) AUX2                                                        ")
SQL.ADD("where  ([F. Generacion] is null or [F. Valor] is not null) and           ")
SQL.ADD("   Cta is not null                                                       ")

ACT(a:fac-2, 'Resumen')
SetFont(a:Fac-2,2)

ACT(a:fac,'Nro. Asiento')
ACT(b:fac,'Cuenta'      )
ACT(c:fac,'F. Generacion')
ACT(d:fac,'F. Valor ')
ACT(e:fac,'Leyenda ')
ACT(f:fac,'DB')
ACT(g:fac,'CR')
ACT(h:fac,'Neto')

SetFilaActual(fac+1)

Recorrer SQL
    SCN(xx:2,1)
    Message(fbn('# Asiento'))
    ACT(a:fac, fbn('# Asiento'))
    ACT(b:fac, fbn('Cta'))
    ACD(c:fac, fbn('F. Generacion'))
    ACD(d:fac, fbn('F. Valor'))
    ACT(e:fac, fbn('Leyenda'))
    ACN(f:fac, fbn('DB'))
    ACN(g:fac, fbn('CR'))
    ACN(h:fac, fbn('Neto'))
Proximo

ACN(xx:1, fac-val(xx:2)-1)

AgregarMarco(a:val(xx:1)..h:val(xx:1),0,0,RGB(255,255,255))
SetFont(a:val(xx:1)..h:val(xx:1),2)
SetFont(a:val(xx:1)+1..f:fac,3)

ACO(3,9)

ACT(a:fac+1,"End of Report")
SetFont(a:Fac+1,2)
LimitesVision(i:fac+2)


