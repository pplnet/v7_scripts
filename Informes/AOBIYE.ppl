MostrarCuadroDeMensajes
CrearDialogo
  Radio3   :'|Contenido|Contiene|'            ;1;1;;;;Dialogo.Radio2 >= 0;'Seleccion Invalida';NO;0 
  Radio1   :'Ordenamiento|Codigo|Nombre|'     ;1;2;;;;Dialogo.Radio1 >= 0;'Ordenamiento Invalido';NO;0 
  Radio2   :'Tipo|Informe|Evento|Funciones'   ;2;1;;;                ;Dialogo.Radio2 >= 0;'Seleccion Invalida';NO;0
  Informe1 :'Informes'                        ;3;1;;;Dialogo.Radio2=0;[Dialogo.Radio2=0 y NoVacio(Dialogo.Informe1)] o Dialogo.Radio2<>0;'Ingresar Informe';NO;;;
  Evento1  :'Eventos'                         ;3;1;;;Dialogo.Radio2=1;[Dialogo.Radio2=1 y NoVacio(Dialogo.Evento1)] o Dialogo.Radio2<>1;'Ingresar Evento';NO;;;
  Funcion1 :'Funciones'                       ;3;1;;;Dialogo.Radio2=2;[Dialogo.Radio2=2 y Novacio(Dialogo.Funcion1)] o [Dialogo.Radio2<>2];"Ingresar Funcion";NO;;;
FinDialogo

if Not OK
  Cancelar
endif


** Fonts
CrearFont(1,'Tahoma,14,B,S')
CrearFont(3,'Arial,9,B')
CrearFont(2,'Arial,9,B,S')
CrearFont(4,'Arial,8,')

** Titulos
AgregarBMP(a1,Exe('LOGO'),80)
ACT(c:2, 'Objetos en Informes/Eventos/Funciones')

if Dialogo.Radio1=0
   ACT(c:3,'Ordenado por Codigo')
else
   ACT(c:3,'Ordenado por Nombre')
endif

AlinearCeldas(c:2..c:3,'C')
SetFont(c:2, 1)
SetFilaActual(5)
ACT(a:fac-1,'Fecha :  '~VAR('FECHASYS'))
SetFont(a:FAC-1, 3)
ACT(z1,iif(Dialogo.Radio2=0,'Informe '~Dialogo.Informe1~' - '~BuscarCampo('INFORMES','Nombre','Codigo',Dialogo.Informe1),iif(Dialogo.Radio2=1,'Evento '~Dialogo.Evento1~' - '~BuscarCampo('EVENTOS','Nombre','Codigo',Dialogo.Evento1),'Funcion '~Dialogo.Funcion1~' - '~BuscarCampo('FUNCIONES','Descripcion','Codigo',Dialogo.Funcion1) ) ))

ACT(a:fac,'Objetos '~iif(Dialogo.Radio3=0,'donde esta llamado el/la '~val(z1),'que contiene el/la '~val(z1)) )

SetFont(a:Fac, 2)

SetFilaActual(fac+2)

act(a:fac, "Codigo")
act(b:fac, "Nombre")
act(c:fac, "Menu")
act(d:fac, "Descripcion")

SetFont(a:fac..d:fac,3)
AgregarMarco(a:fac..d:fac,2,0,RGB(254,228,126))

ACN(xy1,fac)

Message('Recuperando Informacion.....')

if Dialogo.Radio3=0
*  Contenido - Donde se ejecuta 
   if Dialogo.Radio2=0
      * Informe
     ACT(aa1, BuscarEnTablas('INFORMES', Dialogo.Informe1))
     ACT(aa2, BuscarEnTablas('EVENTOS', Dialogo.Informe1))
     ACT(aa3, BuscarEnTablas('FUNCIONES', Dialogo.Informe1))
   else
     if Dialogo.Radio2=1
        * Evento
        ACT(aa1, BuscarEnTablas('INFORMES', Dialogo.Evento1))
        ACT(aa2, BuscarEnTablas('EVENTOS', Dialogo.Evento1))
        ACT(aa3, BuscarEnTablas('FUNCIONES', Dialogo.Evento1))
     else
        * Funcion
        ACT(aa1, BuscarEnTablas('INFORMES', Dialogo.Funcion1))
        ACT(aa2, BuscarEnTablas('EVENTOS', Dialogo.Funcion1))
        ACT(aa3, BuscarEnTablas('FUNCIONES', Dialogo.Funcion1))
     endif
   endif
else
*  Contiene - Que objetos ejecuta
   if Dialogo.Radio2=0
      * Informe
      ACT(aa1, BuscarLinkearHojas('INFORMES', Dialogo.Informe1))
      ACT(aa2, BuscarEjecutarEventos('INFORMES', Dialogo.Informe1))
      ACT(aa3, BuscarFunciones('INFORMES', Dialogo.Informe1))
   else
      if Dialogo.Radio2=1
         * Evento
         ACT(aa1, BuscarLinkearHojas('EVENTOS', Dialogo.Evento1))
         ACT(aa2, BuscarEjecutarEventos('EVENTOS', Dialogo.Evento1))
         ACT(aa3, BuscarFunciones('EVENTOS', Dialogo.Evento1))
      else
         * Funcion
         ACT(aa1, BuscarLinkearHojas('FUNCIONES', Dialogo.Funcion1))
         ACT(aa2, BuscarEjecutarEventos('FUNCIONES', Dialogo.Funcion1))
         ACT(aa3, BuscarFunciones('FUNCIONES', Dialogo.Funcion1))
      endif
   endif
endif




SCN(xy1,1)
ACT(a:val(xy1), 'Informes')
SetFont(a:val(xy1), 3)

if NoVacio(Val(aa1))

   ACN(xy99,Elementos(Val(aa1)))
   ACN(vx1,Val(xy1))
   ACN(xy50,0)
   Message('Paso 1 de 3 - Informes')

   Recorrer&i 1,Val(xy99)

     SCN(xy50,1)     
     Message('Informes '~PYC(Val(xy50),1,0)~' de '~PYC(Val(xy99),1,0))

     SCN(xy1,1)
     ACT(t1,Mirt(Trim (ItemLista(Val(aa1), &i))))
     ACT(a:val(xy1), val(t1))

     SQL.ADD("select I.Tipo, I.Nombre, T.Descripcion ")
     SQL.ADD("from "~DBO~".INFORMES I, "~DBO~".TIPOSINFORME T  ")   
     SQL.ADD("where I.Codigo = '"~Val(t1)~"'  ")
     SQL.ADD(" and T.Codigo= I.Tipo ")

     Recorrer SQL
       act(b:val(xy1),fbn('Nombre'))
       act(c:val(xy1),fbn('Tipo'))
       act(d:val(xy1),fbn('Descripcion'))

     Proximo 
  Proximo
  if Dialogo.Radio1=0
     OrdenarFilas(Val(vx1)+1,Val(xy1),1,'A')
  else
     OrdenarFilas(Val(vx1)+1,Val(xy1),2,'A')
  endif
else
   SCN(xy1,1)
   ACT(b:val(xy1),'Sin Movimientos')
endif

SCN(xy1,1)
ACT(a:val(xy1), 'Eventos')
SetFont(a:val(xy1), 3)

if NoVacio(Val(aa2))

   ACN(xy99,Elementos(Val(aa2)))
   ACN(vx1,Val(xy1))
   ACN(xy50,0)
   Message('Paso 2 de 3 - Eventos')

   Recorrer&i 1,Val(xy99)
     SCN(xy50,1)     
     Message('Eventos '~PYC(Val(xy50),1,0)~' de '~PYC(Val(xy99),1,0))

     SCN(xy1,1)
     ACT(t1,Mirt(Trim (ItemLista(Val(aa2), &i))))
     ACT(a:val(xy1), val(t1))

     SQL.ADD("select E.Tipo, E.Nombre, T.Descripcion ")
     SQL.ADD("from "~DBO~".EVENTOS E, "~DBO~".TIPOSEVENTO T  ")   
     SQL.ADD("where E.Codigo = '"~Val(t1)~"'  ")
     SQL.ADD(" and T.Codigo= E.Tipo ")

     Recorrer SQL
       act(b:val(xy1),fbn('Nombre'))
       act(c:val(xy1),fbn('Tipo'))
       act(d:val(xy1),fbn('Descripcion'))
     Proximo 

   Proximo
   if Dialogo.Radio1=0
      OrdenarFilas(Val(vx1)+1,Val(xy1),1,'A')
   else
      OrdenarFilas(Val(vx1)+1,Val(xy1),2,'A')
   endif
else
   SCN(xy1,1)
   ACT(b:val(xy1),'Sin Movimientos')
endif




SCN(xy1,1)
ACT(a:val(xy1), 'Funciones')
SetFont(a:val(xy1), 3)

if NoVacio(Val(aa3))

   ACN(xy99,Elementos(Val(aa3)))
   ACN(vx1,Val(xy1))
   ACN(xy50,0)
   Message('Paso 3 de 3 - Funciones')

   Recorrer&i 1,Val(xy99)
     SCN(xy50,1)     
     Message('Funciones '~PYC(Val(xy50),1,0)~' de '~PYC(Val(xy99),1,0))

     SCN(xy1,1)
     ACT(t1,Mirt(Trim (ItemLista(Val(aa3), &i))))
     ACT(a:val(xy1), val(t1))
     ACT(b:val(xy1), Sql("Select Descripcion from "~DBO~".FUNCIONES where Codigo='"~Val(t1)~"' "))
   Proximo
   if Dialogo.Radio1=0
      OrdenarFilas(Val(vx1)+1,Val(xy1),1,'A')
   else
      OrdenarFilas(Val(vx1)+1,Val(xy1),2,'A')
   endif
else
   SCN(xy1,1)
   ACT(b:val(xy1),'Sin Movimientos')
endif


if Val(xy1) <= 7
   SCN(xy1,3)   
   ACT(b:Val(xy1),'No hay objetos para esta seleccion')
endif


ACO(1, 8)
ACO(2, 28)
ACO(3, 8)
ACO(4, 28)
ACO(5, 1)

setfilaactual(val(xy1)+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(A:fac, 2)
*Impresion(1,2)
*Impresion(4,1)

Impresion(1,1)
SetPrintFit(3,90)


LimitesVision(e:fac+1)
SetMargins(0.5,0.5,0.5,1.5)
RangoTitulo(a:1..d:fac+1, val(vx1))