* Acumuladores
ACN(WI:1,0)
ACN(WI:2,0)

* Comparación con String Blancos  
ACT(cu:1, '') 

CrearDialogo   
  Fecha1       : 'Desde'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar una Fecha Desde';NO;Fsys
  Fecha2       : 'Hasta'       ;;;;;;NoVacio(Dialogo.Fecha2);'Debe Ingresar una Fecha Desde';NO;Fsys
  Especie1     : 'Especie'     ;;;;;;;;;
  PrecioRef1   : 'PrecioRef'
  TipoTasa1    : 'TipoTasa'
FinDialogo

If Not Ok
  Cancelar
Endif

MostrarCuadroDeMensajes
CrearFont(1,"Arial,10,")
CrearFont(2,"Arial,10,B")
CrearFont(4,"Arial,12,B")
CrearFont(3,"Arial,8,")
SetFilaActual(1)

ACT(a:FAC, 'Informe TasasDia por Fecha')
SetFont(A:Fac..A:Fac, 4)

SetFilaActual(FAC+8)
ACT(a:FAC,'Prec.Ref')
ACT(B:FAC,'TipoTasa')
ACT(C:FAC,'Fecha')
ACT(D:FAC,'Especie')
ACT(E:FAC,'P.Desde')
ACT(F:FAC,'P.Hasta')
ACT(G:FAC,'Tasa')
ACT(H:FAC,'Fact.Desc.')

SetFont(a:FAC..H:FAC,2)
AlinearCeldas(a:FAC..H:FAC,'C')
AgregarMarco(a:FAC..H:FAC,1,1,Exe('COLOR'))

SQL.ADD(" SELECT TD.Especie, TD.Fecha, TD.PlazoDesde, TD.PlazoHasta, TD.TipoTasa, TD.Valor1, TD.Valor4, TT.Codigo, TT.PrecioRef   ")
SQL.ADD(" FROM   "~DBO~".TASASDIA TD,  "~DBO~".TIPOSTASA TT ")
SQL.ADD(" WHERE TD.Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("and TT.Codigo = TD.TipoTasa ")

ACT(A:3, 'Fecha desde: '~Dialogo.Fecha1)
ACT(A:4, 'Fecha hasta: '~Dialogo.Fecha2)

If NoVacio(Dialogo.Especie1)
  ACT(A:5, 'Especie: '~Dialogo.Especie1)
  SQL.ADD("and TD.Especie = '"~Dialogo.Especie1~"'")
Else
  ACT(A:5, 'Especie: Todas')
Endif

If NoVacio(Dialogo.PrecioRef1)
  ACT(A:6, 'PrecioRef: '~Dialogo.PrecioRef1)
  SQL.ADD("and TT.PrecioRef = '"~Dialogo.PrecioRef1~"'")
Else
  ACT(A:6, 'PrecioRef: Todas')
EndIf

If NoVacio(Dialogo.TipoTasa1)
  ACT(A:7, 'Tipo de Tasa: '~Dialogo.TipoTasa1)
  SQL.ADD("and TD.TipoTasa = '"~Dialogo.TipoTasa1~"'")
else
  ACT(A:7, 'Tipo de Tasa: Todas')
EndIf

SQL.ADD(" ORDER BY TT.PrecioRef, TD.Fecha, TD.PlazoHasta ")
SetFont(A:3..A:7, 2)

Recorrer SQL

  ACT(a:fac, fbn('PrecioRef'))    
  ACT(B:fac, fbn('TipoTasa'))   
  ACT(C:fac, fbn('Fecha')) 
  ACT(D:fac, fbn('Especie'))           
  ACT(E:fac, fbn('PlazoDesde'))
  ACT(F:fac, fbn('PlazoHasta'))
  ACN(G:fac, fbn('Valor1')) 
  ACT(H:fac, fbn('Valor4'))  

  FormatoCeldas(e:fac..H:fac,Exe('F8')) 
  AlinearCeldas(a:FAC..H:FAC,'C') 
  SetFont(A:Fac..H:Fac,3)                      

Proximo

ACT(A:FAC+2, 'Fin del Informe.')  
SetFont(A:FAC+2, 2)                      

LimitesVision(E:Fac+2)
ACO(1,7)
ACO(2,8)
ACO(3,9)
ACO(4,9)
ACO(5,8)
ACO(6,8)
ACO(7,12)
ACO(8,12)

Impresion(1,2)