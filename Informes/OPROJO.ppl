*ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"   ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Veh¡culo';NO;VAR('VEHICULODE')
  Cliente1   : "Cliente"    ;2;1;
  Operador1  : "Trader"     ;2;2;
  Especie1   : "Especie"    ;3;1; 
  Mercado1   : 'Mercado'    ;3;2;;;;;;;    
  Fecha1     : "D.Concert"  ;4;1; ;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha2     : "H.Concert"  ;5;1; ;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha3     : "D.Vencim"   ;4;2; ;;;Dialogo.Fecha3<>0;'Debe Ingresar una Fecha';NO;FSys;
  Fecha4     : "H.Vencim"   ;5;2; ;;;Dialogo.Fecha4<>0;'Debe Ingresar una Fecha';No;FSys+30;
  Lista2     : "ClaseOp."   ;6;1;;;;;;;;;VAR('VEHICULODE')  
  Lista1     : "Tipos Op."  ;0;2;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION "~IIF(NoVacio(Dialogo.Lista2)," where ClaseOperacion IN ("~Pipe2Comillas(Dialogo.Lista2)~")"," "));
  ListaClaves: "Orden"      ;1;1;;;;;;;;;Operaciones
FinDialogo

if Not Ok
  Cancelar
endif

if [Not Vacio(Dialogo.Vehiculo1)] y [Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))]
   Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

AgregarBMP(a1,Exe('LOGO'),80)

SetFilaActual(3)

ACT(i:FAC, "Operaciones Retrocedidas a Carga Trader")
SetFont(i:fac..i:fac,3)

SetFilaActual(4)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~' '~BuscarCampo('VEHICULOS','Cliente','Codigo', Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Cliente : '~Dialogo.Cliente1~'  '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Cliente : Todos')
endif

if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+3, 'Especies : Todas')
endif

if NoVacio(Dialogo.Lista1)
  ACT(e:FAC+1, 'Tipo Op. : '~Pipe2coma(Dialogo.Lista1))
else
  ACT(e:FAC+1, 'Tipo Op. : Todas')
endif

ACT(e:FAC+2, 'F.Concertacion: '~Dialogo.Fecha1~' - '~Dialogo.Fecha2)
*ACT(g:FAC+2, Dialogo.Fecha2)
ACT(e:FAC+3, 'F.Vencimiento: '~Dialogo.Fecha3~' - '~Dialogo.Fecha4)
*ACT(g:FAC+3, Dialogo.Fecha4)

if NoVacio(Dialogo.Mercado1)
  ACT(a:FAC+4, 'Mercado : '~Dialogo.Mercado1)
else
  ACT(a:FAC+4, 'Mercados: Todos')
endif

SetListaClaves(1)
If Vacio(Dialogo.ListaClaves)
  ACT(e:FAC+4, "Orden : por NrOperacion")
Else
  ACT(e:FAC+4, "Orden : "~Pipe2coma(Dialogo.ListaClaves))
Endif

SetListaClaves(2)
if NoVacio(Dialogo.Operador1)
  ACT(a:FAC+5, 'Operador : '~Dialogo.Operador1)
else
  ACT(a:FAC+5, 'Operador : Todos')
endif

SetFont(a:FAC..r:FAC+8,2)

SetFilaActual(10)
ACN(fi:1,FAC)

ACT(a:FAC, "Operacion")
ACT(b:FAC, "TipoOp")
ACT(c:FAC, "Mercado")
ACT(d:FAC, "FechaOp")
ACT(e:FAC, "Vto.Esp.")
ACT(f:FAC, "Vto.CEsp.")
ACT(g:FAC, "Plazo")
ACT(h:FAC, "Cliente")
ACT(i:FAC, "Razon Social")
ACT(j:FAC, "Especie ")
ACT(k:FAC, "C.Especie")
ACT(l:FAC, "Cantidad")
ACT(m:FAC, "Precio/Tasa")
ACT(n:FAC, "Total Bruto")
ACT(o:FAC, "Intereses")
ACT(p:FAC, "Total Neto")
ACT(q:FAC, "F.Carga")
ACT(r:FAC, "Nr.Boleto")
ACT(s:FAC, "C.Cust")
ACT(t:FAC, "Op.Refer.")
ACT(u:FAC, "Operador")
ACT(v:FAC, "Orden")
AlinearCeldas(e:FAC..g:FAC,'D')
AlinearCeldas(l:FAC..q:FAC,'D')
SetFont(a:fac..w:FAC,2)
AgregarMarco(a:fac..w:FAC,2,0,Exe('COLOR'))


SQL.ADD(" Select * from ")
SQL.ADD(" (SELECT O.*, I.Nombre, C.RazonSocial, TI.ClaseOperacion, ")
SQL.ADD(" CASE WHEN  TipoOp in ('TICF','TIVF') THEN Mercado ELSE Mercado4 END MercNeg ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I, "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION TI ")
SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")
SQL.ADD("and B.NrOperacion = O.NrOperacion and B.Valor = '1' ") 
SQL.ADD("and B.NrBit = 1 ")
SQL.ADD("and I.NrInstancia = B.NrBit and I.Tabla = 'OPERACIONES' ")
SQL.ADD("and O.Cliente1  = C.Codigo ") 
SQL.ADD("and O.TipoOp  = TI.Codigo ") 
SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and O.Direccion = 1 ")  
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and O.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Operador1)
  SQL.ADD(" and O.Operador = '"~Dialogo.Operador1~"' ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~")")
endif
SQL.ADD(" ) as Aux")
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" Where MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf
if NoVacio(Dialogo.ListaClaves)
  SQL.ADD(" order by "~Dialogo.ListaClaves)
Else
  SQL.ADD("order by NrOperacion ")
endif

Recorrer SQL

   message(fbn('NrOperacion'))

   *** Depende el tipo de operaci¢n, las columnas de cantidades van a tener signo positivo o negativo
   ACN(ab:1,iif(Incluido(fbn['TipoOp'],'CBC|MMFCR|PABC|PBC|VBL|VCP|VFTC|VPP|VTC|VTP|VTPC'),-1,1)) 

   ACT(a:fac, FBN['NrOperacion'])
   ACLO(a:fac, FBN['NrOperacion'])
   ACT(b:fac, FBN['TipoOp'])
   ACT(c:fac, FBN['MercNeg'])
   ACT(d:fac, FBN['FechaOp'])
   ACT(e:fac, FBN['FechaVto'])
   ACD(f:fac, FBN['FechaPago'])
   ACN(g:fac, FBN['Plazo'])
   ACT(h:fac, FBN['Cliente1'])
   ACT(i:fac, Copy(FBN['RazonSocial'],1,30))
   ACT(j:fac, FBN['Especie'])
   ACT(k:fac, FBN['ContraEspecie'])
   ACN(k:fac, FBN['Cantidad']*val(ab:1))
   ACN(m:fac, FBN['Precio1'])
   ACN(n:FAC, FBN['TotalBrutoCli1']*val(ab:1))
   ACN(o:FAC, FBN['TotalIntereses']*val(ab:1))
   ACN(p:FAC, FBN['TotalNetoCli1']*val(ab:1))
   ACD(q:fac, FBN['FechaCargaSys'])
   ACT(r:fac, FBN['NrOperacion3'])
   ACT(s:fac, fbn('Mercado'))
  
   IF Incluido(FBN('TipoOp'),'CTP|VFTP|VTP|VTPC|CFTP') 
      ACT(t:fac, fbn('OperacionRef'))
      ACLO(t:fac, fbn('OperacionRef'))
   Endif  

   ACT(u:fac, FBN['Operador'])
   If Eqstr(fbn['ClaseOperacion'],'BOLSA')
      ACT(v:fac,SQL(" Select NrOrden FROM "~DBO~".MINORDOPS where NrOperacion='"~Fbn['NrOperacion']~"' "))
      If NoVacio(Val(v:fac))
         ACLR(v:fac,Val(v:fac))    
         AsignarLink(v:fac,'MINOPE',NrOperacion1='',NrOrden1=Val(v:fac))
      Endif 
   Endif

proximo

FormatoCeldas(g:Val(fi:1)+1..g:fac,Exe('F0'))
FormatoCeldas(l:Val(fi:1)+1..p:fac,Exe('F2'))
FormatoCeldas(m:Val(fi:1)+1..m:fac,Exe('F7'))

AlinearCeldas(d:Val(fi:1)+1..g:fac,'D')
AlinearCeldas(l:Val(fi:1)+1..q:fac,'D')

SetFont(a:Val(fi:1)+1..z:fac,1)

ACO(1,6)
ACO(2,6)
ACO(3,6)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,4)
ACO(8,10)
ACO(9,18)
ACO(10,6)
ACO(11,6)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,10)
ACO(19,6)
ACO(20,9)
ACO(21,6)
ACO(22,6)

Impresion(1,2)
SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL INFORME.')
SetFont(a:fac,2)
SetPrintFit(3,60)
LimitesVision(v:FAC)
RangoTitulo(a:1..x:fac+1, val(fi:1))
