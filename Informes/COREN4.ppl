ModoReproceso(ConDialogo)
HojaVisible(SI)
CrearDialogo
   Fecha1   : 'Desde'         ;;;;;;;;;;FSYS-1
   Fecha2   : 'Hasta'         ;;;;;;Dialogo.Fecha1 <= Dialogo.Fecha2 y Dialogo.Fecha2 < Fsys;'Error de Fechas';NO;;FSYS-1
   Vehiculo1: 'Vehiculo'      ;1;2;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Especie1 : 'Moneda'        ;2;2;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Check4   : 'Imp.Detallado' ;3;2;;;;;;;;0;
   Check1   : 'Por TipoOp?'   ;3;1;;;;;;;0
   Radio3   : 'Origen:|Todas|Activas|Pasivas'                       ;5;1;;;Dialogo.Check1=0;;;;0;
   Radio1   : 'Terc y Act|Todos|Dep.Pla|Cta.Cte'                    ;6;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2]],-1,Dialogo.Radio1),-1)
   Radio4   : 'Terc y Pas|Todos|Ob.Neg|Com.Ext|Fin.Lo|Fin.Ex|C.C.'  ;7;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=2]],-1,Dialogo.Radio4),-1)
   Radio2   : 'Vinc y Act|Todos|C.C.Vinc|C.C.Div|Co.Vinc|Co.Div'    ;8;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=1] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1]],-1,Dialogo.Radio2),-1)
   Radio5   : 'Vinc y Pas|Todos|C.C.Vinc|C.C.Div|Pr.Vinc|Pr.Div'    ;9;1;;[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1];Dialogo.Check1=0;;;;0;IIf(Dialogo.Check1=0,IIF(Not [[Dialogo.Radio3<=0 o Dialogo.Radio3=2] y [Dialogo.Radio6<=0 o Dialogo.Radio6=1]],-1,Dialogo.Radio5),-1)
   Lista1   : 'Tipos'                                               ;4;1;;;Dialogo.Check1=1;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION Where Codigo In ('MMCDP','MMCP','MMO','MMPCCV','MMFRN','MMON','MMPE','MMPI','MMPCL','MMPLME','MMPSC','MMPCOS','SERA','SERAV','SERP','SERPV','VIMIND','VIMINM','TEMIND','TEMINM')");
   Radio7   : 'Especies:|Todas|Algunas'                             ;5;1;;;;;;;0;
   Lista2   : 'Especies'                                            ;5;2;;Dialogo.Radio7=1;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES");
   Radio6   : 'Clientes:|Todos|Vinculados|Terceros'                 ;6;1;;;;;;;0;
   Lista3   : 'Clientes'                                            ;6;2;;Dialogo.Radio6<>0;;;;;;;IIF(Dialogo.Radio6=1,SQLSet("Select Codigo from "~DBO~".CLIENTES Where Jerarquia LIKE '"~VAR('JERVINCUL')~"%' and SubString(Jerarquia,1,6) <> '"~VAR('JERVINCUL')~"000' "),SQLSet("Select Codigo from "~DBO~".CLIENTES Where SubString(Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Vehiculo1)
   ACT(zz6,Dialogo.Vehiculo1~'|')
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Else 
      *- zz6 Siempre contiene los Vehiculos Habilitados
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') ") )
   EndIf
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*AgregarBMP(a1,Var('LOGO'),Var('ESCALOGO'))

ACT(a:3, 'SISTEMA DE COSTOS Y RENDIMIENTOS - OPERACIONES DE VENCIMIENTO SIMPLE')
*SetFont(a:fac..a:fac,3)

ACT(a5, 'Desde: '~Fecha(Dialogo.Fecha1, 'dd/mm/yyyy'))
ACT(a6, 'Hasta: '~Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
ACT(a7, 'Moneda Expresa: '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1) )

If NoVacio(val(zz6))
   ACT(H5, 'Vehiculo : '~val(zz6))
Else   
   ACT(H5, 'Vehiculo : Todos ')
EndIf

If Dialogo.Radio6 = 0 
  ACT(h6,'Clientes: TODOS' )   
Else
  If NoVacio(Dialogo.Lista3)
     ACT(h6,'Clientes: '~Pipe2coma(Dialogo.Lista3))   
  Else
     If Dialogo.Radio6 = 1
         ACT(h6,'Clientes: VINCULADOS' )   
     Else 
         ACT(h6,'Clientes: TERCEROS' )   
     Endif 
  Endif   
Endif

If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
  ACT(h7,'Especies: '~Pipe2coma(Dialogo.Lista2))   
Else
  ACT(h7,'Especies: TODAS' )   
endif

*--- Si eligio Operaciones, No Displaya Radio1 a RAdio5
If Dialogo.Check1=1
   If NoVacio(Dialogo.Lista1)
      ACT(h8,'Operaciones: '~Pipe2coma(Dialogo.Lista1))     
   Else
      ACT(h8,'Operaciones: MMCDP,MMCP,MMO,MMPCCV,MMFRN,MMON,MMPE,MMPI,MMPCL,MMPLME,MMPSC,MMPCOS,SERA,SERAV,SERP,SERPV,VIMIND,VIMINM,TEMIND,TEMINM')   
   EndIf
EndIf

If Dialogo.Radio3 = 0
   ACT(d6,'Origen: ACTIVAS y PASIVAS ')
Else
   If Dialogo.Radio3 = 1
      ACT(d6,'Origen: ACTIVAS ')
   Else
      ACT(d6,'Origen: PASIVAS ')
   Endif 
Endif

if Dialogo.Radio1=0
   ACT(k4, 'Terc y Act: Todos')
else
   if Dialogo.Radio1=1
      ACT(k4, 'Terc y Act: Dep.Plazo')
   else
      if Dialogo.Radio1=2
         ACT(k4, 'Terc y Act: Cta.CTe.Terceros')
      endif
   endif
endif

if Dialogo.Radio4=0
   ACT(k5, 'Terc y Pas: Todos')
else
   if Dialogo.Radio4=1
      ACT(k5, 'Terc y Pas: Obligaciones Negociables')
   else
      if Dialogo.Radio4=2
         ACT(k5, 'Terc y Pas: Comercio Exterior')
      else
         if Dialogo.Radio4=3
            ACT(k5, 'Terc y Pas: Financiamiento Loc.')
         else
            if Dialogo.Radio4=4
               ACT(k5, 'Terc y Pas: Financiamiento Ext.')
            else
               if Dialogo.Radio4=5
                  ACT(k5, 'Terc y Pas: Cta.Cte.Terceros')
               endif
            endif
         endif
      endif
   endif
endif

if Dialogo.Radio2=0
  ACT(k6, 'Vinc y Act: Todos')
else
  if Dialogo.Radio2=1
    ACT(k6, 'Vinc y Act: Cta.Cte.Vinc.')
  else
    if Dialogo.Radio2=2
      ACT(k6, 'Vinc y Act: Cta.Cte.Div.')
    else
      if Dialogo.Radio2=3
        ACT(k6, 'Vinc y Act: Colocaciones Vinc.')
      else
        if Dialogo.Radio2=4
          ACT(k6, 'Vinc y Act: Colocaciones Div.')
        endif
      endif
    endif
  endif
endif

if Dialogo.Radio5=0
  ACT(k7, 'Vinc y Pas: Todos')
else
  if Dialogo.Radio5=1
    ACT(k7, 'Vinc y Pas: Cta.Cte.Vinc.')
  else
    if Dialogo.Radio5=2
      ACT(k7, 'Vinc y Pas: Cta.Cte.Div.')
    else
      if Dialogo.Radio5=3
        ACT(k7, 'Vinc y Pas: Prestamos Vinc.')
      else
        if Dialogo.Radio5=4
          ACT(k7, 'Vinc y Pas: Prestamos Div.')
        endif
      endif
    endif
  endif
endif

SetFont(a0..z7, 2)

SetFilaActual(5)
ACN(bh:1,FAC)


SetFilaActual(FAC+4)

ACT(a:fac, 'Empresa')
ACT(b:fac, 'Tip.Op')
ACT(c:fac, 'Nro.Op')
ACT(d:fac, 'Entidad')
ACT(e:fac, 'Moneda')
ACT(f:fac, 'F.Origen')
ACT(g:fac, 'F.Vto')
ACT(h:fac, 'Cbio.Origen')
ACT(i:fac, 'Cbio.Vto')
ACT(j:fac, 'Cbio.Desde')
ACT(k:fac, 'Cbio.Hasta')
ACT(l:fac, 'Capital')
ACT(m:fac, 'Plazo')
ACT(n:fac, 'Tasa')
ACT(o:fac, 'Dias Transc.')
ACT(p:fac, 'Intereses')
ACT(q:fac, 'Cap.Conv.')
ACT(r:fac, 'Monto Conv.')
ACT(s:fac, 'Int.Conv.')
ACT(t:fac, 'Tasa Implic.')
ACT(u:fac, 'Cap.Tasa Dias')
ACT(v:fac, 'Cap.Dias')
ACT(w:fac, 'Cap.Plazo')
ACT(x:fac, 'Dias End')
ACT(y:fac, 'Cap.Correg')
ACT(ab:fac, 'Cbio.Vto Ahead')
ACT(ac:fac, 'Monto Ahead')
ACT(ad:fac, 'Int.Ahead')
ACT(ae:fac, 'Tasa Ahead')
ACT(af:fac, 'Cap.Tasa Dias Ahead')
ACT(ag:fac, 'Cap.Dias Ahead')


AlinearCeldas(c:FAC..c:FAC,'D')
AlinearCeldas(h:FAC..ag:FAC,'D')

SetFont(a:Val(bh:1)..ag:FAC,2)
AgregarMarco(a:FAC..ag:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)


*----- Armado de consulta ----------------------------------------------
SQL.ADD(" SELECT NrOperacion,TipoOp,Cliente1,Vehiculo1,FechaOp,FechaVto,FechaPago,Especie,ContraEspecie, ")
SQL.ADD("       Cotizacion1,Cotizacion2,PrecioEj,Cantidad,Plazo,Precio4,FechaEj,TotalNetoCli1,Plazo4, Precio3,FechaVto2,Plazo2 ")
SQL.ADD(" FROM  "~DBO~".OPERACIONES ")

If Dialogo.Radio6 > 0 
   SQL.ADD("O ,"~DBO~".CLIENTES C")
Endif

SQL.ADD(" Where ")

If NoVacio(val(zz6))
   SQL.ADD(" Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
Else 
   SQL.ADD(" Vehiculo1=Vehiculo1 ")
EndIf

If Dialogo.Radio6 > 0 
 If Dialogo.Radio6 = 1
    SQL.ADD(" and C.Codigo = O.Cliente1 and SubString(C.Jerarquia,1,3) = '"~VAR('JERVINCUL')~"' ")
 Else
    SQL.ADD(" and C.Codigo = O.Cliente1 and SubString(C.Jerarquia,1,3) <> '"~VAR('JERVINCUL')~"' ")
 Endif
Endif

If NoVacio(Dialogo.Lista3)
  SQL.ADD("   and Cliente1 In ("~Pipe2Comillas(Dialogo.Lista3)~") ")   
Endif

SQL.ADD(" and (    (TipoOp In('SERA','SERAV','SERP','SERPV') and  FechaEj>'"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("       or (TipoOp In ('MMCDP') and ((FechaVto2 Is Null and FechaVto>'"~IdxDate(Dialogo.Fecha1)~"') or (FechaVto2 Is Not Null and FechaVto2>'"~IdxDate(Dialogo.Fecha1)~"'))) ")
SQL.ADD("       or (TipoOp Not In ('MMCDP','SERA','SERAV','SERP','SERPV') and FechaVto>'"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD("       and FechaOp<'"~IdxDate(Dialogo.Fecha2)~"'    ")
If Dialogo.Check1=1 
   If NoVacio(Dialogo.Lista1)
      SQL.ADD(" and TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~") ")   
   Else
      SQL.ADD(" and TipoOp In ('MMCDP','MMCP','MMO','MMPCCV','MMFRN','MMON','MMPE','MMPI','MMPCL','MMPLME','MMPSC','MMPCOS','SERA','SERAV','SERP','SERPV','VIMIND','VIMINM','TEMIND','TEMINM') ")
   EndIf
Endif
If Dialogo.Radio7 = 1 y NoVacio(Dialogo.Lista2)
   SQL.ADD("    and Especie In ("~Pipe2Comillas(Dialogo.Lista2)~") ")
endif

If Dialogo.Check1=0
   SQL.ADD(" and  ( ")
   ACT(cf:1," ")

   *--- Activas ---------
   If Dialogo.Radio3 = 0 o Dialogo.Radio3 = 1
      *--- Para Terceros --- 
      If Dialogo.Radio6=0 o Dialogo.Radio6=2
****         SQL.ADD(Val(cf:1)~" (TipoOp='SERP')")
****         ACT(cf:1," or ")
         *-- Para Todo o Deposito a Plazo
         if Dialogo.Radio1=0 o Dialogo.Radio1=1
            SQL.ADD(Val(cf:1)~" (TipoOp In ('MMCDP','MMCP','MMO','SERP'))")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Cta.Cte.Terceros
         if Dialogo.Radio1=0 o Dialogo.Radio1=2
            SQL.ADD(Val(cf:1)~" (TipoOp in ('TEMIND','TEMINM') and MB3= '0')")
            ACT(cf:1," or ")
         endif
      Endif

      *--- Para Vinculados--- 
      If Dialogo.Radio6=0 o Dialogo.Radio6=1
         SQL.ADD(Val(cf:1)~" (TipoOp ='SERPV' and MB3='1') ")
         ACT(cf:1," or ")
         *-- Para Todo o Cta.Cte.Vinculadas
         if Dialogo.Radio2=0 o Dialogo.Radio2=1 
            SQL.ADD(Val(cf:1)~" (TipoOp In ('VIMIND','VIMINM') and MB3='0') ")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Cta.Cte.Divisiones
         if Dialogo.Radio2=0 o Dialogo.Radio2=2
            SQL.ADD(Val(cf:1)~" (TipoOp In ('VIMIND','VIMINM') and MB3='0') ")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Colocaciones Vinculadas
         if Dialogo.Radio2=0 o Dialogo.Radio2=3
            SQL.ADD(Val(cf:1)~" (TipoOp = 'MMPCCV' and MB3='1') ")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Colocaciones Divisiones
         if Dialogo.Radio2=0 o Dialogo.Radio2=4
           SQL.ADD(Val(cf:1)~" (TipoOp = 'MMPCCV' and MB3='1') ")
           ACT(cf:1," or ")
         endif
      Endif
   Endif

   *--- Pasivas ---------
   If Dialogo.Radio3 = 0 o Dialogo.Radio3 = 2
      *--- Para Terceros --- 
      If Dialogo.Radio6=0 o Dialogo.Radio6=2
         *-- Para Todo o Obligaciones Negociables
         if Dialogo.Radio4=0 o Dialogo.Radio4=1
            SQL.ADD(Val(cf:1)~" (TipoOp In ('MMFRN','MMON'))")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Comercio Exterior
         if Dialogo.Radio4=0 o Dialogo.Radio4=2
            SQL.ADD(Val(cf:1)~" (TipoOp In ('MMPE','MMPI'))")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Financiamiento Loc
         if Dialogo.Radio4=0 o Dialogo.Radio4=3
            SQL.ADD(Val(cf:1)~" (TipoOp In ('MMPCL','MMPLME','MMPSC'))")
            ACT(cf:1," or ")
*********************************************
            ACT(cz:9," and ")
            SQL.ADD(Val(cf:1)~" ((TipoOp ='SERA')")
            SQL.ADD(Val(cz:9)~" ('ARG' = (SELECT PaisDir FROM  "~DBO~".CLIENTES WHERE Codigo=Cliente1)))")
            ACT(cf:1," or ")
***************************************************
         endif
         *-- Para Todo o Financiamiento Ext
         if Dialogo.Radio4=0 o Dialogo.Radio4=4
            SQL.ADD(Val(cf:1)~" (TipoOp = 'MMPCOS') ")
            ACT(cf:1," or ")
*********************************************
            ACT(cz:9," and ")
            SQL.ADD(Val(cf:1)~" ((TipoOp ='SERA')")
            SQL.ADD(Val(cz:9)~" ('ARG' <> (SELECT PaisDir FROM  "~DBO~".CLIENTES WHERE Codigo=Cliente1)))")
            ACT(cf:1," or ")
***************************************************
         endif
         *-- Para Todo o Cta.Cte
         if Dialogo.Radio4=0 o Dialogo.Radio4=5
            SQL.ADD(Val(cf:1)~" (TipoOp in ('TEMIND','TEMINM') and MB3= '1') ")
            ACT(cf:1," or ")
         endif
      Endif
 
      *--- Para Vinculados--- 
      If Dialogo.Radio6=0 o Dialogo.Radio6=1
         *-- Para Todo o Cta.Cte.Vinculadas
         if Dialogo.Radio5=0 o Dialogo.Radio5=1 
            SQL.ADD(Val(cf:1)~" (TipoOp In ('VIMIND','VIMINM') and MB3='1') ")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Cta.Cte.Divisiones
         if Dialogo.Radio5=0 o Dialogo.Radio5=2
            SQL.ADD(Val(cf:1)~" (TipoOp In ('VIMIND','VIMINM') and MB3='1') ")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Prestamos Vinculadas
         if Dialogo.Radio5=0 o Dialogo.Radio5=3
            SQL.ADD(Val(cf:1)~" (TipoOp = 'MMPCCV' and MB3='0') ")
            ACT(cf:1," or ")
         endif
         *-- Para Todo o Prestamos Divisiones
         SQL.ADD(Val(cf:1)~" (TipoOp = 'SERAV' and MB3='0')")
         ACT(cf:1," or ")
         if Dialogo.Radio5=0 o Dialogo.Radio5=4
            SQL.ADD(Val(cf:1)~" (TipoOp = 'MMPCCV' and MB3='0') ")
            ACT(cf:1," or ")
         endif
      Endif 
   Endif
   SQL.ADD(" ) ")
   * Dialogo.Check1=0
EndIf

SQL.ADD(" ORDER BY NrOperacion ")


*--posicion de la 1ra cuota de todas las Operaciones
ACN(cd:1,fac+1) 
ACN(ce:1,fac) 

* Calculos para COREN 4
(.'CALCOREN4'.)

SetFont(a:10..ag:fac,1)


*--posicion de la ultima cuota barrida de todas las Operaciones
ACN(ce:1, Fac )
FormatoCeldas(h:Val(cd:1)..k:Val(ce:1), EXE('F7'))
FormatoCeldas(ab:Val(cd:1)..ab:Val(ce:1), EXE('F7'))
FormatoCeldas(t:Val(cd:1)..t:Val(ce:1), EXE('F5'))
FormatoCeldas(ae:Val(cd:1)..ae:Val(ce:1), EXE('F5'))
FormatoCeldas(m:Val(cd:1)..m:Val(ce:1), EXE('F0'))
FormatoCeldas(x:Val(cd:1)..x:Val(ce:1), EXE('F0'))

SetFilaActual(Fac+2)

*--- Hago las sumatorias ---
If Val(cd:1) <= Val(ce:1)
    ACN(l:fac , SUM(l:Val(cd:1)..l:Val(ce:1)) )
    ACN(p:fac , SUM(p:Val(cd:1)..p:Val(ce:1)) )
    ACN(q:fac , SUM(q:Val(cd:1)..q:Val(ce:1)) )
    ACN(r:fac , SUM(r:Val(cd:1)..r:Val(ce:1)) )
    ACN(s:fac , SUM(s:Val(cd:1)..s:Val(ce:1)) )
    ACN(u:fac , SUM(u:Val(cd:1)..u:Val(ce:1)) )
    ACN(v:fac , SUM(v:Val(cd:1)..v:Val(ce:1)) )
    ACN(w:fac , SUM(w:Val(cd:1)..w:Val(ce:1)) )
    ACN(y:fac , SUM(y:Val(cd:1)..y:Val(ce:1)) )
    ACN(af:fac, SUM(af:Val(cd:1)..af:Val(ce:1)) )
    ACN(ag:fac, SUM(ag:Val(cd:1)..ag:Val(ce:1)) )

    *--- Saco resultados definitivos ---
    *--Tasa media anual
    ACN(bu:1,  ( Val(u:fac)/Val(v:fac) ) * 100 )
    *--Capital Promedio
    ACN(bv:1,  Val(v:fac) / (Dialogo.Fecha2 - Dialogo.Fecha1) )
    *--Plazo Promedio
    ACN(bw:1,  Val(w:fac)/Val(q:fac)  )

    *--Tasa media anual Ahead
    ACN(bx:1, ( Val(af:fac)/Val(ag:fac) ) * 100 )
    *--Capital promedio Ahead
    ACN(by:1,  Val(y:fac)  )          
    *--Duration  Ahead
    ACN(bz:1,  Val(ag:fac)/Val(y:fac)  )
Else
    ACN(bu:1,0)
    ACN(bv:1,0)
    ACN(bw:1,0)
    ACN(bx:1,0)
    ACN(by:1,0)
    ACN(bz:1,0)
Endif

SetFont(a:fac..ag:fac,2)

SetFilaActual(fac+2)

ACT(h:fac ,'Tasa media anual')
ACT(h:fac+1,'Capital Promedio')
ACT(h:fac+2,'Plazo Promedio')
ACT(h:fac+4,'AHEAD:')
ACT(h:fac+5,'    Tasa media anual')
ACT(h:fac+6,'    Capital promedio')
ACT(h:fac+7,'    Duration')

ACN(j:fac  ,Val(bu1))
ACN(j:fac+1,Val(bv1))
ACN(j:fac+2,Val(bw1))
ACN(j:fac+5,Val(bx1))
ACN(j:fac+6,Val(by1))
ACN(j:fac+7,Val(bz1))

SetFont(h:fac..j:fac+7,2)


ACO(26,1)
ACO(27,1)

SetFilaActual(fac+9)
ACT(a:fac, 'Fin del Listado')
SetFont(a:fac..a:fac,2)
Impresion(1,2)
LimitesVision(ah:fac+2)

If Dialogo.Check4 = 1 
  ImprimirHoja(NO)
Endif 
