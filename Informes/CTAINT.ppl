CrearDialogo
  Radio1:  "TipoDocumento|DNI|CUIT|CUIL|CDI|LE|OTRO" ;;;;;;NoVacio(Radio1) ;'El Tipo de Documento no puede ser vacio'  ;;0;;
  String2: "Nr Documento"                            ;;;;;;NoVacio(String2);'El Numero de Documento no puede ser vacio';;;;
FiNdialogo

If Not OK 
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,15,B")

SetFilaActual(1)
ACT(d:FAC, 'Informe de Cuentas Comitentes')
SetFont(d:fac,3)
SetFilaActual(3)
ACT(a:fac,'Tipo Documento: ')
IF Dialogo.Radio1 = 0
    ACT(b:fac,'DNI')
ENDIF
IF Dialogo.Radio1 = 1
    ACT(b:fac,'CUIT')
ENDIF
IF Dialogo.Radio1 = 2
    ACT(b:fac,'CUIL')
ENDIF
IF Dialogo.Radio1 = 3
    ACT(b:fac,'CDI')
ENDIF
IF Dialogo.Radio1 = 4
    ACT(b:fac,'LE')
ENDIF
IF Dialogo.Radio1 = 5
    ACT(b:fac,'OTRO')
ENDIF
ACT(a:fac+1,'Nr Documento: ')
ACT(b:fac+1,Dialogo.String2)
ACT(a:fac+2,'Nombre: ')

SQL.ADD("SELECT rtrim(Nombre)+' '+Apellido as Persona FROM "~DBO~".PERSONASCOBIS WHERE NrDocumento = '"~Dialogo.String2~"' ")
IF Dialogo.Radio1 = 0
    SQL.ADD("and TipoDocumento = 'DNI' ")
ENDIF
IF Dialogo.Radio1 = 1
    SQL.ADD("and TipoDocumento = 'CUIT' ")
ENDIF
IF Dialogo.Radio1 = 2
    SQL.ADD("and TipoDocumento = 'CUIL' ")
ENDIF
IF Dialogo.Radio1 = 3
    SQL.ADD("and TipoDocumento = 'CDI' ")
ENDIF
IF Dialogo.Radio1 = 4
    SQL.ADD("and TipoDocumento = 'LE' ")
ENDIF
IF Dialogo.Radio1 = 5
    SQL.ADD("and TipoDocumento = 'OTRO' ")
ENDIF
Recorrer SQL
    dfa
    ACT(b:fac+2,fbn('Persona'))
Proximo

SetFont(a:fac..b:fac+2,2)

SQL.ADD("SELECT C.Cliente, C.Codigo, C.Nombre, C.Numero, C.Comitente, CASE C.TipoCuenta WHEN 'CUS' THEN 1 ELSE 2 END Tipo, ")
SQL.ADD("C.TipoCuenta, C.Especies, C.Estado ")
SQL.ADD("FROM "~DBO~".INTEGRANTESCTA IC, "~DBO~".CUENTAS C ")
SQL.ADD("WHERE (IC.Codigo = C.Codigo OR IC.Cliente = C.Cliente) ")

IF Dialogo.Radio1 = 0
    SQL.ADD("and IC.TipoDocumento = 'DNI' ")
ENDIF
IF Dialogo.Radio1 = 1
    SQL.ADD("and IC.TipoDocumento = 'CUIT' ")
ENDIF
IF Dialogo.Radio1 = 2
    SQL.ADD("and IC.TipoDocumento = 'CUIL' ")
ENDIF
IF Dialogo.Radio1 = 3
    SQL.ADD("and IC.TipoDocumento = 'CDI' ")
ENDIF
IF Dialogo.Radio1 = 4
    SQL.ADD("and IC.TipoDocumento = 'LE' ")
ENDIF
IF Dialogo.Radio1 = 5
    SQL.ADD("and IC.TipoDocumento = 'OTRO' ")
ENDIF

SQL.ADD("and IC.NrDocumento = '"~Dialogo.String2~"' ")
SQL.ADD("ORDER BY C.Cliente,Tipo ")

watch(SQL.Batch)
IFA
ACN(xx:1,0)
ACN(xx:2,0)
ACT(CL:1,'')
SetFilaActual(6)
Recorrer SQL
    IF VACIO(val(CL:1)) O Not EqStr(fbn('Cliente'),val(CL:1))
        ACT(CL:1,fbn('Cliente'))
        ACN(xx:1,0)
        ACN(xx:2,0)
        IF val(xx:1) = 0
            IFA
            ACT(a:fac,'Cuentas Comitente ' ~fbn('Cliente'))
            SetFont(a:fac..b:fac+1,2)
            AgregarMarco(a:fac..f:fac,2,1,Exe('COLOR8'))
            IFA
            ACT(a:fac,'Tipo Cuenta')
            ACT(b:fac,'Codigo')
            ACT(c:fac,'Nombre')
            ACT(d:fac,'Numero')
            ACT(e:fac,'Moneda/Especie')
            ACT(f:fac,'Estado')
            SetFont(a:fac..b:fac+1,2)
            AgregarMarco(a:fac..f:fac,2,1,Exe('COLOR'))            
            ACN(xx:1,1)
            IFA
        ENDIF        
    ENDIF
    ACT(b:fac,fbn('Codigo'))
    ACT(c:fac,fbn('Nombre'))    
    ACT(d:fac,fbn('Numero'))
    Recorrer&i 1, Elementos(fbn('Especies'))
        IF Eqstr(ItemLista(fbn('Especies'),&i),'|')
            ACT(e:fac,val(e:fac)~', ')
        ELSE
            ACT(e:fac,val(e:fac)~ItemLista(fbn('Especies'),&i))
        ENDIF
    Proximo
    *ACT(e:fac,fbn('Especies'))    
    IF fbn('Tipo') = 1
        *CUSTODIA
        ACT(a:fac,'Custodia')
    ELSE
        *MONETARIA
        ACT(a:fac,BUSCARCAMPO('TIPOSCUENTA','Descripcion','Codigo',fbn('TipoCuenta')))
    ENDIF
    IF Eqstr(fbn('Estado'),'HAB')
        ACT(f:fac,'Habilitada')
    ELSE
        IF Eqstr(fbn('Estado'),'SUS')
            ACT(f:fac,'Suspendida')
        ELSE
            IF Eqstr(fbn('Estado'),'PEN')
                ACT(f:fac,'Pendiente')
            ELSE        
                ACT(f:fac,'Cerrada')
            ENDIF
        ENDIF
    ENDIF
Proximo
ACO( 1,10)
ACO( 2,10)
ACO( 3,20)
ACO( 4,20)
ACO( 5,20)
ACO( 6,20)
ACO( 7,20)
IFA
IFA
ACT(a:fac, 'FIN DEL LISTADO')
LimitesVision(f:fac)
