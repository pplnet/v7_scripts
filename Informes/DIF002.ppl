MostrarCuadroDeMensajes

CrearDialogo
  Cliente1  : "Cliente"    
  Vehiculo1 : "Vehiculo"   ;;;;;;;;;Var('VEHICULODE')
  Fecha1    : "F.DesdeLiq" ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Fecha2    : "F.HastaLiq" ;;;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha';NO;FSys
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,8,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Fecha(FSys))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Neteo- Diferimientos por Operacion de TI")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
   ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+2, 'Cliente : '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
else
   ACT(a:FAC+2, 'Cliente : Todos')
endif
ACT(a:FAC+3, 'Desde Fecha Liquidacion: '~Dialogo.Fecha1)
ACT(a:FAC+4, 'Hasta Fecha Liquidacion: '~Dialogo.Fecha2)


SetFilaActual(FAC+6)

ACT(a:FAC, 'TipoOp')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'FechaOp')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio')
ACT(i:FAC, 'FechaVto Orig.')
ACT(j:FAC, 'Fecha Diferida')
ACT(k:FAC, 'Usuario')
ACT(l:FAC, 'Fecha Modificacion')

AlinearCeldas(a:FAC+1..f:FAC+1,'I')
AlinearCeldas(g:FAC+1..g:FAC+1,'D')
AlinearCeldas(h:FAC+1..l:FAC+1,'I')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
SetFont(a:Val(w1)..z:FAC,2)
AgregarMarco(a:FAC..l:FAC,1,0,Exe('COLOR6'))

SetFilaActual(FAC+1)

ACT(X1, "FechaVto Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
If NoVacio(Dialogo.Vehiculo1)
   ACT(x1, Val(X1)~" and Vehiculo1 = '"~Dialogo.Vehiculo1~"'")
Endif
If NoVacio(Dialogo.Cliente1)
   ACT(x1, Val(X1)~" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
Endif


SQL.ADD(" SELECT Mer.Netea, O.* FROM "~DBO~".OPERACIONES O")
SQL.ADD(" inner join "~DBO~".MERCADOS Mer on O.Mercado = Mer.Codigo")
SQL.ADD(" WHERE "~Val(X1))
SQL.ADD(" AND Mer.Netea = 'SI'")
SQL.ADD(" AND   O.TipoOp IN ('TIC','TIV','TIFV','TIFC') ")
SQL.ADD(" AND   O.Convenio = '1' ")
SQL.ADD(" order by O.NrOperacion ")


Recorrer SQL
    Message('Operacion: '~FBN['NrOperacion'])

    IF Not EqStr(FBN['NrOperacion'],Val(z1))
       ifa
       ACT(z1, FBN['NrOperacion'])
       ACT(a:FAC, FBN['TipoOp'])
       ACT(b:FAC, FBN['NrOperacion'])
       ACLO(b:FAC, fbn('NrOperacion'))
       ACD(c:FAC, FBN['FechaOp'])
       ACT(d:FAC, fbn('Vehiculo1'))
       ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
       ACT(f:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj'])
       ACN(g:FAC, FBN['Cantidad'])
       ACN(h:FAC, FBN['Precio1'])
       ACD(i:FAC, FBN['FechaAltaSisExterno'])
       SetFont(a:FAC..y:FAC,1)
       fORMATOcELDAS(h:fac,EXE('F9'))
    Endif
    dfa
    SQL.ADD(" SELECT P.* FROM "~DBO~".PMAUDIT P          ")
    SQL.ADD(" WHERE  P.Tabla  = 'OPERACIONES'            ")
    SQL.ADD(" AND    P.Codigo = '"~fbn('NrOperacion')~"' ")
    SQL.ADD(" AND    P.Accion = 'M'                      ")
    SQL.ADD(" AND    P.Campo  = 'FechaVto'               ")


    Recorrer SQL
    *    ACD(j:fac, copy(fbn('ValorActual'),1,12))
         ACD(J:fac, FECHA(fbn('ValorActual')))
       ACT(k:fac, fbn('Operador'))
       ACD(l:fac, fbn('Fecha'))
       SetFont(j:FAC..y:FAC,1)
    Proximo
Proximo

ACO(1,5)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,20)
ACO(6,10)
ACO(7,9)
ACO(8,12)
ACO(9,9)
ACO(10,9)
ACO(11,9)
ACO(12,15)


Impresion(1,2)
SetFilaActual(FAC+3)
ACT(a:FAC, 'Fin del Informe.')
SetFont(a:FAC, 2)
LimitesVision(l:FAC)
RangoTitulo(a:1..o:FAC, Val(w1)+6)
SetPrintFit(3,80)
