************* CABECERA DEL LISTADO ***************

ACT(A:1,'Fecha: '~Var('FECHASYS'))
ACT(A:2,'Detalle de variable: ')
ACT(B:2,Dialogo.String1)
SetFont(A:1..B:2,3)

SetFilaActual(4)

ACT(A:FAC, "Tablas")
ACT(B:FAC, "¿Donde?")
AlinearCeldas(A:FAC..B:FAC,'I')
SetFont(A:FAC..B:FAC, 2)
AgregarMarco(A:FAC..B:FAC,2,0,Exe('COLOR'))

************* CABECERA DEL LISTADO FIN ***************

