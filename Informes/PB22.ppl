CrearDialogo
  Fecha1:   'D.Fecha'   ;1;1;;;;;;;fsys
  Fecha2:   'H.Fecha'   ;1;2;;;;;;;fsys
  Lista1:   'Vehiculos' ; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:2))
  Lista4:   'Conceptos' ;-3;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CNCONCEPTOSPAGOCOBRO WHERE TipoConcepto='RET' ");
  Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
  Lista3:   'Cuentas'   ;-8;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:2))~") " ) )~"  ");
FinDialogo

