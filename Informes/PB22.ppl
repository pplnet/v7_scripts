IFA

SQL.ADD(" SELECT M.Especie,T.Cliente2, M.Cuenta, M.FechaMov, T.ConceptoPago, M.Cantidad, T.CNFormaPago, T.Cambio1, ")
SQL.ADD(" T.Fecha1, CL.RazonSocial, C.Numero, E.Nombre, 'Pendiente' Estado, T.Vehiculo1, T.Cantidad4, ")
SQL.ADD(" FP.Descripcion, CP.Descripcion CPDescripcion, T.Proveedor, T.Cantidad2, FP.Tipo, M.NrOperacion, P.Nombre NombreP  ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES CL, "~DBO~".ESPECIES E, ")
SQL.ADD("  "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M, "~DBO~".CNFORMASPAGOCOBRO FP, "~DBO~".CNCONCEPTOSPAGOCOBRO CP, "~DBO~".CNPROVEEDORES P ")
SQL.ADD(" WHERE T.NrTrans  = M.NrOperacion ")
SQL.ADD(" AND   T.Cliente2 = CL.Codigo ")
SQL.ADD(" AND   M.Cuenta   = C.Codigo ")
SQL.ADD(" AND   M.Especie  = E.Codigo ")
SQL.ADD(" AND   T.CNFormaPago  = FP.Codigo ")
SQL.ADD(" AND   T.ConceptoPago = CP.Codigo ")
SQL.ADD(" AND   T.TipoTr2   = 'DEVM' ")
SQL.ADD(" AND   T.Proveedor *= P.Codigo  ")
SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND   CP.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   T.Cliente2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT M.Especie,T.Cliente2, M.Cuenta, M.FechaMov, T.ConceptoPago, M.Cantidad, T.CNFormaPago, T.Cambio1, ")
SQL.ADD(" T.Fecha1, CL.RazonSocial, C.Numero, E.Nombre, 'Ejecutado' Estado, T.Vehiculo1, T.Cantidad4, ")
SQL.ADD(" FP.Descripcion, CP.Descripcion CPDescripcion, T.Proveedor, T.Cantidad2, FP.Tipo, M.NrOperacion, P.Nombre NombreP ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES CL, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M, "~DBO~".CNFORMASPAGOCOBRO FP, "~DBO~".CNCONCEPTOSPAGOCOBRO CP, "~DBO~".CNPROVEEDORES P ")
SQL.ADD(" WHERE T.NrTrans  = M.NrOperacion ")
SQL.ADD(" AND   T.Cliente2 = CL.Codigo ")
SQL.ADD(" AND   M.Cuenta   = C.Codigo ")
SQL.ADD(" AND   M.Especie  = E.Codigo ")
SQL.ADD(" AND   T.CNFormaPago  = FP.Codigo ")
SQL.ADD(" AND   T.ConceptoPago = CP.Codigo ")
SQL.ADD(" AND   T.TipoTr2   = 'DEVM' ")
SQL.ADD(" AND   T.Proveedor *= P.Codigo ")
SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND   CP.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   T.Cliente2 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:2))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY 1,2,3,4 ")

ACT(vh:1, '')
ACT(ea:1, '')
ACT(ba:1, '')


Recorrer SQL
  If Not eqstr(fbn('Especie'),Val(ea:1)) o Not eqstr(fbn('Vehiculo1'),Val(vh:1))
    If Not eqstr(Val(vh:1),'')
      ACT(a:fac, 'Total Banco ->')
      ACN(c:fac, SUM(c:Val(fi:1)..c:fac) )
      FormatoCeldas(c:fac, EXE('F2'))
      SetFont(a:fac..z:fac,5)
      SCN(to:1, Val(c:fac))
      ifa
      ifa
      ACT(a:fac, 'Total Vehiculo ->')
      ACN(c:fac, Val(to:1) )
      FormatoCeldas(c:fac, EXE('F2'))
      SetFont(a:fac..z:fac,5)
      AgregarMarco(a:fac..k:fac,0,0,0)
      ACN(to:1, 0)
      ifa
      ifa
      ifa
    Endif
    ACT(a:fac, 'Vehiculo: '~fbn('Vehiculo1')~'  -  Moneda: '~fbn('Nombre'))
    message('Vehiculo: '~fbn('Vehiculo1')~'  -  Moneda: '~fbn('Nombre'))
    SetFont(a:fac,2)
    AgregarMarco(a:fac..k:fac,0,0,EXE('COLOR8'))
    ACT(ba:1, '')
  Endif

  If Not eqstr(fbn('Cliente2'),Val(ba:1)) 
     If Not eqstr(Val(ba:1),'')
       ACT(a:fac, 'Total Banco ->')
       ACN(c:fac, SUM(c:Val(fi:1)..c:fac) )
       FormatoCeldas(c:fac, EXE('F2'))
       SetFont(a:fac..z:fac,5)
       SCN(to:1, Val(c:fac))
       ifa
     Endif
     ifa
     message('Banco: '~fbn('RazonSocial'))
     ACT(a:fac, fbn('RazonSocial'))
     SetFont(a:fac,2)
     ACN(fi:1, fac)
  Endif

  ACT(b:fac, fbn('Cuenta')~' - '~fbn('Numero'))
  ACN(c:fac, fbn('Cantidad'))
  ACLT(c:fac, fbn('NrOperacion'))
  ACT(d:fac, fbn('CPDescripcion'))
  ACT(e:fac, fbn('Proveedor')~'-'~fbn('NombreP'))
  ACT(f:fac, fbn('Descripcion'))
  If Eqstr(fbn('Tipo'),'CHE')
    ACT(g:fac, FSTR(fbn('Cantidad2'),0,0))
  Else
    ACT(g:fac, FSTR(fbn('Cambio1'),0,0))
  Endif
  ACD(h:fac, fbn('FechaMov'))
  ACD(i:fac, fbn('Fecha1'))
  ACT(j:fac, fbn('Estado'))
  IF Eqstr(fbn('Estado'), 'Pendiente')
    ColorCeldas(j:fac,clBlue)
  ELSE
    ColorCeldas(j:fac,clGreen)
  ENDIF
  ACT(k:fac, FSTR(fbn('Cantidad4'),0,0))
  SetFont(b:fac..i:fac,1)
  FormatoCeldas(c:fac, EXE('F2'))

  ACT(ea:1, fbn('Especie'))
  ACT(ba:1, fbn('Cliente2'))
  ACT(vh:1, fbn('Vehiculo1'))
Proximo

