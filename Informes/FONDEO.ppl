CrearDialogo
  Fecha1: 'D.Fecha' ;;;;;;;;;FSYS
  Fecha2: 'H.Fecha' ;;;;;;;;;FSYS
FinDialogo

If not ok
   Cancelar
Endif


CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")


ACT(a:2, 'Detalle fondeo Automatico del '~dialogo.Fecha1~' al '~Dialogo.Fecha2)
SetFont(a:2,2)

Setfilaactual(4)

ACT(a:fac, 'NrOperacion')
ACT(b:fac, 'FechaOp')
ACT(c:fac, 'Plazo')
ACT(d:fac, 'FechaVto')
ACT(e:fac, 'Especie')
ACT(f:fac, 'Tasa')
ACT(g:fac, 'Cantidad')
ACT(h:fac, 'Monto')
ACT(i:fac, 'Vehiculo')
ACT(j:fac, 'Prestador')
ACT(k:fac, 'Beneficiario')
ACT(l:fac, 'EspecieRef')
ACT(m:fac, 'Cantidad')
ACT(n:fac, 'Interes')
ACT(o:fac, 'Monto')
AgregarMarco(a:fac..o:fac,1,1,EXE('COLOR6'))
SetFont(a:fac..z:fac,2)
AlinearCeldas(a:fac..z:fac,'C')
IF NO
SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, O.Especie, O.FechaOp, O.FechaVto, O.Plazo, O.Precio1, ")
SQL.ADD(" O.Cantidad, O.TotalBrutoCli1, O.Vehiculo1, D.EspecieRef, D.Cantidad CantidadD, D.Ints, D.Monto, O.Book1, O.Book2  ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".DETALLEFONDEO D ")
ENDIF
SQL.ADD(" SELECT O.NrOperacion, O.TipoOp, O.Especie, O.FechaOp, O.FechaVto, O.Plazo, O.Precio1, ")
SQL.ADD(" O.Cantidad, O.TotalBrutoCli1, O.Vehiculo1, D.Especie2 EspecieRef, D.Cantidad1 CantidadD, D.Cantidad2 Ints, D.Cantidad3 Monto, O.Book1, O.Book2  ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".CUOTAS D ")
SQL.ADD(" WHERE O.NrOperacion = D.NrOperacion ")
SQL.ADD(" AND   O.FechaOp>= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   O.FechaOp<= "~idxdate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND   O.TipoOp = 'IMM' ")
act(AA:1, '')
Recorrer SQL
  If Not Eqstr(fbn('NrOperacion'), val(aa:1))
     ACT(a:fac, fbn('NrOperacion'))
     ACLO(a:fac, fbn('NrOperacion'))
     ACD(b:fac, fbn('FechaOp'))
     ACN(c:fac, fbn('Plazo'))
     ACD(d:fac, fbn('FechaVto'))
     ACT(e:fac, fbn('Especie'))
     ACN(f:fac, fbn('Precio1'))
     ACN(g:fac, fbn('Cantidad'))
     ACN(h:fac, fbn('TotalBrutoCli1'))
     ACT(i:fac, fbn('Vehiculo1'))
     ACT(j:fac, fbn('Book1'))
     ACT(k:fac, fbn('Book2'))
  Endif
  ACT(l:fac, fbn('EspecieRef'))
  ACN(m:fac, fbn('CantidadD'))
  ACN(n:fac, fbn('Ints'))
  ACN(o:fac, fbn('Monto'))
  act(AA:1, fbn('NrOperacion'))
Proximo

SetFont(a:5..m:fac,1)
fORMATOCELDAS(c:4..c:fac, EXE('F0'))
fORMATOCELDAS(f:4..f:fac, EXE('F9'))
fORMATOCELDAS(g:4..h:fac, EXE('F2'))
fORMATOCELDAS(m:4..o:fac, EXE('F2'))
ifa
ifa
ACT(a:fac, 'Fin del informe.')
SETfONT(a:fac,2)
ifa
ACT(a:fac, USUARIOACTIVO)

