SQL.ADD(" SELECT distinct O.TipoOp, O.NrOperacion, O.Cantidad, O.TotalBrutoCli1, ")
SQL.ADD(" O.FechaOp, O.FechaVto, O.Precio1, O.Vehiculo1 Vehiculo, ")
SQL.ADD(" O.Cliente1, O.Especie, O.Precio2, O.TotalBrutoCli2 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".BOOKS B, "~DBO~".OPERACIONESBITS OB ")
SQL.ADD(" WHERE  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD(" AND    O.FechaVto  > '"~IdxDate(Dialogo.Fecha1)~"'  ")
SQL.ADD("and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("and OB.NrBit = 30 ")
SQL.ADD("and OB.Valor = '0' ")
SQL.ADD("and O.Book1 = B.Codigo ")

IF NOVACIO(Dialogo.Operador)
   SQL.ADD(" AND    O.Operador = '"~Dialogo.Operador~"' ")
ENDIF
IF Dialogo.Radio3=0
   SQL.ADD(" AND   (O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' or O.Vehiculo1 = '' or O.Vehiculo1 is Null) ")
ELSE
   IF Dialogo.Radio3=2 y NoVacio(Dialogo.Lista3) 
      SQL.ADD(" AND (O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista3)~") or O.Vehiculo1 = '' or O.Vehiculo1 is Null) ")
   ENDIF  
ENDIF
*IF Dialogo.Radio4=0
*   SQL.ADD(" AND    (B.Producto = '"~Dialogo.Producto1~"' or B.Producto = '' or B.Producto is Null) ")
*ELSE
*   IF Dialogo.Radio4=2 y NoVacio(Dialogo.Lista4)
*      SQL.ADD(" AND (B.Producto IN ("~Pipe2Comillas(Dialogo.Lista4)~") or B.Producto = '' or B.Producto is Null) ")
*   ENDIF  
*ENDIF
IF Dialogo.Radio5=0
   SQL.ADD(" AND    (B.GrupoEspecie = '"~Dialogo.GrupoEspecie1~"' or B.GrupoEspecie = '' or B.GrupoEspecie is Null) ")
ELSE
   IF Dialogo.Radio5=2 y NoVacio(Dialogo.Lista5)
      SQL.ADD(" AND (B.GrupoEspecie IN ("~Pipe2Comillas(Dialogo.Lista5)~") or B.GrupoEspecie = '' or B.GrupoEspecie is Null) ")
   ENDIF  
ENDIF
IF Dialogo.Radio6=0
   SQL.ADD(" AND    (B.TipoNegocio = '"~Dialogo.TipoNegocio1~"' or B.TipoNegocio = '' or B.TipoNegocio is Null) ")
ELSE
   IF Dialogo.Radio6=2 y NoVacio(Dialogo.Lista6)
      SQL.ADD(" AND (B.TipoNegocio IN ("~Pipe2Comillas(Dialogo.Lista6)~") or B.TipoNegocio = '' or B.TipoNegocio is Null) ")
   ENDIF  
ENDIF
IF Dialogo.Radio7=0
   SQL.ADD(" AND    (B.TipoPosicion = '"~Dialogo.TipoPosicion1~"' or B.TipoPosicion = '' or B.TipoPosicion is Null) ")
ELSE
   IF Dialogo.Radio7=2 y NoVacio(Dialogo.Lista7)
      SQL.ADD(" AND  (B.TipoPosicion IN ("~Pipe2Comillas(Dialogo.Lista7)~") or B.TipoPosicion = '' or B.TipoPosicion is Null) ")
   ENDIF  
ENDIF
IF Dialogo.Radio8=0
   SQL.ADD(" AND    (B.Responsable = '"~Dialogo.Responsable1~"' or B.Responsable = '' or B.Responsable is Null) ")
ELSE
   IF Dialogo.Radio8=2 y NoVacio(Dialogo.Lista8)
      SQL.ADD(" AND  (B.Responsable IN ("~Pipe2Comillas(Dialogo.Lista8)~") or B.Responsable = '' or B.Responsable is Null) ")
   ENDIF  
ENDIF
IF Dialogo.Radio9=0
   SQL.ADD(" and (O.Book1 = '"~Dialogo.Book1~"' or O.Book1 = '' or O.Book1 is Null) ")
else
   IF Dialogo.Radio9=2 y NoVacio(Dialogo.Lista9)
      SQL.ADD(" and (O.Book1 in ("~Pipe2Comillas(Dialogo.Lista9)~") or O.Book1 = '' or O.Book1 is Null) ") 
   endif
ENDIF

if Dialogo.Radio1 = 0 
*   SQL.ADD(" AND O.TipoOp IN ('MMCO','IMMPO') ")
** FJL 14/04/16. Se agrego MMOVN
   SQL.ADD(" AND O.TipoOp IN ('MMCO','IMM','MMOVN') ")
else
   SQL.ADD(" and O.TipoOp IN ('MMCT','IMMPF','MMPF','MMPFCE') ")
endif   
IF Dialogo.Check1 = 1
   IF Dialogo.Check2 = 1
      ACT(li:1, 'I|')
   ENDIF
   IF Dialogo.Check3 = 1
      ACT(li:1, Val(li:1)~'O|')
   ENDIF
   IF Dialogo.Check4 = 1
      ACT(li:1, Val(li:1)~'F|')
   ENDIF
   IF Dialogo.Check5 = 1
      ACT(li:1, Val(li:1)~'P|')
   ENDIF
   IF Dialogo.Check6 = 1
      ACT(li:1, Val(li:1)~'R|')
   ENDIF
   IF Dialogo.Check7 = 1
      ACT(li:1, Val(li:1)~'B|')
   ENDIF
   SQL.ADD(" AND  B.Alias2 IN ("~Pipe2Comillas(Val(li:1))~")")
ENDIF
SQL.ADD(" ORDER BY O.Especie, O.FechaOp ")

