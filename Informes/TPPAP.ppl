      ACT(a:11, 'Book: Todos')
   ELSE
      ACT(a:11, 'Book: '~Pipe2coma(Dialogo.Lista9))
   ENDIF
ENDIF
IF Dialogo.Check1 = 1
   ACT(a:12, 'Por Tipo de Book: SI')
   IF Dialogo.Check2 = 1
      ACT(a:12, Val(a:12)~' - Intraday')
   ENDIF
   IF Dialogo.Check3 = 1
      ACT(a:12, Val(a:12)~' - OverNigth')
   ENDIF
   IF Dialogo.Check4 = 1
      ACT(a:12, Val(a:12)~' - Funding')
   ENDIF
   IF Dialogo.Check5 = 1
      ACT(a:12, Val(a:12)~' - Pos.Taking')
   ENDIF
   IF Dialogo.Check6 = 1
      ACT(a:12, Val(a:12)~' - Relative')
   ENDIF
   IF Dialogo.Check7 = 1
      ACT(a:12, Val(a:12)~' - Brokerage')
   ENDIF
ELSE
   ACT(a:12, 'Por Tipo de Book: NO')
ENDIF
SetFont(a:1..z:12, 2)

ACT(a:15, 'Listado de Operaciones '~iif(Dialogo.Radio1=0, 'Activas', 'Pasivas')~' - Applications')
SetFont(a:15,4)
