ACT(b:17, 'Cliente')
ACT(c:17, 'Boleto')
ACT(d:17, 'Inicio')
ACT(e:17, 'Vencim.')
ACT(f:17, 'Capital')
ACT(g:17, 'Tasa')
ACT(h:17, 'Total')
ACT(i:17, 'T.P.P.')
SetFont(b:17..i:17, 3)
AgregarMarco(a:17..i:17,2,0,Exe('COLOR'))

Recorrer SQL
   if EqStr(Val(ab:1), 'SI') o Not EqStr(fbn['Especie'], Val(ac:1))
      if Not EqStr(Val(ab:1), 'SI')
         Recorrer&i 1, Elementos(Dialogo.Lista1)+1
            Recorrer&j 1, Val(p:&i)
               SCN(aa:2, 1)
               ACT(b:Val(aa:2), Val((&i-1)*7+1+10:500+&j))
               ACT(c:Val(aa:2), Val((&i-1)*7+2+10:500+&j))
               ACLO(c:Val(aa:2), Val((&i-1)*7+2+10:500+&j))
               ACD(d:Val(aa:2), Val((&i-1)*7+3+10:500+&j))
               ACD(e:Val(aa:2), Val((&i-1)*7+4+10:500+&j))
               ACN(f:Val(aa:2), Val((&i-1)*7+5+10:500+&j))
               ACN(g:Val(aa:2), Val((&i-1)*7+6+10:500+&j))
               SetFont(b:Val(aa:2)..G:Val(aa:2),1)
            Proximo
            SCN(aa:2,1)
            if &i <> Elementos(Dialogo.Lista1)+1
               ACT(g:Val(aa:2), 'Total hasta '~ItemLista(Dialogo.Lista1, &i)~' dias')
            else
               ACT(g:Val(aa:2), 'Total mas de '~ItemLista(Dialogo.Lista1, &i-1)~' dias')
            endif
            ACN(h:Val(aa:2), Val((&i-1)*7+1+10:500))
            ACN(i:Val(aa:2), Val((&i-1)*7+2+10:500) / Val((&i-1)*7+3+10:500))
            SetFont(g:Val(aa:2)..i:Val(aa:2),2)

            SCN(aa:3, Val((&i-1)*7+1+10:500))
            SCN(aa:4, Val((&i-1)*7+2+10:500))
            SCN(aa:5, Val((&i-1)*7+3+10:500))
         Proximo

         SCN(aa:2, 2)
         ACT(g:Val(aa:2), 'Total '~BuscarCampo('ESPECIES', 'Nombre', 'Codigo', Val(ac:1)))
         ACN(h:Val(aa:2), Val(aa:3))
         ACN(i:Val(aa:2), Val(aa:4) / Val(aa:5))
         SetFont(g:Val(aa:2)..i:Val(aa:2),2)

         SCN(aa:2, 1)
      endif

      * Supongo no mas de 500 operaciones por bucket
      BorrarCeldas(a500..(Elementos(Dialogo.Lista1)+1)*7+10:500)
      BorrarCeldas(p:1..p:Elementos(Dialogo.Lista1)+1)
      BorrarCeldas(aa:3..aa:5)

      ACT(ab:1, 'NO')
      ACT(ac:1, fbn['Especie'])
      SCN(aa:2, 1)
      ACT(A:Val(aa:2), BuscarCampo('ESPECIES', 'Extendido', 'Codigo', Val(aC:1)))
      SetFont(A:Val(aa:2), 3)
   endif

   * Hallo bucket
   Recorrer&i 1, Elementos(Dialogo.Lista1)
      if fbn['FechaVto'] - Dialogo.Fecha1 <= num(ItemLista(Dialogo.Lista1, &i))
         ACN(aa:6, &i)
         ACT(ab:2, 'SI')
         Break
      endif
   Proximo
   if Eqstr(Val(ab:2), 'NO')
       ACN(AA6, Elementos(Dialogo.Lista1)+1)
   endif
   ACT(ab:2, 'NO')
   SCN(p:Val(aa:6),1)
   ACT((Val(aa:6)-1)*7+1+10:500+Val(p:Val(aa:6)), fbn['Cliente1'])
   ACT((Val(aa:6)-1)*7+2+10:500+Val(p:Val(aa:6)), fbn['NrOperacion'])
   ACD((Val(aa:6)-1)*7+3+10:500+Val(p:Val(aa:6)), fbn['FechaOp'])
   ACD((Val(aa:6)-1)*7+4+10:500+Val(p:Val(aa:6)), fbn['FechaVto'])
   ACN((Val(aa:6)-1)*7+5+10:500+Val(p:Val(aa:6)), fbn['Cantidad'])
** FJL 14/04/16. Se agrego MMOVN
   if Incluido(FBN['TipoOp'],'MMCO|MMCT|MMOVN')
     ACN((Val(aa:6)-1)*7+6+10:500+Val(p:Val(aa:6)), fbn['Precio1'])
     SCN((Val(aa:6)-1)*7+1+10:500, fbn['TotalBrutoCli1'])
     SCN((Val(aa:6)-1)*7+2+10:500, fbn['Cantidad'] * (fbn['FechaVto'] - Dialogo.Fecha1) * fbn['Precio1'])
   ELSE
     IF Incluido(fbn('TipoOp'), 'MMPF|MMPFCE')
        ACN((Val(aa:6)-1)*7+6+10:500+Val(p:Val(aa:6)), fbn['Precio2'])
        SCN((Val(aa:6)-1)*7+1+10:500, fbn['TotalBrutoCli1'])
        SCN((Val(aa:6)-1)*7+2+10:500, fbn['Cantidad'] * (fbn['FechaVto'] - Dialogo.Fecha1) * fbn['Precio2'])
     else
        ACN((Val(aa:6)-1)*7+6+10:500+Val(p:Val(aa:6)), fbn['Precio2'])
        SCN((Val(aa:6)-1)*7+1+10:500, fbn['TotalBrutoCli2'])
        SCN((Val(aa:6)-1)*7+2+10:500, fbn['Cantidad'] * (fbn['FechaVto'] - Dialogo.Fecha1) * fbn['Precio2'])
     endif
   ENDIF
   SCN((Val(aa:6)-1)*7+3+10:500, fbn['Cantidad'] * (fbn['FechaVto'] - Dialogo.Fecha1))
   ACT((Val(aa:6)-1)*7+10+10:500+Val(p:Val(aa:6)), fbn['TipoOp'])
Proximo

if Not EqStr(Val(ab:1), 'SI')

   Recorrer&i 1, Elementos(Dialogo.Lista1)+1
      Recorrer&j 1, val(p:&i)
         SCN(aa:2, 1)
         ACT(b:Val(aa:2), Val((&i-1)*7+1+10:500+&j))
         ACT(c:Val(aa:2), Val((&i-1)*7+2+10:500+&j))
         ACLO(c:Val(aa:2), Val((&i-1)*7+2+10:500+&j))
         ACD(d:Val(aa:2), Val((&i-1)*7+3+10:500+&j))
         ACD(e:Val(aa:2), Val((&i-1)*7+4+10:500+&j))
         ACN(f:Val(aa:2), Val((&i-1)*7+5+10:500+&j))
         ACN(g:Val(aa:2), Val((&i-1)*7+6+10:500+&j))
         SetFont(b:Val(aa:2)..g:Val(aa:2),1)
      Proximo

      SCN(aa:2,1)
      if &i <> Elementos(Dialogo.Lista1)+1
         ACT(g:Val(aa:2), 'Total hasta '~ItemLista(Dialogo.Lista1, &i)~' dias')
      else
         ACT(g:Val(aa:2), 'Total mas de '~ItemLista(Dialogo.Lista1, &i-1)~' dias')
      endif
      ACN(h:Val(aa:2), val((&i-1)*7+1+10:500))
      ACN(i:Val(aa:2), val((&i-1)*7+2+10:500) / val((&i-1)*7+3+10:500))
      SetFont(g:Val(aa:2)..i:Val(aa:2),2)

      SCN(aa:3, Val((&i-1)*7+1+10:500))
      SCN(aa:4, Val((&i-1)*7+2+10:500))
      SCN(aa:5, Val((&i-1)*7+3+10:500))
   Proximo
   SCN(aa:2, 2)
   ACT(g:Val(aa:2), 'Total '~BuscarCampo('ESPECIES', 'Nombre', 'Codigo', Val(ac:1)))
   ACN(h:Val(aa:2), Val(aa:3))
   ACN(i:Val(aa:2), Val(aa:4) / Val(aa:5))
   SetFont(g:Val(aa:2)..i:Val(aa:2),2)

   SCN(aa:2, 1)
else
   MessageBox('No existen datos para mostrar')
   Cancelar
endif


ACO(1, 3)
ACO(2, 6)
ACO(3, 7)
ACO(4, 7)
ACO(5, 7)
ACO(6, 10)
ACO(7, 13)
ACO(8, 9)
ACO(9, 6)

LimitesVision(i:Val(aa:2))
