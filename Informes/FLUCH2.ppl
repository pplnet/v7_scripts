CrearDialogo
  Fecha1 : 'Fecha'     ;1;1;;;;;;;Fsys
  Cliente1:'Cliente'     ;2;2;
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'
  Radio1: 'Filtro|Todo|Liq.DDC|Liq.DDV|Conc.DDC|Conc.DDV|Acred.DDC|Acred.DDV'
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Flujo de cheques de cartera propia')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)
if NoVacio(Dialogo.Cliente1)
  ACT(a3, 'Cliente: '~Dialogo.Cliente1)
else
  ACT(a3, 'Cliente: Todos')
endif
ACT(c3, 'Especie:'~Dialogo.Especie1)
if Dialogo.Radio1>2
  if Dialogo.Radio1>4
    let &Filtro 'Acreditacion '
  else
    let &Filtro 'Concertacion '
  endif
else
  let &Filtro 'Liquidacion '
endif
if Dialogo.Radio1=1 or Dialogo.Radio1=3 or Dialogo.Radio1=5
  let &Filtro &Filtro~'Compras'
else
  let &Filtro &Filtro~'Ventas'
endif
ACT(a4, &Filtro)


ACT(a6, 'NrOperacion')
ACT(b6, 'TipoOp')
ACT(c6, 'Cliente')
ACT(d6, 'Fecha Op.')
ACT(e6, 'Fecha Liq.')
ACT(f6, 'Pl.Liq')
ACT(g6, 'F.Acred.')
ACT(h6, 'Pl.Vto')
ACT(i6, 'Monto')
ACT(j6, 'Interes')
ACT(k6, 'Capital')
ACT(l6, 'Derechos')
ACT(m6, 'Aranceles')
ACT(n6, 'Gastos')
ACT(o6, 'IVA')
ACT(p6, 'RG1603')
ACT(q6, 'Nr.Boleto')

*let &TipoOp 'DDC|DDV'
if Dialogo.Radio1=1 o Dialogo.Radio1=3 o Dialogo.Radio1=5
  let &TipoOp 'DDC'
endif
if Dialogo.Radio1=2 o Dialogo.Radio1=4 o Dialogo.Radio1=6
  let &TipoOp 'DDV'
endif


SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp ='"~&TipoOp~"'")
if Dialogo.Radio1>2
  if Dialogo.Radio1 < 5
    SQL.ADD(" and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
  else
    SQL.ADD(" and FechaVto2 = '"~IdxDate(Dialogo.Fecha1)~"'")
  endif
else
  SQL.ADD(" and FechaOp2 = '"~IdxDate(Dialogo.Fecha1)~"'")
endif
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("       and Cliente1 = '"~Dialogo.Cliente1~"'")
else
  SQL.ADD("       and Cliente1 <> '"~VAR('VEHICULODE')~"'")
endif

SetFilaActual(6)
*
*Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
*  ifa
*  ACD(a:fac, Dialogo.Fecha1+&i-1)
*proximo
*
recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, Val(a:fac))
  ACT(b:fac, fbn('TipoOp'))
  ACT(c:fac, fbn('Cliente1'))
  ACD(d:fac, fbn('FechaOp'))
  ACD(e:fac, fbn('FechaOp2'))
  ACT(f:fac, fbn('Plazo2'))
  ACD(g:fac, fbn('FechaVto2'))
  ACT(h:fac, fbn('Plazo'))
  ACN(i:fac, fbn('TotalBrutoCli1'))
  let &TotalMonto &TotalMonto+fbn('TotalBrutoCli1')
  ACN(j:fac, fbn('TotalIntereses'))
  ACN(k:fac, fbn('Cantidad'))
  let &TotalCapital &TotalCapital+fbn('Cantidad')
  ACN(l:fac, fbn('TotalDerechos'))
  ACN(m:fac, fbn('ImpGastos1'))
  let &TotalComisiones &TotalComisiones+fbn('ImpGastos1')
  ACN(n:fac, fbn('TotalGastos'))
  ACN(o:fac, fbn('TotalIVA')+fbn('ImpGastos2')+fbn('TotalAux1'))
  ACN(p:fac, fbn('TotalRetenciones'))
  ACT(q:fac, fbn('NrBoleto'))
proximo
ACT(a:fac+1, 'Totales')
ACN(k:fac+1, &TotalCapital)
ACN(m:fac+1, &TotalComisiones)
if Dialogo.Radio1>4
  ACN(i:fac+1, &TotalMonto)
endif

let &AnchoColFina 6
let &AnchoColumna 8
ACO(2,&AnchoColFina)
ACO(3,&AnchoColFina)
ACO(4,&AnchoColumna)
ACO(5,&AnchoColumna)
ACO(6,&AnchoColFina)
ACO(7,&AnchoColumna)
ACO(8,&AnchoColFina)
ACO(9,&AnchoColumna)
ACO(10,&AnchoColumna)
ACO(11,&AnchoColumna)
ACO(12,&AnchoColumna)
ACO(13,&AnchoColumna)
ACO(14,&AnchoColumna)
ACO(15,&AnchoColumna)
ACO(16,&AnchoColumna)

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,14,B")
CrearFont(4, "Arial,6,")
CrearFont(5, "Arial,10,BU")
CrearFont(6, "Arial,10,B")
CrearFont(7, "Arial,10,")

setfont(a1..z:fac, 1)
*SetFont(a6..z6, 2)
SetFont(a1..z6, 2)
SetFont(a:fac+1..z:fac+1, 2)

* ColorCeldas(a23..c23,Var('COLOR2'))
  FormatoCeldas(i7..p:fac+1, EXE('F2'))
  *  FormatoCeldas(g7..g:fac+1, EXE('F9'))
  * FormatoCeldas(j7..j:fac+1, EXE('F9'))
  AgregarMarco(a6..q6,1,0,Exe('COLOR2'))
  AgregarMarco(a:fac+1..q:fac+1,1,0,Exe('COLOR2'))
*  AgregarMarco(j6..k6,1,0,Exe('COLOR2'))
*  AgregarMarco(b5..h5,1,0,Exe('COLOR2'))
*  AgregarMarco(j5..k5,1,0,Exe('COLOR2'))
**  AgregarMarco(d13..g16,2,0)
*  AgregarMarco(a19..g21,1,0)
*  AgregarMarco(a23..g33,1,0)
*  AgregarMarco(a23..g26,1,0)
*  AgregarMarco(a23..g23,1,0,Exe('COLOR2'))
  AlinearCeldas(i6..p6,'D')


  LimitesVision(q:fac+2)  


Autofit(si)

