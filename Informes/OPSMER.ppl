CrearDialogo
  Fecha1   : 'Fecha'  ;;;;;;;;;FSys
  Mercado1 : 'Casa Cust.';
FinDialogo

if not Ok
  Cancelar
endif

ACT(a1, 'Operaciones por Mercado')
ACT(a2, 'Fecha : '~Dialogo.Fecha1)
if NoVacio(Dialogo.Mercado1)
  ACT(a3, 'Casa Cust. : '~Dialogo.Mercado1)
  ACT(z1, "and Mercado = '"~Dialogo.Mercado1~"'")
else
  ACT(a3, 'Casa Cust. : Todos')
endif

ACT(a5, 'Tipo Op.')
ACT(b5, 'Especie')
ACT(c5, 'Cliente')
ACT(d5, 'Cantidad')
ACT(e5, 'P.Limpio')
ACT(f5, 'P.Dirty')
ACT(g5, 'Moneda')
ACT(h5, 'F.Vto.')
ACT(i5, 'Forma Liq.')
ACT(j5, 'Corredor')
ACT(k5, 'Total')
ACT(l5, '#Operacion')
ACT(m5, '#Boleto')
ACT(n5, '#SIOPEL')

AlinearCeldas(d5..f5, 'D')
AlinearCeldas(k5..k5, 'D')

SetFilaActual(5)
SQL.ADD("Select TipoOp, Especie, Cliente1, ContraEspecie, PaseCB, Mercado,")
SQL.ADD("Cantidad, Precio1, FechaVto, Corredor, FormaLiquidacion1, FormaLiquidacion2,")
SQL.ADD("TotalNetoCli1, NrOperacion, NrBoleto, NroAltaMAE")
SQL.ADD("from "~DBO~".OPERACIONES where")
SQL.ADD("FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' and TipoOp in ('TIC','TIFC','TIV','TIFV')"~Val(z1))
SQL.ADD("order by NrOperacion")
recorrer SQL 
  ACT(a:fac, fbn('TipoOp'))
  if EqStr(fbn('PaseCB'), '1')
    ACT(a:fac, Val(a:fac)~' x pase')
  endif
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente1'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Precio1'))
  ACN(f:fac, fbn('TotalNetoCli1')/fbn('Cantidad'))
  ACT(g:fac, fbn('ContraEspecie'))
  ACT(h:fac, fbn('FechaVto'))
  if Incluido(fbn('Mercado'), 'CV')
    if EqStr(fbn('FormaLiquidacion1'), '0')
      ACT(i:fac, 'STD')
    else
      if EqStr(fbn('FormaLiquidacion1'), '1')
        ACT(i:fac, 'DVP')
      else
        ACT(i:fac, 'RVP')
      endif
    endif
  else
    if EqStr(fbn('FormaLiquidacion2'), '0')
      ACT(i:fac, 'FD&P')
    else
      if EqStr(fbn('FormaLiquidacion2'), '1')
        ACT(i:fac, 'DVP')
      else
        ACT(i:fac, 'FOP')
      endif
    endif
  endif
  ACT(j:fac, fbn('Corredor'))
  ACN(k:fac, fbn('TotalNetoCli1'))
  ACT(l:fac, fbn('NrOperacion'))
  ACT(m:fac, fbn('NrBoleto'))
  ACT(n:fac, fbn('NroAltaMAE'))
proximo

ACO(3,10)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z5, 1)
SetFont(a6..z:fac, 2)
*FormatoCeldas(e:Val(w1)+6..m:FAC,',2R')
AgregarMarco(a5..n5,1,0,Exe('COLOR'))
*AgregarMarco(b5..c5,1)
*AgregarMarco(d5..e5,1)

LimitesVision(o:FAC+1)
FormatoCeldas(d1..d:fac,Exe('F0R'))
FormatoCeldas(k1..k:fac,Exe('F0R'))
FormatoCeldas(e1..f:fac,Exe('F7'))
Impresion(1,2)
