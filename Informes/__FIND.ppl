ModoReproceso(ConDialogo)
CrearDialogo
    String1     : 'Buscar Texto'    ;1;1;;;;NoVacio(Dialogo.String1);'Debe completar el valor';NO;;;;;;
    Check10     : 'CaseSensitive'   ;1;2;;;;;;;
    Check11     : 'Todos        '   ;2;1;;;;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check5+Dialogo.Check6+Dialogo.Check7+Dialogo.Check8+Dialogo.Check9+Dialogo.Check11>0;'Debe seleccionar un tipo de script';NO;1;IIF(Dialogo.Check1=1 O Dialogo.Check2=1 O Dialogo.Check3=1 O Dialogo.Check4=1 O Dialogo.Check5=1 O Dialogo.Check6=1 O Dialogo.Check7=1 O Dialogo.Check8=1 O Dialogo.Check9=1,0,1);
    Check1      : 'ABMs'            ; ; ;;;;;;;0
    Check3      : 'Eventos'         ; ; ;;;;;;;0
    Check5      : 'Formulas'        ; ; ;;;;;;;0
    Check4      : 'Funciones'       ; ; ;;;;;;;0
    Check2      : 'Informes'        ; ; ;;;;;;;0
    Check9      : 'TiposMinutaBolsa'; ; ;;;;;;;0
    Check6      : 'TiposOperacion'  ; ; ;;;;;;;0
    Check8      : 'TiposOrden'      ; ; ;;;;;;;0
    Check7      : 'TiposTransaccion'; ; ;;;;;;;0
FinDialogo

IF NOT OK
  Cancelar
ENDIF

SetFilaActual(1)

**  ENCABEZADO
ACT(A:FAC, 'TEXTO A BUSCAR:')
**  el campo B:1 se usa luego para los filtros
IF  Dialogo.Check10=1
    ACT(B:FAC, Dialogo.String1)
ELSE
    ACT(B:FAC, Mayusculas2(Dialogo.String1))
ENDIF
AgregarMarco(A:FAC..D:FAC,1,0) 
SetFilaActual(FAC+2)

**  COLUMNAS TITULOS
ACT(A:FAC, 'TABLA')   
ACT(B:FAC, 'CODIGO')
ACT(C:FAC, 'TIPO')    
ACT(D:FAC, 'NOMBRE')    
AgregarMarco(A:FAC..D:FAC,1,0) 
SetFilaActual(FAC+1)

** EN ORACLE LOS CAMPOS Script(LONG) NO PUEDEN FILTARSE DETRO DEL WHERE NI PUEDE USARSE CON UNION (POR ESO SE EVALUAN LOS FILTROS DESDE PPL).

** POR PERFORMANCE HAGO LA CONDICION DE CaseSensitive(Check10) UNA UNICA VEZ EN ESTE PUNTO.

IF  Dialogo.Check10=1
**  CaseSensitive:SI
   
    IF  Dialogo.Check1=1 o Dialogo.Check11=1 
        SQL.ADD("SELECT 'ABMS' as TipoScript, A.Codigo, A.Tipo, A.Nombre, A.Script ")
        SQL.ADD("FROM "~DBO~".ABMS A ")
        RECORRER SQL
            IF Buscar(VAL(B:1),FBN['Script']) 
                ACT(A:FAC, FBN('TipoScript'))  
                ACT(B:FAC, FBN('Codigo')) 
                ACT(C:FAC, FBN('Tipo')) 
                ACT(D:FAC, FBN('Nombre'))   
            ELSE
                SetFilaActual(FAC-1)  
            ENDIF
        PROXIMO
    ENDIF
    
    IF  Dialogo.Check2=1 o Dialogo.Check11=1 
        SQL.ADD("SELECT 'INFORMES' as TipoScript, I.Codigo, I.Tipo, I.Nombre, I.Script ")
