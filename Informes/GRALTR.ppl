*ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"     ;1;;;;;;;;
  Cliente1   : "Cliente"      ;2;;;;;;;;
  Especie1   : "Especie"      ;3;;;;;;;;
  Check1     : "Incl.Anuladas" ;3;2;;
  Fecha1     : "F.Desde"      ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
  Fecha2     : "F.Hasta"      ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
  Lista1     : "Tipos Tr."    ;5;1;;;;;;;;;SQLSET("Select Codigo from "~DBO~".TIPOSTRANSACCION2 ")
  ListaClaves: "Orden"        ;-1;2;;;;;;;;;Trans2
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
else
   If [Not Incluido('BANCO', UsrVehiculos(UsuarioActivo)) o Not Incluido('ROU', UsrVehiculos(UsuarioActivo)) o Not Incluido(VAR('VEHICULODE'), UsrVehiculos(UsuarioActivo))] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "General de Transacciones")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif
if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Cliente : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Cliente : Todos')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+3, 'Especie : '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
else
  ACT(a:FAC+3, 'Especies : Todas')
endif
ACT(a:FAC+4, 'Fecha Desde : '~Dialogo.Fecha1)
ACT(c:FAC+4, 'Fecha Hasta : '~Dialogo.Fecha2)
if NoVacio(Dialogo.Lista1)
   ACT(A:FAC+5, 'Tipo Op. : '~Pipe2coma(Dialogo.Lista1))
  else
   ACT(A:FAC+5, 'Tipo Op. : Todas')
endif
if Dialogo.Check1 = 1
   ACT(A:FAC+6, 'Incluye Transacciones ANULADAS ')
   ColorCeldas(a:fac+6,RGB(128,0,0))   
endif

SetListaClaves(1)
If Vacio(Dialogo.ListaClaves)
  ACT(a:fac+7, "Orden : por Fecha Liquidacion")
Else
  ACT(a:fac+7, "Orden : "~Pipe2coma(Dialogo.ListaClaves))
Endif
SetListaClaves(2)



SetFilaActual(FAC+9)

ACT(A:FAC, "Vehiculo")
ACT(B:FAC, "Fecha Op.")
ACT(c:FAC, "Codigo")
ACT(d:FAC, "Cliente")
ACT(e:FAC, "Cuenta")
ACT(f:FAC, "Tran. (T)")
ACT(g:FAC, "Especie")
ACT(h:FAC, "Tipo Tr.")
ACT(i:FAC, "Cantidad")
ACT(j:FAC, "Numero")
ACT(k:FAC, "Concepto")
ACT(l:FAC, "Estado")
ACT(m:FAC, "Instancia")
ACT(n:FAC, "F.Carga")

AlinearCeldas(a:FAC..h:FAC,'I')
AlinearCeldas(i:FAC..i:FAC,'D')
AlinearCeldas(j:FAC..l:FAC,'I')
SetFont(a5..n:FAC,2)
AgregarMarco(a:FAC..n:FAC,2,0,Exe('COLOR'))

ACN(w1,FAC)
SetFilaActual(FAC)

SQL.ADD("SELECT T.Vehiculo1, T.Fecha1, T.Cliente1, T.Cuenta1, T.Cuenta2, T.PrecioEj, ")
SQL.ADD(" T.Especie, T.FechaEj, T.TipoTr2, T.Cantidad1, T.NrTrans, T.ConceptoCA, T.Ley1, T.Fecha2, ")
SQL.ADD(" T.FechaCargaSys, 1 Tip, T.CB1, T.CB2, T.Precio2  from "~DBO~".TRANSACCIONES2 T")
SQL.ADD("where T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD("  and T.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and T.TipoTr2 In ("~Pipe2Comillas(Dialogo.Lista1)~")")
endif

if Dialogo.Check1 = 1
  SQL.ADD("UNION SELECT T.Vehiculo1, T.Fecha1, T.Cliente1, T.Cuenta1, T.Cuenta2, T.PrecioEj, ")
  SQL.ADD(" T.Especie, T.FechaEj, T.TipoTr2, T.Cantidad1, T.NrTrans, T.ConceptoCA, T.Ley1, T.Fecha2, ")
  SQL.ADD(" T.FechaCargaSys, 2 Tip, T.CB1, T.CB2, T.Precio2  from "~DBO~".BTRANSACCIONES2 T")
  SQL.ADD("where T.Fecha1 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
  if NoVacio(Dialogo.Especie1)
    SQL.ADD("  and T.Especie = '"~Dialogo.Especie1~"' ")
  endif
  if NoVacio(Dialogo.Cliente1)
    SQL.ADD("  and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
  endif
  if NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("  and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
  endif
  if NoVacio(Dialogo.Lista1)
    SQL.ADD("and T.TipoTr2 In ("~Pipe2Comillas(Dialogo.Lista1)~")")
  endif
endif

if NoVacio(Dialogo.ListaClaves)
  SQL.ADD(" order by "~Dialogo.ListaClaves)
Else
  SQL.ADD("order by T.Fecha1 ")
endif


recorrer SQL
  ACN(in2, fac)
  ACT(a:fac, FBN['Vehiculo1'])
  ACT(b:fac, FBN['Fecha1'])
  ACT(c:fac, FBN['Cliente1'])
  ACT(d:fac, Copy(BuscarCampo('Clientes','RazonSocial','Codigo',FBN['Cliente1']),1,30))
  ACT(e:fac, FBN['Cuenta1'])
  IF FBN['CB1'] = 1
     ACT(f:fac, 'T')
     AlinearCeldas(f:FAC,'C')
  ENDIF
  ACT(es:fac, BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',FBN['Especie'])))

  If Vacio(FBN['PrecioEj']) o FBN['PrecioEj'] = 0
     ACT(g:FAC, FBN['Especie']~IIF(NoVacio(Val(es:fac)) y FBN['CB1']=1 y FBN['CB2']=1,'/'~Val(es:fac),''))
    else
     ACT(g:FAC, FBN['Especie']~' '~FBN['FechaEj']~' '~FBN['PrecioEj']~IIF(NoVacio(Val(es:fac)) y FBN['CB1']=1 y FBN['CB2']=1,'/'~Val(es:fac),''))
  endif
  ACT(h:fac, FBN['TipoTr2'])
  ACN(i:fac, FBN['Cantidad1'])
  If eqstr(fbn('TipoTr2'),'CAMEST')
     ACN(i:fac, FBN['Precio2'])
  Endif
  ACT(j:fac, FBN['NrTrans'])

  ACT(k:fac, Copy(BuscarCampo('ConceptosCA','Descripcion','Codigo',FBN['ConceptoCA']),1,20))
  ACT(l:fac, FBN['Ley1'])
  ACD(n:fac,iif(Incluido(fbn['TipoTr2'],'DEP|RET|COMP'),fbn['Fecha2'],fbn['FechaCargaSys']))

  SQL.ADD("SELECT I.NrInstancia, I.Nombre ")
  SQL.ADD("FROM "~DBO~".OPERACIONESBITS OB, "~DBO~".INSTANCIAS I ")
  SQL.ADD("WHERE OB.NrOperacion = '"~Val(j:fac)~"' AND ")
  SQL.ADD("      OB.Valor = '1' AND ")
  SQL.ADD("      I.Tabla = 'TRANSACCIONES2' AND ")
  SQL.ADD("      OB.NrBit = I.NrInstancia ")
  SQL.ADD("ORDER BY NrInstancia ")

  ACT(in1, 'SI')
  Recorrer SQL
     IF EqStr(Val(in1), 'SI')
        dfa
     ENDIF
     ACT(m:fac, FBN['Nombre'])
     ACT(in1, 'NO')
  Proximo
  IF EqStr(Val(in1), 'SI')
     dfa
  ENDIF

  if FBN['Tip'] = 2
     ColorCeldas(a:Val(in2)..m:fac,RGB(128,0,0))
  else
     ACLT(j:Val(in2), FBN['NrTrans'])
     ColorCeldas(m:Val(in2)..m:fac,clBlue)
  endif

proximo

SetFont(a:Val(w1)..N:FAC,1)
ACO(1,7)
ACO(2,6)
ACO(3,7)
ACO(4,20)
ACO(5,6)
ACO(6,5)
ACO(7,7)
ACO(8,5)
ACO(9,10)
ACO(10,6)
ACO(11,10)
ACO(12,6)
ACO(13,12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(n:FAC)
RangoTitulo(a:1..N:FAC, Val(w1))
SetPrintFit(3,86)
