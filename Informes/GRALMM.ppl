CrearDialogo 
  Fecha1   :'F.Op.Desde'  ;1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una F.Op. Desde' ;NO;HABILES(PriDeMes(PriDeMes(fsys,-1,VAR('FERIADODEF'))-1,0,VAR('FERIADODEF')));
  Fecha2   :'F.Op.Hasta'  ;2;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una F.Op. Hasta' ;NO;FSys;
  GrupoEconomico :'Grupo Económico' ;3;1;;;;;;;;;;;
  Fecha3   :'F.Vto.Desde' ;1;2;;;;Dialogo.Fecha3<>0;'Debe Ingresar una F.Vto. Desde';NO;HABILES(PriDeMes(PriDeMes(fsys,-1,VAR('FERIADODEF'))-1,0,VAR('FERIADODEF')));
  Fecha4   :'F.Vto.Hasta' ;2;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una F.Vto. Hasta';No;FSys+365;
  Especie1 :'Moneda'      ;3;2;;;;;;;;;;;;" Codigo in('USD','ARP') ";
  ListaTabla1: 'Cliente'  ;4;1;;;;;;;;;;;;;'Codigo';'Codigo;RazonSocial';'CLIENTES'
  ListaTabla2:'Oficial'   ;11;1;;;;;;;;;;;;;'Codigo' ; 'Codigo;Descripcion' ; 'OFICIALESCUENTA' 
  Lista1   :'Tipos Op.'   ;18;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION where Codigo in ('MMCO','MMCT','MMCREM','MMPF') ")
  Lista2   :'Instancias'  ;5;2;;;;;;;;;SQLSet("Select Nombre from "~DBO~".INSTANCIAS where Tabla = 'OPERACIONES' and NrInstancia in ("~Pipe2Comillas(VAR('INSTMM'))~")")
  Lista5   :'Operador'    ;-8;2;;;;;;;;;SQLSet("select distinct Operador from "~DBO~".OPERACIONES ")
#ifdef CMF
  String1:    'TipoDocumento';0;2;;;;;;;;;SqlSet("SELECT Valor from "~DBO~".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'TIPODOCUMENTO' ");;;    
#else
*  String1:    'TipoDocumento';0;2;;;;;;;;;"C.D.I|CUIL|CUIT|DNI|LE|LC|Instit. Fcieras|Pasaporte|Cedula Mercosur|Pers Jur Extr|Fondo Comun De inv.|Documento Extranjero|Fideicomiso|Nro. Registro IERIC|C.I.E|C.I.Provincial|Grupo Crediticio/Economico|Otro|";;;;    
  String1:    'TipoDocumento';0;2;;;;;;;;;"CI:C.D.I|CIL:CUIL|CUI:CUIT|DNI:DNI|LE:LE|LC:LC|IFI:Instit. Fcieras|PAS:Pasaporte|CED:Cedula Mercosur|PJE:Pers Jur Extr|FCI:Fondo Comun De inv.|DEX:Documento Extranjero|FID:Fideicomiso|EIR:Nro. Registro IERIC|CIE:C.I.E|CIP:C.I.Provincial|GCE:Grupo Crediticio/Economico|OTR:Otro|";;;;    
#endif
  String2: 'Nr Documento' ;1;2;;;;;;;;;
FinDialogo

if not OK 
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,12,B')

ACT(e:fac+5, 'Reporte General de Operaciones Money Markets')
SetFont(e:fac+5, 3)

SetFilaActual(7)

ACT(a:fac,'Fecha Op. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha1)~' hasta el '~Fecha(Dialogo.Fecha2))
SetFont(a:fac..b:fac,1)

ACT(d:fac,'Fecha Vto. :')
ACT(e:fac,'Desde el '~Fecha(Dialogo.Fecha3)~' hasta el '~Fecha(Dialogo.Fecha4))
SetFont(d:fac..e:fac,1)
IFA

If NoVacio(Dialogo.ListaTabla1)
   ACT(a:FAC, 'Clientes: ')
   ACT(b:fac,'('~Dialogo.ListaTabla1~') ')
Else
   ACT(a:FAC,'Clientes: ')
   ACT(b:fac,'Todos')
EndIf

If NoVacio(Dialogo.Especie1)
   ACT(d:fac,'Moneda:')
   ACT(e:fac,'('~Dialogo.Especie1~') '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
Else
   ACT(d:fac,'Moneda:')
   ACT(e:fac,'Todas')
EndIf

IFA
ACT(a:fac,'Tipos Operación:')
SetFont(a:fac,1)
If NoVacio(Dialogo.Lista1)
   Recorrer&i 1,Elementos(Dialogo.Lista1)
     ACT(((&i-1) mod 4)+2:fac,ItemLista(Dialogo.Lista1,&i))
     SetFont(((&i-1) mod 4)+2:fac,1)
     If ((&i-1) mod 4)+2 = 5
        IFA
     EndIf
   Proximo
Else
   ACT(b:fac,'Todos')
   SetFont(b:fac,1)
EndIf

If NoVacio(Dialogo.GrupoEconomico)
   ACT(d:fac,'Grupo Económico:')
   ACT(e:fac, Dialogo.GrupoEconomico)
Else
   ACT(d:fac,'Grupo Económico:')
   ACT(e:fac,'Todos')
EndIf
SetFont(d:fac..e:fac,1)
IFA

If NoVacio(Dialogo.ListaTabla2)
   ACT(a:FAC, 'Oficiales: ')
   ACT(b:fac,'('~Dialogo.ListaTabla2~') ')
Else
   ACT(a:FAC,'Oficiales: ')
   ACT(b:fac,'Todos')
EndIf

If NoVacio(Dialogo.Lista5)
   ACT(d:fac,'Operador:')
   ACT(e:fac,Pipe2Comillas(Dialogo.Lista5))
Else
   ACT(d:fac,'Operador:')
   ACT(e:fac,'Todos')
EndIf
SetFont(d:fac..e:fac,1)
IFA

ACT(az:4,'')
ACT(d:fac,'Instancias:')
If NoVacio(Dialogo.Lista2)
   Recorrer&i 1,Elementos(Dialogo.Lista2)
     ACT(((&i-1) mod 2)*2+2:fac,ItemLista(Dialogo.Lista2,&i))
     ACT(az:4,Val(az:4)~FStr(SQL("select NrInstancia from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and Nombre='"~ItemLista(Dialogo.Lista2,&i)~"' "),1,0)~'|')
     SetFont(((&i-1) mod 2)*2+2:fac,1)
     If ((&i-1) mod 2)*2+2 = 4
        IFA
     EndIf
   Proximo
Else
   ACT(e:fac,'Todas')
EndIf

ACT(a:fac,'Tipo Documento: ')
#ifdef CMF
IF NoVacio(Dialogo.String1)
    ACT(b:fac,Dialogo.String1)
ELSE
    ACT(b:fac,'Todos')
ENDIF

#else
IF NoVacio(Dialogo.String1)
    ACT(zz2:4, Dialogo.String1)
    ACN(zz2:5, Longitud(Val(zz2:4)))
    IF Posicion(':',Val(zz2:4),1) = 3
        ACT(b:fac,Copy(Val(zz2:4),4,Val(zz2:5)))
    ELSE
        ACT(b:fac,Copy(Val(zz2:4),5,Val(zz2:5)))
    ENDIF
ELSE
    ACT(b:fac,'Todos')
ENDIF
#endif
IFA

ACT(a:fac,'Nr Documento: ')
IF NoVacio(Dialogo.String2)
    ACT(b:fac,Dialogo.String2)
ELSE
    ACT(b:fac,'-')
ENDIF

SetFilaActual(14)
ACN(zz1,FAC)

ACT(a:fac, 'Tipo de Operación')
ACT(b:fac, 'Nr. Operación')
ACT(c:fac, 'Fecha Operación')
ACT(d:fac, 'Fecha de Vto')
ACT(e:fac, 'Codigo Cliente FPA')
ACT(f:fac, 'Razon Social')
ACT(g:fac, 'Especie')
ACT(h:fac, 'Cantidad')
ACT(i:fac, 'Tasa')
ACT(j:fac, 'Tasa de Transferencia')
ACT(k:fac, 'Encaje')
ACT(l:fac, 'Plazo')
ACT(m:fac, 'Intereses')
ACT(n:fac, 'Monto')
ACT(o:fac, 'Instancia')
ACT(p:fac, 'Cuenta')
ACT(q:fac, 'Nro de Cuenta')
ACT(r:fac, 'Codigo FPA del GE')
ACT(s:fac, 'Operador')
ACT(t:fac, 'Sector')
ACT(u:fac, 'Oficial Cuenta')
ACT(v:fac, 'Fecha Carga')
ACT(w:fac, 'Tipo Docum')
ACT(x:fac, 'Nr. Documento')
ACT(y:fac, 'Cotización A3500')
ACT(z:fac, 'Codigo de Tasa')
ACT(aa:fac, 'Fecha de Vto Original')
ACT(ab:fac, 'Nr. Operación Anterior')

SetFont(a:6..ab:FAC,1)
SetFont(a:14..ab:FAC,1)
AgregarMarco(a:FAC..ab:FAC,1,0,Exe('COLOR6'))

SQL.ADD("select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, C.Codigo, C.RazonSocial, O.Especie, O.Cantidad, O.Precio1, O.Precio4, O.PorBonificacion, O.Plazo, O.TotalBrutoCli1, O.TotalIntereses, Cu.Nombre as NombreCuenta, Cu.Codigo as NumeroCuenta, I.Nombre as NombreInstancia, I.NrInstancia, GE.Controlante, O.Operador, O.OficialCuenta, O.FechaCarga, C.TipoDocum, C.NrDocum, Cu.CodigoTasa, O.FechaPrecan, O.NrOperacion2 as NrOperacionAnt, O.Cuenta3, O.Sector1 ") 
SQL.ADD("from "~dbo~".OPERACIONES O LEFT JOIN "~dbo~".CLIENTES C ON O.Cliente1 = C.Codigo INNER JOIN "~dbo~".OPERACIONESBITS OB ON O.NrOperacion = OB.NrOperacion ") 
SQL.ADD("JOIN "~dbo~".CUENTAS Cu on O.Cuenta1 = Cu.Codigo LEFT JOIN "~DBO~".GRUPOSECONOMICOS GE on GE.Cliente = C.Codigo INNER JOIN "~DBO~".INSTANCIAS I ON I.NrInstancia = OB.NrBit and OB.Valor = 1 and Tabla = 'OPERACIONES'")
SQL.ADD("where O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("and O.FechaVto between '"~IdxDate(Dialogo.Fecha3)~"' and '"~IdxDate(Dialogo.Fecha4)~"' ")

*-Clientes
IF NoVacio(Dialogo.ListaTabla1)
   SQL.ADD(" and  C.Codigo IN ("~Pipe2Comillas(Dialogo.ListaTabla1)~") ")
ENDIF
*-Moneda
IF NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
*-GrupoEconomico
if NoVacio(Dialogo.GrupoEconomico)
  SQL.ADD("and GE.Controlante = '"~Dialogo.GrupoEconomico~"'")
endif
*-Instancia
if NoVacio(Dialogo.Lista2)
  SQL.ADD("and I.Nombre In ("~Pipe2Comillas(Dialogo.Lista2)~")")
endif
*-TipoOp
IF NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   SQL.ADD(" and O.TipoOp In ('MMCO','MMCT','MMCREM','MMPF') ") 
ENDIF
*-Operador
If NoVacio(Dialogo.Lista5)
   SQL.ADD(" and O.Operador In ("~Pipe2Comillas(Dialogo.Lista5)~") ")
EndIf
*-Oficial
IF NoVacio(Dialogo.ListaTabla2)
   SQL.ADD(" and O.OficialCuenta IN ("~Pipe2Comillas(Dialogo.ListaTabla2)~") ")
ENDIF
*-NrDocumento
IF NoVacio(Dialogo.String2)
   SQL.ADD(" and C.NrDocum = '"~Dialogo.String2~"' ")
ENDIF

#ifdef CMF
*-TipoDocumento
IF NoVacio(Dialogo.String1)
    SQL.ADD("and C.TipoDocum = '"~Dialogo.String1~"' ")
ENDIF

#else
*-TipoDocumento
*Copy(String,P1,N)
IF NoVacio(Dialogo.String1)
    ACT(zz2:2, Dialogo.String1)
    IF Posicion(':',Val(zz2:2),1) = 3
        ACT(zz2:3,Copy(Val(zz2:2),1,2))
        SQL.ADD("and C.TipoDocum = '"~Val(zz2:3)~"' ")
    ELSE
        ACT(zz2:3,Copy(Val(zz2:2),1,3))
        SQL.ADD("and C.TipoDocum = '"~Val(zz2:3)~"' ")
    ENDIF
ENDIF

#endif

SQL.ADD(" order by O.NrOperacion")

recorrer SQL
    ACT(a:fac, fbn['TipoOp'])
    ACT(b:fac, fbn['NrOperacion'])
    ACLO(b:fac, FBN['NrOperacion'])
    ACD(c:fac, fbn['FechaOp']) 
    ACD(d:fac, fbn['FechaVto'])
    ACT(e:fac, fbn['Codigo'])
    ACT(f:fac, fbn['RazonSocial'])
    ACT(g:fac, fbn['Especie'])
    ACN(h:fac, fbn['Cantidad'])
    ACN(i:fac, Round(fbn['Precio1'],6))
    ACN(j:fac, Round(fbn['Precio4'],6))
    ACN(k:fac, fbn['PorBonificacion'])
    ACN(l:fac, fbn['Plazo']) 
    IF not Eqstr(fbn['TipoOp'], 'MMCREM')
        ACN(m:fac, fbn['TotalIntereses'])
    ENDIF
    ACN(n:fac, fbn['TotalBrutoCli1'])
    ACT(o:fac, fbn['NrInstancia']~') '~fbn['NombreInstancia'])
    IF Eqstr(fbn['TipoOp'], 'MMCO') or Eqstr(fbn['TipoOp'], 'MMCT')
        ACT(p:fac, SQL("select Nombre from CUENTAS where Codigo = '"~FBN['Cuenta3']~"'"))
        ACT(q:fac, fbn['Cuenta3'])
    ELSE
        ACT(p:fac, fbn['NombreCuenta'])
        ACT(q:fac, fbn['NumeroCuenta'])
    ENDIF   
    ACT(r:fac, fbn['Controlante']) 
    ACT(s:fac, fbn['Operador'])
    ACT(t:fac, fbn['Sector1'])
    *ACT(t:fac, SQL("select sector from USRVEHICULO where Codigo = '"~FBN['Operador']~"'"))
    ACT(u:fac, fbn['OficialCuenta']~' - '~SQL("Select Descripcion from "~dbo~".OFICIALESCUENTA where Codigo = '"~FBN['OficialCuenta']~"'"))
    ACD(v:fac, fbn['FechaCarga'])
    ACT(w:fac, fbn['TipoDocum'])
    ACT(x:fac, fbn['NrDocum'])
    ACT(y:fac, Cotizacion('COMA35',,,,fbn['FechaOp'],1))
    IF Eqstr(fbn['TipoOp'], 'MMCREM')
        ACT(z:fac, fbn['CodigoTasa'])
    ENDIF
    IF fbn['FechaPrecan'] <> NULL 
        ACD(aa:fac, fbn['FechaPrecan'])
    ELSE
        ACT(aa:fac, '')
    ENDIF
        ACT(ab:fac, fbn['NrOperacionAnt'])
      
proximo

