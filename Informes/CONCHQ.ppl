CrearDialogo
  Fecha1 : 'Fecha'     ;1;1;;;;;;;Fsys
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'  
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Contabilidad de cheques de terceros')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)

ACT(a4, "Concertacion")
 
ACT(a5,'Rubro')
ACT(b5,'Descripcion')
ACT(c5,'Debito')
ACT(d5,'Credito')
ACT(e5,'Moneda')
ACT(f5,'Sucursal')
ACT(g5,'Cuenta')
ACT(h5,'Boleto')
ACT(i5,'Operacion')
ACT(j5,'Cliente')

CrearFont(2, "Arial,8,B")
SetFont(a1..j5, 2)
AgregarMarco(a4..j5,1,0,Exe('COLOR2'))

SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and Especie='"~Dialogo.Especie1~"' and Cliente1<>'"~VAR('VEHICULODE')~"' and FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' order by TipoOp")

let &Especie '80'
* esto cambia si se operan documentos emitidos en otras monedas, no es lo que opera BIND en esta etapa

let &CuentaMercado Var('CTAMDOCHQ')

SetFilaActual(5)
recorrer SQL
  let &ClienteBT BuscarCampo('CLIENTES','AliasBT','Codigo',fbn('Cliente1'))
    ACT(a:fac, '131.718.091 ')
    ACT(b:fac, 'Documentos descontados-Compra a liq.')
  
    ACT(a:fac+1, '321.301.xxx ')
    ACT(b:fac+1, 'Acreedores no financieros por otras compras al contado a liquidar')  
    
    ACT(a:fac+2, '141.187.xxx ')
    ACT(b:fac+2, 'Deudores no Financieros por Otras Ventas al Contado')
  
    ACT(a:fac+3, '131.718.092 ')
    ACT(b:fac+3, 'Documentos descontados-Venta a liq.')
  ACN(c:fac, fbn('Cantidad'))
  ACN(d:fac+1, fbn('Cantidad'))
  ACN(c:fac+2, fbn('Cantidad'))
  ACN(d:fac+3, fbn('Cantidad'))
  ACT(e:fac, &Especie)
  ACT(e:fac+1, &Especie)
  ACT(e:fac+2, &Especie)
  ACT(e:fac+3, &Especie)
  ACT(f:fac, '1')
  ACT(f:fac+1, '1')
  ACT(f:fac+2, '1')
  ACT(f:fac+3, '1')
  ACT(h:fac, fbn('NrBoleto'))
  ACT(h:fac+1, fbn('NrBoleto'))
  ACT(h:fac+2, fbn('NrBoleto'))
  ACT(h:fac+3, fbn('NrBoleto'))
  ACT(i:fac, fbn('NrOperacion'))
  ACLO(i:fac, Val(i:fac))
  ACT(j:fac, fbn('Cliente1'))
  if Incluido(fbn('TipoOp'),'DDC')
    ACT(g:fac, &CuentaMercado)
    ACT(g:fac+1, &CuentaMercado)
    ACT(g:fac+2, &ClienteBT)
    ACT(g:fac+3, &ClienteBT)
  else
    ACT(g:fac, &ClienteBT)
    ACT(g:fac+1, &ClienteBT)
    ACT(g:fac+2, &CuentaMercado)
    ACT(g:fac+3, &CuentaMercado)
  endif
  AgregarMarco(a:fac..j:fac+3,1,0)
  SetFilaActual(fac+3)
proximo


setFilaActual(fac+4)
ACT(a:fac, "Liquidacion")
 
ifa
ACT(a:fac,'Rubro')
ACT(b:fac,'Descripcion')
ACT(c:fac,'Debito')
ACT(d:fac,'Credito')
ACT(e:fac,'Moneda')
ACT(f:fac,'Sucursal')
ACT(g:fac,'Cuenta')
ACT(h:fac,'Boleto')
ACT(i:fac,'Operacion')
ACT(j:fac,'Cliente')

SetFont(a:fac-1..j:fac, 2)
AgregarMarco(a:fac-1..j:fac,1,0,Exe('COLOR2'))


SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and Especie='"~Dialogo.Especie1~"' and Cliente1<>'BIND' and FechaOp2 = '"~IdxDate(Dialogo.Fecha1)~"' order by TipoOp")


recorrer SQL
  let &ClienteBT BuscarCampo('CLIENTES','AliasBT','Codigo',fbn('Cliente1'))
  let &C2530 '2.530'
  ACN(c:fac, fbn('Cantidad'))
  ACN(d:fac+1, fbn('Cantidad'))
  ACN(c:fac+2, fbn('Cantidad'))
  ACN(d:fac+3, fbn('Cantidad'))
  ACT(e:fac, &Especie)
  ACT(e:fac+1, &Especie)
  ACT(e:fac+2, &Especie)
  ACT(e:fac+3, &Especie)
  ACT(e:fac+4, &Especie)
  ACT(e:fac+5, &Especie)
  ACT(e:fac+6, &Especie)
  ACT(e:fac+7, &Especie)
  ACT(e:fac+8, &Especie)
  ACT(e:fac+9, &Especie)
  ACT(e:fac+10, &Especie)
  ACT(f:fac, '1')
  ACT(f:fac+1, '1')
  ACT(f:fac+2, '1')
  ACT(f:fac+3, '1')
  ACT(f:fac+4, '1')
  ACT(f:fac+5, '1')
  ACT(f:fac+6, '1')
  ACT(f:fac+7, '1')
  ACT(f:fac+8, '1')
  ACT(f:fac+9, '1')
  ACT(f:fac+10, '1')
  ACT(h:fac, fbn('NrBoleto'))
  ACT(h:fac+1, fbn('NrBoleto'))
  ACT(h:fac+2, fbn('NrBoleto'))
  ACT(h:fac+3, fbn('NrBoleto'))
  ACT(h:fac+4, fbn('NrBoleto'))
  ACT(h:fac+5, fbn('NrBoleto'))
  ACT(h:fac+6, fbn('NrBoleto'))
  ACT(h:fac+7, fbn('NrBoleto'))
  ACT(h:fac+8, fbn('NrBoleto'))
  ACT(h:fac+9, fbn('NrBoleto'))
  ACT(h:fac+10, fbn('NrBoleto'))
  ACT(i:fac, fbn('NrOperacion'))
  ACLO(i:fac, Val(i:fac))
  ACT(j:fac, fbn('Cliente1'))
  if Incluido(fbn('TipoOp'),'DDC')
  
    ACT(a:fac, '131.718.xxx ')
    ACT(b:fac, 'Documentos descontados')
    ACT(a:fac+1, '131.718.091 ')
    ACT(b:fac+1, 'Documentos descontados-Compra a liq.')
    ACT(a:fac+2, '321.301.xxx ')
    ACT(b:fac+2, 'Acreedores no financieros por otras compras al contado a liquidar')
    ACT(a:fac+3, '231.009.xxx ')
    ACT(b:fac+3, 'Cuenta Liquidacion    ')
    ACT(a:fac+4, '131.718.xxx ')
    ACT(b:fac+4, 'Documentos descontados')
    ACT(a:fac+5, '131.718.092 ')
    ACT(b:fac+5, 'Documentos descontados-Venta a liq.')
    ACT(a:fac+6, '141.187.xxx ')
    ACT(b:fac+6, 'Deudores no Financieros por Otras Ventas al Contado')
    ACT(a:fac+7, '541.009.001 ')
    ACT(b:fac+7, 'Comisiones vinculadas con valores mobiliarios(Por las comisiones)')
    ACT(a:fac+8, '541.009.001 ')
    ACT(b:fac+8, 'Comisiones vinculadas con valores mobiliarios(Por los derechos)')
    ACT(a:fac+9, '331.117.001 ')
    ACT(b:fac+9, 'IVA')
    ACT(a:fac+10, '231.009.xxx ')
    ACT(b:fac+10, 'Cuenta Liquidacion  ')

    ACN(c:fac, fbn('Cantidad'))
    ACN(d:fac+1, fbn('Cantidad'))
    ACN(c:fac+2, fbn('Cantidad'))
    ACN(d:fac+3, fbn('Cantidad'))
    ACN(d:fac+4, fbn('Cantidad'))
    ACN(c:fac+5, fbn('Cantidad'))
    ACN(d:fac+6, fbn('Cantidad'))
    *en la parte de comisiones tambien pongo los gastos....
    ACN(d:fac+7, fbn('ImpGastos1')+fbn('TotalGastos'))
    ACN(d:fac+8, fbn('TotalDerechos'))
    ACN(d:fac+9, fbn('ImpGastos2')+fbn('TotalAux1')+fbn('TotalIVA'))
    ACN(c:fac+10, Val(d:fac+6)+Val(d:fac+7)+Val(d:fac+8)+Val(d:fac+9))

    ACT(g:fac, &CuentaMercado)
    ACT(g:fac+1, &CuentaMercado)
    ACT(g:fac+2, &CuentaMercado)
    ACT(g:fac+3, &CuentaMercado)
    ACT(g:fac+4, &ClienteBT)
    ACT(g:fac+5, &ClienteBT)
    ACT(g:fac+6, &ClienteBT)

    ACT(g:fac+7, &C2530)
    ACT(g:fac+8, &C2530)
    ACT(g:fac+9, &C2530)
    
    
    ACT(g:fac+10, &ClienteBT)
  else

    ACT(a:fac, '131.718.xxx ')
    ACT(b:fac, 'Documentos descontados')
    ACT(a:fac+1, '131.718.091 ')
    ACT(b:fac+1, 'Documentos descontados-Compra a liq.')
    ACT(a:fac+2, '321.301.xxx ')
    ACT(b:fac+2, 'Acreedores no financieros por otras compras al contado a liquidar')
    ACT(a:fac+3, '541.009.001 ')
    ACT(b:fac+3, 'Comisiones vinculadas con valores mobiliarios(Por las comisiones)')
    ACT(a:fac+4, '541.009.001 ')
    ACT(b:fac+4, 'Comisiones vinculadas con valores mobiliarios(Por los derechos)')
    ACT(a:fac+5, '331.117.001 ')
    ACT(b:fac+5, 'IVA')
    ACT(a:fac+6, '231.009.xxx ')
    ACT(b:fac+6, 'Cuenta Liquidacion')
    ACT(a:fac+7, '131.718.xxx ')
    ACT(b:fac+7, 'Documentos descontados')
    ACT(a:fac+8, '131.718.092 ')
    ACT(b:fac+8, 'Documentos descontados-Venta a liq.')
    ACT(a:fac+9, '141.187.xxx ')
    ACT(b:fac+9, 'Deudores no Financieros por Otras Ventas al Contado')
    ACT(a:fac+10, '231.009.xxx ')
    ACT(b:fac+10, 'Cuenta Liquidacion  ')

    ACN(c:fac, fbn('Cantidad'))
    ACN(d:fac+1, fbn('Cantidad'))
    ACN(c:fac+2, fbn('Cantidad'))
    ACN(d:fac+3, fbn('ImpGastos1')+fbn('TotalGastos'))
    ACN(d:fac+4, fbn('TotalDerechos'))
    ACN(d:fac+5, fbn('ImpGastos2')+fbn('TotalAux1')+fbn('TotalIVA'))
    ACN(d:fac+6, Val(c:fac+2)-Val(d:fac+3)-Val(d:fac+4)-Val(d:fac+5))
    ACN(d:fac+7, fbn('Cantidad'))
    ACN(c:fac+8, fbn('Cantidad'))
    ACN(d:fac+9, fbn('Cantidad'))
    ACN(c:fac+10, fbn('Cantidad'))
  
  
    
    ACT(g:fac, &ClienteBT)
    ACT(g:fac+1, &ClienteBT)
    ACT(g:fac+2, &ClienteBT)
    ACT(g:fac+3, &C2530)
    ACT(g:fac+4, &C2530)
    ACT(g:fac+5, &C2530)
    ACT(g:fac+6, &ClienteBT)
    ACT(g:fac+7, &CuentaMercado)
    ACT(g:fac+8, &CuentaMercado)
    ACT(g:fac+9, &CuentaMercado)
    ACT(g:fac+10, &CuentaMercado)
  endif
  AgregarMarco(a:fac..j:fac+10,1,0)
  SetFilaActual(fac+10)
proximo
  
ACO(2, 35)
Autofit(si)
  