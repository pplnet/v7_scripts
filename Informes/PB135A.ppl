*MOVIMIENTOS PENDIENTES DE TRANSACCIONES
SQL.ADD(" SELECT M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
SQL.ADD(" DECODE(M.NrComprob,NULL,0,M.NrComprob) NrComprob, T.CNFormaPago Origen, ")
SQL.ADD(" T.Fecha1 FechaOp, P.Nombre, CH.Estado, T.NrTrans, T.Fecha2, T.Proveedor, ")
SQL.ADD(" B.RazonSocial Banco, C.Numero, CD.Tipo CodigoDatanet, B.Codigo ")
SQL.ADD(" FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, ")
SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, ")
SQL.ADD(" "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".CNPROVEEDORES P, "~DBO~".CHEQUES CH ")
SQL.ADD(" WHERE  M.Cuenta      = C.Codigo  ")
SQL.ADD(" AND    C.Comitente   = B.Codigo  ")
SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
SQL.ADD(" AND    M.Especie     = E.Codigo  ")
SQL.ADD(" AND    T.Chequera1   = CH.Chequera  ")
SQL.ADD(" AND    T.Cantidad2   = CH.NrCheque  ")
SQL.ADD(" AND    T.Proveedor   *= P.Codigo   ")
SQL.ADD(" AND    CD.Tipo       *= TD.Codigo  ")
SQL.ADD(" AND    T.CodigoDatanet1 *= CD.Codigo  ")
SQL.ADD(" AND    E.Tipo        = 'MON' ")
SQL.ADD(" AND    M.NrSaldo     = 1 ")
SQL.ADD(" AND    T.TipoTR2 IN ('DEVM') ")
SQL.ADD(" AND    M.Especie     = '"~Dialogo.Especie1~"' ")
*SQL.ADD(" AND    T.Fecha2  >= "~IdxDate2(Dialogo.Fecha1-VAR('DNTIEMPO'))~" ")
SQL.ADD(" AND    T.Fecha2  >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    T.Fecha2  <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND (M.NrComprob <> 0 AND M.NrComprob IS NOT NULL)  ")
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT M.Cantidad1*(-1) Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
SQL.ADD(" M.Cuenta2 Cuenta, M.TipoTr2 Tipo, 0 NrComprob, '  ' Origen, ")
SQL.ADD(" M.Fecha1 FechaOp, ' ' Nombre, ' ' Estado, M.NrTrans, M.Fecha2, ' ' Proveedor, ")
SQL.ADD(" B.RazonSocial Banco, C.Numero, ' ' CodigoDatanet, B.Codigo ")
SQL.ADD(" FROM   "~DBO~".TRANSACCIONES2 M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
SQL.ADD(" AND    C.Comitente = B.Codigo ")
SQL.ADD(" AND    M.Especie   = E.Codigo ")
SQL.ADD(" AND    E.Tipo      = 'MON' ")
SQL.ADD(" AND    M.Fecha2   >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND    M.Fecha2   <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD(" AND    M.TipoTr2   = 'PROYEC' ")
SQL.ADD(" AND    M.RB1       = '1' ")
SQL.ADD(" AND    M.Especie   = '"~Dialogo.Especie1~"' ")
If Dialogo.Radio2=0
  SQL.ADD(" AND C.TipoCuenta IN ('CC','CCE','CCD') ")
Endif
If Dialogo.Radio2=1
  SQL.ADD(" AND C.TipoCuenta IN ('INT') ")
Endif
If Dialogo.Radio2=2
  SQL.ADD(" AND C.TipoCuenta IN ('REC') ")
Endif
If NoVAcio(Dialogo.Lista1)
  SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY 4,5 ")
