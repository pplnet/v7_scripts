Recorrer SQL
  If Not Eqstr(Val(va:1), fbn('Cliente'))
    If Not Eqstr(Val(va:1), '')
      ACT(a:fac, 'Total Cuenta ->')
      ACN(f:fac, SUM(f:Val(fi:1)..f:fac))
      ACN(g:fac, SUM(g:Val(fi:1)..g:fac))
      SCN(tg:1, Val(f:fac))
      SCN(tg:2, Val(g:fac))
      FormatoCeldas(f:fac..g:fac, EXE('F2'))
      SetFont(a:fac..z:fac,5)
      AgregarMarco(a:fac..i:fac,0,0,0)

      ifa
      ifa
      ACT(a:fac, 'Total General -> '~Pyc(Val(tg:2),1,2))
      ACN(f:fac, Val(tg:1))
      ACN(g:fac, Val(tg:2))
      SetFont(a:fac..z:fac,5)
      ColorCeldas(a:fac..z:fac, clBLUE)
      IFA
      SaltarHoja
    Endif
    message('Vehiculo: '~fbn('Cliente'))
    ACT(a:fac, 'Vehiculo: '~fbn('Cliente'))
    ACT(va:1,fbn('Cliente'))
    ACN(tg:1,0)
    ACN(tg:2,0)
    SetFont(a:fac,2)
    ifa

    ACT(a:fac,   'Banco/Cuenta')
    ACT(b:fac,   'Nro.Cheque')
    ACT(c:fac,   'Fecha de ')
    ACT(c:fac+1, 'Emision')
    ACT(d:fac,   'Fecha de ')
    ACT(d:fac+1, 'Vto/Pago')
    ACT(e:fac,   'Proveedor')
    ACT(f:fac,   'Importe en ')
    ACT(f:fac+1, 'Moneda Local')
    ACT(g:fac,   'Importe en ')
    ACT(g:fac+1, 'Moneda Original')
    ACT(h:fac,   'Transaccion')
    ACT(i:fac,   'Estado')

    AlinearCeldas(a:fac..z:fac+1, 'C')
    SetFont(a:fac..z:fac+1,6)
    AgregarMarco(a:fac..i:fac+1,0,0,EXE('COLOR6'))
    ifa
    ifa
    ACT(cu:1,'')
    ACN(fi:1, fac)
  Endif

  If Not Eqstr(fbn('Cuenta'), Val(cu:1)) y Not Eqstr(Val(cu:1),'')
    ACT(a:fac, 'Total Cuenta ->')
    ACN(f:fac, SUM(f:Val(fi:1)..f:fac))
    ACN(g:fac, SUM(g:Val(fi:1)..g:fac))
    SCN(tg:1, Val(f:fac))
    SCN(tg:2, Val(g:fac))
    SetFont(a:fac..z:fac,5)
    FormatoCeldas(f:fac..g:fac, EXE('F2'))
    AgregarMarco(a:fac..i:fac,0,0,0)
    ifa
    ifa
    ACN(fi:1, fac)
  Endif

  ACT(a:fac, fbn('Banco')~' - '~fbn('Numero'))
  ACN(b:fac, fbn('NrComprob'))
  ACD(c:fac, fbn('FechaOp'))
  ACD(d:fac, fbn('Fecha2'))
  ACT(e:fac, fbn('Proveedor')~' - '~fbn('Nombre'))
  If Not Eqstr(fbn('Especie'), 'ARP')
    ACN(f:fac, fbn('Cantidad')*CotizacionC(fbn('Especie'),,,,FSYS,1,SI,'ARP'))
  Else
    ACN(f:fac, fbn('Cantidad'))
  Endif
  ACN(g:fac, fbn('Cantidad'))
  ACT(h:fac, fbn('NrTrans'))
  ACLT(h:fac, fbn('NrTrans'))
  If Eqstr(fbn('Estado'), 'ASI')
    ACT(i:fac, 'Asignado')
  Endif
  If Eqstr(fbn('Estado'), 'ENT')
    ACT(i:fac, 'Entregado')
  Endif
  If Eqstr(fbn('Estado'), 'ANU')
    ACT(i:fac, 'Anulado')
  Endif

  ACT(cu:1,fbn('Cuenta'))
  FormatoCeldas(b:fac, EXE('F0'))
  FormatoCeldas(f:fac..g:fac, EXE('F2'))
  SetFont(a:fac..z:fac, 7)
