* Control del Cotizaciones Actualizadas por el MAE
ModoReproceso(ConDialogo)
GrillaVisible(SI)
CrearDialogo
  Fecha1   : 'Fecha';;;;;;;;;FSys
FinDialogo

if not Ok
  Cancelar
endif

ACT(a:1, 'Control de cotizaciones')
ACT(a:2, 'Fecha : '~Dialogo.Fecha1)

ACT(xx:3, SQLSET("Select 1 from "~DBO~".FLAGSMERCADO Where mercado = '"~Var('AMBMAE')~"' and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' and registro ='COTS' "))

If Incluido(val(xx:3),'1')
    ACT(a:4,'Los precios del día '~Dialogo.Fecha1~' fueron recibidos.')
Else
    ACT(a:4,'Los precios del día '~Dialogo.Fecha1~' aún no fueron recibidos.')
Endif

ACT(a:6, 'Especie')
ACT(b:6, 'Nombre')
ACT(c:6, 'Cotiz.MAE')

SetFilaActual(7)

SQL.ADD("Select Codigo, PrecioMAE from "~DBO~".COTIZACIONES ")
SQL.ADD(" where PrecioMAE <> 0 and Fecha = '"~IdxDate(Dialogo.Fecha1)~"' order by Codigo ")

Recorrer SQL
    If DesciendeDeEspecie(fbn('Codigo'),'TITULO')
      ACT(a:fac, fbn('Codigo'))
      ACT(b:fac, BuscarCampo('ESPECIES','Nombre','Codigo',Val(a:fac)))
      ACN(c:fac, fbn('PrecioMAE'))
    Else
      DFA
    Endif
Proximo

ACO(2,15)
ACO(3,10)

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z5, 1)
SetFont(a6..z:fac+2, 2)

AgregarMarco(a6..c6,1,0,Exe('COLOR'))
AgregarMarco(a7..a:fac,1,0)
AgregarMarco(b7..b:fac,1,0)
AgregarMarco(c7..c:fac,1,0)
AgregarMarco(a7..c:fac,1,0)

FormatoCeldas(c6..c:fac,Exe('F7'))

ACT(a:FAC+2, 'FIN DEL LISTADO')
SetFont(a:FAC+2..a:FAC+2, 1)

Impresion(1,1)
LimitesVision(d:FAC+3)
RangoTitulo(a:1..d:fac+3,3)

