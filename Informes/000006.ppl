  Radio7   : 'Fx       |Nada|Alguno|Todos|'         ;;2;;;;;;;2
  Radio8   : 'MM o FC  |Nada|Alguno|Todos|'         ;;2;;;;;;;2
  Radio9   : 'Derivados|Nada|Alguno|Todos|'         ;;2;;;;;;;2
