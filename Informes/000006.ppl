  Lista3   : 'Especies'          ;-4;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Status='HAB' ORDER BY Codigo "); 
  Label1   : ''                  ;-4;1;;NO;;;;;'Mark To Market'  
