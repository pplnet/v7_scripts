** SELECCIONO las operaciones de Inversion de Fondos
*- Todas las operaciones
SQL.ADD(" Select  O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, O.FechaVto, O.FechaOp, O.TipoOp, O.Cantidad Importe,  ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMPCCV' THEN O.TotalNetoCli1 ELSE O.Cantidad+O.TotalIntereses END ImporteVto,  ")
SQL.ADD(" CASE O.TipoOp WHEN 'VIMINM' THEN  0 ELSE  O.Cantidad END Cantidad , ")
SQL.ADD(" O.Spread ,O.Precio1 Tasa,  O.RB8, O.Plazo,O.TipoTasa,100 as PorAmor,O.PrecioRef,O.TotalIntereses,O.Plazo AS PlazoTot,")
SQL.ADD(" 0 as NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL,"~DBO~".TIPOSTASA TT ")
SQL.ADD(" where O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' ")
* SQL.ADD(" and  ( (O.TipoOp In ('MMPCCV') and O.MB3=1) or (O.TipoOp In ('VIMIND','VIMINM') and O.MB3=0) )  ")
SQL.ADD(" and  O.TipoOp In ('MMPCCV','VIMIND','VIMINM')   ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.TipoOp,C.Cantidad1 Importe, C.Cantidad1+C.Total3 ImporteVto, ")
SQL.ADD(" C.Cantidad2 Cantidad, CASE O.TipoOp WHEN 'MMPCCM' THEN C.Precio4 ELSE O.Spread END Spread, ")
SQL.ADD(" C.Precio2 Tasa, O.RB8, CASE O.TipoOp WHEN 'MMPCCM' THEN  0 ELSE C.Plazo1 END Plazo,O.TipoTasa,C.Tasa1 PorAmor,")
SQL.ADD(" O.PrecioRef,C.Cantidad3 as TotalIntereses,O.Plazo AS PlazoTot, C.NrCuota") 
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.NrOperacion = C.NrOperacion and O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2  >  '"~IdxDate(Dialogo.Fecha1)~"' ")
* SQL.ADD(" and  ( (O.TipoOp In ('MMCPM')) or (O.TipoOp In ('MMPCCM') and O.MB3=1) ) ")
SQL.ADD(" and  O.TipoOp In ('MMCPM','MMPCCM') ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.TipoOp,O.Cantidad Importe, O.TotalBrutoCli1 ImporteVto, ")
SQL.ADD(" O.Cantidad Cantidad, O.Spread, O.Precio1 Tasa, O.RB8, C.Plazo1 Plazo,O.TipoTasa,C.Tasa1 PorAmor,O.PrecioRef,")
SQL.ADD(" O.TotalIntereses,O.Plazo AS PlazoTot, C.NrCuota ")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.NrOperacion = C.NrOperacion and O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and  C.Fecha1  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2   >  '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and   O.TipoOp In ('MMCDIA') ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz:1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
SQL.ADD(" UNION ALL ")
SQL.ADD("Select  O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, O.FechaVto, O.FechaOp, O.TipoOp,O.Cantidad Importe, ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMCP  ' THEN O.TotalNetoCli1 WHEN 'MMD   ' THEN O.Cantidad WHEN 'MMDCA ' THEN O.Cantidad+O.TotalNetoCli2 ELSE O.TotalBrutoCli1 END ImporteVto,  ")
SQL.ADD(" CASE O.TipoOp WHEN 'MMD   ' THEN 0 ELSE O.Cantidad END Cantidad , O.Spread, ")
SQL.ADD(" O.Precio1 Tasa, O.RB8, O.Plazo,O.TipoTasa,100 as PorAmor,O.PrecioRef ,O.TotalIntereses,O.Plazo AS PlazoTot,")
SQL.ADD(" 0 as NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT ")
SQL.ADD(" where O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto >  '"~IdxDate(Dialogo.Fecha1)~"' AND O.TipoOp In ('MMCP','MMO','MMD','MMCCR','MMD','MMDCA') ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
*- Incluyo las operaciones de MRF 
SQL.ADD(" UNION ALL ")
SQL.ADD("Select  O.NrOperacion, O.Lotes*O.TotalBrutoCli1*O.Precio1*CASE O.MB3 WHEN 0 THEN 1 ELSE -1 END as CapIni,")
SQL.ADD(" O.FechaOp as FechaIni, O.FechaEx4 as VtoFinal,O.Cliente1, O.Vehiculo1, O.Contrato as Especie, O.FechaEx4,")
SQL.ADD(" O.FechaOp, O.TipoOp,O.Lotes*O.TotalBrutoCli1*O.Precio1*CASE O.MB3 WHEN 0 THEN 1 ELSE -1 END  Importe, ")
SQL.ADD(" O.Lotes*O.TotalBrutoCli1*O.Precio1*CASE O.MB3 WHEN 0 THEN 1 ELSE -1 END   AS ImporteVto, O.Cantidad as Cantidad,")
SQL.ADD(" 0 as Spread,O.Precio1 Tasa, O.RB8, O.Plazo,")
SQL.ADD(" CASE O.MB4 WHEN 0 THEN 'Equities' WHEN 1 THEN 'Commodities' WHEN 2 THEN 'Fix Income' WHEN 3 THEN 'Currencies' WHEN 4 THEN 'Indices' WHEN 5 THEN 'Tasas' ELSE 'EuroDolar' END as TipoTasa,100 as PorAmor,O.PrecioRef ,O.TotalIntereses,O.Plazo AS PlazoTot, 0 as NrCuota")
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES  CL ")
SQL.ADD(" where O.Cliente1 = CL.Codigo AND O.PrecioRef Is Not Null and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaEx4 >  '"~IdxDate(Dialogo.Fecha1)~"' AND O.TipoOp='MRF' ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
**********************************************************************************************
****---- PRESTAMOS 
*- MMFIMV
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.TipoOp,C.Cantidad4 Importe, C.Cantidad4+C.Cantidad3 ImporteVto, ")
SQL.ADD(" C.Cantidad2 Cantidad, C.Precio4 as Spread, ")
SQL.ADD(" C.Precio2 Tasa, O.RB8, C.Plazo1 Plazo,O.TipoTasa,C.Tasa1 PorAmor,O.PrecioRef,C.Cantidad3 as TotalIntereses,")
SQL.ADD(" O.Plazo AS PlazoTot, C.NrCuota") 
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.NrOperacion = C.NrOperacion and O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and  O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.FechaVto  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha3    > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  O.TipoOp = 'MMFIMV' ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
*- MMFRNP, Prestamos Locales y OffShore, Postfinanciacion, PreFinanciacion
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select O.NrOperacion, O.PrecioEj as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, O.FechaVto FechaVto, O.FechaOp FechaOp, O.TipoOp,O.PrecioEj Importe, O.TotalNetoCli1  ImporteVto, ")
SQL.ADD(" O.PrecioEj Cantidad, O.Spread,O.Precio1 Tasa, O.RB8, O.Plazo,O.TipoTasa,0 PorAmor,O.PrecioRef,O.TotalIntereses,")
SQL.ADD(" O.Plazo AS PlazoTot, 0 as NrCuota") 
SQL.ADD(" from "~DBO~".OPERACIONES  O,  "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.TipoOp In ('MMFRNP','MMPCL','MMPCOS','MMPI','MMPE') ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
*- MMPLME
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, O.FechaVto FechaVto, O.FechaOp FechaOp, O.TipoOp,O.Cantidad Importe, O.TotalNetoCli1  ImporteVto, ")
SQL.ADD(" O.Cantidad Cantidad, O.Spread,O.Precio1 Tasa, O.RB8, O.Plazo,O.TipoTasa,0 PorAmor,O.PrecioRef,O.TotalIntereses,")
SQL.ADD(" O.Plazo AS PlazoTot, 0 as NrCuota") 
SQL.ADD(" from "~DBO~".OPERACIONES  O,  "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.TipoOp In ('MMPLME') ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF
*- MMPCLM,MMPOSM,MMPEM,MMPIM
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select O.NrOperacion, O.Cantidad as CapIni,O.FechaOp as FechaIni, O.FechaVto as VtoFinal,O.Cliente1, O.Vehiculo1,")
SQL.ADD(" O.Especie, C.Fecha2 FechaVto, C.Fecha1 FechaOp, O.TipoOp,C.Cantidad1 Importe, C.Cantidad1+C.Cantidad3 ImporteVto, ")
SQL.ADD(" C.Cantidad2 Cantidad, C.Precio4 as Spread,C.Precio2 Tasa, O.RB8, C.Plazo1 Plazo,O.TipoTasa,C.Tasa1 PorAmor,")
SQL.ADD(" O.PrecioRef,C.Cantidad3 as TotalIntereses,O.Plazo AS PlazoTot, C.NrCuota") 
SQL.ADD(" from "~DBO~".OPERACIONES  O, "~DBO~".CUOTAS C, "~DBO~".CLIENTES  CL ,"~DBO~".TIPOSTASA TT")
SQL.ADD(" where O.NrOperacion = C.NrOperacion and O.Cliente1 = CL.Codigo AND TT.Codigo=O.TipoTasa AND O.PrecioRef Is Not Null ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto  > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2    > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.TipoOp In ('MMPCLM','MMPOSM','MMPIM','MMPEM') ")
If NoVacio(val(li1))
   SQL.ADD(" and  O.Vehiculo1 In ("~Pipe2Comillas(val(li1))~") ")
EndIf
If NoVacio(val(zz1))
   SQL.ADD(" and  O.NrOperacion = '"~val(zz:1)~"' ")
EndIf
If NoVacio(val(li3))
   SQL.ADD(" and  O.Especie In ("~Pipe2Comillas(val(li3))~") ")
EndIF

SQL.ADD("order by 1,2")

ACT(np1,'')

Recorrer SQL

   *- 0= 360 1=365
   ACN(dc1, FBN['RB8'])

   Message(FBN['NrOperacion']~FBN['PrecioRef']~Fstr(val(dc1),0,0))

   If Not EqSTr(FBN['PrecioRef'],val(gr1)) 
      *- Cambio de Tipo de Tasa
      ACT(gr1,FBN['PrecioRef']) 

      *- Recupera el flujo de tasas para interpolar 
      *- Recibe en pe1: Precio de Referencia y fe1: Fecha de Referencia y devuelve 
      *- uf1:Ultima fila del flujo

      ACT(pe1,val(gr1))
      ACD(fe1,Dialogo.Fecha1)
      ACN(fi1,fac)  
      SetFilaActual(val(fi1))

   EndIf

   *- Cambia de operacion, sumarizo el valor actual total y traslado a net market value 
   IF Not EqStr(FBN['NrOperacion'],val(np1)) y NoVacio(val(np1)) 
      If  Not Incluido(val(h:val(co2)),'Devengado|MToMarket')
          ACN(r:fac,Sum(r:val(co2)..r:fac-1))
          ACN(k:val(co2),val(r:fac))
          ACN(v:fac,Sum(v:val(co2)..v:fac-1))
          ACN(j:val(co2),val(v:fac))
          ACN(l:val(co2),val(k:val(co2))-val(d:val(co2)))
      EndIf

      If  Incluido(val(h:val(co2)),'MToMarket')
          *- Recupero la cotizacio de la especie
          IF Incluido(val(to1),'MRF')
             *- Recupero la cotizacion del contrato
             ACN(co1,Cotizacion(val(c:val(co2)),,,,Dialogo.Fecha1,1) )
             ACN(k:val(co2),BuscarCampo('OPERACIONES','Lotes*TotalBrutoCli1','NrOperacion',val(np1))*val(co1))
             ACN(k:val(co2),val(k:val(co2))*IIF(EqStr(BuscarCampo('OPERACIONES','MB3','NrOperacion',val(np1)),'0'),1,-1) )

             *- Calculo el pl realizado
             ACN(m:val(co2),val(k:val(co2)) - val(d:val(co2))) 
          EndIf

      EndIf

      SetFont(a:val(co2)..v:val(co2),2)
      SetFont(a:fac..v:fac,2)
      FormatoCeldas(v:fac..v:fac, Exe('F0'))
      FormatoCeldas(j:val(co2)..j:val(co2), Exe('F0'))
      ifa 
   EndIf

   IF Not EqStr(FBN['NrOperacion'],val(np1))
      ACT(np1,FBN['NrOperacion']) 
      ACT(to1,FBN['TipoOp']) 
      ACT(a:FAC  , FBN['Vehiculo1'])
      ACT(b:FAC  , FBN['TipoOp'])
      ACT(c:FAC  , FBN['Especie'])
      ACN(d:FAC  , FBN['CapIni'])
      ACT(e:FAC  , FBN['Cliente1'])
      ACT(f:FAC  , FBN['TipoTasa'])
      *- Criterio para Valuar => Devuelve en cr1 el criterio al cual valuar
      (.'CRITEVALU'.)
      ACT(h:FAC  , val(cr1))
      ACN(i:FAC  , FBN['Tasa'])
      ACN(j:fac  , FBN['VtoFinal']-FBN['FechaIni'])
      ACT(g:FAC, FBN['NrOperacion'])
      ACLO(g:FAC, FBN['NrOperacion'])
      *- co1: Contador de Flujos
      ACN(co1,0)
      ACN(co2,fac)

      *- Obtengo el resultado realizado que es el interes de los periodos pasados
      SQL.ADD("SELECT Sum(Cantidad3) as Interes FROM "~DBO~".CUOTAS ")
      SQL.ADD("WHERE NrOperacion='"~val(g:fac)~"' and ")
      SQL.ADD("Fecha1<'"~IdxDate(Dialogo.Fecha1)~"' and Fecha2<='"~IdxDate(Dialogo.Fecha1)~"' ")
      Recorrer SQL
         dfa
         ACN(m:FAC  , FBN['Interes'])
      Proximo
   EndIf

   If EqStr(val(h:val(co2)),'Devengado')
      If FBN['FechaOp']<=Dialogo.Fecha1 y FBN['FechaVto']>Dialogo.Fecha1
         SCN(co1,1)
         ACD(u:FAC  , FBN['FechaVto'])

         *- Obtiene los FD(t,Tj-t) en fd1  y tasa implicita en ti1  
         ACD(fe2,FBN['FechaVto'])
         ACN(o:fac,FBN['Importe'])

         *- Solo se valua por devangos el periodo presente
         (.'VALDEVENG'.)

         ACN(q:fac,val(o:fac))
         ACN(r:fac,val(p:fac)+val(q:fac))
      Else 
         *- v: plazo remanente del periodo convertido en años ponderado por capital
         SCN(v:val(co2), FBN['PorAmor']*(FBN['VtoFinal']-Dialogo.Fecha1)/100)
         dfa
      EndIf
   EndIf

   If EqStr(val(h:val(co2)),'MToModel') 
      SCN(co1,1)
      ACD(u:FAC  , FBN['FechaVto'])

      *- v: plazo remanente del periodo convertido en años ponderado por capital
      ACN(v:FAC  , FBN['PorAmor']*(FBN['VtoFinal']-Dialogo.Fecha1)/100)

      *- Obtiene los FD(t,Tj-t) en fd1  y tasa implicita en ti1  
      ACD(fe2,FBN['FechaVto'])

      If FBN['Plazo']<365
         LinkearHoja ('000005',1, String1=val(pe1),Fecha1=val(fe1),Fecha2=val(fe2) )
         ACN(t:fac,LinkH(1,26:1))
         CerrarHoja('000005',1, String1=val(pe1),Fecha1=val(fe1),Fecha2=val(fe2) )   
         ACL(T:fac, '000005', String1=val(pe1),Fecha1=val(fe1),Fecha2=val(fe2) )
      Else
         LinkearHoja ('000007',1, String1=val(pe1),Fecha1=val(fe1),Fecha2=val(fe2) )
         ACN(t:fac,LinkH(1,26:1))
         CerrarHoja('000007',1, String1=val(pe1),Fecha1=val(fe1),Fecha2=val(fe2) )   
         ACL(T:fac, '000007', String1=val(pe1),Fecha1=val(fe1),Fecha2=val(fe2) )
      EndIf

      If EqSTr(FBN['TipoTasa'],'FIJA')
         ACN(t:fac,1)
       EndIf


   EndIf


   *- MARK TO MODEL Multiple Vencimiento A TASA VARIABLE A CORTO/LARGO PLAZO 
   If EqStr(val(h:val(co2)),'MToModel') y Not EqSTr(FBN['TipoTasa'],'FIJA')  y Incluido(FBN['TipoOp'],'MMCPM|MMPCCM|MMPCLM|MMPEM|MMPIM|MMPOSM|MMFIMV|') 

      *- Como estoy a tasa variable, la unica tasa conocida es la del primer periodo para calcular el flujo
      *- de fondos de interes de la columna n
      If val(co1)=1
         ACN(s:fac,((1/val(t:fac))-1))
         *- Formulas para primer flujo, tasa conocida.
         *- TasaPactada*Cant. dias transcurridos desde el inicio del sett/plazo del settlemente*capital vigente
         *- =+'datos ingresados al sistema'!C5*22/90*'datos ingresados al sistema'!C3
         ACN(n:fac,(FBN['Tasa']+FBN['Spread'])*FBN['Cantidad']*FBN['Plazo']/(IIF(val(dc1)=0,36000,36500)) )    
      Else 
         ACN(s:fac,(val(t:fac-1)/val(t:fac))-1)
         ACN(TS:fac,(val(s:fac)/(FBN['Plazo']/IIF(val(dc1)=0,360,365) ))*100  )
         *-- datos ingresados al sistema$C$3*(((I25/I24)^-1)-1)
         ACN(n:fac,FBN['Cantidad']*(( (val(t:fac)/val(t:fac-1))^-1) -1) )
         ***---Check10 = 1 puede setearlo tambien el evento REPTAS cuando es tasa simulada.
         SQL.ADD("UPDATE "~DBO~".CUOTAS SET Cantidad3 = "~Fstr(ABS((Val(n:fac))),0,2)~", ")
         SQL.ADD("Precio2 = "~Fstr(ABS((Val(ts:fac))),0,6)~", ")   
         SQL.ADD("Check10 = 1 ")                
         SQL.ADD("WHERE NrOperacion = '"~FBN['NrOperacion']~"' ")   
         SQL.ADD("AND NrCuota = "~FStr(FBN['NrCuota'],0,0)~" ")   
         SQL.NEW
         SQL.EXEC
         SQL.ActualizarMovimientos2(FBN['NrOperacion'],SI,NO,NO,NO)
         SQL.EXEC
      EndIf

      ACN(s:fac,(val(s:fac)/(FBN['Plazo']/IIF(val(dc1)=0,360,365) ))*100  )
   
      ACN(o:fac,FBN['Importe'])
      ACN(p:fac,val(n:fac)*val(t:fac))
      ACN(q:fac,val(o:fac)*val(t:fac))
      ACN(r:fac,val(p:fac)+val(q:fac))
   EndIf

   *- MARK TO MODEL Multiple Vencimiento A TASA FIJA  A CORTO PLAZO
   If EqStr(val(h:val(co2)),'MToModel') y EqSTr(FBN['TipoTasa'],'FIJA')  y Incluido(FBN['TipoOp'],'MMCPM|MMPCCM|MMPCLM|MMPEM|MMPIM|MMPOSM|MMFIMV') y FBN['PlazoTot']<=365
      *- Como estoy a tasa Fija, todas las tasas son conocidas para calcular el flujo de fondos de interes de la columna n
      ACN(n:fac,(FBN['Tasa']+FBN['Spread'])*FBN['Cantidad']*FBN['Plazo']/(IIF(val(dc1)=0,36000,36500)) )    
      If val(co1)>1
         ACN(s:fac,(val(t:fac-1)/val(t:fac))-1)
      Else
         ACN(s:fac,((1/val(t:fac))-1))
      EndIf

      ACN(s:fac,(val(s:fac)/(FBN['Plazo']/IIF(val(dc1)=0,360,365) ))*100  )
   
      ACN(o:fac,FBN['Importe'])
      ACN(p:fac,val(n:fac)*val(t:fac))
      ACN(q:fac,val(o:fac)*val(t:fac))
      ACN(r:fac,val(p:fac)+val(q:fac))
   EndIf

   *- MARK TO MODEL Unico Vencimiento A TASA FIJA  A CORTO PLAZO
   If EqStr(val(h:val(co2)),'MToModel') y EqSTr(FBN['TipoTasa'],'FIJA')  y Incluido(FBN['TipoOp'],'MMCP|MMFRNP|MMPCL|MMPCOS|MMPI|MMPE|MMPLME|') y FBN['PlazoTot']<=365
      *- Como estoy a tasa Fija, todas las tasas son conocidas para calcular el flujo de fondos de interes de la columna n
      ACN(n:fac,(FBN['Tasa']+FBN['Spread'])*FBN['Cantidad']*FBN['Plazo']/(IIF(val(dc1)=0,36000,36500)) )    

      If val(co1)>1
         ACN(s:fac,(val(t:fac-1)/val(t:fac))-1)
      Else
         ACN(s:fac,((1/val(t:fac))-1))
      EndIf 
      ACN(s:fac,(val(s:fac)/(FBN['Plazo']/IIF(val(dc1)=0,360,365) ))*100  )
      ACN(o:fac,FBN['Importe'])
      ACN(p:fac,val(n:fac)*val(t:fac))
      ACN(q:fac,val(o:fac)*val(t:fac))
      ACN(r:fac,val(p:fac)+val(q:fac))
   EndIf

   SetFont(a:fac..v:fac,2)
   FormatoCeldas(t:fac..t:fac, Exe('F8'))
   FormatoCeldas(s:fac..s:fac, Exe('F8'))
   FormatoCeldas(v:fac..v:fac, Exe('F0'))
Proximo


Ifa

If Not Incluido(val(h:val(co2)),'Devengado|MToMarket')
   ACN(r:fac,Sum(r:val(co2)..r:fac-1))
   ACN(k:val(co2),val(r:fac))
   ACN(v:fac,Sum(v:val(co2)..v:fac-1))
   ACN(j:val(co2),val(v:fac))
   ACN(l:val(co2),val(k:val(co2))-val(d:val(co2)))
EndIf

If Incluido(val(h:val(co2)),'MToMarket')
   *- Recupero la cotizacio de la especie
   IF Incluido(val(to1),'MRF')
      *- Recupero la cotizacion del contrato
      ACN(co1,Cotizacion(val(c:val(co2)),,,,Dialogo.Fecha1,1) )
      ACN(k:val(co2),BuscarCampo('OPERACIONES','Lotes*TotalBrutoCli1','NrOperacion',val(np1))*val(co1))
      ACN(k:val(co2),val(k:val(co2))*IIF(EqStr(BuscarCampo('OPERACIONES','MB3','NrOperacion',val(np1)),'0'),1,-1) )

      *- Calculo el pl realizado
      ACN(m:val(co2),val(k:val(co2)) - val(d:val(co2))) 
   EndIf
EndIf

FormatoCeldas(v:fac..v:fac, Exe('F0'))
FormatoCeldas(j:val(co2)..j:val(co2), Exe('F0'))
SetFont(a:val(co2)..v:val(co2),2)
FormatoCeldas(r:fac..r:fac, Exe('F2'))
SetFont(a:fac..v:fac,2)
ifa 


ACO(1,8)
ACO(2,8)
ACO(3,8)
ACO(4,8)
ACO(5,8)
ACO(6,8)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,10)
ACO(17,10)
ACO(18,10)
ACO(19,10)
ACO(20,10)
ACO(21,10)
ACO(22,10)
ACO(23,10)

SetFilaActual(fac+3)
LimitesVision(v:fac+1)
Impresion(1,2)


if NoVacio(val(zz:1))
  HojaVisible(NO)
endif