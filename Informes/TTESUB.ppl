ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo1 : "Vehiculo"                          ; 1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1    : "Fecha"                             ;  ; ;;;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
   Mercado1  : "Ubicacion"                         ;  ; ;;;;Vacio(Dialogo.MERCADO1) o [NoVacio(Dialogo.MERCADO1) y NoVacio(BuscarCampo('Mercados','Codigo','Codigo',Dialogo.MERCADO1))];'Error en Ubicacion';NO;;;
   Radio2    : "Moneda|Pesos|Dolares"              ;  ; ;;;;;;;0;
   Lista1    : "Especies"                          ;  ; ;;;;;;;;;SQLSet("SELECT Codigo FROM "~DBO~".ESPECIES WHERE Status='HAB' ORDER BY Codigo ");
FinDialogo
IF Not Ok
   Cancelar
ENDIF

IF Vacio(Dialogo.Lista1) 
   IF MessageBox('Selecciono todas las Especies, #Continua?',0,2) = 7
      Cancelar
   ENDIF
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SQL.ADD("SELECT S1.Especie, E.Nombre, S1.Cupon, E.CodAlfCajaValores, E.Cedel, E.EuroClear, S1.Mercado, S1.NrSaldo, ")
SQL.ADD("       E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, M.Descripcion DescMerc, ")
SQL.ADD("       EC.Descripcion DescEst, SUM(S1.Saldo) Saldo,E.Alias5, E.InteresesC ")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK INDEX=INDSALDIA2) , "~DBO~".ESPECIES E WITH (NOLOCK), "~DBO~".MERCADOS M WITH (NOLOCK), "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)")
SQL.ADD("WHERE E.Codigo = S1.Especie AND ")
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   S1.Especie IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
 SQL.ADD("      (S1.NrSaldo>201 or S1.NrSaldo=101) AND ")
 SQL.ADD("      S1.Saldo <> 0 AND ")
 SQL.ADD("      ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) AND ")
 SQL.ADD("      S1.Mercado = M.Codigo AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha)  ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK INDEX=INDSALDIA2)  ")
SQL.ADD("                  WHERE S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Especie = S1.Especie) ")
SQL.ADD("GROUP BY S1.Especie, E.Nombre,S1.Cupon, E.CodAlfCajaValores, E.Cedel, E.EuroClear, S1.Mercado, S1.NrSaldo, ")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, M.Descripcion, EC.Descripcion,E.Alias5, E.InteresesC ")
SQL.ADD("ORDER BY S1.Especie,S1.Cupon, S1.Mercado, S1.NrSaldo")

ACT(c1, 'Saldos Totales de Especie por Ubicacion')
ACD(c2, Dialogo.Fecha1)
SetFont(c1..c2,3)
AlinearCeldas(c1..c2,'C')

ACT(f4, 'Fecha: '~Var('FECHASYS'))
ACT(a5, 'Moneda: '~IIF(Dialogo.Radio2=0, 'Pesos','Dolares'))
IF NoVacio(Dialogo.Vehiculo1)
   ACT(a6, 'Vehiculo: '~Dialogo.Vehiculo1)
ENDIF
IF NoVacio(Dialogo.Mercado1)
   ACT(c6, 'Ubicacion: '~Dialogo.Mercado1)
ENDIF
IF NoVacio(Dialogo.Lista1)
   ACT(a7, 'Especies: '~Dialogo.Lista1)
ENDIF

SetFont(a4..f7,2)

ACT(a:8, 'Especie')
ACT(b:8, 'Cupon')
ACT(c:8, 'Ubicacion')
ACT(d:8, 'Estado')
ACT(e:8, 'V.N.')
ACT(f:8, 'V.R.')
ACT(g:8, 'Valuacion')

SetFont(a:8..g:8,2)
AlinearCeldas(a:8..g:8,'C')
AgregarMarco(a:8..g:8,2,2,Exe('COLOR'))


* Variable Especie
ACT(az2, '')
* Variable Mercado
ACT(az3, '')

* Acumulador Especie VN
ACN(ay2, 0)
* Acumulador Mercado VN
ACN(ay3, 0)

* Acumulador Especie VR
ACN(ax2, 0)
* Acumulador Mercado VR
ACN(ax3, 0)

* Acumulador General Valuacion
ACN(aw1, 0)
* Acumulador Especie Valuacion
ACN(aw2, 0)
* Acumulador Mercado Valuacion
ACN(aw3, 0)

ACN(fi1, 9)
SetFilaActual(Val(fi1)-1)
Recorrer SQL
   IF Not EqStr(FBN['Especie']~FBN['Cupon'], Val(az2))
      IF Val(ay2) <> 0
         ACT(d:fac, 'Total Ubicacion --->')
         ACN(e:fac, Val(ay3))
         ACN(f:fac, Round(Val(ax3),val(vr2)))
         ACN(g:fac, Val(aw3))
         SetFont(d:fac..g:fac,2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         ifa
         ACT(d:fac, 'Total Especie --->')
         ACN(e:fac, Val(ay2))
         ACN(f:fac, Round(Val(ax2),val(vr2)))
         ACN(g:fac, Val(aw2))
         SetFont(d:fac..g:fac,2)
         ACN(ax2, 0)
         ACN(ay2, 0)
         ACN(aw2, 0)
         SetFilaActual(fac+2)
      ENDIF

      IF EqStr(FBN['Mercado'],'CV')
         ACT(me1, FBN['CodAlfCajaValores'])
      ELSE
         IF EqStr(FBN['Mercado'],'EU')
            ACT(me1, FBN['EuroClear'])
         ELSE
            IF EqStr(FBN['Mercado'],'CE')
               ACT(me1, FBN['Cedel'])
            ELSE
               ACT(me1, FBN['CodAlfCajaValores'])
            ENDIF
         ENDIF
      ENDIF
      ACT(a:fac, FBN['Especie']~' - '~Val(me1)~' - '~FBN['Nombre'])
      ACT(az2, FBN['Especie']~FBN['Cupon'])
      ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
      ACN(vr2, FBN['Alias5'])
      ACT(b:fac, FBN['Cupon'])
      ACT(c:fac, FBN['DescMerc'])
      ACT(az3, FBN['Mercado'])
      SetFont(a:fac..c:fac,2)
   ENDIF

   IF Not EqStr(FBN['Mercado'], Val(az3))
      IF Val(ay2) <> 0
         ACT(d:fac, 'Total Ubicacion --->')
         ACN(e:fac, Val(ay3))
         ACN(f:fac, Round(Val(ax3),val(vr2)) )
         ACN(g:fac, Val(aw3))
         SetFont(d:fac..g:fac,2)
         ACN(ax3, 0)
         ACN(ay3, 0)
         ACN(aw3, 0)
         ifa
      ENDIF
      IF EqStr(FBN['Mercado'],'CV')
         ACT(me1, FBN['CodAlfCajaValores'])
      ELSE
         IF EqStr(FBN['Mercado'],'EU')
            ACT(me1, FBN['EuroClear'])
         ELSE
            IF EqStr(FBN['Mercado'],'CE')
               ACT(me1, FBN['Cedel'])
            ELSE
               ACT(me1, FBN['CodAlfCajaValores'])
            ENDIF
         ENDIF
      ENDIF
*      ACT(a:fac, FBN['Especie']~' - '~Val(me1)~' - '~FBN['Nombre'])
      ACT(c:fac, FBN['DescMerc'])
      ACT(az3, FBN['Mercado'])
      SetFont(a:fac..c:fac,2)
   ENDIF

   ACT(d:fac, FBN['DescEst'])
   ACN(e:fac, FBN['Saldo'])

   * (yu:fac..yz:fac)parametros para la funcion INTERESCLE 
   ACN(yt1, fac)
   ACD(yu:fac, Dialogo.Fecha1)
   ACT(yv:fac, FBN['Especie'])
   ACN(yw:fac, FBN['Saldo'])
   ACD(yx:fac, FBN['FechaCambioTasa'])
   ACN(yy:fac, FBN['TasaIntAnterior'])
   ACN(yz:fac, FBN['TasaIntVigente'])
   (.'INTERESCLE'.)
   ACN(ca:fac, Val(zz:fac))
   ACN(cb:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))
   IF Dialogo.Radio2 = 0
      ACN(cc:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
   ELSE
      ACN(cc:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
   ENDIF

   ACN(f:fac, Round(Val(e:fac)*Val(cb:fac),val(vr2)) )

   IF EqStr(FBN['InteresesC'],'CLE')
      IF Incluido(Val(al4), '1585')
         ACN(g:fac, Val(f:fac)*Val(cc:fac)+(Val(ca:fac)*Val(cc:fac)))
      ELSE
         ACN(g:fac, Val(f:fac)*Val(cc:fac)+Val(ca:fac))
      ENDIF
   ELSE
      ACN(g:fac, Val(e:fac)*Val(cc:fac)+Val(ca:fac))
   ENDIF

   SCN(ay3, Val(e:fac))
   SCN(ax3, Val(f:fac))
   SCN(aw3, Val(g:fac))
   SCN(ay2, Val(e:fac))
   SCN(ax2, Val(f:fac))
   SCN(aw2, Val(g:fac))
   SCN(aw1, Val(g:fac))
Proximo

IF Val(ay2) <> 0
   ifa
   ACT(d:fac, 'Total Ubicacion --->')
   ACN(e:fac, Val(ay3))
   ACN(f:fac, Round(Val(ax3),val(vr2)))
   ACN(g:fac, Val(aw3))
   SetFont(d:fac..g:fac,2)
   ifa
   ACT(d:fac, 'Total Especie --->')
   ACN(e:fac, Val(ay2))
   ACN(f:fac, Round(Val(ax2),val(vr2)))
   ACN(g:fac, Val(aw2))
   SetFont(d:fac..g:fac,2)
   SetFilaActual(fac+2)
   ACT(d:fac, 'Total Valuacion --->')
   ACN(g:fac, Val(aw1))
   SetFont(d:fac..g:fac,2)
   SetFilaActual(fac+2)
ENDIF

FormatoCeldas(f:Val(fi1)..f:fac,Exe('F8'))

SetFilaActual(fac+4)
ACT(a:fac, 'Fin del Listado')

ACO(1,15)
ACO(2,5)
ACO(3,10)
ACO(4,13)
ACO(5,13)
ACO(6,13)
ACO(7,11)

FijarFila(Val(fi1))
LimitesVision(g:fac)
SetPrintFit(3,90)
RangoTitulo(a:1..g:fac, 8)