HOJAVISIBLE(SI)
*-- Contratos de Mercado Regulado
CrearDialogo
   Fecha1   : 'Fecha'                ;;;;;;;;;Fsys;;;;;;
   Radio1   : 'MensajeApertura|NO|SI';;;;;;;;;1;;;;;; 
   Fecha2   : '5DiasDespues'         ;;;;NO;;;;;Habiles(Dialogo.Fecha1,5,VAR('FERIADODEF'),SI);Habiles(Dialogo.Fecha1,5,VAR('FERIADODEF'),SI);;;;;
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,'Arial,10,B')
CrearFont(2,'Arial,8,')
CrearFont(3,'Comic Sans MS,10,B')
CrearFont(4,'Arial,8,B')

ACT(a:1, 'Contratos de Mercado Regulado que Vencen Entre el '~Dialogo.Fecha1~' y el '~Dialogo.Fecha2)
SetFont(a:1..a:1,1)

SetFilaActual(3)

ACT(a:fac, 'Contratos Cuyo First Delivery Date esta por vencer en 5 dias Habiles')
SetFont(a:fac..a:fac,3)

SetFilaActual(fac+2)

ACT(a:fac, 'Faltan')
ACT(b:fac, 'Clase')
ACT(c:fac, 'Codigo')
ACT(d:fac, 'CotizaEn')
ACT(e:fac, 'Delivery')
ACT(f:fac, 'Descripcion')
ACT(g:fac, 'Especies')
ACT(h:fac, 'Estado')
ACT(i:fac, 'LastTrad')
ACT(j:fac, 'LastTradOpc')
ACT(k:fac, 'FirstDelivery')
ACT(l:fac, 'Mercado')
ACT(m:fac, 'MinPriceMove')
ACT(n:fac, 'PriceQuoted')
ACT(o:fac, 'ReutersCod')
ACT(p:fac, 'SettDate')
ACT(q:fac, 'Tamaño')
ACT(r:fac, 'TickerSymbol')
ACT(s:fac, 'TickValue')
ACT(t:fac, 'UnMedida')
ACT(u:fac, 'BloombCod')

AlinearCeldas(a:fac..u:fac, 'I')
AgregarMarco(a:fac..u:fac,2,0,Exe('COLOR'))
SetFont(a:fac..u:fac,4)


*-- 5 dias antes del LastTradingDate
SQL.ADD("Select * from "~DBO~".CONTRATOS WHERE ")
SQL.ADD("MaturityDate Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD(" Order By MaturityDate ")

*-- Recorrer valores
Recorrer SQL
     Message('Contrato Futuro '~FBN['Codigo'])

     *-Calculo cuanto falta para FirstTradingDate
     ACN(z1, DifDias(FBN['MaturityDate'],Dialogo.Fecha1,VAR('FERIADODEF'),SI) )

     ACN(a:fac, val(z1))
     ACT(b:fac, IIF(EqStr(FBN['ClaseContrato'],'COM'),'Commodities',IIF(EqStr(FBN['ClaseContrato'],'EQU'),'Equities',IIF(EqStr(FBN['ClaseContrato'],'FIX'),'Fixed Income',IIF(EqStr(FBN['ClaseContrato'],'CUR'),'Currencies',IIF(EqStr(FBN['ClaseContrato'],'IND'),'Indice','Tasa'))))))
     ACT(c:fac, FBN['Codigo'])
     ACT(d:fac, FBN['CotizaEn'])
     ACT(e:fac, FBN['Delivery'])
     ACT(f:fac, FBN['Descripcion'])
     ACT(g:fac, FBN['Especies'])
     ACT(h:fac, FBN['Estado'])
     ACD(i:fac, FBN['LastTradingDate'])
     ACD(j:fac, FBN['LastTradingDateOpc'])
     ACD(k:fac, FBN['MaturityDate'])
     ACT(l:fac, FBN['Mercado'])
     ACT(m:fac, FBN['MinPriceMovement'])
     ACT(n:fac, FBN['PriceQuoted'])
     ACT(o:fac, FBN['ReutersCod'])
     ACD(p:fac, FBN['SettlementDate'])
     ACT(q:fac, FBN['Tamanio'])
     ACT(r:fac, FBN['TickerSymbol'])
     ACT(s:fac, FBN['TickValue'])
     ACT(t:fac, FBN['UnidadMedida'])
     ACT(u:fac, FBN['BloombergCod'])

     SetFont(a:fac..u:fac,2)
     FormatoCeldas(a:fac..a:fac,"0")

Proximo


ifa
ifa

ACT(a:fac, 'Contratos Cuyo Last Trading  Date esta por vencer en 5 dias Habiles')
SetFont(a:fac..a:fac,3)

SetFilaActual(fac+2)

ACT(a:fac, 'Faltan')
ACT(b:fac, 'Clase')
ACT(c:fac, 'Codigo')
ACT(d:fac, 'CotizaEn')
ACT(e:fac, 'Delivery')
ACT(f:fac, 'Descripcion')
ACT(g:fac, 'Especies')
ACT(h:fac, 'Estado')
ACT(i:fac, 'LastTrad')
ACT(j:fac, 'LastTradOpc')
ACT(k:fac, 'FirstDelivery')
ACT(l:fac, 'Mercado')
ACT(m:fac, 'MinPriceMove')
ACT(n:fac, 'PriceQuoted')
ACT(o:fac, 'ReutersCod')
ACT(p:fac, 'SettDate')
ACT(q:fac, 'Tamaño')
ACT(r:fac, 'TickerSymbol')
ACT(s:fac, 'TickValue')
ACT(t:fac, 'UnMedida')
ACT(u:fac, 'BloombCod')

AlinearCeldas(a:fac..u:fac, 'I')
AgregarMarco(a:fac..u:fac,2,0,Exe('COLOR'))
SetFont(a:fac..u:fac,4)


*-- 5 dias antes del LastTradingDate
SQL.ADD("Select * from "~DBO~".CONTRATOS WHERE ")
SQL.ADD("LastTradingDate Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD(" Order By LastTradingDate ")

*-- Recorrer valores
Recorrer SQL

     Message('Contrato Futuro '~FBN['Codigo'])

     *-Calculo cuanto falta para LastTradingDate
     ACN(z1, DifDias(FBN['LastTradingDate'],Dialogo.Fecha1,VAR('FERIADODEF'),SI) )

     ACN(a:fac, val(z1))
     ACT(b:fac, IIF(EqStr(FBN['ClaseContrato'],'COM'),'Commodities',IIF(EqStr(FBN['ClaseContrato'],'EQU'),'Equities',IIF(EqStr(FBN['ClaseContrato'],'FIX'),'Fixed Income',IIF(EqStr(FBN['ClaseContrato'],'CUR'),'Currencies',IIF(EqStr(FBN['ClaseContrato'],'IND'),'Indice','Tasa'))))))
     ACT(c:fac, FBN['Codigo'])
     ACT(d:fac, FBN['CotizaEn'])
     ACT(e:fac, FBN['Delivery'])
     ACT(f:fac, FBN['Descripcion'])
     ACT(g:fac, FBN['Especies'])
     ACT(h:fac, FBN['Estado'])
     ACD(i:fac, FBN['LastTradingDate'])
     ACD(j:fac, FBN['LastTradingDateOpc'])
     ACD(k:fac, FBN['MaturityDate'])
     ACT(l:fac, FBN['Mercado'])
     ACT(m:fac, FBN['MinPriceMovement'])
     ACT(n:fac, FBN['PriceQuoted'])
     ACT(o:fac, FBN['ReutersCod'])
     ACD(p:fac, FBN['SettlementDate'])
     ACT(q:fac, FBN['Tamanio'])
     ACT(r:fac, FBN['TickerSymbol'])
     ACT(s:fac, FBN['TickValue'])
     ACT(t:fac, FBN['UnidadMedida'])
     ACT(u:fac, FBN['BloombergCod'])

     SetFont(a:fac..u:fac,2)
     FormatoCeldas(a:fac..a:fac,"0")

