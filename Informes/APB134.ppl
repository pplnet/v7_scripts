CrearDialogo
   Fecha1  : 'Fecha'     ;1;1;;;;;;;FSYS
   Radio2 :  'Tipo Cta|Cta.Cte|Interm|Recaud|C.Ahorro|Todos' ;2;1;;;;;;;4
   Check1:  'Incluye Pagadoras';;;;;;;;;1
   Lista1:   'Vehiculos' ; 5;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"), Val(VH:1))
   Lista4:   'Monedas'   ;-1;2;;;;;;;;;SQLSET(" Select Codigo from "~DBO~".ESPECIES WHERE Tipo = 'MON' ");
   Lista2:   'Bancos'    ;  ;1;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CLIENTES WHERE Sector='BAN' ");
   Lista3:   'Cuentas'   ;-6;2;;;;;;;;;SQLSet(" Select Codigo From "~DBO~".CUENTAS  WHERE Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") "~IIF(NOVACIO(Dialogo.Lista1)," AND Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~")",iif(NoVacio(UsrVehiculos(UsuarioActivo))," AND Cliente IN ("~Pipe2Comillas(Val(VH:1))~") " ) )~"  ");
   Radio3:   'Columna|AjM|AjI|AjE|ID|ED|G|T|DF|EF|PII|PIE|CH'   ;;1;;;;;;;0
FinDialogo

If NOT OK
  Cancelar
Endif

