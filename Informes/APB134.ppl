*CHEQUES
If Dialogo.Radio3=11
  SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
  *SQL.ADD(" DECODE(M.NrComprob,NULL,0,M.NrComprob) NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" CASE WHEN M.NrComprob IS NULL THEN '0' ELSE M.NrComprob END NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" CD.Tipo TipoDatanet, CD.Codigo CodigoDatanet, CH.Observaciones DescripcionCodigo, M.NrOperacion, TD.Descripcion DescripcionTipo, 'P' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, ")
  SQL.ADD(" "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD, "~DBO~".CHEQUES CH ") 
  SQL.ADD(" WHERE  M.Cuenta      = C.Codigo  ")
  SQL.ADD(" AND    C.Comitente   = B.Codigo  ")
  SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
  SQL.ADD(" AND    M.Especie     = E.Codigo  ")
  SQL.ADD(" AND    E.Tipo        = 'MON' ")
  SQL.ADD(" AND    M.NrSaldo     = 1 ")
  *SQL.ADD(" AND    CD.Tipo       *= TD.Codigo ")
  *SQL.ADD(" AND    T.CodigoDatanet1 *= CD.Codigo ")
  SQL.ADD(" AND    CD.Tipo       = TD.Codigo ")
  SQL.ADD(" AND    T.CodigoDatanet1 = CD.Codigo ")
  SQL.ADD(" AND    (M.NrComprob<>0 OR M.NrComprob IS NOT NULL) ")
  SQL.ADD(" AND    T.TipoTr2 IN ('DEVM') ")
  SQL.ADD(" AND    T.Cantidad2 = CH.NrCheque ")
  SQL.ADD(" AND    T.Chequera1 = CH.Chequera ")
  SQL.ADD(" AND    TD.Codigo Not IN ("~Pipe2Comillas(Var('CODTNOI'))~") ")
*  SQL.ADD(" AND    ( (T.Fecha2  >= "~IdxDate2(Dialogo.Fecha1-VAR('DNTIEMPO'))~" AND T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~" AND (M.NrComprob <> 0 AND M.NrComprob IS NOT NULL))  ")
*  SQL.ADD("         OR  (T.Fecha2 = "~IdxDate2(Dialogo.Fecha1)~" AND (M.NrComprob=0 OR M.NrComprob IS NULL) ) ) ")
  SQL.ADD("  AND T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~" ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
Endif
ACT(ca:1,'xy')
ACN(kk:1,0)
*AJUSTES y TRF
If Dialogo.Radio3=0 o Dialogo.Radio3=1 o Dialogo.Radio3=2 o Dialogo.Radio3=5 o Dialogo.Radio3=6 o Dialogo.Radio3=3 o Dialogo.Radio3=4
  SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
  SQL.ADD(" M.NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ")
  ***---Aca quite el * de siguiente linea
  *SQL.ADD(" CD.Tipo TipoDatanet, CD.Codigo CodigoDatanet, CD.Descripcion DescripcionCodigo, M.NrOperacion, TD.Descripcion DescripcionTipo, 'E' Estado, DECODE(T.TipoTr2,'CRVM','9','DEVM','9','TRANSF',T.CB6,'9') CB6 ")
  SQL.ADD(" CD.Tipo TipoDatanet, CD.Codigo CodigoDatanet, CD.Descripcion DescripcionCodigo, M.NrOperacion, TD.Descripcion DescripcionTipo, 'E' Estado, CASE WHEN T.TipoTr2='CRVM' THEN '9'WHEN T.TipoTr2='DEVM' THEN '9' WHEN T.TipoTr2='TRANSF' THEN T.CB6 ELSE '9' END CB6 ")
  SQL.ADD(" FROM   "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD ")
  SQL.ADD(" WHERE  M.Cuenta      = C.Codigo ")
  SQL.ADD(" AND    C.Comitente   = B.Codigo ")
  SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
  SQL.ADD(" AND    M.Especie     = E.Codigo ")
  SQL.ADD(" AND    E.Tipo        = 'MON' ")
  SQL.ADD(" AND    M.NrSaldo     = 1 ")
  *SQL.ADD(" AND    CD.Tipo       *= TD.Codigo ")
  *SQL.ADD(" AND    T.CodigoDatanet1 *= CD.Codigo  ")
  SQL.ADD(" AND    CD.Tipo       = TD.Codigo ")
  SQL.ADD(" AND    T.CodigoDatanet1 = CD.Codigo  ")
  SQL.ADD(" AND    (M.NrComprob  ='0' OR M.NrComprob is null OR M.NrComprob='' )  ")
  SQL.ADD(" AND    TD.Codigo Not IN ("~Pipe2Comillas(Var('CODTNOI'))~") ")
  If Dialogo.Radio3=0 o Dialogo.Radio3=1 o Dialogo.Radio3=2 o Dialogo.Radio3=5
    SQL.ADD(" AND  T.TipoTr2 IN ('CRVM','DEVM') ")
    SQL.ADD(" AND  M.FechaMov < T.Fecha1 ")
  Endif
  If Dialogo.Radio3=3 o Dialogo.Radio3=4 
    SQL.ADD(" AND  T.TipoTr2 IN ('CRVM','DEVM','TRANSF') ")
    SQL.ADD(" AND  M.FechaMov = T.Fecha1 ")
    If Dialogo.Radio3=3
      SQL.ADD(" AND M.Cantidad > 0 ")
    Else
      SQL.ADD(" AND M.Cantidad < 0 ")
    Endif
  Endif

  If Dialogo.Radio3=6
    SQL.ADD(" AND T.TipoTr2 IN ('TRANSF') AND (T.CB6 IS NULL OR T.CB6='0') ")
  Endif 

  SQL.ADD(" AND    (T.Fecha1 = "~IdxDate2(Dialogo.Fecha1)~" OR T.Fecha1 = "~IdxDate2(HABILES(Dialogo.Fecha1,-1,'ARG'))~" )")
*  SQL.ADD(" AND    (T.Fecha2  >= "~IdxDate2(Dialogo.Fecha1-VAR('DNTIEMPO'))~" ")
*  SQL.ADD(" AND      T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~") ")
  SQL.ADD(" AND      T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~" ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  If Dialogo.Radio3=6 o Dialogo.Radio3=3 o Dialogo.Radio3=4
    * Traslados
    SQL.ADD(" UNION ALL ")
    SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoTr2 Tipo, ")
    SQL.ADD(" M.NrComprob, T.CNFormaPago Origen, T.Fecha1 FechaOp, B.RazonSocial Banco, C.Numero, ")
    SQL.ADD(" CD.Tipo TipoDatanet, CD.Codigo CodigoDatanet, CD.Descripcion DescripcionCodigo, M.NrOperacion, TD.Descripcion DescripcionTipo, 'P' Estado, T.CB6 ")
    SQL.ADD(" FROM   "~DBO~".MOVPENDIENTES M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".CODIGOSDATANET CD, "~DBO~".TIPOSCODIGODATANET TD ")
    SQL.ADD(" WHERE  M.Cuenta      = C.Codigo ")
    SQL.ADD(" AND    C.Comitente   = B.Codigo ")
    SQL.ADD(" AND    M.NrOperacion = T.NrTrans ")
    SQL.ADD(" AND    M.Especie     = E.Codigo ")
    SQL.ADD(" AND    E.Tipo        = 'MON' ")
    SQL.ADD(" AND    M.NrSaldo     = 1 ")
    *SQL.ADD(" AND    CD.Tipo       *= TD.Codigo  ")
    *SQL.ADD(" AND    T.CodigoDatanet1 *= CD.Codigo  ")
    SQL.ADD(" AND    CD.Tipo       = TD.Codigo  ")
    SQL.ADD(" AND    T.CodigoDatanet1 = CD.Codigo  ")
    SQL.ADD(" AND    T.TipoTr2 IN ('TRANSF') ")
    SQL.ADD(" AND    TD.Codigo Not IN ("~Pipe2Comillas(Var('CODTNOI'))~") ")
    If Dialogo.Radio3=3 o Dialogo.Radio3=4
      SQL.ADD(" AND    T.CB6='1' ")
      If Dialogo.Radio3=3 
        SQL.ADD(" AND M.Cantidad >0 ")
      Else
        SQL.ADD(" AND M.Cantidad <0 ")
      Endif
    Else
      SQL.ADD(" AND   (T.CB6='0' OR T.CB6 IS NULL) ")
    Endif
*    SQL.ADD(" AND    (T.Fecha2  >= "~IdxDate2(Dialogo.Fecha1-VAR('DNTIEMPO'))~" ")
*    SQL.ADD(" AND      T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~") ")
    SQL.ADD(" AND      T.Fecha2 <= "~IdxDate2(Dialogo.Fecha1)~" ")
    (.'PBSELECT'.)
    If NoVAcio(Dialogo.Lista1)
      SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
    Else
      If NoVacio(UsrVehiculos(UsuarioActivo))
        SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
      Endif
    Endif
  Endif
Endif

*OPERACIONES
If Dialogo.Radio3=7 o Dialogo.Radio3=8 o Dialogo.Radio3=9 o Dialogo.Radio3=10
  *MOVIMIENTOS EJECUTADOS DE OPERACIONES LIQUIDADAS
  SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoOp Tipo, ")
  SQL.ADD(" 0 NrComprob, '  ' Origen, T.FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" T.TipoOp TipoDatanet, ' ' CodigoDatanet, M.Leyenda DescripcionCodigo, T.NrOperacion, TOPER.Nombre DescripcionTipo, 'E' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M, ")
  SQL.ADD(" "~DBO~".OPERACIONES T, "~DBO~".TRANSACCIONES2 TR, "~DBO~".ESPECIES E, "~DBO~".TIPOSOPERACION TOPER ")
  SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
  SQL.ADD(" AND    C.Comitente = B.Codigo ")
  SQL.ADD(" AND    T.TipoOp    = TOPER.Codigo ")
  SQL.ADD(" AND    M.NrOperacion = TR.NrTrans ")
  SQL.ADD(" AND    T.NrOperacion = TR.NrOperacionRef1 ")
  SQL.ADD(" AND    M.Especie   = E.Codigo ")
  SQL.ADD(" AND    E.Tipo      = 'MON' ")
  *Traigo los que se liquidaron hoy (sin cheque) y los mov de op que se liq con cheque y se conciliaron hoy
  SQL.ADD(" AND   (   (M.NrSaldo =1 AND M.FechaMov = "~IdxDate2(Dialogo.Fecha1)~")  ")
  SQL.ADD("        OR (M.NrSaldo =99 AND M.FechaEje > "~IdxDate2(Dialogo.Fecha1)~") ) ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  SQL.ADD(" UNION ALL ")
  *MOVIMIENTOS PENDIENTES DE OPERACIONES LIQUIDADAS 
  SQL.ADD(" SELECT /*+ RULE */ M.Cantidad, M.Especie, M.FechaMov, M.Cliente, M.Cuenta, T.TipoOp Tipo, ")
  SQL.ADD(" 0 NrComprob, '  ' Origen, T.FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" T.TipoOp TipoDatanet, ' ' CodigoDatanet, M.Leyenda DescripcionCodigo, T.NrOperacion, TOPER.Nombre DescripcionTipo, 'P' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M, ")
  SQL.ADD(" "~DBO~".OPERACIONES T, "~DBO~".TRANSACCIONES2 TR, "~DBO~".ESPECIES E, "~DBO~".TIPOSOPERACION TOPER ")
  SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
  SQL.ADD(" AND    C.Comitente = B.Codigo ")
  SQL.ADD(" AND    T.TipoOp    = TOPER.Codigo ")
  SQL.ADD(" AND    M.NrOperacion = TR.NrTrans  ")
  SQL.ADD(" AND    T.NrOperacion = TR.NrOperacionRef1 ")
  SQL.ADD(" AND    M.Especie   = E.Codigo ")
  SQL.ADD(" AND    E.Tipo      = 'MON' ")
  *Tengo que traer tambien los movimientos de las operaciones que se liquidaron cheque y todavia no conciliaron
  SQL.ADD(" AND    M.NrSaldo   IN (1,99) ")
  SQL.ADD(" AND    M.FechaMov  <= "~IdxDate2(Dialogo.Fecha1)~" ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Cliente  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Cliente IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  SQL.ADD(" UNION ALL ")
  *MOVIMIENTOS PENDIENTES DE OPERACIONES NO LIQUIDADAS 
  SQL.ADD(" SELECT /*+ RULE */ M.Cantidad*(-1), M.Especie, M.FechaMov, M.EnteCustodia Cliente, M.Cuenta, T.TipoOp Tipo, ")
  SQL.ADD(" 0 NrComprob, '  ' Origen, T.FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" T.TipoOp TipoDatanet, ' ' CodigoDatanet, M.Leyenda DescripcionCodigo, T.NrOperacion, TOPER.Nombre DescripcionTipo, 'P' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".CLIENTES B, "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M, ")
  SQL.ADD(" "~DBO~".OPERACIONES T, "~DBO~".ESPECIES E, "~DBO~".TIPOSOPERACION TOPER ")
  SQL.ADD(" WHERE  M.Cuenta    = C.Codigo ")
  SQL.ADD(" AND    C.Comitente = B.Codigo ")
  SQL.ADD(" AND    M.NrOperacion = T.NrOperacion  ")
  SQL.ADD(" AND    T.TipoOp    = TOPER.Codigo ")
  SQL.ADD(" AND    M.Especie   = E.Codigo ")
  SQL.ADD(" AND    E.Tipo      = 'MON' ")
  SQL.ADD(" AND    M.NrSaldo   = 1 ")
  SQL.ADD(" AND    M.FechaMov  <= "~IdxDate2(Dialogo.Fecha1)~" ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.EnteCustodia  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.EnteCustodia IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif

Endif

If Dialogo.Radio3=3 o Dialogo.Radio3=4
  *ESTIMACIONES
  SQL.ADD(" UNION ALL ")
  SQL.ADD(" SELECT /*+ RULE */ M.Cantidad1 Cantidad, M.Especie, M.Fecha2 FechaMov, M.Vehiculo1 Cliente, ")
  SQL.ADD(" M.Cuenta2 Cuenta, M.TipoTr2 Tipo, 0 NrComprob, '  ' Origen, M.Fecha2 FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" M.TipoTr2 TipoDatanet, ' ' CodigoDatanet, ' ' DescripcionCodigo, M.NrTrans NrOperacion, ' ' DescripcionTipo, 'E' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".TRANSACCIONES2 M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E ")
  SQL.ADD(" WHERE  M.Cuenta2   = C.Codigo ")
  SQL.ADD(" AND    C.Comitente = B.Codigo ")
  SQL.ADD(" AND    M.Especie   = E.Codigo ")
  SQL.ADD(" AND    E.Tipo      = 'MON' ")
  SQL.ADD(" AND    M.Fecha2    = "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND    M.TipoTr2   = 'ESTIMA' ")
    If Dialogo.Radio3=3
      SQL.ADD(" AND M.Cantidad1 > 0 ")
    Else
      SQL.ADD(" AND M.Cantidad1 < 0 ")
    Endif
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Vehiculo1  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  SQL.ADD(" UNION ALL ")
  *DISPONIBILIDADES  - INGRESOS 
  SQL.ADD(" SELECT /*+ RULE */ (M.Importe8+M.Importe9+M.Importe10+M.Importe11) Cantidad, ")
  SQL.ADD(" E.Codigo Especie, M.FechaAcreditacion FechaMov, M.Vehiculo Cliente, ")
  SQL.ADD(" C.Codigo Cuenta, 'DISPOI' Tipo, 0 NrComprob, 'DATANE' Origen, M.FechaAcreditacion FechaOp, B.RazonSocial Banco, C.Numero,  ")
  SQL.ADD(" 'Ingresos por Disponibilidades' TipoDatanet, ' ' CodigoDatanet, ' ' DescripcionCodigo, 'DISPONIB' NrOperacion, ' ' DescripcionTipo, 'E' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E, "~DBO~".DATANET D ")
  SQL.ADD(" WHERE  M.Moneda    = E.Alias3 ")
  SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
  SQL.ADD(" AND    C.Comitente = B.Codigo ")
  SQL.ADD(" AND    C.Numero    = M.Cuenta ")
  SQL.ADD(" AND    D.EstadoAprobacion = 'OK' ")
  SQL.ADD(" AND    (C.Pagadora <> 'SI' OR C.Pagadora IS NULL ) ")
  SQL.ADD(" AND    M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND    D.Archivo   IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
  SQL.ADD(" AND    M.EstadoConciliacion Not IN ("~Pipe2Comillas(Val(MM:1))~") ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
  SQL.ADD(" UNION ALL ")
  * DISPONIBILIDADES  - EGRESOS
  SQL.ADD(" SELECT /*+ RULE */ (M.Importe4+M.Importe5+M.Importe6+M.Importe7)*(-1) Cantidad, ")
  SQL.ADD(" E.Codigo Especie, M.FechaAcreditacion FechaMov, M.Vehiculo Cliente, ")
  SQL.ADD(" C.Codigo Cuenta, 'DISPOE' Tipo, 0 NrComprob, 'DATANE' Origen, M.FechaAcreditacion FechaOp, B.RazonSocial Banco, C.Numero, ")
  SQL.ADD(" 'Egresos por Disponibilidades' TipoDatanet, ' ' CodigoDatanet, ' ' DescripcionCodigo, 'DISPONIB' NrOperacion, ' ' DescripcionTipo, 'E' Estado, '9' CB6 ")
  SQL.ADD(" FROM   "~DBO~".MOVDATANET M, "~DBO~".CUENTAS C, "~DBO~".CLIENTES B, "~DBO~".ESPECIES E, "~DBO~".DATANET D ")
  SQL.ADD(" WHERE  M.Moneda    = E.Alias3 ")
  SQL.ADD(" AND    M.NrDatanet = D.NrDatanet ")
  SQL.ADD(" AND    C.Comitente = B.Codigo ")
  SQL.ADD(" AND    C.Numero    = M.Cuenta ")
  SQL.ADD(" AND    D.EstadoAprobacion = 'OK' ")
  SQL.ADD(" AND    (C.Pagadora <> 'SI' OR C.Pagadora IS NULL ) ")
  SQL.ADD(" AND    M.FechaAcreditacion = "~IdxDate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND    D.Archivo   IN ('DNCCDI','DNAHDI','DNCDDI','DNADDI') ")
  SQL.ADD(" AND    M.EstadoConciliacion Not IN ("~Pipe2Comillas(Val(MM:1))~") ")
  (.'PBSELECT'.)
  If NoVAcio(Dialogo.Lista1)
    SQL.ADD(" AND M.Vehiculo  IN ("~Pipe2Comillas(Dialogo.Lista1)~")  ")
  Else
    If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" AND M.Vehiculo IN ("~Pipe2Comillas(Val(VH:1))~") ")
    Endif
  Endif
Endif
SQL.ADD(" ORDER BY 12,4,2,5 ")

Recorrer SQL

 If fbn('Cantidad')<>0
  *Ajustes Manuales // Ajustes de Ingresos // Ajustes de Egresos
*  If [Dialogo.Radio3=0 y Incluido(fbn('Tipo'), 'CRVM|DEVM') y Not Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y fbn('FechaOp')=Dialogo.Fecha1 y fbn('FechaMov')<Dialogo.Fecha1] o [Dialogo.Radio3=1 y Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('TipoDatanet'),VAR('ZPB11')) o [Incluido(fbn('TipoDatanet'),VAR('ZPB12')) y fbn('Cantidad')>0 ] o [Incluido(fbn('TipoDatanet'),VAR('ZPB13')) y fbn('Cantidad')<0] ]] o [Dialogo.Radio3=2 y Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('TipoDatanet'),VAR('ZPB21')) o [Incluido(fbn('TipoDatanet'),VAR('ZPB22')) y fbn('Cantidad')>0 ] o [Incluido(fbn('TipoDatanet'),VAR('ZPB23')) y fbn('Cantidad')<0] ]] y Incluido(fbn('Estado'), 'E') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=HABILES(Dialogo.Fecha1,-1,'ARG')] y fbn('FechaMov')<fbn('FechaOp')
  If [Dialogo.Radio3=0 y Incluido(fbn('Tipo'), 'CRVM|DEVM') y Not Eqstr(mirt(trim(fbn('Origen'))),'DATANE')] o [Dialogo.Radio3=1 y Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('TipoDatanet'),VAR('ZPB11')) o [Incluido(fbn('TipoDatanet'),VAR('ZPB12')) y fbn('Cantidad')>0 ] o [Incluido(fbn('TipoDatanet'),VAR('ZPB13')) y fbn('Cantidad')<0] ]] o [Dialogo.Radio3=2 y Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('TipoDatanet'),VAR('ZPB21')) o [Incluido(fbn('TipoDatanet'),VAR('ZPB22')) y fbn('Cantidad')>0 ] o [Incluido(fbn('TipoDatanet'),VAR('ZPB23')) y fbn('Cantidad')<0] ]] y Incluido(fbn('Estado'), 'E') y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=HABILES(Dialogo.Fecha1,-1,'ARG')] y fbn('FechaMov')<fbn('FechaOp')
    ACN(kk:1,1)
  Endif

  *Ingresos del Dia // Egresos del Dia
  If [Dialogo.Radio3=3 y Incluido(fbn('Tipo'), 'DISPOI') o [Incluido(fbn('Tipo'), 'ESTIMA') y fbn('Cantidad')>0]] o [Dialogo.Radio3=4 y Incluido(fbn('Tipo'), 'DISPOE') o [Incluido(fbn('Tipo'), 'ESTIMA') y fbn('Cantidad')<0]] o [Incluido(fbn('Tipo'), 'CRVM|DEVM') y fbn('FechaMov')=Dialogo.Fecha1  y Not Eqstr(mirt(trim(fbn('Origen'))),'DATANE') ] o [ [Dialogo.Radio3=3 o Dialogo.Radio3=4] y Incluido(fbn('Tipo'),'TRANSF') y Eqstr(MIRT(TRIM(fbn('CB6'))),'1') y [fbn('FechaMov')=Dialogo.Fecha1 o Eqstr(fbn('Estado'),'P') ] ]
    ACN(kk:1,1)
  Endif

  *Gastos
  If Dialogo.Radio3=5 y Eqstr(mirt(trim(fbn('Origen'))),'DATANE') y [Incluido(fbn('TipoDatanet'),VAR('ZPB31')) o [Incluido(fbn('TipoDatanet'),VAR('ZPB32')) y fbn('Cantidad')>0 ] o [Incluido(fbn('TipoDatanet'),VAR('ZPB33')) y fbn('Cantidad')<0] ] y [fbn('FechaOp')=Dialogo.Fecha1 o fbn('FechaOp')=HABILES(Dialogo.Fecha1,-1,'ARG')] y fbn('FechaMov')<fbn('FechaOp')
    ACN(kk:1,1)
  Endif

  *Traslados
  If Dialogo.Radio3=6 y Incluido(fbn('Tipo'), 'TRANSF') y Not Eqstr(MIRT(TRIM(fbn('CB6'))),'1') y [Eqstr(fbn('Estado'),'P') o fbn('FechaMov')=Dialogo.Fecha1]
    ACN(kk:1,1)
  Endif

  *Depositos Financieros
  If [Dialogo.Radio3=7 y Not Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV|DEVM|CRVM|TRANSF|DISPOI|DISPOE|ESTIMA|SALDO|') y fbn('Cantidad')>0] o [Dialogo.Radio3=8 y Not Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV|DEVM|CRVM|TRANSF|DISPOI|DISPOE|ESTIMA|SALDO|') y fbn('Cantidad')<0] o [Dialogo.Radio3=9 y Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV') y fbn('Cantidad')>0] o [Dialogo.Radio3=10 y Incluido(fbn('Tipo'), 'MMPCCM|MMPCCV') y fbn('Cantidad')<0]
    ACN(kk:1,1)
  Endif

  * Cheques
  If Dialogo.Radio3=11 y fbn('NrComprob')<>0
    ACN(kk:1,1)
  Endif

  If Val(kk:1)=1
    If Not Eqstr(Val(ca:1), fbn('TipoDatanet'))

      If Not Eqstr(Val(ca:1),'xy')
        ACN(h:fac, SUM(h:Val(fi:1)..h:fac))
        SetFont(h:fac, 5)
        FormatoCeldas(h:fac, EXE('F2'))
        AgregarMarco(a:fac..l:fac,0,0,0)
        SCN(to:1, Val(h:fac))
        ifa
        ifa
      Endif

      If Dialogo.Radio3<>0 y Dialogo.Radio3<>6 y Dialogo.Radio3<>11
        ACT(a:fac, fbn('TipoDatanet')~' - '~fbn('DescripcionTipo'))
        ACT(ca:1, fbn('TipoDatanet'))
        message(fbn('TipoDatanet')~' - '~fbn('DescripcionTipo'))
      Else

        If Dialogo.Radio3=0
          ACT(a:fac, 'Ajustes Manuales') 
          message('Ajustes Manuales ')
        Endif

        If Dialogo.Radio3=6
          ACT(a:fac, 'Traslados del dia')
          message('Traslados del dia')
        Endif

        If Dialogo.Radio3=11
          ACT(a:fac, 'Fuelle de Cheques Pendientes')
          message('Fuelle de Cheques Pendientes')
        Endif

        ACT(ca:1, fbn('TipoDatanet'))
      Endif
      SetFont(a:fac, 5)
      AgregarMarco(a:fac..l:fac,0,0,EXE('COLOR8'))
      ACN(fi:1, fac)
      ifa
    Endif

    message(fbn('NrOperacion'))
    ACD(a:fac, fbn('FechaMov'))
    ACD(b:fac, fbn('FechaOp'))
    ACT(c:fac, fbn('NrOperacion'))
    If Incluido(fbn('Tipo'), 'CRVM|DEVM|TRANSF|ESTIMA')
      ACT(c:fac, Val(c:fac)~'('~fbn('Estado')~')')
      ACLT(c:fac, fbn('NrOperacion'))
    Else
      If Not Incluido(fbn('Tipo'),'DISPOE|DISPOI')
        ACT(c:fac, Val(c:fac)~'('~fbn('Estado')~')')
        ACLO(c:fac, fbn('NrOperacion'))
      Endif
    Endif
    ACT(d:fac, fbn('Banco'))
    ACT(e:fac, fbn('Cuenta'))
    ACT(f:fac, fbn('Numero'))
    ACT(g:fac, fbn('Especie'))
    ACN(h:fac, fbn('Cantidad'))
    ACT(i:fac, fbn('NrComprob'))
    If Eqstr(fbn('Origen'), 'DATANE')
      ACT(j:fac, 'DATANET')
    Else
      ACT(j:fac, 'FPA')
    Endif
    ACT(k:fac, fbn('CodigoDatanet'))
    ACT(l:fac, fbn('DescripcionCodigo'))
  Else
    If fac>10
      dfa
    Endif
  Endif

  ACN(kk:1,0)
  FormatoCeldas(h:fac, EXE('F2'))
  SetFont(a:fac..z:fac, 7)
 Endif
