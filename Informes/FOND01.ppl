ModoReproceso(SinDialogo)
CrearDialogo
  Lista1     : "Vehiculo" ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1     : "Fecha"    ;;;;;;Dialogo.Fecha1<>0;'Fecha Incorrecta';NO;Fsys
  Especie2   : "Moneda"   ;;;
  Cliente1   : "Entidad"  ;;;
  Especie1   : "Fondo"    ;;;
  Radio1     : "Tipo|Money Markets|Securities|Todos" ;;;;;;;;;2
FinDialogo
if Not Ok
  Cancelar
endif


ACN(jk1, 0)
*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

*** toma la cantidad de empresas que tienen fondos ***
SQL.ADD("Select Distinct S.EnteCustodia   ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("where  S.Especie = E.Codigo  ")
SQL.ADD("  and  S.NrSaldo = 2 ")
SQL.ADD("  and  Round(S.Saldo,0) <> 0 ")
SQL.ADD("  and  E.Tipo = 'FON' ")

if NoVacio(VAL(ZZ6))
   SQL.ADD("and S.Cliente  in ("~Pipe2Comillas(val(zz6))~") ")
   SQL.ADD("and S.EnteCustodia in ("~Pipe2Comillas(val(zz6))~")  ")
endif

if NoVacio(Dialogo.Especie2)
   SQL.ADD("and E.Cotiza = '"~Dialogo.Especie2~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and E.Issuer = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and S.Especie = '"~Dialogo.Especie1~"' ")
endif
if Dialogo.Radio1 = 0
   SQL.ADD(" and E.Alias2 = '0' ")
endif
if Dialogo.Radio1 = 1
   SQL.ADD(" and E.Alias2 = '1' ")
endif
SQL.ADD("and   S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = 2 ")
SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by S.EnteCustodia ")

acn(cf1,0)
Recorrer SQL
  act(ce:fac,fbn['EnteCustodia'])
  scn(cf1,1)  
Proximo

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)

ACT(d:1,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,1)

ACT(a:FAC, "Resumen Inversion Fondo de Ahorro")
SetFont(a:fac..a:fac,3)

SetFilaActual(4)
ACN(w1,FAC)

if NoVacio(VAL(ZZ6))
  ACT(a:FAC+1, 'Vehiculo : '~VAL(ZZ6))
 else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

ACT(a:FAC+2, 'Fecha Analisis : '~Dialogo.Fecha1)

if NoVacio(Dialogo.Especie2)
  ACT(a:FAC+3, 'Moneda : '~Dialogo.Especie2~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie2))
 else
  ACT(a:FAC+3, 'Moneda : Todas')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+4, 'Entidad : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
 else
  ACT(a:FAC+4, 'Entidad : Todas')
endif
if NoVacio(Dialogo.Especie1)
  ACT(a:FAC+5, 'Fondo : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
 else
  ACT(a:FAC+5, 'Fondo : Todos')
endif
ACT(a:FAC+6, 'Tipo Fondo : '~iif(Dialogo.Radio1=2,'Todos',iif(Dialogo.Radio1=1,'Securities','Money Markets')))
SetFont(a:fac..n:FAC+6,2)

SetFilaActual(FAC+8)

SQL.ADD("Select E.Cotiza, E.Issuer, S.Especie, S.EnteCustodia, S.Saldo ")
SQL.ADD("from "~DBO~".SALDOSDIA S, "~DBO~".ESPECIES E ")
SQL.ADD("where  S.Especie = E.Codigo  ")
SQL.ADD("  and  S.NrSaldo = 2 ")
SQL.ADD("  and  Round(S.Saldo,0) <> 0 ")
SQL.ADD("  and  E.Tipo = 'FON' ")

if NoVacio(VAL(zz6))
   SQL.ADD("and S.Cliente  in ("~Pipe2Comillas(val(zz6))~")  ")
   SQL.ADD("and S.EnteCustodia in ("~Pipe2Comillas(val(zz6))~")  ")
endif
if NoVacio(Dialogo.Especie2)
   SQL.ADD("and E.Cotiza = '"~Dialogo.Especie2~"' ")
endif
if NoVacio(Dialogo.Cliente1)
   SQL.ADD("and E.Issuer = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and S.Especie = '"~Dialogo.Especie1~"' ")
endif
if Dialogo.Radio1 = 0
   SQL.ADD(" and E.Alias2 = '0' ")
endif
if Dialogo.Radio1 = 1
   SQL.ADD(" and E.Alias2 = '1' ")
endif
SQL.ADD("and   S.Fecha = (Select Max(D.Fecha) from "~DBO~".SALDOSDIA D ")
SQL.ADD("                   where  D.EnteCustodia = S.EnteCustodia ")
SQL.ADD("                   and    D.Especie = S.Especie  ")
SQL.ADD("                   and    D.Cliente = S.Cliente  ")
SQL.ADD("                   and    D.NrSaldo = 2 ")
SQL.ADD("                   and    D.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
SQL.ADD("order by E.Cotiza, E.Issuer, S.Especie, S.EnteCustodia ")

* cc3: Maxima Columna
acn(cc3,0)

act(ca1,' ')
act(ca2,' ')
act(ca3,' ')
acn(cg1,fac)
acn(cz1,0)
acn(cd3,0)
Recorrer SQL
  if Not EqStr(val(ca1),fbn['Cotiza'])
     if val(cz1) = 0
        acn(cg1,fac)
     else
        (.'TOTFOND01'.)
        acn(cg1,val(cd3)+6+val(cf1)+8)
        Recorrer&j 1, val(ci1)
          acn(ch:&j,0)
          acn(cw:&j,0)
          acn(ch:&j,15)
          acn(cw:&j,16)
        Proximo
     endif
     act(a:val(cg1),'Moneda : '~fbn['Cotiza']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Cotiza']))
     act(ca1,fbn['Cotiza'])
     SetFont(a:val(cg1)..r:val(cg1),3)

     acn(cc1,2)
     if val(cc2) < val(cc1)
        acn(cc2,val(cc1))
     endif
     acn(cd1,val(cg1)+2)
     act(val(cc1):val(cd1),fbn['Issuer'])
     act(ca2,fbn['Issuer'])
     acn(ci1,1)
     SetFont(val(cc1):val(cd1)..val(cc1):val(cd1),3)
     AgregarMarco(val(cc1):val(cd1)..val(cc1)+1:val(cd1),2,0,Exe('COLOR'))

     acn(cd2,val(cd1)+2)
     if val(cd3) < val(cd2)
        acn(cd3,val(cd2))
     endif
     **//
     ACN(jk2, 1)
     act(val(cc1):val(cd2),'Fondo: '~fbn['Especie']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
     act(ca3,fbn['Especie'])
     SetFont(a:val(cd2)..r:val(cd2),2)

     scn(cd2,1)
     (.'TITFOND01'.)
     SetFilaActual(FAC+12+val(cf1))
  endif
  if Not EqStr(val(ca2),fbn['Issuer'])
     scn(cc1,2)
     if val(cc2) < val(cc1)
        acn(cc2,val(cc1))
     endif
     act(val(cc1):val(cd1),fbn['Issuer'])
     act(ca2,fbn['Issuer'])
     scn(ci1,1)
     SetFont(val(cc1):val(cd1)..val(cc1):val(cd1),3)
     AgregarMarco(val(cc1):val(cd1)..val(cc1)+1:val(cd1),2,0,Exe('COLOR'))

     acn(cd2,val(cd1)+2)
     if val(cd3) < val(cd2)
        acn(cd3,val(cd2))
     endif
     **//
     ACN(jk2, 2)
     act(val(cc1):val(cd2),'Fondo: '~fbn['Especie']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
     act(ca3,fbn['Especie'])
     SetFont(a:val(cd2)..r:val(cd2),2)

     scn(cd2,1)
     (.'TITFOND01'.)
  endif
  if Not EqStr(val(ca3),fbn['Especie'])
     acn(cd2,val(cd2)+9+val(cf1))
     if val(cd3) < val(cd2)
        acn(cd3,val(cd2))
     endif
     **//
     ACN(jk2, 3)

     act(val(cc1):val(cd2),'Fondo: '~fbn['Especie']~'  '~BuscarCampo('Especies','Nombre','Codigo',fbn['Especie']))
     act(ca3,fbn['Especie'])
     SetFont(a:val(cd2)..r:val(cd2),2)

     scn(cd2,1)
     (.'TITFOND01'.)
     SetFilaActual(FAC+9+val(cf1))
  endif
  Recorrer&i 1, val(cf1)
    if EqStr(fbn['EnteCustodia'],val(ce:&i))
       acn(val(cc1):val(cd2)+5+&i,fbn['Saldo'])
       acn(val(cc1)+1:val(cd2)+5+&i,fbn['Saldo']*val(val(cc1):val(cd2)+2))
       scn(ch:val(ci1),fbn['Saldo']*val(val(cc1):val(cd2)+2))
       scn(cw:val(ci1),fbn['Saldo'])
       SetFont(val(cc1):val(cd2)+5+&i..val(cc1)+1:val(cd2)+5+&i,1)
       **// SUBTOTALES por ESPECIE
       Scn(val(cc1):val(cd2)+Val(cf1)+6, fbn['Saldo'])
       Scn(val(cc1)+1:val(cd2)+Val(cf1)+6, fbn['Saldo']*val(val(cc1):val(cd2)+2))
       AgregarMarco(a:val(cd2)+Val(cf1)+6..val(cc1)+1:val(cd2)+Val(cf1)+6,1,0,Exe('COLOR'))
       FormatoCeldas(val(cc1):val(cd2)+Val(cf1)+6..val(cc1)+1:val(cd2)+Val(cf1)+6,Exe('F2'))
       SetFont(a:val(cd2)+Val(cf1)+6..val(cc1)+1:val(cd2)+Val(cf1)+6,2)
    endif
  Proximo
  If val(cc3)<val(cc1)
     acn(cc3,val(cc1))
  EndIf
  acn(cz1,1)
proximo

if val(cz1) > 0
   (.'TOTFOND01'.)
endif

ACO(1,13)
Recorrer&i 2, val(cc3)+1
  ACO(&i,11)
proximo

Impresion(1,2)
SetFilaActual(val(cd3)+val(cf1)+15)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(val(cc3)+1:fac)
RangoTitulo(a1..val(cc3)+1:fac,12)
