*ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : 'Grupo'           ; 1;1;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : 'Vehiculo'        ; 2;1;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Lista2     : 'Tipos Book'      ; 3;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".TIPOSBOOK");
  Lista3     : 'Books'           ;-3;2;;;;;;;;;iif(Vacio(Dialogo.Lista2),SQLSET("Select Codigo From "~DBO~".BOOKS"),SQLSET("Select Codigo From "~DBO~".BOOKS where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "));
  Fecha1     : 'Fecha'           ;-2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Check2     : 'Borra Renglones' ;-1;1;;NO;NO;;;;1
  Radio4     : 'Familia|Todas|Titulos|Fondos|Monedas|Time Dep' ; 0;1;;SI;SI;;;;0
  Radio5     : 'Valuacion|Todo a Mercado|Propios V.Teorico'    ; 1;1;;  ;  ;;;;0
  Check1     : 'Con Cta Vista'   ;2;1;;NO;NO;;;;1
  Check3     : 'Hoja Visible'    ;3;1;;NO;NO;;;;0
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

if Dialogo.Check3=1
  ACT(aa:0, 'AA')
  ACT(ba:0, 'BA')
  ACT(bj:0, 'BJ')
  ACT(br:0, 'BR')
  ACT(ca:0, 'CA')
  ACT(cj:0, 'CJ')
  ACT(cu:0, 'CU')
  ACT(da:0, 'DA')
  ACT(ej:0, 'DJ')
  ACT(du:0, 'DU')
  ACT(ea:0, 'EA')
  ACT(ej:0, 'EJ')
  ACT(eu:0, 'EU')
endif

*-- Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
  ACT(r:1,Dialogo.Lista1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(r:1, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  else
    ACT(r:1, SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV' "))
  EndIf
EndIf
If NoVacio(Dialogo.Lista2)
  If NoVacio(Dialogo.Lista3)
    ACT(r:3, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  else
    ACT(r:3, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "))
  endif
Else
  If NoVacio(Dialogo.Lista3)
    ACT(r:3, SQLSET("Select Codigo From "~DBO~".BOOKS Where Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  EndIf
EndIf

ACN(r:4, 0)
ACN(r:4, SQL("Select 1 from "~DBO~".VARIABLES where Codigo='MESINIEJE' "))
if Val(r:4)=0
  ACN(r:5, 1)
else
  ACN(r:5, VAR('MESINIEJE'))
endif
if Val(r:5)<1 or Val(r:5)>12
  ACN(r:5, 1)
endif
if Mes(Dialogo.Fecha1)>=Val(r:5)
  ACT(r:6, '01/'~Pad0(FStr(Val(r:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1),4,0))
else
  ACT(r:6, '01/'~Pad0(FStr(Val(r:5),1,0),2)~'/'~FStr(Anio(Dialogo.Fecha1)-1,4,0))
endif
ACD(r:7, Fecha(Val(r:6)))

ACT(y:1, 'Linea Padre')
ACT(y:2, '# Esp.Caja')
ACT(y:3, '# Esp.Deuda')
ACT(y:4, '# Esp.T.C.')
ACT(y:5, '# Pos.Tit/Fon')
ACT(y:6, '# Pos.Monedas')
ACT(y:7, '# Pos.Futuro')
ACT(y:8, '# Oper T.Dep.')
ACT(y:9, '# Oper Deuda.')
ACT(y:10, 'Informe')
ACT(z:10, 'REPPOS')

ACT(an:1, 'Esp.Fut')
ACT(ao:1, 'Vehiculo')
ACT(ap:1, 'OK')

ACT(ar:1, 'Esp.Caja')
ACT(as:1, 'TC')
ACT(at:1, 'Total')

ACT(au:1, 'Esp.Deuda')
ACT(av:1, 'TC')
ACT(aw:1, 'Total')

ACT(ax:1, 'Esp.TC')
ACT(ay:1, 'Cotiza')
ACT(az:1, 'TC')

ACT(ar:2, 'ARP')
ACN(as:2, CotizacionC('ARP',,,,Dialogo.Fecha1-1,1,,'USD'))
ACT(ar:3, 'USD')
ACN(as:3, CotizacionC('USD',,,,Dialogo.Fecha1-1,1,,'USD'))
ACN(z:2, 3)

ACT(au:2, 'ARP')
ACN(av:2, CotizacionC('ARP',,,,Dialogo.Fecha1-1,1,,'USD'))
ACT(au:3, 'USD')
ACN(av:3, CotizacionC('USD',,,,Dialogo.Fecha1-1,1,,'USD'))
ACN(z:3, 3)

ACT(ax:2, 'USD')
ACT(ay:2, BuscarCampo('ESPECIES','Cotiza','Codigo','USD'))
ACN(az:2, Cotizacion('USD',,,,Dialogo.Fecha1-1,1))
ACN(z:4, 2)
ACN(z:7, 1)

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)
SetFilaActual(FAC+3)

ACT(f:2,'Fecha : '~Var('FECHASYS'))
SetFont(f:2..f:2,1)

ACT(a:FAC, "Reporte de Posicion Financiera Neta")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)

if NoVacio(Dialogo.Vehiculo2)
  ACT(a:FAC, 'Grupo :')
  ACT(b:FAC, Dialogo.Vehiculo2)
else
  if NoVacio(Dialogo.Lista1)
    ACT(a:FAC, 'Vehiculo/s :') 
    ACT(b:FAC, Pipe2Comillas(Dialogo.Lista1))
  else 
    ACT(a:FAC, 'Vehiculos :')
    ACT(b:FAC, 'Todos')
  endif
endif

*ACT(a:FAC+1, 'Books :')
*if NoVacio(Val(r:3))
*  ACT(b:FAC+1, Val(r:3))
*else
*  ACT(b:FAC+1, 'Todos')
*endif
ACT(a:FAC+1, 'Tipos Book :')
If NoVacio(Dialogo.Lista2)
  ACT(b:FAC+1, Dialogo.Lista2)
else
  ACT(b:FAC+1, 'Todos')
endif
ACT(a:FAC+2, 'Books:')
if NoVacio(Dialogo.Lista3)
  ACT(b:FAC+2, Dialogo.Lista3)
else
  ACT(b:FAC+2, 'Todos')
endif

ACT(a:FAC+3, 'Fecha :')
ACT(b:FAC+3, Dialogo.Fecha1)
ACT(a:FAC+4, 'Familia Caja:')
if Dialogo.Radio4=0
  ACT(b:FAC+4, 'Todas')
endif
if Dialogo.Radio4=1
  ACT(b:FAC+4, 'Titulos')
endif
if Dialogo.Radio4=2
  ACT(b:FAC+4, 'Fondos')
endif
if Dialogo.Radio4=3
  ACT(b:FAC+4, 'Monedas')
endif
if Dialogo.Radio4=4
  ACT(b:FAC+4, 'Time Deposits')
endif

SetFont(a:fac..f:FAC+4,2)

SetFilaActual(FAC+6)

ACN(w:1,FAC)
ACT(a:FAC, 'C O M P A N I A')

SetFilaActual(FAC+1)
ACN(w:2,FAC)
SQL.ADD("Select Codigo,Descripcion,TipoVehiculo,Valor4 from "~DBO~".VEHICULOS ")
SQL.ADD(" where 1=1 ")
If NoVacio(Dialogo.Vehiculo2)
  SQL.ADD(" and (Codigo in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~") or Codigo = '"~Dialogo.Vehiculo2~"') ")
else
  If NoVacio(Dialogo.Lista1)
    SQL.ADD(" and Codigo in ("~Pipe2Comillas(val(r:1))~") ")
  EndIf
endif
SQL.ADD(" order by Valor4,Jerarquia ")
recorrer SQL
  if EqStr(fbn('TipoVehiculo'),'VIN')
    IFA
    ACN(z:1, FAC)
  endif
  ACT(a:FAC, fbn('Descripcion'))
  ACT(aa:FAC, fbn('Codigo'))
  ACT(ab:FAC, fbn('TipoVehiculo'))
  ACN(ac:FAC, fbn('Valor4'))
  ACN(ad:FAC, Val(z:1))
  if EqStr(fbn('TipoVehiculo'),'VIN')
    if fbn('Valor4')=1000
      ACN(ae:FAC, 3)
    else
      ACN(ae:FAC, 2)
    endif
  else
    ACN(ae:FAC, 1)
  endif
Proximo
ACN(w:3, FAC)

(.'AUXRPECAJA'.)

(.'AUXRPEDEU'.)

SetFilaActual(Val(w:1))
ACT(3:FAC, 'C A J A')
recorrer&i 2,Val(z:2)
  ACT(&i:FAC+1, BuscarCampo('ESPECIES','Nombre','Codigo',Val(ar:&i)))
proximo
ACT(Val(z:2)+1:FAC+1, 'Total en USD')
ACT(Val(z:2)+3:FAC, 'D E U D A')
recorrer&i 2,Val(z:3)
  ACT(Val(z:2)+&i:FAC+1, BuscarCampo('ESPECIES','Nombre','Codigo',Val(au:&i)))
proximo
ACT(Val(z:2)+Val(z:3)+1:FAC+1, 'Total en USD')
ACT(Val(z:2)+Val(z:3)+2:FAC, 'Total Neto')
ACT(Val(z:2)+Val(z:3)+2:FAC+1, 'En Dolares')

SetFont(a:FAC..Val(z:2)+Val(z:3)+2:FAC+1,2)
AlinearCeldas(a:FAC..Val(z:2)+Val(z:3)+2:FAC+1,'C')
AgregarMarco(a:FAC..a:FAC+1,1,2,Exe('COLOR'))
AgregarMarco(b:FAC..Val(z:2)+1:FAC  ,1,0,Exe('COLOR'))
AgregarMarco(2+Val(z:2):FAC..Val(z:2)+Val(z:3)+1:FAC  ,1,0,Exe('COLOR'))
AgregarMarco(b:FAC+1..Val(z:2)+Val(z:3)+1:FAC+1,1,2,Exe('COLOR'))
AgregarMarco(Val(z:2)+Val(z:3)+2:FAC..Val(z:2)+Val(z:3)+2:FAC+1,1,2,Exe('COLOR'))

recorrer&i Val(w:2),Val(w:3)
  if NoVacio(Val(a:&i))
    recorrer&j 2,Val(z:2)
      if Val(ac:&i)=1000
        ACN(&j:&i, Val(at:&j))
      endif
      if Val(&j:&i)<>0
        SCN(af:&i, 1)
      endif
      SCN(1+Val(z:2):&i, Val(&j:&i)*Val(as:&j))
    proximo
    if Val(1+Val(z:2):&i)<>0
      SCN(af:&i, 1)
    endif

    recorrer&j 2,Val(z:3)
      if Val(ac:&i)=1000
        ACN(&j:&i, Val(at:&j))
      endif
      if Val(Val(z:2)+&j:&i)<>0
        SCN(af:&i, 1)
      endif
      SCN(Val(z:2)+Val(z:3)+1:&i, Val(Val(z:2)+&j:&i)*Val(av:&j))
    proximo
    if Val(Val(z:2)+Val(z:3)+1:&i)<>0
      SCN(af:&i, 1)
    endif

    ACN(Val(z:2)+Val(z:3)+2:&i, Val(Val(z:2)+1:&i)+Val(Val(z:2)+Val(z:3)+1:&i))
    if Val(Val(z:2)+Val(z:3)+2:&i)<>0
      SCN(af:&i, 1)
    endif
   
    if Val(af:&i)=0
      ACT(ag:&i, 'Eliminar')
    endif
    SetFont(a:&i..Val(z:2)+Val(z:3)+2:&i, Val(ae:&i))
    FormatoCeldas(a:&i..Val(z:2)+Val(z:3)+2:&i,Exe('F2'))
    SetFont(aa:&i..ap:&i, 1)
  endif
proximo

ACN(w:4, Val(w:2)-1)
recorrer&i Val(w2),Val(w:3)
  SCN(w:4, 1)
  if EqStr(Val(ag:Val(w:4)),'Eliminar')
    ACT(ah:Val(w:4), 'Eliminado')
    if Dialogo.Check2=1
      EliminarFila(Val(w:4))
      SCN(w:4, -1)
      DFA
    endif
  endif
proximo

SetFilaActual(Val(w:4)+2)
ACT(a:FAC, 'Tipos de Cambio')
SetFont(a:FAC,2)
if Val(z:4)>1
  recorrer&i 2,Val(z:4)
    if &i>2
      IFA
    endif
    ACT(b:FAC, '1 '~Val(ay:&i)~' / '~Val(ax:&i))
    ACN(c:FAC, Val(az:&i))
    SetFont(b:FAC,2)
    SetFont(c:FAC,1)
    FormatoCeldas(c:FAC,Exe('F8'))
  proximo
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del Listado')
SetFont(a:FAC,2)

SetFont(r:1..z:10,1)
SetFont(an:1..az:1,2)
if Val(z:2)>Val(z:3)
  SetFont(ar:2..az:Val(z:2),1)
else
  SetFont(ar:2..az:Val(z:3),1)
endif
if Val(z:7)>1
  SetFont(an:2..ap:Val(z:7),1)
endif
if Val(z:5)>0
  SetFont(ba:1..br:Val(z:5),1)
endif
if Val(z:6)>0
  SetFont(ca:1..cu:Val(z:6),1)
endif
if Val(z:8)>0
  SetFont(da:1..du:Val(z:8),1)
endif
if Val(z:9)>0
  SetFont(ea:1..eu:Val(z:9),1)
  FormatoCeldas(eh:1..ej:Val(z:9),Exe('F2'))
endif

ACO(1,15)
recorrer&i 2,Val(z:2)+Val(z:3)+2
  ACO(&i,10)
proximo

ACO(25,10)

if Dialogo.Check3=0
  LimitesVision(Val(z:2)+Val(z:3)+2:FAC)
endif
Impresion(1,1)
SetMargins(1,1,0.5,1)
