*-- HojaVisible(SI)
CrearDialogo
  String1    : 'Nombre PMG'                           ;;;;;;;;;'CORENA';;
  Fecha1     : "Fecha"                                ;;;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,SI,'ARG');'Debe Ingresar una Fecha y debe ser un Principio de mes';NO;
  Especie1   : 'Moneda:'                              ;;;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
  Radio6     : 'Clientes|Todos|Vinculados|Terceros'   ;;;;;;;;;0;
  Radio3     : 'Origen|Todos|Activo|Pasivo'           ;;;;;;;;;0;
  Lista1     : 'Vehiculo'                             ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

*- Construyo la Exstencion
ACT(z1,Dialogo.Lista1)

If Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1, SI)
   ACT(z1,val(z1)~'/'~Dialogo.Fecha1)
EndIf
ACT(z1,val(z1)~'/'~Dialogo.Especie1~'/'~Dialogo.Radio6~'/'~Dialogo.Radio3)

 act(z10,copy(Dialogo.Lista1,1,Longitud(Dialogo.Lista1)-1))

if SQL("Select Count(*) from "~DBO~".OBJETOS where Codigo='"~Dialogo.String1~"' and Extension='"~VAL(z1)~"' ")=0
  if Not EqStr (SQL("Select Status from "~DBO~".VEHICULOS where Codigo='"~val(z10)~"' ") , "DES")
   MessageBox('No existe el Reporte Solicitado '~Dialogo.String1~' '~val(z1))
  endif
else
   Message('Recuperando '~Dialogo.String1~' '~val(z1))
   LeerPMG(Dialogo.String1, VAL(z1))
endif

Impresion(1,2)
acn(z2,fac)
* LimitesVision(h:fac+2)