ModoReproceso(ConDialogo)
CrearDialogo
  Especie1: 'Especie';;;;;;NoVacio(Dialogo.Especie1);'Debe Ingresar una Especie';NO
  Fecha1  : 'F.Desde';;;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO; FSys
  Fecha2  : 'F.Hasta';;;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO; FSys
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

*ACT(c:2,'Fecha : '~Var('FECHASYS'))
SetFont(c:2..c:2,1)

ACT(a:FAC, 'Cotizaciones por Especie')
SetFont(a:4..a4,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Especie : '~Dialogo.Especie1)
ACT(C:FAC+1, 'Cotiza en: '~CotizaEn(Dialogo.Especie1))
ACT(a:FAC+2, 'F.Desde: '~Dialogo.Fecha1)
ACT(a:FAC+3, 'F.Hasta: '~Dialogo.Fecha2)

SetFilaActual(FAC+5)
ACT(a:FAC, 'Fecha')
ACT(b:FAC, 'Precio Cierre')
ACT(c:FAC, 'Precio Contable')
ACT(d:FAC, 'Cont./Fut.')
ACT(e:FAC, 'FechaEj')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'Plazo')
ACT(h:FAC, 'Mercado')
ACT(i:FAC, 'Fuente')

AlinearCeldas(a:FAC..j:FAC,'D')
AlinearCeldas(f:FAC..i:FAC,'C')

SetFont(a:5..i:FAC,2)
AgregarMarco(a:FAC..i:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC)

SQL.ADD("Select Fecha, Precio1, CallPut,FechaEj, PrecioContable,Moneda, Mercado, Fuente,                          ")
SQL.ADD("Case PlazoLiq When '0' then 'Contado' When '24' then '24Hs' When '48' then '48Hs' Else 'Todos' End Plazo ")
SQL.ADD("From "~DBO~".COTIZACIONES  where                                                                         ")
SQL.ADD("Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'                            ")
SQL.ADD("and Codigo = '"~Dialogo.Especie1~"'                                                                      ")
SQL.ADD("order by Fecha                                                                                           ")

recorrer SQL
    ACT(a:fac, FBN['Fecha'])
    ACN(b:fac, FBN['Precio1'])
    ACN(c:fac, FBN['PrecioContable'])
    ACT(d:FAC, FBN['CallPut'])
    ACT(e:FAC, FBN['FechaEj'])
    ACT(f:fac, FBN['Moneda'])
    
    ACT(g:fac, FBN['Plazo'])

    ACT(h:fac, iif(Vacio(FBN['Mercado']),'Todos',FBN['Mercado']))
    ACT(i:fac, iif(Vacio(FBN['Fuente']),'Manual',FBN['Fuente']))

    AlinearCeldas(a:FAC..a:FAC,'D')
proximo

SetFont(a:Val(w1)+6..i:FAC,1)
AlinearCeldas(d:Val(w1)+6..d:FAC,'C')
AlinearCeldas(f:Val(w1)+6..i:FAC,'C')

ACO(1,7)
ACO(2,10)
ACO(3,10)
ACO(4,8)
ACO(5,8)
ACO(7,10)
ACO(8,10)
ACO(9,10)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL INFORME')
SetPrintFit(3, 70)

SetFont(a:FAC,2)
FormatoCeldas(b5..c:fac, Exe('F10'))
FormatoCeldas(d5..d:fac, Exe('F0'))
FormatoCeldas(g5..j:fac, Exe('F10'))

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(i:FAC)
RangoTitulo(a:1..i:FAC, Val(w1)+5)
