ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : 'Grupo'             ; 1;1;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : 'Vehiculo'          ; 2;1;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Lista2     : 'Tipos Book'        ; 3;1;;;;;;;;;SQLSET("Select Codigo From "~DBO~".TIPOSBOOK");
  Lista3     : 'Books'             ;-3;2;;;;;;;;;iif(Vacio(Dialogo.Lista2),SQLSET("Select Codigo From "~DBO~".BOOKS"),SQLSET("Select Codigo From "~DBO~".BOOKS where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "));
  Fecha1     : 'Fecha'             ;-2;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Especie1   : 'Especie'           ;-1;1;;NO;;;;;'USD'
  Radio2     : 'Consolidado|No|Si' ; 0;1;;;;;;;0
  Radio3     : 'Reset|No|Si'       ; 1;1;;;;;;;1
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

If NoVacio(Dialogo.Lista1)
  ACT(az:1,Dialogo.Lista1)
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    ACT(az:1, SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  else
    ACT(az:1, SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV' "))
  EndIf
EndIf
If NoVacio(Dialogo.Lista2)
  If NoVacio(Dialogo.Lista3)
    ACT(az:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") and Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  else
    ACT(az:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where TipoBook in ("~Pipe2Comillas(Dialogo.Lista2)~") "))
  endif
Else
  If NoVacio(Dialogo.Lista3)
    ACT(az:2, SQLSET("Select Codigo From "~DBO~".BOOKS Where Codigo in ("~Pipe2Comillas(Dialogo.Lista3)~") "))
  EndIf
EndIf

if Dialogo.Radio2=0
*- Consolidado NO
  if NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("Select Codigo from "~DBO~".VEHICULOS ")
    SQL.ADD(" where Codigo in ("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~") ")
    SQL.ADD("   and TipoVehiculo = 'DIV' ")
    recorrer SQL
      SCN(x1,1)
      LinkearHoja('RFXF01',Val(x1),Vehiculo2='',Lista1=fbn['Codigo'],Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Radio3=Dialogo.Radio3)
    proximo
  else  
    If NoVacio(Dialogo.Lista1)
      Recorrer&i 1, Elementos(Dialogo.Lista1)
        LinkearHoja('RFXF01',&i,Vehiculo2='',Lista1=ItemLista(Dialogo.Lista1,&i),Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Radio3=Dialogo.Radio3)
      proximo
    else
      LinkearHoja('RFXF01',1,Vehiculo2='',Lista1='',Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Radio3=Dialogo.Radio3)
    endif
  endif
  HojaVisible(NO)
else
*- Consolidado SI
  *-- Veo solamente los tipos seleccionados
  SetListaClaves(2)

  LinkearHoja('RFXF01',1,Vehiculo2=Dialogo.Vehiculo2,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Radio3=Dialogo.Radio3)
  ACN(ay:1, LinkH(1,ay:1))
  
  if Val(ay:1)>1
    recorrer&i 2,Val(ay:1)
      if LinkH(1,bd:&i)>0
        ACD(ba:&i, LinkH(1,ba:&i))
        ACN(bb:&i, LinkH(1,bb:&i))
        ACN(bc:&i, LinkH(1,bc:&i))
        ACN(bd:&i, LinkH(1,bd:&i))
        ACN(bf:&i, LinkH(1,bf:&i))
        ACN(bg:&i, LinkH(1,bg:&i))
        ACN(bh:&i, LinkH(1,bh:&i))
        ACN(bi:&i, LinkH(1,bi:&i))
        ACN(bj:&i, LinkH(1,bj:&i))
        ACN(bk:&i, LinkH(1,bk:&i))
        ACN(bl:&i, LinkH(1,bl:&i))
        ACN(bm:&i, LinkH(1,bm:&i))
        ACN(bn:&i, LinkH(1,bn:&i))
        ACN(bo:&i, LinkH(1,bo:&i))
        ACN(bp:&i, LinkH(1,bp:&i))
        ACN(bq:&i, LinkH(1,bq:&i))
        ACN(br:&i, LinkH(1,br:&i))
        ACN(bs:&i, LinkH(1,bs:&i))
        ACN(bt:&i, LinkH(1,bt:&i))
      endif

      if LinkH(1,cd:&i)>0
        ACD(ca:&i, LinkH(1,ca:&i))
        ACN(cb:&i, LinkH(1,cb:&i))
        ACN(cc:&i, LinkH(1,cc:&i))
        ACN(cd:&i, LinkH(1,cd:&i))
        ACN(cf:&i, LinkH(1,cf:&i))
        ACN(cg:&i, LinkH(1,cg:&i))
        ACN(ch:&i, LinkH(1,ch:&i))
        ACN(ci:&i, LinkH(1,ci:&i))
        ACN(cj:&i, LinkH(1,cj:&i))
        ACN(ck:&i, LinkH(1,ck:&i))
        ACN(cl:&i, LinkH(1,cl:&i))
        ACN(cm:&i, LinkH(1,cm:&i))
        ACN(cn:&i, LinkH(1,cn:&i))
        ACN(co:&i, LinkH(1,co:&i))
        ACN(cp:&i, LinkH(1,cp:&i))
        ACN(cq:&i, LinkH(1,cq:&i))
        ACN(cr:&i, LinkH(1,cr:&i))
        ACN(cs:&i, LinkH(1,cs:&i))
        ACN(ct:&i, LinkH(1,ct:&i))
      endif
    proximo
    SetFont(ba:2..cs:Val(ay:1),1)
    FormatoCeldas(bf:2..bf:Val(ay:1),Exe('F7'))
    FormatoCeldas(bg:2..bg:Val(ay:1),Exe('F0'))
    FormatoCeldas(bh:2..bi:Val(ay:1),Exe('F7'))
    FormatoCeldas(cf:2..cf:Val(ay:1),Exe('F7'))
    FormatoCeldas(cg:2..cg:Val(ay:1),Exe('F0'))
    FormatoCeldas(ch:2..ci:Val(ay:1),Exe('F7'))
  endif
  CerrarHoja('RFXF01',1,Vehiculo2=Dialogo.Vehiculo2,Lista1=Dialogo.Lista1,Lista2=Dialogo.Lista2,Lista3=Dialogo.Lista3,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Radio3=Dialogo.Radio3)

  SetFilaActual(1)
  ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
  SetFont(a:1,2)
  SetFilaActual(FAC+3)

  ACT(g:2,'Fecha : '~Var('FECHASYS'))
  SetFont(g:2..g:2,1)

  ACT(a:FAC, "Reporte de FX Forwards")
  SetFont(a:fac..a:fac,3)

  SetFilaActual(FAC+2)
  ACN(w1,FAC)

  if NoVacio(Dialogo.Vehiculo2)
    ACT(a:FAC, 'Grupo : '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo2))
  else
    if NoVacio(Dialogo.Lista1)
      ACT(a:FAC, 'Vehiculo/s : '~Dialogo.Lista1) 
    else 
      ACT(a:FAC, 'Vehiculo : Todos')
    endif
  endif

  if NoVacio(Dialogo.Especie1)
    ACT(a:FAC+1, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
  else
    ACT(a:FAC+1, 'Especie : Todos')
  endif

  If NoVacio(Dialogo.Lista2)
    ACT(a:FAC+2, 'Tipos Book: '~Dialogo.Lista2)
  else
    ACT(a:FAC+2, 'Tipos Book: Todos')
  endif
  if NoVacio(Dialogo.Lista3)
    ACT(a:FAC+3, 'Book: '~Dialogo.Lista3)
  else
    ACT(a:FAC+3, 'Book: Todos')
  endif
*  if NoVacio(Val(az:2))
*    ACT(a:FAC+2, 'Book: '~Val(az:2))
*  else
*    ACT(a:FAC+2, 'Book: Todos')
*  endif

  ACT(a:FAC+4, 'Consolidado: SI')

  ACT(a:FAC+5, 'Fecha: '~Dialogo.Fecha1)

  if Dialogo.Radio3=0
    ACT(a:FAC+6, 'Sin Reset de Precios')
  else
    ACT(a:FAC+6, 'Con Reset de Precios')
  endif

  SetFont(a:fac..N:FAC+6,2)

  SetFilaActual(FAC+8)

  ACT(a:FAC, 'C O M P R A S')
  ACT(a:FAC+1, 'Fecha de')
  ACT(a:FAC+2, 'Vencim.')
  ACT(b:FAC+1, 'Nominal')
  ACT(b:FAC+2, '(en USD)')
  ACT(c:FAC+1, 'Precio')
  ACT(c:FAC+2, 'Pactado')
  ACT(d:FAC+1, 'Precio')
  ACT(d:FAC+2, 'Hoy')
  ACT(e:FAC+1, 'Plazo')
  ACT(e:FAC+2, 'Remanente')
  ACT(f:FAC+1, 'Tasa')
  ACT(f:FAC+2, 'Implicita')
  ACT(g:FAC+1, 'Net Market')
  ACT(g:FAC+2, 'Value')
  ACT(h:FAC+1, 'P&L en')
  ACT(h:FAC+2, 'Pesos')
  ACT(i:FAC+1, 'P&L en')
  ACT(i:FAC+2, 'USD')
  ACT(j:FAC, 'V E N T A S')
  ACT(j:FAC+1, 'Fecha de')
  ACT(j:FAC+2, 'Vencim.')
  ACT(k:FAC+1, 'Nominal')
  ACT(k:FAC+2, '(en USD)')
  ACT(l:FAC+1, 'Precio')
  ACT(l:FAC+2, 'Pactado')
  ACT(m:FAC+1, 'Precio')
  ACT(m:FAC+2, 'Hoy')
  ACT(n:FAC+1, 'Plazo')
  ACT(n:FAC+2, 'Remanente')
  ACT(o:FAC+1, 'Tasa')
  ACT(o:FAC+2, 'Implicita')
  ACT(p:FAC+1, 'Net Market')
  ACT(p:FAC+2, 'Value')
  ACT(q:FAC+1, 'P&L en')
  ACT(q:FAC+2, 'Pesos')
  ACT(r:FAC+1, 'P&L en')
  ACT(r:FAC+2, 'USD')

  SetFont(a:FAC..r:FAC+2,2)
  AlinearCeldas(b:FAC+1..i:FAC+2,'D')
  AlinearCeldas(k:FAC+1..r:FAC+2,'D')
  AgregarMarco(a:FAC..i:FAC,1,0,Exe('COLOR'))
  AgregarMarco(j:FAC..r:FAC,1,0,Exe('COLOR'))
  AgregarMarco(a:FAC+1..r:FAC+2,2,0,Exe('COLOR'))

  SetFilaActual(FAC+2)
  ACN(ax:1, FAC+1)

  if Val(ay:1)>1
    recorrer&i 2,Val(ay:1)
      IFA
      if Val(bd:&i)>0
        ACD(a:FAC, Val(ba:&i))
        ACN(b:FAC, Val(bk:&i))
        ACN(c:FAC, Val(bl:&i)/Val(bm:&i))
*        ACN(d:FAC, Val(bi:&i))
*        ACN(d:FAC, Val(bh:&i))
        ACN(d:FAC, Val(bt:&i))
        ACN(e:FAC, Val(bg:&i))
        ACN(f:FAC, Val(bf:&i))
        ACN(g:FAC, Val(bq:&i))
        ACN(h:FAC, Val(br:&i))
        ACN(i:FAC, Val(bs:&i))
      endif
      if Val(cd:&i)>0
        ACD(j:FAC, Val(ca:&i))
        ACN(k:FAC, Val(ck:&i))
        ACN(l:FAC, Val(cl:&i)/Val(cm:&i))
*        ACN(m:FAC, Val(ci:&i))
*        ACN(m:FAC, Val(ch:&i))
        ACN(m:FAC, Val(ct:&i))
        ACN(n:FAC, Val(cg:&i))
        ACN(o:FAC, Val(cf:&i))
        ACN(p:FAC, Val(cq:&i))
        ACN(q:FAC, Val(cr:&i))
        ACN(r:FAC, Val(cs:&i))
      endif
    proximo
    SetFont(a:Val(ax:1)..ap:FAC,1)
    FormatoCeldas(b:Val(ax:1)..b:FAC,Exe('F2'))
    FormatoCeldas(c:Val(ax:1)..d:FAC,Exe('F7'))
    FormatoCeldas(e:Val(ax:1)..e:FAC,Exe('F0'))
    FormatoCeldas(f:Val(ax:1)..f:FAC,Exe('F7'))
    FormatoCeldas(g:Val(ax:1)..i:FAC,Exe('F2'))
    FormatoCeldas(k:Val(ax:1)..k:FAC,Exe('F2'))
    FormatoCeldas(l:Val(ax:1)..m:FAC,Exe('F7'))
    FormatoCeldas(n:Val(ax:1)..n:FAC,Exe('F0'))
    FormatoCeldas(o:Val(ax:1)..o:FAC,Exe('F7'))
    FormatoCeldas(p:Val(ax:1)..r:FAC,Exe('F2'))

  endif

  * Columna para ventas
  ACN(ax:3, 10)
  (.'AUXREPFXF'.)

  ACT(a:FAC, 'Fin del Listado')
  SetFont(a:FAC,2)

  SetFont(ax:1..az:3,1)

  ACO(1,7)
  ACO(2,9)
  ACO(7,9)
  ACO(8,8)
  ACO(9,8)

  ACO(10,7)
  ACO(11,9)
  ACO(16,9)
  ACO(17,8)
  ACO(18,8)

  LimitesVision(r:FAC)
  Impresion(1,1)
  SetMargins(1,1,0.5,1)
endif
