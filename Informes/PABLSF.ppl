ModoReproceso(SinDialogo)
CrearDialogo

 Fecha1: 'Desde';;;;;;;;;Fsys
 Fecha2: 'Hasta';;;;;;;;;Fsys
 Cliente1: 'Codigo' ;;;;;;;;;
 Especie1: 'Especie';;;;;;;;;
 Lista1:  'TipoOp'  ;;;;;;;;;;;SQLSet("Select distinct(TipoOp) From "~DBO~".OPERACIONES order by TipoOp asc ") 
 Check1: 'Confirmar' ;;;;;;;;; 

Findialogo


If Not Ok
   Cancelar
Endif


CrearFont(1, 'Arial,12,B')
CrearFont(2, 'Arial,10,B')

SetFilaActual(2)

ACT(c:fac, 'Descripcion Fechas')
SetFont(c:fac..c:fac, 1)
 
SetFilaActual(5)

AgregarMarco(a:fac..d:fac,2,0,Exe('COLOR'))
ACT(a:fac, 'Especie')
ACT(b:fac, 'Codigo')
ACT(c:fac, 'Fec.Desde')
ACT(d:fac, 'Fec.Hasta')
SetFont(a:fac..d:fac, 2)

ColorCeldas(e:fac..e:fac, clRED)

SQL.ADD(" Select Especie, Cliente1, TipoOp, FechaOp, FechaVto From "~DBO~".OPERACIONES ")
SQL.ADD(" Where FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and   FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")

If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif

If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
Endif

If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") ") 
Endif

Recorrer SQL

 ACT(a:fac, fbn('Especie'))
 ACT(b:fac, fbn('Cliente1')) 
 ACT(c:fac, fbn('FechaOp'))
 ACT(d:fac, fbn('FechaVto'))

Proximo

 
SetFilaActual(10)

Recorrer&i 1, 20

 If Vacio(Dialogo.Cliente1) 
    ACT(a:&i, Val(b:fac))
 else
    ACT(k:1, 'NO')
 Endif
   
Proximo

 If Dialogo.Check1<>0
    ACT(j:fac-9, Fecha(Dialogo.Fecha1, 'dd/mm/yyyy')) 
    ACT(k:fac-9, Fecha(Dialogo.Fecha2, 'dd/mm/yyyy'))
 Endif   

ACO(1,8)
ACO(2,15) 
ACO(3,12)
ACO(4,12) 

LimitesVision(l:fac+1)
SetPrintFit(80)


