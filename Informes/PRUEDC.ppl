***// Moneda Monto
ACT(MO:88, 'USD')

***/// Monto
ACN(MO:55, 10000)


ACD(FD:55, Fecha('01/09/2012'))
ACD(FH:55, Fecha('30/09/2012'))


(.'DCDIARIA'.)

ACT(A:1, 'DC en '~Val(ML:1))
ACT(A:2, 'DC en '~Val(AL:88))
ACT(A:3, 'DC en '~Val(ME:1))

