***// Operacion ACTIVA
ACN(AP:1, 1)

***// Moneda Grupo
ACT(ME:1, Var('MONEEXTR'))

***// Moneda Fuerte
ACT(ML:1, Var('MONELOCA'))

***// Moneda Uruguay
ACT(MU:1, Var('MONEURU'))


***// Moneda Local De vehiculo
