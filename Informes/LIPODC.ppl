CrearDialogo
   Cliente1    :'Cliente'   ;1;1;1;SI;SI;NoVacio(DIALOGO.CLIENTE1);'Debe Ingresar Cliente';NO;
   Vehiculo1   :'Vehiculo'  ;2;1;1;SI;SI;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar Vehiculo';NO;Var('VEHICULODE')
   String1 :'Limite'   ;3;1;1;SI;SI;NoVacio(Dialogo.String1);'Debe Ingresar Limite';NO;
   Book1       :'Book'     ;4;1;1;SI;SI;
FinDialogo

CrearFont(1,'Arial,8,')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,10,B')

SetFilaActual(4)
ACT(a:FAC, 'Limites de Posicion Consumidos')
SetFont(a:FAC, 3)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(a:FAC, 2)

SetFilaActual(FAC+2)
ACT(a:FAC, 'limite')
ACT(b:FAC, 'Descripcion')
ACT(c:FAC, 'Cliente/Book')
ACT(d:FAC, 'Moneda')
ACT(e:FAC, 'Especie')
ACT(f:FAC, 'Consumido')
ACT(g:FAC, 'Cotizacion')
ACT(h:FAC, 'Valuado')

AgregarMarco(a:FAC..h:FAC,1,0,Exe('COLOR'))
SetFont(a:FAC..h:FAC, 2)

ACN(w:1, FAC)
SQL.ADD("Select Limite,Descripcion,Cliente,Book,Vehiculo,Especie,Monto from LIMCONSUMIDOS LC, TIPOSLIMITE TL ")
SQL.ADD("where LC.Limite = TL.COdigo ")
SQL.ADD("and TL.Clase='P' ")
SQL.ADD("and LC.Cliente = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and LC.Limite  = '"~Dialogo.String1~"' ")
SQL.ADD("and LC.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
if NoVacio(Dialogo.Book1)
  SQL.ADD("and LC.Book  = '"~Dialogo.Book1~"' ")
endif
SQL.ADD("and LC.Monto > 0 ")
SQL.ADD("order by Limite,Vehiculo,Book,Cliente ")
Recorrer SQL
  ACT(j:fac, FBN['Limite'])
  ACT(k:fac, FBN['Cliente'])
  ACT(l:fac, FBN['Vehiculo'])
  ACT(m:fac, FBN['Book'])
  ACN(q:fac, FBN('Especie'))
  ACN(p:fac, FBN('Monto'))

  ACT(a:fac, FBN['Limite'])
  ACT(b:fac, FBN['Descripcion'])    
  if Incluido(FBN['Limite'],'BOOK')
    ACT(c:fac, FBN['Book'])
  else
    ACT(c:fac, FBN['Cliente'])
  endif
  ACT(d:fac, 'USD')
  ACT(e:fac, FBN['Especie'])    
  ACN(f:fac, FBN('Monto'))
  ACN(g:fac, CotizacionC(FBN['Especie'],,,,FSys,1,SI,'USD'))
  ACN(h:fac, Val(f:fac)*Val(g:fac))
  SCN(x:1, Val(h:fac))  
Proximo

If FAC>Val(w:1)

  SetFont(a:Val(w:1)+1..a:FAC, 2)
  SetFont(b:Val(w:1)+1..p:FAC, 1)

  IFA
  ACT(g:FAC, 'Total')
  ACT(g:FAC+1, 'Asignado')
  ACT(g:FAC+2, 'Estado')
  ACT(g:FAC+3, 'Exceso')

  ACN(h:fac, Val(x:1))
  ACN(j:fac, LimTotalizado3(Dialogo.Cliente1,Dialogo.String1,0,Dialogo.Vehiculo1,,Dialogo.Book1,,,,,,,,,,,'USD'))

  if ExisteLimite(Dialogo.String1,Dialogo.Cliente1,'USD',Dialogo.Vehiculo1,,Dialogo.Book1)
    ACT(j:fac+1, 'SI')
    ACD(k:fac+1, VtoLimite(Dialogo.String1,Dialogo.Cliente1,'USD',Dialogo.Vehiculo1,,Dialogo.Book1))
  else
    ACT(j:fac+1, 'NO')
  endif
  if EqStr(Val(j:FAC+1),'SI')
    ACN(h:fac+1, LimAsignado(Dialogo.Cliente1,Dialogo.String1,'USD',Dialogo.Vehiculo1,,Dialogo.Book1))
    if Val(k:FAC+1)<FSys
      ACT(h:fac+2, 'Vencido el '~Fecha(Val(k:FAC+1)))
    else
      ACT(h:fac+2, 'Vigente')
    endif
  else
    ACN(h:fac+1, 0)
    ACT(h:fac+2, 'No Asignado')
  endif
  if Val(h:fac)>Val(h:FAC+1)
    ACN(h:FAC+3, Val(h:FAC)-Val(h:FAC+1))
  endif
  SetFont(g:fac..g:FAC+3)
  SetFilaActual(FAC+3)
else
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay Limites de Posicion consumidos')
  SetFont(a:FAC, 2)
endif

ACO(1,8)
ACO(2,12)
ACO(3,10)
ACO(4,8)
ACO(5,10)
ACO(6,10)
ACO(7,15)
ACO(8,10)

Ifa
Ifa

ACT(a:fac,'FIN LISTADO')
SetFont(a:fac, 2)

LimitesVision(h:fac)
Impresion(1,2)
Rangotitulo(a:1..h:7,2)

SetPrintFit(3, 60)
