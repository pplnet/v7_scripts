*Total Interes mensual
ACN(tm:3, 0)
*Total Gastos mensual
ACN(tm:4, 0)
*Total Comision mensual
ACN(tm:5, 0)
*Total IVA RI mensual
ACN(tm:6, 0)


SQL.ADD("SELECT 'Alta' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE, OP.NrOperacion3, ")
SQL.ADD(" OB.Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, FechaEj, PrecioEj ")
SQL.ADD("FROM "~DBO~".OPERACIONES OP, "~DBO~".CLIENTES C, "~DBO~".OPERACIONESBITS OPB, ")
SQL.ADD("     (SELECT OB1.NrOperacion, OB1.Valor ")
SQL.ADD("      FROM "~DBO~".OPERACIONESBITS OB1, "~DBO~".OPERACIONES O")
SQL.ADD("      WHERE OB1.NrOperacion=O.NrOperacion and OB1.NrBit =30) OB ")
SQL.ADD("WHERE OP.FechaCargaSys >= "~IdxDate2(Dialogo.Fecha1)~"   AND ")
SQL.ADD("      OP.FechaCargaSys <  "~IdxDate2(Dialogo.Fecha2+1)~" AND ")
SQL.ADD("      OP.Cliente1  = C.Codigo                    AND         ")
SQL.ADD("      OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'     AND         ")
SQL.ADD("      ((OP.TipoOp In ('TIC','TIV','TIFC','TIFV') AND  OP.CB7 = 1) OR    ")
SQL.ADD("       (OP.TipoOp In ('TICO','TIPO','TICT','TIDE','TCP','TVP','TCC','TVC') ))  AND  ")
SQL.ADD("      OP.NrOperacion = OPB.NrOperacion AND ((OP.TipoTicket=1 and OP.NrOperacion4 Is Null) OR OP.TipoTicket<>1 OR OP.TipoTicket Is Null) AND")
SQL.ADD("      OPB.NrBit = 1 AND ")
SQL.ADD("      OPB.Valor = 0 AND ")
SQL.ADD("      OP.NrOperacion = OB.NrOperacion ")
SQL.ADD("UNION ")
SQL.ADD("SELECT 'Baja' Tipo, OP.NrBoleto, OP.NrOperacion, OP.TipoOp, OP.FechaOp, OP.FechaVto, ")
SQL.ADD(" OP.Especie, OP.Cantidad, OP.Precio1, OP.TotalNetoCli1, OP.FechaEnvioMAE, OP.NroAltaMAE, ")
SQL.ADD(" OP.PaseCB, OP.Cliente1, OP.TotalBrutoCli1, OP.TotalIntereses, OP.EsAforado, OP.TotalCaucion, ")
SQL.ADD(" OP.OpSIOPEL, OP.TotalComisiones, OP.ContraEspecie, OP.ObsErrorMAE,OP.NrOperacion3, ")
SQL.ADD(" '0' Valor, C.CUIT, C.CondicionIVA, C.RazonSocial, OP.TotalAux2, OP.TotalAux4, FechaEj, PrecioEj ")
SQL.ADD("From "~DBO~".BOPERACIONES OP, "~DBO~".CLIENTES C ")
SQL.ADD("Where OP.FechaCargaSys     >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD("      and OP.FechaCargaSys <= "~IdxDate2(Dialogo.Fecha2)~" ")
SQL.ADD("      and OP.Vehiculo1 = '"~Dialogo.Vehiculo1~"'   ")
SQL.ADD("      and OP.Cliente1  = C.Codigo ")
SQL.ADD("      and ((OP.TipoOp In ('TIC','TIV','TIFC','TIFV') AND  OP.CB7 = 1) OR    ")
SQL.ADD("           (OP.TipoOp In ('TICO','TIPO','TICT','TIDE','TCP','TVP','TCC','TVC') ))    ")
SQL.ADD("ORDER BY OP.FechaOp ")

acn(Tt2,0)
acn(zu1,0)
acn(KK1,FAC+1)
ACD(fo:1, 0)
ACN(me:1, 0)

Recorrer SQL
    ACN(zu1,1)
    If fbn('FechaOp')<>Val(fo:1) y val(fo:1)<>0
       ACT(a:fac,'Total dia : ')
       SCN(k:fac, Val(to:1))
       SCN(m:fac, Val(to:2))
       SCN(l:fac, Val(to:3))
       SCN(n:fac, Val(to:4))
       SCN(o:fac, Val(to:7))
       SetFont(a:FAC..z:FAC,3)
       *-Vuelvo a inicializar las variables
       ACN(to:1, 0)
       ACN(to:2, 0)
       ACN(to:3, 0)
       ACN(to:4, 0)
       ACN(to:5, 0)
       ACN(to:6, 0)
       ifa
       ifa
    Endif

    If Mes(fbn('FechaOp'))<>Val(me:1) y 0<>Val(me:1)
       ACT(a:fac,'Total mes : ')
       SCN(k:fac, Val(tm:1))
       SCN(m:fac, Val(tm:2))
       SCN(l:fac, Val(tm:3))
       SCN(n:fac, Val(tm:4))
       SetFont(a:FAC..z:FAC,3)
       ACN(tm:1, 0)
       ACN(tm:2, 0)
       ACN(tm:3, 0)
       ACN(tm:4, 0)
       ACN(tm:5, 0)
       ACN(tm:6, 0)
       ifa
       ifa
    Endif

    If Eqstr(fbn('Tipo'),'Alta')
       ACT(a:FAC, IIF(longitud(fbn['NrBoleto'])<=6,fbn['NrBoleto'],Copy(fbn['NrBoleto'],longitud(fbn['NrBoleto'])-5,6)) )
    Else
       ACT(a:FAC, Copy(fbn['NrOperacion3'],3,6))
    Endif
    ACT(a:FAC, Copy(fbn['NrOperacion'],1,8))
    ACLO(a:FAC, Copy(fbn['NrOperacion'],1,8))
    message('Operacion '~Val(a:fac))
    ACD(b:FAC, fbn['FechaOp'])
    ACD(c:FAC, fbn['FechaVto'])
    If Incluido(fbn['TipoOp'],'TIC')
       ACT(d:FAC, 'Compra')
    EndIf
    If Incluido(fbn['TipoOp'],'TICO')
       ACT(d:FAC, 'Call Otorgado')
    EndIf
    If Incluido(fbn['TipoOp'],'TICT')
       ACT(d:FAC, 'Call Tomado')
    EndIf
    If Incluido(fbn['TipoOp'],'TIDE')
       ACT(d:FAC, 'Dep. de Titulos')
    EndIf
    If Incluido(fbn['TipoOp'],'TIPO')
       ACT(d:FAC, 'Prest.de Titulos')
    EndIf
    If Incluido(fbn['TipoOp'],'TVC')
       ACT(d:FAC, 'Venta de Call')
    EndIf
    If Incluido(fbn['TipoOp'],'TVP')
       ACT(d:FAC, 'Venta de Put')
    EndIf
    If Incluido(fbn['TipoOp'],'TCC')
       ACT(d:FAC, 'Compra de Call')
    EndIf
    If Incluido(fbn['TipoOp'],'TCP')
       ACT(d:FAC, 'Compra de Put')
    EndIf
    If Incluido(fbn['TipoOp'],'TIV')
       ACT(d:FAC, 'Venta')
    Endif
    If Incluido(fbn['TipoOp'],'TIFC')
       ACT(d:FAC, 'Compra Fut')
    EndIf
    If Incluido(fbn['TipoOp'],'TIFV')
       ACT(d:FAC, 'Venta Fut ')
    Endif
    If EqStr(fbn['PaseCB'],'1')
       ACT(d:FAC, val(d:fac)~' Por Pase ')       
    EndIf

*    ACT(f:FAC, Hora(fbn['FechaEnvioMAE']))
*    If Num(fbn['NroAltaMae'])>0
*       ACT(g:FAC, fbn['NroAltaMae'])
*       SQL.ADD(" Select * from "~DBO~".ESPECIES Where Codigo= '"~FBN['Especie']~"' ") 
*       Recorrer SQL
*          dfa
          *- Especie
*          ACT(f:fac,Pad(FBN['CodMAEContado'],5))
*      Proximo
*    Else
*       ACT(g:FAC, 'N/A')
*       ACT(f:FAC,FBN['Especie']~)
*       ACT(q:FAC, fbn['NroAltaMAE'])
*    Endif

    SQL.ADD(" Select CodMAEContado, Nombre From "~DBO~".ESPECIES Where Codigo = '"~fbn('Especie')~"' ")
    Recorrer SQL
        DFA
        ACT(h:fac, fbn('CodMAEContado')~' - '~Copy(fbn('Nombre'), 1, 15))
    Proximo

    If Incluido(fbn['TipoOp'],'TCP|TVP|TCC|TVC')
       ACT(h:FAC, Val(h:fac)~'-'~FBN[FechaEj]~'-'~FBN[PrecioEj])
    Endif

    ACT(e:fac, fbn('Cliente1')~' - '~Copy(fbn('RazonSocial'),1,25))
    ACT(f:fac, fbn('CUIT'))

    If eqstr(fbn('CondicionIVA'),'INS')
       ACT(g:fac,'RI')
    Endif
    If eqstr(fbn('CondicionIVA'),'NOI')
       ACT(g:fac, 'RNI')
    Endif
    If eqstr(fbn('CondicionIVA'),'EXE')
       ACT(g:fac, 'Exe')
    Endif
    If eqstr(fbn('CondicionIVA'),'MON')
       ACT(g:fac,'Monotrib.')
    Endif
    If eqstr(fbn('CondicionIVA'),'CF')
       ACT(g:fac,'C.Final')
    Endif

    ACN(i:FAC, fbn['Cantidad'])

    If Eqstr(FBN['Especie'],'FRB') 
       ACN(j:fac, FBN['Precio1']*BuscarCampo('ESPECIES','VTeorico','Codigo',FBN['Especie']) )
    Else
       ACN(j:fac, FBN['Precio1'])
    Endif
  
    If Eqstr(fbn('ContraEspecie'), Dialogo.Especie1)
       ACN(k:FAC, fbn['TotalBrutoCli1'])
    ELse
       ACN(k:fac, fbn['TotalBrutoCli1']*CotizacionC(FBN['ContraEspecie'],,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
    Endif

    *- Si la especie es Dirty Clean igualmente calculo los intereses
    IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'CLE') y EqStr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'DIR')
       *- Calculo el precio sacandole los intereses
       ACN(j:fac,(fbn['TotalNetoCli1']-fbn['TotalIntereses'])/fbn['Cantidad'])
       ACN(k:FAC, fbn['TotalBrutoCli1']-fbn['TotalIntereses'])
    EndIf

    * - La especie es CLEAN DIRTY, informo Neto y precio sucio
    IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'DIR') y EqStr(BuscarCampo('ESPECIES','InteresesC','Codigo',FBN['Especie']),'CLE')
       *- Calculo el precio sacandole los intereses
       ACN(j:fac,(fbn['TotalNetoCli1'])/fbn['Cantidad'])
       ACN(k:FAC, fbn['TotalNetoCli1'])
    EndIf


    IF EqStr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',FBN['Especie']),'CLE') 
       If Eqstr(fbn('ContraEspecie'), Dialogo.Especie1)
          ACN(l:FAC, fbn['TotalIntereses'])
       ELse
          ACN(l:fac, fbn['TotalIntereses']*CotizacionC(FBN['ContraEspecie'],,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
       Endif
    Endif

    If Eqstr(fbn('ContraEspecie'), Dialogo.Especie1)
       ACN(m:FAC, fbn['TotalNetoCli1'])
    ELse
       ACN(m:fac, fbn['TotalNetoCli1']*CotizacionC(FBN['ContraEspecie'],,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
    Endif

    If EqStr(fbn['EsAforado'],'1')
       ACT(d:FAC, val(d:fac)~' Aforado ')       
       ACN(m:FAC, fbn['TotalCaucion'])
    EndIf

    If Eqstr(fbn('ContraEspecie'), Dialogo.Especie1)
       ACN(n:fac, fbn('TotalComisiones'))
    ELse
       ACN(n:fac, fbn('TotalComisiones')*CotizacionC(FBN['ContraEspecie'],,,,fbn('FechaOp'),1,SI,Dialogo.Especie1))
    Endif

    If Incluido(fbn['TipoOp'],'TIC|TIV')
    Endif

    ACT(o:FAC, Copy(BuscarCampo('Clientes','NrMAE','Codigo',fbn['Cliente1']),1,25))
    ACT(p:FAC, fbn['OpSIOPEL'])
    ACT(q:FAC, 'C.Propia')
    ACT(r:fac, fbn('ContraEspecie'))
    If fbn['Valor']=1 o Eqstr(fbn('Tipo'),'Baja')
       If EqStr(fbn['ObsErrorMAE'],'C')
          ACT(s:FAC, 'Baja por Carta')
       Else
          ACT(s:FAC, 'Baja')
       Endif
    Endif
    scn(tT2,1)
    SetFont(a:FAC..z:FAC,1)
    FormatoCeldas(j:fac,Exe('F8'))
    AlinearCeldas(d:FAC..d:FAC,'I')

    *-Diarios
    SCN(to:1, Val(k:fac))
    SCN(to:2, Val(m:fac))
    SCN(to:3, Val(l:fac))
    SCN(to:4, Val(n:fac))
    *-Mensuales
    SCN(tm:1, Val(k:fac))
    SCN(tm:2, Val(m:fac))
    SCN(tm:3, Val(l:fac))
    SCN(tm:4, Val(n:fac))

    ACD(fo:1, fbn('FechaOp'))
    ACN(me:1, mes(fbn['FechaOp']))
Proximo 

ifa
ACT(a:fac,'Total dia : ')
ACN(k:fac, Val(to:1))
ACN(m:fac, Val(to:2))
ACN(l:fac, Val(to:3))
ACN(n:fac, Val(to:4))
SetFont(a:FAC..t:FAC,3)

ifa
ifa

ACT(a:fac,'Total mes : ')
ACN(k:fac, Val(tm:1))
ACN(m:fac, Val(tm:2))
ACN(l:fac, Val(tm:3))
ACN(n:fac, Val(tm:4))
SetFont(a:FAC..t:FAC,3)
IFA

