MOSTRARCuadroDeMensajes

CrearDialogo
   Vehiculo1  :'Vehiculo'       ;;;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1     :'Desde Fecha'    ;;;;;;;;;;FSYS
   Fecha2     :'Hasta Fecha'    ;;;;;;;;;;FSYS
   Especie1   :'Moneda Totales' ;;;;;;noVacio(Dialogo.Especie1);'Moneda Invalida';NO;;'ARP';;;;" Tipo = 'MON' ";
FinDialogo

If not Ok
   Cancelar
endif

CrearFont(1, 'Arial,7,')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,8,B')
CrearFont(4, 'Arial,7,B')

SetFilaActual(1)
ACN(zz1,FAC)

ACT(g:FAC+1, BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Vehiculo1))
ACT(f:FAC+2, 'Registro de Operaciones No Informadas desde '~Dialogo.Fecha1~' hasta '~Dialogo.Fecha2 )
AlinearCeldas(j:FAC+1..j:FAC+2,'C')

ACT(o:fac+2, 'Cotizacion USD: '~fstr(Cotizacion('USD',,,,FSYS,1,SI),0,8))

SetFilaActual(fac+4)


ACT(a:FAC, 'Nr.Minuta')
ACT(b:FAC, 'Fecha Op.')
ACT(c:FAC, 'Fecha Liq.')
ACT(d:FAC, 'Tipo Op')

ACT(e:FAC, 'Comitente')
ACT(f:FAC, 'Com. CUIT')
ACT(g:FAC, 'Com. IVA')

ACT(h:FAC, 'Especie')
ACT(i:FAC, 'Cantidad VN')
ACT(j:FAC, 'Precio')
ACT(k:FAC, 'Importe Bruto')
ACT(l:FAC, 'Intereses')
ACT(m:FAC, 'Importe Neto')
ACT(n:fac, 'Gastos')

ACT(o:FAC, 'Age.')
ACT(p:FAC, 'Oper.')
ACT(q:FAC, 'Contr.')
ACT(r:fac, 'Moneda')
ACT(s:FAC, 'Baja')

AlinearCeldas(a:FAC..s:FAC,'C')
AgregarMarco(a:FAC..s:FAC,2)
SetFont(a:FAC..t:FAC,2)

ACN(z:1,FAC)

*Total Bruto diario
ACN(to:1, 0)
*Total NeTo diario
ACN(to:2, 0)
*Total Interes diario
ACN(to:3, 0)
*Total Gastos diario
ACN(to:4, 0)
*Total Comision diario
ACN(to:5, 0)
*Total IVA RI diario
ACN(to:6, 0)

