CrearDialogo
  Vehiculo1: 'Vehiculo'                                              ;1;1;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');
  Fecha1   : 'Fecha Liq.'                                            ;1;2;;;;Dialogo.Fecha1<>0 ;'Debe Ingresar una Fecha';NO;FSys;
  Especie1 : 'Especie'                                               ;2;1;;;;;;;
  Cliente1 : 'Cliente'                                               ;3;1;;Dialogo.Radio6<>2;;;;;IIF(Dialogo.Radio6=2,SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'');IIF(Dialogo.Radio6=2,SQL("SELECT Cliente1 FROM "~DBO~".MERCADOS WHERE Codigo='"~Dialogo.Mercado1~"' "),'')
  Radio2   : 'Operatoria|Securities|F.Exchange|M.Market|Bursatil'    ;4;1;;NO;NO;;;;3;
  Radio6   : 'Pre-Liq|Cliente|Agente|ArgenClear'                     ;5;1;;NO;NO;;;;2;
  Mercado1 : 'Mercado'                                               ;6;1;;;;NoVacio(Dialogo.Mercado1);'Debe ingresar un Mercado';NO;VAR('MERNETEODE');;;;;" NETEA='SI' "
FinDialogo

if Not Ok
  Cancelar
endif
SQL.ADD("  SELECT *  ") 
SQL.ADD("  from "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("  where M.NrTrans2 = T.NrTrans                    ")
SQL.ADD("  and   T.NrTrans  = B.NrOperacion                 ")
SQL.ADD("  and   B.NrBit In (1,11,3,6,70,8)                   ")
SQL.ADD("  and   B.Valor = '1'                             ") 
SQL.ADD("  and   M.NrSaldo = 1                             ")
SQL.ADD("  and   T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"'  ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and   T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
If Dialogo.Radio6=1
   SQL.ADD("  and T.Cliente1 In (SELECT C.Codigo FROM  "~DBO~".AGENTES Ag, "~DBO~".CLIENTES C WHERE Ag.Codigo = C.NrAgenteBolsa) ")
   SQL.ADD("  and M.Cliente = T.Cliente1 ")
Else 
   SQL.ADD("  and T.Cliente1 Not In (SELECT C.Codigo FROM  "~DBO~".AGENTES Ag, "~DBO~".CLIENTES C WHERE Ag.Codigo = C.NrAgenteBolsa) ")
   If Dialogo.Radio6<>2
      SQL.ADD("  and   M.Cliente = T.Cliente1 ")
   Else 
   SQL.ADD("  and   T.Cliente1='"~Dialogo.Cliente1~"' ")
   EndIf
EndIf
SQL.ADD(" and (M.Transaccion is Null or M.Transaccion = ' ')  ")

watch(SQL.BATCH())