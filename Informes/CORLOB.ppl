ModoReproceso(SinDialogo)
HojaVisible(NO)
CrearDialogo
   Fecha1  : 'Desde'          ;1;1;;;;Dialogo.Fecha1=PriDeMes(Dialogo.Fecha1,SI);'La Fecha Desde debe ser un Principio de Mes';NO;;PriDeMes(FSYS-1, SI)
   Fecha2  : 'Hasta'          ;2;1;;;;Dialogo.Fecha1 <= Dialogo.Fecha2;'Error en Fechas';NO;;Habiles(FinDeMes(FSYS, SI, 'ARG'),1,'ARG',NO)
   Especie1: 'Moneda'         ;;;;;;;;;Var('MONEEXTR');;;;;" Jerarquia Like '"~Var('JERMONEDA')~"%' and SubString(Jerarquia,1,6) <> '"~Var('JERMONEDA')~"000' "
   Radio3  : 'Origen|Todos|Activo|Pasivo';;;;;;;;;0;
   Radio6  : 'Clientes|Todos|Vinculados|Terceros';;;;;;;;;0;
   Lista1  : 'Vehiculo'       ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
FinDialogo

IF NOT OK
   Cancelar
ENDIF

* Veo solamente los tipos seleccionados
SetListaClaves(2)

* Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')") )
   Else 
      ACT(zz6,SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   EndIf
EndIf

*-- Por Cada Mes Obtengo el CORENA para Un Vehiculo/Mes/Moneda y Tipo de Cliente
SQL.ADD(" SELECT Codigo FROM "~DBO~".VEHICULOS ")
If NoVacio(val(zz6))
   SQL.ADD(" Where Codigo in ("~Pipe2Comillas(val(zz6))~") ")
EndIf
SQL.ADD(" ORDER BY Codigo ")

Recorrer SQL  

   If Dialogo.Radio6<>2 y Dialogo.Radio3<>2 
      Message(FBN['Codigo']~' Activos Vinculados  ')
      * Llamada Para Vinculados 
      LinkearHoja('CORENB',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=0,Radio6=0,Radio1=-1,Radio4=-1,Radio2=0,Radio5=0,Radio14=0,Especie1=Dialogo.Especie1,Check4=0,Check1=1,Radio8=0,Radio10=0,Radio12=0,Radio7=0,Lista1=fbn['Codigo']~'|',Lista2='',Lista3='')
   EndIf

   If Dialogo.Radio6<>1 y Dialogo.Radio3<>2 
      Message(FBN['Codigo']~' Activos Terceros ')
      * Llamada Para Terceros
      LinkearHoja('CORENB',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=0,Radio6=1,Radio1=0,Radio4=0,Radio2=-1,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=0,Check1=1,Radio8=0,Radio10=0,Radio12=0,Radio7=0,Lista1=fbn['Codigo']~'|',Lista2='',Lista3='')
   EndIf

   If Dialogo.Radio6<>2 y Dialogo.Radio3<>1
      Message(FBN['Codigo']~' Pasivos Vinculados  ')
      * Llamada Para Vinculados 
      LinkearHoja('CORENB',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=1,Radio6=0,Radio1=-1,Radio4=-1,Radio2=0,Radio5=0,Radio14=0,Especie1=Dialogo.Especie1,Check4=0,Check1=1,Radio8=0,Radio10=0,Radio12=0,Radio7=0,Lista1=fbn['Codigo']~'|',Lista2='',Lista3='')
   EndIf

   If Dialogo.Radio6<>1 y Dialogo.Radio3<>1
      Message(FBN['Codigo']~' Pasivos Terceros ')
      * Llamada Para Terceros
      LinkearHoja('CORENB',1,Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha2,Radio3=1,Radio6=1,Radio1=0,Radio4=0,Radio2=1,Radio5=-1,Radio14=0,Especie1=Dialogo.Especie1,Check4=0,Check1=1,Radio8=0,Radio10=0,Radio12=0,Radio7=0,Lista1=fbn['Codigo']~'|',Lista2='',Lista3='')
   EndIf
Proximo
