CrearDialogo
    String1: 'Texto a Buscar'      ;;;;;;NoVacio(Dialogo.String1);'Debe ingresar un texto';NO;;;
    Check1 : 'TiposOperacion'      ;;;;;;;;;;Dialogo.Check10=1;
    Check2 : 'TiposTransaccion'    ;;;;;;;;;;Dialogo.Check10=1;
    Check3 : 'TiposOrden'          ;;;;;;;;;;Dialogo.Check10=1;
    Check4 : 'TiposMinutaBolsa'    ;;;;;;;;;;Dialogo.Check10=1;
    Check5 : 'Informes'            ;;;;;;;;;;Dialogo.Check10=1;
    Check6 : 'Eventos'             ;;;;;;;;;;Dialogo.Check10=1;
    Check7 : 'Funciones'           ;;;;;;;;;;Dialogo.Check10=1;
    Check8 : 'Formulas'            ;;;;;;;;;;Dialogo.Check10=1;
    Check11: 'ABMs'                ;;;;;;;;;;Dialogo.Check10=1;
    Label1 : 'Distingue'           ;;;;;;;;;;;
    Check9 : 'Mayus. y Minus.'     ;;;;;;;;;;; 
    Check10: 'Todos'               ;1;2;;;;;;;;; 
    Check12: 'Omitir BackUps'      ;;2;;;;;;;;;
FinDialogo

If Not OK
    Cancelar
Endif

CrearFont(2,"Arial,8,B")

ACT(A:1,'Texto a Buscar: ')
ACT(B:1, Dialogo.String1)
SetFont(B:1,2)

*ACT(A:2,IIF(Dialogo.Check9 = 1,'Distingue Mayusculas y Minusculas','NO Distingue Mayusculas y Minusculas'))

SetFilaActual(3)

*TiposOperaciones
IF Dialogo.Check1 = 1
    let &Primero 0
    SQL.ADD(" SELECT Codigo, Nombre, Script ")
    SQL.ADD(" FROM "~DBO~".TIPOSOPERACION ")
    IF Dialogo.Check12 = 1
        SQL.ADD(" WHERE Nombre not like '%BACK%' ")
    ENDIF
    SQL.ADD(" Order by Codigo ")
    Recorrer SQL
        ACT(ZZ:999,fbn('Script'))
        IF Dialogo.Check9 = 1
            IF Buscar(Dialogo.String1,Val(ZZ:999)) = true
                IF &Primero = 0
                    let &Primero 1
                    ACT(A:fac,'Operaciones')
                    ifa
                    ACT(B:fac,'Codigo')
                    ACT(C:fac,'Nombre')
                    Ifa
                ENDIF
                ACT(B:fac,fbn('Codigo'))
                ACT(C:fac,fbn('Nombre'))
            ELSE
                DFA
            ENDIF
        ELSE
            IF Buscar(Mayusculas2(Dialogo.String1),Mayusculas2(Val(ZZ:999))) = true
                IF &Primero = 0
                    let &Primero 1
                    ACT(A:fac,'Operaciones')
                    ifa
                    ACT(B:fac,'Codigo')
                    ACT(C:fac,'Nombre')
                    Ifa                    
                ENDIF
                ACT(B:fac,fbn('Codigo'))
                ACT(C:fac,fbn('Nombre'))                
            ELSE
                DFA
            ENDIF        
        ENDIF
    Proximo
ENDIF

IF &Primero = 1
    IFA
ENDIF

