MostrarCuadroDeMensajes
CrearDialogo
  Radio1:    'T.Negocio|Spot|Futuro|Ambos';1;1;1;;;;;;2
  Check1:    'Con detalle MTM';1;2;1;Dialogo.Radio1>0;Dialogo.Radio1>0;;;;0
  Fecha1:    'FechaLiq';2;1;1;;;;;;fsys
  Especie1:  'Moneda'  ;3;1;1;;;;;;;;;;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Cliente1:  'Cliente' ;
  Vehiculo1: 'Vehiculo';
FinDialogo

IF NOT OK
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

ACT(a:4, 'FX - Movimientos Liquidados - '~Dialogo.Fecha1)
SetFont(A:4, 3)

If Dialogo.Radio1=0
  ACT(a:6, 'Tipo negocio: Spot')
Else
  If Dialogo.Radio1=1
     ACT(a:6, 'Tipo negocio: Futuro')
  Else
     ACT(a:6, 'Tipo negocio: Todos (Spot y Futuro)')
  Endif
Endif
If NoVacio(Dialogo.Especie1)
   ACT(a:7, 'Moneda: '~Dialogo.Especie1)
Else
   ACT(a:7, 'Moneda: Todas')
Endif
If NoVacio(Dialogo.Cliente1)
   ACT(a:8, 'Cliente: '~Dialogo.Cliente1)
Else
   ACT(a:8, 'Cliente: Todos')
Endif
If NoVacio(Dialogo.Vehiculo1)
   ACT(a:9, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
   ACT(a:9, 'Vehiculo: Todos')
Endif
SetFont(A:5..A:9, 2)

SetFilaActual(11)

ACT(a:fac, 'FechaMov')
ACT(b:fac, 'Cliente')
ACT(c:fac, 'Cantidad')
ACT(d:fac, 'Cuenta')
ACT(e:fac, 'TipoOp')
ACT(f:fac, 'Operacion')
ACT(g:fac, 'FechaOp')
ACT(h:fac, 'FechaVto')
ACT(i:fac, 'Especie')
ACT(j:fac, 'ContraEsp.')
ACT(k:fac, 'Precio')
ACT(l:fac, 'Estado')
ACT(m:fac, 'NrTrans')

SetFont(A:fac..z:fac, 2)
Agregarmarco(A:fac..m:fac,1,0,EXE('COLOR6'))
AlinearCeldas(A:fac..z:fac, 'C')

ACT(ea:1, '')

SQL.ADD(" SELECT M.FechaMov, M.Especie Moneda, -M.Cantidad Cantidad, M.Cuenta, O.TipoOp, M.NrOperacion, T.NrTrans, ")
SQL.ADD(" O.Cliente1, O.FechaOp, O.FechaVto,  O.Especie, O.ContraEspecie, O.Precio1, T.CB3, T.CB9, T.Cuenta2, T.Mercado1 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" WHERE O.NrOperacion = M.NrOperacion  ")
SQL.ADD(" AND   M.NrTrans2    = T.NrTrans      ")
*SQL.ADD(" AND   M.Concepto = 'FX' ")
** FJL 18/12/18 - Permite optar Tipo Negocio
SQL.ADD(" AND   M.Concepto in ('FX','FM') ")
If Dialogo.Radio1=0
  SQL.ADD(" AND   M.Concepto in ('FX') ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND   M.Concepto in ('FM') ")
Endif
*FO10/11/2005 SQL.ADD(" AND  M.FechaMov = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND  M.FechaEje = "~idxdate2(Dialogo.Fecha1)~" ")
If Novacio(Dialogo.Especie1)
   SQL.ADD(" AND  M.Especie = '"~Dialogo.Especie1~"' ")
Endif
If Novacio(Dialogo.Cliente1)
   SQL.ADD(" AND  O.Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" UNION ")
SQL.ADD(" SELECT M.FechaMov, M.Especie Moneda, M.Cantidad, M.Cuenta, O.TipoTr2 TipoOp, M.NrOperacion, T.NrTrans, ")
SQL.ADD(" O.Cliente1, O.Fecha1 FechaOp, O.Fecha1 FechaVto, O.Especie, ' ' ContraEspecie, 0 Precio1, T.CB3, T.CB9, T.Cuenta2, T.Mercado1 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 O, "~DBO~".MOVEJECUTADOS M, "~DBO~".TRANSACCIONES2 T")
SQL.ADD(" WHERE O.NrTrans  = M.NrOperacion ")
SQL.ADD(" AND   M.NrTrans2 = T.NrTrans     ")
SQL.ADD(" AND   O.TipoTr2 = 'TRANSP' ")
*FO10/11/2005SQL.ADD(" AND  M.FechaMov = "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND  M.FechaEje = "~idxdate2(Dialogo.Fecha1)~" ")
If Novacio(Dialogo.Especie1)
   SQL.ADD(" AND  M.Especie = '"~Dialogo.Especie1~"' ")
Endif
If Novacio(Dialogo.Cliente1)
   SQL.ADD(" AND  O.Cliente1 = '"~Dialogo.Cliente1~"' ")
Endif
If Novacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND  O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
Endif
SQL.ADD(" ORDER BY M.Especie, T.NrTrans, M.FechaMov, M.NrOperacion  ")

Recorrer SQL
  If Not Eqstr(Val(ea:1), fbn('Moneda'))
      If Not Eqstr(Val(ea:1), '')
         ACT(a:fac, 'Total liquidado '~fbn('Moneda')~' --> ')
         ACN(c:fac, SUM(c:Val(fi:1)..c:fac))
         Agregarmarco(a:fac..m:fac,1,0)
         SetFont(A:fac..z:fac, 2)
         Formatoceldas(c:fac, EXE('F2'))
         ifa
         ifa
      Endif
      ACT(a:fac, 'Movimientos Liquidados de '~fbn('Moneda'))
      Agregarmarco(a:fac..m:fac,1,0,EXE('COLOR8'))
      SetFont(A:fac..z:fac, 2)
      ifa
      ACN(fi:1, fac)
  Endif

** FJL 18/12/18 - Para Mercados regulados de FX (ROFEX) poner Netos
  if Dialogo.Check1=0
    ACT(z:1, BuscarCampo('MERCADOS','Regulado','Codigo',fbn['Mercado1']))
    if EqStr(Val(z:1),'SI')
      if EqStr(fbn('NrTrans'), Val(z:2))
        DFA
      endif
      ACT(z:2, fbn('NrTrans'))
    endif
  endif

  ACD(a:fac, fbn('FechaMov'))
  ACT(b:fac, fbn('Cliente1'))
  SCN(c:fac, fbn('Cantidad'))
  ACT(d:fac, fbn('Cuenta2'))
** FJL 18/12/18 - Para Mercados regulados de FX (ROFEX) poner Netos
  if EqStr(Val(z:1),'SI') y Dialogo.Check1=0
    ACT(f:fac, 'Neto de Operaciones')
  else
    ACT(e:fac, fbn('TipoOp'))
    ACT(f:fac, fbn('NrOperacion'))
    ACLO(f:fac, fbn('NrOperacion'))
    ACD(g:fac, fbn('FechaOp'))
    ACD(h:fac, fbn('FechaVto'))
    ACT(i:fac, fbn('Especie'))
    ACT(j:fac, fbn('ContraEspecie'))
    ACN(k:fac, fbn('Precio1'))
  endif
  If fbn('CB3')=1
    ACT(l:fac, 'Fallado')
  ELse
    If fbn('CB9')=1
      ACT(l:fac, 'Confirmado')
    Else
      ACT(l:fac, 'Pendiente')
    Endif
  Endif
  ACT(m:fac, fbn('NrTrans'))
  ACLT(m:fac, fbn('NrTrans'))

  ACT(ea:1, fbn('Moneda'))
  SetFont(A:fac..z:fac, 1)
  Formatoceldas(c:fac, EXE('F2'))
  Formatoceldas(k:fac, EXE('F9'))
Proximo

ifa
ACT(a:fac, 'Total liquidado '~vAL(ea:1)~' --> ')
ACN(c:fac, SUM(c:Val(fi:1)..c:fac))
Agregarmarco(a:fac..m:fac,1,0)
SetFont(A:fac..z:fac, 2)
Formatoceldas(c:fac, EXE('F2'))

IFA
IFA
IFA
ACT(a:fac, 'Fin del Informe.')
IFA
ACT(a:fac, USUARIOACTIVO)
SetFont(A:fac-1..a:fac, 2)


Recorrer&i 1,12
  ACO(&i, 8)
Proximo

iMPRESION(1,2)
iMPRESION(4,1)
LimitesVision(m:fac+2)
SetMargins(0,0,0,2)
