ACT(a:fac+1, 'Vehiculo : '~Dialogo.Vehiculo1)
ACT(a:fac+2, IIF(Dialogo.Radio2=0,'Trimestre: '~Fstr(Dialogo.Entero1,0,0),'Mes: '~Fstr(Dialogo.Entero4,0,0))~'  '~'Fecha Hasta : '~Dialogo.Fecha2)
If Dialogo.Radio1=0
   ACT(a:fac+3, 'Tipo Cliente: '~VAR('LABEL') )
Else
   If Dialogo.Radio1=1
      ACT(a:fac+3, 'Tipo Cliente: CAJA')
   Else
      ACT(a:fac+3, 'Tipo Cliente: TODOS')
   EndIf
EndIf
 
SetFont(a:fac+1..i:fac+4,2)
