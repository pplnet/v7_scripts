ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"                          ;1;1;;NO;;;;;VAR('VEHICULODE')
  Radio1     : "Tipo Cliente|"~VAR('LABEL')~"|Caja|Todos" ;2;1;;NO;NO;;;;2;
  Entero1    : "Trimestre"                         ;4;1;;Dialogo.Radio2=0;Dialogo.Radio2=0;Dialogo.Entero1>=1 y Dialogo.Entero1<=4;'Nro. de Trimestre Incorrecto';NO;IIf(Trunc2(Mes(Fsys)/3.1)=0,4,Trunc2(Mes(Fsys)/3.1))
  Entero4    : "Mes"                               ;4;1;;Dialogo.Radio2=1;Dialogo.Radio2=1;Dialogo.Entero4>=1 y Dialogo.Entero4<=12;'Nro. de Mes Incorrecto';NO;Mes(Fsys)
  Entero2    : "Anio"                              ;4;2;;;;Dialogo.Entero1>=0;'Anio Incorrecto !!!';NO;IIf(Trunc2(Mes(Fsys)/3.1)=0,Anio(Fsys)-1,Anio(Fsys))
  Fecha2     : "F.Hasta"                           ;5;1;;;;Dialogo.Fecha2<=Habiles(FSys,1);"Fecha Hasta Incorrecta";NO;;IIf(Dialogo.Radio2=0,IIf(Dialogo.Entero1<>Trunc2(Dialogo.Entero4/3.1)+1,FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero1*3,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),IIF(Fsys=FinDeMes(Fsys),FinDeMes(Fsys,SI),Fsys)),IIF(Mes(Fsys)<>Dialogo.Entero4 o Anio(Fsys)<>Dialogo.Entero2,FinDeMes(Fecha('01/'~Pad0(Fstr(Dialogo.Entero4,0,0),2)~'/'~Fstr(Dialogo.Entero2,4,0)),SI),Fsys))
  Radio2     : "Tipo|Trimestral|Mensual|"          ;;;;NO;;;;;1
** FJL 15/11/21 - Da error - REVISAR
  *  ListaTabla1: 'Clientes'                          ;7;1;;;;;;;;;;;;IIF(Dialogo.Radio1<>2," "~IIF(Dialogo.Radio1=0," TipoCliente='"~VAR('CLISUD')~"' or TipoCliente Is Null"," TipoCliente='"~VAR('CLICAJA')~"' ")),"1=1" );'Codigo' ; 'Codigo;RazonSocial' ; 'vCLIENTES01'
FinDialogo

If Not OK
   Cancelar
Endif

If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
  Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
Endif

