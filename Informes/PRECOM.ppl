AgregarMarco(a:fac..l:fac,2,0,Exe('COLOR6'))
SetFont(a:fac..l:fac,2)
AlinearCeldas(a:fac..l:fac,'C') 

*-Seleccion de tipos de transacciones 'CUSSAl' segun un cliente y un oficial. 
SQL.ADD("SELECT DISTINCT T.* , 'PENDIENTE' Estado, C.RazonSocial, C.Sucursal, O.Descripcion FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPENDIENTES M, "~DBO~".OFICIALESCUENTA O, "~DBO~".CLIENTES C  " )
SQL.ADD("WHERE T.TipoTr2='CUSSAL' ")
If Dialogo.Radio2=0
   SQL.ADD("and T.Precio1="~Fstr(Dialogo.Entero1,0,0)~"  ")
Else
   SQL.ADD("and T.Precio1="~Fstr(Dialogo.Entero4,0,0)~"  ")
EndIf
SQL.ADD("and T.Precio2="~Fstr(Dialogo.Entero2,0,0)~" ")
SQL.ADD("and (T.Fecha1='"~IdxDate(Dialogo.Fecha2)~"' or T.CB1='1' ) ")
SQL.ADD("and T.NrTrans = M.NrOperacion ")
** FJL 16/11/21 - El =* da error - Ver como reemplazarlo
*SQL.ADD("and O.Codigo=*T.Ley1 ")
SQL.ADD("and O.Codigo=T.Ley1 ")
SQL.ADD("and T.Cliente1=C.Codigo ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and T.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
EndIf
If NoVacio(Dialogo.Listatabla1)
   SQL.ADD("and T.Cliente1 in ("~Pipe2Comillas(Dialogo.Listatabla1)~") ")
EndIf
IF Dialogo.Radio1 = 0
   *- Solamente Clientes SUDAMERIS
   SQL.ADD("and   (C.TipoCliente = '"~VAR('CLISUD')~"' or ")
   SQL.ADD("    C.TipoCliente IS NULL or ")
   SQL.ADD("    C.TipoCliente = '      ')")
EndIf
IF Dialogo.Radio1 = 1
   *- Solamente Clientes CAJA
   SQL.ADD(" and C.TipoCliente = '"~VAR('CLICAJA')~"'")
EndIf
SQL.ADD("UNION ALL ")
SQL.ADD("SELECT DISTINCT T.*, 'EJECUTADO' Estado, C.RazonSocial, C.Sucursal, O.Descripcion FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M, "~DBO~".OFICIALESCUENTA O, "~DBO~".CLIENTES C ")
SQL.ADD("WHERE T.TipoTr2='CUSSAL' ")
If Dialogo.Radio2=0
   SQL.ADD("and T.Precio1="~Fstr(Dialogo.Entero1,0,0)~"  ")
Else
   SQL.ADD("and T.Precio1="~Fstr(Dialogo.Entero4,0,0)~"  ")
EndIf
SQL.ADD("and T.Precio2="~Fstr(Dialogo.Entero2,0,0)~" ")
SQL.ADD("and (T.Fecha1='"~IdxDate(Dialogo.Fecha2)~"' or T.CB1='1' ) ")
SQL.ADD("and T.NrTrans = M.NrOperacion ")
** FJL 16/11/21 - El =* da error - Ver como reemplazarlo
*SQL.ADD("and O.Codigo=*T.Ley1 ")
SQL.ADD("and O.Codigo=T.Ley1 ")
SQL.ADD("and T.Cliente1=C.Codigo ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD("and T.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
EndIf
*- Para un cliente dado
If NoVacio(Dialogo.Listatabla1)
   SQL.ADD("and T.Cliente1 in ("~Pipe2Comillas(Dialogo.Listatabla1)~") ")
EndIf
IF Dialogo.Radio1 = 0
   *- Solamente Clientes SUDAMERIS
   SQL.ADD(" and  (C.TipoCliente = '"~VAR('CLISUD')~"' or ")
   SQL.ADD("    C.TipoCliente IS NULL or ")
   SQL.ADD("    C.TipoCliente = '      ')")
EndIf
IF Dialogo.Radio1 = 1
   *- Solamente Clientes CAJA
   SQL.ADD("and C.TipoCliente = '"~VAR('CLICAJA')~"' ")
EndIf
SQL.ADD(" ORDER BY T.Ley1,T.Especie,T.Cliente1")


Recorrer SQL

*- Contenido de celdas:
*-                     z2 = Total por IVA 
*-                     z3 = Total por Comision
*-                     z4 = Flags 
*-                     z5 = Iva+Comision
      
