   **ACT(j:FAC+1,FBN['TipoOp'])
   ACT(k:FAC,FBN['NrOperacion'])
   AgregarMarco(j:FAC..k:FAC,2,2)
   SetFont(j:FAC, 2)
   
   IFA
   ACT(a:FAC, 'Plazo: ')
   SetFont(a:FAC, 2)
   ACT(c:FAC, FBN['Plazo'])
   AgregarMarco(a:FAC..c:FAC,2,0)
   
   IFA
   ACT(a:FAC, 'Fecha Vencimiento: ')
   SetFont(a:FAC, 2)
   ACT(c:FAC, FBN['FechaVto'])
   AgregarMarco(a:FAC..c:FAC,2,0)
    
   IFA
   
   SetFilaActual(FAC+2)
      
   *  SetFilaActual(FAC+1)
    
   * SetFilaActual(FAC+2)
   ACT(A:FAC, 'Colocador')
   ACT(g:FAC, 'Tomador')
   AgregarMarco(a:FAC..f:FAC,2,0)
   AgregarMarco(g:FAC..k:FAC,2,0)
   SetFont(a:FAC..l:FAC, 2)
   IFA
      
   * ---> Impresion De La Razon Social
   ACT(ZB:01, FBN['RazonSocVeh'])
   (.'ELIBLANCOS'.)
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
      ACT(A:FAC, Val(ZB:03))
   Else
   ACT(G:FAC,Val(ZB:03))
   Endif
   ACT(ZB:01, FBN['RazonSocCli'])
   (.'ELIBLANCOS'.)
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
   ACT(G:FAC, copy(Val(ZB:03),1,25))
   Else
      ACT(A:FAC, Val(ZB:03))
   Endif
    
   AgregarMarco(a:FAC..f:FAC,2,0)
   AgregarMarco(g:FAC..k:FAC,2,0)
     
   IFA    
   * ---> Impresion Del Numero De CUIT/CUIL    
   ACT(zz1, FBN['CuitVeh'])
   ACT(zz2, FBN['TipoInsVeh'])
   If [NoVacio(Val(zz1)) y Not EqStr(Val(zz1), '000000000000000')]
      If [EqStr(Copy(Val(zz1), 01, 04), '0000')]
         ACT(ZB:10, Copy(Val(zz1), 05, 11))
      Else  
         If [[EqStr(Copy(Val(zz1), 03, 01), '-')] y [EqStr(Copy(Val(zz1), 12, 01), '-')]]
            ACT(ZB:10, Copy(Val(zz1), 01, 13))
         Else           
            ACT(ZB:10, Copy(Val(zz1), 01, 11))
         EndIf      
      EndIf
   Else
      ACT(ZB:10, '')
   EndIf
   ACT(ZB:11, Val(zz2))
   (.'ARMACUIT'.)
   * ---> Impresion Del CUIT
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
      ACT(A:FAC, Val(ZB:14))
      ACT(A:FAC+1, Val(ZB:13))
   Else
      ACT(g:FAC, Val(ZB:14))
      ACT(g:FAC+1, Val(ZB:13))
   Endif
   ACT(zz1, FBN['CuitCli'])
   ACT(zz2, FBN['TipoInsCli'])
   If [NoVacio(Val(zz1)) y Not EqStr(Val(zz1), '000000000000000')]
      If [EqStr(Copy(Val(zz1), 01, 04), '0000')]
         ACT(ZB:10, Copy(Val(zz1), 05, 11))
      Else  
         If [[EqStr(Copy(Val(zz1), 03, 01), '-')] y [EqStr(Copy(Val(zz1), 12, 01), '-')]]
            ACT(ZB:10, Copy(Val(zz1), 01, 13))
         Else           
            ACT(ZB:10, Copy(Val(zz1), 01, 11))
         EndIf      
      EndIf
   Else
      ACT(ZB:10, '')
   EndIf
   ACT(ZB:11, Val(zz2))
   (.'ARMACUIT'.)
   * ---> Impresion Del CUIT
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
      ACT(g:FAC, Val(ZB:14))
      ACT(g:FAC+1, Val(ZB:13))
   Else
      ACT(A:FAC, Val(ZB:14))
      ACT(A:FAC+1, Val(ZB:13))
   Endif
    
   * ---> Impresion De La Direccion
   #ifdef MLASA
      ACT(c:FAC, 'Domicilio / Address')
      ACT(i:FAC, 'Domicilio / Address') 
   #else
      ACT(c:FAC, 'Domicilio ')
      ACT(i:FAC, 'Domicilio ') 
   #endif
   
   SetFont(A:FAC..l:FAC, 2)
   AlinearCeldas(A:FAC..l:FAC,'I')
           
   IFA        
       
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
      ACT(ZB:01, FBN['DireVeh'])
      if Vacio(val(ZB:01))
         ACT(ZB:01, FBN('CalleVeh')~' '~FBN('AlturaVeh')~' '~FSTR(FBN('PisoVeh'),1,0)~' '~FBN('DeptoVeh'))
      endif
      (.'ELIBLANCOS'.)
      ACT(c:FAC, Val(ZB:03))
      ACT(ZB:01, FBN['DireCli'])
      if Vacio(val(ZB:01))
         ACT(ZB:01, FBN('CalleCli')~' '~FBN('AlturaCli')~' '~FSTR(FBN('PisoCli'),1,0)~' '~FBN('DeptoCli'))
      endif
      (.'ELIBLANCOS'.)
      ACT(i:FAC, Val(ZB:03))
   Else
      ACT(ZB:01, FBN['DireVeh'])
      if Vacio(val(ZB:01))
         ACT(ZB:01, FBN('CalleVeh')~' '~FBN('AlturaVeh')~' '~FSTR(FBN('PisoVeh'),1,0)~' '~FBN('DeptoVeh'))
      endif
      (.'ELIBLANCOS'.)
      ACT(i:FAC, Val(ZB:03))
      ACT(ZB:01, FBN['DireCli'])
      if Vacio(val(ZB:01))
         ACT(ZB:01, FBN('CalleCli')~' '~FBN('AlturaCli')~' '~FSTR(FBN('PisoCli'),1,0)~' '~FBN('DeptoCli'))
      endif
      (.'ELIBLANCOS'.)
      ACT(c:FAC, Val(ZB:03))
   Endif      
     
   AgregarMarco(a:FAC-1..b:FAC,2,0) 
   AgregarMarco(c:FAC-1..f:FAC,2,0)   
   AgregarMarco(g:FAC-1..h:FAC,2,0)  
   AgregarMarco(i:FAC-1..k:FAC,2,0)  
        
   * ---> Impresion Del Codigo Postal y la Localidad
   IFA
   #ifdef MLASA   
      ACT(A:FAC, 'Localidad / Town')
      ACT(C:FAC, 'C. Postal / Z. Code')
      ACT(D:FAC, 'Telefono/s / Telephone/s')
   
      ACT(g:FAC, 'Localidad / Town')
      ACT(i:FAC, 'C.Postal / Z. Code')
      ACT(j:FAC, 'Telefono/s / Telephone/s')
   #else
      ACT(A:FAC, 'Localidad ')
      ACT(C:FAC, 'C. Postal ')
      ACT(D:FAC, 'Telefono/s')
   
      ACT (g:FAC, 'Localidad ')
      ACT(i:FAC, 'C.Postal ')
      ACT(j:FAC, 'Telefono/s ')   
   #endif
   SetFont(A:FAC..l:FAC, 2)
   
   IFA
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
      If NoVacio(FBN['LocaliVeh'])
         ACT(ZB:01, FBN['LocaliVeh'])
         (.'ELIBLANCOS'.)
         ACT(A:FAC, Val(ZB:03))
      EndIf
      If NoVacio(FBN['LocaliCli'])
         ACT(ZB:01, FBN['LocaliCli'])
         (.'ELIBLANCOS'.)
         ACT(g:FAC, Val(ZB:03))
      EndIf
   Else
      If NoVacio(FBN['LocaliVeh'])
         ACT(ZB:01, FBN['LocaliVeh'])
         (.'ELIBLANCOS'.)
         ACT(g:FAC, Val(ZB:03))
      EndIf
      If NoVacio(FBN['LocaliCli'])
         ACT(ZB:01,FBN['LocaliCli'])
         (.'ELIBLANCOS'.)
         ACT(a:FAC, Val(ZB:03))
      EndIf
   Endif
         
   ACT(zz1, FBN['CodPosVeh'])   
   If [NoVacio(Val(zz1)) y Not EqStr(Val(zz1), '000000')]
      If [EqStr(Copy(Val(zz1), 01, 02), '00')]
         If Incluido(fbn['TipoOp'],'TICO|TIPO')
            ACT(C:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Else
            ACT(i:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Endif
      Else  
         If Incluido(fbn['TipoOp'],'TICO|TIPO')
            ACT(C:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Else
            ACT(i:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Endif
      EndIf
   EndIf
   ACT(zz1, FBN['CodPosCli'])   
   If [NoVacio(Val(zz1)) y Not EqStr(Val(zz1), '000000')]
      If [EqStr(Copy(Val(zz1), 01, 02), '00')]
         If Incluido(fbn['TipoOp'],'TICO|TIPO')
            ACT(i:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Else
            ACT(C:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Endif
      Else  
         If Incluido(fbn['TipoOp'],'TICO|TIPO')
            ACT(i:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Else
            ACT(C:FAC, "(" ~ Copy(Val(zz1), 01, 04) ~ ')')
         Endif
      EndIf
   EndIf
    
   If Incluido(fbn['TipoOp'],'TICO|TIPO')
