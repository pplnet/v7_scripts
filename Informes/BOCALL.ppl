ACT(op:1, Dialogo.NrOperacion1)
ACT(ar:1,VAR('PATHCONFI')~'Boleto_Cliente_'~Val(cu:1)~'_'~Val(op:1)~'_'~Dialogo.String~'.pdf')

*Email
ACT(em:3, BuscarCampo('OPERACIONES', 'Cliente1','NrOperacion', Dialogo.NrOperacion1))
ACT(em:1, BuscarCampo('Clientes', 'DireccionEmail', 'Codigo', Val(em:3)))

*Leyendas
ABT(AA:10..AA:20, LeerLeyenda('','','','MBOLETOASU'), 1)
ABT(ZK:1..ZK:4, LeerLeyenda('','','','MBOLETODET'), 1)


SetFilaActual(fac+3)
LimitesVision(L:FAC)
SetPrintFit(3,80)
Impresion(1,0)
Impresion(2,0)
Impresion(3,0)
Impresion(4,0)
SetMargins(1,0,0,0)

ACO(1, 8)
ACO(2, 7)
ACO(3, 10)
ACO(4, 11)
ACO(5, 2)
ACO(6, 4)
ACO(7, 2)
ACO(8, 12)
ACO(9, 12)
ACO(10, 8)
ACO(11, 8)
ACO(12,2)

if Dialogo.Radio2 = 0
   ImprimirHoja
Else
   If Dialogo.Radio2 = 2
      HojaVisible(NO)
      SetPrintFit(4)
      ExportarPdfLite(val(ar:1))
    Else
       If Dialogo.Radio2 = 3  
         HojaVisible(NO)
         SetPrintFit(4)
         ExportarPdfLite(val(ar:1))
         SendMail(Val(em:1),val(AA:10),val(ZK:1),SI,,,val(ar:1),,SI)
       Endif
    Endif
Endif 