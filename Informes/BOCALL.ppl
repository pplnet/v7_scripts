   AgregarMarco(d:FAC-1..f:FAC,2,0)   
   AgregarMarco(g:FAC-1..h:FAC,2,0)  
   AgregarMarco(i:FAC-1..i:FAC,2,0)  
   AgregarMarco(j:FAC-1..k:FAC,2,0)  
      
