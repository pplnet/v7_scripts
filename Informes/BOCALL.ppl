SQL.ADD("SELECT O.*, E.Alias5,  E.InteresesC, OB.Valor,  E.CodMAEContado ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit       = 30  ")
ENDIF

SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8, ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.Add(" CC.RazonSocial RazonSocCli, CC.Direccion DireCli, CC.CUIT CuitCli, CC.TipoInscripcion TipoInsCli, CC.Localidad LocaliCli, ")
SQL.Add(" CC.CodigoPostal CodPosCli, CC.Telefono TelefonoCli, CC.Calle CalleCli, CC.Altura AlturaCli, CC.Piso PisoCli, CC.Depto DeptoCli, ")
SQL.Add(" CV.RazonSocial RazonSocVeh, CV.Direccion DireVeh, CV.CUIT CuitVeh, CV.TipoInscripcion TipoInsVeh, CV.Localidad LocaliVeh, ")
SQL.Add(" CV.CodigoPostal CodPosVeh, CV.Telefono TelefonoVeh, CV.Calle CalleVeh, CV.Altura AlturaVeh, CV.Piso PisoVeh, CV.Depto DeptoVeh, ")
SQL.ADD(" O.Vehiculo1, E.Alias5,  E.InteresesC, 0 Valor,  E.CodMAEContado,                              ")
SQL.ADD(" O.Mercado2 MercadoMon, O.Mercado MercadoTit, O.Mercado4 MercadoNeg                            ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB, "~DBO~".CLIENTES CC, "~DBO~".CLIENTES CV  ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit  NOT IN (30,31) AND OB.Valor=1 ")
SQL.ADD("       and O.Cliente1 = CC.Codigo ")
SQL.ADD("       and O.Vehiculo1 = CV.Codigo ")
SQL.ADD(" UNION ")
SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8,         ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.Add(" CC.RazonSocial RazonSocCli, CC.Direccion DireCli, CC.CUIT CuitCli, CC.TipoInscripcion TipoInsCli, CC.Localidad LocaliCli, ")
SQL.Add(" CC.CodigoPostal CodPosCli, CC.Telefono TelefonoCli, CC.Calle CalleCli, CC.Altura AlturaCli, CC.Piso PisoCli, CC.Depto DeptoCli, ")
SQL.Add(" CV.RazonSocial RazonSocVeh, CV.Direccion DireVeh, CV.CUIT CuitVeh, CV.TipoInscripcion TipoInsVeh, CV.Localidad LocaliVeh, ")
SQL.Add(" CV.CodigoPostal CodPosVeh, CV.Telefono TelefonoVeh, CV.Calle CalleVeh, CV.Altura AlturaVeh, CV.Piso PisoVeh, CV.Depto DeptoVeh, ")
SQL.ADD(" O.Vehiculo1, E.Alias5,  E.InteresesC, 1 Valor,  E.CodMAEContado,                              ")
SQL.ADD(" O.Mercado2 MercadoMon, O.Mercado MercadoTit, O.Mercado4 MercadoNeg                            ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB, "~DBO~".CLIENTES CC, "~DBO~".CLIENTES CV  ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit IN (30,31) AND OB.Valor=1 ")
SQL.ADD("       and O.Cliente1 = CC.Codigo ")
SQL.ADD("       and O.Vehiculo1 = CV.Codigo ")
SQL.ADD(" UNION ")
SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8, ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.Add(" CC.RazonSocial RazonSocCli, CC.Direccion DireCli, CC.CUIT CuitCli, CC.TipoInscripcion TipoInsCli, CC.Localidad LocaliCli, ")
SQL.Add(" CC.CodigoPostal CodPosCli, CC.Telefono TelefonoCli, CC.Calle CalleCli, CC.Altura AlturaCli, CC.Piso PisoCli, CC.Depto DeptoCli, ")
SQL.Add(" CV.RazonSocial RazonSocVeh, CV.Direccion DireVeh, CV.CUIT CuitVeh, CV.TipoInscripcion TipoInsVeh, CV.Localidad LocaliVeh, ")
SQL.Add(" CV.CodigoPostal CodPosVeh, CV.Telefono TelefonoVeh, CV.Calle CalleVeh, CV.Altura AlturaVeh, CV.Piso PisoVeh, CV.Depto DeptoVeh, ")
SQL.ADD(" O.Vehiculo1, E.Alias5,  E.InteresesC, 1 Valor,  E.CodMAEContado,                              ")
SQL.ADD(" O.Mercado2 MercadoMon, O.Mercado MercadoTit, O.Mercado4 MercadoNeg                            ")
SQL.ADD("FROM   "~DBO~".BOPERACIONES O, "~DBO~".ESPECIES E , "~DBO~".CLIENTES CC, "~DBO~".CLIENTES CV   ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and O.Cliente1 = CC.Codigo ")
SQL.ADD("       and O.Vehiculo1 = CV.Codigo ")
watch(SQL.BATCH())

* ---> Impresion De Lineas Del Boleto
Recorrer SQL
    
   * ---> Impresion Del Titulo De Referencia
   #ifdef BACS
   SetFilaActual(9)
   #else
   SetFilaActual(11)
   #endif
   If EqStr(fbn['TipoOp'],'TICO')
   ACT(d:fac, "                 Liquidacion Call Otorgado de Titulos")
   Else
      If EqStr(fbn['TipoOp'],'TICT')
      ACT(d:fac, "             Liquidacion Call Tomado de Titulos")
      Else
         If EqStr(fbn['TipoOp'],'TIPO')
         ACT(d:fac, "          Liquidacion Prestamo Otorgado Titulos")
         Else
            If EqStr(fbn['TipoOp'],'TIDE')
            ACT(d:fac, "               Liquidacion Deposito Titulos")
            Else
               ACT(d:fac, "")
            Endif
         Endif
      Endif   
   Endif 
 
   SetFont(d:fac, 3)
   SetFilaActual(13)  
    
   
   AFI(FAC+2,0.1)
   AFI(FAC+3,0.1)
   AFI(FAC+4,0.1)
   AFI(FAC+5,0.1)
   AFI(FAC+6,0.1)
   *ACT(e:fac+2, 'Depositante en Caja de Valores N# '~Val(vh:4))
   *ACT(d:fac+3, '                              Agente de Mercado Abierto N# '~Val(vh:5)~'  CUIT '~Val(vh:1))
   *ACT(d:fac+4, '                                IVA Resp. Inscripto - Ingresos Brutos n# '~Val(vh:2))

   **verificar si cambiamos por esto
   #ifdef BACS
   
   #else
   ACT(c:fac,  '        Agente de Liquidacion y Compensacion Propio registrado en CNV bajo el Nro. de matricula '~Val(vh:4)~' - ALyC y AN Propio')
   if no
   if EqStr(fbn['MercadoNeg'],var('AMBMAE'))
       ACT(d:fac+1, '                    Agente de Mercado Abierto N# '~Val(vh:5)~'  CUIT '~Val(vh:1))
   else
       ACT(d:fac+1, '                          Numero Agente N# '~Val(vh:6)~'  CUIT '~Val(vh:1))
   endif
   endif
   ACT(d:fac+2, '                         IVA Resp. Inscripto - Ingresos Brutos n# '~Val(vh:2))  
   #endif

   *SetFont(d:fac+1..h:fac+6,4)
   
   if FBN['Valor']=1
      act(d:fac-3,Pad('',18)~'A    N    U    L    A    D    O')    
      SetFont(d:FAC-3, 3)
   endif
      
   SetFilaActual(fac+4)
   acn(w1,fac)
   
   * ---> Impresion De La Fecha De Emision y Fecha De Vencimiento
   ACD(ZB:09, FSys)
   ACT(a:FAC, 'Fecha Concertacion: ')
   SetFont(a:FAC, 2)
   ACT(c:FAC, FBN['FechaOp'])
   AgregarMarco(a:FAC..c:FAC,2,0)
      
   ACT(j:FAC, 'N# Minuta')
