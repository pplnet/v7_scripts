      ACT(f:FAC+1, 'Cupon')
      ACT(H:FAC+1, 'Notional Value')
      ACT(I:FAC+1, 'Residual Value')
      ACT(J:FAC+1, 'Rate')
      ACT(K:FAC+1, 'VN Interes')
      ACN(W4,FAC+1)
      AlinearCeldas(A:FAC+1..L:FAC+1,'C')
      AlinearCeldas(K:FAC+1,'D')
      SetFont(a:fac+1..k:fac+1,2)
   #endif  
   AgregarMarco(a:fac..k:val(w4),2,0)        
   SetFilaActual(fac+3)   
          
   ACT(b:FAC, BuscarCampo('Especies', 'CodMAEContado', 'Codigo', fbn['Especie']))
   ACT(c:FAC, BuscarCampo('Especies', 'CodNumCajaValores', 'Codigo', fbn['Especie']))
   ACT(d:FAC, BuscarCampo('Especies', 'Nombre', 'Codigo', fbn['Especie']))
      
   ACT(a:FAC, Trim(BuscarCampo('Especies', 'Nombre', 'Codigo', FBN('ContraEspecie'))))
   ACN(f:FAC, FBN['Cupon1'])
   FormatoCeldas(f:FAC,Exe('FE'))
   ACN(H:FAC, fbn['Cantidad'])
   acn(vr2,   FBN['Alias5'])
   
   acn(ZB:08, FBN['CANTIDAD']*ValorTeorico2(FBN['ESPECIE'],FBN['FECHAOP']))
   
   ACN(I:FAC, Round(Val(ZB:08),Val(vr2)))
   ACN(J:FAC, fbn['Precio1'])   
   FormatoCeldas(J:FAC,Exe('F9'))
   ACN(Z:11,fbn['TotalIntereses'])
   ACN(K:FAC, Val(Z:11))
   FormatoCeldas(k:FAC,Exe('F6'))
   SetFont(a:fac..k:fac,1)
      
   AlinearCeldas(A:FAC..L:FAC,'C')
   AlinearCeldas(K:FAC,'D')
   
   SetFilaActual(fac+2) 
     
   SetFilaActual(fac+1)
   AlinearCeldas(j:fac-4..J:FAC,'D')
   AgregarMArco(a:FAC-4..k:fac,2,0)
       
   SetFilaActual(fac+1)  
   ACT(h:FAC, 'Nominales a recibir por el tomador el '~FBN['FechaOp'])
   ACN(K:FAC, fbn['Cantidad'])
   ACT(h:FAC+1, 'Nominales a entregar por el tomador el '~FBN['FechaVto'])
   ACN(K:FAC+1, fbn['Cantidad'])
   ACT(h:FAC+2, 'Intereses a pagar por el tomador el '~FBN['FechaVto'])
   ACN(K:FAC+2, fbn['TotalIntereses'])
   
   If FBN['FechaVto'] <= FSYS
   
       ACT(H:FAC+3, 'Cotizacion ')
       ACN(K:FAC+3, BuscarCampo('OPERACIONES','Precio2', 'NrOperacion', FBN['NrOperacion'] ))
       ACT(h:FAC+4, 'Intereses en moneda al VTO')
       ACN(k:FAC+4, BuscarCampo('OPERACIONES', 'TotalBrutoCli3', 'NrOperacion', FBN['NrOperacion']))
       
       AgregarMarco(H:FAC..k:FAC+4,2,0)
       
    else
     
       AgregarMarco(H:FAC..k:FAC+2,2,0)
       
    endif
  
   SetFilaActual(fac+1)
   AgregarMarco(A:FAC..C:FAC+2,2,0)

   * ACT(bm1, Copy(var('FBOLETO'), 1, Posicion('.',var('FBOLETO'), 1, Longitud(var('FBOLETO'))) -1) ~'D.bmp') 
   *DesEncriptarArchivo(var('FBOLETO'),val(bm1))
   *AgregarBMP(a:fac,val(bm1),80)
   *BorrarArchivo(val(bm1))

   * Firma
   *AgregarBMP(a:fac,EXE('FBOLETO'),70)

   #ifdef MLASA
      ACT(a:FAC+3,Pad('',12)~'Firma y Sello / Signature ')
   #else
      ACT(a:FAC+3,Pad('',12)~'Firma y Sello ')
   #endif
   SetFont(a:fac+3,2)
   SetFilaActual(FAC+7)
       
   ACT(e:FAC-2,Dialogo.String)
   SetFont(e:fac-2,2)
proximo

* La Asignacion del nombre del archivo para generar PDF debe estar previo a la definicion de LimiteVision
