CrearDialogo
  Cliente1 : 'Cliente';;;;;;NoVacio(Dialogo.Cliente1);'Debe ingresar un cliente';NO;
  Fecha1 : 'F.Desde';;;;;;;;;FSys
  Fecha2 : 'F.Hasta';;;;;;;;;FSys
FinDialogo

if not Ok
  Cancelar
endif


ACT(a1, 'Gestion de Clientes')
ACT(a2, 'Cliente : '~Dialogo.Cliente1)
ACT(a3, 'D.Fecha : '~Dialogo.Fecha1)
ACT(a4, 'H.Fecha : '~Dialogo.Fecha2)

ACT(a6, 'Tipo')
ACT(b6, 'ARP')
ACT(c6, 'USD')
***---ACT(d6, 'Total')

SQL.ADD("Select * from "~DBO~".OPERACIONES where")
SQL.ADD("Cliente1 = '"~Dialogo.Cliente1~"' and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and TipoOp in ('MMCO','MMCT','MMAD','MMDES','MMCA','MMPF','MMPFCE','MMPO','MMOVN')")
SQL.ADD("order by TipoOp")

SetFilaActual(6) 
recorrer SQL
  dfa
  if Not EqStr(Val(a:fac), fbn('TipoOp'))
    ifa
    ACT(a:fac, fbn('TipoOp'))
  endif
  if Incluido(fbn('Especie'), 'ARP')
    SCN(b:fac, fbn('Cantidad'))
  else
    SCN(c:fac, fbn('Cantidad'))
  endif
***---  SCN(d:fac, fbn('Cantidad'))
proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..z6, 1)
SetFont(a7..z:fac, 2)
AgregarMarco(a6..C6,2,0,Exe("COLOR"))
AlinearCeldas(b6..d6, 'D')
FormatoCeldas(b7..d:fac, Exe('F0'))
LimitesVision(e:fac+1)
