CrearDialogo  
   Radio1       : 'Tipo|Activa|Borrada'  ;;;;;;;;;0;
   NrOperacion1 : '# Operacion:'         ;;;;Dialogo.Radio1=0;Dialogo.Radio1=0;;;;;;;;;;;;;;
   NrBOperacion : 'Op.Borrada :'         ;2;;;Dialogo.Radio1=1;Dialogo.Radio1=1;;;;;;;;;;;;;; 
   String1      : '# Alta Mae :'         ;;;;;;;;;;iif(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','NroAltaMAE',  'NrOperacion',Dialogo.NrOperacion1),BuscarCampo('BOPERACIONES','NroAltaMAE', 'NrOperacion',Dialogo.NrBOperacion));
   Fecha1       : 'Fecha Alta Mae:'      ;;;;;;;;;;iif((Dialogo.Radio1=0 y Vacio(Dialogo.NrOperacion1)) o (Dialogo.Radio1=1 y Vacio(Dialogo.NrBOperacion)),FSys,iif(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','FechaAltaMAE','NrOperacion',Dialogo.NrOperacion1),BuscarCampo('BOPERACIONES','FechaAltaMAE','NrOperacion',Dialogo.NrBOperacion)));
   Entero1      : 'Hora:'                ;;;;;;Dialogo.Entero1<24;'La hora no puede ser superior a 24'     ;NO;;Num(Copy(Dialogo.String5,1,2))
   Entero2      : 'Minutos:'             ;;;;;;Dialogo.Entero2<60;'Los minutos no pueden ser superiores a 60';NO;;Num(Copy(Dialogo.String5,4,2))
   Entero3      : 'Segundos:'            ;;;;;;Dialogo.Entero3<60;'Los segundos no pueden ser superiores a 60';NO;;Num(Copy(Dialogo.String5,7,2))
   String2      : '# Boleto'             ;;;;;;;;;;iif(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','NrBoleto','NrOperacion',Dialogo.NrOperacion1),BuscarCampo('BOPERACIONES','NrBoleto','NrOperacion',Dialogo.NrBOperacion));;;
   String4      : '# Orden'              ;;;;;;;;;;iif(Dialogo.Radio1=0,BuscarCampo('OPERACIONES','NrOrden','NrOperacion',Dialogo.NrOperacion1),BuscarCampo('BOPERACIONES','NrOrden','NrOperacion',Dialogo.NrBOperacion));;;
   String3      : 'Ref.MAE1'             ;;;;BuscarCampo('OPERACIONES','CB8','NrOperacion',Dialogo.NrOperacion1)=1 O BuscarCampo('BOPERACIONES','CB8','NrOperacion',Dialogo.NrBOperacion)=1;BuscarCampo('OPERACIONES','CB8','NrOperacion',Dialogo.NrOperacion1)=1 O BuscarCampo('BOPERACIONES','CB8','NrOperacion',Dialogo.NrBOperacion)=1
   String5      : 'Hora'                 ;;;;NO;NO;;;;;iif(Dialogo.Radio1=0,Hora(BuscarCampo('OPERACIONES','FechaAltaMAE','NrOperacion',Dialogo.NrOperacion1)),Hora(BuscarCampo('BOPERACIONES','FechaAltaMAE','NrOperacion',Dialogo.NrBOperacion)));
FinDialogo

If Not OK
   Cancelar
EndIf

ACT(A2,Copy(Dialogo.Fecha1,7,4)~'-'~Copy(Dialogo.Fecha1,4,2)~'-'~Copy(Dialogo.Fecha1,1,2)~' '~FStr(Dialogo.Entero1,2,0)~':'~FStr(Dialogo.Entero2,2,0)~':'~FStr(Dialogo.Entero3,2,0))  
  ACT(K12,SQLFechaStr(Val(a2),Exe('FORFECHOR')))  
  
  messagebox(val(k12))

   SQL.ADD(" "~DBO~".OPERACIONES SET         ")


   SQL.ADD("FechaAltaMAE  = "~Val(K12)~" ")




   SQL.ADD("where NrOperacion = '"~Dialogo.NrOperacion1~"'")