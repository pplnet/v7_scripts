ModoReproceso(SinDialogo)
CrearDialogo
  NrOperacion1 : "Nr.Operacion" ;;;;;;Vacio(Dialogo.NrOperacion1) o Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.NrOperacion1),'TIC|TIV');'Tipo Operacion invalido';NO
  Fecha1       : "F.Desde"      ;;;;;;Dialogo.Fecha1>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2       : "F.Hasta"      ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar la Fecha Hasta valida';NO;FSys
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Fecha(FSys))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Movimientos Parking por Operacion")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

if NoVacio(Dialogo.NrOperacion1)
  ACT(a:fac+1, 'NrOperacion: '~Dialogo.NrOperacion1)
else
  ACT(a:FAC+1, 'Fecha Desde: '~Dialogo.Fecha1)
  ACT(a:FAC+2, 'Fecha Hasta: '~Dialogo.Fecha2)
endif

SetFilaActual(FAC+4)

ACT(a:FAC, 'Tipo Op.')
ACT(b:FAC, 'Numero')
ACT(c:FAC, 'F.Operacion')
ACT(d:FAC, 'Vehiculo')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Especie')
ACT(g:FAC, 'Cantidad')
ACT(h:FAC, 'Precio')
ACT(i:FAC, 'Afecta')
ACT(j:FAC, 'Moneda')
ACT(k:FAC, 'Mer-Tit.')
ACT(l:FAC, 'Mer.Mon.')

ACT(c:FAC+1, 'F.Ejecucion')
ACT(d:FAC+1, 'F.Mov.')
ACT(e:FAC+1, 'Cliente Afectado')
ACT(f:FAC+1, 'Especie Afectada')
ACT(g:FAC+1, 'Cantidad')
ACT(h:FAC+1, 'Leyenda')
ACT(i:FAC+1, 'NrSaldo')
ACT(j:FAC+1, 'Moneda')
ACT(k:FAC+1, 'TipoDol')
ACT(l:FAC+1, 'Mercado')

AlinearCeldas(a:FAC+1..f:FAC+1,'I')
AlinearCeldas(g:FAC+1..g:FAC+1,'D')
AlinearCeldas(h:FAC+1..l:FAC+1,'I')
AlinearCeldas(a:FAC..f:FAC,'I')
AlinearCeldas(g:FAC..h:FAC,'D')
SetFont(a:Val(w1)..z:FAC+1,2)
AgregarMarco(a:FAC..l:FAC,2,0,Exe('COLOR6'))
AgregarMarco(b:FAC+1..l:FAC+1,2,0,Exe('COLOR6'))

SetFilaActual(FAC+1)

if NoVacio(Dialogo.NrOperacion1)
  ACT(X1, "O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
else
  ACT(X1, "FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")
endif

SQL.ADD("SELECT *  ")  
SQL.ADD("from "~DBO~".OPERACIONES O ")
SQL.ADD("where "~Val(X1))
SQL.ADD("  and TipoOp in ('TIC','TIV') ")
SQL.ADD("order by O.NrOperacion")

Recorrer SQL
  Message('Recuperando Datos Operacion ...')

  IF Not EqStr(FBN['NrOperacion'],Val(z1))
    ifa
    ACT(z1, FBN['NrOperacion'])
    ACT(a:FAC, FBN['TipoOp'])
    ACT(b:FAC, FBN['NrOperacion'])
    ACLO(b:FAC, fbn('NrOperacion'))
    ACD(c:FAC, FBN['FechaOp'])
    ACT(d:FAC, fbn('Vehiculo1'))
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
    ACT(f:FAC, FBN['Especie'])
    ACN(g:FAC, FBN['Cantidad'])
    ACN(h:FAC, FBN['Precio1'])
    ACT(i:FAC, FBN['ParkAfecta'])
    ACT(j:FAC, FBN['ContraEspecie'])
    ACT(k:FAC, FBN['Mercado'])
    ACT(l:FAC, FBN['Mercado2'])
    SetFont(a:FAC..y:FAC,2)
  endif
  ACN(y:1, 0)
  Message('Recuperando Mov. Ejecutados  ...')

  SQL.ADD("SELECT O.TipoOp, ")
  SQL.ADD("M.Cliente, M.FechaMov, M.FechaEje, M.Especie esp, M.Leyenda, ")
  SQL.ADD("M.NrSaldo, M.Cuenta, M.Transaccion, M.NrComprob, 'EJEC' est, ")
  SQL.ADD("M.Cantidad can, ")
  SQL.ADD("M.NrMov, M.Mercado MercMov ")  
  SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
  SQL.ADD("where O.NrOperacion = M.NrOperacion ")
  SQL.ADD("and O.NrOperacion = '"~fbn['NrOperacion']~"' ")
  SQL.ADD("and M.NrSaldo > 130 and M.NrSaldo < 140 ")
  SQL.ADD("order by O.TipoOp, O.NrOperacion, NrMov, est  ")
  
  Recorrer SQL
    SCN(y:1, 1)
    ACT(b:FAC, FBN['est'])
    ACD(c:FAC, FBN['FechaEje'])
    ACD(d:FAC, FBN['FechaMov'])
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

    if Vacio(Val(e:FAC))
      ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
    endif

    ACT(f:FAC, FBN['Esp'])
    ACN(g:FAC, FBN['Can'])
    ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
    ACN(i:FAC, FBN['NrSaldo'])
    if FBN['NrSaldo']=131
      ACT(j:FAC, 'ARP')
    endif
    if FBN['NrSaldo']=132
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'MEP')
    endif
    if FBN['NrSaldo']=133
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'Cable')
    endif
    ACT(l:FAC, FBN['MercMov'])

    SetFont(a:FAC..z:FAC,1)

    FormatoCeldas(g:fac..g:fac,Exe('F2'))
    FormatoCeldas(i:fac..i:fac,"0")
  proximo

  Message('Recuperando Mov. Pendientes  ...')

  SQL.ADD("SELECT O.TipoOp, ")
  SQL.ADD("M.Cliente, M.FechaMov, M.FechaEje, M.Especie esp, M.Leyenda, ")
  SQL.ADD("M.NrSaldo, M.Cuenta, M.Transaccion, M.NrComprob, 'Pendiente' est, ")
  SQL.ADD("M.Cantidad can, ")
  SQL.ADD("NrTrans2, M.NrMov, M.Mercado MercMov ")  
  SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".MOVPENDIENTES M ")
  SQL.ADD("where O.NrOperacion = M.NrOperacion ")
  SQL.ADD("and O.NrOperacion = '"~fbn['NrOperacion']~"' ")
  SQL.ADD("and M.NrSaldo > 130 and M.NrSaldo < 140 ")
  SQL.ADD("order by O.TipoOp, O.NrOperacion, NrMov, est  ")

  Recorrer SQL
    SCN(y:1, 1)
    ACT(b:FAC, FBN['est'])
    ACD(c:FAC, FBN['FechaEje'])
    ACD(d:FAC, FBN['FechaMov'])
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

    if Vacio(Val(e:FAC))
      ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
    endif

    ACT(f:FAC, FBN['Esp'])
    ACN(g:FAC, FBN['Can'])
    ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
    ACN(i:FAC, FBN['NrSaldo'])
    if FBN['NrSaldo']=131
      ACT(j:FAC, 'ARP')
    endif
    if FBN['NrSaldo']=132
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'MEP')
    endif
    if FBN['NrSaldo']=133
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'Cable')
    endif
    ACT(l:FAC, FBN['MercMov'])

    SetFont(a:FAC..z:FAC,1)

    ColorCeldas(a:FAC..l:FAC,clGREEN)

    FormatoCeldas(g:fac..g:fac,Exe('F2'))
    FormatoCeldas(i:fac..i:fac,"0")
  proximo
  if Val(y:1)=0
    IFA
    ACT(b:FAC, 'No hay apliacion de Parking')
    SetFont(b:FAC,2)
  endif
Proximo

*********************************
** DRT
*********************************
ACT(X1, "FechaOp Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")

SQL.ADD("SELECT *  ")  
SQL.ADD("from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD("where Fecha1 Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and TipoTr2 in ('DRT') ")
SQL.ADD("  and ParkAfecta = 'SI' ")
SQL.ADD("order by T.NrTrans ")

Recorrer SQL
  Message('Recuperando Datos Tramsaccion ...')

  IF Not EqStr(FBN['NrTrans'],Val(z1))
    ifa
    ACT(z1, FBN['NrTrans'])
    ACT(a:FAC, FBN['TipoTr2'])
    ACT(b:FAC, FBN['NrTrans'])
    ACLT(b:FAC, fbn('NrTrans'))
    ACD(c:FAC, FBN['Fecha1'])
    ACT(d:FAC, fbn('Vehiculo1'))
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']),1,30))
    ACT(f:FAC, FBN['Especie'])
    ACN(g:FAC, FBN['Cantidad1'])
    ACT(i:FAC, FBN['ParkAfecta'])
    ACT(k:FAC, FBN['Mercado2'])
    ACT(l:FAC, FBN['Mercado1'])
    SetFont(a:FAC..y:FAC,2)
  endif
  ACN(y:1, 0)
  Message('Recuperando Mov. Ejecutados  ...')

  SQL.ADD("SELECT T.TipoTr2, ")
  SQL.ADD("M.Cliente, M.FechaMov, M.FechaEje, M.Especie esp, M.Leyenda, ")
  SQL.ADD("M.NrSaldo, M.Cuenta, M.Transaccion, M.NrComprob, 'EJEC' est, ")
  SQL.ADD("M.Cantidad can, ")
  SQL.ADD("M.NrMov, M.Mercado MercMov ")  
  SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVEJECUTADOS M ")
  SQL.ADD("where T.NrTrans = M.NrOperacion ")
  SQL.ADD("and T.NrTrans = '"~fbn['NrTrans']~"' ")
  SQL.ADD("and M.NrSaldo > 130 and M.NrSaldo < 140 ")
  SQL.ADD("order by T.TipoTr2, T.NrTrans, NrMov, est ")
  
  Recorrer SQL
    SCN(y:1, 1)
    ACT(b:FAC, FBN['est'])
    ACD(c:FAC, FBN['FechaEje'])
    ACD(d:FAC, FBN['FechaMov'])
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

    if Vacio(Val(e:FAC))
      ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
    endif

    ACT(f:FAC, FBN['Esp'])
    ACN(g:FAC, FBN['Can'])
    ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
    ACN(i:FAC, FBN['NrSaldo'])
    if FBN['NrSaldo']=131
      ACT(j:FAC, 'ARP')
    endif
    if FBN['NrSaldo']=132
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'MEP')
    endif
    if FBN['NrSaldo']=133
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'Cable')
    endif
    ACT(l:FAC, FBN['MercMov'])

    SetFont(a:FAC..z:FAC,1)

    FormatoCeldas(g:fac..g:fac,Exe('F2'))
    FormatoCeldas(i:fac..i:fac,"0")
  proximo

  Message('Recuperando Mov. Pendientes  ...')

  SQL.ADD("SELECT T.TipoTr2, ")
  SQL.ADD("M.Cliente, M.FechaMov, M.FechaEje, M.Especie esp, M.Leyenda, ")
  SQL.ADD("M.NrSaldo, M.Cuenta, M.Transaccion, M.NrComprob, 'Pendiente' est, ")
  SQL.ADD("M.Cantidad can, ")
  SQL.ADD("M.NrMov, M.Mercado MercMov ")  
  SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPENDIENTES M ")
  SQL.ADD("where T.NrTrans = M.NrOperacion ")
  SQL.ADD("and T.NrTrans = '"~fbn['NrTrans']~"' ")
  SQL.ADD("and M.NrSaldo > 130 and M.NrSaldo < 140 ")
  SQL.ADD("order by T.TipoTr2, T.NrTrans, NrMov, est  ")

  Recorrer SQL
    SCN(y:1, 1)
    ACT(b:FAC, FBN['est'])
    ACD(c:FAC, FBN['FechaEje'])
    ACD(d:FAC, FBN['FechaMov'])
    ACT(e:FAC, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente']),1,30))

    if Vacio(Val(e:FAC))
      ACT(e:FAC, Copy(BuscarCampo('VEHICULOS','Descripcion','Codigo',FBN['Cliente']),1,30))
    endif

    ACT(f:FAC, FBN['Esp'])
    ACN(g:FAC, FBN['Can'])
    ACT(h:FAC, Copy(FBN['Leyenda'],1,17))
    ACN(i:FAC, FBN['NrSaldo'])
    if FBN['NrSaldo']=131
      ACT(j:FAC, 'ARP')
    endif
    if FBN['NrSaldo']=132
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'MEP')
    endif
    if FBN['NrSaldo']=133
      ACT(j:FAC, 'USD')
      ACT(k:FAC, 'Cable')
    endif
    ACT(l:FAC, FBN['MercMov'])

    SetFont(a:FAC..z:FAC,1)

    ColorCeldas(a:FAC..l:FAC,clGREEN)

    FormatoCeldas(g:fac..g:fac,Exe('F2'))
    FormatoCeldas(i:fac..i:fac,"0")
  proximo
  if Val(y:1)=0
    IFA
    ACT(b:FAC, 'No hay apliacion de Parking')
    SetFont(b:FAC,2)
  endif
Proximo

ACO(1,5)
ACO(2,6)
ACO(3,7)
ACO(4,7)
ACO(5,20)
ACO(6,10)
ACO(7,9)
ACO(8,12)
ACO(9,7)
ACO(10,6)
ACO(11,6)
ACO(12,6)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)

LimitesVision(l:FAC)
RangoTitulo(a:1..l:FAC, Val(w1)+6)
SetPrintFit(3,77)
