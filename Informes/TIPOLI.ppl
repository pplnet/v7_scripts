CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Tipos de Limites')
ACT(a:FAC+2,'Codigo')
ACT(b:FAC+2,'Descripcion')
ACT(c:FAC+2,'Tipo')
AgregarMarco(a:FAC+2..d:FAC+2,2,0,Exe('COLOR'))
SetFont(a:FAC..c:FAC+2,2)

SetFilaActual(FAC+2)

SQL.ADD("Select * From "~DBO~".TIPOSLIMITE")
recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN['Codigo'])
  ACT(b:FAC, FBN['Descripcion'])
  if FBN['Clase']=0
    ACT(c:FAC, 'Limite de Credito')
  endif
  if FBN['Clase']=1
    ACT(c:FAC, 'Limite de Posicion')
  endif
  if FBN['Clase']=2
    ACT(c:FAC, 'Otro')
  endif
proximo

AgregarMarco(a:Val(w1)+3..d:FAC+1,1)
SetFont(a:Val(w1)+3..c:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(2,25)
ACO(3,12)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC, 2)
AgregarBMP(a1,Exe('LOGO'),60)
LimitesVision(c:FAC)
RangoTitulo(a:1..c:FAC,Val(w1)+2)
