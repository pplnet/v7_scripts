CrearDialogo
  Fecha1   : 'Fecha'  ;;;;;;;;;FSys
  Vehiculo1: 'Vehiculo' ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');;
  Mercado1 : 'Casa Cust.'  ;;;;;;NoVacio(Dialogo.MERCADO1);'Debe ingresar un Mercado';NO;;;
  Cantidad1: 'Nro Columna'                          ;4;1;;;;Dialogo.Cantidad1<>0;'Debe ingresar una columna';NO;
  Especie1 : 'Especie'                              ;5;1;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;
  Radio2   : 'Expresado|Mon.Local|Mon.Extranjera|'  ;6;1;;;;;;;0
  String1  : 'Cupon '   ;;;;NO;NO;;;;;;;;;;;
  Cuenta1  : 'Cuenta'   ;;;;;;;;;;;
FinDialogo

If Not OK
   Cancelar
Endif

*MessageBox(IdxDate(Dialogo.Fecha1)~' '~Dialogo.Vehiculo1~' '~Dialogo.Mercado1~' '~FStr(Dialogo.Cantidad1,0,0)~' '~Dialogo.Especie1~' '~Dialogo.Radio2)

If Dialogo.Radio2 = 0
   ACT(mn1, VAR('MONELOCA'))
Else
   ACT(mn1, VAR('MONEEXTR'))
EndIf

*- Datos de la Especie
SQL.ADD("SELECT * FROM "~DBO~".ESPECIES ")
IF NoVacio(Dialogo.Especie1)
   SQL.ADD("WHERE Codigo='"~Dialogo.Especie1~"' ")
ENDIF

ACD(yu:1 , Dialogo.Fecha1)

Recorrer SQL
   dfa
   ACN(yt1, 1)
   ACT(yv:1 , FBN['Codigo'])
   ACD(yx:1 , FBN['FechaCambioTasa'])
   ACN(yy:1 , FBN['TasaIntAnterior'])
   ACN(yz:1 , FBN['TasaIntVigente'])
   ACN(vr2,FBN['Alias5'])
   ACN(vr1, IIf(EqStr(FBN['InteresesC'],'CLE'),VALORTEORICO2(FBN['Codigo'],Dialogo.Fecha1),1) )
   ACN(cc1, CotizacionC(FBN['Codigo'],,,,Dialogo.Fecha1,1,SI,Val(mn1)) ) 
Proximo

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

ACT(d2, 'Detalle de Tenencia de Cartera Propia')
IF Dialogo.Cantidad1 = 3
   ACT(a4, 'Compras a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,0,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 4
   ACT(a4, 'Ventas a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,0,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 6
   ACT(a4, 'Compras a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,1,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 7
   ACT(a4, 'Ventas a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,1,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 9
   ACT(a4, 'Compras a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,2,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 10
   ACT(a4, 'Ventas a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,2,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 12
   ACT(a4, 'Compras a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,3,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 13
   ACT(a4, 'Ventas a Liquidar ')
   ACD(c4, HABILES(Dialogo.Fecha1,3,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 15
   ACT(a4, 'Compras a Liquidar > ')
   ACD(c4, HABILES(Dialogo.Fecha1,3,'ARG'))
ENDIF
IF Dialogo.Cantidad1 = 16
   ACT(a4, 'Ventas a Liquidar > ')
   ACD(c4, HABILES(Dialogo.Fecha1,3,'ARG'))
ENDIF

ACT(a5, 'Fecha: '~Dialogo.Fecha1)

SetFont(d2, 3)
SetFont(a1..a5, 1)
SetFont(c4, 1)

ACT(a6, 'NrOperacion')
ACT(b6, 'Tipo Op.')
ACT(c6, 'Fecha Op.')
ACT(d6, 'Fecha Vto.')
ACT(e6, 'Cantidad')
ACT(f6, 'Monto')
ACT(g6, 'Interes')
ACT(h6, 'Neto')
***ACT(i6, 'Valuacion')

SetFont(a6..i6, 1)
AgregarMarco(a6..i6,1,0,Exe("COLOR6"))

SetFilaActual(6)

* Todas las compras y ventas
If Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 4 o Dialogo.Cantidad1 = 7 o Dialogo.Cantidad1 = 10 o Dialogo.Cantidad1 = 13 o Dialogo.Cantidad1 = 16
   SQL.ADD("SELECT T.NrTrans NrOperacion, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, T.Cambio1 TotalNetoCli1, ")
   SQL.ADD("       0 TotalBrutoCli1, 0 TotalDerechos, 0 TotalIntereses, T.Fecha1 FechaOp, CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, E.Cotiza ContraEspecie, M.Cupon ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPENDIENTES M ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   SQL.ADD("      E.Codigo = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      T.Mercado1 = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      M.Cupon = "~Dialogo.String1~" AND ") 
   If NoVacio(Dialogo.Cuenta1)
      SQL.ADD("      M.Cuenta = '"~Dialogo.Cuenta1~"' AND ")
   EndIf
   SQL.ADD("      T.RB4 >= 0 AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 4
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END <= '"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 7
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 10
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 13
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 16
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END > '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   SQL.ADD("      T.Cliente1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
   SQL.ADD("      M.Especie = E.Codigo AND ")
   SQL.ADD("      M.NrSaldo = 101 AND ")
   SQL.ADD("      M.Cliente = T.Cliente1 AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 15
      SQL.ADD("      T.TipoTr2 IN ('DTP') ")
   ELSE
      SQL.ADD("      T.TipoTr2 IN ('RTP') ")
   ENDIF
   SQL.ADD("    AND ((T.CB6 IS NULL OR CB6='0') OR T.NrOperacionRef1 NOT in (SELECT MM.NrTrans2 FROM "~DBO~".MOVEJECUTADOS MM, "~DBO~".OPERACIONES O WHERE MM.NrOperacion=O.NrOperacion AND MM.NrTrans2=T.NrOperacionRef1 ) ) ")

   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.NrTrans NrOperacion, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad, T.Cambio1 TotalNetoCli1, ")
   SQL.ADD("       0 TotalBrutoCli1, 0 TotalDerechos, 0 TotalIntereses, T.Fecha1 FechaOp, CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, E.Cotiza ContraEspecie, M.Cupon ")
   SQL.ADD("FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPENDIENTES M ")
   SQL.ADD("WHERE T.NrTrans=B.NrOperacion AND ")
   SQL.ADD("      B.Valor=0 AND B.NrBit In ('30') AND ")
   SQL.ADD("      E.Codigo = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      T.Mercado1 = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      M.Cupon = "~Dialogo.String1~" AND ") 
   If NoVacio(Dialogo.Cuenta1)
      SQL.ADD("      M.Cuenta = '"~Dialogo.Cuenta1~"' AND ")
   EndIf
   SQL.ADD("      T.RB4 >= 0 AND ") 
   SQL.ADD("      T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 4
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END <= '"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 7
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 10
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 13
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 16
      SQL.ADD("      CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END > '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   SQL.ADD("      T.Cliente2 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      M.NrOperacion = T.NrTrans AND ")
   SQL.ADD("      M.Especie = E.Codigo AND ")
   SQL.ADD("      M.NrSaldo = 101 AND ")
   SQL.ADD("      M.Cliente = T.Cliente2 AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 15
      SQL.ADD("      T.TipoTr2 IN ('RTP') ")
   ELSE
      SQL.ADD("      T.TipoTr2 IN ('DTP') ")
   ENDIF
   SQL.ADD("    AND ((T.CB6 IS NULL OR CB6='0') OR T.NrOperacionRef1 NOT in (SELECT MM.NrTrans2 FROM "~DBO~".MOVEJECUTADOS MM, "~DBO~".OPERACIONES O WHERE MM.NrOperacion=O.NrOperacion AND MM.NrTrans2=T.NrOperacionRef1 ) ) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.Cantidad, O.TotalNetoCli1+O.TotalAux3+O.TotalIVA TotalNetoCli1, ")
   SQL.ADD("       O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses, O.FechaOp, O.FechaVto, O.ContraEspecie, O.Cupon1 Cupon ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      E.Codigo = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      O.Especie = E.Codigo AND ")
   SQL.ADD("      O.Mercado = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      O.Cartera >= 0 AND ") 
*   SQL.ADD("      O.Cupon1 = "~Dialogo.String1~" AND ") 
   SQL.ADD("      E.Cupon = "~Dialogo.String1~" AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   If NoVacio(Dialogo.Cuenta1)
      SQL.ADD("      O.Cuenta1 = '"~Dialogo.Cuenta1~"' AND ")
   EndIf
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 4
      SQL.ADD("      O.FechaVto <= '"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 7
      SQL.ADD("      O.FechaVto = '"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 10
      SQL.ADD("      O.FechaVto = '"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 13
      SQL.ADD("      O.FechaVto = '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 16
      SQL.ADD("      O.FechaVto > '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   SQL.ADD("      O.NrOperacion IN (SELECT DISTINCT M.NrOperacion ")
   SQL.ADD("                        FROM "~DBO~".MOVPENDIENTES M ")
   SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion AND ")
   SQL.ADD("                              M.Especie = O.Especie AND ")
   SQL.ADD("                              M.Cliente = O.Cliente1 ")
   SQL.ADD("                        UNION ")
   SQL.ADD("                        SELECT DISTINCT M.NrOperacion ")
   SQL.ADD("                        FROM "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion AND ")
   SQL.ADD("                              M.Especie = O.Especie AND ")
   SQL.ADD("                              M.Cliente = O.Cliente1 AND ")
   SQL.ADD("                              NOT EXISTS ")
   SQL.ADD("                              (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 WHERE T.NrTrans=M.NrTrans2 and T1.NrTrans=T.NrOperacionRef2 AND T1.RB2=1) ")
   SQL.ADD("                              ) AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 15
      SQL.ADD("      O.TipoOp IN ('CTC','CTP') AND ")
   ELSE
      SQL.ADD("      O.TipoOp IN ('VTC','VTP') AND ")
   ENDIF
   SQL.ADD("      (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.Cantidad, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses, ")
   SQL.ADD("       O.FechaOp, O.FechaVto, O.ContraEspecie, O.Cupon1 Cupon ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      E.Codigo = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      O.Especie = E.Codigo AND ")
   SQL.ADD("      O.Mercado = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      O.Cartera >= 0 AND ") 
*   SQL.ADD("      O.Cupon1 = "~Dialogo.String1~" AND ") 
   SQL.ADD("      E.Cupon  = "~Dialogo.String1~" AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   If NoVacio(Dialogo.Cuenta1)
      SQL.ADD("      O.Cuenta1 = '"~Dialogo.Cuenta1~"' AND ")
   EndIf
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 4
      SQL.ADD("      O.FechaVto <= '"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 7
      SQL.ADD("      O.FechaVto = '"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 10
      SQL.ADD("      O.FechaVto = '"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 13
      SQL.ADD("      O.FechaVto = '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   IF Dialogo.Cantidad1 = 15 o Dialogo.Cantidad1 = 16
      SQL.ADD("      O.FechaVto > '"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND ")
   ENDIF
   SQL.ADD("      O.NrOperacion IN (SELECT DISTINCT M.NrOperacion ")
   SQL.ADD("                        FROM "~DBO~".MOVPENDIENTES M ")
   SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion AND ")
   SQL.ADD("                              M.Especie = O.Especie ")
   SQL.ADD("                        UNION ")
   SQL.ADD("                        SELECT DISTINCT M.NrOperacion ")
   SQL.ADD("                        FROM "~DBO~".MOVEJECUTADOS M ")
   SQL.ADD("                        WHERE M.NrOperacion = O.NrOperacion AND ")
   SQL.ADD("                              M.Especie = O.Especie AND ")
   *SQL.ADD("                              NOT EXISTS ")
   *SQL.ADD("                              (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 WHERE T.NrTrans=M.NrTrans2 and T1.NrTrans=T.NrOperacionRef2 AND T1.RB2=1) ")
   * Cambia el criterio para usar el mismo del reporte principal
   SQL.ADD("                                EXISTS (SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1,"~DBO~".MOVPENDIENTES MP1 ")
   SQL.ADD("                                      WHERE T.NrTrans  = M.NrTrans2        ")
   SQL.ADD("                                      AND   T1.NrTrans = T.NrOperacionRef2 ")
   SQL.ADD("                                      AND   T1.NrTrans = MP1.NrOperacion   ")
   SQL.ADD("                                      AND   O.Especie  = MP1.Especie       ")
   SQL.ADD("                                      AND   MP1.NrSaldo = 101)             ")

   
   SQL.ADD("                              ) AND ")
   IF Dialogo.Cantidad1 = 3 o Dialogo.Cantidad1 = 6 o Dialogo.Cantidad1 = 9 o Dialogo.Cantidad1 = 12 o Dialogo.Cantidad1 = 15
*** FJL 08-06-18 - Se incorporan TCOPRi de Cartera Propia
*      SQL.ADD("      O.TipoOp IN ('TIC','TIFC') ")
      SQL.ADD("      (O.TipoOp IN ('TIC','TIFC') or (O.TipoOp IN ('TCOPRI') and O.Corporate=1)) ")
   ELSE
      SQL.ADD("      O.TipoOp IN ('TIV','TIFV','TIBCRA') ")
   ENDIF
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.NrOperacion, O.TipoOp, O.Cantidad, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses, ")
   SQL.ADD("       O.FechaOp, O.FechaVto, O.ContraEspecie, O.Cupon1 Cupon ")
   SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("      B.Valor=0 and B.NrBit In ('30') and ")
   SQL.ADD("      O.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("      O.Mercado = '"~Dialogo.Mercado1~"' AND ")
   SQL.ADD("      O.Cupon1 = "~Dialogo.String1~" AND ") 
   SQL.ADD("      O.Cartera >= 0 AND ") 
   SQL.ADD("      O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("      O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   If NoVacio(Dialogo.Cuenta1)
      SQL.ADD("      O.Cuenta1 = '"~Dialogo.Cuenta1~"' AND ")
   EndIf
   IF Dialogo.Cantidad1=3 
      SQL.ADD("      ((O.FechaOp<='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto<='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=6 
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF   
   IF Dialogo.Cantidad1=9 
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=12
      SQL.ADD("      ((O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=15
      SQL.ADD("      ((O.FechaOp>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaVto>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF

   *---------------------------
   IF Dialogo.Cantidad1=4 
      SQL.ADD("      ((O.FechaVto<='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp<='"~IdxDate(HABILES(Dialogo.Fecha1,0,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=7
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,1,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=10
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,2,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=13
      SQL.ADD("      ((O.FechaVto='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp='"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   IF Dialogo.Cantidad1=16
      SQL.ADD("      ((O.FechaVto>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIDE','TICT')) or ")
      SQL.ADD("      (O.FechaOp>'"~IdxDate(HABILES(Dialogo.Fecha1,3,'ARG'))~"' AND O.TipoOp IN ('TIPO','TICO'))) ")
   ENDIF
   SQL.ADD(" and O.TipoOp IN ('TIDE','TIPO','TICO','TICT')  ")
ENDIF

Recorrer SQL

   ACT(cv1,'')
   ACN(mc1,0)
   ACN(mv1,0)

   IF Incluido(FBN['TipoOp'], 'TIDE|TICT|TIPO|TICO') 
      *- Chequeo Por Concertacion cv1: marca de concertacion o Vto
      ACT(cv1,'V')
      IF [Dialogo.Cantidad1=3 y FBN['FechaOp']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT') ] 
         ACT(cv1,'C')
      EndIf
      If [Dialogo.Cantidad1=6 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
         ACT(cv1,'C')
      ENDIF   
      IF [Dialogo.Cantidad1=9 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=12 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
          ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=15 y FBN['FechaOp']>HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIDE|TICT')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=4 y FBN['FechaOp']<=HABILES(Dialogo.Fecha1,0,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=7 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,1,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=10 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,2,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=13 y FBN['FechaOp']=HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
      IF [Dialogo.Cantidad1=16 y FBN['FechaOp']>HABILES(Dialogo.Fecha1,3,'ARG') y Incluido(FBN['TipoOp'],'TIPO|TICO')]
         ACT(cv1,'C')
      ENDIF
   
      If EqStr(val(cv1),'C')
         Message('*- Chequeo si tiene algun movimiento ejecutado a la concertacion '~FBN['NrOperacion'])
         SQL.ADD("SELECT DISTINCT M.NrOperacion ")
         SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M ")
         SQL.ADD("WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND ")
         SQL.ADD("M.Especie='"~Dialogo.Especie1~"' AND M.FechaMov='"~IdxDate(FBN['FechaOp'])~"' AND EXISTS ")
         SQL.ADD("(SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 ")
         SQL.ADD(" WHERE T.NrTrans=M.NrTrans2 and T1.NrTrans=T.NrOperacionRef2 AND T1.RB2=1) ")
         Recorrer SQL
            dfa
            ACN(mc1,1)
         Proximo  
      EndIf

      If EqStr(val(cv1),'V')
         Message('*- Chequeo si tiene algun movimiento ejecutado  al vto '~FBN['NrOperacion'])
         SQL.ADD("SELECT DISTINCT M.NrOperacion ")
         SQL.ADD("FROM "~DBO~".MOVEJECUTADOS M ")
         SQL.ADD("WHERE M.NrOperacion = '"~FBN['NrOperacion']~"' AND ")
         SQL.ADD("M.Especie='"~Dialogo.Especie1~"' AND M.FechaMov='"~IdxDate(FBN['FechaVto'])~"' AND EXISTS ")
         SQL.ADD("(SELECT 1 FROM "~DBO~".TRANSACCIONES2 T,"~DBO~".TRANSACCIONES2 T1 ")
         SQL.ADD(" WHERE T.NrTrans=M.NrTrans2 and T1.NrTrans=T.NrOperacionRef2 AND T1.RB2=1)  ")
         Recorrer SQL
            dfa
            ACN(mv1,1)
         Proximo      
      EndIf

      Message(FBN['NrOperacion']~' mc1 '~val(mc1)~' mv1 '~val(mv1))

      If [EqStr(val(cv1),'V') y val(mv1)=0] o [EqStr(val(cv1),'C') y val(mc1)=0]
         * Indice para pasar un monto de una moneda a otra
         ACN(in1, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(mn1)))

         ACT(a:fac, fbn('NrOperacion'))
         ACLO(a:fac, fbn('NrOperacion'))
  
         ACT(b:fac, fbn('TipoOp'))
         ACD(c:fac, fbn('FechaOp'))
         ACD(d:fac, fbn('FechaVto'))   
         ACN(e:fac, fbn('Cantidad'))
         ACN(f:fac, fbn('TotalBrutoCli1'))
         If Incluido(fbn('TipoOp'), 'TIC|TCOPRI|TIV|CTP|VTP|TIBCRA|TIFC|TIFV')
            ACN(g:fac, fbn('TotalIntereses'))
         Else
            ACN(g:fac, fbn('TotalDerechos'))
         Endif
         ACN(h:fac, fbn('TotalNetoCli1'))

         SetFont(a:fac.. i:fac, 2)
         FormatoCeldas(e:fac..i:fac, Exe('F2'))
      Else 
         dfa
      EndIf
  Else 
     * Indice para pasar un monto de una moneda a otra
     ACN(in1, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(mn1)))

     If Incluido(fbn('TipoOp'), 'DTP|RTP')
        ACT(a:fac, fbn('NrOperacion'))
        ACLT(a:fac, fbn('NrOperacion')) 
     Else
        ACT(a:fac, fbn('NrOperacion'))
        ACLO(a:fac, fbn('NrOperacion'))
     Endif
     ACT(b:fac, fbn('TipoOp'))
     ACD(c:fac, fbn('FechaOp'))
     ACD(d:fac, fbn('FechaVto'))   
     ACN(e:fac, fbn('Cantidad'))
     ACN(f:fac, fbn('TotalBrutoCli1'))
     If Incluido(fbn('TipoOp'), 'TIC|TCOPRI|TIV|CTP|VTP|TIBCRA|TIFC|TIFV')
        ACN(g:fac, fbn('TotalIntereses'))
     Else
        ACN(g:fac, fbn('TotalDerechos'))
     Endif
     ACN(h:fac, fbn('TotalNetoCli1'))

     SetFont(a:fac.. i:fac, 2)
     FormatoCeldas(e:fac..i:fac, Exe('F2'))
  EndIf
Proximo

ifa
ifa

*- Sumatoria de la Valuacion y de la Cantidad
act(a:fac, 'Total ... ')
acn(e:fac, Sum(e:5..e:fac-1) )
***acn(i:fac, Sum(i:5..i:fac-1) )
SetFont(a:fac..h:fac, 1)
FormatoCeldas(e:fac..h:fac, Exe('F2'))
ifa

ACT(a:fac,'FIN DE LISTADO')
SetFont(a:fac, 1)

ACO(1, 7)
ACO(2, 6)
ACO(3, 7)
ACO(4, 7)
ACO(5, 9)
ACO(6, 9)
ACO(7, 9)
ACO(8, 9)
***ACO(9, 8)

LimitesVision(h:fac+1)
Rangotitulo(a:1..h:fac+1, 6)
