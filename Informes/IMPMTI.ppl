CrearDialogo
  NrOperacion1:'Operacion'
  Check1:      'Impresora'
FinDialogo

if Not OK
   Cancelar
endif
  
SetFilaActual(1)
SQL.ADD("Select O.*, T.Nombre TNom, C.RazonSocial, E.Extendido, E.DiasAnio EDiasAnio, E.CotizaMAE ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".TIPOSOPERACION T, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E ")
SQL.ADD(" where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" and   O.TipoOp   = T.Codigo ")
SQL.ADD(" and   O.Especie  = E.Codigo ")
SQL.ADD(" and   O.Cliente1 = C.Codigo ")
Recorrer SQL
   SQL.ADD("SELECT Contacto, Fecha, Observaciones, Usuario FROM "~DBO~".CONFIRMACIONESOP WHERE NrOperacion = '"~fbn('NrOperacion')~"' ")
   Recorrer SQL
     dfa
     ACT(cf:1, fbn('Contacto'))
     ACD(cf:2, fbn('Fecha'))
     ACT(cf:3, fbn('Observaciones'))
     ACT(cf:4, fbn('Usuario'))
   Proximo

   * Marco 
   AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
   ACT(A3, BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo', FBN['Vehiculo1']))

   SetFont(a:fac..a:fac+1,2)
   CrearFont(4, "Arial,7,")

  ACT(d:fac-1, 'Sr./es:    '~BuscarCampo('CLIENTES','RazonSocial','Codigo',FBN['Cliente1']))
  ACT(b:fac+4,'Minuta de '~fbn['TNom']) 

  ***********
  * GENERALES
  ***********

  ACT(a:fac+6, 'Fecha Operacion')
  ACD(b:fac+6, FBN['FechaOp']) 
 
  ACT(a:fac+7, 'Fecha Impresion')
  ACD(b:fac+7, FSYS)

  ACT(a:fac+8, 'Hora Operacion')
  ACT(b:fac+8, hora(fbn['FechaCarga']))

  ACT(a:fac+9, 'Operador')
  ACT(b:fac+9, BuscarCampo('USUARIOS','Nombre','Codigo',Fbn['Operador']))

  *----- 
  ACT(d:fac+6, 'Hora de Confirmacion')
  If EqStr(FBN('CB5'),'1')
     ACT(e:fac+6, hora(fbn['FechaCarga']))
  Else
     ACT(e:fac+6, hora(Val(cf:2)))
  Endif

  ACT(d:fac+7, 'Realizada por')
  If EqStr(FBN('CB5'),'1')
     ACT(e:fac+7, 'Ofertas')
  Else
     ACT(e:fac+7, BuscarCampo('USUARIOS','Nombre','Codigo',Val(cf:4)))
  Endif

  ACT(d:fac+8, 'Hora Impresion')
  ACT(e:fac+8, hora(AHORA))

  ACT(d:fac+9, 'Operador')
  ACT(e:fac+9, BuscarCampo('USUARIOS','Nombre','Codigo', USUARIOACTIVO))

*** Ojo! columna agregada
  if Not Vacio(SQL("Select Usuario from "~DBO~".INSTANCIASOP Where NrInstancia = 3 and NrOperacion = '"~Dialogo.NrOperacion1~"' ")) 
     ACT(d:fac+10, 'Autorizada por')
     ACT(e:fac+10, SQL("Select Usuario from "~DBO~".INSTANCIASOP Where NrInstancia = 3 and NrOperacion = '"~Dialogo.NrOperacion1~"' "))
  endif

  *--------------------------

*********
* Datos de la operacion
*********

  ACT(a:fac+11,'Operacion Nro. :')
  ACT(b:fac+11, Fbn['NrOperacion'])
  ACLO(b:fac+11, Fbn['NrOperacion'])
                            
  ACT(a:fac+12,'Especie : ')
  ACT(b:fac+12,FBN['Especie']~' / '~Copy(fbn['Extendido'],1,45))

  ACT(a:fac+13,'Fecha de Liquidacion : ')
  ACD(b:fac+13,FBN['FechaVto'])

  ACT(a:fac+14,'Cantidad Nominal :')
  ACN(b:fac+14, Fbn['Cantidad'])

  ACT(a:fac+15,'Precio :')
* FO 05/10/2006  ACN(b:fac+15, Fbn['Precio1'])
  IF EqStr(FBN['EsAforado'],'1')
     ACN(b:fac+15, fbn['TipoCambio2'])
  Else
     ACN(b:fac+15, fbn['Precio1'])
  Endif


  ACT(a:fac+16,'Contra Especie :')
  ACT(b:fac+16, Fbn['ContraEspecie'])

  ACT(a:fac+17,'Liquid. Contra Especie :')
  ACD(b:fac+17, Fbn['FechaVto'])

  ACT(a:fac+18,'Confirmada con :')

  If EqStr(FBN('CB5'),'1')
     ACT(b:fac+18, 'Ofertas')
  Else
     ACT(b:fac+18, Val(cf:1))
  Endif

  ACT(a:fac+19, 'Equivalente :')
* fo 05/10/2006  ACN(b:fac+19, Fbn['TotalBrutoCli1'])
  If EqStr(fbn['EsAforado'],'1')  
     ACN(b:fac+19, fbn['TotalCaucion']-IIF(EqStr(FBN['CotizaMAE'],'CLE'),fbn['TotalIntereses'],0))
  Else
     ACN(b:fac+19, fbn['TotalBrutoCli1'])
  Endif

  ACN(aa20, 0)
  if not vacio(fbn['Corredor'])
     ACT(a:fac+21+val(aa20),'Corredor :')
     ACT(b:fac+21+val(aa20), Fbn['Corredor'])

     ACT(a:fac+22+val(aa20),'Comision :')
     ACN(b:fac+22+val(aa20), Fbn['Comision'])
     * Habr¡a que darle formato de porcentaje.
                
     ACT(a:fac+23+val(aa20),'Importe :')
     ACN(b:fac+23+val(aa20), Fbn['Comision'] * Fbn['Cantidad'])
     SCN(aa20, 4)
  endif

if no
  ACT(a:fac+21+val(aa20),'Interes :')
*  ACN(b:fac+21+val(aa20), Fbn['TotalIntereses'])
  if fbn['TotalIntereses'] > 0
    ACN(b:fac+21+val(aa20), Fbn['TotalAux1'])
  endif

  ACT(a:fac+22+val(aa20),'Base de Interes :')
  if fbn['TotalIntereses'] > 0
     ACT(b:fac+22+val(aa20), Fbn['EDiasAnio'])
  endif
endif

  ACT(AA15, SQL("Select NrBoleto from "~DBO~".OPERACIONES Where OperacionRef = '"~fbn['NrOperacion']~"'"))
  if not Eqstr(trim(mirt(val(AA15))), '')
       AgregarMarco(D:fac+15..E:fac+16,2,0)
       ACT(D:fac+15, 'Boleto Asociado :')
       ACT(E:fac+15, val(AA15))
       ** dato redundante (operador)
       ACT(D:fac+16, 'Fue renovada por :')
       ACT(E:fac+16, val(b:fac+9))
  endif
  
*********
* Forma de liquidacion
*********

  ACT(a:fac+25+val(aa20), 'LIQUIDACION Instruccion Especie ')
  SQL.ADD(" Select Mercado, Nombre, Numero, Alias3 from "~DBO~".CUENTAS Where Codigo = '"~iif(incluido(fbn['TipoOp'], 'FXV|FXVT'), fbn['Cuenta3'], fbn['Cuenta1'])~"'")
  Recorrer SQL  
     ACT(a:fac+26+val(aa20), 'Forma de liquidacion: ')
     ACT(b:fac+26+val(aa20), FBN['Mercado'])

     ACT(a:fac+27+val(aa20), 'Nombre :')  
     ACT(b:fac+27+val(aa20), Copy(FBN['Nombre'],1,24))

     ACT(a:fac+28+val(aa20), 'Nro. de Cuenta :')
     ACT(b:fac+28+val(aa20), Copy(FBN['Numero'],1,20))

     ACT(a:fac+29+val(aa20), 'Cod. Swift :')
     ACT(b:fac+29+val(aa20), Copy(FBN['Alias3'],1,20))
  Proximo
  dfa

  ACT(d:fac+25+val(aa20), 'LIQUIDACION Instruccion ContraEspecie') 
  SQL.ADD(" Select Mercado, Nombre, Numero, Alias3 from "~DBO~".CUENTAS Where Codigo = '"~iif(incluido(fbn['TipoOp'], 'FXV|FXVT'), fbn['Cuenta2'], fbn['Cuenta4'])~"'")
  Recorrer SQL  
     ACT(d:fac+26+val(aa20), 'Forma de liquidacion :')
     ACT(e:fac+26+val(aa20), FBN['Mercado'])

     ACT(d:fac+27+val(aa20), 'Nombre :')  
     ACT(e:fac+27+val(aa20), Copy(FBN['Nombre'],1,24) )

     ACT(d:fac+28+val(aa20), 'Nro. de Cuenta :')
     ACT(e:fac+28+val(aa20), Copy(FBN['Numero'],1,20))

     ACT(d:fac+29+val(aa20), 'Cod. Swift :')
     ACT(e:fac+29+val(aa20), Copy(FBN['Alias3'],1,20))
  Proximo
  dfa

  ACT(a:fac+32+val(aa20), 'Observ. Back Office')
  if EqStr(FBN('CB5'),'1')
     ACT(b:fac+32+val(aa20), 'Ofertas')
  else
     ACT(b:fac+32+val(aa20), Val(cf:3))
  endif

  
  CrearFont(1, 'Arial,10,B')
  CrearFont(2, 'Arial,10,')
  CrearFont(3, 'Arial,14,B')

  SetFont(a:fac..a:fac+30+val(aa20),1)
  SetFont(b:fac..b:fac+30+val(aa20),2)
  SetFont(d:fac..d:fac+30+val(aa20),1)
  SetFont(e:fac..e:fac+30+val(aa20),2)
  SetFont(b:fac+4,3)
  
  ColorCeldas(b:fac+4,1)
  ColorCeldas(a:fac+29+val(aa20),1)
  ColorCeldas(a:fac+32+val(aa20),1)

  FormatoCeldas(b:fac+15, EXE('F9'))
  AgregarMarco(a:fac+6..f:fac+32+val(aa20),2,0)
  AgregarMarco(a:fac+11..f:fac+32+val(aa20),2,0)
  AgregarMarco(a:fac+24+val(aa20)..f:fac+32+val(aa20),2,0)
  AlinearCeldas(a:fac+6..a:fac+32+val(aa20),'I')
  AlinearCeldas(b:fac+6..b:fac+32+val(aa20),'I')
  AlinearCeldas(d:fac+6..e:fac+32+val(aa20),'I')
  AlinearCeldas(e:fac+6..f:fac+32+val(aa20),'I')
  

  ACO(1,16)
  ACO(2,12)
  ACO(3,5)
  ACO(4,15)
  ACO(5,8)
  ACO(6,9)
  
  Autofit(no)

  LimitesVision(g:fac+35)
  
  IF Dialogo.Check1=1
     ImprimirHoja
  ENDIF
Proximo
