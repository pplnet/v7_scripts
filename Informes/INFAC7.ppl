ACT(c:fac, 'Fecha Orig.')
ACT(d:fac, 'Cliente' )
ACT(e:fac, 'Fecha Falla')
ACT(f:fac, 'Transporte')
ACT(g:fac, 'Mercado')   
ACT(h:fac, 'Especie')
ACT(i:fac, 'Cant/Monto Falla')
