SQL.ADD("select T.*,C.RazonSocial ")
SQL.ADD("from "~DBO~".TRANSACCIONES2 T, "~DBO~".MOVPENDIENTES M, "~DBO~".CLIENTES C     ")
SQL.ADD("where T.Cliente1    = C.Codigo ")
SQL.ADD("  and T.NrTrans     = M.NrOperacion ")
SQL.ADD("and   T.TipoTr2     = 'TRANSP' ")
*SQL.ADD("and   T.Fecha1      = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and   M.FechaMov      <= '"~IdxDate(Dialogo.Fecha1)~"' ")
Recorrer SQL
  ACT(a:fac, FBN['NrTransRef1'])
  ACLT(a:fac, FBN['NrTransRef1'])
  ACT(b:fac, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',FBN['NrTransRef1']))
  ACD(c:fac, BuscarCampo('TRANSACCIONES2','Fecha1','NrTrans',FBN['NrTransRef1']))
  ACT(d:FAC, FBN['Cliente1']~' - '~FBN['RazonSocial'])
  ACD(e:fac, FBN['Fecha1'])
  ACT(f:fac, FBN['NrTrans'])
  ACLT(f:fac, FBN['NrTrans'])
  ACT(g:fac, FBN['Mercado1'])
  ACT(h:fac, FBN['Especie'])
  ACN(i:fac, FBN['Cantidad1'])
  ACT(j:fac, BuscarCampo('TRANSACCIONES2','NrOperacionRef1','NrTrans',FBN['NrTransRef1']))
  If Eqstr(Copy(Val(j:FAC),1,2),'VT')
    ACLT(j:fac,Val(j:FAC))
  Else
    ACLO(j:fac,Val(j:FAC))
  Endif

  FormatoCeldas(i:fac..i:fac,Exe('F2'))
Proximo

ifa
ifa
