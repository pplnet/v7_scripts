*ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1:'D.Operacion: ';;;;;;NOVACIO(Dialogo.NrOperacion1) ;'Debe ingresar una operacion valida' ;NO;;
  NrOperacion2:'H.Operacion: ';;;;;;NOVACIO(Dialogo.NrOperacion2) ;'Debe ingresar una operacion valida' ;NO;;
  Fecha1:  'D.FechaValor'     ;;;;;;NOVACIO(Dialogo.Fecha1) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha2:  'H.FechaValor'     ;;;;;;NOVACIO(Dialogo.Fecha2) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha3:  'D.FechaGeneracion';;;;;;NOVACIO(Dialogo.Fecha3) ;'Debe ingresar una fecha valida' ;NO;;FSYS
  Fecha4:  'H.FechaGeneracion';;;;;;NOVACIO(Dialogo.Fecha4) ;'Debe ingresar una fecha valida' ;NO;;FSYS
FinDialogo

if not Ok
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

AgregarBMP(a1,Exe('LOGO'),80)
ACT(a3, 'Asientos por Operacion')
ACT(a4, 'Desde Operacion: '~Dialogo.NrOperacion1)
ACT(a5, 'Hasta Operacion: '~Dialogo.NrOperacion2)
ACT(d4, 'Desde FechaValor: '~FECHA(Dialogo.Fecha1,'dd/mm/yyyy'))
ACT(d5, 'Hasta FechaValor: '~FECHA(Dialogo.Fecha2,'dd/mm/yyyy'))
ACT(g4, 'Desde FechaGeneracion: '~FECHA(Dialogo.Fecha3,'dd/mm/yyyy'))
ACT(g5, 'Hasta FechaGeneracion: '~FECHA(Dialogo.Fecha4,'dd/mm/yyyy'))

ACT(a6, 'Operacion')
ACT(b6, 'Modelo')
ACT(c6, 'NrAsiento')
ACT(d6, 'FechaValor')
ACT(e6, 'FechaGen.')
ACT(f6, 'Credito')
ACT(g6, 'Debito')
ACT(h6, 'Cliente')
ACT(i6, 'FechaOp')

AgregarMarco(a6..i6,1,0,Exe('COLOR'))

SetFont(a1..k6, 1)
SetFilaActual(6)

SQL.ADD(" SELECT A.*, O.Cliente1, O.TipoOp, O.FechaOp, C.FechaValor, C.FechaGeneracion, C.Modelo ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON1 A, "~DBO~".ASIENTOSCON C,       ")
SQL.ADD(" "~DBO~".OPERACIONES O                                     ")
SQL.ADD(" WHERE A.NrOperacion     >= '"~Dialogo.NrOperacion1~     "'")
SQL.ADD(" AND   A.NrOperacion     <= '"~Dialogo.NrOperacion2~     "'")
SQL.ADD(" AND   A.NrOperacion      = O.NrOperacion                  ")
SQL.ADD(" AND   A.NrUnicoAsiento   = C.NrUnicoAsiento               ")
SQL.ADD(" AND   C.FechaValor      >= '"~IdxDate(Dialogo.Fecha1)~  "'")
SQL.ADD(" AND   C.FechaValor      <= '"~IdxDate(Dialogo.Fecha2)~  "'")
SQL.ADD(" AND   C.FechaGeneracion >= '"~IdxDate(Dialogo.Fecha3)~  "'")
SQL.ADD(" AND   C.FechaGeneracion <= '"~IdxDate(Dialogo.Fecha4)~  "'")
SQL.ADD(" ORDER BY  O.NrOperacion, A.Especie1,  A.NrUnicoAsiento,  A.DebitoCredito")

ACN(pr1,0)

Recorrer SQL
  IF NOT EqStr(fbn('NrOperacion'), Val(oa1)) o NOT EqStr(fbn('Especie1'), Val(ea1))
     message(fbn('NrOperacion'))
     IF Val(pr1)=1
        ACT(a:fac, 'Totales ... ')
        ACN(f:fac, SUM(f:Val(fa1)..f:fac))
        ACN(g:fac, SUM(g:Val(fa1)..g:fac))
        SetFont(a:val(fa1)..k:fac-1, 2)
        SetFont(a:fac..k:fac, 1)
        ifa
     ELSE
       ACN(pr1,1)      
     ENDIF
     ACT(a:fac, fbn('NrOperacion'))
     ACLO(a:fac, fbn('NrOperacion'))
     ACT(b:fac, fbn('TipoOp'))
     ACT(b:fac, Val(b:fac)~' -  '~fbn('Especie1'))
     ACT(oa1, fbn('NrOperacion'))
     ACT(ea1, fbn('Especie1'))
     SetFont(a:fac..k:fac, 1)
     AgregarMarco(a:fac..i:fac,1,0)
     ifa
     ACN(fa1, fac)
  ENDIF
  ACT(b:fac, fbn('Modelo'))
  ACN(c:fac, fbn('NrUnicoAsiento'))
  ACD(d:fac, fbn('FechaValor'))
  ACD(e:fac, fbn('FechaGeneracion'))
  IF EqStr(fbn('DebitoCredito'), 'CRE')
      ACN(f:fac, fbn('Cantidad1'))
      ACN(g:fac, 0)
  ELSE
      ACN(g:fac, fbn('Cantidad1'))
      ACN(f:fac, 0)
  ENDIF
  ACT(h:fac, fbn('Cliente1'))
  ACD(i:fac, fbn('FechaOp'))

Proximo
ifa
ACT(a:fac, 'Totales ... ')
ACN(f:fac, SUM(f:Val(fa1)..f:fac))
ACN(g:fac, SUM(g:Val(fa1)..g:fac))
SetFont(a:val(fa1)..k:fac-1, 2)
SetFont(a:fac..k:fac, 1)


FormatoCeldas(c7..c:fac,Exe('F0'))
FormatoCeldas(f7..g:fac,Exe('F2'))

ACO(7,8)
ACO(11,25)

LimitesVision(j:fac)
