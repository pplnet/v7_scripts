CrearDialogo
   Fecha1:      'Fecha'    ;;;;;;;;;FSYS
   Book1:       'Book'     ;;;;;;;;;
   Especie1:    'Especie'  ;;;;;;;;;
   Cantidad:    'Nominal'
FinDialogo

If not OK
   Cancelar
Endif

IFA
ACT(a:fac, "Fecha")
ACD(b:fac, Dialogo.Fecha1)
IFA
ACT(a:fac, "Book")
ACT(b:fac, Dialogo.Book1)
IFA
ACT(a:fac, "Nominal")
ACN(b:fac, Dialogo.Cantidad)
IFA
IFA
ACT(a:fac, "Especie")
ACT(b:fac, "Valuacion NIIF")
ACT(c:fac, "Revaluo NIIF")
ACT(d:fac, "Tipo Valuacion NIIF")
ACT(e:fac, "Cotizacion Utilizada NIIF")
ACT(f:fac, "TipoValuacion ORI")
ACT(g:fac, "CotizacionUtilizada ORI")
ACT(h:fac, "Resultado ORI")

AgregarMarco(a:fac..h:fac, 2,2, Exe('COLOR'))

IFA

let &valuacion ValuacionNIIF(Dialogo.Especie1, Dialogo.Fecha1, Dialogo.Book1, Dialogo.Cantidad)
if(Vacio(&valuacion))
    ACT(a:fac, "SIN DATOS")
else
    ACT(a:fac, Dialogo.Especie1)
    ACN(b:fac, &valuacion.get_ValuacionNIIF )
    ACN(c:fac, &valuacion.get_RevaluoNIIF )
    ACT(d:fac, &valuacion.get_TipoValuacionNIIF )
    ACN(e:fac, &valuacion.get_CotizacionUtilizadaNIIF )
    FormatoCeldas(E:FAC, EXE('F8'))
    ACT(f:fac, &valuacion.get_TipoValuacionORI )
    ACN(g:fac, &valuacion.get_CotizacionUtilizadaORI )
    FormatoCeldas(G:FAC, EXE('F8'))
    ACN(h:fac, &valuacion.get_ResultadoORI  )
endif


ACO(1, 10)
ACO(2, 12)
ACO(4, 12)
ACO(5, 12)
ACO(6, 12)
