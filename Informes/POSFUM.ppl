FormatoCeldas(l:8..l:fac,Exe('F2'))
FormatoCeldas(m:8..m:fac,Exe('F9'))
FormatoCeldas(n:8..n:fac,Exe('F2'))
FormatoCeldas(o:8..p:fac,Exe('F9'))
FormatoCeldas(q:8..X:fac,Exe('F2'))

IFA
IFA
ACT(A:Fac,'Fin del Informe')
SetFont(a:1..b:Fac,2)


