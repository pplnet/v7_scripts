SQL.ADD(" SELECT DISTINCT P.Especie, P.Cupon, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, ")
SQL.ADD(" P.PrecioIni, E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, ")
SQL.ADD(" P.PrecioFin, P.Fecha, P.Precio1, P.Precio2, FechaFut, P.Producto, P.Mercado ")
SQL.ADD(" FROM "~DBO~".POSICIONESFUT P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   E.Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
** FJL 19/12/18 - Para evitar posiciones ya vencidas que podrian hacer quedado abiertas.
SQL.ADD(" AND   P.FechaFut >= '"~IdxDate(Dialogo.Fecha1)~"' ")
** FJL 19/12/18 - Para contemplar posciones cerradas entre compras y ventas
*SQL.ADD(" AND   P.CantidadFin <> 0 ")
SQL.ADD(" AND   (P.CantidadIni <> 0 or P.Cantidad1 <> 0 or P.Cantidad2 <> 0 or P.CantidadFin <> 0) ")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND P.Cliente = '"~Dialogo.Vehiculo1~"' ")
Endif
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" AND P.Mercado = '"~Dialogo.Mercado1~"' ")
Endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Book IN ( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
* FJL 14/11/18 - Siempre es Radio2=0 ==> Concertada
IF Dialogo.Radio2 = 0
* FJL 14/11/18 - Siempre es Radio1=0 ==> ARP
  IF Dialogo.Radio1 = 0
    ***---Posicion concertada en ARP
* FJL 14/11/18 - Nuevos Numeros de Saldo
*    SQL.ADD(" AND P.NrSaldo IN (182) ")
* FJL 14/11/18 - 41 Delibery o 42 NDF
    SQL.ADD(" AND P.NrSaldo IN (41,42) ")
**************************
  ELSE
    ***---Posicion concertada en Cotiza
    SQL.ADD(" AND P.NrSaldo IN (181) ")  
  ENDIF
ELSE
    IF Dialogo.Radio1 = 0
    ***---Posicion liquidada en ARP
    SQL.ADD(" AND P.NrSaldo IN (192) ")
  ELSE
  ***---Posicion liquidada en Cotiza
  SQL.ADD(" AND P.NrSaldo IN (191) ")  
  ENDIF
ENDIF
* FJL 14/11/18 - Para que no incluya ARP
SQL.ADD(" AND P.Especie <> '"~Val(ex:1)~"' ")  
**************************
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONESFUT P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
** FJL 17/01/25 - Se agrega control de Mercado
SQL.ADD("                   AND   P1.Mercado   = P.Mercado ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaFut = P.FechaFut OR ((P1.FechaFut IS NULL OR P1.FechaFut='' OR P1.FechaFut=' ') AND (P.FechaFut IS NULL OR P.FechaFut='' OR P.FechaFut=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
** FJL 19/12/18 - Para contemplar posciones cerradas entre compras y ventas
SQL.ADD("                  AND   (P1.CantidadIni <> 0 or P1.Cantidad1 <> 0 or P1.Cantidad2 <> 0 or P1.CantidadFin <> 0) ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.Mercado, P.Especie, P.FechaFut, P.Book, P.NrSaldo, E.Tipo ")
watch(SQL.Batch)
Recorrer SQL
  If Not Eqstr(Fbn['Mercado'],Val(av:1)) Y Not Eqstr(Val(av:1),'')
    IFA
    *** Totales por Moneda
    ACT(c:Fac,'Total '~Val(av:2))
    ACN(h:Fac, Val(xx:1))
    If Val(h:Fac)>0
      ACL(h:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=0, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1='', Mercado1= val(av:1))
    EndIf
    ACN(j:Fac,Val(xx:2))
    If Val(j:Fac)<0
    ACL(j:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=1, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1='', Mercado1= val(av:1))
    EndIf
    ACN(n:Fac,Val(xx:3))
    AgregarMarco(c:fac..p:fac,0,0)
    ACN(xx:1,0)
    ACN(xx:2,0)
    ACN(xx:3,0)
    SetFilaActual(FAC+2)

    *** Totales por Mercado
    ACT(A:Fac,'Total '~Val(av:1))
    
    ACN(h:Fac,Val(yy:1))
    If Val(h:Fac)>0
    ACL(h:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=0, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1='', Mercado1= val(av:1))
    EndIf
    ACN(j:Fac,Val(yy:2))
    If Val(j:Fac)<0
    ACL(j:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=1, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1='', Mercado1= val(av:1))
    EndIf
    ACN(n:Fac,Val(yy:3))
    AgregarMarco(a:fac..p:fac,0,0)
    ACN(yy:1,0)
    ACN(yy:2,0)
    ACN(yy:3,0)
    IFA
  else
    If Not Eqstr(Fbn['Especie'],Val(av:2)) Y Not Eqstr(Val(av:2),'')
      *** Totales por Moneda
      ACT(c:Fac,'Total '~Val(av:2))
      ACN(h:Fac,Val(xx:1))
      If Val(h:Fac)>0
        ACL(h:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=0, Especie1=Fbn['Especie'], Entero1=Fbn['NrSaldo'], Book1='', Mercado1= Fbn['Mercado'])
      EndIf
      ACN(j:Fac,Val(xx:2))
      If Val(j:Fac)<0
        ACL(j:Fac, 'MOVOPF', Fecha1=0, Fecha2 =Dialogo.Fecha1, Radio1=1, Especie1=Fbn['Especie'], Entero1=Fbn['NrSaldo'], Book1='', Mercado1= Fbn['Mercado'])
      EndIf
      ACN(n:Fac,Val(xx:3))
      ACN(xx:1,0)
      ACN(xx:2,0)
      ACN(xx:3,0)
      AgregarMarco(c:fac..p:fac,0,0)
    EndIf
  endif
  
  IFA
  IF Dialogo.Radio1 = 1 Y Not Eqstr(fbn('Cotiza'), Val(EX:1))
    ***---Expresado en USD y no cotiza en USD => lo paso a USD
    ACN(CT:1,CotizacionC(fbn('Cotiza'),'CON',,,Dialogo.Fecha1,25, Val(EX:1)))
  ELSE
    ACN(CT:1, 1)
  ENDIF
   ACT(A:Fac, Fbn['Mercado'])
** FJL 13/12/18 - Se agrega Book
   ACT(b:Fac, Fbn['Book'])
   ACT(c:Fac, Fbn['Especie'])
   ACT(ab:FAC, SQL(" Select NombreExtendido From "~DBO~".PLAZOSMERCADO Where Especie='"~Fbn['Especie']~"' and FechaVto='"~IdxDate(Fbn['FechaFut'])~"' and MercadoNegociacion='"~Fbn['Mercado']~"' "))
   if EqStr(Fbn['Mercado'],'ROFEX')
     ACT(c:Fac, Val(c:FAC)~' - '~Val(ab:FAC))
   endif
   ACD(d:Fac, Fbn['FechaFut'])
   ***---ACN(e:Fac,COTIZACION(fbn('Especie'),'FUT',fbn('FechaFut'),,Habiles(Dialogo.Fecha1,-1,'ARG','SI'),1))      
   ACN(e:fac, SQL(" Select TOP 1 Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~fbn('Especie')~"' and Fecha <= '"~IdxDate(Habiles(Dialogo.Fecha1,-1,'ARG','SI'))~"' and Moneda = '"~Val(EX:1)~"' AND FechaFut = '"~IdxDate(fbn('FechaFut'))~"' AND Mercado = '"~fbn('Mercado')~"' AND CallPut = 'FUT' Order by Fecha desc ") * Val(CT:1))
   If Dialogo.Fecha1=Fbn['Fecha']
      ACN(f:Fac,Fbn['CantidadIni'])
      ACN(g:Fac,Fbn['PrecioIni'] * Val(CT:1))
      ACN(h:Fac,Fbn['Cantidad1'])
      If Val(h:Fac)>0
      ACL(h:Fac, 'MOVOPF', Fecha1=Val(d:Fac), Fecha2=Dialogo.Fecha1, Radio1=0, Especie1=Fbn['Especie'], Entero1=Fbn['NrSaldo'], Book1=Fbn['Book'], Mercado1= Fbn['Mercado'])
      EndIf
      ACN(i:Fac,Fbn['Precio1'] * Val(CT:1))
** FJL 19/12/18 - Se pone signo
      ACN(j:Fac, -Fbn['Cantidad2'])
      If Val(j:Fac)<0
        ACL(j:Fac, 'MOVOPF', Fecha1=Val(d:Fac), Fecha2=Dialogo.Fecha1, Radio1=1, Especie1=Fbn['Especie'], Entero1=Fbn['NrSaldo'], Book1=Fbn['Book'], Mercado1=Fbn['Mercado'])
      EndIf
      ACN(k:Fac,Fbn['Precio2'] * Val(CT:1))
      ACN(n:Fac,Fbn['CantidadFin'])
      ACN(o:Fac,Fbn['PrecioFin'] * Val(CT:1))
   Else
      ACN(f:Fac,Fbn['CantidadFin'])
      ACN(g:Fac,Fbn['PrecioFin'] * Val(CT:1))
      ACN(h:Fac,0)
      ACN(i:Fac,0)
      ACN(j:Fac,0)
      ACN(k:Fac,0)
      ACN(n:Fac,Fbn['CantidadFin'])
      ACN(o:Fac,Fbn['PrecioFin'] * Val(CT:1))
   EndIf   
   if Dialogo.Check3=1
     ***---Busco los Resultados
     SQL.ADD(" Select TipoResultado, Day, MTD, YTD ")
     SQL.ADD(" From "~DBO~".RESULTADOSFUT ")
     SQL.ADD(" Where Especie = '"~fbn('Especie')~"' ")
     SQL.ADD(" AND Fecha = '"~IdxDate(Dialogo.Fecha1)~"' ")   
     SQL.ADD(" AND FechaFut = '"~IdxDate(fbn('FechaFut'))~"' ")
     SQL.ADD(" AND Mercado = '"~fbn('Mercado')~"' ")
     SQL.ADD(" AND Book = '"~fbn('Book')~"' ")
     SQL.ADD(" AND TipoNegocio IN ("~Pipe2Comillas(Val(PR:1))~") ")
     SQL.ADD(" AND NrSaldo = "~Fstr(fbn('NrSaldo'), 0, 0)~" ")
     Recorrer SQL
       DFA
       IF Eqstr(fbn('TipoResultado'), 'TRADE')
         ACN(q:fac, fbn('Day') * Val(CT:1))
         ACN(r:fac, fbn('MTD') * Val(CT:1))
         ACN(s:fac, fbn('YTD') * Val(CT:1))
       ELSE
         IF Eqstr(fbn('TipoResultado'), 'REALIZ')
           ACN(t:fac, fbn('Day') * Val(CT:1))
           ACN(u:fac, fbn('MTD') * Val(CT:1))
           ACN(v:fac, fbn('YTD') * Val(CT:1))
         ELSE
           IF Eqstr(fbn('TipoResultado'), 'REVAL')
             ACN(w:fac, fbn('Day') * Val(CT:1))
             ACN(x:fac, fbn('MTD') * Val(CT:1))
             ACN(y:fac, fbn('YTD') * Val(CT:1))
           ENDIF     
         ENDIF
       ENDIF
     Proximo
   EndIf   
   
** FJL 19/12/18 - Los egresos ahora tienen signo
*   ACN(l:Fac, Val(h:Fac)-Val(j:Fac))
   ACN(l:Fac, Val(h:Fac)+Val(j:Fac))

   ***PPPNETO
   ***1-PPC*CantidadCompra
   ACN(PP:Fac, Val(h:Fac)*Val(i:Fac))
   ***2-PPV*CantidadVenta
** FJL 19/12/18 - Los egresos ahora tienen signo
*   ACN(PO:Fac, Val(j:Fac)*Val(k:Fac))
   ACN(PO:Fac, -Val(j:Fac)*Val(k:Fac))
   ***(1-2)/CantTotal
** FJL 19/12/18 - Los egresos ahora tienen signo
*   ACN(m:Fac, (Val(PP:Fac)-Val(PO:Fac))/(Val(h:Fac)-Val(j:Fac)))
   ACN(m:Fac, (Val(PP:Fac)-Val(PO:Fac))/(Val(h:Fac)+Val(j:Fac)))
   ***---ACN(P:Fac,COTIZACION(fbn('Especie'),'FUT',fbn('FechaFut'),,Habiles(Dialogo.Fecha1,0,'ARG','SI'),1)) 
   ACN(p:fac, SQL(" Select TOP 1 Precio1 From "~DBO~".COTIZACIONESFUT Where Codigo = '"~fbn('Especie')~"' and Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' and Moneda = '"~Val(EX:1)~"' AND FechaFut = '"~IdxDate(fbn('FechaFut'))~"' AND Mercado = '"~fbn('Mercado')~"' AND CallPut = 'FUT' Order by Fecha desc ") * Val(CT:1))

   **Cartera
   ACT(CA:1,Fbn['Book'])
   **Especie
   ACT(ES:1,Fbn['Especie'])
   ACT(ES:2,SQL(" Select NombreExtendido From "~DBO~".PLAZOSMERCADO Where Especie='"~Fbn['Especie']~"' and FechaVto='"~IdxDate(Fbn['FechaFut'])~"' and MercadoNegociacion='"~Fbn['Mercado']~"' "))
   **NrSaldo
   ACN(NS:1,Fbn['NrSaldo'])

   ACT(av:1, fbn('Mercado'))
   ACT(av:2, fbn('Especie'))
   
   ***Totales
   SCN(xx:1, Val(h:Fac))
   SCN(xx:2, Val(j:Fac))
   SCN(xx:3, Val(n:Fac))
   SCN(yy:1, Val(h:Fac))
   SCN(yy:2, Val(j:Fac))
   SCN(yy:3, Val(n:Fac))
   
Proximo
if Not Eqstr(Val(av:1),'')
  SetFilaActual(FAC+2)
  *** Totales por Moneda
  ACT(c:Fac,'Total '~Val(av:2))
  ACN(h:Fac,Val(xx:1))
  If Val(h:Fac)>0
    ACL(h:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=0, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1='', Mercado1= VAL(av:1))
  EndIf
  ACN(j:Fac,Val(xx:2))
  If Val(j:Fac)<0
    ACL(j:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=1, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1='', Mercado1= VAL(av:1))
  EndIf
  ACN(n:Fac,Val(xx:3))
  AgregarMarco(c:fac..p:fac,0,0)
  SetFilaActual(FAC+2)

  *** Totales por Mercado
  ACT(A:Fac,'Total '~Val(av:1))
  ACN(h:Fac,Val(yy:1))
  If Val(h:Fac)>0
    ACL(h:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=0, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1=Val(CA:1), Mercado1= VAL(av:1))
  EndIf
  ACN(j:Fac,Val(yy:2))
  If Val(j:Fac)<0
    ACL(j:Fac, 'MOVOPF', Fecha1=0, Fecha2=Dialogo.Fecha1, Radio1=1, Especie1=Val(ES:1), Entero1=Val(NS:1), Book1=Val(CA:1), Mercado1= VAL(av:1))
  EndIf
  ACN(n:Fac,Val(yy:3))
  AgregarMarco(a:fac..p:fac,0,0)
endif

FormatoCeldas(e:8..e:fac,Exe('F9'))
FormatoCeldas(f:8..f:fac,Exe('F2'))
FormatoCeldas(g:8..g:fac,Exe('F9'))
FormatoCeldas(h:8..h:fac,Exe('F2'))
