CrearDialogo
  Fecha1   : 'Fecha'          ;1;1;;;;;;;fsys  
  Mercado1 : 'Mercado'        ;2;1;;;;Vacio(Dialogo.Mercado1) o Incluido('FM',BuscarCampo('MERCADOS','TipoNegocio','Codigo',Dialogo.Mercado1));'Debe ingresar un Mercado de Futuros de Moneda';NO;;;;;;" TipoNegocio Like '%FM%' "
  Especie1 : 'Especie'        ;3;1;;;;Vacio(Dialogo.Especie1) o [DesciendeDeEspecie(Dialogo.Especie1,'MONEDA') y EsTerminal(Dialogo.Especie1, Especie)];'Debe ingresar una moneda';NO;;;;;;" Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Vehiculo1: 'Vehiculo'       ;4;1;;;;;;
  Radio2   : 'Posicion|Concertada|Liquidada' ;5;;;NO;NO;;;;0
  Radio1   : 'Expresado|ARP|USD'             ;5;;;NO;NO;;;;0
  Check3   : 'Inc.Resultados' ;7;1; ;NO;NO;;;;0
  Check2   : 'Inc.Pos.0'      ;8;1; ;NO;NO;;;;0
  Lista1   : 'Cartera'        ;0;2; ;NO;NO;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
FinDialogo
IF NOT OK
   Cancelar
Endif

