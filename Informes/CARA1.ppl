HojaVisible(SI)
CrearDialogo
   Fecha1    : 'Fecha Vigencia'                         ;1;1;;;;;;;;FSYS
   Lista1    : 'Vehiculo'                               ;;;;Dialogo.Radio1=1;;;;;;;IIf(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='')"),SQLSET("Select U.Vehiculo from "~DBO~".USRVEHICULO U,"~DBO~".VEHICULOS V where U.Codigo='"~UsuarioActivo~"' and U.Vehiculo=V.Codigo and (Status='HAB' or Status Is Null or Status='') "))
   Precio1   : 'Cot.USD/ARP'                            ;;;;;;Dialogo.Precio1>0;'La cotizacion del USD contra el peso debe ser mayor a cero';NO;0;
   Radio1    : 'Consolidado|NO|SI'                      ;;;;;;;;;0;
   Radio3    : "Expresado|ARP|USD"                      ;;;;;;;;;1
   Vehiculo1 : 'Grupo'                                  ;;;;NO;NO;;;;;;;;;"TipoVehiculo <> 'DIV'";
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1,"Comic Sans MS,9,")
CrearFont(2,"Comic Sans MS,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")

SetFilaActual(2)
ACT(g:fac,'Operaciones Financieras CONFIDENCIAL')
SetFont(g:fac,4)

ACT(ml1,VAR('MONELOCA'))
ACT(me1,VAR('MONEEXTR'))
ACT(me2,VAR('MONEEURO'))
ACT(in1,VAR('INDICEDEFA'))


*-- Encabezado Gral
ACT(a:FAC  , 'Resumen de la Posicion Financiera al '~Dialogo.Fecha1~' Expresado en '~IIf(Dialogo.Radio3=0,val(ml1),val(me1)))
ACT(a:FAC+1, IIF(Dialogo.Radio1=0,'NO ')~'Consolidado ')
SetFont(a:FAC..a:FAC+1, 2)
IFA
ACT(a:FAC, 'Vehiculos: '~IIF(Vacio(Dialogo.Lista1), 'Todos', Dialogo.Lista1))
ACT(c:FAC, 'Cotizacion: '~Dialogo.Precio1)
SetFont(a:fac..e:FAC, 2)
IFA
IFA

*- ct1: Cotizacion para mostrar el informe
ACN(ct1,1)

If Dialogo.Radio3=0
   *- Expresado en $ => Invierto la cotizacion
   ACN(ct1,Dialogo.Precio1)
EndIf

*- Nro. de Link de resumen
ACN(lr1,1)

*- Llamo al Informe de CORTO + LARGO con todos los vehiculos
LinkearHoja('OPFIAU',val(lr1),Fecha1=Dialogo.Fecha1,Lista1=Dialogo.Lista1,Radio1=Dialogo.Radio1,Precio1=Dialogo.Precio1,Radio2=2,Check1=0,Check2=0,Vehiculo1=Dialogo.Vehiculo1)

*- Inversiones
(.'MARCOCARA'.)

Recorrer&i 1,val(fm1)

   If [val(su:&i)<>0 y val(sv:&i)<>0] o [val(aa:&i)<>0 y val(ab:&i)<>0] o [val(ba:&i)<>0 y val(bb:&i)<>0] o [val(aa:&i)<>0 y val(ba:&i)<>0] 
      *- Recupera datos para la Fila
      If val(su:&i)<>0 y val(sv:&i)<>0 
         If Vacio(val(sz:&i))
            acn(b:&i,Sum(b:val(su:&i)..b:val(sv:&i)))
            acn(c:&i,Sum(c:val(su:&i)..c:val(sv:&i)))
            acn(d:&i,Sum(d:val(su:&i)..d:val(sv:&i)))
         Else 
            Recorrer&j val(su:&i),val(sv:&i)
               If Buscar(val(sz:&i),val(a:&j)) 
                  scn(b:&i,val(b:&j))
                  scn(c:&i,val(c:&j))
                  scn(d:&i,val(d:&j))
               EndIf
            Proximo
         EndIf

         AgregarMarco(a:&i..d:&i,2,0,EXE('COLOR6'))
      Else 
         If Vacio(val(ac:&i)) 

            *- Linkeo valores del INFORME RESUMEN
            If val(ca:&i)<>0 y val(cb:&i)<>0 y val(cc:&i)<>0 

               *- Rango de Filas a recuperar incluyendo el titulo desde el resumen 
               *- ra1: Fila desde ra2: Fila Hasta
               acn(ra1,LinkH(val(lr1),val(ca:&i):val(cb:&i)) )
               acn(ra2,LinkH(val(lr1),val(cc:&i):val(cd:&i)) )

               Recorrer&j val(ra1),val(ra2)
                  If Vacio(val(da:&i))
                     act(a:&i+&j-val(ra1),LinkH(val(lr1),1:&j)  )
                  Else
                     act(a:&i+&j-val(ra1),LinkH(val(lr1),val(da:&i):&j)  )
                  EndIf

                  If NoVacio(val(a:&i+&j-val(ra1)))
                     *- No hay mas datos
                     acn(b:&i+&j-val(ra1),LinkH(val(lr1),val(aa:&i):&j)*val(ct1) )     
                     acn(c:&i+&j-val(ra1),LinkH(val(lr1),val(ba:&i):&j)*val(ct1) )     
                     acn(d:&i+&j-val(ra1),val(b:&i+&j-val(ra1))+val(c:&i+&j-val(ra1)))     
                     
                     If val(b:&i+&j-val(ra1))=0
                        act(b:&i+&j-val(ra1),' ')
                     EndIf
                     If val(c:&i+&j-val(ra1))=0
                        act(c:&i+&j-val(ra1),' ')
                     EndIf
                     If val(d:&i+&j-val(ra1))=0
                        act(d:&i+&j-val(ra1),' ')
                     EndIf
                  Else 
                     Break
                  EndIf

                  SetFont(a:&i+&j-val(ra1),4)      
                  SetFont(b:&i+&j-val(ra1)..d:&i+&j-val(ra1),3)      
               Proximo
            Else 
               If val(aa:&i)<>0 y val(ab:&i)<>0
                  *- Capital
                  acn(b:&i,LinkH(val(lr1),val(aa:&i):val(ab:&i))*val(ct1) )
               EndIf
               If val(ba:&i)<>0 y val(bb:&i)<>0
                  *- Interes
                  acn(c:&i,LinkH(val(lr1),val(ba:&i):val(bb:&i))*val(ct1) )
               EndIf
            EndIf
         Else                      
            *- Linkeo Otros informes
            If Incluido(val(ac:&i),'INVFO1')   
               LinkearHoja(val(ac:&i), val(lr1)+&i,Fecha1=val(ad:&i), Lista1=val(ae:&i), Especie1=val(af:&i), Radio2=val(ag:&i),Precio1=val(ah:&i), Especie2=val(ai:&i), Radio3=val(aj:&i), Lista2=val(ak:&i) )
            EndIf
            If val(aa:&i)<>0 y val(ab:&i)<>0
               acn(b:&i,LinkH(val(lr1)+&i,val(aa:&i):val(ab:&i))*val(ct1) )
            EndIf
            If val(ba:&i)<>0 y val(bb:&i)<>0
               acn(c:&i,LinkH(val(lr1)+&i,val(ba:&i):val(bb:&i))*val(ct1) )
            EndIf
         EndIf

         acn(d:&i,val(b:&i)+val(c:&i))
      EndIf

      *- Si debe sumarizar la fila
      IF val(e:&i)=1
         SCN(b:1,val(b:&i))
         SCN(c:1,val(c:&i))
         SCN(d:1,val(d:&i))
      EndIf

      *- Si debe Dividir por la cotizacion de usd.
      IF val(z:&i)=1
         ACN(b:&i,(val(b:&i)/Dialogo.Precio1))
         ACN(c:&i,(val(c:&i)/Dialogo.Precio1))
         ACN(d:&i,(val(d:&i)/Dialogo.Precio1))
      EndIf
      SetFont(a:&i,4)      
      SetFont(b:&i..d:&i,3)      
      If val(su:&i)<>0 y val(sv:&i)<>0 
         SetFont(b:&i..d:&i,4)      
      EndIf
   EndIf
Proximo


*- Deudas
(.'MARCOCARA2'.)

Recorrer&i 1,val(fm2)

   If [val(su:&i)<>0 y val(sv:&i)<>0] o [val(aa:&i)<>0 y val(ab:&i)<>0] o [val(ba:&i)<>0 y val(bb:&i)<>0] o [val(aa:&i)<>0 y val(ba:&i)<>0] 
      *- Recupera datos para la Fila
      If val(su:&i)<>0 y val(sv:&i)<>0 
         acn(g:&i,Sum(g:val(su:&i)..g:val(sv:&i)))
         acn(h:&i,Sum(h:val(su:&i)..h:val(sv:&i)))
         acn(i:&i,Sum(i:val(su:&i)..i:val(sv:&i)))
         AgregarMarco(f:&i..i:&i,2,0,EXE('COLOR6'))
      Else 
         If Vacio(val(ac:&i)) 
            *- Linkeo valores del INFORME RESUMEN
            If val(ca:&i)<>0 y val(cb:&i)<>0 y val(cc:&i)<>0 y val(cc:&i)<>0
               *- Rango de Filas a recuperar incluyendo el titulo desde el resumen 
               *- ra1: Fila desde ra2: Fila Hasta
               acn(ra1,LinkH(val(lr1),val(ca:&i):val(cb:&i)) )
               acn(ra2,LinkH(val(lr1),val(cc:&i):val(cd:&i)) )
               Recorrer&j val(ra1),val(ra2)
                  act(f:&i+&j-val(ra1),LinkH(val(lr1),1:&j)  )
                  if NoVacio(val(f:&i+&j-val(ra1)))
                     *- No hay mas datos
                     acn(g:&i+&j-val(ra1),LinkH(val(lr1),val(aa:&i):&j)*val(ct1) )     
                     acn(h:&i+&j-val(ra1),LinkH(val(lr1),val(ba:&i):&j)*val(ct1) )     
                     acn(i:&i+&j-val(ra1),val(g:&i+&j-val(ra1))+val(h:&i+&j-val(ra1)))     

                     If val(g:&i+&j-val(ra1))=0
                        act(g:&i+&j-val(ra1),' ')
                     EndIf
                     If val(h:&i+&j-val(ra1))=0
                        act(h:&i+&j-val(ra1),' ')
                     EndIf
                     If val(i:&i+&j-val(ra1))=0
                        act(i:&i+&j-val(ra1),' ')
                     EndIf

                  Else 
                     Break
                  EndIf
                  SetFont(f:&i+&j-val(ra1),4)      
                  SetFont(g:&i+&j-val(ra1)..i:&i+&j-val(ra1),3)      
               Proximo
            Else 
               If val(aa:&i)<>0 y val(ab:&i)<>0
                  *- Capital
                  acn(g:&i,LinkH(val(lr1),val(aa:&i):val(ab:&i))*val(ct1) )
               EndIf
               If val(ba:&i)<>0 y val(bb:&i)<>0
                  *- Interes
                  acn(h:&i,LinkH(val(lr1),val(ba:&i):val(bb:&i))*val(ct1) )
               EndIf
            EndIf
         Else
            *- Linkeo Otros informes
            If Incluido(val(ac:&i),'INVFO1')   
               LinkearHoja(val(ac:&i), val(lr1)+&i,Fecha1=val(ad:&i), Lista1=val(ae:&i), Especie1=val(af:&i), Radio2=val(ag:&i),Precio1=val(ah:&i), Especie2=val(ai:&i), Radio3=val(aj:&i), Lista2=val(ak:&i) )
            EndIf
            If val(aa:&i)<>0 y val(ab:&i)<>0
               acn(g:&i,LinkH(val(lr1)+&i,val(aa:&i):val(ab:&i))*val(ct1) )
            EndIf
            If val(ba:&i)<>0 y val(bb:&i)<>0
               acn(h:&i,LinkH(val(lr1)+&i,val(ba:&i):val(bb:&i))*val(ct1) )
            EndIf
         EndIf
      EndIf   

      *- Si debe Dividir por la cotizacion de usd.
      IF val(z:&i)=1
         ACN(g:&i,(val(g:&i)/Dialogo.Precio1))
         ACN(h:&i,(val(h:&i)/Dialogo.Precio1))
         ACN(i:&i,(val(i:&i)/Dialogo.Precio1))
      EndIf

      acn(i:&i,val(g:&i)+val(h:&i))
      SetFont(f:&i,4)      
      SetFont(g:&i..i:&i,3)      
      If val(su:&i)<>0 y val(sv:&i)<>0 
         SetFont(g:&i..i:&i,4)      
      EndIf
   EndIf
Proximo

*- Calculo la Posicion Neta y la Posicion Contable
ACN(g:val(ft2),val(b:val(ft1))-val(g:val(ft1)) )
ACN(h:val(ft2),val(c:val(ft1))-val(h:val(ft1)) )
ACN(i:val(ft2),val(d:val(ft1))-val(i:val(ft1)) )
SetFont(f:val(ft2)..i:val(ft2),2)      
FormatoCeldas(f:val(ft2)..i:val(ft2),EXE('F2'))      
AgregarMarco(f:val(ft2)..i:val(ft2),2,0,EXE('COLOR6'))

*- Calculo la Posicion Contable
SCN(g:val(ft3),val(g:val(ft2))+val(g:val(ft4)))
SCN(h:val(ft3),val(h:val(ft2))+val(h:val(ft4)))
SCN(i:val(ft3),val(i:val(ft2))+val(i:val(ft4)))
SetFont(f:val(ft3)..i:val(ft3),2)      
FormatoCeldas(f:val(ft3)..i:val(ft3),EXE('F2'))      

SetFilaActual(val(ft3)-2)

*- Imprime las cotizaciones del USD, EURO E INDICE.
ACT(a:fac  ,'Cotizacion '~val(ml1)~': '~FStr(Cotizacion(val(ml1),,,, Dialogo.Fecha1, 1),0,8))
ACT(a:fac+1,'Cotizacion '~val(me2)~': '~FStr(Cotizacion(val(me2),,,, Dialogo.Fecha1, 1),0,8))
ACT(a:fac+2,'Cotizacion '~val(in1)~': '~FStr(Cotizacion(val(in1),,,, Dialogo.Fecha1, 1),0,8))
SetFont(a:fac..a:fac+2,2)      
AgregarMarco(a:fac..a:fac+2,2,0)

ACO(1,30)
ACO(2,10)
ACO(3,10)
ACO(4,10)
ACO(5,0)
ACO(6,30)
ACO(7,10)
ACO(8,10)
ACO(9,10)

BorrarCeldas(a:1..i:1)
LimitesVision(i:val(ft3)+1)
SetPrintFit(3,50)
Impresion(2,4)

*
*    Esto es lo que agrega Silvia
*
RangoTitulo(a:1..i:val(ft3)+1, 5)
