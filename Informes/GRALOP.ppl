ModoReproceso(SINDIALOGO)
CrearDialogo
  Cliente1 :'Cliente'     ;1;1;;;;;;
  Especie1 :'Especie'     ;2;1;;;;;;
  Mercado1 :'Mercado'     ;2;2;;;;;;;  
  Fecha1   :'F.Op.Desde'  ;3;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una F.Op. Desde' ;NO;FSys-30;
  Fecha2   :'F.Op.Hasta'  ;4;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una F.Op. Hasta' ;NO;FSys;
  Fecha3   :'F.Vto.Desde' ;3;2;;;;Dialogo.Fecha3<>0;'Debe Ingresar una F.Vto. Desde';NO;FSys;
  Fecha4   :'F.Vto.Hasta' ;4;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una F.Vto. Hasta';No;FSys+365;
  Lista1   :'Tipos Op.'   ;5;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION ")  
  Check1   :'Pata pase'   ;6;1;;;;;;;1;
  Lista2   :'Instancias'  ;-1;2;;;;;;;;;SQLSet("Select Nombre from "~DBO~".INSTANCIAS where Tabla = 'OPERACIONES' ")  
  Operador1:'Operador'    ;0;2;;;;;;
***---  Sucursal :'Sucursal'    ;2;2;;;;;;;SQL("Select Sucursal from "~DBO~".USRVEHICULO where Codigo = '"~USUARIOACTIVO~"' and Vehiculo = '"~Dialogo.Vehiculo1~"'");SQL("Select Sucursal from "~DBO~".USRVEHICULO where Codigo = '"~Dialogo.Operador1~"' and Vehiculo = '"~Dialogo.Vehiculo1~"'")
  Book1:      'Book'      ;1;2;;;;
  Vehiculo1:'Vehiculo'    ;1;1;;;;NoVacio(Dialogo.Vehiculo1);'Debe Ingresar el Vehiculo';NO;Var('VEHICULODE')
  Lista3   :'Tipos Neg.'  ;2;1;;;;;;;;;SQLSet("Select Descripcion from "~DBO~".TIPOSNEGOCIO");
  
   NrOperacion1: 'Operacion' ;;;;;;;;;;;;;;"SELECT NrOperacion, Especie, TipoOp, Cliente1, FechaOp FROM "~DBO~".OPERACIONES"
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

Recorrer&i 1,Elementos(Dialogo.Lista3)
  ACT(LI:1,BuscarCampo('TIPOSNEGOCIO','Codigo','Descripcion',ItemLista(Dialogo.Lista3,&i))~'|'~Val(LI:1))
Proximo

SetFilaActual(4)
ACT(f:fac,'General de Operaciones')
SetFont(f:fac,3)

SetFilaActual(fac+2)
If NoVacio(Dialogo.Cliente1)
   ACT(a:fac,'Cliente:')
   ACT(b:fac,'('~Dialogo.Cliente1~') '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:fac,'Clientes:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA

If NoVacio(Dialogo.Especie1)
   ACT(a:fac,'Especie:')
   ACT(b:fac,'('~Dialogo.Especie1~') '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
Else
   ACT(a:fac,'Especies:')
   ACT(b:fac,'Todas')
EndIf
If NoVacio(Dialogo.Mercado1)
   ACT(d:fac,'Mercado:')
   ACT(e:fac, Dialogo.Mercado1)
Else
   ACT(d:fac,'Mercados:')
   ACT(e:fac,'Todos')
EndIf
SetFont(a:fac..e:fac,2)
IFA

ACT(a:fac,'Fecha Op. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha1)~' hasta el '~Fecha(Dialogo.Fecha2))
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,'Fecha Vto. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha3)~' hasta el '~Fecha(Dialogo.Fecha4))
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,'Tipos Op.:')
SetFont(a:fac,2)
If NoVacio(Dialogo.Lista1)
   Recorrer&i 1,Elementos(Dialogo.Lista1)
     ACT(((&i-1) mod 4)+2:fac,ItemLista(Dialogo.Lista1,&i))
     SetFont(((&i-1) mod 4)+2:fac,2)
     If ((&i-1) mod 4)+2 = 5
        IFA
     EndIf
   Proximo
Else
   ACT(b:fac,'Todos')
   SetFont(b:fac,2)
EndIf
IFA

If NoVacio(Dialogo.Lista3)
   ACT(a:fac,'Tipos Neg.:')
   ACT(b:fac,Pipe2Comillas(Dialogo.Lista3))
Else
   ACT(a:fac,'Tipos Neg.:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA

If NoVacio(Dialogo.Lista3)
   ACT(a:fac,'Tipos Neg.:')
   ACT(b:fac,Pipe2Comillas(Dialogo.Lista3))
Else
   ACT(a:fac,'Tipos Neg.:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA

ACT(az:4,'')
ACT(a:fac,'Instancias:')
SetFont(a:fac,2)
If NoVacio(Dialogo.Lista2)
   Recorrer&i 1,Elementos(Dialogo.Lista2)
     ACT(((&i-1) mod 2)*2+2:fac,ItemLista(Dialogo.Lista2,&i))
     ACT(az:4,Val(az:4)~FStr(SQL("select NrInstancia from "~DBO~".INSTANCIAS where Tabla='OPERACIONES' and Nombre='"~ItemLista(Dialogo.Lista2,&i)~"' "),1,0)~'|')
     SetFont(((&i-1) mod 2)*2+2:fac,2)
     If ((&i-1) mod 2)*2+2 = 4
        IFA
     EndIf
   Proximo
Else
   ACT(b:fac,'Todas')
   SetFont(b:fac,2)
EndIf
IFA

ACT(a:fac,'Vehiculo:')
ACT(b:fac,'('~Dialogo.Vehiculo1~') '~BuscarCampo('VEHICULOS','Descripcion','Codigo',Dialogo.Vehiculo1))
SetFont(a:fac..b:fac,2)
IFA

If NoVacio(Dialogo.Operador1)
   ACT(a:fac,'Operador:')
   ACT(b:fac,'('~Dialogo.Operador1~') '~BuscarCampo('USUARIOS','Nombre','Codigo',Dialogo.Operador1))
Else
   ACT(a:fac,'Operadores:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..e:fac,2)

If NoVacio(Dialogo.Book1)
   ACT(d:fac,'Book:')
   ACT(e:fac, Dialogo.Book1)
Else
   ACT(d:fac,'Book:')
   ACT(e:fac,'Todos')
EndIf


IFA
If NoVacio(Dialogo.NrOperacion1)
   ACT(a:fac,'Operacion:')
   ACT(b:fac, Dialogo.NrOperacion1)
Else
   ACT(a:fac,'Operaciones:')
   ACT(b:fac,'Todas')
EndIf

SetFont(a:fac..b:fac,2)


SetFont(a:fac..e:fac,2)

SetFilaActual(fac+2)
ACT(a:fac,'Tipo Op.')
ACT(b:fac,'Nro. Op.')
ACT(c:fac,'Fecha Op.')
ACT(d:fac,'Fecha Vto.')
ACT(e:fac,'Cliente')
ACT(f:fac,'Nombre')
ACT(g:fac,'Cuenta Comit.')
ACT(h:fac,'Especie')
ACT(i:fac,'Cantidad')
ACT(j:fac,'Precio')
ACT(k:fac,'Plazo')
ACT(l:fac,'C.Esp.')
ACT(m:fac,'Total')
ACT(n:fac,'Tipo')
ACT(o:fac,'Book')
ACT(p:fac,'M. Negociacion')
ACT(q:fac,'Vehiculo')
ACT(r:fac,'Operador')
ACT(s:fac,'F.Carga')
ACT(t:fac,'H.Carga')
ACT(u:fac, 'F.CargaSys')
ACT(v:fac,'Instancia')
ACT(W:fac,'Boleto')
ACT(x:fac,'Nr.Orden')
* FJL 15/01/20 - Se agrega Termsheet ID
ACT(y:fac,'TermSheet ID')
* FJL 15/01/20 - Issue 4603 - Se agrega FechaVto Original si es diferimeinto
ACT(z:fac, 'F.Vto.Real')

AlinearCeldas(a:fac..z:fac,'C')
SetFont(a:fac..z:fac,2)
AgregarMarco(a:fac..z:fac,2,0,EXE('COLOR'))
ACN(az:1,fac)






















SQL.ADD(" Select * from ")
SQL.ADD(" (Select O.TipoOp, O.NrOperacion, O.FechaOp, CASE WHEN TipoOp = 'CONU' and CB1=1 Then "~IdxDate2(Dialogo.Fecha4)~" ELSE Case When TipoOp in ('PICO','PICD') Then O.FechaVto  Else O.FechaVto End END FechaVto, O.FechaPago, ")
SQL.ADD(" O.Cliente1, C.RazonSocial CliNom, O.CB1,")
SQL.ADD(" Cuenta1, O.Especie, O.FechaEj, O.PrecioEj, O.Cantidad, O.Precio1, O.Precio4, O.Plazo, O.PaseCB, ")
SQL.ADD(" O.ContraEspecie, O.TotalNetoCli1, O.Book1, O.Vehiculo1, O.Operador, O.FechaOp2, ")
SQL.ADD(" O.FechaCarga,O.FechaCargaSys, O.NrBoleto,O.NrOperacion3, O.TotalBrutoCli1,O.NrOrden1, ")
* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
SQL.ADD(" O.ObservacDoc as TSID, O.OperacionRef, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TICF','TIVF') THEN O.Mercado ELSE O.Mercado4 END MercNeg, O.CB3, O.CB4,O.Corporate ")
* FJL 05/07/19 - Por Opraciones sin Cliente
*SQL.ADD("  From "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("  From "~DBO~".OPERACIONES O LEFT OUTER JOIN "~DBO~".CLIENTES C on O.Cliente1=C.Codigo ")
SQL.ADD(" Where O.FechaOp  between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2) )
*SQL.ADD(" and   O.FechaVto between "~IdxDate2(Dialogo.Fecha3)~" and "~IdxDate2(Dialogo.Fecha4) )
* FJL 05/07/19 - Por Opraciones sin Cliente
*SQL.ADD(" and   O.Cliente1    = C.Codigo ")
SQL.ADD(" and   O.Vehiculo1   = '"~Dialogo.Vehiculo1~"' ")
*-Especie
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
*-Cliente
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
*-Operador
If NoVacio(Dialogo.Operador1)
   SQL.ADD(" and O.Operador = '"~Dialogo.Operador1~"' ")
EndIf
*-Book
If NoVacio(Dialogo.Book1)
   SQL.ADD(" and O.Book1 = '"~Dialogo.Book1~"' ")
EndIf
*-Lista
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
*-Pata pase
If Dialogo.Check1=0
  SQL.ADD(" and (TipoOp Not in ('TIV', 'TIFC', 'TIC','TIFV') or (O.PaseCB = '0' and TipoOp in ('TIV', 'TIFC', 'TIC','TIFV'))) ")
EndIf
*-Tipos Negocio
If NoVacio(Dialogo.Lista3)
   SQL.ADD(" and O.TipoOp In ( Select Codigo From "~DBO~".TIPOSOPERACION Where TipoNegocio in ("~Pipe2Comillas(Val(LI:1))~") ) ")
EndIf






If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
EndIf


SQL.ADD(" ) as Aux")

*SQL.ADD(" Where (TipoOp = 'MMCREM' OR (FechaVto between "~IdxDate2(Dialogo.Fecha3)~" and "~IdxDate2(Dialogo.Fecha4)~") ) ")
SQL.ADD(" Where  FechaVto between "~IdxDate2(Dialogo.Fecha3)~" and "~IdxDate2(Dialogo.Fecha4) )
*-Mercado
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" and MercNeg = '"~Dialogo.Mercado1~"' ")
EndIf
SQL.ADD("Order by TipoOp, NrOperacion ")
watch(SQL.Batch)
Recorrer SQL
  ACN(az:5,0)
  If [Not CeldaVacia(az:4)]
     If SQL("select Count(*) from "~DBO~".OPERACIONESBITS where NrOperacion='"~fbn('NrOperacion')~"' and NrBit IN ("~Pipe2Comillas(Val(az:4))~") and Valor='1' ") <> 0
        ACN(az:5,1)
     EndIf
  Else
     ACN(az:5,1)
  EndIf
  
  If Val(az:5) = 0
     DFA
  Else
     ACT(a:fac,fbn('TipoOp')~IIF(EqStr(FBN['PaseCB'],'1'),' x Pase'))
   ACT(g:fac, FBN['TipoOp']~IIF(EqStr(FBN['PaseCB'],'1'),' x Pase'))
     
     ACT(b:fac,fbn('NrOperacion'))
     ACLO(b:fac,fbn('NrOperacion'))
     ACT(c:fac,fbn('FechaOp'))
* FJL 25/10/20 - Issue 4603 - Fecha post-diferimiento
*     ACT(d:fac,iif(EqStr(fbn('TipoOp'),'CONU'),iif(fbn('CB1')=1,'',fbn('FechaVto')),fbn('FechaVto')))
     if EqStr(fbn('TipoOp'),'CONU')
*       ACT(d:fac, iif(fbn('CB1')=1,'',fbn('FechaVto')))
     else
       if Incluido(fbn('TipoOp'),'TIC|TIV')
         if fbn('FechaPago')<>fbn('FechaVto')
           ACT(d:fac, fbn('FechaPago'))
           ACT(z:fac, fbn('FechaVto'))
         else
           ACT(d:fac, fbn('FechaVto'))
         endif
       else
         ACT(d:fac, fbn('FechaVto'))
       endif
     endif
     AlinearCeldas(b:fac..d:fac,'C')
     AlinearCeldas(z:fac..z:fac,'C')
     
     ACT(e:fac,fbn('Cliente1'))
     ACT(f:fac,Copy(fbn('CliNom'), 1, 25))
     ACT(g:fac,FBN['Cuenta1'])
     
     If NoVacio(fbn('FechaEj')) Y Not Incluido(fbn('TipoOp'), 'FXCTC|FXVTC|FXCF|FXVF')
        ACT(h:fac,fbn('Especie')~'-'~Fecha(fbn('FechaEj'))~'-'~FStr(fbn('PrecioEj'),1,7))
     Else
        ACT(h:fac,fbn('Especie'))
     EndIf
     If Incluido(fbn('TipoOp'), 'FXCTC|FXVTC|')  
        ACN(i:fac,fbn('Cantidad') *  BuscarCampo('ESPECIES','TamanioLote','Codigo',fbn('Especie')) )
     Else
        ACN(i:fac,fbn('Cantidad')  )
     EndIf
     FormatoCeldas(i:fac,EXE('F2'))
     
     ACN(j:fac,fbn('Precio1'))
     FormatoCeldas(j:fac,EXE('F9'))
     
     ACN(k:fac,fbn('Plazo'))
     If Incluido(fbn('TipoOp'), 'TIC|TIV|TCOPRI')
        ACN(k:fac,fbn('Plazo')/24)
     Endif
     
     FormatoCeldas(k:fac,EXE('F0S'))
     ACT(l:fac,fbn('ContraEspecie'))
     If Incluido(fbn('TipoOp'), 'FXC|FXV|FXCT|FXVT|FXA|FXAT|MMCO|MMCT|TIDE|TIPO|MMPF|MMPFCE|MMOVN|FXCF|FXVF|PMU|PME|IEXP|IMM|IFX|ISL|TICO|TIPA|TIPP|TICT|TICF|TICV')
        ACN(m:fac,fbn('TotalBrutoCli1'))
     Else
        ACN(m:fac,fbn('TotalNetoCli1'))
     Endif
     FormatoCeldas(m:fac,EXE('F2'))
     
     If Incluido(fbn['TipoOp'],'TIC|TIV|EQC|EQV')
        If fbn('CB4')=1
           ACT(n:fac,'TERCEROS')
        Else
           ACT(n:fac,'PROPIA')
        EndIf
     EndIf
     If Incluido(fbn['TipoOp'],'TCOPRI')
        If fbn('Corporate')=1
           ACT(n:fac,'PROPIA')
        Else
           ACT(n:fac,'TERCEROS')
        EndIf
     EndIf
     ACT(o:fac,fbn('Book1'))
     If Incluido(fbn['TipoOp'],'TIC|TIV')
        If fbn('CB3')=1
           ACT(p:fac, fbn('MercNeg')~' - SENEBI')
        Else
           ACT(p:fac, fbn('MercNeg'))
        EndIf
     Else
        ACT(p:fac,fbn('MercNeg'))
     EndIf
     
     ACT(p:fac,fbn('MercNeg'))
     ACT(q:fac,fbn('Vehiculo1'))
     ACT(r:fac,fbn('Operador'))
*     ACT(s:fac,Fecha(fbn('FechaCarga'),))
     ACT(s:fac,Copy(fbn('FechaCarga'),1,10))
     ACT(t:fac,Hora(fbn('FechaCarga')))
*     ACT(u:fac, Fecha(fbn('FechaCargaSys')))
     ACT(u:fac, fbn('FechaCargaSys'))
     If Incluido(fbn['TipoOp'],'CFTP|CTC|CTP|LIC|VFTP|VTC|VTP|ANTCBC|ANTCBT|CBC|CBT|CCP|CPP|VCP|VPP')
        ACT(w:fac, fbn('NrOperacion3'))
     Else
        If Not Incluido(fbn['TipoOp'],'TICF|TIVF')
           ACT(w:fac, fbn('NrBoleto'))
        EndIf
     EndIf
     ACT(x:fac,fbn('NrOrden1'))
     *ACLR(x:fac,fbn('NrOperacion'))
     AlinearCeldas(s:fac..x:fac,'C')

* FJL 15/01/20 - Se agrega Termsheet ID (CONU)
     If Incluido(fbn['TipoOp'],'CONU')
       ACT(y:fac, fbn('TSID'))
     EndIf
     If Incluido(fbn['TipoOp'],'PICO|PICD')
       ACT(y:fac, BuscarCampo('OPERACIONES','ObservacDoc','NrOperacion',fbn('OperacionRef')))
     EndIf

     SetFont(a:fac..y:fac,1)
     
     ACN(az:2,0)
     SQL.ADD(" Select NrBit ")
     SQL.ADD(" From  "~DBO~".OPERACIONESBITS ")
     SQL.ADD(" Where NrOperacion = '"~fbn('NrOperacion')~"' ")
     SQL.ADD("  and  Valor = '1' ")
     SQL.ADD(" Order by NrBit ")
     Recorrer SQL
       DFA
       If Val(az:2) = 0
          ACN(az:2,1)
       Else
          IFA
       EndIf
       ACT(v:fac,FStr(fbn('NrBit'),1,0))
       ACT(az:3,SQL(" Select Nombre From "~DBO~".INSTANCIAS Where NrInstancia="~FStr(fbn('NrBit'),1,0)~" "))
       If Not CeldaVacia(az:3)
          ACT(v:fac,'('~Val(v:fac)~') '~Val(az:3))
       EndIf
*       ColorCeldas(v:fac,clBLUE)
       SetFont(v:fac,1)
     Proximo
  EndIf
Proximo

SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac,2)

Impresion(1,2)
Impresion(2,1)
Impresion(3,1)
Impresion(4,1)

LimitesVision(z:fac)
Rangotitulo(a:1..z:fac,Val(az:1))
SetPrintFit(3, 50)

ACO(1,7)
ACO(2,6)
ACO(3,8)
ACO(4,7)
ACO(5,9)
ACO(6,20)
ACO(7,8)
ACO(8,15)
ACO(9,10)
ACO(10,9)
ACO(11,4)
ACO(12,5)
ACO(13,10)
ACO(14,8)
ACO(15,8)
ACO(16,9)
ACO(17,13)
ACO(18,7)
ACO(19,6)
ACO(20,8)
ACO(21,13)
ACO(22,13)
ACO(25,8)
ACO(26,7)
