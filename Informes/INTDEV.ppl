CrearDialogo
  Fecha1 : 'F.Desde';;;;;;;;;FinDeMes(FSys-30)+1
  Fecha2 : 'F.Hasta';;;;;;;;;FinDeMes(FSys)
FinDialogo
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3,"Arial,10,B")


if not OK
  Cancelar
endif
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
ACT(a5, 'Intereses devengados por periodo')
ACT(a6, 'F.Desde : '~Dialogo.Fecha1)
ACT(a7, 'F.Hasta : '~Dialogo.Fecha2)

SetFont(a5..p5, 3)
SetFont(a6..p7, 1)

setFilaActual(8)
ACT(a:FAC, 'Nro.Op.')
ACT(b:FAC, 'Especie')
ACT(c:FAC, 'Cliente')
ACT(d:FAC, 'Cantidad')
ACT(e:FAC, 'Plazo')
ACT(f:FAC, 'Fecha Op.')
ACT(g:FAC, 'Fecha Vto.')
ACT(h:FAC, 'Intereses en Pesos')
ACT(h:FAC+1, 'Total')
ACT(i:FAC+1, 'Deveng.')
AgregarMarco(h:FAC..i:FAC,1)
AgregarMarco(h:FAC+1..i:FAC+1,1)
ACT(j:FAC, 'Intereses en Dolares')
ACT(j:FAC+1, 'Total')
ACT(k:FAC+1, 'Deveng.')
AgregarMarco(j:FAC..k:FAC,1)
AgregarMarco(j:FAC+1..k:FAC+1,1)
ACT(l:FAC, 'Dias P.')
AlinearCeldas(d:FAC..e:FAC, 'D')
AlinearCeldas(h:FAC+1..k:FAC+1, 'D')
AlinearCeldas(l:FAC..l:FAC, 'D')

AgregarMarco(a:FAC..l:FAC+1, 2,0,Exe('COLOR'))

SetFilaActual(FAC+1)
Let &titulo FAC+1
SQL.ADD("Select NrOperacion, TipoOp, Especie, FechaOp, FechaVto, Cliente1, Cantidad, TotalIntereses, Plazo, RazonSocial from "~DBO~".OPERACIONES o join clientes c on o.Cliente1 = c.Codigo") 
SQL.ADD("where FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and TipoOp in ('MMCA','MMCO','MMCT','MMPF','MMPFCE','MMPO','MMAD','MMDES','MMOVN')")
 
SQL.ADD("order by TipoOp, NrOperacion")

recorrer SQL
  if Not EqStr(Val(z1),fbn('TipoOp'))
    if NoVacio(Val(z1))
      ACT(a:fac, 'Total')
      ACN(i:fac, Sum(i:Val(z4)..i:fac-1))
      ACN(k:fac, Sum(k:Val(z4)..k:fac-1))
      AgregarMarco(a:fac..l:fac,1)
      ifa
    endif
    ACT(a:fac, fbn('TipoOp'))
    ACT(z1, fbn('TipoOp'))
    AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
    ifa
    ACN(z4, fac)
  endif
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente1') ~' - '~ Copy(fbn('RazonSocial'),1,25))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Plazo'))
  ACT(f:fac, fbn('FechaOp'))
  ACT(g:fac, fbn('FechaVto'))
  if fbn('FechaOp') > Dialogo.Fecha1
    ACN(z2, fbn('FechaOp'))
  else
    ACN(z2, Dialogo.Fecha1)
  endif
  if fbn('FechaVto') <= Dialogo.Fecha2
    ACN(z3, fbn('FechaVto'))
  else
    ACN(z3, Dialogo.Fecha2+1)
  endif
  ACN(l:fac, Val(z3)-Val(z2))
  if Incluido(fbn('TipoOp'), 'MMCT|MMPF|MMCA|MMPFCE')
    ACN(z5, -1)
  else
    ACN(z5, 1)
  endif
  if EqStr(fbn('Especie'),'ARP')
    ACN(h:fac, fbn('TotalIntereses')*Val(z5))
    ACN(i:fac, Val(h:fac)/fbn('Plazo')*Val(l:fac))
  else
    if EqStr(fbn('Especie'),'USD') 
       ACN(j:fac, fbn('TotalIntereses')*Val(z5))
    else
       ACN(j:fac, fbn('TotalIntereses')*Val(z5)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,'USD') )
    endif
    ACN(k:fac, Val(j:fac)/fbn('Plazo')*Val(l:fac))
  endif
proximo

if NoVacio(Val(z1))
  ifa
  ACT(a:fac, 'Total')
  ACN(i:fac, Sum(i:Val(z4)..i:fac-1))
  ACN(k:fac, Sum(k:Val(z4)..k:fac-1))
  AgregarMarco(a:fac..l:fac,1)
  ifa
  ACT(a:fac, 'Total General')
  ACN(i:fac, Sum(i7..i:fac-1)/2)
  ACN(k:fac, Sum(k7..k:fac-1)/2)
  AgregarMarco(a:fac..l:fac,2,0,Exe('COLOR'))
  AgregarMarco(i:&titulo..i:fac,1)
  AgregarMarco(k:&titulo..k:fac,1)
  AgregarMarco(h:&titulo..l:fac,1)
endif
SetFont(a:fac..z:fac, 1)
FormatoCeldas(d6..d:fac, Exe('F2'))
FormatoCeldas(e6..e:fac, Exe('F0'))
FormatoCeldas(h6..k:fac, Exe('F2'))
FormatoCeldas(l6..l:fac, Exe('F0'))
LimitesVision(m:fac+1)
ACO(8,8)
ACO(9,9)
ACO(10,8)
ACO(11,9)
ACO(3, 25)
Impresion(1,2)
