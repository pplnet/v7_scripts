CrearDialogo
  Fecha1 : 'F.Desde';;;;;;;;;FinDeMes(FSys-30)+1
  Fecha2 : 'F.Hasta';;;;;;;;;FinDeMes(FSys)
FinDialogo


if not OK
  Cancelar
endif

ACT(a1, 'Money Markets - Intereses devengados de un periodo')
ACT(a2, 'F.Desde : '~Dialogo.Fecha1)
ACT(a3, 'F.Hasta : '~Dialogo.Fecha2)

ACT(a5, 'Nro.Op.')
ACT(b5, 'Especie')
ACT(c5, 'Cliente')
ACT(d5, 'Cantidad')
ACT(e5, 'Plazo')
ACT(f5, 'Fecha Op.')
ACT(g5, 'Fecha Vto.')
ACT(h5, 'Intereses en Pesos')
ACT(h6, 'Total')
ACT(i6, 'Deveng.')
AgregarMarco(h5..i5,1)
AgregarMarco(h6..i6,1)
ACT(j5, 'Intereses en Dolares')
ACT(j6, 'Total')
ACT(k6, 'Deveng.')
AgregarMarco(j5..k5,1)
AgregarMarco(j6..k6,1)
ACT(l5, 'Dias P.')
AlinearCeldas(d5..e5, 'D')
AlinearCeldas(h6..k6, 'D')
AlinearCeldas(l5..l5, 'D')

AgregarMarco(a5..l6, 2,0,Exe('COLOR'))

SetFilaActual(6)
SQL.ADD("Select NrOperacion, TipoOp, Especie, FechaOp, FechaVto, Cliente1, Cantidad, TotalIntereses, Plazo from "~DBO~".OPERACIONES")
SQL.ADD("where FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("and TipoOp in ('MMCA','MMCO','MMCT','MMPF','MMPFCE','MMPO','MMAD','MMDES','MMOVN')")
 
SQL.ADD("order by TipoOp, NrOperacion")
recorrer SQL
  if Not EqStr(Val(z1),fbn('TipoOp'))
    if NoVacio(Val(z1))
      ACT(a:fac, 'Total')
      ACN(i:fac, Sum(i:Val(z4)..i:fac-1))
      ACN(k:fac, Sum(k:Val(z4)..k:fac-1))
      AgregarMarco(a:fac..l:fac,1)
      ifa
    endif
    ACT(a:fac, fbn('TipoOp'))
    ACT(z1, fbn('TipoOp'))
    AgregarMarco(a:fac..l:fac,1,0,RGB(192,192,192))
    ifa
    ACN(z4, fac)
  endif
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, fbn('NrOperacion'))
  ACT(b:fac, fbn('Especie'))
  ACT(c:fac, fbn('Cliente1'))
  ACN(d:fac, fbn('Cantidad'))
  ACN(e:fac, fbn('Plazo'))
  ACT(f:fac, fbn('FechaOp'))
  ACT(g:fac, fbn('FechaVto'))
  if fbn('FechaOp') > Dialogo.Fecha1
    ACN(z2, fbn('FechaOp'))
  else
    ACN(z2, Dialogo.Fecha1)
  endif
  if fbn('FechaVto') <= Dialogo.Fecha2
    ACN(z3, fbn('FechaVto'))
  else
    ACN(z3, Dialogo.Fecha2+1)
  endif
  ACN(l:fac, Val(z3)-Val(z2))
  if Incluido(fbn('TipoOp'), 'MMCT|MMPF|MMCA|MMPFCE')
    ACN(z5, -1)
  else
    ACN(z5, 1)
  endif
  if EqStr(fbn('Especie'),'ARP')
    ACN(h:fac, fbn('TotalIntereses')*Val(z5))
    ACN(i:fac, Val(h:fac)/fbn('Plazo')*Val(l:fac))
  else
    if EqStr(fbn('Especie'),'USD') 
       ACN(j:fac, fbn('TotalIntereses')*Val(z5))
    else
       ACN(j:fac, fbn('TotalIntereses')*Val(z5)*CotizacionC(fbn('Especie'),,,,Dialogo.Fecha2,1,SI,'USD') )
    endif
    ACN(k:fac, Val(j:fac)/fbn('Plazo')*Val(l:fac))
  endif
proximo

if NoVacio(Val(z1))
  ifa
  ACT(a:fac, 'Total')
  ACN(i:fac, Sum(i:Val(z4)..i:fac-1))
  ACN(k:fac, Sum(k:Val(z4)..k:fac-1))
  AgregarMarco(a:fac..l:fac,1)
  ifa
  ACT(a:fac, 'Total General')
  ACN(i:fac, Sum(i7..i:fac-1)/2)
  ACN(k:fac, Sum(k7..k:fac-1)/2)
  AgregarMarco(a:fac..l:fac,2,0,Exe('COLOR'))
  AgregarMarco(i6..i:fac,1)
  AgregarMarco(k6..k:fac,1)
  AgregarMarco(h6..l:fac,1)
endif
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
SetFont(a1..z6, 1)
SetFont(a7..z:fac, 2)
SetFont(a:fac..z:fac, 1)
FormatoCeldas(d6..d:fac, Exe('F2'))
FormatoCeldas(e6..e:fac, Exe('F0'))
FormatoCeldas(h6..k:fac, Exe('F2'))
FormatoCeldas(l6..l:fac, Exe('F0'))
LimitesVision(m:fac+1)
ACO(8,8)
ACO(9,9)
ACO(10,8)
ACO(11,9)
Impresion(1,2)
