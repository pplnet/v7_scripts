        ACN(p:fac,Val(tv:5))
        ACN(q:fac,Val(tv:6))
        ACN(r:fac,Val(tv:7))
        Endif
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..s:fac,0,0,EXE('COLOR8'))
        ifa
        ifa
        IFA
        ACN(fi:1, fac)
        * --- Limpia Totales por Book
        ACN(tt:1, 0 )
        ACN(tt:2, 0 )
        ACN(tt:3, 0 )
        ACN(tt:4, 0 )
        ACN(tt:5, 0 )
        ACN(tt:6, 0 )
        ACN(tt:7, 0 )

        * --- Limpia Totales por vehiculo
