     ACN(i:fac, 1)
  Else
* FJL 25/5/22 - Se cambia por precio NIIF
*     ACN(i:fac, CotizacionRanking(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,,,))
    ***---Precio Cierre NIIF
    Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book'))
    IF Vacio(&PrecioNIIF)
      ACN(i:FAC, 0)
      ACT(aa:FAC, 'NIIF cero')
    ELSE
      ACN(i:FAC, &PrecioNIIF.PrecioCotizacionDeterminada)
    ENDIF
    ACN(ab:FAC, COTIZACION(fbn('Especie'),,,,Dialogo.Fecha1,1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')),,,,Dialogo.Fecha1,25,SI,'ARP'))
    if Val(i:FAC)=0
      ACN(i:FAC, Val(ab:FAC))
    endif
  Endif
*
  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
     ACN(j:fac, 1)
  Else
* FJL 25/5/22 - Se cambia por precio NIIF
*     ACN(j:fac, CotizacionRanking(fbn('Especie'),,,,habiles(Dialogo.Fecha1,-1,'ARG'),1,SI,,,))
    ***---Precio Cierre NIIF
    Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Habiles(Dialogo.Fecha1,-1,'ARG'), fbn('Book'))
    IF Vacio(&PrecioNIIF)
