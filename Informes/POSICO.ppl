        ACN(m:fac,Val(tt:2))
        ACN(n:fac,Val(tt:3))
        ACN(o:fac,Val(tt:4))
        ACN(p:fac,Val(tt:5))
        ACN(q:fac,Val(tt:6))
        ACN(r:fac,Val(tt:7))
        AgregarMarco(a:fac..s:fac,0,0)
