SQL.ADD("  OR  (P.Fecha<"~idxdate2(Dialogo.Fecha1)~" and (Round(P.CantidadFin,2) <> 0 ))")
SQL.ADD("     )")

If Dialogo.Check1=0
   SQL.ADD(" AND   P.Especie <> '"~VAR('MONELOCA')~"' ")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
If NoVacio(Dialogo.Vehiculo1)
