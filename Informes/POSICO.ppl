    ACN(ad:FAC, COTIZACION(fbn('Especie'),,,,Habiles(Dialogo.Fecha1,-1,'ARG'),1)*COTIZACIONC(BuscarCampo('ESPECIES','Cotiza','Codigo',fbn('Especie')),,,,Habiles(Dialogo.Fecha1,-1,'ARG'),25,SI,'ARP'))
    if Val(j:FAC)=0
      ACN(j:FAC, Val(ad:FAC))
    endif
  Endif
  ACN(k:fac, Val(g:fac)-Val(d:fac))
  ACN(l:fac, Val(i:fac)*Val(g:fac))

  SetFont(a:fac..z:fac, 1)

  If dialogo.check3=1 y Not Incluido(fbn('Book'),&BValuaPartida)
  ACN(m:fac, 0)
  ACN(n:fac, 0)
  ACN(o:fac, 0)
  ACN(p:fac, 0)
  ACN(q:fac, 0)
  ACN(r:fac, 0)

  SQL.ADD(" SELECT Day, MTD, YTD, TipoResultado, Fecha FROM "~DBO~".RESULTADOS R  ")
  SQL.ADD(" WHERE Especie   = '"~fbn('Especie')~"'     ")
  SQL.ADD(" AND   NrSaldo   = "~fstr(fbn('NrSaldo'),0,0)~" ")
  SQL.ADD(" AND   Vehiculo  = '"~fbn('Vehiculo')~"'    ")
  SQL.ADD(" AND   Book      = '"~fbn('Book')~"'        ")
  IF Novacio(FBN('FechaEj'))
     SQL.ADD(" AND   FechaEj  = "~idxdate2(FBN('FechaEj'))~" ")
  Endif
  SQL.ADD(" AND   TipoResultado IN ('REACON','REVCON') ")
  ** FJL 24/11/22 - Mostraba la suma de resultados en todas las lineas de la misma especie
  SQL.ADD(" AND   IsNull(Estrategia,'')   = IsNull('"~fbn('Estrategia')~"','')        ")
  SQL.ADD(" AND   IsNull(TipoPosicion,'') = IsNull('"~fbn('TipoPosicion')~"','')        ")
  ****************
  SQL.ADD(" AND   Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS R1 ")
  SQL.ADD("                 WHERE R.Especie  = R1.Especie  ")
  SQL.ADD("                 AND   R.NrSaldo  = R1.NrSaldo  ")
  SQL.ADD("                 AND   R.Cliente  = R1.Cliente ")
  SQL.ADD("                 AND   R.Vehiculo = R1.Vehiculo ")
  SQL.ADD("                 AND   R.Book     = R1.Book     ")
  SQL.ADD("                 AND   R.TipoResultado  = R1.TipoResultado    ")
*  SQL.ADD("                 AND   (R.Sector   = R1.Sector   OR (R.Sector   IS NULL AND R1.Sector   IS NULL) ) ")
*  SQL.ADD("                 AND   (R.CallPut  = R1.CallPut  OR (R.CallPut  IS NULL AND R1.CallPut  IS NULL) ) ")
*  SQL.ADD("                 AND   (R.Cupon    = R1.Cupon    OR (R.Cupon    IS NULL AND R1.Cupon    IS NULL) ) ")
*  SQL.ADD("                 AND   (R.FechaEj  = R1.FechaEj  OR (R.FechaEj  IS NULL AND R1.FechaEj  IS NULL) ) ")
*  SQL.ADD("                 AND   (R.PrecioEj = R1.PrecioEj OR (R.PrecioEj IS NULL AND R1.PrecioEj IS NULL) ) ")
*  SQL.ADD("                 AND   (R.Estrategia   = R1.Estrategia   OR (R.Estrategia   IS NULL AND R1.Estrategia   IS NULL) ) ")
*  SQL.ADD("                 AND   (R.TipoPosicion = R1.TipoPosicion OR (R.TipoPosicion IS NULL AND R1.TipoPosicion IS NULL) ) ")
  SQL.ADD("                 and   IsNull(R.Unidad,'')       = IsNull(R1.Unidad,'') ")
  SQL.ADD("                 and   IsNull(R.Centro,'')       = IsNull(R1.Centro,'') ")
  * Sector se usa para saldos 101-102
  SQL.ADD("                 and   IsNull(R.Sector,'')       = IsNull(R1.Sector,'') ")
  SQL.ADD("                 and   IsNull(R.Sucursal,'')     = IsNull(R1.Sucursal,'') ")
  SQL.ADD("                 and   IsNull(R.PrecioEj,0)      = IsNull(R1.PrecioEj,0) ")
  SQL.ADD("                 and   IsNull(R.FechaEj,0)       = IsNull(R1.FechaEj,0) ")
  SQL.ADD("                 and   IsNull(R.CallPut,'')      = IsNull(R1.CallPut,'') ")
  * Estrategia se usa para saldos 121-122
  SQL.ADD("                 and   IsNull(R.Estrategia,'')   = IsNull(R1.Estrategia,'') ")
  SQL.ADD("                 and   IsNull(R.Cartera,'')      = IsNull(R1.Cartera,'') ")
  SQL.ADD("                 and   IsNull(R.Trader,'')       = IsNull(R1.Trader,'') ")
  * TipoNegocio se usa siempre
  SQL.ADD("                 and   IsNull(R.TipoNegocio,'')  = IsNull(R1.TipoNegocio,'') ")
  SQL.ADD("                 and   IsNull(R.Cupon,'')        = IsNull(R1.Cupon,'') ")
  SQL.ADD("                 and   IsNull(R.Responsable,'')  = IsNull(R1.Responsable,'') ")
  * TipoPosicion se usa para saldos 121-122
  SQL.ADD("                 and   IsNull(R.TipoPosicion,'') = IsNull(R1.TipoPosicion,'') ")
  SQL.ADD("                 and   IsNull(R.Producto,'')     = IsNull(R1.Producto,'') ")
  SQL.ADD("                 and   IsNull(R.GrupoEspecie,'') = IsNull(R1.GrupoEspecie,'') ")
  SQL.ADD("                 AND   R1.Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ) ")
  Recorrer SQL
    dfa
    If Eqstr(fbn('TipoResultado'),'REACON')
       If fbn('Fecha')=Dialogo.Fecha1
         SCN(m:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
         SCN(n:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
         SCN(o:fac, fbn('YTD'))
       Endif
    Endif
    If Eqstr(fbn('TipoResultado'),'REVCON')
       If fbn('Fecha')=Dialogo.Fecha1
         SCN(p:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
         SCN(q:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
         SCN(r:fac, fbn('YTD'))
       Endif
    Endif
  Proximo
  endif
  
  Let &Valuacion ValuacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book'), fbn('CantidadFin'))
  If dialogo.check3=1
    IF Vacio(&Valuacion)
      ACT(s:fac, '')
    ELSE
      ACT(s:fac, &valuacion.get_TipoValuacionNIIF )
    ENDIF
    ACT(t:FAC, fbn('Estrategia'))
    ACT(u:FAC, fbn('TipoPosicion'))
  else
    IF Vacio(&Valuacion)
      ACT(m:fac, '')
    ELSE
      ACT(m:fac, &valuacion.get_TipoValuacionNIIF )
    ENDIF
    ACT(n:FAC, fbn('Estrategia'))
    ACT(o:FAC, fbn('TipoPosicion'))
  endif

  ACN(ae:FAC, fbn('PrecioReset'))
  ACN(af:FAC, fbn('PrecioResetCon'))

  FormatoCeldas(d:fac..g:fac, EXE('F2'))
  FormatoCeldas(h:fac..j:fac, EXE('F9'))
  FormatoCeldas(k:fac..r:fac, EXE('F2'))
  FormatoCeldas(aa:fac..af:fac, EXE('F9'))

  SetFont(a:fac..af:fac, 1)

  ACN(xx:1, fbn('NrSaldo'))
  ACT(xx:2, fbn('Vehiculo'))
  ACT(xx:3, fbn('Book'))
Proximo

ifa
If Val(xx:1)=121 o Val(xx:1)=122
   ACT(a:fac, 'Total Titulos')
Endif
* --- iMPRIME Totales por tipo
ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
If dialogo.check3=1
ACN(m:fac, SUM(m:Val(fi:1)..m:fac) )
ACN(n:fac, SUM(n:Val(fi:1)..n:fac) )
ACN(o:fac, SUM(o:Val(fi:1)..o:fac) )
ACN(p:fac, SUM(p:Val(fi:1)..p:fac) )
ACN(q:fac, SUM(q:Val(fi:1)..q:fac) )
ACN(r:fac, SUM(r:Val(fi:1)..r:fac) )
endif
SetFont(a:fac..z:fac, 3)

* --- Suma totales para BOOK
SCN(tt:1, Val(l:fac) )
If dialogo.check3=1
SCN(tt:2, Val(m:fac) )
SCN(tt:3, Val(n:fac) )
SCN(tt:4, Val(o:fac) )
SCN(tt:5, Val(p:fac) )
SCN(tt:6, Val(q:fac) )
SCN(tt:7, Val(r:fac) )
Endif

* --- Suma totales para Vehiculo
SCN(tv:1, Val(l:fac) )
If dialogo.check3=1
SCN(tv:2, Val(m:fac) )
SCN(tv:3, Val(n:fac) )
SCN(tv:4, Val(o:fac) )
SCN(tv:5, Val(p:fac) )
SCN(tv:6, Val(q:fac) )
SCN(tv:7, Val(r:fac) )
Endif

ifa
ACT(a:fac,  'Total Book: '~Val(xx:3))
ACN(l:fac,Val(tt:1))
If dialogo.check3=1 y incluido(Val(xx:3),&BValuaPartida)
ACN(m:fac,Val(tt:2))
ACN(n:fac,Val(tt:3))
ACN(o:fac,Val(tt:4))
ACN(p:fac,Val(tt:5))
ACN(q:fac,Val(tt:6))
ACN(r:fac,Val(tt:7))
AgregarMarco(a:fac..s:fac,0,0,EXE('COLOR8'))
else
AgregarMarco(a:fac..l:fac,0,0,EXE('COLOR8'))
Endif
SetFont(a:fac..z:fac, 2)
ifa
ifa
ACT(a:fac, 'Total Vehiculo '~Val(xx:2))
ACN(l:fac,Val(tv:1))
If dialogo.check3=1
ACN(m:fac,Val(tv:2))
ACN(n:fac,Val(tv:3))
ACN(o:fac,Val(tv:4))
ACN(p:fac,Val(tv:5))
ACN(q:fac,Val(tv:6))
ACN(r:fac,Val(tv:7))
AgregarMarco(a:fac..s:fac,0,0,EXE('COLOR8'))
else
AgregarMarco(a:fac..l:fac,0,0,EXE('COLOR8'))
Endif
SetFont(a:fac..z:fac, 2)
FormatoCeldas(l:11..x:fac, EXE('F2'))


ifa
ifa
ifa
ACO(1,20)
ACO(2,4)

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac, 1)
IFA
ACT(a:fac, USUARIOACTIVO)

Impresion(1,2)
Impresion(4,1)
SetMargins(0,0,0,2)
If dialogo.check3=1
   LimitesVision(u:fac+2)
   SetPrintFIT(3,57)
Else
   LimitesVision(o:fac+2)
   SetPrintFIT(3,100)
Endif
