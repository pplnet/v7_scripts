CrearDialogo
  Fecha1   : 'D. FechaEj'                   ; ; ;;;;Dialogo.Fecha1<>0;'Fecha Desde Invalida';NO;FSYS
  Fecha2   : 'H. FechaEj'                   ;1;2;;;;Dialogo.Fecha2<>0;'Fecha Hasta Invalida';NO;FSYS
  Especie1 : 'Especie'                      ;3;1;;;;;;;;;;
  Radio1   : 'Incluye|Exterior|Bolsa|Todas' ;3;2;;;;;;;2
  Vehiculo1: 'Vehiculo'                     ;5;1;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE')
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,10,BU")
CrearFont(5,"Arial,14,B")

ACO( 1, 8)
ACO( 2, 7)
ACO( 3, 7)
ACO( 4, 6)
ACO( 5, 7)
ACO( 6, 4)
ACO( 7, 8)
ACO( 8, 8)
ACO( 9, 8)
ACO( 10, 10)

SetFilaActual(2)
ACT(E:fac, 'Spin Off - Opciones que no se pueden ejercer')
SetFilaActual(fac+2)
IF Dialogo.Radio1=0
    ACT(A:fac, 'Opciones: Exterior')
    IFA
ENDIF
IF Dialogo.Radio1=1
    ACT(A:fac, 'Opciones: Bolsa')
    IFA
ENDIF
IF Dialogo.Radio1=2
    ACT(A:fac, 'Opciones: Todas')
    IFA
ENDIF
IF NoVacio(Dialogo.Especie1)
    ACT(A:fac, 'Especie: '~Dialogo.Especie1)
    IFA
ELSE
    ACT(A:fac, 'Especie: Todas')
    IFA
ENDIF
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
IFA
ACT(A:fac, 'Desde Fecha de Ejercicio: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Hasta Fecha de Ejercicio: '~Dialogo.Fecha2)
SetFont(A:fac-7..J:fac, 2)
ifa
***---Titulos de Columnas
ACT(A:fac, 'Especie')
ACT(B:fac, 'Numero')
ACT(B:fac+1, 'Operacion')
ACT(C:fac, 'Fecha')
ACT(C:fac+1, 'Operacion')
ACT(D:fac, 'Cliente')
ACT(E:fac, 'Fecha')
ACT(E:fac+1, 'Ejercicio')
ACT(F:fac, 'Tipo')
ACT(G:fac, 'Precio')
ACT(G:fac+1, 'Ejercicio')
ACT(H:fac, 'Contratos')
ACT(I:fac, 'Prima')
ACT(J:fac, 'Total')

SetFont(A:fac..J:fac+1, 2)
AlinearCeldas(A:fac..J:fac+1,'C')
AgregarMarco(A:fac..J:fac+1,0,2,Exe('COLOR'))
SetFilaActual(fac+2)

ACN(FI:1, fac)
ACT(ES:1, '')
ACN(ST:1, 0)
ACN(TT:1, 0)

SQL.ADD(" Select O.Especie, O.NrOperacion, O.FechaOp, O.Cliente1, O.FechaEj, O.PrecioEj, ")
SQL.ADD(" O.Cantidad, O.Precio1, O.TotalBrutoCli1, O.TipoOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" Where O.FechaEj >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND B.NrOperacion = O.NrOperacion ")
SQL.ADD(" AND B.NrBit <> 30 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD(" AND O.FechaEj <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND O.CB7 = '1' ")
SQL.ADD(" AND (O.CB6 = '0' OR O.CB6 IS Null) ")
IF Dialogo.Radio1 = 0
    SQL.ADD(" AND O.TipoOp IN ('CCE', 'CPE', 'VCE', 'VPE') ")
ENDIF
IF Dialogo.Radio1 = 1
    SQL.ADD(" AND O.TipoOp IN ('CCP', 'CPP', 'VCP', 'VPP') ")
ENDIF
IF Dialogo.Radio1 = 2
    SQL.ADD(" AND O.TipoOp IN ('CCE', 'CPE', 'VCE', 'VPE', 'CCP', 'CPP', 'VCP', 'VPP') ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
ENDIF

SQL.ADD(" Order By O.Especie, O.NrOperacion ")

Recorrer SQL
    IF Eqstr(Val(ES:1), '')
    ***---Primer Registro
        DFA
        ACT(ES:1, fbn('Especie'))
        ACT(A:fac, fbn('Especie'))
        SetFont(A:fac, 2)
    ENDIF
    IF Not Eqstr(Val(ES:1), fbn('Especie'))
    ***---Cambio de Especie
        ACT(A:fac, 'Total Especie:')
        ACT(B:fac, Val(ES:1))
        SetFont(A:fac..J:fac, 2)
        AgregarMarco(A:fac..J:fac,0,2, Exe('COLOR6'))
        ACT(ES:1, fbn('Especie'))
        ACN(J:fac, Val(ST:1))
        ACN(ST:1, 0)
        IFA
        ACT(A:fac, fbn('Especie'))
        SetFont(A:fac, 2)
    ENDIF
    ACT(B:fac, fbn('NrOperacion'))
    ACLO(B:fac, fbn('NrOperacion'))
    ACT(C:fac, fbn('FechaOp'))
    ACT(D:fac, fbn('Cliente1'))
    ACT(E:fac, fbn('FechaEj'))
    IF Incluido(fbn('TipoOp'), 'CCE|VCE|CCP|VCP')
        ACT(F:fac, 'CAL')
    ELSE
        ACT(F:fac, 'PUT')
    ENDIF
    ACN(G:fac, fbn('PrecioEj'))
    ACN(H:fac, fbn('Cantidad'))
    ACN(I:fac, fbn('Precio1'))
    ACN(J:fac, fbn('TotalBrutoCli1'))
    SCN(ST:1, fbn('TotalBrutoCli1'))
    SCN(TT:1, fbn('TotalBrutoCli1'))
    AlinearCeldas(F:fac,'C')
Proximo

AgregarMarco(A:Val(FI:1)..J:fac,0,2)
IFA
ACT(A:fac, 'Total Especie:')
ACT(B:fac, Val(ES:1))
AgregarMarco(A:fac..J:fac+1,0,2,Exe('COLOR6'))
ACN(J:fac, Val(ST:1))
IFA
ACT(A:fac, 'TOTAL:')
ACN(J:fac, Val(TT:1))
AgregarMarco(A:fac..J:fac,0,2,Exe('COLOR'))
FormatoCeldas(G:Val(FI:1)..G:fac, Exe('F8'))
FormatoCeldas(H:Val(FI:1)..H:fac, Exe('F2'))
FormatoCeldas(I:Val(FI:1)..I:fac, Exe('F8'))
FormatoCeldas(J:Val(FI:1)..J:fac, Exe('F2'))

IFA
IFA
IFA
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac-3..J:fac, 2)
LimitesVision(K:fac+2)
