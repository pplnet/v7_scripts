ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1   : 'Fecha'             ;;;;;;;;;FSys
  Lista1   : 'Vehiculo'          ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Radio2   : 'Expresado|ARP|USD' ;;;;;;;;;0
FinDialogo

if not OK
  Cancelar
endif

Message(Dialogo.Lista1)

CrearFont(3, 'Arial,12,B')
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,1)

ACT(g1, 'Informe de Cartera')
ACT(a3, 'Fecha : '~Dialogo.Fecha1)

if NoVacio(Dialogo.Lista1)
   ACT(a:4, 'Vehiculo : '~Dialogo.Lista1)
else
   ACT(a:4, 'Vehiculo : Todos')
endif
ACT(a:5, 'Expresado en '~IIF(Dialogo.Radio2=0,'Pesos','Dolares') )

ACD(n2, FSys)
SetFont(g1,3)
SetFont(a3..a5,1)
SetFilaActual(6)

**** Corte de control de Swaps de Tasa de Interes o de Tipo de Cambio
ACN(zt1, 0)

**** Variable para el inicio
ACN(zt2,0)

**** Variable que dice si es consolidado
ACN(zt3,1)

**** guardo la posicion de la celda inicial de datos
ACN(zt4,0)

ACT(zz1,'TASA DE INTERES')
ACT(zz2,'TIPO DE CAMBIO')
ACN(zt4,0)

** Inicializo variables de suma
ACN(pp1,0)
ACN(qq1,0)
ACN(ss1,0)
ACN(tt1,0)
ACN(uu1,0)
ACN(vv1,0)

*** SELECCIONO SWAPS DE INTERES
*************** Selecciono operaciones con Vto Simple *****
SQL.ADD("Select 1 Orden,          O.Vehiculo1,             O.FechaCargaSys,            O.Cliente1,              O.NrOperacion, ")
SQL.ADD("       O.Especie,        O.ContraEspecie,         O.FechaOp,                  O.FechaEj FVto,          O.FechaOp2 FInicio, ")
SQL.ADD("       O.FechaEj FFin,   O.Cantidad ResidualV,    O.TotalBrutoCli1 ResidualC, O.Precio3 VTasa,         O.TotalGanancias CTasa, ")
SQL.ADD("       O.Spread VSpread, O.TotalNetoCli2 CSpread, O.TotalIntereses VTotInt,   O.InteresesCorr CTotInt, O.TipoOp, ")
SQL.ADD("       O.RB9,            O.RB8,                   O.TotalAux3,                O.TotalBrutoCli2,        O.FechaPago, ")
SQL.ADD("       0 Cantidad5,      0 Cantidad6,             0 Cuotas1,                  O.RB5,                   O.FechaOp2 FInicioC")
SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.Especie=O.ContraEspecie ")
SQL.ADD("   AND (TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') ")
SQL.ADD("        and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("        and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("       ) ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif

SQL.ADD("  Union All ")

*************** Selecciono operaciones con Vto Multiple
SQL.ADD("Select 1 Orden,          O.Vehiculo1,           O.FechaCargaSys,       O.Cliente1,                                                                                       O.NrOperacion, ")
SQL.ADD("       O.Especie,        O.ContraEspecie,       O.FechaOp,             CASE O.TipoOp WHEN 'DTSFVX' THEN O.FechaEx2 WHEN 'DTSNFV' THEN O.FechaEx2 ELSE C.Fecha2 END FVto, C.Fecha1 FInicio, ")
SQL.ADD("       C.Fecha2 FFin,    C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa,                                                                                  C.Precio2 CTasa, ")
SQL.ADD("       C.Total3 VSpread, C.Total4 CSpread,      C.Cantidad3 VTotInt,   C.Cantidad4 CTotInt,                                                                              O.TipoOp, ")
SQL.ADD("       O.RB9,            O.RB8,                 O.TotalAux3,           O.TotalBrutoCli2,                                                                                 C.Fecha3 FechaPago, ")
SQL.ADD("       C.Cantidad5,      C.Cantidad6,           O.Cuotas1,             O.RB5,                                                                                            C.Fecha5 FInicioC ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("   AND O.Especie     = O.ContraEspecie ")
SQL.ADD("   and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM') ")
SQL.ADD("         and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("         and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("        ) ")
SQL.ADD("        or ")
SQL.ADD("        (TipoOp IN ('DTSNFV') ")
SQL.ADD("         and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("        )" )
SQL.ADD("       ) ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif

SQL.ADD("  Union All ")

*** SELECCIONO SWAPS DE TIPO DE CAMBIO
*** Selecciono operaciones con Vto Simple *****
SQL.ADD("Select 2 Orden,          O.Vehiculo1,             O.FechaCargaSys,            O.Cliente1,              O.NrOperacion, ")
SQL.ADD("       O.Especie,        O.ContraEspecie,         O.FechaOp,                  O.FechaEj FVto,          O.FechaOp2 FInicio, ")
SQL.ADD("       O.FechaEj FFin,   O.Cantidad ResidualV,    O.TotalBrutoCli1 ResidualC, O.Precio3 VTasa,         O.TotalGanancias CTasa, ")
SQL.ADD("       O.Spread VSpread, O.TotalNetoCli2 CSpread, O.TotalIntereses VTotInt,   O.InteresesCorr CTotInt, O.TipoOp, ")
SQL.ADD("       O.RB9,            O.RB8,                   O.TotalAux3,                O.TotalBrutoCli2,        O.FechaPago, ")
SQL.ADD("       0 Cantidad5,      0 Cantidad6,             0 Cuotas1,                  O.RB5,                   O.FechaOp2 FInicioC ")
SQL.ADD("  from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.Especie<>O.ContraEspecie ")
SQL.ADD("   AND (TipoOp IN ('DTSFV','DTSFF','DTSVV','DTSFVV') ")
SQL.ADD("        and O.FechaOp2<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("        and O.FechaEj>='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("       ) ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif

SQL.ADD("  Union All ")

*** Selecciono operaciones con Vto Multiple
SQL.ADD("Select 2 Orden,          O.Vehiculo1,           O.FechaCargaSys,       O.Cliente1,                                                                                       O.NrOperacion, ")
SQL.ADD("       O.Especie,        O.ContraEspecie,       O.FechaOp,             CASE O.TipoOp WHEN 'DTSFVX' THEN O.FechaEx2 WHEN 'DTSNFV' THEN O.FechaEx2 ELSE C.Fecha2 END FVto, C.Fecha1 FInicio, ")
SQL.ADD("       C.Fecha2 FFin,    C.Cantidad1 ResidualV, C.Cantidad2 ResidualC, C.Precio1 VTasa,                                                                                  C.Precio2 CTasa, ")
SQL.ADD("       C.Total3 VSpread, C.Total4 CSpread,      C.Cantidad3 VTotInt,   C.Cantidad4 CTotInt,                                                                              O.TipoOp, ")
SQL.ADD("       O.RB9,            O.RB8,                 O.TotalAux3,           O.TotalBrutoCli2,                                                                                 C.Fecha3 FechaDePago, ")
SQL.ADD("       C.Cantidad5,      C.Cantidad6,           O.Cuotas1,             O.RB5,                                                                                            C.Fecha5 FInicioC ")
SQL.ADD(" from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("   AND O.Especie<>O.ContraEspecie ")
SQL.ADD("   and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM') ")
SQL.ADD("         and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("         and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("        ) ")
SQL.ADD("        or ")
SQL.ADD("        (TipoOp IN ('DTSNFV') ")
SQL.ADD("         and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("        )")
SQL.ADD("       ) ")
if NoVacio(Dialogo.Lista1)
  SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif

SQL.ADD("Union All ")

SQL.ADD("Select 1 Orden,          O.Vehiculo1,             O.FechaCargaSys,       O.Cliente1,                 O.NrOperacion, ")
SQL.ADD("       O.Especie,        O.Especie ContraEspecie, O.FechaOp,             C.Fecha2 FVto,              C.Fecha1 FInicio, ")
SQL.ADD("       C.Fecha2 FFin,    C.Cantidad1 ResidualV,   C.Cantidad2 ResidualC, C.Precio1 VTasa,            C.Precio2 CTasa, ")
SQL.ADD("       C.Total3 VSpread, C.Total4 CSpread,        C.Cantidad3 VTotInt,   C.Cantidad4 CTotInt,        O.TipoOp, ")
SQL.ADD("       '1' as RB9,       O.RB8,                   O.TotalAux3,           O.TotalAux3 TotalBrutoCli2, C.Fecha3 FechaDePago, ")
SQL.ADD("       C.Cantidad5,      C.Cantidad6,             O.Cuotas1,             O.RB8 as RB5,               C.Fecha5 FInicioC ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD("   and TipoOp IN ('DTCAP','DTFLO') ")
SQL.ADD("   and C.Fecha1<='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and C.Fecha2>'"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" order by 1,2,3 ")

Recorrer SQL

   ** Si NO es consolidado y cambia el orden (Vto simple o Vto Multiple)
   if [FBN['Orden'] <> Val(zt1)]
      if Val(zt3)=0
         AgregarMarco(a:Val(zt4)..Val(co1)-2:fac,2,2)
         AgregarMarco(Val(co1)-1:Val(zt4)..Val(co1):fac,2,0)
         ACT(o:fac+1, 'Total '~IIF(Dialogo.Radio2=0,'ARP','USD') )
         
         ACN(p:fac+1, IIf(VAL(ZT1)=1,Val(pp1)) )
         ACN(q:fac+1, Val(qq1) )
         ACN(s:fac+1, IIf(VAL(ZT1)=1,Val(ss1)) )
         ACN(t:fac+1, Val(tt1) )
         *ACN(v:fac+1, Val(vv1) )
         
         ** Inicializo variables de suma
         ACN(pp1,0)
         ACN(qq1,0)
         ACN(ss1,0)
         ACN(tt1,0)
         ACN(uu1,0)
         ACN(vv1,0)

         AgregarMarco(o:fac+1..t:fac+1,2,2)
         AgregarMarco(u:fac+1..v:fac+1,2,0)
         SetFont(o:fac+1..v:fac+1,1)
         SetFont(a:Val(zt4)..Val(co1):fac,2)
         FormatoCeldas(n:Val(zt4)..o:fac,Exe('F7'))
         FormatoCeldas(j:Val(zt4)..k:fac,Exe('F3'))
         FormatoCeldas(p:Val(zt4)..q:fac,Exe('F3'))
         FormatoCeldas(r:Val(zt4)..r:fac,Exe('F0'))
         FormatoCeldas(s:Val(zt4)..v:fac+1,Exe('F2'))
         SetFilaActual(fac+3)
      endif
      ACN(zt3,1)
      ACT(a:fac, 'SWAPS DE '~IIF(FBN['Orden']=1,Val(zz1),Val(zz2)) )
      AgregarMarco(a:fac..c:fac,2,0,Exe('COLOR6'))
      SetFont(a:fac..c:fac,1)
      SetFilaActual(fac+2)
   endif

   ** Si cambia el orden y (es la primera vez o No es consolidado)
   if [FBN['Orden'] <> Val(zt1)] y [Val(zt3)=1]
      if FBN['Orden'] = 1
          ACN(SW1,1)
      else
          ACN(SW1,0)
      endif
      ACN(zt1,FBN['Orden'])
      ACN(zt3,0)
      (.'TITIRSA1'.)
      ACN(zt4,fac)
   endif

   if Not EqStr(FBN['Especie'],Val(es1))
      * az1: Cotizacion 
       ACN(az1,CotizacionC(fbn['Especie'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
       ACT(es1, FBN['Especie'])
   endif

   if Not EqStr(FBN['ContraEspecie'],Val(es2))
      * az2: Cotizacion Contraparte
       ACN(az2,CotizacionC(fbn['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
       ACT(es2, FBN['ContraEspecie'])
   endif

   ACT(a:fac, FBN['Cliente1'] )
   ACT(b:fac, FBN['FechaCargaSys'] )
   ACT(c:fac, FBN['FechaOp'] )
   ACT(d:fac, FBN['FVto'] )

   ** Si es una op de Venc. Mult. la fecha vto anterior no me sirve, tengo que tomar la fecha fin de la ultima cuota
   if Incluido(FBN['TipoOp'], 'DTSFVM|DTSFFM|DTSVVM|DTCAP|DTFLO')
      ACT(d:fac, SQL("SELECT Fecha2 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~FBN['NrOperacion']~"' and NrCuota="~FBN['Cuotas1']) )

      AsignarLink(a:fac,'DESWAP',NrOPeracion1=FBN['NrOperacion'])

      LinkearHoja('DESWAP',1,NrOPeracion1=FBN['NrOperacion'])
      ACN(u:fac, LinkH(1, ck1))
      ACN(v:fac, LinkH(1, ck2))
      message('a '~fstr(val(v:fac),0,2))
      CerrarHoja('DESWAP',1,NrOPeracion1=FBN['NrOperacion'])
   endif

   ** Si es una op que posee cuotas, asigno link de detalle 
   if Incluido(FBN['TipoOp'], 'DTSFVM|DTSFFM|DTSVVM|DTSFVX|DTSNFF|DTSNFV|DTSNVV|DTCAP|DTFLO')
      AsignarLink(a:fac,'DESWAP',NrOPeracion1=FBN['NrOperacion'])
      LinkearHoja('DESWAP',1,NrOPeracion1=FBN['NrOperacion'])
      ACN(u:fac, LinkH(1, ck1))
      ACN(v:fac, LinkH(1, ck2))
      message('b '~fstr(val(v:fac),0,2))
      CerrarHoja('DESWAP',1,NrOPeracion1=FBN['NrOperacion'])
   endif

   ACT(e:fac, FBN['Especie'] )
   ACT(f:fac, FBN['ContraEspecie'] )
   ACT(g:fac, FBN['NrOperacion'] )
   ACLO(g:fac, FBN['NrOperacion'] )
   ACT(h:fac, FBN['FInicio'] )
   ACT(i:fac, FBN['FFin'] )
   ACN(j:fac, FBN['ResidualV'] )
   ACN(k:fac, FBN['ResidualC'] )      
   ACN(l:fac, FBN['Cantidad6'] )
   ACN(m:fac, FBN['Cantidad5'] )
   ACN(n:fac, (FBN['VTasa']+FBN['VSpread']) )
   ACN(o:fac, (FBN['CTasa']+FBN['CSpread']) )
   ACN(p:fac, FBN['CTotInt'] )
   ACN(q:fac, FBN['VTotInt'] )
   ACN(r:fac, FACTORDIAS2(FBN['FInicio'],Dialogo.Fecha1+1,FBN['RB8']+1))

   ** Calculo intereses devengados
   *- Interes Devengado a Recibir -> Day Count de la contraparte
   ACN(s:fac, IIF(FBN['RB9']=0,((FBN['ResidualC']*(FBN['CTasa']+FBN['CSpread']))/100)*FACTORDIAS(FBN['FInicio'],Dialogo.Fecha1+1,FBN['RB5']+1),IIF(FBN['CTasa']>0,((FBN['ResidualC']*(FBN['CTasa']+FBN['CSpread']))/100)*FACTORDIAS(FBN['FInicio'],Dialogo.Fecha1+1,FBN['RB5']+1),0)) )

   *- Interes Devengado a Pagar  -> Day Count de la Vehiculo
   ACN(t:fac, IIF(FBN['RB9']=0,((FBN['ResidualV']*(FBN['VTasa']+FBN['VSpread']))/100)*FACTORDIAS(FBN['FInicio'],Dialogo.Fecha1+1,FBN['RB8']+1),IIF(FBN['VTasa']>0,((FBN['ResidualV']*(FBN['VTasa']+FBN['VSpread']))/100)*FACTORDIAS(FBN['FInicio'],Dialogo.Fecha1+1,FBN['RB8']+1),0)) )
   if Val(SW1)=0
      ** Calculo Tipo de Cambio si estoy en swaps de tipo de cambio
      ACN(w:fac, IIF(EqStr(Modo(FBN['Especie'],FBN['ContraEspecie']),'DIR'),FBN['ResidualC']/FBN['ResidualV'],FBN['ResidualV']/FBN['ResidualC']) )
      *ACN(v:fac, FBN['VTotInt'] )
      *ACN(u:fac, FBN['CTotInt'] )      
      SCN(uu1, FBN['CTotInt']*Val(az2) )
      SCN(vv1, FBN['VTotInt']*Val(az1) )      
   else
      *ACN(v:fac, FBN['CTotInt']-FBN['VTotInt'] )
      *SCN(vv1, Val(v:fac) )      
   endif

   ** En el caso de que sea una op Mult. Venc., tengo que tomar la cuota vigente del vehiculo y de la contraparte (las dos por separado).
   ** La cuota del vehiculo ya la tome en el select superior, ahora seleccionar algunos datos de la cuota vigente de la contraparte
   ** y los sobreescribo sobre los que ya estan
   ACN(fi1,fac)
   SQL.ADD("Select C.Fecha6 FFin,       C.Cantidad2 ResidualC, C.Precio2 CTasa,                                                                C.Total4 CSpread, ")
   SQL.ADD("       C.Cantidad4 CTotInt, O.TipoOp,              CASE O.TipoOp WHEN  'DTCAP ' THEN  1 WHEN 'DTFLO ' THEN  1 ELSE  O.RB9 END RB9, O.RB8, ")
   SQL.ADD("       C.NrCuota ")
   SQL.ADD("  from "~DBO~".OPERACIONES O, "~DBO~".CUOTAS C ")
   SQL.ADD(" where C.NrOperacion = '"~Val(g:fac)~"' ")
   SQL.ADD("   and C.NrOperacion=O.NrOperacion " )
   SQL.ADD("   and ((TipoOp IN ('DTSFFM','DTSFVM','DTSFVX','DTSVVM','DTCAP','DTFLO') ")
   SQL.ADD("         and C.Fecha5<='"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD("         and C.Fecha6>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD("        ) ")
   SQL.ADD("        or ")
   SQL.ADD("        (TipoOp IN ('DTSNFV') ")
   SQL.ADD("         and C.Fecha6>'"~IdxDate(Dialogo.Fecha1)~"'")
   SQL.ADD("        )")
   SQL.ADD("       ) ")
   Recorrer SQL
     ACN(k:Val(fi1), FBN['ResidualC'] )
     ** Tasa
     ACN(o:Val(fi1), (FBN['CTasa']+FBN['CSpread']) )
     ** Intereses Totales
     ACN(p:Val(fi1), FBN['CTotInt'] )
     ** Intereses devengados
     * ACN(s:Val(fi1), IIF(FBN['RB9']=0,((FBN['ResidualC']*(FBN['CTasa']+FBN['CSpread']))/100)*FACTORDIAS(Val(h:Val(fi1)),Dialogo.Fecha1,FBN['RB8']+1),IIF(FBN['CTasa']>0,((FBN['ResidualC']*(FBN['CTasa']+FBN['CSpread']))/100)*FACTORDIAS(Val(h:Val(fi1)),Dialogo.Fecha1,FBN['RB8']+1),0)) )
   Proximo

   SetFilaActual(Val(fi1))
   SCN(pp1,Val(p:fac)*Val(az2) )
   SCN(qq1,Val(q:fac)*Val(az1) )
   SCN(ss1,Val(s:fac)*Val(az2) )
   SCN(tt1,Val(t:fac)*Val(az1) )  

Proximo

ifa
AgregarMarco(a:Val(zt4)..Val(co1):fac,2,2)
FormatoCeldas(n:Val(zt4)..o:fac,Exe('F5'))
FormatoCeldas(j:Val(zt4)..k:fac,Exe('F3'))
FormatoCeldas(p:Val(zt4)..q:fac,Exe('F3'))
FormatoCeldas(r:Val(zt4)..r:fac,Exe('F0'))
FormatoCeldas(s:Val(zt4)..v:fac+1,Exe('F2'))
SetFont(a:Val(zt4)..Val(co1):fac,2)
ACT(o:fac+1, 'Total '~IIF(Dialogo.Radio2=0,'ARP','USD') )
         
ACN(p:fac+1, IIf(VAL(ZT1)=1,Val(pp1)) )
ACN(q:fac+1, Val(qq1) )
ACN(s:fac+1, IIf(VAL(ZT1)=1,Val(ss1)) )
ACN(t:fac+1, Val(tt1) )
*ACN(v:fac+1, Val(vv1) )
*ACN(u:fac+1, IIf(VAL(ZT1)=1,Val(uu1)) )

If VAL(ZT1)<>1
   ACT(p:fac+1, ' ')
   ACT(s:fac+1, ' ')
   *ACT(u:fac+1, ' ')
   AgregarMarco(o:fac+1..o:fac+1,2,2)
   AgregarMarco(q:fac+1..q:fac+1,2,2)
   AgregarMarco(t:fac+1..t:fac+1,2,2)
   AgregarMarco(v:fac+1..v:fac+1,2,2)
Else
   AgregarMarco(o:fac+1..v:fac+1,2,2)
EndIf
SetFont(o:fac+1..v:fac+1,1)
if Val(SW1)=0
   FormatoCeldas(w:Val(zt4)..w:fac,Exe('F5'))
endif

SetFilaActual(fac+3)
ACT(a:fac, 'F X    F O R W A R D ' )
AgregarMarco(a:fac..b:fac,2,0,Exe('COLOR6'))
SetFont(a:fac..d:fac,1)

SetFilaActual(fac+2)

*- Selecciono las operaciones de cambios
ACT(a:FAC  , 'Numero')
ACT(a:FAC+1, 'Operacion')
ACT(b:FAC  , 'Fecha')
ACT(b:FAC+1, 'Concert')
ACT(c:FAC,   'Entidad')
ACT(d:FAC,   'Moneda ')
ACT(e:FAC  , 'Plazo')
ACT(e:FAC+1, 'Moneda')
ACT(f:FAC  , 'Vto')
ACT(f:FAC+1, 'Moneda')
ACT(g:FAC  , 'ContraEsp')
ACT(h:FAC  , 'Plazo')
ACT(h:FAC+1, 'ContraEs')
ACT(i:FAC  , 'Vto ')
ACT(i:FAC+1, 'ContraEs')
ACT(j:FAC  , 'Valor')
ACT(j:FAC+1, 'Nominal')
ACT(k:FAC  , 'Importe')
ACT(k:FAC+1, 'Bruto')
ACT(l:FAC  , 'Precio')
ACT(m:FAC  , 'Dias Reman')
ACT(m:FAC+1, 'a Recibir')
ACT(n:FAC  , 'Dias Reman')
ACT(n:FAC+1, 'a Entregar')
AgregarMarco(a:fac..n:fac+1,2,2,Exe('COLOR8'))
SetFont(a:fac..n:FAC+1,1)
AlinearCeldas(a:fac..n:fac+1, 'C')
Ifa

SQL.ADD(" Select O.* ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD("where O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and ((O.FechaVto >= O.FechaPago ")
SQL.ADD("        and O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("       ) ")
SQL.ADD("       or ")
SQL.ADD("       (O.FechaPago > O.FechaVto ")
SQL.ADD("        and O.FechaPago > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("       )")
SQL.ADD("      ) ")
SQL.ADD("  and O.TipoOp IN ('FXCT','FXVT') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
   SQL.ADD("and O.Vehiculo1 in ("~Pipe2Comillas(Val(zz6))~") ")
Endif
SQL.ADD(" order by 1 ")
Recorrer SQL 
  ACT(ba5, fbn('Especie'))   

  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACD(b:FAC, FBN['FechaOp'])
  ACT(c:FAC, FBN['Cliente1'])
  ACT(d:FAC, FBN['Especie'])
  ACN(e:FAC, FBN['Plazo'])
  ACD(f:FAC, FBN['FechaVto'])
  ACT(g:FAC, FBN['ContraEspecie'])
  ACN(h:FAC, FBN['Plazo2'])
  ACD(i:FAC, FBN['FechaPago'])
  ACN(j:FAC, FBN['Cantidad'])
  ACN(k:FAC, FBN['TotalBrutoCli1'])
  ACN(l:FAC, FBN['Precio1'])
  ACN(m:FAC, FBN['FechaVto']-Dialogo.Fecha1)
  ACN(n:FAC, FBN['FechaPago']-Dialogo.Fecha1)

  * Si la ContraEspecie no es USD convierte para sumar en el informe de totales por vehiculo
  ACN(sz2, CotizacionC(fbn('ContraEspecie'),,,,Dialogo.Fecha1,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )

  SCN(tj1, Val(j:fac)*VAL(sz1))
  SCN(tk1, Val(k:fac)*VAL(sz2))

  SetFont(a:fac..p:FAC,2)
  FormatoCeldas(e:fac..e:fac,"0")
  FormatoCeldas(h:fac..h:fac,"0")
  FormatoCeldas(l:fac..l:fac,EXE('F6'))
  FormatoCeldas(m:fac..n:fac,"0")
Proximo 

SetFilaActual(fac+2)
ACN(j:FAC, val(tj1))
ACN(k:FAC, val(tk1))
SetFont(j:fac..k:FAC,2)
ACO(10,10)
ACO(11,17)
ACO(12,10)
ACO(13,17)
ACO(16,15)
ACO(17,9)
ACO(19,15)
ACO(20,9)
ACO(21,10)
ACO(22,10)
ACO(23,5)

SetFilaActual(fac+3)
LimitesVision(z:fac+1)
Impresion(1,2)
