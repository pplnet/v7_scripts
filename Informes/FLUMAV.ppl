CrearDialogo
  Fecha1 : 'F.Desde'     ;1;1;;;;;;;Fsys
  Fecha2 : 'F.Hasta'     ;2;1;;;;;;;Fsys+7
  Cliente1:'Cliente'     ;2;2;;;;;;;
  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Liquidacion con MAV')
ACT(a2, 'D.Fecha: '~Dialogo.Fecha1)
ACT(c2, 'H.Fecha: '~Dialogo.Fecha2)
ACT(c3, 'Especie:'~Dialogo.Especie1)

ACT(a6, 'Fecha')
ACT(b5, 'Liquidacion 3ros')
ACT(b6, 'Compras')
ACT(c6, 'Ventas')
ACT(d6, 'Derechos')
ACT(e6, 'IVA')
ACT(f6, 'Acred.3ros.')
ACT(g6, 'Total 3ros')

ACT(h5, 'Liquidacion CP')
ACT(h6, 'Compras')
ACT(i6, 'Ventas')
ACT(j6, 'Derechos')
ACT(k6, 'IVA')
ACT(l6, 'Acred.CP')
ACT(m6, 'Total CP')

ACT(n6, 'Tot.General')


SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and ((FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp<'"~IdxDate(Dialogo.Fecha2+1)~"') or ")
SQL.ADD("(FechaOp2 >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp2<='"~IdxDate(Dialogo.Fecha2+1)~"') or")
SQL.ADD("(FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto2<='"~IdxDate(Dialogo.Fecha2+1)~"'))")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"'")
endif
SetFilaActual(6)

Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
  ifa
  ACD(a:fac, Dialogo.Fecha1+&i-1)
proximo

recorrer SQL
  Let &Delta 0
  if EqStr(fbn('Cliente1'),VAR('VEHICULODE'))
    Let &Delta 6
  endif
  if fbn('FechaOp2')>=Dialogo.Fecha1 y fbn('FechaOp2')<Dialogo.Fecha2+1
    Let &Fila 6+(fbn('FechaOp2')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
      SCN(b+&Delta:&Fila, fbn('Cantidad'))
    else
      SCN(c+&Delta:&Fila, fbn('Cantidad'))
    endif
    SCN(d+&Delta:&Fila, fbn('TotalDerechos'))
    SCN(e+&Delta:&Fila, fbn('TotalIVA'))
  endif
  if fbn('FechaVto2')>=Dialogo.Fecha1 y fbn('FechaVto2')<Dialogo.Fecha2+1
  Let &Fila 6+(fbn('FechaVto2')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
      SCN(f+&Delta:&Fila, fbn('TotalBrutoCli1'))
    endif
  endif
  
*  if fbn('FechaOp')>=Dialogo.Fecha1 y fbn('FechaOp')<Dialogo.Fecha2+1
*    Let &Fila 6+(fbn('FechaOp')-Dialogo.Fecha1+1)
*    If Incluido(fbn('TipoOp'),'DDC')
*    SCN(j:&Fila, fbn('Cantidad'))
*    else
*    SCN(k:&Fila, fbn('Cantidad'))
*    endif
*  endif
proximo

setfilaactual(6)
Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
  ifa
  ACN(g:fac, Val(c:fac)-Val(b:fac)-Val(d:fac)-Val(e:fac))
  * sacamos la columna de acreditacion (F) del total
  ACN(m:fac, Val(i:fac)-Val(h:fac)-Val(j:fac)-Val(k:fac))
  * sacamos la columna de acreditacion (L) del total
  ACN(n:fac, Val(g:fac)+Val(m:fac))
  
  if NoVacio(h:fac)
  ACL(h:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1= VAR('VEHICULODE'), Radio1=1)
  endif  
  if NoVacio(i:fac)
  ACL(i:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1= VAR('VEHICULODE'), Radio1=2)
  endif  
  if NoVacio(l:fac)
  ACL(l:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1= VAR('VEHICULODE'), Radio1=5)
  endif 
 
   if NoVacio(b:fac)
    ACL(b:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=1)
  endif  
  if NoVacio(c:fac)
    ACL(c:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=2)
  endif  
  if NoVacio(j:fac)
    ACL(f:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=5)
  endif  
 
  *  if NoVacio(k:fac)
*    ACL(k:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=4)
*  endif  
*  if NoVacio(e:fac)
*    ACL(e:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=5)
*  endif  
*  if NoVacio(f:fac)
*    ACL(f:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=6)
*  endif  
