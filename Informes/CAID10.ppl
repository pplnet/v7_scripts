ModoReproceso(ConDialogo)
CrearDialogo
  Vehiculo2  : "Grupo"                   ;;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1     : "Vehiculo"                ;;;;Vacio(Dialogo.Vehiculo2);;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS Where TipoVehiculo = 'DIV'"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"));;;;;
  Especie1   : "Especie"                 ;;;
  Book1      : "Book"                    ;;; 
  Fecha1     : "F.Desde"                 ;;;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2     : "F.Hasta"                 ;5;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys+365
  Radio1     : "Expresado|Pesos|Dolares" ;;1;;;;;;;0
  Radio2     : "Consolidado|Si|No"       ;;;;;;;;;1 
FinDialogo

If Not Ok
  Cancelar
EndIf
 
***--- Vehiculos permitidos por el usuario
If NoVacio(Dialogo.Lista1)
   ACT(zz6,Dialogo.Lista1)
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
EndIf

***---ARP = Var('MONELOCA')
***---USD = Var('MONEEXTR')
ACT(ML:1, Var('MONELOCA'))
ACT(ME:1, Var('MONEEXTR'))
ACT(im:1, iif(Dialogo.Radio1=0,Val(ml:1),Val(me:1)))
ACN(fi:1, 0)
ACN(ff:1, 0)

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(4)

ACT(i:2,'Fecha : '~Var('FECHASYS'))
SetFont(i:2..i:2,1)

ACT(a:FAC, "Caida de Prestamos en Especies")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

******------ Encabezado ------******

If NoVacio(Dialogo.Vehiculo2)
  ACT(a:FAC+1, 'Grupo : '~Dialogo.Vehiculo2)
Else
  If NoVacio(Dialogo.Lista1)
    ACT(a:FAC+1, 'Vehiculo/s : '~Dialogo.Lista1) 
  Else 
    ACT(a:FAC+1, 'Vehiculo : Todos')
  Endif
Endif

If NoVacio(Dialogo.Especie1)
  ACT(a:FAC+2, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
  ACT(a:FAC+2, 'Especie : Todos')
EndIf

If NoVacio(Dialogo.Book1)
  ACT(a:FAC+3, 'Book : '~Dialogo.Book1~' '~BuscarCampo('Books','Descripcion','Codigo',Dialogo.Book1))
Else
  ACT(a:FAC+3, 'Book : Todos')
EndIf

ACT(a:FAC+4, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+5, 'Fecha Hasta: '~Dialogo.Fecha2)
ACT(a:FAC+6, 'Expresado en '~iif(Dialogo.Radio1 = 0,'Pesos','Dolares'))
ACT(a:FAC+7, 'Consolidado '~iif(Dialogo.Radio2 = 1,'No','Si'))

SetFont(a:fac..N:FAC+7,2)

SetFilaActual(FAC+9)

ACT(a:FAC, 'Vehiculo')
ACT(b:FAC, '    Cliente')
ACT(c:FAC, 'Especie')
ACT(d:FAC, 'Moneda')
ACT(e:FAC, 'Monto Amort. V.N.')
ACT(f:FAC, 'Precio')
ACT(g:FAC, 'Monto Amort. Val.')
ACT(h:FAC, ' Tasa')
ACT(i:FAC, 'Tipo de')
ACT(j:FAC, ' FechaOP')
ACT(k:FAC, 'FechaVto')
ACT(l:FAC, 'Plazo')
ACT(m:FAC, '  Monto Final')
ACT(n:FAC, 'Total x Dia')
ACT(o:FAC, 'Tipo Oper')
ACT(p:FAC, 'Num. Oper')

ACT(g:FAC+1, 'Moneda Orig.')
ACT(i:FAC+1, ' Tasa')
ACT(l:FAC+1, 'Rem.')
ACT(m:FAC+1, 'Moneda Orig.')
ACT(n:FAC+1, ' en '~iif(Dialogo.Radio1=0,'Pesos','Dolares'))

AlinearCeldas(a:FAC..p:FAC+1,'I')
SetFont(a:fac..p:FAC+1,2)
AgregarMarco(a:FAC..p:FAC+1,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)
ACN(va:1, FAC)
If Dialogo.Radio2=1
    SQL.ADD("Select O.Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion, ")
Else
    SQL.ADD("Select 'Consolidado' Vehiculo1, O.Especie, O.FechaOp, O.TipoOp, O.NrOperacion, ")
EndIf
SQL.ADD("C.Fecha2 Vto, C.Cantidad1 Cant,L.RazonSocial, O.TipoTasa, C.Cantidad3 Interes, C.Precio2 Tasa,O.TotalBrutoCli1, ")
SQL.ADD(" O.TotalNetoCli1, O.ContraEspecie, O.TotalBrutoCli2, O.Book1, O.Vehiculo1 Vehiculo, O.FechaPago, C.Precio4 Sprd, O.MB3, ")
SQL.ADD("C.Cantidad2, C.Precio8, O.TipoOp, C.Total7, C.Total2 ")
SQL.ADD(" from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O, "~DBO~".CLIENTES L ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and L.Codigo = O.Cliente1 ")
***---SQL.ADD(" and L.Jerarquia NOT LIKE '"~VAR('JERVINCUL')~"%' ")
SQL.ADD(" and O.TipoOp In ('SEPTMV','SEPVMV') ")
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
ELSE
  If NoVacio(Dialogo.Vehiculo2)
    SQL.ADD("and O.Vehiculo1 in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo2))~")")
  EndIf
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and  C.Fecha2 <= '"~IdxDate(Dialogo.Fecha2)~"' ")
If NoVacio(Dialogo.Book1)
  SQL.ADD(" and O.Book1 = '"~Dialogo.Book1~"' ")
EndIf
Recorrer SQL
  If Val(ac:1) <> FBN['Vto']
    If val(ac:2) = 1
      ACN(n:fac-1,val(ac:3))   
      ACN(AC:3, 0)
      SetFont(n:FAC-1..n:FAC-1,2)
      FormatoCeldas(n:fac-1..n:fac-1,Exe('F2'))
    EndIF
    ACD(ac:1, FBN['Vto'])
  EndIf
  ***--- Corte y Totales por Vehiculo
  If Not EqStr(FBN['Vehiculo1'], Val(z:2)) Y Not CeldaVacia(Z:2)
    SetFilaActual(FAC+2)
    ACT(a:FAC, 'Vehiculo')
    ACT(b:FAC, '    Cliente')
    ACT(c:FAC, 'Especie')
    ACT(d:FAC, 'Moneda')
    ACT(e:FAC, 'Monto Amort. V.N.')
    ACT(f:FAC, 'Precio')
    ACT(g:FAC, 'Monto Amort. Val.')
    ACT(h:FAC, ' Tasa')
    ACT(i:FAC, 'Tipo de')
    ACT(j:FAC, ' FechaOP')
    ACT(k:FAC, 'FechaVto')
    ACT(l:FAC, 'Plazo')
    ACT(m:FAC, '  Monto Final')
    ACT(n:FAC, 'Total x Dia')
    ACT(o:FAC, 'Tipo Oper')
    ACT(p:FAC, 'Num. Oper')
    ACT(g:FAC+1, 'Moneda Orig.')
    ACT(i:FAC+1, ' Tasa')
    ACT(l:FAC+1, 'Rem.')
    ACT(m:FAC+1, 'Moneda Orig.') 
    ACT(n:FAC+1, ' en '~iif(Dialogo.Radio1=0,'Pesos','Dolares'))
    ACT(MN:1, FBN('ContraEspecie'))
    AlinearCeldas(a:FAC..p:FAC+1,'I')
    SetFont(a:fac..p:FAC+1,2)
    AgregarMarco(a:FAC..p:FAC+1,2,0,Exe('COLOR'))
    SetFilaActual(FAC+2)
  EndIf  
  ACT(a:FAC, Copy(BuscarCampo('Vehiculos','Descripcion','Codigo', FBN['Vehiculo']),1,23))
  ACT(b:FAC, Copy(FBN['RazonSocial'],1,28))
  ACT(c:FAC, FBN['Especie'])
  ACT(d:FAC, FBN['ContraEspecie'])
  ACN(e:FAC, FBN['Cant'])
  ACN(f:FAC, FBN['Precio8'])
  ACN(g:FAC, FBN['Total7'])
  ACN(h:FAC, FBN['Tasa'] + FBN['Sprd'] )
  ACT(i:FAC, FBN['TipoTasa'])
  ACD(j:FAC, FBN['FechaOp'])
  ACD(k:FAC, FBN['Vto'])
  ACN(m:FAC, FBN['Total2'])
  ACT(o:FAC, FBN['TipoOp'])
  ACT(p:FAC, FBN['NrOperacion'])
  ACLO(p:FAC, FBN['NrOperacion'])
  ACN(l:FAC, Val(k:FAC)-Fsys)
  ACN(CT:1, CotizacionC(FBN['ContraEspecie'],,,,Fsys,1,SI,Val(im:1)))
  SCN(ac:3, val(m:fac)* Val(CT:1))  
  ACN(g:FAC, Val(e:FAC) * Val(f:FAC))
  IF Not Eqstr(Val(MN:1), Val(IM:1))
     ACN(BD:1, 0)
     Recorrer&k Val(FI:1), Val(FF:1)
         IF Eqstr(Val(T:&k), Val(MN:1))
            ACN(BD:1, 1)
            Break
         ENDIF
     Proximo
     IF Val(BD:1) = 0
         SCN(FF:1, 1)
         ACT(T:Val(FF:1), Val(MN:1))
         ACN(U:Val(FF:1), Val(CT:1))
     ENDIF
  ENDIF
  ACN(ac:2,1)
  SetFont(a:FAC..p:FAC,1)
  FormatoCeldas(l:fac..l:fac,"0")
  FormatoCeldas(g:fac..g:fac,Exe('F2'))
  FormatoCeldas(m:fac..n:fac,Exe('F2'))
  FormatoCeldas(f:fac..f:fac,Exe('F8'))
  ACT(z:2, FBN['Vehiculo1'])     
Proximo
If val(ac:2) = 1
  ACN(n:fac,val(ac:3))   
  SetFont(n:FAC..n:FAC,2)
  FormatoCeldas(n:fac..n:fac,Exe('F2'))
EndIf
Ifa
SetFilaActual(FAC+2)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Cotizacion')
SetFont(a:FAC..b:FAC,2)
AgregarMarco(a:FAC..b:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)
ACN(vv:1, FAC)
Recorrer&j Val(fi:1)+1, val(ff:1)
  ACT(a:FAC, Val(T:&k)) 
  ACN(b:FAC, Val(U:&k))
  IFA
Proximo
AgregarMarco(a:Val(vv:1)..b:FAC-1,2,0)
FormatoCeldas(b:Val(vv:1)..b:FAC-1,EXE('F8'))
FormatoCeldas(h:Val(va:1)..h:FAC-1,EXE('F6'))
ACO(1,10)
ACO(2,18)
ACO(3,9) 
ACO(5,11)
ACO(6,9)
ACO(7,11)
ACO(8,7)
ACO(9,7)
ACO(10,8)
ACO(11,9)
ACO(12,6)
ACO(13,10)
ACO(14,7)
AlinearCeldas(b:FAC,'I') 
Impresion(1,2)
ACT(a:FAC+1, 'FIN DE LISTADO')
SetPrintFit(3,80)
SetFont(a:FAC+1, 2)
LimitesVision(p:FAC)
RangoTitulo(a1..n:FAC, 12)
