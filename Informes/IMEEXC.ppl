SetFont(a:fac..c:fac, 2)
AlinearCeldas(a:fac..c:fac, 'C')

SetFilaActual(Fac)

ACN(ZZ:1,Fac)
SQL.ADD("Select NrOperacion,FechaModificacion,Descripcion ")
SQL.ADD(" From  "~DBO~".IMEOPERBILEXT ")
SQL.ADD(" Where FechaProcesamiento='"~IdxDate(Dialogo.Fecha1)~"' and Estado <> 'OK' ")
Recorrer SQL
   ACT(A:Fac,FBN['NrOperacion'])
   ACT(B:Fac,FBN['FechaModificacion'])
   ACT(C:Fac,FBN['Descripcion'])
Proximo

SetFont(a:Val(ZZ:1)+1..c:fac, 1)

SetFilaActual(Fac+3)

If(No)
    ACT(B:fac, 'IME Bilateral Captura Bloomberg')
    SetFont(B:fac, 5)

    SetFilaActual(fac+2)

    ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
    SetFont(a:fac, 2)

    SetFilaActual(fac+1)

    ACT(A:Fac,'Número Operación')
    ACT(B:Fac,'Fecha Modificación')
    ACT(C:Fac,'Descripción')
    AgregarMarco(A:fac..C:fac,0,0,EXE('COLOR'))
    SetFont(a:fac..c:fac, 2)
    AlinearCeldas(a:fac..c:fac, 'C')

    SetFilaActual(Fac)

    ACN(ZZ:1,Fac)
    SQL.ADD("Select NrOperacion,FechaModificacion,Descripcion ")
    SQL.ADD(" From  "~DBO~".IMEOPERTOOMS ")
    SQL.ADD(" Where FechaProcesamiento='"~IdxDate(Dialogo.Fecha1)~"' and Estado <> 'OK' ")
    Recorrer SQL
       ACT(A:Fac,FBN['NrOperacion'])
       ACT(B:Fac,FBN['FechaModificacion'])
       ACT(C:Fac,FBN['Descripcion'])
    Proximo

    SetFont(a:Val(ZZ:1)+1..c:fac, 1)

    SetFilaActual(Fac+2)
EndIf
If(Si)
    ACT(B:fac, 'IME Bilateral Garantizado Captura OPERSECEXT (SENEBI/SISTACO)')
    SetFont(B:fac, 5)

    SetFilaActual(fac+2)

    ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
    SetFont(a:fac, 2)

    SetFilaActual(fac+1)

    ACT(A:Fac,'Número Operación')
    ACT(B:Fac,'Fecha Modificación')
    ACT(C:Fac,'Descripción')
    AgregarMarco(A:fac..C:fac,0,0,EXE('COLOR'))
    SetFont(a:fac..c:fac, 2)
    AlinearCeldas(a:fac..c:fac, 'C')

    SetFilaActual(Fac)

    ACN(ZZ:1,Fac)
    SQL.ADD("Select NrOperacion,FechaModificacion,Descripcion ")
    SQL.ADD(" From  "~DBO~".IMEOPERSECEXT ")
    SQL.ADD(" Where FechaProcesamiento='"~IdxDate(Dialogo.Fecha1)~"' and Estado = 'ERROR' ")
    Recorrer SQL
       ACT(A:Fac,FBN['NrOperacion'])
       ACT(B:Fac,FBN['FechaModificacion'])
       ACT(C:Fac,FBN['Descripcion'])
    Proximo

    SetFont(a:Val(ZZ:1)+1..c:fac, 1)

    SetFilaActual(Fac+2)
EndIf


ACT(a:fac,'FIN DEL INFORME')
SetFont(a:fac, 2)

LimitesVision(C:Fac+1)

ACO(1,11)
ACO(2,12)
ACO(3,90)
