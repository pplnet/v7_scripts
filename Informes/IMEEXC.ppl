CrearDialogo
  Fecha1:   'Fecha'   ;;;;;;;;;FSys
FinDialogo

If Not Ok
   Cancelar
Endif


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')
CrearFont(5, 'Arial,12,B')

SetFilaActual(1)

***************************************************MAC     20/07/2023 Se agrega IME Garantizado Captura (SDIB)
ACT(A:fac, 'IME Excepciones ')
SetFont(A:fac, 5)

SetFilaActual(Fac+3)



ACT(B:fac, 'IME Garantizado Captura (SDIB) ')
SetFont(B:fac, 5)

SetFilaActual(fac+2)

ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
SetFont(a:fac, 2)

SetFilaActual(fac+1)

ACT(A:Fac,'Número Orden')
ACT(B:Fac,'Fecha Modificación')
ACT(C:Fac,'Descripción')
AgregarMarco(A:fac..C:fac,0,0,EXE('COLOR'))
SetFont(a:fac..c:fac, 2)
AlinearCeldas(a:fac..c:fac, 'C')

SetFilaActual(Fac)

ACN(ZZ:1,Fac)
SQL.ADD("Select NrOrden,FechaModificacion,Descripcion ")
SQL.ADD(" From  "~DBO~".IMEOFERTASORD ")
SQL.ADD(" Where FechaProcesamiento='"~IdxDate(Dialogo.Fecha1)~"' and Estado = 'ERROR' ")
Recorrer SQL
   ACT(A:Fac,FBN['NrOrden'])
   ACT(B:Fac,FBN['FechaModificacion'])
   ACT(C:Fac,FBN['Descripcion'])
Proximo

SetFont(a:Val(ZZ:1)+1..c:fac, 1)

***************************************************

SetFilaActual(Fac+3)


If(No)
    ACT(B:fac, 'IME Bilateral Envío SIAF - Mercado (SENEBI)')
    SetFont(B:fac, 5)

    SetFilaActual(fac+2)

    ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
    SetFont(a:fac, 2)

    SetFilaActual(fac+1)

    ACT(A:Fac,'Número Operación')
    ACT(B:Fac,'Fecha Modificación')
    ACT(C:Fac,'Descripción')
    AgregarMarco(A:fac..C:fac,0,0,EXE('COLOR'))
    SetFont(a:fac..c:fac, 2)
    AlinearCeldas(a:fac..c:fac, 'C')

    SetFilaActual(Fac)

    ACN(ZZ:1,Fac)
    SQL.ADD("Select NrOperacion,FechaModificacion,Descripcion ")
    SQL.ADD(" From  "~DBO~".IMEOFERTASENEBI ")
    SQL.ADD(" Where FechaProcesamiento > '"~IdxDate(Dialogo.Fecha1)~"' and FechaProcesamiento < '"~IdxDate(Dialogo.Fecha1+1)~"' and Estado <> 'OPERADA' ")
    Recorrer SQL
       ACT(A:Fac,FBN['NrOperacion'])
       ACT(B:Fac,FBN['FechaModificacion'])
       ACT(C:Fac,FBN['Descripcion'])
    Proximo

    SetFont(a:Val(ZZ:1)+1..c:fac, 1)

    SetFilaActual(Fac+3)
EndIf


ACT(B:fac, 'IME Bilateral Captura OPERBILEXT (SENEBI)')
SetFont(B:fac, 5)

SetFilaActual(fac+2)

ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
SetFont(a:fac, 2)

SetFilaActual(fac+1)

ACT(A:Fac,'Número Orden')
ACT(B:Fac,'Fecha Modificación')
ACT(C:Fac,'Descripción')
