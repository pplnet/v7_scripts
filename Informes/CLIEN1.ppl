ModoReproceso(CONDIALOGO)
CrearDialogo
 Radio1:'Orden|Jerarquia|Codigo|R.Social|'  ;1;1;;;;;;;0
 Cliente3:'Desciende de:'  ;2;1;;;Dialogo.Radio1<>4;;;;
 Cliente1:'Desde Cli:'     ;2;1;;;Dialogo.Radio1=4;;;;
 Cliente2:'Hasta Cli:'     ;3;1;;;Dialogo.Radio1=4;;;;
 Radio2:'Tipo|Todos|Habilitados|DesHabilitados'    ;4;1;;;;;;;0
FinDialogo

if Not Ok
 Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACO( 1,10)
ACO( 2,10)
ACO( 3,55)
ACO( 4,25)
ACO( 5, 8)
ACO( 6,12)
ACO( 7,10)
ACO( 8,10)
ACO( 9,10)
ACO(10,10)
ACO(11,10)
ACO(12,15)
ACO(13,15)

SetFilaActual(1)
ACT(a:fac,'Informe General de Clientes')
SetFont(a:fac,3)

SetFilaActual(fac+2)

ACT(a:fac,'Orden:')
if Dialogo.Radio1=0
   ACT(b:fac,'Jerarquia')
endif
if Dialogo.Radio1=1
   ACT(b:fac,'Codigo')
endif
if Dialogo.Radio1=2
   ACT(b:fac,'Razon Social')
endif
SetFont(a:fac..b:fac+1,2)

SetFilaActual(fac+1)
ACT(a:fac,'Estado:')
if Dialogo.Radio2=0
   ACT(b:fac,'Todos')
endif
if Dialogo.Radio2=1
   ACT(b:fac,'Habilitados')
endif
if Dialogo.Radio2=2
   ACT(b:fac,'DesHabilitados')
endif
SetFont(a:fac..b:fac+1,2)

SetFilaActual(fac+2)

ACT(a:fac,  'Jerarquia')
ACT(b:fac,  'Codigo')
ACT(c:fac,  'Razon Social')
ACT(d:fac,  'Direccion')
ACT(e:fac,  'C.Postal')
ACT(f:fac,  'Localidad')
ACT(g:fac,  'Pais')
ACT(h:fac,  'Telefono')
ACT(i:fac,  'Fax')
ACT(j:fac,  'Of.Cuenta')
ACT(k:fac,  'F.Apertura')
ACT(l:fac,  'CUIT')
ACT(c:fac+1,'  E-Mail')
ACT(d:fac+1,'  Cond. IVA')
ACT(e:fac+1,'  Cond. Gan.')
ACT(f:fac+1,'  Ing.Brutos')
ACT(g:fac+1,'  DNRP')
ACT(h:fac+1,'  Imp.Internos')
ACT(i:fac+1,'  Persona')
ACT(j:fac+1,'  Status')
ACT(k:fac+1,'  F.Des.Habil.')
*AlinearCeldas(a:fac..l:fac+1,'C')
SetFont(a:fac..l:fac+1,2)
AgregarMarco(a:fac..l:fac,2,1,Exe('COLOR'))
AgregarMarco(c:fac+1..l:fac+1,2,1,Exe('COLOR'))
ACN(z:1,fac+1)

SetFilaActual(fac+1)
SQL.ADD("select Jerarquia,Codigo,RazonSocial,Direccion,Localidad,CodigoPostal,Telefono,")
SQL.ADD("       CUIT,CondicionIVA,CondicionGan,Status,FecDesHabilitacion,NrIngBrutos,")
SQL.ADD("       NrDNRP,ImpuestosInternos,Fax,Pais,DireccionEMail,Persona,OficialCuenta,")
SQL.ADD("       FechaApertura ")
SQL.ADD(" from "~DBO~".CLIENTES ")
SQL.ADD("where Jerarquia is not null ")
if Dialogo.Radio2=1
 SQL.ADD(" and Status='HAB' ")
endif
if Dialogo.Radio2=2
 SQL.ADD(" and Status='DES'")
endif
if NoVacio(Dialogo.Cliente1)
 SQL.ADD(" and Jerarquia like (select Substring(C.Jerarquia,1,Patindex('%000%',C.Jerarquia)-1)+'%'")
 SQL.ADD("                       from "~DBO~".CLIENTES C ")
 if Dialogo.Radio1  <>4
 SQL.ADD("                      where C.Codigo='"~Dialogo.Cliente3~"') ")
 else
 SQL.ADD("                      where C.Codigo='"~Dialogo.Cliente1~"') ")
 endif
endif
if Dialogo.Radio1=0
 SQL.ADD("order by Jerarquia")
endif
if Dialogo.Radio1=1
 SQL.ADD("order by Codigo")
endif
if Dialogo.Radio1=2
 SQL.ADD("order by RazonSocial")
endif

recorrer SQL
 ACT(a:fac,fbn('Jerarquia'))
 ACT(b:fac,fbn('Codigo'))
 ACT(c:fac,fbn('RazonSocial'))
 ACT(d:fac,fbn('Direccion'))
 ACT(e:fac,fbn('CodigoPostal'))
 ACT(f:fac,fbn('Localidad'))
 ACT(g:fac,fbn('Pais'))
 ACT(h:fac,fbn('Telefono'))
 ACT(i:fac,fbn('Fax'))
 ACT(j:fac,fbn('OficialCuenta'))
 if Vacio(fbn('FechaApertura'))
    ACT(k:fac,'')
 else
    ACT(k:fac,Fecha(fbn('FechaApertura'),'DD/MM/YYYY'))
 endif                  
 ACT(l:fac,fbn('CUIT'))
 ACT(c:fac+1,'  '~fbn('DireccionEMail'))
 ACT(d:fac+1,'  '~fbn('CondicionIVA'))
 ACT(e:fac+1,'  '~fbn('CondicionGan'))
 ACT(f:fac+1,'  '~fbn('NrIngBrutos'))
 ACT(g:fac+1,'  '~fbn('NrDNRP'))
 ACT(h:fac+1,'  '~fbn('ImpuestosInternos'))
 ACT(i:fac+1,'  '~fbn('Persona'))
 if EqStr(fbn('Status'),'HAB')
    ACT(j:fac+1,'  Habilitado')
    ColorCeldas(j:fac+1..j:fac+1,3)
 else
    ACT(j:fac+1,'  DesHabilitado')
    ColorCeldas(j:fac+1..j:fac+1,1)
 endif
 if Vacio(fbn('FecDesHabilitacion'))
    ACT(k:fac+1,'')
 else
    ACT(k:fac+1,ACT(k:fac+1,'  '~Fecha(fbn('FecDesHabilitacion'),'DD/MM/YYYY'))) 
 endif
 if EqStr(fbn('CondicionIVA'),'INS')
  ACT(d:fac+1,'  R.Inscripto')
 else
  if EqStr(fbn('CondicionIVA'),'NOI')
   ACT(d:fac+1,'  R. No Inscripto')
  else
   if EqStr(fbn('CondicionIVA'),'EXE')
    ACT(d:fac+1,'  Exento')
   else
    if EqStr(fbn('CondicionIVA'),'FIN')
     ACT(d:fac+1,'  Cons.Final')
    else
     if EqStr(fbn('CondicionIVA'),'MON')
      ACT(d:fac+1,'  Monotributo')
     else
      ACT(d:fac+1,'  Otro')
     endif
    endif
   endif
  endif
 endif

 if EqStr(fbn('CondicionGan'),'INS')
  ACT(e:fac+1,'  Inscripto')
 else
  if EqStr(fbn('CondicionGan'),'NOI')
   ACT(e:fac+1,'  No Inscripto')
  else
   if EqStr(fbn('CondicionGan'),'EXE')
    ACT(e:fac+1,'  Exento')
   else
    if EqStr(fbn('CondicionGan'),'NOR')
     ACT(e:fac+1,'  No Residente')
    else
     ACT(e:fac+1,'  Otro')
    endif
   endif
  endif
 endif

 SetFont(a:fac..l:fac+1,1)
 ifa
 ifa
proximo

SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac,2)

Impresion(1,2)
Impresion(2,1)
Impresion(3,1)
Impresion(4,1)

LimitesVision(l:fac)
Rangotitulo(a:1..l:fac,Val(z:1))
SetPrintFit(3,70)
