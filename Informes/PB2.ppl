SQL.ADD(" SELECT T.Proveedor, T.Fecha1, T.Especie, T.Cantidad1, T.Cantidad2, M.Leyenda, ")
SQL.ADD(" T.Cliente1, T.Cuenta1, T.Cliente2, T.Cuenta2, T.Cliente3, T.CNCuentaProveedor1, M.NrOperacion, ")
*SQL.ADD(" M.Cuenta, M.FechaMov, T.ConceptoPago, M.Cantidad CantidadM, CL.RazonSocial, M.Especie EspecieM, ")
SQL.ADD(" M.Cuenta, M.FechaMov, T.ConceptoPago, M.Cantidad CantidadM, M.Especie EspecieM, ")
SQL.ADD(" C.Numero, E.Nombre, 'Pendiente' Estado, T.Vehiculo1, T.CB6 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, ")
SQL.ADD("  "~DBO~".CUENTAS C, "~DBO~".MOVPENDIENTES M ")
SQL.ADD(" WHERE T.NrTrans   = M.NrOperacion ")
*SQL.ADD(" AND   C.Comitente = CL.Codigo ")
SQL.ADD(" AND   M.Cuenta    = C.Codigo ")
SQL.ADD(" AND   M.Especie   = E.Codigo ")
***---SQL.ADD(" AND   T.ConceptoPago = CP.Codigo ")
SQL.ADD(" AND   T.TipoTr2    = 'TRANSF' ")
*SQL.ADD(" AND   T.Proveedor  *= P.Codigo  ")
SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
If Dialogo.Radio1=0
  SQL.ADD(" AND T.CB6 = '1' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND (T.CB6 = '0' OR T.CB6 IS NULL ) ")
Endif
If NoVacio(Dialogo.Lista4)
*  SQL.ADD(" AND   CP.Codigo IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
  SQL.ADD(" AND   T.ConceptoPago IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" UNION ALL ")
SQL.ADD(" SELECT T.Proveedor, T.Fecha1, T.Especie, T.Cantidad1, T.Cantidad2, M.Leyenda,  ")
SQL.ADD(" T.Cliente1, T.Cuenta1, T.Cliente2, T.Cuenta2, T.Cliente3, T.CNCuentaProveedor1, M.NrOperacion, ")
SQL.ADD(" M.Cuenta, M.FechaMov, T.ConceptoPago, M.Cantidad CantidadM, M.Especie EspecieM, ")
*SQL.ADD(" C.Numero, E.Nombre, 'Pendiente' Estado, T.Vehiculo1, CP.Descripcion CPDescripcion, P.Nombre NombreP, T.CB6 ")
SQL.ADD(" C.Numero, E.Nombre, 'Pendiente' Estado, T.Vehiculo1, T.CB6 ")
SQL.ADD(" FROM "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, ")
SQL.ADD(" "~DBO~".CUENTAS C, "~DBO~".MOVEJECUTADOS M ")
SQL.ADD(" WHERE T.NrTrans  = M.NrOperacion ")
*SQL.ADD(" AND   C.Comitente = CL.Codigo ")
SQL.ADD(" AND   M.Cuenta   = C.Codigo ")
SQL.ADD(" AND   M.Especie  = E.Codigo ")
*SQL.ADD(" AND   T.ConceptoPago = CP.Codigo ")
SQL.ADD(" AND   T.TipoTr2  = 'TRANSF' ")
*SQL.ADD(" AND   T.Proveedor  *= P.Codigo  ")
SQL.ADD(" AND   M.FechaMov >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaMov <= "~IdxDate2(Dialogo.Fecha2)~" ")
If Dialogo.Radio1=0
  SQL.ADD(" AND T.CB6 = '1' ")
Endif
If Dialogo.Radio1=1
  SQL.ADD(" AND (T.CB6 = '0' OR T.CB6 IS NULL ) ")
Endif
If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND   T.ConceptoPago IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif
If NoVacio(Dialogo.Lista3)
*  SQL.ADD(" AND   M.Especie IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
  SQL.ADD(" AND   C.Codigo IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND   C.Comitente IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif
If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND   T.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Else
  If NoVacio(UsrVehiculos(UsuarioActivo))
    SQL.ADD(" AND T.Vehiculo1 IN ("~Pipe2Comillas(Val(VH:1))~") ")
  Endif
Endif
SQL.ADD(" ORDER BY 1,2,3,4 ")

