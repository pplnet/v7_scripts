Recorrer SQL
 If Not eqstr(fbn('NrOperacion'),Val(oa:1))
   message(fbn('NrOperacion'))
   ACD(a:fac, fbn('Fecha1'))
   ACT(b:fac,fbn('NrOperacion'))
   ACLT(b:fac,fbn('NrOperacion'))
*   ACT(c:fac,fbn('CPDescripcion'))
   IF Not Eqstr(fbn('ConceptoPago'), Val(CP:1))
       ACT(C:fac, BuscarCampo('CNCONCEPTOSPAGOCOBRO','Descripcion','Codigo', fbn('ConceptoPago')))
       ACT(DS:1, Val(C:fac))
   ELSE
       ACT(C:fac, Val(DS:1))
   ENDIF
   ACT(CP:1, fbn('ConceptoPago'))
   ACN(d:fac, fbn('Cantidad1'))
   ACN(e:fac, fbn('Cantidad2'))
   ACT(f:fac, fbn('Cliente1'))
   ACT(g:fac, fbn('Cuenta1'))
*   ACT(h:fac, fbn('Proveedor')~'-'~fbn('NombreP'))
   IF Not Eqstr(fbn('Proveedor'), Val(PV:1))
       ACT(NM:1, BuscarCampo('CNPROVEEDORES','Nombre','Codigo', fbn('Proveedor')))
   ENDIF
   ACT(H:fac, fbn('Proveedor')~'-'~Val(NM:1))
   ACT(PV:1, fbn('Proveedor'))
   If Vacio(fbn('Proveedor'))
     ACT(i:fac, fbn('Cliente2'))
     ACT(j:fac, fbn('Cuenta2'))
   Else
     ACT(i:fac, fbn('Cliente3'))
     ACT(j:fac, fbn('CNCuentaProveedor1'))
   Endif
 Endif
 ACN(k:fac, fbn('CantidadM'))
 ACD(l:fac, fbn('FechaMov'))
 ACT(m:fac, fbn('Cuenta')~' - '~fbn('Numero'))
 ACT(n:fac, fbn('Leyenda'))
 ACT(o:fac, fbn('Estado'))
 IF Eqstr(fbn('Estado'), 'Pendiente')
   ColorCeldas(o:fac,clBlue)
 ELSE
   ColorCeldas(o:fac,clGreen) 
 ENDIF
 IF Eqstr(fbn('CB6'), '1')
   ACT(p:fac, 'Automatica')
 ELSE
   ACT(p:fac, 'Manual')
 ENDIF

 ACT(oa:1,fbn('NrOperacion'))
 SetFont(a:fac..z:fac,1)
 FormatoCeldas(d:fac..e:fac,EXE('F2'))
