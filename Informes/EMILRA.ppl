   ACT(A:FAC, BuscarCampo('Especies', 'CodNumCajaValores', 'Codigo', Dialogo.Especie3))
   ACT(B:FAC, BuscarCampo('Especies', 'Nombre', 'Codigo', Dialogo.Especie3))
   ACT(D:FAC, FBN['Cupon1'])
   ACT(E:FAC, FBN['Fecha1'])
   ACT(G:FAC, Val(ZB:09) )
