      ACT(A:FAC, Val(ZB:03))
   EndIf
   
   If [NoVacio(FBN('CodigoPostal')) y Not EqStr(FBN('CodigoPostal'), '000000')]
      If [EqStr(Copy(FBN('CodigoPostal'), 01, 02), '00')]
         ACT(d:FAC, "(" ~ Copy(FBN('CodigoPostal'), 03, 04) ~ ')')
      Else  
         ACT(d:FAC, "(" ~ Copy(FBN('CodigoPostal'), 01, 04) ~ ')')
      EndIf
   EndIf
   
   ACT(g:FAC, fbn['Telefono'])
   
