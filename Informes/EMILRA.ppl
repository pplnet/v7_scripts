   ACT(A:FAC, fbn['SucCli'])
   ACT(C:FAC, BuscarCampo('Sucursales', 'Nombre', 'Codigo', FBN('SucCli')))
   SetFont(A:FAC..C:FAC, 1)
   
   * ---> Impresion Del Numero De  Cuenta

   IFA
   ACT(A:FAC, 'Cuenta Nro. ')
   ACT(C:FAC, 'Comitente Nro.')
     
   SetFont(A:FAC..C:FAC, 2)

   ** Parte Vieja
