   ACN(J:FAC, Val(ZA:15))
   ACN(K:FAC, Val(BD:1))
  SetFont(a:fac..k:fac,1)

  IFA
  ACT(D:FAC, '% Amortizacion ')
  ACT(k:FAC, 'IVA Inscriptos')
  AlinearCeldas(k:fac,'D')
  SetFont(a:fac..k:fac,2)

  IFA
