  FormatoCeldas(k:FAC, Exe('F2'))
  SetFont(k:FAC..k:FAC, 1)
    
   
  AgregarMarco(K:FAC-1..K:FAC,2,0)
  
  AgregarMarco(A:Val(w2)..k:FAC,2,0)
  
  * ---> Impresion De La Forma De Pago Y De La Cuenta A Acreditar
  
  IFA

If FBN['NrSaldo']<>101
  ACT(ca3, FBN['Cliente']~' - ')
  if EqStr(FBN['CUEMOV'],'MOD23')
     ACT(ca3, FBN['CUEMOV'])
  else
     ACT(ca4, BuscarCampo('CUENTAS','TipoCuenta','Codigo',FBN['CUEMOV']) )
     if EqStr(Val(ca4),'CUS')
        ACT(ca3, Val(ca3)~' Cuenta Custodia')
     else
         if EqStr(Val(ca4),'CA')
            ACT(ca3, Val(ca3)~' Caja de Ahorro')
         else
            if EqStr(Val(ca4),'VIS')
               ACT(ca3, Val(ca3)~' Cuenta Vista')
            else
               if EqStr(Val(ca4),'CCO')
                  ACT(ca3, Val(ca3)~' Cuenta Propia')
               else
                  if EqStr(Val(ca4),'CAJ')
                     ACT(ca3, Val(ca3)~' Cuenta Caja')
                  else
                     if EqStr(Val(ca4),'INV')
                        ACT(ca3, Val(ca3)~' Cuenta Inversor')
                     else
                        if EqStr(Val(ca4),'FCI')
                           ACT(ca3, Val(ca3)~' Fondo Comun de Inversion')
                        else
                           if EqStr(Val(ca4),'CC')
                              ACT(ca3, Val(ca3)~' Cuenta Corriente')
                           else
                              ACT(ca3, Val(ca3)~'  ')
                           endif
                        endif
                     endif
                  endif
               endif
            endif
         endif
     endif
  Endif
Endif
  ** Parte Vieja
