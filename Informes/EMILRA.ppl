  ACN(D:FAC+1, Val(ZA:11))
  FormatoCeldas(D:FAC+1,Exe('F7'))
  SetFont(d:fac..d:fac,2)
  SetFont(d:fac+1..d:fac+1,1)
  IFA


  ACT(A:FAC, 'Tenencia Residual Actual')
  SetFont(a:fac..a:fac,2)
  
  IFA
  ACN(A:FAC, round(Val(ZA:07),Val(vr2)))
  FormatoCeldas(A:FAC,Exe('F7'))
  SetFont(a:fac..a:fac,1)
  ***

  SetFont(d:fac..d:fac,1)   
  AgregarMarco(A:Val(w3)..E:FAC,2,0)
  AgregarMarco(I:Val(w4)..K:FAC,2,0)
  * ---> Impresion Del Importe Neto
  ifa
  ACT(k:FAC, 'Total Neto')
  AlinearCeldas(k:fac,'D')
