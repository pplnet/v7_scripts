         ACT(A:FAC, fbn['CueMov'])
         ACT(C:FAC, BuscarCampo('CUENTAS', 'NrDepositante', 'Codigo', FBN('CueMov'))~' - Tenencia en '~BuscarCampo('MERCADOS','Descripcion','Codigo',BuscarCampo('CUENTAS', 'Mercado', 'Codigo', FBN('CueMov'))))
         SetFont(A:FAC..B:FAC, 1)     
      ENDIF
   endif

   ** Parte pedida por Carlos Mangiarua (reemplaza Parte vieja)
   IFA
   IF fbn['NrSaldo']=fbn['Concepto']
     ACT(A:FAC, fbn['Cliente'])
     ACT(C:FAC, BuscarCampo('CUENTAS', 'NrDepositante', 'Codigo', FBN('CueMov'))~' - Tenencia en '~BuscarCampo('MERCADOS','Descripcion','Codigo',BuscarCampo('CUENTAS', 'Mercado', 'Codigo', FBN('CueMov'))))
     SetFont(A:FAC..B:FAC, 1)     
   ENDIF   
   **

   * ---> Impresion De La Razon Social
   IFA
   ACT(A:FAC, 'Apellido y Nombre/s o Razon Social ')
   ACT(I:FAC, 'Documento   -Tipo y Numero-')
   SetFont(A:FAC..I:FAC, 2)
   
   IFA
   ACT(ZB:01, copy(FBN('RazonSocial'),1,25))
   (.'ELIBLANCOS'.)
   ACT(A:FAC, Val(ZB:03))

   SQL.ADD("SELECT TipoDocumento, NrDocumento FROM "~DBO~".INTEGRANTESCLI WHERE Codigo = '"~FBN['Cliente']~"' AND TipoPoder = 'TIT' AND Status = 'VIG' ")
   Recorrer SQL
      dfa
      ACT(J:FAC, FBN['TipoDocumento'])
      If EqStr(Val(j:FAC),'CUT')
         ACT(j:FAC, 'CUIT')
      Endif
      If EqStr(Val(j:FAC),'CUL')
         ACT(j:FAC, 'CUIL')
      Endif
      ACT(J:FAC, Val(J:fac)~'   '~FBN['NrDocumento'])
   Proximo
   SetFont(A:FAC..J:FAC, 1)
      
   
   * ---> Impresion Del Numero De CUIT/CUIL
   
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
         EndIf      
      EndIf
   Else
      ACT(ZB:10, '')
   EndIf
   ACT(ZB:11, FBN('TipoInscripcion'))
   (.'ARMACUIT'.)
   IFA
   ACT(A:FAC, Val(ZB:14))
   * ---> Impresion De La Direccion
   ACT(d:FAC, 'Domicilio')
