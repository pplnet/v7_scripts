       ACN(ZA:06, FBN('NrGrupo2')  * Val(vr1))
***

     ELSE
       *Acreditacion (Monto en Acciones)
       ACN(ZA:08, FBN('Cantidad')* ValorTeorico2(Dialogo.Especie1,FBN['Fecha1']-1))
     ENDIF
  ENDIF
   **
   
   * ---> Impresion Del Codigo Postal Y La Localidad
   IFA
      
   ACT(A:FAC, 'Localidad')
