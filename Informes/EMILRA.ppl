  * ---> Impresion De Los Valores De I.V.A.
**  IF fbn['NrSaldo']  = 4 
      IF fbn['NrGrupo']  = 42
        If [FBN('Formula') = VAR('IVA')]
           * ACN(ZA:16, FBN('Cantidad') * Val(ZA:12))  
           ACN(ZA:16, FBN('NrInstan') * Val(ZA:12))  
          ACN(ZA:17, 0.00)
        Else
          If [FBN('Formula') = VAR('RNI')]
            ACN(ZA:16, 0.00)
            ACN(ZA:17, FBN('NrInstan') * Val(ZA:12))  
          Else
            ACN(ZA:16, FBN('NrInstan') * VAR('IVA')   / (VAR('IVA')+VAR('RNI')) * Val(ZA:12))  
            ACN(ZA:17, FBN('NrInstan') * VAR('RNI') / (VAR('IVA')+VAR('RNI')) * Val(ZA:12))  
          EndIf
        EndIf
      ENDIF
***  ENDIF
  ACN(k:FAC, Val(ZA:16))
  SetFont(a:fac..k:fac,1)

  IFA   
