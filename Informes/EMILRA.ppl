   AlinearCeldas(k:fac,'D')
   AgregarMarco(A:FAC-1..K:FAC,2,0)
   SetFont(a:FAC..k:FAC, 1)
   
   IFA
   ACT(a:FAC, 'Hora:')
   SetFont(a:FAC, 2)   
   IFA
   ACT(a:FAC,Hora(Ahora))
   SetFont(a:FAC, 1)   
   
   IFA
   * ---> Impresion Del Codigo Y Nombre De La Sucursal
   
   ACT(A:FAC, 'Nr. Sucursal ')
   ACT(C:FAC, 'Nombre Sucursal ')
   SetFont(A:FAC..C:FAC, 2)
   
   *- Fila de Impresion de Sucursal 19
