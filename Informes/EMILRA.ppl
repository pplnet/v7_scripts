* ---> Impresion De La Carta De Liquidacion De Renta Y Amortizaciones
ModoReproceso(SinDialogo)
GrillaVisible(SI)
*HojaVisible(NO)
HojaVisible(si)
CrearDialogo
   Vehiculo1: 'Vehiculo   '; 01;  1;  1; SI; SI; NoVacio(Dialogo.Vehiculo1)                                                                                                                                            ; 'Debe Ingresar El Vehiculo'                    ; NO; Var('VEHICULODE')
   Cliente1 : 'Cliente    '; 02;  1;  1; SI; SI; NoVacio(Dialogo.Cliente1)                                                                                                                                             ; 'Debe Ingresar El Cliente'                     ; NO; 
   Especie3 : 'Especie    '; 03;  1;  1; SI; SI; NoVacio(Dialogo.Especie3) y DesciendeDeEspecie(Dialogo.Especie3, 'TITULO') y EsTerminal(Dialogo.Especie3, Especie)                                                    ; 'Debe Ingresar Una Especie Valida'             ; NO;                                                                                                                                                       ;                                                                                                                                                         ; ; ; ; "Status = 'HAB' "
   TipoTr1  : 'TipoTrans. '; 04;  1;  1; SI; SI; NoVacio(Dialogo.TipoTr1)  y Incluido(Dialogo.TipoTr1, 'CCUPON|PCUPON')                                                                                                ; 'Debe Ingresar Un Tipo Valido'                 ; NO; 'CCUPON'                                                                                                                                              ;                                                                                                                                             
   Especie1 : 'Cupon      '; 05;  1;  1; NO; SI;                                                                                                                                                                       ;                                                ; SI; BuscarCampo('Especies', 'Alias9', 'Codigo', Dialogo.Especie3)                                                                                         ; BuscarCampo('Especies', 'Alias3', 'Codigo', Dialogo.Especie3)                                                                                           ; ; ; ; "Status = 'HAB' "
   Entero1  : 'Nro.Cupon  '; 06;  1;  1; NO; SI; Dialogo.Entero1 >  0                                                                                                                                                  ; 'Debe Ingresar El Numero De Cupon'             ; NO; 0                                                                                                                                                     ; BuscarCampo('Especies', 'Cupon',  'Codigo', Dialogo.Especie3)-1
   Fecha1   : 'F.Pago/Cob.'; 07;  1;  1; Dialogo.Entero1=0;Dialogo.Entero1=0; ;;; ;
   Precio1  : '% Amort.   '; 09;  1;  1; NO; SI; Dialogo.Precio1 >= 0                                                                                                                                                  ; 'El % De Amortizacion Debe Ser Positivo'       ; NO;                                                                                                                                                       ; SQL("SELECT PorAmCapital FROM " ~ DBO ~ ".AGENDACUPONES WHERE Especie = '" ~ Dialogo.Especie3 ~ "' AND NrCupon = '" ~ FStr(Dialogo.Entero1, 1, 0) ~ "'");;;'###.########'
   Precio2  : '% Renta    '; 10;  1;  1; NO; SI; Dialogo.Precio2 >= 0                                                                                                                                                  ; 'El % De Renta Debe Ser Positivo'              ; NO;                                                                                                                                                       ; SQL("SELECT PorRenta     FROM " ~ DBO ~ ".AGENDACUPONES WHERE Especie = '" ~ Dialogo.Especie3 ~ "' AND NrCupon = '" ~ FStr(Dialogo.Entero1, 1, 0) ~ "'");;;'###.########'
   Precio5  : 'V.T.Actual '; 11;  1;  1; NO; SI; Dialogo.Precio5 >  0                                                                                                                                                  ; 'El % De V. Teorico Al Corte Debe Ser Positivo'; NO; ValorTeorico(Dialogo.Especie3)                                                                                                                        ; ValorTeorico(Dialogo.Especie3)
   Cantidad1: 'NrMov      '; 12;  1;  1; NO; SI; Dialogo.Cantidad1>0                                                                                                                                                   ; 'El Nr. de Saldo es Incorrecto'; NO
   NrTrans1 : 'NrTrans'    ;;;;;;
FinDialogo

If [Not OK]
   Cancelar
EndIf

If [[NoVacio(Dialogo.Vehiculo1)] y [Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo))] y [Not Vacio(UsrVehiculos(UsuarioActivo))]]
   Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
EndIf

* ---> Seleccion De La Informacion A Listar
ACN(ZA:01, BuscarCampo('EstadosCustodia', 'NrSaldo', 'Codigo', Var('SALLIBRECU'))+100)

(.'LOGO'.)

SQL.Add("SELECT T2.*, ")
SQL.Add("       C.RazonSocial, ")
SQL.Add("       C.Direccion DirCli, ")
SQL.Add("       C.Localidad, ")
SQL.Add("       C.CodigoPostal, ")
SQL.Add("       C.CUIT, ")
SQL.Add("       C.CondicionIVA, ")
SQL.Add("       C.TipoInscripcion, ")
SQL.Add("       C.Sucursal as SucCli, ")
SQL.Add("       C.Telefono, ")
*--Efectivo
SQL.ADD("       M.NrGrupo2, ")
*--%IVA Comis.
SQL.ADD("       M.Formula, ")
SQL.ADD("       M.Cantidad, ")
SQL.ADD("       M.Especie ESPEMOV,")
SQL.ADD("       M.Cuenta CUEMOV,")
SQL.ADD("       M.NrSaldo,")
SQL.ADD("       M.NrGrupo,")
SQL.ADD("       M.NrOperacion,")
SQL.ADD("       M.Concepto,")
SQL.ADD("       M.Cliente, M.NrInstan ")
SQL.Add("FROM "~DBO~".TRANSACCIONES2 T2, ")
SQL.Add("     "~DBO~".CLIENTES C, ")
SQL.Add("     "~DBO~".MOVEJECUTADOS M ")
SQL.Add("WHERE T2.Especie = '"~Dialogo.Especie1~"' ")
If Dialogo.Entero1 > 0
   SQL.Add("  AND T2.Cupon1 = '"~FStr(Dialogo.Entero1,0,0)~"' ")
Endif
SQL.Add("  AND T2.NrTrans = '"~Dialogo.NrTrans1~"' ")
SQL.Add("  AND T2.TipoTr2 = '"~VAR('LCUPON')~"' ")
If Dialogo.Fecha1 > 0
   SQL.Add("  AND T2.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif
SQL.Add("  AND CONVERT(integer, SUBSTRING(STR(NrMov,6),2,5)) = "~FStr(Dialogo.Cantidad1,0,0)~" ")
SQL.Add("  AND M.NrOperacion= T2.NrTrans ")
SQL.Add("  AND M.Cliente = '"~Dialogo.Cliente1~"' ")
SQL.Add("  AND M.Cliente = C.Codigo ")

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,12,B")

* ---> Impresion De Lineas De La Carta

Recorrer SQL

***   MessageBox('NRMOV '~Fstr(FBN['NrGrupo'],1,2) )

   SetFilaActual(9)
    
   * ---> Impresion Del Titulo De Referencia
   
   ACT(f:FAC, "Liquidacion de Renta y/o Amortizacion")
   SetFont(f:FAC, 3)
   AgregarMarco(e:FAC-1..j:FAC+1,2,0)
   
   * ---> Impresion De La Fecha De Emision
   SetFilaActual(15)
   acn(w1,fac)
    
   ACT(ZB:09, SQL("SELECT FechaPago FROM "~DBO~".AGENDACUPONES WHERE Especie='"~Dialogo.Especie3~"' and NrCupon="~FBN['Cupon1']) )
