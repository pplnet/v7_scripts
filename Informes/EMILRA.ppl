   IFA
   ACT(A:FAC, Val(ZB:13))
   ACT(ZB:01, FBN('DirCli'))
   (.'ELIBLANCOS'.)
   ACT(d:FAC, Val(ZB:03))
   SetFont(A:FAC..d:FAC, 1)

   **
   * ------> Conversion DE PESOS A LA MONEDA DEL PAGO DEL DIVIDENDO
   *ACN(ZA:12, CotizacionC(VAR('MONELOCA'), , , , FSys, 1, SI,FBN('Especie1')))
   * no hace falta porque se cobra en la misma moneda del corte de cupon
   ACN(ZA:12, 1)
   
   IF Incluido(fbn['NrGrupo'],'41|42')
      * ---> Impresion De La Comision
      IF fbn['NrGrupo'] = 41 
        ACN(ZA:13, FBN('Cantidad') * Val(ZA:12))
        ACN(BD:1, FBN('NrInstan') * Val(ZA:12))
      ENDIF
      IF fbn['NrGrupo'] = 42 
        ACN(ZA:14, FBN('Cantidad') * Val(ZA:12))
      ENDIF
      *ACN(ZA:15, Val(ZA:13)       + Val(ZA:14))
      ACN(ZA:15, Val(ZA:13))
   ELSE

     IF EqStr(fbn['EspeMov'],'ARP') O EqStr(fbn['EspeMov'],'USD')
       *Importe Efectivo
       ACN(ZA:09, FBN('Cantidad'))

       *Tenencia Nominal y Residual
       ACN(ZA:05, FBN('NrGrupo2'))

