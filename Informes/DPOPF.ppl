IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF
CrearDialogo
  Fecha1:       'Fecha'                                 ;;;;;;;;;
  Vehiculo1:    'Vehiculo'                              ;;;;;;;;;
  Book1:        'Book'                                  ;;;;;;;;;
  Radio1:       'Expresado en|ARP|USD'                  ;;;;;;;;;
  Radio2:       'Expresado en|Millones|ImporteOri'      ;;;;;;;;;
  Precio1:      'CotDolDivisa'                          ;;;;;;;;;
  Precio2:      'CotDolBillete'                         ;;;;;;;;;
  #ifdef STD_CORP
    Radio4:       'Valuacion|Oficial|USD Alternativo'               ;1;2;;;;;;;0;;;
  #endif
  Lista1:       'Vehiculo'                              ;;;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
FinDialogo

IF Not OK
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

*****************************************************************VAR MONEDAS****************************************************
let &monedaLocal Var('MONELOCA')
let &monedaExtr Var('MONEEXTR')
let &dolBillete Var('DOLBILLETE')
let &vehiculosDolBillete Var('VEHDOLBI')
let &cotDolDivisa Dialogo.Precio1
let &cotDolBillete Dialogo.Precio2
IF Dialogo.Radio1 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF
********************************************************ENCABEZADO****************************************************
SetFilaActual(1)

let &filaLogo 1
@LOGO
ACT(D:fac,'Posicion de PF')
SetFont(D:fac..D:fac, 3)
SetFilaACtual(fac+6)


let &ComienzoTitulos fac

ACT(A:fac,'Fecha: '  ~Dialogo.Fecha1)
ifa

IF Vacio(Dialogo.Vehiculo1)
    IF Vacio(Dialogo.Lista1)
        let &Vehiculos 'Todos'
    ELSE
        let &Vehiculos Dialogo.Lista1
    ENDIF
ELSE
    let &Vehiculos Dialogo.Vehiculo1
ENDIF
ACT(A:fac,'Vehiculo: '~ &Vehiculos)
ifa

IF Vacio(Dialogo.Book1)
    let &Books 'Todos'
ELSE
    let &Books Dialogo.Book1
ENDIF
ACT(A:fac,'Books: '~ &Books)
ifa
IF Dialogo.Radio1 = 0
    let &expresion 'ARP'
ELSE
    let &expresion 'USD'
ENDIF
ACT(A:fac,'Expresado en : '~ &expresion)
ifa

ACT(A:fac, 'TC Divisa:')
ACN(B:fac, &cotDolDivisa)
ifa
ACT(A:fac, 'TC Billete:')
ACN(B:fac, &cotDolBillete)
FormatoCeldas(B:fac-1..B:fac, Exe('F8'))
ifa
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF
ifa
ACT(A:fac,'Apertura por vehiculo y books')
#ifdef STD_CORP
    ifa
    ACT(A:fac, 'TC Valuacion: ')
    IF Dialogo.Radio4 = 0
        ACT(A:fac, Val(A:fac )~'Oficial')
    ELSE
        ACT(A:fac, Val(A:fac )~'Alternativo')
    ENDIF
#endif
ifa
ifa
ACT(A:fac,'NrOperacion')
ACT(B:fac,'Banco')
ACT(C:fac,'Moneda')
ACT(D:fac,'Capital')
ACT(E:fac,'Int. Devengados')
ACT(F:fac,'Total')
ACO(1,15)
ACO(4,10)
ACO(5,10)
AgregarMarco(A:fac..F:fac, 0, 3, Exe('COLOR'))
AlinearCeldas(A:fac-1..F:fac,'C')
SetFont(A:&ComienzoTitulos..I:fac, 2)

***********************************************************************SQL*****************************************************************
SQL.ADD("Select Sum(M.Monto)/"~Fstr(&unidad, 0, 0)~" as 'Devengados',O.Cantidad/"~Fstr(&unidad, 0, 0)~" as 'Capital',O.NrOperacion,")
SQL.ADD(" O.Vehiculo1 as 'Vehiculo',O.Book1,O.Cliente1,O.Especie as 'Moneda', O.ContraEspecie2 ")
SQL.ADD(" FROM "~DBO~".MOVDEVENGADOS M, "~DBO~".OPERACIONES O")
SQL.ADD("Where M.NrOperacion=O.NrOperacion and O.TipoOp='MMCPM'  and O.FechaVto> '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 ='"~Dialogo.Vehiculo1~"'")
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
Endif 
IF NoVacio(Dialogo.Book1)
    SQL.ADD("and O.Book1 ='"~Dialogo.Book1~"'")
Endif
SQL.ADD(" AND M.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD("Group by O.NrOperacion,O.Cantidad,O.Vehiculo1,O.Especie,O.Book1,O.Cliente1, O.ContraEspecie2")

SQL.ADD(" UNION ")

SQL.ADD("Select 0 as 'Devengados',O.Cantidad/"~Fstr(&unidad, 0, 0)~" as 'Capital',O.NrOperacion,")
SQL.ADD(" O.Vehiculo1 as 'Vehiculo',O.Book1,O.Cliente1,O.Especie as 'Moneda', O.ContraEspecie2 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O")
SQL.ADD("Where O.TipoOp='MMCPM'  ")
IF NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("and O.Vehiculo1 ='"~Dialogo.Vehiculo1~"'")
ELSE
    IF NoVacio(Dialogo.Lista1)
        SQL.ADD(" AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
    ENDIF
Endif 
IF NoVacio(Dialogo.Book1)
    SQL.ADD("and O.Book1 ='"~Dialogo.Book1~"'")
Endif
SQL.ADD(" AND O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ") 
SQL.ADD("Group by O.NrOperacion,O.Cantidad,O.Vehiculo1,O.Especie,O.Book1,O.Cliente1, O.ContraEspecie2")


SQL.ADD("Order By O.Vehiculo1,O.Book1")

let &comienzoDatos fac
Watch(sql.batch)
Recorrer SQL
    IF Not Eqstr(fbn('Book1'), Val(BO:1)) y NoVacio(Val(BO:1)) o [Not Eqstr(fbn('Vehiculo'), Val(VH:1)) y NoVacio(Val(VH:1))]
        ACT(A:fac,'Sub Totales Cartera: '~ Val(BO:1))
        ACN(D:fac,&totCapitalBook)
        ACN(E:fac,&totDevengadosBook)
        ACN(F:fac,&totCapitalBook+&totDevengadosBook)
        SetFont(A:fac..F:fac,2)
        AgregarMarco(A:fac..F:fac,1,0,)
        let &totCapitalBook 0
        let &totDevengadosBook 0
        ifa
        ifa
    Endif
    If Vacio(Dialogo.Book1)
        IF Not Eqstr(fbn('Vehiculo'), Val(VH:1)) y NoVacio(Val(VH:1))
            ACT(A:fac,'Total Vehiculo: '~ Val(VH:1))
            ACN(D:fac,&totCapitalVh)
            ACN(E:fac,&totDevengadosVh)
            ACN(F:fac,&totCapitalVh+&totDevengadosVh)
            SetFont(A:fac..F:fac,2)
            AgregarMarco(A:fac..F:fac,1,0,EXE('COLOR6'))
            let &totCapitalVh 0
            let &totDevengadosVh 0
            ifa
            ifa
        Endif
        If  Not Eqstr(fbn('Vehiculo'), Val(VH:1))
            ACT(A:fac,'VEHICULO: '~FBN['Vehiculo'])
            AgregarMarco(A:fac..F:fac,1,0,EXE('COLOR6'))
            SetFont(A:fac..A:fac,2)
            ifa
        Endif
    Endif
    If  Not Eqstr(fbn('Book1'), Val(BO:1)) o Not Eqstr(fbn('Vehiculo'), Val(VH:1))
    ACT(A:fac,'CARTERA: '~FBN['Book1'])
        SetFont(A:fac..A:fac,2)
        AgregarMarco(A:fac..F:fac,1,0,)
        ACT(BO:1,FBN['Book1'])
        ifa
    ENDIF
    ACT(VH:1,FBN['Vehiculo'])
    IF Incluido(fbn('Vehiculo'), &vehiculosDolBillete)
        let &cotVehiculo &cotDolBillete
    ELSE
        let &cotVehiculo &cotDolDivisa
    ENDIF
    #ifdef STD_CORP
        IF Dialogo.Radio4 = 1 Y NoVacio(Trim(fbn('ContraEspecie2')))
            ***---Hay que tomar TC Valuacion
            let &cotVehiculo CotizacionBNA(fbn('ContraEspecie2'),Dialogo.Fecha1-1,1,NO,NO)
        ENDIF
    #endif
    IF Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
    IF Not Eqstr(fbn('Moneda'), &especieAnt)
        let &cotEspecie COTIZACION(fbn('Moneda'),,,,Dialogo.Fecha1,1,SI)
    ENDIF
    ***---let &capital fbn('Capital') * &cotEspecie * &tc
    let &capital fbn('Capital') * &tc
    ***---let &devengados fbn('Devengados') * &cotEspecie * &tc
    let &devengados fbn('Devengados') * &tc
    ACT(A:fac,fbn['NrOperacion'] )
    ACLO(A:FAC, FBN('NrOperacion'))
    ACT(B:fac,fbn['Cliente1'])
    ACT(C:fac,fbn['Moneda'])
    ACN(D:fac,&capital)
    ACN(E:fac,&devengados)
    ACN(F:fac,&capital+&devengados)
    
    let &totCapitalVh &totCapitalVh+&capital 
    let &totDevengadosVh &totDevengadosVh+&devengados
    let &totCapitalBook &totCapitalBook+&capital 
    let &totDevengadosBook &totDevengadosBook+&devengados
Proximo

ifa
If NoVacio(Val(A:&comienzoDatos+1))
    ACT(A:fac,'Sub Totales Cartera: '~ Val(BO:1))
    ACN(D:fac,&totCapitalBook)
    ACN(E:fac,&totDevengadosBook)
    ACN(F:fac,&totCapitalBook+&totDevengadosBook)    
    SetFont(A:fac..F:fac,2)
    AgregarMarco(A:fac..F:fac,1,0,)
    ifa
    If Vacio(Dialogo.Book1)
        ifa
        ACT(A:fac,'Total Vehiculo: '~ Val(VH:1))
        ACN(D:fac,&totCapitalVh)
        ACN(E:fac,&totDevengadosVh)
        ACN(F:fac,&totCapitalVh+&totDevengadosVh) 
        SetFont(A:fac..F:fac,2)
        AgregarMarco(A:fac..F:fac,1,0,EXE('COLOR6'))
    Endif
Endif
let &ultimoRegistro fac
FormatoCeldas(D:&comienzoDatos..F:&ultimoRegistro, Exe('F2'))
ifa
ifa
ACT(A:fac,'Fin del Reporte')
SetFont(A:fac..A:fac,2)
LimitesVision(G:fac)
