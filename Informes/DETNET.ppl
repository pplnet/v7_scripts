CrearDialogo
    Fecha1:    'Fecha'    ;;;;;;;;;
    Vehiculo1: 'Vehiculo' ;;;;;;;;;
    Cliente1:  'Banco'    ;;;;;;;;
    Especie1:  'Especie'  ;;;;;;;;;
    Cuenta1:   'Cuenta'   ;;;;;;;;;
    Book1:     'Cartera'  ;;;;;;;;;
FinDialogo

If Not Ok
    Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,12,B")

SetFilaActual(1)
ACT(C:FAC, 'Detalle Neteos del dia')
SetFont(C:FAC, 4)

SetFilaActual(FAC+2)

ACT(A:FAC, 'Vehiculo')
ACT(B:FAC, 'Banco')
ACT(C:FAC, 'Especie')
ACT(D:FAC, 'Cuenta')
ACT(E:FAC, 'Book')
ACT(F:FAC, 'Importe')
SetFont(A:FAC .. F:FAC, 2)
AgregarMarco(A:FAC .. F:FAC, 2, 2, EXE('COLOR6'))
AlinearCeldas(A:FAC .. F:FAC, 'C')

SQL.ADD("Select C.Cliente as Vehiculo, M.Cuenta, C.Comitente, M.Especie, M.Book, ") 
SQL.ADD("M.Cantidad as Importe from "~DBO~".MOVEJECUTADOS M, "~DBO~".CUENTAS C ")
SQL.ADD("Where M.Cuenta = C.Codigo And M.NrSaldo = 10 And M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("And C.Cliente = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("And C.Comitente = '"~Dialogo.Cliente1~"' ")
SQL.ADD("And M.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD("And M.Cuenta = '"~Dialogo.Cuenta1~"' ")
SQL.ADD("And M.Book = '"~Dialogo.Book1~"' ")

ACN(CN:1, FAC+1)
Recorrer SQL
    ACT(A:FAC, FBN('Vehiculo'))
    ACT(B:FAC, FBN('Comitente'))
    ACT(C:FAC, FBN('Especie'))
    ACT(D:FAC, FBN('Cuenta'))
    ACT(E:FAC, FBN('Book'))
    ACN(F:FAC, FBN('Importe'))
Proximo
SetFont(A:Val(CN:1) .. F:FAC, 1)
AgregarMarco(A:Val(CN:1) .. F:FAC, 1, 2)
FormatoCeldas(F:Val(CN:1) .. F:FAC, EXE('F2'))

SetFilaActual(FAC+2)
ACT(A:FAC, 'Fin del Informe.')
SetFont(A:FAC, 2)

ACO(1, 10)
ACO(2, 10)
ACO(4, 10)
ACO(5, 10)
ACO(6, 10)

LimitesVision(G:FAC+1)    
