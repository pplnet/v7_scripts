CrearDialogo
   Vehiculo1  : "Vehiculo"             ;1;1;1;SI;SI;NoVacio(DIALOGO.VEHICULO1);'Debe Ingresar El Vehiculo';NO;Var('VEHICULODE')
   Cliente1   : "Cliente"              ;2;1;1;SI;SI;
   Mercado1   : 'C.Custodia'           ;3;1;1;SI;SI;;;SI;
   Especie3   : 'Especie'              ;1;2;1;SI;SI;Vacio(Dialogo.Especie3) O [DesciendeDeEspecie(Dialogo.Especie3, 'TITULO') y EsTerminal(Dialogo.Especie3, Especie)];'Debe Ingresar Una Especie Valida'; NO;;;;;;" Status = 'HAB' ";
   Especie1   : 'Cupon'                ;2;2;1;NO;SI;;;;BuscarCampo('ESPECIES', 'Alias9', 'Codigo', Dialogo.Especie3);BuscarCampo('ESPECIES', 'Alias9', 'Codigo', Dialogo.Especie3);
FinDialogo

If [Not OK]
   Cancelar
EndIf

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,9,B")

If [[NoVacio(DIALOGO.VEHICULO1)] y [Not Incluido(DIALOGO.VEHICULO1, UsrVehiculos(UsuarioActivo))] y [Not Vacio(UsrVehiculos(UsuarioActivo))]]
   Cancelar('El Operador No Esta Habilitado Para Operar Con El Vehiculo')
EndIf

SetFilaActual(3)
ACT(D:fac, 'Cupones Pendientes de Pago')
SetFont(D:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:fac, 'Especie: '~Dialogo.Especie3)
ELSE
    ACT(A:fac, 'Especies: Todas')
ENDIF
ifa
IF NoVacio(Dialogo.Cliente1)
    ACT(A:fac, 'Cliente: '~Dialogo.Cliente1)
ELSE
    ACT(A:fac, 'Clientes: Todos')
ENDIF
ifa
IF NoVacio(Dialogo.Mercado1)
    ACT(A:fac, 'Casa Custodia: '~Dialogo.Mercado1)
ELSE
    ACT(A:fac, 'Casa Custodia: Todas')
ENDIF
SetFont(A:fac-3..A:fac, 2)
SetFilaActual(fac+2)
ACT(A:fac, 'Especie')
ACT(B:fac, 'Cliente')
ACT(C:fac, 'Especie')
ACT(C:fac+1, 'Cupon')
ACT(D:fac, 'Fecha')
ACT(D:fac+1, 'Cobro/Pago')
* FJL 26/02/20 - Se agrega Fecha Ex-Cupon
ACT(e:fac, 'Fecha')
ACT(e:fac+1, 'Ex-Cupon')
ACT(f:fac, 'Mercado')
ACT(g:fac, 'Cuenta')
ACT(h:fac, 'NrCupon')
ACT(i:fac, 'Saldo')
AgregarMarco(A:fac..i:fac+1, 0, 0, Exe('COLOR6'))
SetFont(A:fac..i:fac+1, 2)
ifa
ACN(FI:1, fac+1)
SQL.ADD(" Select E.Codigo, S.Especie, S.Fecha, S.Mercado, S.Cuenta, ")
* FJL 26/02/20 - Se agrega Fecha Ex-Cupon
*SQL.ADD("        S.Cupon, S.Saldo, S.Cliente ")
SQL.ADD("        S.Cupon, S.Saldo, S.Cliente, E.PlazoLiq  ")
SQL.ADD(" From "~DBO~".ESPECIES E, "~DBO~".SALDOSDIA S ")
SQL.ADD(" Where S.Especie = E.Alias9 ")
 
SQL.ADD(" AND S.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND S.Especie IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'CUPON'))~") ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND S.Cliente = '"~Dialogo.Cliente1~"' ")
ENDIF
IF NoVacio(Dialogo.Mercado1)
    SQL.ADD(" AND S.Mercado = '"~Dialogo.Mercado1~"' ")
ENDIF
IF NoVacio(Dialogo.Especie1)
    SQL.ADD(" AND S.Especie = '"~Dialogo.Especie1~"' ")
ENDIF
SQL.ADD(" AND S.Saldo <> 0 ")
***---SQL.ADD(" AND S.Cliente <> '"~Dialogo.Vehiculo1~"' ")
Recorrer SQL
    ACT(A:fac, fbn('Codigo'))
    ACT(B:fac, fbn('Cliente'))
    ACT(C:fac, fbn('Especie'))
    ACD(D:fac, fbn('Fecha'))
* FJL 26/02/20 - Se agrega Fecha Ex-Cupon
    ACN(l:fac, fbn('PlazoLiq')/24)
    ACD(e:fac, Habiles(fbn('Fecha'),-Val(l:fac),'ARG','SI'))
    ACT(f:fac, fbn('Mercado'))
    ACT(g:fac, fbn('Cuenta'))
    ACT(h:fac, fbn('Cupon'))
    ACN(i:fac, fbn('Saldo'))
Proximo
AgregarMarco(A:Val(FI:1)..i:fac, 0, 0)
SetFont(A:Val(FI:1)..i:fac, 1)
FormatoCeldas(i:Val(FI:1)..i:fac, Exe('F2'))
*LimitesVision(I:fac+1)
