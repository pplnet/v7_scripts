  Lista2           :  'Tipo Op'               ;4;2;;;;;;;;;SQLSET("Select Codigo from "~DBO~".TIPOSOPERACION");;;;;
  CuentaContable1  :  'Cta. Contable'         ;;;;;;;;;;;
