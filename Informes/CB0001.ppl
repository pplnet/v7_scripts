message('Recuperando Asientos...')

SQL.ADD(" SELECT A1.NrUnicoAsiento,A1.Especie1, A1.Cantidad1, A1.Especie2, A1.Cantidad2, A1.Especie3, A1.Cantidad3, A1.Alias1 Especie, A1.Alias2, A1.Alias3, A1.NrItem, A1.Alias4, A1.Alias5, ")
*SQL.ADD(" CONCAT(left(convert(INT,A1.Cuenta),len(convert(INT,A1.Cuenta))-1),'-',right(convert(INT,A1.Cuenta),1)) Cuenta, A1.Cuenta Cuenta1, ")
SQL.ADD(" A1.Cuenta Cuenta, ")
SQL.ADD(" A1.Valor1, A1.Valor3, A1.DebitoCredito, A1.NrTrans2, ")
SQL.ADD(" A.FechaGeneracion, A.Libro, A.FechaValor, A.Modelo, A.NrOperacion, A.NrAsiento, M.TipoAsiento,M.TipoOp TipOp, M.TipoTr2 TipTr, ")
SQL.ADD(" A.Fecha1, A.Estado, A.Fecha2, M.Descripcion, A.Vehiculo, M.Codigo, A1.NrItem, A1.CentroCosto, A1.Alias1 Especie ")
SQL.ADD(" FROM "~DBO~".ASIENTOSCON1 A1, "~DBO~".ASIENTOSCON A, "~DBO~".MODELOSASIENTO M ")
SQL.ADD(" WHERE A1.NrUnicoAsiento = A.NrUnicoAsiento ")
SQL.ADD("   and A.Modelo    = M.Codigo ")



IF NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" AND A.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
    IF NoVacio(Dialogo.NrUnicoAsiento1)
       SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
    ENDif 
ELSE
    IF NoVacio(Dialogo.NrBOperacion)
        SQL.ADD(" AND A.NrOperacion = '"~Dialogo.NrBOperacion~"' ")
        IF NoVacio(Dialogo.NrUnicoAsiento1)
           SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
        ENDif 
    ELSE
        IF NoVacio(Dialogo.NrUnicoAsiento1)
           SQL.ADD(" AND A.NrUnicoAsiento = '"~Dialogo.NrUnicoAsiento1~"' ")
        ELSE
           SQL.ADD("   and A.FechaGeneracion>= "~IdxDate2(Dialogo.Fecha1))
           SQL.ADD("   and A.FechaGeneracion<= "~IdxDate2(Dialogo.Fecha2))
           SQL.ADD("   and A.FechaValor>= "~IdxDate2(Dialogo.Fecha3))
           SQL.ADD("   and A.FechaValor<= "~IdxDate2(Dialogo.Fecha4))
               If Dialogo.Check1=1
                   SQL.ADD("   and A.Fecha1>= "~IdxDate2(Dialogo.Fecha5))
                   SQL.ADD("   and A.Fecha1<= "~IdxDate2(Dialogo.Fecha6))
               Endif
         ENDIF
    ENDIF
ENDIF
IF NoVacio(Dialogo.ModeloAsiento1)
  SQL.ADD(" and A.Modelo     =  '"~Dialogo.ModeloAsiento1~"' ")  
ENDIF
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and A.Vehiculo in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
ELSE
   *If NoVacio(Dialogo.Vehiculo1)
   *    SQL.ADD("and A.Vehiculo in("~Pipe2Comillas(Descendientes('VEHICULOS', Dialogo.Vehiculo1))~") ")
   *EndIf
EndIf
If NoVacio(Dialogo.CuentaContable1)
  SQL.ADD("and A1.Cuenta =  '"~Dialogo.CuentaContable1~"' ")
Endif
*If NoVacio(Dialogo.Especie1)
*  SQL.ADD(" and (A1.Alias7 IN ("~Pipe2Comillas(Descendientes('ESPECIES', Dialogo.Especie1))~") OR A1.Alias7 = '"~Dialogo.Especie1~"') AND A1.Alias7 <> '' ") 
*EndIf
If NoVacio(Dialogo.Lista2)
  SQL.ADD(" and M.TipoOp in ("~Pipe2Comillas(Dialogo.Lista2)~") ")
EndIf
If NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and A1.Alias3 = '"~Dialogo.Cliente1~"'")
EndIf
*If Dialogo.Radio2 = 0
*  SQL.ADD(" and C.PaisDir = 'ARG' ")
*Else
*  If Dialogo.Radio2 = 1
*    SQL.ADD(" and C.PaisDir <> 'ARG' ")
*  EndIf
*EndIf
IF Dialogo.Radio1 = 0
   SQL.ADD(" AND A.Estado IN ('E','COE','NCE','REE') ")
ELSE
   IF Dialogo.Radio1 = 1
      SQL.ADD(" AND (A.Estado Not IN ('E','COE','NCE','REE') OR A.Estado Is Null OR A.Estado = '' OR A.Estado = ' ') ")
   ELSE
      IF Dialogo.Radio1 = 2
         SQL.ADD(" AND A.Estado IN ('R','COR') ")
      ELSE
         IF Dialogo.Radio1 = 3
            SQL.ADD(" AND A.Estado IN ('A','COA') ")
         ENDIF
       ENDIF
    ENDIF
ENDIF

If NoVacio(Dialogo.Lista3)
    SQL.ADD("And M.TipoAsiento in ("~Pipe2Comillas(Dialogo.Lista3)~ ")")
EndIf




***///SQL.ADD(" ORDER By A.FechaGeneracion, M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento, A1.Alias3, A1.Especie1 ")
SQL.ADD(" ORDER By A.FechaGeneracion, M.TipoAsiento, A.Modelo, A1.NrUnicoAsiento, A1.NrItem, A1.Especie1 ")
watch(sql.batch)
ACT(as:1, '')
ACT(mn:1, '')
ACN(fi:1, fac)

Recorrer SQL
   IF fbn('FechaGeneracion') <> Val(FE:1)
      IF Val(FE:1) > 0
          ACT(A:fac, 'Cantidad de Asientos: '~Fstr(Val(TF:1), 0, 0))
          AgregarMarco(A:fac..s:fac, 0, 0, Exe('COLOR8'))
          SetFont(A:fac, 2)
          SetFilaActual(fac+2)
      ENDIF
      ACT(A:fac, 'FechaGeneracion: '~Fecha(fbn('FechaGeneracion')))
      SetFont(A:fac, 2)
      AgregarMarco(A:fac..s:fac, 0, 0, Exe('COLOR8'))
      ACN(TF:1, 0)
   ENDIF
   If Not Eqstr(Val(as:1), fbn('NrUnicoAsiento'))
      ifa
      ACT(a:fac, fbn('Descripcion'))
      IF Vacio(fbn('Estado'))
          ACT(A:fac, Val(A:fac)~' - (Asiento Sin Enviar)')
           IF NoVacio(fbn('NrAsiento'))
              ACT(ET:1,BuscarCampo('ASIENTOSCON', 'Estado', 'NrUnicoAsiento', fbn('NrAsiento')))
              IF Incluido(Val(ET:1), 'COE|COT|COA|COR')
                 ACT(A:fac, Val(A:fac)~' Con ContraAsiento Nro '~fbn('NrAsiento'))
              ELSE
                  IF Incluido(Val(ET:1), 'NC|NCE')
                     ACT(A:fac, Val(A:fac)~' Con Nota de Credito Nro '~fbn('NrAsiento'))
                  ELSE
                      IF Incluido(Val(ET:1), 'REV|REE')
                         ACT(A:fac, Val(A:fac)~' Con Reversa Nro '~fbn('NrAsiento'))
                      ENDIF
                  ENDIF
              ENDIF
           ENDIF
      ENDIF
      IF Eqstr(fbn('Estado'), 'E')
          ACT(A:fac, Val(A:fac)~' - (Asiento Enviado)')
          IF NoVacio(fbn('NrAsiento'))
              ACT(ET:1,BuscarCampo('ASIENTOSCON', 'Estado', 'NrUnicoAsiento', fbn('NrAsiento')))
              IF Incluido(Val(ET:1), 'COE|COT|COA|COR')
                 ACT(A:fac, Val(A:fac)~' Con ContraAsiento Nro '~fbn('NrAsiento'))
              ELSE
                  IF Incluido(Val(ET:1), 'NC|NCE')
                     ACT(A:fac, Val(A:fac)~' Con Nota de Credito Nro '~fbn('NrAsiento'))
                  ELSE
                      IF Incluido(Val(ET:1), 'REV|REE')
                         ACT(A:fac, Val(A:fac)~' Con Reversa Nro '~fbn('NrAsiento'))
                      ENDIF 
                  ENDIF
              ENDIF
          ENDIF
      ENDIF 
      IF Eqstr(fbn('Estado'), 'A')
          ACT(A:fac, Val(A:fac)~' - (Asiento Aceptado)')
          IF NoVacio(fbn('NrAsiento'))
              ACT(ET:1,BuscarCampo('ASIENTOSCON', 'Estado', 'NrUnicoAsiento', fbn('NrAsiento')))
              IF Incluido(Val(ET:1), 'COE|COT|COA|COR')
                 ACT(A:fac, Val(A:fac)~' Con ContraAsiento Nro '~fbn('NrAsiento'))
              ELSE
                  IF Incluido(Val(ET:1), 'NC|NCE')
                     ACT(A:fac, Val(A:fac)~' Con Nota de Credito Nro '~fbn('NrAsiento'))
                  ELSE
                      IF Incluido(Val(ET:1), 'REV|REE')
                         ACT(A:fac, Val(A:fac)~' Con Reversa Nro '~fbn('NrAsiento'))
                      ENDIF 
                  ENDIF
              ENDIF
          ENDIF
      ENDIF    
      IF Eqstr(fbn('Estado'), 'R')
          ACT(A:fac, Val(A:fac)~' - (Asiento Rechazado)')
          IF NoVacio(fbn('NrAsiento'))
              ACT(ET:1,BuscarCampo('ASIENTOSCON', 'Estado', 'NrUnicoAsiento', fbn('NrAsiento')))
              IF Incluido(Val(ET:1), 'COE|COT|COA|COR')
                 ACT(A:fac, Val(A:fac)~' Con ContraAsiento Nro '~fbn('NrAsiento'))
              ELSE
                  IF Incluido(Val(ET:1), 'NC|NCE')
                     ACT(A:fac, Val(A:fac)~' Con Nota de Credito Nro '~fbn('NrAsiento'))
                  ELSE
                      IF Incluido(Val(ET:1), 'REV|REE')
                         ACT(A:fac, Val(A:fac)~' Con Reversa Nro '~fbn('NrAsiento'))
                      ENDIF 
                  ENDIF
              ENDIF
          ENDIF
      ENDIF  
      
      IF Eqstr(fbn('Estado'), 'COT')
          ACT(A:fac, Val(A:fac)~' - (ContraAsiento Sin Enviar del Asiento '~fbn('NrAsiento')~')')
      ELSE
          IF Eqstr(fbn('Estado'), 'COE')
              ACT(A:fac, Val(A:fac)~' - (ContraAsiento Enviado del Asiento '~fbn('NrAsiento')~')')
          ELSE
              IF Eqstr(fbn('Estado'), 'NC')
                  ACT(A:fac, Val(A:fac)~' - (Nota de Credito sin Enviar del Asiento '~fbn('NrAsiento')~')')
              ELSE
                  IF Eqstr(fbn('Estado'), 'NCE')
                      ACT(A:fac, Val(A:fac)~' - (Nota de Credito Enviada del Asiento '~fbn('NrAsiento')~')')
                  ELSE
                      IF Eqstr(fbn('Estado'), 'REV')
                          ACT(A:fac, Val(A:fac)~' - (Reversa Sin Enviar del Asiento '~fbn('NrAsiento')~')')
                      ELSE
                          IF Eqstr(fbn('Estado'), 'REE')
                              ACT(A:fac, Val(A:fac)~' - (Reversa Enviada del Asiento '~fbn('NrAsiento')~')')
                          ELSE
                              IF Eqstr(fbn('Estado'), 'COA')
                                  ACT(A:fac, Val(A:fac)~' - (ContraAsiento Aceptado del Asiento '~fbn('NrAsiento')~')')
                              ELSE
                                  IF Eqstr(fbn('Estado'), 'COR')
                                        ACT(A:fac, Val(A:fac)~' - (ContraAsiento Rechazado del Asiento '~fbn('NrAsiento')~')')
                                  ENDIF                              
                              ENDIF
                          ENDIF
                      ENDIF
                  ENDIF
              ENDIF
          ENDIF
      ENDIF
      SetFont(a:fac..r:fac, 2)
      IFA
      SCN(TF:1, 1)
   Endif

   ACT(a:fac, FECHA(fbn('FechaGeneracion'))~' - '~FECHA(fbn('Fecha1')))
   *ACT(a:fac, FECHA(fbn('FechaGeneracion')))
   ACD(b:fac, FECHA(fbn('FechaValor')))
   ACT(CT:1, Reemplazar(MIRT(Reemplazar(fbn('Cuenta'),0,' ')),' ',0))
   ACT(CT:2, Copy(val(CT:1),1,longitud(val(CT:1))-1)~'-'~Copy(val(CT:1),longitud(val(CT:1)),1))
   ACT(c:fac, VAL(CT:2)~' - '~BuscarCampo('CONTABILIDAD','Nombre','Codigo', fbn('Cuenta')))

   ACT(d:fac, fbn('Especie1'))
   If Eqstr(fbn('DebitoCredito'),'DEB')
      ACN(e:fac, fbn('Cantidad1'))
   Else
      ACN(f:fac, fbn('Cantidad1'))
   Endif

   *ACT(g:fac, fbn('Especie2'))
   *If Eqstr(fbn('DebitoCredito'),'DEB')
   *   ACN(h:fac, fbn('Cantidad2'))
   *Else
   *   ACN(i:fac, fbn('Cantidad2'))
   *Endif
   
   *ACT(j:fac, fbn('Especie3'))
   *If Eqstr(fbn('DebitoCredito'),'DEB')
   *   ACN(k:fac, fbn('Cantidad3'))
   *Else
   *   ACNtfac, fbn('Cantidad3'))
   *Endif

   ACT(g:fac,  fbn('CentroCosto')~' - '~BuscarCampo('CENTROSCOSTO','Descripcion','Codigo', fbn('CentroCosto')))
   ACT(h:fac,  fbn('Especie')~' - '~BuscarCampo('ESPECIES','Codigo4','Codigo', fbn('Especie'))) 
   ACT(i:fac,  fbn('Modelo'))
*   ACL(o:fac, 'INV005',String=fbn('Modelo'))
   ACT(j:fac,  fbn('NrUnicoAsiento'))
   ACT(k:fac,  fbn('NrItem'))
   
   
   If NoVacio(fbn('NrOperacion'))
    ACT(l:fac,  fbn('NrOperacion'))
      If NoVacio(FBN['TipOp'])
         IF SQL(" Select 1 from "~DBO~".OPERACIONES Where NrOperacion='"~fbn('NrOperacion')~"' ")=1
            ACLO(l:fac, fbn('NrOperacion'))
         Else
            ACLBO(l:fac, fbn('NrOperacion'))
         EndIf
      Else
         IF SQL(" Select 1 from "~DBO~".TRANSACCIONES2 Where NrTrans='"~fbn('NrOperacion')~"' ")=1
            ACLT(l:fac, fbn('NrOperacion'))
         Else
            ACLBT(l:fac, fbn('NrOperacion'))
         EndIf
      EndIf
   EndIf
   *ACT(l:fac,  fbn('Libro'))
   If NoVacio(fbn('NrTrans2'))
      ACT(M:fac,  fbn('NrTrans2')) 
      ACN(BD:1, 0)
      SQL.ADD(" Select TipoTr2, Mercado1 From "~DBO~".TRANSACCIONES2 Where NrTrans='"~fbn('NrTrans2')~"' ")
      Recorrer SQL
        DFA
        ACT(O:fac, fbn('TipoTr2'))
        ACT(P:fac, fbn('Mercado1')~' - '~IIF(Eqstr(BuscarCampo('MERCADOS','Netea','Codigo', fbn('Mercado1')), 'SI'), 'Netea', 'NO Netea'))
        ACN(BD:1, 1)
      Proximo
      IF Val(BD:1) = 0
        ACLBT(M:fac, fbn('NrTrans2'))
      ELSE
         ACLT(M:fac, fbn('NrTrans2'))
      ENDIF
   EndIf
   *ACT(m:fac,  fbn('Alias4'))
   *ACT(n:fac,  fbn('Alias2'))   
   ACT(R:fac,  fbn('Alias2')) 
   ACT(N:fac,  FBN['TipOp'])   
   ***---ACT(n:fac,  IIF(Eqstr(BuscarCampo('CLIENTES','PaisDir','Codigo', fbn('Alias2')), 'ARG'), 'SI', 'NO') )
   *ACT(q:fac,  FBN['Vehiculo'])
   *ACT(r:fac,  FBN['Valor3'])
   

   act(az:1,BuscarCampo('CLIENTES','AliasBT','Codigo', fbn('Alias3')))
   *--*Ubicacion de guion de Alias5
   ACN(PO:1,Posicion('-',fbn('Alias5'),1))
   ACT(CC:1,Copy(fbn('Alias5'),1,val(PO:1)-1))
 
   if Eqstr(val(CC:1),val(az:1)) o Vacio(val(az:1))
       ACT(s:fac, val(CC:1))
   else
       ACT(s:fac, val(CC:1)~' - '~val(az:1)) 
   endif
   
   
   ** Valor Nominal solo para Revaluo Titulos Diario
   If [NoVacio(Dialogo.Lista3) Y Incluido(VAR('TIPASRETID'),Dialogo.Lista3)] or Vacio(Dialogo.Lista3)
      SQL.ADD(" Select P.CantidadFin, P.Especie, P.Vehiculo, P.Book, P.Cupon ")
      SQL.ADD(" From "~DBO~".POSICIONES P ")
      SQL.ADD(" Where P.Especie = '"~FBN['Especie']~"' ")
      SQL.ADD(" AND P.Cliente = '"~FBN['Vehiculo']~"' ")
      SQL.ADD(" AND P.Vehiculo = '"~FBN['Vehiculo']~"' ")
      SQL.ADD(" AND P.Fecha <= '"~IdxDate(Val(b:fac))~"' ")
      SQL.ADD(" AND P.CantidadFin <> 0 ")
      SQL.ADD(" AND P.Book = '"~FBN['Alias2']~"' ")
      SQL.ADD(" AND P.Cupon = '"~FBN['Alias3']~"' ")
      SQL.ADD(" AND P.NrSaldo = '171' ")
      SQL.ADD(" AND P.Fecha IN (Select Max(Fecha) From "~DBO~".POSICIONES P1 ")
      SQL.ADD("      Where P1.Especie = P.Especie ")
      SQL.ADD("      AND P1.Vehiculo = P.Vehiculo ")
      SQL.ADD("      AND P1.Cliente = P.Cliente ")
      SQL.ADD("      AND P1.NrSaldo = P.NrSaldo ")
      SQL.ADD("      AND P1.Book = P.Book ")
      SQL.ADD("      AND (P1.Cupon = P.Cupon OR ((P1.Cupon Is Null OR P1.Cupon = '' OR P1.Cupon = ' ') AND (P.Cupon Is Null OR P.Cupon = '' OR P.Cupon = ' ' ))) ")
      SQL.ADD("      AND (P1.Sector = P.Sector OR ((P1.Sector Is Null OR P1.Sector = '' OR P1.Sector =' ') AND (P.Sector Is Null OR P.Sector = '' OR P.Sector = ' ' ))) ")
      SQL.ADD("      AND (P1.CallPut = P.CallPut OR ((P1.CallPut Is Null OR P1.CallPut = '' OR P1.CallPut = ' ') AND (P.CallPut Is Null OR P.CallPut = '' OR P.CallPut = ' ' ))) ")
      SQL.ADD("      AND (P1.FechaEj = P.FechaEj OR ((P1.FechaEj  Is Null OR P1.FechaEj = '' OR P1.FechaEj = ' ') AND (P.FechaEj IS Null OR P.FechaEj = '' OR P.FechaEj = ' ' ))) ")
      SQL.ADD("      AND (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj Is Null OR P1.PrecioEj = '' OR P1.PrecioEj =' ') AND (P.PrecioEj Is Null OR P.PrecioEj = '' OR P.PrecioEj = ' ' ))) ")
      SQL.ADD("      AND P1.Fecha <= '"~IdxDate(Val(b:fac))~"') ")
      Recorrer SQL
        DFA
        ACN(q:fac, fbn('CantidadFin'))
        If Val(q:fac) <> 0
        ACL(q:fac, 'PORECO', Fecha1=Val(b:fac), Especie1=FBN['Especie'], Vehiculo1=FBN['Vehiculo'], Book1=FBN['Book'], String1=FBN['Cupon'])
        EndIf
      Proximo
   EndIf
   
   If NoVacio(Dialogo.CuentaContable1)
     SCN(dt:1, Val(e:fac))
     SCN(ct:1, Val(f:fac))
     SCN(dt:2, Val(i:fac))
     SCN(ct:2, Val(j:fac))
     SCN(dt:3, Val(l:fac))
     SCN(ct:3, Val(m:fac))       
     ACN(bd:2, 1)
   EndIf

   ACT(as:1, fbn('NrUnicoAsiento'))
   ACT(mn:1, fbn('Especie1'))
   ACD(FE:1, fbn('FechaGeneracion'))
   SetFont(a:fac..s:fac, 1)
   AlinearCeldas(D:fac..s:fac+1, 'C')
   AlinearCeldas(g:fac, 'I')
Proximo
*SetFilaActual(fac+2)
ifa

If Val(bd:2) = 1
  ACT(A:fac, 'Total Cuenta:')
  ACN(E:FAC, Val(dt:1)) 
  ACN(F:FAC, Val(ct:1))
  ACN(I:FAC, Val(dt:2)) 
  ACN(J:FAC, Val(ct:2))
  ACN(L:FAC, Val(dt:3))
  ACN(M:FAC, Val(ct:3))
  SetFont(A:fac..s:fac, 2)
  AgregarMarco(A:fac..s:fac, 0, 0, Exe('COLOR6'))

  SetFilaActual(FAC+1)
  ACT(A:fac, 'Cantidad de Asientos: '~Fstr(Val(TF:1), 0, 0))
  SetFont(A:fac, 2)
  AgregarMarco(A:fac..s:fac, 0, 0, Exe('COLOR8'))
Else
  ACT(A:fac, 'Cantidad de Asientos: '~Fstr(Val(TF:1), 0, 0))
  SetFont(A:fac, 2)
  AgregarMarco(A:fac..s:fac, 0, 0, Exe('COLOR8'))
EndIf
