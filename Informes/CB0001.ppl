  Fecha1           :  'D.Fec.Gener'           ;1;;;Dialogo.Check2=0 y Dialogo.Check3=0 y Dialogo.Check4=0;;;;;FSYS
  Fecha2           :  'H.Fec.Gener'           ;2;;;Dialogo.Check2=0 y Dialogo.Check3=0 y Dialogo.Check4=0;;;;;FSYS
  Fecha3           :  'D.Fec.Valor'           ;4;;;Dialogo.Check2=0 y Dialogo.Check3=0 y Dialogo.Check4=0;;;;;HABILES(FSYS,-Var('CONTVALOR'),'ARG')
  Fecha4           :  'H.Fec.Valor'           ;5;;;Dialogo.Check2=0 y Dialogo.Check3=0 y Dialogo.Check4=0;;;;;FSYS
  Check1           :  'Filtra F.Ejec'         ;1;2;;;;;;;0
  Fecha5           :  'D.Fec.Ejec'            ;2;2;;Dialogo.Check2=0;Dialogo.Check1=1 ;;;;FSYS
  Fecha6           :  'H.Fec.Ejec'            ;3;2;;Dialogo.Check2=0;Dialogo.Check1=1 ;;;;FSYS
  Check2           :  'Filtra Oper.'          ;4;2;;;;;;;0
  NrOperacion1     :  'Operacion'             ;5;2;;Dialogo.Check2=1;Dialogo.Check2=1;;;;;;;;;
  Check4           :  'Filtra Oper.Anu.'      ;6;2;;;;;;;0
  NrBOperacion     :  'Operacion Anulada'     ;7;2;;Dialogo.Check4=1;Dialogo.Check4=1;;;;;;;;;
  Check3           :  'Filtra Asiento'        ;8;2;;;;;;;0
  NrUnicoAsiento1  :  'Nr Asiento'            ;9;2;;Dialogo.Check3=1;Dialogo.Check3=1;
  ModeloAsiento1   :  'Modelo'                ;6;1;;;;;;
