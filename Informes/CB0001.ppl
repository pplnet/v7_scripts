  Radio1           :  'Estado|Enviados|NO Enviados|Rechazado|Aprobado|Todos' ;6;1;;;;;;;4;
  Lista3           :  'Tipo Asiento'          ;7;1;;;;;;;;;SQLSET("Select Codigo from "~DBO~".TIPOSASIENTO");;;;;
FinDialogo


