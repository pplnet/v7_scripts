ModoReproceso(ConDialogo)
CrearDialogo
  Radio1    : 'Calculo|FPA|MAE' ;1;1;;;;;;;0;
  Fecha1    : 'Fecha'     ;3;1;;;;Dialogo.Fecha1 <> 0;'Fecha Invalida';NO;FSys
  Cliente1  : 'Agente'    ;1;2;;;;Vacio(Dialogo.Cliente1) O Incluido(Dialogo.Cliente1, SQLSet(" Select Codigo From "~DBO~".CLIENTES Where NrMAE Is Not Null AND NrMAE <> '0' "));'Agente Invalido';NO;;;;;;" NrMAE Is Not Null AND NrMAE <> '0' ";
  Vehiculo1 : 'Vehiculo'  ;3;2;;NO;;NoVacio(Dialogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

**AgregarBMP(A:1, Exe('LOGO'), 60)
ACT(a:2, Codigoinforme)
SetFilaActual(4)
ACT(C:Fac, 'MTM por Agente')
SetFont(C:fac, 3)
SetFilaActual(fac+2)
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
if NoVacio(Dialogo.Cliente1)
  ACT(A:fac, 'Agente: '~Dialogo.Cliente1)
else
  ACT(A:fac, 'Agentes: Todos')
endif
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
ifa
if Dialogo.Radio1 = 0
  ACT(A:fac, 'Calculo FPA')
else
  ACT(A:fac, 'Calculo MAE')
endif
SetFont(A:fac-3..A:fac, 1)
SetFilaActual(fac+2)
ACT(A:fac, 'Agente')
ACT(B:fac, 'Especie')
ACT(C:fac, 'Vto')
ACT(D:fac, 'MTM')
SetFont(A:fac..D:fac, 1)
AlinearCeldas(A:fac..D:fac, 'C')
AgregarMarco(A:fac..D:fac, 0, 0, Exe('COLOR'))
ACN(BD:1, 0)
ACN(FI:1, fac+1)
IF Dialogo.Radio1 = 0
    ***---Calculo FPA
    SQL.ADD(" Select M.Cliente, O.Especie, M.NrOperacion, M.Cantidad, O.FechaVto ")
    SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".MOVEJECUTADOS M ")
    SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
    SQL.ADD(" AND O.TipoOp IN ('FXOCTC','FXOCTV') ")
    SQL.ADD(" AND M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' ")
    IF NoVacio(Dialogo.Cliente1)
        SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
    ENDIF
    SQL.ADD(" AND M.NrSaldo = 100 ")
    SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
ELSE
    ***---Calculo MAE
    SQL.ADD(" Select Cliente, Especie, NroAltaMAE, Monto Cantidad, FechaVto ")
    SQL.ADD(" From "~DBO~".MTMDETOCT ")
    SQL.ADD(" Where TipoOp IN ('FXOCTC','FXOCTV') ")
    SQL.ADD(" AND FechaProc = '"~IdxDate(Dialogo.Fecha1)~"' ")
    IF NoVacio(Dialogo.Cliente1)
        SQL.ADD(" AND Cliente = '"~Dialogo.Cliente1~"' ")
    ENDIF
ENDIF
SQL.ADD(" Order By 1, 2, 5 ")
Recorrer SQL
    ACN(BD:1, 1)
    SCN(TO:1, fbn('Cantidad'))
    IF Not Eqstr(fbn('Cliente'), Val(CL:1))
        IF Not CeldaVacia(CL:1)
            SetFont(A:Val(FA:1)+1..D:fac, 2)
        ELSE
            ifa
        ENDIF
        ACT(A:fac, fbn('Cliente'))
        SCN(D:fac, fbn('Cantidad'))
        ACN(FA:1, fac)
        SetFont(A:fac..D:fac, 1)
        AgregarMarco(A:fac..D:fac, 0, 0, Exe('COLOR10'))
        ACL(D:fac, 'DETOCT', Fecha1 = Dialogo.Fecha1, NrTrans1 = '', Vehiculo1 = Dialogo.Vehiculo1, Cliente1 = fbn('Cliente'), Especie1 = '', Fecha2 = 0, Radio1 = Dialogo.Radio1)
        ifa
        ACT(B:fac, fbn('Especie'))
        ACD(C:fac, fbn('FechaVto'))
        SCN(D:fac, fbn('Cantidad'))
        ACN(FE:1, fac)
        ACT(CL:1, fbn('Cliente'))
        ACT(ES:1, fbn('Especie'))
        ACD(FV:1, fbn('FechaVto'))
        ACL(D:fac, 'DETOCT', Fecha1 = Dialogo.Fecha1, NrTrans1 = '', Vehiculo1 = Dialogo.Vehiculo1, Cliente1 = fbn('Cliente'), Especie1 = fbn('Especie'), Fecha2 = fbn('FechaVto'), Radio1 = Dialogo.Radio1)
    ELSE
        SCN(D:Val(FA:1), fbn('Cantidad'))
        ACL(D:fac, 'DETOCT', Fecha1 = Dialogo.Fecha1, NrTrans1 = '', Vehiculo1 = Dialogo.Vehiculo1, Cliente1 = fbn('Cliente'), Especie1 = '', Fecha2 = 0, Radio1 = Dialogo.Radio1)
        if Not Eqstr(fbn('Especie'), Val(ES:1)) O fbn('FechaVto') <> Val(FV:1)
            ACT(B:fac, fbn('Especie'))
            ACD(C:fac, fbn('FechaVto'))
            SCN(D:fac, fbn('Cantidad'))
            ACN(FE:1, fac)
            ACT(ES:1, fbn('Especie'))
            ACD(FV:1, fbn('FechaVto'))
            ACL(D:fac, 'DETOCT', Fecha1 = Dialogo.Fecha1, NrTrans1 = '', Vehiculo1 = Dialogo.Vehiculo1, Cliente1 = fbn('Cliente'), Especie1 = fbn('Especie'), Fecha2 = fbn('FechaVto'), Radio1 = Dialogo.Radio1)
        ELSE
            DFA
            SCN(D:Val(FE:1), fbn('Cantidad'))
            ACL(D:fac, 'DETOCT', Fecha1 = Dialogo.Fecha1, NrTrans1 = '', Vehiculo1 = Dialogo.Vehiculo1, Cliente1 = fbn('Cliente'), Especie1 = fbn('Especie'), Fecha2 = fbn('FechaVto'), Radio1 = Dialogo.Radio1)
        ENDIF
    ENDIF
Proximo
IF Val(BD:1) = 0 Y Dialogo.Radio1 = 0
    Cancelar('El MTM del Dia No Ha Sido Procesado')
ENDIF
IF Val(BD:1) = 0 Y Dialogo.Radio1 = 1
    Cancelar('No se ha Recibido el MTM MAE del Dia')
ENDIF
SetFont(A:Val(FA:1)+1..D:fac, 2)

SetFilaActual(fac+2)
ACT(A:fac, 'Total Multilateral')
ACN(D:fac, Val(TO:1))
ACL(D:fac, 'DETOCT', Fecha1 = Dialogo.Fecha1, NrTrans1 = '', Vehiculo1 = Dialogo.Vehiculo1, Cliente1 = IIF(NoVacio(Dialogo.Cliente1), Dialogo.Cliente1, ''), Especie1 = '', Fecha2 = 0, Radio1 = Dialogo.Radio1)
SetFont(A:fac..D:fac, 1)
FormatoCeldas(D:Val(FI:1)..D:fac, Exe('F2'))
AgregarMarco(A:fac..D:fac, 0, 0, Exe('COLOR'))

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 1)
ACO(4, 12)
LimitesVision(E:fac+1)
