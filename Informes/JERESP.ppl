ModoReproceso(ConDialogo)
CrearDialogo
   Especie1: 'Especie' ;;;;;;;;
FinDialogo

if Not Ok
 Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

If Vacio(Dialogo.Especie1)
   SQL.ADD(" SELECT Jerarquia, Codigo,Nombre")
   SQL.ADD(" FROM "~DBO~".ESPECIES ")
   If NoVacio(Dialogo.Especie1)
      SQL.ADD(" WHERE Codigo='"~Dialogo.Especie1~"' ")
   EndIf
   SQL.ADD(" ORDER BY Jerarquia ")
   Recorrer SQL
      ACN(je1,Num(Copy(FBN['Jerarquia'],1,3)))
      ACN(je2,Num(Copy(FBN['Jerarquia'],4,3)))
      ACN(je3,Num(Copy(FBN['Jerarquia'],7,3)))
      ACN(je4,Num(Copy(FBN['Jerarquia'],10,3)))
      ACN(je5,Num(Copy(FBN['Jerarquia'],13,3)))

      if Val(je5)<>0
         ACN(co1,5)
      else
         if Val(je4)<>0
            ACN(co1,4)
         else
            if Val(je3)<>0
               ACN(co1,3)
            else
               if Val(je2)<>0
                  ACN(co1,2)
               else
                  if Val(je1)<>0
                     ACN(co1,1)
                  endif
               endif
            endif
         endif
      endif
      ACT(Val(co1):fac, FBN['Codigo'])
      if Not EsTerminal(FBN['Codigo'],ESPECIES)
         SetFont(Val(co1):fac,2)
      endif
   Proximo
Else
   ACN(co1,0)
   ACN(co2,0)
   ACN(co3,0)
   ACN(co4,0)
   ACN(co5,0)
   ACT(aa1, BuscarCampo('ESPECIES','Jerarquia','Codigo',Dialogo.Especie1))

   ACN(je1,Num(Copy(Val(aa1),1,3)))
   ACN(je2,Num(Copy(Val(aa1),4,3)))
   ACN(je3,Num(Copy(Val(aa1),7,3)))
   ACN(je4,Num(Copy(Val(aa1),10,3)))
   ACN(je5,Num(Copy(Val(aa1),13,3)))

   if Val(je5)<>0
      ACT(5:5, Dialogo.Especie1)
      SetFont(5:5,2)
   endif
   if Val(je4)<>0
      ACT(4:4, BuscarCampo('ESPECIES','Codigo','Jerarquia',PAD(Copy(Val(aa1),1,12),15,'0')))
      SetFont(4:4,2)
   endif
   if Val(je3)<>0
      ACN(co3,1)
      ACT(3:3, BuscarCampo('ESPECIES','Codigo','Jerarquia',PAD(Copy(Val(aa1),1,9),15,'0')))
      SetFont(3:3,2)
   endif
   if Val(je2)<>0
      ACN(co2,1)
      ACT(2:2, BuscarCampo('ESPECIES','Codigo','Jerarquia',PAD(Copy(Val(aa1),1,6),15,'0')))
      SetFont(2:2,2)
   endif
   if Val(je1)<>0
      ACN(co1,1)
      ACT(1:1, BuscarCampo('ESPECIES','Codigo','Jerarquia',PAD(Copy(Val(aa1),1,3),15,'0')))
      SetFont(1:1,2)
   endif

EndIf

LimitesVision(x:fac)