 if Not EqStr(fbn('Especie'),Val(aa:1))
    if Val(aa:2) = 1
       ifa
       ACT(a:fac,Val(aa:1)~' - '~Val(aa:8) )
       *Saldo inicial
       ACN(b:fac,Val(aa:3))
       ACT(z:3,  Val(aa:1)) 
       
       ACT(z:1,' = '~idxdate2(Dialogo.Fecha1))
       ACT(z:8,      idxdate2(Habiles(Dialogo.Fecha1,0,'ARG')))
       ACN(z:9,      171)
       
       (.'CARPRODIA'.)
       IF Val(z:4)<>0
          ACN(c:fac,Val(z:4))
       ENDIF
       IF Val(z:5)<>0
          ACN(d:fac,Abs(Val(z:5)))
       EndIf
       IF Vacio(val(c:fac))
          acn(c:fac,0)
       endif    
       IF Vacio(val(d:fac))
          acn(d:fac,0)
       endif    
       *Saldo final
       ACN(e:fac, val(b:fac)+val(c:fac)-val(d:fac))

              **Linea en cero no se informa
       If Val(aa:3)=0 y Val(e:fac)=0 y Val(c:fac)=0 y Val(d:fac)=0
          BorrarCeldas(a:fac..e:fac)
          dfa
       else
          FormatoCeldas(b:fac..e:fac,Exe('F2'))
          SetFont(a:fac..e:fac,1)
          AgregarMarco(a:fac..e:fac,0,3)
       Endif
    else
       ACN(aa:2,1)
    endif
    ACT(aa:1, fbn('Especie') )
    ACT(aa:8, fbn('Nombre') )
    ACN(aa:3, 0)
 endif

 if EqStr(fbn('Tipo'),'0')
    SCN(aa:3,fbn('Saldo'))
 endif
 
 
