  ACT(a:fac,fbn('Cliente')~' - '~fbn('RazonSocial'))
  SetFont(a:fac,2)
  AgregarMarco(a:fac..d:fac,0,0)
  ACT(aa:1,fbn('Cliente'))
 endif

 if EqStr(fbn('Tipo'),'0')
    SCN(aa:5,fbn('Saldo'))
 endif
 if EqStr(fbn('Tipo'),'1')
    SCN(aa:6,fbn('Saldo'))
 endif
