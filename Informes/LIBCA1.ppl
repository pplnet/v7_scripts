    SQL.ADD("UNION ALL ")

    SQL.ADD("SELECT Distinct S1.Especie, E.Nombre, S1.Cliente, S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior,  ")
    SQL.ADD("       E.TasaIntVigente, '0' Saldo,E.Alias5, E.InteresesC, '0' Tipoc, '0' Cupon, ' ' TipoOp                         ")
    SQL.ADD("FROM   "~DBO~".MOVPOSEJE S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                                 ")
    SQL.ADD("WHERE  S1.Cliente = C.Codigo                        AND                                                             ")
    SQL.ADD("       S1.Cliente='"~Dialogo.Vehiculo1~"'           AND                                                             ")
