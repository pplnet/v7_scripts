SQL.ADD("Select O.*, '1' as Tipo, C.RazonSocial ")
SQL.ADD("  from  "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD(" where O.Especie =  E.Codigo ")
if Dialogo.Check1=0
SQL.ADD("   and IsNull(O.EsTBills,'')    <> 'SI'  ")
endif
SQL.ADD("   and O.Cliente1 =  C.Codigo ")
SQL.ADD("   and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("   and O.TipoOp  in ('TIC','TIV','TCOPRI') ")
** FJL 30/06/21 - Para que no tome las operaciones que son por Cta y Orden
SQL.ADD("   and ((O.TipoOp  in ('TIC','TIV') and IsNull(CB4,'0')='0') ")
SQL.ADD("     or (O.TipoOp = 'TCOPRI' and O.Corporate = 1)")
SQL.ADD("       ) ")
SQL.ADD(" union ")
SQL.ADD("Select O.*, '2' as Tipo, C.RazonSocial ")
SQL.ADD("  from "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD(" where O.Especie =  E.Codigo ")
if Dialogo.Check1=0
SQL.ADD("   and IsNull(O.EsTBills,'')    <> 'SI'  ")
endif
SQL.ADD("   and O.Cliente1 =  C.Codigo ")
SQL.ADD("   and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and O.TipoOp  in ('TIPA','TIPP') ")
SQL.ADD(" Order by O.Especie, O.Cupon1, Tipo ")   

**           Movimientos   aa -- ar
recorrer SQL
  ACT(aa:FAC, fbn('Especie'))  
  ACN(ab:FAC, fbn('Cupon1'))  
  ACT(ac:FAC, fbn('Tipo'))  
  ACT(ad:FAC, fbn('TipoOp'))  
  ACD(ae:FAC, fbn('FechaVto'))  
  ACN(af:FAC, fbn('Cantidad'))  
  ACT(ag:FAC, fbn('NrOperacion'))  
  ACT(at:FAC, fbn('RazonSocial'))
  
    ACT(ah:FAC, fbn('TipoOp'))
    if EqStr(Val(ad:FAC),Val(ah:FAC))
      ACT(ai:FAC, 'OK')
    else
      ACT(ai:FAC, 'Mal')
    endif
    if Incluido(Val(ah:FAC),'TIC|TIV|TIAJUC|TIAJUV|TIPA|TIPP|TCOPRI')
      ACD(aj:FAC, fbn('FechaOp'))
      if Incluido(Val(ah:FAC),'TIC|TIV|TIAJUC|TIAJUV|TCOPRI')
** FJL 27/10/20 - FechaVto Original
*        ACD(ak:FAC, fbn('FechaVto'))
        if fbn('FechaPago')>0
          ACD(ak:FAC, fbn('FechaPago'))
        else
          ACD(ak:FAC, fbn('FechaVto'))
        endif
        ACT(ao:FAC, fbn('ContraEspecie'))
        if Incluido(Val(ah:FAC),'TIC|TIAJUC|TCOPRI')
          ACN(ap:FAC, -fbn('TotalNetoCli1'))
        else
          ACN(ap:FAC, fbn('TotalNetoCli1'))
        endif
        ACN(av:FAC, ABS(Val(ap:FAC)/Val(af:FAC)))
      else
        ACD(al:FAC, fbn('FechaPago'))
        ACD(am:FAC, fbn('FechaVto'))
        if Val(al:FAC)=Val(ae:FAC)
          ACD(ak:FAC, Val(al:FAC))
          ACT(an:FAC, 'Pata Spot')
          ACT(ao:FAC, fbn('ContraEspecie'))
          if Incluido(Val(ah:FAC),'TIPA')
            ACN(ap:FAC, -fbn('TotalNetoCli1'))
          else
            ACN(ap:FAC, fbn('TotalNetoCli1'))
          endif
          ACN(av:FAC, ABS(Val(ap:FAC)/Val(af:FAC)))
        else
          if Val(am:FAC)=Val(ae:FAC)
            ACD(ak:FAC, Val(am:FAC))
            ACT(an:FAC, 'Pata Fut')
            ACT(ao:FAC, fbn('ContraEspecie'))
            if Incluido(Val(ah:FAC),'TIPA')
              ACN(ap:FAC, fbn('TotalNetoCli1'))
            else
              ACN(ap:FAC, -fbn('TotalNetoCli1'))
            endif
            ACN(av:FAC, ABS(Val(ap:FAC)/Val(af:FAC)))
          else
            ACD(ak:FAC, Val(ae:FAC))
            ACT(an:FAC, 'Error')
          endif
        endif
      endif
    else
if no
      * Para CUPON
      ACT(ah:FAC, BuscarCampo('TRANSACCIONES2','TipoTr2','NrTrans',Val(ag:FAC)))
      if EqStr(Val(ad:FAC),Val(ah:FAC))
        ACT(ai:FAC, 'OK')
      else
        ACT(ai:FAC, 'Mal')
      endif
*      ACD(aj:FAC, BuscarCampo('TRANSACCIONES2','FechaOp','NrOperacion',Val(ag:FAC)))
*      ACD(ak:FAC, BuscarCampo('TRANSACCIONES2','FechaVto','NrOperacion',Val(ag:FAC)))
*      ACT(ao:FAC, BuscarCampo('TRANSACCIONES2','ContraEspecie','NrOperacion',Val(ag:FAC)))
*      ACN(ap:FAC, BuscarCampo('TRANSACCIONES2','TotalNetoCli1','NrOperacion',Val(ag:FAC)))
endif
    endif

  ACN(aq:FAC, FAC)
  ACT(as:FAC, BuscarCampo('ESPECIES','CodMAEContado','Codigo',Val(aa:FAC)))
  ACT(ar:FAC, Pad(Val(as:FAC),10)~Pad0(FStr(Val(ab:FAC),1,0),3)~LPad(Val(ac:FAC),2)~Pad(Val(ao:FAC),10)~Pad0(FStr(Anio(Val(aj:FAC)),1,0),4)~Pad0(FStr(Mes(Val(aj:FAC)),1,0),4)~Pad0(FStr(Dia(Val(aj:FAC)),1,0),4))
  ACT(au:FAC, Val(as:FAC))
  if Val(ab:FAC)>0
     ACT(au:FAC, Val(au:FAC)~' '~FStr(Val(ab:FAC),1,0))
  endif
  if EqStr(BuscarCampo('ESPECIES','EsCupon','Codigo',Val(aa:FAC)),'SI')
     ACT(au:FAC, Val(au:FAC)~' Cup')
  endif
proximo

** Consolidacion Movimientos   ba -- bk

if FAC>1
  BorrarCeldas(v:2..z:10)
  OrdenarFilas(2,FAC,44,'A')
  FormatoCeldas(af:2..af:FAC,Exe('F2'))
  FormatoCeldas(ap:2..ap:FAC,Exe('F2'))
  FormatoCeldas(bd:2..bd:FAC,Exe('F8'))
  SetFont(aa:2..av:FAC,3)
  ACN(y4, FAC)
  ACN(y5, 1)
  recorrer&i 2,Val(y4)
    if Not EqStr(Val(as:&i),Val(v1)) o Val(ab:&i)<>Val(v2) o Not EqStr(Val(ac:&i),Val(v3)) o Not EqStr(Val(ao:&i),Val(v4)) o Val(aj:&i)<>Val(v5)
      if &i>2
        if Val(bc:Val(y5))>-0.01 y Val(bc:Val(y5))<0.01
          BorrarCeldas(ba:Val(y5)..bj:Val(y5))
          SCN(y5, -1)
        else
          if Val(bc:Val(y5))>0
            ACT(ba:Val(y5), 'Incremento')
          else
            ACT(ba:Val(y5), 'Disminucion')
          endif
          if EqStr(Val(v3),'2')
            ACT(ba:Val(y5), Val(ba:Val(y5))~' Por Pase')
          endif
          if EqStr(Val(v3),'3')
            ACT(ba:Val(y5), Val(ba:Val(y5))~' Por Corte')
          endif
          if EqStr(Val(v3),'4')
            ACT(ba:Val(y5), Val(ba:Val(y5))~' Por Ajuste')
          endif
          ACN(bd:Val(y5), -Val(bf:Val(y5))/Val(bc:Val(y5)))
        endif
      endif
      SCN(y5, 1)
      ACT(bb:Val(y5), Val(au:&i))
      ACT(be:Val(y5), Val(ao:&i))
      ACD(bg:Val(y5), Val(aj:&i))
      ACD(bh:Val(y5), Val(ak:&i))
      ACT(bi:Val(y5), Val(aa:&i))
      ACN(bj:Val(y5), Val(ab:&i))
      ACT(bk:Val(y5), Val(ad:&i))
      ACT(v1, Val(as:&i))
      ACN(v2, Val(ab:&i))
      ACT(v3, Val(ac:&i))
      ACT(v4, Val(ao:&i))
      ACD(v5, Val(aj:&i))
    endif
    SCN(bc:Val(y5), Val(af:&i))
    SCN(bf:Val(y5), Val(ap:&i))
  proximo
  if Val(y5)>1
    if Val(bc:Val(y5))>-0.01 y Val(bc:Val(y5))<0.01
      BorrarCeldas(ba:Val(y5)..bj:Val(y5))
      SCN(y5, -1)
    else
      if Val(bc:Val(y5))>0
        ACT(ba:Val(y5), 'Incremento')
      else
        ACT(ba:Val(y5), 'Disminucion')
      endif
      if EqStr(Val(v3),'2')
        ACT(ba:Val(y5), Val(ba:Val(y5))~' Por Pase')
      endif
      if EqStr(Val(v3),'3')
        ACT(ba:Val(y5), Val(ba:Val(y5))~' Por Corte')
      endif
      if EqStr(Val(v3),'4')
        ACT(ba:Val(y5), Val(ba:Val(y5))~' Por Ajuste')
      endif
      ACN(bd:Val(y5), -Val(bf:Val(y5))/Val(bc:Val(y5)))
    endif
  endif
  if Val(y5)>1
    SetFont(ba:2..bk:Val(y5),3)
    FormatoCeldas(bc:2..bf:Val(y5),Exe('F2'))
    FormatoCeldas(bd:2..bd:Val(y5),Exe('F8'))
    ACN(y6,1)
    recorrer&i 2,Val(y5)
      if Not EqStr(Val(bb:&i),Val(v6))
        SCN(y6,1)
        ACT(ca:Val(y6), Val(bb:&i))
        ACT(cc:Val(y6), Val(bi:&i))
        ACN(cd:Val(y6), Val(bj:&i))
        ACT(v6, Val(bb:&i))
      endif
      if Val(bc:&i) > 0
         SCN(cb:Val(y6), Val(bc:&i))
      else
         SCN(cf:Val(y6), Val(bc:&i))
      endif
    proximo
  endif
endif


