*    SQL.ADD("       E.TasaIntVigente,  S1.Cantidad Saldo,E.Alias5, E.InteresesC, '0' Tipoc, '0' Cupon, ' ' TipoOp                ")
    SQL.ADD("       E.TasaIntVigente,  '0' Saldo, E.Alias5, E.InteresesC, '0' Tipoc, '0' Cupon, ' ' TipoOp                ")
    SQL.ADD("FROM   "~DBO~".MOVPOSPEN S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                                 ")
    SQL.ADD("WHERE  S1.Cliente = C.Codigo AND                                                                                    ")
    SQL.ADD("       S1.Cliente='"~Dialogo.Vehiculo1~"' AND                                                                       ")
    SQL.ADD("       E.Codigo = S1.Especie AND                                                                                    ")
    if Dialogo.Check1=0   
    SQL.ADD("       IsNull(E.Tipo,'') <> 'TBL' AND                                                                               ")
    endif
    SQL.ADD("       E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND                                                               ")
    SQL.ADD("       Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND                                                             ")
    SQL.ADD("       S1.Vehiculo = '"~Dialogo.Vehiculo1~"' AND                                                                    ")
    SQL.ADD("       S1.NrSaldo  = 171 and                                                                                        ")
    SQL.ADD("       S1.Cantidad <> 0 AND                                                                                         ")
    SQL.ADD("       (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
