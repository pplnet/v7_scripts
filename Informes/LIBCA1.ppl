    SQL.ADD("       E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'    AND                                                             ")
    SQL.ADD("       Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND                                                             ")
    SQL.ADD("       S1.Vehiculo = '"~Dialogo.Vehiculo1~"'        AND                                                             ")
    SQL.ADD("       S1.NrSaldo  = 171                            AND                                                             ")
    SQL.ADD("       S1.Cantidad <> 0                             AND                                                             ")
    SQL.ADD("       (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
