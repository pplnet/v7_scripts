** FJL 31/07/19 - Se saca la tabla intermedia
*SQL.ADD("SELECT * FROM ( ") 
    SQL.ADD("SELECT S1.Especie, E.Nombre, S1.Cliente, S1.NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, ")
    SQL.ADD(" E.TasaIntVigente,  SUM(S1.CantidadFin) Saldo,E.Alias5, E.InteresesC, '0' Tipo,S1.Cupon, ' ' TipoOp       ")
    SQL.ADD("FROM "~DBO~".POSICIONES S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                        ")
    SQL.ADD("WHERE S1.Cliente = C.Codigo AND                                                                           ")
    SQL.ADD("      S1.Cliente='"~Dialogo.Vehiculo1~"' AND                                                              ")
    SQL.ADD("      E.Codigo = S1.Especie AND                                                                           ")
    if Dialogo.Check1=0
    SQL.ADD("      IsNull(E.Tipo,'') <> 'TBL' AND                                                                      ")
    endif
    SQL.ADD("      E.Jerarquia LIKE '"~Var('JERTITULOS')~"%'  AND                                                      ")
    SQL.ADD("      Not E.Jerarquia LIKE '"~Var('JERFONDOS')~"%' AND                                                    ")
    SQL.ADD("      S1.Vehiculo = '"~Dialogo.Vehiculo1~"' AND                                                           ")
    SQL.ADD("      S1.NrSaldo  = 171 and                                                                               ")
    SQL.ADD("      S1.CantidadFin <> 0 AND                                                                             ")
    SQL.ADD("      (S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP1'))~") AND S1.Especie Not In ("~Pipe2Comillas(Var('ESPNOCP2'))~"))  AND ")
    SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha)                                                                    ")
    SQL.ADD("                  FROM "~DBO~".POSICIONES S2                                                              ")
    SQL.ADD("                   WHERE S2.Especie   = S1.Especie                                                        ")
    SQL.ADD("                   AND   S2.Vehiculo  = S1.Vehiculo                                                       ")
    SQL.ADD("                   AND   S2.Cliente   = S1.Cliente                                                        ")
    SQL.ADD("                   AND   S2.NrSaldo   = S1.NrSaldo                                                        ")
    SQL.ADD("                   AND   S2.Book      = S1.Book                                                           ")
    SQL.ADD("                   AND   (S2.Cupon    = S1.Cupon    OR ((S2.Cupon    IS NULL OR S2.Cupon   ='' OR S2.Cupon   =' ') AND (S1.Cupon    IS NULL OR S1.Cupon   ='' OR S1.Cupon   =' ' )) )  ")
    SQL.ADD("                   AND   (S2.Sector   = S1.Sector   OR ((S2.Sector   IS NULL OR S2.Sector  ='' OR S2.Sector  =' ') AND (S1.Sector   IS NULL OR S1.Sector  ='' OR S1.Sector  =' ' )) )  ")
    SQL.ADD("                   AND   (S2.CallPut  = S1.CallPut  OR ((S2.CallPut  IS NULL OR S2.CallPut ='' OR S2.CallPut =' ') AND (S1.CallPut  IS NULL OR S1.CallPut ='' OR S1.CallPut =' ' )) )  ")
    SQL.ADD("                   AND   (S2.FechaEj  = S1.FechaEj  OR ((S2.FechaEj  IS NULL OR S2.FechaEj ='' OR S2.FechaEj =' ') AND (S1.FechaEj  IS NULL OR S1.FechaEj ='' OR S1.FechaEj =' ' )) )  ")
    SQL.ADD("                   AND   (S2.PrecioEj = S1.PrecioEj OR ((S2.PrecioEj IS NULL OR S2.PrecioEj='' OR S2.PrecioEj=' ') AND (S1.PrecioEj IS NULL OR S1.PrecioEj='' OR S1.PrecioEj=' ' )) )  ")
    SQL.ADD("                   AND   S2.Fecha <= '"~IdxDate(Dialogo.Fecha1-1)~"' )                                    ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Cliente, S1.NrSaldo, C.RazonSocial,                                     ")
    SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, Tipo,S1.Cupon    ")

    SQL.ADD("UNION ALL ")

    Message(' Saldo Inicial Pases')
    SQL.ADD(" SELECT S1.Especie, E.Nombre, S1.Vehiculo1 Cliente, 171 NrSaldo, C.RazonSocial, E.FechaCambioTasa, E.TasaIntAnterior, ")
    SQL.ADD("        E.TasaIntVigente, CASE WHEN S1.TipoOp = 'TIPP' Then -SUM(S1.Cantidad) ELSE SUM(S1.Cantidad) END Saldo,        ")
    SQL.ADD(" E.Alias5, E.InteresesC, '0' Tipo, S1.Cupon1 Cupon, S1.TipoOp                                                         ")
    SQL.ADD(" FROM "~DBO~".OPERACIONES S1, "~DBO~".CLIENTES C, "~DBO~".ESPECIES E                                                  ")
    SQL.ADD(" WHERE S1.Vehiculo1 = C.Codigo                                                                                        ")
    SQL.ADD(" AND   S1.Especie   = E.Codigo                                                                                        ")
    if Dialogo.Check1=0
    SQL.ADD(" AND   IsNull(E.Tipo,'') <> 'TBL'                                                                                     ")
    endif
    SQL.ADD(" AND   S1.TipoOp IN ('TIPP','TIPA')                                                                                   ")
    *VTO SPOT
    SQL.ADD(" AND   S1.FechaPago <= "~idxdate2(Dialogo.Fecha1-1)~"                                                                 ")
    *VTO FUT
    SQL.ADD(" AND   S1.FechaVto2  > "~idxdate2(Dialogo.Fecha1-1)~"                                                                 ")
    SQL.ADD("GROUP BY S1.Especie, E.Nombre, S1.Vehiculo1, C.RazonSocial, S1.TipoOp,                                                ")
    SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, E.Alias5, E.InteresesC, Tipo,S1.Cupon1               ")

    * se hace union all con las tablas movpospen y movspoeje para recuperar los días siguientes
    *
    SQL.ADD("UNION ALL ")

