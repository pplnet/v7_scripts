MostrarCuadroDeMensajes
CrearDialogo
  Fecha1   : 'Fecha'   ;;;;;;;;;FSYS
  Especie1 : 'Moneda'  ;;;;;;[NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA') y EsTerminal(Dialogo.Especie1, Especie)] o Vacio(Dialogo.Especie1);'Debe Ingresar una Moneda V lida';;
  Book1    : 'Book'    ;6;1;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Operador : 'Operador';;;;;;;;;UsuarioActivo;
FinDialogo
If Not Ok
  Cancelar
EndIF

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")

SetFilaActual(2)
ACN(w99,FAC)

ACT(A:FAC,'Operaciones de Cambio Spot por Fecha de Concertacion')
ACT(A:FAC+1,'Fecha : '~Dialogo.Fecha1)
if NoVacio(Dialogo.Especie1)
  ACT(A:FAC+2,'Moneda: '~Dialogo.Especie1) 
else
  ACT(A:FAC+2,'Moneda: Todas') 
endif
if NoVacio(Dialogo.Book1)
   ACT(A:FAC+3,'Book: '~Dialogo.Book1) 
else
   ACT(A:FAC+3,'Books: Todos') 
endif
if NoVacio(Dialogo.Operador)
  ACT(A:FAC+4,'Operador: '~Dialogo.Operador) 
else
  ACT(A:FAC+4,'Operador: Todos') 
endif
ACN(FI:1, fac+5)
SetFilaActual(FAC+6)

ACT(a:FAC, 'TipoOp')
ACT(b:FAC, 'Operacion')
ACT(c:FAC, 'FechaOp')
ACT(d:FAC, 'FechaVto')
ACT(e:FAC, 'Cliente')
ACT(f:FAC, 'Moneda')
ACT(g:FAC, 'Mon.Pago')
ACT(h:FAC, 'Importe')
ACT(i:FAC, 'T.Cambio')
ACT(j:FAC, 'Monto')
ACT(k:FAC, 'Mercado')
ACT(l:FAC, 'Plazo')
ACT(M:FAC, 'Book')
ACT(N:FAC, 'Puesto')
ACT(O:FAC, 'Fecha Carga')

AlinearCeldas(a:fac..O:fac,'C')
SetFont(a:Val(w1)..O:FAC,2)
AgregarMarco(a:FAC..O:FAC, 1,0,Exe('COLOR6'))

SQL.ADD("Select NrOperacion, FechaOp, FechaVto, Cliente1, ")
SQL.ADD("       TipoOp, Cantidad, Precio1, Precio2, ")
SQL.ADD("       TotalBrutoCli1, TotalBrutoCli2, FechaCarga, Especie, ")
SQL.ADD("       ContraEspecie, MercadoRB, Plazo, Puesto, ")
SQL.ADD("       ValorRB1, FormaLiquidacion2, Alias1, Mercado, Mercado2, Book1 ")
SQL.ADD("from "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O   ")
SQL.ADD("where FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Especie1)
   SQL.ADD("and Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Operador)
   SQL.ADD("and Operador = '"~Dialogo.Operador~"' ")
endif
SQL.ADD("  and ((TipoOp = 'FXA' and (PaseCB <> '1' or PaseCB is NULL)) ")
SQL.ADD("       or (TipoOp in ('FXC','FXV') and (PaseCB <> '1' or PaseCB is NULL) ")
SQL.ADD("           and (Arbitraje <> '1'or Arbitraje is NULL)")
SQL.ADD("          )")
SQL.ADD("      )")
SQL.ADD("  and E.Codigo = O.Especie ")
SQL.ADD("order by Book1, TipoOp, FechaOp, Alias1, Especie ")
BorrarCeldas(w1..w4)
ACN(z1,0)

Recorrer SQL
  if Not EqStr(fbn('TipoOp'),Val(w3))
    if NoVacio(Val(w1))
      * Cambio Moneda
      dfa
      ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w98)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
      ACN(h:fac, Val(w5))
      AgregarMarco(a:fac..O:fac,1)
      SetFont(a:fac..O:fac, 2)
      BorrarCeldas(w5..w5)
      ifa
    endif
      
    ACT(w3, fbn('TipoOp'))
    ACT(a:fac, Val(w3)~' - '~BuscarCampo('TIPOSOPERACION','Nombre','Codigo',Val(w3)))
    AgregarMarco(a:fac..O:fac,1,0,RGB(192,192,192))
    SetFont(a:fac..O:fac, 2)
    ifa
      
    * Asignar Especie
    ACT(w4, fbn('Especie'))
    ACT(w1, fbn('Alias1')~fbn('Especie'))
    ACT(w98, fbn('Alias1'))
    ACT(a:fac, Val(w4)~' - '~Val(w98)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
    AgregarMarco(a:fac..O:fac,1)
    SetFont(a:fac..O:fac, 2)
    ifa
  else
    if Not EqStr(fbn('Alias1')~fbn('Especie'),Val(w1))
      if NoVacio(Val(w1))
        * Cambio Moneda
        dfa
        ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w98)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
        ACN(h:fac, Val(w5))
        AgregarMarco(a:fac..O:fac,1)
        SetFont(a:fac..O:fac, 2)
        BorrarCeldas(w5..w5) 
        ifa
      endif

      * Asignar Especie
      ACT(w4, fbn('Especie'))  
      ACT(w1, fbn('Alias1')~fbn('Especie'))  
      ACT(w98, fbn('Alias1'))  
      ACT(a:fac, Val(w4)~' - '~Val(w98)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
      AgregarMarco(a:fac..O:fac,1)
      SetFont(a:fac..O:fac, 2)
      ifa
    endif
  endif

  SCN(z1,1)
  ACT(z2, Fbn('NrOperacion'))

  ACT(a:FAC, Fbn('TipoOp'))
  ACT(b:FAC, Fbn('NrOperacion'))
  ACLO(b:fac, fbn('NrOperacion'))
  ACD(c:FAC, Fbn('FechaOp'))
  ACD(d:FAC, Fbn('FechaVto'))
  ACT(e:FAC, fbn('Cliente1'))
  ACT(f:FAC, fbn('Especie'))
  ACT(g:FAC, fbn('ContraEspecie'))
  ACN(h:FAC, fbn('Cantidad'))

  ACN(i:FAC, fbn('Precio1'))
  ACN(j:FAC, fbn('TotalBrutoCli1'))

  if fbn('FechaCarga')>0
    ACD(O:FAC, fbn('FechaCarga'))
  endif

  ACT(k:fac, fbn('Mercado')~'/'~fbn('Mercado2'))

  ACT(M:fac, fbn('Book1'))

  if fbn('Puesto')=0
     ACT(N:fac, 'No')
  endif
  if fbn('Puesto')=1
     ACT(N:fac, 'Si')
  endif
  if fbn('ValorRB1')=0
     ACT(l:FAC, '0 hs.')
  endif
  if fbn('ValorRB1')=1
     ACT(l:FAC, '24 hs.')
  endif
  if fbn('ValorRB1')=2
      ACT(l:FAC, '48 hs.')
  endif
  if fbn('ValorRB1')=3
      ACT(l:FAC, '72 hs.')
  endif
  if fbn('ValorRB1')=4
     ACT(l:FAC, 'Otro')
  endif
  SCN(w5,fbn('Cantidad'))
  SetFont(a:fac..O:fac+1,1)

  IFA
proximo

