
Hojavisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Lista1: 'Modelos'     ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".MODELOSASIENTO")
  Check1: 'Automatico'  ;;;;NO;NO;;;;0
  String1: 'Modelo'     ;;;;NO;NO;;;;
FinDialogo

If Not Ok
  Cancelar
Endif

*(.'ABCDARIO'.)

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')
CrearFont(4, 'Arial,8,BI')

SetFilaActual(1)
ACT(a:fac, CodigoInforme)
SetFont(a:FAC, 1)

SetFilaActual(3)
ACT(a:fac, 'Impresion Modelos de Asientos')
SetFont(a:fac,3)

SetFilaActual(5)
if Dialogo.Check1 = 1
   ACT(a:fac, 'Modelos de Asientos '~Dialogo.String1)
else
   ACT(a:fac, 'Modelos de Asientos '~Dialogo.Lista1)
Endif
SetFont(a:fac,2)

SetFilaActual(7)
ACT(a:fac,   'Modelo')
ACT(b:fac,   'Item')
ACT(c:fac,   'Cuenta')
ACT(c:fac+1, 'Contable')
ACT(d:fac,   'Calculo1')
ACT(e:fac,   'Calculo2')
ACT(f:fac,   'Calculo3')
ACT(g:fac,   'Validez')
ACT(h:fac,   'Deb/Cre')
ACT(i:fac,   'Moneda1')
ACT(j:fac,   'Moneda2')
ACT(k:fac,   'Moneda3')
ACT(l:fac,   'Alias1')
ACT(m:fac,   'Alias2')
ACT(n:fac,   'Alias3')
ACT(o:fac,   'Alias4')
ACT(p:fac,   'Alias5')
ACT(q:fac,   'Detalle')
ACT(r:fac,   'Book')
ACT(s:fac,   'Centro')
ACT(s:fac+1, 'Costo')
SetFont(a:fac..s:fac+1,2)
AgregarMarco(a:fac..s:fac+1,1,0,EXE('COLOR6'))
AlinearCeldas(a:fac..s:fac+1,'C')

ACT(w1,'1')
ACT(w2,'2')
ACT(w3,'3')
ACT(w4,'4')
ACT(w5,'5')

SetFilaActual(8)
ACN(x1,8)

SQL.ADD(" SELECT M1.*, M.Descripcion, M.Vehiculo, M.TipoAsiento FROM "~DBO~".MODELOSASIENTO1 M1, "~DBO~".MODELOSASIENTO M")
SQL.ADD(" WHERE M.Codigo = M1.Modelo ")
if Dialogo.Check1 = 1
   SQL.ADD(" AND   M.Codigo = '"~Dialogo.String1~"' ")
Else
   SQL.ADD(" AND   M.Codigo In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
SQL.ADD(" ORDER BY M1.Modelo,M1.NrItem,M1.Alias5 ")

Recorrer SQL

  if Not EqStr(Val(a:fac-1),fbn('Modelo'))
    ifa
    ACT(a:fac,fbn('Modelo')~': '~fbn('Descripcion')~' - Tipo Asiento '~ fbn('TipoAsiento')~' - Vehiculo '~ fbn('Vehiculo') )
    SetFont(a:fac,4)
    ifa
  endif
  ACT(a:fac,fbn('Modelo'))
  ACN(b:fac, fbn('NrItem'))
  If Eqstr(fbn('CC1'),'SI')
    ACT(c:fac, fbn('CuentaContable1'))
  Else
    ACT(c:fac, fbn('CuentaContable'))
  Endif
  ACT(d:fac, fbn('FormaCalculo1'))
  ACT(e:fac, fbn('FormaCalculo2'))
  ACT(f:fac, fbn('FormaCalculo3'))
  ACT(g:fac, fbn('CondicionValidez'))
  ACT(h:fac, fbn('DebitoCredito'))
  If Eqstr(fbn('MN1'),'SI')
    ACT(i:fac, fbn('Moneda11'))
  Else
    ACT(i:fac, fbn('Moneda1'))
  Endif
  If Eqstr(fbn('MN2'),'SI')
    ACT(j:fac, fbn('Moneda12'))
  Else
    ACT(j:fac, fbn('Moneda2'))
  Endif
  If Eqstr(fbn('MN3'),'SI')
    ACT(k:fac, fbn('Moneda13'))
  Else
    ACT(k:fac, fbn('Moneda3'))
  Endif
  ACT(l:fac, fbn('Alias1'))
  ACT(m:fac, fbn('Alias2'))
  ACT(n:fac, fbn('Alias3'))
  ACT(o:fac, fbn('Alias4'))
  ACT(p:fac, fbn('Alias5'))
  ACT(q:fac, fbn('Detalle'))
  If Eqstr(fbn('BK1'),'SI')
     ACT(r:fac, fbn('Book1'))
  Else
     ACT(r:fac, fbn('Book'))
  Endif
  If Eqstr(fbn('CT1'),'SI')
     ACT(s:fac, fbn('CentroCosto1'))
  Else
     ACT(s:fac, fbn('CentroCosto'))
  Endif
  SetFont(a:fac..r:fac,1)
  FormatoCeldas(b:fac, EXE('F0'))
Proximo

ACN(x2,fac)
ACN(x3,fac)

if Val(x1) < Val(x2)
   ACT(a:fac+2,'Formula')
   ACT(c:fac+2,'Script')
   AgregarMarco(a:fac+2..r:fac+2,1,0,EXE('COLOR6'))
   SetFont(a:fac+2..c:fac+2, 2)
   AlinearCeldas(a:fac+2..r:fac+2,'C')
   ACN(X5,fac+3)
   ACN(X6,fac+3)

   recorrer&i val(x1),val(x2)

     IF NOVacio(val(c:&i))
        act(Y1,val(c:&i))
        (.'MODELOASI'.)
     Endif

     IF NOVacio(val(d:&i))
        act(Y1,val(d:&i))
        (.'MODELOASI'.)
     Endif 

     IF NOVacio(val(e:&i))
        act(Y1,val(e:&i))
        (.'MODELOASI'.)
     Endif

     IF NOVacio(val(f:&i))
        act(Y1,val(f:&i))
        (.'MODELOASI'.)
     Endif

     IF NOVacio(val(g:&i))
        act(Y1,val(g:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(h:&i))
        act(Y1,val(h:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(i:&i))
        act(Y1,val(i:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(j:&i))
        act(Y1,val(j:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(k:&i))
        act(Y1,val(k:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(l:&i))
        act(Y1,val(l:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(m:&i))
        act(Y1,val(m:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(n:&i))
        act(Y1,val(n:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(o:&i))
        act(Y1,val(o:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(p:&i))
        act(Y1,val(p:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(q:&i))
        act(Y1,val(q:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(r:&i))
        act(Y1,val(r:&i))
        (.'MODELOASI'.)
     Endif
     IF NOVacio(val(s:&i))
        act(Y1,val(s:&i))
        (.'MODELOASI'.)
     Endif
   Proximo

   Repetir
     ACN(X1,val(x6))
     ACN(X2,Val(x5))
     recorrer&i val(x1),val(x2)
       IF NOVacio(val(c:&i))
          act(Y1,val(c:&i))
          (.'MODELOASI'.)
       Endif  
     Proximo
       IF val(x5)=val(x2)
         Break
       EndIf
   Proximo

   OrdenarFilas(val(X6),val(X5)-1,1,'A')

   SetFilaActual(val(X5)-1)

Else
   ACT(c:fac+2,'No se Encontro Modelo ')
   SetFont(c:fac+2, 3)
   SetFilaActual(fac+3)
Endif

ACO(1,8)
ACO(2,3)
ACO(3,8)
ACO(4,20)
ACO(5,20)
ACO(6,12)
ACO(7,15)
ACO(8,5)
ACO(9,8)
ACO(10,8)
ACO(11,8)
ACO(12,8)
ACO(13,8)
ACO(14,5)
ACO(15,8)
ACO(16,7)
ACO(17,15)
ACO(18,8)
ACO(19,8)
ACO(20,8)

LimitesVision(s:VAL(X3)+3+(val(X5)-val(X6)))

SetPrintFit(3,80)
Impresion(1,2)
Impresion(4,1)