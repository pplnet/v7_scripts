  NrOperacion1: 'NrOperacion';1;1;;;;Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.Nroperacion1),'MMPCCM|MMPCLM|MMPOSM') y [Incluido(BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion',Dialogo.Nroperacion1),UsrVehiculos(UsuarioActivo)) o Vacio(UsrVehiculos(UsuarioActivo))];IIF(Not Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',Dialogo.Nroperacion1),'MMPCCM|MMPCLM|MMPOSM'),'Debe ingresar una operacion MMPCCM, MMPCLM o MMPOSM','El vehiculo de la operacion no esta habilitado para el usuario '~UsuarioActivo);NO;;;;;;"TipoOp in ('MMPCCM','MMPCLM','MMPOSM') "
