*Informe: LOGPER
*Tipo: LOGFIL
*Log de Modificaciones a Perfiles
(.'INFLOG1'.)
ACT(f:FAC, 'Log de Modificaciones a Perfiles')
AlinearCeldas(f:fac, 'C')
SetFont(a:FAC..i:FAC+4,2)
AgregarMarco(a:FAC+4..i:FAC+4, 2, 1, Exe('COLOR'))

SetFilaActual(FAC+4)
SQL.ADD(" Select * from "~DBO~".PMAUDIT")
SQL.ADD(" where  Tabla ='PERFILES2' ")
SQL.ADD("   and Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Fecha <  '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD("   and ((Accion='A' and IsNull(ValorActual,'')<>'' and Campo<>'Script') ")
SQL.ADD("     or (Accion='B' and IsNull(ValorAnterior,'')<>'' and Campo<>'Script') ")
SQL.ADD("     or Accion='M' ")
SQL.ADD("       ) ")
SQL.ADD(" Union ")
SQL.ADD("Select * from "~DBO~".PMAUDIT2 ")
SQL.ADD(" where  Tabla ='PERFILES2' ")
SQL.ADD("   and Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("   and Fecha <  '"~IdxDate(Dialogo.Fecha2+1)~"' ")
SQL.ADD("   and ((Accion='A' and IsNull(ValorActual,'')<>'' and Campo<>'Script') ")
SQL.ADD("     or (Accion='B' and IsNull(ValorAnterior,'')<>'' and Campo<>'Script') ")
SQL.ADD("     or Accion='M' ")
SQL.ADD("       ) ")
(.'INFLOG2'.)
