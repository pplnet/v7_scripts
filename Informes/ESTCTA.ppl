HOJAVISIBLE(NO)
CrearDialogo
  Cliente1    :'Cliente'         ;;;;;;;'Ingrese un Cliente';;;
  Fecha1      :'Fecha Desde'      ;;;;;;Dialogo.Fecha1<>0 y Dialogo.Fecha1 <= Fsys;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2      :'Fecha Hasta'      ;;;;;;Dialogo.Fecha2<>0 y Dialogo.Fecha2 >= Dialogo.Fecha1 y Dialogo.Fecha2 <= Fsys;'Debe Ingresar una Fecha Hasta valida';NO;FSys
  String1     :'Path Destino'    ;1;2;;NO;;;;;VAR('PATHCONFI')
FinDialogo

If Not Ok
  Cancelar
Endif

SQL.ADD("Select Codigo ")
SQL.ADD("FROM "~DBO~".CLIENTES  ")
SQL.ADD("where (Jerarquia like '"~VAR('JERCLIENTE')~"%' or Jerarquia like '"~VAR('JERCLIEMP')~"%' or Jerarquia like '"~VAR('JERVINCULA')~"%' OR Vinculado ='SI') and Status = 'HAB' ")
SQL.ADD("  and SUBSTRING(Jerarquia,4,3) <> '000' ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("  and Codigo = '"~Dialogo.Cliente1~"' ")
endif

Recorrer SQL
    LinkearHoja('RESCTA', 1, Cliente1=fbn['Codigo'], Fecha1=Dialogo.Fecha1,Fecha2=Dialogo.Fecha1,Radio1=1, String1=Dialogo.String1)
    SCN(cl:1,1)
Proximo