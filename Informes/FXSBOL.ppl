CrearDialogo
  Fecha1       : 'FechaOp D.'  ;;;;;;Dialogo.Fecha1 <> 0 O NoVacio(Dialogo.NrOperacion1);'FechaOp Desde Invalida';NO;Fsys
  Fecha2       : 'FechaOp H.'  ;;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1 O NoVacio(Dialogo.NrOperacion1);'FechaOp Hasta Invalida';NO;Fsys
  NrOperacion1 : 'Operacion'   ;;;;;;Vacio(Dialogo.NrOperacion1) O Incluido(BuscarCampo('OPERACIONES','TipoOp','NrOperacion', Dialogo.NrOperacion1), 'FXC|FXV');'Tipo de Operacion Invalida';NO;;;;;;" TipoOp IN ('FXC','FXV') ";
  Vehiculo1    : 'Vehiculo'    ;;;;;;NoVacio(Dialogo.Vehiculo1);'Vehiculo1 Invalido';NO;Var('VEHICULODE');
FinDialogo

if Not OK
  Cancelar
endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')
CrearFont(3,'Arial,10,B')

SetFilaActual(2)

ACT(E:fac, 'Operaciones FXs Sin Boleto BCRA Asociado')
SetFont(E:fac, 3)
SetFilaActual(fac+2)
IF NoVacio(Dialogo.NrOperacion1)
    ACT(A:fac, 'Operacion: '~Dialogo.NrOperacion1)
ELSE
    ACT(A:fac, 'Desde: '~Dialogo.Fecha1)
    ifa
    ACT(A:fac, 'Hasta: '~Dialogo.Fecha2)
ENDIF
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(A:fac-2..A:fac, 1)

SetFilaActual(fac+2)
ACT(A:fac, 'Operacion')
ACT(B:fac, 'TipoOp')
ACT(C:fac, 'Cliente')
ACT(D:fac, 'FechaOp')
ACT(E:fac, 'FechaVto')
ACT(F:fac, 'Especie')
ACT(G:fac, 'C.Especie')
ACT(H:fac, 'Cantidad')
ACT(I:fac, 'Precio')
ACT(J:fac, 'Monto')
ACT(K:fac, 'Instancia')
SetFont(A:fac..K:fac, 1)
AgregarMarco(A:fac..K:fac, 0, 0, Exe('COLOR6'))

ACN(FI:1, fac+1)
SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.TipoOp, O.FechaOp, O.FechaVto, O.Cantidad, ")
SQL.ADD(" O.Precio1, O.TotalBrutoCli1, O.Especie, O.Vehiculo1, B.NrBit, O.ContraEspecie ")
SQL.ADD(" From "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".CLIENTES C ")
SQL.ADD(" Where O.NrOperacion = B.NrOperacion ")
SQL.ADD(" AND O.Cliente1 = C.Codigo ")
SQL.ADD(" AND B.NrBit IN (10, 70) ")
SQL.ADD(" AND B.Valor = '1' ")
***---Sin Boleto Asignado
SQL.ADD(" AND O.NrOperacion4 Is Null ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
***---No Financiero o del Exterior
SQL.ADD(" AND (C.Sector <> 'BAN' OR C.Sector Is Null OR C.Codigo IN ("~Pipe2Comillas(Descendientes('CLIENTES', 'BEXTER'))~")) ")
SQL.ADD(" AND O.TipoOp IN ('FXC', 'FXV') ")
IF NoVacio(Dialogo.NrOperacion1)
    SQL.ADD(" AND O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
ELSE
    SQL.ADD(" AND O.FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
ENDIF
SQL.ADD(" Order By O.NrOperacion ")
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('TipoOp'))
    ACT(C:fac, fbn('Cliente1'))
    ACD(D:fac, fbn('FechaOp'))
    ACD(E:fac, fbn('FechaVto'))
    ACT(F:fac, fbn('Especie'))
    ACT(G:fac, fbn('ContraEspecie'))
    ACN(H:fac, fbn('Cantidad'))
    ACN(I:fac, fbn('Precio1'))
    ACN(J:fac, fbn('TotalBrutoCli1'))
    ACT(K:fac, BuscarCampo('INSTANCIAS','Nombre','NrInstancia', fbn('NrBit')))
Proximo
SetFont(A:Val(FI:1)..K:fac, 2)
FormatoCeldas(H:Val(FI:1)..H:fac, Exe('F0'))
FormatoCeldas(I:Val(FI:1)..I:fac, Exe('F8'))
AgregarMarco(A:Val(FI:1)..K:fac, 0, 0)

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 1)

ACO(8, 10)
ACO(9, 10)
ACO(10, 12)
ACO(11, 15)
Impresion(1, 2)
LimitesVision(L:fac+1)
