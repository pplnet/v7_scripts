HOJAVISIBLE(SI)
ModoReproceso(ConDialogo)
CrearDialogo
*--  Label1       : ''             ;1;1;;NO;;;;;'Con F2 muestra lista para seleccion'
  Vehiculo1    : "Vehiculo"     ;1;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1     : "Banco"        ;2;;
  NrOperacion1 : "Nr.Operacion" ;3;;;;;;;;;;;
  Fecha1       : "F.Desde"      ;4;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha Desde';NO;FSys
  Fecha2       : "F.Hasta"      ;4;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar la Fecha Hasta';NO;FSys
  Radio2  : "Expresado|ARP  |USD   "  ;6;1;;;;;;;0
  Fecha3       : "F.Vigencia"   ;6;2;;;;Dialogo.Fecha3<>0;'Debe Ingresar la Fecha de Vigencia';NO;FSys
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   else
      ACT(zz6,Dialogo.Vehiculo1~"|")
   endif
else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
   EndIf
endif

ACD(zz7,(Dialogo.Fecha3 + 365))

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
CrearFont(4,"Arial,8,BI")

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,2)

SetFilaActual(3)
ACN(fi1,0)
ACT(g:FAC,'Fecha : '~Var('FECHASYS'))
SetFont(g:FAC..g:FAC,1)
ACT(a:FAC,'Apertura Deuda de Capital Corriente - No Corriente')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(a:FAC+1, 'Expresado en '~Val(mo1))
SetFont(a:fac..a:fac+1,3)
SetFilaActual(FAC+1)
ACN(w1,FAC)

if NoVacio(Dialogo.Vehiculo1)
  ACT(a:FAC+1, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
else
  ACT(a:FAC+1, 'Vehiculo : Todos')
endif

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+2, 'Banco : '~Dialogo.Cliente1~'  '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(a:FAC+2, 'Banco : Todos')
endif

ACT(a:FAC+3, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(c:FAC+3, 'Fecha Hasta: '~Dialogo.Fecha2)
ACT(g:FAC+3, 'Fecha Vigencia: '~Dialogo.Fecha3)

SetFont(a:fac..N:FAC+3,2)
SetFilaActual(FAC+5)
ACN(z11, FAC+1)

ACT(a:FAC,'Banco')
ACT(b:FAC,'Tipo Op')
ACT(c:FAC,'Plazo')
ACT(d:FAC,'Numero Op.')
ACT(e:FAC,'Fecha Op.')
ACT(f:FAC,'Fecha Vto.')
ACT(g:FAC,'Mon.')
ACT(mo1,VAR('MONELOCA'))
If Dialogo.Radio2=1
   ACT(mo1,VAR('MONEEXTR'))
EndIf
ACT(h:FAC,'Importe')

AlinearCeldas(a:FAC..c:FAC,'I')
AlinearCeldas(e:FAC..f:FAC,'I')
AlinearCeldas(d:FAC..d:FAC,'C')
AlinearCeldas(g:FAC..h:FAC,'C')
SetFont(a:fac..h:FAC,2)
AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR'))

act(cc1,'')
act(cc2,'')
act(cc3,'')
act(cc4,'')
BorrarCeldas(w11..w11)
BorrarCeldas(w21..w21)
BorrarCeldas(w31..w31)
BorrarCeldas(w41..w41)
BorrarCeldas(w91..w91)

SetFilaActual(FAC+1)
*-- Selecciono los datos a listar para el Capital corriente
*---------------------------------------------------------
SQL.ADD("Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha3 FechaVto, C.Cantidad4 Importe, O.Cantidad ")
SQL.ADD(" , O.FechaOp, C.Plazo1 Plazo, C.Fecha3 FechaTest from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.FechaOp <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Fecha3 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha3 <='"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV','MMONM') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha2 FechaVto, C.Cantidad1 Importe,O.Cantidad ")
SQL.ADD(" , O.FechaOp, C.Plazo1 Plazo, C.Fecha2 FechaTest from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.FechaOp <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2 <='"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and (O.TipoOp In ('MMPCLM','MMPEM','MMPIM','MMPOSM' ) or  (O.TipoOp In ('MMSELN') AND O.MB3 ='0' ) )   ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalNetoCli1 Importe,O.Cantidad ")
SQL.ADD(" , O.FechaOp, O.Plazo, O.FechaVto FechaTest  from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto <='"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPCL','MMPCOS','MMPE','MMFRP','MMPSI') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalBrutoCli1 Importe, O.Cantidad ")
SQL.ADD(" , O.FechaOp, O.Plazo, O.FechaVto FechaTest from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto <='"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPLME','MMON') ")


*-- Ordenado por Vehiculo,Especie,TipoOp,Cliente,NroOperacion
SQL.ADD(" order by 1,5,3,2,4 ")

Recorrer SQL
*-- Recorro  para listar Capital Corriente
if Eqstr(Val(cc1),'') y eqstr(Val(cc2),'') y eqstr(Val(cc3),'') y eqstr(Val(cc4),'')
   act(cc1, fbn('Vehiculo1'))
   act(cc2, 'Corriente')
   act(cc3, fbn('Especie'))
   act(cc4, fbn('TipoOp'))
   *-- inicializo corte por veh#culo
   act(a:fac,fbn('Vehiculo1'))
   AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
   SetFont(a:fac..h:fac,2)
   ifa
   *-- inicializo corte por Capital Corriente
   act(a:fac,'Capital Corriente')
   AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..h:fac,2)
   ifa
else
*-- Preparo corte de control
  if Not Eqstr(fbn('Vehiculo1'),Val(cc1)) y NoVacio(Val(cc1))
     act(a:fac,'Total Oper. '~Val(cc4) )
*--  act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w41))
     BorrarCeldas(w41..w41)
     AgregarMarco(a:fac..h:fac,1,0)
     SetFont(a:fac..h:fac,4)
     ifa
     act(a:fac,'Total Especie '~Val(cc3) )
     act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w31))
     BorrarCeldas(w31..w31)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Capital. '~Val(cc2)~' en '~Val(mo1))
     acn(h:fac, Val(w2))
     BorrarCeldas(w21..w21)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(cc1)~' en '~Val(mo1))
     acn(h:fac, Val(w11)) 
     SCN(w91, Val(w11))
     BorrarCeldas(w11..w11)
     AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..h:fac,2)
     ifa
     act(cc1, fbn('Vehiculo1'))
     act(cc2, 'Corriente')
     act(cc3, fbn('Especie'))
     act(cc4, fbn('TipoOp'))
     ifa
     act(a:fac,fbn('Vehiculo1'))
     AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..h:fac,2)
     ifa
  Else 
      If [Not Eqstr(fbn['Especie'],Val(cc3))] y NoVacio(Val(cc3))
         *-- Cambia el Especie(Moneda)
         act(a:fac,'Total Oper. '~Val(cc4) )
*--      act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(h:fac, Val(w41))
         BorrarCeldas(w41..w41)
         AgregarMarco(a:fac..h:fac,1,0)
         SetFont(a:fac..h:fac,4)
         ifa
         act(a:fac,'Total Especie '~Val(cc3) )
         act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(h:fac, Val(w31))
         BorrarCeldas(w31..w31)
         AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..h:fac,2)
         ifa
         * Asignar Especie
         act(cc1, fbn('Vehiculo1'))
         act(cc3, fbn('Especie'))
         act(cc4, fbn('TipoOp'))
      Else
        If [Not Eqstr(fbn['TipoOp'],Val(cc4))] y NoVacio(Val(cc4))
           *-- Cambia el Tipo de Operaci#n (Linea de credito)
           act(a:fac,'Total Oper. '~Val(cc4) )
*--        act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
           acn(h:fac, Val(w41))
           BorrarCeldas(w41..w41)
           AgregarMarco(a:fac..h:fac,1,0)
           SetFont(a:fac..h:fac,4)
           ifa
           * Asignar Especie
           act(cc1, fbn('Vehiculo1'))
           act(cc3, fbn('Especie'))
           act(cc4, fbn('TipoOp'))
        Endif
      EndIf
    EndIf
  Endif
*Endif
      *-- A: Cliente(Banco)
      *-- B: TipoOp
      *-- d: NrOperacion 
      *-- e: Fecha Op.
      *-- f: Fecha Vto.
      *-- g: Especie(Moneda)
      *-- h: Importe Original
      *-- az1: Cotizacion 
      ACT(a:fac,FBN['Cliente1'])  
      ACT(b:fac,FBN['TipoOp'])   
      ACT(c:fac,FBN['Plazo'])   
      ACT(d:fac,FBN['NrOperacion'])
      ACLO(d:fac,FBN['NrOperacion'])
      ACT(e:fac,FBN['FechaOp'])
      ACT(f:fac,FBN['FechaVto'])
      ACT(g:fac,FBN['Especie']) 
      ACN(az1,CotizacionC(fbn['Especie'],,,,Fsys,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )



If Eqstr(fbn['Especie'],Var('MONELOCA')) y Dialogo.Radio2=1
   ACT(az2,PYC(1/val(az1),0,8)~' (INV) ')
ELSE
   ACT(az2,PYC(Val(az1),0,8))
ENDIF

      ACN(h:fac,FBN['Importe'])
       
      SCN(w41,val(h:fac))
      SCN(w31,val(h:fac))
      SCN(w21,val(h:fac)*Val(az1))
      SCN(w11,val(h:fac)*Val(az1))
      SetFont(a:FAC..h:FAC,1)
SCN(fi1,1)
Proximo
*-- Veo si hay algo para listar
If Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else
*-- Listo ultimo total
     ifa
     act(a:fac,'Total Oper. '~Val(cc4) )
*--  act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w41))
     BorrarCeldas(w41..w41)
     AgregarMarco(a:fac..h:fac,1,0)
     SetFont(a:fac..h:fac,4)
     ifa
     act(a:fac,'Total Especie '~Val(cc3) )
     act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w31))
     BorrarCeldas(w31..w31)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Capital '~Val(cc2)~' en '~Val(mo1) )
     acn(h:fac, Val(w21))
     BorrarCeldas(w21..w21)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(cc1)~' en '~Val(mo1)~' de Capital Corriente' )
     acn(h:fac, Val(w11)) 
     SCN(w91, Val(w11))
     BorrarCeldas(w11..w11)
     AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..h:fac,2)
     ifa
     ifa
     act(cc1,'')
     act(cc2,'')
     act(cc3,'')
     act(cc4,'')
endif
*---
*-- Selecciono los datos a listar para el Capital No Corriente
*---------------------------------------------------------------
SQL.ADD("Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha3 FechaVto, C.Cantidad4 Importe, O.Cantidad ")
SQL.ADD(" , O.FechaOp, C.Plazo1 Plazo, C.Fecha3 FechaTest from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.FechaOp <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Fecha3 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha3 >'"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMFIMV','MMSIMV','MMONM') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, C.Fecha2 FechaVto, C.Cantidad1 Importe,O.Cantidad ")
SQL.ADD(" , O.FechaOp, C.Plazo1 Plazo, C.Fecha2 FechaTest from "~DBO~".OPERACIONES O ,"~DBO~".CUOTAS C")
SQL.ADD(" where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.FechaOp <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <='"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and C.Fecha2 >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha2 >'"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and (O.TipoOp In ('MMPCLM','MMPEM','MMPIM','MMPOSM' )  or  (O.TipoOp In ('MMSELN') AND O.MB3 ='0' ) )   ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalNetoCli1 Importe,O.Cantidad ")
SQL.ADD(" , O.FechaOp, O.Plazo, O.FechaVto FechaTest  from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >='"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto >'"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"'")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPCL','MMPCOS','MMPE','MMFRP','MMPSI') ")
SQL.ADD(" Union All " )
SQL.ADD(" Select O.Vehiculo1, O.Cliente1, O.TipoOp, O.NrOperacion, O.Especie, O.FechaOp, O.FechaVto FechaVto, O.TotalBrutoCli1 Importe, O.Cantidad ")
SQL.ADD(" , O.FechaOp, O.Plazo, O.FechaVto FechaTest from "~DBO~".OPERACIONES O ")
SQL.ADD(" where O.FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaVto >'"~IdxDate(val(zz7))~"' ")
SQL.ADD(" and O.Vehiculo1 in ("~Pipe2Comillas(val(zz6))~") ")
if NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.NrOperacion1)
   SQL.ADD(" and O.NrOperacion = '"~Dialogo.NrOperacion1~"'")
endif
SQL.ADD(" and O.TipoOp In ('MMPLME','MMON') ")
*-- Ordenado por Vehiculo,Especie,TipoOp,Cliente,NroOperacion
SQL.ADD(" order by 1,5,3,2,4 ")

Recorrer SQL
*-- Recorro  para listar Capital No corriente
if Eqstr(Val(cc1),'') y eqstr(Val(cc2),'') y eqstr(Val(cc3),'') y eqstr(Val(cc4),'')
   act(cc1, fbn('Vehiculo1'))
   act(cc2, 'No Corriente')
   act(cc3, fbn('Especie'))
   act(cc4, fbn('TipoOp'))
   *-- inicializo corte por veh#culo
   act(a:fac,fbn('Vehiculo1'))
   AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
   SetFont(a:fac..h:fac,2)
   ifa
   *-- inicializo corte por Capital No Corriente
   act(a:fac,'Capital No Corriente')
   AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
   SetFont(a:fac..h:fac,2)
   ifa
else
*-- Preparo corte de control
  if Not Eqstr(fbn('Vehiculo1'),Val(cc1)) y NoVacio(Val(cc1))
     act(a:fac,'Total Oper. '~Val(cc4) )
*--  act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w41))
     BorrarCeldas(w41..w41)
     AgregarMarco(a:fac..h:fac,1,0)
     SetFont(a:fac..h:fac,4)
     ifa
     act(a:fac,'Total Especie '~Val(cc3) )
     act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w31))
     BorrarCeldas(w31..w31)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Capital. '~Val(cc2)~' en '~Val(mo1))
     acn(h:fac, Val(w2))
     BorrarCeldas(w21..w21)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(cc1)~' en '~Val(mo1))
     acn(h:fac, Val(w11)) 
     SCN(w91, Val(w11))
     BorrarCeldas(w11..w11)
     AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..h:fac,2)
     ifa
     act(cc1, fbn('Vehiculo1'))
     act(cc2, 'No Corriente')
     act(cc3, fbn('Especie'))
     act(cc4, fbn('TipoOp'))
     ifa
     act(a:fac,fbn('Vehiculo1'))
     AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..h:fac,2)
     ifa
  Else 
      If [Not Eqstr(fbn['Especie'],Val(cc3))] y NoVacio(Val(cc3))
         *-- Cambia el Especie(Moneda)
         act(a:fac,'Total Oper. '~Val(cc4) )
*--      act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(h:fac, Val(w41))
         BorrarCeldas(w41..w41)
         AgregarMarco(a:fac..h:fac,1,0)
         SetFont(a:fac..h:fac,4)
         ifa
         act(a:fac,'Total Especie '~Val(cc3) )
         act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
         acn(h:fac, Val(w31))
         BorrarCeldas(w31..w31)
         AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
         SetFont(a:fac..h:fac,2)
         ifa
         * Asignar Especie
         act(cc1, fbn('Vehiculo1'))
         act(cc3, fbn('Especie'))
         act(cc4, fbn('TipoOp'))
      Else
        If [Not Eqstr(fbn['TipoOp'],Val(cc4))] y NoVacio(Val(cc4))
           *-- Cambia el Tipo de Operaci#n (Linea de credito)
           act(a:fac,'Total Oper. '~Val(cc4) )
*--        act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
           acn(h:fac, Val(w41))
           BorrarCeldas(w41..w41)
           AgregarMarco(a:fac..h:fac,1,0)
           SetFont(a:fac..h:fac,4)
           ifa
           * Asignar Especie
           act(cc1, fbn('Vehiculo1'))
           act(cc3, fbn('Especie'))
           act(cc4, fbn('TipoOp'))
        Endif
      EndIf
    EndIf
  Endif
*Endif
      *-- A: Cliente(Banco)
      *-- B: TipoOp
      *-- d: NrOperacion 
      *-- e: Fecha Op.
      *-- f: Fecha Vto.
      *-- g: Especie(Moneda)
      *-- h: Importe Original
      *-- az1: Cotizacion 
      ACT(a:fac,FBN['Cliente1'])  
      ACT(b:fac,FBN['TipoOp'])   
      ACT(c:fac,FBN['Plazo'])   
      ACT(d:fac,FBN['NrOperacion'])
      ACLO(d:fac,FBN['NrOperacion'])
      ACT(e:fac,FBN['FechaOp'])
      ACT(f:fac,FBN['FechaVto'])
      ACT(g:fac,FBN['Especie']) 
      ACN(az1,CotizacionC(fbn['Especie'],,,,Fsys,1,SI,IIF(Dialogo.Radio2=0,VAR('MONELOCA'),VAR('MONEEXTR'))) )
      ACN(h:fac,FBN['Importe'])
       
      SCN(w41,val(h:fac))
      SCN(w31,val(h:fac))
      SCN(w21,val(h:fac)*Val(az1))
      SCN(w11,val(h:fac)*Val(az1))
      SetFont(a:FAC..h:FAC,1)
SCN(fi1,1)
Proximo
*-- Veo si hay algo para listar
If Val(fi1)=0
   ** No entro en el select (resultado vacio)
   HojaVisible(no)
   Messagebox('No se encontraron operaciones.')
else
*-- Listo ultimo total
     ifa
     act(a:fac,'Total Oper. '~Val(cc4) )
*--  act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w41))
     BorrarCeldas(w41..w41)
     AgregarMarco(a:fac..h:fac,1,0)
     SetFont(a:fac..h:fac,4)
     ifa
     act(a:fac,'Total Especie '~Val(cc3) )
     act(d:fac,'Cotizacion en '~Val(mo1)~' : '~Val(az2))
     acn(h:fac, Val(w31))
     BorrarCeldas(w31..w31)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Capital '~Val(cc2)~' en '~Val(mo1) )
     acn(h:fac, Val(w21))
     BorrarCeldas(w21..w21)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,2)
     ifa
     act(a:fac,'Total Cia. '~Val(cc1)~' en '~Val(mo1)~' de Capital No Corriente' )
     acn(h:fac, Val(w11))
     SCN(w91, Val(w11))
     BorrarCeldas(w11..w11)
     AgregarMarco(a:FAC..h:FAC,2,0,Exe('COLOR6'))
     SetFont(a:fac..h:fac,2)
     ifa
     ifa
     act(a:fac,'Total General en '~Val(mo1))
     acn(h:fac, Val(w91))
     BorrarCeldas(w91..w91)
     AgregarMarco(a:fac..h:fac,1,0,RGB(192,192,192))
     SetFont(a:fac..h:fac,3)
FormatoCeldas(h:val(z11)..h:fac,Exe('F2'))

ACO(1,14)
ACO(2,6)
ACO(3,4)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,3)
ACO(8,11)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(h:FAC)

*
*    Esto permite repetir los encabezados
*
RangoTitulo(a:1..h:FAC, 9)

Endif
