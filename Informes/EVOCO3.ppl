CrearDialogo
  Fecha1         :  'Fecha Desde'                     ;1;1;;;;Dialogo.Fecha1>0;'Debe agregar una fecha de inicio';NO;FSYS;
  Fecha2         :  'Fecha Hasta'                     ;2;1;;;;Dialogo.Fecha2>Dialogo.Fecha1;'La fecha de fin no puede ser menor a la fecha de inicio';NO;FSYS+1;
  String1        :  'Tipo Especie'                    ;1;2;;Dialogo.CHECK1=0;;IF(Dialogo.Check1=0,NoVacio(Dialogo.String1));'Debe seleccionar un tipo de especie';NO;;IIF(Dialogo.Check1=1,Null,);SQLSet("Select Distinct Tipo from "~DBO~".ESPECIES Where Tipo IN ('PUB','PRI','ONE','FON','MON','OTR','IND')")
  Check1         :  'Todos'                           ;2;2;;;;;;;SI;;;;;;;;;;;;;;
  Lista1         :  'Especies'                        ;3;2;;;;;;;;;IF(Dialogo.CHECK1=1,SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Status='HAB'"),SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Status='HAB'and Tipo='"~Dialogo.String1~"'"))
FinDialogo

If Not OK
    Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,12,B")
CrearFont(3,"Arial,8,B")
********************************************************VERIFICACION DE SELECCION DE ESPECIES***************************************************
IF NoVacio(Dialogo.Lista1)
    let &ListaEspecies SQLSet("Select Distinct Codigo From "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Dialogo.Lista1)~") Order By Codigo") 
Else
    IF Dialogo.Check1=1
    let &ListaEspecies SQLSet("Select Distinct Codigo From "~DBO~".ESPECIES Where Status = 'HAB' Order By Codigo")
    Else
    let &ListaEspecies SQLSet("Select Distinct Codigo From "~DBO~".ESPECIES Where Tipo = '"~Dialogo.String1~"' and Status = 'HAB' Order By Codigo")
    Endif
Endif

******************************************************************TITULOS***************************************************************

ACT(F:1,'EVOLUCION COTIZACIONES DE CIERRE POR FECHA')
SetFont(F:1..F:1,2)
ifa
ifa
ifa
ifa
ACT(A:fac,'Desde: '~Dialogo.Fecha1~ ' Hasta : ' ~Dialogo.Fecha2)
SetFont(A:fac..A:fac,3)
ifa
ifa
ifa 
**************************************************************VARIABLES********************************************************************
let &CantidadEspecies Elementos(&ListaEspecies)
let &FilaEspecies fac
let &Especie ' ' 
let &FilaComienzoFechas fac+1
let &ColComienzoEspecies 2
let &ColEspecieEnCurso &ColComienzoEspecies-1
let &FilaFechaEnCurso &FilaComienzoFechas
let &LengthEspecies Longitud(&ListaEspecies)
let &DifDias DifDias(Dialogo.Fecha1,Dialogo.Fecha2,'ARG',NO)
********************************************************************CARGA FECHAS**********************************************************
Recorrer&i 0,&DifDias
   ACD(A:&FilaFechaEnCurso,Dialogo.Fecha1+&i)
   let &FilaFechaEnCurso &FilaFechaEnCurso+1
Proximo

****************************************************************SQL**********************************************************************

SQL.ADD("Select Codigo,Fecha,Precio1 From "~DBO~".COTIZACIONES ")
SQL.ADD("Where (Fecha Between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"') and Codigo IN ("~Pipe2Comillas(&ListaEspecies)~")")
SQL.ADD(" ORDER BY Codigo,Fecha ")
*******************************************************CARGA ESPECIES Y PRECIOS**********************************************************
let &ColumnaPrecio &ColComienzoEspecies
let &FilaPrecio &FilaEspecies
let &Flag 0
Recorrer SQL
    If Not EqStr(FBN['Codigo'],&Especie)
        Recorrer&i 1,&DifDias
            If Vacio(Val(A:&FilaPrecio))
                break
            Else
                ACN(&ColEspecieEnCurso:&FilaPrecio,Val(&ColEspecieEnCurso:&FilaPrecio-1))
                let &FilaPrecio &FilaPrecio+1
            Endif
        Proximo
        let &Especie FBN['Codigo']
        let &FilaPrecio &FilaEspecies
        let &ColEspecieEnCurso &ColEspecieEnCurso+1
        ACT(&ColEspecieEnCurso:&FilaEspecies,FBN['Codigo'])
        let &Flag 1
        let &FilaPrecio &FilaPrecio+1
    Endif
    Recorrer&i 1,&DifDias
        If Vacio(Val(A:&FilaPrecio))
            break
        Else
            If FBN['Fecha']=Val(A:&FilaPrecio)
                ACN(&ColEspecieEnCurso:&FilaPrecio,FBN['Precio1'])
                let &FilaPrecio &FilaPrecio+1
                
                break
            Else
                If Val(A:&FilaPrecio)=Dialogo.Fecha1
                    ACN(&ColEspecieEnCurso:&FilaPrecio,Cotizacion(FBN['Codigo'],,,,Dialogo.Fecha1,1))
                    let &FilaPrecio &FilaPrecio+1 
                    
                Else
                    ACN(&ColEspecieEnCurso:&FilaPrecio,Val(&ColEspecieEnCurso:&FilaPrecio-1))
                    let &FilaPrecio &FilaPrecio+1 
                    
                Endif
            Endif
        Endif
     Proximo
Proximo
Recorrer&i 1,&DifDias
    If Vacio(Val(A:&FilaPrecio))
        break
    Else
        ACN(&ColEspecieEnCurso:&FilaPrecio,Val(&ColEspecieEnCurso:&FilaPrecio-1))
        let &FilaPrecio &FilaPrecio+1
    Endif
Proximo

If &Flag=0
    Cancelar('No existen cotizaciones cargadas para las especies y rango de fechas seleccionados')
Endif

*******************************************************FORMATOS**********************************************************
FormatoCeldas(&ColComienzoEspecies:&FilaComienzoFechas..&ColEspecieEnCurso:&FilaPrecio,Exe('F8'))
SetFilaActual(&FilaPrecio)
ifa
ACT(A:fac,'Fin del Reporte')
SetFont(A:fac..A:fac,3)
SetFont(&ColComienzoEspecies:&FilaEspecies..&ColEspecieEnCurso:&FilaEspecies,3)
SetFont(A:&FilaComienzoFechas..A:&FilaPrecio,3)
AgregarMarco(&ColComienzoEspecies-1:&FilaEspecies..&ColEspecieEnCurso:&FilaEspecies,2,1,Exe('COLOR6'))
AgregarMarco(A:&FilaComienzoFechas..A:&FilaPrecio-1,2,2,Exe('COLOR6'))

let &ColumnaLimite &ColEspecieEnCurso

IF &ColEspecieEnCurso-1<11
    let &ColumnaLimite 11
Endif


LimitesVision(&ColumnaLimite:fac)   
