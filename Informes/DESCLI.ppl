ModoReproceso(ConDialogo)
CrearDialogo
   Cliente1: 'Jerarquia' ;;;;;;NoVacio(Dialogo.Cliente1);'Ingrese una Jerarquia';;;
FinDialogo

if Not Ok
 Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

ACT(aa1, Copy(BuscarCampo('CLIENTES','Jerarquia','Codigo',Dialogo.Cliente1),1,3))

SQL.ADD(" SELECT Jerarquia, Codigo,RazonSocial")
SQL.ADD(" FROM "~DBO~".CLIENTES ")
SQL.ADD(" WHERE SUBSTRING(Jerarquia,1,3) like '"~Val(aa1)~"%' ")
SQL.ADD(" ORDER BY 1 ")
SetfilaActual(1)
ACN(aa2,0)
ACN(su1,0)
ACN(z1,0)
Recorrer SQL

   ACN(je1,Num(Copy(FBN['Jerarquia'],1,3)))
   ACN(je2,Num(Copy(FBN['Jerarquia'],4,3)))
   ACN(je3,Num(Copy(FBN['Jerarquia'],7,3)))
   ACN(je4,Num(Copy(FBN['Jerarquia'],10,3)))
   ACN(je5,Num(Copy(FBN['Jerarquia'],13,3)))

   if Val(je1)<>0
      ACN(co1,1)
   endif
   if Val(je2)<>0
      ACN(co1,2)
   endif
   if Val(je3)<>0
      ACN(co1,3)
   endif
   if Val(je4)<>0
      ACN(co1,3)
   endif
   if Val(je5)<>0
      ACN(co1,5)
   endif

*   ACT(Val(co1):fac, FBN['Codigo']~' - '~FBN['RazonSocial'])
   ACT(Val(co1):fac, FBN['Codigo'])
   ACT(Val(co1)+1:fac, copy(FBN['RazonSocial'],1,25))
   SCN(su1,1)
Proximo

ifa
