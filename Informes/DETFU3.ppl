MostrarCuadroDeMensajes
CrearDialogo
  Radio2   : 'Fechas|Vigentes|FechaOp|F.Valuacion';;;;;;;;;0 
  Fecha1   : 'D.Fecha'  ;2;1;1;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;FSYS
  Fecha2   : 'H.Fecha'  ;3;1;1;Dialogo.Radio2=1;Dialogo.Radio2=1;;;;FSYS
  Fecha3   : 'Fecha'    ;2;1;1;Dialogo.Radio2<>1;Dialogo.Radio2<>1;;;;FSYS
  Mercado1 : 'Mercado'  ;3;1;;;;;;;  
  Especie1 : 'Moneda'   ;4;1;1;;;[NoVacio(Dialogo.Especie1) y DesciendeDeEspecie(Dialogo.Especie1,'MONEDA') y EsTerminal(Dialogo.Especie1, Especie)] o Vacio(Dialogo.Especie1);'Debe Ingresar una Moneda Valida';
  Radio1   : 'Tipo|Todas|Delivery|Non Delivery';5;1;1;Dialogo.Radio2<>2;;;;;0;iIF(DIALOGO.RADIO2=2,2)
  Book1    : 'Book'     ;6;1;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Operador : 'Operador' ;;;;;;;;;;;
FinDialogo
If Not Ok
   Cancelar
EndIF

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
AgregarBMP(a1,Exe('LOGO'),80)

SetFilaActual(4)
ACN(w1,FAC)

ACT(F:FAC,'Operaciones de Cambio Futuro')
If Dialogo.radio1=1
   ACT(F:fac, Val(F:fac)~' - Delivery')
Endif
If Dialogo.radio1=2
   ACT(F:fac, Val(F:fac)~' - Non Delivery')
Endif
If Dialogo.Radio2=0
   ACT(A:FAC+1,'Vigentes al '~Dialogo.Fecha3)
Endif
If Dialogo.Radio2=1
   ACT(A:FAC+1,'Concertadas del '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)
Endif
If Dialogo.Radio2=2
   ACT(A:FAC+1,'Fecha Valuacion = '~Dialogo.Fecha3)
Endif

if NoVacio(Dialogo.Especie1)
   ACT(A:FAC+2,'Moneda: '~Dialogo.Especie1) 
else
   ACT(A:FAC+2,'Moneda: Todas') 
endif
if NoVacio(Dialogo.Mercado1)
   ACT(D:FAC+2,'Mercado: '~Dialogo.Mercado1) 
else
   ACT(D:FAC+2,'Mercados: Todos') 
endif
if NoVacio(Dialogo.Operador)
   ACT(A:FAC+3,'Operador: '~Dialogo.Operador) 
else
   ACT(A:FAC+3,'Operador: Todos') 
endif
if NoVacio(Dialogo.Book1)
   ACT(A:FAC+4,'Book: '~Dialogo.Book1) 
else
   ACT(A:FAC+4,'Books: Todos') 
endif
ACN(FI:1, fac+5)
SetFilaActual(FAC+6)
ACT(a:FAC, 'TipoOp')
ACT(b:FAC, 'Mercado')
ACT(c:FAC, 'Operacion')
ACT(d:FAC, 'FechaOp')
ACT(e:FAC, 'FechaVto')
ACT(f:FAC, 'Cliente')
ACT(g:FAC, 'Moneda')
ACT(h:FAC, 'Mon.Pago')
ACT(i:FAC, 'Importe')
ACT(j:FAC, 'T.Cambio')
ACT(k:FAC, 'Monto')
ACT(l:FAC, 'Plazo')
ACT(m:FAC, 'Tipo')
ACT(n:FAC, 'Book')
ACT(o:FAC, 'F.Valuacion')
ACT(p:FAC, 'Valuacion')
ACT(q:FAC, 'Resultado')
SetFont(a:Val(w1)..q:FAC,2)
AlinearCeldas(a:fac..q:FAC,'C')
AgregarMarco(a:FAC..q:FAC, 1,0,Exe('COLOR6'))

SQL.ADD(" Select NrOperacion, FechaOp, FechaVto, Cliente1, TipoOp, Cantidad,     ")
SQL.ADD("        Precio1, Precio2, TotalBrutoCli1, TotalBrutoCli2, FechaCarga, Especie, ")
SQL.ADD("        ContraEspecie, MercadoRB, Plazo, Puesto, ValorRB1, FormaLiquidacion2,  ")
** FJL 20/12/18 - El Resultado esta en TotalAux3 (MTM) y TotalAux2 (FIX)
*SQL.ADD(" RB10, Alias1, O.Book1, O.FechaVto2, O.TipoCambio3, O.TotalNetoCli1, Mercado4  ")
SQL.ADD("        RB10, Alias1, O.Book1, O.FechaVto2, O.TipoCambio3, O.TotalNetoCli1, Mercado4,  ")
SQL.ADD("        TotalAux2, TotalAux3, CB6 ")
SQL.ADD(" FROM "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O   ")
SQL.ADD(" where E.Codigo = O.Especie ")
If Dialogo.Radio2=0
* FJL 22/11/18 - La que vencen en el dia no se muestran - Issue 3461
*   SQL.ADD(" and FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"'    ")
   SQL.ADD(" and FechaVto > '"~IdxDate(Dialogo.Fecha3)~"'    ")
   SQL.ADD(" and FechaOp <= '"~IdxDate(Dialogo.Fecha3)~"'    ")
Endif
If Dialogo.Radio2=1
   SQL.ADD(" and FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"'    ")
   SQL.ADD(" and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'    ")
Endif
If Dialogo.Radio2=2
   SQL.ADD(" and FechaVto2 = '"~IdxDate(Dialogo.Fecha3)~"'    ")
Endif
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" and Mercado4 = '"~Dialogo.Mercado1~"' ")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and Especie = '"~Dialogo.Especie1~"' ")
Endif
If NoVacio(Dialogo.Operador)
   SQL.ADD(" and Operador = '"~Dialogo.Operador~"' ")
Endif
SQL.ADD(" and ((TipoOp = 'FXAT' and (PaseCB <> '1'or PaseCB is NULL) ) ")
SQL.ADD("      or (TipoOp in ('FXCT','FXVT','FXCF','FXVF') and (PaseCB <> '1'or PaseCB is NULL)")
SQL.ADD("          and (Arbitraje <> '1'or Arbitraje is NULL)")
SQL.ADD("         ) ")
SQL.ADD("     )     ")
IF NoVacio(Dialogo.Book1)
    SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"' ")
ENDIF
If Dialogo.Radio1=1
   SQL.ADD(" AND (O.RB10 IS NULL OR O.RB10 = '0' ) ")
Endif
If Dialogo.Radio1=2
   SQL.ADD(" AND O.RB10 = '1' ")
Endif
SQL.ADD(" order by Book1, TipoOp, FechaOp, Alias1 ")
watch(sql.Batch())
BorrarCeldas(w1..w4)
ACN(z1,0)

Recorrer SQL
  if Not EqStr(fbn('TipoOp'),Val(w3))
    if NoVacio(Val(w4))
       * Cambio Moneda
       dfa
       ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
       ACN(i:fac, Val(w5))
       AgregarMarco(a:fac..q:fac,1)
       SetFont(a:fac..q:fac, 2)
       BorrarCeldas(w5..w5) 
       ifa
       ifa
       ifa
    endif
    ACT(w3, fbn('TipoOp'))  
    ACT(a:fac, Val(w3)~' - '~BuscarCampo('TIPOSOPERACION','Nombre','Codigo',Val(w3)))
    AgregarMarco(a:fac..q:fac,1,0,RGB(192,192,192))
    SetFont(a:fac..q:fac, 2)
    ifa
    * Asignar Especie
    ACT(w4, fbn('Especie'))  
    ACT(w1, fbn('Alias1'))  
    ACT(a:fac, Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
    AgregarMarco(a:fac..q:fac,1)
    SetFont(a:fac..q:fac, 2)
    ifa
  else
    if Not EqStr(fbn('Especie'),Val(w4))
      if NoVacio(Val(w4))
         * Cambio Moneda
         dfa
         ACT(a:fac, 'Total por '~Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
         ACN(i:fac, Val(w5))
         AgregarMarco(a:fac..q:fac,1)
         SetFont(a:fac..q:fac, 2)
         BorrarCeldas(w5..w5) 
         ifa
      endif
      * Asignar Especie
      ACT(w4, fbn('Especie'))  
      ACT(w1, fbn('Alias1'))  
      ACT(a:fac, Val(w4)~' - '~Val(w1)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',Val(w4)))
      AgregarMarco(a:fac..q:fac,1)
      SetFont(a:fac..q:fac, 2)
      ifa
    endif
  endif

  SCN(z1,1)
  ACT(z2, Fbn('NrOperacion'))

  ACT(a:FAC, Fbn('TipoOp'))
  ACT(b:FAC, Fbn('Mercado4'))
  ACT(c:FAC, Fbn('NrOperacion'))
  ACLO(c:fac, fbn('NrOperacion'))
  ACD(d:FAC, Fbn('FechaOp'))
  ACD(e:FAC, Fbn('FechaVto'))
  ACT(f:FAC, fbn('Cliente1'))
  ACT(g:FAC, fbn('Especie'))
  ACT(h:FAC, fbn('ContraEspecie'))
  ACN(i:FAC, fbn('Cantidad'))

  ACN(j:FAC, fbn('Precio1'))
  ACN(k:FAC, fbn('TotalBrutoCli1'))
  if Eqstr(Fecha(fbn('FechaCarga'),'dd/mm/yyyy'),'00/00/0000')
     ACT(p:FAC, ' ')
  else
     ACT(p:FAC, Fecha(fbn('FechaCarga'),'dd/mm/yyyy'))
  endif

  ACN(l:fac, fbn('Plazo'))

  if fbn('RB10')=0
     ACT(m:fac, 'Delivery')
  endif
  if fbn('RB10')=1
     ACT(m:fac, 'Non Delivery')
  endif

  ACT(n:FAC, fbn('Book1'))

  ACD(o:FAC, fbn('FechaVto2'))
  ACN(p:FAC, fbn('TipoCambio3'))
** FJL 20/12/18 - El Resultado esta en TotalAux3 (MTM) y TotalAux2 (FIX)
*  ACN(q:FAC, fbn('TotalNetoCli1'))
  if EqStr(BuscarCampo('MERCADOS','Regulado','Codigo',fbn('Mercado4')),'SI')
    ACN(q:fac, fbn('TotalAux3')+fbn('TotalAux2'))
  else
    if fbn('CB6')=1
      ACN(q:fac, fbn('TotalAux2'))
    else
      ACN(q:fac, fbn('TotalAux3'))
    endif
  endif

  SCN(w5,fbn('Cantidad'))
  SetFont(a:fac..q:fac+1,1)
  IFA
Proximo

