CrearDialogo
  Fecha1 : 'D.Concert.'    ;1;1;;;;;;;Fsys-365
  Fecha2 : 'H.Concert.'    ;1;2;;;;;;;Fsys
  Fecha3 : 'D.Vencim.'     ;2;1;;;;;;;Fsys+1
  Fecha4 : 'H.Vencim.'     ;2;2;;;;;;;Fsys+365  
  Cliente1:'Cliente'     ;3;1;
  Especie1:'Especie'     ;3;2;;No;;;;;'ARP'
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Inventario de cheques')
ACT(a2, 'D.Concert.: '~Dialogo.Fecha1)
ACT(c2, 'H.Concert.: '~Dialogo.Fecha2)
ACT(a3, 'D.Vencim.: '~Dialogo.Fecha3)
ACT(c3, 'H.Vencim.: '~Dialogo.Fecha4)
if NoVacio(Dialogo.Cliente1)
  ACT(a4, 'Cliente: '~Dialogo.Cliente1)
else
  ACT(a4, 'Cliente: Todos')
endif
ACT(c4, 'Especie:'~Dialogo.Especie1)
*if Dialogo.Radio1>2
*  let &Filtro 'Concertacion '
*else
*  let &Filtro 'Liquidacion '
*endif
*if Dialogo.Radio1=1 or Dialogo.Radio1=3
*  let &Filtro &Filtro~'Compras'
*else
*  let &Filtro &Filtro~'Ventas'
*endif
*ACT(a4, &Filtro)


ACT(a6, 'NrOperacion')
ACT(b6, 'TipoOp')
ACT(c6, 'Cliente / Nro.BT')
ACT(d6, 'Fecha Op.')
ACT(e6, 'Fecha Liq.')
ACT(f6, 'Pl.Liq')
ACT(g6, 'F.Vto')
ACT(h6, 'Pl.Vto')
ACT(i6, 'Monto')
ACT(j6, 'Interes')
ACT(k6, 'Capital')
ACT(l6, 'Derechos')
ACT(m6, 'Aranceles')
ACT(n6, 'Gastos')
ACT(o6, 'IVA')
ACT(p6, 'Nr.Boleto')
*
**let &TipoOp 'DDC|DDV'
*if Dialogo.Radio1=1 o Dialogo.Radio1=3
*let &TipoOp 'DDC'
*endif
*if Dialogo.Radio1=2 o Dialogo.Radio1=4
*let &TipoOp 'DDV'
*endif
*
*
SQL.ADD("SELECT O.*, C.AliasBt FROM   "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C")
SQL.ADD(" where FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp <= '"~IdxDate(Dialogo.Fecha2)~"'")
SQL.ADD(" and FechaVto >= '"~IdxDate(Dialogo.Fecha3)~"' and FechaVto <= '"~IdxDate(Dialogo.Fecha4)~"'")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
SQL.ADD(" and Cliente1 = C.Codigo")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("       and Cliente1 = '"~Dialogo.Cliente1~"'")
endif

SetFilaActual(6)
recorrer SQL
  ACT(a:fac, fbn('NrOperacion'))
  ACLO(a:fac, Val(a:fac))
  ACT(b:fac, fbn('TipoOp'))
  ACT(c:fac, fbn('Cliente1')~' / '~fbn('AliasBt'))
  ACD(d:fac, fbn('FechaOp'))
  ACD(e:fac, fbn('FechaOp2'))
  ACT(f:fac, fbn('Plazo2'))
  ACD(g:fac, fbn('FechaVto'))
  ACT(h:fac, fbn('Plazo'))
  ACN(i:fac, fbn('TotalBrutoCli1'))
  ACN(j:fac, fbn('TotalIntereses'))
  ACN(k:fac, fbn('Cantidad'))
  let &TotalCapital &TotalCapital+fbn('Cantidad')
  ACN(l:fac, fbn('TotalDerechos'))
  ACN(m:fac, fbn('ImpGastos1'))
  let &TotalComisiones &TotalComisiones+fbn('ImpGastos1')
  ACN(n:fac, fbn('TotalGastos'))
  ACN(o:fac, fbn('TotalIVA')+fbn('ImpGastos2')+fbn('TotalAux1'))
  ACT(p:fac, fbn('NrBoleto'))
proximo
ACT(a:fac+1, 'Totales')
ACN(k:fac+1, &TotalCapital)
ACN(m:fac+1, &TotalComisiones)


let &AnchoColFina 6
let &AnchoColumna 8
ACO(2,&AnchoColFina)
ACO(3,12)
ACO(4,&AnchoColumna)
ACO(5,&AnchoColumna)
ACO(6,&AnchoColFina)
ACO(7,&AnchoColumna)
ACO(8,&AnchoColFina)
ACO(9,&AnchoColumna)
ACO(10,&AnchoColumna)
ACO(11,&AnchoColumna)
ACO(12,&AnchoColumna)
ACO(13,&AnchoColumna)
ACO(14,&AnchoColumna)
ACO(15,&AnchoColumna)

CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,14,B")
CrearFont(4, "Arial,6,")
CrearFont(5, "Arial,10,BU")
CrearFont(6, "Arial,10,B")
CrearFont(7, "Arial,10,")

setfont(a1..z:fac, 1)
