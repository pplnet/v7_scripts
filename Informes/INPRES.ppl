*-Prestamos Financieros de Capital e Int.
*-Llama al reporteador FINPRE
HOJAVISIBLE(NO)
ModoReproceso(SinDialogo)
CrearDialogo
*--  Label1      : ''                        ;1;1;;NO;;;;;'Con F2 muestra lista para seleccion'
  Fecha1       : "F.Vigencia"                 ;1;1;;;;Dialogo.Fecha1 <> 0 Y Dialogo.Fecha1 <= Fsys;'Fecha Vigencia Invalida';NO;Fsys;
  Especie1     : "Especie"                    ;2;1;;;;;;;;;
  Cliente1     : "Entidad"                    ;1;2;;;;;;;;;
  NrOperacion1 : "Operacion"                  ;;;;;;;;;;;;;" TipoOp In ('MMFIMV','MMPCLM','MMPEM', 'MMPOSM','MMFRNP','MMPCL','MMPE','MMPCOS','MMPLME','MMSELN' )"
  Radio2       : "Expresado|ARP  |USD      "  ;3;1;;;;;;;0
  Vehiculo1    : "Grupo"                      ;;;;Vacio(Dialogo.Lista1);;;;;;;;;;"TipoVehiculo <> 'DIV'";
  Lista1       : "Vehiculo"                   ;5;1;;Vacio(Dialogo.Vehiculo1);;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "))
  Lista2       : "TipoOp"                     ;-1;2;;;;NoVacio(Dialogo.Lista2);'Seleccione al menos un tipo de Operacion';NO;'MMFIMV|MMPCLM|MMSELN|MMPEM|MMPOSM|MMFRNP|MMPCL|MMPE|MMPCOS|MMPLME|';;SQLSet(" Select Codigo From "~DBO~".TIPOSOPERACION Where Codigo In ('MMPIM','MMPI','MMFIMV','MMPCLM','MMPEM', 'MMPOSM','MMFRNP','MMPCL','MMPE','MMPCOS','MMPLME','MMPCCM') ")
  Radio3       : "Consolidado|SI|NO"          ;;1;;;;;;;1;
FinDialogo

if Not Ok
  Cancelar
endif

if NoVacio(Dialogo.Lista2)
   ACT(op1,Dialogo.Lista2)
else
   ACT(op1,"MMFIMV|MMPCLM|MMPEM|MMPOSM|MMFRNP|MMPCL|MMPE|MMPCOS|MMPLME|MMPIM|MMPI|MMSELN|")
endif




LinkearHoja("FINPRE",1,Fecha1=Dialogo.Fecha1,Especie1=Dialogo.Especie1,Cliente1=Dialogo.Cliente1,NrOperacion1=Dialogo.NrOperacion1,Lista1=Dialogo.Lista1,Lista2=Val(op1),Radio1=1,Radio2=Dialogo.Radio2, Vehiculo1=Dialogo.Vehiculo1,Radio3=Dialogo.Radio3)

