* PRUMAR - PRUEBA - Operaciones Bancarias
ModoReproceso(CONDialogo)

************* DEFINICION DE CAMPOS DE PANTALLA ***************

CrearDialogo
  Cliente1     : "Cliente"    ;1;1;;;;Vacio(Dialogo.Cliente1) o DESCIENDEDECLIENTE(Dialogo.CLIENTE1,'BANCOS');'Debe ingresar una entidad bancaria';NO;
  Vehiculo1    : "Vehiculo"   ;2;1;;;;EsTerminal(Dialogo.Vehiculo1, Vehiculos) o Vacio (Dialogo.Vehiculo1);'Debe ingresar un Vehiculo';NO;
  Especie1     : "Especie"    ;3;1;;;;;;;
  Operador     : 'Operador'   ;1;2;;;;;;;
  Fecha1       : "F.Op.Desde" ;2;2;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha';NO;FSys-30;
  Fecha2       : "F.Op.Hasta" ;3;2;;;;Dialogo.Fecha2<>0;'Debe Ingresar una Fecha';NO;FSys;
FinDialogo

************* DEFINICION DE CAMPOS DE PANTALLA FIN ***************


*************

IF Not Ok
  Cancelar
ENDIF

*************


************* DEFINICION DE FUENTE ***************

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

************* DEFINICION DE FUENTE FIN ***************


************* CABECERA DEL LISTADO ***************

SetFilaActual(1)
ACT(a:1,'Operaciones Bancarias')
ACT(e:1,'Fecha: '~Var('FECHASYS'))
SetFont(a:1..g:1,3)

IFA
IFA

IF NoVacio (Dialogo.Cliente1)
   ACT(a:FAC, 'Grupo : '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
ELSE
   ACT(a:FAC, 'Grupo : Todos')
ENDIF

ACT(c:FAC, 'Ope.Desde: '~Dialogo.Fecha1)
ACT(d:FAC, 'Ope.Hasta: '~Dialogo.Fecha2)

IFA

IF NoVacio (Dialogo.Vehiculo1)
   ACT(a:FAC, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
ELSE
   ACT(a:FAC, 'Vehiculo : Todos')
ENDIF

IFA

IF NoVacio(Dialogo.Especie1)
  ACT(a:FAC, 'Especie : '~Dialogo.Especie1)
ELSE
  ACT(a:FAC, 'Especies : Todas')
ENDIF

IFA

IF NoVacio(Dialogo.Operador)
  ACT(a:FAC, 'Operador : '~Dialogo.Operador)
ELSE
  ACT(a:FAC, 'Operador : Todos')
ENDIF

SetFont(a:3..d:FAC,2)

IFA
IFA

ACT(A:FAC, "Cliente")
ACT(B:FAC, "Vehiculo")
ACT(C:FAC, "Especie")
ACT(D:FAC, "FechaOp")
ACT(E:FAC, "Contra Esp.")
ACT(F:FAC, "Tipo Op.")
ACT(G:FAC, "Cantidad")
ACT(H:FAC, "Precio/Tasa")
ACT(I:FAC, "Plazo")
ACT(J:FAC, "Total")
ACT(K:FAC, "Nro.Ope.")
AlinearCeldas(A:FAC..F:FAC,'I')
AlinearCeldas(G:FAC..J:FAC,'D')
AlinearCeldas(K:FAC,'I')
SetFont(A:FAC..K:FAC, 2)
AgregarMarco(A:FAC..K:FAC,2,0,Exe('COLOR'))

************* CABECERA DEL LISTADO FIN ***************


************* ARMADO DE CONDICION DE DATOS DEL WHERE DEPENDIENDO LA ENTRADA ***************

IF NoVacio(Dialogo.Cliente1)
  ACT(z:1, "O.Cliente1 = '"~Dialogo.Cliente1~"' and ")
ELSE
  ACT(z:1, "O.Cliente1 in ("~Pipe2Comillas(Descendientes('CLIENTES','BANCOS'))~")  and ")
ENDIF

IF NoVacio(Dialogo.Vehiculo1)
  ACT(z:1, Val(z:1)~"O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' and ")
ENDIF

IF NoVacio(Dialogo.Especie1)
  ACT(z:1, Val(z:1)~"O.Especie = '"~Dialogo.Especie1~"' and ")
ENDIF

ACT(z:1, Val(z:1)~"O.FechaOp between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"'")

IF NoVacio(Dialogo.Operador)
  ACT(z:1, Val(z:1)~" and O.Operador = '"~Dialogo.Operador~"'")
ENDIF

************* ARMADO DE CONDICION DE DATOS DEL WHERE DEPENDIENDO LA ENTRADA FIN ***************


************* QUERY A LA TABLA ***************

SQL.ADD("SELECT O.Cliente1, O.Vehiculo1, O.Especie, O.ContraEspecie, O.TipoOp, O.Cantidad, O.Precio1, O.Plazo, O.TotalBrutoCli1, O.NrOperacion, O.FechaOp,")
SQL.ADD("C.Codigo, C. RazonSocial, V.Codigo, V.Descripcion, T.Nombre, T.Codigo ")
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V, "~DBO~".CLIENTES C, "~DBO~".TIPOSOPERACION T ")
SQL.ADD("WHERE "~Val(z:1)~"")
SQL.ADD("  AND V.Codigo = O.Vehiculo1")
SQL.ADD("  AND C.Codigo = O.Cliente1")
SQL.ADD("  AND T.Codigo = O.TipoOp ")
SQL.ADD("  ORDER BY C.RazonSocial, V.Descripcion")

************* QUERY A LA TABLA FIN ***************


************* RECORRIDO DEL QUERY PARA MOVER DATOS AL LISTADO ***************

ACT(XX:1,'')
Recorrer SQL
  IF Not EqStr(FBN['Cliente1'], Val(XX:1)) Y Not CeldaVacia(XX:1)  
     IFA
     ACT(A:FAC, "Cliente")
     ACT(B:FAC, "Vehiculo")
     ACT(C:FAC, "Especie")
     ACT(D:FAC, "FechaOp")
     ACT(E:FAC, "Contra Esp.")
     ACT(F:FAC, "Tipo Op.")
     ACT(G:FAC, "Cantidad")
     ACT(H:FAC, "Precio/Tasa")
     ACT(I:FAC, "Plazo")
     ACT(J:FAC, "Total")
     ACT(K:FAC, "Nro.Ope.")
     AlinearCeldas(A:FAC..F:FAC,'I')
     AlinearCeldas(G:FAC..J:FAC,'D')
     AlinearCeldas(K:FAC,'I')
     SetFont(A:FAC..K:FAC, 2)
     AgregarMarco(A:FAC..K:FAC,2,0,Exe('COLOR'))
     IFA
  ENDIF
  ACT(A:FAC, Copy(FBN['RazonSocial'],1,25))
  ACT(B:FAC, Copy(BuscarCampo('VEHICULOS', 'Descripcion', 'Codigo', FBN['Vehiculo1']),1,25))
  ACT(C:FAC, FBN['Especie'])
  ACT(D:FAC, FBN['FechaOp'])
  ACT(E:FAC, FBN['ContraEspecie'])
  ACT(F:FAC, FBN['TipoOp'])
  ACT(G:FAC, FBN['Cantidad'])
  ACT(H:FAC, FBN['Precio1'])
  ACT(I:FAC, FBN['Plazo'])
  ACT(J:FAC, FBN['TotalBrutoCli1'])
  ACT(K:FAC, FBN['NrOperacion'])
  ACT(XX:1 , FBN['Cliente1'])
Proximo

************* RECORRIDO DEL QUERY PARA MOVER DATOS AL LISTADO FIN ***************


************* ANCHO DE COLUMNAS Y FIN DEL LISTADO ***************

ACO( 1,18)
ACO( 2,14)
ACO( 3,13)
ACO( 4,13)
ACO( 5,13)
ACO( 6,12)
ACO( 7,11)
ACO( 8,10)
ACO( 9,10)
ACO(10,10)
ACO(11,10)

IFA
IFA

ACT(A:FAC, 'FIN DEL LISTADO')
SetFont(A:FAC,2)

************* ANCHO DE COLUMNAS Y FIN DEL LISTADO FIN ***************