Setfont(a2..q:fac, 1)
AlinearCeldas(A:fac..q:fac, 'C')

*--  Codigos Datanet
*   ACT(da1, TRIM(MIRT(Dialogo.String1))) 


SQL.ADD(" SELECT  M.*,   ")
SQL.ADD("        D.FechaBajada, D.Archivo    ")
SQL.ADD(" FROM "~DBO~".MOVDATANET M,   ")
SQL.ADD("      "~DBO~".DATANET D ")
SQL.ADD(" WHERE M.NrDatanet = D.NrDatanet (+) ")
SQL.ADD(" AND   M.FechaAcreditacion >= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND   M.FechaAcreditacion <= "~IdxDate2(Dialogo.Fecha2)~" ")

If NoVacio(Dialogo.Lista1)
  SQL.ADD(" AND M.NrDatanet IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif

If NoVacio(Dialogo.Lista2)
  SQL.ADD(" AND M.Banco IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
Endif

If NoVacio(Dialogo.Lista3)
  SQL.ADD(" AND M.Cuenta IN ("~Pipe2Comillas(Dialogo.Lista3)~") ")
Endif

If NoVacio(Dialogo.Lista4)
  SQL.ADD(" AND M.TipoMov IN ("~Pipe2Comillas(Dialogo.Lista4)~") ")
Endif


SQL.ADD(" ORDER BY M.Banco, M.Sucursal, M.Cuenta, M.DC, M.FechaAcreditacion, M.Comprobante, M.Importe ")






acn(z3,0)
acn(z2,0)

ACN(FI:1, fac+1)
