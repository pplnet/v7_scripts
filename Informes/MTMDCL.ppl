CrearDialogo
  Fecha1:   'Fecha'    ;1;1;;;;EsHabil(Dialogo.Fecha1,'ARG') y Dialogo.Fecha1>0;'Fecha invalida';NO;FSys;
  Cliente1: 'Cliente'  ;2;1;;;;
  Mercado1: 'Mercado'  ;3;1;;;;
  Especie1: 'Especie'  ;4;1;;SI;;
FinDialogo

If Not OK
  Cancelar
EndIf

CrearFont(1,'Arial,9,BU')
CrearFont(2,'Arial,8,B')
CrearFont(3,'Arial,8,')
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

ACT(A:4,'Detalle MTM Mercado Cliente')
SetFont(A:4,1)

SetFilaActual(6)

ACT(A:FAC,'Fecha: '~Dialogo.Fecha1)
If NoVacio(Dialogo.Cliente1)
   ACT(A:FAC+1,'Cliente: '~Dialogo.Cliente1)
Else
   ACT(A:FAC+1,'Cliente: Todos')
EndIf
If NoVacio(Dialogo.Mercado1)
   ACT(A:FAC+2,'Origen: '~Dialogo.Mercado1)
Else
   ACT(A:FAC+2,'Origen: Todos')
EndIf

SetFont(A:FAC..A:FAC+2,2)

SetFilaActual(FAC+4)

ACT(A:FAC,'Tipo Operacion')
ACT(B:FAC,'NrOperacion')
ACT(C:FAC,'Especie')
ACT(D:FAC,'F. Concertacion')
ACT(E:FAC,'F. Vencimiento')
ACT(F:FAC,'F. Fixing')
ACT(G:FAC,'F. PreCancelacion')
ACT(H:FAC,'Importe Contrato')
ACT(I:FAC,'Precio')
ACT(J:FAC,'PrecioIni')
ACT(K:FAC,'PrecioFin')
ACT(L:FAC,'Valor MTM')
ACT(M:FAC,'Acumulado MTM')
ACT(N:FAC,'Valor MTM Especie')
ACT(O:FAC,'Acum. MTM Especie')

AlinearCeldas(A:FAC..O:FAC,'C')
AgregarMarco(A:FAC..O:FAC,2,0,Exe('COLOR'))
SetFont(A:FAC..O:FAC,2)
if NO
SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.Cliente1, O.Especie, O.FechaOp, O.FechaVto, O.FechaPrecan, O.Cantidad, O.Precio1, M.PrecioAyer, M.PrecioHoy, M.MTM ValorMTM, SUM(M.MTMEspecie) ValorMTMEspecie,")
SQL.ADD(" (Select SUM(M1.MTM) from MTMDIARIO M1 Where M1.NrOperacion=O.NrOperacion and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') AcumuladoMTM, ")
SQL.ADD(" (Select SUM(M1.MTMEspecie) from MTMDIARIO M1 Where M1.NrOperacion=O.NrOperacion and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') AcuMTMEspecie ")
SQL.ADD("   From "~DBO~".OPERACIONES O, "~DBO~".MTMDIARIO M ")
SQL.ADD("  Where O.NrOperacion = M.NrOperacion ")
SQL.ADD("    And O.TipoOp in ('TICF','TIVF','FXCF','FXVF') ")
SQL.ADD("    And M.Fecha= '"~IdxDate(Dialogo.Fecha1)~"' ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" And O.Cliente1= '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" And O.Mercado= '"~Dialogo.Mercado1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" And O.Especie= '"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD(" Group By TipoOp, O.NrOperacion, O.Cliente1, O.Especie, O.FechaOp, O.FechaVto, O.FechaPrecan, O.Cantidad, O.Precio1, M.PrecioAyer, M.PrecioHoy, M.MTM, M.MTMEspecie ")
SQL.ADD(" Order by O.TipoOp ")
endif

SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.Cliente1, O.Especie, O.FechaOp, O.FechaVto, O.FechaPrecan, O.Cantidad, O.Precio1, O.Mercado4, FechaVto2, ")

SQL.ADD(" (Select PrecioAyer From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O.NrOperacion=O1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha = '"~IdxDate(Dialogo.Fecha1)~"') PrecioAyer, ")
SQL.ADD(" (Select PrecioHoy From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O.NrOperacion=O1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha = '"~IdxDate(Dialogo.Fecha1)~"') PrecioHoy, ")




SQL.ADD(" (Select SUM(M1.MTM) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O.NrOperacion=O1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha = '"~IdxDate(Dialogo.Fecha1)~"') ValorMTM, ")
SQL.ADD(" (Select SUM(M1.MTMEspecie) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O.NrOperacion=O1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha = '"~IdxDate(Dialogo.Fecha1)~"') ValorMTMEspecie, ")
SQL.ADD(" (Select SUM(M1.MTM) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O.NrOperacion=O1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') AcumuladoMTM, ")
SQL.ADD(" (Select SUM(M1.MTMEspecie) From "~DBO~".MTMDIARIO M1, "~DBO~".OPERACIONES O1 ")
SQL.ADD("   where O1.NrOperacion = M1.NrOperacion and O.NrOperacion=O1.NrOperacion and O1.Cliente1 = O.Cliente1 and O1.Especie = O.Especie and O1.TipoOp = O.TipoOp and O1.Mercado4 = O.Mercado4 and M1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') AcuMTMEspecie ")
SQL.ADD("   From "~DBO~".OPERACIONES O ")
SQL.ADD("  Where O.TipoOp in ('TICF','TIVF','FXCF','FXVF') ")
SQL.ADD("    And O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'       ")
SQL.ADD("    And O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"'       ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" And O.Cliente1= '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Mercado1)
   SQL.ADD(" And O.Mercado= '"~Dialogo.Mercado1~"' ")
EndIf
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" And O.Especie= '"~Dialogo.Especie1~"' ")
EndIf
SQL.ADD(" Group By TipoOp, O.NrOperacion, O.Cliente1, O.Especie, O.FechaOp, O.FechaVto, O.FechaPrecan, O.Cantidad, O.Precio1, O.Mercado4, O.FechaVto2 ")
SQL.ADD(" Order by O.TipoOp ")

watch(sql.batch())
ACN(Z:1,FAC+1)
ACT(OP:1,'')

Recorrer SQL
  If Eqstr(Val(OP:1),'')
     ACT(A:FAC,FBN['TipoOp'])
  EndIf
  If Not Eqstr(Fbn['TipoOp'],Val(OP:1)) Y Not Eqstr(Val(OP:1),'')
  *     ACT(H:FAC,'Total '~IIF(Eqstr(Val(OP:1),'TICF'),'Compras','Ventas')~' Cliente '~Dialogo.Cliente1~':')
  ACT(H:FAC,'Total '~IIF(Incluido(Val(OP:1),'TICF|FXCF'),'Compras','Ventas')~' Cliente '~Dialogo.Cliente1~':')
     ACN(L:FAC,Val(TO:1))
     ACN(M:FAC,Val(TO:2))
     ACN(N:FAC,Val(TO:41))
     ACN(O:FAC,Val(TO:42))

     SCN(TO:3,Val(L:FAC))     
     SCN(TO:4,Val(M:FAC))
     SCN(TO:43,Val(N:FAC))     
     SCN(TO:44,Val(O:FAC))

     ACN(TO:1,0)
     ACN(TO:2,0)
     ACN(TO:41,0)
     ACN(TO:42,0)
     
     AgregarMarco(H:FAC..O:FAC,0,0)
     SetFont(H:FAC..O:FAC,2)
     IFA
     IFA
     ACT(A:FAC,FBN['TipoOp'])
  EndIf
  
  ACT(B:FAC,FBN['NrOperacion'])
  ACL(B:FAC,'MTMDOP', NrOperacion1=FBN['NrOperacion'], Fecha1=Dialogo.Fecha1)
  ACT(C:FAC,FBN['Especie'])
  ACD(D:FAC,FBN['FechaOp'])
  ACD(E:FAC,FBN['FechaVto'])
  ACD(F:FAC,FBN['FechaVto2'])
  ACN(H:FAC,FBN['Cantidad'])
  ACN(I:FAC,FBN['Precio1'])
  ACN(J:FAC,FBN['PrecioAyer'])
  ACN(K:FAC,FBN['PrecioHoy'])
  ACN(L:FAC,FBN['ValorMTM'])
  ACN(M:FAC,FBN['AcumuladoMTM'])
  ACN(N:FAC,FBN['ValorMTMEspecie'])
  ACN(O:FAC,FBN['AcuMTMEspecie'])  
  SCN(TO:1,FBN['ValorMTM'])
  SCN(TO:2,FBN['AcumuladoMTM'])
  SCN(TO:41,FBN['ValorMTMEspecie'])
  SCN(TO:42,FBN['AcuMTMEspecie'])  
  SetFont(A:FAC..O:FAC,3)
  ACT(OP:1,FBN['TipoOp'])
Proximo

IFA
ACT(H:FAC,'Total '~IIF(Incluido(Val(OP:1),'TICF|FXCF'),'Compras','Ventas')~' Cliente '~Dialogo.Cliente1~':')
