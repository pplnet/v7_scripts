CrearDialogo
   Fecha1   : 'Fecha'           ;1;1;
   Vehiculo1: 'Vehiculo'        ;;;;;
   Mercado1 : 'Mercado'        ;;;;;;
   Especie1 : 'Especie'        ;;;;;;
   Entero1 : 'Cupon'        ;;;;;;
   Radio1  : 'Mayor|NO|SI'  ;;;;;
FinDialogo

IF Not Ok
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')

SetFilaActual(1)
ACN(FI:1, fac)
ACT(A:fac, 'Detalle de Tenencia Pases Cartera Propia')
ifa
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
ACT(A:fac, 'Mercado: '~Dialogo.Mercado1)
ifa
ACT(A:fac, 'Especie: '~Dialogo.Especie1)
ifa
ACT(A:fac, 'Cupon: '~Fstr(Dialogo.Entero1, 0, 0))
SetFont(A:Val(FI:1)..A:fac, 3)
SetFilaActual(fac+3)
ACN(FI:1, fac)
ACT(A:fac, 'NrOperacion')
ACT(B:fac, 'TipoOp')
ACT(C:fac, 'FechaOp')
ACT(D:fac, 'FechaVto')
ACT(E:fac, 'Cantidad')
* FJL 12/09/22 - Issues 5741-5909 - Para igualarlo con el DTENCP
ACT(f:fac, 'Monto')
ACT(g:fac, 'Interes')
ACT(h:fac, 'Neto')
ACT(i:fac, 'Merc.Neg.')

SetFont(A:fac..i:fac, 1)
AgregarMarco(A:fac..i:fac, 0, 0, Exe('COLOR'))
ACN(TT:1, 0)
ACN(FI:1, fac+1)
SQL.ADD(" Select O.Especie, O.Cupon1 Cupon, O.Mercado, O.Cantidad, O.FechaVto, O.PaseCB, ")
* FJL 12/09/22 - Issues 5741-5909 - Para igualarlo con el DTENCP
SQL.ADD(" O.TotalBrutoCli1, O.TotalIntereses, O.TotalNetoCli1, Mercado4 MerNeg, UDN2, ")
SQL.ADD(" O.FechaOp, O.NrOperacion, O.TipoOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O ")
SQL.ADD(" Where O.TipoOp In ('TIC','TIV','TIFC','TIFV') ")
SQL.ADD(" AND O.PaseCB=1 ")
IF Dialogo.Radio1 = 0
    SQL.ADD(" AND O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"'  ")
ELSE
    SQL.ADD(" AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'  ")
ENDIF
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND O.Mercado = '"~Dialogo.Mercado1~"' ")
SQL.ADD(" AND O.Especie = '"~Dialogo.Especie1~"' ")
SQL.ADD(" AND O.Cupon1 = "~Fstr(Dialogo.Entero1, 0, 2)~" ")
Watch(SQL.Batch())
Recorrer SQL
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('TipoOp'))
    ACD(C:fac, fbn('FechaOp'))
    ACD(D:fac, fbn('FechaVto'))
    ACN(E:fac, fbn('Cantidad'))
    IF Incluido(fbn('TipoOp'), 'TIV|TIFV')
        ACN(E:fac, Val(E:fac) * (-1))
    ENDIF
* FJL 12/09/22 - Issues 5741-5909 - Para igualarlo con el DTENCP
    ACN(f:fac, fbn('TotalBrutoCli1'))
    ACN(g:fac, fbn('TotalIntereses'))
    ACN(h:fac, fbn('TotalNetoCli1'))
    IF Incluido(fbn('TipoOp'), 'TIC|TIFC')
      ACN(f:fac, Val(f:fac) * (-1))
      ACN(g:fac, Val(g:fac) * (-1))
      ACN(h:fac, Val(h:fac) * (-1))
    ENDIF
    ACT(i:fac, fbn('MerNeg'))
    if EqStr(fbn('MerNeg'),'BYMA')
      ACT(i:fac, Val(i:fac)~' - '~fbn('UDN2'))
    endif
    SCN(TT:1, Val(E:fac))
Proximo
SetFont(A:Val(FI:1)..E:fac, 2)
ifa
ACN(E:fac, Val(TT:1))
SetFont(E:fac, 1)
FormatoCeldas(E:Val(FI:1)..h:fac, Exe('F2'))
ifa
ifa
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 1)

ACO(1, 7)
ACO(2, 6)
ACO(3, 7)
ACO(4, 7)
ACO(5, 9)
ACO(6, 9)
ACO(7, 9)
ACO(8, 9)
ACO(9, 12)

LimitesVision(j:fac+1)
