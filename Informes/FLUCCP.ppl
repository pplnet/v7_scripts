CrearDialogo
  Fecha1 : 'F.Desde'     ;1;1;;;;;;;Fsys
  Fecha2 : 'F.Hasta'     ;2;1;;;;;;;Fsys+7
  Cliente1:'Cliente'     ;2;2;;;;;;;VAR('VEHICULODE')

  Especie1:'Especie'     ;1;2;;No;;;;;'ARP'
FinDialogo

if Not Ok
  Cancelar
endif


ACT(a1, 'Flujo de cheques de Cartera Propia')
ACT(a2, 'D.Fecha: '~Dialogo.Fecha1)
ACT(c2, 'H.Fecha: '~Dialogo.Fecha2)
ACT(c3, 'Especie:'~Dialogo.Especie1)

ACT(a6, 'Fecha')
ACT(b5, 'Liquidacion')
ACT(b6, 'Compras')
ACT(c6, 'Ventas')

ACT(e5, 'Acreditacion')
ACT(e6, 'Compras')
ACT(f6, 'Ventas')

ACT(h6, 'Neto')

*ACT(d6, 'Derechos')
*ACT(e6, 'Comisiones')
*ACT(f6, 'Gastos')
*ACT(g6, 'IVA')
*ACT(h6, 'Neto')
ACT(j5, 'Concertacion')
ACT(j6, 'Compras')
ACT(k6, 'Ventas')

SQL.ADD("SELECT * FROM   "~DBO~".OPERACIONES")
SQL.ADD("WHERE TipoOp in ('DDC','DDV') and ((FechaOp >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp<'"~IdxDate(Dialogo.Fecha2+1)~"') or ")
SQL.ADD("(FechaOp2 >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaOp2<='"~IdxDate(Dialogo.Fecha2+1)~"') or")
SQL.ADD("(FechaVto2 >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaVto2<='"~IdxDate(Dialogo.Fecha2+1)~"'))")
SQL.ADD(" and Especie = '"~Dialogo.Especie1~"'")
SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"'")

  SetFilaActual(6)

Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
  ifa
  ACD(a:fac, Dialogo.Fecha1+&i-1)
proximo

recorrer SQL
  if fbn('FechaOp2')>=Dialogo.Fecha1 y fbn('FechaOp2')<Dialogo.Fecha2+1
    Let &Fila 6+(fbn('FechaOp2')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
      SCN(b:&Fila, fbn('Cantidad'))
    else
      SCN(c:&Fila, fbn('Cantidad'))
    endif
  endif

  if fbn('FechaVto2')>=Dialogo.Fecha1 y fbn('FechaVto2')<Dialogo.Fecha2+1
  Let &Fila 6+(fbn('FechaVto2')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
      SCN(e:&Fila, fbn('TotalBrutoCli1'))
    else
      SCN(f:&Fila, fbn('TotalBrutoCli1'))
    endif
  endif
  
  if fbn('FechaOp')>=Dialogo.Fecha1 y fbn('FechaOp')<Dialogo.Fecha2+1
    Let &Fila 6+(fbn('FechaOp')-Dialogo.Fecha1+1)
    If Incluido(fbn('TipoOp'),'DDC')
    SCN(j:&Fila, fbn('Cantidad'))
    else
    SCN(k:&Fila, fbn('Cantidad'))
    endif
  endif
proximo

setfilaactual(6)
Recorrer&i 1, Dialogo.Fecha2-Dialogo.Fecha1+1
  ifa
  ACN(h:fac, Val(c:fac)-Val(b:fac)+Val(e:fac)-Val(f:fac))
  if NoVacio(b:fac)
    ACL(b:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=1)
  endif  
  if NoVacio(c:fac)
    ACL(c:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=2)
  endif  
  if NoVacio(j:fac)
    ACL(j:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=3)
  endif  
  if NoVacio(k:fac)
    ACL(k:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=4)
  endif  
  if NoVacio(e:fac)
    ACL(e:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=5)
  endif  
  if NoVacio(f:fac)
    ACL(f:fac, 'FLUCH2',Fecha1 = Val(a:fac), Especie1=Dialogo.Especie1, Cliente1=Dialogo.Cliente1, Radio1=6)
  endif  

  *agregar todos los links, seleccionando el tipo por el radio1: liqcompras, liqventas, conccompras, concventas
proximo

let &AnchoColumna 8
ACO(2,&AnchoColumna)
