ModoReproceso(SinDialogo)
CrearDialogo
  Vehiculo1  : "Vehiculo"     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Cliente1   : "Contraparte"  ;;;;;;;;;;;
  Especie1   : "Especie"      ;;;;;;;;;
  Fecha1     :'F.Desde'       ;;;;;;NoVacio(Dialogo.Fecha1);'Debe Ingresar Fecha Desde';NO;FSys-Dia(FSys)+1
  Fecha2     :'F.Hasta'       ;;;;;;NoVacio(Dialogo.Fecha2);'Debe Ingresar Fecha Hasta';NO;FinDeMes(FSys,SI,'ARG')
  Radio1     :'Tipo|Todos|Colocacion|Toma' ;;;;NO;;;;;0
FinDialogo

if Not Ok
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo1 ')
   endif
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC, "Operaciones entre Terceros")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+1, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
Else
   if Vacio(UsrVehiculos(UsuarioActivo))
      ACT(a:FAC+1, 'Vehiculo : Todos ')
   else
      ACT(a:FAC+1, 'Vehiculo : '~val(zz6))
   endif
EndIf

If NoVacio(Dialogo.Cliente1)
   ACT(a:FAC+2, 'Contraparte : '~BuscarCampo('Clientes','RazonSocial','Codigo',Dialogo.Cliente1))
else
   ACT(a:FAC+2, 'Contraparte : Todos ')
EndIf

acd(zz7,HABILES(Dialogo.Fecha1,-1, VAR('FERIADODEF')))

ACT(a:FAC+3, 'Especie : '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
ACT(a:FAC+4, 'Fecha Desde: '~val(zz7))
ACT(a:FAC+5, 'Fecha Hasta: '~Dialogo.Fecha2)

if Dialogo.Radio1=0
   ACT(a:FAC+6, 'Tipo de Movimiento : Todos ')
else
   if Dialogo.Radio1=1
      ACT(a:FAC+6, 'Tipo de Movimiento : Colocaciones ')
   else
      ACT(a:FAC+6, 'Tipo de Movimiento : Tomas ')
   endif
endif

SetFont(a:fac..N:FAC+6,2)

SetFilaActual(FAC+8)

act(a:fac, 'Numero Op.')
ACT(b:FAC, 'Fecha Ini.')
ACT(c:FAC, 'Fecha Vto.')
ACT(d:FAC, 'Especie')
ACT(e:FAC, 'Plazo')
ACT(f:FAC, 'Mov.Dia')
ACT(g:FAC, 'Capital')
ACT(h:FAC, 'Tasa')
ACT(i:FAC, 'Intereses')
ACT(j:FAC, 'TipoOp')

AlinearCeldas(a:FAC..k:FAC,'I')
AlinearCeldas(f:FAC..j:FAC,'D')
SetFont(a:fac..k:FAC,2)
AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))

SetFilaActual(FAC+1)

* Recupero las TEMIND que no son FechasValor
SQL.ADD("Select CASE (FechaOp-FechaCarga) WHEN 0 THEN 'A' ELSE 'B' END Tip,")
SQL.ADD("O.* from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp IN ('TEMIND','TEMINM') ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1='"~Dialogo.Cliente1~"' ")
EndIf
if NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"'")
endif
SQL.ADD(" and  ( ")
SQL.ADD(" (O.FechaOp  >= '"~IdxDate(val(zz7))~"' and O.FechaOp<='"~IdxDate(Dialogo.Fecha2)~"' ) ")
SQL.ADD(" or ")
SQL.ADD(" (TipoOp='TEMIND' and (FechaOp-FechaCarga)>0 and FechaVto>='"~IdxDate(val(zz7))~"' and FechaVto<='"~IdxDate(Dialogo.Fecha2)~"') ")
SQL.ADD(" ) ")
If Dialogo.Radio1=1
   * Coloca
   SQL.ADD(" and MB3 ='0' ")
EndIf
If Dialogo.Radio1=2
   * Toma
   SQL.ADD(" and MB3 ='1' ")
EndIf
SQL.ADD("order by O.Vehiculo1,O.Cliente1, O.Especie,O.MB3,1, O.FechaOp")

ACT(X1,' ')
ACT(X3,' ')
ACT(X4,' ')
act(x5,' ')
acn(x2,0)

* Suma por Vehiculo de x7: Mov.Diarios x8: Capital x9: Interes
acn(x7,0)
acn(x8,0)
acn(x9,0)

* Suma Total de x7: Mov.Diarios x8: Capital x9: Interes
acn(x17,0)
acn(x18,0)
acn(x19,0)

Recorrer SQL

  If Not EqStr(val(x3),fbn['Vehiculo1']~' '~Iif(EqStr(FBN['MB3'],'0'),' Coloca ',' Toma ')~' '~fbn['Cliente1']~' '~fbn['Especie']~' '~Iif(EqStr(FBN['Tip'],'B'),' Fecha Valor '))
     * Total de operaciones del cuerpo principal
     If Val(x2)<>0 y EqStr(VAL(x4),'A')
        ifa
        ACT(a:FAC, 'Total ')        
        *acn(f:fac,val(x7))
        *acn(g:fac,val(x8))
        acn(i:fac,val(x9))
        
        SetFont(a:FAC..k:FAC,2)
        FormatoCeldas(f:fac..k:fac,Exe('F2'))
        ifa
        ifa
        * Suma por Vehiculo de x7: Mov.Diarios x8: Capital x9: Interes
        acn(x7,0)
        acn(x8,0)
        acn(x9,0)
     EndIf

     If Not EqStr(val(x5),fbn['Especie'])
        acn(x17,0)
        acn(x18,0)
        acn(x19,0)
     EndIf

     act(x3,fbn['Vehiculo1']~' '~Iif(EqStr(FBN['MB3'],'0'),' Coloca ',' Toma ')~' '~fbn['Cliente1']~' '~fbn['Especie']~' '~Iif(EqStr(FBN['Tip'],'B'),' Fecha Valor '))
     act(x4,fbn['Tip'])
     act(a:FAC, val(x3) )

     If  EqStr(val(x4),'A')
         AgregarMarco(a:FAC..k:FAC,2,0,Exe('COLOR'))
     Else
         AgregarMarco(a:FAC..d:FAC,1,0)
     EndIf

     SetFont(a:FAC..c:FAC,2)
     ifa
     ifa
     acn(x2,0)
  endif

  acn(x6,0)

  If EqStr(fbn['Tip'],'A') y Not EqStr(fbn['TipoOp'],'TEMINM') 
     *-- Selecciono los Movimientos del Dia.
     SQL.ADD("Select O.Vehiculo1, O.Cliente1, O.Especie, ")
     SQL.ADD(" Sum(CASE O.MB3 WHEN '0' THEN - O.Cantidad ELSE O.Cantidad END) Cant ")
     SQL.ADD("from "~DBO~".OPERACIONES  O ")
     SQL.ADD("where O.TipoOp = 'TEMD' ")
     SQL.ADD(" and O.Vehiculo1 = '"~fbn['Vehiculo1']~"'")
     SQL.ADD(" and O.Cliente1 = '"~fbn['Cliente1']~"'")
     SQL.ADD(" and O.Especie = '"~fbn['Especie']~"'")
     SQL.ADD(" and  O.FechaOp  = '"~IdxDate(fbn['FechaOp'])~"' ")
     SQL.ADD("group by O.Vehiculo1, O.Cliente1, O.Especie ")

     Recorrer SQL
       dfa
       acn(x6,fbn['Cant'])
     Proximo
  EndIf

  act(a:fac,fbn['NrOperacion'])
  aclo(a:fac,fbn['NrOperacion'])
  acd(b:fac,fbn['FechaOp'])
  acd(c:fac,fbn['FechaVto'])
  act(d:fac,fbn['Especie'])
  acn(e:fac,fbn['Plazo'])
  act(j:fac,fbn['TipoOp']~' '~IIF(EqStr(FBN['MB3'],'0'),'C','T'))

  acn(g:fac,iif(fbn['MB3']=0,-fbn['Cantidad'],fbn['Cantidad']))

  If EqStr(FBN['TipoOp'],'TEMINM')
     acn(g:fac,iif(fbn['MB3']=0,-fbn['TotalBrutoCli1'],fbn['TotalBrutoCli1']))     
  EndIf

  acn(f:fac,0)
  acn(h:fac,fbn['Precio1'])
  acn(i:fac,fbn['TotalIntereses'])

  If EqStr(fbn['Tip'],'A')
     acn(f:fac,val(x6))

     * Totales por Vehiculo
     scn(x7,val(f:fac))
     scn(x8,val(g:fac))
     scn(x9,val(i:fac))

     * Totales Generales
     scn(x17,val(f:fac))
     scn(x18,val(g:fac))
     scn(x19,val(i:fac))
  EndIf

  acn(x2,1)
  SetFont(a:FAC..k:FAC,1)
  FormatoCeldas(e:fac..e:fac, EXE('F0'))
  FormatoCeldas(f:fac..k:fac,Exe('F2'))
  FormatoCeldas(i:fac..i:fac,Exe('F6'))
  AlinearCeldas(f:FAC..j:FAC,'D')
proximo

* Total de operaciones del cuerpo principal
If Val(x2)<>0 y EqStr(VAL(x4),'A')
   ifa
   ifa
   ACT(a:FAC, 'Total ')        
   *acn(f:fac,val(x7))
   *acn(g:fac,val(x8))
   acn(i:fac,val(x9))
        
   SetFont(a:FAC..k:FAC,2)
   FormatoCeldas(f:fac..k:fac,Exe('F2'))
   ifa
   ifa

   * Suma por Vehiculo de x7: Mov.Diarios x8: Capital x9: Interes
   acn(x7,0)
   acn(x8,0)
   acn(x9,0)
EndIf

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,5)
ACO(5,5)
ACO(6,12)
ACO(7,12)
ACO(8,12)
ACO(9,8)
ACO(10,12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
LimitesVision(k:FAC)
*RangoTitulo(a1..k:8,36)

