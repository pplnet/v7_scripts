ACT(A1,'Hora de una Fecha No Vacia')
ACT(B1,Hora(BuscarCampo('OPERACIONES','FechaEnvioMae','NrOperacion','T0033187')))
ACT(A2,'Hora de una Fecha Vacia')
ACT(B2,Hora(BuscarCampo('OPERACIONES','FechaAltaMae','NrOperacion','T0033187')))
ACT(A3,'Hora de SQLAhora')
ACT(B3,Hora(SQLAhora))

ACN(C1,Num(Copy(Val(B1),1,2))*3600+Num(Copy(Val(B1),4,2))*60+Num(Copy(Val(B1),7,2))+(Var('ESPERA')*60))
ACN(C2,Num(Copy(Val(B2),1,2))*3600+Num(Copy(Val(B2),4,2))*60+Num(Copy(Val(B2),7,2))+(Var('ESPERA')*60))
ACN(C3,Num(Copy(Hora(SQLAhora),1,2))*3600+Num(Copy(Hora(SQLAhora),4,2))*60+Num(Copy(Hora(SQLAhora),7,2)))

ACO(1,15)