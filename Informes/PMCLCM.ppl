ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1  : 'Fecha Desde'   ;;;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;PriDeMes(FSys,SI);PriDeMes(DIALOGO.FECHA2,SI)
  Fecha2  : 'Fecha Hasta'   ;;;;;;NoVacio(Dialogo.Fecha2);'Debe ingresar la Fecha Hasta';NO;FinDeMes(FSys,SI);FinDeMes(DIALOGO.FECHA1,SI)
  Cliente1: 'Cliente'       ; ;;;;;Vacio(Dialogo.Cliente1) o EsTerminal(Dialogo.Cliente1,Clientes);'Cliente incorrecto';NO;;;;;;;;;
FinDialogo
if Not OK
  Cancelar
endif

if NoVacio(Dialogo.Cliente1)
  if EsTerminal(Dialogo.Cliente1,Clientes)
    ACT(v1, Dialogo.Cliente1)
  else
    Cancelar('Cliente no vßlido')
  endif 
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACN(w1,FAC)

ACT(a:FAC, 'Control de Limites de Concentracion de Riesgo (BCRA) - Mensual')
ACT(a:FAC+1, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
ACT(a:FAC+2, 'Fecha de Proceso: '~Dialogo.Fecha1)

if NoVacio(Dialogo.Cliente1)
  ACT(a:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(a:FAC+3, 'Cliente : Todos')
endif

ACT(a:FAC+4, 'RPC: ')
ACN(b:FAC+4, BuscarCampo('CLIENTES','RPC','Codigo',Var('VEHICULODE')))

ACT(r:FAC, 'Control de Limites de Concentracion de Riesgo (BCRA) - Mensual')
ACT(r:FAC+1, 'Desde: '~Dialogo.Fecha1~' Hasta: '~Dialogo.Fecha2)
ACT(r:FAC+2, 'Fecha de Proceso: '~Dialogo.Fecha1)

if NoVacio(Dialogo.Cliente1)
  ACT(r:FAC+3, 'Cliente : '~Dialogo.Cliente1)
else
  ACT(r:FAC+3, 'Cliente : Todos')
endif

ACT(r:FAC+4, 'RPC: ')
ACN(s:FAC+4, BuscarCampo('CLIENTES','RPC','Codigo',Var('VEHICULODE')))

SetFont(a:FAC..s:FAC+4,2)


ACD(z2, Dialogo.Fecha1)
ACD(z4, Dialogo.Fecha2)

SetFilaActual(val(w1)+6)

(.'PMOAUXCLCM'.)


Impresion(1,2)
SetFilaActual(FAC+12)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC,2)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
AgregarBMP(r1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(ag:FAC)

BorrarCeldas(t:1..af:9)

RangoTitulo(a:1..ag:FAC, 6)

SetPrintFit(3,72)