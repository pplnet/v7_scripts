ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : 'Fecha Desde';;;;;;;;;FSys
  Fecha2     : 'Fecha Hasta';;;;;;;;;FSys
  Cliente1   : 'Cliente';
  Vehiculo1  : 'Vehiculo';
  Mercado1   : 'Mercado';
FinDialogo

if Not OK
  Cancelar
endif


if Eqstr(Dialogo.Mercado1,VAR('MERCAACMC'))
   Cancelar('El Mercado es Incorrecto ')
Endif


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

SetFilaActual(4)
ACN(w1,FAC)

ACT(a:FAC, 'Vouchers Transportados')
ACT(a:FAC+1, 'Fecha Desde: '~Dialogo.Fecha1)
ACT(a:FAC+2, 'Fecha Hasta: '~Dialogo.Fecha2)
ACT(a:FAC+3, 'Cliente: '~iif(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(a:FAC+4, 'Vehiculo: '~iif(NoVacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
ACT(a:FAC+5, 'Mercado: '~iif(NoVacio(Dialogo.Mercado1),Dialogo.Cliente1,'Todos'))

ACT(a:FAC+6, 'Cliente')
ACT(b:FAC+6, 'Especie')
ACT(c:FAC+6, 'Nr.Compr.')
ACT(d:FAC+6, 'Merc.')
ACT(e:FAC+6, 'Mod.Liq.')
ACT(f:FAC+6, 'Fecha')
ACT(g:FAC+6, '                Total Voucher')
ACT(g:FAC+7, 'Cant.Especie')
ACT(h:FAC+7, 'Cant.Moneda')
ACT(i:FAC+6, '                 Cant.Cob/Pag')
ACT(i:FAC+7, 'Cant.Especie')
ACT(j:FAC+7, 'Cant.Moneda')
ACT(k:FAC+6, '                 Cant.Fallada')
ACT(k:FAC+7, 'Cant.Especie')
ACT(l:FAC+7, 'Cant.Moneda')
ACT(m:FAC+6, '                  Datos Falla')
ACT(m:FAC+7, 'Voucher')
ACT(n:FAC+7, 'Fecha')
ACT(o:FAC+7, 'Nr.Oper.')

AlinearCeldas(f:FAC+6,'D')
AlinearCeldas(g:FAC+7..o:FAC+7,'D')
SetFont(a:FAC..o:FAC+7,2)
AgregarMarco(a:FAC+6..f:FAC+7,1,2,Exe('COLOR'))
AgregarMarco(g:FAC+6..h:FAC+6,1,0,Exe('COLOR'))
AgregarMarco(i:FAC+6..j:FAC+6,1,0,Exe('COLOR'))
AgregarMarco(k:FAC+6..l:FAC+6,1,0,Exe('COLOR'))
AgregarMarco(g:FAC+7..l:FAC+7,1,2,Exe('COLOR'))
AgregarMarco(m:FAC+6..o:FAC+6,1,0,Exe('COLOR'))
AgregarMarco(m:FAC+7..o:FAC+7,1,2,Exe('COLOR'))

SetFilaActual(FAC+7)

ACT(y1, Fecha(Dialogo.Fecha1, 'YYYY.MM.DD'))
ACT(y2, Fecha(Dialogo.Fecha2, 'YYYY.MM.DD'))

SQL.ADD(" Select * from "~DBO~".TRANSACCIONES2 T ")
SQL.ADD(" where T.TipoTr2 in ('DEP','RET','COMP','MATCH','TRANSP') ")
SQL.ADD(" and T.Mercado1  not in("~Pipe2Comillas(VAR('MERCAACMC'))~")  ")
SQL.ADD(" and T.CB3 = '1' ")
SQL.ADD(" and ")
SQL.ADD(" ( ")
SQL.ADD("   T.NrTrans in (Select I.NrOperacion from "~DBO~".INSTANCIASOP I where I.NrInstancia = 30 and Convert(Char,I.Fecha,102) between '"~Val(y1)~"' and '"~Val(y2)~"' and I.NrOperacion like 'V%' ) ")
SQL.ADD("   or ")
SQL.ADD("   ( ")
SQL.ADD("     T.Fecha3 between '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("     and (T.CB9 = '0' or T.CB9 is NUll) ")
SQL.ADD("   ) ")
SQL.ADD(" ) ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD(" and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and T.Cliente1 = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD(" and T.Mercado1 = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD(" order by T.Vehiculo1,T.Cliente1,T.Especie,T.Especie1  ")
Recorrer SQL
  if Not EqStr(fbn('Vehiculo1'),Val(v4)) o Not EqStr(FBN['Cliente1'],Val(v1)) o Not EqStr(FBN['Especie'],Val(v2)) o Not EqStr(FBN['Especie1'],Val(v3))
    if FAC>Val(w1)+8
      IFA
    endif
    if Not EqStr(fbn('Vehiculo1'),Val(v4))
      ACT(v4, fbn('Vehiculo1'))
      ACT(a:fac, 'Vehiculo '~Val(v4))
      AgregarMarco(a:fac..o:fac,1,0,RGB(192,192,192))
      SetFont(a:fac..b:fac,2)
      ifa
    endif
    if Not EqStr(FBN['Cliente1'],Val(v1))
      ACT(v1, FBN['Cliente1'])
      ACT(a:FAC,Val(v1))
    endif
    ACT(v2,FBN['Especie'])
    ACT(b:FAC,Val(v2))
    SetFont(a:FAC..b:FAC,2)
  endif
  ACT(c:FAC, FBN['NrTrans'])
  ACLT(c:FAC, FBN['NrTrans'])
  ACT(d:FAC, FBN['Mercado1'])
  if Incluido(FBN['TipoTr2'],'DEP|RET')
    if Incluido(FBN['Mercado1'],Var('MERCTITULO'))
      if EqStr(Copy(FBN['NrOperacionRef1'],1,1),'I')
        ACT(e:FAC, 'STD')
      else
        dfa
        SQL.ADD(" Select TipoOp,FormaLiquidacion1,FormaLiquidacion2 FROM "~DBO~".OPERACIONES WHERE NrOperacion = '"~FBN['NrOperacionRef1']~"' ")
        Recorrer SQL
          if Incluido(FBN['TipoOp'],'TIC|TIV|TIADJ|TIRES')
            if FBN['FormaLiquidacion2']=0
              ACT(e:FAC, 'FD&P')
            endif
            if FBN['FormaLiquidacion2']=2
              ACT(e:FAC, 'FOP')
            endif
          endif
          if Incluido(FBN['TipoOp'],'TIFC|TIFV')
            if FBN['FormaLiquidacion1']=0
              ACT(e:FAC, 'FD&P')
            endif
            if FBN['FormaLiquidacion1']=2
              ACT(e:FAC, 'FOP')
            endif
          endif
        Proximo      
      endif
    else
      if NoVacio(fbn('NrOperacionRef1')) y Incluido(Copy(fbn('NrOperacionRef1'),1,2),'FX|FA')
        ACN(x3, BuscarCampo('OPERACIONES','FormaLiquidacion1','NrOperacion',fbn('NrOperacionRef1')))
        ACT(x4, BuscarCampo('OPERACIONES','TipoOp','NrOperacion',fbn('NrOperacionRef1')))
        ACT(x5, BuscarCampo('OPERACIONES','Especie','NrOperacion',fbn('NrOperacionRef1')))
        ACT(x6, BuscarCampo('OPERACIONES','ContraEspecie','NrOperacion',fbn('NrOperacionRef1')))
        if Val(x3)=0
          ACT(e:FAC, 'STD')
        endif
        if Incluido(Val(x4),'FXC|FXCT|FXA|FXAT')
          if Val(x3)=1
            if EqStr(fbn('Especie'),Val(x5))
              ACT(e:FAC, 'Conf.')
            else
              ACT(e:FAC, 'DVP')
            endif
          endif
          if Val(x3)=2
            if EqStr(fbn('Especie'),Val(x5))
              ACT(e:FAC, 'RVP')
            else
              ACT(e:FAC, 'Conf.')
            endif
          endif
        else
          if Val(x3)=1
            if EqStr(fbn('Especie'),Val(x5))
              ACT(e:FAC, 'DVP')
            else
              ACT(e:FAC, 'Conf.')
            endif
          endif
          if Val(x3)=2
            if EqStr(fbn('Especie'),Val(x5))
              ACT(e:FAC, 'Conf.')
            else
              ACT(e:FAC, 'RVP')
            endif
          endif
        endif
      else
        if FBN['CB6']=1
          ACT(e:FAC, 'DVP')
        endif
        if FBN['CB7']=1
          ACT(e:FAC, 'RVP')
        endif
        if FBN['CB8']=1
          ACT(e:FAC, 'Conf.')
        endif
        if Not NoVacio(Val(e:FAC))
          ACT(e:FAC, 'STD')
        endif
      endif
    endif
  endif
  if Incluido(FBN['TipoTr2'],'MATCH')
    ACT(e:FAC, 'Match')
  endif
  ACD(f:FAC, FBN['Fecha2'])
  if DesciendeDeEspecie(FBN['Especie'],'TITULO')
    ACN(x2,7)
  else
    ACN(x2,8)
  endif
  if EqStr(FBN['TipoTr2'],'DEP') 
    ACN(Val(x2):FAC  , FBN['Cantidad1'])
    if FBN['Cantidad3']<>0
      ACN(Val(x2)+2:FAC, FBN['Cantidad1'] - FBN['Cantidad3'])
      ACN(Val(x2)+4:FAC, FBN['Cantidad3'] )
    else
      ACN(Val(x2)+4:FAC, FBN['Cantidad1'] )
    endif                 
  endif                 
  if EqStr(FBN['TipoTr2'],'RET')
    ACN(Val(x2):FAC  , -FBN['Cantidad1'])
    if FBN['Cantidad3']<>0
      ACN(Val(x2)+2:FAC, -FBN['Cantidad1'] - FBN['Cantidad3'])
      ACN(Val(x2)+4:FAC, FBN['Cantidad3'])
    else
      ACN(Val(x2)+4:FAC, -FBN['Cantidad1'])
    endif               
  endif               
  If EqStr(FBN['TipoTr2'],'MATCH') 
    ACN(g:FAC  , -FBN['Cantidad1'])
    ACN(h:FAC  , -FBN['Cantidad2'])
    ACN(k:FAC , -FBN['Cantidad1'])
    ACN(l:FAC , -FBN['Cantidad2'])
  endif               

  If Incluido(FBN['Mercado1'],Var('MERCTITULO'))
    ACT(m:FAC, FBN['NrTrans'])
    ACLT(m:FAC, FBN['NrTrans'])
  Else
    ACT(m:fac,FBN['NrTransRef1'])
    ACLT(m:fac,FBN['NrTransRef1'])
    ACD(n:fac,FBN['Fecha3'])
  Endif
  ACT(o:fac,FBN['NrOperacionRef1'])
  If Eqstr(Copy(FBN['NrOperacionRef1'],1,2),'VT')
    ACLT(o:fac,FBN['NrOperacionRef1'])
  Else
    ACLO(o:fac,FBN['NrOperacionRef1'])
  Endif
  SetFont(c:FAC..o:FAC,1)
proximo

FormatoCeldas(g:Val(w1)+8..l:FAC,Exe('F2'))

ACO(1,8)
ACO(2,7)
ACO(3,7)
ACO(4,4)
ACO(5,5)
ACO(6,7)
ACO(7,10)
ACO(8,10)
ACO(9,10)
ACO(10,10)
ACO(11,10)
ACO(12,10)

Impresion(1,2)
SetPrintFit(3,83)
SetFilaActual(FAC+2)
ACT(a:FAC, 'Fin del informe')
SetFont(a:FAC, 2)
AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))
LimitesVision(o:FAC)
RangoTitulo(a:1..o:FAC, Val(w1)+7)
