   ACT(da:1, TRIM(MIRT(Dialogo.String1))) 
*--  Select
SQL.ADD(" Select Codigo, Nombre, Numero, Cliente, Comitente, CBU, Alias2, Alias3, Alias5,Alias6, Alias7, TipoCuenta, Pagadora, CtaPrincipal, Especies ")
SQL.ADD(" from "~DBO~".CUENTAS ") 
SQL.ADD("   where Comitente = Comitente ")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD("and Cliente ='"~Dialogo.Cliente1~"' ")
Endif
If NoVacio(Dialogo.Cliente2)
   SQL.ADD("and Comitente ='"~Dialogo.Cliente2~"' ")
Endif
If NoVacio(Dialogo.String1)
   SQL.ADD("and Alias3 like '"~val(da:1)~"%' ")
Endif
SQL.ADD("order by Cliente, Comitente, Codigo")
acn(z3,0)
acn(z2,0)
ACN(FI:1, fac+1)
