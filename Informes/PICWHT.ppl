act(f:fac+1,'Amount')
act(g:fac,  'Rate')
act(h:fac,  'Interest')
act(i:fac,  'USD')
act(i:fac+1, 'Amount')
act(j:fac,  'FX Rate')
act(k:fac,  'Local Curr.')
act(k:fac+1,'Amount')

AlinearCeldas(f:fac..k:fac+1,'D')
AgregarMarco(a:fac..k:fac+1,2,0,RGB(254,228,126))
SetFont(a:fac..k:fac,2)
SetFont(a:fac+1..k:fac+1,2)

SQL.ADD("Select O.FechaOp, O.Plazo, O.FechaPrecan, O.FechaVto, O.Cantidad, O.Precio1, O.TotalRetenciones, C.RazonSocial, O.TotalIntereses ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C where O.FechaPrecan >0  and O.FechaPrecan >='"~IdxDate(Dialogo.Fecha1)~"'         ")
SQL.ADD("and O.FechaPrecan <= '"~IdxDate(Dialogo.Fecha2)~"' and O.TipoOp = 'MMPICO' and O.Cliente1 = C.Codigo                             ")
SQL.ADD("union ")
SQL.ADD("Select O.FechaOp, O.Plazo, O.FechaPrecan, O.FechaVto, O.Cantidad, O.Precio1, O.TotalRetenciones, C.RazonSocial, O.TotalIntereses ")
SQL.ADD("from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C where O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' and O.TipoOp = 'MMPICO' and  O.Cliente1 = C.Codigo   ")
SQL.ADD("and O.FechaVto <= '"~IdxDate(Dialogo.Fecha2)~"' and (O.FechaPrecan = 0 or O.FechaPrecan is null)                                 ")


SetFilaActual(fac+1)
acn(w3,fac)

Recorrer SQL
  act(a:fac, '8935')
  act(b:fac, FBN['RazonSocial'])
  acd(c:fac, FBN['FechaOp'])
  acn(d:fac, FBN['Plazo'])  
  if FBN['FechaPrecan']>0
    acd(e:fac, FBN['FechaPrecan'])
  else
    acd(e:fac, FBN['FechaVto'])
  endif
  acn(f:fac, FBN['Cantidad'])
  acn(g:fac, FBN['Precio1'])
  acn(h:fac, FBN['TotalIntereses'])
  acn(i:fac, FBN['TotalRetenciones'])
  acn(j:fac, Cotizacion('USD',,,,Dialogo.Fecha2,1))  
  acn(k:fac, Val(i:fac)*Val(j:fac))
  if FBN['FechaPrecan']>0
    act(l:fac,'Prec.')  
  endif    
  scn(z1,Val(i:fac))
  scn(z2,Val(k:fac))  
