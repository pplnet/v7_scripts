* DELIAC Detalle de Limites Posicion Activos
ModoReproceso(SinDialogo)
CrearDialogo
  Fecha1    : 'Fecha'   ;;;;;;;;;FSys
  Lista1    : 'TipoOp'  ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".TIPOSOPERACION ");
  Vehiculo1 : 'Vehiculo';;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
FinDialogo

if Not Ok
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)

ACT(g:2,'Fecha : '~Var('FECHASYS'))
SetFont(g:2..g:2,1)

ACT(a:FAC,"Detalle de Limites Posicion Activos")
SetFont(a:fac..a:fac,3)

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC+1, 'Fecha : '~Dialogo.Fecha1)

If NoVacio(Dialogo.Vehiculo1)
   ACT(a:FAC+3, 'Vehiculo : '~Dialogo.Vehiculo1)
Else
   ACT(a:FAC+3, 'Vehiculo : Todos')
EndIf
ACT(a:FAC+4, 'Operaciones : '~Dialogo.Lista1)

SetFont(a:fac..N:FAC+5,2)

SetFilaActual(fac+7)

ACT(a:FAC, 'Numero Op.')
ACT(b:FAC, 'Tipo Op.')
ACT(c:FAC, 'F.Carga')
ACT(d:FAC, 'F.Inicio')
ACT(e:FAC, 'F.Concert.')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Capital')
ACT(i:FAC, 'Plazo')
ACT(j:FAC, 'F.Vto.')
ACT(k:FAC, 'Entidad')
ACT(l:FAC, 'Cotizacion')
ACT(m:FAC, 'Valor')

SetFont(a:fac..m:FAC,2)
AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))

SQL.ADD("Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1,")
SQL.ADD("O.Especie,C.Cantidad1 Cantidad,C.Plazo1 Plazo,C.Fecha2 FechaVto,O.Precio1,O.Cliente1,'Depositos a Plazo' Tipo")
SQL.ADD("from "~DBO~".CUOTAS C, "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.NrOperacion = C.NrOperacion ")
SQL.ADD(" and O.TipoOp In ('MMCPM') ")
SQL.ADD(" and C.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and C.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" Union All ")
SQL.ADD("Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1,")
SQL.ADD("O.Especie,O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.Cliente1,'Depositos a Plazo' Tipo ")
SQL.ADD("from "~DBO~".OPERACIONES  O ")
SQL.ADD("where O.TipoOp In ('MMCP','MMDCA','MMCCR','MMO') ")
SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
if NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.TipoOp in ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
If Incluido('MMCP',Dialogo.Lista1)
   SQL.ADD(" Union All ")
   *- FXVT 
   SQL.ADD("Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1,")
   SQL.ADD("O.Especie,-O.Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.Cliente1,'Foreing Exchange' Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('FXVT') ")
   SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD(" Union All ")
   SQL.ADD("Select O.NrOperacion,O.TipoOp,O.FechaCargaSys,O.FechaOp,O.FechaOp2,O.Vehiculo1,")
   SQL.ADD("O.ContraEspecie Especie,O.TotalBrutoCli1 Cantidad,O.Plazo,O.FechaVto,O.Precio1,O.Cliente1,'Foreing Exchange' Tipo ")
   SQL.ADD(" from "~DBO~".OPERACIONES  O ")
   SQL.ADD("where O.TipoOp In ('FXVT') ")
   SQL.ADD(" and O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
   SQL.ADD(" and O.FechaOp  <= '"~IdxDate(Dialogo.Fecha1)~"' ")
   if NoVacio(Dialogo.Vehiculo1)
      SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
   endif
   SQL.ADD("order by O.Especie,O.TipoOp Desc ")
EndIf
acn(x1,fac)
acn(x2,fac)

Recorrer SQL  

  *- Corte por Especie y Tipo 
  IF Not EqStr(FBN['Tipo'],val(z1)) o Not EqStr(FBN['Especie'],val(z2))
     If val(z11)<>0
        ACT(a:fac,'  SubTotal '~val(z1))
        ACN(m:fac, val(z11))
        acn(z11,0)
        SetFont(a:FAC..n:FAC,2)
        FormatoCeldas(m:fac..m:fac,Exe('F2'))
        AgregarMarco(a:FAC..m:FAC,1,0)
        ifa
        ifa
     EndIf
     If Not EqStr(FBN['Especie'],val(z2)) y val(z12)<>0
        dfa
        ACT(a:fac,'Total '~val(z2))
        ACN(m:fac, val(z12))
        SetFont(a:FAC..n:FAC,2)
        FormatoCeldas(m:fac..m:fac,Exe('F2'))
        AgregarMarco(a:FAC..m:FAC,1,0,Exe('COLOR6'))
        AgregarMarco(a:Val(x1)..m:FAC,2,0)
        acn(z12,0)
        ifa
        ifa
     EndIf

     If Not EqStr(FBN['Especie'],val(z2))
        act(z2,FBN['Especie']) 
        act(a:fac,val(z2)~' '~BuscarCampo('ESPECIES','Nombre','Codigo',val(z2)) )
        SetFont(a:FAC..n:FAC,2)
        AgregarMarco(a:FAC..m:FAC,1,0,Exe('COLOR6'))
        ACN(x1, fac)
        ifa
        act(z1,FBN['Tipo']) 
        act(a:fac,'  '~FBN['Tipo'])
        AgregarMarco(a:FAC..m:FAC,1,0)
        SetFont(a:FAC..n:FAC,2)
        ifa
     EndIf

     If Not EqStr(FBN['Tipo'],val(z1))
        act(z1,FBN['Tipo']) 
        act(a:fac,'  '~FBN['Tipo'])
        AgregarMarco(a:FAC..m:FAC,1,0)
        SetFont(a:FAC..n:FAC,2)
        ifa
     EndIf
  EndIf

  ACT(a:FAC, FBN['NrOperacion'])
  ACLO(a:FAC, FBN['NrOperacion'])
  ACT(b:FAC, FBN['TipoOp']~'  '~BuscarCampo('TiposOperacion','Nombre','Codigo',FBN['TipoOp']))
  ACD(c:FAC, FBN['FechaCargaSys'])
  ACD(d:FAC, FBN['FechaOp'])
  ACD(e:FAC, FBN['FechaOp2'])
  ACT(f:FAC, FBN['Vehiculo1'])
  ACT(g:FAC, FBN['Especie'])
  ACN(h:FAC, FBN['Cantidad'])
  ACN(i:FAC, FBN['Plazo'])
  ACD(j:FAC, FBN['FechaVto'])
  ACT(k:FAC, FBN['Cliente1'])
  ACN(l:FAC, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,'USD'))
  ACN(m:FAC, val(h:fac)*val(l:fac))

  scn(z11,val(m:fac))
  scn(z12,val(m:fac))

  If Not Incluido(FBN['TipoOp'],'FXVT')
     scn(z13,val(m:fac))
  EndIf

  SetFont(a:FAC..n:FAC,1)
  FormatoCeldas(i:fac..i:fac,"0")
  FormatoCeldas(h:fac..h:fac,Exe('F2'))
  FormatoCeldas(l:fac..l:fac,Exe('F7'))
Proximo
Ifa

ACT(a:fac,'  SubTotal '~val(z1))
ACN(m:fac, val(z11))
acn(z11,0)
SetFont(a:FAC..n:FAC,2)
FormatoCeldas(m:fac..m:fac,Exe('F2'))
AgregarMarco(a:FAC..m:FAC,1,0)
ifa

ACT(a:fac,'Total '~val(z2))
ACN(m:fac, val(z12))
SetFont(a:FAC..n:FAC,2)
FormatoCeldas(m:fac..m:fac,Exe('F2'))
AgregarMarco(a:FAC..m:FAC,1,0,Exe('COLOR6'))
AgregarMarco(a:Val(x1)..m:FAC,2,0)
acn(z12,0)
ifa

ifa
ACT(a:fac,'TOTAL DE Depositos a Plazo')
ACN(m:fac, val(z13))
SetFont(a:FAC..m:FAC,3)
FormatoCeldas(m:fac..m:fac,Exe('F2'))
AgregarMarco(a:FAC..m:FAC,2,0,Exe('COLOR'))
ifa

SetFont(a:FAC..n:FAC,2)
FormatoCeldas(h:fac..l:fac,Exe('F2'))

