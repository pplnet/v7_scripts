HojaVisible(SI)
ModoReproceso(SinDialogo)
CrearDialogo
   Radio1    : 'Tipo|Extrabursatil|Bursatil'   ;1;1;;;;;;;0;
   TipoOp1   : 'Tipo Op.'                      ;2;1;;;;;;;;;IIF(Dialogo.Radio1=0 ,Var('OPEREXTBUR'),Var('OPERBUR'));NO;
   Especie1  : 'ContraEspecie'                 ;3;1;;;;Vacio(Dialogo.Especie1) o DESCIENDEDEESPECIE(Dialogo.Especie1,'MONEDA');'Debe ingresar una ContraEspecie';NO;;;Var('LISCONTRA');NO;
   Fecha1    : 'Fecha Op.'                     ;4;1;;;;;;;Fsys;
   Fecha3    : 'Fecha Carga'                   ;5;1;;;;;;;Fsys; 
   Fecha2    : 'Fecha Liq.'                    ;6;1;;;;
FinDialogo

If Not Ok
   Cancelar
Endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

ACT(a1, 'Detalle de Operaciones de Compra/Venta')
SetFont(a1..a1, 3)

IF Dialogo.Radio1=0
   ACT(a3, 'Tipo: Extrabursatiles')
else
   ACT(a3, 'Tipo: Bursatiles')
Endif

*-- Busco el nombre de la Operacion
SQL.ADD("SELECT * FROM "~DBO~".TIPOSOPERACION ")
SQL.ADD("WHERE Codigo = '"~Dialogo.TipoOp1~"' ")

Recorrer SQL
   ACT(c3, 'Tipo Op.: '~Dialogo.TipoOp1~' - '~FBN['Nombre'] )
Proximo

If NoVacio(Dialogo.Especie1)
   *-- Busco el nombre de la contraespecie
   SQL.ADD("SELECT * FROM "~DBO~".ESPECIES ")
   SQL.ADD("WHERE Codigo = '"~Dialogo.Especie1~"' ")

   Recorrer SQL
     ACT(e3, 'ContraEspecie: '~Dialogo.Especie1~' - '~FBN['Nombre'])
   Proximo
EndIf

*-- Coloca la fecha que ingreso como parametro
If NoVacio(IdxDate(Dialogo.Fecha1))
   ACT(a4, 'Fecha Op.: '~Dialogo.Fecha1)
Endif

If NoVacio(IdxDate(Dialogo.Fecha3))
   ACT(a5, 'Fecha Carga.: '~Dialogo.Fecha3)
Endif

If NoVacio(IdxDate(Dialogo.Fecha2))
   ACT(c4, 'Fecha Vto.: '~Dialogo.Fecha2)
Endif

If Dialogo.Fecha2>0
   ACT(e4, 'Plazo: '~Fstr((Dialogo.Fecha2-Dialogo.Fecha1),0,0))
EndIf


SetFont(a3..e5, 2)

SetFilaActual(7)

*-- Encabezado
ACT(a:FAC, 'Nr.Minuta ')
ACT(b:FAC, 'Fecha Op.')
ACT(c:FAC, 'Fecha Carga')
ACT(d:FAC, 'Hora Op.')
ACT(e:FAC, 'Fecha Liq')
ACT(f:FAC, 'Cliente')
ACT(g:FAC, 'Especie')
ACT(h:FAC, 'Precio')
ACT(i:FAC, 'Cant. (V/N)')
ACT(j:FAC, 'Imp.Bruto')
ACT(k:FAC, 'Aranc./Der.')
ACT(l:FAC, 'Imp. Neto')
ACT(m:FAC, 'Cuenta')
ACT(n:FAC, 'Agente')
ACT(o:FAC, 'C.Cust')
ACT(p:FAC, 'Operador')
ACT(q:FAC, 'Instancia')
ACT(r:fac, 'Pase')

SEtFont(a:FAC..r:FAC, 2)
AgregarMarco(a:FAC..r:FAC,2,0,Exe('COLOR6'))
AlinearCeldas(a:FAC..r:FAC,'C')

If Dialogo.Radio1=0
   *-- Realizo la seleccion de la operacion segun los parametros dados.
   SQL.ADD("SELECT Distinct  O.*,I.NrInstancia,I.Nombre, Convert(Char(12), O.FechaCarga, 14) as Hora, E.CodMAEContado, Cl.RazonSocial ")
else
   *-- Realizo la seleccion de la operacion segun los parametros dados.
   SQL.ADD("SELECT Distinct  O.*,I.NrInstancia,I.Nombre, Convert(Char(12), O.FechaCarga, 14) as Hora, E.CodMAEContado, Cl.RazonSocial ")
Endif
SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E,  "~DBO~".CLIENTES Cl, "~DBO~".OPERACIONESBITS B, "~DBO~".INSTANCIAS I ")
SQL.ADD("WHERE E.Codigo=O.Especie and O.Cliente1=Cl.Codigo ")
SQL.ADD("and B.NrOperacion = O.NrOperacion ") 
SQL.ADD("and B.Valor = '1'") 
SQL.ADD("and I.NrInstancia = B.NrBit ")
SQL.ADD("and I.Tabla = 'OPERACIONES' ")
*--- No Lista las anuladas ---*
SQL.ADD("and B.NrBit<>30 ")

*--Selecciono la fecha
If NoVacio(IdxDate(Dialogo.Fecha1))
   SQL.ADD(" and O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"' ")
Endif

If NoVacio(IdxDate(Dialogo.Fecha2))
   SQL.ADD(" and O.FechaVto = '"~IdxDate(Dialogo.Fecha2)~"' ")
Endif

*-- Selecciono operacion extrabursatil
If Dialogo.Radio1 = 0 
   If NoVacio(IdxDate(Dialogo.Fecha3))
      SQL.ADD(" and O.FechaCarga > '"~IdxDate(Dialogo.Fecha3)~"' ")
      SQL.ADD(" and O.FechaCarga < '"~IdxDate(Dialogo.Fecha3+1)~"' ")
   Endif
   *- Una operacion
   If NoVacio(Dialogo.TipoOp1)
      SQL.ADD("and TipoOp In ("~Pipe2Comillas(Dialogo.TipoOp1)~") ")
   else
      *- Todas la operaciones
      SQL.ADD(" and TipoOp In ('TIC','TIV','TIFC','TIFV') ")
   Endif 
Endif

*-- Selecciono operacion bursatil
If Dialogo.Radio1 = 1 
   If NoVacio(IdxDate(Dialogo.Fecha3))
      SQL.ADD(" and O.FechaCargaSys >= '"~IdxDate(Dialogo.Fecha3)~"' ")
      SQL.ADD(" and O.FechaCargaSys < '"~IdxDate(Dialogo.Fecha3+1)~"' ")
   Endif
   *-- Una operacion
   If NoVacio(Dialogo.TipoOp1)
      SQL.ADD("and TipoOp In ("~Pipe2Comillas(Dialogo.TipoOp1)~") ")
   else
      *- Todas la operaciones
      SQL.ADD(" and TipoOp In ('CTC','CTP','VTC','VTP') ")
   Endif 
Endif

*-- Selecciono la ContraEspecie
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and ContraEspecie In ("~Pipe2Comillas(Dialogo.Especie1)~") ")
else
   SQL.ADD(" and ContraEspecie In  ('ARP', 'USD') ")
Endif

SQL.ADD("ORDER BY TipoOp,ContraEspecie,Especie,O.NrOperacion ")


Recorrer SQL
*- Contenido de celdas:
*-                       z1 = Tipo Operacion
*-                       z2 = ContraEspecie
*-                       z3 = Plazo
*-                       z4 = Fecha Operacion
*-                       z5 = Fecha Liquidacion
*-                       z6 = Total Imp.Bruto
*-                       z7 = Total Deducciones
*-                       z8 = Total Imp. FP
*-                       z9 = Cant. Opers.
*-                      Z10 = Total Cant. (V/N) 
*-              z26,z27,z28,z29,z30 = Flags 

   If Not EqStr(Val(z20),FBN['NrOperacion'])
      ACT(z20,FBN['NrOperacion'])
      If Not EqStr(FBN['TipoOp'],val(z1)) o Not EqStr(FBN['Especie'],val(z2))   
      
          *-- Total de Cantidad (V/N) por Especie
          If Not EqStr(FBN['TipoOp'],val(z1)) o Not EqStr(FBN['Especie'],val(z2)) 
             if Val(z29) <> 0
                act(d:fac,"Total por Especie "~Val(z2))
                acn(i:fac,Val(z10))
                setfont(a:fac..r:fac,2)
                acn(z10,0)
                ifa
             else
                acn(z29,1)
             endif 
             act(z2,FBN['Especie'])
          Endif 

         *-- Corte por ContraEspecie
         If Not EqStr(FBN['ContraEspecie'],Val(z19)) o Not EqStr(FBN['TipoOp'],Val(z1))
             if Val(z31) <> 0
                *-- Totales generales
                act(d:fac,"TOTAL "~Val(z19))
                acn(j:fac, Val(z6))
                acn(k:fac, Val(z7))
                acn(l:fac, Val(z8))
                setfont(a:fac..r:fac,2)
                ACN(z6,0)
                ACN(z7,0)
                ACN(z8,0)
                ifa
                ifa
             else
                 ACN(z31,1)
             endif

             *-- Corte por Tipo Operacion
             If Not EqStr(FBN['TipoOp'],Val(z1))
                   *-- Rotulo de Tipo Operacion
                   act(a:fac,'Tipo Operacion: '~FBN['TipoOp'])
                   AgregarMarco(a:fac..b:fac,2,0,EXE('COLOR8'))
                   SetFont(a:fac..b:fac,2)
                   ACT(z1,FBN['TipoOp'])
                   ifa
             endif
             act(a:fac,'ContraEspecie: '~FBN['ContraEspecie'])
             SetFont(a:fac..r:fac,2)
             act(z19,FBN['ContraEspecie'])
         EndIf
         IFA
      EndIf     
      
    *-- Linea de Detalle   
    act(a:fac,FBN['NrOperacion'])
    aclo(a:fac,FBN['NrOperacion'])
    act(b:fac, FBN['FechaOp'])
    act(c:fac, FBN['FechaCarga'])
    act(d:fac,FBN['Hora'])
    act(e:fac, FBN['FechaVto'])
    AlinearCeldas(b:fac..e:fac,'C')
    act(f:fac,FBN['Cliente1']~'-'~COPY(FBN('RazonSocial'),1,25))
    if NoVacio(fbn('CodMAEContado'))
     act(g:fac,FBN['Especie']~'-'~FBN['CodMAEContado'])
    else
     act(g:fac,FBN['Especie'])
    endif
    acn(h:fac,FBN['Precio1'])
    FormatoCeldas(g:fac..g:fac,EXE('F7'))
    acn(i:fac,FBN['Cantidad'])
    act(m:fac, FBN['Cuenta1'])
    act(n:fac, FBN['Cliente2'])
    act(o:fac, FBN['Mercado'])
    act(p:fac, FBN['Operador'])
    act(r:fac,FBN['OperacionRef'])
    aclo(r:fac,FBN['OperacionRef'])
    
    ** Importe Bruto **
    if Incluido(FBN['TipoOp'],'TIC|TIV|TIFC|TIFV|')
     ACN(j:fac,FBN['TotalBrutoCli1'])
    else
     ACN(j:fac,FBN['TotalNetoCli1'])
    endif
    *******************

    *-- Calculo de Deducciones 
    If EqStr(FBN['TipoOp'],'TIC') o EqStr(FBN['TipoOp'],'TIV') o EqStr(FBN['TipoOp'],'TIFC') o EqStr(FBN['TipoOp'],'TIFV')
       *acn(z10, Val(g:fac)*FBN['Comision']/100)
       *acn(j:fac, FBN['PorComision'])
       acn(k:fac, 0)
    else
       acn(z11, FBN['TotalAux3'])
       scn(z11, FBN['TotalIva'])
       acn(k:fac,Val(z11))
    endif  
    
    *-- Importe Neto
    If EqStr(FBN['TipoOp'],'TIC') o EqStr(FBN['TipoOp'],'TIV') o EqStr(FBN['TipoOp'],'TIFC') o EqStr(FBN['TipoOp'],'TIFV') 
       acn(l:fac, FBN['TotalNetoCli1'])
    else   
       If EqStr(FBN['TipoOp'],'VTC') o EqStr(FBN['TipoOp'],'VTP') 
          acn(z12, -FBN['TotalAux3'])
          scn(z12, -FBN['TotalIva'])
          scn(z12, FBN['TotalNetoCli1'])
          acn(l:fac, Val(z12))
       else
          acn(z12, FBN['TotalAux3'])
          scn(z12, FBN['TotalIva'])
          acn(z13, FBN['TotalNetoCli1'])
**JUAN          scn(z13, -Val(z12))
          scn(z13, Val(z12))
          acn(l:fac, Val(z13))
       Endif
    Endif

    SetFont(a:fac..o:FAC,1)    
    *- Totales
    scn(z6,Val(j:fac)) 
    scn(z7,Val(k:fac))
    scn(z8,Val(l:fac))
    scn(z9,1)
    scn(z10,Val(i:fac))
  endif
    act(q:fac, FBN['NrINstancia']~' '~FBN['Nombre'])
    ColorCeldas(q:fac,clBlue)
Proximo

*-- Proceso para el ultimo registro
SetFilaActual(fac+1)
if Val(z29) <> 0
   act(d:fac,"Total por Especie "~Val(z2))
   acn(i:fac,Val(z10))
   setfont(a:fac..r:fac,2)
   acn(z10,0)
   ifa
else
   acn(z29,1)
endif  
*-- Totales generales
act(d:fac,"TOTAL "~Val(z19))
acn(j:fac, Val(z6))
acn(k:fac, Val(z7))
acn(l:fac, Val(z8))
setfont(a:fac..l:fac,2)

act(a:fac+2, 'CANTIDAD DE OPERACIONES PROCESADAS:')
acn(d:fac+2, Val(z9))
FormatoCeldas(d:fac+2, EXE('FE'))
SetFont(a:fac..l:fac,2)
SetFont(a:fac+2..l:fac+2,2) 

*-- Ajuste de celdas
ACO( 1, 8)
ACO( 2, 7)
ACO( 3,12)
ACO( 4, 8)
ACO( 5, 7)
ACO( 6,30)
ACO( 7, 8)
ACO( 8, 8)
ACO( 9, 8)
ACO(10, 8)
ACO(11, 8)
ACO(12, 8)
ACO(13, 7)
ACO(14, 7)
ACO(15, 5)
ACO(16, 8)
ACO(17,15)
ACO(18, 8)

RangoTitulo(a1..r6, 5)
SetMargins(0,0,0,2)
Impresion(1,2)
SetPrintFit(3,57)
SetFilaActual(FAC+4)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC,2)
LimitesVision(r:fac)

