CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")

SetFilaActual(4)
ACN(w1,FAC)
ACT(a:FAC, 'Archivo de Mercados')
ACT(a:FAC+2,'Codigo')
ACT(b:FAC+2,'Descripcion')
ACT(c:FAC+2,'Liquida Moneda,Titulo o Ambos')
AgregarMarco(a:FAC+2..d:FAC+2,2,0,Exe('COLOR'))
SetFont(a:FAC..c:FAC+2,2)

SetFilaActual(FAC+2)

SQL.ADD("Select * From "~DBO~".MERCADOS")
recorrer SQL
  SCN(w2,1)
  ACT(a:FAC, FBN('Codigo'))
  ACT(b:FAC, FBN('Descripcion'))
  ACT(c:FAC, FBN('Observaciones'))
proximo

AgregarMarco(a:Val(w1)+3..d:FAC+1,1)
SetFont(a:Val(w1)+3..c:FAC,1)

SetFilaActual(FAC+2)
ACT(a:FAC, 'Cantidad de Registros: '~FStr(Val(w2),1,0))
SetFont(a:FAC, 2)

ACO(2,20)
ACO(3,30)

Impresion(1,1)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DEL LISTADO')
SetFont(a:FAC, 2)
AgregarBMP(a1,Exe('LOGO'),60)
SetFont(c:3,2)
AlinearCeldas(c:3,'D')
LimitesVision(c:FAC)
RangoTitulo(a:1..c:FAC,Val(w1)+2)
