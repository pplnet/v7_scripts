CrearDialogo
  Fecha1      : 'Fecha Desde' ; 1;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha Desde';NO;FSys
  Fecha2      : 'Fecha Hasta' ; 2;1;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar una Fecha Hasta';NO;FSys
  Cliente1    : 'Cliente'     ; 3;1;;;;;;
  Radio1      : 'Estado|Pendientes|Recibidas|Todas'       ;;;;;;;;;0
FinDialogo
If Not OK
  Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)
ACT(a:FAC, 'Listado de Operaciones con DJ')
SetFont(a:fac..b:fac,3)

SetFilaActual(fac+2)
ACT(a:fac,'Fecha Op. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha1)~' hasta el '~Fecha(Dialogo.Fecha2))
SetFont(a:fac..a:fac,1)
SetFont(b:fac..b:fac,2)

IFA
If NoVacio(Dialogo.Cliente1)
   ACT(a:fac,'Cliente:')
   ACT(b:fac,'('~Dialogo.Cliente1~') '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:fac,'Clientes:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..a:fac,1)
SetFont(b:fac..b:fac,2)

IFA
ACT(a:fac,'Estado:')
If Dialogo.Radio1=0
  ACT(b:fac,'Pendientes')
endif
If Dialogo.Radio1=1
  ACT(b:fac,'Recibidas')
endif
If Dialogo.Radio1=2
  ACT(b:fac,'Todos')
endif
SetFont(a:fac..a:fac,1)
SetFont(b:fac..b:fac,2)

SetFilaActual(fac+2)
ACT(a:fac,'NrOpracion')
ACT(b:fac,'TipoOp')
ACT(c:fac,'FechaOp')
ACT(d:fac,'Cliente')
ACT(e:fac,'Especie')
ACT(f:fac,'Cantidad')
ACT(g:fac,'Moneda')
ACT(h:fac,'Mercado')
ACT(i:fac,'Requiere')
ACT(j:fac,'Codigo')
ACT(k:FAC, 'Emitida')
ACT(l:FAC, 'Presen.')
ACT(m:FAC, 'F.Pres')
ACT(n:FAC, 'Observac')
SetFont(a:fac..n:fac,2)
AlinearCeldas(c:fac..c:fac,'D')
AlinearCeldas(f:fac..f:fac,'D')
AlinearCeldas(m:fac..m:fac,'D')
AgregarMarco(a:FAC..n:FAC,1,0,Exe('COLOR6'))

SQL.ADD(" Select * ")
SQL.ADD("From "~DBO~".OPERACIONES ")
SQL.ADD("where FechaOp between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2))
if NoVacio(Dialogo.Cliente1)
  SQL.ADD(" and Cliente1 = '"~Dialogo.Cliente1~"' ")  
endif
SQL.ADD(" and DDJJRequiere = 'SI' ")  
if Dialogo.Radio1=0
  SQL.ADD(" and isNull(DDJJPresentada,'NO') <> 'SI' ")  
endif
if Dialogo.Radio1=1
  SQL.ADD(" and isNull(DDJJPresentada,'NO') = 'SI' ")  
endif
SQL.ADD(" order by NrOperacion ")  
Recorrer SQL
  SCN(x:1, 1)
  ACT(a:FAC, fbn('NrOperacion'))
  ACLO(a:fac, FBN['NrOperacion'])
  ACT(b:FAC, fbn('TipoOp'))
  ACD(c:FAC, fbn('FechaOp'))
  ACT(d:FAC, fbn('Cliente1'))
  ACT(e:FAC, fbn('Especie'))
  ACN(f:FAC, fbn('Cantidad'))
  ACT(g:FAC, fbn('ContraEspecie'))
  ACT(h:FAC, fbn('Mercado'))
  ACT(i:FAC, fbn('DDJJRequiere'))
  ACT(j:FAC, fbn('DDJJCodigo'))
  ACT(k:FAC, fbn('DDJJEmitida'))
  ACT(l:FAC, fbn('DDJJPresentada'))
  if fbn('DDJJFechaPres')>0
    ACD(m:FAC, fbn('DDJJFechaPres'))
  endif
  ACT(n:FAC, fbn('DDJJObservac'))
  SetFont(a:fac..n:fac,1)
proximo

if Val(x:1)=0
  SetFilaActual(fac+2)
  ACT(a:FAC, 'No hay Opeaciones')
  SetFont(a:fac..n:fac,2)
endif

