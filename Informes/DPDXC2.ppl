   SQL.ADD("M.NrSaldo IN ("~Pipe2Comillas(Val(cr2))~") AND ")
   SQL.ADD("M.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("M.Especie = E.Codigo AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("T.Fecha1 = '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("(T.TipoTr2 IN ('PDIVID') ) ")
Endif
* Compras a liquidar a Fecha1 TIDE/TICT FechaOp=Fys TIPO/TICO FechaVto=Fys 
If Dialogo.Cantidad1 = 5
   SQL.ADD("SELECT O.NrOperacion, O.Cupon1 Cupon, O.TipoOp, O.Cantidad Cantidad2, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses,  ")
   SQL.ADD("O.FechaOp, O.FechaVto, O.ContraEspecie,O.PaseCB ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE   O.NrOperacion=B.NrOperacion and ")
   SQL.ADD(" B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD(" O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD(" (O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND ")
   SQL.ADD(" O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD(" O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD(" O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD(" O.TipoOp IN ('TIC') AND ")
   SQL.ADD(" (O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT O.NrOperacion, O.Cupon1 Cupon, O.TipoOp, O.Cantidad Cantidad2, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.TotalNetoCli1+O.TotalAux3+O.TotalIVA TotalNetoCli1, ")
   SQL.ADD("O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses, O.FechaOp, O.FechaVto, O.ContraEspecie,O.PaseCB ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")  
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("(O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND ")
   SQL.ADD("O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("O.FechaVto = '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("O.TipoOp IN ('CTC','CTP') AND ")
   SQL.ADD("(O.PaseCB = '0' OR O.PaseCB IS NULL) ")
   ACT(co1,"((TipoOp In ('TIDE','TICT') and O.FechaOp='"~IdxDate(Dialogo.Fecha1)~"') OR (TipoOp In ('TIPO','TICO') and O.FechaVto='"~IdxDate(Dialogo.Fecha1)~"')) ")
   (.'TIPRESSEL'.)
Endif
* Ventas a liquidar a Fecha1
If Dialogo.Cantidad1 = 6
   SQL.ADD("SELECT O.NrOperacion, O.Cupon1 Cupon, O.TipoOp, O.Cantidad Cantidad2, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses,  ")
   SQL.ADD("O.FechaOp, O.FechaVto, O.ContraEspecie,O.PaseCB ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
