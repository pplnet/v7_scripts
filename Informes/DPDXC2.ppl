* Prestamos y Depositos Concertados a la Fecha1 o que vencen despues de fecha1
IF Dialogo.Cantidad1 = 9 O Dialogo.Cantidad1 = 15
   SQL.ADD("SELECT O.NrOperacion, O.Cupon1 Cupon, O.TipoOp, O.Cantidad Cantidad2, O.Cantidad Cantidad, ")
   SQL.ADD("O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses,  ")
   SQL.ADD("O.FechaOp, O.FechaVto, O.ContraEspecie, E.InteresesC,O.PaseCB ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B, "~DBO~".ESPECIES E ")
   SQL.ADD("WHERE   O.NrOperacion = B.NrOperacion and ")
   SQL.ADD(" B.Valor       = 0 and B.NrBit in ('30') and ")
   SQL.ADD(" O.Especie     = E.Codigo AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD(" O.Especie     = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD(" O.Cartera     = '"~Fstr(Dialogo.Radio1,0,0)~"' AND ")
   SQL.ADD(" O.Vehiculo1   = '"~Dialogo.Vehiculo1~"' AND ")
   IF Dialogo.Cantidad1 = 9
       SQL.ADD(" O.FechaOp    = '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   ELSE
       SQL.ADD(" O.FechaOp    <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
       SQL.ADD(" O.FechaVto    > '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   ENDIF
   SQL.ADD(" O.TipoOp IN ('TIDE','TIPO', 'TICT', 'TICO') ")
Endif

* Compras y Ventas Futuras
(.'POSDISFUT'.)

* Pases Activos no Liq. a la Fecha1
If Dialogo.Cantidad1 = 12
   SQL.ADD("SELECT O.NrOperacion, O.Cupon1 Cupon, O.TipoOp, O.Cantidad Cantidad2, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses,  ")
   SQL.ADD("O.FechaOp, O.FechaVto, O.ContraEspecie,O.PaseCB ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("(O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND")
   SQL.ADD("O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("O.TipoOp IN ('TIFV') AND ")
   SQL.ADD("O.PaseCB = 1 ")
Endif
* Pases Pasivos no Concertados a la Fecha1
If Dialogo.Cantidad1 = 13
   SQL.ADD("SELECT O.NrOperacion, O.Cupon1 Cupon, O.TipoOp, O.Cantidad Cantidad2, Cantidad = CASE O.Cartera WHEN -1 THEN "~VAl(az1)~" ELSE O.Cantidad END, O.TotalNetoCli1, O.TotalBrutoCli1, O.TotalDerechos, O.TotalIntereses,  ")
   SQL.ADD("O.FechaOp, O.FechaVto, O.ContraEspecie,O.PaseCB ")
   SQL.ADD("FROM   "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B  ")
   SQL.ADD("WHERE  O.NrOperacion=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("O.Especie = '"~Dialogo.Especie1~"' AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" O.Cupon1 = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("(O.Cartera = '"~Fstr(Dialogo.Radio1,0,0)~"' OR (O.Cartera=-1 and "~Val(az1)~">0)) AND")
   SQL.ADD("O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("O.TipoOp IN ('TIFC') AND ")
   SQL.ADD("O.PaseCB = 1 ")
Endif

Recorrer SQL
  ** Porcentaje asignado a la cartera
  ACN(az2, FBN['Cantidad']/FBN['Cantidad2'] )

  * Indice para pasar un monto de una moneda a otra
  ACN(in1, CotizacionC(FBN['ContraEspecie'],,,,Dialogo.Fecha1,1,SI,Val(mn1)))

  If Incluido(fbn('TipoOp'), 'DTP|RTP|PDIVID')
     ACT(a:fac, fbn('NrOperacion'))
     ACLT(a:fac, fbn('NrOperacion')) 
  Else
     ACT(a:fac, fbn('NrOperacion'))
     ACLO(a:fac, fbn('NrOperacion'))
  Endif
  ACT(b:fac, fbn('TipoOp'))
  ACD(c:fac, fbn('FechaOp'))
  ACD(d:fac, fbn('FechaVto'))   
  ACN(e:fac, fbn('Cantidad'))

  *- Casos que restan a la posicion
  IF Incluido(FBN['TipoOp'], 'TIV|TIFV|') y FBN['FechaVto']=Dialogo.Fecha1 y FBN['PaseCB'] = 1
     ACN(e:fac, -fbn('Cantidad'))
  EndIf

  IF Incluido(FBN['TipoOp'], 'TIFC|') y FBN['FechaVto'] > Dialogo.Fecha1 y FBN['PaseCB'] = 1
     ACN(e:fac, -fbn('Cantidad'))
  EndIf
  ACN(f:fac, fbn('TotalBrutoCli1')*Val(az2))

  If Incluido(fbn('TipoOp'), 'TIC|TIV|CTP|VTP|TIBCRA|TIFC|TIFV')
     ACN(g:fac, fbn('TotalIntereses')*Val(az2))
  Else
     ACN(g:fac, fbn('TotalDerechos')*Val(az2))
  Endif

  ACN(h:fac, fbn('TotalNetoCli1')*Val(az2))

  **-- Resolucion 1585
  ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', Dialogo.Especie1))

  *-Valuacion para la fecha del informe  ca1: Cantidad VN  ca2: VR ca3: Valuacion
  acn(ca1,FBN['Cantidad'])
  acn(ca2,Round(val(ca1)*val(vr1),val(vr2)) )
  ACN(yw:1, val(ca1))

  (.'INTERESCLE'.)

  IF Incluido(Val(al4), '1585')
     ACN(ca3, val(ca2)*val(cc1)+(Val(zz1)*Val(cc1)))        
  Else
     ACN(ca3, val(ca2)*val(cc1)+Val(zz1))     
  Endif

  ACN(i:fac, val(ca3)*Val(az2) )
  SetFont(a:fac.. i:fac, 2)
  FormatoCeldas(e:fac..i:fac, Exe('F2'))
Proximo
ifa
ifa
