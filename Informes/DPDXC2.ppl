act(a:fac, 'Total ... ')
acn(e:fac, Sum(e:5..e:fac-1) )
acn(i:fac, Sum(i:5..i:fac-1) )
SetFont(a:fac.. i:fac, 1)
FormatoCeldas(e:fac..i:fac, Exe('F2'))
ifa
ACT(a:fac,'FIN DE LISTADO')
SetFont(a:fac, 1)
ACO(1, 7)
ACO(2, 5)
ACO(3, 6)
ACO(4, 6)
ACO(5, 8)
ACO(6, 8)
ACO(7, 8)
ACO(8, 8)
ACO(9, 8)
