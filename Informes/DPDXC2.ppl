   SQL.ADD("((T.TipoTr2 IN ('DTP') AND ")
   SQL.ADD("  T.Cliente1 = '"~Dialogo.Vehiculo1~"') OR ")
   SQL.ADD(" (T.TipoTr2 IN ('RTP') AND ")
   SQL.ADD("  T.Cliente2 = '"~Dialogo.Vehiculo1~"')) AND ")
   SQL.ADD("T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.NrTrans NrOperacion, M.Cupon, T.TipoTr2 TipoOp,T.Cantidad1 Cantidad2, M.Cantidad Cantidad, 0 TotalNetoCli1,  ")
   SQL.ADD("0 TotalBrutoCli1, 0 TotalDerechos, 0 TotalIntereses, T.Fecha1 FechaOp, CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, E.Cotiza ContraEspecie,'0' PaseCB ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSEJE M ")
   SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
