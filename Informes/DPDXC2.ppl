ModoReproceso(condialogo)
CrearDialogo
  Fecha1   : 'Fecha'  ;;;;;;;;;FSys
  Vehiculo1: 'Vehiculo' ;;;;;;NoVacio(Dialogo.VEHICULO1);'Debe ingresar un Vehiculo';NO;VAR('VEHICULODE');;
  Radio1   : 'Cartera|Trading|Invest<=6M.|Invest>6M.|Otras Soc.';;;;;;;;;0
  Cantidad1: 'Nro Columna'                          ;4;1;;;;Dialogo.Cantidad1<>0;'Debe ingresar una columna';NO;
  Especie1 : 'Especie'                              ;5;1;;;;NoVacio(Dialogo.Especie1);'Debe ingresar una Especie';NO;
  Radio2   : 'Expresado|Mon.Local|Mon.Extranjera|'  ;6;1;;;;;;;0
  String1  : 'NrCupon'                              ; ; ;;NO;NO;;;;;
FinDialogo

If Not OK
   Cancelar
Endif
ACT(mn1, VAR('MONEEXTR'))
If Dialogo.Radio2 = 0
   ACT(mn1, VAR('MONELOCA'))
EndIf

*- Datos de la Especie
SQL.ADD("SELECT Codigo,FechaCambioTasa,TasaIntAnterior,TasaIntVigente,Alias5,InteresesC FROM "~DBO~".ESPECIES ")
IF NoVacio(Dialogo.Especie1)
   SQL.ADD("WHERE Codigo='"~Dialogo.Especie1~"' ")
ENDIF
ACD(yu:1 , Dialogo.Fecha1)
Recorrer SQL
   dfa
   ACN(yt1, 1)
   ACT(yv:1 , FBN['Codigo'])
   ACD(yx:1 , FBN['FechaCambioTasa'])
   ACN(yy:1 , FBN['TasaIntAnterior'])
   ACN(yz:1 , FBN['TasaIntVigente'])
   ACN(vr2,FBN['Alias5'])
   ACN(vr1, IIf(EqStr(FBN['InteresesC'],'CLE'),VALORTEORICO2(FBN['Codigo'],Dialogo.Fecha1),1) )
   ACN(cc1, CotizacionC(FBN['Codigo'],,,,Dialogo.Fecha1,1,SI,Val(mn1)) ) 
Proximo
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')
CrearFont(3, 'Arial,10,B')
(.'DPDXC2'.)
if Dialogo.Radio1 = 0
   ACT(az1,'O.CanPosTrad')
else
    if Dialogo.Radio1 = 1
       ACT(az1,'O.CanPosInv1')
    else
        if Dialogo.Radio1 = 2
           ACT(az1,'O.CanPosInv2')
        else
            ACT(az1,'O.CanPosOSoc')
        endif  
    endif
endif
* Retiros
If Dialogo.Cantidad1 = 3
   SQL.ADD("SELECT T.NrTrans NrOperacion, M.Cupon, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad2, T.Cantidad1 Cantidad, T.Cambio1 TotalNetoCli1, ")
   SQL.ADD("0 TotalBrutoCli1, 0 TotalDerechos, 0 TotalIntereses, T.Fecha1 FechaOp, CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, E.Cotiza ContraEspecie,'0' PaseCB ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSPEN M ")
   SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("T.NrTrans = M.NrOperacion AND ")
   SQL.ADD("M.NrSaldo IN ("~Pipe2Comillas(Val(cr2))~") AND ")
   SQL.ADD("M.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("M.Especie = E.Codigo AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("T.RB4 = '"~Fstr(Dialogo.Radio1,0,0)~"' AND ") 
   SQL.ADD("T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("((T.TipoTr2 IN ('RTP') AND ")
   SQL.ADD("  T.Cliente1 = '"~Dialogo.Vehiculo1~"') OR ")
   SQL.ADD(" (T.TipoTr2 IN ('DTP') AND ")
   SQL.ADD("  T.Cliente2 = '"~Dialogo.Vehiculo1~"')) AND ")
   SQL.ADD("T.CB6 <> 1 ")
   SQL.ADD("UNION ALL ")
   SQL.ADD("SELECT T.NrTrans NrOperacion, M.Cupon, T.TipoTr2 TipoOp, T.Cantidad1 Cantidad2, T.Cantidad1 Cantidad, T.Cambio1 TotalNetoCli1, ")
   SQL.ADD("0 TotalBrutoCli1, 0 TotalDerechos, 0 TotalIntereses, T.Fecha1 FechaOp, CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, E.Cotiza ContraEspecie,'0' PaseCB ")
   SQL.ADD("FROM   "~DBO~".TRANSACCIONES2 T, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B, "~DBO~".MOVPOSEJE M ")
   SQL.ADD("WHERE  T.NrTrans=B.NrOperacion and ")
   SQL.ADD("B.Valor=0 and B.NrBit in ('30') and ")
   SQL.ADD("T.NrTrans = M.NrOperacion AND ")
   SQL.ADD("M.NrSaldo IN ("~Pipe2Comillas(Val(cr2))~") AND ")
   SQL.ADD("M.Especie = '"~Dialogo.Especie1~"' AND ")
   SQL.ADD("M.Especie = E.Codigo AND ")
   If NoVacio(Dialogo.String1)
      SQL.ADD(" M.Cupon = "~Dialogo.String1~" AND ")
   EndIf
   SQL.ADD("T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' AND ")
   SQL.ADD("T.RB4 = '"~Fstr(Dialogo.Radio1,0,0)~"' AND ") 
   SQL.ADD("T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END = '"~IdxDate(Dialogo.Fecha1)~"' AND ")
   SQL.ADD("((T.TipoTr2 IN ('RTP') AND ")
   SQL.ADD("  T.Cliente1 = '"~Dialogo.Vehiculo1~"') OR ")
   SQL.ADD(" (T.TipoTr2 IN ('DTP') AND ")
   SQL.ADD("  T.Cliente2 = '"~Dialogo.Vehiculo1~"')) AND ")
   SQL.ADD("T.CB6 <> 1 ")
Endif
