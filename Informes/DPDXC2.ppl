   SQL.ADD("0 TotalBrutoCli1, 0 TotalDerechos, 0 TotalIntereses, T.Fecha1 FechaOp, CASE T.Fecha3 WHEN NULL THEN T.Fecha1 ELSE T.Fecha3 END FechaVto, E.Cotiza ContraEspecie,'0' PaseCB ")
