*Los campos de 'Cantidad' están definidos en PPLRC
CrearDialogo
    String    : "Producto"
    Fecha1    : "Fecha"
    Cantidad1 : "Numero default"
    Cantidad2 : 'Numero enmascarado 1'
    Cantidad3 : 'Numero enmascarado 2'
FinDialogo

If Dialogo.Ok

    CrearFont(1, "Arial,16,B")
    CrearFont(2, "Arial,13,B")
    CrearFont(3, "Arial,10")


    *************
    *LOGO
    *************
    AgregarBMP(A1,Exe("LOGO"),10)

    *************
    *TITULO
    *************
    *Agrega un "bloque", o sea un grupo de celdas mergeadas
    ABT(B1..B3,"LAYS",1,"black")
    AlinearCeldas(B1,"C")
    *AgregarMarco(B1..B1,2,0,"green") -> También funca
    AgregarMarco(b1..b1,2,0,"#99FF55")


    *************
    *CUERPO
    *************
    *Entre los números cambia el formato de String a number únicamente si tiene comas.
    
    Act(A7,"Este es un titulo")
    Act(A10,"Este es un subtitulo")
    Act(C10,"Este es un texto común")
    
    Act(A12, "Cantidad1 - STRING")
    Act(C12, Dialogo.Cantidad1)
    
    Act(A14, "Cantidad2 - STRING")
    Act(C14, Dialogo.Cantidad2)
    
    Act(A16, "Cantidad3 - STRING")
    Act(C16, Dialogo.Cantidad3)
    
    Act(A18, "Cantidad1 - NUM")
    Acn(C18, Dialogo.Cantidad1)
    
    Act(A20, "Cantidad2 - NUM")
    Acn(C20, Dialogo.Cantidad2)
    
    Act(A22, "Cantidad3 - NUM")
    Acn(C22, Dialogo.Cantidad3)
    
    Act(A24, "Fecha - STRING")
    Act(C24, Dialogo.Fecha1)
    
    Act(A26, "Fecha - DATE")
    Acd(C26, Dialogo.Fecha1)
    
    *Agrego un buen ancho a la columna 'A' (1) con "Ancho Columna (ACO)"
    ACO(1,20)
    *Personalizo el ancho de las columnas B y C también
    ACO(2,10)
    ACO(3,15)
    
    AgregarMarco(A12..C26,0,0)
    
    *Le agrego el formato a todos los subtítulos y textos "comunes"
    SetFont(a7,1)
    SetFont(a10,2)
    SetFont(C10,3)

Else

    HojaVisible(NO)

EndIf