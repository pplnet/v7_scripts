SQL.ADD("Select O.TipoOp, O.Cliente1, O.Especie, O.Cuenta1, O.Vehiculo1, O.Plazo, O.FechaVto, O.Precio1, O.Cantidad, O.FechaOp ")
SQL.ADD(" From "~DBO~".OPERACIONES O  where O.NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
   ACT(za:99, Fbn['TipoOp'])
   ACT(zb:99, fbn['Cliente1'])
   ACT(zc:99, fbn['Especie'])
   ACT(zd:99, PYC(fbn['Cantidad'],1,2))
   ACT(zf:99, fbn['Cuenta1'])
   ACT(zg:99, fbn['Vehiculo1'])
   ACT(zh:99, fbn['Plazo'])
   ACD(zi:99, fbn['FechaVto'])
*--   ACT(zj:99, IIF(EqStr(val(za:99), 'MMCP'), PYC(fbn['Precio1'],1,2), PYC(BuscarCampo('CUOTAS','Tasa1','NrOperacion', Dialogo.NrOperacion1),1,2)  ) )
   ACT(zj:99, IIF(EqStr(val(za:99), 'MMCP'), PYC(fbn['Precio1'],1,2), PYC(BuscarCampo('CUOTAS','Precio2','NrOperacion', Dialogo.NrOperacion1),1,2)  ) )
   ACD(zm:99, fbn['FechaOp'])
Proximo

If Not EqStr(val(za:99), 'MMCP') y Not EqStr(val(za:99), 'MMCPM')
    Cancelar
Endif

SetFilaActual(10)
ACT(a:FAC, BuscarCampo('CLIENTES','Localidad','Codigo',val(zg:99))~', '~FStr(Dia(val(zm:99)),1,0)~' de '~Meses(Mes(val(zm:99)))~' de '~FStr(Anio(val(zm:99)),4,0)~'.')
