ACT(a:fac,'Señores')
SetFont(a:10..a:fac,1)

SetFilaActual(fac+1)
ACT(a:fac, BuscarCampo('CLIENTES','RazonSocial','Codigo',val(zb:99)))
SetFont(a:fac,2)

SetFilaActual(fac+1)
ACT(a:fac,'Presente')
SetFont(a:fac,3)

SetFilaActual(fac+3)
acn(zz:99,fac)
ACT(a:fac,'De nuestra consideracion:')

SetFilaActual(fac+1)
ACT(TX:1,'Por medio de la presente, y de acuerdo a los fondos a nuestra disposicion en vuestro Banco en nuestra Cuenta '~BuscarCampo('CUENTAS','Numero','Codigo',val(zf:99))~', les solicitamos a Uds. la constitucion de un Deposito a Plazo segun las siguientes condiciones:')
 ACN(CR:1, 80)
   (.'LINEAS'.)
**--   Forma de usar a esta funcion desde donde se la llame
   Recorrer&k 1, Val(FI:2)
       ifa
       ACT(A:fac, Copy(Val(TX:1), Val(CA:&k), Val(CB:&k)))
   Proximo


SetFont(a:val(zz:99)..a:fac,1)

SetFilaActual(fac+2)
acn(zz:99, fac)
ACT(a:fac,'Monto: '~IIF(EqStr(val(zc:99),'ARP'),'$',IIF(EqStr(val(zc:99),'USD'),'u$s',val(zc:99) ) )~' '~val(zd:99)~'.-')
SetFilaActual(fac+1)
ACT(a:fac,'Plazo: '~val(zh:99)~IIF(num(val(zh:99))>1,' dias',' dia')~'.')
SetFilaActual(fac+1)
ACT(a:fac,'Vencimiento: '~val(zi:99))
SetFilaActual(fac+1)
ACT(a:fac,'T.N.A.: '~val(zj:99)~'%')
SetFont(a:val(zz:99)..a:fac,2)


SetFilaActual(fac+4)
ACT(a:Fac,'Sin otro particular, los saludamos a Uds. muy atte.')
