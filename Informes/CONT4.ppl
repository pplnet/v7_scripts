MostrarCuadroDeMensajes
*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:   'Fecha'    ; 1; ;;;;;;;fsys
  Especie1: 'Especie'  ; 1;2;
  Lista1:   'Vehiculos'; 3;1;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"'"))
FinDialogo
If Not Ok
   Cancelar
Endif

message('--- Asientos de Resultados por Tenencia ---')

ACN(x1, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
ACN(x3, SQL("Select 1 from "~DBO~".VARIABLES where Codigo = 'DIASCONT' "))
if Val(x1)=1
  ACN(x1, Trunc(Var('DIASCONT'),0))
endif
if Val(x1)<1
  ACN(x1, 1)
endif
ACD(x2, Habiles(PriDeMes(Dialogo.Fecha1,SI)-1,Val(x1),'ARG'))
if Dialogo.Fecha1<>Val(x2)
  Cancelar('La fecha es incorrecta. Verificar variable DIASCONT.')
endif

ACD(v:1, Dialogo.Fecha1)
ACD(v:2, Habiles(PriDeMes(Dialogo.Fecha1),-1,'ARG'))
ACD(v:3, Habiles(PriDeMes(Val(v:2)),-1,'ARG'))
ACT(y:1, Dialogo.Lista1)
ACT(y:2, '101,102')

SetFilaActual(1)
ACT(a:FAC, 'Especie')
ACT(b:FAC, 'Nombre')
ACT(c:FAC, 'Cupon')
ACT(d:FAC, 'NrSaldo')
ACT(e:FAC, 'TipoNegocio')
ACT(f:FAC, 'Vehiculo')
ACT(g:FAC, 'Book')
ACT(h:FAC, 'Fecha')
ACT(i:FAC, 'CantidadFin')
ACT(j:FAC, 'PrecioFin')
ACT(k:FAC, 'Cotiza')
ACT(l:FAC, 'Cot.Mes Ant')
ACT(m:FAC, 'Cot.Actual')
ACT(n:FAC, 'Dif.Cotiz.')
ACT(o:FAC, 'Res.Saldo Ant.')
ACT(p:FAC, 'Res.Operac.')
ACT(q:FAC, 'Res.TOTAL')
ACT(r:FAC, 'Tipos Asi')

ACT(aa:FAC, 'Especie')
ACT(ab:FAC, 'Nombre')
ACT(ac:FAC, 'Cupon')
ACT(ad:FAC, 'NrSaldo')
ACT(ae:FAC, 'TipoNegocio')
ACT(af:FAC, 'Vehiculo')
ACT(ag:FAC, 'Book')
ACT(ah:FAC, 'FechaMov')
ACT(ai:FAC, 'Cantidad')
ACT(aj:FAC, 'Precio')
ACT(ak:FAC, 'Cotiza')
ACT(al:FAC, 'Cotizacion')
ACT(am:FAC, 'Dif.Cotiz.')
ACT(an:FAC, 'Resultado')
ACT(ao:FAC, 'Linea')
ACT(ap:FAC, 'NrOperacion')
ACT(aq:FAC, 'TipoOp')
ACT(ar:FAC, 'FechaOp')

*SQL.ADD("select P.Fecha,    P.Cliente,     P.Especie,     P.Cupon,     ")
*SQL.ADD("       P.NrSaldo,  P.TipoNegocio, P.CantidadFin, P.PrecioFin, ")
*SQL.ADD("       P.Vehiculo, P.Book,        ")
*SQL.ADD("       E.Nombre,   E.Cotiza,      E.InteresesC  ")
SQL.ADD("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
SQL.ADD("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
SQL.ADD("       Sum(P.CantidadFin) as Cantidad, ")
SQL.ADD("       Sum(P.CantidadFin*P.PrecioFin) as Monto ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" where P.Especie     = E.Codigo ")
SQL.ADD("   and P.NrSaldo     in ("~Val(y:2)~") ")
SQL.ADD("   and P.TipoNegocio = 'SEC' ")
if NoVacio(Val(y:1))
  SQL.ADD("   and P.Vehiculo    In ("~Pipe2Comillas(val(y:1))~") ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and P.Especie     = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha       = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P2 ")
SQL.ADD("                       where P2.Especie     = P.Especie ")
SQL.ADD("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("                         and P2.Cliente     = P.Cliente ")
SQL.ADD("                         and P2.Vehiculo    = P.Vehiculo ")
SQL.ADD("                         and P2.NrSaldo     = P.NrSaldo ")
SQL.ADD("                         and P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                         and P2.Fecha      <= "~IdxDate2(Val(v:3))~" ) ")
*SQL.ADD(" order by P.Especie, P.Cupon ")
SQL.ADD(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC ")
Recorrer SQL
  ACT(a:FAC, FBN('Especie'))
  ACT(b:FAC, FBN('Nombre'))
*  ACT(c:FAC, FBN('Cupon'))
  ACN(d:FAC, FBN('NrSaldo'))
  ACT(e:FAC, FBN('TipoNegocio'))
  ACT(f:FAC, FBN('Vehiculo'))
*  ACT(g:FAC, FBN('Book'))
*  ACD(h:FAC, FBN('Fecha'))
*  ACN(i:FAC, FBN('CantidadFin'))
*  ACN(j:FAC, FBN('PrecioFin'))
  ACN(i:FAC, FBN('Cantidad'))
  ACN(j:FAC, FBN('Monto')/FBN('Cantidad'))
  ACT(k:FAC, FBN('Cotiza'))
  ACN(l:FAC, CotizacionC(FBN('Especie'),,,,Val(v:3),1,SI,FBN('Cotiza')))
  ACN(m:FAC, CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
  ACN(n:FAC, Val(m:FAC)-Val(l:FAC))
  ACN(o:FAC, Val(i:FAC)*Val(n:FAC))
proximo

ACN(w:1, 1)
SQL.ADD("select M.FechaMov,    M.Cliente,     M.Especie,     M.Cupon,  ")
SQL.ADD("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.Precio, ")
SQL.ADD("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
SQL.ADD("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
SQL.ADD("       O.TipoOp,      O.FechaOp      ")
SQL.ADD("  from "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O ")
SQL.ADD(" where M.NrSaldo     in ("~Val(y:2)~") ")
SQL.ADD("   and M.TipoNegocio = 'SEC' ")
if NoVacio(Val(y:1))
  SQL.ADD("   and M.Vehiculo  In ("~Pipe2Comillas(val(y:1))~") ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and M.Especie    = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
SQL.ADD("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
SQL.ADD("   and M.Especie     = E.Codigo ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
SQL.ADD(" order by M.Especie, M.Cupon ")
Recorrer SQL
  DFA
  SCN(w:1,1)
  ACN(w:2,0)
  if FAC>1
    recorrer&i 2,FAC
*      if EqStr(FBN('Especie'),Val(a:&i)) y EqStr(FBN('Cupon'),Val(c:&i))
      if EqStr(FBN('Especie'),Val(a:&i))
        ACN(w:2, &i)
        Break
      endif
    proximo
  endif
  if Val(w:2)=0
    IFA
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
*    ACT(c:FAC, FBN('Cupon'))
    ACN(d:FAC, FBN('NrSaldo'))
    ACT(e:FAC, FBN('TipoNegocio'))
    ACT(f:FAC, FBN('Vehiculo'))
    ACT(g:FAC, FBN('Book'))
    ACN(w:2, FAC)
  endif

  ACT(aa:Val(w:1), FBN('Especie'))
  ACT(ab:Val(w:1), FBN('Nombre'))
  ACT(ac:Val(w:1), FBN('Cupon'))
  ACN(ad:Val(w:1), FBN('NrSaldo'))
  ACT(ae:Val(w:1), FBN('TipoNegocio'))
  ACT(af:Val(w:1), FBN('Vehiculo'))
  ACT(ag:Val(w:1), FBN('Book'))
  ACD(ah:Val(w:1), FBN('FechaMov'))
  ACN(ai:Val(w:1), FBN('Cantidad'))
  ACN(aj:Val(w:1), FBN('Precio'))
  ACT(ak:Val(w:1), FBN('Cotiza'))
  ACN(al:Val(w:1), CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
  ACN(am:Val(w:1), Val(al:Val(w:1))-Val(aj:Val(w:1)))
  ACN(an:Val(w:1), Val(ai:Val(w:1))*Val(am:Val(w:1)))
  ACN(ao:Val(w:1), Val(w:2))
  ACT(ap:Val(w:1), FBN('NrOperacion'))
  ACT(aq:Val(w:1), FBN('TipoOp'))
  ACD(ar:Val(w:1), FBN('FechaOp'))
  SCN(p:Val(w:2), Val(an:Val(w:1)))
proximo

ACN(w:3, FAC)
********************************
**********   FONDOS   **********
********************************
*SQL.ADD("select P.Fecha,    P.Cliente,     P.Especie,     P.Cupon,     ")
*SQL.ADD("       P.NrSaldo,  P.TipoNegocio, P.CantidadFin, P.PrecioFin, ")
*SQL.ADD("       P.Vehiculo, P.Book,        ")
*SQL.ADD("       E.Nombre,   E.Cotiza,      E.InteresesC  ")
SQL.ADD("select P.Especie,  P.NrSaldo, P.TipoNegocio, ")
SQL.ADD("       P.Vehiculo, E.Nombre, E.Cotiza,  E.InteresesC, ")
SQL.ADD("       Sum(P.CantidadFin) as Cantidad, ")
SQL.ADD("       Sum(P.CantidadFin*P.PrecioFin) as Monto ")
SQL.ADD(" from  "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" where P.Especie     = E.Codigo ")
SQL.ADD("   and P.NrSaldo     = 101 ")
SQL.ADD("   and P.TipoNegocio = 'FC' ")
if NoVacio(Val(y:1))
  SQL.ADD(" and P.Vehiculo    In ("~Pipe2Comillas(val(y:1))~") ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD(" and P.Especie     = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and P.CantidadFin <> 0 ")
SQL.ADD("   and P.Fecha       = (select Max(Fecha) ")
SQL.ADD("                       from  "~DBO~".POSICIONES P2 ")
SQL.ADD("                       where P2.Especie     = P.Especie ")
SQL.ADD("                         and (P2.Cupon      = P.Cupon or (P2.Cupon IS NULL and P.Cupon IS NULL)) ")
SQL.ADD("                         and P2.Cliente     = P.Cliente ")
SQL.ADD("                         and P2.Vehiculo    = P.Vehiculo ")
SQL.ADD("                         and P2.NrSaldo     = P.NrSaldo ")
SQL.ADD("                         and P2.TipoNegocio = P.TipoNegocio ")
SQL.ADD("                         and P2.Fecha      <= "~IdxDate2(Val(v:3))~" ) ")
*SQL.ADD(" Order by P.Especie, P.Cupon ")
SQL.ADD(" Group by P.Especie, P.NrSaldo, P.TipoNegocio, P.Vehiculo, E.Nombre, E.Cotiza, E.InteresesC ")
Recorrer SQL
  ACT(a:FAC, FBN('Especie'))
  ACT(b:FAC, FBN('Nombre'))
*  ACT(c:FAC, FBN('Cupon'))
  ACN(d:FAC, FBN('NrSaldo'))
  ACT(e:FAC, FBN('TipoNegocio'))
  ACT(f:FAC, FBN('Vehiculo'))
*  ACT(g:FAC, FBN('Book'))
*  ACD(h:FAC, FBN('Fecha'))
*  ACN(i:FAC, FBN('CantidadFin'))
*  ACN(j:FAC, FBN('PrecioFin'))
  ACN(i:FAC, FBN('Cantidad'))
  ACN(j:FAC, FBN('Monto')/FBN('Cantidad'))
  ACT(k:FAC, FBN('Cotiza'))
  ACN(l:FAC, CotizacionC(FBN('Especie'),,,,Val(v:3),1,SI,FBN('Cotiza')))
  ACN(m:FAC, CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
  ACN(n:FAC, Val(m:FAC)-Val(l:FAC))
  ACN(o:FAC, Val(i:FAC)*Val(n:FAC))
proximo

SQL.ADD("select M.FechaMov,    M.Cliente,     M.Especie,     M.Cupon,  ")
SQL.ADD("       M.NrSaldo,     M.TipoNegocio, M.Cantidad,    M.Precio, ")
SQL.ADD("       M.Vehiculo,    M.Book,        M.NrOperacion, ")
SQL.ADD("       E.Nombre,      E.Cotiza,      E.InteresesC,  ")
SQL.ADD("       O.TipoOp,      O.FechaOp      ")
SQL.ADD("  from "~DBO~".MOVPOSEJE M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONES O ")
SQL.ADD(" where M.NrSaldo     = 101 ")
SQL.ADD("   and M.TipoNegocio = 'FC' ")
if NoVacio(Val(y:1))
  SQL.ADD("   and M.Vehiculo  In ("~Pipe2Comillas(val(y:1))~") ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("  and M.Especie    = '"~Dialogo.Especie1~"' ")
endif
SQL.ADD("   and M.FechaMov    >  "~IdxDate2(Val(v:3))~" ")
SQL.ADD("   and M.FechaMov    <=  "~IdxDate2(Val(v:2))~" ")
SQL.ADD("   and M.Especie     = E.Codigo ")
SQL.ADD("   and M.NrOperacion = O.NrOperacion ")
SQL.ADD(" order by M.Especie, M.Cupon ")
Recorrer SQL
  DFA
  SCN(w:1,1)
  ACN(w:2,0)
  if FAC>Val(w:3)
    recorrer&i Val(w:3)+1,FAC
*      if EqStr(FBN('Especie'),Val(a:&i)) y EqStr(FBN('Cupon'),Val(c:&i))
      if EqStr(FBN('Especie'),Val(a:&i))
        ACN(w:2, &i)
        Break
      endif
    proximo
  endif
  if Val(w:2)=0
    IFA
    ACT(a:FAC, FBN('Especie'))
    ACT(b:FAC, FBN('Nombre'))
*    ACT(c:FAC, FBN('Cupon'))
    ACN(d:FAC, FBN('NrSaldo'))
    ACT(e:FAC, FBN('TipoNegocio'))
    ACN(w:2, FAC)
  endif

  ACT(aa:Val(w:1), FBN('Especie'))
  ACT(ab:Val(w:1), FBN('Nombre'))
  ACT(ac:Val(w:1), FBN('Cupon'))
  ACN(ad:Val(w:1), FBN('NrSaldo'))
  ACT(ae:Val(w:1), FBN('TipoNegocio'))
  ACT(af:Val(w:1), FBN('Vehiculo'))
  ACT(ag:Val(w:1), FBN('Book'))
  ACD(ah:Val(w:1), FBN('FechaMov'))
  ACN(ai:Val(w:1), FBN('Cantidad'))
  ACN(aj:Val(w:1), FBN('Precio'))
  ACT(ak:Val(w:1), FBN('Cotiza'))
  ACN(al:Val(w:1), CotizacionC(FBN('Especie'),,,,Val(v:2),1,SI,FBN('Cotiza')))
  ACN(am:Val(w:1), Val(al:Val(w:1))-Val(aj:Val(w:1)))
  ACN(an:Val(w:1), Val(ai:Val(w:1))*Val(am:Val(w:1)))
  ACN(ao:Val(w:1), Val(w:2))
  ACT(ap:Val(w:1), FBN('NrOperacion'))
  ACT(aq:Val(w:1), FBN('TipoOp'))
  ACD(ar:Val(w:1), FBN('FechaOp'))
  SCN(p:Val(w:2), Val(an:Val(w:1)))
proximo

if Val(w:3)>1
  recorrer&i 2,Val(w:3)
    ACN(q:&i, Val(o:&i)+Val(p:&i))
    if DesciendeDeEspecie(Val(a:&i),'ACCION')
      ACT(r:&i, Var('TIPASITEAC'))
    else
      ACT(r:&i, Var('TIPASITETI'))
    endif
    SQL.ADD("select MA.Codigo ")
    SQL.ADD("  from "~DBO~".MODELOSASIENTO MA ")
    SQL.ADD(" where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
    Recorrer SQL    
      DFA
      Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
      SQL.GenerarAsientoOp(fbn('Codigo'), '','','',810,Val(v:2),Val(f:&i),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
    proximo
  proximo
endif

if FAC>Val(w:3)
  recorrer&i Val(w:3)+1,FAC
    ACN(q:&i, Val(o:&i)+Val(p:&i))
    ACT(r:&i, Var('TIPASITEFC'))
    SQL.ADD("select MA.Codigo ")
    SQL.ADD("  from "~DBO~".MODELOSASIENTO MA ")
    SQL.ADD(" where MA.TipoAsiento IN ("~Pipe2Comillas(Val(r:&i))~") ")
    Recorrer SQL    
      DFA
      Message(Val(a:&i)~' - Modelo: '~fbn('Codigo'))
      SQL.GenerarAsientoOp(fbn('Codigo'), '','','',810,Val(v:2),Val(f:&i),,,,,,,,,,,,,fsys,Dialogo.Fecha1)
      SQL.EXEC
    proximo
  proximo
endif
