*ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Fecha'   ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Invalida';NO;Fsys
  Cliente1  : 'Agente'  ;;;;;;Vacio(Dialogo.Cliente1) O Incluido(Dialogo.Cliente1, SQLSet(" Select Codigo From "~DBO~".CLIENTES Where NrMAE Is Not Null AND NrMAE <> '0' "));'Agente Invalido';NO;;;;;;" NrMAE Is Not Null AND NrMAE <> '0' ";
  Vehiculo1 : 'Vehiculo';;;;NO;;NoVacio(DIalogo.Vehiculo1);'Vehiculo Invalido';NO;Var('VEHICULODE');
  Radio1    : 'Orden|x Operacion|x Cliente';;;;;;;;;0;
  Lista1    : 'Fixing'       ;5;1;;;;;;;;;SQLSet("Select Codigo from "~DBO~".ESPECIES where SUBSTRING(Jerarquia,10,3)<>'000' AND SUBSTRING(Jerarquia,1,9)= (Select SUBSTRING(Jerarquia,1,9) from "~DBO~".ESPECIES where Codigo='OCTFIX') ")
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

**AgregarBMP(A:1, Exe('LOGO'), 60)
ACT(A:2, CodigoInforme)
SetFilaActual(4)
ACT(D:fac, 'Operaciones Vigentes OCT al '~Dialogo.Fecha1)
SetFont(D:fac, 3)
SetFilaActual(fac+2)
if NoVacio(Dialogo.Cliente1)
    ACT(A:fac, 'Agente: '~Dialogo.Cliente1)
else
    ACT(A:fac, 'Agentes: Todos')
endif
if NoVacio(Dialogo.Lista1)
  act(d:fac, '  Fixing :  ' ~Dialogo.Lista1)
else
  act(d:fac, '  Fixing :  Todos')
endif
ifa
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
ifa
ACT(A:fac, 'Ordenado por '~iif(Dialogo.Radio1=0,'Operacion','Cliente'))
SetFont(A:fac-2..D:fac, 2)

SetFilaActual(fac+2)
ACT(A:fac, 'Operacion')
ACT(B:fac, 'TipoOp')
ACT(C:fac, 'Cliente')
ACT(D:fac, 'FechaOp')
ACT(E:fac, 'FechaPrecan')
ACT(F:fac, 'FechaVto')
ACT(G:fac, 'Cantidad')
ACT(H:fac, 'PrecioOp')
ACT(I:fac, 'Resultado')
AlinearCeldas(A:fac..I:fac, 'C')
SetFont(A:fac..I:fac, 2)
AgregarMarco(A:fac..I:fac, 0, 0, Exe('COLOR'))
ACN(FI:1, fac+1)

SQL.ADD(" Select O.NrOperacion, O.TipoOp, O.Cliente1, O.FechaOp, O.FechaVto, O.FechaPrecan, O.Cantidad, O.CB6, O.Precio1, ")
SQL.ADD(" O.PrecioEj, O.ContraEspecie, O.ObsErrorMAE, O.Especie, O.MB1 ")
SQL.ADD(" From "~DBO~".OPERACIONES O,"~DBO~".OPERACIONESBITS OB  ")
SQL.ADD(" Where O.NrOperacion = OB.NrOperacion AND OB.NrBit = 30 AND OB.Valor <> '1' ")
SQL.ADD(" AND O.TipoOp IN ('FXOCTC','FXOCTV') ")
SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND ((O.CB6 = '1' AND O.FechaPrecan >= '"~IdxDate(Dialogo.Fecha1)~"') OR ((O.CB6 <> '1' OR O.CB6 Is Null OR O.CB6 = '') AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"')) ")
SQL.ADD(" AND O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
IF NoVacio(Dialogo.Cliente1)
    SQL.ADD(" AND O.Cliente1 = '"~Dialogo.Cliente1~"' ")
ENDIF
If NoVacio(Dialogo.Lista1)
   SQL.ADD("and O.ContraEspecie2 In ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
if Dialogo.Radio1=0
  SQL.ADD(" Order By O.NrOperacion ")
else
  SQL.ADD(" Order By O.Cliente1, O.NrOperacion ")
endif
Recorrer SQL
    ***---TipoNegociacion
    ACT(TN:fac, Copy(fbn('ObsErrorMAE'), 1, 1))
    ***---EspecieOrigen
    ACT(EO:fac, Copy(fbn('ObsErrorMAE'), 2, 5))
    ***---Especie MTM
    ACT(EM:fac, SQL(" Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where TipoNegociacion = '"~Val(TN:fac)~"' AND EspecieOrigen = '"~Val(EO:fac)~"' AND EspecieDestino1 = '"~fbn('Especie')~"' AND TipoCotizacion = 'O' "))
    ***---Metodo Fixing
    IF Eqstr(fbn('Especie'), 'USD')
        IF fbn('MB1') = 0
            ACT(MT:fac, 'E')
        ENDIF
        IF fbn('MB1') = 1
            ACT(MT:fac, 'A')
        ENDIF
    ENDIF
    ***---Especie Fixing
    ACT(EF:fac, SQL(" Select EspecieDestino2 From "~DBO~".EQUIVALENCIA_ESPECIES Where TipoCotizacion = 'F' AND TipoNegociacion = '"~Val(TN:fac)~"' AND Metodo = '"~Val(MT:fac)~"' "))
    ACT(A:fac, fbn('NrOperacion'))
    ACLO(A:fac, fbn('NrOperacion'))
    ACT(B:fac, fbn('TipoOp'))
    ACT(C:fac, fbn('Cliente1'))
    ACD(D:fac, fbn('FechaOp'))
    IF fbn('CB6') = 1 Y fbn('FechaPrecan') <= Dialogo.Fecha1
        ACD(E:fac, fbn('FechaPrecan'))
    ENDIF
    ACD(F:fac, fbn('FechaVto'))
    ACN(G:fac, fbn('Cantidad'))
    ACN(H:fac, fbn('Precio1'))
    ***---Precio Hoy
    IF fbn('FechaVto') = Dialogo.Fecha1 O [fbn('FechaPrecan') = Dialogo.Fecha1 Y fbn('CB6') = 1]
        ***---Fixing o Precan
        ACN(PH:fac, fbn('PrecioEj'))
    ELSE
        ACN(PH:fac, CotizacionC(Val(EM:fac),'FUT',fbn('FechaVto'),,Dialogo.Fecha1,1,,fbn('ContraEspecie')))
    ENDIF
    ***---PrecioOp
    ACN(PO:fac, fbn('Precio1'))
    IF Eqstr(fbn('TipoOp'), 'FXOCTC')
        ACN(I:fac, fbn('Cantidad') * (Val(PH:fac)-Val(PO:fac)))
    ELSE
        ACN(I:fac, fbn('Cantidad') * (Val(PO:fac)-Val(PH:fac)))
    ENDIF
    ACL(I:fac, 'DETVIG', NrOperacion1 = Val(A:fac), Vehiculo1 = Dialogo.Vehiculo1, Fecha1 = 0, Fecha2 = Dialogo.Fecha1, Cantidad1 = Val(I:fac), Radio1 = 1)
    SCN(TO:1, Val(I:fac))
Proximo

SetFont(A:Val(FI:1)..I:fac, 1)
FormatoCeldas(H:Val(FI:1)..H:fac, Exe('F9'))
SetFilaActual(fac+2)
ACT(G:fac, 'Total Neto')
ACN(I:fac, Val(TO:1))
SetFont(G:fac..I:fac, 2)
FormatoCeldas(I:Val(FI:1)..I:fac, Exe('F2'))

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

ACO(5, 8)
ACO(7, 10)
ACO(8, 9)
ACO(9, 10)

LimitesVision(I:fac+1)
