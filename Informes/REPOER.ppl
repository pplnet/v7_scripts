*Variable con DBO
ACT(va:1,VAR('PATHEXTERN'))

ModoReproceso(SINDIALOGO)
CrearDialogo
  Cliente1 :'Cliente'     ;1;1;;;;;;
  Especie1 :'Especie'     ;2;1;;;;;;
  Fecha1   :'F.Op.Desde'  ;3;1;;;;Dialogo.Fecha1<>0;'Debe Ingresar una F.Op. Desde' ;NO;FSys-30;
  Fecha2   :'F.Op.Hasta'  ;4;1;;;;Dialogo.Fecha2<>0;'Debe Ingresar una F.Op. Hasta' ;NO;FSys;
  Fecha3   :'F.Vto.Desde' ;3;2;;;;Dialogo.Fecha3<>0;'Debe Ingresar una F.Vto. Desde';NO;FSys;
  Fecha4   :'F.Vto.Hasta' ;4;2;;;;Dialogo.Fecha4<>0;'Debe Ingresar una F.Vto. Hasta';No;FSys+365;
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")


SetFilaActual(1)
ACT(a:fac,'Reporte de Operaciones')
SetFont(a:fac,3)

SetFilaActual(fac+2)
If NoVacio(Dialogo.Cliente1)
   ACT(a:fac,'Cliente:')
   ACT(b:fac,'('~Dialogo.Cliente1~') '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:fac,'Clientes:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA

If NoVacio(Dialogo.Especie1)
   ACT(a:fac,'Especie:')
   ACT(b:fac,'('~Dialogo.Especie1~') '~BuscarCampo('ESPECIES','Nombre','Codigo',Dialogo.Especie1))
Else
   ACT(a:fac,'Especies:')
   ACT(b:fac,'Todas')
EndIf
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,'Fecha Op. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha1)~' hasta el '~Fecha(Dialogo.Fecha2))
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,'Fecha Vto. :')
ACT(b:fac,'Desde el '~Fecha(Dialogo.Fecha3)~' hasta el '~Fecha(Dialogo.Fecha4))
SetFont(a:fac..b:fac,2)


SetFilaActual(fac+2)
ACT(a:fac,'Tipo Op.')
ACT(b:fac,'Nro. Op.')
ACT(c:fac,'Fecha Op.')
ACT(d:fac,'Fecha Vto.')
ACT(e:fac,'Cliente')
ACT(f:fac,'Nr.Orden')
ACT(g:fac,'Cuenta Comit.')
ACT(h:fac,'Especie')
ACT(i:fac,'Cantidad')
ACT(j:fac,'Precio')
ACT(k:fac,'Plazo')
ACT(l:fac,'C.Esp.')
ACT(m:fac,'Total')
ACT(n:fac,'Tipo')
ACT(o:fac,'Book')
ACT(p:fac,'M. Negociacion')
ACT(q:fac,'Vehiculo')
ACT(r:fac,'Operador')
ACT(s:fac,'F.Carga')
ACT(t:fac,'H.Carga')
ACT(u:fac, 'F.CargaSys')
ACT(v:fac,'Boleto')


AlinearCeldas(a:fac..v:fac,'C')
AlinearCeldas(i:fac..i:fac,'D')
AlinearCeldas(j:fac..j:fac,'D')
AlinearCeldas(k:fac..k:fac,'D')
AlinearCeldas(m:fac..m:fac,'D')

SetFont(a:fac..v:fac,2)
AgregarMarco(a:fac..v:fac,2,0,EXE('COLOR'))
ACN(z:1,fac)

SQL.ADD(" Select O.TipoOp, O.NrOperacion, O.FechaOp, O.FechaVto, O.Cliente1,                    ")
SQL.ADD(" Cuenta1, O.Especie, O.FechaEj, O.PrecioEj, O.Cantidad, O.Precio1, O.Precio4, O.Plazo, ")
SQL.ADD(" O.ContraEspecie, O.TotalNetoCli1, O.Book1, O.Vehiculo1, O.Operador, O.FechaOp2,       ")
SQL.ADD(" O.FechaCarga,O.FechaCargaSys, O.NrBoleto,O.NrOperacion3, O.TotalBrutoCli1,O.NrOrden1, ")
SQL.ADD(" CASE WHEN  O.TipoOp in ('TICF','TIVF') THEN O.Mercado ELSE O.Mercado4 END MercNeg     ")
SQL.ADD(" From  "~val(va:1)~".OPERACIONES O ")
SQL.ADD(" Where O.FechaOp  between "~IdxDate2(Dialogo.Fecha1)~" and "~IdxDate2(Dialogo.Fecha2) )
SQL.ADD(" and   O.FechaVto between "~IdxDate2(Dialogo.Fecha3)~" and "~IdxDate2(Dialogo.Fecha4) )
*-Especie
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" and O.Especie = '"~Dialogo.Especie1~"' ")
EndIf
*-Cliente
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
SQL.ADD("Order by O.TipoOp, O.NrOperacion")

Recorrer SQL

     ACT(a:fac,fbn('TipoOp'))
     ACT(b:fac,fbn('NrOperacion'))
     ACLO(b:fac,fbn('NrOperacion'))
     ACT(c:fac,fbn('FechaOp'))
     ACT(d:fac,fbn('FechaVto'))
     AlinearCeldas(b:fac..d:fac,'C')
     
     ACT(e:fac,fbn('Cliente1'))
     ACT(f:fac,fbn('NrOrden1'))
     ACT(g:fac,FBN['Cuenta1'])
     
     If NoVacio(fbn('FechaEj')) Y Not Incluido(fbn('TipoOp'), 'FXCTC|FXVTC|FXOCTC|FXOCTV')
        ACT(h:fac,fbn('Especie')~'-'~Fecha(fbn('FechaEj'))~'-'~FStr(fbn('PrecioEj'),1,7))
     Else
        ACT(h:fac,fbn('Especie'))
     EndIf
     If Incluido(fbn('TipoOp'), 'FXCTC|FXVTC|')  
        ACN(i:fac,fbn('Cantidad') *  BuscarCampo('ESPECIES','TamanioLote','Codigo',fbn('Especie')) )
     Else
        ACN(i:fac,fbn('Cantidad')  )
     EndIf
     FormatoCeldas(i:fac,EXE('F2'))
     
     ACN(j:fac,fbn('Precio1'))
     FormatoCeldas(j:fac,EXE('F9'))
     
     ACN(k:fac,fbn('Plazo'))
     If Incluido(fbn('TipoOp'), 'TIC|TIV')
        ACN(k:fac,fbn('Plazo')/24)
     Endif
     
     FormatoCeldas(k:fac,EXE('F0'))
     ACT(l:fac,fbn('ContraEspecie'))
     If Incluido(fbn('TipoOp'), 'FXC|FXV|FXCT|FXVT|FXA|FXAT|MMCO|MMCT|TIDE|TIPO|MMPF|MMPFCE|MMOVN|FXOCTC|FXOCTV|PMU|PME|IEXP|IMM|IFX|ISL|TICO|TIPA|TIPP|TICT|TICF|TICV')
        ACN(m:fac,fbn('TotalBrutoCli1'))
     Else
        ACN(m:fac,fbn('TotalNetoCli1'))
     Endif
     FormatoCeldas(m:fac,EXE('F2'))
     
     ACT(n:fac,'TERCEROS/PROPIA')
     ACT(o:fac,fbn('Book1'))
     ACT(p:fac,fbn('MercNeg'))
     ACT(p:fac,fbn('MercNeg'))
     ACT(q:fac,fbn('Vehiculo1'))
     ACT(r:fac,fbn('Operador'))
*     ACT(s:fac,Fecha(fbn('FechaCarga'),))
     ACT(s:fac,Copy(fbn('FechaCarga'),1,10))
     ACT(t:fac,Hora(fbn('FechaCarga')))
*     ACT(u:fac, Fecha(fbn('FechaCargaSys')))
     ACT(u:fac, fbn('FechaCargaSys'))
     If Incluido(fbn['TipoOp'],'CFTP|CTC|CTP|LIC|VFTP|VTC|VTP|ANTCBC|ANTCBT|CBC|CBT|CCP|CPP|VCP|VPP')
        ACT(v:fac, fbn('NrOperacion3'))
     Else
        If Not Incluido(fbn['TipoOp'],'TICF|TIVF')
            ACT(v:fac, fbn('NrBoleto'))
        EndIf
     EndIf

     *ACLR(x:fac,fbn('NrOperacion'))
     AlinearCeldas(s:fac..x:fac,'C')
     SetFont(a:fac..x:fac,1)
    
Proximo

SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac,2)

Impresion(1,2)
Impresion(2,1)
Impresion(3,1)
Impresion(4,1)

LimitesVision(w:fac)
Rangotitulo(a:1..v:fac,Val(z:1))
SetPrintFit(3, 50)

