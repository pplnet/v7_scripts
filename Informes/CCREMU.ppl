CrearDialogo
  Fecha1     : "Fecha Desde"         ;;;;;;Dialogo.Fecha1 <> 0;'Fecha Desde Invalida';NO;PriDeMes(Fsys, NO, 'ARG');
  Fecha2     : "Fecha Hasta"         ;;;;;;Dialogo.Fecha2 >= Dialogo.Fecha1;'Fecha Hasta Invalida';NO;Fsys;
  Cliente1   : "Entidad"             ;;;;;;;;;;;;;
  Especie1   : "Moneda Oper."        ;1;2;;;;;;;Var('MONEEXTR');;SQLSet(" Select Codigo From "~DBO~".ESPECIES Where Codigo IN ("~Pipe2Comillas(Descendientes('ESPECIES', 'MONEDA'))~") ");
  Radio4     : "Consolidado|NO|SI"   ;2;2;;;;;;;0
  Radio1     : 'Expresado|'~Var('MONEEXTR')~'|'~Var('MONELOCA');3;2;;;;;;;0;
  Precio1    : 'Tipo de Cambio'      ;4;1;;[Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1];[Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1];[Dialogo.Precio1 > 0] O [Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0] O [Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1];'Tipo de Cambio Invalido';NO;;IIF(Not Eqstr(Dialogo.Especie1, Var('MONEEXTR')) Y Dialogo.Radio1 = 0, CotizacionC(Dialogo.Especie1,,,, Fsys, 1, SI, Var('MONEEXTR'))^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONEEXTR')),'INV'),-1,1), IIF(Not Eqstr(Dialogo.Especie1, Var('MONELOCA')) Y Dialogo.Radio1 = 1, CotizacionC(Dialogo.Especie1,,,, Fsys, 1, SI, Var('MONELOCA'))^IIF(EqStr(Modo(Dialogo.Especie1,VAR('MONELOCA')),'INV'),-1,1),1));;;'###,###.########';
  Lista1     : "Vehiculo"            ;5;1;;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSET(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') "));
FinDialogo

If Not Ok
  Cancelar
EndIf

ACT(LS:1, IIF(Vacio(UsrVehiculos(UsuarioActivo)), SQLSet(" Select Codigo From "~DBO~".VEHICULOS Where (Status='HAB' or Status Is Null or Status='') "), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where U.Codigo = '"~UsuarioActivo~"' AND U.Vehiculo = V.Codigo AND (Status='HAB' or Status Is Null or Status='') ")))

IF NoVacio(Dialogo.Lista1)
    ACN(EL:1, Elementos(Dialogo.Lista1))
ELSE
    ACN(EL:1, Elementos(Val(LS:1)))
ENDIF

IF Dialogo.Radio4 = 0
    ***---No Consolidado
    Recorrer&k 1, Val(EL:1)
        IF NoVacio(Dialogo.Lista1)
*            ACT(VH:1, Pipe2Comillas(ItemLista(Dialogo.Lista1, &k)))
            ACT(VH:1, ItemLista(Dialogo.Lista1, &k))
        ELSE
*            ACT(VH:1, Pipe2Comillas(ItemLista(Val(LS:1), &k)))
            ACT(VH:1, ItemLista(Val(LS:1), &k))
        ENDIF
        
        *LinkearHoja('CCREMA', 1, Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2, Especie1 = Dialogo.Especie1, Cliente1 = Dialogo.Cliente1, Radio4 = Dialogo.Radio4, Vehiculo1 = Val(VH:1), Precio1 = Dialogo.Precio1, Lista1 = '', Radio1 = Dialogo.Radio1)
        LinkearHoja('CCREMA', 1, Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2, Especie1 = Dialogo.Especie1, Cliente1 = Dialogo.Cliente1, Radio4 = Dialogo.Radio4, Vehiculo1 = '', Precio1 = Dialogo.Precio1, Lista1 = Val(vh:1), Radio1 = Dialogo.Radio1)
    Proximo
ELSE
    ***---Consolidado
    LinkearHoja('CCREMA', 1, Fecha1 = Dialogo.Fecha1, Fecha2 = Dialogo.Fecha2, Especie1 = Dialogo.Especie1, Cliente1 = Dialogo.Cliente1, Radio4 = Dialogo.Radio4, Vehiculo1 = '', Precio1 = Dialogo.Precio1, Lista1 = IIF(NoVacio(Dialogo.Lista1), Dialogo.Lista1, Val(LS:1)), Radio1 = Dialogo.Radio1)
ENDIF
HojaVisible(NO)