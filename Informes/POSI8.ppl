ACT(n:fac, 'Reva.Cont.')
ACT(m:fac+1, 'Day')
ACT(n:fac+1, 'MTD')
ACT(o:fac+1, 'YTD')

AgregarMarco(a:fac..c:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(a:fac..z:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(I:fac..l:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(m:fac..o:fac+1,0,0,EXE('COLOR6'))
SetFont(a:fac..z:fac+1, 2)
AlinearCeldas(a:fac..z:fac+1, 'C')

ACD(fe:2, Fecha('01/01/'~Fstr(Anio(dialogo.Fecha1),4,0)) )

ifa
SQL.ADD(" SELECT DISTINCT P.Especie, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, P.Vehiculo, P.CantidadFin, P.CantidadIni, P.Cantidad1, P.Cantidad2, ")
SQL.ADD(" E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, P.PrecioFin, P.Fecha ,")
SQL.ADD(" P.PrecioFinCon, P.PrecioHistCon, P.PrecioFinHistCon ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Dialogo.Fecha1)~" ")
****SQL.ADD(" AND   (P.CantidadFin <> 0 OR P.CantidadIni<>0 OR P.Cantidad1<>0 OR P.Cantidad2<>0 )")
*If Dialogo.Check2=0
*   SQL.ADD(" AND   (P.CantidadFin <> 0 OR (P.Cantidad1<>0 OR P.Cantidad2<>0 AND P.Fecha= "~idxdate2(Dialogo.Fecha1)~" ) )")
*Else
*   SQL.ADD(" AND   (P.CantidadFin <> 0 OR P.Fecha >= "~idxdate2(Val(fe:2))~" ) ")
*Endif
* FJL 21/05/21 - Paara que muestre el PPP aunque hoy se haya vendido todo.
*SQL.ADD(" AND   P.CantidadFin <> 0 ")
*SQL.ADD(" AND   ((P.CantidadFin <> 0 and P.Fecha<"~idxdate2(Dialogo.Fecha1)~") or (P.Fecha="~idxdate2(Dialogo.Fecha1)~")) ")
SQL.ADD(" AND   ((P.CantidadFin <> 0 and P.Fecha<"~idxdate2(Dialogo.Fecha1)~") or ((P.CantidadIni>0 or P.Cantidad1>0 or P.Cantidad2>0) and P.Fecha="~idxdate2(Dialogo.Fecha1)~")) ")
If Dialogo.Check1=0
   SQL.ADD(" AND   P.Especie <> '"~VAR('MONELOCA')~"' ")
Endif
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND   P.Cliente = '"~Dialogo.Vehiculo1~"'  ")
Endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Book in( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
SQL.ADD(" AND   P.NrSaldo IN (171) ")
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")
SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.Book, P.NrSaldo, E.Tipo, P.Especie ")

ACN(xx:1, 0)
ACT(xx:2, '')
ACT(xx:3, '')

ACN(fi:1, fac+1)
Recorrer SQL

  If Not Eqstr(fbn('Vehiculo'), Val(xx:2))
     If Not Eqstr('', Val(xx:2))
        If Val(xx:1)=171 o Val(xx:1)=172
           ACT(a:fac, 'Total Titulos')
        Endif
        If Val(xx:1)=31 o Val(xx:1)=51
           ACT(a:fac, 'Total FX')
        Endif
        If Val(xx:1)=43
           ACT(a:fac, 'Total OCT')
        Endif
        If Val(xx:1)=44
           ACT(a:fac, 'Total Rofex ')
        Endif
        If Val(xx:1)=45
           ACT(a:fac, 'Total Internal FX Exposure')
        Endif
        If Val(xx:1)=42
           ACT(a:fac, 'Total FX NDF')
        Endif
        If Val(xx:1)=41
           ACT(a:fac, 'Total FX DF')
        Endif
        * --- Totales por Tipo de Resultado
        ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
        ACN(m:fac, SUM(m:Val(fi:1)..m:fac) )
        ACN(n:fac, SUM(n:Val(fi:1)..n:fac) )
        ACN(o:fac, SUM(o:Val(fi:1)..o:fac) )
        SetFont(a:fac..z:fac, 3)
        * --- Sumo totales para Book
        SCN(tt:1, Val(l:fac) )
        SCN(tt:2, Val(m:fac) )
        SCN(tt:3, Val(n:fac) )
        SCN(tt:4, Val(o:fac) )

        * --- Sumo totales para vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(m:fac) )
        SCN(tv:3, Val(n:fac) )
        SCN(tv:4, Val(o:fac) )
        ifa

        ACT(a:fac,  'Total Book: '~Val(xx:3))
        * --- Imprimo Totales para Book
        ACN(l:fac,Val(tt:1))
        ACN(m:fac,Val(tt:2))
        ACN(n:fac,Val(tt:3))
        ACN(o:fac,Val(tt:4))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0)
        ifa
        ifa
        ACT(a:fac, 'Total Vehiculo '~Val(xx:2))
        ACN(l:fac,Val(tv:1))
        ACN(m:fac,Val(tv:2))
        ACN(n:fac,Val(tv:3))
        ACN(o:fac,Val(tv:4))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR8'))
        ifa
        ifa
        IFA
        ACN(fi:1, fac)
        * --- Limpia Totales por Book
        ACN(tt:1, 0 )
        ACN(tt:2, 0 )
        ACN(tt:3, 0 )
        ACN(tt:4, 0 )

        * --- Limpia Totales por vehiculo
        ACN(tv:1, 0 )
        ACN(tv:2, 0 )
        ACN(tv:3, 0 )
        ACN(tv:4, 0 )
     Endif
     ACN(xx:1, 0)
     ACT(xx:3, '')
  Endif

  If Not Eqstr(fbn('Book'), Val(xx:3))
     If Not Eqstr('', Val(xx:3))
        If Val(xx:1)=171 o Val(xx:1)=172
           ACT(a:fac, 'Total Titulos')
        Endif
        If Val(xx:1)=31 o Val(xx:1)=51
           ACT(a:fac, 'Total FX')
        Endif
        If Val(xx:1)=43
           ACT(a:fac, 'Total OCT')
        Endif
        If Val(xx:1)=44
           ACT(a:fac, 'Total Rofex')
        Endif
        If Val(xx:1)=45
           ACT(a:fac, 'Total Internal FX Exposure')
        Endif
        If Val(xx:1)=42
           ACT(a:fac, 'Total FX NDF')
        Endif
        If Val(xx:1)=41
           ACT(a:fac, 'Total FX DF')
        Endif
        * --- Imprime totales por tipo 
        ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
        ACN(m:fac, SUM(m:Val(fi:1)..m:fac) )
        ACN(n:fac, SUM(n:Val(fi:1)..n:fac) )
        ACN(o:fac, SUM(o:Val(fi:1)..o:fac) )
        SetFont(a:fac..z:fac, 3)

        * --- Suma totales para Book
        SCN(tt:1, Val(l:fac) )
        SCN(tt:2, Val(m:fac) )
        SCN(tt:3, Val(n:fac) )
        SCN(tt:4, Val(o:fac) )

        * --- Suma totales para Vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(m:fac) )
        SCN(tv:3, Val(n:fac) )
        SCN(tv:4, Val(o:fac) )

        ifa
        ACT(a:fac,  'Total Book: '~Val(xx:3))
        * --- Imprime Totales paar Book
        ACN(l:fac,Val(tt:1))
        ACN(m:fac,Val(tt:2))
        ACN(n:fac,Val(tt:3))
        ACN(o:fac,Val(tt:4))
        SetFont(a:fac..z:fac, 2)
        AgregarMarco(a:fac..z:fac,0,0)
        ifa
        ifa
        ACN(fi:1, fac)
        * --- Limpia totales para Book
        ACN(tt:1, 0 )
        ACN(tt:2, 0 )
        ACN(tt:3, 0 )
        ACN(tt:4, 0 )
     Endif
     ACN(xx:1,0)
  Endif

  If fbn('NrSaldo')<>Val(xx:1) 
     If Val(xx:1)<>0
        If Val(xx:1)=171 o Val(xx:1)=172
           ACT(a:fac, 'Total Titulos')
        Endif
        If Val(xx:1)=31 o Val(xx:1)=51
           ACT(a:fac, 'Total FX')
        Endif
        If Val(xx:1)=43
           ACT(a:fac, 'Total OCT')
        Endif
        If Val(xx:1)=44
           ACT(a:fac, 'Total Rofex ')
        Endif
        If Val(xx:1)=45
           ACT(a:fac, 'Total Internal FX Exposure')
        Endif
        If Val(xx:1)=42
           ACT(a:fac, 'Total FX NDF')
        Endif
        If Val(xx:1)=41
           ACT(a:fac, 'Total FX DF')
        Endif
        ACN(l:fac, SUM(l:Val(fi:1)..l:fac) )
        ACN(m:fac, SUM(m:Val(fi:1)..m:fac) )
        ACN(n:fac, SUM(n:Val(fi:1)..n:fac) )
        ACN(o:fac, SUM(o:Val(fi:1)..o:fac) )
        SetFont(a:fac..z:fac, 3)

        * --- Suma totales para Book
        SCN(tt:1, Val(l:fac) )
        SCN(tt:2, Val(m:fac) )
        SCN(tt:3, Val(n:fac) )
        SCN(tt:4, Val(o:fac) )

        * --- Suma totales para vehiculo
        SCN(tv:1, Val(l:fac) )
        SCN(tv:2, Val(m:fac) )
        SCN(tv:3, Val(n:fac) )
        SCN(tv:4, Val(o:fac) )

        ifa
        ifa
        ACN(fi:1, fac)
     Endif
  Endif

  ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
  message(Val(a:fac))
  ACT(b:fac, fbn('Cupon'))
  ACD(c:fac, fbn('FechaEj'))

  If Dialogo.Fecha1=fbn('Fecha')
     ACN(d:fac, fbn('CantidadIni'))
     ACN(e:fac, fbn('Cantidad1'))
     ACN(f:fac, -fbn('Cantidad2'))
  Else
     ACN(d:fac, fbn('CantidadFin'))
     ACN(e:fac, 0)
     ACN(f:fac, 0)
  Endif
  ACN(g:fac, fbn('CantidadFin'))
** FJL 11/05/21 - Ver cual va!!!!
*  ACN(h:fac, fbn('PrecioFinCon'))
  ACN(h:fac, fbn('PrecioHistCon'))
  
  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
    ACN(i:fac, 1)
  Else
** FJL 11/05/21 - para resultados contables se usa NIIF
*    ACT(i:fac, CotizacionRanking(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,,,))
    ***---Precio Cierre NIIF
    Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Dialogo.Fecha1, fbn('Book'))
    IF Vacio(&PrecioNIIF)
      ACN(i:FAC, 0)
    ELSE
      ACN(i:FAC, &PrecioNIIF.PrecioCotizacionDeterminada)
    ENDIF

  Endif
*
  If Eqstr(fbn('Especie'),VAR('MONELOCA'))
    ACN(j:fac, 1)
  Else
** FJL 11/05/21 - para resultados contables se usa NIIF
*    ACT(j:fac, CotizacionRanking(fbn('Especie'),,,,habiles(Dialogo.Fecha1,-1,'ARG'),1,SI,,,))
    Let &PrecioNIIF CotizacionNIIF(fbn('Especie'), Habiles(Dialogo.Fecha1,-1,'ARG'), fbn('Book'))
    IF Vacio(&PrecioNIIF)
      ACN(j:FAC, 0)
    ELSE
      ACN(j:FAC, &PrecioNIIF.PrecioCotizacionDeterminada)
    ENDIF
  Endif
  FormatoCeldas(h:fac..j:fac, EXE('F9'))

  ACN(k:fac, Val(g:fac)-Val(d:fac))
  ACN(l:fac, Val(i:fac)*Val(g:fac))

  SetFont(a:fac..z:fac, 1)

  SQL.ADD(" SELECT Day, MTD, YTD, TipoResultado, Fecha FROM "~DBO~".RESULTADOS R  ")
  SQL.ADD(" WHERE Especie   = '"~fbn('Especie')~"'     ")
  SQL.ADD(" AND   NrSaldo   = "~fstr(fbn('NrSaldo'),0,0)~" ")
  SQL.ADD(" AND   Vehiculo  = '"~fbn('Vehiculo')~"'    ")
  SQL.ADD(" AND   Book      = '"~fbn('Book')~"'        ")
  IF Novacio(FBN('FechaEj'))
     SQL.ADD(" AND   FechaEj  = "~idxdate2(FBN('FechaEj'))~" ")
  Endif
  SQL.ADD(" AND   Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   TipoResultado IN ('REVCON') ")
  SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS R1 ")
  SQL.ADD("                 WHERE R.Especie  = R1.Especie  ")
  SQL.ADD("                 AND   R.NrSaldo  = R1.NrSaldo  ")
  SQL.ADD("                 AND   R.Vehiculo = R1.Vehiculo ")
  SQL.ADD("                 AND   R.Book     = R1.Book     ")
  SQL.ADD("                 AND   R.TipoResultado  = R1.TipoResultado    ")
  SQL.ADD("                 AND   (R.Sector   = R1.Sector   OR (R.Sector   IS NULL AND R1.Sector   IS NULL) ) ")
  SQL.ADD("                 AND   (R.CallPut  = R1.CallPut  OR (R.CallPut  IS NULL AND R1.CallPut  IS NULL) ) ")
  SQL.ADD("                 AND   (R.Cupon    = R1.Cupon    OR (R.Cupon    IS NULL AND R1.Cupon    IS NULL) ) ")
  SQL.ADD("                 AND   (R.FechaEj  = R1.FechaEj  OR (R.FechaEj  IS NULL AND R1.FechaEj  IS NULL) ) ")
  SQL.ADD("                 AND   (R.PrecioEj = R1.PrecioEj OR (R.PrecioEj IS NULL AND R1.PrecioEj IS NULL) ) ")
  SQL.ADD("                 AND   R1.Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ) ")
  Recorrer SQL
    dfa
    If Eqstr(fbn('TipoResultado'),'REVCON')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(m:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1) y Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(n:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(o:fac, fbn('YTD'))
       Endif
    Endif

    SetFont(a:fac..z:fac, 1)
    FormatoCeldas(k:fac..z:fac, EXE('F2'))
  Proximo

  FormatoCeldas(d:fac..g:fac, EXE('F2'))
  FormatoCeldas(H:fac..j:fac, EXE('F9'))
  SetFont(a:fac..z:fac, 1)

  ACN(xx:1, fbn('NrSaldo'))
  ACT(xx:2, fbn('Vehiculo'))
  ACT(xx:3, fbn('Book'))
Proximo

