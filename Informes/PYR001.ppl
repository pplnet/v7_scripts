      endif
      ACT(a:fac, fbn('especie'))
      ACL(a:fac,'PYR003',Fecha1=Dialogo.Fecha1,Vehiculo1=Val(z2),Especie1=val(a:fac),Book1=val(z3))
      ACN(b:fac, fbn('CantidadIniSaldo1'))
      ACN(c:fac, fbn('CantidadFinSaldo1'))
      ACN(d:fac, fbn('PmosTomados')-fbn('PmosOtorgados'))
      ACN(e:fac, fbn('PasesActivos')-fbn('PasesPasivos'))
      ACN(f:fac, fbn('GarantiasRecibidas')-fbn('GarantiasEntregadas'))
      ACN(g:fac, fbn('CantidadIniSaldo2'))
