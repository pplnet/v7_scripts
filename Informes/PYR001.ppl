SQL.ADD("select p2.Fecha	, p2.Especie especie, p2.Book book, p2.Vehiculo vehiculo")
SQL.ADD("	, sum(ISNULL(p21.NrSaldo, 0)) NrSaldo1")
SQL.ADD("	, sum(isnull(p21.CantidadIni,0)) CantidadIniSaldo1	, sum(isnull(p21.CantidadFin, 0))CantidadFinSaldo1")
SQL.ADD("	, sum(isnull(p21.PmosOtorgados, 0))PmosOtorgados	, sum(isnull(p21.PmosTomados, 0))PmosTomados")
SQL.ADD("	, sum(isnull(p21.PasesActivos, 0))PasesActivos	, sum(isnull(p21.PasesPasivos, 0))PasesPasivos")
SQL.ADD("	, sum(isnull(p21.GarantiasEntregadas,0))GarantiasEntregadas	, sum(isnull(p21.GarantiasRecibidas, 0))GarantiasRecibidas")
SQL.ADD("	, sum(isnull(p22.NrSaldo,0)) NrSaldo2")
SQL.ADD("	, sum(isnull(p22.CantidadIni,0))CantidadIniSaldo2, sum(isnull(p22.PIHME,0))PIHME")
SQL.ADD("	, sum(isnull(p22.Compras,0))Compras	, sum(isnull(p22.PCME,0))PCME")
SQL.ADD("	, sum(isnull(p22.Ventas,0))Ventas	, sum(isnull(p22.PVME,0))PVME")
SQL.ADD("	, sum(isnull(p22.CantidadFin,0))CantidadFinSaldo2	, sum(isnull(p22.PFHME,0))PFHME")
SQL.ADD("	, sum(isnull(p22.INMFDAY, 0))+sum(isnull(p22.DIMFDAY, 0))+sum(isnull(p22.RRMFDAY, 0))+sum(isnull(p22.CRMFDAY, 0))+sum(isnull(p22.IRMFDAY, 0))+sum(isnull(p22.VRMFDAY, 0))+sum(isnull(p22.DSMFDAY, 0))+sum(isnull(p22.DRMFDAY, 0))+sum(isnull(p22.ICMFDAY, 0))+sum(isnull(p22.IDMFDAY, 0))+sum(isnull(p22.CIMFDAY, 0))+sum(isnull(p22.RTMFDAY, 0)) MFDAY ")
SQL.ADD("	, sum(isnull(p22.INMFMTD, 0))+sum(isnull(p22.DIMFMTD, 0))+sum(isnull(p22.RRMFMTD, 0))+sum(isnull(p22.CRMFMTD, 0))+sum(isnull(p22.IRMFMTD, 0))+sum(isnull(p22.VRMFMTD, 0))+sum(isnull(p22.DSMFMTD, 0))+sum(isnull(p22.DRMFMTD, 0))+sum(isnull(p22.ICMFMTD, 0))+sum(isnull(p22.IDMFMTD, 0))+sum(isnull(p22.CIMFMTD, 0))+sum(isnull(p22.RTMFMTD, 0)) MFMTD ")
SQL.ADD("	, sum(isnull(p22.INMFYTD, 0))+sum(isnull(p22.DIMFYTD, 0))+sum(isnull(p22.RRMFYTD, 0))+sum(isnull(p22.CRMFYTD, 0))+sum(isnull(p22.IRMFYTD, 0))+sum(isnull(p22.VRMFYTD, 0))+sum(isnull(p22.DSMFYTD, 0))+sum(isnull(p22.DRMFYTD, 0))+sum(isnull(p22.ICMFYTD, 0))+sum(isnull(p22.IDMFYTD, 0))+sum(isnull(p22.CIMFYTD, 0))+sum(isnull(p22.RTMFYTD, 0)) MFYTD ")
SQL.ADD("	, sum(isnull(p22.INMCDAY, 0))+sum(isnull(p22.DIMCDAY, 0))+sum(isnull(p22.RRMCDAY, 0))+sum(isnull(p22.CRMCDAY, 0))+sum(isnull(p22.IRMCDAY, 0))+sum(isnull(p22.VRMCDAY, 0))+sum(isnull(p22.DSMCDAY, 0))+sum(isnull(p22.DRMCDAY, 0))+sum(isnull(p22.ICMCDAY, 0))+sum(isnull(p22.IDMCDAY, 0))+sum(isnull(p22.CIMCDAY, 0))+sum(isnull(p22.RTMCDAY, 0)) MCDAY ")
SQL.ADD("	, sum(isnull(p22.INMCMTD, 0))+sum(isnull(p22.DIMCMTD, 0))+sum(isnull(p22.RRMCMTD, 0))+sum(isnull(p22.CRMCMTD, 0))+sum(isnull(p22.IRMCMTD, 0))+sum(isnull(p22.VRMCMTD, 0))+sum(isnull(p22.DSMCMTD, 0))+sum(isnull(p22.DRMCMTD, 0))+sum(isnull(p22.ICMCMTD, 0))+sum(isnull(p22.IDMCMTD, 0))+sum(isnull(p22.CIMCMTD, 0))+sum(isnull(p22.RTMCMTD, 0)) MCMTD ")
SQL.ADD("	, sum(isnull(p22.INMCYTD, 0))+sum(isnull(p22.DIMCYTD, 0))+sum(isnull(p22.RRMCYTD, 0))+sum(isnull(p22.CRMCYTD, 0))+sum(isnull(p22.IRMCYTD, 0))+sum(isnull(p22.VRMCYTD, 0))+sum(isnull(p22.DSMCYTD, 0))+sum(isnull(p22.DRMCYTD, 0))+sum(isnull(p22.ICMCYTD, 0))+sum(isnull(p22.IDMCYTD, 0))+sum(isnull(p22.CIMCYTD, 0))+sum(isnull(p22.RTMCYTD, 0)) MCYTD ")
SQL.ADD("	, sum(isnull(p22.INMLDAY, 0))+sum(isnull(p22.DIMLDAY, 0))+sum(isnull(p22.RRMLDAY, 0))+sum(isnull(p22.CRMLDAY, 0))+sum(isnull(p22.IRMLDAY, 0))+sum(isnull(p22.VRMLDAY, 0))+sum(isnull(p22.DSMLDAY, 0))+sum(isnull(p22.DRMLDAY, 0))+sum(isnull(p22.ICMLDAY, 0))+sum(isnull(p22.IDMLDAY, 0))+sum(isnull(p22.CIMLDAY, 0))+sum(isnull(p22.RTMLDAY, 0)) MLDAY ")
SQL.ADD("	, sum(isnull(p22.INMLMTD, 0))+sum(isnull(p22.DIMLMTD, 0))+sum(isnull(p22.RRMLMTD, 0))+sum(isnull(p22.CRMLMTD, 0))+sum(isnull(p22.IRMLMTD, 0))+sum(isnull(p22.VRMLMTD, 0))+sum(isnull(p22.DSMLMTD, 0))+sum(isnull(p22.DRMLMTD, 0))+sum(isnull(p22.ICMLMTD, 0))+sum(isnull(p22.IDMLMTD, 0))+sum(isnull(p22.CIMLMTD, 0))+sum(isnull(p22.RTMLMTD, 0)) MLMTD ")
SQL.ADD("	, sum(isnull(p22.INMLYTD, 0))+sum(isnull(p22.DIMLYTD, 0))+sum(isnull(p22.RRMLYTD, 0))+sum(isnull(p22.CRMLYTD, 0))+sum(isnull(p22.IRMLYTD, 0))+sum(isnull(p22.VRMLYTD, 0))+sum(isnull(p22.DSMLYTD, 0))+sum(isnull(p22.DRMLYTD, 0))+sum(isnull(p22.ICMLYTD, 0))+sum(isnull(p22.IDMLYTD, 0))+sum(isnull(p22.CIMLYTD, 0))+sum(isnull(p22.RTMLYTD, 0)) MLYTD ")
SQL.ADD("from (	select NrSaldo	, Fecha, Especie, Book, Vehiculo from POSICIONES2 p2 ")
SQL.ADD("               where p2.Fecha='"~IdxDate(Dialogo.Fecha1)~"' and p2.NrSaldo in (1,2)")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("				and (p2.Especie='"~Dialogo.Especie1~"')")
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("				and (p2.Book='"~Dialogo.Book1~"')")
endif
if NoVacio(Dialogo.Vehiculo1)
SQL.ADD("				and (p2.Vehiculo='"~Dialogo.Vehiculo1~"')")
endif
SQL.ADD("		group by p2.NrSaldo, Fecha, Especie, Book, Vehiculo")
SQL.ADD("	)p2 ")
SQL.ADD("		left join ( select Fecha, NrSaldo, Especie, Book, Vehiculo")
SQL.ADD("						, CantidadIni, CantidadFin, PmosOtorgados, PmosTomados, PasesActivos, PasesPasivos, GarantiasEntregadas, GarantiasRecibidas")
SQL.ADD("					from POSICIONES2 p2")
SQL.ADD("					where Fecha='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("						and NrSaldo =1")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("						and (p2.Especie='"~Dialogo.Especie1~"')")
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("						and (p2.Book='"~Dialogo.Book1~"')")
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("						and (p2.Vehiculo='"~Dialogo.Vehiculo1~"')")
endif
SQL.ADD("					)p21 on p2.Fecha=p21.Fecha")
SQL.ADD("							and p2.NrSaldo =p21.NrSaldo")
SQL.ADD("							and p2.Especie=p21.Especie")
SQL.ADD("							and p2.Book=p21.Book")
SQL.ADD("							and p2.Vehiculo=p21.Vehiculo					")
SQL.ADD("		left join	(")
SQL.ADD("						select p22.Fecha")
SQL.ADD("							, p22.NrSaldo, p22.Especie, p22.Book, p22.Vehiculo")
SQL.ADD("							, p22.CantidadIni, p22.PIHME")
SQL.ADD("							, Compras, PCME")
SQL.ADD("							, Ventas, PVME")
SQL.ADD("							, CantidadFin, PFHME")
SQL.ADD("							, INMFDAY, INMFMTD, INMFYTD , INMCDAY , INMCMTD , INMCYTD , INMLDAY , INMLMTD , INMLYTD ")
SQL.ADD("							, DIMFDAY , DIMFMTD , DIMFYTD , DIMCDAY , DIMCMTD , DIMCYTD , DIMLDAY , DIMLMTD , DIMLYTD ")
SQL.ADD("							, RRMFDAY , RRMFMTD , RRMFYTD , RRMCDAY , RRMCMTD , RRMCYTD , RRMLDAY , RRMLMTD , RRMLYTD ")
SQL.ADD("							, CRMFDAY , CRMFMTD , CRMFYTD , CRMCDAY , CRMCMTD , CRMCYTD , CRMLDAY , CRMLMTD , CRMLYTD ")
SQL.ADD("							, IRMFDAY , IRMFMTD , IRMFYTD , IRMCDAY , IRMCMTD , IRMCYTD , IRMLDAY , IRMLMTD , IRMLYTD ")
SQL.ADD("							, VRMFDAY , VRMFMTD , VRMFYTD , VRMCDAY , VRMCMTD , VRMCYTD , VRMLDAY , VRMLMTD , VRMLYTD ")
SQL.ADD("							, DSMFDAY , DSMFMTD , DSMFYTD , DSMCDAY , DSMCMTD , DSMCYTD , DSMLDAY , DSMLMTD , DSMLYTD ")
SQL.ADD("							, DRMFDAY , DRMFMTD , DRMFYTD , DRMCDAY , DRMCMTD , DRMCYTD , DRMLDAY , DRMLMTD , DRMLYTD ")
SQL.ADD("							, ICMFDAY , ICMFMTD , ICMFYTD , ICMCDAY , ICMCMTD , ICMCYTD , ICMLDAY , ICMLMTD , ICMLYTD ")
SQL.ADD("						        , IDMFDAY , IDMFMTD , IDMFYTD , IDMCDAY , IDMCMTD , IDMCYTD , IDMLDAY , IDMLMTD , IDMLYTD ")
SQL.ADD("						        , CIMFDAY , CIMFMTD , CIMFYTD , CIMCDAY , CIMCMTD , CIMCYTD , CIMLDAY , CIMLMTD , CIMLYTD ")
SQL.ADD("							, RTMFDAY , RTMFMTD , RTMFYTD , RTMCDAY , RTMCMTD , RTMCYTD , RTMLDAY , RTMLMTD , RTMLYTD ")
SQL.ADD("						from POSICIONES2 p22")
SQL.ADD("							INNER join RESULTADOS2 r on p22.Fecha=r.Fecha")
SQL.ADD("														and p22.NrSaldo =r.NrSaldo")
SQL.ADD("														and p22.Especie=r.Especie")
SQL.ADD("														and p22.Book=r.Book")
SQL.ADD("														and p22.Vehiculo=r.Vehiculo					")
SQL.ADD("														AND p22.TipoNegocio=r.TipoNegocio")
SQL.ADD("						where p22.Fecha='"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("							and p22.NrSaldo =2")
if NoVacio(Dialogo.Especie1)
  SQL.ADD("							and (p22.Especie='"~Dialogo.Especie1~"')")
endif
if NoVacio(Dialogo.Book1)
  SQL.ADD("							and (p22.Book='"~Dialogo.Book1~"')")
endif
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("							and (p22.Vehiculo='"~Dialogo.Vehiculo1~"')")
endif
SQL.ADD("					)p22 on p2.Fecha=p22.Fecha")
SQL.ADD("							and p2.NrSaldo =p22.NrSaldo")
SQL.ADD("							and p2.Especie=p22.Especie")
SQL.ADD("							and p2.Book=p22.Book")
SQL.ADD("							and p2.Vehiculo=p22.Vehiculo					")
SQL.ADD("	group by p2.Fecha, p2.Especie, p2.Book, p2.Vehiculo")
SQL.ADD("order by p2.Vehiculo, p2.Book, p2.Especie")

    recorrer SQL
