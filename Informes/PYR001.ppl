      ACN(l:fac, fbn('PVME'))
      ACN(m:fac, fbn('CantidadFinSaldo2'))
      ACN(n:fac, fbn('PFHME'))
* aca va el if por moneda
      ACN(o:fac, fbn('MFDAY'))
