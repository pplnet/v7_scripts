          ACT(a:fac, 'Total Book '~Val(z3))
          ACN(o:fac, Val(ay1))
          ACN(p:fac, Val(ay2))
          ACN(q:fac, Val(ay3))
          ACN(r:fac, Val(ay4))
          ACN(s:fac, Val(ay5))
          ACN(t:fac, Val(ay6))
          ACN(u:fac, Val(ay7))
          ACN(v:fac, Val(ay8))
          ACN(w:fac, Val(ay9))
