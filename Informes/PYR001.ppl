CrearDialogo
  Fecha1:'Fecha';;;;;;;;;Fsys
  Vehiculo1:'Vehiculo'
  Book1:'Book'
  Especie1:'Especie'
  Radio1: 'Moneda|Fuerte|Consolidacion|Local'
FinDialogo

if not OK 
  Cancelar
endif


CrearFont(1,"Arial,8,B")
CrearFont(2,"Arial,8,")

ACT(a1, 'Posiciones y Resultados')
ACT(a2, 'Fecha: '~Dialogo.Fecha1)
if NoVacio(Dialogo.Especie1)
  ACT(a3, 'Especie: '~Dialogo.Especie1)
else
  ACT(a3, 'Especie: Todas')
endif
if NoVacio(Dialogo.Vehiculo1)
  ACT(a4, 'Vehiculo: '~Dialogo.Vehiculo1)
else
  ACT(a4, 'Vehiculo: Todos')
endif
if NoVacio(Dialogo.Book1)
  ACT(a5, 'Book: '~Dialogo.Book1)
else
  ACT(a5, 'Book: Todos')
endif
*if Dialogo.Radio1=0
