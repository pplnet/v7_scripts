  Cliente1  : 'Cliente'    ;
  Especie1  : 'Especie'    ;
  Mercado2  :'Mercado Neg.';;;;;;;;;;;;;;" EsNegociacion='SI' "
  Check1    : 'Titulos'    ;;;;  ;;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check5+Dialogo.Check6+Dialogo.Check13 >0;'Debe seleccionar un grupo de operaciones';NO;1;
