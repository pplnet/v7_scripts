ACT(g:FAC+9,'Cant.Especie')
ACT(h:FAC+9,'Cant.Moneda')
ACT(i:FAC+9,'Descripcion')
ACT(j:FAC+9,'Observaciones')
ACT(k:FAC+9,'Conc.')
ACT(l:FAC+9,'Cuenta')
ACT(m:FAC+9,'Mercado Neg')

AlinearCeldas(f:FAC+9..h:FAC+9,'D')
SetFont(a:FAC..m:FAC+9,2)
AgregarMarco(a:FAC+9..m:FAC+9,1,3,Exe('COLOR'))

SetFilaActual(FAC+9)


SQL.ADD("Select M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, M.NrOperacion, ")
SQL.ADD("M.Status, M.NrMov, O.TipoOp Tipo, O.Mercado4 MercaNeg, M.Mercado MercM, M.Cuenta, M.Concepto, O.Mercado MercO, M.Leyenda, O.FechaOp Fecha ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = O.NrOperacion")
SQL.ADD("and M.NrOperacion = B.NrOperacion")
SQL.ADD("and M.Cliente = O.Cliente1 ")
SQL.ADD("and M.NrSaldo = 1 ")
if Dialogo.Check1=0 y Dialogo.Check13=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif

if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif

if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif

if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'PM' ")
endif

if Dialogo.Check5=0
  SQL.ADD("and M.Concepto <> 'OCT' ")
endif

if Dialogo.Check6=0
  SQL.ADD("and M.Concepto <> 'RF' ")
endif

if Dialogo.Check13=0
   SQL.ADD("and M.NrGrupo <> 15   ") 
endif

SQL.ADD("and M.FechaMov >= '09/01/99' ")
SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and M.Bits IN ('MV','MI') ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
*  SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
if NoVacio(Dialogo.Mercado2)
  SQL.ADD("and O.Mercado4 = '"~Dialogo.Mercado2~"' ")
endif
SQL.ADD(" and M.Mercado <> '"~VAR('MERCARGC')~"' ")
SQL.ADD("and ((M.Status <> 'MATCH' or M.Status is NULL) or (M.Status = 'MATCH' and M.Especie = O.Especie)) ")
SQL.ADD("and B.NrBit IN (70,10) ")
SQL.ADD("and B.Valor = '1' ") 
SQL.ADD("union ")
SQL.ADD("Select M.FechaMov, M.Cliente, M.Especie, M.Cupon, M.Cantidad, M.NrOperacion, ")
SQL.ADD("M.Status, M.NrMov, T.TipoTr2 Tipo, O.Mercado4 MercaNeg, M.Mercado MercM, M.Cuenta, M.Concepto, T.Mercado1 MercO, M.Leyenda, T.Fecha1 Fecha")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B, "~DBO~".OPERACIONES O ")
SQL.ADD("where M.NrOperacion = T.NrTrans")
SQL.ADD("and M.NrOperacion = B.NrOperacion")
SQL.ADD("and M.Cliente = T.Cliente1 ")
SQL.ADD("and M.NrSaldo = 1 ")
SQL.ADD("and T.NrOperacionRef1 = O.NrOperacion ")
if Dialogo.Check1=0 y Dialogo.Check13=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif
if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif
if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif
if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'PM' ")
endif
if Dialogo.Check5=0
  SQL.ADD("and M.Concepto <> 'OCT' ")
endif
if Dialogo.Check6=0
  SQL.ADD("and M.Concepto <> 'RF' ")
endif

if Dialogo.Check13=0
   SQL.ADD("and M.NrGrupo <> 15   ") 
Endif


SQL.ADD("and M.FechaMov >= '09/01/99' ")
SQL.ADD("and M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and M.Bits IN ('MV','MI') ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
  SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
endif
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
if NoVacio(Dialogo.Mercado2)
  SQL.ADD("and O.Mercado4 = '"~Dialogo.Mercado2~"' ")
endif
SQL.ADD(" and M.Mercado <> '"~VAR('MERCARGC')~"' ")
SQL.ADD("and ((T.TipoTr2 in ('CCUPON','PCUPON','PIT','CIT','TRANSP') ")
SQL.ADD("      and B.NrBit = 5 ")
SQL.ADD("      and B.Valor = '1') ") 
SQL.ADD("  or (T.TipoTr2 in ('LIQOCT') ")
SQL.ADD("      and B.NrBit = 4 ")
SQL.ADD("      and B.Valor = '1')) ") 
SQL.ADD("Order By 1, 2, 3")

recorrer SQL
  if EqStr(fbn('Status'),'MATCH')
    ACT(x3, BuscarCampo('OPERACIONES','ContraEspecie','NrOperacion',fbn('NrOperacion')))
  else
    ACT(x3, '**')
  endif
  if fbn('FechaMov')<>Val(v1) o Not EqStr(fbn('Cliente'),Val(v2)) o Not EqStr(fbn('Especie'),Val(v3)) o Not EqStr(Val(x3),Val(v4))
    if FAC>Val(w1)+9 y Val(z3)>0
      ACT(f:FAC, 'Total '~Val(v3))
      ACN(Val(x2):FAC, Val(z1))
      if Not EqStr(Val(v4),'**')
        ACT(f:FAC, Val(f:FAC)~'/'~Val(v4))
        ACN(h:FAC, Val(z2))
      endif
      ACN(z1,0)
      ACN(z2,0)
      ACN(z3,0)
      SetFont(f:FAC..h:FAC,2)
      SetFilaActual(FAC+2)
    endif
    if DesciendeDeEspecie(fbn('Especie'),'TITULO') o DesciendeDeEspecie(fbn('Especie'),'CUPON')
      ACN(x2,7)
    else
      ACN(x2,8)
    endif
    if fbn('FechaMov')<>Val(v1)
      if FAC>Val(w1)+9
      AgregarMarco(a:FAC+1..m:FAC+1,2)
        SetFont(a:FAC,2)
        IFA
      endif
      ACN(v1, fbn('FechaMov'))
      ACT(v2, '**')
      ACT(a:FAC, 'Liquidacion del '~Fecha(Val(v1)))
      SetFont(a:FAC,2)
      SetFilaActual(FAC+2)
    endif
    if Not EqStr(fbn('Cliente'),Val(v2))
      ACT(v2, fbn('Cliente'))
      ACT(a:FAC,Val(v2))
    endif
    ACT(v3,fbn('Especie'))
    ACT(v4,Val(x3))
    ACT(b:FAC,Val(v3))
    if Not EqStr(Val(x3),'**')
      ACT(b:FAC, Val(b:FAC)~'/'~Val(x3))
    endif
    SetFont(a:FAC..b:FAC,2)
  endif
  ACT(c:FAC, fbn('NrOperacion'))
  if EqStr(fbn('Status'),'CONF')
    ACT(e:FAC, 'Conf.')
  endif
  if EqStr(fbn('Status'),'MATCH')
    ACT(e:FAC, 'Match')
  endif
  if Incluido(fbn('Status'),'DVP|RVP')
    ACT(e:FAC, fbn('Status'))
  endif
  ACN(Val(x2):FAC, -fbn('Cantidad'))
  if EqStr(fbn('Status'),'MATCH')
    if Incluido(fbn('Tipo'),'TIC|TIFC|TIV|TIFV')
      if BuscarCampo('OPERACIONES','TotalCaucion','NrOperacion',fbn('NrOperacion'))>0
        ACN(y1,BuscarCampo('OPERACIONES','TotalCaucion','NrOperacion',fbn('NrOperacion')))
      else
        ACN(y1,BuscarCampo('OPERACIONES','TotalNetoCli1','NrOperacion',fbn('NrOperacion')))
      endif
      if Incluido(fbn('Tipo'),'TIC|TIFC')
        ACN(h:FAC, -Val(y1))
        SCN(z2, -Val(y1))
      else
        ACN(h:FAC, Val(y1))
        SCN(z2, Val(y1))
      endif
    endif
  endif
  ACT(i:FAC, fbn('Leyenda'))
  if Incluido(Copy(fbn('NrOperacion'),1,2),'VT|I0')
     ACT(d:FAC, fbn('MercM'))
     ACD(f:FAC, fbn('Fecha'))
     if EqStr(Copy(fbn('NrOperacion'),1,2),'VT')
        if Not NoVacio(Val(e:FAC))
           ACT(e:FAC, 'STD')
        endif
        ACT(j:FAC, 'Voucher sin confirmar')
     else
        ACT(e:FAC, 'STD')
        ACT(j:FAC, 'Transaccion sin controlar')
     endif
  else
    ACT(d:FAC, fbn('MercM'))
** FJL 29/03/22 - x Issue EXTBIND-5478
*    ACN(y2,BuscarCampo('OPERACIONES','FormaLiquidacion1','NrOperacion',fbn('NrOperacion')))
*    if Incluido(fbn('MercM'), VAR('MERCTITULO'))
*      if Incluido(fbn('Tipo'),'TIC|TIV')
*        if Val(y2)=0
*          ACT(e:FAC, 'FD&P')
*        endif
*        if Val(y2)=2
*          ACT(e:FAC, 'FOP')
*        endif
*      endif
*      if Incluido(fbn('Tipo'),'TIFC|TIFV')
*        if Val(y2)=0
*          ACT(e:FAC, 'FD&P')
*        endif
*        if vAL(y2)=2
*          ACT(e:FAC, 'FOP')
*        endif
*      endif
*    else
*      if Incluido(fbn('Tipo'),'TIC|TIV|TIFC|TIFV')
*        if Val(y2)=0
*          ACT(e:FAC, 'STD')
*        endif
*      endif
*    endif
*    if Incluido(fbn('Tipo'),'TICO|TICT|TIPO|TIDE')
*      if Val(y2)=0
*        ACT(e:FAC, 'STD')
*      endif
*    endif
    if Incluido(fbn('Tipo'),'TIC|TIV|TIFC|TIFV')
      if Incluido(fbn('MercO'), VAR('MERCADOCV'))
        ACN(y2, BuscarCampo('OPERACIONES','FormaLiquidacion1','NrOperacion',fbn('NrOperacion')))
        if Val(y2)=0
          ACT(e:FAC, 'STD')
        endif
        if Val(y2)=1
          ACT(e:FAC, 'DVP')
        endif
        if Val(y2)=2
          ACT(e:FAC, 'RVP')
        endif
      endif
      if Incluido(fbn('MercO'), VAR('MERCAVARI'))
        ACN(y2, BuscarCampo('OPERACIONES','FormaLiquidacion2','NrOperacion',fbn('NrOperacion')))
        if Val(y2)=0
          ACT(e:FAC, 'FD&P')
        endif
        if Val(y2)=1
          ACT(e:FAC, 'DVP')
        endif
        if Val(y2)=2
          ACT(e:FAC, 'FOP')
        endif
      endif
    endif
    if Incluido(fbn('Tipo'),'TICO|TICT|TIPO|TIDE')
      ACN(y2,BuscarCampo('OPERACIONES','FormaLiquidacion1','NrOperacion',fbn('NrOperacion')))
      if Val(y2)=0
        ACT(e:FAC, 'STD')
      endif
    endif

    ACD(f:FAC, fbn('Fecha'))
    ACN(y3, BuscarCampo('OPERACIONES','PaseCB','NrOperacion',fbn('NrOperacion')))
    if Incluido(fbn('Tipo'),'TIC|TIV') y EqStr(Val(y3),'1')
      ACT(j:FAC, Val(j:FAC)~' Alta de Pase')
    endif
    if Incluido(fbn('Tipo'),'TIFC|TIFV') y EqStr(Val(y3),'1')
      ACT(j:FAC, Val(j:FAC)~' Vto de Pase')
    endif
  endif
  ACT(k:FAC,fbn('Concepto'))
  ACT(l:FAC,fbn('Cuenta'))
  ACT(m:FAC,fbn('MercaNeg'))
  SCN(z1, -fbn('Cantidad'))
  SCN(z3, 1)
  SetFont(c:FAC..l:FAC,1)
proximo

if FAC > Val(w1)+8 y Val(z3) > 0
  IFA
  ACT(f:FAC, 'Total '~Val(v3))
  ACN(Val(x2):FAC, Val(z1))
  if Not EqStr(Val(v4),'**')
    ACT(f:FAC, Val(f:FAC)~'/'~Val(v4))
    ACN(h:FAC, Val(z2))
  endif
  SetFont(f:FAC..h:FAC,2)
endif

