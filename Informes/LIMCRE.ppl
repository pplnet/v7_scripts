ModoReproceso(SinDialogo)
CrearDialogo
   Cliente1 : 'Cliente' ;;;;;;NoVacio(Dialogo.Cliente1) y EsTerminal(Dialogo.Cliente1, Cliente);'Debe Ingresar un Cliente Valido';NO;Dialogo.Cliente1
   Fecha1   : 'Fecha '  ;;;;NO;NO;;;;FSys
FinDialogo
if Not Ok
  Cancelar
endif

CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

SetFilaActual(1)
ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,1)

ACT(a4, 'Limites de Credito por Contraparte')
ACT(a5, 'Cliente: '~Dialogo.Cliente1)
ACT(a6, 'Fecha: '~Fecha(Dialogo.Fecha1))

ACT(a8, 'Tipo Limite')
ACT(a9, 'Credito Otorgado')
ACT(a10,'Credito Recibido')
ACT(a11,'PreSettlement')
ACT(a12,'Contract')
ACT(a13,'Settlement hoy')

ACT(b8,'Monto Asignado')
ACT(c8,'Monto Utilizado')
ACT(d8,'Monto Disponible')
ACT(e8,'Fecha Vto.')
ACT(f8,'Estado')
ACT(g8,'Moneda')

AgregarMarco(a8..g8, 1, 0, Exe('COLOR'))
AgregarMarco(a8..g13, 1)

SetFilaActual(8)
SQL.ADD("Select FVencimiento, Limite, Monto,Especie from "~DBO~".LIMASIGNADOS")
SQL.ADD(" where Cliente = '"~Dialogo.Cliente1~"' and Limite in ('SETTLEMENT','PRESETTLEM','COTOR','CRECI','CONTRACT')")

Recorrer SQL  
  dfa
  if EqStr(fbn('Limite'),'SETTLEMENT')
    ACN(b13, fbn('Monto'))
    ACD(e13, fbn('FVencimiento'))
    ACT(g13, fbn('Especie'))
  else
    if EqStr(fbn('Limite'),'PRESETTLEM')  
      ACN(b11, fbn('Monto'))
      ACD(e11, fbn('FVencimiento'))
      ACT(g11, fbn('Especie'))
    else
      if EqStr(fbn('Limite'),'COTOR')  
         ACN(b9, fbn('Monto'))
         ACD(e9, fbn('FVencimiento'))
         ACT(g9, fbn('Especie'))
      else
        if EqStr(fbn('Limite'),'CRECI')  
          ACN(b10, fbn('Monto'))
          ACD(e10, fbn('FVencimiento'))
          ACT(g10, fbn('Especie'))
        else
          ACN(b12, fbn('Monto'))
          ACD(e12, fbn('FVencimiento'))
          ACT(g12, fbn('Especie'))
        endif
      endif
    endif
  endif
Proximo

ACN(c9 ,LimConsumido(Dialogo.Cliente1,'COTOR',val(g:9),0))
ACN(c10,LimConsumido(Dialogo.Cliente1,'CRECI',val(g:10),0))
ACN(c11,LimConsumido(Dialogo.Cliente1,'PRESETTLEM',val(g:11),0))
ACN(c12,LimConsumido(Dialogo.Cliente1,'CONTRACT',val(g12),0))
*ACN(c13,LimSumado(Dialogo.Cliente1,'SETTLEMENT',Dialogo.Fecha1))
SCN(c13,LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Dialogo.Fecha1))

ACN(d9,Val(b9)-Val(c9))
ACN(d10,Val(b10)-Val(c10))
ACN(d11,Val(b11)-Val(c11))
ACN(d12,Val(b12)-Val(c12))
ACN(d13,Val(b13)-Val(c13))

if Val(c:9)<>0
  AsignarLink(c:9,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,TipoLimite1='COTOR')
endif
if Val(c:10)<>0
  AsignarLink(c:10,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,TipoLimite1='CRECI')
endif
if Val(c:11)<>0
  AsignarLink(c:11,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,TipoLimite1='PRESETTLEM')
endif
if Val(c:12)<>0
  AsignarLink(c:12,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,TipoLimite1='CONTRACT')
endif
if Val(c:13)<>0
  AsignarLink(c:13,'DETLCR',Fecha1=Dialogo.Fecha1,Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
endif

if Val(e:9)<Dialogo.Fecha1 y Val(e:9)>0
  ACT(f:9, 'Vencido')
endif
if Val(e:10)<Dialogo.Fecha1 y Val(e:10)>0
  ACT(f:10, 'Vencido')
endif
if Val(e:11)<Dialogo.Fecha1 y Val(e:11)>0
  ACT(f:11, 'Vencido')
endif
if Val(e:12)<Dialogo.Fecha1 y Val(e:12)>0
  ACT(f:12, 'Vencido')
endif
if Val(e:13)<Dialogo.Fecha1 y Val(e:13)>0
  ACT(f:13, 'Vencido')
endif

if Val(d:9)<0
  if NoVacio(Val(f:9))
    ACT(f:9, Val(f:9)~' - ')
  endif
  ACT(f:9, Val(f:9)~'Excedido')
endif
if Val(d:10)<0
  if NoVacio(Val(f:10))
    ACT(f:10, Val(f:10)~' - ')
  endif
  ACT(f:10, Val(f:10)~'Excedido')
endif
if Val(d:11)<0
  if NoVacio(Val(f:11))
    ACT(f:11, Val(f:11)~' - ')
  endif
  ACT(f:11, Val(f:11)~'Excedido')
endif
if Val(d:12)<0
  if NoVacio(Val(f:12))
    ACT(f:12, Val(f:12)~' - ')
  endif
  ACT(f:12, Val(f:12)~'Excedido')
endif
if Val(d:13)<0
  if NoVacio(Val(f:13))
    ACT(f:13, Val(f:13)~' - ')
  endif
  ACT(f:13, Val(f:13)~'Excedido')
endif

AlinearCeldas(b8..e8, 'D')

ACT(a:14, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,1,'ARG',SI)))
ACT(a:15, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,2,'ARG',SI)))
ACT(a:16, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,3,'ARG',SI)))
ACD(i:14, Habiles(Dialogo.Fecha1,1,'ARG',SI))
ACD(i:15, Habiles(Dialogo.Fecha1,2,'ARG',SI))
ACD(i:16, Habiles(Dialogo.Fecha1,3,'ARG',SI))

ACN(b:14, Val(b:13))
ACN(b:15, Val(b:13))
ACN(b:16, Val(b:13))
ACD(e:14, Val(e:13))
ACD(e:15, Val(e:13))
ACD(e:16, Val(e:13))
*ACN(c14, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Habiles(Dialogo.Fecha1,1,'ARG',SI)))
*ACN(c15, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Habiles(Dialogo.Fecha1,2,'ARG',SI)))
*ACN(c16, LimSumado(Dialogo.Cliente1,'SETTLEMENT',Habiles(Dialogo.Fecha1,3,'ARG',SI)))

SCN(c:14, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Dialogo.Fecha1,1,'ARG',SI)))
SCN(c:15, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Dialogo.Fecha1,2,'ARG',SI)))
SCN(c:16, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Dialogo.Fecha1,3,'ARG',SI)))

ACN(d:14, Val(b:14)-Val(c:14))
ACN(d:15, Val(b:15)-Val(c:15))
ACN(d:16, Val(b:16)-Val(c:16))

if Val(c:14)<>0
  AsignarLink(c:14,'DETLCR',Fecha1=Val(i:14),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
endif
if Val(c:15)<>0
  AsignarLink(c:15,'DETLCR',Fecha1=Val(i:15),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
endif
if Val(c:16)<>0
  AsignarLink(c:16,'DETLCR',Fecha1=Val(i:16),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
endif

if Val(e:14)<Val(i:14) y Val(e:14)>0
  ACT(f:14, 'Vencido')
endif
if Val(e:15)<Val(i:15) y Val(e:15)>0
  ACT(f:15, 'Vencido')
endif
if Val(e:16)<Val(i:16) y Val(e:16)>0
  ACT(f:16, 'Vencido')
endif
if Val(d:14)<0
  if NoVacio(Val(f:14))
    ACT(f:14, Val(f:14)~' - ')
  endif
  ACT(f:14, Val(f:14)~'Excedido')
endif
if Val(d:15)<0
  if NoVacio(Val(f:15))
    ACT(f:15, Val(f:15)~' - ')
  endif
  ACT(f:15, Val(f:15)~'Excedido')
endif
if Val(d:16)<0
  if NoVacio(Val(f:16))
    ACT(f:16, Val(f:16)~' - ')
  endif
  ACT(f:16, Val(f:16)~'Excedido')
endif

SetFilaActual(16)
recorrer&i 4,14
  if LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Dialogo.Fecha1,&i,'ARG',SI))>0
    IFA
    ACT(a:FAC, 'Settlement '~Fecha(Habiles(Dialogo.Fecha1,&i,'ARG',SI)))
    ACN(b:FAC, Val(b13))
    ACD(e:FAC, Val(e13))
    SCN(c:FAC, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Dialogo.Fecha1,&i,'ARG',SI)))
    ACN(d:FAC, Val(b:fac)-Val(c:fac))
    ACD(i:FAC, Habiles(Dialogo.Fecha1,&i,'ARG',SI))
    if Val(c:FAC)<>0
      AsignarLink(c:FAC,'DETLCR',Fecha1=Val(i:FAC),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
    endif
    if Val(e:FAC)<Val(i:FAC) y Val(e:FAC)>0
      ACT(f:FAC, 'Vencido')
    endif
    if Val(d:FAC)<0
      if NoVacio(Val(f:FAC))
        ACT(f:FAC, Val(f:FAC)~' - ')
      endif
      ACT(f:FAC, Val(f:FAC)~'Excedido')
    endif
  endif
proximo

SQL.ADD("Select Distinct FechaMov from "~DBO~".MOVLIMITES ")
SQL.ADD("where Cliente='"~Dialogo.Cliente1~"' ")
SQL.ADD("and Limite='SETCRE' ")
SQL.ADD("and FechaMov >'"~IdxDate(Habiles(Dialogo.Fecha1,14,'ARG',SI))~"' ") 
SQL.ADD("and Monto > 0 ") 
SQL.ADD("order by FechaMov")
Recorrer SQL
  if Habiles(Val(i:FAC-1),1,'ARG',SI)<fbn('FechaMov')
    if LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Val(i:FAC-1),1,'ARG',SI))>0
      IFA
      ACT(a:fac, 'Settlement '~Fecha(Habiles(Val(i:FAC-2),1,'ARG',SI)))
      ACN(b:fac, Val(b13))
      ACD(e:fac, Val(e13))
      SCN(c:fac, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Val(i:FAC-2),1,'ARG',SI)))
      ACN(d:fac, Val(b:fac)-Val(c:fac))
      ACD(i:FAC, Habiles(Val(i:FAC-2),1,'ARG',SI))
      if Val(c:FAC)<>0
        AsignarLink(c:FAC,'DETLCR',Fecha1=Val(i:FAC),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
      endif
      if Val(e:FAC)<Val(i:FAC) y Val(e:FAC)>0
        ACT(f:FAC, 'Vencido')
      endif
      if Val(d:FAC)<0
        if NoVacio(Val(f:FAC))
          ACT(f:FAC, Val(f:FAC)~' - ')
        endif
        ACT(f:FAC, Val(f:FAC)~'Excedido')
      endif
    endif
  endif
  ACT(a:fac, 'Settlement '~fbn('FechaMov'))
  ACN(b:fac, Val(b13))
  ACD(e:fac, Val(e13))
  SCN(c:fac, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,fbn('FechaMov')))
  ACN(d:fac, Val(b:fac)-Val(c:fac))
  ACD(i:FAC, fbn('FechaMov'))
  if Val(c:FAC)<>0
    AsignarLink(c:FAC,'DETLCR',Fecha1=Val(i:FAC),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
  endif
  if Val(e:FAC)<Val(i:FAC) y Val(e:FAC)>0
    ACT(f:FAC, 'Vencido')
  endif
  if Val(d:FAC)<0
    if NoVacio(Val(f:FAC))
      ACT(f:FAC, Val(f:FAC)~' - ')
    endif
    ACT(f:FAC, Val(f:FAC)~'Excedido')
  endif
proximo
if LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Val(i:FAC),1,'ARG',SI))>0
  IFA
  ACT(a:fac, 'Settlement '~Fecha(Habiles(Val(i:FAC-1),1,'ARG',SI)))
  ACN(b:fac, Val(b13))
  ACD(e:fac, Val(e13))
  SCN(c:fac, LimConsumido(Dialogo.Cliente1,'SETCRE',val(g13),0,,,,,Habiles(Val(i:FAC-1),1,'ARG',SI)))
  ACN(d:fac, Val(b:fac)-Val(c:fac))
  ACD(i:FAC, Habiles(Val(i:FAC-1),1,'ARG',SI))
  if Val(c:FAC)<>0
    AsignarLink(c:FAC,'DETLCR',Fecha1=Val(i:FAC),Cliente1=Dialogo.Cliente1,TipoLimite1='SETCRE')
  endif
  if Val(e:FAC)<Val(i:FAC) y Val(e:FAC)>0
    ACT(f:FAC, 'Vencido')
  endif
  if Val(d:FAC)<0
    if NoVacio(Val(f:FAC))
      ACT(f:FAC, Val(f:FAC)~' - ')
    endif
    ACT(f:FAC, Val(f:FAC)~'Excedido')
  endif
endif

AgregarMarco(a8..a:fac, 1)
AgregarMarco(e8..e:fac, 1)
AgregarMarco(a14..g:fac, 1)

SetFont(a1..az:8, 1)
