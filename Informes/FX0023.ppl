ModoReproceso(ConDialogo)
MostrarCuadroDeMensajes

CrearDialogo
  Fecha1:    'Fecha'                         ;;;;;;;;;FSYS
  Especie1 : 'Moneda'                        ;;;;;;;;;;;;;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Radio4   : '|C/V|Opciones|Todo'            ;;;;NO;NO;;;;2
  Radio2:    'Posicion|Spot|Forward|Ambos'   ;;;;;;;;;2
  Radio1:    'Cartera|Trading|General|Ambas' ;;;;NO;NO;;;;2
  Vehiculo1 : 'Vehiculo'   ;;;;;;[NoVacio(Dialogo.Vehiculo1)] Y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) O Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;Var('VEHICULODE');;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo))," Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");;;;;
  Book1:      'Book'                  ;;;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
FinDialogo

If Not Ok
  Cancelar
Endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,11,B")
CrearFont(4,"Arial,9,BI")
CrearFont(5,"Arial,8,I")

SetFilaActual(2)

AgregarBMP(a1,Exe('LOGO'),90)
SetFont(a:1,2)

ACT(a:2, 'Fecha: '~Dialogo.Fecha1)

If NOVACIO(Dialogo.Especie1)
   ACT(a:3, 'Moneda: '~Dialogo.Especie1~'  '~BuscarCampo('Especies','Nombre','Codigo',Dialogo.Especie1))
Else
   ACT(a:3, 'Moneda: Todas')
Endif
ACT(a:4, 'Vehiculo : '~Dialogo.Vehiculo1~'  '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
SetFilaActual(4)
ifa
IF NoVacio(Dialogo.Book1)
    ACT(A:fac, 'Book: '~Dialogo.Book1)
ELSE
    ACT(A:fac, 'Book: Todos')
ENDIF
ifa
ACT(c:fac, " Detalle de lo Operado en Dia - ")
If Dialogo.Radio2=0
  ACT(c:fac, Val(c:fac)~'Spot' )
Else
  If Dialogo.Radio2=1
    ACT(c:fac, Val(c:fac)~'Forward' )
  Else
    ACT(c:fac, Val(c:fac)~'Spot y Forward' )
  Endif
Endif

SetFont(a:2..z:fac,2)
SetFont(c:fac, 3)

SetFilaActual(fac+2)

act(a:fac,'Plazo')
act(b:fac,'                         Compras')
act(d:fac,'                         Ventas')
act(f:fac,'                         Descalce')
act(h:fac,'Posicion')
act(b:fac+1,'Cantidad')
act(c:fac+1,'Precio')
act(d:fac+1,'Cantidad')
act(e:fac+1,'Precio')
act(f:fac+1,'Cantidad')
act(g:fac+1,'Caja Utilizada')

ACN(FI:1, fac+1)

AgregarMarco(a:fac..h:fac+1,1,0,Exe('COLOR6'))
AgregarMarco(a:fac..a:fac+1,1,0)
AgregarMarco(b:fac..c:fac,1,0)
AgregarMarco(d:fac..e:fac,1,0)
AgregarMarco(f:fac..g:fac,1,0)
AgregarMarco(b:fac+1..c:fac+1,1,0)
AgregarMarco(c:fac+1..d:fac+1,1,0)
AgregarMarco(d:fac+1..e:fac+1,1,0)
AgregarMarco(e:fac+1..f:fac+1,1,0)
AgregarMarco(f:fac+1..g:fac+1,1,0)
AgregarMarco(g:fac+1..g:fac+1,1,0)

SetFont(a:fac..z:fac+1,2)
AlinearCeldas(a:8..h:9, 'C')

SQL.ADD(" SELECT O.TipoOp, O.Cantidad, ")
SQL.ADD("        Especie = Case When M.Cantidad < 0 AND O.TipoOp IN ('FXA','FXAT') Then O.ContraEspecie ")
SQL.ADD("        When O.TipoOp = 'FXP' Then M.Especie ")
SQL.ADD("        Else O.Especie END, ")
SQL.ADD(" FechaVto = CASE WHEN O.TipoOp = 'FXP' AND (M.NrSaldo = 11 or M.NrSaldo = 31 OR M.NrSaldo = 35) THEN O.FechaAltaMAE ")
SQL.ADD("            When O.TipoOp = 'FXP' AND (M.NrSaldo = 21 or M.NrSaldo=41 OR M.NrSaldo = 45) THEN O.FechaVto ")
SQL.ADD("            When O.TipoOp IN ('FXCC', 'FXVC') Then O.FechaOp ")
SQL.ADD("                 ELSE O.FechaVto END, ")
SQL.ADD(" O.Precio1, E.Nombre, O.PrecioEj, O.FechaEj, ")
SQL.ADD(" FX = Case When M.Cantidad > 0 Then 'Compra' ")
SQL.ADD("           When M.Cantidad < 0 Then 'Venta' END, ")
SQL.ADD(" O.TotalBrutoCli1, O.Cotizacion1, O.Cotizacion2, O.NrOperacion, ")
SQL.ADD(" O.TotalBrutoCli2, O.Precio4, O.Plazo, O.TasaBase, O.ContraEspecie, ")
SQL.ADD(" M.NrSaldo, M.CallPut, O.TotalNetoCli3, O.Book1 ")
SQL.ADD(" FROM "~DBO~".OPERACIONES O, "~DBO~".ESPECIES E, "~DBO~".MOVPOSEJE M ")
SQL.ADD(" Where O.NrOperacion = M.NrOperacion ")
SQL.ADD(" AND   E.Codigo      = M.Especie     ")
SQL.ADD(" AND   O.Especie     = M.Especie     ")
SQL.ADD(" AND   O.FechaOp     = '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD(" AND   M.FechaMov    = '"~IdxDate(Dialogo.Fecha1)~"' ")
IF NoVacio(Dialogo.Book1)
   SQL.ADD(" AND O.Book1 = '"~Dialogo.Book1~"' ")
ENDIF
IF NOVACIO(Dialogo.Vehiculo1)
   SQL.ADD(" AND O.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
ENDIF
If NoVacio(Dialogo.Especie1)
  If Dialogo.Radio4=0
    SQL.ADD(" AND (('"~Dialogo.Especie1~"' = O.Especie AND O.TipoOp Not IN ('FXP','FXA','FXAT','FXCJ')) OR (O.TipoOp = 'FXP' AND M.Especie = '"~Dialogo.Especie1~"') OR (O.TipoOp IN ('FXA','FXAT','FXCJ') AND ((O.Especie = '"~Dialogo.Especie1~"' AND M.Cantidad > 0) OR (O.ContraEspecie = '"~Dialogo.Especie1~"' AND M.Cantidad < 0)))) ")
  Else
    SQL.ADD(" AND ('"~Dialogo.Especie1~"' = O.Especie)")
  Endif
Endif
IF Dialogo.Radio2 = 0
   * Contado
   SQL.ADD(" AND (M.NrSaldo = 31 OR M.NrSaldo = 11 OR M.NrSaldo = 35) ")
ENDIF
IF Dialogo.Radio2 = 1
   * Futuro
   SQL.ADD(" AND (M.NrSaldo=41 OR M.NrSaldo=42 OR M.NrSaldo=43 OR M.NrSaldo=44 OR M.NrSaldo = 21 OR M.NrSaldo = 45) ")
ENDIF
IF Dialogo.Radio2 = 2
   * Contado y Futuro
   SQL.ADD(" AND (M.NrSaldo=31 OR M.NrSaldo=11 OR M.NrSaldo=35 OR M.NrSaldo=41 OR M.NrSaldo=42 OR M.NrSaldo=43 OR M.NrSaldo=44 OR M.NrSaldo=21 OR M.NrSaldo=45) ")
ENDIF
IF Dialogo.Radio4 = 0
   * Compra/Venta
   SQL.ADD(" AND (M.NrSaldo = 31 OR M.NrSaldo = 11 OR M.NrSaldo=41 OR M.NrSaldo=42 OR M.NrSaldo=43 OR M.NrSaldo=44 OR M.NrSaldo = 21) ")
ENDIF
IF Dialogo.Radio4 = 1
   * Opciones
   SQL.ADD(" AND (M.NrSaldo = 35 OR M.NrSaldo = 45) ")
ENDIF
SQL.ADD(" ORDER BY O.Book1, 3, O.FechaVto, O.NrOperacion ")

ACT(ea:1, '' )
ACT(CA:1, '' )
ACD(fj:1, 0)
ACN(pj:1, 0)
ACT(cp:1, '' )

ACD(fa:1, 0)
ACN(tv:1, 0)
ACN(tv:2, 0)
ACN(tc:1, 0)
ACN(tc:2, 0)
ACN(tv:3, 0)
ACN(tc:3, 0)
ACN(tv:4, 0)
ACN(tc:4, 0)

ACN(z:1,0)

Recorrer SQL
 message(fbn('Especie'))
 IF CeldaVacia(BK:1)
    ifa
    ACT(A:fac, 'Book: '~fbn('Book1'))
    SetFont(A:fac, 4)
    AgregarMarco(a:fac..H:fac,0,0,EXE('COLOR6'))
    ifa
 ENDIF
 If Not Eqstr(fbn('Especie'), Val(ea:1)) o Not Eqstr(fbn('CallPut'), Val(cp:1)) o fbn('PrecioEj')<>Val(pj:1) o [fbn('FechaEj')<>Val(fj:1) y Incluido(fbn('TipoOp'), 'FCC|FVC|FVP|FCP')] O [Not CeldaVacia(BK:1) Y Not Eqstr(fbn('Book1'), Val(BK:1))]
   If Val(z:1)<>0
     ifa
     ACN(b:fac, Val(tc:3))
     ACN(D:fac, Val(TV:3))
     ACN(CB:5, IIF(Eqstr(Modo(Val(EA:1), Var('MONELOCA')), 'INV'), 0, 1))
     IF Val(CB:5) = 1
        ACN(c:fac, Val(tc:4)/Val(tc:3))
        ACN(e:fac, Val(tv:4)/Val(tv:3))
     ELSE
        ACN(C:fac, Val(TC:3)/Val(TC:4))
        ACN(E:fac, Val(TV:3)/Val(TV:4))
     ENDIF
     ACN(h:fac, Val(tc:3)-Val(tv:3))
     ACT(a:fac, 'Total operado ->')

     If Not Incluido(fbn('CallPut'), 'CAL|PUT')
       IF Val(B:fac) <> 0
          AsignarLink(b:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=Val(BK:1), Fecha2=0)
       ENDIF
       IF Val(D:fac) <> 0
          AsignarLink(d:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=Val(BK:1), Fecha2=0)
       ENDIF
       AsignarLink(h:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=IIF(Val(B:fac)<>0, IIF(Val(D:fac)<>0, 2, 0), IIF(Val(D:fac)<>0,1, 0)),Radio4=0, Book1=Val(BK:1), Fecha2=0)
     Else
       IF Val(B:fac) <> 0
          AsignarLink(b:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=1, Book1=Val(BK:1), Fecha2=0)
       ENDIF
       IF Val(D:fac) <> 0
          AsignarLink(d:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=1, Book1=Val(BK:1), Fecha2=0)
       ENDIF
       AsignarLink(h:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=IIF(Val(B:fac)<>0, IIF(Val(D:fac)<>0, 2, 0), IIF(Val(D:fac)<>0,1, 0)),Radio4=1, Book1=Val(BK:1), Fecha2=0)
     Endif

     AgregarMarco(a:fac..h:fac,0,0)
     SetFont(a:fac..h:fac, 5)
     ifa
     ifa
     IF Not Eqstr(fbn('Book1'), Val(BK:1))
         ACT(A:fac, 'Book: '~fbn('Book1'))
         SetFont(A:fac, 4)
         AgregarMarco(a:fac..H:fac,0,0,EXE('COLOR6'))
         ifa
     ENDIF
   Endif

   ACN(z:1,1)
   ifa
   ACT(ea:1, fbn('Especie'))
   ACT(cp:1, fbn('CallPut'))
   ACD(fj:1, fbn('FechaEj'))
   ACN(pj:1, fbn('PrecioEj'))
   ACT(BK:1, fbn('Book1'))

   ACD(fa:1, 0)
   ACN(tv:3, 0)
   ACN(tc:3, 0)
   ACN(tv:4, 0)
   ACN(tc:4, 0)
   If Not Incluido(fbn('CallPut'), 'CAL|PUT')
     ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
   Else
     ACT(a:fac, fbn('Especie')~' - '~fbn('CallPut')~' - '~fbn('FechaEj')~' - '~PyC(fbn('PrecioEj'),1,8))
   Endif

   AgregarMarco(a:fac..h:fac,0,0,EXE('COLOR8'))
   SetFont(a:fac, 4)
   ifa
 Endif

 If fbn('FechaVto')<>Val(fa:1)
   ACD(fa:1, fbn('FechaVto'))
   ACD(a:fac, fbn('FechaVto'))
   If Not Incluido(fbn('CallPut'), 'CAL|PUT')
     AsignarLink(a:fac, 'FX0025',Fecha1=fbn('FechaVto'),Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=2,Radio4=0, Fecha2=Dialogo.Fecha1, Book1=fbn('Book1'))
   Else
     AsignarLink(a:fac, 'FX0025',Fecha1=fbn('FechaVto'),Especie1=fbn('Especie'),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=2,Radio4=1, Fecha2=Dialogo.Fecha1, Book1=fbn('Book1'))
   Endif
   ACN(tv:1, 0)
   ACN(tv:2, 0)
   ACN(tc:1, 0)
   ACN(tc:2, 0)
 Else
   dfa
 Endif

 ACN(CB:5, IIF(Eqstr(Modo(fbn('Especie'), Var('MONELOCA')), 'INV'), 0, 1))
 ACN(CB:6, IIF(Eqstr(Modo(fbn('ContraEspecie'), Var('MONELOCA')), 'INV'), 0, 1))
 If Incluido(fbn('TipoOp'), 'FXC|FXCT|FCC|FCP') o [Incluido(fbn('TipoOp'),'FXA|FXAT') y Eqstr(fbn('FX'),'Compra')] O [Eqstr(fbn('TipoOp'), 'FXP') Y Buscar('Compra', fbn('FX'))]
   ***---Opciones y Compras de Pases y Arbitrajes
   ACN(CT:1, fbn('Cantidad'))
 ELSE
   ***---Ventas de Pases y Arbitrajes
   ACN(CT:1, fbn('TotalBrutoCli1'))
 ENDIF
 IF Incluido(fbn('TipoOp'), 'FXA|FXAT')
     IF [Eqstr(fbn('TipoOp'), 'FXA')]
         IF Eqstr(fbn('FX'), 'Compra')
             ACN(PC:1, fbn('Cotizacion1'))
         ELSE
             ACN(PC:1, fbn('Cotizacion2'))
         ENDIF
     ELSE
         ACN(PC:1, fbn('Cotizacion1')+(fbn('Precio4')*fbn('Plazo')/36500))
     ENDIF
     IF Eqstr(fbn('FX'), 'Compra')
         ACN(TC:9, IIF(Val(CB:5)=1, Val(CT:1)*Val(PC:1), Val(CT:1)/Val(PC:1)))
     ELSE
         ACN(TC:9, IIF(Val(CB:6)=1, Val(CT:1)*Val(PC:1), Val(CT:1)/Val(PC:1)))
     ENDIF
 ENDIF

 If Incluido(fbn('TipoOp'), 'FXC|FXCT|FCC|FCP|FXCC') o [Incluido(fbn('TipoOp'),'FXA|FXAT') y Eqstr(fbn('FX'),'Compra')] O [Eqstr(fbn('TipoOp'), 'FXP') Y Eqstr('Compra', fbn('FX'))] O [Eqstr(fbn('TipoOp'), 'FXCJ') Y Eqstr('Compra', fbn('FX'))]
   ***---Opciones y Compras de Pases y Arbitrajes
   If Incluido(fbn('TipoOp'),'FXA|FXAT')
       SCN(b:fac, fbn('Cantidad'))
       SCN(tc:1, fbn('Cantidad'))
       SCN(tc:3, fbn('Cantidad'))
       SCN(tc:2, Val(TC:9))
       SCN(tc:4, Val(TC:9))
   Else
       SCN(b:fac, fbn('Cantidad'))
       SCN(tc:1, fbn('Cantidad'))
       SCN(tc:3, fbn('Cantidad'))
       SCN(tc:2, fbn('Cantidad')*fbn('Precio1'))
       SCN(tc:4, fbn('Cantidad')*fbn('Precio1'))
   Endif
 Else
   ***---Ventas de Pases y Arbitrajes
   If Incluido(fbn('TipoOp'),'FXA|FXAT')
     SCN(d:fac, fbn('TotalBrutoCli1'))
     SCN(tv:1, fbn('TotalBrutoCli1'))
     SCN(tv:3, fbn('TotalBrutoCli1'))
     SCN(tv:2, Val(TC:9))
     SCN(tv:4, Val(TC:9))
   Else
     SCN(d:fac, fbn('Cantidad'))
     SCN(tv:1, fbn('Cantidad'))
     SCN(tv:3, fbn('Cantidad'))
     SCN(tv:2, fbn('Cantidad')*fbn('Precio1'))
      SCN(tv:4, fbn('Cantidad')*fbn('Precio1'))
   Endif
 Endif

 IF Val(CB:5) = 1
    ACN(c:fac, Val(tc:2)/Val(tc:1))
    ACN(e:fac, Val(tv:2)/Val(tv:1))
 ELSE
    ACN(C:fac, Val(TC:1)/Val(TC:2))
    ACN(E:fac, Val(TV:1)/Val(TV:2))
 ENDIF
 ACN(f:fac, Val(d:fac)-Val(b:fac))
 ACN(g:fac, Val(tv:2)-Val(tc:2))
 ACN(h:fac, Val(tc:1)-Val(tv:1))
 SCN(tp:1, Val(h:fac))
 SetFont(a:fac..z:fac, 1)
Proximo

ifa
ifa
ACN(b:fac, Val(tc:3))
ACN(d:fac, Val(tv:3))
IF Val(CB:5) = 1
   ACN(c:fac, Val(tc:4)/Val(tc:3))
   ACN(e:fac, Val(tv:4)/Val(tv:3))
ELSE
   ACN(C:fac, Val(TC:3)/Val(TC:4))
   ACN(E:fac, Val(TV:3)/Val(TV:4))
ENDIF
ACN(h:fac, Val(tc:3)-Val(tv:3))
ACT(a:fac, 'Total operado ->')

If Not Incluido(Val(cp:1), 'CAL|PUT')
  IF Val(B:fac) <> 0
     AsignarLink(b:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=Val(BK:1), Fecha2=Val(fj:1))
  ENDIF
  IF Val(D:fac) <> 0
     AsignarLink(d:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=Val(BK:1), Fecha2=Val(fj:1))
  ENDIF
  AsignarLink(h:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=IIF(Val(B:fac)<>0, IIF(Val(D:fac)<>0, 2, 0), IIF(Val(D:fac)<>0,1, 0)),Radio4=0, Book1=Val(BK:1), Fecha2=Val(fj:1))
Else
  IF Val(B:fac) <> 0
     AsignarLink(b:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=1, Book1=Val(BK:1), Fecha2=Val(fj:1))
  ENDIF
  IF Val(D:fac) <> 0
     AsignarLink(d:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=1, Book1=Val(BK:1), Fecha2=Val(fj:1))
  ENDIF
  AsignarLink(h:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=Val(ea:1),Radio2=Dialogo.Radio2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Radio3=IIF(Val(B:fac)<>0, IIF(Val(D:fac)<>0, 2, 0), IIF(Val(D:fac)<>0,1, 0)),Radio4=1, Book1=Val(BK:1), Fecha2=Val(fj:1))
Endif

AgregarMarco(a:fac..h:fac,0,0)
SetFont(a:fac..h:fac, 5)

ifa
ifa
ifa

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac, 2)

FormatoCeldas(b:10..h:fac, EXE('F2'))
FormatoCeldas(c:10..c:fac, EXE('F9'))
FormatoCeldas(e:10..e:fac, EXE('F9'))

FijarFila(Val(FI:1)+1)

ACO(1, 10)
ACO(2, 10)
ACO(3, 8)
ACO(4, 10)
ACO(5, 8)
ACO(6, 10)
ACO(7, 10)
ACO(8, 10)
ACO(9, 2)

RangoTitulo(A:1..I:fac+2, Val(FI:1))
LimitesVision(i:fac+2)
Impresion(1,2)
Impresion(4,1)
