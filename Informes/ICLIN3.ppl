ModoReproceso(SINDIALOGO)
CrearDialogo
  Cliente1 : 'Cliente'       ;1;1;;;;;;
  Fecha1   : 'Fecha'         ; ; ;;;;Dialogo.Fecha1<>0;'Debe Ingresar una Fecha' ;NO;Habiles(FSys,-1,var('FERIDEF'),SI);
  Lista1   : 'Books'         ; ; ;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS")  
  Check1   : 'Precancelados' ; ; ;;;;;;;0;
FinDialogo

If Not Ok
   Cancelar
EndIf

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))
ACD(pm:1,PrideMes(Dialogo.Fecha1,SI))
SetFilaActual(4)
ACT(f:fac,'ICL - Intereses devengados a fin de mes')
SetFont(f:fac,3)
SetFilaActual(fac+2)
If NoVacio(Dialogo.Cliente1)
   ACT(a:fac,'Cliente:')
   ACT(b:fac,'('~Dialogo.Cliente1~') '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
Else
   ACT(a:fac,'Clientes:')
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,'Fecha:')
ACT(b:fac,Dialogo.Fecha1)
SetFont(a:fac..b:fac,2)
IFA
ACT(a:fac,'Books:')
If NoVacio(Dialogo.Lista1)
   ACT(b:fac,Dialogo.Lista1)
Else
   ACT(b:fac,'Todos')
EndIf
SetFont(a:fac..b:fac,2)
IFA
ACT(a:fac,'Precancelados:')
If Dialogo.Check1=1
   ACT(b:fac,'SI')
else   
   ACT(b:fac,'NO')
endif
SetFont(a:fac..b:fac,2)
IFA

ACT(a:fac,  'Operacion')
ACT(b:fac,  'Fecha Op.')
ACT(c:fac,  'Fecha Vto.')
ACT(c:fac+1,'Final')
ACT(d:fac  ,'Entidad')
ACT(e:fac  ,'Tipo Op.')
ACT(f:fac  ,'Especie')
ACT(g:fac  ,'Saldo')
ACT(h:fac  ,'Tasa')
ACT(i:fac  ,'Tasa Base')
ACT(j:fac  ,'Tasa Spread')
ACT(k:fac  ,'Plazo Total')
ACT(l:fac  ,'Dias Trans.')
ACT(m:fac  ,'Intereses')
ACT(m:fac+1,'Deveng.Total')
ACT(n:fac  ,'Intereses')
ACT(n:fac+1,'Deveng.Fecha')

AlinearCeldas(a:fac..yx:fac+1,'C')
SetFont(a:fac..y:fac+1,2)
AgregarMarco(a:fac..n:fac+1,2,0,EXE('COLOR'))
ACN(z:1,fac+1)
ifa
ifa
SQL.ADD(" SELECT * FROM ( ")
SQL.ADD(" Select O.NrOperacion, O.Cliente1, O.Especie, O.TipoOp, O.Cantidad, O.FechaOp, O.FechaVto, ")
SQL.ADD("  O.Precio1 as Tasa, O.TipoTasa as CodTasa, O.Spread, O.Especie1 as CodSpread, O.Plazo, O.DiasAnio, O.Book1, O.CB1, ")
SQL.ADD(" (Select "~DBO~".SaldoCONU(NrOperacion,'"~IdxDate(Dialogo.Fecha1)~"',2)) SaldoHoy, ")
SQL.ADD(" (Select "~DBO~".SaldoCONU(NrOperacion,'"~IdxDate(val(pm:1))~"',2)) SaldoPri ")
SQL.ADD(" from "~DBO~".OPERACIONES O ")
SQL.ADD(" where (FechaVto >= "~IdxDate2(Dialogo.Fecha1)~"  or CB1=1 ) ")
SQL.ADD("   and FechaOp < "~IdxDate2(Dialogo.Fecha1))
SQL.ADD("   and TipoOp in ('CONU')")
If NoVacio(Dialogo.Cliente1)
   SQL.ADD(" and O.Cliente1 = '"~Dialogo.Cliente1~"' ")
EndIf
If NoVacio(Dialogo.Lista1)
   SQL.ADD(" and O.Book1 In ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
SQL.ADD(" ) Intereses ")
SQL.ADD(" WHERE ((FechaVto >= "~IdxDate2(Dialogo.Fecha1)~")  or (SaldoHoy>0) ") 
if Dialogo.Check1=1
   SQL.ADD(" or (CB1=1 and SaldoPri>0  ) ") 
endif
SQL.ADD(" ) ORDER BY Book1 ")
watch(SQL.Batch)
acn(w:1,fac+1)
acn(ag:1,0)
acn(am:1,0)
acn(an:1,0)
Recorrer SQL
        if Not Eqstr(fbn['Book1'],val(bo:1))
           if Novacio(val(bo:1))
               acn(g:fac,val(ag:1))
               acn(m:fac,val(am:1))
               acn(n:fac,val(an:1))
               acn(ag:1,0)
               acn(am:1,0)
               acn(an:1,0)
               ifa
               ifa
           ENDIF    
           act(a:fac,'Book: '~fbn['Book1']~' - '~BuscarCampo('BOOKS','Descripcion','Codigo',fbn['Book1']))
           SetFont(a:fac..z:fac,2)
           ifa
        endif
        Message(FBN['NrOperacion'])
        
        ACT(a:fac,FBN['NrOperacion'])
        ACLO(a:fac,FBN['NrOperacion'])
        ACD(b:fac,FBN['FechaOp'])
        ACD(ar:fac,FindeMes(Dialogo.Fecha1,SI))

        if FBN['FechaVto']>0
           ACD(c:fac,FBN['FechaVto'])
           if val(ar:fac)>val(c:fac)
              ACD(ar:fac,val(c:fac))
           endif
        endif    
        ACT(d:fac,FBN['Cliente1'])
        ACT(e:fac,FBN['TipoOp'])
        ACT(f:fac,FBN['Especie'])
        ACN(g:fac, FBN['SaldoHoy'])
        ACN(h:fac,FBN['Tasa'])
        ACT(i:fac,FBN['CodTasa'])
        ACN(j:fac,FBN['Spread'])
        if FBN['FechaVto']>0
           ACN(k:fac,FBN['FechaVto']-FBN['FechaOp'])
        endif    
        ACN(l:fac,Dialogo.Fecha1-FBN['FechaOp']+1)
        ACN(m:fac,SQL("SELECT SUM(Monto) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha>="~IdxDate2(val(pm:1))~" and Fecha<="~IdxDate2(Dialogo.Fecha1)))
        ACN(n:fac,SQL("SELECT SUM(Monto) FROM "~DBO~".MOVDEVENGADOS WHERE NrOperacion='"~FBN['NrOperacion']~"' and Fecha="~IdxDate2(Dialogo.Fecha1)))
        ACT(bo:1,fbn['Book1'])
        SCN(ag:1,val(g:fac))
        SCN(am:1,val(m:fac))
        SCN(an:1,val(n:fac))
Proximo
SetFont(a:fac..z:fac,1)
ifa
acn(g:fac,val(ag:1))
acn(m:fac,val(am:1))
acn(n:fac,val(an:1))
SetFont(a:fac..z:fac,2)
FormatoCeldas(g:val(w:1)..s:fac,EXE('F2'))
FormatoCeldas(h:val(w:1)..j:fac,EXE('F6'))
FormatoCeldas(k:val(w:1)..l:fac,EXE('F0'))
FormatoCeldas(r:val(w:1)..r:fac,EXE('F0'))
SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL LISTADO')
SetFont(a:fac,2)

*Impresion(1,2)
*Impresion(2,1)
*Impresion(3,1)
*Impresion(4,1)

LimitesVision(o:fac)
*Rangotitulo(a:1..m:fac,Val(z:1))
SetPrintFit(3, 50)

ACO(1,9)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,6)
ACO(7,10)
ACO(8,10)
ACO(9,6)
ACO(10,9)
ACO(11,7)
ACO(12,7)
ACO(13,10)
ACO(14,10)
ACO(15,1)
