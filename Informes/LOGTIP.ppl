CrearDialogo
  Fecha1  : 'Desde'     ;;;;;;;;;Hoy
  Fecha2  : 'Hasta'     ;;;;;;;;;Hoy
  Operador: 'Usuario'
  Check1  : 'Resumido'  ;;;;;;;;;0;
  Lista1  : 'Tablas'    ;1;2;;;;;;;;;'|INFORMES|EVENTOS|FUNCIONES|FORMULAS|TIPOSOPERACION|TIPOSORDEN|TIPOSMINUTABOLSA|TIPOSTRANSACCION2|ESPECIES'
FinDialogo
if not Ok
  Cancelar
endif

AgregarBMP(a1,Exe('LOGO'),50)

CrearFont(3, 'Arial,11,B')
CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

ACT(a3, 'Log Total de Modificaciones')
SetFont(a3..a3, 3)


ACT(a5, 'Fecha : '~Dialogo.Fecha1)
ACT(a6, 'Archivo : Parametrizacion ' )
ACT(a7, 'Usuario')
ACT(b7, 'Fecha')
ACT(c7, 'Accion')
ACT(d7, 'Tabla')
ACT(e7, 'Codigo')
ACT(f7, 'Campo')
ACT(g7, 'Val.Anterior')
ACT(h7, 'Val.Actual')

SetFilaActual(7)
If Dialogo.Check1=1
  SQL.ADD("select Distinct Tabla,Codigo ")
Else
  SQL.ADD("select Tabla,Codigo,Accion,Fecha,ValorAnterior,ValorActual,Operador,Campo ")
Endif
SQL.ADD("from "~DBO~".PMAUDIT where ")
SQL.ADD(" Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' and Fecha <= '"~IdxDate(Dialogo.Fecha2+1)~"' ")
IF NoVacio(Dialogo.Lista1)
    SQL.ADD(" AND Tabla IN ("~pipe2comillas(Dialogo.Lista1)~") ")
else
    SQL.ADD(" AND Tabla IN ('INFORMES','EVENTOS','FUNCIONES','FORMULAS','TIPOSOPERACION','TIPOSORDEN','TIPOSMINUTABOLSA','TIPOSTRANSACCION2','ESPECIES') ")
endif
IF NoVacio(Dialogo.Operador)
   SQL.ADD(" AND Operador = 'Usuario "~Dialogo.Operador ~"' ")
ENDIF
******   SQL.ADD(" AND Accion = 'B' ")

If Dialogo.Check1=0
   SQL.ADD("order by Fecha, Codigo, Accion, Tabla ")
ELSE
   SQL.ADD("order by Tabla, Codigo ")
Endif


recorrer SQL
  acn(x1, 0)

  If Dialogo.Check1 = 0

    if Not EqStr(Val(z1), fbn('Tabla')~fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
      ACT(z1,    fbn('Tabla')~fbn('Codigo')~fbn('Accion')~fbn('Fecha'))
      ACT(a:FAC, fbn('Operador'))
      ACT(b:FAC, fbn('Fecha'))
      ACT(c:FAC, fbn('Accion'))
      ACT(d:FAC, fbn('Tabla'))
      ACT(e:FAC, fbn('Codigo'))
      scn(x1, 1)
    endif
    if [EqStr(fbn('Accion'),'A') y NoVacio(fbn('ValorActual'))] o [EqStr(fbn('Accion'),'M') y Not EqStr(fbn('ValorActual'),fbn('ValorAnterior'))] o [EqStr(fbn('Accion'),'B') y NoVacio(fbn('ValorAnterior'))]
      ACT(f:FAC, fbn('Campo'))
      ACT(g:FAC, fbn('ValorAnterior'))
      ACT(h:FAC, fbn('ValorActual'))
    else
      if Val(x1) = 0
        dfa
      endif
    endif

  Else

    ACT(d:FAC, fbn('Tabla'))
    ACT(e:FAC, fbn('Codigo'))

  Endif


proximo


