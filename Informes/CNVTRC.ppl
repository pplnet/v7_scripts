SQL.ADD("Select DISTINCT(Pais), Nombre From ( ")
SQL.ADD("Select isnull(C.Pais,'80') Pais, P.Nombre, C.Codigo FROM "~DBO~".CLIENTES C ")
SQL.ADD("     left JOIN "~DBO~".PAISES P WITH (NOLOCK) ")
SQL.ADD("           ON P.Codigo = isnull(C.Pais,'80') ")
SQL.ADD("Where C.Codigo <> '"~Dialogo.Vehiculo1~"' ")
*SQL.ADD("  and FechaApertura >= '"~IdxDate(Dialogo.Fecha1)~"' ")
#ifdef MLASA
SQL.ADD("  and FechaApertura <= '"~IdxDate(Dialogo.Fecha2)~"' ")
SQL.ADD("  and (Jerarquia like '"~Var('JERCLIENTE')~"%' or Jerarquia like '"~Var('JERVINCULA')~"%'  or Vinculado='SI') ")
SQL.ADD("  and Status = 'HAB' ")
#else
**SQL.ADD(" and C.Codigo in (Select Cliente FROM "~DBO~".CUENTAS T where TipoCuenta='CUS' and FechaAlta <= '"~IdxDate(Dialogo.Fecha1)~"' and FechaAlta = (select min(FechaAlta)  from "~DBO~".CUENTAS T1 where TipoCuenta='CUS' and T.Cliente = T1.Cliente)) and Status = 'HAB' "~VAL(xy10)~" ")
SQL.ADD(" and C.Codigo in (Select Cliente FROM "~DBO~".CUENTAS T where Mercado='CV' and Tipocuenta='CUS' and Comitente= '"~Dialogo.Vehiculo1~"' and Estado= 'HAB' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha1)~"') <= '"~IdxDate(Dialogo.Fecha1)~"' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha1)~"') = (select min(FechaAlta)  from "~DBO~".CUENTAS T1 where mercado='CV' and Tipocuenta='CUS' and Comitente= '"~Dialogo.Vehiculo1~"' and Estado= 'HAB' and T.Cliente = T1.Cliente)) and Status = 'HAB' "~VAL(xy10)~" ")
SQL.ADD("  ) as Aux ")
#endif
SQL.ADD("  Order by Nombre ")
watch(sql.batch)
Recorrer SQL
  dfa
  if EqStr(FBN['Pais'],VAR('PAISARG'))
     dfa
  else
     SCN(pa2,1)
     if Vacio(FBN['Pais']) o EqStr(FBN['Pais'],'')
        ACT(ab:Val(pa2),'Sin Pais')
     else
        ACT(aa:Val(pa2),FBN['Pais'])
        ACT(ab:Val(pa2),FBN['Nombre'])
     endif   
  endif
Proximo

* Clientes Previos al Informe
SQL.ADD("Select Persona,Pais,Count(*)as Cuantos ")
SQL.ADD("FROM "~DBO~".CLIENTES  ")
SQL.ADD("Where Codigo <> '"~Dialogo.Vehiculo1~"' ")
#ifdef MLASA
SQL.ADD("  and FechaApertura < '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("  and (Jerarquia like '"~Var('JERCLIENTE')~"%' or Jerarquia like '"~Var('JERVINCULA')~"%'  or Vinculado='SI') ")
SQL.ADD("  and Status = 'HAB' ")
#else
**SQL.ADD(" and Codigo in (Select Cliente FROM "~DBO~".CUENTAS T where TipoCuenta='CUS' and FechaAlta <= '"~IdxDate(Dialogo.Fecha1)~"' and FechaAlta = (select min(FechaAlta)  from "~DBO~".CUENTAS T1 where TipoCuenta='CUS' and T.Cliente = T1.Cliente)) and Status = 'HAB' "~VAL(xy10)~" ")
SQL.ADD(" and Codigo in (Select Cliente FROM "~DBO~".CUENTAS T where Mercado='CV' and Tipocuenta='CUS' and Comitente= '"~Dialogo.Vehiculo1~"' and Estado= 'HAB' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha1)~"') <= '"~IdxDate(Dialogo.Fecha1)~"' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha1)~"') = (select min(FechaAlta)  from "~DBO~".CUENTAS T1 where mercado='CV' and Tipocuenta='CUS' and Comitente= '"~Dialogo.Vehiculo1~"' and Estado= 'HAB' and T.Cliente = T1.Cliente)) and Status = 'HAB' "~VAL(xy10)~" ")
#endif
SQL.ADD("  Group by Persona,Pais ")
SQL.ADD("  Order by Persona,Pais ")
watch(sql.batch)

Recorrer SQL
  dfa
   if EqStr(FBN['Persona'],'SI')
      SCN(pf4,FBN['Cuantos'])
      if EqStr(FBN['Pais'],VAR('PAISARG'))
         SCN(pf5,FBN['Cuantos'])
      else
         SCN(pf6,FBN['Cuantos'])
      endif
      Recorrer&K Val(pa1), Val(pa2)
         ACN(pa3,&k)
         if EqStr(FBN['Pais'],val(aa:Val(pa3)))
            SCN(ae:Val(pa3),FBN['Cuantos'])
            break
         endif
      Proximo
   else
      SCN(pj4,FBN['Cuantos'])
      if EqStr(FBN['Pais'],VAR('PAISARG'))
         SCN(pj5,FBN['Cuantos'])
      else
         SCN(pj6,FBN['Cuantos'])
      endif
      Recorrer&K Val(pa1), Val(pa2)
      if EqStr(FBN['Pais'],val(aa:&k))
            SCN(af:&k,FBN['Cuantos'])
            break
         endif
      Proximo
   endif
  
Proximo

