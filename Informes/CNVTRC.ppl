SQL.ADD("  and (Jerarquia like '"~Var('JERCLIENTE')~"%' or Jerarquia like '"~Var('JERVINCULA')~"%'  or Vinculado='SI') ")
SQL.ADD("  and Status = 'HAB' ")
#else
**SQL.ADD(" and Codigo in (Select Cliente FROM "~DBO~".CUENTAS T where TipoCuenta='CUS' and FechaAlta >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaAlta <= '"~IdxDate(Dialogo.Fecha2)~"' and FechaAlta = (select min(FechaAlta)  from "~DBO~".CUENTAS T1 where TipoCuenta='CUS' and T.Cliente = T1.Cliente)) and Status = 'HAB' "~VAL(xy10)~" ")
SQL.ADD(" and Codigo in (Select Cliente FROM "~DBO~".CUENTAS T where Mercado='CV' and Tipocuenta='CUS' and Comitente= '"~Dialogo.Vehiculo1~"' and Estado= 'HAB' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha2)~"') >= '"~IdxDate(Dialogo.Fecha1)~"' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha2)~"') <= '"~IdxDate(Dialogo.Fecha2)~"' and isnull(FechaAlta,'"~IdxDate(Dialogo.Fecha1)~"') = (select min(FechaAlta)  from "~DBO~".CUENTAS T1 where mercado='CV' and Tipocuenta='CUS' and Comitente= '"~Dialogo.Vehiculo1~"' and Estado= 'HAB' and T.Cliente = T1.Cliente)) and Status = 'HAB' "~VAL(xy10)~" ")
#endif

watch(sql.batch)
