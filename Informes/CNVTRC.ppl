ModoReproceso(SinDialogo)
CrearDialogo
   Vehiculo1 : "Vehiculo"         ; 1;1;;NO;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
   Fecha1    : "Ini Trimestre"    ; 2; ;;NO;;Dialogo.Fecha1<=Fsys y Dialogo.Fecha1<>0 ;'Debe Ingresar Fecha Inicio';NO;PrideMes(Dialogo.Fecha2-80,SI);PrideMes(Dialogo.Fecha2-80,SI)
   Fecha2    : "Fin Trimestre"    ; 3;1;;;;Dialogo.Fecha2<=Fsys y Dialogo.Fecha2<>0 y incluido(Pad0(Mes(Dialogo.Fecha2),2),'03|06|09|12') y FinDeMes(Dialogo.Fecha2,SI)=Dialogo.Fecha2;'Ingresar Fecha Fin Trimestre';NO;FinDeMes(PriDemes(FSys,SI)-1,SI)   
FinDialogo

IF Not Ok
   Cancelar
ENDIF

CrearFont(1,"Arial,8,")
