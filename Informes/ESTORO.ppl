ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1:  'Fecha'  ;1;1;1;  ;  ;Dialogo.Fecha1>0;'Fecha No Valida';NO;Fsys
  Radio1:  'Estado|Pendientes|Generadas|Todas';2;1; ;SI;SI;;;;2;
FinDialogo
if Not OK
  Cancelar
endif

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

SetFilaActual(4)
ACT(a:fac, "Listado de Operaciones ROFEX ")
SetFont(a:fac..a:fac,3)

SetFilaActual(FAC+2)
ACT(a:fac, 'Fecha: '~Dialogo.Fecha1)
ACT(a:fac+1, 'Estado: '~iif(Dialogo.Radio1=0,'Pendientes',iif(Dialogo.Radio1=1,'Generadas','Todas')))
SetFont(a:fac..z:fac+1,2)

SetFilaActual(fac+3)

ACT(a:fac, 'Boleta')
ACT(b:fac, 'Posciion')
ACT(c:fac, 'Tipo Cont.')
ACT(d:fac, 'IdCpraVta')
ACT(e:fac, 'Cantidad')
ACT(f:fac, 'Precio')
ACT(g:fac, 'ID Comitente')
ACT(h:fac, 'Fecha')
ACT(i:fac, 'Hora')
ACT(j:fac, 'Vencimiento')
ACT(k:fac, 'Fecha Real')
ACT(l:fac, 'Procesado')
ACT(m:fac, 'NrOperacion')
ACT(n:fac, 'Warning')
ACT(o:fac, 'Anulada')
ACT(p:fac, 'Exec ID')
ACT(q:fac, 'Estado')

SetFont(a:fac..q:fac,2)
AgregarMarco(a:fac..q:fac,2,0,Exe('COLOR'))

ACN(w:1, FAC)
SQL.ADD("Select * from "~DBO~".OPROFEX")
SQL.ADD(" where Convert(Date,FechaReal)="~IdxDate2(Dialogo.Fecha1) )
if Dialogo.Radio1=0
  SQL.ADD("   and isnull(Procesado,'0')='0' ")
  SQL.ADD("   and TipoContrato='1' ")
  SQL.ADD("   and isnull(Anulada,'NO')  = 'NO' ")
  SQL.ADD("   and isnull(ExecId,'')  <> '' ")
endif
if Dialogo.Radio1=1
  SQL.ADD("   and isnull(NrOperacion,'')<>'' ")
endif
SQL.ADD(" Order by Fecha,Boleta ")  
watch(sql.batch)
Recorrer SQL
  ACT(a:FAC, fbn('Boleta'))
  ACT(b:FAC, fbn('Posicion'))
  ACT(c:FAC, fbn('TipoContrato'))
  ACT(d:FAC, fbn('IDCpraVta'))
  ACN(e:FAC, fbn('Cantidad'))
  ACN(f:FAC, fbn('Precio'))
  ACT(g:FAC, fbn('IDComitente'))
  ACD(h:FAC, fbn('Fecha'))
  ACT(i:FAC, fbn('Hora'))
  ACD(j:FAC, fbn('Vto'))
  ACD(k:FAC, fbn('FechaReal'))
  ACT(l:FAC, fbn('Procesado'))
  if Vacio(Val((l:FAC)))
    ACT(l:FAC, '0')
  endif
  ACT(m:FAC, fbn('NrOperacion'))
  ACT(n:FAC, fbn('Warning'))
  ACT(o:FAC, fbn('Anulada'))
  ACT(p:FAC, fbn('ExecId'))
  if NoVacio(Val((m:FAC)))
    ACT(q:FAC, 'Op.Generada')
  endif
  if EqStr(Val(l:FAC),'0')
    if EqStr(Val(c:FAC),'1')
      if EqStr(Val(o:FAC),'NO') o Vacio(Val(o:FAC))
        if NoVacio(Val(p:FAC))
          ACT(q:FAC, 'Pendiente')
        endif
      endif
    endif
  endif
  if Vacio(Val((q:FAC)))
    ACT(q:FAC, 'Registro descartado')
  endif
proximo
if FAC=Val(w:1)
  SetFilaActual(FAC+2)
  ACT(a:FAC, 'No hay registros para listar')
  SetFont(a:fac,2)
else
  FormatoCeldas(e:Val(w:1)+1..e:fac,Exe('F2'))
  FormatoCeldas(f:Val(w:1)+1..f:fac,Exe('F7'))
  SetFont(a:Val(w:1)+1..p:fac,1)
endif

SetFilaActual(FAC+2)
ACT(a:FAC, 'Condiciones a cumplir')
SetFont(a:fac,2)
IFA
if Dialogo.Radio1=0 o Dialogo.Radio1=2
  ACT(b:FAC, 'Registros a Procesar (Pendientes)')
  SetFont(b:fac,2)
  ACT(c:FAC+1, 'Procesado = 0 (o vacio)')
  ACT(c:FAC+2, 'TipoContrato = 1')
  ACT(c:FAC+3, 'Anulado = NO (o vacio)')
  ACT(c:FAC+4, 'ExecID no vacio')
  SetFont(c:fac+1..c:fac+4,1)
  SetFilaActual(FAC+5)
endif
if Dialogo.Radio1=1 o Dialogo.Radio1=2
  ACT(b:FAC, 'Registros Procesados (Op Generada)')
  SetFont(b:fac,2)
  ACT(c:FAC+1, 'Procesado = 1')
  ACT(c:FAC+2, 'NrOperacion No vacio')
  SetFont(c:fac+1..c:fac+2,1)
  SetFilaActual(FAC+3)
endif

ACO(14,25)
ACO(17,15)

SetFilaActual(fac+2)
ACT(a:fac, 'FIN DEL INFORME')
SetFont(a:fac,2)

LimitesVision(q:fac)

****************************************************************
****************************************************************
IF NO

ACT(v:1, 'Oper en OPROFEX')
ACT(v:2, 'OpROFEX en USR')
ACT(v:3, 'Operador Default')
ACN(w:1, SQL("SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'OPROFEX' AND COLUMN_NAME in ('RootPartyID') "))
ACN(x:1, SQL("SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'OPROFEX' AND COLUMN_NAME in ('RootPartyRole') "))
ACN(w:2, SQL("SELECT 1 FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'USUARIOS' AND COLUMN_NAME in ('OpROFEX') "))
if SQL("SELECT 1 FROM "~DBO~".VARIABLES where Codigo='OPROFEXDEF' ")=1
  ACT(w:3, Var('OPROFEXDEF'))
  if SQL("SELECT 1 FROM "~DBO~".USUARIOS where Codigo='"~Val(w:3)~"' ")=0
    ACT(w:3, USUARIOACTIVO)
  endif
endif
if Vacio(Val(w:3))
  ACT(w:3, USUARIOACTIVO)
endif

Message('Recuperando OpRofex...')
SQL.ADD("Select * from "~DBO~".OPROFEX")
SQL.ADD(" where isnull(Procesado,'0')='0' ")
SQL.ADD("   and Convert(Date,FechaReal)="~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and TipoContrato='1' ")
SQL.ADD("   and isnull(Anulada,'NO')  = 'NO' ")
SQL.ADD("   and isnull(ExecId,'')  <> '' ")
SQL.ADD(" Order by Fecha,Boleta ")  
watch(sql.batch)
Recorrer SQL
   if Dialogo.Check1=1
     Message('...'~fbn('Boleta'))
   else
     MessageBox('...'~fbn('Boleta'))
   endif
   ACT(aa:FAC, fbn('Boleta'))
   ACT(ab:FAC, fbn('Posicion'))
   
   
**// Warning por default
   ACT(WA:1, 'Falta la posicion '~FBN('Posicion'))
   ACN(BD:1, 2)
** Ver si es necesaria esta fecha
   ACD(VT:1, FBN('Vto'))
   **// 
   SQL.ADD(" Select Especie, FechaVto, NombreExtendido ")
   SQL.ADD(" From "~DBO~".PLAZOSMERCADO ")
   SQL.ADD(" Where NombreExtendido = '"~FBN('Posicion')~"' ")
   Recorrer SQL
     DFA
     **// Marco que existe la posicion
     ACN(BD:1, 1)
     ACT(E:2, FBN('Especie'))
     ACT(E:1, SQL("SELECT ContraespecieCupon From "~DBO~".ESPECIES where Codigo='"~FBN('Especie')~"' "))
     ACT(E:3, FBN('Especie'))
     ACN(VT:2, FBN('FechaVto'))
     **// Si falta Especie FIX o MTM, no se genera la operacion
     If Vacio(Val(E:1)) O Vacio(Val(E:3))
       ACT(WA:1, 'Faltan datos en la posicion '~FBN('NombreExtendido'))
       ACN(BD:1, 2)
     Endif
   Proximo
   
   ACT(CL:1,SQL("SELECT Codigo FROM "~DBO~".Clientes WHERE NrRofex  = '"~FBN['IdComitente']~"' "))
   

   If vacio(val(CL:1))
    ACT(WA:1, 'Cliente inexistente '~FBN['IdComitente'])
    ACN(BD:1, 12)
   Endif
   

   **// Si ya hay una operacion con ese numero de boleta, no se genera.
   If SQL("Select 1 from "~DBO~".OPERACIONES where FechaOp="~IdxDate2(fbn['Fecha'])~" and TipoOp In ('FXCF','FXVF','TICF','TIVF') and NrBoleto in ('"~PAD0(FBN['Boleta'],8)~"','"~FBN['Boleta']~"') ")=1
     ACN(BD:1, 3)
     ACT(WA:1, 'Ya existe operacion con NrBoleta '~PAD0(FBN('Boleta'),8)~'. ')
   else
     If SQL("Select 1 from "~DBO~".BOPERACIONES where FechaOp="~IdxDate2(fbn['Fecha'])~" and TipoOp In ('FXCF','FXVF','TICF','TIVF') and NrBoleto in ('"~PAD0(FBN['Boleta'],8)~"','"~FBN['Boleta']~"') ")=1
       ACN(BD:1, 5)
       ACT(WA:1, 'Ya existe Boperacion con NrBoleta '~PAD0(FBN('Boleta'),8)~' ')
     else
       if DesciendeDeEspecie(Val(e:2),'TITULO') o DesciendeDeEspecie(Val(e:FAC),'CUPON')    
         ACN(BD:1, 4)
         ACT(WA:1, 'Operacion de Titulos '~val(e:2)~'. ')
       endif
     endif   
   Endif
   ACN(ac:FAC, Val(bd:1))

* FJL 12/07/20 - Operador segun informacon de ROFEX
   if Val(w:1)+Val(x:1)+Val(w:2)=3
     * Existen los tres campor nuevos en la base
     if EqStr(fbn('RootPartyRole'),'12')
       ACT(ae:FAC, fbn('RootPartyID'))
     endif
     if NoVacio(Val(ae:FAC))
       ACT(af:FAC, SQL("Select Codigo from "~DBO~".USUARIOS Where OpROFEX = '"~Val(ae:FAC)~"'"))
       if Vacio(Val(af:FAC))
         ACT(af:FAC, Val(w:3))
       endif
     else
       ACT(af:FAC, Val(w:3))
     endif
   else
     ACT(af:FAC, Val(w:3))
   endif

* FJL 13/07/20 - Se agregan validaciones (Issue 4350)   
   If Val(BD:1)=1 
     If Not Incluido(FBN('IdCpraVta'),'1|3')
       ACN(BD:1, 6)
       ACT(WA:1, 'ID Cpra/Vta invalido.')
     endif 
   endif
   If Val(BD:1)=1 
     If FBN('Cantidad')<=0
       ACN(BD:1, 7)
       ACT(WA:1, 'Cantidad no es mayor a 0.')
     endif 
   endif
   If Val(BD:1)=1 
     If FBN('Precio')<=0
       ACN(BD:1, 8)
       ACT(WA:1, 'Precio no es mayor a 0.')
     endif 
   endif
   If Val(BD:1)=1 
     If FBN('Fecha')<=0
       ACN(BD:1, 9)
       ACT(WA:1, 'Fecha Op invalida.')
     endif 
   endif
   If Val(BD:1)=1 
     If FBN('Vto')<=0
       ACN(BD:1, 10)
       ACT(WA:1, 'Fecha Vto invalida.')
     endif 
   endif
   
   If Val(BD:1)=1 
      **// TipoOP
      ACT(TO:1, iif(FBN('IdCpraVta')=1,'FXVF','FXCF') )
      **// MB1 - Frec. Liq
      ACN(FR:1,0)
      **// Cliente1 - Cliente
      *ACT(CL:1,Var('VEHICULODE'))
      **// Mercado3 - Mdo. Liq. Especie
      ACT(ME:3,MercadoDef(Val(E:2)))
      **// FormaLiquidacion1
      ACN(FL:1,0)
      **// FormaLiquidacion2
      ACN(FL:2,IIF(Incluido(VAL(ME:3),VAR('MERCAVARI')),1,0))
      **// CB9 - Cliente No Lim
      ACN(CL:2,SQL("Select 1 from "~DBO~".CLIENTES where Codigo='"~Val(CL:1)~"' and (Alias1='CP') "))
      **// Book1 - Cartera
** FJL 11/12/18 - Se cambia la logica de book default para mercado ROFEX
*      ACT(BK:1,BookDefault2(VAR('VEHICULODE'),Val(TO:1),'',Val(e:2),'','','','','HAB'))
      ACT(BK:1, VAR('BOOKMRFM'))
      **// Cliente3 - Controlante
      ACT(CL:3,IIF(NoVacio(Val(BK:1)),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~Val(CL:1)~"' "),''))
      **// Razon Social
      ACT(RZ:1, Copy(BuscarCampo('CLIENTES','RazonSocial','Codigo',Var('CLIROFEX')),1,25))
** FJL 12/12/18 - Se cambia la logica por cambio API ROFEX
*      **// Cantidad - Importe
*      ACN(IM:1, FBN('Cantidad') * BuscarCampo('ESPECIES','TamanioLote','Codigo',Val(E:3)))
      **// TotalBrutoCli3 - Cant.Contratos
      ACN(IM:1, FBN('Cantidad') / BuscarCampo('MERCADOS','TamanioLote','Codigo',VAR('MERROFEX')))
      **// FechaVto - Fecha de vencimiento
** FJL 13/07/20 - Ahora toma siempre la fecha que viene de ROFEX que se valida no venga vacia.
*      ACD(FV:1, IIF(Val(VT:2)=0,Habiles(FBN('Fecha'),1000,VAR('FERIDEF')),Val(VT:1)))
      ACD(FV:1, Val(VT:1))
      **// TotalBrutoCli1 - Monto 
      ACN(A:1, FBN('Precio') * Val(IM:1))
      **// Plazo
      ACN(PL:1, Val(FV:1)-FBN('Fecha'))
      **// FechaPago - Fecha Liq. Mon. Pago 
      ACD(FP:1, Habiles(Val(FV:1),0,VAR('FERIDEF')))
      **// FechaVto2 - Fecha Valuacion 
      ACD(FV:2,Habiles(Val(FP:1),-2,VAR('FERIDEF'),SI))
      **/ Plazo2 - PlazoLiq de la moneda
      **// queda fijo plazo en horas --> cambiar 0 Cero por PlazoLiq de la moneda --> Plazo2
      ACN(PL:2,0)
      **// FechaPrecan - Fecha Liquidacion
      ACD(FQ:1,Habiles(Val(FV:1),(Val(PL:1) DIV 24),VAR('FERIDEF'),SI))
      **// PrecioMer - C.CEsp ARP 
      ACN(A:6,1)
      **// TipoCambio2 - Precio Mercado
      ACN(A:7, COTIZACIONC(Val(E:3),'FUT',Val(FV:1),,FBN('Fecha'),1,SI,VAR('MONELOCA')))
      **// ModoCotiza - Modo Directa|Inversa
      ACT(A:13, IIF(EqStr(Modo(Val(E:2),CotizaEn(Val(E:2))),'DIR'),'0','1'))
      **// PorDerechoBolsa - C.Esp ARP
      ACN(A:14,IIF(Eqstr(VAR('MONELOCA'),CotizaEn(Val(E:2))),1,CotizacionC(VAR('MONELOCA'),,,,FBN('Fecha'),1,SI,CotizaEn(Val(E:2))) ))
      **// PorCaucion - RsikWeighting
      ACN(A:15,IIF(NoVacio(Val(BK:1)),("Select Factor from "~DBO~".RISKWEIGHT where Especie = 'USD' and TipoOp = '"~Val(TO:1)~"' and Fecha <= '"~IdxDate(FBN('Fecha'))~"' order by Fecha desc"),0))
      **// TotalAux5 - PreSettlement
      ACN(TO:5,IIF(NoVacio(Val(BK:1)),Val(IM:1)*iif(Val(A:15)=0,1,Val(a:15)/100),0))
      **// MinDerechoBolsa - Ex. Pres  *** Ver tema cliente y si se genera negativo cuando no hay asignado
      ACN(LM:1, LimAsignado(Val(CL:1),'PRESETTLEM',Val(E:2),VAR('VEHICULODE')))
      ACN(LM:2, LimConsumido(Val(CL:1),'PRESETTLEM',Val(E:2),0,VAR('VEHICULODE'),,,''))
      IF NoVacio(Val(BK:1))
         ACN(A:17, Val(LM:1)-(Val(LM:2)+Val(TO:5)))
      Endif
**      IF NoVacio(Val(BK:1)) Y NOT[Val(A:17)<0]      
**         ACN(A:17, 0)
**      Endif      
      **// Mercado2 - Mercado de la ContraEspecie
*      ACT(A:20,MercadoDef(VAR('MONELOCA')))
      ACT(A:20,VAR('MERROFEX'))
      **// MB4 - Liquida MTM
      ACN(MT:1,BuscarCampo('MERCADOS','MTM','Codigo',VAR('MERROFEX')))
      **// RB10 - Tipo Fut
      ACN(TF:1,1)
      **// MB6 - Origen FPA|OPEX|Altamira|Siopel|OCT 
      ACN(OR:1,4)
      **// TotalAux5 - PreSettlement
      ACN(TO:5,IIF(NoVacio(Val(BK:1)),Val(IM:1)*iif(Val(A:15)=0,1,Val(a:15)/100),0))
      **// Cuenta1 Cta.Esp.CLI
      ACT(CT:1,'')
      **// Cuenta2 Cta.Esp.VEH
      ACT(CT:2,'')      
      **// Cuenta3 Cta.Mon.VEH
      ACN(CO:3,SQL("Select Count(*) from "~DBO~".CUENTAS Where Cliente = '"~VAR('VEHICULODE')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      If VAl(CO:3)=1
        ACT(CT:3,SQL("Select Codigo from "~DBO~".CUENTAS Where Cliente = '"~VAR('VEHICULODE')~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      Endif
      **// Cuenta4 Cta.Mon.CLI
      ACN(CO:4,SQL("Select Count(*) from "~DBO~".CUENTAS Where Cliente = '"~Val(CL:1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      If VAl(CO:4)=1
        ACT(CT:4,SQL("Select Codigo from "~DBO~".CUENTAS Where Cliente = '"~Val(CL:1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VAR('MONELOCA')~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and Mercado='"~Val(A:20)~"' "))
      Endif

      **// Instancia 7-Confirmacion 10- Liquidacion
      **// verificar si tienen cuentas definidas: Ok va a 10 else a 7
      If Vacio(CT:3) o Vacio(CT:4)
        ACN(IN:1, 7)
      Else
        ACN(IN:1, 10)
      Endif
* FJL 12/07/20 - Operador segun informacon de ROFEX
      ACT(a:21, Val(af:FAC))      

      ACT(ad:FAC, 'OK')
      IF Dialogo.Check1=1
        **// NrOperacion
        ACT(xx3,Copy(FBN('Fecha'),7,4)~'-'~Copy(FBN('Fecha'),4,2)~'-'~Copy(FBN('Fecha'),1,2)~' '~Copy(FBN('Hora'),1,2)~':'~Copy(FBN('Hora'),3,2)~':'~Copy(FBN('Hora'),5,2))  
        Message(val(xx3))
       
        ACT(NR:1, GetNumerador(51))
        ACT(NR:2, GetNumerador(198))
        ACT(ae:FAC, Val(nr:1))
        SQL.ADD(" Insert INTO "~DBO~".OPERACIONES                                          ")
        SQL.ADD(" ( TipoOp,            NrOperacion,       FechaOp,         Especie,        ")
        SQL.ADD("   MB1,               MB2,               Cliente1,        Mercado3,       ")
        SQL.ADD("   FormaLiquidacion1, FormaLiquidacion2, TotalBrutoCli3,  Cantidad,       ")
        SQL.ADD("   Precio1,           Book1,             Cliente3,        TipoCambio,     ")
        SQL.ADD("   TotalBrutoCli1,    ContraEspecie,     Plazo,           Plazo2,         ")
        SQL.ADD("   FechaVto,          FechaPago,         NrBoleto,        Mercado2,       ")
        SQL.ADD("   Mercado,           TablaFeriados1,    Observac2,       PrecioMer,      ")
        SQL.ADD("   TipoCambio2,       CB9,               RB5,             MB4,            ")
        SQL.ADD("   MB6,               Operador,          Vehiculo1,       ModoCotiza,     ")
        SQL.ADD("   TotalAux2,         TotalAux3,         PorDerechoBolsa, FechaEj,        ")
        SQL.ADD("   Precio2,           FechaVto2,         CB6,             FechaOp2,       ")
        SQL.ADD("   ContraEspecie2,    FechaPrecan,       Observac3,       FechaAltaMAE,   ")
        SQL.ADD("   MinDerechoBolsa,   Cliente2,          RB3,             MB3,            ")
        SQL.ADD("   PorCaucion,        TotalAux5,         RB10,            Observaciones,  ")
        SQL.ADD("   Cuenta1,           Cuenta2,           Cuenta3,         Cuenta4,        ")
        SQL.ADD("   UsrInput,          FechaCarga,        FechaCargaSys,   Direccion,      ")
        SQL.ADD("   LInstancia,        Numerador,         Mercado4,        ObservacDoc, NroAltaMAE     ")
       
        SQL.ADD(" ) Values ( ")

        * TipoOp
        SQL.ADD("   '"~Val(TO:1)~"',             '"~Val(NR:1)~"',          "~IdxDate2(FBN('Fecha'))~",     '"~Val(E:2)~"',                   ")
        * MB1
        SQL.ADD("   "~Fstr(Val(FR:1),0,0)~",     0,                        '"~Val(CL:1)~"',                '"~Val(ME:3)~"',                  ")
        * FormaLiquidacion1
** FJL 12/12/18 - Se cambia la logica por cambio API ROFEX
*        SQL.ADD("   "~Fstr(Val(FL:1),0,0)~",     "~Fstr(Val(FL:2),0,0)~",  "~Fstr(FBN('Cantidad'),0,2)~",  "~Fstr(Val(IM:1),0,2)~",          ")
        SQL.ADD("   "~Fstr(Val(FL:1),0,0)~",     "~Fstr(Val(FL:2),0,0)~",  "~Fstr(Val(IM:1),0,2)~",        "~Fstr(FBN('Cantidad'),0,2)~",    ")
        * Precio1
        SQL.ADD("   "~Fstr(FBN('Precio'),0,8)~", '"~Val(BK:1)~"',          '"~Val(CL:3)~"',                "~Fstr(FBN('Precio'),0,8)~",      ")
        * TotalBrutoCli1
        SQL.ADD("   "~Fstr(Val(A:1),0,2)~",      '"~VAR('MONELOCA')~"',    "~Fstr(Val(PL:1),0,0)~",         "~Fstr(Val(PL:2),0,0)~",         ")
        * FechaVto
        SQL.ADD("   "~IdxDate2(Val(FV:1))~",     "~IdxDate2(Val(FP:1))~",  '"~PAD0(Val(NR:2),8)~"',         '"~Val(A:20)~"',                 ")    
        * Mercado
        SQL.ADD("   '"~VAR('MERROFEX')~"',       '"~VAR('FERIDEF')~"',     '',                             "~Fstr(Val(A:6),0,8)~",           ")
        * TipoCambio2
        SQL.ADD("   "~Fstr(FBN('Precio'),0,8)~", "~Fstr(Val(CL:2),0,0)~",  0,                              "~Fstr(Val(MT:1),0,0)~",          ")
        * MB6
* FJL 12/07/20 - Operador segun informacon de ROFEX
*        SQL.ADD("   "~Fstr(Val(OR:1),0,0)~",     '"~USUARIOACTIVO~"',      '"~VAR('VEHICULODE')~"',        '"~Val(A:13)~"',                  ")
        SQL.ADD("   "~Fstr(Val(OR:1),0,0)~",     '"~Val(a:21)~"',      '"~VAR('VEHICULODE')~"',        '"~Val(A:13)~"',                  ")
        * TotalAux2
        SQL.ADD("   0,                            0,                       "~Fstr(Val(A:14),0,8)~",         null,                            ")
        * Precio2
        SQL.ADD("   0,                            "~IdxDate2(Val(FV:2))~", 0,                               "~IdxDate2(FSYS)~",              ")
        * ContraEspecie2
        SQL.ADD("   '"~Val(E:1)~"',               "~IdxDate2(Val(FQ:1))~", null,                            Convert(datetime,'"~Val(xx3)~"',120),      ")
        * MinDerechoBolsa
        SQL.ADD("   "~Fstr(Val(A:17),0,2)~",      '"~Val(CL:1)~"',         0,                               0,                               ")
        * PorCaucion
        SQL.ADD("   "~Fstr(Val(A:15),0,8)~",      "~Fstr(Val(TO:5),0,2)~", "~Fstr(Val(TF:1),0,0)~",         'GENRFX - Generado Automatico',  ")
        * Cuenta1
        SQL.ADD("   '"~Val(CT:1)~"',              '"~Val(CT:2)~"',         '"~Val(CT:3)~"',                 '"~Val(CT:4)~"',                 ")      
        * UseInput
        SQL.ADD("   '"~USUARIOACTIVO~"',          "~SQLAhora~",            "~IdxDate2(FSYS)~",              2,                               ")
        * LInstancia
        SQL.ADD("   1,                            51,                      '"~VAR('MERROFEX')~"',           '"~FBN('Posicion')~"', '"~FBN('Boleta')~"' )          ")
        SQL.NEW
        SQL.EXEC
   
        Message('     Se genero '~Val(NR:1))
        SQL.ADD(" Update "~DBO~".OPROFEX ")
        SQL.ADD("    Set Procesado = '1', NrOperacion = '"~Val(NR:1)~"', Warning = null")
        SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
        SQL.NEW
        SQL.EXEC
      
        ModificarOperacion(Val(NR:1),0,SI,SI,SI,NO,SI,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,NO,SI,NO,NO,NO,0,NO,NO)      
        **// Instancia Inicial
      
        ACT(az3,Val(NR:1))
        ACT(az4,'OPERACIONES')
        ACN(az5,10)
        ACN(az6,0)
        (.'MODIINSTAN'.) 
if no      
        SQL.ADD("SELECT NrInstancia FROM "~DBO~".INSTANCIAS ")
        SQL.ADD("WHERE Tabla='OPERACIONES' ")
        SQL.ADD(" AND NrInstancia in (1,2,3,7,8,10,30) ")
        SQL.ADD("ORDER BY NrInstancia ")
        Recorrer SQL
          DFA
          SQL.ADD("INSERT INTO "~DBO~".OPERACIONESBITS ( ")
          SQL.ADD(" NrOperacion, NrBit, Valor ) Values ( ")
          SQL.ADD(" '"~Val(NR:1)~"',"~Fstr(FBN['NrInstancia'],2,0)~", '"~IIF(VAL(IN:1)=FBN['NrInstancia'],'1','0')~"' ) ")
          SQL.NEW
        Proximo
        SQL.EXEC
endif      
      endif 
   Else
     Message('     No se genero la OP')
     ACT(ah:FAC, Val(wa:1))
     IF Dialogo.Check1=1
       SQL.ADD(" Update "~DBO~".OPROFEX ")
       SQL.ADD("    Set Procesado='0', Warning= '"~Trim(Copy(Val(WA:1),1,255))~"' ")
       SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
       SQL.NEW
       SQL.EXEC
     endif      
   Endif
Proximo

Message('Eliminando Operaciones Rofex...')
SQL.ADD("Select OPB.Nroperacion, OPB.Boleta, OPB.BoletaBaja ")
SQL.ADD("  from "~DBO~".OPROFEX OPB ")
SQL.ADD(" where isnull(OPB.Procesado,'0')='0' ")
SQL.ADD("   and OPB.TrdRptStatus='3' ")
SQL.ADD("   and Convert(Date,OPB.FechaReal)="~IdxDate2(Dialogo.Fecha1) )
SQL.ADD("   and OPB.TipoContrato='1' ")
*SQL.ADD("   and isnull(Anulada,'NO')  = 'NO' ")
SQL.ADD("   and isnull(OPB.ExecId,'')  <> '' ")
SQL.ADD(" Order by OPB.Fecha,OPB.Boleta ")  
watch(sql.batch)
Recorrer SQL
   if SQL("SELECT 1 FROM "~DBO~".MOVEJECUTADOS WHERE NrOperacion='"~FBN['Nroperacion']~"' ")=1
      SQL.ADD(" Update "~DBO~".OPROFEX ")
      SQL.ADD("    Set Warning = 'Intento de baja. La operacion se encuentra liquidada' ")
      SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
      SQL.NEW
      SQL.EXEC
   else
      acn(IN:2,SQL("SELECT NrBit FROM "~DBO~".OPERACIONESBITS WHERE NrOperacion='"~FBN['Nroperacion']~"' and Valor=1 "))
      EjecutarEvento('DESAFE',NrOperacion1=FBN['Nroperacion'])
      EjecutarEvento('CBOINS', String1=FBN['Nroperacion'], Radio1=0, Radio2=1, Entero1=Val(IN:2), Entero2=30)

      Message('Operacion dada de baja '~FBN['Nroperacion'])
      SQL.ADD(" Update "~DBO~".OPROFEX ")
      SQL.ADD("    Set Procesado = '1', Warning = null")
      SQL.ADD("  Where Boleta = '"~FBN('Boleta')~"' ")
      SQL.NEW
      SQL.EXEC
   endif   
Proximo
ENDIF

