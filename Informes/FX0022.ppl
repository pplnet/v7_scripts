SQL.ADD(" SELECT P.Especie, P.Fecha, P.Cantidad1, P.Cantidad2, P.Precio1, P.Precio2, E.Nombre, ") 
SQL.ADD(" P.Book, P.Vehiculo, P.Cliente, P.CantidadFin, P.PrecioFin, P.CallPut, P.FechaEj, ")
SQL.ADD(" P.PrecioEj, P.CantidadIni, P.PrecioIni, ")
SQL.ADD("        NrSaldo = Case When P.NrSaldo = 42 Then 41 ")
SQL.ADD("                       When P.NrSaldo = 43 Then 41 ")
SQL.ADD("                       When P.NrSaldo = 44 Then 41 ")
SQL.ADD("        Else P.NrSaldo END ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E ")
SQL.ADD(" WHERE  P.Especie  = E.Codigo ")
SQL.ADD(" AND    P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD(" AND    P.Cliente  = '"~Dialogo.Vehiculo1~"' ")
If Dialogo.Fecha2<>0
   SQL.ADD(" AND    P.FechaEj  = "~idxdate2(Dialogo.Fecha2)~" ")
Endif
IF NoVacio(Dialogo.Book1)
   SQL.ADD(" AND Book = '"~Dialogo.Book1~"' ")
ENDIF
If NoVacio(Dialogo.Especie1)
  SQL.ADD(" AND  P.Especie  = '"~Dialogo.Especie1~"' ")
Endif
SQL.ADD(" AND    P.Fecha <= "~IdxDate2(Dialogo.Fecha1)~" ")
SQL.ADD(" AND P.NrSaldo <> 51 ")
If Dialogo.Radio1=0 y Dialogo.Radio2=0
  If Dialogo.Radio4=0
    SQL.ADD(" AND P.NrSaldo = 31 ")
  Else
    If Dialogo.Radio4=1
      SQL.ADD(" AND P.NrSaldo = 35 ")
    Else
      SQL.ADD(" AND P.NrSaldo IN (31,35) ")
    Endif
  Endif 
Endif
If Dialogo.Radio1=0 y Dialogo.Radio2=1
  SQL.ADD(" AND P.NrSaldo in (41,42,43,44) ")
Endif
If Dialogo.Radio1=0 y Dialogo.Radio2=2
  If Dialogo.Radio4=0
    SQL.ADD(" AND P.NrSaldo IN (31,41,41,42,43,44) ")
  Else
    If Dialogo.Radio4=1
      SQL.ADD(" AND P.NrSaldo = 35 ")
    Else
      SQL.ADD(" AND P.NrSaldo IN (31,41,42,43,44,35) ")
    Endif
  Endif 
Endif
If Dialogo.Radio1=1 y Dialogo.Radio2=0
  If Dialogo.Radio4=0
    SQL.ADD(" AND P.NrSaldo = 11 ")
  Else
    If Dialogo.Radio4=1
      SQL.ADD(" AND P.NrSaldo = 45 ")
    Else
      SQL.ADD(" AND P.NrSaldo IN (11,45) ")
    Endif
  Endif 
Endif
If Dialogo.Radio1=1 y Dialogo.Radio2=1
  SQL.ADD(" AND P.NrSaldo = 21 ")
Endif
If Dialogo.Radio1=1 y Dialogo.Radio2=2
  If Dialogo.Radio4=0
    SQL.ADD(" AND P.NrSaldo IN (11,21) ")
  Else
    If Dialogo.Radio4=1
      SQL.ADD(" AND P.NrSaldo = 45 ")
    Else
      SQL.ADD(" AND P.NrSaldo IN (11,21,45) ")
    Endif
  Endif 
Endif
If Dialogo.Radio1=2 y Dialogo.Radio2=0
  If Dialogo.Radio4=0
    SQL.ADD(" AND P.NrSaldo IN (31,11) ")
  Else
    If Dialogo.Radio4=1
      SQL.ADD(" AND P.NrSaldo IN (35,45) ")
    Else
      SQL.ADD(" AND P.NrSaldo IN (31,11,35,45) ")
    Endif
  Endif 
Endif
If Dialogo.Radio1=2 y Dialogo.Radio2=1
  SQL.ADD(" AND P.NrSaldo IN (41,21,42,43,44) ")
Endif
If Dialogo.Radio1=2 y Dialogo.Radio2=2
  If Dialogo.Radio4=0
    SQL.ADD(" AND P.NrSaldo IN (41,42,43,44,21,31,11) ")
  Else
    If Dialogo.Radio4=1
      SQL.ADD(" AND P.NrSaldo IN (35,45) ")
    Else
      SQL.ADD(" AND P.NrSaldo IN (41,42,43,44,45,21,31,11,35,45) ")
    Endif
  Endif 
Endif
SQL.ADD(" AND    P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES  ")
SQL.ADD("                    WHERE  Especie  = P.Especie ")
                                    If NoVacio(Dialogo.Especie1)
                                      SQL.ADD(" AND  Especie = '"~Dialogo.Especie1~"' ")
                                    Endif
                                    If Dialogo.Fecha2<>0
                                       SQL.ADD(" AND    FechaEj  = "~idxdate2(Dialogo.Fecha2)~" ")
                                    Endif
SQL.ADD("                    AND    Vehiculo = P.Vehiculo ")
SQL.ADD("                    AND    Vehiculo = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("                    AND    Cliente  = P.Cliente ")
SQL.ADD("                    AND    Book     = P.Book ")
SQL.ADD("                    AND    Cliente  = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("                    AND    NrSaldo  = P.NrSaldo ")
SQL.ADD("                    AND    Trader   = P.Trader ")
SQL.ADD("                    AND    (TipoNegocio  = P.TipoNegocio OR (TipoNegocio IS NULL AND P.TipoNegocio IS NULL)) ")
SQL.ADD("                    AND    (FechaEj  = P.FechaEj  OR (FechaEj  IS NULL AND P.FechaEj  IS NULL)) ")
SQL.ADD("                    AND    (PrecioEj = P.PrecioEj OR (PrecioEj IS NULL AND P.PrecioEj IS NULL)) ")
SQL.ADD("                    AND    (CallPut  = P.CallPut  OR (CallPut  IS NULL AND P.CallPut  IS NULL)) ")
SQL.ADD("                    AND    Fecha <= "~IdxDate2(Dialogo.Fecha1)~" ) ")
SQL.ADD(" ORDER BY P.Book, P.NrSaldo, P.Especie ")

ACN(sa:1, 0)
ACT(ea:1, '')
ACD(fj:1, 0)
ACN(pj:1, 0)
ACT(cp:1, '')
ACN(pp:1, 0)
ACN(pp:2, 0)

Recorrer SQL
 If fbn('Cantidad1')<>0 o fbn('Cantidad2')<>0 o fbn('CantidadFin')<>0
   ACN(BD:1, 0)
   IF Not Eqstr(fbn('Book'), Val(BK:1))
      ifa
      ACT(A:fac, 'Book: '~fbn('Book'))
      ACT(BK:1, fbn('Book'))
      ACN(BD:1, 1)
      SetFont(A:fac, 4)
      AgregarMarco(a:fac..n:fac,0,0,EXE('COLOR6'))
   ENDIF
   If fbn('NrSaldo')<>Val(sa:1) O Val(BD:1) = 1
     ifa
     ACN(sa:1, fbn('NrSaldo'))
     If fbn('NrSaldo')=31
      ACT(a:fac, 'Spot')
     Endif
     If fbn('NrSaldo')=35
       ACT(a:fac, 'Opciones')
     Endif
     If fbn('NrSaldo')=11
       ACT(a:fac, 'Spot')
     Endif
     If fbn('NrSaldo')=45
       ACT(a:fac, 'Opciones')
     Endif
     If fbn('NrSaldo')=41 o fbn('NrSaldo')=42 o fbn('NrSaldo')=43 o fbn('NrSaldo')=44
       ACT(a:fac, 'Forward')
     Endif
     If fbn('NrSaldo')=21
       ACT(a:fac, 'Forward')
     Endif
     AgregarMarco(a:fac..n:fac,0,0,EXE('COLOR8'))
     SetFont(a:fac, 4)
     ifa
     ACT(ea:1, '')
     ACD(fj:1, 0)
     ACN(pj:1, 0)
     ACT(cp:1, '')
   Endif

   If Not Eqstr(fbn('Especie'), Val(ea:1)) o Not Eqstr(fbn('CallPut'), Val(cp:1)) o fbn('PrecioEj')<>Val(pj:1) o fbn('FechaEj')<>Val(fj:1) o Not Eqstr(fbn('Book'), Val(BK:1))
     message(fbn('Especie'))
     ACT(ea:1, fbn('Especie'))
     ACD(fj:1, fbn('FechaEj'))
     ACN(pj:1, fbn('PrecioEj'))
     ACT(cp:1, fbn('CallPut'))
     ACT(BK:1, fbn('Book'))
     ACN(pp:1, 0)
     ACN(pp:2, 0)
   Else
     dfa
   Endif
   If NoVacio(fbn('CallPut'))
     ACT(a:fac, fbn('Especie')~' - '~fbn('CallPut')~' - '~fbn('FechaEj')~' - '~PyC(fbn('PrecioEj'),1,8) ) 
   Else
     ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre')~' - '~fbn('FechaEj')) 
   Endif
   If fbn('NrSaldo')=31
     AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   Endif
   If fbn('NrSaldo')=35
     AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio4=1, Book1=fbn('Book'))
   Endif
   If fbn('NrSaldo')=11
     AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   Endif
   If fbn('NrSaldo')=45
     AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio4=1, Book1=fbn('Book'))
   Endif
   If fbn('NrSaldo')=41 o fbn('NrSaldo')=42 o fbn('NrSaldo')=43 o fbn('NrSaldo')=44 
     AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   Endif
   If fbn('NrSaldo')=21
     AsignarLink(a:fac, 'FX0023',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio4=0, Book1=fbn('Book'))
   Endif
   ACT(FE:1, fbn('Fecha'))
   If fbn('Fecha')=Dialogo.Fecha1
     SCN(b:fac, fbn('CantidadIni'))
     SCN(c:fac, fbn('Cantidad1'))
     SCN(pp:1, fbn('Precio1')*fbn('Cantidad1'))
     ACN(d:fac, Val(pp:1)/Val(c:fac))

     SCN(e:fac, fbn('Cantidad2'))
     SCN(pp:2, fbn('Precio2')*fbn('Cantidad2'))
     ACN(f:fac, fbn('Precio2'))
     ACN(f:fac, Val(pp:2)/Val(e:fac))


     IF Val(C:fac) <> 0 Y fbn('NrSaldo')=31
       AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     ENDIF
     IF Val(E:fac) <> 0 Y fbn('NrSaldo')=31
       AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     Endif
     If Val(C:fac) <> 0 Y fbn('NrSaldo')=35
       AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=1, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     ENDIF
     If Val(E:fac) <> 0 Y fbn('NrSaldo')=35
       AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=1, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     Endif
     If Val(C:fac) <> 0 Y fbn('NrSaldo')=11
       AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     ENDIF
     If Val(E:fac) <> 0 Y fbn('NrSaldo')=11
       AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     Endif
     If Val(C:fac) <> 0 Y fbn('NrSaldo')=45
       AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=1, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     ENDIF
     If Val(E:fac) <> 0 Y fbn('NrSaldo')=45
       AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=0,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=1, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     Endif
     If Val(C:fac) <> 0 Y [fbn('NrSaldo')=41 o fbn('NrSaldo')=42 o fbn('NrSaldo')=43 o fbn('NrSaldo')=44]
       AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     ENDIF
     If Val(E:fac) <> 0 Y [fbn('NrSaldo')=41 o fbn('NrSaldo')=42 o fbn('NrSaldo')=43 o fbn('NrSaldo')=44]
       AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=0,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     Endif
     If Val(C:fac) <> 0 Y fbn('NrSaldo')=21
       AsignarLink(c:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=0,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     ENDIF
     If Val(C:fac) <> 0 Y fbn('NrSaldo')=21
       AsignarLink(e:fac, 'FX0024',Fecha1=Dialogo.Fecha1,Especie1=fbn('Especie'),Radio2=1,Radio1=1,Vehiculo1=Dialogo.Vehiculo1,Radio3=1,Radio4=0, Book1=fbn('Book'), Fecha2=fbn('FechaEj'))
     Endif
   ELSE
     ***---Posicion Final del fecha anterior que se suma a Posicion Inicial de la fecha del dialogo
     SCN(b:fac, fbn('CantidadFin'))
   Endif

   ACN(g:fac, Val(c:fac)-Val(e:fac))
   SCN(h:fac, fbn('CantidadFin'))
   If Incluido(fbn('CallPut'), 'CAL|PUT')
     ACN(i:fac, CotizacionC(fbn('Especie'),fbn('CallPut'),fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
     ACN(m:fac, CotizacionC(fbn('Especie'),fbn('CallPut'),fbn('FechaEj'),fbn('PrecioEj'),Dialogo.Fecha1-1,1,SI,Dialogo.Especie2) )
   Else
     If novacio(fbn('FechaEj'))
*       ACN(i:fac, CotizacionC(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1,1,SI,Dialogo.Especie2,SI) )
*       ACN(m:fac, CotizacionC(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1-1,1,SI,Dialogo.Especie2,SI) )
       ACN(i:fac, CotizacionC(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
       ACN(m:fac, CotizacionC(fbn('Especie'),,fbn('FechaEj'),,Dialogo.Fecha1-1,1,SI,Dialogo.Especie2) )
     Else
       ACN(i:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1,1,SI,Dialogo.Especie2) )
       ACN(m:fac, CotizacionC(fbn('Especie'),,,,Dialogo.Fecha1-1,1,SI,Dialogo.Especie2) )
     Endif
   Endif

   ACN(j:fac, Val(h:fac)*Val(i:fac))
   ACT(k:fac, IIF(Eqstr(Dialogo.Especie2,VAR('MONELOCA')),'$','U$S') )

   *- Precio de Equilibrio ((Compras * ppp compras ) - (Vtas * ppp Vtas))/Descalce
   ACN(l:fac, (val(c:fac)*val(d:fac) - val(e:fac)*val(f:fac)) / val(g:fac))

   *- Precio Promedio de cierre
   ACN(n:fac,  (val(m:fac)*val(b:fac) + val(l:fac)*(Val(c:fac)-Val(e:fac))) / val(h:fac))
            
  
   SetFont(a:fac..n:fac,1)

   *- Para linkear posicion 
   ACN(ck1,val(b:fac))
   ACN(ck2,FBN['PrecioIni'])

 Else
   dfa
 Endif
