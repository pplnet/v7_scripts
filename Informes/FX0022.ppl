CrearDialogo
  Fecha1:    'Fecha'                 ;1;1;;;;;;;FSYS
  Especie1 : 'Moneda'                ;3;1;;;;;;;;;;;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Radio4   : '|C/V|Opciones|Todo'    ;2;2;;NO;NO;;;;2
  Especie2 : 'Expresado en'          ;1;2;;;;NoVacio(Dialogo.Especie2);'Moneda Invalida';NO;Var('MONELOCA');;Var('MONELOCA')~'|'~Var('MONEEXTR')~'|';;;"Jerarquia LIKE '"~Jerarquia('ESPECIES','MONEDA')~"%' "
  Radio2:    'Posicion|Spot|Forward|Ambas'  ;3;2;;;;;;;2
  Radio1:    'Cartera|Trading|General|Ambas';;;;NO;NO;;;;2
  Vehiculo1 : 'Vehiculo'                    ;5;1;;;;[NoVacio(Dialogo.Vehiculo1)] Y [Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) O Vacio(UsrVehiculos(UsuarioActivo))];'Vehiculo Invalido';NO;Var('VEHICULODE');;;;;IIF(NoVacio(UsrVehiculos(UsuarioActivo))," Codigo IN ("~Pipe2Comillas(UsrVehiculos(UsuarioActivo))~") ");;;;;
  Book1:      'Book'                  ;5;2;;;;Vacio(Dialogo.Book1) O Incluido(Dialogo.Book1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') "));'Book Invalido';NO;;;;;;" Vehiculo = '"~Dialogo.Vehiculo1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%FX%|') ";
  Fecha2:     'FechaVto'              ;1;1;1;NO;NO;
FinDialogo

If Not Ok
  Cancelar
Endif

