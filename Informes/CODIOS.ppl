ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'Fecha'      ;;;;;;Dialogo.Fecha1>0;;;FSys
  Check1    : 'C/Intereses';
FinDialogo
if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,7,')
CrearFont(4, 'Arial,7,B')

ACT(ai:7, 'AI')
ACT(ar:7, 'AR')
ACT(ai:8, 'Padre')
ACT(aj:8, 'Local')
ACT(ak:8, 'Lim RPC')
ACT(al:8, 'Lim Local')
ACT(am:8, 'Lim Off-S')
ACT(an:8, 'Lim Mayor')
ACT(ao:8, 'Disp.Off-S')
ACT(ap:8, 'Disp.Total')
ACT(aq:8, 'Loc.c/suc')
ACT(ba:7, 'Consumido Local')
ACT(ba:8, 'BA')
ACT(br:8, 'BR')
ACT(ca:7, 'Consumido Off-Shore')
ACT(ca:8, 'CA')
ACT(cr:8, 'CR')
ACT(da:7, 'Asignado Local')
ACT(da:8, 'DA')
ACT(dr:8, 'DR')
ACT(ea:7, 'Asignado Off-Shore')
ACT(ea:8, 'EA')
ACT(er:8, 'ER')

SetFilaActual(4)
ACT(a:FAC, 'Limites - Disponible Off-Shore')
ACT(a:FAC+2, 'Fecha: '~Dialogo.Fecha1)
if Dialogo.Check1=1
  ACT(a:FAC+3, 'Con Intereses Devengados')
endif
SetFont(a:FAC..a:FAC+3,2)

ACT(z3, Descendientes('Clientes', 'BANCOS'))
ACT(z4, Pipe2Comillas(Val(z3)))

SetFilaActual(FAC+5)

ACT(a:FAC, 'Bancos')
ACT(q:FAC, 'TOTAL')

SetFont(a:FAC..q:FAC,4)
AlinearCeldas(a:FAC..q:FAC,'C')
AgregarMarco(a:FAC..q:FAC,1,3,Exe('COLOR'))

ACN(y1,FAC+1)
SQL.ADD("Select * from "~DBO~".LIMASIGNADOS where Vehiculo is Not Null ")
SQL.ADD("and Limite in ('ACLTOT','ACOTOT')")
SQL.ADD("order by Cliente,Vehiculo")
recorrer SQL
  if EqStr(FBN['Cliente'],Val(w:FAC-1))
    DFA
  else
    ACT(w:FAC, FBN['Cliente'])
    ACT(x:FAC, SQL("Select Controlante from "~DBO~".GRUPOSECONOMICOS where Cliente = '"~Val(w:FAC)~"' and TipoGrupo = 'BANCA' "))
    if Vacio(Val(x:FAC))
      ACT(a:FAC, FBN['Cliente'])
    else
      ACT(a:FAC, Copy(BuscarCampo('CONTROLANTES','RazonSocial','Codigo',Val(x:FAC)),1,25))
    endif
    ACT(ai:FAC, FBN['Cliente'])
    ACT(ba:FAC, FBN['Cliente'])
    ACT(ca:FAC, FBN['Cliente'])
    ACT(da:FAC, FBN['Cliente'])
    ACT(ea:FAC, FBN['Cliente'])
    ACT(fa:FAC, FBN['Cliente'])
    ACT(ga:FAC, FBN['Cliente'])
  endif
  ACN(x1, 0)

  if Val(x2)>0
    recorrer&i 1,Val(x2)
*      if EqStr(FBN['Vehiculo'],Val(&i+1:Val(y1)-1))
*      endif
      if Incluido(FBN['Vehiculo'],Val(52+&i+1:Val(y1)-2)) o EqStr(FBN['Vehiculo'],Val(&i+1:Val(y1)-1))
        ACN(x1, &i+1)
      endif
    proximo
  endif
  if Val(x1)=0
    SCN(x2, 1)
    if Val(x2)>15
      ACN(x2, 15)
      ACN(x1, 20)
    else
      ACT(1+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACT(53+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACT(53+Val(x2):Val(y1)-2, Descendientes('Vehiculos', FBN['Vehiculo']))
      ACT(79+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACT(105+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACT(131+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACT(157+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACT(183+Val(x2):Val(y1)-1, FBN['Vehiculo'])
      ACN(x1, Val(x2)+1)
    endif
  endif
  
  ACN(y3, FBN['Monto']/1000)
  if EqStr(FBN['Limite'],'ACLTOT')
    SCN(104+Val(x1):FAC, Val(y3))
  else
    SCN(130+Val(x1):FAC, Val(y3))
  endif
proximo
ACN(w2, FAC)

SQL.ADD("Select Controlante Clie, O.Vehiculo1 Vehi, TipoOp Tipo, Especie, Cantidad Cant, '0' Mar1, PaisDir, '0' Mar2, TotalIntereses TotInt, Plazo Pla, FechaOp FOp, NrOperacion NrOp, PrecioEj PreEj from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G ")
SQL.ADD("where FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and ")
SQL.ADD("(")
SQL.ADD("(")
SQL.ADD("(")
SQL.ADD("TipoOp in ('MMPCL' ,'MMPCLM','MMPLME') ")
SQL.ADD("or ")
SQL.ADD("TipoOp in ('MMPCOS' ,'MMPOSM') ")
SQL.ADD("or ")
SQL.ADD("(")
SQL.ADD("TipoOp in ('MMPE','MMPEM','MMPI','MMPIM','MMFRNP','MMFIMV','MMPSI','MMSIMV') ")
*SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null)")
SQL.ADD(") ")
SQL.ADD(") ")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(") ")
SQL.ADD("or ")
SQL.ADD("(")
SQL.ADD("TipoOp in ('GA','GAMV','CC','CCMV') ")
*SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null)")
SQL.ADD("and FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(") ")
SQL.ADD(") ")
SQL.ADD("and Cliente1 = Cliente ")
SQL.ADD("and TipoGrupo = 'BANCA' ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")
SQL.ADD("union ")
SQL.ADD("Select Cliente1 Clie, O.Vehiculo1 Vehi, TipoOp Tipo, Especie, Cantidad Cant, '0' Mar1, PaisDir, '0' Mar2, TotalIntereses TotInt, Plazo Pla, FechaOp FOp, NrOperacion NrOp, PrecioEj PreEj from "~DBO~".OPERACIONES O, "~DBO~".CLIENTES C ")
SQL.ADD("where FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and ")
SQL.ADD("(")
SQL.ADD("(")
SQL.ADD("(")
SQL.ADD("TipoOp in ('MMPCL' ,'MMPCLM','MMPLME') ")
SQL.ADD("or ")
SQL.ADD("TipoOp in ('MMPCOS' ,'MMPOSM') ")
SQL.ADD("or ")
SQL.ADD("(")
SQL.ADD("TipoOp in ('MMPE','MMPEM','MMPI','MMPIM','MMFRNP','MMFIMV','MMPSI','MMSIMV') ")
*SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null)")
SQL.ADD(") ")
SQL.ADD(") ")
SQL.ADD("and FechaVto > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(") ")
SQL.ADD("or ")
SQL.ADD("(")
SQL.ADD("TipoOp in ('GA','GAMV','CC','CCMV') ")
*SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null)")
SQL.ADD("and FechaEx2 > '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD(") ")
SQL.ADD(") ")
SQL.ADD("and (Select Count(*) from "~DBO~".GRUPOSECONOMICOS where Cliente = Cliente1 and TipoGrupo = 'BANCA')= 0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")

SQL.ADD("union ")

SQL.ADD("Select Controlante Clie, T.Cliente2 Vehi, TipoTr2 Tipo, Especie, Cantidad1 Cant, RB2 Mar1, PaisDir, RB1 Mar2, 0 TotInt, 0 Pla, T.Fecha1 FOp, NrTrans NrOp, 0 PreEj from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G ")
SQL.ADD("where T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and T.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and TipoTr2 = 'ACV' ")
*SQL.ADD("and RB1 = '0' ")
SQL.ADD("and Cliente1 = Cliente ")
SQL.ADD("and TipoGrupo = 'BANCA' ")
*SQL.ADD("and (Select Count(*) from "~DBO~".GRUPOSECONOMICOS where Cliente = Cliente1 and TipoGrupo = 'BANCA')= 0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")
SQL.ADD("union ")
SQL.ADD("Select Cliente1 Clie, T.Cliente2 Vehi, TipoTr2 Tipo, Especie, Cantidad1 Cant, RB2 Mar1, PaisDir, RB1 Mar2, 0 TotInt, 0 Pla, T.Fecha1 FOp, NrTrans NrOp, 0 PreEj from "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C ")
SQL.ADD("where T.Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and T.Fecha2 >= '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("and TipoTr2 = 'ACV' ")
*SQL.ADD("and RB1 = '0' ")
SQL.ADD("and (Select Count(*) from "~DBO~".GRUPOSECONOMICOS where Cliente = Cliente1 and TipoGrupo = 'BANCA')= 0 ")
SQL.ADD("and Codigo = Cliente1 ")
SQL.ADD("and Codigo in ("~Val(z4)~") ")

SQL.ADD("order by 1,2 ")

recorrer SQL
  DFA
  SCN(y2,1)
  ACT(aa:Val(y2), FBN['NrOp'])
  ACT(ab:Val(y2), FBN['Tipo'])
  ACT(ac:Val(y2), FBN['Clie'])
  ACT(ad:Val(y2), FBN['Vehi'])
  ACN(af:Val(y2), FBN['Cant'])

  ACN(w1, 0)
  if Val(w2)>Val(y1)-1
    recorrer&i Val(y1),Val(w2)
      if EqStr(FBN['Clie'],Val(w:&i))
        ACN(w1, &i)
      endif
    proximo
  endif
  if Val(w1)=0
    SCN(w2, 1)
    IFA
    ACT(w:FAC, FBN['Clie'])
    ACT(x:FAC, SQL("Select Controlante from "~DBO~".GRUPOSECONOMICOS where Cliente = '"~Val(w:FAC)~"' and TipoGrupo = 'BANCA' "))
    if Vacio(Val(x:FAC))
      ACT(a:FAC, FBN['Clie'])
    else
      ACT(a:FAC, Copy(BuscarCampo('CONTROLANTES','RazonSocial','Codigo',Val(x:FAC)),1,25))
    endif
    ACT(ai:FAC, FBN['Clie'])
    ACT(ba:FAC, FBN['Clie'])
    ACT(ca:FAC, FBN['Clie'])
    ACT(da:FAC, FBN['Clie'])
    ACT(ea:FAC, FBN['Clie'])
    ACT(fa:FAC, FBN['Clie'])
    ACT(ga:FAC, FBN['Clie'])
    ACN(w1, FAC)
  endif

  ACN(x1, 0)
  if Val(x2)>0
    recorrer&i 1,Val(x2)
*      if EqStr(FBN['Vehi'],Val(&i+1:Val(y1)-1))
*      endif
      if Incluido(FBN['Vehi'],Val(52+&i+1:Val(y1)-2)) o EqStr(FBN['Vehi'],Val(&i+1:Val(y1)-1))
        ACN(x1, &i+1)
      endif
    proximo
  endif
  if Val(x1)=0
    SCN(x2, 1)
    if Val(x2)>15
      ACN(x2, 15)
      ACN(x1, 20)
    else
      ACT(1+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACT(53+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACT(53+Val(x2):Val(y1)-2, Descendientes('Vehiculos', FBN['Vehi']))
      ACT(79+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACT(105+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACT(131+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACT(157+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACT(183+Val(x2):Val(y1)-1, FBN['Vehi'])
      ACN(x1, Val(x2)+1)
    endif
  endif

  ACN(y3,0)
  if Incluido(FBN['Tipo'],'ACV')
    ACN(y3, FBN['Cant']/1000)
    ACN(y3, Val(y3)*CotizacionC(FBN['Especie'],,,,FBN['FOp'],1,SI,'USD'))
    ACN(ae:Val(y2),1)
    if FBN['Mar2']=0
      SCN(52+Val(x1):Val(w1), Val(y3))
    else
      SCN(78+Val(x1):Val(w1), Val(y3))
    endif
  else
    if Incluido(FBN['Tipo'],'MMPCLM|MMPOSM|GAMV|CCMV|MMPIM|MMPEM|MMFIMV|MMSIMV')
      if Incluido(FBN['Tipo'],'MMPCLM|MMPOSM|MMPIM|MMPEM|MMFIMV|MMSIMV')
        SQL.ADD("Select Cantidad2 from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion =  '"~FBN['NrOp']~"' ")
        SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
        recorrer SQL
          DFA
          ACN(y3, FBN['Cantidad2']/1000)
        proximo
      else
        SQL.ADD("Select Cantidad1 from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion =  '"~FBN['NrOp']~"' ")
        SQL.ADD("and Fecha1 <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        SQL.ADD("and Fecha2 > '"~IdxDate(Dialogo.Fecha1)~"' ")
        recorrer SQL
          DFA
          ACN(y3, FBN['Cantidad1']/1000)
        proximo
      endif
    else
      if Incluido(FBN['Tipo'],'MMPLME|GA|CC|MMFRNP|MMPSI')
        ACN(y3, FBN['Cant']/1000)
      else
        ACN(y3, FBN['PreEj']/1000)
      endif
    endif
    ACN(ag:Val(y2), Val(y3))
    if Dialogo.Check1=1
      if Incluido(FBN['Tipo'],'MMPCLM|MMPOSM|GAMV|CCMV|MMPIM|MMPEM|MMFIMV|MMSIMV')
        SQL.ADD("Select Cantidad3,Fecha1,Fecha2,Plazo1 from "~DBO~".CUOTAS ")
        SQL.ADD("where NrOperacion =  '"~FBN['NrOp']~"' ")
        SQL.ADD("and Fecha1 < '"~IdxDate(Dialogo.Fecha1)~"' ")
        recorrer SQL
          DFA
          if FBN['Fecha2']<Dialogo.Fecha1
            SCN(y3, FBN['Cantidad3']/1000)
          else
            SCN(y3, FBN['Cantidad3']/FBN['Plazo1']*(Dialogo.Fecha1-FBN['Fecha1'])/1000)
          endif
        proximo
      else
        SCN(y3, FBN['TotInt']/FBN['Pla']*(Dialogo.Fecha1-FBN['FOp'])/1000)
      endif
    endif
    ACN(y3, Val(y3)*CotizacionC(FBN['Especie'],,,,FBN['FOp'],1,SI,'USD'))
    if Incluido(FBN['Tipo'],'MMPCL|MMPCLM|MMPLME')
      ACN(ae:Val(y2),1)
      SCN(52+Val(x1):Val(w1), Val(y3))
    endif
    if Incluido(FBN['Tipo'],'MMPCOS|MMPOSM')
      ACN(ae:Val(y2),1)
      SCN(78+Val(x1):Val(w1), Val(y3))
    endif
    if Incluido(FBN['Tipo'],'GA|GAMV|CC|CCMV|MMPI|MMPIM|MMPE|MMPEM|MMFRNP|MMFIMV|MMPSI|MMSIMV')
      ACN(ae:Val(y2),1)
      if EqStr(FBN['PaisDir'],'ARG') o Vacio(FBN['PaisDir'])
        SCN(52+Val(x1):Val(w1), Val(y3))
      else
        SCN(78+Val(x1):Val(w1), Val(y3))
      endif
    endif
  endif
proximo

SetFont(b:Val(y1)-1..p:Val(y1)-1,4)
AlinearCeldas(b:Val(y1)-1..p:Val(y1)-1,'C')
if FAC>=Val(y1)
  recorrer&i Val(y1),FAC
************************************************************
    if DesciendeDeCliente(Val(w:&i),'BLOCAL')
      ACN(aj:&i, 1)
      if EqStr(BuscarCampo('CLIENTES','PaisDir','Codigo',Val(w:&i)),'ARG') o Vacio(BuscarCampo('CLIENTES','PaisDir','Codigo',Val(w:&i)))
        if BuscarCampo('CLIENTES','RPC','Codigo',Val(w:&i))>0
          ACN(ak:&i, BuscarCampo('CLIENTES','RPC','Codigo',Val(w:&i))/1000)
        else
          ACN(ak:&i, BuscarCampo('CLIENTES','Patrimonio','Codigo',Val(w:&i))/1000*0.15)
        endif
      endif
      SQL.ADD("Select Codigo from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G")
      SQL.ADD("where Controlante = '"~Val(w:&i)~"'")
      SQL.ADD("and Codigo = Cliente ")
      SQL.ADD("and PaisDir <> 'ARG' ")
      SQL.ADD("and PaisDir is Not Null ")
      recorrer SQL
        DFA
        ACN(aq:&i, 1)
      proximo
    else
      SQL.ADD("Select Codigo, Patrimonio, FechaBal, RPC from "~DBO~".CLIENTES C, "~DBO~".GRUPOSECONOMICOS G")
      SQL.ADD("where Controlante = '"~Val(w:&i)~"'")
      SQL.ADD("and Codigo = Cliente ")
      SQL.ADD("and (PaisDir = 'ARG' or PaisDir is Null) ")
      recorrer SQL
        DFA
        ACN(aj:&i, 1)
        if FBN['RPC']>0
          ACN(ak:&i, FBN['RPC']/1000)
        else
          ACN(ak:&i, FBN['Patrimonio']/1000*0.15)
        endif
      proximo
    endif

*** Calculo Diaponible Grupo por Banco
    ACN(al:&i, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACLTOT' and Cliente = '"~Val(w:&i)~"' and Vehiculo is NULL")/1000)
    ACN(am:&i, SQL("Select Monto From "~DBO~".LIMASIGNADOS where Limite = 'ACOTOT' and Cliente = '"~Val(w:&i)~"' and Vehiculo is NULL")/1000)
    if Val(aq:&i)=1
      if Val(am:&i)=0
        if Val(al:&i)>0
          if Val(al:&i)>Val(ak:&i)
            ACN(am:&i, Val(ak:&i))
          else
            ACN(am:&i, Val(al:&i))
          endif
        endif
      endif
    endif
    ACN(bq:&i, SUM(bb:&i..bp:&i)+Val(bt:&i))
    ACN(cq:&i, SUM(cb:&i..cp:&i)+Val(ct:&i))
    ACN(ao:&i, Val(am:&i)-Val(cq:&i))
    if Val(al:&i)>Val(am:&i)
      ACN(an:&i, Val(al:&i))
    else
      ACN(an:&i, Val(am:&i))
    endif
    ACN(ap:&i, Val(an:&i)-Val(bq:&i)-Val(cq:&i))
    if Val(ap:&i)>=0
      if Val(ao:&i)>=0
        if Val(ao:&i)>Val(ap:&i)
          ACN(ao:&i, Val(ap:&i))
        endif
      endif
    else
      if Val(ao:&i)>=0
        ACN(ao:&i, 0)
      endif
    endif

*** Calculo Disponible por Empresa
    recorrer&j 2,Val(x2)+1
      if Val(130+&j:&i)=0
        if Val(104+&j:&i)>0
          ACN(130+&j:&i, Val(104+&j:&i))
        endif
      endif
      * Disponible Off-Shore
      ACN(&j:&i, Val(130+&j:&i)-Val(78+&j:&i))
      if Val(104+&j:&i)>Val(130+&j:&i)
        ACN(156+&j:&i, Val(104+&j:&i))
      else
        ACN(156+&j:&i, Val(130+&j:&i))
      endif
      ACN(182+&j:&i, Val(156+&j:&i)-Val(52+&j:&i)-Val(78+&j:&i))
      if Val(182+&j:&i)>=0
        if Val(&j:&i)>=0
          if Val(&j:&i)>Val(182+&j:&i)
            ACN(&j:&i, Val(182+&j:&i))
          endif
        endif
      else
        if Val(&j:&i)>=0
          ACN(&j:&i, 0)
        endif
      endif
      * Chequeo Contra Grupo
      if Val(&j:&i)>=0
        if Val(&j:&i)>Val(ao:&i)
          if Val(ao:&i)>=0
            ACN(&j:&i, Val(ao:&i))
          else
            ACN(&j:&i, 0)
          endif
        endif
      endif      
      if SQL("Select Count(*) from "~DBO~".VEHICULOS where Codigo = '"~Val(&j:Val(y1)-1)~"'")=0
        ACN(&j:&i, 0)
      endif      
    proximo

************************************************************
    ACN(q:&i, SUM(b:&i..p:&i))
  proximo
  FormatoCeldas(b:Val(y1)..t:FAC,EXE('F0R'))
  SetFont(a:Val(y1)..t:FAC,3)
endif
if FAC>Val(y1)+1
  OrdenarFilas(Val(y1)+1,FAC,1,'A')
endif
IFA
ACT(a:FAC, 'TOTAL')
ACN(b:FAC, SUM(b:Val(y1)..b:FAC-1))
ACN(c:FAC, SUM(c:Val(y1)..c:FAC-1))
ACN(d:FAC, SUM(d:Val(y1)..d:FAC-1))
ACN(e:FAC, SUM(e:Val(y1)..e:FAC-1))
ACN(f:FAC, SUM(f:Val(y1)..f:FAC-1))
ACN(g:FAC, SUM(g:Val(y1)..g:FAC-1))
ACN(h:FAC, SUM(h:Val(y1)..h:FAC-1))
ACN(i:FAC, SUM(i:Val(y1)..i:FAC-1))
ACN(j:FAC, SUM(j:Val(y1)..j:FAC-1))
ACN(k:FAC, SUM(k:Val(y1)..k:FAC-1))
ACN(l:FAC, SUM(l:Val(y1)..l:FAC-1))
ACN(m:FAC, SUM(m:Val(y1)..m:FAC-1))
ACN(n:FAC, SUM(n:Val(y1)..n:FAC-1))
ACN(o:FAC, SUM(o:Val(y1)..o:FAC-1))
ACN(p:FAC, SUM(p:Val(y1)..p:FAC-1))
ACN(q:FAC, SUM(q:Val(y1)..q:FAC-1))
ACN(t:FAC, SUM(t:Val(y1)..t:FAC-1))
FormatoCeldas(b:FAC..t:FAC,EXE('F0R'))
SetFont(a:FAC..t:FAC,2)
AgregarMarco(a:Val(y1)..q:FAC,1,3)
SetFont(ai:1..gp:FAC,1)

if Val(y2)>0
  SetFont(aa:1..ag:Val(y2),1)
  FormatoCeldas(af:1..ag:Val(y2),EXE('F0R'))
endif

SetFont(w1..z5,1)

ACO(1,15)
ACO(2,5)
ACO(3,5)
ACO(4,5)
ACO(5,5)
ACO(6,5)
ACO(7,5)
ACO(8,5)
ACO(9,5)
ACO(10,5)
ACO(11,5)
ACO(12,5)
ACO(13,5)
ACO(14,5)
ACO(15,5)
ACO(16,5)
