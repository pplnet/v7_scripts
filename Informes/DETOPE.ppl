CrearDialogo
  NrOperacion1 : '# Operacion'
FinDialogo

if not ok 
  Cancelar
endif

Recorrer ("Select * from "~DBO~".OPERACIONES where NrOperacion = '"~Dialogo.NrOperacion1~"'")
  ACT(a1, 'Nro Operacion')
  ACT(a2, 'Tipo Op')
  ACT(a3, 'Especie / Moneda')
  ACT(a4, 'C.Especie / M.Pago')
  ACT(a5, 'Fecha Op.')
  ACT(a6, 'Fecha Vto.')
  ACT(a7, 'Importe')
  ACT(a8, 'Precio')
  ACT(a9, 'Monto')
  ACT(a10, 'Cliente')
  ACT(a11, 'Operador')
  ACT(a12, 'Valor')
  ACT(a13, 'Puesto')
  ACT(a14, 'Corredor')
  ACT(a15, 'Comision')
  ACT(a16, 'Corresponsal')
  ACT(a17, 'Vehiculo')
  ACT(a18, 'Forma Liq.')
  ACT(a19, 'Cartera')
  ACT(a20, 'Sector')
  ACT(a21, 'Operacion Ref.')
  ACT(a22, 'Arbitraje')
*  ACT(a23, 'Convenio')
  ACT(a24, 'Rojo')
  ACT(a25, 'Pase')
  ACT(a26, 'Unidad')
  ACT(a27, 'Centro')
  ACT(a28, 'Sector')
  ACT(a29, 'Tipo')
  ACT(a30, 'Nr.Sis.Externo')
*  ACT(a18, '')
  ACT(b1,  fbn('NrOperacion'))
  ACT(b2,  fbn('TipoOp'))
  ACT(b3,  fbn('Especie'))
  ACT(b4,  fbn('ContraEspecie'))
  ACT(b5,  fbn('FechaOp'))
  ACT(b6,  fbn('FechaVto'))
  If Incluido(fbn('TipoOp'), 'FXCTC|FXVTC')   
     ACN(b7,  fbn('Cantidad')  *  BuscarCampo('ESPECIES','TamanioLote','Codigo',fbn('Especie')) )
  else   
     ACN(b7,  fbn('Cantidad') )
  Endif
  FormatoCeldas(b7..b7,Exe('F2'))
  ACN(b8,  fbn('Precio1'))
  FormatoCeldas(b8..b8,Exe('F6'))
  If Incluido(fbn('TipoOp'), 'CTC|CTP|VTC|VTP|CFTP|VFTP|FXCTC|FXVTC') 
     ACN(b9,  fbn('TotalNetoCli1'))
  Else
     ACN(b9,  fbn('TotalBrutoCli1'))
  EndIf
  FormatoCeldas(b9..b9,Exe('F2'))
  ACT(b10, fbn('Cliente1'))
  ACT(b11, fbn('Operador'))
  if EqStr(fbn('ValorRB1'), '0')
    ACT(b12, 'Hoy')
  else
    if EqStr(fbn('ValorRB1'), '1')
      ACT(b12, 'Normal')
    else
      if EqStr(fbn('ValorRB1'), '2')
        ACT(b12, '48 hs.')
      else
        if EqStr(fbn('ValorRB1'), '3')
          ACT(b12, '72 hs.')
        endif
      endif
    endif
  endif
  if EqStr(fbn('Puesto'), '1')
    ACT(b13, 'Si')
  else
    ACT(b13, 'No')
  endif
  ACT(b14, fbn('Corredor'))
  If Incluido(fbn('TipoOp'), 'CTC|CTP|VTC|VTP|CFTP|VFTP') 
     ACN(b15, fbn('TotalAux3'))
  Else
     ACN(b15, fbn('Precio3'))
  EndIf
  FormatoCeldas(b15..b15,Exe('F6'))
  ACT(b16, fbn('Cuenta1')) 
  if Incluido(fbn('TipoOp'), 'FXA|FXAT|FXP') y NoVacio(fbn('Cuenta2'))
    ACT(b16, Val(b16)~' / '~fbn('Cuenta2'))
  endif
  ACT(b17, fbn('Vehiculo1'))
  if EqStr(fbn('FormaLiquidacion1'), '0')
    ACT(b18, 'STD')
  else
    if EqStr(fbn('FormaLiquidacion1'), '1')
      ACT(b18, 'DVP')
    else
      if EqStr(fbn('FormaLiquidacion1'), '2')
        ACT(b18, 'RVP')
      endif
    endif
  endif
  if EqStr(fbn('Cartera'), '0')
    ACT(b19, 'Trading')
  else
    ACT(b19, 'Positioning')
  endif
  ACT(b20, fbn('SectorRB'))
  ACT(b21, fbn('OperacionRef'))
  if EqStr(fbn('Arbitraje'), '1')
    ACT(b22, 'Si')
  else
    ACT(b22, 'No')
  endif
*  if EqStr(fbn('Convenio'), '1')
*    ACT(b23, 'Si')
*  else
*    ACT(b23, 'No')
*  endif
  if EqStr(fbn('Rojo'), '1')
    ACT(b24, 'Si')
  else
    ACT(b24, 'No')
  endif
  if EqStr(fbn('PaseCB'), '1')
    ACT(b25, 'Si')
  else
    ACT(b25, 'No')
  endif
  ACT(b26, fbn('UDN1'))
  ACT(b27, fbn('Centro1'))
  ACT(b28, fbn('Sector1'))
  ACT(b29, fbn('TipoTicket'))
  ACT(b30, fbn('NrSisExterno'))
proximo

AgregarMarco(a1..b30, 2)
AgregarMarco(a1..a30, 1, 0, Exe('COLOR6'))

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

SetFont(a1..a:50, 1)
SetFont(b1..e:50, 2)
ACO(1, 15)
ACO(2, 15)
LimitesVision(b:31)