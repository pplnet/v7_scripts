MostrarCuadroDeMensajes
CrearDialogo
  Fecha1:    'Fecha'   ;;;;;;;;;fsys
  Especie1:  'Especie'
  Vehiculo1: 'Vehiculo'
  Radio1   : 'TipoPos.|Consol.|Trad.|In<=6m|Inv>6m|O.Soc.|Todas' ;;;;NO;NO;;;;5
  Radio2   : '|Concertada|Liquidada' ;;;;;;;;;0
  Lista1   : 'Book'         ;;;;;;;;;;;SQLSet("Select Codigo from "~DBO~".BOOKS ")
FinDialogo

IF NOT OK
   Cancelar
Endif


CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,8,BI')
CrearFont(4, 'Arial,10,B')


ACT(a:1, 'Informe de Posiciones y Resultados al '~Dialogo.Fecha1~' - '~iif(Dialogo.Radio2=0,'Por Fecha de Concertacion','Por Fecha de Liquidacion'))
ACT(a:3, 'Especie: '~iif(novacio(Dialogo.Especie1),Dialogo.Especie1,'Todas'))
ACT(a:4, 'Vehiculo: '~iif(novacio(Dialogo.Vehiculo1),Dialogo.Vehiculo1,'Todos'))
*ACT(a:5, 'Posicion: '~iif(Dialogo.Radio1=0,'Todas Consolidadas',iif(Dialogo.Radio1=1,'Trading',iif(Dialogo.Radio1=2,'Investment<=6 meses',iif(Dialogo.Radio1=3,'Investment>=6 meses',iif(Dialogo.Radio1=4,'Otras Sociedades','Todas Discriminadas'))))))
if NoVacio(Dialogo.Lista1)
  ACT(a:6, 'Book : '~Pipe2Comillas(Dialogo.Lista1))
else
  ACT(a:6, 'Book : Todos')
endif

SetFont(a:1, 4)
SetFont(a:2..z:6, 2)

SetFilaActual(8)
ACT(a:fac, 'Especie')
ACT(b:fac, 'Cupon')
ACT(c:fac, 'FechaEj')
ACT(d:fac, 'PrecioEj')
ACT(e:fac, 'CallPut')
ACT(f:fac, 'Nominales')
ACT(g:fac, 'Residuales')
ACT(h:fac, 'PrecioFin')

ACT(j:fac, 'Trading')
ACT(i:fac+1, 'Day')
ACT(j:fac+1, 'MTD')
ACT(k:fac+1, 'YTD')

ACT(m:fac, 'Realizado')
ACT(l:fac+1, 'Day')
ACT(m:fac+1, 'MTD')
ACT(n:fac+1, 'YTD')

ACT(p:fac, 'Revaluo')
ACT(o:fac+1, 'Day')
ACT(p:fac+1, 'MTD')
ACT(q:fac+1, 'YTD')

AgregarMarco(a:fac..e:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(a:fac..z:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(i:fac..k:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(l:fac..n:fac+1,0,0,EXE('COLOR6'))
AgregarMarco(o:fac..q:fac+1,0,0,EXE('COLOR6'))
SetFont(a:fac..z:fac+1, 2)
AlinearCeldas(a:fac..z:fac+1, 'C')

ifa

SQL.ADD(" SELECT P.Especie, P.Cupon, P.FechaEj, P.PrecioEj, P.CallPut, P.NrSaldo, P.Vehiculo, P.CantidadFin, ")
SQL.ADD(" E.Nombre, E.Tipo, E.EsCupon, E.CodNumCajaValores, E.CodMAEContado, V.Descripcion, E.Cotiza, P.Book, P.PrecioFin  ")
SQL.ADD(" FROM "~DBO~".POSICIONES P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
SQL.ADD(" WHERE P.Especie = E.Codigo ")
SQL.ADD(" AND   P.Cliente = V.Codigo ")
SQL.ADD(" AND   P.Vehiculo= V.Codigo ")
SQL.ADD(" AND   P.Fecha  <= "~idxdate2(Dialogo.Fecha1)~" ")
*SQL.ADD(" AND   P.CantidadFin <> 0 ")
SQL.ADD(" AND   (P.CantidadFin <> 0 OR P.CantidadIni<>0)")
If NoVacio(Dialogo.Especie1)
   SQL.ADD(" AND   P.Especie = '"~Dialogo.Especie1~"'  ")
Endif
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" AND   P.Cliente = '"~Dialogo.Vehiculo1~"'  ")
Endif
if NoVacio(Dialogo.Lista1)
  SQL.ADD(" and P.Book in( "~Pipe2Comillas(Dialogo.Lista1)~") ")
endif
If Dialogo.Radio2=0
   * Concertada
*   If Dialogo.Radio1=0
      SQL.ADD(" AND   P.NrSaldo IN (171) ")
*   Endif
IF NO
   If Dialogo.Radio1=1
      SQL.ADD(" AND   P.NrSaldo IN (173) ")
   Endif
   If Dialogo.Radio1=2
      SQL.ADD(" AND   P.NrSaldo IN (174) ")
   Endif
   If Dialogo.Radio1=3
      SQL.ADD(" AND   P.NrSaldo IN (175) ")
   Endif
   If Dialogo.Radio1=4
      SQL.ADD(" AND   P.NrSaldo IN (176) ")
   Endif
   If Dialogo.Radio1=5
      SQL.ADD(" AND   P.NrSaldo IN (173,174,175,176) ")
   Endif
ENDIF
Else
   * Liquidada
*   If Dialogo.Radio1=0
      SQL.ADD(" AND   P.NrSaldo IN (172) ")
*   Endif
IF NO
   If Dialogo.Radio1=1
      SQL.ADD(" AND   P.NrSaldo IN (177) ")
   Endif
   If Dialogo.Radio1=2
      SQL.ADD(" AND   P.NrSaldo IN (178) ")
   Endif
   If Dialogo.Radio1=3
      SQL.ADD(" AND   P.NrSaldo IN (179) ")
   Endif
   If Dialogo.Radio1=4
      SQL.ADD(" AND   P.NrSaldo IN (170) ")
   Endif
   If Dialogo.Radio1=5
      SQL.ADD(" AND   P.NrSaldo IN (177,178,179,170) ")
   Endif
ENDIF
Endif
SQL.ADD(" AND   P.Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".POSICIONES P1 ")
SQL.ADD("                   WHERE P1.Especie   = P.Especie  ")
SQL.ADD("                   AND   P1.Vehiculo  = P.Vehiculo ")
SQL.ADD("                   AND   P1.Cliente   = P.Cliente  ")
SQL.ADD("                   AND   P1.NrSaldo   = P.NrSaldo  ")
SQL.ADD("                   AND   P1.Book      = P.Book     ")
IF NO
SQL.ADD("                   AND   (P1.Book     = P.Book     OR (P1.Book     IS NULL AND P.Book     IS NULL) ) ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR (P1.Sector   IS NULL AND P.Sector   IS NULL) ) ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR (P1.CallPut  IS NULL AND P.CallPut  IS NULL) ) ")
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR (P1.Cupon    IS NULL AND P.Cupon    IS NULL) ) ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR (P1.FechaEj  IS NULL AND P.FechaEj  IS NULL) ) ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR (P1.PrecioEj IS NULL AND P.PrecioEj IS NULL) ) ")
ENDIF
SQL.ADD("                   AND   (P1.Cupon    = P.Cupon    OR ((P1.Cupon    IS NULL OR P1.Cupon   ='' OR P1.Cupon   =' ') AND (P.Cupon    IS NULL OR P.Cupon   ='' OR P.Cupon   =' ' )) )  ")
SQL.ADD("                   AND   (P1.Sector   = P.Sector   OR ((P1.Sector   IS NULL OR P1.Sector  ='' OR P1.Sector  =' ') AND (P.Sector   IS NULL OR P.Sector  ='' OR P.Sector  =' ' )) )  ")
SQL.ADD("                   AND   (P1.CallPut  = P.CallPut  OR ((P1.CallPut  IS NULL OR P1.CallPut ='' OR P1.CallPut =' ') AND (P.CallPut  IS NULL OR P.CallPut ='' OR P.CallPut =' ' )) )  ")
SQL.ADD("                   AND   (P1.FechaEj  = P.FechaEj  OR ((P1.FechaEj  IS NULL OR P1.FechaEj ='' OR P1.FechaEj =' ') AND (P.FechaEj  IS NULL OR P.FechaEj ='' OR P.FechaEj =' ' )) )  ")
SQL.ADD("                   AND   (P1.PrecioEj = P.PrecioEj OR ((P1.PrecioEj IS NULL OR P1.PrecioEj='' OR P1.PrecioEj=' ') AND (P.PrecioEj IS NULL OR P.PrecioEj='' OR P.PrecioEj=' ' )) )  ")



SQL.ADD("                   AND   P1.Fecha     <= "~idxdate2(Dialogo.Fecha1)~" ")
SQL.ADD("                  ) ")
SQL.ADD(" ORDER BY P.Vehiculo, P.NrSaldo, P.Book, E.Tipo, P.Especie ")
ACN(xx:1, 0)
ACT(xx:2, '')
ACT(xx:3, '')

Recorrer SQL
  If Not Eqstr(fbn('Vehiculo'), Val(xx:2))
     If NoVacio(Val(xx:2))
        ifa
     Endif
     ACT(a:fac, fbn('Vehiculo')~' - '~fbn('Descripcion'))
     SetFont(a:fac..z:fac, 2)
     AgregarMarco(a:fac..z:fac,0,0,EXE('COLOR8'))
     ifa
  Endif

  If fbn('NrSaldo')<>Val(xx:1) o Not Eqstr(fbn('Book'), Val(xx:3))
     If Val(xx:1)<>0
        ifa
     Endif
     If fbn('NrSaldo')=101 o fbn('NrSaldo')=102 o fbn('NrSaldo')=171 o fbn('NrSaldo')=172
        ACT(a:fac, 'Todas las posiciones consolidadas '~fbn('Book'))
     Endif
     If fbn('NrSaldo')=103 o fbn('NrSaldo')=107 o fbn('NrSaldo')=173 o fbn('NrSaldo')=177
        ACT(a:fac, 'Tipo Posicion: Trading - Book: '~fbn('Book'))
     Endif
     If fbn('NrSaldo')=104 o fbn('NrSaldo')=108 o fbn('NrSaldo')=174 o fbn('NrSaldo')=178
        ACT(a:fac, 'Tipo Posicion: Investment<=6m - Book: '~fbn('Book'))
     Endif
     If fbn('NrSaldo')=105 o fbn('NrSaldo')=109 o fbn('NrSaldo')=175 o fbn('NrSaldo')=179
        ACT(a:fac, 'Tipo Posicion: Investment>=6m - Book: '~fbn('Book'))
     Endif
     If fbn('NrSaldo')=106 o fbn('NrSaldo')=110 o fbn('NrSaldo')=176 o fbn('NrSaldo')=170
        ACT(a:fac, 'Tipo Posicion: Otras Sociedades - Book: '~fbn('Book'))
     Endif
     SetFont(a:fac..z:fac, 3)
     AgregarMarco(a:fac..z:fac,0,0)
     ifa
  Endif

  ACT(a:fac, fbn('Especie')~' - '~fbn('Nombre'))
  ACT(b:fac, fbn('Cupon'))
  ACD(c:fac, fbn('FechaEj'))
  ACN(d:fac, fbn('PrecioEj'))
  ACT(e:fac, fbn('CallPut'))
  ACN(f:fac, fbn('CantidadFin'))
  ACN(h:fac, fbn('PrecioFin'))
  FormatoCeldas(h:fac, EXE('F9'))

  SetFont(a:fac..z:fac, 1)

  SQL.ADD(" SELECT Day, MTD, YTD, TipoResultado, Fecha FROM "~DBO~".RESULTADOS R  ")
  SQL.ADD(" WHERE Especie   = '"~fbn('Especie')~"'     ")
  SQL.ADD(" AND   NrSaldo   = "~fstr(fbn('NrSaldo'),0,0)~" ")
  SQL.ADD(" AND   Vehiculo  = '"~fbn('Vehiculo')~"'    ")
  SQL.ADD(" AND   Book      = '"~fbn('Book')~"'        ")
  SQL.ADD(" AND   Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ")
  SQL.ADD(" AND   Fecha IN (SELECT MAX(Fecha) FROM "~DBO~".RESULTADOS R1 ")
  SQL.ADD("                 WHERE R.Especie  = R1.Especie  ")
  SQL.ADD("                 AND   R.NrSaldo  = R1.NrSaldo  ")
  SQL.ADD("                 AND   R.Vehiculo = R1.Vehiculo ")
  SQL.ADD("                 AND   R.Book     = R1.Book     ")
  SQL.ADD("                 AND   R.TipoResultado     = R1.TipoResultado    ")
  SQL.ADD("                 AND   R1.Fecha  < = "~idxdate2(Dialogo.Fecha1)~" ) ")
  Recorrer SQL
    dfa
    If Eqstr(fbn('TipoResultado'),'TRADE')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(i:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(j:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(k:fac, fbn('YTD'))
       Endif
    Endif
    If Eqstr(fbn('TipoResultado'),'REALIZ')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(l:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(m:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(n:fac, fbn('YTD'))
       Endif
    Endif
    If Eqstr(fbn('TipoResultado'),'REVAL')
       If fbn('Fecha')=Dialogo.Fecha1
          ACN(o:fac, fbn('Day'))
       Endif
       If mes(fbn('Fecha'))=mes(Dialogo.Fecha1)
          ACN(p:fac, fbn('MTD'))
       Endif
       If Anio(fbn('Fecha'))=Anio(Dialogo.Fecha1)
          ACN(q:fac, fbn('YTD'))
       Endif
    Endif
    SetFont(a:fac..z:fac, 1)
    FormatoCeldas(i:fac..q:fac, EXE('F2'))
  Proximo

  FormatoCeldas(d:fac, EXE('F9'))
  FormatoCeldas(F:fac, EXE('F2'))
  FormatoCeldas(H:fac, EXE('F9'))
  SetFont(a:fac..z:fac, 1)

  ACN(xx:1, fbn('NrSaldo'))
  ACT(xx:2, fbn('Vehiculo'))
  ACT(xx:3, fbn('Book'))
Proximo

ifa
ifa
ifa
ACO(1,15)

ACT(a:fac, 'Fin del Informe.')
SetFont(a:fac, 1)
LimitesVision(Q:fac+2)
Impresion(1,2)
Impresion(4,1)
SetMargins(0,0,0,2)