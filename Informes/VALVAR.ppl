    String1: "Variable: "                                    ;1;1;;;;;;;
    Radio1 : "Variables que |Se usan |No se usan  |Ambas  "  ;2;1;;;;;;;2
FinDialogo

************* DEFINICION DE CAMPOS DE PANTALLA FIN ***************

*************

IF Not Ok
  Cancelar
ENDIF

*************

************* DEFINICION DE FUENTE ***************

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

************* DEFINICION DE FUENTE FIN ***********

************* CABECERA DEL LISTADO ***************

SetFilaActual(1)
ACT(A:1,'Busqueda de Variables')
ACT(A:2,'Fecha: '~Var('FECHASYS'))
SetFont(A:1..E:2,3)

IFA
IFA
IFA

ACT(A:FAC, "Codigo")
ACT(B:FAC, "Nombre")
ACT(C:FAC, "¿Se usa?")
ACT(D:FAC, "Valor")

AlinearCeldas(A:FAC..D:FAC,'I')
SetFont(A:FAC..D:FAC, 2)
AgregarMarco(A:FAC..D:FAC,2,0,Exe('COLOR'))

************* CABECERA DEL LISTADO FIN ***************

IF NoVacio (Dialogo.String1)

   MessageBox('Variable - '~Dialogo.String1)
ELSE
  IF Dialogo.Radio1 = 0 
     MessageBox('Todas las variables que se usan.')
  ELSE
    IF Dialogo.Radio1 = 1
       MessageBox('Todas las variables que no se usan.')
    ELSE
       MessageBox('Todas las variables.')
    ENDIF
  ENDIF
ENDIF

************* QUERY A LA TABLA ***************

SQL.ADD(" SELECT Codigo, Nombre, Valor FROM "~DBO~".VARIABLES ")
IF NoVacio (Dialogo.String1)
    SQL.ADD("  WHERE Codigo = '"~Dialogo.String1~"' ")
ENDIF

SQL.ADD(" ORDER BY Codigo ")

************* QUERY A LA TABLA FIN ***************

