ACN(Z3, Ahora)

* ACT(A20, SQL("select DB_NAME() AS DataBaseName "))

Recorrer&i 1, 15
  ACN(Z1, Ahora)
  ACT(Z2, SQL("select count(*) from dbo.VARIABLES where Codigo = 'FSYS'"))

  ACT(A:&i, 'Llamada :'~FStr(&i, 2, 0))
  ACN(B:&i, (Ahora-Val(Z1))*86400)
Proximo

ACT(A17, 'Total :')
ACN(B17, (Ahora-Val(Z3))*86400)

FormatoCeldas(A1..B20, '0,.0000000000;(0,.0000000000)R')
