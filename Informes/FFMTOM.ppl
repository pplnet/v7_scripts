CrearDialogo
  Lista1   : 'Vehiculo'    ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Entero1  : 'Columnas a Recuperar' ;;;;;;;;;;;
  String1  : 'Path'        ;;;;;;;;;VAR('DIRDEFAULT')
FinDialogo

If not OK
  Cancelar
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')

*- Calculo la Diferencia entre columna aa (27) y Entero1
*- Linkeo la Curva de Futuros Simulada
ImportarWKS(a1..Dialogo.Entero1:13,a1..Dialogo.Entero1:13,Dialogo.String1~'FFT'~Dialogo.Vehiculo1~'.WKS')

*- En la Ultima Columna ubico el total
act(Dialogo.Entero1-27+2:5,'Total')

* Recorro las Filas sumando Cobro, Collateral y Neto
Recorrer&j 6,8
   acn(Dialogo.Entero1-27+2:&j,Sum(b:&j..Dialogo.Entero1-27+1:&j))
Proximo

SetFont(a:1..Dialogo.Entero1-27+2:5,1)
SetFont(a:10..Dialogo.Entero1-27+2:10,1)
SetFont(a:1..a:13,1)
SetFont(b:6..Dialogo.Entero1-27+2:13,2)

*- Recorro las Columnas
Recorrer&i 1,Dialogo.Entero1-27+2
 ACO(&i,15)
Proximo

BorrarCeldas(b1..Dialogo.Entero1-27+2:4)

*- PPal
AgregarMarco(a:5..Dialogo.Entero1-27+2:5,2,0,Exe('COLOR'))
AgregarMarco(a:6..a:8,2,0,Exe('COLOR'))
AgregarMarco(b:5..Dialogo.Entero1-27+2:8,1,3)

*- Corto y largo plazo
AgregarMarco(a:10..c:10,2,0,Exe('COLOR'))
AgregarMarco(a:11..a:13,2,0,Exe('COLOR'))
AgregarMarco(b:10..c:13,1,3)

SetFilaActual(14)
act(a:fac,'FIN DE LISTADO')
SetFont(a:fac..a:fac,1)

LimitesVision(Dialogo.Entero1-27+2:fac)