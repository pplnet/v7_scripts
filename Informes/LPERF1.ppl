if EQSTR(VAR('INSTALACIO'),'MLASA')
*ModoReproceso(ConDialogo)
CrearDialogo
  Cliente1   : 'Cliente' ;;;;;;NoVacio(Dialogo.Cliente1);'Debe ingresar un Cliente';NO;
  TipoLimite1: 'Limite'  ;;;;;;NoVacio(Dialogo.TipoLimite1) y EqStr(BuscarCampo('TIPOSLIMITE','Clase','Codigo',Dialogo.TipoLimite1),'C');'Debe ingresar un Tipo de Limite de Credito';NO;;;;;;"  Clase='C' "
  Vehiculo1  : 'Vehiculo';;;;;;;;;VAR('VEHICULODE')
  Fecha1     : 'Fecha Desde'   ;4;1;;;;NoVacio(Dialogo.Fecha1);'Debe ingresar la Fecha Desde';NO;PriDeMes(FSys,SI);
  Fecha2     : 'Fecha Hasta'   ;5;1;;;;NoVacio(Dialogo.Fecha2);'Debe ingresar la Fecha Hasta';NO;FinDeMes(FSys,SI);
FinDialogo

if Not Ok
   Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')

AgregarBMP(a1,Exe('LOGO'),Exe('ESCALOGO'))

ACT(a:4, 'Detalle de Limites Perfilamiento Clientes')
ACT(a:5, 'Cliente : '~Dialogo.Cliente1)
ACT(a:6, 'Limite : '~Dialogo.TipoLimite1)
ACT(a:7, 'Fecha : '~Dialogo.Fecha1~' al '~Dialogo.Fecha2)

ACT(a:9, 'Cliente')
ACT(b:9, 'Limite')
ACT(c:9, 'Fecha')
ACT(d:9, 'Especie')
ACT(e:9, 'Operacion')
ACT(f:9, 'Tipo')
ACT(g:9, 'Consumido')
ACT(h:9, 'Acumulado')
AgregarMarco(a:9..h:9,1,1,Exe('COLOR6'))
SetFont(a:1..h:9,2)

SetFilaActual(9)
SQL.ADD("Select ML.*, OP.TipoOp from "~DBO~".MOVLIMITES ML , "~DBO~".OPERACIONES OP ")
SQL.ADD("where Cliente = '"~Dialogo.Cliente1~"' ")
SQL.ADD("and ML.NrOperacion = OP.NrOperacion ")
if NoVacio(Dialogo.Vehiculo1)
  SQL.ADD("and Vehiculo = '"~Dialogo.Vehiculo1~"' ")
endif
if Dialogo.Fecha1=Dialogo.Fecha2
   SQL.ADD("and (FechaMov >= '"~IdxDate(PriDeMes(Dialogo.Fecha1))~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"'  and Bits = 'P' and Monto > 0)  ")
Else
   SQL.ADD("and (FechaMov >= '"~IdxDate(Dialogo.Fecha1)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"'  and Bits = 'P' and Monto > 0)  ")
Endif
SQL.ADD("and Limite = '"~Dialogo.TipoLimite1~"'")
SQL.ADD("order by Limite,TipoOp,Especie,FechaMov")
watch(SQL.BATCH())
ACT(tp:1,'VACIO')
recorrer SQL
   If not EqStr(FBN['TipoOp'],Val(tp:1))
       ifa
       ACT(tp:1,FBN['TipoOp'])
   Endif
   ACN(to:1,99)
   if Dialogo.Fecha1=Dialogo.Fecha2
      ACN(to:1,SQL("select 1 from "~DBO~".MOVLIMITES where Cliente= '"~FBN['Cliente']~"' and Limite='"~FBN['Limite']~"' and NrOperacion='"~FBN['NrOperacion']~"' and FechaMov >= '"~IdxDate(PriDeMes(Dialogo.Fecha1)+1)~"' and FechaMov <= '"~IdxDate(Dialogo.Fecha2)~"'  and Bits = 'P' and Monto < 0"))
   Endif 
  
   IF FBN['Monto']<>0 and Val(to:1)<>1
      ACT(a:FAC, FBN['Cliente'])
      ACT(b:FAC, FBN['Limite'])
      ACT(c:FAC, FBN['FechaMov'])
      ACT(d:FAC, FBN['Especie'])
      ACT(e:FAC, FBN['NrOperacion'])
      ACT(f:FAC, FBN['TipoOp'])
      ACN(g:FAC, FBN['Monto'])
      ACN(h:FAC, Val(h:FAC-1)+Val(g:FAC))
      SCN(to:10, Val(g:FAC))
      ACLO(e:fac, Val(e:fac))
   Else
      DFA
   Endif
proximo

SetFont(a:10..h:FAC,1)
SetFilaActual(FAC+2)
ACT(f:FAC, 'Limite Consumido')
ACN(h:FAC, Val(to:10))
SetFont(f:FAC..h:FAC,2)
FormatoCeldas(g:10..h:FAC,EXE('F2'))

ACO(1,7)
ACO(2,7)
ACO(3,7)
ACO(4,7)
ACO(5,7)
ACO(6,7)
ACO(7,10)
ACO(8,10)

LimitesVision(h:FAC)
** Endif por INSTALACION
Endif