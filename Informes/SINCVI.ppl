CrearDialogo
  Fecha1     : "Fecha"    ; 1; ;;;;Dialogo.Fecha1<>0;'Debe Ingresar la Fecha';NO;FSys
  Cliente1   : "Cliente"  ;  ; ;;;;;;;
  Vehiculo1  : "Vehiculo" ;  ; ;;;;NoVacio(Dialogo.Vehiculo1);'Debe ingresar un vehiculo';NO;VAR('VEHICULODE')
FinDialogo
IF Not Ok
  Cancelar
ENDIF

CrearFont(1,"Arial,8,")
CrearFont(2,"Arial,8,B")
CrearFont(3,"Arial,10,B")

* Reconstruye saldos por si se hubiera desliquidado FValor
EjecutarEvento('DES81')

ACT(x:1, VAR('MERCUSMON'))

SetFilaActual(4)
ACT(a:fac, 'Saldo Cuenta Vista')
SetFont(a:fac,3)

SetFilaActual(fac+2)
ACT(a:fac, 'Fecha')
ACT(a:fac+1, 'Cliente')
ACT(a:fac+2, 'Vehiculo')
SetFont(a:fac..a:FAC+2,2)

ACD(b:fac, Dialogo.Fecha1)
AlinearCeldas(b:fac,'I')
if NoVacio(Dialogo.Cliente1)
  ACT(b:fac+1, Dialogo.Cliente1~' - '~BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Cliente1))
else
  ACT(b:fac+1, 'Todos')
endif
ACT(b:fac+2, Dialogo.Vehiculo1)
SetFont(a:fac..a:FAC+2,1)

SetFilaActual(fac+4)

ACT(a:fac, 'Cliente')
ACT(b:fac, 'Razon Social')
ACT(c:fac, 'Mercado')
ACT(d:fac, 'Cuenta')
ACT(e:fac, 'Moneda')
ACT(f:fac, 'Saldo')

SetFont(a:fac..p:fac,2)
AgregarMarco(a:fac..f:fac,0,0,Exe('COLOR'))
ACN(w:1, FAC)

SQL.ADD("SELECT  Cliente, Especie, Mercado, EnteCustodia, Cuenta, Sum(Saldo) as Saldo, Cupon")
SQL.ADD("FROM (")

SQL.ADD("SELECT         S1.Cliente, S1.Mercado, S1.Cuenta,  S1.Especie, ")
SQL.ADD("        ISNULL(S1.Cupon, '') AS Cupon, S1.Saldo,   S1.EnteCustodia")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD("WHERE S1.EnteCustodia = '"~Dialogo.Vehiculo1~"'")

IF NoVacio(Dialogo.Cliente1)
   SQL.ADD("and S1.Cliente = '"~Dialogo.Cliente1~"' ")
ENDIF

SQL.ADD("  and S1.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("  and S1.NrSaldo = 81")

SQL.ADD("  and round(S1.Saldo,2) <> 0 ")
SQL.ADD("  and S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE IsNull(S2.Cliente,'')      = IsNull(S1.Cliente,'')      ")
SQL.ADD("                    and IsNull(S2.Especie,'')      = IsNull(S1.Especie,'')      ")
SQL.ADD("                    and IsNull(S2.EnteCustodia,'') = IsNull(S1.EnteCustodia,'') ")
SQL.ADD("                    and IsNull(S2.Mercado,'')      = IsNull(S1.Mercado,'')      ")
SQL.ADD("                    and IsNull(S2.NrSaldo,'')      = IsNull(S1.NrSaldo,'')      ")
SQL.ADD("                    and IsNull(S2.Cuenta,'')       = IsNull(S1.Cuenta,'')       ")
SQL.ADD("                    and IsNull(S2.Book,'')         = IsNull(S1.Book,'')         ")
SQL.ADD("                    and IsNull(S2.Cupon,'')        = IsNull(S1.Cupon,'')        ")
SQL.ADD("                    and S2.Fecha       < '"~IdxDate(Dialogo.Fecha1)~"' )        ")

*Rueda Garantizada invierto cantidad
SQL.ADD(" UNION ALL ")
SQL.ADD("SELECT        S3.Cliente,              S3.Mercado,  S3.Cuenta,   S3.Especie, ")
SQL.ADD("       ISNULL(S3.Cupon, '') AS Cupon, -S3.Cantidad Saldo, S3.EnteCustodia")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS S3")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONES O")
SQL.ADD("    on  S3.NrOperacion  = O.NrOperacion")
SQL.ADD("WHERE   S3.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
SQL.ADD("    and ((O.TipoOp  in('TIC','TIV') and (O.CB4 = 1 or O.Cliente1=O.Vehiculo1)) OR (O.TipoOp  in('TCOPRI')))")
SQL.ADD("    and S3.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("    and S3.NrSaldo = 1")
SQL.ADD("    and S3.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' " )
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD("    and S3.Cliente = '"~Dialogo.Cliente1~"' ")
ENDIF
    
*Resto de los movimientos 
SQL.ADD(" UNION ALL ")
SQL.ADD("SELECT        S3.Cliente,             S3.Mercado,  S3.Cuenta,  S3.Especie, ")
SQL.ADD("       ISNULL(S3.Cupon, '') AS Cupon, S3.Cantidad Saldo, S3.EnteCustodia")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS S3")
SQL.ADD("LEFT JOIN "~DBO~".OPERACIONES O")
SQL.ADD("    on  S3.NrOperacion  = O.NrOperacion")
SQL.ADD("WHERE   S3.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
SQL.ADD("    and not((IsNull(O.TipoOp,'') in('TIC','TIV') and (IsNull(O.CB4, 0) = 1 or IsNull(O.Cliente1,'')=IsNull(O.Vehiculo1,''))) OR (IsNull(O.TipoOp,'') in('TCOPRI')))")
SQL.ADD("    and S3.Mercado in ("~pipe2comillas(Val(x:1))~" ) ")
SQL.ADD("    and S3.NrSaldo = 1")
SQL.ADD("    and S3.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' " )
IF NoVacio(Dialogo.Cliente1)
   SQL.ADD("    and S3.Cliente = '"~Dialogo.Cliente1~"' ")
ENDIF

SQL.ADD(") SaldoTotal")
SQL.ADD("GROUP BY Cliente, Mercado, Cuenta, Especie, Cupon, EnteCustodia")
SQL.ADD("ORDER BY Cliente, Mercado, Cuenta, Especie, Cupon")

WATCH(SQL.BATCH())

