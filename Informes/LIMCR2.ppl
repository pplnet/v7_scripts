SetFont(a1..az:8, 1)
SetFont(a9..az:fac, 2)

FormatoCeldas(b9..q:fac, Exe('F2'))

ACO(1,8)
ACO(2,15)
ACO(3,10)
ACO(4,10)
ACO(5,10)
ACO(6,10)
ACO(7,10)
ACO(8,10)
