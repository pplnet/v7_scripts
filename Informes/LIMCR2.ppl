CrearFont(1,'Arial,8,B')
CrearFont(2,'Arial,8,')

ACT(a4, 'Lineas de Credito Asignadas')

ACT(a7, 'Entidad')
ACT(b7, 'Nombre')
ACT(b8, 'Entidad')

*-- A partir de la B muestro los tipos de limites asignados
ACN(cl1,3)
ACN(cl2,3)

SQL.ADD("Select DISTINCT L.Limite from "~DBO~".LIMASIGNADOS L, "~DBO~".TIPOSLIMITE T ")
SQL.ADD("Where L.Limite=T.Codigo and T.Clase='C' Order By L.Limite ")

Recorrer SQL
  dfa
  ACT(val(cl1)  :7, FBN['Limite'])  
  ACT(val(cl1)  :8, 'Monto')
  ACT(val(cl1)+1:8, 'F.Revision')
  ACT(val(cl1)+2:8, 'F.Vto.')

  AgregarMarco(val(cl1):7..val(cl1)+2:8,1)
  AgregarMarco(val(cl1):8..val(cl1)+2:8,1)

  SCN(cl1,3)
Proximo

AgregarMarco(a7..val(cl1):8,1,0,Exe('COLOR'))

SetFilaActual(8)

SQL.ADD("Select C.Codigo, C.RazonSocial, L.* from "~DBO~".CLIENTES C, "~DBO~".LIMASIGNADOS L, "~DBO~".TIPOSLIMITE T ")
SQL.ADD("where C.Codigo=L.Cliente and L.Limite=T.Codigo and T.Clase='C' Order by C.Codigo,L.Limite ")

Recorrer SQL
  Message(fbn('Codigo'))
  dfa

  if Not EqStr(Val(z1), fbn('Codigo'))
     ACT(z1, fbn('Codigo'))
     ifa
     ACT(a:fac, fbn('Codigo'))
     ACT(b:FAC,copy(FBN['RazonSocial'],1,25))
     ACN(cl2,3)
  endif

  Recorrer&j 1,val(cl1) 
    If Not EqStr(fbn('Limite'),val(val(cl2):7))
       SCN(cl2, 3)
    Endif
  Proximo
  
  ACN(Val(cl2)  :fac, fbn('Monto'))
  ACT(Val(cl2)+1:fac, fbn('FRevision'))
  ACT(Val(cl2)+2:fac, fbn('FVencimiento'))

Proximo

AgregarMarco(a9..a:fac,1)

ACN(cl2,2)
AgregarMarco(a:9..b:fac,1)
AgregarMarco(c:9..e:fac,1)
AgregarMarco(f:9..h:fac,1)
AgregarMarco(i:9..k:fac,1)
AgregarMarco(l:9..n:fac,1)
AgregarMarco(o:9..q:fac,1)
AgregarMarco(r:9..t:fac,1)
AgregarMarco(u:9..w:fac,1)

