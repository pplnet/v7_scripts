ACO(10,10)
ACO(11,10)
ACO(12,10)
ACO(13,10)
ACO(14,10)
ACO(15,10)
ACO(16,10)

Ifa
Ifa

ACT(a:fac,'FIN LISTADO')
SetFont(a:fac, 1)

LimitesVision(val(cl1)-1:fac)
Impresion(1,2)
Rangotitulo(a:1..Val(cl1)-1:fac,2)

SetPrintFit(3, 60)
