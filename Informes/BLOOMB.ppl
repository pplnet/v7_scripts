* recorrer valores
Recorrer&i Val(z2),Val(z3)

  Message('Especie '~VAL(a:Val(z5)))
  
  *-- armar celda excel
  ACT(z6,'l'~FStr(&i,1,0)~'c3')  

  *-- buscar especie
  if SQL("Select count(*) from "~DBO~".ESPECIES where Codigo='"~Val(a:Val(z5))~"' ")=1
     * Calcular el precio
     if [DesciendeDeEspecie(Val(a:Val(z5)),'PUBLIC')]
        ACF(b:Val(z5), LinkDDE(Val(z6))/100)
     else
        ACF(b:Val(z5), LinkDDE(Val(z6)))
     endif
  else
     ACF(b:Val(z5), LinkDDE(Val(z6)))
  endif

  Message('Cotizacion '~VAL(b:Val(z5)))
  SCN(z5,1)
Proximo

SetFont(a1..z3, 1)
SetFont(a4..z:Val(z5), 2)
LimitesVision(i:Val(z5)+2)
FormatoCeldas(b1..c:Val(z5)+2, Exe('F7'))
