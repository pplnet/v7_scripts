*- PFEVOL - Posicion Financiera - Evolutivo -
*- Si Encuentra las Grabacion de la 1er. y 2da. Fecha las tomas sino 
*- Obtiene el Cuadro de Posicion Financiera y lo Graba. Ahi Calcula el Evolutivo.
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1     : "Fecha 1"               ;;;;;;Dialogo.Fecha1<>0             ;'Debe Ingresar una Fecha';NO;Habiles(FSys,-2,'ARG',SI)
  Fecha2     : "Fecha 2"               ;;;;;;Dialogo.Fecha2>=Dialogo.Fecha1;'Debe Ingresar una Fecha Futura';NO;Habiles(FSys,-1,'ARG',SI)
  Radio1     : "Tipo|Total|Vinculadas" ;;;;;;;;;0
  Vehiculo1  : "Empresa"               ;;;;Dialogo.Radio1=1;Dialogo.Radio1=1;Dialogo.Radio1=0 o NoVacio(Dialogo.Vehiculo1);'Debe Ingresar una Empresa';NO;
FinDialogo
if Not Ok
  Cancelar
endif


if Dialogo.Radio1 = 0
   If [SQL("Select Count(*) from "~DBO~".VEHICULOS ") <> SQL("Select Count(*) from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"' ")] y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con Todos los Vehiculos ')
   endif
endif
if Dialogo.Radio1 = 1
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
  else
endif

CrearFont(1,"Arial,9,")
CrearFont(2,"Arial,9,B")
CrearFont(3,"Arial,8,")
CrearFont(4,"Arial,8,B")


ACT(a1,'Posicion Financiera - EVOLUTIVO     '~Dialogo.Fecha1~' y '~Dialogo.Fecha2)
SetFont(a:1..a:1,2)

(.'MARCOPOSFI'.)

Message('Linkeo Los Valores de La Hoja Futura')

*- Codigo del PMG
If Dialogo.Fecha2=FinDeMes(Dialogo.Fecha2,NO,'ARG')
   act(zz2,'PFNEW')
   act(zz3,'VERPF')
Else
   act(zz2,'POSFIN')
   act(zz3,'VERPF2')
EndIf

If Dialogo.Radio1=0
   act(zz1,'TODOS/'~Dialogo.Fecha2)
Else
   act(zz1,Dialogo.Vehiculo1~'/'~Dialogo.Fecha2)
EndIf

if SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='"~val(zz2)~"' and Extension='"~VAL(zz1)~"' ")=0
   Message('Genero Posicion Financiera Futuro '~Dialogo.Fecha2~' '~Iif(Dialogo.Radio1=0,'Total ',Dialogo.Vehiculo1)~' ...' )
   LinkearHoja('PFNEW',1,Fecha1=Dialogo.Fecha2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Check1=1)
   * CerrarLink(1)
EndIf

Message('Recupero Posicion Financiera Futuro '~Dialogo.Fecha2~' '~Iif(Dialogo.Radio1=0,'Total ',Dialogo.Vehiculo1)~' ...' )
LinkearHoja(val(zz3),1,Fecha1=Dialogo.Fecha2,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1)


Recorrer&j 2,300

  If NoVacio(LinkH(1,&j:2))
     Message(LinkH(1,&j:2))
  Else
     Break
  EndIf

  Recorrer&i 1,110     
     If NoVacio(LinkH(1,&j:&i))
        If &i>5 y &j>1
           acn(&j:&i,LinkH(1,&j:&i))
        Else
           act(&j:&i,LinkH(1,&j:&i))
        EndIf
     EndIf
   Proximo

   ACO(&j,10)
   SetFont(&j:1..&j:110,3)
   SetFont(&j:2..&j:2,4)
Proximo

Message('Linkeo Los Valores de La Hoja Presente')

*- Codigo del PMG
If Dialogo.Fecha1=FinDeMes(Dialogo.Fecha1,NO,'ARG')
   act(zz2,'PFNEW')
   act(zz3,'VERPF')
Else
   act(zz2,'POSFIN')
   act(zz3,'VERPF2')
EndIf

If Dialogo.Radio1=0
   act(zz1,'TODOS/'~Dialogo.Fecha1)
Else
   act(zz1,Dialogo.Vehiculo1~'/'~Dialogo.Fecha1)
EndIf

if SQL("Select count(*) from "~DBO~".OBJETOS where Codigo='"~val(zz2)~"' and Extension='"~VAL(zz1)~"' ")=0
   Message('Genero Posicion Financiera Contado '~Dialogo.Fecha1~' '~Iif(Dialogo.Radio1=0,'Total ',Dialogo.Vehiculo1)~' ...' )
   LinkearHoja('PFNEW',2,Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1,Check1=1)
   * CerrarLink(2)
EndIf

Message('Recupero Posicion Financiera  Contado '~Dialogo.Fecha1~' '~Iif(Dialogo.Radio1=0,'Total ',Dialogo.Vehiculo1)~' ...' )
LinkearHoja(val(zz3),2,Fecha1=Dialogo.Fecha1,Radio1=Dialogo.Radio1,Vehiculo1=Dialogo.Vehiculo1)

Recorrer&j 2,300

  If NoVacio(LinkH(2,&j:2))
     Message(LinkH(2,&j:2))
  Else
     Break
  EndIf

  Recorrer&i 1,110     
     If NoVacio(LinkH(2,&j:&i))
        If &i>5 y &j>1
           scn(&j:&i,-LinkH(2,&j:&i))
        Else
           act(&j:&i,LinkH(2,&j:&i))
        EndIf
     EndIf
   Proximo

   ACO(&j,10)
   SetFont(&j:1..&j:110,3)
   SetFont(&j:2..&j:2,4)
Proximo

Impresion(1,2)
LimitesVision(LinkH(2,b:200)+2:130)
