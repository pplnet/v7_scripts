*ModoReproceso(ConDialogo)
*GrillaVisible(SI)

CrearDialogo
  NrOperacion1   : "NrOperacion"        ;1;1;1;;;NOVACIO(Dialogo.NrOperacion1);'Operacion Invalida.';NO;;;;;;"TipoOp IN ('TIFV','TIFC')"
  Radio2         :'|Impresora|Pantalla|PDF|Mail' ;2;1;1;;;Dialogo.Radio2>=0;;;1
  String:
FinDialogo

If Not OK
   Cancelar
Endif

CrearFont(4, "Arial,6,")
CrearFont(1, "Arial,8,")
CrearFont(2, "Arial,8,B")
CrearFont(3, "Arial,14,B")
CrearFont(5, "Arial,10,BU")
CrearFont(6, "Arial,10,B")

(.'LOGO'.)

SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8,         ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.ADD(" Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE, O.Mercado4 MercadoNeg,                      ")
SQL.Add(" C.Codigo, C.RazonSocial, C.Direccion Dire, C.Localidad, C.CodigoPostal, C.CUIT, C.NrMAE,      ")
SQL.Add(" C.CondicionIVA, C.TipoInscripcion, C.Sucursal, C.Telefono, C.CategDepositante,                ")
SQL.Add(" C.Calle,        C.Altura,              C.Piso,            C.Depto,                            ")
SQL.Add(" C.Alias1, C.NrCuenta, E.Alias5,  E.InteresesC, 0 Valor,                                       ")
SQL.ADD(" E.CodMAEContado, O.TotalCaucion, E.CotizaMAE, E.VTeorico, O.TipoCambio2, O.PaseCB             ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit  NOT IN (30,31) AND OB.Valor=1 ")
SQL.ADD("  UNION ")
SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8,         ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.ADD(" Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE, O.Mercado4 MercadoNeg,                      ")
SQL.Add(" C.Codigo, C.RazonSocial, C.Direccion Dire, C.Localidad, C.CodigoPostal, C.CUIT, C.NrMAE,      ")
SQL.Add(" C.CondicionIVA, C.TipoInscripcion, C.Sucursal, C.Telefono, C.CategDepositante,                ")
SQL.Add(" C.Calle,        C.Altura,              C.Piso,            C.Depto,                            ")
SQL.Add(" C.Alias1, C.NrCuenta, E.Alias5,  E.InteresesC, 1 Valor,                                       ")
SQL.ADD(" E.CodMAEContado, O.TotalCaucion, E.CotizaMAE, E.VTeorico, O.TipoCambio2, O.PaseCB             ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and OB.NrBit  IN (30,31) AND OB.Valor=1 ")
SQL.ADD("  UNION ")
SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8,         ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.ADD(" Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE, O.Mercado4 MercadoNeg,                      ")
SQL.Add(" C.Codigo, C.RazonSocial, C.Direccion Dire, C.Localidad, C.CodigoPostal, C.CUIT, C.NrMAE,      ")
SQL.Add(" C.CondicionIVA, C.TipoInscripcion, C.Sucursal, C.Telefono, C.CategDepositante,                ")
SQL.Add(" C.Calle,        C.Altura,              C.Piso,            C.Depto,                            ")
SQL.Add(" C.Alias1, C.NrCuenta, E.Alias5,  E.InteresesC, 1 Valor,                                       ")
SQL.ADD(" E.CodMAEContado, O.TotalCaucion, E.CotizaMAE, E.VTeorico, O.TipoCambio2, O.PaseCB             ")
SQL.ADD("FROM   "~DBO~".BOPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E                           ")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and E.Codigo   = O.Especie ")
watch(SQL.BATCH())

* ---> Impresion De Lineas Del Boleto

Recorrer SQL
   SetFilaActual(13)
    
   * ---> Impresion Del Titulo De Referencia
   message(fbn('NrOperacion'))
   IF NoVacio(FBN['CodMAEContado'])
      IF Eqstr(fbn('TipoOp'), 'TIFC')
           ACT(I:6, 'BOLETO DE COMPRA')
           IF Eqstr(fbn('PaseCB'), '1')
              ACT(I:6, 'BOLETO DE PASE (COMPRA)')
              IF Eqstr(fbn('EsAforado'), '1')
                 ACT(I:6, 'BOLETO DE PASE AF. (COMPRA)')
              Endif
           Endif
      ELSE
           ACT(I:6, 'BOLETO DE VENTA')
           IF Eqstr(fbn('PaseCB'), '1')
              ACT(I:6, 'BOLETO DE PASE (VENTA)')
              IF Eqstr(fbn('EsAforado'), '1')
                 ACT(I:6, 'BOLETO DE PASE AF. (VENTA)')
              Endif
           Endif
      ENDIF
      AlinearCeldas(I:6, 'C')
      SetFont(I:6, 3)
      AgregarMarco(H:5..J:7, 2, 0)
   ELSE
      iF EQSTR(fbn('TipoOp'), 'TIFC')
         ACT(d:FAC, "                   Liquidación de Compra")
      Else
         ACT(d:FAC, "                   Liquidación de Venta")
      Endif
   ENDIF
   If Eqstr(fbn('Convenio'),'1')
      ACD(fv:1,FBN('FechaAltaSisExterno'))
   Else
      ACD(fv:1,FBN('FechaVto'))
   Endif

   SetFont(d:FAC, 3)
   AFI(FAC+2,0.1)
   AFI(FAC+3,0.1)
   AFI(FAC+4,0.1)
   AFI(FAC+5,0.1)
   AFI(FAC+6,0.1)
  
   if FBN['Valor']=1
      act(d:fac-2,Pad('',16)~'A    N    U    L    A    D    O')    
      SetFont(d:FAC-2, 3)
   endif
      
   * ---> Impresion De La Fecha De Emision
   
   SetFilaActual(fac+6)
   acn(w1,fac)
    
   ACD(ZB:09, FSys)
   ACT(a:FAC, 'Fecha Concertación')
   SetFont(a:FAC, 2)
   IFA
   ACT(A:FAC, FBN['FechaOp'])
   AgregarMarco(a:FAC,2,0)

   IFA
   ACT(a:FAC, 'Hora')
   IF NoVacio(FBN['CodMAEContado'])
      ACT(a:FAC+1,Copy(FBN['HoraMAE'],1,8))
   ELSE
      ACT(a:FAC+1,Copy(HORA(FBN['FechaCarga']),1,8))
   ENDIF
   ACT(j:FAC, 'N# Minuta')
   ACT(k:FAC,FBN['NrOperacion'])
   AgregarMarco(k:FAC,2,0)
   AlinearCeldas(j:fac..k:fac,'D')
   SetFont(a:FAC..j:FAC, 2)
   IFA
   AgregarMarco(a:FAC,2,0)
   IFA
   ACT(A:fac, 'Fecha Liquidación')
   SetFont(a:FAC, 2)
   ifa
   ACT(A:fac, fbn('FechaVto'))
   AgregarMarco(a:FAC,2,0)
   ifa
   If EqStr(FBN['CategDepositante'],'CLI')
      * ---> Impresion Del Codigo Y Nombre De La Sucursal
      ACT(A:FAC+1, 'Sucursal')
      ACT(C:FAC+1, fbn['Sucursal']~'- '~BuscarCampo('Sucursales', 'Nombre', 'Codigo', FBN('Sucursal')) )
      SetFont(A:FAC+1..C:FAC+1, 2)
      AgregarMarco(c:FAC+1..f:FAC+1,2,0)

      * ---> Impresion Del Numero De  Cuenta
      ACT(A:FAC+2, 'Cuenta Nro. ')
      ACT(C:FAC+2, 'Comitente Nro.')
      SetFont(A:FAC+2..C:FAC+2, 2)
      ACT(A:FAC+3, fbn['Cliente1'])

      AgregarMarco(a:FAC+3,2,0)   
      ACT(C:FAC+3, BuscarCampo('CUENTAS', 'NrDepositante', 'Codigo', FBN('Cuenta1')))
      AgregarMarco(c:FAC+3,2,0)
      AlinearCeldas(a:fac+3..c:fac+3,'D')
   Endif

   ACT(j:FAC, 'Nr. Boleto')
   SetFont(j:FAC, 2)
   ACT(k:FAC, fbn['NrBoleto'])
   AlinearCeldas(j:fac..k:fac,'D')
   AgregarMarco(k:FAC,2,0)

   SetFilaActual(FAC+2)
   IF NoVacio(FBN['CodMAEContado'])
      if EqStr(fbn['MercadoNeg'],VAR('AMBMAE'))
         ACT(j:FAC,'Secuencia M.A.E.')
      else
         if EqStr(fbn['MercadoNeg'],var('AMBBYMA'))
            ACT(j:FAC,'Secuencia BYMA')
         else
            ACT(j:FAC,'Secuencia')
         endif  
      endif  
      
      SetFont(j:FAC, 2)
      ACT(k:FAC, fbn['NroAltaMAE'])
      AlinearCeldas(j:fac..k:fac,'D')   
      AgregarMarco(k:FAC,2,0)
   ENDIF

   SetFilaActual(FAC+1)
   If Eqstr(fbn('CB8'),'1') 
      IFA
      ACT(j:FAC, 'Contraparte:')

      If SQL("SELECT COUNT(*) FROM "~DBO~".OPERACIONES WHERE NrOperacion3 = '"~fbn('NrOperacion3')~"' AND TipoOp IN ('TIFC','TIFV') ")=2
         act(CL:1 , SQL("Select Cliente1 From "~DBO~".OPERACIONES Where NrOperacion3 = '"~fbn('NrOperacion3')~"' and CB8 ='1' and NrOperacion <> '"~fbn('NrOperacion')~"'"))
         act(cl3 , SQL("Select CategDepositante From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))
         act(cl4 , SQL("Select AFJP From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))
         act(cl6 , SQL("Select Alias2 From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))
         act(cl5 , SQL("Select NrCuenta From "~DBO~".CLIENTES Where Codigo = '"~Val(CL:1)~"' "))

         If novacio(fbn('NrMAE')) y Not eqstr(fbn('NrMAE'),'000')
            * SOLO SE INDICA EL TIPO DE CONTRAPARTE EN EL BOLETO DEL AGENTE MAE
            IF Eqstr(Val(cl3),'BAN') 
               act(k:fac,'Banco') 
            Endif
            IF Eqstr(Val(cl3),'ABO') 
               act(k:fac,'Soc.Bolsa ') 
            Endif
            IF Eqstr(Val(cl3),'AME') 
               act(k:fac,'Age.MAE ') 
            Endif
            IF Eqstr(Val(cl3),'FON') Y [Vacio(Val(cl4)) o  Eqstr(Val(cl4),'NO')]
               act(k:fac,'FCI') 
            Endif
            IF Eqstr(Val(cl3),'FON') Y Eqstr(Val(cl4),'SI')
               act(k:fac,'AFJP Fondo') 
            Endif
            IF [Not Eqstr(Val(cl3),'FON') o Vacio(val(cl3))] Y Eqstr(Val(cl4),'SI')
               act(k:fac,'AFJP Encaje') 
            Endif
            IF Eqstr(Val(cl3),'OTR')
               act(k:fac,'Otros') 
            Endif
            IF Eqstr(Val(cl3),'OTR') y Eqstr(Val(cl4),'SI')
               act(k:fac,'AFJP') 
            Endif
            act(k:fac,Val(k:fac) )  
            act(k:fac+1,Val(cl:6) )  
         Else
            act(k:fac,Val(cl:5))
         Endif
      Else
         ACT(k:FAC, 'Cartera Propia')
      Endif
      SetFont(a:FAC..j:FAC+1, 2)
      AlinearCeldas(K:fac..K:fac+1, 'D')
      AgregarMarco(k:FAC..k:fac+1,2,0)
      ifa
      ifa
   Endif

    
   * ---> Impresion De La Razon Social
   SetFilaActual(FAC+2)
   ACT(A:FAC, 'Sres.')
   If EqStr(FBN['CategDepositante'],'CLI')
      ACT(I:FAC, 'Documento   (Tipo y Numero)')
   Endif
   SetFont(A:FAC..I:FAC, 2)
   
   IFA
   ACT(ZB:01, FBN('RazonSocial'))
   (.'ELIBLANCOS'.)
   ACT(A:FAC, Val(ZB:03))
   If EqStr(FBN['CategDepositante'],'CLI')
      ACT(i:FAC, BuscarCampo('INTEGRANTESCLI', 'TipoDocumento', 'Codigo', FBN['Cliente1'] ))
      If EqStr(Val(j:FAC),'CUT')
         ACT(i:FAC, 'CUIT')
      Endif
      If EqStr(Val(j:FAC),'CUL')
         ACT(i:FAC, 'CUIL')
      Endif

      ACT(i:FAC, Val(i:fac)~'   '~BuscarCampo('INTEGRANTESCLI', 'NrDocumento', 'Codigo', FBN['Cliente1'] ))
      SetFont(A:FAC..J:FAC, 1)
      AgregarMarco(h:fac..k:fac,2,0)
   Endif
   AgregarMarco(a:fac..f:fac,2,0)
      
   
   * ---> Impresion Del Numero De CUIT/CUIL
   If [NoVacio(FBN('CUIT')) y Not EqStr(FBN('CUIT'), '000000000000000')]
      If [EqStr(Copy(FBN('CUIT'), 01, 04), '0000')]
         ACT(ZB:10, Copy(FBN('CUIT'), 05, 11))
      Else  
         If [[EqStr(Copy(FBN('CUIT'), 03, 01), '-')] y [EqStr(Copy(FBN('CUIT'), 12, 01), '-')]]
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 13))
         Else           
            ACT(ZB:10, Copy(FBN('CUIT'), 01, 11))
         EndIf      
      EndIf
   Else
      ACT(ZB:10, '')
   EndIf
   ACT(ZB:11, FBN('TipoInscripcion'))
   (.'ARMACUIT'.)
   IFA
   ACT(A:FAC, Val(ZB:14))

   * ---> Impresion De La Direccion
   ACT(e:FAC, 'Domicilio / Address')
   AlinearCeldas(e:fac,'I')
   SetFont(A:FAC..e:FAC, 2)
   IFA
   ACT(A:FAC, Val(ZB:13))
   AgregarMarco(a:FAC..b:FAC,2,0)  
   ACT(ZB:01, FBN('Dire'))
   if Vacio(val(ZB:01))
      ACT(ZB:01, FBN('Calle')~' '~FBN('Altura')~' '~FSTR(FBN('Piso'),1,0)~' '~FBN('Depto'))
   endif
   (.'ELIBLANCOS'.)

   ACT(E:FAC, Val(ZB:03))
   AgregarMarco(e:FAC..h:FAC,2,0)  
   SetFont(A:FAC..c:FAC, 1)
   
   * ---> Impresion Del Codigo Postal Y La Localidad
   IFA
      
   ACT(A:FAC, 'Localidad / Town')
   ACT(C:FAC, 'Codigo Postal / Zip Code')
   ACT(E:FAC, 'Telefono/s / Telephone/s')
   SetFont(A:FAC..E:FAC, 2)
   
   IFA
   If [NoVacio(FBN('Localidad'))]
      ACT(ZB:01, FBN('Localidad'))
      (.'ELIBLANCOS'.)
      ACT(A:FAC, Val(ZB:03))
   EndIf
   AgregarMarco(a:FAC..b:FAC,2,0)     

   If [NoVacio(FBN('CodigoPostal')) y Not EqStr(FBN('CodigoPostal'), '000000')]
      If [EqStr(Copy(FBN('CodigoPostal'), 01, 02), '00')]
         ACT(C:FAC, "(" ~ Copy(FBN('CodigoPostal'), 03, 04) ~ ')')
      Else  
         ACT(C:FAC, "(" ~ Copy(FBN('CodigoPostal'), 01, 04) ~ ')')
      EndIf
   EndIf
   AgregarMarco(c:FAC,2,0)  
   
   ACT(E:FAC, fbn['Telefono'])
   AgregarMarco(e:FAC..h:fac,2,0)  

   SetFont(A:FAC..E:FAC, 1)
   
   SetFilaActual(fac+1)
   acn(w2,FAC)
   
   if Incluido(fbn['TipoOp'],'TIFC')
       act(z1,'COMPRADO')
       act(z2,'PARA')
       act(z3,'VENDIDO')
       act(z11,'BOUGHT')
       act(z12,'FOR')
       act(z13,'SOLD')
   else
       act(z1,'VENDIDO')
       act(z2,'DE')
       act(z3,'COMPRADO')
       act(z11,'SOLD')
       act(z12,'FROM ')
       act(z13,'BOUGHT')
   endif
   If Eqstr(fbn('CB8'),'1') 
      IF SQL(" Select 1 FROM "~DBO~".OPERACIONES WHERE NrOperacion3 = '"~fbn('NrOperacion3')~"' AND TipoOp <> '"~fbn('TipoOp')~"' AND TipoOp IN ('TIFC','TIFV') ")=1
         * ---- varias operaciones ---- *
         If eqstr(fbn('NrMAE'),'000') o Vacio(fbn('NrMAE'))
            * CLIENTE
             ACT(b:FAC+3, '  HEMOS EFECTUADO POR CUENTA Y ORDEN DE TERCEROS LA SIGUIENTE OPERACION:')
         Else
           * CONTRAPARTE
           ACT(b:FAC+3, '  HEMOS EFECTUADO POR CUENTA Y ORDEN DE TERCEROS LA SIGUIENTE OPERACION:')
         Endif
      Else
         * ---- es contra cartera ---- *
         ACT(b:FAC+3, '  HEMOS EFECTUADO DE NUESTRA CARTERA PROPIA LA SIGUIENTE OPERACION:')
      Endif
   Else
      ACT(b:FAC+3, '  HEMOS EFECTUADO DE NUESTRA CARTERA PROPIA LA SIGUIENTE OPERACION:')
   Endif

   ACT(c:FAC+6,'ESPECIE')
   SetFont(a:fac+1..c:fac+6,2)
   SetFilaActual(fac+7)   
   ACT(b:FAC, 'Código')
   ACT(c:FAC, 'CodCV')
   ACT(d:FAC, 'Descripción')
   ACT(a:FAC, 'Moneda')
   ACT(I:FAC, 'V.Nominal')
   ACT(J:FAC, 'Precio')
   ACT(K:FAC, 'Importe')
   ACN(W4,FAC)
   AlinearCeldas(A:FAC..L:FAC,'C')
   AlinearCeldas(K:FAC,'D')
   SetFont(a:fac..k:fac,2)

   ACN(W4,FAC+1)
   AlinearCeldas(A:FAC+1..L:FAC+1,'C')
   AlinearCeldas(K:FAC+1,'D')
   SetFont(a:fac+1..k:fac+1,2)
   SetFilaActual(fac+1)   
   IFA   
   ACT(b:FAC, BuscarCampo('Especies', 'CodMAEContado', 'Codigo', fbn['Especie']))
   ACT(c:FAC, BuscarCampo('Especies', 'CodNumCajaValores', 'Codigo', fbn['Especie']))
   ACT(d:FAC, Copy(BuscarCampo('Especies', 'Extendido', 'Codigo', fbn['Especie']), 1, 45) )
   if NOT Eqstr(FBN['Cupon1'],' ') y NOT Eqstr(FBN['Cupon1'],'  ') Y NoVacio(FBN['Cupon1'])
      ACT(d:FAC,Val(d:FAC)~' - Cupon '~Fstr(FBN['Cupon1'],1,0) )
   Endif

   ACT(a:FAC, Trim(BuscarCampo('Especies', 'Nombre', 'Codigo', FBN('ContraEspecie'))))

   FormatoCeldas(f:FAC,Exe('FE'))
   ACN(I:FAC, fbn['Cantidad'])
   acn(vr2,   FBN['Alias5'])
   
   acn(ZB:08, FBN['CANTIDAD']*ValorTeorico2(FBN['ESPECIE'],FBN['FECHAOP']))  

   ** AA Jun-2021 en STD TipoCambio2 esta en cero
   IF EqStr(FBN['EsAforado'],'1')
      ACN(J:FAC, fbn['TipoCambio2'])
   Else
      ACN(J:FAC, fbn['Precio1'])
   Endif

   * --- FO 16/08/2006 Esto tiene que ser igual que el copiativo --- *
   FormatoCeldas(J:FAC,Exe('F9'))
   ACN(Z:11,fbn['TotalBrutoCli1'])

   * --- FO 16/08/2006 Agrego esta parte  s/CRISTINA SEGATO
   * --- Monto Bruto
   If EqStr(fbn['EsAforado'],'1')  
      ACN(z:11, fbn['TotalCaucion']-IIF(EqStr(FBN['CotizaMAE'],'CLE'),fbn['TotalIntereses'],0))
   Else
      ACN(z:11, fbn['TotalBrutoCli1'])
   Endif

   *- Si la especie es Dirty Clean igualmente calculo los intereses
   IF EqStr(FBN['CotizaMAE'],'CLE') y EqStr(FBN('InteresesC'),'DIR')
       *- Calculo el precio sacandole los intereses
       If EqStr(fbn['EsAforado'],'1')
           * Precio Clean Aforado
          ACN(j:fac,(fbn['TotalCaucion']-fbn['TotalIntereses'])/fbn['Cantidad'])
           * Bruto Aforado
          ACN(z:11, fbn['Cantidad']*Val(j:fac)*ValorTeorico2(fbn('Especie'),fbn('FechaVto')) )
       Else
          ACN(j:fac,(fbn['TotalNetoCli1']-fbn['TotalIntereses'])/fbn['Cantidad'])
          ACN(z:11, fbn['TotalBrutoCli1']-fbn['TotalIntereses'])
       Endif
   EndIf
   * - La especie es CLEAN DIRTY, informo Neto y precio sucio
   IF EqStr(FBN['CotizaMAE'],'DIR') y EqStr(FBN('InteresesC'),'CLE')
       *- Calculo el precio sacandole los intereses
       If EqStr(fbn['EsAforado'],'1')
          ACN(j:fac,(fbn['TotalCaucion'])/fbn['Cantidad'])
          ACN(z:11, fbn['TotalCaucion'])
       Else
          ACN(j:fac,(fbn['TotalNetoCli1'])/fbn['Cantidad'])
          ACN(z:11, fbn['TotalNetoCli1'])
       Endif
   EndIf

   ACN(K:FAC, Val(Z:11))
   * ------------------------------------------------- *
   SetFont(a:fac..k:fac,1)
   AgregarMarco(a:fac,2,0)
   AgregarMarco(b:fac,2,0)
   AgregarMarco(c:fac,2,0)
   AgregarMarco(d:fac..h:fac,2,0)
   AgregarMarco(i:fac,2,0)
   AgregarMarco(j:fac,2,0)
   AgregarMarco(k:fac,2,0)
   AlinearCeldas(A:FAC..L:FAC,'C')
   AlinearCeldas(K:FAC,'D')
   AlinearCeldas(D:FAC,'I')
   *- Si es una operacion aforada, muestro el porcentaje de aforo
*   IF EqStr(FBN['EsAforado'],'1')   
*      ACT(I:FAC+1,'AFORO')
*      ACT(J:FAC+1,FSTR(FBN['PorAforo'],0,7)~'%')
*      ACN(k:FAC+1,FBN['TotalBrutoCli1']*FBN['PorAforo']/100)
*      AlinearCeldas(I:FAC+1..k:FAC+1,'D')
*      SetFont(I:FAC+1..k:FAC+1,2)
*      AgregarMarco(I:FAC+1..k:FAC+1,2,0)    
*   EndIf

  SetFilaActual(fac+2) 
  ACT(J:FAC,'SUBTOTAL')
*  ACN(k:FAC,FBN['TotalBrutoCli1']-val(K:fac-1))
  ACN(k:FAC, Val(z:11))
  AlinearCeldas(J:FAC..k:FAC,'D')
  SetFont(J:fac,2)
  AgregarMarco(K:FAC,2,0)

  SetFilaActual(fac+1) 
  ACT(J:FAC,'INTERESES CORRIDOS')
  If EqStr(FBN['InteresesC'],'DIR')
     ACN(k:FAC,0)     
  Else
     ACN(k:FAC,FBN['TotalIntereses']) 
  EndIf
  AlinearCeldas(J:FAC,'D')
  SetFont(J:fac,2)
  AgregarMarco(K:FAC,2,0)

     SetFilaActual(fac+1) 
     ACT(J:FAC,'TOTAL NETO')
     IF EqStr(FBN['EsAforado'],'1')   
        ACN(k:FAC,FBN['TotalCaucion'])
     Else
        ACN(k:FAC,FBN['TotalNetoCli1'])
     Endif
     If Not eqstr(fbn('ContraEspecie'), VAR('MONELOCA'))
        ACT(a:fac,'A los fines fiscales el tipo de cambio a considerar es '~fbn('ContraEspecie')~' 1 = $'~fstr(cotizacionBNA(fbn('ContraEspecie'),fbn('FechaOp')-1,2,SI,SI),0,8))
        SetFont(a:FAC,2)
     Endif
     AlinearCeldas(J:FAC,'D')
     SetFont(J:fac,2)
     AgregarMarco(K:FAC,2,0)
     AgregarMArco(a:FAC-7..k:fac+2,2,0)
     SetFilaActual(fac+2)

  * ---> Impresion De La Forma De Pago Y De La Cuenta A Acreditar
  if Incluido(fbn['TipoOp'],'TIFC')
     act(zb:02,'Credito')
  else
     act(zb:02,'Debito')
  endif

  AgregarMarco(A:FAC..k:FAC,2,0)
  SetFilaActual(fac+1)
  AgregarMarco(A:FAC..C:FAC+3,2,0)

  ACT(a:FAC+4,Pad('',12)~'Firma y Sello / Signature ')
  SetFont(a:fac+4,2)

  SetFilaActual(FAC+7)

  ACT(e:FAC-2,Dialogo.String)
  SetFont(e:fac-2,2)  
proximo

  SetFilaActual(FAC+2)   
  
  
  
  **************
  *PIE DE PÁGINA
  **************
  *Se toma el pie de página desde Leyendas.
  *Variables:
  
  *[0] : Banco Vehículo
  *[1] : Dirección email
  
    ABT(A:FAC..K:FAC+2, FormatSTR(LeerLeyenda('','','','BOEXTR'),BuscarCampo('CLIENTES','RazonSocial','Codigo',VAR('VEHICULODE')), BuscarCampo('CLIENTES','DireccionEMail','Codigo',VAR('VEHICULODE'))),1)
    AgregarMarco(A:fac..A:fac, 1, 0)
  
  ***********************************************
  *INICIO DE BLOQUE TEMPORAL
  ***********************************************
  *El siguiente bloque se creó para suplantar al pie de página anterior que usaba el Core 6.7.7
  *Debe borrarse cuando se le envíe al respectivo banco la nueva versión del CORE
  
*  ABT(A:FAC..J:FAC,"En caso de que los términos contenidos en la presente no coincidan con los de la operación de referencia, toda observación o solicitud ")
*  ABT(A:FAC+1..J:FAC+1,"de rectificación sólo será válida si es efectuada mediante nota por escrito dirigida por Uds. a " ~ BuscarCampo('CLIENTES','RazonSocial','Codigo',VAR('VEHICULODE')) ~ " Dpto. de Compliance,")
*  ABT(A:FAC+2..J:FAC+2,"o por e-mail a " ~ BuscarCampo('CLIENTES','DireccionEMail','Codigo',VAR('VEHICULODE')) ~ " dentro de las 24 horas hábiles bancarias de concertada tal operación.")
*  AgregarMarco(A:FAC..K:FAC+2,1,0)
*  
*  SetFilaActual(FAC+2)
  
  *************************
  *Fin del bloque temporal
  *************************
  
*La Asignacion del nombre del archivo para generar PDF debe estar previo a la definicion de LimiteVision
ACT(cu:1, BuscarCampo('Clientes', 'RazonSocial', 'Codigo', VAR('VEHICULODE')))
ACT(op:1, Dialogo.NrOperacion1)
ACT(ar:1,VAR('PATHCONFI')~'Boleto_Cliente_'~Val(cu:1)~'_'~Val(op:1)~'.pdf')
  
*Email
ACT(em:3, BuscarCampo('OPERACIONES', 'Cliente1','NrOperacion', Dialogo.NrOperacion1))
ACT(em:1, BuscarCampo('Clientes', 'DireccionEmail', 'Codigo', Val(em:3)))

*Leyendas
ABT(AA:10..AA:20, LeerLeyenda('','','','MBOLETOASU'), 1)
ABT(ZK:1..ZK:4, LeerLeyenda('','','','MBOLETODET'), 1)


LimitesVision(L:FAC)
SetPrintFit(3,81)
Impresion(1,0)
Impresion(2,0)
Impresion(3,0)
Impresion(4,0)
SetMargins(1,0,0,0)

ACO(1, 9)
ACO(2, 6)
ACO(3, 7)
ACO(4, 17)
ACO(5, 2)
ACO(6, 4)
ACO(7, 2)
ACO(8, 10)
ACO(9, 10)
ACO(10, 10)
ACO(11, 8)
ACO(12,2)

if Dialogo.Radio2 = 0
   ImprimirHoja
else
   If Dialogo.Radio2 = 2 
      HojaVisible(NO)
      SetPrintFit(4)
      ExportarPdfLite(val(ar:1))
   Else 
       If Dialogo.Radio2 = 3  
         HojaVisible(NO)
         SetPrintFit(4)
         ExportarPdfLite(val(ar:1))
         SendMail(Val(em:1),val(AA:10),val(ZK:1),SI,,,val(ar:1),,SI)         
       Endif 
   endif
endif 