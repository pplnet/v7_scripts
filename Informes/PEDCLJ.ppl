GrillaVisible(SI)
ModoReproceso(ConDialogo)
CrearDialogo
  Fecha1    : 'F.Hasta'   ;;;;;;;;;FSys
  Vehiculo1 : 'Vehiculo'  ;;;;;;;;;Var('VEHICULODE')
  Mercado1  : 'Mercado'   ;
  Cliente1  : 'Cliente'   ;
  Especie1  : 'Especie'   ;
  Check1    : 'Titulos'   ;;;;  ;;Dialogo.Check1+Dialogo.Check2+Dialogo.Check3+Dialogo.Check4+Dialogo.Check5+Dialogo.Check13>0;'Debe seleccionar un grupo de operaciones';NO;1;
  Check2    : 'F.Exchange';;;;  ;;;;;0;
  Check3    : 'M.Market'  ;;;;  ;;;;;0;
  Check4    : 'Rofex'     ;;;;  ;;;;;0;
  Check5    : 'OCT'       ;;;;  ;;;;;0;
  Check13   : 'COM. MAE1' ;;;;  ;;;;;0;
FinDialogo
if Not OK
  Cancelar
endif

if Incluido(Dialogo.Mercado1,Var('MERCAACMC'))
   Cancelar('El Mercado es Incorrecto.')
Endif
AgregarBMP(a1,Exe('LOGO'),EXE('ESCALOGO'))

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

SetFilaActual(5)
ACN(w1,FAC)

ACT(a:FAC,'Pendientes / Detalle por Cliente')
ACT(a:FAC+1,'Cliente: '~iif(NoVacio(Dialogo.Cliente1),Dialogo.Cliente1,'Todos'))
ACT(a:FAC+2,'Especie: '~iif(NoVacio(Dialogo.Especie1),Dialogo.Especie1,'Todos'))
ACT(a:FAC+3,'Mercado: '~iif(NoVacio(Dialogo.Mercado1),Dialogo.Mercado1,'Todos'))
ACT(a:FAC+4,'Fecha Hasta: '~Dialogo.Fecha1)

ACT(a:FAC+6,'Cliente')
ACT(b:FAC+6,'Especie')
ACT(c:FAC+6,'Conc.')
ACT(d:FAC+6,'Nr.Op.')
ACT(e:FAC+6,'Merc.')
ACT(f:FAC+6,'Mod.Liq.')
ACT(g:FAC+6,'Fecha Oper.')
ACT(h:FAC+6,'Cant.Especie')
ACT(i:FAC+6,'Cant.Moneda')
ACT(j:FAC+6,'Descripcion')
*ACT(j:FAC+6,'Conc.')
ACT(k:FAC+6,'Cuenta')
ACT(l:FAC+6,'Observaciones')

AlinearCeldas(g:FAC+6..i:FAC+6,'D')
SetFont(a:FAC..o:FAC+6,2)
AgregarMarco(a:FAC+6..l:FAC+6,1,3,Exe('COLOR'))

SetFilaActual(FAC+6)

SQL.ADD("Select M.FechaMov,      M.Cliente,       M.Especie, M.Cupon,             M.Cantidad,          M.NrOperacion, ")
SQL.ADD("       M.Status,        M.NrMov,         O.TipoOp,  M.Mercado MercM,     M.Cuenta,            M.Concepto,    O.Mercado, ")
SQL.ADD("       O.ContraEspecie, O.TotalNetoCli1, M.Leyenda, O.FormaLiquidacion1, O.FormaLiquidacion2, O.PaseCB,      O.FechaOp ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".OPERACIONES O, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = O.NrOperacion")
SQL.ADD("and M.NrOperacion = B.NrOperacion")
SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and M.Cliente = O.Cliente1 ")
SQL.ADD("and M.NrSaldo = 1 ")
if Dialogo.Check1=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif
if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif
if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif
if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'RF' ")
endif
if Dialogo.Check5=0
  SQL.ADD("and M.Concepto <> 'OCT' ")
endif
if Dialogo.Check13=0
  SQL.ADD("and M.NrGrupo <> 15   ") 
endif
SQL.ADD("and ((M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha1)~"' <= '"~IdxDate(FSys)~"') or (M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'))")
SQL.ADD("and M.Bits IN ('MV','MI') ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD(" and M.Mercado not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD("and O.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and ((M.Status <> 'MATCH' or M.Status is NULL) or (M.Status = 'MATCH' and M.Especie = O.Especie)) ")
SQL.ADD("and B.NrBit IN (70,10) ")
SQL.ADD("and B.Valor = '1' ") 

SQL.ADD("union ")

SQL.ADD("Select M.FechaMov,       M.Cliente,                M.Especie,        M.Cupon,              M.Cantidad,           M.NrOperacion, ")
SQL.ADD("       M.Status,         M.NrMov,                  T.TipoTr2 TipoOp, M.Mercado MercM,      M.Cuenta,             M.Concepto,    T.Mercado1 Mercado, ")
SQL.ADD("       '' ContraEspecie, M.Cantidad TotalNetoCli1, '' Leyenda,       '' FormaLiquidacion1, '' FormaLiquidacion2, '' PaseCB,     T.Fecha1 FechaOp ")
SQL.ADD("from "~DBO~".MOVPENDIENTES M, "~DBO~".TRANSACCIONES2 T, "~DBO~".OPERACIONESBITS B ")
SQL.ADD("where M.NrOperacion = T.NrTrans")
SQL.ADD("and M.NrOperacion = B.NrOperacion")
SQL.ADD("and M.EnteCustodia = '"~Dialogo.Vehiculo1~"' ")
SQL.ADD("and M.Cliente = T.Cliente1 ")
SQL.ADD("and M.NrSaldo = 1 ")
if Dialogo.Check1=0
  SQL.ADD("and M.Concepto <> 'TI' ")
endif
if Dialogo.Check2=0
  SQL.ADD("and M.Concepto <> 'FX' ")
endif
if Dialogo.Check3=0
  SQL.ADD("and M.Concepto <> 'MM' ")
endif
if Dialogo.Check4=0
  SQL.ADD("and M.Concepto <> 'RF' ")
endif
if Dialogo.Check5=0
  SQL.ADD("and M.Concepto <> 'OCT' ")
endif
if Dialogo.Check13=0
  SQL.ADD("and M.NrGrupo <> 15   ") 
endif
SQL.ADD("and ((M.FechaMov <= '"~IdxDate(Dialogo.Fecha1)~"' and '"~IdxDate(Dialogo.Fecha1)~"' <= '"~IdxDate(FSys)~"') or (M.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"'))")
SQL.ADD("and M.Bits IN ('MV','MI') ")
if NoVacio(Dialogo.Cliente1)
  SQL.ADD("and M.Cliente = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Especie1)
  SQL.ADD("and M.Especie = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
  SQL.ADD("and M.Mercado = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD(" and M.Mercado not in("~Pipe2Comillas(VAR('MERCAACMC'))~") ")
SQL.ADD("and T.Vehiculo1 = '"~Dialogo.Vehiculo1~"' ")

*PIT = Pago de intereses de Call
*CIT = Cobro de intereses de Call
*TRANSP = Vouchers de transporte, cuando hubo una falla y hay que volver a liquidar

SQL.ADD("and T.TipoTr2 in ('CCUPON','PCUPON','PIT','CIT','TRANSP') ")
SQL.ADD("and B.NrBit = 5 ")
SQL.ADD("and B.Valor = '1' ") 
SQL.ADD("Order By 2, 1, 7, 3, 6")

recorrer SQL
  if EqStr(fbn('Status'),'MATCH')
    ACT(x3, fbn('ContraEspecie'))
  else
    ACT(x3, '**')
  endif

  if fbn('FechaMov')<>Val(v1) o Not EqStr(fbn('Cliente'),Val(v2)) o Not EqStr(fbn('Especie'),Val(v3)) o Not EqStr(Val(x3),Val(v4))
    if FAC>Val(w1)+7 y Val(z3)>0
      ACT(g:FAC, 'Total '~Val(v3))
      ACN(Val(x2):FAC, Val(z1))
      if Not EqStr(Val(v4),'**')
        ACT(g:FAC, Val(g:FAC)~'/'~Val(v4))
        ACN(i:FAC, Val(z2))
      endif
      ACN(z1,0)
      ACN(z2,0)
      ACN(z3,0)
      SetFont(g:FAC..i:FAC,2)
      SetFilaActual(FAC+2)
    endif
    if DesciendeDeEspecie(fbn('Especie'),'TITULO')
      ACN(x2,8)
    else
      ACN(x2,9)
    endif
    if Not EqStr(fbn('Cliente'),Val(v2))
      if FAC>Val(w1)+7
        AgregarMarco(a:FAC..m:FAC,2)
        SetFont(a:FAC,2)
        IFA
      endif
      ACT(v2, fbn('Cliente'))
      ACT(a:FAC, 'Cliente: '~BuscarCampo('CLIENTES','RazonSocial','Codigo',fbn('Cliente')))
      SetFont(a:FAC,3)
      SetFilaActual(FAC+2)
      ACN(v1, -1)
    endif
    if fbn('FechaMov')<>Val(v1)
      ACN(v1, fbn('FechaMov'))
      ACT(v2, '**')
      ACT(a:FAC, 'Liquidacion del '~Fecha(Val(v1)))
      SetFont(a:FAC,2)
      SetFilaActual(FAC+2)
    endif
    if Not EqStr(fbn('Cliente'),Val(v2))
      ACT(v2, fbn('Cliente'))
      ACT(a:FAC,Val(v2))
    endif
    ACT(v3,fbn('Especie'))
    ACT(v4,Val(x3))
    ACT(b:FAC,Val(v3))
    if Not EqStr(Val(x3),'**')
      ACT(b:FAC, Val(b:FAC)~'/'~Val(x3))
    endif
    SetFont(a:FAC..c:FAC,2)
  endif
  ACT(d:FAC, fbn('NrOperacion'))
  ACLO(d:FAC, fbn('NrOperacion'))
  if EqStr(fbn('Status'),'CONF')
    ACT(f:FAC, 'Conf.')
  endif
  if EqStr(fbn('Status'),'MATCH')
    ACT(f:FAC, 'Match')
  endif
  if Incluido(fbn('Status'),'DVP|RVP')
    ACT(f:FAC, fbn('Status'))
  endif
  ACN(Val(x2):FAC, -fbn('Cantidad'))
  if EqStr(fbn('Status'),'MATCH')
      if Incluido(fbn('TipoOp'),'TIC|TIFC|TIV|TIFV')
        if Incluido(fbn('TipoOp'),'TIC|TIFC')
          ACN(i:FAC, -fbn('TotalNetoCli1'))
          SCN(z2, -fbn('TotalNetoCli1'))
        else
          ACN(i:FAC, fbn('TotalNetoCli1'))
          SCN(z2, fbn('TotalNetoCli1'))
        endif
      endif
  endif
  ACT(j:FAC, fbn('Leyenda'))
  if EqStr(Copy(fbn('NrOperacion'),1,2),'VT') o EqStr(Copy(fbn('NrOperacion'),1,1),'I') 
    ACT(e:FAC, fbn('Cuenta'))    
    ACD(g:FAC, fbn('FechaOp'))
    if EqStr(Copy(fbn('NrOperacion'),1,2),'VT')
      if Not NoVacio(Val(e:FAC))
        ACT(f:FAC, 'STD')
      endif

      *if Not EqStr(fbn('Bit5'),'1')
      *  ACT(m:FAC, 'Voucher sin confirmar')
      *endif

      *if Not EqStr(fbn('Bit5'),'1')
      *  ACT(m:FAC, 'Voucher sin confirmar')
      *endif
    else
      ACT(f:FAC, 'STD')
     *if Not EqStr(fbn('Bit5'),'1')  
     *    ACT(m:FAC, 'Transaccion sin controlar')
     * endif
    endif
  else
    ACT(e:FAC, fbn('MercM'))
** FJL 29/03/22 - x Issue EXTBIND-5477
*      if Incluido(fbn('MercM'), VAR('MERCTITULO'))
*        if Incluido(fbn('TipoOp'),'TIC|TIV')
*          if fbn('FormaLiquidacion1')=0
*            ACT(f:FAC, 'FD&P')
*          endif
*          if fbn('FormaLiquidacion1')=2
*            ACT(f:FAC, 'FOP')
*          endif
*        endif
*        if Incluido(fbn('TipoOp'),'TIFC|TIFV')
*          if fbn('FormaLiquidacion1')=0
*            ACT(f:FAC, 'FD&P')
*          endif
*          if fbn('FormaLiquidacion1')=2
*            ACT(f:FAC, 'FOP')
*          endif
*        endif
*      else
*        if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV')
*          if fbn('FormaLiquidacion1')=0
*            ACT(f:FAC, 'STD')
*          endif
*        endif
*      endif
    if Incluido(fbn('TipoOp'),'TIC|TIV|TIFC|TIFV')
      if Incluido(fbn('Mercado'), VAR('MERCADOCV'))
        if fbn('FormaLiquidacion1')=0
          ACT(f:FAC, 'STD')
        endif
        if fbn('FormaLiquidacion1')=1
          ACT(f:FAC, 'DVP')
        endif
        if fbn('FormaLiquidacion1')=2
          ACT(f:FAC, 'RVP')
        endif
      endif
      if Incluido(fbn('Mercado'), VAR('MERCAVARI'))
        if fbn('FormaLiquidacion2')=0
          ACT(f:FAC, 'FD&P')
        endif
        if fbn('FormaLiquidacion2')=1
          ACT(f:FAC, 'DVP')
        endif
        if fbn('FormaLiquidacion2')=2
          ACT(f:FAC, 'FOP')
        endif
      endif
    endif
    if Incluido(fbn('TipoOp'),'TICO|TICT|TIPO|TIDE')
      if fbn('FormaLiquidacion1')=0
        ACT(f:FAC, 'STD')
      endif
    endif
    ACD(g:FAC, fbn('FechaOp'))
    if Incluido(fbn('TipoOp'),'TIC|TIV') y EqStr(fbn('PaseCB'),'1')
      ACT(m:FAC, Val(j:FAC)~' Alta de Pase')
    endif
    if Incluido(fbn('TipoOp'),'TIFC|TIFV') y EqStr(fbn('PaseCB'),'1')
      ACT(m:FAC, Val(j:FAC)~' Vto de Pase')
    endif
  endif

  ACT(c:fac, fbn('Concepto'))
  ACT(k:fac, fbn('Cuenta') ~ ' - ' ~ BuscarCampo('CUENTAS','Numero','Codigo', fbn('Cuenta')))

  SCN(z1, -fbn('Cantidad'))
  SCN(z3, 1)

  SetFont(d:FAC..m:FAC,1)

proximo
if FAC > Val(w1)+6 y Val(z3) > 0
  IFA
  ACT(g:FAC, 'Total '~Val(v3))
  ACN(Val(x2):FAC, Val(z1))
  if Not EqStr(Val(v4),'**')
    ACT(g:FAC, Val(f:FAC)~'/'~Val(v4))
    ACN(i:FAC, Val(z2))
  endif
  SetFont(g:FAC..i:FAC,2)
endif

FormatoCeldas(h:Val(w1)+7..i:FAC,Exe('F2'))

ACO(1,8)
ACO(2,8)
ACO(3,4)
ACO(4,6)
ACO(5,4)
ACO(6,6)
ACO(7,8)
ACO(8,8)
ACO(9,8)
ACO(10,12)
ACO(11,12)
ACO(12,12)

Impresion(1,2)
SetFilaActual(FAC+2)
ACT(a:FAC, 'FIN DE LISTADO')
SetFont(a:FAC, 2)
SetFont(c15..c:fac, 2)
