IF Vacio(UsrVehiculos(UsuarioActivo))
    ACT(LS:1, SQLSet(" Select Codigo from "~DBO~".VEHICULOS where Status = 'HAB' "))
ELSE
    ACT(LS:1, UsrVehiculos(UsuarioActivo))
ENDIF

CrearDialogo
  Fecha1    : 'Fecha'                            ;1;1;1;;;;;;FSys
  Vehiculo1 : 'Vehiculo'                         ;2;1;1;;;;;;;;IIF(Vacio(UsrVehiculos(UsuarioActivo)), Val(LS:1), SQLSet(" Select U.Vehiculo From "~DBO~".USRVEHICULO U, "~DBO~".VEHICULOS V Where V.Codigo = U.Vehiculo AND U.Codigo = '"~UsuarioActivo~"' AND V.Status = 'HAB' "));;
  Lista2    : 'Books'                            ;3;1;1;;;;;;;;;;;;;
  Radio2    : 'Expresado en|ARP|USD'             ;4;1;1;;;;;;0
  Radio3    : 'Expresado en|Millones|ImporteOri' ;5;1;1;SI;SI;;;;0;;;;;
  **TC**
  Radio5    : 'TC: |BNA|Mercado'                 ;4;2;1;;;;;;0
  Especie1  : 'Moneda'                           ;5;2;1;;Dialogo.Radio5=1;(Dialogo.Radio5=0 Y Vacio(Dialogo.Especie1)) O ( Incluido(SQLSet(" SELECT Codigo FROM ESPECIES WHERE Tipo IN('MON','IND')"),Dialogo.Especie1,1) );'La Moneda ingresada es invalida';NO;Var('MONEEXTR');;;;;" Tipo IN('MON','IND') AND NOT Codigo = '"~Var('MONELOCA')~"' "
  ****
  Radio4    : 'Vehiculo Consolidado|NO|SI'       ;-5;2;1;;;;;;1;;;;;;;
  Lista1    : 'Vehiculos'                        ;-4;2;1;;;;;;;;;;;;;
  
FinDialogo

IF Not OK
  Cancelar
ENDIF

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

IF NoVacio(Dialogo.Lista1)  
    let &listaVehiculos Dialogo.Lista1
Else
    let &listaVehiculos Val(LS:1) 
Endif
******************DIASCOTBNA****************************
let &FechaTC Dialogo.Fecha1-VAR('DIASCOTBNA')
(.'VARTIPOCAM'.)

If Dialogo.Radio5 = 1
    let &cotDolDivisa Cotizacion(Dialogo.Especie1,,,,&FechaTC,1,NO,NO)
    let &cotDolBillete Cotizacion(Dialogo.Especie1,,,,&FechaTC,1,NO,NO)
Endif
*********************************************
******FECHA DE POSICIONES*******
*Si la fecha es un sábado, se elige el viernes anterior
If DiaSem(Dialogo.Fecha1) = 7 
    let &fechaPosiciones2 Dialogo.Fecha1-1
else
    *Si la fecha es un domingo, se elige el viernes anterior
    If DiaSem(Dialogo.Fecha1) = 1 
        let &fechaPosiciones2 Dialogo.Fecha1-2
    else
        *sino, se deja la fecha del diálogo
        let &fechaPosiciones2 Dialogo.Fecha1
    Endif
Endif
********************************************

IF Dialogo.Radio2 = 0
    let &monedaInforme &monedaLocal
ELSE
    let &monedaInforme &monedaExtr
ENDIF

let &monedaTC1 &monedaInforme

SetFilaActual(1)
ACT(D:fac, 'Detalle de INVERSIONES')
SetFont(D:fac, 3)
SetFilaActual(fac+2)
Let &fi1 fac
ACT(A:fac, 'Fecha: '~Dialogo.Fecha1)
ifa
IF NoVacio(Dialogo.Vehiculo1) 
    ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
Else
    If eqStr(&listaVehiculos, Val(LS:1))
        ACT(A:fac, 'Vehiculos: Todos')
    Else
    ACT(A:fac, 'Vehiculo(s): '~&listaVehiculos)
    Endif
Endif
ifa
IF NoVacio(Dialogo.Lista2)
    ACT(A:fac, 'Book(s): '~Dialogo.Lista2)
ELSE
    ACT(A:fac, 'Books: Todos')
ENDIF
ifa
ACT(A:fac, 'Consolidado por vehiculo')
IF Dialogo.Radio4 = 0
    ACT(A:fac, Val(A:FAC)~' NO')
    let &colInstrumento 2
    let &finFormato 10
ELSE
    ACT(A:fac, Val(A:FAC)~' SI')
    let &colInstrumento 3
    let &finFormato 9
ENDIF
********DIASCOTBNA**********
ifa
ACT(A:fac, 'TC ')
IF Dialogo.Radio5=0
    ACT(A:fac, Val(A:FAC)~'BNA')
Else
    ACT(A:fac, Val(A:FAC)~'Mercado')
    ACT(B:fac, Dialogo.Especie1)
    Alinearceldas(B:fac.. B:fac, 'D')
EndIf
ifa
******************
IF Dialogo.Radio2 = 0
    ACT(A:fac, 'Expresado en: ARP')
    let &monedaExpr '$'
ELSE
    ACT(A:fac, 'Expresado en: USD')
    let &monedaExpr 'U$S'
ENDIF
ifa
ACT(A:fac, 'TC Divisa:')
ACN(B:fac, &cotDolDivisa)
ifa
ACT(A:fac, 'TC Billete:')
ACN(B:fac, &cotDolBillete)
FormatoCeldas(B:fac-1..B:fac, Exe('F8'))
ifa
IF Dialogo.Radio3 = 0
    ACT(A:fac, 'Expresado en: Millones')
    let &unidad 1000000
ELSE
    ACT(A:fac, 'Expresado en: Importe Original')
    let &unidad 1
ENDIF
SetFont(A:&fi1..B:fac, 2)
ifa
let &filaTotalCtasVista fac
ifa

**********************************************************************
***---Cuadro Cuentas a la vista
**********************************************************************
ACT(A:fac, 'Vehiculo')
If Dialogo.Radio4=1
    ACT(B:fac, 'Book')
Else
    ACT(&colInstrumento+5:fac, '% Sobre Total Invertido')
EndIf
ACT(&colInstrumento:fac, 'Instrumento')
ACT(&colInstrumento+1:fac, 'Entidad')
ACT(&colInstrumento+2:fac, 'Moneda')
ACT(&colInstrumento+3:fac, 'Remunera')
ACT(&colInstrumento+4:fac, 'Monto a la Fecha')
SetFont(A:fac..G:fac, 2)
If Dialogo.Radio4=0
    AgregarMarco(A:fac..H:fac, 0, 0, Exe('COLOR'))
Else
    AgregarMarco(A:fac..G:fac, 0, 0, Exe('COLOR'))
Endif
let &filaIniCtasVista fac+1
SQL.ADD(" Select (S.SaldoContable+S.Ajuste)/"~Fstr(&unidad, 0, 0)~" SaldoContable, C.Cliente Vehiculo, C.Alias1 BookCta, V.Alias5 BookDafult, C.Especies, S.NrCuenta, ")
SQL.ADD(" C.Codigo Cuenta, 'Cta Cte' Instrumento, C.Comitente Entidad, C.Especies Moneda, 1 NrSaldo, V.Descripcion ")
SQL.ADD(" From "~DBO~".SALDOSBANCARIOS S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where S.NrCuenta = C.Numero ")
SQL.ADD(" AND V.Codigo = C.Cliente ")
SQL.ADD(" AND S.Estado<>'ANU' ")
SQL.ADD(" AND S.FechaSaldo = '"~IdxDate(Dialogo.Fecha1)~"' ")
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" AND C.Cliente = '"~Dialogo.Vehiculo1~"' ")
Else
    SQL.ADD(" AND C.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif    
**************
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND C.Alias1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
SQL.ADD(" UNION ALL ")
SQL.ADD(" Select Round(S.Saldo/"~Fstr(&unidad, 0, 0)~",2) SaldoContable, C.Cliente Vehiculo, C.Alias1 BookCta, V.Alias5 BookDafult, C.Especies, C.Numero NrCuenta, ")
SQL.ADD(" S.Cuenta, 'Cta Comitente' Instrumento, C.Comitente Entidad, S.Especie Moneda, S.NrSaldo, V.Descripcion ")
SQL.ADD(" From "~DBO~".SALDOSDIA S, "~DBO~".CUENTAS C, "~DBO~".VEHICULOS V ")
SQL.ADD(" Where S.Cuenta = C.Codigo ")
SQL.ADD(" AND V.Codigo = C.Cliente ")
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" AND C.Cliente = '"~Dialogo.Vehiculo1~"' ")
Else
    SQL.ADD(" AND C.Cliente IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
Endif
**************
SQL.ADD(" AND S.NrSaldo = 50 ")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND C.Alias1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
SQL.ADD(" AND S.Fecha = (Select Max(Fecha) From "~DBO~".SALDOSDIA S1 ")
SQL.ADD("                Where S.Cuenta = S1.Cuenta ")
SQL.ADD("                AND S.NrSaldo = S1.NrSaldo ")
SQL.ADD("                AND S.Especie = S1.Especie ")
SQL.ADD("                AND S1.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"') ")
IF Dialogo.Radio4=1
    SQL.ADD(" Order By 2, 3, 8 ")
Else
    SQL.ADD(" Order By 3, 8 ")
Endif
Watch(sql.Batch)
Recorrer SQL
    let &vehiculoTC FBN['Vehiculo']
    (.'COTVEHIC'.)
    
    IF (fbn('NrSaldo')  = 50 Y Eqstr(&monedaInforme, fbn('Moneda'))) O (fbn('NrSaldo')  <> 50 Y Incluido(&monedaInforme, fbn('Especies')))
    **Esto debemos hacerlo por los casos de cuentas multimoneda
    *IF Incluido(&monedaInforme, fbn('Especies')) o Eqstr(&monedaInforme, fbn('Moneda'))
        let &tc 1
    ELSE
        IF Eqstr(&monedaInforme, &monedaLocal)
            let &tc &cotVehiculo
        ELSE
            let &tc 1/&cotVehiculo
        ENDIF
    ENDIF
   
    If Dialogo.Radio4=1
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Descripcion'))
        ACT(B:fac, fbn('BookCta'))
    Else    
        ACT(A:fac, fbn('Vehiculo'))
        IF NoVacio(fbn('BookCta'))
            ***---Si la cuenta tiene definido el book, tomamos ese, sino el book default del vehículo, que no se muestra
            ACT(A:fac, Val(A:fac)~' '~fbn('BookCta'))
        ENDIF
    EndIf
    ACT(&colInstrumento:fac, fbn('Instrumento'))
    ACT(&colInstrumento+1:fac, fbn('Entidad'))
    IF fbn('NrSaldo') = 50
        ACT(&colInstrumento+2:fac, fbn('Moneda'))
    ELSE
        ACT(&colInstrumento+2:fac, ItemLista(fbn('Moneda'), 1))
    ENDIF
    let &remunera 0
    let &instrumento fbn('Instrumento') 
    SQL.ADD(" Select O.NrOperacion From "~DBO~".OPERACIONES O, "~DBO~".CUENTAS C ")
    SQL.ADD(" Where C.Codigo = O.Cuenta1 ")
    SQL.ADD(" AND O.TipoOp = 'MMRPAC' ")
    SQL.ADD(" AND C.Numero = '"~fbn('NrCuenta')~"' ")
    SQL.ADD(" AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD(" AND O.FechaVto >= '"~IdxDate(Dialogo.Fecha1)~"' ")
    SQL.ADD("  ")
    Recorrer SQL
        DFA
        let &remunera 1
        *Cintia Dic2025 x Gémini 8886
        *Una misma cuenta puede venir en cte y comitente, debemos identificar si remunera para marcarla en la columna E(Remunera), pero no debemos
        *sumar devengados en ambas filas ya que se duplican. Sólo sumamos devengados en el bloque de Comitentes.
        If NOT EqStr(&instrumento,'Cta Cte')
            Break
        Endif
        let &MMCCRAsociada ''
        let &intRem 0
        *Levantamos los MOVDEVENGADOS de las MMCCR asociadas a la MMRPAC
        SQL.ADD(" Select NrOperacion from "~DBO~".OPERACIONES Where OperacionRef='"~fbn('NrOperacion')~"' and TipoOp = 'MMCCR' ")
        Recorrer SQL
            DFA
            let &MMCCRAsociada &MMCCRAsociada~fbn('NrOperacion')~'|'
        Proximo
        
        SQL.ADD(" Select Sum(Monto)/"~Fstr(&unidad, 0, 0)~" Monto From "~DBO~".MOVDEVENGADOS ")
        SQL.ADD(" Where NrOperacion IN ("~Pipe2Comillas(&MMCCRAsociada)~") ")
        SQL.ADD(" AND NrSaldo = 140 ")
        SQL.ADD(" AND TipoDevengado = 'INTLEN' ")
        SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ")
        Recorrer SQL
            DFA
            let &intRem &intRem + (fbn('Monto') * &tc)
        Proximo
    Proximo
    IF &remunera = 0
        ACT(&colInstrumento+3:fac, 'NO')
        ACN(&colInstrumento+4:fac, fbn('SaldoContable') * &tc)
    ELSE
        ACT(&colInstrumento+3:fac, 'SI')
        *17/04/2024
        *Tenemos que sumar los Devengados para que coincida con POSICI
        ACN(&colInstrumento+4:fac, (fbn('SaldoContable') * &tc)+&intRem)
    ENDIF
    let &totalCtasVista &totalCtasVista + Val(&colInstrumento+4:fac)
Proximo

****FORMATO Cuentas Vista
If Dialogo.Radio4=0
    AgregarMarco(A:&filaIniCtasVista..H:fac, 0, 0)
Else
    AgregarMarco(A:&filaIniCtasVista..G:fac,0,0)
EndIf
FormatoCeldas(&colInstrumento+4:&filaIniCtasVista..&colInstrumento+4:fac, Exe('F2'))
ACN(&colInstrumento+4:&filaTotalCtasVista, &totalCtasVista)

SetFont(&colInstrumento+4:&filaTotalCtasVista, 2)
FormatoCeldas(&colInstrumento+4:&filaTotalCtasVista, Exe('F2'))
AgregarMarco(&colInstrumento+4:&filaTotalCtasVista, 0, 0)
let &filaFinCtasVista fac

SetFilaActual(fac+3)

**********************************************************************
***---Cuadro FCI
**********************************************************************
let &filaTotalFCI fac-1
let &filaIniFCI fac+1
let &filaIniInversiones fac+1
ACT(A:fac, 'Vehiculo')
If Dialogo.Radio4=1
    ACT(B:fac, 'Book')
Else
    ACT(&colInstrumento+7:fac, '% Sobre Total Invertido')
EndIf
ACT(&colInstrumento:fac, 'Instrumento')
ACT(&colInstrumento+1:fac, 'Nombre Extendido de la Especie')
ACT(&colInstrumento+2:fac, 'Moneda')
ACT(&colInstrumento+3:fac, 'Vencimiento')
ACT(&colInstrumento+4:fac, 'Valor Cuotaparte')
ACT(&colInstrumento+5:fac, 'CuotasPartes')                             
ACT(&colInstrumento+6:fac, 'Monto a la Fecha')

SetFont(A:fac..&finFormato:fac, 2)
AgregarMarco(A:fac..&finFormato:fac, 0, 0, Exe('COLOR'))

***---SQL Bloque FCI
SQL.ADD(" Select P.Especie, P.CantidadFin/"~Fstr(&unidad, 0, 0)~" CantidadFin, P.Vehiculo, P.Book, E.Cotiza Moneda, 'FCI' Instrumento,")
SQL.ADD("E.Issuer Entidad, E.Extendido, E.PlazoLiq ")

IF Dialogo.Radio4=0
    SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
    SQL.ADD(" Where E.Codigo = P.Especie ")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
    SQL.ADD("Where E.Codigo = P.Especie ") 
    SQL.ADD("AND V.Codigo = P.Vehiculo ")
EndIf

SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(P.Especie,'FONDOS') = 1 ")
SQL.ADD(" AND P.NrSaldo = 1 ")
SQL.ADD(" AND P.Fecha = '"~IdxDate(&fechaPosiciones2)~"' ")
***Vehiculo***
IF NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" AND P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
Else
    SQL.ADD(" AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~") ")
EndIf
**************
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND P.Book IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
**Cintia Dic2025 por Gémini 8886 para que se comporte igual que el reporte de cartera
SQL.ADD(" AND Round(P.CantidadFin,0)>0 ")
SQL.ADD(" Order By 3, 4, 1 ")
Watch(sql.Batch)
Recorrer SQL
    let &vehiculoTC FBN['Vehiculo']
    (.'COTVEHIC'.)
    let &monedaTC2 fbn('Moneda')
    (.'TIPOCAMBIO'.)
    
    If Dialogo.Radio4=1
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Descripcion'))
        ACT(B:fac, fbn('Book'))
    Else
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Book'))
    EndIf
    ACT(&colInstrumento:fac, fbn('Instrumento'))
    ACT(&colInstrumento+1:fac, fbn('Extendido'))
    ACT(&colInstrumento+2:fac, fbn('Moneda'))
    ACT(&colInstrumento+3:fac, Dialogo.Fecha1 + (fbn('PlazoLiq') / 24)) 
    ACN(&colInstrumento+4:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI))                             
    ACN(&colInstrumento+5:fac, fbn('CantidadFin'))                                                                                          
    ACN(&colInstrumento+6:fac, Val(&colInstrumento+5:fac)* Val(&colInstrumento+4:fac) * &tc)
    let &totalFCI &totalFCI + Val(&colInstrumento+6:fac)
Proximo

***FORMATO DE CELDAS BLOQUE FCI
let &filaFinFCI fac
AgregarMarco(A:&filaIniFCI..&finFormato:&filaFinFCI, 0, 0)
FormatoCeldas(&colInstrumento+4:&filaIniFCI..&colInstrumento+4:&filaFinFCI, Exe('F8'))
FormatoCeldas(&colInstrumento+5:&filaIniFCI..&colInstrumento+5:&filaFinFCI, Exe('F2'))
FormatoCeldas(&colInstrumento+6:&filaIniFCI..&colInstrumento+6:&filaFinFCI, Exe('F2'))


***TOTAL MONTO A LA FECHA FCI
ACN(&colInstrumento+6:&filaTotalFCI, &totalFCI)
SetFont(&colInstrumento+6:&filaTotalFCI, 2)
FormatoCeldas(&colInstrumento+6:&filaTotalFCI, Exe('F2'))
AgregarMarco(&finFormato:&filaTotalFCI, 0, 0)
SetFilaActual(fac+3)

**********************************************************************
***---BLOQUE PF
**********************************************************************
let &filaTotalPF fac-1
let &filaIniPlazoFijo fac+1
ACT(A:fac, 'Vehiculo')
If Dialogo.Radio4=1
    ACT(B:fac, 'Book')
Else
    ACT(&colInstrumento+7:fac, '% Sobre Total Invertido')
EndIf
ACT(&colInstrumento:fac, 'Instrumento')
ACT(&colInstrumento+1:fac, 'Entidad')
ACT(&colInstrumento+2:fac, 'Moneda')
ACT(&colInstrumento+3:fac, 'Vencimiento')
ACT(&colInstrumento+4:fac, 'Tasa')
ACT(&colInstrumento+5:fac, 'Capital Inicial')
ACT(&colInstrumento+6:fac, 'Monto a la Fecha')

SetFont(A:fac..&finFormato:fac, 2)
AgregarMarco(A:fac..&finFormato:fac, 0, 0, Exe('COLOR'))

****SQL Bloque PF***
SQL.ADD("SELECT O.NrOperacion,SUM(M.Monto)/"~Fstr(&unidad, 0, 0)~" AS Monto, M.Especie, M.TipoDevengado, M.Cliente, O.Vehiculo1 as 'Vehiculo',")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.CantidadOri/"~Fstr(&unidad, 0, 0)~" AS CantidadOri,O.Book1, O.Precio1")
IF Dialogo.Radio4=0
    SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M,"~DBO~".OPERACIONES O")
    SQL.ADD("WHERE M.NrOperacion = O.NrOperacion")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M,"~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
    SQL.ADD("WHERE M.NrOperacion = O.NrOperacion") 
    SQL.ADD("AND V.Codigo = O.Vehiculo1 ")
EndIf
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND M.Vehiculo='"~Dialogo.Vehiculo1~"'")
Else
    SQL.ADD("AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
**************
SQL.ADD("AND O.TipoOp = 'MMCPM'")
SQL.ADD("AND M.TipoDevengado = 'INTLEN'")
SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("AND M.Fecha   <= '"~IdxDate(Dialogo.Fecha1)~"'")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.Book1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF  
SQL.ADD("GROUP By O.NrOperacion,M.Especie, M.TipoDevengado, M.Cliente, O.Vehiculo1,")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.CantidadOri,O.Book1, O.Precio1")
If Dialogo.Radio4=1
    SQL.ADD(",V.Descripcion")
EndIF

SQL.ADD(" UNION ")

SQL.ADD("SELECT O.NrOperacion,0 AS Monto, O.Especie, '' as TipoDevengado, O.Vehiculo1 as 'Cliente', O.Vehiculo1 as 'Vehiculo',")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.CantidadOri/"~Fstr(&unidad, 0, 0)~" AS CantidadOri,O.Book1, O.Precio1")
IF Dialogo.Radio4=0
    SQL.ADD("FROM "~DBO~".OPERACIONES O")
    SQL.ADD("WHERE O.TipoOp = 'MMCPM'")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
    SQL.ADD("WHERE O.TipoOp = 'MMCPM'") 
    SQL.ADD("AND V.Codigo = O.Vehiculo1 ")
EndIf
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
Else
    SQL.ADD("AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
**************
*Operaciones ingresadas en el dia o plazo fijo a tasa cero.
SQL.ADD("AND (O.FechaOp= '"~IdxDate(Dialogo.Fecha1)~"' OR (O.FechaOp<= '"~IdxDate(Dialogo.Fecha1)~"' AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' AND O.Precio1 = 0))")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.Book1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF  
SQL.ADD("GROUP By O.NrOperacion,O.Especie, O.Vehiculo1,O.Cliente1,O.FechaOp,O.FechaVto,O.CantidadOri,O.Book1, O.Precio1")
IF Dialogo.Radio4=1
    SQL.ADD(",V.Descripcion")
Endif
SQL.ADD(" ORDER BY O.Vehiculo1,O.Book1, O.NrOperacion ")
    
    
Watch(sql.Batch)
Recorrer SQL
    let &vehiculoTC FBN['Vehiculo']
    (.'COTVEHIC'.)
    let &monedaTC2 fbn('Especie')
    (.'TIPOCAMBIO'.)
    
    If Dialogo.Radio4=1
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Descripcion'))
        ACT(B:fac, fbn('Book1'))
    Else
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Book1'))
    EndIf
    ACT(&colInstrumento:fac, 'PF')
    ACT(&colInstrumento+1:fac, fbn('Cliente1'))
    ACT(&colInstrumento+2:fac, fbn('Especie'))
    ACT(&colInstrumento+3:fac, fbn('FechaVto'))
    ACN(&colInstrumento+4:fac, fbn('Precio1'))
    ACN(&colInstrumento+5:fac, fbn('CantidadOri'))
    
    If EqStr(&MonedaInforme, fbn('Especie'))
        ACN(&colInstrumento+6:fac, fbn('CantidadOri')+fbn('Monto') )
    ELSE
        ACN(&colInstrumento+6:fac, ((fbn('CantidadOri')+fbn('Monto'))*&tc) )
    ENDIF
    let &totalPF &totalPF + Val(&colInstrumento+6:fac)
    ACT(&colInstrumento+9:FAC, FBN['NrOperacion'])
    ACLO(&colInstrumento+9:FAC, FBN['NrOperacion'])
Proximo
