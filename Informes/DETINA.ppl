AgregarMarco(A:fac..&finFormato:fac, 0, 0, Exe('COLOR'))


****SQL Bloque CAUCIONES***
SQL.ADD("SELECT O.NrOperacion,SUM(M.Monto)/"~Fstr(&unidad, 0, 0)~" AS Monto, O.Especie As Moneda, M.TipoDevengado, M.Cliente, O.Vehiculo1 as 'Vehiculo',")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.Cantidad/"~Fstr(&unidad, 0, 0)~" AS Cantidad,O.Book1, O.Precio1, O.TipoOp")

IF Dialogo.Radio4=0
    SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M,"~DBO~".OPERACIONES O")
    SQL.ADD("WHERE M.NrOperacion = O.NrOperacion")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M,"~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
    SQL.ADD("WHERE M.NrOperacion = O.NrOperacion")
    SQL.ADD(" AND V.Codigo = O.Vehiculo1 ")
EndIf
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND M.Vehiculo='"~Dialogo.Vehiculo1~"'")
Else
    SQL.ADD("AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
**************
SQL.ADD("AND O.TipoOp IN('SECAC', 'SECAT')")
SQL.ADD("AND M.TipoDevengado = 'INTLEN'")
SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
*SQL.ADD("AND O.FechaOp <= '"~IdxDate(Dialogo.Fecha1)~"'")
SQL.ADD("AND M.Fecha   <= '"~IdxDate(Dialogo.Fecha1)~"'")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.Book1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
SQL.ADD("GROUP By O.NrOperacion,O.Especie, M.TipoDevengado, M.Cliente, O.Vehiculo1,O.Cliente1,O.FechaOp,O.FechaVto,O.Cantidad,O.Book1, O.Precio1, O.TipoOp")
If Dialogo.Radio4=1
SQL.ADD(", V.Descripcion")
Endif

SQL.ADD(" UNION ")

SQL.ADD("SELECT O.NrOperacion,0 AS Monto, O.Especie As Moneda, '' As 'TipoDevengado', '' as 'Cliente', O.Vehiculo1 as 'Vehiculo',")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.Cantidad/"~Fstr(&unidad, 0, 0)~" AS Cantidad,O.Book1, O.Precio1, O.TipoOp")
IF Dialogo.Radio4=0
    SQL.ADD("FROM "~DBO~".OPERACIONES O")
    SQL.ADD("WHERE O.TipoOp IN('SECAC', 'SECAT')")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD("FROM "~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
    SQL.ADD("WHERE O.TipoOp IN('SECAC', 'SECAT')")
    SQL.ADD(" AND V.Codigo = O.Vehiculo1 ")
EndIf

***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND O.Vehiculo1='"~Dialogo.Vehiculo1~"'")
Else
    SQL.ADD("AND O.Vehiculo1 IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
**************
SQL.ADD("AND O.FechaOp = '"~IdxDate(Dialogo.Fecha1)~"'")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.Book1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
SQL.ADD("GROUP By O.NrOperacion,O.Especie, O.Vehiculo1,O.Cliente1,O.FechaOp,O.FechaVto,O.Cantidad,O.Book1, O.Precio1, O.TipoOp")
IF Dialogo.Radio4=1
    SQL.ADD(",V.Descripcion")
Endif

SQL.ADD(" ORDER BY O.Vehiculo1,O.Book1, O.TipoOp, O.NrOperacion ")

Watch(sql.Batch)
Recorrer SQL
    let &vehiculoTC FBN['Vehiculo']
    (.'COTVEHIC'.)
    let &monedaTC2 fbn('Moneda')
    (.'TIPOCAMBIO'.)
    
    If Dialogo.Radio4=1
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Descripcion'))
        ACT(B:fac, fbn('Book1'))
    Else
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Book1'))
    EndIf    
    ACT(&colInstrumento:fac, 'CAUCION')
    ACT(&colInstrumento+1:fac, fbn('Cliente1'))
    ACT(&colInstrumento+2:fac, fbn('Moneda'))
    ACT(&colInstrumento+3:fac, fbn('FechaVto'))
    ACN(&colInstrumento+4:fac, fbn('Precio1'))
    IF EqStr(FBN('TipoOp'), 'SECAT')
        ACN(&colInstrumento+5:fac, fbn('Cantidad')*(-1))
    ELSE
        ACN(&colInstrumento+5:fac, fbn('Cantidad'))
    EndIf
        ACN(&colInstrumento+6:fac, Val(&colInstrumento+5:fac)+fbn('Monto') )
    If EqStr(&MonedaInforme, fbn('Moneda'))
        ACN(&colInstrumento+6:fac, Val(&colInstrumento+5:fac)+fbn('Monto') )
    ELSE
        ACN(&colInstrumento+6:fac, (Val(&colInstrumento+5:fac)+fbn('Monto'))*&tc) 
    EndIf    
    let &totalCauciones &totalCauciones + Val(&colInstrumento+6:fac)
    ACT(&colInstrumento+9:FAC, FBN['NrOperacion'])
    ACLO(&colInstrumento+9:FAC, FBN['NrOperacion'])
Proximo

