ACT(&colInstrumento+4:fac, 'Cotización ARS')
ACT(&colInstrumento+5:fac, 'Nominales')
ACT(&colInstrumento+6:fac, 'Monto a la Fecha')

SetFont(A:fac..&finFormato:fac, 2)
AgregarMarco(A:fac..&finFormato:fac, 0, 0, Exe('COLOR'))

***SQL ONs***
SQL.ADD(" Select P.Vehiculo,P.Especie,E.Issuer Entidad, E.MonedaEmision Moneda, E.Fecha, E.Cotiza, ")
SQL.ADD(" P.CantidadFin/"~Fstr(&unidad, 0, 0)~" CantidadFin,  P.Book ")
IF Dialogo.Radio4=0
    SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E ")
    SQL.ADD(" Where E.Codigo = P.Especie ")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD(" From "~DBO~".POSICIONES2 P, "~DBO~".ESPECIES E, "~DBO~".VEHICULOS V ")
    SQL.ADD(" Where E.Codigo = P.Especie ")
    SQL.ADD(" AND V.Codigo = P.Vehiculo ")
EndIf
SQL.ADD(" AND dbo.DESCIENDEDEESPECIE(P.Especie,'CORP B') = 1 ")
SQL.ADD(" AND P.NrSaldo = 1 ")
SQL.ADD(" AND P.Fecha = '"~IdxDate(&fechaPosiciones2)~"' ")
***---Que no este vencida
SQL.ADD(" AND E.Fecha >= '"~IdxDate(&fechaPosiciones2)~"' ")
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD(" AND P.Vehiculo = '"~Dialogo.Vehiculo1~"' ")
Else
    SQL.ADD("AND P.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
**************
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND P.Book IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF
*SQL.ADD(" Order By 3, 4, 1 ")
SQL.ADD(" Order By P.Vehiculo,P.Book ")
Watch(sql.Batch)
Recorrer SQL
    let &vehiculoTC FBN['Vehiculo']
    (.'COTVEHIC'.)
    let &monedaTC2 fbn('Cotiza')
    (.'TIPOCAMBIO'.)
    
    
    If Dialogo.Radio4=1
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Descripcion'))
        ACT(B:fac, fbn('Book'))
    Else
        ACT(A:fac, fbn('Vehiculo')~' '~fbn('Book'))
    EndIf  
    ACT(&colInstrumento:fac, fbn('Especie'))
    ACT(&colInstrumento+1:fac, fbn('Entidad'))
    ACT(&colInstrumento+2:fac, fbn('Moneda'))
    ACT(&colInstrumento+3:fac, fbn('Fecha')) 
    *Si la Especie Cotiza en Pesos, pongo la Cotización a la fecha del informe en moneda local
    IF EqStr(fbn('Cotiza'), &monedaLocal)
        ACN(&colInstrumento+4:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)) 
   ELSE 
        IF EqStr(fbn('Cotiza'), &monedaExtr)
            ACN(&colInstrumento+4:fac, Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)*&cotVehiculo) 
        EndIF
    EndIf
    let &precioCotiza Cotizacion(fbn('Especie'),,,,Dialogo.Fecha1,1,SI)
    ACN(&colInstrumento+5:fac, fbn('CantidadFin'))
    ACN(&colInstrumento+6:fac, Val(&colInstrumento+5:fac)* &precioCotiza * &tc)
    let &totalONs &totalONs + Val(&colInstrumento+6:fac)
Proximo
****FORMATO DE CELDAS BLOQUE ONs****
let &filaFinONs fac
*let &filaFinInversiones fac
AgregarMarco(A:&filaIniONs..&finFormato:&filaFinONs, 0, 0)
FormatoCeldas(&colInstrumento+4:&filaIniONs..&colInstrumento+4:&filaFinONs, Exe('F8'))
FormatoCeldas(&colInstrumento+5:&filaIniONs..&colInstrumento+5:&filaFinONs, Exe('F2'))
FormatoCeldas(&colInstrumento+6:&filaIniONs..&colInstrumento+6:&filaFinONs, Exe('F2'))

****TOTAL MONTO A LA FECHA ONs
ACN(&colInstrumento+6:&filaTotalONs, &TotalONs)
SetFont(&colInstrumento+6:&filaTotalONs, 2)
FormatoCeldas(&colInstrumento+6:&filaTotalONs, Exe('F2'))
AgregarMarco(&colInstrumento+6:&filaTotalONs, 0, 0)
SetFilaActual(fac+3)

**********************************************************************
****---BLOQUE CHEQUES
**********************************************************************
let &filaTotalCheques fac-1
let &filaIniCheques fac+1
let &corrimientoCheques 3
ACT(A:fac, 'Vehiculo')
If Dialogo.Radio4=1
    ACT(B:fac, 'Book')
Else
    ACT(&colInstrumento+4:fac, '% Sobre Total Invertido')
EndIf
ACT(&colInstrumento:fac, 'Descuento Documento')
ACT(&colInstrumento+1:fac, 'Entidad')
ACT(&colInstrumento+2:fac, 'Moneda')
*ACT(&colInstrumento+3:fac, 'Vencimiento')
*ACT(&colInstrumento+4:fac, 'Cotización ARS')
*ACT(&colInstrumento+5:fac, 'Nominales')
ACT(&colInstrumento+&corrimientoCheques:fac, 'Monto a la Fecha')

SetFont(A:fac..&finFormato-&corrimientoCheques:fac, 2)
AgregarMarco(A:fac..&finFormato-&corrimientoCheques:fac, 0, 0, Exe('COLOR'))

****SQL Bloque Cheques***
let &bookActual ''
let &clienteActual ''
let &tipoDocActual ''
let &esPrimerRegistro 1

SQL.ADD("SELECT O.NrOperacion,SUM(M.Monto)/"~Fstr(&unidad, 0, 0)~" AS Monto, M.Especie, M.TipoDevengado, M.Cliente, O.Vehiculo1 as 'Vehiculo',")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.Cantidad/"~Fstr(&unidad, 0, 0)~" AS Capital,O.Book1, O.Precio1, O.TipoDoc")
IF Dialogo.Radio4=0
    SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M,"~DBO~".OPERACIONES O")
    SQL.ADD("WHERE M.NrOperacion = O.NrOperacion")
Else
    SQL.ADD(",V.Descripcion")
    SQL.ADD("FROM "~DBO~".MOVDEVENGADOS M,"~DBO~".OPERACIONES O, "~DBO~".VEHICULOS V ")
    SQL.ADD("WHERE M.NrOperacion = O.NrOperacion") 
    SQL.ADD("AND V.Codigo = O.Vehiculo1 ")
EndIf
***Vehiculo***
If NoVacio(Dialogo.Vehiculo1)
    SQL.ADD("AND M.Vehiculo='"~Dialogo.Vehiculo1~"'")
Else
    SQL.ADD("AND M.Vehiculo IN ("~Pipe2Comillas(Dialogo.Lista1)~")")
EndIf
**************
SQL.ADD("AND O.TipoOp = 'DDC'")
SQL.ADD("AND M.TipoDevengado = 'INTLEN'")
SQL.ADD("AND O.FechaVto > '"~IdxDate(Dialogo.Fecha1)~"' ")
SQL.ADD("AND M.Fecha   <= '"~IdxDate(Dialogo.Fecha1)~"'")
IF NoVacio(Dialogo.Lista2)
    SQL.ADD(" AND O.Book1 IN ("~Pipe2Comillas(Dialogo.Lista2)~") ")
ENDIF  
SQL.ADD("GROUP By O.NrOperacion,M.Especie, M.TipoDevengado, M.Cliente, O.Vehiculo1,")
SQL.ADD("O.Cliente1,O.FechaOp,O.FechaVto,O.Cantidad,O.Book1, O.Precio1, O.TipoDoc")
If Dialogo.Radio4=1
    SQL.ADD(",V.Descripcion")
EndIF
*SQL.ADD(" ORDER BY O.Vehiculo1,O.Book1, O.NrOperacion ")
SQL.ADD(" ORDER BY O.Book1,O.Cliente1, O.TipoDoc ")
Watch(sql.Batch)
Recorrer SQL
    let &vehiculoTC FBN['Vehiculo']
    (.'COTVEHIC'.)
    let &monedaTC2 fbn('Especie')
    (.'TIPOCAMBIO'.)
    IF Eqstr(fbn('Book1'),&bookActual) Y Eqstr(fbn('Cliente1'),&clienteActual) Y Eqstr(fbn('TipoDoc'),&tipoDocActual)
        DFA
        If EqStr(&MonedaInforme, fbn('Especie'))
            SCN(&colInstrumento+3:fac, fbn('Capital')+fbn('Monto') )
        ELSE
            SCN(&colInstrumento+3:fac, ((fbn('Capital')+fbn('Monto'))*&tc) )
        ENDIF
    ELSE
        let &bookActual fbn('Book1')
        let &clienteActual fbn('Cliente1')
        let &tipoDocActual fbn('TipoDoc')
        
        If Dialogo.Radio4=1
            ACT(A:fac, fbn('Vehiculo')~' '~fbn('Descripcion'))
            ACT(B:fac, fbn('Book1'))
        Else
            ACT(A:fac, fbn('Vehiculo')~' '~fbn('Book1'))
        EndIf
        ACT(&colInstrumento:fac, fbn('TipoDoc'))
        ACT(&colInstrumento+1:fac, fbn('Cliente1'))
        ACT(&colInstrumento+2:fac, fbn('Especie'))
        *ACT(&colInstrumento+3:fac, fbn('FechaVto'))
        *ACN(&colInstrumento+4:fac, fbn('Precio1'))
        *ACN(&colInstrumento+5:fac, fbn('Capital'))
        
        If EqStr(&MonedaInforme, fbn('Especie'))
            ACN(&colInstrumento+3:fac, fbn('Capital')+fbn('Monto') )
        ELSE
            ACN(&colInstrumento+3:fac, ((fbn('Capital')+fbn('Monto'))*&tc) )
        ENDIF
    ENDIF
    let &totalCheques &totalCheques + IIF(EqStr(&MonedaInforme, fbn('Especie')),fbn('Capital')+fbn('Monto'),((fbn('Capital')+fbn('Monto'))*&tc))
    *04/01/2024 - Agustin
    *Por mas que los cheques sean una inversion, se condensara a una sola linea por Book, Entidad y TipoDocumento
    *No se muestra el NrOperacion
Proximo

let &filaFinCheques fac
let &filaFinInversiones fac
AgregarMarco(A:&filaIniCheques..&finFormato-&corrimientoCheques:&filaFinCheques, 0, 0)
FormatoCeldas(&colInstrumento+4:&filaIniCheques..&colInstrumento+4:&filaFinCheques, Exe('F8'))
FormatoCeldas(&colInstrumento+5:&filaIniCheques..&colInstrumento+5:&filaFinCheques, Exe('F2'))
FormatoCeldas(&colInstrumento+6:&filaIniCheques..&colInstrumento+6:&filaFinCheques, Exe('F2'))

****TOTAL MONTO A LA FECHA Cheques
ACN(&colInstrumento+&corrimientoCheques:&filaTotalCheques, &TotalCheques)
SetFont(&colInstrumento+3:&filaTotalCheques, 2)
FormatoCeldas(&colInstrumento+3:&filaTotalCheques, Exe('F2'))
AgregarMarco(&colInstrumento+3:&filaTotalCheques, 0, 0)
SetFilaActual(fac+3)


**********************************************************************
***---Armo Cuadro Final de SubTotales por Vehiculo/Book/Instrumento
**********************************************************************
If Dialogo.Radio4=0
    ***---Inversiones
    *let &vehiculoBook ''
    let &filaIniSubTotales fac+1
    let &listaInvBooks ''
    let &cantBooks 0
    Recorrer&k &filaIniInversiones, &filaFinInversiones
        IF Not(Vacio(Val(A:&k)) O Eqstr(Val(A:&k), 'Vehiculo'))   
       ***--Reviso si el book está en &listaInvBooks, sino escribo un nuevo registro
            If Not Incluido(Val(A:&k), &listaInvBooks )
                ifa
                ACT(B:fac, Val(A:&k))
                ACT(C:fac, 'Inversiones '~Val(A:&k))
                *El total de los cheques se guarda en la fila E
                ACN(D:fac, Val(D:fac) + IIF(&k<&filaIniCheques,Val(H:&k),Val(E:&k)))
                let &listaInvBooks &listaInvBooks ~ '|'~Val(a:&k)
                let &cantBooks &cantBooks + 1
       ***--Si el Book ya existe, vuelvo a recorrer el cuadro para sumar el valor al book correspondiente        
            ELSE
                Recorrer&j &filaIniSubTotales, &filaIniSubTotales + &cantBooks
                    IF EqStr(Val(A:&k),Val(B:&j))
                        *El total de los cheques se guarda en la fila E
                        ACN(D:&j, Val(D:&j) + IIF(&k<&filaIniCheques,Val(H:&k),Val(E:&k)))
                    EndIf
                Proximo
            ENDIF
        EndIf 
    Proximo
    SetFont(B:&filaIniSubTotales..D:fac, 1)
    FormatoCeldas(B:&filaIniSubTotales..D:fac, Exe('F2'))
    AgregarMarco(B:&filaIniSubTotales..D:fac, 0, 0)
    ***---Ctas Vista
    ifa
    let &vehiculoBookInst ''
    let &totalVehiculoBookInst 0
    let &filaIniInst fac
    let &totalVehiculoBook 0
    let &instrumento ''
    Recorrer&k &filaIniCtasVista, &filaFinCtasVista
        IF Not Eqstr(Val(A:&k)~Val(B:&k), &vehiculobookInst)
            IF NoVacio(&VehiculobookInst)
                ACN(D:fac, &totalVehiculoBookInst)
                IF Not Eqstr(Val(B:&k), &instrumento)
                    SetFont(B:&filaIniInst..D:fac, 2)
                    FormatoCeldas(B:&filaIniInst..D:fac, Exe('F2'))
                    AgregarMarco(B:&filaIniInst..D:fac, 0, 0)
                ENDIF
                ifa
                *let &filaIniInst fac
            ENDIF
            ACT(B:fac, Val(A:&k))
            ACT(C:fac, Val(B:&k))
            let &totalVehiculoBookInst 0
        ENDIF
        let &totalVehiculoBookInst &totalVehiculoBookInst + Val(F:&k)
        let &VehiculobookInst Val(A:&k)~Val(B:&k)
        let &instrumento Val(C:fac)
    Proximo
    ACN(D:fac, &totalVehiculoBookInst)
    SetFont(B:&filaIniInst..D:fac, 1)
    FormatoCeldas(B:&filaIniInst..D:fac, Exe('F2'))
    AgregarMarco(B:&filaIniInst..D:fac, 0, 0)
    let &filaFinInst fac

    ifa
**********************************************************************
***---Cuadro de Totales por Vehiculo/Book
**********************************************************************

    let &cantVehiculoBook 0
    let &filaIniTotalVehiculoBook fac
    let &totalGeneral 0
    let &listaBooks ''
    Recorrer&k &filaIniSubTotales, &filaFinInst
        ***---Recorro cada fila del cuadro de Vehiculo/Book/Instrumentos
        If Not Incluido(Val(B:&k), &listaBooks)
            ***---Si no encontro el vehiculo/book, sumo una fila al cuadro final, sumo el nombre del book a la lista
            let &cantVehiculoBook &cantVehiculoBook + 1
            ACT(C:fac, Val(B:&k))
            ACN(D:fac, Val(D:&k))
            let &totalGeneral &totalGeneral + Val(D:&k)
            let &listaBooks &listaBooks~'|'~Val(B:&k)
            ifa
        ELSE
            ***---Si el vehiculo/book está en la lista, vuelvo a recorrer el cuadro de totales por Vehiculo/Book
            Recorrer&j &filaIniTotalVehiculoBook, &filaIniTotalVehiculoBook + &cantVehiculoBook
               IF Eqstr(Val(B:&k), Val(C:&j))
                   ACN(D:&j, Val(D:&j) + Val(D:&k))
                   let &totalGeneral &totalGeneral + Val(D:&k)
               ENDIF
            Proximo
        ENDIF
    Proximo
    Recorrer&k &filaIniTotalVehiculoBook, &filaIniTotalVehiculoBook + &cantVehiculoBook-1
        ***---Recorro último cuadro para agregar palabra "Total"
        ACT(C:&k, 'Total '~Val(C:&k))
    Proximo

    SetFont(C:&filaIniTotalVehiculoBook..D:fac-1, 2)
    FormatoCeldas(D:&filaIniTotalVehiculoBook..D:fac-1, Exe('F2'))
    AgregarMarco(C:&filaIniTotalVehiculoBook..D:fac-1, 0, 0)
    ACT(C:fac, 'Total')
    ACN(D:fac, &totalGeneral)
    SetFont(C:fac..D:fac, 3)
    FormatoCeldas(D:fac..D:fac, Exe('F2'))
    AgregarMarco(C:fac..D:fac, 0, 0, Exe('COLOR'))

**********************************************************************
***CÁLCULO % SOBRE TOTAL INVERTIDO***
**********************************************************************
***---Recorro Cuadro CTAS VISTA para calcular el % sobre total Invertido
    Recorrer&k &filaIniCtasVista, &filaFinCtasVista
        ACN(G:&k, Val(F:&k) / &totalGeneral * 100)
        ACN(G:&filaTotalCtasVista, Val(G:&filaTotalCtasVista) + Val(G:&k))
        ACN(H:&k, Val(F:&k) / &totalCtasVista * 100)
        ACN(H:&filaTotalCtasVista+1, Val(H:&filaTotalCtasVista+1) + Val(H:&k))
    Proximo
    SetFont(G:&filaIniCtasVista..H:&filaFinCtasVista, 1)
    SetFont(G:&filaTotalCtasVista..H:&filaTotalCtasVista+1, 2)
    FormatoCeldas(G:&filaTotalCtasVista..H:&filaFinCtasVista, Exe('F2%'))

    ***---Recorro Cuadro FCI y Plazo Fijo para calcular el % sobre total Invertido
    Recorrer&k &filaIniFCI, &filaFinFCI
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalFCI, Val(I:&filaTotalFCI) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &totalFCI * 100)
        ACN(J:&filaTotalFCI+1, Val(J:&filaTotalFCI+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniFCI..J:&filaFinFCI, 1)
    SetFont(I:&filaTotalFCI..J:&filaTotalFCI+1, 2)
    FormatoCeldas(I:&filaTotalFCI..J:&filaFinFCI, Exe('F2%'))

    ***---Recorro Cuadro PLAZO FIJO para calcular el % sobre total Invertido
    Recorrer&k &filaIniPlazoFijo, &filaFinPlazoFijo
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalPF, Val(I:&filaTotalPF) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &totalPF * 100)
        ACN(J:&filaTotalPF+1, Val(J:&filaTotalPF+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniPlazoFijo..J:&filaFinPlazoFijo, 1)
    SetFont(I:&filaTotalPF..J:&filaTotalPF+1, 2)
    FormatoCeldas(I:&filaTotalPF..J:&filaFinPlazoFijo, Exe('F2%'))

    ***---Recorro Cuadro CAUCIONES para calcular el % sobre total Invertido
    Recorrer&k &filaIniCauciones, &filaFinCauciones
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalCauciones, Val(I:&filaTotalCauciones) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &TotalCauciones * 100)
        ACN(J:&filaTotalCauciones+1, Val(J:&filaTotalCauciones+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniCauciones..J:&filaFinCauciones, 1)
    SetFont(I:&filaTotalCauciones..J:&filaTotalCauciones+1, 2)
    FormatoCeldas(I:&filaTotalCauciones..J:&filaFinCauciones, Exe('F2%'))

    ***---Recorro Cuadro LETRAS para calcular el % sobre total Invertido
    Recorrer&k &filaIniLetras, &filaFinLetras
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalLetras, Val(I:&filaTotalLetras) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &TotalLetras * 100)
        ACN(J:&filaTotalLetras+1, Val(J:&filaTotalLetras+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniLetras..J:&filaFinLetras, 1)
    SetFont(I:&filaTotalLetras..J:&filaTotalLetras+1, 2)
    FormatoCeldas(I:&filaTotalLetras..J:&filaFinLetras, Exe('F2%'))

    ***---Recorro Cuadro BONOS para calcular el % sobre total Invertido
    Recorrer&k &filaIniBonos, &filaFinBonos
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalBonos, Val(I:&filaTotalBonos) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &TotalBonos * 100)
        ACN(J:&filaTotalBonos+1, Val(J:&filaTotalBonos+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniBonos..J:&filaFinBonos, 1)
    SetFont(I:&filaTotalBonos..J:&filaTotalBonos+1, 2)
    FormatoCeldas(I:&filaTotalBonos..J:&filaFinBonos, Exe('F2%'))

    ***---Recorro Cuadro ACCIONES para calcular el % sobre total Invertido
    Recorrer&k &filaIniAcciones, &filaFinAcciones
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalAcciones, Val(I:&filaTotalAcciones) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &TotalAcciones * 100)
        ACN(J:&filaTotalAcciones+1, Val(J:&filaTotalAcciones+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniAcciones..J:&filaFinAcciones, 1)
    SetFont(I:&filaTotalAcciones..J:&filaTotalAcciones+1, 2)
    FormatoCeldas(I:&filaTotalAcciones..J:&filaFinAcciones, Exe('F2%'))

    ***---Recorro Cuadro ONs para calcular el % sobre total Invertido
    Recorrer&k &filaIniONs, &filaFinONs
        ACN(I:&k, Val(H:&k) / &totalGeneral * 100)
        ACN(I:&filaTotalONs, Val(I:&filaTotalONs) + Val(I:&k))
        ACN(J:&k, Val(H:&k) / &TotalONs * 100)
        ACN(J:&filaTotalONs+1, Val(J:&filaTotalONs+1) + Val(J:&k))
    Proximo
    SetFont(I:&filaIniONs..J:&filaFinONs, 1)
    SetFont(I:&filaTotalONs..J:&filaTotalONs+1, 2)
    FormatoCeldas(I:&filaTotalONs..J:&filaFinONs, Exe('F2%'))
    
    ***---Recorro Cuadro Cheques para calcular el % sobre total Invertido
    Recorrer&k &filaIniCheques, &filaFinCheques
        ACN(F:&k, Val(E:&k) / &totalGeneral * 100)
        ACN(F:&filaTotalCheques, Val(F:&filaTotalCheques) + Val(F:&k))
        ACN(G:&k, Val(E:&k) / &TotalCheques * 100)
        ACN(G:&filaTotalCheques+1, Val(G:&filaTotalCheques+1) + Val(G:&k))
    Proximo
    SetFont(F:&filaIniCheques..G:&filaFinCheques, 1)
    SetFont(F:&filaTotalCheques..G:&filaTotalCheques+1, 2)
    FormatoCeldas(F:&filaTotalCheques..G:&filaFinCheques, Exe('F2%'))
Endif
**********************************************************************
SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)


ACO(1, 20)
ACO(2, 15)
ACO(&colInstrumento, 15)
ACO(&colInstrumento+1, 20)
ACO(&colInstrumento+2, 8) 
ACO(&colInstrumento+3, 12)
ACO(&colInstrumento+4, 15)
ACO(&colInstrumento+5, 15)
ACO(&colInstrumento+6, 15)
ACO(&colInstrumento+7, 15)
ACO(&colInstrumento+8, 15)
ACO(&colInstrumento+9, 15)
ACO(&colInstrumento+10, 15)
ACO(&colInstrumento+11, 15)
ACO(&colInstrumento+12, 15)

if Dialogo.Radio4=0
    LimitesVision(L:fac+1)
Else
    LimitesVision(J:fac+1)
Endif