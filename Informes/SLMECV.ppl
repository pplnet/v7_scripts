**************************
*Saldo cuenta vista

SQL.ADD("SELECT  ST.Cliente, ST.Especie, ST.Mercado, ")
SQL.ADD("CU.Nombre as NomCuenta,")
SQL.ADD("E.Nombre,")
SQL.ADD("ST.Cuenta, ")
SQL.ADD("C.RazonSocial,")
SQL.ADD("Convert(int, E.CodNumCajaValores) as NumCaja,")
SQL.ADD("'' as DescEst,'' as Codigo,")
SQL.ADD("E.Alias5, E.InteresesC,")
SQL.ADD("Sum(ST.Saldo) as Saldo,")
SQL.ADD("ST.Cupon, Convert(int, CU.Numero) as NroCuenta")

SQL.ADD("FROM (")

SQL.ADD("SELECT         S1.Cliente, S1.Mercado, S1.Cuenta,  S1.Especie, ")
SQL.ADD("        ISNULL(S1.Cupon, '') AS Cupon, S1.Saldo,   S1.EnteCustodia")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 ")
SQL.ADD("WHERE S1.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
SQL.ADD("  and S1.Mercado = '"~Var('MERAUXLIQ')~"' ")
SQL.ADD("  and S1.NrSaldo = 81")
SQL.ADD("  and round(S1.Saldo,2) <> 0 ")
SQL.ADD("  and S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 ")
SQL.ADD("                  WHERE S2.Cliente      = S1.Cliente ")
SQL.ADD("                    and S2.Especie      = S1.Especie ")
SQL.ADD("                    and S2.EnteCustodia = S1.EnteCustodia ")
SQL.ADD("                    and S2.Mercado      = S1.Mercado ")
SQL.ADD("                    and S2.NrSaldo      = S1.NrSaldo ")
SQL.ADD("                    and S2.Cuenta       = S1.Cuenta ")
SQL.ADD("                    and IsNull(S2.Cupon,'') = IsNull(S1.Cupon,'') ")
SQL.ADD("                    and S2.Fecha       < '"~IdxDate(Dialogo.Fecha1)~"' ) ")

*Rueda Garantizada invierto cantidad
SQL.ADD("UNION ALL")
SQL.ADD("SELECT        S3.Cliente,              S3.Mercado,  S3.Cuenta,   S3.Especie, ")
SQL.ADD("       ISNULL(S3.Cupon, '') AS Cupon, -S3.Cantidad, S3.EnteCustodia")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS S3")
SQL.ADD("INNER JOIN "~DBO~".OPERACIONES O")
SQL.ADD("    on  S3.NrOperacion  = O.NrOperacion")
SQL.ADD("WHERE   S3.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
SQL.ADD("    and  O.TipoOp  in('TIC','TIV') and (O.CB4 = 1 or O.Cliente1=O.Vehiculo1)")
SQL.ADD("    and S3.Mercado =  '"~Var('MERAUXLIQ')~"' ")
SQL.ADD("    and S3.NrSaldo = 1")
SQL.ADD("    and S3.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' " )
    
*Resto de los movimientos 
SQL.ADD("UNION ALL")
SQL.ADD("SELECT        S3.Cliente,             S3.Mercado,  S3.Cuenta,  S3.Especie, ")
SQL.ADD("       ISNULL(S3.Cupon, '') AS Cupon, S3.Cantidad, S3.EnteCustodia")
SQL.ADD("FROM "~DBO~".MOVEJECUTADOS S3")
SQL.ADD("LEFT JOIN "~DBO~".OPERACIONES O")
SQL.ADD("    on  S3.NrOperacion  = O.NrOperacion")
SQL.ADD("WHERE   S3.EnteCustodia = '"~Dialogo.Vehiculo1~"'")
SQL.ADD("    and not(IsNull(O.TipoOp,'') in('TIC','TIV') and (IsNull(O.CB4, 0) = 1 or IsNull(O.Cliente1,'')=IsNull(O.Vehiculo1,'')))")
SQL.ADD("    and S3.Mercado = '"~Var('MERAUXLIQ')~"' ")
SQL.ADD("    and S3.NrSaldo = 1")
SQL.ADD("    and S3.FechaMov = '"~IdxDate(Dialogo.Fecha1)~"' " )

SQL.ADD(") AS ST")

SQL.ADD("INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK)")
SQL.ADD("      ON C.Codigo   = ST.Cliente")
SQL.ADD("INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("      ON E.Codigo   = ST.Especie ")
SQL.ADD("INNER JOIN "~DBO~".CUENTAS CU WITH (NOLOCK) ")
SQL.ADD("      ON CU.Codigo  = ST.Cuenta ")

SQL.ADD("WHERE ")
IF NoVacio(Dialogo.Lista3)
   SQL.ADD("   CU.Numero IN ("~Pipe2Comillas(Dialogo.Lista3)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("   E.CodNumCajaValores IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("   E.CodNumCajaValores Not IN ("~Pipe2Comillas(Dialogo.Lista2)~") AND ")
ENDIF
SQL.ADD("      ST.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   ST.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF Dialogo.Radio1 = 0
   *- Solamente Clientes SUDAMERIS
   SQL.ADD("   (C.TipoCliente = '"~VAR('CLISUD')~"' OR ")
   SQL.ADD("    C.TipoCliente IS NULL OR ")
   SQL.ADD("    C.TipoCliente = '      ') AND ")
EndIf
IF Dialogo.Radio1 = 1
   *- Solamente Clientes CAJA
   SQL.ADD(" C.TipoCliente = '"~VAR('CLICAJA')~"' AND ")
EndIf
SQL.ADD("      ST.Saldo <> 0 ")
SQL.ADD(" AND  ST.Cliente = CU.Cliente ")

SQL.ADD("GROUP BY ST.Cliente, ST.Mercado,  ST.Cuenta,          ST.Especie, ST.Cupon,      ST.EnteCustodia, ")
SQL.ADD("          E.Nombre,  C.RazonSocial, Convert(int, E.CodNumCajaValores), E.Alias5,   E.InteresesC, CU.Nombre, CU.Numero")

SQL.ADD("UNION ALL")


**************************
*Saldo Custodia
 
SQL.ADD("SELECT  S1.Cliente,     S1.Especie,          S1.Mercado,                CU.Nombre as NomCuenta, E.Nombre,")
SQL.ADD("        S1.Cuenta,      C.RazonSocial,       Convert(int, E.CodNumCajaValores) as NumCaja,       EC.Descripcion DescEst, EC.Codigo,")
SQL.ADD("        E.Alias5,       E.InteresesC,    SUM(S1.Saldo) Saldo,           S1.Cupon,               Convert(int, CU.Numero) as NroCuenta")
SQL.ADD("FROM "~DBO~".SALDOSDIA S1 WITH (NOLOCK) INNER JOIN "~DBO~".CLIENTES C WITH (NOLOCK)")
SQL.ADD("           ON S1.Cliente = C.Codigo ")
SQL.ADD("     INNER JOIN "~DBO~".ESPECIES E WITH (NOLOCK) ")
SQL.ADD("           ON E.Codigo = S1.Especie ")
SQL.ADD("     INNER JOIN "~DBO~".CUENTAS CU WITH (NOLOCK) ")
SQL.ADD("           ON CU.Codigo = S1.Cuenta ")
SQL.ADD("     INNER JOIN "~DBO~".ESTADOSCUSTODIA EC WITH (NOLOCK)  ")
SQL.ADD("           ON (S1.NrSaldo>201 or S1.NrSaldo=101) AND (S1.NrSaldo not in(121,227)) AND ((S1.NrSaldo-100=EC.NrSaldo AND S1.NrSaldo>201) or (S1.NrSaldo=EC.NrSaldo AND S1.NrSaldo=101)) ")
SQL.ADD("WHERE ")
IF NoVacio(Dialogo.Lista3)
   SQL.ADD("   CU.Numero IN ("~Pipe2Comillas(Dialogo.Lista3)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista1)
   SQL.ADD("    E.CodNumCajaValores IN ("~Pipe2Comillas(Dialogo.Lista1)~") AND ")
ENDIF
IF NoVacio(Dialogo.Lista2)
   SQL.ADD("   E.CodNumCajaValores Not IN ("~Pipe2Comillas(Dialogo.Lista2)~") AND ")
ENDIF
SQL.ADD("      S1.EnteCustodia = '"~Dialogo.Vehiculo1~"' AND ")
IF NoVacio(Dialogo.Mercado1)
   SQL.ADD("   S1.Mercado = '"~Dialogo.Mercado1~"' AND ")
ENDIF
IF Dialogo.Radio1 = 0
   *- Solamente Clientes SUDAMERIS
   SQL.ADD("   (C.TipoCliente = '"~VAR('CLISUD')~"' OR ")
   SQL.ADD("    C.TipoCliente IS NULL OR ")
   SQL.ADD("    C.TipoCliente = '      ') AND ")
EndIf
IF Dialogo.Radio1 = 1
   *- Solamente Clientes CAJA
   SQL.ADD(" C.TipoCliente = '"~VAR('CLICAJA')~"' AND ")
EndIf
SQL.ADD("      S1.Saldo <> 0 AND ")
SQL.ADD("      S1.Fecha = (SELECT MAX(S2.Fecha) ")
SQL.ADD("                  FROM "~DBO~".SALDOSDIA S2 WITH (NOLOCK) ")
SQL.ADD("                  WHERE S2.Cliente = S1.Cliente AND ")
SQL.ADD("                        S2.Especie = S1.Especie AND ")
SQL.ADD("                        S2.Cupon = S1.Cupon AND ")
SQL.ADD("                        S2.EnteCustodia = S1.EnteCustodia AND ")
SQL.ADD("                        S2.Mercado = S1.Mercado AND ")
SQL.ADD("                        S2.NrSaldo = S1.NrSaldo AND ")
SQL.ADD("                        S2.Cuenta = S1.Cuenta AND ")
SQL.ADD("                        S2.Fecha <= '"~IdxDate(Dialogo.Fecha1)~"' ) ")
SQL.ADD("GROUP BY S1.Especie, CU.Nombre, E.Nombre, S1.Mercado, S1.Cliente, S1.Cuenta, S1.NrSaldo, C.RazonSocial,  Convert(int, E.CodNumCajaValores),")
SQL.ADD("         E.FechaCambioTasa, E.TasaIntAnterior, E.TasaIntVigente, EC.Descripcion, EC.Codigo,E.Alias5, E.InteresesC, E.Cotiza, S1.Cupon, Convert(int, CU.Numero)")
SQL.ADD("ORDER BY Convert(int, CodNumCajaValores), Especie, Nombre, Cupon, Mercado, Convert(int, CU.Numero), Cuenta, Cliente")


