         ACT(es1, COPY(Val(es1),Longitud(FBN['Codigo'])+2,(Longitud(Val(es1))-(Longitud(FBN['Codigo'])+2))))
      ENDIF
      ACT(es3, BuscarCampo('ESTADOSCUSTODIA','Descripcion','Codigo',Val(es1)))
   ENDIF

   IF Incluido(Val(es3), Dialogo.Lista4) o Vacio(Dialogo.Lista4)
      IF [Not EqStr(FBN['Especie'], Val(az2))] o [Eqstr(FBN['Especie'], Val(az2)) y Round(FBN['Cupon'],0) <> Round(Val(cp1),0)] 
         IF Val(ay2)<>0 o Val(ay4)<>0  o Val(ay3)<>0
            ACT(h:fac, 'Total Cliente --->')
            ACN(i:fac, Val(ay4))
            ACN(j:fac, Round(Val(ax4),val(vr2)) )
