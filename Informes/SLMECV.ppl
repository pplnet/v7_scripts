         ENDIF

        
         Message(   FBN['NumCaja'] ~' - '~FBN['Especie'] ~' - '~FBN['Nombre'])
         ACT(a:fac, FBN['NumCaja'] ~' - '~FBN['Especie'] ~' - '~FBN['Nombre'])
        
         ACN(cp1, FBN['Cupon'])
         If Round(FBN['Cupon'],0) >= 0
            ACT(b:fac, FBN['Cupon'])
            AlinearCeldas(b:fac,'C')
         Endif
         
         ACT(az2, FBN['Especie'])
         ACT(al4, BuscarCampo('ESPECIES', 'Alias4', 'Codigo', FBN['Especie']))
         ACT(c:fac, FBN['Mercado'])
         ACT(az3, FBN['Mercado'])
         ACT(d:fac, FBN['NroCuenta'] ~ " - " ~ FBN['Cliente'])
         ACT(e:fac,Copy(FBN['RazonSocial'],1,25))
         ACT(az4, FBN['Cliente'])
         ACT(f:fac, FBN['Cuenta'])
         ACT(az5, FBN['Cuenta'])
         ACT(g:fac, FBN['NomCuenta'])
         SetFont(a:fac..e:fac,2)

         ACN(vr2,FBN['Alias5'])
      ENDIF

      IF Not EqStr(FBN['Mercado'], Val(az3))
         IF Val(ay2)<>0 o Val(ay4)<>0  o Val(ay3)<>0
            ACT(h:fac, 'Total Cliente --->')
            ACN(i:fac, Val(ay4))
            ACN(j:fac, Round(Val(ax4),val(vr2)) )
            ACN(k:fac, Val(aw4))
            SetFont(h:fac..k:fac,2)
            ACN(ax4, 0)
            ACN(ay4, 0)
            ACN(aw4, 0)
            
            ifa
            ACT(h:fac, 'Total Ubicacion --->')
            ACN(i:fac, Val(ay3))
            ACN(j:fac, Round(Val(ax3),val(vr2)) )
            ACN(k:fac, Val(aw3))
            SetFont(h:fac..k:fac,2)
            ACN(ax3, 0)
            ACN(ay3, 0)
            ACN(aw3, 0)
            
            ifa
         ENDIF
         ACT(c:fac, FBN['Mercado'])
         ACT(az3, FBN['Mercado'])
         ACT(d:fac, FBN['NroCuenta'] ~ " - " ~ FBN['Cliente'])
         ACT(e:fac,Copy(FBN['RazonSocial'],1,25))
         ACT(az4, FBN['Cliente'])
         ACT(az5, FBN['Cuenta'])
         ACT(f:fac, FBN['Cuenta'])
         ACT(g:fac, FBN['NomCuenta'])
         SetFont(c:fac..e:fac,2)
      ENDIF

      IF Not EqStr(FBN['Cliente'], Val(az4))
         IF Val(ay2)<>0 o Val(ay4)<>0  o Val(ay3)<>0
            ACT(h:fac, 'Total Cliente --->')
            ACN(i:fac, Val(ay4))
            ACN(j:fac, Round(Val(ax4),val(vr2)))
            ACN(k:fac, Val(aw4))
            SetFont(h:fac..k:fac,2)
            ACN(ax4, 0)
            ACN(ay4, 0)
            ACN(aw4, 0)
            
            ifa
         ENDIF
         ACT(d:fac, FBN['NroCuenta'] ~ " - " ~ FBN['Cliente'])
         ACT(e:fac,Copy(FBN['RazonSocial'],1,25))
         ACT(az4, FBN['Cliente'])
         ACT(az5, FBN['Cuenta'])
         ACT(f:fac, FBN['Cuenta'])
         ACT(g:fac, FBN['NomCuenta'])
         SetFont(d:fac..e:fac,2)
      ENDIF

      IF Not EqStr(FBN['Cuenta'], Val(az5))
         ACT(az5, FBN['Cuenta'])
         ACT(f:fac, FBN['Cuenta'])
         ACT(g:fac, FBN['NomCuenta'])
      ENDIF

      ACT(h:fac, FBN['DescEst'])
      ACN(i:fac, FBN['Saldo'])

      (.'INTERESCLE'.)

      ACN(ca:fac, Val(zz:fac))

      ACN(cb:fac, VALORTEORICO2(FBN['Especie'],Dialogo.Fecha1))

      IF Dialogo.Radio2 = 0
         ACN(cc:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONELOCA')))
      ELSE
         ACN(cc:fac, CotizacionC(FBN['Especie'],,,,Dialogo.Fecha1,1,SI,VAR('MONEEXTR')))
      ENDIF

      ACN(j:fac, Round(Val(i:fac)*Val(cb:fac),val(vr2)) )

      ACT(EE1,FBN['Especie'])
      ACD(EE2,Dialogo.Fecha1)

      IF EqStr(FBN['InteresesC'],'CLE')
         IF Incluido(Val(al4), '1585')
            ACN(k:fac, Val(j:fac)*Val(cc:fac)+(Val(ca:fac)*Val(cc:fac)) ) 
         ELSE
            ACN(k:fac, Val(j:fac)*Val(cc:fac)+Val(ca:fac) )
         ENDIF
      ELSE
         ACN(k:fac, Val(i:fac)*Val(cc:fac)+Val(ca:fac) )
      ENDIF

      SCN(ay4, Val(i:fac))
      SCN(ax4, Val(j:fac))
      SCN(aw4, Val(k:fac))
      SCN(ay3, Val(i:fac))
      SCN(ax3, Val(j:fac))
      SCN(aw3, Val(k:fac))
      SCN(ay2, Val(i:fac))
      SCN(ax2, Val(j:fac))
      SCN(aw2, Val(k:fac))
      SCN(aw1, Val(k:fac))
   ENDIF
