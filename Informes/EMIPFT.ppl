CrearFont(3, "Arial,14,B")
CrearFont(5, "Arial,10,BU")
CrearFont(6, "Arial,10,B")

ACT(tp:1,'NO COMPENSABLE POR CAMARA')
act(pi:1,Var('RESCTAPIEA'))
act(pi:2,Var('RESCTAPIEB'))

SQL.ADD("SELECT O.NrOperacion, O.Cliente1, O.Cantidad, O.Especie, O.ContraEspecie, O.Precio1, O.Cupon1, ")
SQL.ADD(" O.TotalBrutoCli1, O.TotalNetoCli1, O.TotalAux2, O.TotalAux4, O.TotalIntereses, O.CB8,         ") 
SQL.ADD(" O.PorAforo, O.EsAforado, O.TipoOp, O.Convenio, O.FechaOp, O.FechaVto, O.FechaAltaSisExterno,  ")
SQL.ADD(" O.FechaAltaMAE, O.FechaCarga, O.Cuenta1, O.NrBoleto, O.NrOperacion3, O.Plazo, O.NroAltaMAE,   ")
SQL.ADD(" Convert(Char(12), O.FechaAltaMAE, 14) as HoraMAE, O.Mercado4 MercadoNeg, O.DiasAnio,          ")
SQL.Add(" C.Codigo, C.RazonSocial, C.Direccion Dire, C.Localidad, C.CodigoPostal, C.CUIT, C.NrMAE,      ")
SQL.Add(" C.CondicionIVA, C.TipoInscripcion, C.Sucursal, C.Telefono, C.CategDepositante,                ")
SQL.Add(" C.Calle,        C.Altura,              C.Piso,            C.Depto,                            ")
SQL.Add(" C.Alias1, C.NrCuenta, E.Alias5,  E.InteresesC, 0 Valor, E.Extendido,                          ")
SQL.ADD(" E.CodMAEContado, O.TotalCaucion, E.CotizaMAE, E.VTeorico, O.TipoCambio2, O.PaseCB,            ")
SQL.ADD(" S.Nombre SucNombre, S.Localidad SucLocalidad                                                  ")
SQL.ADD("FROM   "~DBO~".OPERACIONES O,"~DBO~".CLIENTES C ,"~DBO~".ESPECIES E,"~DBO~".OPERACIONESBITS OB , "~DBO~".SUCURSALES S")
SQL.ADD("WHERE  O.NrOperacion  = '"~Dialogo.NrOperacion1~"'")
SQL.ADD("       and O.TipoOp  in  ('TIDE') ")
SQL.ADD("       and O.Cliente1 = C.Codigo  ")
SQL.ADD("       and E.Codigo   = O.Especie ")
SQL.ADD("       and OB.NrOperacion = O.NrOperacion ")
SQL.ADD("       and C.Sucursal = S.Codigo  ")
SQL.ADD("       and OB.NrBit  NOT IN (30,31) AND OB.Valor=1 ")
watch(SQL.BATCH())

Recorrer SQL
* ---> Generacion de lineas del Certificado

    **BuscarCampo('CLIENTES','RazonSocial','Codigo',Dialogo.Vehiculo1)
    ACN(im:1,FBN['TotalBrutoCli1'])
    ACT(tp:2,'INTRANSFERIBLE TITULOS '~BuscarCampo('ESPECIES','CodMaeContado','Codigo',FBN['ContraEspecie']))
    ACT(cl:1,FBN['Cliente1'])
    ACT(op:1,FBN['NrOperacion'])
    ACT(fe:1, FECHA(FBN['FechaOp']))
    ACT(fe:2, FECHA(FBN['FechaVto']))
    act(nu:1, '322-000-0000')
    (.'DIGVER9713'.)
    ACT(en:1, val(nu:1)~' '~Val(dv:1))

    
    ACT(nc:1,'00001701 9')
    ACT(nc:2,'77777777777 3')
    ACT(de:1,FBN['Extendido'])
    ACT(le:1, Letras(FBN['TotalBrutoCli1']))
    
    ACT(aa:1,'Imp.Depositado')
    ACT(ab:1,'Plazo')
    ACT(ac:1,'TNA%')
    ACT(ad:1,'TEA%')
    ACT(ae:1,'Periodo liq. Int.')
    ACT(af:1,'Total Interes')
    ACT(ag:1,'Retención') 

    ACT(aa:2,FBN['TotalBrutoCli1'])
    ACT(ab:2,FBN['Plazo'])
    ACT(ac:2,FBN['Precio1'])
    ***---TEA
    ACN(DA:100, iif(fbn('DiasAnio') = 0,360,365) )
    ACN(TE:100, (((1 + (fbn('Precio1') * FBN['Plazo'] / (Val(DA:100) * 100))) ^ (Val(DA:100) / FBN['Plazo'])) - 1) * 100)
    ACT(ad:2,Val(TE:100))
    
    ACT(ae:2,'Al Vencimiento')
    ACT(af:2,'')
    ACT(ag:2,'Ganancia')     
    ACT(ag:3,'Impuesto')         
    
    ACT(tc:1, 'Orden Unipersonal')
    ACT(do:1,  FBN['Calle']~' '~FBN['Altura']~' '~FBN['Piso']~' '~FBN['Depto']~' ('~FBN['CodigoPostal']~') '~FBN['Localidad'])
    
    ACT(aa:4,'CUIT/CUIL')
    ACT(ab:4,FBN['CUIT'])
    ACT(ac:4,FBN['RazonSocial'])
    ACT(ad:4,'')
    ACT(aa:5,'CUIT/CUIL')
    ACT(ab:5,FBN['CUIT'])
    ACT(ac:5,FBN['RazonSocial'])
    ACT(ad:5,'')
    ACT(aa:6,'CUIT/CUIL')
    ACT(ab:6,FBN['CUIT'])
    ACT(ac:6,FBN['RazonSocial'])
    ACT(ad:6,'')
    
    ACT(su:1,FBN['SucNombre']~' ('~FBN['Sucursal']~') '~FBN['SucLocalidad'])
    
proximo

