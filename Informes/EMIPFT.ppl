CrearDialogo
  NrOperacion1   : "NrOperacion"        ;1;1;1;;;NOVACIO(Dialogo.NrOperacion1);'Operacion Invalida.';NO;;;;;;"TipoOp IN ('TIDE')"
  Radio1         :"|Pantalla|PDF|Mail"  ;;;;;;;;;1;;;;;
