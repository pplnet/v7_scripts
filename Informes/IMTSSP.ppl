 if Num(SQL("select Count(*) from "~DBO~".MOVEJECUTADOS where NrOperacion='"~fbn('NrTrans')~"' ")) = 0
   ACT(k:fac,'Pendiente')
 else
   ACT(k:fac,'Confirmado')
 endif
 SetFont(b:fac..k:fac,4)
 if NoVacio(Dialogo.Especie1)
