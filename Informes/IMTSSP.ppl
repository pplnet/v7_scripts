ifa
ACT(z:1,'')
ACT(z:2,'')
ACN(z:3,0)
ACN(z:4,0)
ACN(z:5,0)

SQL.ADD("select DISTINCT  T.Mercado1, M.Descripcion NomMer, T.Cliente1, C.RazonSocial, T.NrTrans, T.Fecha1, T.Fecha2, T.Especie, E.Nombre NomEsp, T.Cantidad1, T.Precio1, T.Cantidad2, T.Cantidad3, T.Cuenta1, T.Cuenta2, T.Cupon1 ")
SQL.ADD(" from  "~DBO~".TRANSACCIONES2 T, "~DBO~".CLIENTES C, "~DBO~".MERCADOS M, "~DBO~".ESPECIES E, "~DBO~".OPERACIONESBITS B ")
SQL.ADD(" where T.TipoTr2   = 'STOCK' ")
SQL.ADD(" AND B.NrOperacion = T.NrTrans ")
SQL.ADD(" AND B.NrBit <> 40 ")
SQL.ADD(" AND B.Valor = '1' ")
SQL.ADD("  and  T.Mercado1 = M.Codigo ")
SQL.ADD("  and  T.Cliente1 = C.Codigo ")
SQL.ADD("  and  T.Especie  = E.Codigo ")
if NoVacio(Dialogo.Fecha3)
 SQL.ADD("  and  T.Fecha1    >= "~IdxDate2(Dialogo.Fecha3) )
endif
if NoVacio(Dialogo.Fecha4)
 SQL.ADD("  and  T.Fecha1    <= "~IdxDate2(Dialogo.Fecha4) )
endif
if NoVacio(Dialogo.Fecha1)
 SQL.ADD("  and  T.Fecha2    >= "~IdxDate2(Dialogo.Fecha1) )
endif
if NoVacio(Dialogo.Fecha2)
 SQL.ADD("  and  T.Fecha2    <= "~IdxDate2(Dialogo.Fecha2) )
endif
if NoVacio(Dialogo.Especie1)
 SQL.ADD("  and  T.Especie    = '"~Dialogo.Especie1~"' ")
endif
if NoVacio(Dialogo.CLiente1)
 SQL.ADD("  and  T.Cliente1   = '"~Dialogo.Cliente1~"' ")
endif
if NoVacio(Dialogo.Mercado1)
 SQL.ADD("  and  T.Mercado1   = '"~Dialogo.Mercado1~"' ")
endif
SQL.ADD("  and  T.Vehiculo1  = '"~Dialogo.Vehiculo1~"' ")
** FJL 10/08/22 - No mostrar transacciones saldos Parking
SQL.ADD("  and  Cambio5 not in ("~Pipe2Comillas(Val(w:1))~") ")
SQL.ADD(" order by T.Mercado1, T.Cliente1, T.NrTrans ")

recorrer SQL
 message(fbn('RazonSocial'))
