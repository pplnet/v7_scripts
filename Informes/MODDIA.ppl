CrearDialogo
  Vehiculo1    : "Vehiculo"     ;;;;;;;;;;;iif(Vacio(UsrVehiculos(UsuarioActivo)),SQLSET("Select Codigo from "~DBO~".VEHICULOS"),SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))
  Fecha1       : 'Fecha' ;;;;;;;;;FSys
  NrOperacion1 : 'Operacion'
FinDialogo

if Not OK
  Cancelar
endif

if Not Vacio(Dialogo.Vehiculo1)
   If Not Incluido(Dialogo.Vehiculo1, UsrVehiculos(UsuarioActivo)) y Not Vacio(UsrVehiculos(UsuarioActivo))
      Cancelar('El Operador no esta habilitado para operar con el Vehiculo ')
   endif
endif

CrearFont(1, 'Arial,8,B')
CrearFont(2, 'Arial,8,')


SetFilaActual(1)

ACT(a:1,'Operaciones Financieras CONFIDENCIAL')
SetFont(a:1,1)


ACT(a3, 'Operaciones modificadas del dia')

ACT(a4, 'Fecha: '~Dialogo.Fecha1)

if NoVacio(Dialogo.NrOperacion1)
   ACT(a5, 'Nr.Operacion: '~Dialogo.NrOperacion1)
else
   ACT(a5, 'Nr.Operacion: Todas')
endif

* Vehiculos permitidos por el usuario
ACT(zz6,SQLSET("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"' "))

If NoVacio(Dialogo.Vehiculo1)
   ACT(a6, 'Vehiculo : '~BuscarCampo('Vehiculos','Descripcion','Codigo',Dialogo.Vehiculo1))
Else
   if Vacio(UsrVehiculos(UsuarioActivo))
      ACT(a6, 'Vehiculo : Todos ')
   else
      ACT(a6, 'Vehiculo : '~val(zz6))
   endif
EndIf

ACT(a8, 'Nr.Op/Cuota')
ACT(b8, 'Tipo Op')
ACT(c8, 'Especie')
ACT(d8, 'Fecha Op')
ACT(e8, 'Campo')
ACT(f8, 'Anterior')
ACT(g8, 'Actual')
ACT(h8, 'Operador')

SetFont(a1..h8,1)

AgregarMarco(a8..h8,1,0,Exe('COLOR'))
SetFilaActual(8)

ACN(x1,FAC+1)

SQL.ADD("Select O.TipoOp,O.Especie,O.FechaOp,A.* from "~DBO~".PMAUDIT A,"~DBO~".OPERACIONES O ")
SQL.ADD(" where A.Tabla In ('OPERACIONES','CUOTAS') and A.Fecha >='"~IdxDate(Dialogo.Fecha1)~"' and A.Fecha <= '"~IdxDate(Dialogo.Fecha1+1)~"'")
SQL.ADD(" and A.Accion='M' ")
*SQL.ADD(" and Codigo>=O.NrOperacion and Codigo<=O.NrOperacion+'/9999' ")
If NoVacio(Dialogo.Vehiculo1)
   SQL.ADD(" and O.Vehiculo1='"~Dialogo.Vehiculo1~"' ")
Else
   If NoVacio(UsrVehiculos(UsuarioActivo))
      SQL.ADD(" and O.Vehiculo1 IN ("~Pipe2Comillas(val(zz6))~") ")
   EndIf
EndIf
If NoVacio(Dialogo.NrOperacion1)
   SQL.ADD("and O.NrOperacion='"~Dialogo.NrOperacion1~"'")
Endif
SQL.ADD("Order by A.Codigo, A.Fecha")

Recorrer SQL

  if EqStr(fbn('ValorAnterior'),fbn('ValorActual')) o Incluido(fbn('Campo'), 'LInstancia|Direccion') 
    dfa
  else
    if Not EqStr(Val(z1), fbn('Codigo'))
      ACT(z1, fbn('Codigo'))
      ACT(a:fac, fbn('Codigo'))
      ACLO(a:fac,Val(a:fac))
      ACT(b:FAC, fbn('TipoOp'))
      ACT(c:FAC, fbn('Especie'))
      ACT(d:FAC, fbn('FechaOp'))
    endif
    ACT(e:fac, fbn('Campo'))
    ACT(f:fac, fbn('ValorAnterior'))
    ACT(g:fac, fbn('ValorActual'))
    ACT(h:fac, fbn('Operador'))
    ACT(h:fac, Val(h:fac)~' '~fbn('Fecha'))
  endif
proximo


