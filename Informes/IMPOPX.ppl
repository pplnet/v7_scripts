CrearDialogo
  NrOperacion1 : 'Operacion';;;;;;NoVacio(Dialogo.NrOperacion1);'Operacion Invalida';NO;
  Radio1       : 'Automatico|SI|NO'    ;;;;NO;NO;;;;1;
FinDialogo

if not Ok
  Cancelar
endif

ACT(A:fac+1, 'Operacion:')
ACT(B:fac+1, Dialogo.NrOperacion1)
ACT(A:fac+2, 'TipoOp:')
ACT(A:fac+3, 'Plazo:')
ACT(A:fac+4, 'Vehiculo:')
ACT(A:fac+5, 'Monto USD:')

SQL.ADD(" Select TipoOp, TotalAux3, PrecioMer, Plazo, Vehiculo1 ")
SQL.ADD(" From "~DBO~".OPERACIONES ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
Recorrer SQL
    ACT(B:fac+1, fbn('TipoOp'))
    ACT(B:fac+2, fbn('Plazo'))
    ACT(B:fac+3, fbn('Vehiculo1'))
    IF Incluido(fbn('TipoOp'), 'DFXO|DSEO')
        ACT(B:fac+4, Fstr(fbn('TotalAux3'), 0, 2))
    ELSE
        ACT(B:fac+4, Fstr(fbn('PrecioMer'), 0, 2))
    ENDIF
Proximo

ACT (zz:99,  Dialogo.NrOperacion1)
ACT (zz:100, HORA(AHORA))
ACT (zz:101, Copy (Val (zz:100),1,2)~Copy (Val (zz:100),4,2)~Copy (Val (zz:100),7,2))
ACD (ZZ:102, Fsys)
ACT (zz:103, Copy (Val (zz:102),1,2)~Copy (Val (zz:102),4,2)~Copy (Val (zz:102),9,2))

SetFilaActual(fac+5)
ImprimirOperacion(Dialogo.NrOperacion1, SI, , , SI, NO)

if Dialogo.Radio1=0
  ExportarXLS(a:1..e:100,a:1..e:100,VAR('PATHWORK')~Val (zz:99)~Val (zz:103)~Val (zz:101)~'.XLS')
  ExportarXLS(a:1..e:100,a:1..e:100,VAR('PATHWOTE')~Val (zz:99)~Val (zz:103)~Val (zz:101)~'.XLS')
endIf

ACO(1, 20)
ACO(2, 12)
