*ModoReproceso(ConDialogo)
CrearDialogo
  NrOperacion1 : 'Operacion'  ;1;1;;  ;  ;NoVacio(Dialogo.NrOperacion1);'Operacion Invalida';NO;;;;;;" TipoOp IN ('FXCF', 'FXVF') ";
  Fecha1       : 'Desde Fecha';2;1;;NO;NO;
  Fecha2       : 'A Fecha'    ;2;1;;  ;  ;Dialogo.Fecha2 <> 0;'Fecha Invalida';NO;Fsys;
  Vehiculo1    : 'Vehiculo'   ;3;1;;NO;  ;;;NO;;BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion', Dialogo.NrOperacion1);
  Cantidad1    : 'Res.Acumul.';4;1;;NO;NO;
  Radio1       : 'Proceso|Manual|Automatico|Rango' ;5;1;;NO;NO;;;;0;
FinDialogo

if not Ok 
  Cancelar
endif

CrearFont(1, 'Arial,8,')
CrearFont(2, 'Arial,8,B')
CrearFont(3, 'Arial,10,B')

AgregarBMP(a:1,EXE('LOGO'),EXE('ESCALOGO'))
SetFilaActual(5)
ACT(A:fac, 'Detalle de Resultados Operacion Futuro '~Dialogo.NrOperacion1)
SetFont(A:fac, 3)
SetFilaActual(fac+2)
if Dialogo.Radio1<2
  ACT(A:fac, 'Hasta el '~Dialogo.Fecha2)
else
  ACT(A:fac, 'Entre el '~Dialogo.Fecha1~' y el '~Dialogo.Fecha2)
endif
SetFont(A:fac, 2)
IFA
ACT(A:fac, 'Vehiculo: '~Dialogo.Vehiculo1)
SetFont(A:fac, 2)

SetFilaActual(fac+2)
ACT(A:fac, 'Fecha')
ACT(B:fac, 'Resultado')
SetFont(A:fac..B:fac, 2)
AlinearCeldas(A:fac..B:fac, 'C')
AgregarMarco(A:fac..B:fac, 0, 0, Exe('COLOR'))
ACN(FI:1, fac+1)

SQL.ADD(" Select MTM Cantidad, Fecha  ")
SQL.ADD(" From "~DBO~".MTMDIARIO ")
SQL.ADD(" Where NrOperacion = '"~Dialogo.NrOperacion1~"' ")
SQL.ADD(" AND TipoMTM = 'MTM' ")
SQL.ADD(" AND Fecha <= '"~IdxDate(Dialogo.Fecha2)~"' ")
if Dialogo.Radio1=2
  SQL.ADD(" AND Fecha >= '"~IdxDate(Dialogo.Fecha1)~"' ")
endif
SQL.ADD(" Order By Fecha ")
Recorrer SQL
    ACD(A:fac, fbn('Fecha'))
    ACN(B:fac, fbn('Cantidad'))
    SCN(TO:1, fbn('Cantidad'))
Proximo

SetFont(A:Val(FI:1)..B:fac, 1)
SetFilaActual(fac+2)
ACT(A:fac, 'Total')
ACN(B:fac, Val(TO:1))
IF Round(Val(TO:1), 2) <> Round(Dialogo.Cantidad1, 2) Y Dialogo.Radio1 > 0
    ACT(C:fac, 'Verifique Resultados por Dia')
ENDIF
SetFont(A:fac..C:fac, 2)
FormatoCeldas(B:Val(FI:1)..B:fac, Exe('F2'))

SetFilaActual(fac+2)
ACT(A:fac, 'Fin del Informe')
SetFont(A:fac, 2)

ACO(2, 12)

LimitesVision(F:fac+1)
