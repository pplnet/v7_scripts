*Ignore=V6
test("anidado - fbn resuelve por nivel", ->{
    sql.addrow(${Col1 = 1})
    Recorrer sql
      assertEq(1, fbn("Col1"))
      sql.addrow(${Col2 = 2})
      Recorrer sql
        assertEq(2, fbn("Col2"))
      Proximo
      assertEq(1, fbn("Col1"))
    Proximo
})

test("anidado - el interno corre para cada fila del externo", ->{
    ACN(Z:1, 0)
    sql.addrow(${Foo = 1})
    sql.addrow(${Foo = 2})
    Recorrer SQL
       sql.addrow(${Bar = 1})
       sql.addrow(${Bar = 2})
       sql.addrow(${Bar = 3})
       Recorrer SQL
          SCN(Z:1, 1)
       Proximo
    Proximo
    ** 2 filas externas x 3 internas = 6
    assertEq(6, Val(Z:1))
})

test("anidado - break en el interno", ->{
    sql.addrow(${Foo = 1})
    sql.addrow(${Foo = 2})
    Recorrer SQL
       sql.addrow(${Bar = 1})
       sql.addrow(${Bar = 2})
       Recorrer SQL
           If 1=1
              Break
           EndIf
       Proximo
       ACT(A:1, 'foo')
    Proximo
    assertEq('foo', Val(A:1))
})

test("recorrer&i dentro de recorrer sql", ->{
    SetFilaActual(3)
    ACN(A:1,0)
    sql.addrow(${Foo = 1})
    sql.addrow(${Foo = 2})
    sql.addrow(${Foo = 3})
    sql.addrow(${Foo = 4})
    sql.addrow(${Foo = 5})
    sql.addrow(${Foo = 6})
    sql.addrow(${Foo = 7})
    sql.addrow(${Foo = 8})
    sql.addrow(${Foo = 9})
    sql.addrow(${Foo = 10})
    Recorrer SQL
       Recorrer&i 1, FAC
           SCN(A:1,1)
       Proximo
    Proximo
    assertEq(85, Val(A:1))
})
