#*********************************************************************
set ds_FechaAlta           = db.get_scalar("SELECT convert(datetime, Valor, 103) from "+dbo+".VARIABLES where Codigo='FECHASYS' ")
#*********************************************************************

def abm 'ICLTermSheet'      
    def grid
    Codigo: as 'Termsheet', Descripcion:, Monto:,  Utilizado:, FIngreso: as 'Fecha Ingreso'
    end
    def filter
    ' 1=1 order by FIngreso,Codigo --'
    end
    def key
        Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'     
          column          
            Codigo:       ,'Termsheet', small_text
            Descripcion:  ,,large_text
            Monto:        ,,numeric,'###,###,###,##0.00'
            FIngreso:     ,'Fecha Ingreso', date  
          column     
            Label1:       ,'',label
            Label2:       ,'',label
            Utilizado:    ,,numeric,'###,###,###,##0.00'
    end
    
    disable:
    FIngreso:,1=1;
    Utilizado:,1=1;
    
    before_show_create_dialog:  do
        if $.Alta()
            $.set_field FIngreso:,ds_FechaAlta
            $.set_field Monto:, 0
            $.set_field Utilizado:, 0
            $.hide(Utilizado:)
        endif
    end
#    before_show_dialog:  do
#        if $.Alta()
#            $.set_field FIngreso:,ds_FechaAlta
#            $.set_field Monto:, 0
#            $.set_field Utilizado:, 0
#            $.hide(Utilizado:)
#        endif
#    end

    required_fields: Codigo:, Descripcion:, Monto:

    validations: 
    Monto:, $.val(Monto: ) > 0,'El Monto debe ser mayor que 0.'

    validates_max_length_of:
        Codigo:, 6,true;
        Descripcion:, 30,true;
     validates_uniqueness_of: Codigo:
     upper_case_fields: Codigo:
     
     before_delete: do
        If $.Baja() 
            If $.val(Utilizado:) > 0 and ppl.NoVacio($.val(Utilizado:))
                $.Alert('No se pueden eliminar un Termsheet que esta utilizado.')
                false
            else
                true
            EndIf
        else
            true
        EndIf    
     end

     before_update: do
        If $.Modificacion() 
            If $.val(Monto:) < $.val(Utilizado:)
                $.Alert('Si se modifica el Monto no puede ser menor que el Utilizado.')
                false
            else
                true
            EndIf
        else
            true
        EndIf    
     end
end