def abm 'Paises'      
    def grid
    Codigo:, Nombre:, Alias:, NrExterno:
    end
    def key
        Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'       
            column          
                Codigo:         ,, small_text
                Nombre:         ,, large_text
                Alias:          ,, small_text                           
                CodPersonaFisica:      ,, small_text
                CodPersonaJuridica:    ,, small_text 
                Ganancias: , 'Ganancias', numeric,'0.00'
                NrExterno: , 'Numero Externo'              
             column
                NoCooperativo: ,          , check
                NomExterno:     ,'Nombre UIF', large_text
    end
    upper_case_fields: Codigo:
    validates_max_length_of:
       Codigo:,10,true; 
       Nombre:,50,true;
       Alias:,12,true;
       CodPersonaFisica:,11,true;
       CodPersonaJuridica:,11,true;
       NrExterno:, 20,true;              
    validates_uniqueness_of: Codigo:
end