set fsys = db.get_scalar("SELECT convert(datetime, getdate(), 103)  ")
set Codigo = ''
set Atrib = ''
def abm 'ConfigValExternos'
    def grid
    CodigoProceso:,Atributo:,Valor:,ValorSistemaExterno:, Leyenda:
    end
    def Key
    CodigoProceso:,Atributo:,Valor:,ValorSistemaExterno:, Leyenda:
    end
    def dialog
        tab 'General'
            column
                CodigoProceso:          ,          , small_text
                Atributo:               ,          , large_text
                Valor:                  ,          , large_text
                ValorSistemaExterno:    ,          , large_text
                Leyenda:                ,          , large_text
                FechaActualizacion:     ,          ,date, fsys
    end
    before_show_create_dialog: do
       $.set_field(FechaActualizacion:, fsys) 
       $.set_field(CodigoProceso:, Codigo) 
        $.set_field(Atributo:, Atrib) 
       $.disable(FechaActualizacion:)
    end 
    validates_max_length_of:
    CodigoProceso:, 12,true;
    Atributo:, 30 ,true;
    Valor:  , 50 ,true;
    ValorSistemaExterno:  , 30 ,true;
    Leyenda:  , 50 ,true;
    required_fields: CodigoProceso:, Atributo:, Valor:,ValorSistemaExterno:
    upper_case_fields: CodigoProceso:, Atributo:
    after_save:  do
        set Codigo = $.val(CodigoProceso:)
        set Atrib = $.val(Atributo:)
   
    end
    validates_uniqueness_of_set: CodigoProceso:,Atributo:,Valor:,ValorSistemaExterno:
    end