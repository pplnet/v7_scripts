def abm 'Instancias'      
    def grid
        Tabla:, Nombre:, NRinstancia:, Agregar:, Editar:, Borrar:, FWD:, REW: 
    end
    def key
            Tabla:, NRinstancia:
    end
    def dialog
        #**************************************************************************
        tab 'General'       
            column          
                Tabla: , , large_text
                Nombre: , ,large_text
                NRinstancia: , , numeric
                Agregar: , , large_text
                Editar: , , large_text
                Borrar: , , large_text
                FWD: , , large_text
                REW: , , large_text
    end
    upper_case_fields: Tabla:
end