#*********************************************************************************
#combos data sources.
set ds_TipoCupon           = "REN:Renta|RYA:Renta y Amortiz|AMO:Amortizacion|CAP:Capitalizacion|ZER:Zero Coupon|ZCA:Zero Coup.Am|"
set ds_Estado              = "PRO:Procesado|PEN:Pendiente|"
 
#*********************************************************************************
def abm 'AgendaCupones'
    def grid
      Especie:, NrCupon:, FechaCorte:, FechaPago:, TipoCupon:, Estado: 
    end
    def filter
      ' 1=1 order by Especie,Convert(int,NrCupon) --'
    end
    def key
      Especie:, NrCupon: 
    end
    def dialog
        #**************************************************************************
        tab 'General'
        column
            Especie:      ,      , autocomplete, 'Especies', 'Codigo,Nombre'   
            NrCupon:      ,      , extra_small_text
            FechaCorte:   ,      , date
            FechaPago:    ,      , date
            TNA:          ,      , numeric, '##0.00000000'
            PorRenta:     , '% Renta Periodo'         , numeric, '##0.00000000'
            PorAmCapital: , '% Am. Capital Periodo'   , numeric, '##0.00000000'
            PorAmIntCap:  , '% Am. Int. Cap. Periodo' , numeric, '##0.00000000'
            TasaCapInt:   , '% Cap. Interes Anual'    , numeric, '##0.00000000'
            PorRentaAnterior: , '% Renta Anterior'    , numeric, '##0.00000000'
            FechaCambioTasa:  , 'Fecha Cambio Tasa'   , date
            IntsCapitalizados:, 'Ints. Capitalizados' , numeric, '##0.00000000'
            FechaProceso: ,                           , date
            VTeoricoAnt:  ,                           , numeric, '##0.00000000'
            PrecioCupon:  ,                           , numeric, '##0.00000000'
        column
            TipoCupon: , 'Tipo', combo, ds_TipoCupon
            Estado: ,          , combo, ds_Estado
            Label1:,'',label
            FechaPagoOriginal: , 'F. Pago Orig.'      , date
    end
    upper_case_fields: Especie:
    required_fields: Especie:, TipoCupon:, Estado:
    
end