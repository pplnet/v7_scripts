#*********************************************************************************
def abm 'ConceptosBCRA'
   def grid
    Codigo:,Descripcion:,Alias1:,Alias2:,Alias3:
   end
   def key
   Codigo:, Descripcion:
   end
       def dialog
        #**************************************************************************
        tab 'General'       
         column          
            Codigo:,,
            Descripcion:,,
            Alias1:,,
            Alias2:,,
            Alias3:,,
    end
    upper_case_fields: Codigo:
    validates_max_length_of:
       Codigo:,                 6 ,true;
       Descripcion:,            40,true;    
       Alias1:,                 15,true;
       Alias2:,                 15,true;
       Alias3:,                 15,true;
    validates_uniqueness_of: Codigo:
end