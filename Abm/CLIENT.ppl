#*********************************************************************************
#combos data sources.
set ds_Status              = "HAB:Habilitado|DES:Deshabilitado|JER:Jerarquia|"
set ds_Sector              = "IND:Industria|COM:Comercio|BAN:Banca|PUB:Publico|STA:Staff|OTR:Otro|FCI:FCI|"
#set ds_CategCliente        = ppl.SQLSet("SELECT  rtrim(Codigo)+':'+rtrim(Sector)+' - '+rtrim(Descripcion) from "+dbo+".CATEGORIACLIENTES  ")
set ds_CategCliente        = "CAH:C.Ahorro|ABO:Ag.Bolsa|AME:Ag.Mercado|CFI:Cia Fin|FON:Fondo|BAN:Banco|OTR:Otro"
set ds_TipoSucursal        = "CMA:Casa Matriz|SUC:Sucursal|SUB:Subsidiaria|GOB:Gobierno|IND:Individual|SOC:Sociedad|TRU:Trust|NA:N/A|"
set ds_CatPrestamosBCRA    = "NOR:Normal|RPO:Riesgo Potencial|CPR:Con Problemas|IRR:Irrecuperables|IRA:Irrecuperables (A2440)|"
set ds_LiqHabitual         = "STD:Estandar|CLI:Contra Acr.Cliente|PRO:Contra Acr.Propia|"
set ds_TipoIngBru          = "EXE:Exento|CM:Conv.Multilateral|BA:Bs.As.|"
set ds_TipoInscripcion     = "CIT:CUIT|CIL:CUIL|CDI:CDI|CNR:CNR|CNA:Caj.Nac.Valores"
set ds_CondicionIVA        = "INS:Inscripto|NOI:No Inscripto|NO5:No inscripto Adic. 50%|NOR:No Alcanzado|EXE:Exento|GRA:Gran Consumidor|FIN:Consumidor Final|MON:MonoTributista|NOC:No Categorizado|OTR:Otro|"
set ds_Ganancias           = "INS:Inscripto|NOI:No Insc.|EXE:Exento|NOR:No Resid.|NOA:No Alcanzado|MON:Monotributista|OTR:Otro|"
set ds_Balance             = "|MEN:Mensual|SEM:Semestral|ANU:Anual|"
set ds_TipoDocum           = "CI:CI|DNI:DNI|LE:LE|LC:LC|PAS:Pasaporte|CIP:C.I.Provincial|CUI:CUIT|GCE:Grupo Crediticio|CMG:Certif. de Migracion|OTR:Otro|"
set ds_EstadoCivil         = "SOL:Soltero|CAS:Casado|DIV:Divorciado|VIU:Viudo|"
set ds_Sexo                = "MAS:Masculino|FEM:Femenino|"
set ds_Estudios            = "PRI:Primario|SEC:Secundario|UNI:Universitario|OTR:Otro|"
set ds_TipoActividad       = "RDE:R.Dependencia|CTA:Ctapropista|NOT:NoTrabaja|"
set ds_ExperienciaInv      = "001:Nivel 1|002:Nivel 2|003:Nivel 3|004:Nivel 4|005:Nivel 5|"
set ds_SexoConyuge         = "MAS:Masculino|FEM:Femenino|"
set ds_Vivienda            = "PRO:Propia|ALQ:Alquilada|OTR:Otro|"
set ds_Persona             = "NO:Juridica|SI:Fisica|"
set ds_Inscripcion         = "COM:Reg.Pub.Comercio|JUS:Ins.Gen.Justicia|"
set ds_Sellos              = "NOA:No Alcanzado|ALC:Alcanzado|NOR:No Residente"
set ds_Res3337             = "NO:No Corresponde|SI:Comprendido|EX:Excluido"
 
#*********************************************************************************
def abm 'Clientes'
   def grid
       Jerarquia:, Codigo:, RazonSocial:, NrCuenta: 
   end
   def user_filter
       "Habilit", "Status in ('HAB','JER') or Substr(Jerarquia,1,3) Not in ('002','003','004') "
   end
   def key
       Jerarquia:, Codigo:
   end
   
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia: , 'Jerarquia',
             Codigo: , 'Codigo', small_text
             NrCuenta: ,          , 
             RazonSocial: , 'Razon Social', extra_large_text
             Direccion: , 'Direccion', extra_large_text
             Localidad: ,          , large_text
             CodigoPostal: , 'Codigo Postal', large_text
             Provincia: , 'Provincia', autocomplete, 'Provincias', 'Codigo,Nombre'             
             PaisDir: , 'Pais', autocomplete, 'Paises', 'Codigo,Nombre' 
             Telefono: ,          , large_text
             Fax: ,          , large_text
             DireccionEmail: , 'Direccion EMail', extra_large_text
             Limite: , 'Limite Credito', numeric
          column
             Bcuelga: , 'Depende del anterior' , check
             Status: ,          , combo, ds_Status
             FecDeshabilitacion: , 'Fes. Deshab.' , date
       #**************************************************************************
       tab 'Datos'
          column
             NrMAE: ,          , small_text
             FIngreso: , 'Fecha Ingreso', date
             CodComitente: , 'Cod.Comitente', text
             NrAgenteBolsa: , 'Nr.Agente Bolsa', extra_small_text
             DeposDelComitente: , 'Depos del Comit', extra_small_text
             CodDepCajaValores: , 'Cod Dep Caj Val' , text
             CodigoBCRA: , 'Codigo BCRA', numeric,'#########0'
             SectorBCRA: ,          ,
             ActividadBCRA: ,          , autocomplete, 'ActividadesBCRA', 'Codigo,Descripcion'
             OficialCuenta:,,autocomplete,'OficialesCuenta','Codigo,Descripcion'
          column
             Label2:,'Depositante',label
             EsDepositante: ,          , check
             CodigoDepositante:,      ,extra_small_text
             CategDepositante: , 'Categoria ', combo, ds_CategCliente
             Baux:,,
             CatPrestamosBCRA: , 'Cat.Prest BCRA', combo, ds_CatPrestamosBCRA
             AFJP: ,          , check
             ActComplementarias: ,          , check, NULL
             Vinculado: ,          , check
          column
             Sector: ,          , combo, ds_Sector
             TipoSucursal: , 'Tipo', combo, ds_TipoSucursal
         
       #**************************************************************************
       tab 'Preferencias'
          column
             BACRR: , 'CRR', small_text
             GCI: , 'GCI#', small_text
             CIS: , 'CIS#', text
             Responsable: ,          , autocomplete, 'Usuarios', 'Codigo,Nombre'
             PresentadoPor: , 'Presentado Por', large_text
             NrUnico: , 'Nr Unico', numeric,'#########0'
             TipoArancel: , 'Tipo Arancel', autocomplete, 'TiposArancel', 'Codigo,Descripcion'
             CodAS400: ,          , large_text
             
             Label1:,'Datos de correspondencia',label
             CARTAINSTRUCCION:,'Carta Instruccion del Cliente',check,
             CorrespDireccion:, 'Direccion', text
             CorrespLocalidad:, 'Localidad', small_text
             CorrespCodigoPostal:, 'Codigo Postal', text
             CorrespProvincia:, 'Provincia', autocomplete, 'Provincias', 'Codigo,Nombre'
             CorrespPais:, 'Pais', autocomplete, 'Paises', 'Codigo,Nombre'
             
          column
             Extracto: , 'Extracto'    , check
             FAXConfirmacion: , 'FAXConfirmacion' , check
             HabDerivados: , 'HabDerivados' , check
             HabFuturos: , 'HabFuturos' , check
             HabExtLocal: , 'Hab. Extrabustail Local' , check
             HabExtIntl: , 'Hab. Extrabustail Internac.' , check
             HabBurPiso: , 'Hab. Bursatil Piso' , check
             HabBurCont: , 'Hab. Bursatil Continuo' , check
             HabFinanciero: , 'Hab. Financiero' , check
             HabPrestamos: , 'Hab. Prestamos' , check
             HabFX: , 'HabFX' , check  
             Baux2:,,
             LiqHabitual: , 'Liquidacion', combo, ds_LiqHabitual  
       #**************************************************************************
       tab 'Impositivos'
          column
             CUIT: , , text
             FechaBal: , 'Fecha Balance' , date
             Patrimonio: , , numeric
             NrIngBrutos: , , 
             NrDNRP: , , 
             ImpuestosInternos: , 'Imp Internos' 
             RPC: , , numeric
             FExeGan: , 'F. Exen. Desde' , date
             FexeGanHasta:,'F. Exen. Hasta',date
             PorcExeGan:, '%Exenc. Ganan',numeric,'##0.00#########'
             DExe3337:,'Desde Exen.3337',date
             HExe3337:,'Hasta Exen.3337',date
             PORCEXE3337:,'%Exenc.3337',numeric,'##0.00#########'
             PORCINGBRU:,'%Ingr.Brutos',numeric,'##0.00#########'
             
          column  
             Res3125: , 'Res. 3125' , check
             AjusteIn: , 'Ajuste Inflacion' , check
             ImpuestoEEmp: , 'Impuesto Endeudamiento' , check
             GrupoEconomico: , 'Es Controlante' , check          
             CodGrupoEconomico: , 'Codigo', autocomplete, 'Controlantes', 'Codigo,RazonSocial'
             Sellos:,'Imp. Sellos',combo,ds_Sellos
             TIngBru: , 'Tipo Ing. Brutos' , combo, ds_TipoIngBru
             Res3337: , 'Res. 3337' , combo,ds_Res3337
             
          column
             TipoInscripcion: , 'Tipo Inscripcion' , combo, ds_TipoInscripcion
             CondicionIVA: , 'Condicion IVA' , combo, ds_CondicionIVA
             CondicionGan: , 'Ganancias' , combo, ds_Ganancias
             PeriodicidadBalance: , 'Balance' , combo, ds_Balance
       #**************************************************************************
       tab 'Caracteristicas'
          column
             Caracteristicas:,,autocomplete_ar_list,'Caracteristicas','Codigo,Descripcion'
             Productores:,,autocomplete_ar_list,'Usuarios','Codigo,Nombre'
             Perfiles:,,autocomplete_ar_list,'Perfiles','Codigo,Descripcion'
          column
             Tasa1:,,numeric
             Tasa2:,,numeric
             Tasa3:,,numeric
             Tasa4:,,numeric
             Tasa5:,,numeric
       tab 'Titulares'
          column
             Titulares:,,embeded_abm,"INTECL"
       #**************************************************************************
       tab 'Persona Fisica'
          column
             Persona: , 'Tipo', combo, ds_Persona
             Nacionalidad: ,          , autocomplete, 'Paises', 'Codigo,Nombre'
             NrDocum: , 'Documento', large_text
             FechaNacimiento: , 'Fecha Nac.', date
             CantHijos: ,          , numeric,'#########0'
             CantACargo: ,          , numeric,'#########0'
             Ocupacion: ,          , large_text
             Cargo: ,          , large_text
             Ingresos: ,          , numeric
             NetWorth: ,          , numeric
             NyAConyuge: ,          , large_text
             FNacConyuge: ,          , 
             OcupConyuge: ,          , large_text
             IngrConyuge: ,          , numeric
          column
             Sexo: ,          , combo, ds_Sexo
             Estudios: ,          , combo, ds_Estudios
             SexoConyuge: ,          , combo, ds_SexoConyuge
             EstadoCivil: , 'Estado', combo, ds_EstadoCivil
             Vivienda: ,          , combo, ds_Vivienda
          column
             TipoDocum: , 'Tipo Documento', combo, ds_TipoDocum
             ExperienciaInv: , 'Exp. Inversion', combo, ds_ExperienciaInv
             TipoActividad: ,          , combo, ds_TipoActividad
       #**************************************************************************
       tab 'Variables'
          column
             Valor1: ,          , numeric
             Valor2: ,          , numeric
             Valor3: ,          , numeric
             Valor4: ,          , numeric
             Valor5: ,          , numeric
             Valor6: ,          , numeric
             Valor7: ,          , numeric
             Valor8: ,          , numeric
             Valor9: ,          , numeric
             Valor10: ,          , numeric
          column
             Fecha1: ,          , date
             Fecha2: ,          , date
             Fecha3: ,          , date
             Fecha4: ,          , date
             Fecha5: ,          , date
             Fecha6: ,          , date
             Fecha7: ,          , date
             Fecha8: ,          , date
             Fecha9: ,          , date
             Fecha10: ,          , date
           column
             Alias1: ,          , large_text              
             Alias2: ,          , large_text
             Alias3: ,          , large_text
             Alias4: ,          , large_text
             Alias5: ,          , large_text
             Alias6: ,          , large_text
             Alias7: ,          , large_text
             Alias8: ,          , large_text
             Alias9: ,          , large_text
             Alias10: ,          , large_text
       #**************************************************************************
       tab 'Inscripcion'
          column
             NroInsc: , 'Nr.Inscripcion', small_text
             Libro: ,          , extra_small_text
             Folio: ,          , small_text
             Tomo: ,          , extra_small_text
             FechaInsc: , 'Fecha Inscr', date
             PaisInsc: , 'Pais Inscr.', autocomplete, 'Paises', 'Codigo,Nombre'
          column
             Inscripcion: ,          , combo, ds_Inscripcion
       #**************************************************************************
       tab 'Observaciones'
          column
             Observaciones: ,          , full_tab_text
   end
   
        
#   when_change:
#      Status:, $.toggle_enabled(FecDeshabilitacion:,val(Status:)='DES')
#   when_change:
#      Persona:, $.toggle_enabled(Nacionalidad:,NrDocum:,FechaNacimiento:,CantHijos:,CantACargo:,Ocupacion:,Cargo:,Ingresos:,NetWorth:,NyAConyuge:,FNacConyuge:,OcupConyuge:,IngrConyuge:,val(Persona:)='SI')
   disable:
   Jerarquia:,1=1,
   CategDepositante:,
   CodigoDepositante:;
   # Esto hace que no el campo no se grabe.
   do_not_map: 
   Bcuelga:,Baux:,Baux2:;

   when_change: Bcuelga: do
       if $.Alta()
           set jerRef = $.val(sender.JERARQUIA)
           $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('CLIENTES', jerRef, $.val Bcuelga: = 'SI')
       endif
   end
   
   when_change: GrupoEconomico: do
        If $.val GrupoEconomico: = 'SI'
            $.Enable(CodGrupoEconomico:)
        Else
            $.disable(CodGrupoEconomico:)
        Endif
   end
   
   when_change: EsDepositante: do
        If $.val EsDepositante: = 'SI'
            $.Enable(CategDepositante:,CodigoDepositante:)
        Else
            $.disable(CategDepositante:,CodigoDepositante:)
        Endif
   end

   when_change: Persona: do 
       $.enable Nacionalidad: ,NrDocum: ,FechaNacimiento: ,CantHijos: ,CantACargo: ,Ocupacion: ,Cargo: ,
                Ingresos: ,NetWorth: ,NyAConyuge: ,FNacConyuge: ,OcupConyuge: ,IngrConyuge: ,Sexo: ,
                Estudios: ,SexoConyuge: ,EstadoCivil: ,Vivienda: ,TipoDocum: ,ExperienciaInv: ,TipoActividad: 
       if($.val (Persona:) = 'NO')
          $.disable(Nacionalidad: ,NrDocum: ,FechaNacimiento: ,CantHijos: ,CantACargo: ,Ocupacion: ,Cargo: ,
                    Ingresos: ,NetWorth: ,NyAConyuge: ,FNacConyuge: ,OcupConyuge: ,IngrConyuge: ,Sexo: ,
                    Estudios: ,SexoConyuge: ,EstadoCivil: ,Vivienda: ,TipoDocum: ,ExperienciaInv: ,TipoActividad: )
       end
   end 
    
#   before_show_dialog: do
#        If $.Alta() OR ( $.Modificacion() AND $.val EsDepositante: = 'NO' )
#            $.disable(CategDepositante:,CodigoDepositante:)
#        Endif
#   end
   
   before_show_create_dialog:  do
       $.SetField(ActComplementarias:,'null')
       if $.Alta()
           # Se muestra solo en el alta
           $.show(Bcuelga:)
           set jerRef = $.val(sender.JERARQUIA)
           $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('CLIENTES', jerRef, $.val Bcuelga: = 'SI')
       endif
   end

    hide_fields: 
        Bcuelga:,Baux:,Baux2:;
        
    upper_case_fields: Codigo:
    validates_uniqueness_of: Codigo:, Jerarquia:

    
end