#*********************************************************************************
#combos data sources.
set ds_Status              = "HAB:Habilitado|DES:Deshabilitado|"
set ds_Sector              = "IND:Industria|COM:Comercio|BAN:Banca|PUB:Publico|STA:Staff|OTR:Otro|"
set ds_CategCliente        = ppl.SQLSet("SELECT  rtrim(Codigo)+':'+rtrim(Sector)+' - '+rtrim(Descripcion) from "+dbo+".CATEGORIACLIENTES  ")
set ds_TipoSucursal        = "CMA:Casa Matriz|SUC:Sucursal|SUB:Subsidiaria|GOB:Gobierno|IND:Individual|SOC:Sociedad|TRU:Trust|NA:N/A|"
set ds_CatPrestamosBCRA    = "NOR:Normal|RPO:Riesgo Bajo|CPR:Riesgo Medio|IRR:Riesgo Alto|IRA:Irrecuperable|"
set ds_LiqHabitual         = "STD:Estandar|CLI:Contra Acr.Cliente|PRO:Contra Acr.Propia|"
set ds_TipoIngBru          = "EXE:Exento|CM:Conv.Multilateral|BA:Bs.As.|"
set ds_Balance             = "|MEN:Mensual|SEM:Semestral|ANU:Anual|"
set ds_Sexo                = "MAS:Masculino|FEM:Femenino|"
set ds_Estudios            = "PRI:Primario|SEC:Secundario|UNI:Universitario|OTR:Otro|"
set ds_TipoActividad       = "RDE:R.Dependencia|CTA:Ctapropista|NOT:NoTrabaja|"
set ds_ExperienciaInv      = "001:Nivel 1|002:Nivel 2|003:Nivel 3|004:Nivel 4|005:Nivel 5|"
set ds_SexoConyuge         = "MAS:Masculino|FEM:Femenino|"
set ds_Vivienda            = "PRO:Propia|ALQ:Alquilada|OTR:Otro|"
set ds_Persona             = "SI:Fisica|NO:Juridica|"
set ds_Inscripcion         = "COM:Reg.Pub.Comercio|JUS:Ins.Gen.Justicia|"
set ds_PerfilInv           = " |Conservador|Moderado|Arriesgado|Calificado|"


#*********************************************************************************
#combos data sources.
%%ifdef CMF
    set ds_TipoInscripcion     = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'TIPOINSCRIPCION' ")
    set ds_CondicionIVA        = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'CONDICIONIVA' ")
    set ds_TipoDocum           = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'TIPODOCUMENTO' ")
    set ds_Ganancias           = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'CONDICIONGAN' ")
    set ds_EstadoCivil         = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'ONLPER' AND Atributo = 'ESTADOCIVIL' ")
%%else
    set ds_TipoInscripcion     = "CDI:C.D.I|CIL:CUIL|CIT:CUIT|DNI:DNI|LE:LE|LC:LC|IFI:Instit. Fcieras|PAS:Pasaporte|CED:Cedula Mercosur|PJE:Pers Jur Extr|FCI:Fondo Comun De inv.|DEX:Documento Extranjero|FID:Fideicomiso|EIR:Nro. Registro IERIC|CIE:C.I.E|"
    set ds_CondicionIVA        = "INS:Inscripto|NOI:No Inscripto|NO5:No inscripto Adic. 50%|NOR:No Responsable|EXE:Exento|GRA:Gran Consumidor|FIN:Consumidor Final|MON:MonoTributista|NOC:No Categorizado|OTR:Otro|"
    set ds_Ganancias           = "INS:Inscripto|NOI:No Insc.|EXE:Exento|NOR:No Resid.|MON:Monotributista|OTR:Otro|"
    set ds_TipoDocum           = "CI:C.D.I|CIL:CUIL|CUI:CUIT|DNI:DNI|LE:LE|LC:LC|IFI:Instit. Fcieras|PAS:Pasaporte|CED:Cedula Mercosur|PJE:Pers Jur Extr|FCI:Fondo Comun De inv.|DEX:Documento Extranjero|FID:Fideicomiso|EIR:Nro. Registro IERIC|CIE:C.I.E|CIP:C.I.Provincial|GCE:Grupo Crediticio/Economico|OTR:Otro|"
    set ds_EstadoCivil         = "SOL:Soltero|CAS:Casado|DIV:Divorciado|VIU:Viudo|"
%%endif 


 

#*********************************************************************************
def abm 'Clientes'
#%%ifdef BIND
#   def grid
#   Jerarquia:, Codigo:, RazonSocial:, NrCuenta:, AliasBt: as 'AliasCore'
#   end
#%%else
   def grid
   Jerarquia:, Codigo:, RazonSocial:, NrCuenta:
   end
#%%endif   
   
   def key
       Jerarquia:, Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia: , 'Jerarquia',
             Codigo: , 'Codigo', small_text
             NrCuenta: ,          , 
             RazonSocial: , 'Razon Social', extra_large_text
             Direccion: , 'Direccion', extra_large_text
             Localidad: ,          , large_text
             CodigoPostal: , 'Codigo Postal', large_text
             Provincia: , 'Provincia', autocomplete, 'Provincias', 'Codigo,Nombre'             
             Pais: , 'Pais', autocomplete, 'Paises', 'Codigo,Nombre' 
             Telefono: ,          , large_text
             Fax: ,          , large_text
             Calle:,,extra_large_text
             Altura:,,extra_small_text
             Piso:,,extra_small_text
             Depto:,,extra_small_text
#             DireccionEmail: , '
             DireccionEmail: , 'Direccion EMail', extra_large_text
          column
             Bcuelga: , 'Depende del anterior' , check
             Status: ,          , combo, ds_Status
             TipoCliente:,'Tipo Cliente',autocomplete,'TiposCliente','Codigo,Descripcion'
#             FecDeshabilitacion: , 'Fes. Deshab.' , date
       #**************************************************************************
       tab 'Datos'
          column
             NrMAE: ,          , small_text
             NrBYMA: ,         , small_text
             NrRofex: ,        , small_text
             FechaApertura: , 'Fecha Apertura' , date
             FIngreso: , 'Fecha Ingreso', date
             CodComitente: , 'Cod.Comitente', text
             NrAgenteBolsa: , 'Nr.Agente Bolsa', extra_small_text
             DeposDelComitente: , 'Depos del Comit', extra_small_text
             CodDepCajaValores: , 'Cod Dep Caj Val' , text
             
             CodigoBCRA: , 'Codigo BCRA', numeric,'######'
             SectorBCRA: ,  'Sector BCRA'        ,
             ActividadBCRA: ,  'Cod.Act. BCRA'        , autocomplete, 'ActividadesBCRA', 'Codigo,Descripcion'
             ContactoEmpresa: , 'Contac. Empresa', text        
             ContactoDireccion: , 'Cont. Direccion', text
             ContactoLocalidad: , 'Cont. Localidad', text
             ContactoCP: , 'Contacto CP', text
             Limite: , 'Limite Credito', numeric
          column
             EsDepositante: ,          , check
             CategDepositante: , 'Categoria ', combo, ds_CategCliente
             CatPrestamosBCRA: , 'Cat.Prest BCRA', combo, ds_CatPrestamosBCRA
             CodigoCNV: , 'Codigo CNV', numeric,'#########0'
             CodigoMAV: , 'Codigo MAV', numeric,'#########0'
             AFJP: ,          , check
             ActComplementarias: ,          , check
             Vinculado: ,          , check
             OficialCuenta: ,          , autocomplete, 'OficialesCuenta', 'Codigo,Descripcion'             
             AuditorExterno: , , large_text
             ClasificacionSE:,'Clasif.Sist.Ext.', small_text
          column
             Sector: ,          , combo, ds_Sector
             TipoSucursal: , 'Tipo', combo, ds_TipoSucursal
             Label1:,'Perfil del Inversor',label
             PerfilInv:      , 'Perfil', combo, ds_PerfilInv
             FechaVtoTest:   , 'Fecha Test', date
             TestInv:        , 'Test Realizado',  check
       #**************************************************************************
       tab 'Preferencias'
          column
#             BACRR: , 'CRR', small_text
#             GCI: , 'GCI#', small_text
#             CIS: , 'CIS#', text
             Responsable: ,          , autocomplete, 'Usuarios', 'Codigo,Nombre'
             PresentadoPor: , 'Presentado Por', large_text
             NrUnico: , 'Nr Unico', numeric
             TipoArancel: , 'Tipo Arancel', autocomplete, 'TiposArancel', 'Codigo,Descripcion'
             Label:,'Datos de correspondencia',label
             CorrespDireccion:, 'Direccion', text
             CorrespLocalidad:, 'Localidad', small_text
             CorrespCodigoPostal:, 'Codigo Postal', text
             CorrespProvincia:, 'Provincia', autocomplete, 'Provincias', 'Codigo,Nombre'
             CorrespPais:, 'Pais', autocomplete, 'Paises', 'Codigo,Nombre'
             CorrespCalle:,'Calle',extra_large_text
             CorrespAltura:,'Altura',extra_small_text
             CorrespPiso:,'Piso',extra_small_text
             CorrespDepto:,'Depto',extra_small_text
#             CodAS400: ,          , large_text
          column
#             Extracto: , 'Extracto'    , check
#             FAXConfirmacion: , 'FAXConfirmacion' , check
#             HabDerivados: , 'HabDerivados' , check
             HabFuturos: , 'HabFuturos' , check
             HabExtLocal: , 'HabExtLocal' , check
             HabExtIntl: , 'HabExtInt' , check
#             HabBurPiso: , 'HabBurPiso' , check
#             HabBurCont: , 'HabBurCont' , check
             HabFinanciero: , 'HabFinanciero' , check
             HabPrestamos: , 'HabPrestamos' , check
             HabFX: , 'HabFX' , check  
#             LiqHabitual: , 'Liquidacion', combo, ds_LiqHabitual  
             
#             ContactoEmpresa: ,          , extra_large_text
#             OficialCuenta: ,          , autocomplete, 'OficialesCuenta', 'Codigo,Descripcion'
#             DomicilioContacto: ,          , extra_large_text
#             LocalidadContacto: ,          , extra_large_text
#             CodPostalContacto: ,          , extra_large_text
#             TelContacto: ,          , extra_large_text
#             NrMaeStr: , 'CRR', extra_small_text
#             Cash: ,          , check
#             OperaSisPort: ,          , check
#             OperaGlobCust: ,          , check
#             Equipo: , 'Equipo', autocomplete, 'Equipos', 'Codigo,Nombre,Responsable'
#             TipoCliente: , 'TipoCliente', autocomplete, 'TiposCliente', 'Codigo,Descripcion'
#             CargaCMS: ,          , check
       #**************************************************************************
       tab 'Impositivos'
          column
             CUIT: , , text
             FechaBal: , 'Fecha Balance' , date
             Patrimonio: , , numeric
             PatrimonioPesos: , 'Pat. Pesos', numeric, '#############0.00' 
             NrIngBrutos: , , 
             NrDNRP: , , 
             ImpuestosInternos: , 'Imp Internos' , 
             RPC: , , numeric ,'#############0.00'
             Valor3: , 'RPC Anterior' , numeric, '#############0.00'
             FExeGan: , 'F. Exe. Ganancias' , date
          column  
             GrupoEconomico: , 'Es Controlante' , check          
             CodGrupoEconomico: , 'Codigo', autocomplete, 'Controlantes', 'Codigo,RazonSocial'
             TIngBru: , 'Tipo Ing. Brutos' , combo, ds_TipoIngBru
             Res3125: , 'Res. 3125' , check
             Res3337: , 'Res. 3337' , check
             AjusteIn: , 'Ajuste Inflacion' , check
             ImpuestoEEmp: , 'Impuesto Endeudamiento' , check
            
          column
             TipoInscripcion: , 'Tipo Inscripcion' , combo, ds_TipoInscripcion
             CondicionIVA: , 'Condicion IVA' , combo, ds_CondicionIVA
             CondicionGan: , 'Ganancias' , combo, ds_Ganancias
             PeriodicidadBalance: , 'Balance' , combo, ds_Balance
             
#             ExIVA: ,          , check
#             PorcExIVA: , '%Exclusion IVA', numeric
#             FechaDesdeExIVAPer: , 'F.desde Excl IVA', 
#             FechaHastaExIVAPer: , 'F.hasta Excl IVA', 
       #**************************************************************************
       tab 'Titulares'
          column
             Titulares:,,embeded_abm,"INTECL"
       #**************************************************************************
       tab 'Persona Fisica'
          column
             Persona: , 'Tipo', combo, ds_Persona
             Nacionalidad: ,          , autocomplete, 'Paises', 'Codigo,Nombre'
             NrDocum: , 'Documento', large_text
#             FechaNacimiento: , 'Fecha Nac.', date
#             CantHijos: ,          , numeric
#             CantACargo: ,          , numeric
#             Ocupacion: ,          , large_text
#             Cargo: ,          , large_text
             Ingresos: ,          , numeric
             NetWorth: ,          , numeric
#             NyAConyuge: ,          , large_text
#             FNacConyuge: ,          , 
#             OcupConyuge: ,          , large_text
#             IngrConyuge: ,          , numeric
#          column
#             Sexo: ,          , combo, ds_Sexo
#             Estudios: ,          , combo, ds_Estudios
#             SexoConyuge: ,          , combo, ds_SexoConyuge
#             EstadoCivil: , 'Estado', combo, ds_EstadoCivil
#             Vivienda: ,          , combo, ds_Vivienda
          column
             TipoDocum: , 'Tipo Documento', combo, ds_TipoDocum
             ExperienciaInv: , 'Exp. Inversion', combo, ds_ExperienciaInv
             TipoActividad: ,          , combo, ds_TipoActividad
       #**************************************************************************
       tab 'Variables'
          column
             Valor1: ,          , numeric
             Valor2: ,          , numeric     
             Valor4: ,          , numeric
             Valor5: ,          , numeric
             Valor6: ,          , numeric
             Valor7: ,          , numeric
             Valor8: ,          , numeric
             Valor9: ,          , numeric
             Valor10: ,          , numeric
          column
             Fecha1: ,          , date
             Fecha2: ,          , date
             Fecha3: ,          , date
             Fecha4: ,          , date
             Fecha5: ,          , date
             Fecha6: ,          , date
             Fecha7: ,          , date
             Fecha8: ,          , date
             Fecha9: ,          , date
             Fecha10: ,          , date
           column
             Alias1: ,          , large_text              
             Alias2: ,          , large_text
             Alias3: ,          , large_text
             Alias4: ,          , large_text
             Alias5: ,          , large_text
             Alias6: ,          , large_text
             Alias7: ,          , large_text
             Alias8: ,          , large_text
             Alias9: ,          , large_text
             Alias10: ,          , large_text
             AliasBt:,'AliasCore',large_text
       #**************************************************************************
       tab 'Inscripcion'
          column
             NroInsc: , 'Nr.Inscripcion', small_text
             Libro: ,          , extra_small_text
             Folio: ,          , small_text
             Tomo: ,          , extra_small_text
             FechaInsc: , 'Fecha Inscr', date
             PaisInsc: , 'Pais Inscr.', autocomplete, 'Paises', 'Codigo,Nombre'
          column
             Inscripcion: ,          , combo, ds_Inscripcion
       #**************************************************************************
%%ifndef MLASA       
       tab 'Documentacion'
          column
            Documentacion:,,embeded_abm,"DOCUCL"
%%endif
       #**************************************************************************
       tab 'Observaciones'
          column
             Observaciones: ,          , full_tab_text
   end
   
        
#   when_change:
#      Status:, $.toggle_enabled(FecDeshabilitacion:,val(Status:)='DES')
#   when_change:
#      Persona:, $.toggle_enabled(Nacionalidad:,NrDocum:,FechaNacimiento:,CantHijos:,CantACargo:,Ocupacion:,Cargo:,Ingresos:,NetWorth:,NyAConyuge:,FNacConyuge:,OcupConyuge:,IngrConyuge:,val(Persona:)='SI')
   disable:
   Jerarquia:,1=1;
   # Esto hace que no el campo no se grabe.
    do_not_map: 
        Bcuelga:;
        
    when_change: Bcuelga: do
        if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('CLIENTES', jerRef, $.val Bcuelga: = 'SI')
        endif
    end

    before_show_create_dialog:  do
        if $.Alta()
            # Se muestra solo en el alta
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('CLIENTES', jerRef, $.val Bcuelga: = 'SI')
            $.set_field AliasBt:,""
            $.set_field NrMAE:,""
            $.set_field NrBYMA:,""
        endif
    end

#             DireccionEmail: , '   
    hide_fields: 
        Bcuelga:;
        Limite:;
        AFJP:;
        
    upper_case_fields: Codigo:
    validates_uniqueness_of: Codigo:, Jerarquia:
    validates_max_length_of:
        Calle:,60,true;
        Altura:,8,true;
        Piso:,2,true;
        Depto:,2,true;
        CorrespCalle:,60,true;
        CorrespAltura:,8,true;
        CorrespPiso:,2,true;
        CorrespDepto:,2,true;
    
end
