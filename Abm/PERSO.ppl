#*********************************************************************************
#combos data sources.
set ds_Sexo                = "MAS:Masculino|FEM:Femenino|X:No Binario|"
set ds_TipoPersona         = "SI:Fisica|NO:Juridica|"
set ds_Patrimonio          = "P1:   200.000 -    500.000|P2:   500.001 - 1.000.000|P3:1.000.001 - 2.000.000|P4:Mas de 2.000.000|"
set ds_Estudios            = "SEC:Secundario|UNI:Universitario|POS:Postgrado|"
set ds_CodigoPEP           = "SI:SI|NO:NO|"


%%ifdef CMF
    set ds_TipoPoder        = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'ONLPER' AND Atributo = 'TIPOPODERF' ")
    set ds_TipoDocumento    = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'TIPODOCUMENTO' ")
    set ds_EstadoCivil      = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'ONLPER' AND Atributo = 'ESTADOCIVIL' ")
    set ds_CondicionIVA     = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'CONDICIONIVA' ")
    set ds_Ganancias        = ppl.SQLSet("SELECT  rtrim(Valor)+':'+rtrim(Leyenda) from "+dbo+".CONFIGVALEXTERNOS where CodigoProceso = 'CLIONL' AND Atributo = 'CONDICIONGAN' ")
%%else
    set ds_EstadoCivil         = "SOL:Soltero|CAS:Casado|DIV:Divorciado|VIU:Viudo|CON:Concubinato|SD:Sin Datos|SEP:Separado"
    set ds_TipoPoder           = "TIT:Titular|AUT:Autorizado|APO:Apoderado|"
    set ds_TipoDocumento       = "CI:C.D.I|CIL:CUIL|CUI:CUIT|DNI:DNI|LE:LE|LC:LC|IFI:Instit. Fcieras|PAS:Pasaporte|CED:Cedula Mercosur|PJE:Pers Jur Extr|FCI:Fondo Comun De inv.|DEX:Documento Extranjero|FID:Fideicomiso|EIR:Nro. Registro IERIC|CIE:C.I.E|CIP:C.I.Provincial|GCE:Grupo Crediticio/Economico|OTR:Otro|"
    set ds_CondicionIVA        = "INS:Inscripto |NOI:No Insc.|EXE:Exento|CON:Cons.Final|MON:Monotributista|"
    set ds_Ganancias           = "INS:Inscripto |NOI:No Insc. |EXE:Exento   |NOR:No Residente|"
%%endif 
 
#*********************************************************************************
def abm 'Personas'
   def grid
       TipoDocumento:, NrDocumento:, Nombre:, Apellido: 
   end
   def key
       TipoDocumento:, NrDocumento: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Nombre: ,          , large_text
             Apellido: ,          , large_text
             TipoDocumento: , 'Tipo Documento', combo, ds_TipoDocumento
             NrDocumento: ,          , large_text
             Nacionalidad: ,          , large_text
             FechaNacimiento: , 'Fecha Nacimiento', date
             Direccion: , 'Direccion ', large_text
             Numero: ,          , small_text
             Piso: ,        , extra_small_text             
             Depto: ,'Departamento' , extra_small_text                          
             CodigoPostal: , 'Codigo Postal', small_text
             Telefono: , 'Telefono', small_text
             Localidad: ,          , large_text
             Provincia: ,          , autocomplete, 'Provincias', 'Codigo,Nombre'
         column
             Pais: ,'Pais'       , autocomplete, 'Paises', 'Codigo,Nombre'
             CondicionIVA: , 'Condicion', combo, ds_CondicionIVA
             Ganancias: ,          , combo, ds_Ganancias
             Cuit: , 'CUIT', large_text
             Cuil: , 'CUIL', large_text
             Sexo: ,          , combo, ds_Sexo
             EstadoCivil: , 'Estado', combo, ds_EstadoCivil
             TipoPoder: , 'Tipo Poder', combo, ds_TipoPoder             
             CodigoPEP: , 'Es PEP?',  combo, ds_CodigoPEP
#             Percepcion: ,          , check
             ActividadBCRA: , 'Actividad BCRA', autocomplete, 'ActividadesBCRA', 'Codigo,Descripcion'
#             EmpleadoGobierno: ,          , check
#             Piso: ,          , extra_small_text
#             Depto: , 'P', extra_small_text
#             NroPais: , 'NroPais', extra_small_text
#             TipoPersona: , 'Tipo', combo, ds_TipoPersona
#             Sector: , 'Sector ', extra_small_text
#             Torre: , 'Torre ', extra_small_text
#             Manzana: , 'Manzana ', extra_small_text
       #**************************************************************************
       tab 'Datos'
          column
#             Patrimonio: , 'Patrimonio', combo, ds_Patrimonio
             Empresa: ,          , large_text
#             Estudios: , 'Estudios', combo, ds_Estudios
#             OtrTpEnt: , 'Otro Tipo Ent ', large_text
#             PaisDoc: , 'Pais Doc ', autocomplete, 'Paises', 'Codigo,Nombre'
#             PaisNac: , 'Pais Nac ', autocomplete, 'Paises', 'Codigo,Nombre'
#             NroIdentResid: , 'NroIdentResid ', large_text
#             PaisRes: , 'Pais Resid ', autocomplete, 'Paises', 'Codigo,Nombre'
#             ProvExterior: , 'ProvExterior ', large_text
   end
   upper_case_fields: TipoDocumento:
    validates_max_length_of:
        Nombre:,30,true; 
        Direccion:,30,true
end