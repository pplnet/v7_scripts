
#*********************************************************************************

set ds_Jerarquia = ppl.SQLSet( "  Select DISTINCT  rtrim(Codigo)+':' +  trim(Codigo) + ' - ' + trim(Leyenda) FROM dbo.CLIENTES C inner join dbo.CONFIGVALEXTERNOS Con on C.Codigo = Con.Valor and Con.CodigoProceso = 'CLIONL' and Con.Atributo = 'Jerarquia'")

def abm 'PORENCAJETASAT'

#%%else      tambien darle sentencias
   def grid
    Porcentaje:, CodJerarquia: as 'Valor Encaje'
   end
#%%endif   
   
   def key
       CodJerarquia:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
          CodJerarquia: , 'Jerarquia' ,combo,ds_Jerarquia
          Porcentaje: , 'Valor Encaje', numeric
            
   end
   #   validates_uniqueness_of_set: CodJerarquia:
 end
   