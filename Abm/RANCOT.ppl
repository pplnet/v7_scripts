def abm 'RankingCotizaciones'
   def grid
   Codigo:, Descripcion:, Especie:, MercadoPlazos:
   end
   def key
       Codigo:
   end
   def dialog
        tab 'General' 
          column
             Codigo:        , 'Codigo:', small_text,'XXXXXXXX'
             Descripcion:   , 'Descripcion:', text
             Especie:      ,  'Especie', autocomplete, 'ESPECIES','Codigo,Nombre'
             MercadoPlazos: ,'Mercado+Plazo', autocomplete_ar_list, 'MercadoPlazo', 'Codigo,Descripcion'
   end
   
   upper_case_fields: Codigo:
   validates_max_length_of:
       Codigo:,8,true; 
       Descripcion:,40,true;
       Especie:,6,true;
       MercadoPlazos:,700,true;

   validations: 
        Codigo:, ppl.Vacio(ppl.SQL("Select 1 from RankingCotizaciones where Codigo = '"+$.val(Codigo:)+"'")) OR __action__ <> "A", 'Clave duplicada';
        Codigo:, ppl.NoVacio($.val(Codigo:)), 'El codigo no puede ser vacio';
        Descripcion:, ppl.NoVacio($.val(Descripcion:)), 'La descripcion no puede ser vacia';
        
   before_delete: do
        If $.Baja() 
           true
        else
            true
        EndIf
   end
   
   after_save:  do 
        set especie = $.val(Especie:)
        set codigo = $.val(Codigo:)
#        $.val($.EjecutarEvento('RAESPE', {Lista1:especie,String1:codigo}))
   end
   
   validates_uniqueness_of: Codigo:
end