#*********************************************************************************
# ABM de Clientes (demo) - Utiliza: before_create, before_delete, before_update,
# $.ToggleEnabled(), $.SetFields(), $.SetWhere(), $.InnerText(), $.Focus()
#*********************************************************************************
# Combos data sources
set ds_Status              = "HAB:Habilitado|DES:Deshabilitado|JER:Jerarquia|"
set ds_Sector              = "IND:Industria|COM:Comercio|BAN:Banca|PUB:Publico|STA:Staff|OTR:Otro|FCI:FCI|"
set ds_CategCliente        = "CAH:C.Ahorro|ABO:Ag.Bolsa|AME:Ag.Mercado|CFI:Cia Fin|FON:Fondo|BAN:Banco|OTR:Otro"
set ds_TipoSucursal        = "CMA:Casa Matriz|SUC:Sucursal|SUB:Subsidiaria|GOB:Gobierno|IND:Individual|SOC:Sociedad|TRU:Trust|NA:N/A|"
set ds_Persona             = "NO:Juridica|SI:Fisica|"
set ds_TipoDocum           = "CI:CI|DNI:DNI|LE:LE|LC:LC|PAS:Pasaporte|CIP:C.I.Provincial|CUI:CUIT|GCE:Grupo Crediticio|OTR:Otro|"
set ds_Sexo                = "MAS:Masculino|FEM:Femenino|"
set ds_EstadoCivil         = "SOL:Soltero|CAS:Casado|DIV:Divorciado|VIU:Viudo|"
set ds_ExperienciaInv      = "001:Nivel 1|002:Nivel 2|003:Nivel 3|004:Nivel 4|005:Nivel 5|"
set ds_CondicionIVA        = "INS:Inscripto|NOI:No Inscripto|EXE:Exento|GRA:Gran Consumidor|FIN:Consumidor Final|MON:MonoTributista|OTR:Otro|"
set dbo                    = "dbo"

#*********************************************************************************
def abm 'Clientes'
    def grid
        Codigo:, RazonSocial:, CUIT:, Status:, Sector:, Limite: as 'Limite Credito'
    end
    def filter
        ' 1=1 order by RazonSocial --'
    end
    def user_filter
        "Habilitados", "Status = 'HAB'"
        "Deshabilitados", "Status = 'DES'"
    end
    def key
        Codigo:
    end

    def dialog
        #**************************************************************************
        tab 'General'
            column
                Codigo:            , 'Codigo', small_text
                RazonSocial:       , 'Razon Social', extra_large_text
                CUIT:              , 'CUIT', text
                Direccion:         , 'Direccion', extra_large_text
                Localidad:         , , large_text
                CodigoPostal:      , 'Codigo Postal', large_text
                Provincia:         , 'Provincia', autocomplete, 'Provincias', 'Codigo,Nombre'
                Telefono:          , , large_text
                DireccionEmail:    , 'Email', extra_large_text
            column
                Status:            , , combo, ds_Status
                FecDeshabilitacion:, 'Fec. Deshab.', date
                Sector:            , , combo, ds_Sector
                TipoSucursal:      , 'Tipo', combo, ds_TipoSucursal
                Limite:            , 'Limite Credito', numeric, '###,###,###,##0.00'
                Responsable:       , , autocomplete, 'Usuarios', 'Codigo,Nombre'
        #**************************************************************************
        tab 'Datos Depositante'
            column
                EsDepositante:     , , check
                CodigoDepositante: , , extra_small_text
                CategDepositante:  , 'Categoria', combo, ds_CategCliente
            column
                CondicionIVA:      , 'Condicion IVA', combo, ds_CondicionIVA
                OficialCuenta:     , , autocomplete, 'OficialesCuenta', 'Codigo,Descripcion'
        #**************************************************************************
        tab 'Persona Fisica'
            column
                Persona:           , 'Tipo', combo, ds_Persona
                Nacionalidad:      , , autocomplete, 'Paises', 'Codigo,Nombre'
                NrDocum:           , 'Documento', large_text
                TipoDocum:         , 'Tipo Documento', combo, ds_TipoDocum
                FechaNacimiento:   , 'Fecha Nac.', date
                Sexo:              , , combo, ds_Sexo
                EstadoCivil:       , 'Estado Civil', combo, ds_EstadoCivil
                ExperienciaInv:    , 'Exp. Inversion', combo, ds_ExperienciaInv
            column
                Ocupacion:         , , large_text
                Cargo:             , , large_text
                Ingresos:          , , numeric
                NetWorth:          , , numeric
        #**************************************************************************
        tab 'Observaciones'
            column
                Observaciones:     , , full_tab_text
    end

    #*********************************************************************************
    # Campos y reglas estaticas
    #*********************************************************************************
    disable:
        CodigoDepositante:,;
        CategDepositante:,;
        FecDeshabilitacion:,1=1;

    required_fields: Codigo:, RazonSocial:, Status:
    upper_case_fields: Codigo:
    validates_uniqueness_of: Codigo:

    validates_max_length_of:
        Codigo:, 10, true;
        RazonSocial:, 80, true;
        CUIT:, 13, true;

    validations:
        Limite:, ppl.Vacio($.val(Limite:)) OR $.val(Limite:) >= 0, 'El limite de credito no puede ser negativo.';
        CUIT:, ppl.Vacio($.val(CUIT:)) OR ppl.Longitud($.val(CUIT:)) >= 11, 'El CUIT debe tener al menos 11 caracteres.';

    #*********************************************************************************
    # before_show_create_dialog: inicializa valores al crear
    #*********************************************************************************
    before_show_create_dialog: do
        $.set_field Status:, 'HAB'
        $.set_field Persona:, 'NO'
        $.set_field Limite:, 0
        $.Focus(Codigo:)
    end

    #*********************************************************************************
    # before_show_dialog: configura estado visual al abrir
    #*********************************************************************************
    before_show_dialog: do
        # Habilitar fecha de deshabilitacion solo si Status = DES
        $.ToggleEnabled(FecDeshabilitacion:, val(Status:)='DES')

        # Habilitar campos de depositante solo si EsDepositante = SI
        $.ToggleEnabled(CodigoDepositante:, CategDepositante:, val(EsDepositante:)='SI')

        # Habilitar campos de persona fisica solo si Persona = SI
        $.ToggleEnabled(Nacionalidad:, NrDocum:, TipoDocum:, FechaNacimiento:, Sexo:, EstadoCivil:, ExperienciaInv:, Ocupacion:, Cargo:, Ingresos:, NetWorth:, val(Persona:)='SI')

        # Filtrar oficial de cuenta segun sector del cliente
        set sec = $.val(Sector:)
        If ppl.NoVacio(sec)
            $.SetWhere(OficialCuenta:, "Sector = '" + sec + "' or Sector is null")
        EndIf
    end

    #*********************************************************************************
    # when_change: Status - alterna habilitacion de fecha y limpia campos
    #*********************************************************************************
    when_change: Status: do
        $.ToggleEnabled(FecDeshabilitacion:, val(Status:)='DES')

        If $.val(Status:) <> 'DES'
            # Limpiar fecha de deshabilitacion si ya no corresponde
            $.SetFields(FecDeshabilitacion:, '')
        Else
            $.Focus(FecDeshabilitacion:)
        EndIf
    end

    #*********************************************************************************
    # when_change: EsDepositante - alterna campos de depositante
    #*********************************************************************************
    when_change: EsDepositante: do
        $.ToggleEnabled(CodigoDepositante:, CategDepositante:, val(EsDepositante:)='SI')

        If $.val(EsDepositante:) <> 'SI'
            $.SetFields(CodigoDepositante:, CategDepositante:, '')
        Else
            $.Focus(CodigoDepositante:)
        EndIf
    end

    #*********************************************************************************
    # when_change: Persona - alterna campos de persona fisica
    #*********************************************************************************
    when_change: Persona: do
        $.ToggleEnabled(Nacionalidad:, NrDocum:, TipoDocum:, FechaNacimiento:, Sexo:, EstadoCivil:, ExperienciaInv:, Ocupacion:, Cargo:, Ingresos:, NetWorth:, val(Persona:)='SI')

        If $.val(Persona:) = 'NO'
            # Limpiar campos de persona fisica si cambia a Juridica
            $.SetFields(Nacionalidad:, NrDocum:, TipoDocum:, FechaNacimiento:, Sexo:, EstadoCivil:, ExperienciaInv:, Ocupacion:, Cargo:, '')
            $.SetFields(Ingresos:, NetWorth:, '')
        EndIf
    end

    #*********************************************************************************
    # when_change: Sector - filtra oficiales de cuenta por sector
    #*********************************************************************************
    when_change: Sector: do
        set sec = $.val(Sector:)
        If ppl.NoVacio(sec)
            $.SetWhere(OficialCuenta:, "Sector = '" + sec + "' or Sector is null")
        Else
            $.SetWhere(OficialCuenta:, '1=1')
        EndIf
    end

    #*********************************************************************************
    # when_change: Provincia - muestra el nombre legible de la provincia
    #*********************************************************************************
    when_change: Provincia: do
        set nombreProv = $.InnerText(Provincia:)
        If ppl.NoVacio(nombreProv)
            $.set_field Observaciones:, 'Cliente de ' + nombreProv
        EndIf
    end

    #*********************************************************************************
    # before_create: validaciones previas al alta
    #*********************************************************************************
    before_create: do
        If $.Alta()
            # Verificar que el CUIT no este repetido en otro cliente
            set cuit = $.val(CUIT:)
            If ppl.NoVacio(cuit)
                set existente = ppl.SQL("Select Codigo from "+dbo+".Clientes where CUIT = '"+cuit+"' and Codigo <> '"+$.val(Codigo:)+"'")
                If ppl.NoVacio(existente)
                    $.Alert('Ya existe un cliente con el CUIT ' + cuit + ' (Codigo: ' + existente + ').')
                    $.Focus(CUIT:)
                    false
                Else
                    true
                EndIf
            Else
                true
            EndIf
        Else
            true
        EndIf
    end

    #*********************************************************************************
    # before_update: validaciones previas a la modificacion
    #*********************************************************************************
    before_update: do
        If $.Modificacion()
            # Si se deshabilitó, exigir fecha de deshabilitacion
            If $.val(Status:) = 'DES' and ppl.Vacio($.val(FecDeshabilitacion:))
                $.Alert('Debe ingresar la fecha de deshabilitacion.')
                $.Focus(FecDeshabilitacion:)
                false
            Else
                # Si es persona fisica, exigir documento
                If $.val(Persona:) = 'SI' and ppl.Vacio($.val(NrDocum:))
                    $.Alert('Debe ingresar el numero de documento para personas fisicas.')
                    $.Focus(NrDocum:)
                    false
                Else
                    true
                EndIf
            EndIf
        Else
            true
        EndIf
    end

    #*********************************************************************************
    # before_delete: validaciones previas a la baja
    #*********************************************************************************
    before_delete: do
        If $.Baja()
            # No permitir eliminar clientes con limite de credito utilizado
            set saldo = ppl.SQL("Select sum(Saldo) from "+dbo+".CuentasCorrientes where Cliente = '"+$.val(Codigo:)+"'")
            If ppl.NoVacio(saldo) and saldo > 0
                $.Alert('No se puede eliminar el cliente porque tiene saldo pendiente en cuenta corriente.')
                false
            Else
                # No permitir eliminar clientes habilitados sin deshabilitarlos primero
                If $.val(Status:) = 'HAB'
                    $.Alert('Debe deshabilitir el cliente antes de eliminarlo.')
                    false
                Else
                    true
                EndIf
            EndIf
        Else
            true
        EndIf
    end

end
