def abm "USRVEHICULO"
    def grid
        Codigo:,
        Vehiculo:,
        UDN:,
        CentroCosto:,
        Sector:,
        Sucursal:,
        Tenor1:,
        Tenor2:,
        Tenor3:,
        Tenor4:,
        Tenor5:,
        LimiteEAR:,
        LimiteVolumen:,
        LimiteDiaEAR:,
        LimiteDiaVolumen:,
        DiasValorAutoriz:       
    end
   
    def filter
        "Codigo = '" + $.parent('Codigo') + "'"
    end
    
    def key
        Vehiculo:, Codigo:
    end
    def dialog          
       tab 'General'
        column
            Codigo:,
            Vehiculo:,, autocomplete, 'Vehiculos', 'Codigo,Descripcion'
            UDN:,, autocomplete, 'UDNs', 'Codigo,Descripcion'
            CentroCosto:,, autocomplete, 'CentrosCosto', 'Codigo,Descripcion'
            Sector:,, autocomplete, 'Sectores', 'Codigo,Descripcion'
            Sucursal:,, autocomplete, 'Sucursales', 'Codigo,Nombre'
        tab 'Valores'
        column
            Tenor1:,,numeric,'0'
            Tenor2:,,numeric,'0'
            Tenor3:,,numeric,'0'
            Tenor4:,,numeric,'0'
            Tenor5:,,numeric,'0'
            LimiteEAR:,,numeric,'0.0000'
            LimiteVolumen:,,numeric,'0.0000'
            LimiteDiaEAR:,,numeric,'0.0000'
            LimiteDiaVolumen:,'Lim Dia Vol',numeric,'0.0000'
            DiasValorAutoriz:,'Dias Val Autoriz',numeric,'0'
    end
    hide_fields:
        Codigo:;
    validates_max_length_of:
        Vehiculo:,10 ,true;
        UDN:,10 ,true;
        CentroCosto:,10 ,true;
        Sector:,10 ,true;
        Sucursal:,6 ,true;
        Tenor1:,10 ,true;
        Tenor2:,10 ,true;
        Tenor3:,10 ,true;
        Tenor4:,10 ,true;
        Tenor5:,10 ,true;
        LimiteEAR:,10 ,true;
        LimiteVolumen:,10 ,true;
        LimiteDiaEAR:,10 ,true;
        LimiteDiaVolumen:,10 ,true;
        DiasValorAutoriz:,10 ,true;
    before_show_create_dialog: do
          $.set_field  (Codigo:, $.parent("Codigo"))
   end
end

