#*********************************************************************************
#combos data sources.
set ds_Status              = "OPE:Operativo|BLO:Bloqueado|ENT:En Tramite|CAN:Cancelado|"
set ds_ActPas              = "ACT:Activo|PAS:Pasivo|TOD:Todos|"
set ds_CarteraBCRA         = "AAA:A|BBB:B|CCC:C|"
 
#*********************************************************************************
def abm 'LimAsignados'
   def grid
       # Se reemplaza por la clave que tiene la tabla
       # Cliente:, Especie:, Limite:, Vehiculo:, Facility:,Tenor:,FVencimiento:,Monto: 
       Cliente:, Especie:, Limite:, Vehiculo:, Book: ,Responsable: ,TipoPosicion: ,Producto: ,GrupoEspecie: ,TipoNegocio: ,Trader: ,Monto: 
   end
   def filter
       "Where Limite in (Select Codigo from dbo.TIPOSLIMITE Where Clase = 'P')"
   end
   def key
   # Se reemplaza por la clave que tiene la tabla
   #    Cliente:, Especie:, Limite:, Vehiculo:, Facility:,Tenor:,FVencimiento:,Monto: 
       Cliente:, Especie:, Limite:, Vehiculo:, Book: ,Responsable: ,TipoPosicion: ,Producto: ,GrupoEspecie: ,TipoNegocio: ,Trader: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Limite: ,          , autocomplete, 'TiposLimite', 'Codigo,Descripcion',, "Clase = 'P'"
             Cliente: ,          , autocomplete, 'Clientes', 'Codigo,RazonSocial'
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             Facility: ,          , 
             Tenor: ,          , numeric
             FVencimiento: ,          , date
             FAsignacion: ,          ,  date
             FRevision: ,          ,    date
             Monto: ,          , numeric,'##,###,###,##0.00'
#             PlazoDesde: , 'PlazoDesde', numeric
#             PlazoHasta: , 'PlazoHasta', numeric
#             MontoRealocado: , 'MontoRealocado', numeric
#             MontoBloqueado: , 'MontoBloqueado', numeric
#             MontoAmpliado: , 'MontoAmpliado', numeric
#             MontoOperativo: , 'MontoOperativo', numeric
#             Commited: ,          , check
#             Status: , 'Status', combo, ds_Status
#             ActPas: , 'Activo/Pasivo', combo, ds_ActPas
       #**************************************************************************
       tab 'Codigos'
          column
             Vehiculo: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             Operador: ,          , autocomplete, 'Usuarios', 'Codigo,Nombre'
             Book: ,          , autocomplete, 'Books', 'Codigo,Descripcion'
             Trader: , 'Trader', autocomplete, 'Usuarios', 'Codigo,Nombre'
             TipoNegocio: , 'TipoNegocio', autocomplete, 'TiposNegocio', 'Codigo,Descripcion'
             Responsable: , 'Responsable', autocomplete, 'Responsables', 'Codigo,Descripcion'
             TipoPosicion: , 'TipoPosicion', autocomplete, 'TiposPosicion', 'Codigo,Descripcion'
             Producto: , 'Producto', autocomplete, 'Productos', 'Codigo,Descripcion'
             GrupoEspecie: , 'GrupoEspecie', autocomplete, 'GruposEspecie', 'Codigo,Descripcion'
             CarteraBCRA: , 'CarteraBCRA', combo, ds_CarteraBCRA
#             SubLimite: , 'SubLimite ', autocomplete, 'SubLimites', 'Codigo,Descripcion'
#             Cartera: , 'CarteraBCRA ', autocomplete, 'Carteras', 'Codigo,Descripcion'
   end
   before_show_create_dialog: do
      set today = db.get_scalar("Select GetDate()")
      if $.Alta()
         $.set_field(FVencimiento:, today)
         $.set_field(FAsignacion:, today)
         $.set_field(FRevision:, today)
         endif
      end
   upper_case_fields: Cliente:, Especie:
   required_fields: Cliente:, FVencimiento:
   validates_uniqueness_of_set: Cliente:, Especie:, Limite:, Vehiculo:, Book:,Responsable:,TipoPosicion:,Producto:,GrupoEspecie:,TipoNegocio:,Trader:
  
end

