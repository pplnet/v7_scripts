def abm 'TiposNegocio'        
    def grid
        Codigo:, Descripcion:, Mercado:, PorPreset:
    end
    def key
            Codigo:
    end
    def dialog
        #**************************************************************************
        tab 'General'       
            column          
                Codigo: ,, small_text
                Descripcion: ,,large_text
                Mercado: ,, autocomplete, 'Mercados', 'Codigo,Descripcion'
                PorPreset: ,, numeric,'##0.00'
    end
    upper_case_fields: Codigo:
end