             MinGraficar: , 'Min.Graficar', numeric,'########0.0000000'
             MaxSupuesto: , 'Max Supuesto', numeric,'########0.0000000'
             MinSupuesto: , 'Min.Supuesto', numeric,'########0.0000000'
             Intervalos:  ,               , numeric,'########0.0000000'
