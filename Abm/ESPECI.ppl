#combos data sources.
set ds_Status              = "HAB:Habilitada|DES:Deshabilitada|JER:Jerarquia|"
set ds_InteresesC          = "DIR:Dirty|CLE:Clean|"
set ds_CotizaMAE           = "DIR:Dirty|CLE:Clean|"
set ds_DiasMes             = "30:30|REA:Real|30E:30E|31E:30E+1|"
set ds_DiasAnio            = "360:360|365:365|REA:Real|"
set ds_Tipo                = "PUB:Publico|PRI:Privado|ONE:O.N.|FON:Fondo|MON:Moneda|OTR:Otro|"
#set ds_Tipo                = ppl.SQLSet("SELECT  rtrim(Codigo)+':'+rtrim(Descripcion) from "+dbo+".TIPOESPECIE ")
set ds_TipoEC              = "ESC:Escritural|CAR:Cartular|"
set ds_IVA                 = "EXE:Exento|IVA:IVA|RNI:IVA RNI|"
set ds_FormaCalculoInts    = "IND:Indice|TAS:Tasa|"
set ds_Security            =  "0:I|1:II|2:III|3:Otro|" 

set today = db.get_scalar("SELECT TO_CHAR(SYSDATE, 'DD-MM-YYYY HH24:MI:SS') FROM DUAL") 

#set RespMessage = 10

#*********************************************************************************
def abm 'Especies'
   def grid
       Jerarquia:, Codigo:, Nombre:, Extendido:, ISIN: 
   end
   def key
       Jerarquia:, Codigo:
   end
   
