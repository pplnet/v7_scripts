#combos data sources.
set ds_CondicionIVA        = "INS:Inscripto|NOI:No Inscripto|NO5:No inscripto Adic. 50%|NOR:No Responsable|EXE:Exento|GRA:Gran Consumidor|FIN:Consumidor Final|MON:MonoTributista|NOC:No Categorizado|OTR:Otro|"

def abm "TIPOSIMPUESTO1"
    def grid
        Codigo:,
        Item:,
        FechaDesde:,
        FechaHasta:,
        Minimo:,
        Maximo:,
        Porcentaje:,
        MontoFijo:,
        DesdeMonto:,
        HastaMonto:,
        CategCliente:
    end
    def filter
        "Codigo = '" + $.parent('Codigo') + "'"
    end
    def key
        Codigo:, Item:
    end
    def dialog
        #**************************************************************************
        tab "General"
            column
                Item: ,, numeric, '###0'
                FechaDesde: ,'Fecha Desde', date
                FechaHasta: ,'Fecha Hasta', date
                Minimo: ,          , numeric,'##,###,###,##0.00'
                Maximo: ,          , numeric,'##,###,###,##0.00'
                Porcentaje: ,      , numeric,'##0.0000'
                MontoFijo: ,       , numeric,'##,###,###,##0.00'
             column
                DesdeMonto: ,      , numeric,'##,###,###,##0.00'
                HastaMonto: ,      , numeric,'##,###,###,##0.00'
# FJL 23/09/25 - Para respetar las opciones de Clientes
#                CategCliente: ,    , numeric, '###0'
                CategCliente: ,    , combo, ds_CondicionIVA
                Codigo:,
                
    end
    disable_fields: Codigo:
     hide_fields: Codigo:;
     before_show_create_dialog: do
        $.set_field  (Codigo:, $.parent("Codigo"))
    end
    validates_uniqueness_of_set:  Codigo:, Item:
    
    
 end