set ds_Tipo                = "PUB:Publico|PRI:Privado|MON:Moneda|OTR:Otro|"
def abm 'TIPOESPECIE'
   def grid
       Codigo:, Descripcion:, Clasificacion:, DescUIF:
   end
   def key
        Codigo:, Descripcion:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text,'XXX'
             Descripcion: ,          , large_text
             Clasificacion: ,        , combo, ds_Tipo
             DescUIF: ,          , large_text
       #**************************************************************************
    
   end
       
   validates_uniqueness_of: Codigo:
end