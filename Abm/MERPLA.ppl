#*********************************************************************************
#combos data sources.
set ds_Plazo            = ":Todos|0:Contado|24:24Hs|48:48Hs|"
#*********************************************************************************

def abm 'MERCADOPLAZO'
   def grid
       Codigo:, Descripcion:, Mercado:, Plazo:
   end
   def key
       Codigo:
   end
   def dialog
        tab 'General' 
          column
             Codigo:        , 'Codigo:', small_text,'XXXXXXXX'
             Descripcion:   , 'Descripcion:', text
             Mercado:       ,'Mercado', autocomplete, 'Mercados', 'Codigo,Descripcion'
             Plazo:      ,'Plazo', combo,ds_Plazo
   end
   
   upper_case_fields: Codigo:
   validates_max_length_of:
       Codigo:,8,true; 
       Descripcion:,40,true;
       Mercado:,6,true;
       Plazo:,6,true;

   validations: 
   Codigo:, ppl.Vacio(ppl.SQL("Select 1 from MERCADOPLAZO where Codigo = '"+$.val(Codigo:)+"'")) OR __action__ <> "A", 'Clave duplicada';
        Codigo:, ppl.NoVacio($.val(Codigo:)), 'El codigo no puede ser vacio';
        Descripcion:, ppl.NoVacio($.val(Descripcion:)), 'La descripcion no puede ser vacia';
        
   before_delete: do
        If $.Baja() 
           true
        else
            true
        EndIf
   end
   
   after_save:  do 
        set codigo = $.val(Codigo:)
   end
   
   validates_uniqueness_of: Codigo:
end