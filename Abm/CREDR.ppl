#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'CRF'
   def grid
       Especie:, ContraEspecie:, Fecha:, Valor1:, Valor2:, Valor3: 
   end
   def key
       Especie:, ContraEspecie:, Fecha: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             ContraEspecie: , 'Contraespecie', autocomplete, 'Especies', 'Codigo,Nombre'
             Fecha: ,          , date
             Valor1: ,          , numeric
             Valor2: ,          , numeric
             Valor3: ,          , numeric
   end
   upper_case_fields: Especie:
end