#*********************************************************************************
# ABM embebido demo - Contactos de Clientes
# Hijo de CLIDMO (Clientes). Usa def fkey explicito para testear Path 1.
#*********************************************************************************

def abm 'ClientesContactos'
    def grid
        CodigoCliente:,
        NroContacto:,
        Nombre:,
        Telefono:,
        Email:,
        Cargo:
    end
    def filter
        "CodigoCliente = '" + $.parent('Codigo') + "'"
    end
    def key
        CodigoCliente:, NroContacto:
    end
    def fkey
        CodigoCliente:, Codigo:
    end
    def dialog
        tab 'Contacto'
            column
                NroContacto:, 'Nro', small_text
                Nombre:, , large_text
                Cargo:, , text
            column
                Telefono:, , text
                Email:, , large_text
    end

    required_fields: NroContacto:, Nombre:
    upper_case_fields: CodigoCliente:

    hide_fields:
        CodigoCliente:

    before_save: do
        if ppl.Vacio($.val(Nombre:))
            $.Alert('El nombre del contacto no puede estar vacio.')
            false
        else
            true
        end
    end

end
