 
#*********************************************************************************
#combos data sources.
set ds_FormaLiquidacion    = "DVP:DVP|STD:STD|"
 
#*********************************************************************************
def abm 'RiskWeight'
   def grid
       Fecha:, Especie:, Plazo:, TipoOp:, FormaLiquidacion:, Factor: 
   end
   def key
       Fecha:, Especie:, Plazo:, TipoOp:, FormaLiquidacion: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
          Fecha: ,          , date
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             TipoOp: , 'Tipo Op', autocomplete, 'TiposOperacion', 'Codigo,Nombre'
             Plazo: ,          , numeric, '#######0.'
             Factor: ,          , numeric
             FormaLiquidacion: , 'Forma', combo, ds_FormaLiquidacion
       #**************************************************************************
       tab 'Valores'
          column
             Valor1: , 'Valor 1', numeric
             Valor2: , 'Valor 2', numeric
             Valor3: , 'Valor 3', numeric
   end
end