#*********************************************************************************
#combos data sources.
set ds_TipoAcuerdo         = "DES:Descubierto|SOB:Sobre Giro|REM:Remunerada|"
set ds_Estado              = "SAU:Sin Autorizar|HAB:Habilitado|"
 
#*********************************************************************************
def abm 'AcuerdosCuenta'
   def grid
       Producto:, Codigo:,TipoAcuerdo:,FechaAlta:,FechaFin:,Orden: 
   end
   def key
       Codigo:,Producto:,TipoAcuerdo:,FechaAlta:,Orden:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Producto: ,          , autocomplete, 'Productos', 'Codigo,Descripcion'
             TipoAcuerdo: ,          , combo, ds_TipoAcuerdo
             FechaAlta: , 'FechaAlta ', 
             FechaFin: , 'FechaFin ', 
             Codigo: , 'Cuenta', autocomplete, 'Cuentas', 'Codigo,Nombre'
             Orden: , 'NrOrden ', numeric
#             Estado: , 'Estado', combo, ds_Estado
#             FechaAprobacion: , 'FechaAprob ', 
#             UsuarioAlta: , 'UsuarioAlta ', autocomplete, 'Usuarios', 'Codigo,Nombre'
#             UsuarioAprobacion: , 'UsuarioAprob ', autocomplete, 'Usuarios', 'Codigo,Nombre'
       #**************************************************************************
       tab 'Valores'
          column
             Monto1: ,         , numeric
             Monto2: ,         , numeric
             Monto3: ,         , numeric
             Monto4: ,         , numeric
             Monto5: ,         , numeric
             Tasa5: ,          , numeric
             Tasa4: ,          , numeric
             Tasa3: ,          , numeric
             Tasa2: ,          , numeric
             Tasa1: ,          , numeric
   end
   upper_case_fields: Codigo:
end