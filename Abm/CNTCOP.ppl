def abm 'CNTiposConceptosPago'
    def grid
        Codigo:, Descripcion:
    end
    def key
        Codigo:
    end
    def dialog_size
    600,400
    end
    def dialog
        tab 'General'
            column
                Codigo:         , 'Codigo', small_text
                Descripcion:    , 'Descripcion', large_text
    end
    upper_case_fields: Codigo:
    validates_max_length_of:
        Codigo:, 6,true;
        Descripcion:, 50,true;
end