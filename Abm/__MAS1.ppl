#*********************************************************************************
#combos data sources.
set ds_DC            = "DEB:Debito|CRE:Credito|OTRO:Otro"
#*********************************************************************************

def abm "MODELOSASIENTO1"
    def grid
        Modelo:,
        NrItem:,
        CuentaContable:,
        CuentaContable1:,
        TablaRC:,
        FormaCalculo1:,
        CondicionValidez:,
        DebitoCredito:,
        Moneda1:,
        CentroCosto1:,
        CentroCosto:,
        CC1:,
        Detalle:,        
        Moneda2:,
        Moneda3:,
        Alias1:,
        Alias2:,
        Alias3:,           
        MN1:,
        MN2:,
        MN3:,
        AL1:,
        AL2:,
        AL3:,            
        Moneda11:,
        Moneda12:,
        Moneda13:,
        CT1:,
        Alias4:,
        Alias5:,
        FormaCalculo2:,
        FormaCalculo3:        
    end
    def filter
        "Modelo = '" + $.parent('Codigo') + "'"
    end
    def key
        Modelo:, NrItem:
    end
    def dialog_size
        850,630
    end
    def dialog          
        tab 'General'
            column
                NrItem:,,numeric,'####0'
                
                CuentaContable:,, autocomplete_formula,'Descripcion'
                CuentaContable1: , 'Cuenta Contable' , autocomplete, 'CONTABILIDAD', 'Codigo,Nombre',,,125
                FormaCalculo1:,, autocomplete_formula,'Descripcion'
                FormaCalculo2:,, autocomplete_formula,'Descripcion'
                FormaCalculo3:,, autocomplete_formula,'Descripcion'
                CondicionValidez:,, autocomplete_formula,'Descripcion'
                DebitoCredito:,, text
                Moneda1:, 'Moneda 1', autocomplete_formula,'Descripcion'
                Moneda11:, 'Moneda 1', autocomplete, 'ESPECIES', 'Codigo,Nombre'
                Moneda2:, 'Moneda 2', autocomplete_formula,'Descripcion'
                Moneda12:, 'Moneda 2', autocomplete, 'ESPECIES', 'Codigo,Nombre'
                Moneda3:, 'Moneda 3', autocomplete_formula,'Descripcion'
                Moneda13:, 'Moneda 3', autocomplete, 'ESPECIES', 'Codigo,Nombre'
                TablaRC:,'TipoCta', autocomplete, 'TIPOCTACONT', 'Codigo,Nombre'
                CentroCosto:,'Centro Costos', autocomplete_formula,'Descripcion'
                CentroCosto1:,'Centro Costos', autocomplete, 'CENTROSCOSTO', 'Codigo,Descripcion'
                Modelo:,
            column
                Label1: ,       ,label
                CC1:    , 'Fijo',check
                Label2: ,       ,label
                Label3: ,       ,label
                Label4: ,       ,label
                Label5: ,       ,label
                Label6: ,       ,label
                DC1:    , 'Tipo',combo, ds_DC
                              
                MN1:    , 'Fijo',check
                Label8: ,       ,label
                MN2:    , 'Fijo',check
                Label9: ,       ,label
                MN3:    , 'Fijo',check
                Label10:,       ,label
                Label11:,       ,label
                CT1:    , 'Fijo',check
                
        tab 'Adicional'
            column
                Alias1:,'Especie', large_text
                Alias2:,'Book', large_text
                Alias3:,'Cliente', large_text
                Alias4:,'FechaVto', large_text
                Alias5:,'Cli/Esp Sis Cont', large_text
                #FormulaValor1:,, autocomplete_formula
                FormulaValor2:,'Nominales', autocomplete_formula
                FormulaValor3:,'Tasa', autocomplete_formula
                Detalle:,, extra_large_text,                 
                Book:, 'Book', autocomplete_formula
                Book1:, 'Book', autocomplete, 'BOOKS', 'Codigo', 'Codigo,Descripcion'
           # Estos campos vienen desde BKB (BOFA)
           #     Alias6:,, autocomplete_formula
           #     Alias7:,, autocomplete_formula
           #     Alias8:,, autocomplete_formula
           #     Alias9:,, autocomplete_formula
           #     Alias10:,, autocomplete_formula
           #column
           #     Clave:,, large_text, 
           #     Producto:,, large_text, 
           #     SubProducto:,, large_text, 
           #     CodContable:,, large_text, 
           #     CuentaWest:,, large_text, 
            column
                Label12:,,label
                Label13:,,label
                Label14:,,label
                Label15:,,label
                Label16:,,label
                Label17:,,label
                Label18:,,label
                Label19:,,label
                Label20:,,label
                BK1: , 'Fijo' , check
            
    end

    do_not_map: 
        DC1:    
   
    when_change: CC1: do
       if $.val CC1: = 'SI'
            $.Show(CuentaContable1:)
            $.Hide(CuentaContable:)
       else
            $.Hide(CuentaContable1:)
            $.Show(CuentaContable:)       
       end
    end
    
    when_change: MN1: do
       if $.val MN1: = 'SI'
            $.Show(Moneda11:)
            $.Hide(Moneda1:)
       else
            $.Hide(Moneda11:)
            $.Show(Moneda1:)
       end
    end
    
    when_change: MN2: do
        if $.val MN2: = 'SI'
            $.Show(Moneda12:)
            $.Hide(Moneda2:)
        else
            $.Hide(Moneda12:)
            $.Show(Moneda2:)
        end
    end
    
    when_change: MN3: do
        if $.val MN3: = 'SI'
            $.Show(Moneda13:)
            $.Hide(Moneda3:)
        else
            $.Hide(Moneda13:)
            $.Show(Moneda3:)
        end
    end

    when_change: BK1: do
       if $.val BK1: = 'SI'
            $.Show(Book1:)
            $.Hide(Book:)
       else
            $.Hide(Book1:)
            $.Show(Book:)       
       end
    end
    
    when_change: CT1: do
        if $.val CT1: = 'SI'
            $.Show(CentroCosto1:)
            $.Hide(CentroCosto:)
        else
            $.Hide(CentroCosto1:)
            $.Show(CentroCosto:)
        end
    end

    when_change: DC1: do
        if $.val (DC1:) = 'DEB'
             $.set_field(DebitoCredito:, "'DEB'")
             $.Disable(DebitoCredito:)
        end
        if $.val DC1: = 'CRE'
             $.set_field(DebitoCredito:, "'CRE'") 
             $.Disable(DebitoCredito:)
        end
        if $.val DC1: = 'OTRO'
            $.set_field(DebitoCredito:, '')
            $.Enable(DebitoCredito:)
        end
     end
   
    before_show_dialog: do
       $.Show(DC1:)
       if $.val CC1: = 'SI'
            $.Show(CuentaContable1:)
            $.Hide(CuentaContable:)
       else
            $.Hide(CuentaContable1:)
            $.Show(CuentaContable:)       
       end

        if $.val CT1: = 'SI'
            $.Show(CentroCosto1:)
            $.Hide(CentroCosto:)
        else
            $.Hide(CentroCosto1:)
            $.Show(CentroCosto:)
        end

       if $.val (DebitoCredito:) = "'DEB'"
            $.set_field(DC1:, 'DEB')
            $.Disable(DebitoCredito:)
       else 
            if $.val DebitoCredito: = "'CRE'"
                $.set_field(DC1:, 'CRE') 
                $.Disable(DebitoCredito:)
            else
                 $.set_field(DC1:, 'OTRO')
                 $.Enable(DebitoCredito:)
                 $.set_field(DebitoCredito:, ppl.SQL("Select DebitoCredito FROM MODELOSASIENTO1 WHERE Modelo = '"+$.val(Modelo:)+"' AND NrItem = '"+$.val(NrItem:)+"' "))
                 #$.set_field(DebitoCredito:, ppl.BuscarCampo('MODELOSASIENTO1', 'DebitoCredito', 'Modelo', $.parent('Codigo')))
            endif
       endif
    end

    before_show_create_dialog: do
       $.set_field(DC1:,'OTRO')
       $.set_field  (DebitoCredito:, '')
       $.set_field  (Modelo:, $.parent("Codigo"))
       if $.val CC1: = 'SI'
            $.Show(CuentaContable1:)
            $.Hide(CuentaContable:)
       else
            $.Hide(CuentaContable1:)
            $.Show(CuentaContable:)       
       end
       if $.val MN1: = 'SI'
            $.Show(Moneda11:)
            $.Hide(Moneda1:)
       else
            $.Hide(Moneda11:)
            $.Show(Moneda1:)
       end       
        if $.val MN2: = 'SI'
            $.Show(Moneda12:)
            $.Hide(Moneda2:)
        else
            $.Hide(Moneda12:)
            $.Show(Moneda2:)
        end
        if $.val MN3: = 'SI'
            $.Show(Moneda13:)
            $.Hide(Moneda3:)
        else
            $.Hide(Moneda13:)
            $.Show(Moneda3:)
        end
        if $.val CT1: = 'SI'
            $.Show(CentroCosto1:)
            $.Hide(CentroCosto:)
        else
            $.Hide(CentroCosto1:)
            $.Show(CentroCosto:)                 
        end
        if $.val BK1: = 'SI'
            $.Show(Book1:)
            $.Hide(Book:)
        else
            $.Hide(Book1:)
            $.Show(Book:)       
        end        
    end
     
    hide_fields:
        Modelo:,DC1:
        
    validations: 
        DebitoCredito:, not ppl.Vacio($.val(DebitoCredito:)), 'El campo DebitoCredito no puede ser vacio','error' 
 
end