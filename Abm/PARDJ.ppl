#*********************************************************************************
#combos data sources.
set ds_Mercados   = "LOC:Local|EXT:Exterior|"
set ds_TipoCli    = "LOC:Local|EXT:Exterior|VIN:Vinculados|"
set ds_TipoEsp    = "BOP:Bopreal|:|"
#*********************************************************************************
def abm 'ParametrosDDJJ'
   def grid
     Codigo:,Descripcion:,Mercado:,TipoCli:,TipoEsp:,Archivo:
   end
   def key
     Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
          Codigo:      , 'Codigo', small_text
          Descripcion: , 'Descripcion', large_text              
          Mercado:     , 'Mercado', combo, ds_Mercados
          TipoCli:     , 'Cliente', combo, ds_TipoCli
          TipoEsp:     , 'Especie', combo, ds_TipoEsp
          Archivo:     , 'Archivo'    , large_text              
   end
   upper_case_fields: Codigo:,Mercado:,TipoCli:,TipoEsp:
   validates_max_length_of:
       Codigo:,10,true;
       Descripcion:,30,true;
       Archivo:,100,true;
end
