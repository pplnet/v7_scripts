 
#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'Sucursales'
   def grid
       Codigo:, Nombre:, Vehiculo:, Zona: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Nombre: ,          , extra_large_text
             Vehiculo: ,          , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             Zona: ,          , autocomplete, 'Zonas', 'Codigo,Nombre'
             Direccion: ,          , extra_large_text
             Localidad: ,          , extra_large_text
             CodPostal: ,          , small_text
             Provincia: ,          , autocomplete, 'Provincias', 'Codigo,Nombre'
#             Pais: , 'Pais', autocomplete, 'Paises', 'Codigo,Nombre'
       #**************************************************************************
       tab 'Alias'
          column
             Alias1: , 'Alias 1', extra_large_text
             Alias2: , 'Alias 2', extra_large_text
             Alias3: , 'Alias 3', extra_large_text
   end
   upper_case_fields: Codigo:
   validates_uniqueness_of: Codigo:
end