#*********************************************************************************
#combos data sources.
set ds_Movimiento = "MAN:Manual|AUT:Automatico|"
#*********************************************************************************
def abm 'Aranceles'
   def grid
       Codigo:, Descripcion: 
   end
   def key
       Codigo: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: , 'Descripcion', large_text
             TipoArancel: , 'Tipo Arancel', autocomplete, 'TiposArancel', 'Codigo,Descripcion'
             Especie: , , autocomplete, 'Especies', 'Codigo,Nombre'
             Vehiculo: , , autocomplete, 'Vehiculos', 'Codigo,Descripcion'
             CuentaContable: , , autocomplete, 'Contabilidad', 'Codigo,Nombre'
             Mercado: , 'Ubicacion' , autocomplete, 'Mercados', 'Codigo,Descripcion'
             Movimiento: , , combo, ds_Movimiento
          column
             TiposOperacion: , , autocomplete_ar_list, 'TiposOperacion', 'Codigo,Nombre'
             ListaEspecies: , , autocomplete_ar_list, 'Especies', 'Codigo,Nombre'
          column
             TiposTransaccion2: , , autocomplete_ar_list, 'TiposTransaccion2', 'Codigo,Nombre'
             EstadosCustodia: , , autocomplete_ar_list, 'EstadosCustodia', 'Codigo,Descripcion'
       #**************************************************************************
       tab 'Valores'
          column
# FJL 11/01/22 - Cambio mascaras
#             Porcentaje: ,          , numeric, '#######0.000000000'
#             Minimo: ,          , numeric, '#######0.000000000'
#             Fijo: ,          , numeric, '#######0.000000000'
#             BasePorcentaje: , 'Base Porcentaje', numeric, '#######0.000000000'
#             DesdeMonto: , 'Desde Monto', numeric, '#######0.000000000'
#             HastaMonto: , 'Hasta Monto', numeric, '#######0.000000000'
#             Maximo: , 'Maximo', numeric, '#######0.000000000'
             Porcentaje: ,          , numeric, '##,###,##0.0000'
             Minimo: ,          , numeric, '##,###,##0.00'
             Fijo: ,          , numeric, '##,###,##0.00'
             BasePorcentaje: , 'Base Porcentaje', numeric, '##,###,##0.0000'
             DesdeMonto: , 'Desde Monto', numeric, '###,###,###,##0.00'
             HastaMonto: , 'Hasta Monto', numeric, '###,###,###,##0.00'
             Maximo: , 'Maximo', numeric, '##,###,##0.00'
   end
   validates_max_length_of:
      Codigo:, 6,true;
      Descripcion:, 30,true;
   upper_case_fields: Codigo:
   validates_uniqueness_of: Codigo:
end