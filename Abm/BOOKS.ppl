#*********************************************************************************
#combos data sources.
set ds_TipoBook         = "TRA:Trading|TRE:Treasury|"
set ds_TipoNegocio      = "SPO:Spot|FWD:FWD|"
set ds_Status           = "HAB:Habilitada|DES:Deshabilitada|"
#*********************************************************************************

def abm 'books'
   def grid
       Jerarquia:, Codigo:, Descripcion: 
   end
   def key
       Jerarquia:, Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Jerarquia: , 'Jerarquia', 
             Codigo: , 'Codigo', small_text
             Descripcion: ,          , large_text
             Vehiculo: , 'Vehiculo', autocomplete, 'Vehiculos', 'Codigo,Descripcion'
#             TipoPosicion: , 'TipoPosicion', autocomplete, 'TiposPosicion', 'Codigo,Descripcion'
             Responsable: , 'Responsable', autocomplete, 'Usuarios', 'Codigo,Nombre'
             BookIEXP: ,    'BookIEXP', autocomplete, 'Books', 'Codigo,Descripcion'
             EspecieFondeo:,'EspecieFondeo', autocomplete, 'Especies', 'Codigo,Nombre'
             TipoTasa:,'TipoTasa', autocomplete, 'TiposTasa', 'Codigo,Nombre'
             CentroFuncional: , 'Centro funcional' , autocomplete, 'CentrosCosto', 'Codigo,Descripcion'
             BookFondeo: ,    'BookFondeo', autocomplete, 'Books', 'Codigo,Descripcion'
             TipoValuacion: ,    'TipoValuacion', autocomplete, 'TIPOSVALUACION', 'Codigo,Descripcion'
             TipoValuacionTIRNIIF: ,    'T.Valua. TIRNIIF', autocomplete, 'TIPOSVALUACION', 'Codigo,Descripcion'
#             Producto: , 'Producto', autocomplete, 'Productos', 'Codigo,Descripcion'
#             GrupoEspecie: , 'Grupo Especie', autocomplete, 'GruposEspecie', 'Codigo,Descripcion'
#             TipoNegocio: , 'Tipo Negocio', autocomplete, 'TiposNegocio', 'Codigo,Descripcion'
#             Book: , 'Book ', autocomplete, 'Books', 'Codigo,Descripcion'
#             TipoBook: , 'RMSBook', autocomplete, 'TiposBook', 'Codigo,Descripcion'
#             IdRMS: , 'RMSBook', large_text
          column
             Bcuelga: , 'Depende del Anterior' , check
             TipoBook: ,          , combo, ds_TipoBook
             TipoNegocio: ,       , combo, ds_TipoNegocio
             Estado: ,            , combo, ds_Status
             Fondea: ,            , check
       #**************************************************************************
       tab 'Valores'
          column
             Alias1: , 'Alias 1', 
             Alias2: , 'Alias 2', 
             Alias3: , 'Alias 3', 
             Alias4: , 'Alias 4', 
             Alias5: , 'Alias 5', 
          column
             Valor1: , 'Valor 1', numeric
             Valor2: , 'Valor 2', numeric
             Valor3: , 'Valor 3', numeric
             Valor4: , 'Valor 4', numeric
             Valor5: , 'Valor 5', numeric
          column          
              Fecha1: , 'Fecha 1', date 
              Fecha2: , 'Fecha 2', date
              Fecha3: , 'Fecha 3', date
              Fecha4: , 'Fecha 4', date
              Fecha5: , 'Fecha 5', date
       #**************************************************************************
       tab 'Listas'
          column
          TiposOperacion: ,     , autocomplete_ar_list, 'TiposOperacion', 'Codigo,Nombre'
            TiposOrden: ,     , autocomplete_ar_list, 'TiposOrden', 'Codigo,Nombre'  
          column 
            Especies: ,           , autocomplete_ar_list, 'Especies', 'Codigo,Nombre'
            TiposTransaccion: , 'Transacciones' , autocomplete_ar_list, 'TiposTransaccion2', 'Codigo,Nombre'
          column
            Traders: ,            , autocomplete_ar_list, 'Usuarios', 'Codigo,Nombre'
         
          
        
           
   end
   upper_case_fields: Codigo:
   disable:
        Jerarquia:,1=1;
   # Esto hace que no el campo no se grabe.
   do_not_map: 
       Bcuelga:;
       
   when_change: Bcuelga: do
       if $.Alta()
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('BOOKS', jerRef, $.val Bcuelga: = 'SI')
        endif
   end
   
   before_show_create_dialog:  do
        if $.Alta()
            # Se muestra solo en el alta
            $.show(Bcuelga:)
            set jerRef = $.val(sender.JERARQUIA)
            $.set_field Jerarquia:, ppl.GenerarJerarquiaByRef('BOOKS', jerRef, $.val Bcuelga: = 'SI')
        endif
   end
   
   hide_fields: 
       Bcuelga:;
       
   validates_uniqueness_of: Jerarquia:, Codigo:
end