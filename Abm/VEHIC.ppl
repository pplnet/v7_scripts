#*********************************************************************************
#combos data sources.
set ds_TipoVehiculo        = "DIV:Division|VIN:Vinculada|NOC:No Controlada|OTR:Otros|"
set ds_Status              = "HAB:Habilitado|DES:Deshabilitado|"
 
#*********************************************************************************
def abm 'Vehiculos'
   def grid
      Codigo:, Descripcion: 
   end
   def key
            Codigo:
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Codigo: , 'Codigo', small_text
             Descripcion: , 'Nombre', extra_large_text
             Cliente: ,          , autocomplete, 'Clientes', 'Codigo,RazonSocial'
       #**************************************************************************
       tab 'Valores'
          column
             Alias1: , 'Alias 1', 
             Alias2: , 'Alias 2', 
             Alias3: , 'Alias 3', 
             Alias4: , 'Alias 4', 
             Alias5: , 'Alias 5', 
          column
             Valor1: , 'Valor 1', numeric
             Valor2: , 'Valor 2', numeric
             Valor3: , 'Valor 3', numeric
             Valor4: , 'Valor 4', numeric
             Valor5: , 'Valor 5', numeric
          column          
             Fecha1: , 'Fecha 1', 
             Fecha2: , 'Fecha 2', 
             Fecha3: , 'Fecha 3', 
             Fecha4: , 'Fecha 4', 
             Fecha5: , 'Fecha 5', 
   end
   upper_case_fields: Codigo:
   validates_max_length_of:
   Codigo:, 10,true;
   Descripcion:, 40,true;
   Alias1:, 15,true; 
   Alias2:, 15,true; 
   Alias3:, 15,true; 
   Alias4:, 15,true; 
   Alias5:, 15,true;
   validates_uniqueness_of: Codigo:
end