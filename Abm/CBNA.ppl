#*********************************************************************************
#combos data sources.
 
#*********************************************************************************
def abm 'CierreBNA'
   def grid
       Fecha:, Especie:, PrecioCompra:, PrecioVenta:, PorCada: 
   end
   def user_filter
       "Del dia", "Fecha = FECHASYS"
   end
   def key
       Fecha:, Especie: 
   end
   def dialog
       #**************************************************************************
       tab 'General'
          column
             Fecha: ,          , date
             Especie: ,          , autocomplete, 'Especies', 'Codigo,Nombre'
             PrecioCompra: , 'Precio Compra', numeric,'#,##0.0000000000'
             PrecioVenta: , 'Precio Venta', numeric,'#,##0.0000000000'
             PorCada: , 'Por Cada', numeric,'##0'
       #**************************************************************************
       tab 'Adicional'
          column
             Precio1: ,          , numeric,'#,##0.0000000000'
             Precio2: ,          , numeric,'#,##0.0000000000'
             Precio3: ,          , numeric,'#,##0.0000000000'
             Precio4: ,          , numeric,'#,##0.0000000000'
             Precio5: ,          , numeric,'#,##0.0000000000'
   end
       upper_case_fields: Especie:
       validates_max_length_of:
       PorCada:, 3,true;
end