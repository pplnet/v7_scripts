FechaOp  ;Vehiculo1;Especie;;;;Vehiculo1;;;;;132; Cantidad                             ;COTIZACIONC(ESPECIE,,,,FECHAOP-1,1,SI,'USD')  ;;;VTXT19;;'FXS';Not Incluido(Especie,'ARP|USD');
