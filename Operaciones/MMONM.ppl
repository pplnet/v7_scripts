CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ;1;1;;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'FECHA DE CONCERTACION INCORRECTA';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ;2;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA DE ORIGEN INCORRECTA';RB11 = 0;FSYS;
MB2             : 'Clase|ON|CP'                ;4;1;;;;MB2>=0;'INDICAR OBLIGACION NEGOCIABLE O COMERCIAL PAPER';NO;;
RB10            : 'Precancelable|Si|No'        ;4;2;;;;RB10>=0;'Precancelable Si/No';NO;; 
RB9             : 'Ley|Argentina|NY'           ;17;1;;;;RB9>=0;'Indique Ley';NO;;
RB12            : 'Convert. Acc.|Si|No'        ;18;1;;;;RB12>=0;'Convertible en Acciones Si/No';NO;;
RB13            : 'DOL.|MEP|Cable'             ;19;1;; NOT EQSTR(ESPECIE,VAR('MONELOCA'));NOT EQSTR(ESPECIE,VAR('MONELOCA'));EQSTR(ESPECIE,VAR('MONELOCA')) o RB13>=0;'Indique DOLAR MEP o Cable';NO;;IF(EQSTR(ESPECIE,VAR('MONELOCA')),-1,RB13)

@VEHITO
Operador        :                              ;3;2;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
Cliente1        : 'Ent_Arranger'               ;5;1;;NOT EV;;NOVACIO(CLIENTE1) Y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS');'ENTIDAD ARRANGER INVALIDA';NO;;
Observac2       : 'Op.Arranger'                ;5;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR ARRANGER NO ES VALIDO';NO;;
Cliente2        : 'Ent_Agente'                 ;6;1;;NOT EV;;NOVACIO (CLIENTE2) Y DESCIENDEDECLIENTE(CLIENTE2,'BANCOS');'ENTIDAD AGENTE INVALIDA';NO;;
Especie         : 'Moneda'                     ;;;;NOT EV;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA') y EsTerminal(ESPECIE, Especie);'DEBE INGRESAR UNA MONEDA VALIDA';NO;'USD';;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;
Cantidad        : 'Capital'                    ;;;;NOT EV;;CANTIDAD>0;'CAPITAL INVALIDO';NO;;IF(CANTIDADORI<>0,CANTIDADORI*COEFICIENTE,CANTIDADORI);;;;;'###,###,###,###,###.##'
TotalComisiones : 'Comision EF'                ;;;;NO;;;;;;CANTIDAD*VCAN10/100;;;;;'###,###,###,###,###.##'
PrecioEj        : 'V. Nominal'                 ;;;;NO;;;;;;CANTIDAD+TOTALCOMISIONES;;;;;'###,###,###,###,###.##'
RB8             : 'Day Count|ActAct|Act365F|Act360|360360|30E360' ;;;;;;;;;2;IF(MODI,RB8,IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),1,0))
TablaFeriados1  : 'Feriados'                   ;6;2;;;;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;;BuscarCampo('Feriados','Codigo','Codigo',BuscarCampo('Especies','PaisOrigen','Codigo',ESPECIE)) 
Plazo           : 'Plazo '                     ;;;;;;PLAZO>0 Y [[MB2=1 Y PLAZO<=365] O MB2=0];'PLAZO INVALIDO';NO;0;FECHAVTO-FECHAOP
FechaVto        : 'Fecha_Vto'                  ;;;;;;DiaSem(FECHAVTO) > 1 Y DiaSem(FECHAVTO) < 7;'LA FECHA DE VENCIMIENTO NO PUEDE SER SABADO O DOMINGO';RB11 = 0;FECHAOP+PLAZO;FECHAOP+PLAZO
TotalNetoCli3   : 'VN_Actual'                  ;12;1;;NO;TOTALNETOCLI3<>CANTIDAD;;;;;CANTIDAD;;;;;'###,###,###,###,###.##'
TipoTasa        : 'Tipo_Tasa'                  ;14;1;;VACIO(OPERACIONREF);;NOVACIO(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;;IF(VACIO(OPERACIONREF),TIPOTASA,OPREF.TIPOTASA)
Spread          :                              ;15;2; ; VACIO(OPERACIONREF) Y Not EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;IF(VACIO(OPERACIONREF),IF(EQSTR(TIPOTASA,'FIJA'),0,SPREAD),OPREF.SPREAD)                                      
Precio1         : 'Tasa'                       ;15;1; ;EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA');PRECIO1>=0;'La Tasa debe SER POSITIVA';NO;0;IF (NOT EQSTR(TIPOTASA,'FIJA'),0,PRECIO1);;;;;;'###,###.######'
Plazo4          : 'Dias Seteo Tasa'            ; 14;2; ;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);[PLAZO4>=0] O [EQSTR(TIPOTASA,'FIJA')];'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa';NO;;
RB7            : 'Setea|InicioPer|FinPer'      ;15;1;;;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);RB7=0 O RB7=1 O [EQSTR(TIPOTASA,'FIJA') o VACIO(TIPOTASA)];'Indique Inicio o Fin de Periodo';NO;

Cuotas1         : 'Nr_Periodos'                ;;;;;;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;;;
ImpGastos2      : 'Tasa_IVA'                   ;12;2;;EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) O Incluido(Fstr(ImpGastos2,2,2),VAR('IVA'));'El Valor de TASA IVA es Erroneo: '~VAR('IVA')~' ...';NO;VAR('IVA');IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),IMPGASTOS2,0);;;;;'###,###.######'
TotalAux1       : 'Tasa WH'                    ;;;;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)) O Incluido(Fstr(TotalAux1,2,4),VAR('TASAWH'));'El Valor de TASA WH es Erroneo: '~VAR('TASAWH')~' ...';NO;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,TOTALAUX1);;;;;'###,###.######'
VCAN10          : 'ComEF'                      ;11;3;;NO;NO;;;;;SUM(COM2L,2,1,5);;;;;'###.########'
RB3             : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
Impresa         : 'Modificado'                 ;10;3;;NO;NO;;;;0
CB10            : 'Loc o Extr'                 ;12;3;;NO;NO;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1);IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
RB6             : 'Loc o Extr'                 ;12;3;;NO;NO;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1);IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,1)
Cotizacion1     : 'TC_Concert.'                ;1;1;2;;NO Y Not Eqstr(ESPECIE,VAR('MONEEXTR'));SI O Eqstr(ESPECIE,VAR('MONEEXTR')) O [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,VAR('MONEEXTR')),1)
Cotizacion2     : 'TC_Vencim.'                 ;;;;COTIZACION2<>0;COTIZACION2<>0;;;;

Observac3       : 'Nr.Emis Serie'              ;  ; ;2;;;NoVacio(OBSERVAC3);'No Ingreso el Numero de Emision de la Serie';SI;;;;;;;'XXXXXXXXXXXXXXXXXXXXXXXXXXXX';
MB3             : 'Emision|No|Prima|Dto|Par|'  ;  ; ;2;NOT EV;;;;;0
TotalGastos     : 'Precio Emision'             ;  ; ;2;NOT EV y MB3<>0;MB3<>0;MB3=0 o [TOTALGASTOS<>0 Y TOTALGASTOS<1] O [TOTALGASTOS = 1 Y MB3 = 3];'Debe Ingresar el Precio de Prima o Descuento de Emision por Unidad';NO;1;;;;;;'#.######'
TotalDerechos   :  IF(MB3=1,'Prima',IF(MB3=2,'Descuento', 'Par'))  ; ; ;2;NO;MB3<>0;;;;IF(MB3<>0,PRECIOEJ*(1-TOTALGASTOS),0);IF(MB3<>0,PRECIOEJ*(1-TOTALGASTOS),0);;;;;'###,###,###.######'
ContraEspecie   : 'Titulo'                     ;  ; ;2; ;MB3<>0;[DESCIENDEDEESPECIE(CONTRAESPECIE,'TITULO') y NOVACIO(CONTRAESPECIE) ] o [MB3=0];'Debe Ingresar un Titulo valido';NO;;;;;;;;" "~DBO~".DESCIENDEDEESPECIE(Codigo,'TITULO') = 1"

Precio4         : 'TC Indice'                  ;7;2;2;NO;NO;;;;;IF(Eqstr(ESPECIE,CONTRAESPECIE4),1,IF(Eqstr(ESPECIE,Var('MONEEXTR')),CotizacionBNA(CONTRAESPECIE5,FECHAOP+PLAZO2,1,NO,NO),1/CotizacionBNA(CONTRAESPECIE5,FECHAOP+PLAZO2,1,NO,NO)));;;

RB11            : 'Ajuste|NO|SI'               ;8;1;2;;;;;;1;

VPRE1           : 'Cot.TC/USD'                 ;13;2; ;NO;NO;;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))^If(EqStr(Modo(ESPECIE,VAR('MONEEXTR')),'DIR'),1,-1)
PrecioMer       : 'Monto USD WF'               ;1;2;2;NO;NO;;;;PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));PRECIOEJ*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

VTXT18            : 'Book Def'    ; 1;2;2;NO;NO;;;;;BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1)
VTXT19            : 'Codigo Book' ; 2;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Codigo','Codigo',VTXT18)
VTXT20            : 'Vehic.Book'  ; 3;2;2;NO;NO;;;;;BuscarCampo('BOOKS','Vehiculo','Codigo',VTXT19)

