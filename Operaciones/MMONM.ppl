@CALLPUTON

LISTA:SI;IF(ESINICIO,100,CUOTAS1);
  Tasa1    : 'Tasa Amort'     ;NOT EV;;CUOTASL.TASA1[Fila]>=0;'La Tasa de Amortizacion debe SER POSITIVA';(100/CUOTAS1);CUOTASL.CANTIDAD4[Fila]*100/(CANTIDADORI+(CANTIDADORI*VCAN10/100));100;;Numero;'###,###.######';NO;NO;'2'
  Cantidad4: 'Imp Amort'      ;NOT EV;;CUOTASL.CANTIDAD4[Fila]>=0;'El Importe Amortizacion debe SER POSITIVO';((CANTIDADORI+(CANTIDADORI*VCAN10/100))*(100/CUOTAS1)/100)*CUOTASL.COEFICIENTE[Fila];((CANTIDADORI+(CANTIDADORI*VCAN10/100))*CUOTASL.TASA1[Fila]/100)*CUOTASL.COEFICIENTE[Fila];200;;Numero;'###,###,###,###.##';NO;NO;'1'
  Plazo1   : 'Plazo'          ;;;CUOTASL.PLAZO1[Fila]>0;'El Plazo DEBE SER POSITIVO';IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1));CUOTASL.FECHA2[Fila]-CUOTASL.FECHA1[Fila];60;;Numero;'####';NO;NO;
  Fecha1   : 'F.Origen'       ;;;ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1);'La Fecha Origen de la Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);90;;Fecha;NO;NO;;;;;;RB11 = 0
  Fecha2   : 'F.Vto'          ;  ;;DIASEM(CUOTASL.FECHA2[Fila]) > 1 Y DIASEM(CUOTASL.FECHA2[Fila]) < 7;'El Vencimiento de la Cuota '~Fstr(Fila, 0, 0)~ ' NO PUEDE SER SABADO O DOMINGO';IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);90;;Fecha;;;;;;;;RB11 = 0
  Fecha3   : 'F.Sett'         ;;;ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA3[Fila],'ARG');'El Settlemnt No es HABIL';IF(Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG'),Habiles(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1, SI), CUOTASL.FECHA2[Fila]);IF(Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG'),Habiles(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1, SI), CUOTASL.FECHA2[Fila]);90;;Fecha;NO;NO
  Fecha5   : 'F.Seteo TC Indice' ;NO;NoVacio(INDICE);;;CUOTASL.FECHA2[FILA]+PLAZO2;CUOTASL.FECHA2[FILA]+PLAZO2;100;;Fecha;
  Cantidad2: 'V.Nominal'      ;NO;;CUOTASL.CANTIDAD2[Fila]>=0;'El Valor Nominal debe SER POSITIVO';IF(Fila=1,(CANTIDADORI+(CANTIDADORI*VCAN10/100)),CUOTASL.CANTIDAD2ORI[Fila-1]-CUOTASL.CANTIDAD1ORI[Fila-1])*CUOTASL.COEFICIENTE[Fila];IF(Fila=1,(CANTIDADORI+(CANTIDADORI*VCAN10/100)),CUOTASL.CANTIDAD2ORI[Fila-1]-CUOTASL.CANTIDAD1ORI[Fila-1])*CUOTASL.COEFICIENTE[Fila];200;;Numero;'###,###,###,###,###.##'
  Precio2  : 'Tasa Interes'   ;;;[NOT EQSTR(TIPOTASA,'FIJA') Y Fila>1 Y CUOTASL.PRECIO2[Fila]=0] O [CUOTASL.PRECIO2[Fila]>=VAR('RTASA1') Y CUOTASL.PRECIO2[Fila]<=VAR('RTASA2')];'Tasa Incorrecta o Fuera de Rango:'~VAR('RTASA1')~" Y "~VAR('RTASA2');;IF(EQSTR(TIPOTASA,'FIJA'),PRECIO1,IF(Eqstr(CampoEditado, 'TIPOTASA'),CUOTASL.PRECIO2[Fila],0));100;;Numero;'###,###.######';NO;NO;'11'
  Precio4  : 'Spread'         ;;NOT EQSTR(TIPOTASA,'FIJA');EQSTR(TIPOTASA,'FIJA') O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]=0] O [NOT EQSTR(TIPOTASA,'FIJA') Y CUOTASL.PRECIO4[Fila]>=VAR('RSPREAD1') Y CUOTASL.PRECIO4[Fila]<=VAR('RSPREAD2')];'El Spread es incorrecto o esta Fuera de Rango:'~VAR('RSPREAD1')~' '~VAR('RSPREAD2');;IF(EQSTR(TIPOTASA,'FIJA'),CUOTASL.PRECIO4[Fila],SPREAD);100;;Numero;'###,###.######';NO;NO;'11'
  Cantidad3: 'Interes'        ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'10;9;18';
  Tasa2    : 'Tasa_Int_IVA'   ;;EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));CUOTASL.TASA2[Fila]>=0;'Ingrese la Tasa para el Calculo del Iva';0;CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila];100;;Numero;'###,###.######';NO;NO;
  Precio1  : 'Imp. IVA'       ;EV;;NOT EV o [[ROUND(CUOTASL.PRECIO1[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.PRECIO1[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,( (IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*(CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*IMPGASTOS2/100));200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Total6   : 'Tasa_Int_WH'    ;;NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1));CUOTASL.TOTAL6[Fila]>=0;'Ingrese la Tasa para el Calculo del WH';0;CUOTASL.PRECIO2[Fila]+CUOTASL.PRECIO4[Fila];100;;Numero;'###,###.######';NO;NO;
  Precio3  : 'Imp. WH'        ;EV;;NOT EV o [[ROUND(CUOTASL.PRECIO3[Fila],2) <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.PRECIO3[Fila],2) >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe WHT Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,( (IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*(CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*TOTALAUX1/100));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'19'
  Cantidad5: 'Interes Total'  ;NO;;;;;CUOTASL.CANTIDAD3[Fila]+CUOTASL.PRECIO3[Fila]+CUOTASL.TOTAL9[Fila];200;;Numero;'###,###,###,###,###.##'
  Cantidad6: 'Imp Amort Mon. Liq.'  ;NO;NoVacio(INDICE);;;CUOTASL.CANTIDAD4[Fila]*CUOTASL.PRECIO8[Fila];CUOTASL.CANTIDAD4[Fila]*CUOTASL.PRECIO8[Fila];200;;Numero;'###,###,###,###,###.##';
  Cantidad7: 'Interes Mon. Liq.'    ;NO;NoVacio(INDICE);;;CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO8[Fila];CUOTASL.CANTIDAD3[Fila]*CUOTASL.PRECIO8[Fila];200;;Numero;'###,###,###,###,###.##';
  Total4   : 'Imp. WH Mon. Liq.'    ;NO;NoVacio(INDICE);;;CUOTASL.PRECIO3[Fila]*CUOTASL.PRECIO8[Fila];CUOTASL.PRECIO3[Fila]*CUOTASL.PRECIO8[Fila];200;;Numero;'###,###,###.##';
  Total3   : 'Tasa T.Neta'    ;NO;;SI Y [[NOT EQSTR(TIPOTASA,'FIJA') Y Fila>1 Y CUOTASL.TOTAL3[Fila]=0] O [CUOTASL.TOTAL3[Fila]>=VAR('RTTN1') Y CUOTASL.TOTAL3[Fila]<=VAR('RTTN2')]];'Tasa Total Neta Incorrecta o Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');;;200;;Numero;'###.######'
  Tasa3    : '% Imp.Interes'  ;;;[Incluido(Fstr(CUOTASL.TASA3[Fila],2,4),VAR('TASAINT'))];'El Valor de TASA Impuesto  INTERES es Erroneo: '~VAR('TASAINT')~' ...';VAR('DEFAINT');CUOTASL.TOTAL9[Fila]*100/CUOTASL.CANTIDAD3[Fila];90;NO;Numero;'###.##';NO;NO;'20'
  Total9   : 'Impto.Interes'  ;;;NOT EV o [[ROUND(CUOTASL.TOTAL9[Fila],2) <= ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.TOTAL9[Fila],2) >= ROUND((NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Interes Fuera de Rango: '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(NUM(CUOTASL.PRECIOREF1[Fila])*(1+Var('PORVAR')/100),2),0,2);;CUOTASL.CANTIDAD3[Fila]*(CUOTASL.TASA3[Fila]/100);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'16'
  Fecha4   : 'F.SeteoTasa'     ;NO;NOT EQSTR(TIPOTASA,'FIJA') Y NOVACIO(TIPOTASA);;;;HABILES(IF(RB7=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Total2   : 'Monto'          ;NO;;;;;(CUOTASL.CANTIDAD4[Fila]+CUOTASL.CANTIDAD3[Fila]);200;;Numero;'###,###,###,###,###.##'
  Total1   : 'Monto Total'    ;NO;;;;;CUOTASL.CANTIDAD4[Fila]+CUOTASL.CANTIDAD5[Fila];200;;Numero;'###,###,###,###,###.##'
  Precio5  : 'MOD INT'        ;NO;NO;;;;IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*((CUOTASL.PRECIO4[Fila]+CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1));200;;Numero;'###.######'
  Precio6  : 'MOD IVA'        ;NO;NO;;;;IF(NOT EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,( (IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*(CUOTASL.TASA2[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*IMPGASTOS2/100));200;;Numero;'###.######'
  Precio7  : 'MOD WHT'        ;NO;NO;;;;IF(EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),0,( (IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD2[Fila]*(CUOTASL.TOTAL6[Fila]/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1)))*TOTALAUX1/100));200;;Numero;'###.######'
  Cotizacion1: 'TC_IVA'       ;NO;NO;;;-1;;200;;Numero;'###.######'
  PrecioRef1: 'MOD Impto.Interes';NO;NO;;;;Fstr(CUOTASL.CANTIDAD3[Fila]*(CUOTASL.TASA3[Fila]/100),0,2);200;NO;String;
