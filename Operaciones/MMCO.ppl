[PRECIO4<=PRECIO2*(1+VAR('RTASA2')/100) Y PRECIO4>=PRECIO2*(1-VAR('RTASA2')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia Fuera de Rango: '~FSTR((PRECIO2*(1-VAR('RTASA2')/100)),1,7)~' y '~FSTR((PRECIO2*(1+VAR('RTASA2')/100)),1,7);NO;;;;;
[PRECIO4<=PRECIO2*(1+VAR('RTASA1')/100) Y PRECIO4>=PRECIO2*(1-VAR('RTASA1')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia Fuera de Rango: '~FSTR((PRECIO2*(1-VAR('RTASA1')/100)),1,7)~' y '~FSTR((PRECIO2*(1+VAR('RTASA1')/100)),1,7);SI;SI;Fsys;'RANGOTRANS';;

PRECIO1<=PRECIO4*(1+VAR('RTASA2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RTASA2')/100);'Tasa Fuera de Rango: '~FSTR((PRECIO4*(1-VAR('RTASA2')/100)),1,7)~' y '~FSTR((PRECIO4*(1+VAR('RTASA2')/100)),1,7);NO           
PRECIO1<=PRECIO4*(1+VAR('RTASA1')/100) Y PRECIO1>=PRECIO4*(1-VAR('RTASA1')/100);'Tasa Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RTASA1')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RTASA1')/100),1,7)    ;SI;SI;Fsys;'RANGOTASA'

[PRECIO1>=PRECIO4 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Spread Negativo: '~FSTR(PRECIO4-PRECIO1,0,7);SI;SI;FSys;'SPREADNEG';;
[PRECIO4 = PRECIO2 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia: '~FSTR(PRECIO2,0,7)~'. Tasa Transferencia Modificada: '~FSTR(PRECIO4,0,7)~'. ';SI;SI;FSys;'TASATMOD';;

IF(EqStr(VAR('CTRLSECTOR'),'SI'),NOVACIO(SECTOR1)) O EqStr(VAR('CTRLSECTOR'),'NO');'El usuario no tiene sector asignado';NO


VACIO(CLIENTE1) o ExisteLimite('DFROM',Cliente1,'USD',Vehiculo1)                                                   ; 'Due From Cliente no asignado'   ;SI;SI;FSYS;'DFROMNOAS'
VACIO(CLIENTE1) o LimAsignado(Cliente1,'DFROM','USD',Vehiculo1)   >= VCAN1+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)  ; 'Due From Cliente excedido en U$D '~PYC(VCAN1+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimAsignado(Cliente1,'DFROM','USD',Vehiculo1),1,0)~'.-'   ;SI;SI;FSYS;'DFROMEXCE'
*VACIO(CLIENTE1) o BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1) >= FechaOp; 'Review date Cliente vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1));SI;SI;FSYS;'RDATEVENC'
VACIO(CLIENTE1) o QUERY("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Cliente1~"' AND Limite = 'DFROM'") >= FechaOp; 'Due From Cliente vencido el '~Fecha(QUERY("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~Cliente1~"' AND Limite = 'DFROM'"));SI;SI;FSYS;'RDATEVENC'
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente no puede ser el Vehiculo';NO

VACIO(VTXT11) o ExisteLimite('DFROM',VTXT11,'USD',Vehiculo1)                                                   ; 'Due From Controlante '~VTXT11~' no asignado'   ;SI;SI;FSYS;'DFROMNOAS'
VACIO(VTXT11) o LimAsignado(VTXT11,'DFROM','USD',Vehiculo1)   >= VCAN1+LimConsumido(VTXT11,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)  ; 'Due From Controlante '~VTXT11~' excedido en U$D '~PYC(VCAN1+LimConsumido(VTXT11,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimAsignado(VTXT11,'DFROM','USD',Vehiculo1),1,0)~'.-'   ;SI;SI;FSYS;'DFROMEXCE'
*VACIO(VTXT11) o BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT11) >= FechaOp; 'Review date Controlante '~VTXT11~' vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT11));SI;SI;FSYS;'RDATEVENC'
VACIO(VTXT11) o QUERY("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~VTXT11~"' AND Limite = 'DFROM'") >= FechaOp; 'Due From Controlante '~VTXT11~' vencido el '~Fecha(QUERY("SELECT FVencimiento FROM "~DBO~".LIMASIGNADOS WHERE Cliente = '"~VTXT11~"' AND Limite = 'DFROM'"));SI;SI;FSYS;'RDATEVENC'



Not EqStr('DES',BuscarCampo('ESPECIES','Status','Codigo',ESPECIE));'La Especie esta deshabilitada';NO

[EQSTR(ESPECIE,'ARP') Y PRECIO1>=0] O [Not EQSTR(ESPECIE,'ARP') y PRECIO1>0];'La Tasa NO puede ser negativa';NO

[Eqstr(Especie,Opref.Especie)] o [Not NoVacio(OperacionRef)];'No coincide la especie con la operacion de referencia';NO
[Eqstr(Cliente1,Opref.Cliente1)] o [Not NoVacio(OperacionRef)];'No coincide el cliente con la operacion de referencia';NO
[FechaOp=Opref.FechaVto] o [Not NoVacio(OperacionRef)];'La operacion de referencia no ha vencido aun';NO
[Not NoVacio(OperacionRef)] o [EqStr(BuscarCampo('OPERACIONES', 'RB6', 'NrOperacion', OPERACIONREF),'0')];'La operacion de referencia debe estar pendiente';NO

Not EqStr('DES',BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO

Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado));'Ingreso un Mercado de Titulos para el Mercado de Especie';NO 
SI o Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado2));'Ingreso un Mercado de Titulos para el Mercado de Moneda';NO 

SI o Vacio(Query("Select Valor from "~DBO~".VARIABLES Where Codigo='TRADOVNGT' "));pipe2coma(Query("Select Valor from "~DBO~".VARIABLES Where Codigo='TRADOVNGT' "))~' tienen todavia posiciones en Overnight.';SI

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO

LIMITES
Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);Cliente1;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'), CANTIDAD, CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'))                                  ;TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;;;;;;;;;;0;;;
FechaOp                                                              ;Cliente1;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'), (CANTIDAD-OPREF.CANTIDAD), (CANTIDAD-OPREF.CANTIDAD)*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));TipoOp~' '~Especie;NoVacio(CLIENTE1) y NOVACIO(OPERACIONREF) y MB1=0 y CANTIDAD>OPREF.CANTIDAD;Vehiculo1;;;;;;;;;;0;;;
Habiles(FechaOp,1,TablaFeriados1)                                    ;Cliente1;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'),-(CANTIDAD-OPREF.CANTIDAD),-(CANTIDAD-OPREF.CANTIDAD)*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));TipoOp~' '~Especie;NoVacio(CLIENTE1) y NOVACIO(OPERACIONREF) y MB1=0 y CANTIDAD>OPREF.CANTIDAD;Vehiculo1;;;;;;;;;;0;;;
Habiles(FechaVto,1,TablaFeriados1)                                   ;Cliente1;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'),-CANTIDAD,-CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'))                                  ;TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;;;;;;;;;;0;;;
Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);VTXT11  ;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'), CANTIDAD, CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'))                                  ;TipoOp~' '~Especie;NoVacio(VTXT11);Vehiculo1;;;;;;;;;;0;;;
FechaOp                                                              ;VTXT11  ;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'), (CANTIDAD-OPREF.CANTIDAD), (CANTIDAD-OPREF.CANTIDAD)*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));TipoOp~' '~Especie;NoVacio(VTXT11) y NOVACIO(OPERACIONREF) y MB1=0 y CANTIDAD>OPREF.CANTIDAD;Vehiculo1;;;;;;;;;;0;;;
Habiles(FechaOp,1,TablaFeriados1)                                    ;VTXT11  ;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'),-(CANTIDAD-OPREF.CANTIDAD),-(CANTIDAD-OPREF.CANTIDAD)*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));TipoOp~' '~Especie;NoVacio(VTXT11) y NOVACIO(OPERACIONREF) y MB1=0 y CANTIDAD>OPREF.CANTIDAD;Vehiculo1;;;;;;;;;;0;;;
Habiles(FechaVto,1,TablaFeriados1)                                   ;VTXT11  ;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'),-CANTIDAD,-CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'))                                  ;TipoOp~' '~Especie;NoVacio(VTXT11);Vehiculo1;;;;;;;;;;0;;;

