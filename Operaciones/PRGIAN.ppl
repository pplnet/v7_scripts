CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
Cantidad        : 'Capital'                    ;;;;;;;;;
Operador        :                              ;9;2;;NO;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
PlazoGracia     : 'Plazo_Gracia'               ;13;2;;NO;NO;PLAZOGRACIA>0 Y PLAZOGRACIA<=CUOTAS1;'Plazo de Gracia >=1 y <= '~CUOTAS1;NO;1;
Cuotas1         : 'Nr_Periodos'                ;;2;;VACIO(OPERACIONREF) O OPREF.RB6<0;;CUOTAS1>=1;'Debe INGRESAR la Cantidad DE PERIODOS';NO;;OPREF.CUOTAS1-IF(CUOTAS2>0,CUOTAS2-1,0);
OperacionRef    : 'Id_Partida'                 ;3;2;;;;;;SI;;;;

LISTA:SI;CUOTAS1;
  Cantidad1: 'Imp Amort'         ;  ;;;;;CANTIDAD;200;;Numero;'###,###,###,###,###.##';NO;NO;'1'
  Fecha1   : 'F.Origen'          ;  ;;;;;FSYS;90;;Fecha;NO;NO;'5;3';;;;;
  Fecha2   : 'F.Vto'             ;  ;;;;;FSYS+3;90;;Fecha;NO;NO;'3;4';;;;;
  Precio2  : 'Tasa Interes'      ;  ;;;;;IF(VACIO(OPERACIONREF),CUOTASL.PRECIO2[Fila],555);100;;Numero;'###,###.######';NO;NO;'16;9'
  Cantidad3: 'Interes'           ;EV;;;;;IF(Fila<PlazoGracia,0,CUOTASL.CANTIDAD1[Fila]*((CUOTASL.PRECIO2[Fila])/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],1));100;NO;Numero;'###,###,###,###,###.##';NO;NO;'7;8';

    
    
