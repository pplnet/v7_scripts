Cantidad         : 'V.N.'            ; 5;1; ;NO;  ;CANTIDAD>0;'El Importe debe ser Positivo';NO; ;if(CB5=1 y EqStr(MERCADO4,VAR('AMBMAE')),Cantidad,TOTALBRUTOCLI3 * (if(EqStr(VTXT1,'SI') y Query("Select IsNull(Plazo,0) from "~DBO~".PLAZOSMERCADO Where MercadoNegociacion = '"~MERCADO4~"' and FechaVto = '"~IdxDate(FECHAVTO)~"' and Especie = '"~ESPECIE~"' ") > 0,Query("Select Plazo from "~DBO~".PLAZOSMERCADO Where MercadoNegociacion = '"~MERCADO4~"' and FechaVto = '"~IdxDate(FECHAVTO)~"' and Especie = '"~ESPECIE~"' "),BuscarCampo('MERCADOS','TamanioLote','Codigo',MERCADO4))))
Precio1          : 'Precio Futuro'   ; 6;1; ;  ;  ;PRECIO1>0 ;'El Tipo de Cambio debe ser Positivo'    ;NO;0;
