CAMPOS:3;;51

FechaOp          : 'Fecha Op.'       ; 3;2; ;  ;  ;FechaOp <= FSys y [[FinDeMes(FECHAOP)<>FinDeMes(FSys) y FECHAOP>= Habiles(FSys,-Var('FTVALOR'),Var('FERIDEF'))] o [FinDeMes(FECHAOP)=FinDeMes(FSys)]] y [EsHabil(FECHAOP,Var('FERIDEF')) y EsHabil(FECHAOP,TABLAFERIADOS1)];'Fecha Op. Incorrecta';NO;FSYS;
Mercado4         : 'M. Negociac.'    ; 1;1; ;  ;;NOVACIO(MERCADO4) y Incluido('FM',BuscarCampo('MERCADOS','TipoNegocio','Codigo',MERCADO4));'Debe ingresar Mercado de Futuro de Moneda';NO;VAR('MENEFFX');;;;;;;"TipoNegocio Like '%FM%' and EsNegociacion = 'SI' "
