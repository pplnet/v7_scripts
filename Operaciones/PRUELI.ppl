FormaLiquidacion1: 'Liquidacion|FD&&P|DVP|RVP'    ;7;2;;Not EV y Eqstr(RB10,'0');Eqstr(RB10,'0') Y INCLUIDO(MERCADO3,VAR('MERCADOCV'));;;;0; IF(Incluido(MERCADO3,VAR('MERCAVARI')),IF(MODI O EV,FORMALIQUIDACION1,0),0);
FormaLiquidacion2: 'Liquidacion|STD|DVP|FOP'      ;7;2;;Not EV y NOT INCLUIDO(MERCADO3,VAR('MERCAACMC')) y Vacio(NRORDEN1);Incluido(MERCADO3,VAR('MERCAVARI'));EV o NOT Incluido(MERCADO3,VAR('MERCAVARI')) O FORMALIQUIDACION2>0;'Liquidacion no puede ser FD&&P';NO;IF(Incluido(MERCADO3,VAR('MERCAVARI')),1,0);IF(Incluido(MERCADO3,VAR('MERCAVARI')),IF(MODI O EV,FORMALIQUIDACION2,1),0);
