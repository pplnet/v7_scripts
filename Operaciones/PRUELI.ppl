ContraEspecie    : 'Mon. Pago'       ; 2;2; ;NO;  ;;;;Var('MONELOCA');Var('MONELOCA')
Plazo            : 'Plazo'           ; 4;2; ;  ;  ;PLAZO>=0;'Plazo invalido';NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP
VPRE1            : 'MTM Merc4'       ;11;3; ;NO;NO;;;;;BuscarCampo('MERCADOS','MTM','Codigo',MERCADO4);;;;;
