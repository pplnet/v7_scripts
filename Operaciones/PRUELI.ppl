Cuenta3          : 'Cta.Mon.VEH:'   ;15;2;1;Not EV;;Vacio(CUENTA3) o [CLIENTECUENTA(VEHICULO1,CUENTA3) y ESPECIECUENTA(VTXT2,CUENTA3) y EqStr(IF(Eqstr(VTXT1, 'SI'),MERCADO4,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(VTXT2,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(VTXT2,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO2)),MERCADO2)), BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA3))];'Cuenta Moneda Vehiculo inválida';NO;;IF(NoVacio(BOOK1),IF(EqStr(VTXT12,'SI'),CUENTA4,QUERY("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VTXT2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') and Mercado='"~ IF(Eqstr(VTXT1, 'SI'),MERCADO4,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(VTXT2,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(VTXT2,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO2)),MERCADO2)) ~"' ORDER by ISNull(Permanente,'NO') DESC, Codigo ASC")));;;;;;"Cliente = '"~VEHICULO1~"' and (Especies Like '%MONEDA%' or Especies Like '%"~VTXT2~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') and Mercado='"~ IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(VTXT2,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(VTXT2,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO2)),MERCADO2) ~"'";;

