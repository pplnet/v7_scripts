FechaOp;FechaVto-1;;SI;NO;TablaFeriados1;SI;SI;'INTLEN';TotalGastos-TotalCaucion;140;Vehiculo1;Vehiculo1;;;;;;;;ContraEspecie;;;;;;Book1;OPERADOR;;;;Especie;0;

MOVIMIENTOS

LIMITES
FechaOp;VTXT11;'SETTLEMENT';Especie      ;FechaPago; VCAN10;TipoOp~' '~Especie;FormaLiquidacion1 <> 1;Vehiculo1;
FechaOp;VTXT11;'SETTLEMENT';ContraEspecie;FechaVto2;  VCAN9;TipoOp~' '~Especie;FormaLiquidacion2 <> 1;Vehiculo1;

FechaOp;VTXT10;'SETTLEMENT';Especie      ;FechaPago; VCAN10;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y FormaLiquidacion1 <> 1;Vehiculo1;
FechaOp;VTXT10;'SETTLEMENT';ContraEspecie;FechaVto2;  VCAN9;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y FormaLiquidacion2 <> 1;Vehiculo1;

FechaOp  ;VTXT11;'PRESETTLEM';'USD';; TotalAux2;TipoOp~' '~Especie;;Vehiculo1;
FechaVto2;VTXT11;'PRESETTLEM';'USD';;-TotalAux2;TipoOp~' '~Especie;FormaLiquidacion2 <> 1;Vehiculo1;

FechaOp  ;VTXT10;'PRESETTLEM';'USD';; TotalAux2;TipoOp~' '~Especie~' GE';NoVacio(VTXT10);Vehiculo1;
FechaVto2;VTXT10;'PRESETTLEM';'USD';;-TotalAux2;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y FormaLiquidacion2 <> 1;Vehiculo1;

FechaOp  ;Vehiculo1;'MAX'~MERCADO;VAR('MONEEXTR');FechaPago ; VCAN10;TipoOp~' '~Especie ;VCAN1=0  y [FormaLiquidacion1=1];Vehiculo1
FechaOp  ;Vehiculo1;'MAX'~MERCADO;VAR('MONEEXTR');FechaVto2 ; VCAN9 ;TipoOp~' '~Especie ;VCAN1=0  y [FormaLiquidacion2=1];Vehiculo1

