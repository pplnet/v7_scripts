VFEC6          : 'Fecha Mad.Esp.' ; 5;3; ;NO;NoVacio(CORREDOR);;;;;BuscarCampo('ESPECIES','Fecha','Codigo',ESPECIE);
TotalComisiones:                  ; 5;2; ;NO;NoVacio(CORREDOR);;;;;ComCorredor2(CORREDOR,TIPOOP,ESPECIE,CONTRAESPECIE,CANTIDAD,TOTALBRUTOCLI1,TIPOCAMBIO,PRECIO1*100,VFEC6-FECHAOP,VTXT7) 
FechaVto2      : 'Fecha Liq.Mon'  ; 6;3;1;  ;EQSTR(MERCADO4,VAR('TCOPRIEPA')) y EqStr(TIPOOP,'TCOPRI') ;FechaVto2<=fechaVto y fechaVto2>=FechaOp;'fecha Incorrecta';;IF(FECHAVTO>FECHAOP,HABILES(FECHAOP,(PLAZO DIV 24)-1,TABLAFERIADOS1,SI),FECHAOP);IF(FECHAVTO>FECHAOP,HABILES(FECHAOP,(PLAZO DIV 24)-1,TABLAFERIADOS1,SI),FECHAOP)
