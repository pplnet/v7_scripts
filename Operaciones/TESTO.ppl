*Precio1        : 'Precio (entero)'; ; ; ;Not EV y PASECB=0 y (Vacio(NRORDEN1) o CB10=1) y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];;PRECIO1>0;'Debe ingresar un precio positivo';NO;;IF(VPRE21=1 y CB5=0 y CB2=0 y PaseCB=0 y Not [RB6=3 y NoVacio(NRORDEN1)],1-(TIPOCAMBIO/100*(FechaMaduracion(ESPECIE)-FECHAVTO)/360),PRECIO1);;;;;'####.########';
Precio1        : 'Precio (entero)'; ; ; ;Not EV y PASECB=0 y (Vacio(NRORDEN1) o CB10=1) y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];;PRECIO1>0;'Debe ingresar un precio positivo';NO;;IF(VPRE21=0 o CB5=1 o CB2=1 o PaseCB=1 o RB6=3 o NoVacio(NRORDEN1),PRECIO1,IF(VPRE21=1,1-(TIPOCAMBIO/100*(FechaMaduracion(ESPECIE)-FECHAVTO)/360),PRECIO1));;;;;'###,###,###.########';
Corredor       : 'Corredor'       ; ; ; ;Not EV y PASECB=0 y (Vacio(NRORDEN1) o CB10=1) y CB5=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];not EqStr(TIPOOP,'TCOPRI')

EsTBills       : 'T-Bill'         ;2;3; ;NO;NO;;;;;if(EqStr(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'TBL'),'SI','NO')

VTXT30         : 'TCOPRI Cont'    ;2;3; ;NO;Incluido(TIPOOP,'TCOPRI') y NO;;;;'NO';IF(Incluido(TIPOOP,'TCOPRI') y CB10=1,'SI','NO')
VCAN30         : 'Plazo orden'    ;3;3; ;NO;Incluido(TIPOOP,'TCOPRI') y NO;;;;0;IF(EqStr(VTXT30,'SI') y NoVacio(NRORDEN1),BuscarCampo('ORDENES', 'Lotes', 'NrOrden', NRORDEN1),VCAN30);
VCAN31         : 'RB5 de orden'   ;4;3; ;NO;Incluido(TIPOOP,'TCOPRI') y NO;;;;0;IF(EqStr(VTXT30,'SI') y NoVacio(NRORDEN1),VCAN30/24,VCAN31);
Plazo          : 'Plazo'          ;3;2; ;NO;NO;;;;IF(RB5=0,0,IF(RB5=1,24,IF(RB5=2,48,IF(RB5=3,72,IF(RB5=4,96,RB5*24)))));IF(EV y Incluido(UDN2,VAR('RUECPC1')),PLAZO,IF(RB5=0,0,IF(RB5=1,24,IF(RB5=2,48,IF(RB5=3,72,RB5*24)))))
RB5            : 'Plazo|'~IF(Incluido(TIPOOP,'TCOPRI'),VAR('PLAZOTCOPR'),VAR('PLAZOLIQ')) ;3;2;;Not EV y CB5=0 y CB2=0 y EqStr(VTXT30,'NO');;RB5>=0;'Plazo Incorrecto';NO;0;IF(EqStr(VTXT30,'SI'),VCAN31,IF(EV y Incluido(UDN2,VAR('RUECPC1')),RB5,IF(CB5=1 o CB2=1 o RB6=3 o RB6=4 o PaseCB=1,RB5,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'0'),0,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'24'),1,IF(EqStr(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE),'48'),2,3))))))

UDN2           : 'Rueda MAE'      ;5;1;2;NO;NO;
FechaVto       : 'Fecha Liq.'     ;4;2;1;NO;  ;;;;HABILES(FECHAOP,(PLAZO DIV 24),TABLAFERIADOS1,SI);HABILES(FECHAOP,(PLAZO DIV 24),TABLAFERIADOS1,SI)
FechaPago      : 'Fecha Liq.Orig.';4;3;1;NO;FECHAPAGO<>FECHAVTO;;;;;FECHAVTO
