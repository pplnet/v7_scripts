DDJJTipoCli:   'TipoCli DDJJ'  ;20;3;1;NO;EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),if(DESCIENDEDECLIENTE(CLIENTE1,'VINCULADOS'),'VIN',''))
%%ifdef MLASA
  DDJJTipoEsp:   'TipoEsp DDJJ'  ;21;3;1;NO;EqStr(DDJJRequiere,'SI');;;;;if(EqStr(DDJJRequiere,'SI'),if(EqStr(BuscarCampo('ESPECIES','TipoTitulo','Codigo',ESPECIE),'BP'),'BOP',''))
%%else
