FormaLiquidacion1:'Liquid.CV|STD|DVP|RVP'     ;6;2; ;Not EV y PASECB=0 y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]] y Vacio(NRORDEN1)                                                ;INCLUIDO(MERCADO,VAR('MERCADOCV'));                                                                                                     ;                                ;  ;0                                         ;IF(EqStr(TIPOOP,'TCOPRI') y NoVacio(NRORDEN1),BuscarCampo('ORDENES','RB9','NrOrden',NRORDEN1),IF(CB5=1 o PaseCB=1 o [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)],FORMALIQUIDACION1,IF(Incluido(MERCADO,VAR('MERCAVARI')),IF(MODI,FORMALIQUIDACION1,0),0)));
*FormaLiquidacion2:'Liquid.Otros|FD&&P|DVP|FOP';6;2; ;Not EV y PASECB=0 y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]] y Vacio(NRORDEN1) y [NOT INCLUIDO(MERCADO,VAR('MERCAACMC')) o SI];Incluido(MERCADO,VAR('MERCAVARI'));EV o NOT Incluido(MERCADO,VAR('MERCAVARI')) O FORMALIQUIDACION2>0 o [EqStr(TIPOOP,'TCOPRI') y CB10=1];'Liquidacion no puede ser FD&&P';NO;IF(Incluido(MERCADO,VAR('MERCAVARI')),1,0);IF(CB5=1 o PaseCB=1 o [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)],FORMALIQUIDACION2,IF(Incluido(MERCADO,VAR('MERCAVARI')),IF(MODI,FORMALIQUIDACION2,1),1));
FormaLiquidacion2:'Liquid.Otros|FD&&P|DVP|FOP';6;2; ;Not EV y PASECB=0 y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]] y Vacio(NRORDEN1) y [NOT INCLUIDO(MERCADO,VAR('MERCAACMC')) o SI];Incluido(MERCADO,VAR('MERCAVARI'));EV o NOT Incluido(MERCADO,VAR('MERCAVARI')) O FORMALIQUIDACION2>0 o [EqStr(TIPOOP,'TCOPRI') y CB10=1];'Liquidacion no puede ser FD&&P';NO;IF(Incluido(MERCADO,VAR('MERCAVARI')),1,0);IF(EqStr(TIPOOP,'TCOPRI') y NoVacio(NRORDEN1),BuscarCampo('ORDENES','RB10','NrOrden',NRORDEN1),IF(CB5=1 o PaseCB=1 o [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)],FORMALIQUIDACION2,IF(Incluido(MERCADO,VAR('MERCAVARI')),IF(MODI,FORMALIQUIDACION2,1),1)));

TipoCambio     : 'Tasa'           ;7;2; ;Not EV y VPRE21=1 y PASECB=0;VPRE21=1;;;;;IF(VPRE21=1,(1-PRECIO1)*36000/(FechaMaduracion(ESPECIE)-FECHAVTO),0)

TotalBrutoCli1 : 'Monto'          ; 7;1; ;NO;;;;;;IF(PaseCB=1,TOTALBRUTOCLI1,IF(Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE'),PRECIO1*CANTIDAD*ValorTeorico2(ESPECIE,FECHAVTO),PRECIO1*CANTIDAD));

