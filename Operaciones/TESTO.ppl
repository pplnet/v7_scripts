CAMPOS:2;;1;

* Llevar veriable MERLIQBYMA
* Llevar veriable NOMERCADO
FechaOp        : 'Fecha Op.'      ;2;2;1;Not EV y VerificaAcceso('OPFVALOR') Y PASECB=0 y (Vacio(NRORDEN1) o CB10=1) y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];;FechaOp <= FSys y [[FinDeMes(FECHAOP)<>FinDeMes(FSys) y FECHAOP>= Habiles(FSys,-Var('FVALORMAX'),'ARG')] o [FinDeMes(FECHAOP)=FinDeMes(FSys)]] y EsHabil(FECHAOP,'ARG');'Fecha incorrecta';NO;FSYS;
Especie        : 'Especie'        ;1;1; ;Not EV y Vacio(NRORDEN1) y [[CB5=0 y CB2=0] o Vacio(ESPECIE) o MODI] y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'TITULO') y  EsTerminal(ESPECIE, Especie);'Debe Ingresar una Especie Valida';NO;;IF(NoVacio(NRORDEN1),BuscarCampo('ORDENES','Especie','NrOrden',NRORDEN1),ESPECIE);;Var('LE'~USUARIOACTIVO);;;;"Status = 'HAB'"
EnteCus1       : 'CodMAE'         ;1;2;1;NO;NOT EQSTR(MERCADO4,VAR('AMBBYMA'));;;;IF(CB5=1,ENTECUS1,BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE));IF(CB5=1,ENTECUS1,BuscarCampo('ESPECIES','CodMAEContado','Codigo',ESPECIE))
VTXT8          : 'ZeroCoupon'     ;1;3;1;NO;EqStr(VTXT8,'SI') y NO;;;;BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE);BuscarCampo('ESPECIES','ZeroCoupon','Codigo',ESPECIE);;;;;'XX';
VTXT9          : 'Especie 2'      ;1;2;2;NO;NoVacio(VTXT9);;;;BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',ESPECIE));BuscarCampo('ESPECIES','Codigo','CodNumCajaValores',BuscarCampo('ESPECIES','Alias8','Codigo',ESPECIE));;;;;'######';
CB2            : VAR('SISEXT1')   ;4;1;2;NO;;;;;0;
CB5            : 'Siopel'         ;5;1;2;NO;;;;;;
Cliente1       : 'Cliente'        ;2;1;1;[Not EV o [EQSTR(VAR('BOOK'),'1') y VACIO(CLIENTE1)]] y Vacio(NRORDEN1) y [[CB5=0 y CB2=0] o EqStr(CLIENTE1,'SIOPEL') o Vacio(CLIENTE1) o MODI] y [Vacio(NRORDEN1) o SI] y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];;[NOT DESCIENDEDECLIENTE(CLIENTE1,'OTROS') y EsTerminal(CLIENTE1,Cliente) y NoVacio(CLIENTE1)];'El Cliente no es valido.';NO;;IF(NoVacio(NRORDEN1),if(EqStr(TIPOOP,'TCOPRI') y (VCAN1=1 o EqStr(VTXT20,VTXT21)),if(EqStr(CLIENTE1,VAR('VEHICULODE')),CLIENTE1,QUERY("SELECT Cliente1 From "~DBO~".OPERACIONES WHERE NrOperacion=(SELECT NrOperacion1 FROM "~DBO~".ORDENES WHERE NrOrden='"~NRORDEN1~"' )")),BuscarCampo('ORDENES','Cliente','NrOrden',NRORDEN1)),CLIENTE1);;Var('LC'~USUARIOACTIVO);;;;"Status = 'HAB' "
VTXT17         : 'ClienteCP'      ;2;3;1;NO;NO;;;;'0';QUERY("Select '1' from "~DBO~".CLIENTES where Codigo='"~CLIENTE1~"' and (Alias1='CP' or Codigo = '"~VEHICULO1~"') ")
VTXT12         : 'NrMAE'          ;2;1; ;NO;NO;;;;;BuscarCampo('CLIENTES','NrMAE','Codigo',CLIENTE1)
Cantidad       : 'Cantidad'       ; ; ; ;Not EV y PASECB=0 y (Vacio(NRORDEN1) o CB10=1) y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];;CANTIDAD>0;'La Cantidad debe ser positiva';NO;
