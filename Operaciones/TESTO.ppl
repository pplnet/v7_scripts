ParkAfecta:   'Afecta.Park.'  ;19;2;1;NO;NO;;;;;if(Not EqStr(Var('PARKINGFUL'),'SI') o Vacio(ParkMoneda) o Vacio(ParkJuris) o PARKNRSALDO=0 o EqStr(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'TBL'),'NO','SI')

DDJJRequiere:  'Requiere DDJJ' ;20;1;1;NO;SI;;;;;if(Not EqStr(Var('DDJJPARK'),'SI') o Not Incluido(CONTRAESPECIE,'USD') o DESCIENDEDECLIENTE(CLIENTE1,'BANCOS'),'NO','SI')
