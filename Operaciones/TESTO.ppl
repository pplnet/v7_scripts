TotalIntereses : 'Interes'        ;9;1; ;NO;[Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',ESPECIE),'CLE') o Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE')  ];(Vacio(NRORDEN1) o CB10=1) y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];'No esta vacio el atributo';;;IF(VPRE16=0, (VPRE1*VPRE7)+(VPRE1*VPRE15*PRECIO1), VCAN33-(CANTIDAD*PRECIO1))

TotalAux8      : 'Cot.MEmis'      ; 7;2; ;[Not EV o EQSTR(VAR('BOOK'),'1')];NOVACIO(BOOK1) y Not EQSTR(VTXT14,CONTRAESPECIE) y [Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',ESPECIE),'CLE') o Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE')];[TOTALAUX8>0] O EQSTR(VTXT14,CONTRAESPECIE) O [Not Eqstr(BuscarCampo('ESPECIES','CotizaMAE','Codigo',ESPECIE),'CLE') Y Not Eqstr(BuscarCampo('ESPECIES','InteresesC','Codigo',ESPECIE),'CLE')];'Debe ingresar una Cotizacion de la Moneda de Emision en ContraEspecie';NO;;COTIZACIONC(VTXT14,,,,FECHAOP,1,SI,CONTRAESPECIE);;;;;'####.########';
Mercado4       : 'Merc.Negoc.'    ;10;1; ;CB5=0 y Not[Incluido(TIPOOP,'TCOPRI') y NoVacio(NRORDEN1)];;NOVACIO(MERCADO4) y EqStr(BuscarCampo('MERCADOS','EsNegociacion','Codigo',MERCADO4),'SI');'Debe indicar Merc. de Negociacion';NO;VAR('MERCANEG');IF(Incluido(TIPOOP,'TCOPRI') y NoVacio(NRORDEN1),BuscarCampo('ORDENES','Mercado4','NrOrden',NRORDEN1),IF(CB5=1 o RB6=0 o RB6=3 o RB6=4 o PaseCB=1 o [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)],MERCADO4,IF(MODI,MERCADO4,IF(EqStr(ESTBILLS,'SI'),BuscarCampo('ESPECIES','MercadoNeg','Codigo',ESPECIE),BuscarCampo('TIPOSNEGOCIO','Mercado','Codigo',BuscarCampo('TIPOSOPERACION','TipoNegocio','Codigo',TIPOOP))))));;;;;;" IsNull(EsNegociacion,'NO') = 'SI' "
Plataforma     : 'Plataforma'     ;10;2; ;EqStr(MERCADO4,VAR('AMBMAE'));EqStr(MERCADO4,VAR('AMBMAE'));(EqStr(MERCADO4,VAR('AMBMAE')) y Incluido(PLATAFORMA,'SIOPEL|'~Var('PLATAA3'))) o (Not EqStr(MERCADO4,VAR('AMBMAE')) y Vacio(PLATAFORMA));'Plataforma Invalida';NO;IF(EqStr(MERCADO4,VAR('AMBMAE')),Var('PLATAA3'),'');IF(EqStr(MERCADO4,VAR('AMBMAE')),Var('PLATAA3'),'');;'SIOPEL|'~Var('PLATAA3');
EstadoA3       : 'Estado'         ;10;3; ;NO;EqStr(MERCADO4,VAR('AMBMAE'));;;;;IF(EqStr(MERCADO4,VAR('AMBMAE')),'PEN','')
Mercado        : 'Merc.Liq.Esp.'  ;11;1; ;Not EV y not [EqStr(TIPOOP,'TCOPRI') y CB10=0] y PASECB=0 y [CB5=0 o Vacio(MERCADO) o MODI];  ;NOVACIO(MERCADO) y EqStr(BuscarCampo('MERCADOS','EsLiquidacion','Codigo',MERCADO),'SI') y Incluido('T',BuscarCampo('MERCADOS','Observaciones','Codigo',MERCADO)) y [ [Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1),VAR('TCLIMC')) Y Incluido(MERCADO,VAR('MERCAACMC')) o [Not Incluido(MERCADO,VAR('MERCAACMC'))]] o SI ];'Debe indicar mercado Correcto';NO;;IF(EqStr(TIPOOP,'TCOPRI'),VTXT22,IF((CB5=1 o PaseCB=1 o RB6=2 o RB6=3 o RB6=4 o [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)]) y NOVACIO(MERCADO),MERCADO,IF(EqStr(MERCADO4,VAR('AMBBYMA')),COPY(VAR('MERLIQBYMA'),1,2),IF(NoVacio(ESPECIE),MercadoDef(ESPECIE)))));;;;;;"Observaciones Like '%T%' and IsNull(EsLiquidacion,'NO') = 'SI' "
