ContraEspecie  : 'ContraEspecie'  ;6;1; ;Not EV y PASECB=0 y (Vacio(NRORDEN1) o CB10=1) y CB5=0 y CB2=0 y [Not [CB4=1 o EQSTR(CLIENTE1,VEHICULO1)] o [EqStr(TIPOOP,'TCOPRI') y CB10=1]];  ;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y EsTerminal(CONTRAESPECIE, Especie);'Debe ingresar una ContraEspecie';NO;;IF(CB5=1 o CB2=1 o RB6=3 o RB6=4 o PaseCB=1,CONTRAESPECIE,IF(EV o MODI,CONTRAESPECIE,COTIZAEN(ESPECIE)));;;;;;"Status='HAB' And (Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' And Jerarquia Not Like '"~Jerarquia('ESPECIES','MROFEX')~"%') "
