VCAN33         : 'Neto s/Com'     ;8;1; ;NO;NO;;;;;if(Incluido(BuscarCampo('ESPECIES','Alias4','Codigo',ESPECIE),'1585'),(TOTALBRUTOCLI1*IF(VPRE16=0,1,(1+IntsCapitalizados2(ESPECIE,FECHAVTO))))+If(EqStr(VTXT3,'CLE'),(VCAN22*PRECIO1)),(TOTALBRUTOCLI1*IF(VPRE16=0,1,(1+IntsCapitalizados2(ESPECIE,FECHAVTO))))+If(EqStr(VTXT3,'CLE'),VCAN22));
