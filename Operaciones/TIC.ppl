BAJA
Vacio(NrOrden1) y Vacio(QUERY("Select NrOperacion from "~DBO~".PARTIDAS where NrOperacion='"~NROPERACION~"' "));'No se puede dar de baja, tiene una orden o partida asignada';

SQL:EqStr(ABM,'E')
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "

NOTIFICACION
EqStr(abm,'A');'ALTA';NrOperacion=NROPERACION;_sev=info;_msg='Operación creada por '~USUARIOACTIVO;
EqStr(abm,'E');'EDICION';NrOperacion=NROPERACION;_sev=warning;_msg='Operación editada por '~USUARIOACTIVO;;
EqStr(abm,'D');'BAJA';NrOperacion=NROPERACION;_sev=error;_msg='Operación borrada por '~USUARIOACTIVO;
EqStr(CLIENTE1,'0000087') y EqStr(abm,'A');'ALTA87';NrOperacion=NROPERACION;_sev=info;_msg='Operación de Cliente '~CLIENTE1~ 'creada por '~USUARIOACTIVO;

MOVIMIENTOS
FechaVto;Cliente1;Especie      ;;;;                                                                    Mercado;  Vehiculo1;1;      -Cantidad;;'Compra de '~Especie            ;SI;NO;1;NOVACIO(CLIENTE1) y   Vacio(NRORDEN1)                               ;;Cuenta1;;1;'TI';IF(Incluido(Mercado,VAR('MERCACV')),IF(FormaLiquidacion1=1,'CONF',IF(FormaLiquidacion1=2,'RVP' )),IF(FormaLiquidacion2=1,IF(Eqstr(CUENTA1,CUENTA4) y Eqstr(CUENTA2,CUENTA3),'MATCH')));Cupon1;;;;Book1;
