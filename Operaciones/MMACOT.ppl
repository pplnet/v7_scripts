CAMPOS:1;;BuscarCampo('VEHICULOS','Alias1','Codigo',Vehiculo1)
FechaOp2        : 'Fecha Conc.'                ; 1;1; ;VERIFICAACCESO('OPFVALOR');;FECHAOP2<=FECHAOP;'Fecha incorrecta';NO;FSYS;
FechaOp         : 'Fecha_Origen'               ; 2;1; ;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha de Origen Incorrecta';RB11 = 0;FSYS;
Vehiculo1 : 'Vehiculo'    ; 1;2;1;(Not (RB4=0 Y Incluido(TIPOOP,Var('OPPROINV')~VAR('OPSOLFON')))) Y (NOT EV y EqStr(ABM,'A'));;NOVACIO(VEHICULO1) Y  Incluido(VEHICULO1,SqlSet("Select Codigo from "~DBO~".VEHICULOS WHERE Codigo = '"~Vehiculo1~"' and Status ='HAB' ")) y [Vacio(UsrVehiculos(UsuarioActivo)) o Incluido(VEHICULO1,SqlSet("Select Vehiculo From "~DBO~".USRVEHICULO Where Codigo = '"~UsuarioActivo~"'"))];'El VEHICULO es INVALIDO';NO;; IF[Vacio(NRORDEN),(IIF([Incluido(TIPOOP,'MMPRCO|MMPREC') o [Incluido(TIPOOP,'SECS|SEVS|SECSV|SEVSV|FXCS|FXVS|FXCSV|FXVSV|FCCPV|FCVPV')   y CB13=1]] THEN BuscarCampo('OPERACIONES','Vehiculo1','NrOperacion', NROPERACION5)   ELSE IF(Incluido(TIPOOP, 'MMONRE'), OPREF.VEHICULO1) ENDIF)),BuscarCampo('ORDENES','Vehiculo','NrOrden',NRORDEN)];;;;;;;IF(Vacio(UsrVehiculos(UsuarioActivo)),  " Status ='HAB' " ,  " Codigo IN (Select Vehiculo from "~DBO~".USRVEHICULO where Codigo = '"~UsuarioActivo~"')")
Book1     : 'Book'        ; 2;2;1;(Not (RB4=0 Y Incluido(TIPOOP,Var('OPPROINV')~VAR('OPSOLFON')))) Y (Not Incluido(TIPOOP, 'MMPRCO|MMPREC|MMONRE|SECS|SEVS|SECSV|SEVSV|FXCS|FXVS|FXCSV|FXVSV|FCCPV|FCVPV') o [Incluido(TIPOOP,'SECS|SEVS|SECSV|SEVSV|FXCS|FXVS|FXCSV|FXVSV|FCCPV|FCVPV') y CB13=0]);;[SI O BookValido(BOOK1, TIPOOP, ESPECIE, VEHICULO1, OPERADOR,'')] Y NoVacio(BOOK1) Y ((RB4=1 Y Not Eqstr(BuscarCampo('BOOKS','CB1','Codigo',BOOK1),'SI')) O RB4=0);IF(RB4=1 Y Eqstr(BuscarCampo('BOOKS','CB1','Codigo',BOOK1),'SI'),'Este Book solo puede operar con instrucci?n del Fiduciante','Book Invalido');NO;IF[Vacio(NRORDEN),BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1),BuscarCampo('ORDENES','Book1','NrOrden',NRORDEN)];IF[Vacio(NRORDEN),(IIF([Incluido(TIPOOP,'SECS|SEVS|SECSV|SEVSV|FXCS|FXVS|FXCSV|FXVSV|FCCPV|FCVPV') y CB13=1] THEN BuscarCampo('OPERACIONES','Book1','NrOperacion', NROPERACION5) ELSE BuscarCampo('VEHICULOS','Alias5','Codigo',VEHICULO1) ENDIF)),BuscarCampo('ORDENES','Book1','NrOrden',NRORDEN)] ;;;;;;" Vehiculo='"~VEHICULO1~"' AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
RB4      : 'Origen|Orden|Rebalanceo' ;2;3;1;;;RB4>=0;'Debe Seleccionar el Origen de la Operacion';NO;0;;;;;;;;;;
NrOrden  : 'Nr. Orden'               ;3;3;1;RB4=0 y Eqstr(ABM,'A');RB4=0;RB4=1 O [IF(INCLUIDO(TIPOOP,VAR('OPPROINV')),IF(INCLUIDO(TIPOOP,VAR('OPORDNOPLA')),FECHAVTO=BuscarCampo('ORDENES','FechaEjercicio','NrOrden',NRORDEN),FECHAOP=BuscarCampo('ORDENES','FechaEjercicio','NrOrden',NRORDEN) Y FECHAVTO<=FECHAOP+BuscarCampo('ORDENES','Plazo1','NrOrden',NRORDEN)), FECHAVTO<=BuscarCampo('ORDENES','FechaEjercicio','NrOrden',NRORDEN))];IF(RB4=0,IF(INCLUIDO(TIPOOP,VAR('OPPROINV')),IF(INCLUIDO(TIPOOP,VAR('OPORDNOPLA')),'La fecha de vencimiento debe ser igual a la fecha ejercicio de la orden','La fecha de concertacion debe ser igual a la fecha ejercicio de la orden, y la fecha de vencimiento debe ser menor o igual a la fecha de concertacion m?s el plazo de la orden'),'La fecha de vencimiento debe ser menor o igual a la fecha ejercicio de la orden'));NO;;IF(RB4=0 Y [[Incluido(TIPOOP, Var('OPPROINV')) Y [[INCLUIDO(TIPOOP,VAR('OPORDNOPLA')) Y FECHAVTO=BuscarCampo('ORDENES','FechaEjercicio','NrOrden',NRORDEN)] O [Not INCLUIDO(TIPOOP,VAR('OPORDNOPLA')) Y FECHAOP=BuscarCampo('ORDENES','FechaEjercicio','NrOrden',NRORDEN) Y FECHAVTO<=FECHAOP+BuscarCampo('ORDENES','Plazo1','NrOrden',NRORDEN)]]] O [Not Incluido(TIPOOP, Var('OPPROINV')) Y FECHAVTO<=BuscarCampo('ORDENES','FechaEjercicio','NrOrden',NRORDEN)]],NRORDEN,'');;;;;;IF(Incluido(TIPOOP, Var('OPPROINV')),IF(INCLUIDO(TIPOOP,VAR('OPORDNOPLA')),"FechaEjercicio='"~IdxDate(FECHAVTO)~"' AND TipoOrden = 'PROINV' AND CantidadCompletada < (CantidadTotalOrden+(CantidadTotalOrden/"~VAR('PORDESORD')~")) AND NrOrden IN (SELECT NrOperacion FROM "~DBO~".OPERACIONESBITS WHERE Valor = 1 AND NrBit >= 15) ","FechaEjercicio='"~IdxDate(FECHAOP)~"' AND FechaEjercicio+Plazo1>='"~IdxDate(FECHAVTO)~"' AND TipoOrden = 'PITEST' AND CantidadCompletada < (CantidadTotalOrden+(CantidadTotalOrden/"~VAR('PORDESORD')~")) "),"FechaEjercicio>='"~IdxDate(FECHAVTO)~"' AND TipoOrden = 'SOLFON' AND CantidadCompletada < (CantidadTotalOrden+(CantidadTotalOrden/"~VAR('PORDESORD')~")) AND NrOrden IN (SELECT NrOperacion FROM "~DBO~".OPERACIONESBITS WHERE Valor = 1 AND NrBit >= 15)");
Operador        :                              ;  ;2; ;NO;  ;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;

Especie         : 'Moneda'                     ;5 ;1; ;Not (RB4=0 Y Incluido(TIPOOP,Var('OPPROINV')~VAR('OPSOLFON'))) Y NOT EV;;NOVACIO(ESPECIE) y DESCIENDEDEESPECIE(ESPECIE,'MONEDA') y ESTERMINAL(ESPECIE, ESPECIE);'Debe Ingresar una Moneda ';NO;;IF[NoVacio(NrOrden),BuscarCampo('ORDENES','Especie','NrOrden',NRORDEN)];;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";
Cliente1        : 'Entidad'                    ; 3;1; ;Not (RB4=0 Y Incluido(TIPOOP,Var('OPPROINV')~VAR('OPSOLFON'))) Y NOT EV;;NOVACIO(CLIENTE1);'La Entidad Contratante ES INCORRECTA';NO;;IF[NoVacio(NrOrden),BuscarCampo('ORDENES','Cliente','NrOrden',NRORDEN)];;;;;;"Status = 'HAB'";;;;
Cantidad        : 'Valor Nominal'              ;6 ;1; ;NOT EV;;CANTIDAD>0;IF(RB4=0 y Eqstr(ABM,'A'),'El Valor Nominal Supera a la Cantidad Completada de la Orden o no es positivo','El Valor Nominal DEBE SER POSITIVO');NO;;;;;;;'###,###,###,###,###.##'
Plazo           : 'Plazo'                      ;  ; ; ;  ;  ;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
FechaVto        : 'Fecha_Vto'                  ;  ; ; ;NO;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1);'La Fecha de Vencimiento NO ES DIA HABIL';RB11 = 0;FECHAOP;FECHAOP+PLAZO
TablaFeriados1  : 'Feriados'                   ;10; ; ;  ;  ;NOVACIO(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO; IF(EQSTR('USA',BuscarCampo('Clientes','Pais','Codigo',CLIENTE1)),'USA','ARG');IF(EQSTR('USA',BuscarCampo('Clientes','Pais','Codigo',CLIENTE1)),'USA','ARG')

@CUENTAS

CONDICIONES
@ORCCCA

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador
Not EqStr(CB9,'1');'La operacion debe ser eliminada a trav?s del proceso de anulacion de plazo fijo'

POSTEDICION
NoVacio(NRORDEN) Y Not EqStr(ABM,'D');'ACTEJE';NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1=CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=CANTIDAD;Radio1=0
NoVacio(NRORDEN) Y EqStr(ABM,'D');'ACTEJE';NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1=CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=CANTIDAD;Radio1=1

BITS
1;1