Precio2        : 'TES (%)'        ;14;1; ;NO;  ;;;;;Precio1/(if(DiasAnio=0,360,365)/PLAZO);;;;;'####.######';
Precio3        : 'TEA (%)'        ;15;1; ;NO;  ;;;;;(((1+(PRECIO2/100))^(if(DiasAnio=0,360,365)/PLAZO))-1)*100;;;;;'####.######';
Precio4        : 'CFT (%)'        ;16;1; ;NO;  ;;;;;(((1+(((CANTIDAD*PRECIO2+TOTALAUX1*100)/CANTIDAD)*(if(DiasAnio=0,360,365)/PLAZO))/100*PLAZO/if(DiasAnio=0,360,365))^(if(DiasAnio=0,360,365)/PLAZO))-1)*100;;;;;'####.######';
Plazo          :                  ; 4;2; ;CB5=0;  ;PLAZO>0 y [Plazo<=BuscarCampo('VARIABLES','Valor','Codigo','PLAMAXCAU') o QUERY("SELECT 1 FROM "~DBO~".VARIABLES WHERE Codigo= 'PLAMAXCAU' ")=0];'El plazo fuera de rango';NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP;
FechaVto       : 'Fecha Vto.'     ; 5;2; ;CB5=0;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1) Y [ESHABIL(FECHAVTO,'USA') O EQSTR(ESPECIE,'ARP')];'No es un dia habil';NO;HABILES(FECHAOP,1,TABLAFERIADOS1,NO);FECHAOP+PLAZO
MB1      : 'Liquidacion|Com.|Liq.'; 6;2; ;  ;NOVACIO(OPERACIONREF);;;;0;
TotalIntereses : 'Interes'        ; 5;1; ;NO;  ;;;;;CANTIDAD*PRECIO1*PLAZO/If(DIASANIO=0,36000,36500);
TotalBrutoCli1 : 'Monto'          ; 6;1; ;NO;  ;;;;;CANTIDAD+TOTALINTERESES;
DiasAnio       : 'Base|360|365'   ; 7;1; ;CB5=0;  ;;;;1
Mercado        : 'Merc.Especie'   ; 7;2; ;  ;  ;NOVACIO(MERCADO);'Debe indicar mercado';NO;VAR('ENTELIQA3');if(MODI o SI,MERCADO,BuscarCampo('ESPECIES','MercadoDef','Codigo',ESPECIE));;;;;;"Observaciones Like '%M%' "
Mercado2       : 'Merc.Moneda'    ; 7;2; ;NO;NO;                ;                      ;  ;MERCADO;MERCADO;;;;;;"Observaciones Like  '%M%'"
Corredor       : 'Corredor'       ; 8;1; ;  ;  ;
MB2            : 'Agrede |SI|NO'  ; 8;2; ;NoVacio(CORREDOR);NoVacio(CORREDOR);;;;1;IF(Vacio(CORREDOR),1,MB2);

