VCAN13         : 'BCRA Gar Ant.'  ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;IF(EqStr(VEHICULO1,VAR('VEHICULODE')),LIMCONSUMIDO(CLIENTE1,'BCRAG','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP)+LIMCONSUMIDO(CLIENTE1,'ACIDG','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP)+LIMCONSUMIDO(CLIENTE1,'ACCOG','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP),0);
VCAN5          : 'Total BCRA Gar' ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;IF(EqStr(VEHICULO1,VAR('VEHICULODE')),VCAN3+VCAN12+VCAN13,0);
VPRE15         : '% RPC Gar'      ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;IF(EqStr(VTXT7,'VAC'),Var('BCFRAGVAC'),IF(EqStr(VTXT7,'VIN'),Var('BCFRAGVIN'),IF(EqStr(VTXT8,'CIG'),Var('BCFRAGCIG'),IF(EqStr(VTXT8,'CNIG'),Var('BCFRAGNIG'),IF(EqStr(VTXT9,'BAN'),Var('BCFRAGF'),Var('BCFRAGNF'))))))
VCAN15         : 'Lim RPC Gar'    ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;VCAN16*VPRE15/100;
VPRE17         : '% Tope Maximo'  ;15;1;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;Var('BCGRATMAX')
VPRE18         : '% Tope Minimo'  ;15;1;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;Var('BCGRATMIN')
VPRE19         : '% RPC Grad'     ;15;1;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;Var('BCGRARPC')
VCAN18         : 'Tope Maximo'    ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;VCAN17*VPRE17/100
VCAN19         : 'Tope Minimo'    ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;VCAN17*VPRE18/100
VCAN20         : 'RPC Grad'       ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;BuscarCampo('CLIENTES','Valor3','Codigo',VEHICULO1)*VPRE19/100
ContraEspecie  : 'ContraEspecie'  ;15;2;2;NO;NO;;;;;ESPECIE;;;;;;

VTXT10         : 'Vehiculo'       ;13;2;2;NO;NO;;;;;if(VACIO(BuscarCampo('BOOKS','Vehiculo','Codigo',BOOK1)),'',BuscarCampo('BOOKS','Vehiculo','Codigo',BOOK1));
Cartera        : 'Cartera|Trading|Investment|Comerc';13;2;2;NO;NO;;;;0

VTXT11         : 'Controlante'    ;14;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~CLIENTE1~"' "))
VCAN1          : 'Afect.DueFrom'  ;14;2;2;NO;NO;;;;;IF( NOVACIO(OPERACIONREF) Y MB1=0 , IF(CANTIDAD>OPREF.CANTIDAD, IF(EQSTR(ESPECIE,'USD'),(CANTIDAD-OPREF.CANTIDAD),(CANTIDAD-OPREF.CANTIDAD) *COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD') ),0) , IF(EQSTR(ESPECIE,'USD'),CANTIDAD,CANTIDAD *COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD')) ) ;

VCAN2          : 'Total.DueFrom'  ;15;2;2;NO;NO;;;;;VCAN1+LimSumado(CLIENTE1,'DFROM',-1,VEHICULO1,,,NROPERACION)

CONDICIONES:

SI o TASABASE>0;'La Tasa base NO puede ser Negativa o Cero';NO
Not FECHAOP<FSYS o EV;'Es una Operacion FechaValor';SI;SI;FSYS;'FVALOR'
SI o [PRECIO1<=TASABASE*(1+VAR('RTASA1')/100) Y PRECIO1>=TASABASE*(1-VAR('RTASA1')/100)];'Tasa Fuera de Rango: '~FSTR(TASABASE*(1-VAR('RTASA1')/100),1,7)~' y '~FSTR(TASABASE*(1+VAR('RTASA1')/100),1,7);SI;SI;Fsys;'RANGOTASA';

VACIO(CLIENTE1) o ExisteLimite('DFROM',Cliente1,'USD',Vehiculo1)                                                   ; 'Due From Cliente no asignado'   ;SI;SI;FSYS;'DFROMNOAS'
VACIO(CLIENTE1) o LimOperativo(Cliente1,'DFROM','USD',Vehiculo1)   >= VCAN1+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)  ; 'Due From Cliente excedido en U$D '~PYC(VCAN1+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(Cliente1,'DFROM','USD',Vehiculo1),1,0)~'.-'   ;SI;SI;FSYS;'DFROMEXCE'
VACIO(CLIENTE1) o BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1) >= FechaOp; 'Review date Cliente vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1));SI;SI;FSYS;'RDATEVENC'

VACIO(VTXT11) o ExisteLimite('DFROM',VTXT11,'USD',Vehiculo1)                                                   ; 'Due From Controlante '~VTXT11~' no asignado'   ;SI;SI;FSYS;'DFROMNOAS'
VACIO(VTXT11) o LimOperativo(VTXT11,'DFROM','USD',Vehiculo1)   >= VCAN1+LimConsumido(VTXT11,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)  ; 'Due From Controlante '~VTXT11~' excedido en U$D '~PYC(VCAN1+LimConsumido(VTXT11,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(VTXT11,'DFROM','USD',Vehiculo1),1,0)~'.-'   ;SI;SI;FSYS;'DFROMEXCE'
VACIO(VTXT11) o BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT11) >= FechaOp; 'Review date Controlante '~VTXT11~' vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT11));SI;SI;FSYS;'RDATEVENC'

Precio1 >= 0;'La tasa debe ser mayor a cero';NO

Not EqStr('DES',BuscarCampo('ESPECIES','Status','Codigo',ESPECIE));'La Especie esta deshabilitada';NO

[EQSTR(ESPECIE,'ARP') Y PRECIO1>=0] O [Not EQSTR(ESPECIE,'ARP') y PRECIO1>0];'La Tasa NO puede ser negativa';NO

[Eqstr(Especie,Opref.Especie)] o [Not NoVacio(OperacionRef)];'No coincide la especie con la operacion de referencia';NO
[Eqstr(Cliente1,Opref.Cliente1)] o [Not NoVacio(OperacionRef)];'No coincide el cliente con la operacion de referencia';NO
[FechaOp=Opref.FechaVto] o [Not NoVacio(OperacionRef)];'La operacion de referencia no ha vencido aun';NO
[Not NoVacio(OperacionRef)] o [EqStr(BuscarCampo('OPERACIONES', 'RB6', 'NrOperacion', OPERACIONREF),'0')];'La operacion de referencia debe estar pendiente';NO

Not EqStr('DES',BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO

Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado));'Ingreso un Mercado de Titulos para el Mercado de Especie';NO 
SI o Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado2));'Ingreso un Mercado de Titulos para el Mercado de Moneda';NO 

SI o Vacio(Query("Select Valor from "~DBO~".VARIABLES Where Codigo='TRADOVNGT' "));pipe2coma(Query("Select Valor from "~DBO~".VARIABLES Where Codigo='TRADOVNGT' "))~' tienen todavia posiciones en Overnight.';SI

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO

LIMITES
Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);Cliente1;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'), CANTIDAD, CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'))                                  ;TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;;;;;;;;;;0;;;
FechaOp                                                              ;Cliente1;'DFROM';'USD'  ;;IF(EQSTR(ESPECIE,'USD'), (CANTIDAD-OPREF.CANTIDAD), (CANTIDAD-OPREF.CANTIDAD)*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));TipoOp~' '~Especie;NoVacio(CLIENTE1) y NOVACIO(OPERACIONREF) y MB1=0 y CANTIDAD>OPREF.CANTIDAD;Vehiculo1;;;;;;;;;;0;;;
