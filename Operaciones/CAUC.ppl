OperacionRef   : 'Op.Ref.'        ; 5;1;2;NO;VRB1=1;;;;;if(VRB1 =1,Query("Select NrOperacion from "~DBO~".OPERACIONES Where TipoOp = 'CAUC' and RB6 = '0' and Cliente1 = '"~CLIENTE1~"' and Especie = '"~ESPECIE~"' and FechaVto = '"~IDXDATE(FECHAOP)~"'"))
VTXT12         : 'Op.Ref.Ant.'    ; 6;1;2;NO;  ;;;;OPERACIONREF
