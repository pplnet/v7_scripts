VRB2           : 'Cross_S.P.|Cobro|Pago' ; 8;2;2;RB7=1 y EqStr('001001', VTXT13);RB7=1 y EqStr('001001', VTXT13);;;;0;if(RB7=0 o not EqStr('001001', VTXT13) o [Eqstr(copy(VTXT4,1,6),'002001') y not Incluido(ESPECIE, 'LEXP2|LEXP2|BTVA1|BTVA2|TAV2|TAV3|TAV4|')] o EqStr(Copy(VTXT4,1,9), '002004002'), 0, 1);
VPRE9          : 'H.Spread Def.'      ;11;2;2;EqStr(VTXT14, 'CLIENTE') o [EqStr(VTXT14,'EVENTUAL') y RB7=1];EqStr(VTXT14, 'CLIENTE') o [EqStr(VTXT14,'EVENTUAL') y RB7=1];;;;SPREAD;
Spread         : 'Hard Spread'        ;14;2;2;NO;NO;;;;;if(VRB2=0, abs(VPRE9), -abs(VPRE9));

