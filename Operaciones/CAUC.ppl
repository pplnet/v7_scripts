CAMPOS:2;;1
FechaOp        : 'Fecha Op.'      ; 3;2;1;CB5=0 y VerificaAcceso('OPFVALOR');;FechaOp <= FSys y FechaOp >= Habiles(FSys,-Num(Var('FVALORMAX')),'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
Especie        : 'Especie'        ; 1;1; ;CB5=0;  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA') y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Moneda Valida';NO;;IF(MODI,ESPECIE,OPREF.ESPECIE);;;;;;" Jerarquia like '001%' "
Cliente1       : 'Cliente'        ; 2;1; ;CB5=0;  ;NOVACIO(CLIENTE1) Y Incluido(BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1), SQLSet("SELECT Codigo FROM "~DBO~".CATEGORIACLIENTES WHERE Sector='FIN' "));'Debe ingresar un cliente Financiero';NO;;IF(MODI,CLIENTE1,OPREF.CLIENTE1);;;;;;" Status = 'HAB' AND  CategDepositante in(SELECT Codigo FROM "~DBO~".CATEGORIACLIENTES WHERE Sector='FIN' )" 

Cantidad       :                  ; 3;1; ;CB5=0;  ;CANTIDAD>0;'La Cantidad debe ser positiva';NO;
