VCAN16         : 'RPC'            ;14;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;BuscarCampo('CLIENTES','RPC','Codigo',VEHICULO1);
VCAN17         : 'Patrimonio'     ;15;2;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;BuscarCampo('CLIENTES','PatrimonioPesos','Codigo',CLIENTE1);
VTXT7          : 'AcComp.'        ;15;2;2;NO;NO;;;;;BuscarCampo('CLIENTES','ActComplementarias','Codigo',CLIENTE1)
VTXT8          : 'Alias7'         ;15;2;2;NO;NO;;;;;BuscarCampo('CLIENTES','Alias7','Codigo',CLIENTE1)
VTXT9          : 'CategDepos'     ;15;2;2;NO;NO;;;;;BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1)
VCAN12         : 'BCRA NGar Ant.' ;15;1;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;IF(EqStr(VEHICULO1,VAR('VEHICULODE')),LIMCONSUMIDO(CLIENTE1,'BCRAN','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP)+LIMCONSUMIDO(CLIENTE1,'ACIDN','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP)+LIMCONSUMIDO(CLIENTE1,'ACCON','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP)+LIMCONSUMIDO(CLIENTE1,'ACMAN','ARP',0,VEHICULO1,,,NROPERACION,FECHAOP),0);
VCAN4          : 'Total BCRA NGAr';15;1;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;IF(EqStr(VEHICULO1,VAR('VEHICULODE')),VCAN3+VCAN12,0);

VPRE14         : '% RPC NGar'     ;15;1;2;NO;NO y EqStr(VEHICULO1,VAR('VEHICULODE'));;;;;IF(EqStr(VTXT7,'VAC'),Var('BCFRANGVAC'),IF(EqStr(VTXT7,'VIN'),Var('BCFRANGVIN'),IF(EqStr(VTXT8,'CIG'),Var('BCFRANGCIG'),IF(EqStr(VTXT8,'CNIG'),Var('BCFRANGNIG'),IF(EqStr(VTXT9,'BAN'),Var('BCFRANGF'),Var('BCFRANGNF'))))))
