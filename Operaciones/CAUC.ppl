TotalBrutoCli2 : 'Cant.USD Equiv' ; 2;2;2;NO;  ;;;;;IF(EQSTR(ESPECIE,'USD'), CANTIDAD, CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));
