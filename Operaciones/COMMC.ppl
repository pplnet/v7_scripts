CAMPOS:1;;80

Especie        : 'Commodity'                  ;1;;;NOT EV;;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'COMMOD') y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Especie';NO;;;;;;;;"Status='HAB' and Jerarquia Like '"~Jerarquia('ESPECIES','COMMOD')~"%' "
Cliente1       : 'Cliente'                    ; ;;;NOT EV;;NOVACIO(CLIENTE1) y EsTerminal(CLIENTE1,Cliente);'El Cliente no es valido';NO;;;;;;;;"Status = 'HAB'"
Cantidad       : 'Cantidad'                   ; ;;;NOT EV;;CANTIDAD>0;'La Cantidad DEBE SER POSITIVA';NO;
Precio1        : 'Precio'                     ; ;;;;;PRECIO1 > 0;'El Precio Debe ser Positivo';NO;
ContraEspecie  : 'Especie Liq'                ; ;;;NOT EV;;NOVACIO(CONTRAESPECIE) y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') y ESTERMINAL(CONTRAESPECIE,ESPECIE);'Debe ingresar una ContraEspecie';NO;;IF(MODI,CONTRAESPECIE,COTIZAEN(ESPECIE));;;;;;"Status='HAB' And (Jerarquia Like '"~Jerarquia('ESPECIES','MONEDA')~"%' And Jerarquia Not Like '"~Jerarquia('ESPECIES','MROFEX')~"%') "
TotalBrutoCli1 : 'Monto'                      ; ;;;NOT EV;;;;NO;;CANTIDAD*PRECIO1

FechaOp        : 'Fecha Conc.'                ;2;2;;NOT EV y VERIFICAACCESO('OPFVALOR');;EsHabil(FECHAOP,'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
Plazo          : 'Plazo'                      ; ; ;;Not EV;;(PLAZO DIV 24)*24=PLAZO;'El plazo debe ser multiplo de 24';SI;0;IF(Vacio(BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE)),0,BuscarCampo('ESPECIES','PlazoLiq','Codigo',ESPECIE));
FechaVto       : 'Fecha Liq.'                 ; ; ;;NO;  ;;;;HABILES(FECHAOP,(PLAZO DIV 24),TABLAFERIADOS1,SI);HABILES(FECHAOP,(PLAZO DIV 24),TABLAFERIADOS1,SI)

Book1          : 'Book'                       ;7;1;;Not EV;;NoVacio(BOOK1);'Debe ingresar un Book';NO;;;;;;;;"Vehiculo='"~VEHICULO1~"' and "~"(TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%')"
Vehiculo1      : 'Vehiculo'                   ; ; ;;NOT EV;;NOVACIO(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE');

FormaLiquidacion1:'Liquidacion|STD|DVP|RVP'   ;6;2;;Not EV;;;;;0;IF(INCLUIDO(MERCADO,'CV'),IF(MODI O EV,FORMALIQUIDACION1,0),0);
TablaFeriados1 : 'Feriados'                   ; ; ;;Not EV;;NOVACIO(TABLAFERIADOS1) o EV;'Se debe indicar feriados a utilizar';NO;IIF(HABILES(FECHAOP,3,'ARG')=HABILES(FECHAOP,3,'USA') THEN 'ARG' ELSE 'ARG' ENDIF);IIF(MODI THEN TABLAFERIADOS1 ELSE IIF(HABILES(FECHAOP,3,'ARG')=HABILES(FECHAOP,3,'USA') THEN 'ARG' ELSE 'ARG' ENDIF) ENDIF);
Operador       :                              ; ; ;;;;NOVACIO(OPERADOR);'El Operador es Invalido';NO;USUARIOACTIVO;
VTXT1          : 'U.Medida'                   ; ; ;;;NO;SI O NOVACIO(VTXT1);'Indique la Unidad de Medida';NO;BuscarCampo('Especies','Alias1','Codigo',ESPECIE)

VCAN20         : 'Cliente'                    ;1;1;1;NO;NO;;;;IF(EqStr(BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1),'CLI'),1,0);IF(EqStr(BuscarCampo('CLIENTES','CategDepositante','Codigo',CLIENTE1),'CLI'),1,0);

Mercado        : 'Merc.Especie'               ;10;1;;Not EV;;NOVACIO(MERCADO);'Debe indicar Mercado de Especie';NO;MercadoDef(ESPECIE);MercadoDef(ESPECIE);;;;;;" Observaciones Like '%M%' "
Cuenta1        : 'Cta.Esp.Veh.'               ;11;1;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o VACIO(CUENTA1);;;IF(VCAN20=0,CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB'));IF(VCAN20=0,IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB')));;;;;;" Estado='HAB' and Mercado='"~MERCADO~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ";

Mercado2       : 'Merc.Moneda'                ;10;2;;Not EV;;NOVACIO(MERCADO2);'Debe indicar Mercado de Moneda';NO;MercadoDef(CONTRAESPECIE);MercadoDef(CONTRAESPECIE);;;;;;" Observaciones Like '%M%' "
Cuenta2        : 'Cta.Mon.Veh.'               ;11;2;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))] o VACIO(CUENTA2) ;;;IF(VCAN20=0,CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(CONTRAESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO2)),MERCADO2),TIPOOP,'HAB'));IF(VCAN20=0 Y NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(CONTRAESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO2)),MERCADO2),TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~ IIF(Incluido(MERCADO2,Var('MERNOVEHI')) THEN IIF(EqStr(CONTRAESPECIE,Var('MONELOCA')) THEN Var('MERCBCRA') ELSE IIF(EqStr(CONTRAESPECIE,Var('MONEEXT')) THEN Var('MERSWIFT') ELSE MERCADO2 ENDIF) ENDIF) ELSE MERCADO2 ENDIF) ~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ";

*Se deja el original previo a sacarle mercado vista a vehiculos. CAL 15/11/2022
*Cuenta2        : 'Cta.Mon.Veh.'               ;11;2;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))] o VACIO(CUENTA2) ;;;IF(VCAN20=0,CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB'));IF(VCAN20=0,IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB'))));;;;;;" Estado='HAB' and Mercado='"~MERCADO2~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') ";

Cuenta3        : 'Cta.Esp.Cli.'               ;12;1;;Not EV;;[[VCAN20=1 O CLIENTECUENTA(CLIENTE1,CUENTA3)]  y ESPECIECUENTA(ESPECIE,CUENTA3) y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA3))] o VACIO(CUENTA3);;;IF(VCAN20=0,CUENTACLIENTE(CLIENTE1,ESPECIE,,MERCADO,TIPOOP,'HAB')) ;IF(VCAN20=0,IF(NoVacio(BOOK1), CUENTACLIENTE(CLIENTE1,ESPECIE, ,MERCADO,TIPOOP,'HAB')));;;;;;IF(VCAN20=0," Estado='HAB' and Mercado='"~MERCADO~"' and  Cliente='"~CLIENTE1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') "," Estado='HAB' and Mercado='"~MERCADO~"' and (Cliente='"~CLIENTE1~"' or Cliente='' or Cliente Is Null) AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ");
Cuenta4        : 'Cta.Mon.Cli.'               ;12;2;;Not EV;;[[VCAN20=1 O CLIENTECUENTA(CLIENTE1,CUENTA4)]  y ESPECIECUENTA(CONTRAESPECIE,CUENTA4) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA4))] o VACIO(CUENTA4);;;IF(VCAN20=0,CUENTACLIENTE(CLIENTE1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB')) ;IF(VCAN20=0,IF(NoVacio(BOOK1), CUENTACLIENTE(CLIENTE1,CONTRAESPECIE, ,MERCADO2,TIPOOP,'HAB')));;;;;;IF(VCAN20=0," Estado='HAB' and Mercado='"~MERCADO2~"' and Cliente='"~CLIENTE1~"' AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') "," Estado='HAB' and Mercado='"~MERCADO2~"' and (Cliente='"~CLIENTE1~"' or Cliente='' or Cliente Is Null) AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') ");


CONDICIONES

EsTerminal(CONTRAESPECIE,Especie);'La ContraEspecie No puede ser una Jerarquia';NO
EqStr(BuscarCampo('Especies','Status','Codigo',CONTRAESPECIE),'HAB');'La ContraEspecie No esta Habilitada';NO
FechaOp > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(FechaOp,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ESPECIE),'HAB');'La Especie No esta Habilitada';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO


MOVIMIENTOS
FechaVto;Cliente1;Especie      ;;;;                                                                  Mercado;Vehiculo1;1;      -Cantidad;;'Compra de '~Especie;SI;NO;1;NOVACIO(CLIENTE1);;Cuenta1;;1;'TI';IF(Incluido(Mercado,'CV'),IF(FormaLiquidacion1=1,'CONF',IF(FormaLiquidacion1=2,'RVP')));;;;;Book1;
FechaVto;Cliente1;Contraespecie;;;;IF(NoVacio(Mercado2),Mercado2,IF(EqStr(Mercado,VAR('MERCARGC')),Mercado));Vehiculo1;1; TotalBrutoCli1;;'Compra de '~Especie;SI;NO;2;NOVACIO(CLIENTE1);;Cuenta4;;2;'TI';IF(Incluido(Mercado,'CV'),IF(FormaLiquidacion1=1,'DVP' ,IF(FormaLiquidacion1=2,'CONF')));;;;;Book1;

@INSTFXCV
