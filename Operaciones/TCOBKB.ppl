FechaOp ;VTXT11;'IPO'~MERCADO ;'USD';; TotalBrutoCli3;'Afect. '~TipoOp~' '~Especie;Not EqStr(VTXT20,'1')         ;Vehiculo1
FechaVto;VTXT11;'IPO'~MERCADO ;'USD';;-TotalBrutoCli3;'Desaf. '~TipoOp~' '~Especie;Not EqStr(VTXT20,'1') y RB10=1;Vehiculo1


