TotalAux3 : 'Ex.Vol.Concertado' ;11;1;2;NO;NO;;;;IF(Not[(LimAsignado(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),FECHAOP,VEHICULO1,,,NROPERACION)+TOTALNETOCLI3))<0],0,(LimAsignado(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),FECHAOP,VEHICULO1,,,NROPERACION)+TOTALNETOCLI3)));IF(Not[(LimAsignado(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),FECHAOP,VEHICULO1,,,NROPERACION)+TOTALNETOCLI3))<0],0,(LimAsignado(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),VEHICULO1)-(LimConsumido(VTXT11,'VOLUMENCON',VAR('MONEEXTR'),FECHAOP,VEHICULO1,,,NROPERACION)+TOTALNETOCLI3)));;;;;'###,###,###,###.######'
