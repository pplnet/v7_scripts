Cuenta4        : 'Cuenta Moneda'  ;9;2;2;;;NoVacio(Cuenta4) o EqStr(CUENTA4,VAR('CTAMOD23'));'Ingrese una cuenta de moneda';NO;;IF(1<=VCAN2,ItemLista(VTXT5,1),VAR('CTAMOD23'));;;;;;"Cliente='"~IF(EqStr(MERCADO,VAR('MERCARGC')),VAR('CLIARGC'),CLIENTE1)~"' and (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In('CC','CA')";

