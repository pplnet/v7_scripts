CAMPOS:1;;
Cantidad        : 'Valor Nominal'              ;6 ;1; ;NOT EV;;CANTIDAD>0;IF(RB4=0 y Eqstr(ABM,'A'),'El Valor Nominal Supera a la Cantidad Completada de la Orden o no es positivo','El Valor Nominal DEBE SER POSITIVO');NO;;;;;;;'###,###,###,###,###.##'

TotalNetoCli1   : 'Total a Pagar: '            ;12;1;1;NO;SI;;;;(CANTIDAD-TOTALAUX1)+(CUOTASL.Cantidad3(1) - CUOTASL.Cantidad4(1));(CANTIDAD-TOTALAUX1)+(CUOTASL.Cantidad3(1) - CUOTASL.Cantidad4(1));SI;;;;;SI
TotalAux1       : 'Penalidad'                  ;16;1;;NO;TOTALAUX1>0;;;;;;;
Precio1         : 'Tasa'                       ; 6;2; ;;;;;NO;0;;;;;;;'###,###.######'
Plazo           : 'Plazo'                      ;  ; ; ;  ;  ;PLAZO>0;'Debe INGRESAR el PLAZO';NO;0;
Spread          :                              ; 6;2; ;NOT EQSTR(TIPOTASA,'FIJA');NOT EQSTR(TIPOTASA,'FIJA');SPREAD>=0;'El SPREAD Debe SER POSITIVO';NO;0;
TipoTasa        : 'Tipo_Tasa'                  ; 5;2; ;  ;NO;NoVacio(TIPOTASA);'El Tipo de Tasa ES INVALIDO';NO;'FIJA';
RB6             : 'Redondea|SI|NO'             ;5 ;2; ;NOVACIO(ESPECIE) Y NOT EQSTR(Var('MONELOCA'),ESPECIE);NOVACIO(ESPECIE) Y NOT EQSTR(Var('MONELOCA'),ESPECIE);EQSTR(Var('MONELOCA'),ESPECIE) O [NOT EQSTR(Var('MONELOCA'),ESPECIE) Y [RB6 = 0 O RB6 = 1]];'Es obligatorio indicar si la operacion redondea';NO;-1;IF(VACIO(ESPECIE) O EQSTR(Var('MONELOCA'),ESPECIE),1,RB6);;;;;;
PlazoGracia     : 'Plazo_Gracia'               ;  ; ; ;  ;NO;PLAZOGRACIA>=0 Y PLAZOGRACIA<=CUOTAS1;'Plazo de Gracia >=0 y <= '~CUOTAS1;NO;1;


LISTA:SI;1;
  Tasa1    : 'Tasa Amort'     ;NOT EV;  ;CUOTASL.TASA1[Fila]>=0;'La Tasa de Amortizacion debe SER POSITIVA';100;100;100;  ;Numero;'###,###.######';NO;NO;'2';
  Cantidad1: 'Imp Amort'      ;NOT EV;  ;CUOTASL.CANTIDAD1[Fila]>=0;'El Importe Amortizacion debe SER POSITIVO';CANTIDAD;CANTIDAD;200;;Numero;'###,###,###,###,###.##';NO;NO;'1';
  Plazo1   : 'Plazo'          ;      ;  ;[CUOTASL.PLAZO1[Fila]>0 Y NOT [DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1))]] O [CUOTASL.PLAZO1[Fila]> 0 Y DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1))] ;'El Plazo del Periodo Debe ser Positivo';IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1));IF(Fila=CUOTAS1 Y (PLAZO MOD CUOTAS1)<>0,(PLAZO DIV CUOTAS1)+(PLAZO MOD CUOTAS1),(PLAZO DIV CUOTAS1)); 60;  ;Numero;'####'

  Fecha1   : 'F.Origen'       ;NO    ;  ;ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA1[Fila],'ARG');'La Fecha Origen de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
  Fecha2   : 'F.Vto'          ;NO    ;  ;ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA2[Fila],'ARG');'El Vencimiento de la Cuota '~Fstr(Fila, 0, 0)~' No es HABIL';IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);IF(Fila=CUOTAS1,FECHAVTO,CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila]);90;;Fecha;;;;;;;;RB11 = 0
  Fecha3   : 'F.Sett'         ;      ;  ;CUOTASL.FECHA3[Fila]>=CUOTASL.FECHA2[Fila] Y ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1) Y ESHABIL(CUOTASL.FECHA3[Fila],'ARG');'El Settlement No es HABIL o es Menor que el Vto';IF((Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG')),Habiles2(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1~'|ARG', SI), CUOTASL.FECHA2[Fila]);IF((Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1) O Not EsHabil(CUOTASL.FECHA2[Fila], 'ARG')),Habiles2(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1~'|ARG', SI), CUOTASL.FECHA2[Fila]);90;;Fecha;NO;NO
  Cantidad2: 'V.Nominal'      ;NO    ;  ;CUOTASL.CANTIDAD2[Fila]>=0;'El Valor Nominal debe SER POSITIVO';;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD1[Fila-1]);200;  ;Numero;'###,###,###,###,###.##'
  *  Precio2  : 'Tasa Interes'   ;      ;  ;[FILA>1 Y CUOTASL.PRECIO2[Fila]>=0] O [Fila=1 Y CUOTASL.PRECIO2[Fila]>=0 Y NOT EQSTR(TIPOTASA,'FIJA') Y RB16 = 1] O [Fila=1 Y CUOTASL.PRECIO2[Fila]>0];'TASA INVALIDA O FALTA TASA';;IF(EQSTR(TIPOTASA,'FIJA'),PRECIO1,CUOTASL.PRECIO2[Fila]);100;  ;Numero;'###,###.######';NO;SI;'8';
  Precio2  : 'Tasa Interes'   ;      ;  ;[Vacio(INDICE) Y CUOTASL.PRECIO2[FILA] > 0] O [NoVacio(INDICE) Y CUOTASL.PRECIO2[FILA] >= 0];IF(Vacio(INDICE),'La Tasa debe ser positiva','La tasa debe ser 0 o positiva');;IF(EQSTR(TIPOTASA,'FIJA'),PRECIO1,CUOTASL.PRECIO2[Fila]);100;  ;Numero;'###,###.######';NO;SI;'8';

  Cantidad5: 'Imp. IVA'       ;EV    ;  ;NOT EV o [[ROUND(CuotasL.Cantidad5[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CuotasL.Cantidad5[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS2/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Cantidad3: 'Imp Interes'    ;EV    ;  ;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(Fila<PlazoGracia,0,IF(RB6=0,ROUND((CUOTASL.CANTIDAD2[Fila]*(SPREAD+CUOTASL.PRECIO2[Fila])*CUOTASL.PLAZO1[Fila])/IF(RB8=0,36000,36500)),(CUOTASL.CANTIDAD2[Fila]*(SPREAD+CUOTASL.PRECIO2[Fila])*CUOTASL.PLAZO1[Fila])/IF(RB8=0,36000,36500)));200;NO;Numero;'###,###,###,###,###.##';NO;NO;'7';
  Total5   : 'Imp_Perc_IVA'   ;EV    ;  ;NOT EV o [[ROUND(CuotasL.Total5[Fila],2)    <= ROUND((CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CuotasL.Total5[Fila],2)    >= ROUND((CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Perc. IVA Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO7[Fila]*(1+Var('PORVAR')/100),2),0,2);;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*TOTALAUX2/100,0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Cantidad6: 'Imp_Neto_IVA'   ;NO    ;  ;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD5[Fila]+CUOTASL.TOTAL5[Fila],0);200;  ;Numero;'###,###,###,###,###.##'
  Cantidad4: 'Ret.Gan'        ;EV    ;  ;NOT EV o [[ROUND(CuotasL.Cantidad4[Fila],2) <= ROUND((CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CuotasL.Cantidad4[Fila],2) >= ROUND((CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100)),2)]];'Importe Impuesto Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO8[Fila]*(1+Var('PORVAR')/100),2),0,2) ;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),IF(RB6=0,ROUND(CUOTASL.CANTIDAD3[Fila]*IMPGASTOS1/100),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS1/100),0);200;NO;Numero;'###,###,###,###,###.##';NO;NO
  Total3   : 'Imp.Int.Neto'   ;NO    ;  ;;;;CUOTASL.CANTIDAD3[Fila]-CUOTASL.CANTIDAD4[Fila]  ;200;  ;Numero;'###,###,###,###,###.##'
  Total2   : 'Monto'          ;NO    ;  ;;;;(CUOTASL.CANTIDAD1[Fila]+CUOTASL.CANTIDAD3[Fila]);200;  ;Numero;'###,###,###,###,###.##'
  Total1   : 'Monto Neto'     ;NO    ;  ;;;;(CUOTASL.TOTAL2[Fila]-CUOTASL.CANTIDAD4[Fila])   ;200;  ;Numero;'###,###,###,###,###.##'
  Precio4  : 'Tasa T.Neta'    ;NO    ;  ;SI Y [CUOTASL.Precio4[Fila]<=VAR('RTTN2') Y CUOTASL.Precio4[Fila]>=VAR('RTTN1')];'Tasa Total Neta Fuera de Rango:'~VAR('RTTN1')~" Y "~VAR('RTTN2');;;200;;Numero;'###.######';NO;NO;
  Precio6  : 'MOD IVA'        ;NO    ;NO;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS2/100,0);200;;Numero;'###.######'
  Precio5  : 'MOD INT'        ;NO    ;NO;;;;IF(Fila<PlazoGracia,0,(CUOTASL.CANTIDAD2[Fila]*(SPREAD+CUOTASL.PRECIO2[Fila])*CUOTASL.PLAZO1[Fila])/IF(RB8=0,36000,36500));200;;Numero;'###.######'
  Precio7  : 'MOD I P IVA'    ;NO    ;NO;;;;IF(NOT DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*TOTALAUX2/100,0);200;;Numero;'###.######'
  Precio8  : 'MOD IMP'        ;NO    ;NO;;;;IF(DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') Y EQSTR('ARG',BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1)),CUOTASL.CANTIDAD3[Fila]*IMPGASTOS1/100,0);200;;Numero;'###.######'
  Fecha4   : 'F.Reset'        ;NO    ;NOT EQSTR(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA);;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
  Tasa7    : '% Amort Orig'   ;NO;SI;;;IF(VACIO(OPERACIONREF) o CUOTAS2=0 o OPREF.RB6<=0,if(EqStr(ABM,'A'),(100/CUOTAS1),CUOTASL.TASA1[Fila]),IF(Fila>1,QUERY("SELECT Tasa1 FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota="~Fstr(Fila+CUOTAS2-1,0,0)~" "),QUERY("SELECT Sum(Tasa1) FROM "~DBO~".CUOTAS Where NrOperacion='"~OPERACIONREF~"' and NrCuota<="~Fstr(Fila+CUOTAS2-1,0,0)~" ")));IF(SUM(CUOTASL, 24)=0, CUOTASL.TASA1[Fila], CUOTASL.TASA7[Fila]);100;;Numero;'###,###.######';NO;NO;
  
  Cantidad10 :'Interes Ori'   ;NO;NO;;;CUOTASL.CANTIDAD3[Fila];CUOTASL.CANTIDAD3[Fila];;;Numero;'###,###,###,###,###.##'
  Cantidad11 :'Retencion Ori' ;NO;NO;;;CUOTASL.CANTIDAD4[Fila];CUOTASL.CANTIDAD4[Fila];;;Numero;'###,###,###,###,###.##'
  Cantidad7  :'Imp. IVA'   ;NO;NO;;;CUOTASL.CANTIDAD5[Fila];CUOTASL.CANTIDAD5[Fila];;;Numero;'###,###,###,###,###.##'
  Cantidad8  :'Imp_Neto_IVA Ori' ;NO;NO;;;CUOTASL.CANTIDAD6[Fila];CUOTASL.CANTIDAD6[Fila];;;Numero;'###,###,###,###,###.##'
  Total6  :'Imp_Perc_IVA Ori' ;NO;NO;;;CUOTASL.TOTAL5[Fila];CUOTASL.TOTAL5[Fila];;;Numero;'###,###,###,###,###.##'
  Total4  :'Imp.Int.Neto Ori' ;NO;NO;;;CUOTASL.TOTAL3[Fila];CUOTASL.TOTAL3[Fila];;;Numero;'###,###,###,###,###.##'
  Total7  :'Monto Ori' ;NO;NO;;;CUOTASL.TOTAL2[Fila];CUOTASL.TOTAL2[Fila];;;Numero;'###,###,###,###,###.##'
  Total8  :'Monto Neto Ori' ;NO;NO;;;CUOTASL.TOTAL1[Fila];CUOTASL.TOTAL1[Fila];;;Numero;'###,###,###,###,###.##'
  Precio1    :  'Precio1'       ;;NO;;;;;200;;Numero;'###,###,###,###,###.##';NO;NO;
  Precio3    :  'Precio3'       ;;NO;;;;;200;;Numero;'###,###,###,###,###.##';NO;NO;