Operador          :                  ;10;1;1;NO;  ;;;;USUARIOACTIVO;
RB1               : 'Gar.2412'       ;10;2;1;NO;NO;;;;0;
RB2               : 'Gar.2412'       ;10;2;1;NO;NO;;;;0;

NrOperacion2      : 'Op.Fondeo'      ;11;1;1;  ;  ;[RB2=0 y EQSTR(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',NrOperacion2),'IMM') y NOVACIO(NROPERACION2)] o Vacio(NROPERACION2);'La operacion debe ser IMM';NO;;;;;;;;" TipoOp ='IMM' and (NrOperacion2 = ' ' or NrOperacion2 is Null)  and Vehiculo1= '"~VEHICULO1~"' and Especie ='"~ESPECIE~"' AND Book1 = '"~BOOK1~"' "
NrOperacion3      : 'Prest.Asoc.'    ;11;1;1;[Eqstr(VEHICULO1,VAR('VEHICULODE')) y RB2=1];[Eqstr(VEHICULO1,VAR('VEHICULODE')) y RB2=1] o [Eqstr(VEHICULO1,'INGCURA') y RB1=1];[NOVACIO(NROPERACION3) y Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',NROPERACION3),'PME') y [RB2=1 o RB1=1]] o Vacio(NROPERACION3); 'La operacion debe ser PME';NO;;;;;;;;" TipoOp ='PME' and Cliente1='"~CLIENTE1~"' and Especie ='"~ESPECIE~"' and Cantidad = "~Fstr(CANTIDAD,0,0)~" and Plazo = "~PLAZO~" and Cuotas1 = "~CUOTAS1~" and FechaOp = '"~IdxDate(FECHAOP)~"' and Vehiculo1= 'INGCURA' and (NrOperacion3 = ' ' or NrOperacion3 is Null) and (RB1='0' or RB1=' ' or RB1 is Null) "
