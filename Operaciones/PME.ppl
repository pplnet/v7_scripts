CuentaContable2   : 'Forma Pago '    ;12;1; ;RB1=0;NO;SI o [NOVACIO(CUENTACONTABLE2) y Query("Select Count(*) from "~DBO~".FORMASPAGO Where CuentaContable='"~CUENTACONTABLE2~"' and Vehiculo='"~VEHICULO1~"' and Mercado='"~MERCADO2~"' and Especie in ("~Pipe2Comillas(VTXT19)~") ")>0];'Debe Ingresar una Forma de Pago valida' ;NO;;FormaPago(ESPECIE,MERCADO2,'PAG',TIPOOP,VEHICULO1);

