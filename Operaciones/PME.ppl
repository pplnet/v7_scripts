CAMPOS:2;;11
FechaOp           : 'Fecha Op.'      ; 3;2;1;RB1=0 y RB2=0 y VerificaAcceso('OPFVALOR');;FECHAOP <= FSYS Y FECHAOP >= Habiles(FSys,-Var('CHKFVLPMO'),'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
Especie           : 'Especie'        ; 1;1;1;RB1=0 y RB2=0;  ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA') y EsTerminal(ESPECIE, Especie) y Incluido(ESPECIE,Var('LISESPMO'));'Debe Ingresar una Moneda Valida';NO;;IF(MODI,ESPECIE,OPREF.ESPECIE);;Var('LISESPMO')
Cliente1          : 'Cliente'        ; 2;1;1;RB1=0 y RB2=0;  ;NoVacio(CLIENTE1) Y Not Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE1),'BAN');'Tipo de Cliente no valido';NO;;;;;;;;"Status like 'HAB' and Sector <> 'BAN' "
Cantidad          :                  ; 3;1;1;RB1=0 y RB2=0;  ;CANTIDAD>0;'La Cantidad debe ser positiva';NO;
MB2               :'Tasa|Fija|Repact.'; 4;1;1;RB1=0 y RB2=0;;;;;0;IF(VACIO(OPERACIONREF) o Incluido(ABM,'E'),MB2,OPREF.MB2)
Precio1           : 'Tasa (%)'       ; 5;1;1;RB1=0 y RB2=0;;[RB2=0 y PRECIO1>=0] o [RB2=1 y PRECIO1>=0];'La Tasa debe ser  mayor o igual que cero');NO;IF(RB2=1,0,PRECIO1);IF(RB2=1,0,PRECIO1)
DiasAnio          : 'Base|360|365'   ; 6;1;1;RB1=0;;;;;IF(RB2=1 y Eqstr(VEHICULO1,VAR('VEHICULODE')),BuscarCampo('OPERACIONES','DiasAnio','NrOperacion',NROPERACION3),1);IF(RB2=1 y Eqstr(VEHICULO1,VAR('VEHICULODE')),BuscarCampo('OPERACIONES','DiasAnio','NrOperacion',NROPERACION3),IF(MODI,DIASANIO,1))
RB8               :'Prestamo ON|NO|SI'; 1;2;1;  ; ;;;;0
ContraEspecie2    : 'Especie ON'     ; 2;2;1;RB8=1;RB8=1;[RB8=0 y Vacio(CONTRAESPECIE2)] o [RB8=1 y NoVacio(CONTRAESPECIE2) y DesciendeDeEspecie(CONTRAESPECIE2,'ON')];'La especie debe ser una ON';NO;IF(RB8=0,'',CONTRAESPECIE2);;;;;;;"Status = 'HAB' and Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','ON'))~")"
Plazo             : 'Plazo'          ; 4;2;1;RB1=0 y RB2=0;  ;PLAZO>0;'El plazo debe ser mayor que cero';NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP;
FechaVto          : 'Fecha Vto.'     ; 5;2;1;RB1=0 y RB2=0;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1) Y [ESHABIL(FECHAVTO,'USA') O NOT EQSTR(ESPECIE,'USD')];'No es un dia habil';NO;HABILES(FECHAOP,1,TABLAFERIADOS1,NO);FECHAOP+PLAZO;
MB1               : 'Liquidacion|Com.|Liq.'; 6;2;1;RB1=0;NOVACIO(OPERACIONREF);;;;0;
VPRE2:  'Plazo x cuota'   ;20;1;1;NO;NO;;;;;Trunc(PLAZO/CUOTAS1,0)
VPRE3:  'Plazo ult cuota' ;21;1;1;NO;NO;;;;;PLAZO-VPRE2*(CUOTAS1-1)
