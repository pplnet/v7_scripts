CAMPOS:4;;10
FechaOp         : 'Fecha Op.'     ; 2;2;1;VerificaAcceso('OPFVALOR');;FechaOp<=FSys y FechaOp>=Habiles(FSys,-5,'ARG') Y ESHABIL(FECHAOP,'ARG') Y [ESHABIL(FECHAOP,'USA') O EQSTR(ESPECIE,'ARP')] Y [Mes(FECHAOP)=Mes(FSYS) o SI];'Fecha alta incorrecta';NO;FSYS;
FechaPago       : 'Fecha Desem.'  ; 3;2; ;VerificaAcceso('OPFVALOR');;FechaPago>=FechaOp Y ESHABIL(FECHAPAGO,'ARG') Y [ESHABIL(FECHAPAGO,'USA') O EQSTR(ESPECIE,'ARP')];'Fecha desembolso incorrecta';NO;FSYS;
CB5             : 'x CONU'        ; 1;2; ;NO;NO;;;;1;;
OperacionRef    : 'CONU afectado' ; 1;1; ;  ;  ;[NOVACIO(OPERACIONREF) y EQSTR(OPREF.TIPOOP,'CONU') y OPREF.CB9<>1 y OPREF.CB10<>1] o CB5=0;'La operacion de referencia debe ser CONU habilitada';NO;;;;;;;;" TipoOp = 'CONU' and Isnull(CB9,'0')<>'1' and IsNull(CB10,'0')<>'1'"
Termsheet       : 'Termsheet ID'  ; 1;2; ;NO;CB5=1;;;;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.TERMSHEET,'');;;;;'XXXXXXXXXX';
TipoCONU        : 'Tipo CONU'     ; 1;3; ;NO;CB5=1;;;;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.TIPOCONU,'');;;;;'XXXXX';
Cliente1        : 'Cliente'       ; 2;1; ;CB5=0;  ;NOVACIO(CLIENTE1) Y DESCIENDEDECLIENTE(CLIENTE1,'VINCULADOS');'Debe ingresar un Cliente que sea vinculado';NO;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.CLIENTE1,CLIENTE1);
Especie         : 'Especie'       ; 3;1; ;CB5=0;  ;NOVACIO(ESPECIE)  Y Incluido(ESPECIE,'ARP|USD');'Debe ingresar ARP o USD';NO;'USD';IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.ESPECIE,ESPECIE);;'ARP|USD|';NO
VCAN2           : 'Monto Linea'   ; 4;1; ;NO;CB5=1;;;;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.CANTIDAD,0)
VCB1            : 'CONU Evergreen'; 4;2; ;NO;CB5=1 y VCB1=1;;;;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.CB1,0)
VFEC1           : 'Vto CONU'      ; 4;2; ;NO;CB5=1 y VCB1=0;;;;;IF(CB5=1 y NoVacio(OPERACIONREF) Y OPREF.CB1=0,OPREF.FECHAVTO,0)
TotalAux1       : 'Disp CONU'     ; 5;1; ;NO;CB5=1;TOTALAUX1>0;'El Disponible del CONU debe ser positivo';NO;;IF(NoVacio(OPERACIONREF),Query("Select "~DBO~".SaldoCONU('"~OPERACIONREF~"','"~IdxDate(FECHAOP)~"',1) "),0)
Cantidad        :                 ; 6;1; ;  ;  ;CANTIDAD>0 Y (CANTIDAD<=TOTALAUX1 o CB5=0);'La Cantidad de ser positiva y no puede superar el disponible del CONU';NO;
MB1             : 'Tipo Tasa|Fija|Variable'; 7;1; ;CB5=0;  ;;;;0;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.MB1,MB1)
Precio1         : 'Tasa (%)'      ; 7;2; ;CB5=0 y MB1=0;MB1=0;PRECIO1>=0 o MB1<>0;'La Tasa es negativa';NO;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.PRECIO1,IF(MB1<>0,0,PRECIO1))
TipoTasa        : 'Tasa'          ; 7;2; ;CB5=0 y MB1=1;MB1>0;NoVacio(TIPOTASA) o MB1<>1;'Debe ingresar Tipo Tasa';NO;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.TIPOTASA,IF(MB1<>1,'',TIPOTASA))
MB2             : 'Tipo Spread|Fijo|Indice'; 8;1; ;CB5=0;  ;;;;0;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.MB2,MB2)
Spread          : 'Spread'        ; 8;2; ;CB5=0 y MB2=0;MB2=0;;;;0;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.SPREAD,IF(MB2<>0,0,SPREAD))
Especie1        : 'Indice'        ; 8;2; ;CB5=0 y MB2=1;MB2=1;(NOVACIO(ESPECIE1) Y DesciendeDeEspecie(ESPECIE1,'INDICE') y EsTerminal(ESPECIE1,ESPECIES)) o MB2<>1;'Debe ingresar un indice';NO;;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.ESPECIE1,IF(MB2<>1,'',ESPECIE1));;;;;;" "~DBO~".desciendedeespecie(Codigo,'INDICE') = 1 and "~DBO~".EsTerminalEspecie(Codigo) = 1 "

DiasAnio        : 'Base Ints.|360|365'; 9;1; ;CB5=0;  ;;;;0;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.DIASANIO,DIASANIO)
DiasMes         : 'Dias Mes|Act|30'   ; 9;2; ;CB5=0;NO;;;;0;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.DIASMES,DIASMES)
TablaFeriados1  : 'Feriados'      ;10;1; ;  ;  ;Novacio(TABLAFERIADOS1);'Debe indicar tabla feriados';NO;'USA'
CB3             : 'Capitalizable' ;11;1; ;CB5=0;  ;;;;1;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.CB3,CB3)
CB2             : 'Precancelable' ;12;1; ;CB5=0;  ;;;;0;IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.CB2,CB2)
