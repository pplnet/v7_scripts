Operador        :                 ;14;1; ;NO;  ;;;;USUARIOACTIVO;
Book1           : 'Book'          ;15;1; ;CB5=0;  ;CB5=1 o Incluido(BOOK1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') "));'Book Invalido.';NO;BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');IF(CB5=1 y NoVacio(OPERACIONREF),OPREF.BOOK1,BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB'));;;;;;" Estado  = 'HAB' and Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
Vehiculo1       : 'Vehiculo '     ;16;1; ;  ;  ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')

Mercado        : 'Merc.Liq.'      ;11;2; ;Not EV;  ;NOVACIO(MERCADO) y Incluido('M',BuscarCampo('MERCADOS','Observaciones','Codigo',MERCADO));'Debe indicar mercado Correcto';NO;;IF(MODI,MERCADO,IF(NoVacio(ESPECIE),MercadoDef(ESPECIE)));;;;;;"Observaciones Like '%M|%'"
VTXT5          : 'Ctas Clie'      ;10;2;1;NO;NO;;;;;IF(NoVacio(BOOK1),SQLSet("Select Codigo from "~DBO~".CUENTAS where Cliente='"~CLIENTE1~"' and (Especies Like '%"~ESPECIE~"%' or Especies Like '%MONEDA%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS') and  Mercado='"~MERCADO~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC"))
VCAN5          : 'Cant C.Clie'    ;11;3;1;NO;NO;;;;;IF(NoVacio(BOOK1),IF(NoVacio(VTXT5),Elementos(VTXT5),0));
VTXT6          : 'Ctas Vehi'      ;12;3;1;NO;NO;;;;;IF(NoVacio(BOOK1),SQLSet("SELECT Codigo FROM "~DBO~".CUENTAS WHERE Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' or Especies Like '%MONEDA%') AND Estado='HAB' AND TipoCuenta In ('CC','CA','CUS') AND Mercado='"~MERCADO~"' and (TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') ORDER BY ISNull(Permanente,'NO') DESC, Codigo ASC")) ;
VCAN6          : 'Cant.C.Vehi'    ;12;3;1;NO;NO;;;;;IF(NoVacio(BOOK1),IF(NoVacio(VTXT6),Elementos(VTXT6),0));

Cuenta1        : 'Cta Cliente:'   ;12;2;1;Not EV;;;;;;IF(NoVacio(BOOK1),IF(1<=VCAN5,ItemLista(VTXT5,1),''));;;;;;"Estado='HAB' and Mercado='"~MERCADO~"' and TipoCuenta In ('CC','CA','CUS') and Cliente='"~CLIENTE1~"' ";
Cuenta2        : 'Cta Vehiculo:'  ;13;2;1;Not EV;;;;;;IF(NoVacio(BOOK1),IF(1<=VCAN6,ItemLista(VTXT6,1),''));;;;;;"Estado='HAB' and Mercado='"~MERCADO~"' and TipoCuenta In ('CC','CA','CUS') and Cliente='"~VEHICULO1~"' ";

VCAN1           : 'Cuotas'        ;17;1;1;NO;NO;;;;;Query("Select Count(*) from "~DBO~".CUOTAS where NrOperacion='"~NROPERACION~"' ")
