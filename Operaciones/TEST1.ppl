CAMPOS:1;;1


Mercado  : 'M. Negociac.'                             ;1;1;;;;NOVACIO(MERCADO);'Debe ingresar Mercado de Futuro de Titulos';NO;VAR('MENEFTI');;;;;;;" Codigo in ('OCT','ROFEX') "
MB4      : 'Liquida MTM|No Aplica|Liquida|No Liquida' ;2;1;;Eqstr(BuscarCampo('MERCADOS','Regulado','Codigo', Mercado), 'NO');;;;;;BuscarCampo('MERCADOS','MTM','Codigo',MERCADO);
MB1      : 'Frec.Liq.|Diario|Mensual|Vto'             ;3;1;;Eqstr(BuscarCampo('MERCADOS','Regulado','Codigo', Mercado), 'NO');;;;;0;

VCAN1 : 'Monto' ; 5;1; ;  ;  ; ; ; ;1125330.89

ContraEspecie          : 'Contraespecie'  ; 1;2; ;  ;  ;NoVacio(CONTRAESPECIE) y DesciendeDeEspecie(CONTRAESPECIE,'MONEDA');'Debe Ingresar una ContraEspecie';NO;'ARP';
Cuenta4                :                  ;10;1; ;  ;  ;;;;'0003658C01'              
Mercado2               : 'Merc.Liq.Mon.'  ;11;1; ;  ;  ;NOVACIO(MERCADO2) y EqStr(BuscarCampo('MERCADOS','EsLiquidacion','Codigo',MERCADO2),'SI');'Debe indicar Merc.Moneda';NO;'MERINT';IF(NoVacio(CONTRAESPECIE),MercadoDef(CONTRAESPECIE) );;;;;;"Observaciones not like '%T%'  and EsLiquidacion='SI' "
AfectaLS               : 'Afecta'         ;11;2; ;EqStr(BuscarCampo('CANALES','EditarAfectacion','Codigo',VAR('CANALDEF')),'SI');INSTANCIA=1 o INSTANCIA=0;;;;;IF(MODI o EV,AFECTALS,BuscarCampo('CANALES','AfectaPorDefecto','Codigo',VAR('CANALDEF'))); ;SQLSet("SELECT DISTINCT AfectaPorDefecto FROM "~DBO~".CANALES");
MB2                    : 'Bloquea Saldo'  ;12;2; ;EqStr(TIPOOP,'TEST1') y EqStr(AfectaLS,'Saldos') y Not EqStr(MB1,'SI');EqStr(TIPOOP,'TEST1') y EqStr(AfectaLS,'Saldos');;;;IF(Not [EqStr(TIPOOP,'TEST1') y EqStr(AfectaLS,'Saldos')],0,1);IF(Not [EqStr(TIPOOP,'TEST1') y EqStr(AfectaLS,'Saldos')] o EqStr(MB1,'SI'),0,IF(MODI o EV,MB2,1))

VTXT28                 : 'Bloquea'        ;10;3; ;NO;SI;Incluido(VTXT28,'NO|SI');'Bloqueo de Saldos con error';NO;'NO';IF(EqStr(TIPOOP,'TEST1') y EqStr(AfectaLS,'Saldos') y EqStr(MERCADO2,VAR('MERCADOBT')) y MB2=1,'SI','NO');;;;;'XX'
VTXT29                 : 'Ref.Bloqueo'    ;11;3; ;NO;SI;;;;GetNumerador(900);;;;;;'XXXXXXXX'
Observac2              : 'Ref.Bloqueo'    ;12;3; ;NO;SI;;;;;IF(EqStr(VTXT28,'SI'),VTXT29,'');;;;;'XXXXXXXX'
VTXT4                  : 'Res.Bloqueo'    ;13;3; ;NO;SI;;;;;ppl.bloquearsaldoorden(Copy(CUENTA4,1,7),Copy(CUENTA4,9,2),Num(VCAN1),VTXT28);;;;;'XXXXXXXXXX'
%%ifdef STD
VTXT5                  : 'ifdef' ;14;3; ;NO;SI;;;;'OK'
%%else
VTXT5                  : 'ifdef' ;14;3; ;NO;SI;;;;'ELSE'
%%endif

LISTA:SI;3;
  Cantidad1 : 'CantPrec'  ;NO;;;;;;80;;NUMERO;'########.##'
  Cantidad2 : 'IntPrec'   ;NO;;;;;;80;;NUMERO;'########.##'

CONDICIONES
Incluido(ppl.bloquearsaldoorden(Copy(CUENTA4,1,7),Copy(CUENTA4,9,2),Num(VCAN1),VTXT28),'OK');'No se pudo bloquear saldo de la cuenta '~CUENTA4~' por '~PyC(VCAN1,1,2)~' '~BuscarCampo('Especies','Nombre','Codigo',CONTRAESPECIE);NO
NO;'No graba';NO
  
