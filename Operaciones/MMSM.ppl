CAMPOS:2;;10
FechaOp        : 'Fecha Conc.'                ;1;1;;NOT EV y VERIFICAACCESO('OPFVALOR');;ESHABIL(FECHAOP,TABLAFERIADOS1);'FECHA CONCERTACION NO HABIL EN TABLA SELECCIONADA';NO;FSYS;
Vehiculo1      : 'Vehiculo'                   ;1;2; ;; ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;if(Eqstr(ABM,'A'),VAR('VEHICULODE'),Vehiculo1)
FechaVto       : 'Fecha Vto'                  ;2;1;;NO;CUOTAS1 > 0;;;NO;FSYS;CUOTASL.FECHA2[CUOTAS1]
Cliente1       : 'ContraParte'                ;3;1;;NOT EV ;;NOVACIO(CLIENTE1);'EL CLIENTE NO ES VALIDO';NO;;;;;;;;"Status = 'HAB'";;;;
Observac2      : 'Op.Contraparte'             ;3;2;;;;NOVACIO(OBSERVAC2);'EL OPERADOR CONTRAPARTE NO ES VALIDO';SI;;;

CB9            : 'Mark To Mkt'                ;4;1;;NO;NO;;;;0;
TablaFeriados1 : 'Feriados'                   ;;;;;;NOVACIO(TABLAFERIADOS1);'SE DEBE INDICAR FERIADOS A UTILIZAR';NO;'ARG';
Cuotas1        : 'Cant_Periodos'              ;5;2;;;;CUOTAS1>1;'La Cantidad de Settlements debe ser superior a 1';NO;

Especie        : 'V Moneda'                   ;7;1;1;NOT EV ;;NOVACIO(ESPECIE) Y [DESCIENDEDEESPECIE(ESPECIE,'MONEDA') Y ESTERMINAL(ESPECIE,ESPECIE)];'DEBE INGRESAR UNA MONEDA DE VEHICULO VALIDA';NO;Var('MONELOCA');;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;
RB8            : 'V Day Count|Act Act|Act 365 F|Act 360|360 360|30E 360' ;9;1;1;;;;;;0;
RB5            : 'C Day Count|Act Act|Act 365 F|Act 360|360 360|30E 360' ;9;2;1;;;;;;0;

RB1            : 'V_Tipo|Tasa|Indice'         ;11;1;1;;;;;;0;;;;;
RB2            : 'C_Tipo|Tasa|Indice'         ;11;2;1;;;;;;0;;;;;
TipoTasa       : 'V Tipo_Tasa'                ;12;1;1;;RB1=0;RB1=1 O NoVacio(TIPOTASA);'Tipo de Tasa del Vehiculo Invalida';NO;;;
Especie1       : 'V_Indice'                   ;12;1;1;;RB1=1;RB1=0 O NoVacio(ESPECIE1);'Indice del Vehiculo Invalida';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','INDICE' ))~") and Status = 'HAB'";;;;
Cantidad       : 'V_Cantidad'                 ;13;1;1;;CANTIDAD >= 0;'Debe Ingresar el Vehiculo Initial Exchange';NO;0;IF(COTIZACION1=0 O COTIZACION1=CANTIDAD O TOTALBRUTOCLI2=0,CANTIDAD,IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALBRUTOCLI2/COTIZACION1,TOTALBRUTOCLI2*COTIZACION1))
Precio1        : 'V_Tasa'                     ;14;1;1;;Eqstr(TIPOTASA, 'FIJA');Not Eqstr(TIPOTASA, 'FIJA') O PRECIO1 > 0;'Tasa Vehiculo Invalida';
Cotizacion1    : 'Tipo Cambio'                ;19;2;1;Not Eqstr(ESPECIE,CONTRAESPECIE);Not Eqstr(ESPECIE,CONTRAESPECIE);Eqstr(ESPECIE,CONTRAESPECIE) o [COTIZACION1<=VPRE1*(1+VAR('RPRECIO2')/100) Y COTIZACION1>=VPRE1*(1-VAR('RPRECIO2')/100)];'Tipo de Cambio Concertacion Fuera de Rango: '~FSTR(VPRE1*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE1*(1+VAR('RPRECIO2')/100),1,7);NO;;IF(Eqstr(ESPECIE,CONTRAESPECIE),1,VPRE1)
VPRE1          : 'Cot.ESP/CONTRAESP'          ;;;1;NO;NO;;;;;IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),TOTALBRUTOCLI2/CANTIDAD,CANTIDAD/TOTALBRUTOCLI2)
VPRE2          : 'Cot. de Mercado'            ;20;2;1;NO;Not Eqstr(ESPECIE, CONTRAESPECIE);;;;;IF(Eqstr(ESPECIE, Var('MONELOCA')), CotizacionC(CONTRAESPECIE,,,,FECHAOP,1,SI,ESPECIE), CotizacionC(ESPECIE,,,,FECHAOP,1,SI,CONTRAESPECIE))
ContraEspecie  : 'C Moneda'                   ;7;2;1;NOT EV ;;NOVACIO(CONTRAESPECIE) Y DESCIENDEDEESPECIE(CONTRAESPECIE,'MONEDA') Y ESTERMINAL(CONTRAESPECIE,ESPECIE);'DEBE INGRESAR UNA MONEDA CONTRAPARTE VALIDA';NO;Var('MONEEXTR');;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','MONEDA' ))~") and Status = 'HAB'";;;;;
TipoTasa2      : 'C Tipo_Tasa'                ;12;2;1;;RB2=0;RB2=1 O NoVacio(TIPOTASA2);'Tipo de Tasa de la Contraparte Invalida';NO;;;
ContraEspecie2 : 'C_Indice'                   ;12;2;1;;RB2=1;RB2=0 O NoVacio(CONTRAESPECIE2);'Indice de la Contraparte Invalida';NO;;;;;;;;"Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','INDICE' ))~") and Status = 'HAB'";;;;
TotalBrutoCli2 : 'C_Cantidad'                 ;13;2;1;;;TOTALBRUTOCLI2>=0;'Contraparte Initial Exchange Invalido';NO;0;IF(COTIZACION1=0 O COTIZACION1=CANTIDAD O TOTALBRUTOCLI2<>0,TOTALBRUTOCLI2,IF(EqStr(Modo(ESPECIE,CONTRAESPECIE),'DIR'),CANTIDAD*COTIZACION1,CANTIDAD/COTIZACION1))
Precio2        : 'C_Tasa'                     ;14;2;1;;Eqstr(TIPOTASA2, 'FIJA');Not Eqstr(TIPOTASA2, 'FIJA') O PRECIO2 > 0;'Tasa ContraParte Invalida';
PlazoRenovPredeter : 'Cot.Contable'           ;9;2;3;NO Y [NOT EQSTR (COTIZAEN(ESPECIE),CONTRAESPECIE)];NO Y [NOT EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE)]; SI O [EQSTR(COTIZAEN(ESPECIE),CONTRAESPECIE) o PLAZORENOVPREDETER > 0];'REQUIERE COTIZACION CONTABLE';NO;;IF(MODI, PLAZORENOVPREDETER, IF(Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE), IF(Eqstr(CotizaEn(ESPECIE), VAR('MONELOCA') ), 1 , COTIZACIONBNA(CONTRAESPECIE,FECHAOP,1,NO,NO) )   ))

Plazo4         : 'V_Dias Seteo Tasa'            ;15;1;1;;NoVacio(TIPOTASA) Y Not Eqstr(TIPOTASA, 'FIJA');PLAZO4>=0;'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa del Vehiculo';NO;;
RB10           : 'V_Setea|InicioPer|FinPer'     ;16;1;1;;NoVacio(TIPOTASA) Y Not Eqstr(TIPOTASA, 'FIJA');RB10 >= 0 O Eqstr(TIPOTASA,'FIJA') O RB1=1;'Indique Inicio o Fin de Periodo para Tasa del Vehiculo';NO;
Plazo3         : 'C_Dias Seteo Tasa'            ;15;2;1;;NoVacio(TIPOTASA2) Y Not Eqstr(TIPOTASA2, 'FIJA');PLAZO3>=0;'Indique la Cantidad de Dias Previos al Inicio para Setear la Tasa de la ContraParte';NO;;
RB4            : 'C_Setea|InicioPer|FinPer'     ;16;2;1;;NoVacio(TIPOTASA2) Y Not Eqstr(TIPOTASA2, 'FIJA');RB4 >= 0 O Eqstr(TIPOTASA2,'FIJA') O RB2=1;'Indique Inicio o Fin de Periodo para Tasa de la ContraParte';NO;

RB6            : 'Liquida|Compensacion|Flujo de Fondos';19;1;1;EQSTR(ESPECIE,CONTRAESPECIE);EQSTR(ESPECIE,CONTRAESPECIE);[EQSTR(ESPECIE,CONTRAESPECIE) Y RB6>=0] O Not EQSTR(ESPECIE,CONTRAESPECIE);'DEBE INGRESAR FORMA LIQUIDACION';NO;0;IF(EQSTR(ESPECIE,CONTRAESPECIE),RB6,-1);
Mercado4       : 'M. Negociac.'               ;20;1;1;;;NoVacio(MERCADO4) y Incluido('M',BuscarCampo('MERCADOS','TipoNegocio','Codigo',MERCADO4));'Debe ingresar Mercado de negociacion';NO;Var('MENESWAPS');;;;;;;"TipoNegocio Like '%FM%' "
Mercado2       : 'Mer.Liq.Mon.'               ;21;1;1;;;Incluido('M',BuscarCampo('MERCADOS','TipoNegocio','Codigo',MERCADO2));'Debe ingresar un Mercado de Moneda';NO;;MercadoDef(ESPECIE);;;;;;"TipoNegocio Like '%M%' "
Operador       : 'Operador'                   ;23;1;1;NO;;NoVacio(OPERADOR);'El Operador es Invalido';NO;UsuarioActivo;

Impresa        : 'Modificado'                 ;10;3;;NO;NO;;;;0
RB3            : 'MOF'                        ;10;2;;NO;NO;;;;;IF(INSTANCIA=2,0,1)
PrecioMer      : 'Monto USD WF'               ;1;2;3;NO;NO;;;;CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'));CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,VAR('MONEEXTR'))

Cuenta1        : 'Cta V_Moneda:'              ;23;1;1;;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO2, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o VACIO(CUENTA1);'Cuenta Moneda Vehiculo Invalida';;CUENTACLIENTE(VEHICULO1,ESPECIE,,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERCSWIFT'),MERCADO2)),MERCADO2),TIPOOP,'HAB');CUENTACLIENTE(VEHICULO1,ESPECIE,,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERCSWIFT'),MERCADO2)),MERCADO2),TIPOOP,'HAB');;;;;;" (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and Mercado='"~ IIF(Incluido(MERCADO2,Var('MERNOVEHI')) THEN IIF(EqStr(ESPECIE,Var('MONELOCA')) THEN Var('MERCBCRA') ELSE IIF(EqStr(ESPECIE,Var('MONEEXT')) THEN Var('MERSWIFT') ELSE MERCADO2 ENDIF) ENDIF) ELSE MERCADO2 ENDIF) ~"' ";

*Se deja el original previo a sacar el mercado vista a vehiculos. CAL 15/11/2022
*Cuenta1        : 'Cta V_Moneda:'              ;23;1;1;;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO2, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o VACIO(CUENTA1);'Cuenta Moneda Vehiculo Invalida';;CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO2,TIPOOP,'HAB');CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO2,TIPOOP,'HAB');;;;;;" (Especies Like '%MONEDA%' or Especies Like '%"~ESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and Mercado='"~MERCADO2~"' ";

Cuenta2        : 'Cta C_Moneda:'              ;22;2;1;;Not Eqstr(ESPECIE, CONTRAESPECIE);Eqstr(ESPECIE, CONTRAESPECIE) O [CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqStr(MERCADO2, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))] o VACIO(CUENTA2);'Cuenta Moneda ContraParte Invalida';;CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB');CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB');;;;;;" (Especies Like '%MONEDA%' or Especies Like '%"~CONTRAESPECIE~"%') and Estado='HAB' and TipoCuenta In ('CC','CA','CUS','VIS') and Mercado='"~MERCADO2~"' ";

OperacionRef   : 'Op.Referencia'              ;4;2;;Not EV;;VACIO(OPERACIONREF) O [Incluido(Copy(BuscarCampo('Operaciones','TipoOp','NrOperacion',OPERACIONREF),1,2),'MM|')];'El Codigo de Op.Referencia es Invalido';NO;;;;;;;;" TipoOp Like 'MM%'"

REFERENCIA
"Contrato='1'";Not EqStr(ABM,'D')

LISTA:SI;IF(ESINICIO,10,CUOTAS1);
 Fecha1    : 'Inicio Per'   ;;;SI O ESHABIL(CUOTASL.FECHA1[Fila],TABLAFERIADOS1);'Fecha Inicio Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';IF(Fila=1,FECHAOP,CUOTASL.FECHA2[Fila-1]);IF(Fila=1,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila-1]);90;;Fecha;;;;;;;;RB11 = 0
 Plazo1    : 'Plazo'        ;;;CUOTASL.PLAZO1[Fila]>0;'El PLAZO DEBE SER POSITIVO';;;60;;Numero;'####'
 Fecha2    : 'Fin Per'      ;NO;;SI O ESHABIL(CUOTASL.FECHA2[Fila],TABLAFERIADOS1);'Fecha Fin Cuota '~Fstr(Fila, 0, 0)~' NO ES HABIL';;CUOTASL.FECHA1[Fila]+CUOTASL.PLAZO1[Fila];90;;Fecha;;;;;;;;RB11 = 0
 Fecha3    : 'Settlement'     ;;;ESHABIL(CUOTASL.FECHA3[Fila],TABLAFERIADOS1);'FECHA SETTLEMENT NO HABIL EN TABLA SELECCIONADA';;IF(Not EsHabil(CUOTASL.FECHA2[Fila], TABLAFERIADOS1),Habiles2(CUOTASL.FECHA2[Fila],1,TABLAFERIADOS1, SI), CUOTASL.FECHA2[Fila]);90;NO;Fecha;;NO

 Cantidad6 : 'V_Imp_Amor'     ;NOT EV;;CUOTASL.CANTIDAD6[Fila]>=0;'El Importe Amortizacion del Vehiculo debe SER POSITIVO';IF(Fila=CUOTAS1,CANTIDAD,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;IF(Fila=CUOTAS1,CANTIDAD,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###.##';NO;NO;'6'
 Cantidad1 : 'V_Cantidad'     ;NOT EV ;;CUOTASL.CANTIDAD1[Fila]>0;'La Cantidad del Vehiculo es Incorrecta';IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD1[Fila-1]-CUOTASL.CANTIDAD6[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;IF(Fila=1,CANTIDAD,CUOTASL.CANTIDAD1[Fila-1]-CUOTASL.CANTIDAD6[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###,###.##';NO;NO;'6'
 Precio1   : 'V_Tasa'         ;RB1=0 Y Not Eqstr(TIPOTASA, 'FIJA');RB1=0;;;;IF(Eqstr(TIPOTASA, 'FIJA'), PRECIO1, 0);100;;Numero;'###,###.######';NO;NO;'9'
 Total3    : 'V_Spread'       ;;RB1=0 Y Not Eqstr(TIPOTASA, 'FIJA');RB1=1 O Eqstr(TIPOTASA, 'FIJA') O CUOTASL.TOTAL3[Fila] > 0;'Spread del Vehiculo Invalido';;;100;;Numero;'###,###.######'
 Cantidad3 : 'V_Interes'      ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD3[Fila],2) <= ROUND((CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD3[Fila],2) >= ROUND((CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Vehiculo Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO5[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'7'
 
 Cantidad5 : 'C_Imp_Amor'     ;NOT EV;;CUOTASL.CANTIDAD5[Fila]>=0;'El Importe Amortizacion de la ContraParte debe SER POSITIVO';IF(Fila=CUOTAS1,TOTALBRUTOCLI2,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;IF(Fila=CUOTAS1,TOTALBRUTOCLI2,0)-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###.##';NO;NO;'11'
 Cantidad2 : 'C_Cantidad'     ;NOT EV ;;CUOTASL.CANTIDAD2[Fila]>0;'La Cantidad de la Contraparte es Incorrecta';IF(Fila=1,TOTALBRUTOCLI2,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;IF(Fila=1,TOTALBRUTOCLI2,CUOTASL.CANTIDAD2[Fila-1]-CUOTASL.CANTIDAD5[Fila-1])-TOTALBRUTOCLI2+TOTALBRUTOCLI2-CANTIDAD+CANTIDAD-COTIZACION1+COTIZACION1;200;;Numero;'###,###,###,###,###.##';NO;NO;'10'
 
 Precio2   : 'C_Tasa'         ;RB2=0 Y Not Eqstr(TIPOTASA2, 'FIJA');RB2=0;;;;IF(Eqstr(TIPOTASA2, 'FIJA'), PRECIO2, 0);100;;Numero;'###,###.######';NO;NO;'14'
 Total4    : 'C_Spread'       ;;RB2=0 Y Not Eqstr(TIPOTASA2, 'FIJA');RB2=1 O Eqstr(TIPOTASA2, 'FIJA') O CUOTASL.TOTAL4[Fila] > 0;'Spread de la Contraparte Invalido';;;100;;Numero;'###,###.######'
 Cantidad4 : 'C_Interes'      ;EV;;NOT EV o [[ROUND(CUOTASL.CANTIDAD4[Fila],2) <= ROUND((CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100)),2)] y [ROUND(CUOTASL.CANTIDAD4[Fila],2) >= ROUND((CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100)),2)]];'Interes Contraparte Fuera de Rango: '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1-Var('PORVAR')/100),2),0,2)~' y '~FSTR(ROUND(CUOTASL.PRECIO6[Fila]*(1+Var('PORVAR')/100),2),0,2);;((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;NO;Numero;'###,###,###,###,###.##';NO;NO;'12'
 
 Fecha4    : 'F.Reset'        ;NO;[Not EqStr(TIPOTASA,'FIJA') y NOVACIO(TIPOTASA)] O [Not EqStr(TIPOTASA2,'FIJA') y NOVACIO(TIPOTASA2)];;;;HABILES(IF(RB16=0,CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila]),-PLAZO4,TABLAFERIADOS1,SI); 90;;Fecha;NO;NO;;;;;;
 Total2    : 'Resultado'      ;NO;;;;;IF(CUOTASL.PRECIO1[Fila]>0 y CUOTASL.PRECIO2[Fila]>0 Y EqStr(ESPECIE,CONTRAESPECIE) y RB6=0,CUOTASL.CANTIDAD4[Fila]-CUOTASL.CANTIDAD3[Fila],0);200;;Numero;'###,###,###,###,###.##'
 Check1    : 'Ejercio?'       ;NO;;;;;IF(CUOTASL.CANTIDAD3[Fila]=0 O CUOTASL.CANTIDAD4[Fila]=0,0,1);50;NO;Check;NO;SI;

 Precio5   : 'V MOD INT'      ;NO;NO;;;;((CUOTASL.CANTIDAD1[Fila]*(CUOTASL.PRECIO1[Fila]+CUOTASL.TOTAL3[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB8+1);200;;Numero;'###,###.######'
 Precio6   : 'C MOD INT'      ;NO;NO;;;;((CUOTASL.CANTIDAD2[Fila]*(CUOTASL.PRECIO2[Fila]+CUOTASL.TOTAL4[Fila]))/100)*FACTORDIAS(CUOTASL.FECHA1[Fila],CUOTASL.FECHA2[Fila],RB5+1);200;;Numero;'###,###.######'
 Cantidad8 : 'Exposicion MM'  ;NO;NO;;;;;100;;Numero;'###,###,###,###.##'
 Check10   : 'Est.'           ;  ;  ;CUOTASL.CHECK10[Fila] = 0;'La Tasa de la Cuota '~Fstr(Fila, 0, 0)~' Es Estimada';0;;50;;Check;;;;;;;;SI
 Precio3   : 'CtaModiInteres' ;NO;NO;;;;IF(Round(QUERY("SELECT Cantidad3 FROM "~DBO~".CUOTAS WHERE NrOperacion='"~NROPERACION~"' and NrCuota="~Fstr(Fila,0,0)~" "),2)<>Round(CUOTASL.CANTIDAD3[Fila],2),Fila,0);100;;Numero;'###'

 *MTMDIARIO:Query("Select 1 from "~DBO~".MTMDIARIO where NrOperacion='"~NROPERACION~"' ")=1;;
 MTMDIARIO:SI;;
Fecha       : 'Fecha MTM'   ;NO;;;;;;100;NO;Fecha;
PrecioAyer  : 'V_Tasa'      ;NO;;;;;;90;NO;Numero;'###.########';
PrecioHoy   : 'C_Tasa'      ;NO;;;;;;90;NO;Numero;'###.########';
MTM         : 'MTM'         ;NO;;;;;;90;NO;Numero;'###,###.##';
Especie1    : 'Moneda'      ;NO;;;;;;90;NO;String;;
*MTMEspecie  : 'MTM ME'      ;NO;;;;;;90;NO;Numero;'###,###.##';
*Especie2    : 'Moneda'      ;NO;;;;;;90;NO;String;;

 
 CONDICIONES
SUM(CUOTASL,5) =CANTIDAD;'El Imp. de Amortizacion del Vehiculo debe ser igual que el Initial Exchange Vehiculo ';NO
SUM(CUOTASL,10)=TOTALBRUTOCLI2;'El Imp. de Amortizacion de la ContraParte debe ser igual que el Initial Exchange Contraparte';NO
ESHABIL(FECHAOP,'ARG');'LA FECHA DE CONCERTACION NO ES DIA HABIL EN ARGENTINA';SI;SI;FSYS;'COINH'
Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not EqStr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
EqStr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
NOT [EQSTR(ESPECIE,CONTRAESPECIE) Y EQSTR(TIPOTASA,TIPOTASA2)];'Error,  Monedas y Tipos de Tasa Iguales !!!';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
VACIO(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VPRE2*(1+VAR('RPRECIO2')/100) Y PLAZORENOVPREDETER>=VPRE2*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VPRE2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VPRE2*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(CotizaEn(ESPECIE), CONTRAESPECIE) O PLAZORENOVPREDETER<=VPRE2*(1+VAR('RPRECIO') /100) Y PLAZORENOVPREDETER>=VPRE2*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VPRE2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VPRE2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'
 

EDICION
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
EqStr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

MOVIMIENTOS
FechaOp;Cliente1 ;Especie       ;;;;;Vehiculo1;1;     -Cantidad;;'Initial Exchange Vehiculo';SI;;;;;Cuenta1;;1;
FechaOp;Cliente1 ;ContraEspecie ;;;;;Vehiculo1;1; TotalBrutoCli2;;'Initial Exchange Contraparte';SI;;;;;Cuenta2;;2;


MOVCUOTAS
CuotasL.Fecha2[Fila];Cliente1 ;Especie       ;;Vehiculo1;1; CuotasL.Cantidad3[Fila];'Interest Payment Vehiculo'   ;SI;;;CuotasL.Cantidad3[Fila]<>0 y [Not Eqstr(Especie,ContraEspecie) o [Eqstr(Especie,ContraEspecie) y RB6=1]];;Cuenta1;;(Fila+2*CUOTAS1)+4;
CuotasL.Fecha2[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Cantidad4[Fila];'Interest Payment ContraParte';SI;;;CuotasL.Cantidad4[Fila]<>0 y [Not Eqstr(Especie,ContraEspecie) o [Eqstr(Especie,ContraEspecie) y RB6=1]];;Cuenta2;;(Fila+3*CUOTAS1)+4;
CuotasL.Fecha3[Fila];Cliente1 ;Especie       ;;Vehiculo1;1; CuotasL.Cantidad6[Fila];'Final Exchange Vehiculo'     ;SI;;;Not Eqstr(Especie,ContraEspecie) O RB6 = 1;;Cuenta1;;(Fila+4*CUOTAS1)+4;
CuotasL.Fecha3[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Cantidad5[Fila];'Final Exchange Contraparte'  ;SI;;;Not Eqstr(Especie,ContraEspecie) O RB6 = 1;;Cuenta2;;(Fila+5*CUOTAS1)+4;
CuotasL.Fecha3[Fila];Cliente1 ;ContraEspecie ;;Vehiculo1;1;-CuotasL.Total2[Fila];'Resultado '~TIPOOP;SI;;;Eqstr(Especie,ContraEspecie) y RB6=0 y CuotasL.Total2[Fila]<>0;;Cuenta2;;(Fila+6*CUOTAS1)+4;

DEVENGADOSCUOTAS
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];EQSTR(Especie,ContraEspecie)    ;SI;NO;TablaFeriados1;SI;SI;'INTLEN';(-CUOTASL.CANTIDAD3[Fila]+CUOTASL.CANTIDAD4[Fila]);140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'DT';;Fstr(Fila,0,0);Especie;
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];Not EQSTR(Especie,ContraEspecie);SI;NO;TablaFeriados1;SI;SI;'INTLEN';-CUOTASL.CANTIDAD3[Fila]                          ;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;Especie;;;;;;Book1;Operador;'DT';;Fstr(Fila,0,0);Especie;
CUOTASL.FECHA1[Fila]+1;CUOTASL.FECHA2[Fila];Not EQSTR(Especie,ContraEspecie);SI;NO;TablaFeriados1;SI;SI;'INTLEN'; CUOTASL.CANTIDAD4[Fila]                          ;140;Vehiculo1;Vehiculo1;;;;;;TipoOp;;ContraEspecie;;;;;;Book1;Operador;'DT';;Fstr(Fila,0,0);ContraEspecie;

BITS
1;1
3;0
