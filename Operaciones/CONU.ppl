CAMPOS:3;;10
FechaOp         : 'Fecha Alta'   ; 2;2;1;VerificaAcceso('OPFVALOR');;FechaOp<=FSys y FechaOp>=Habiles(FSys,-5,'ARG') Y ESHABIL(FECHAOP,'ARG') Y [ESHABIL(FECHAOP,'USA') O EQSTR(ESPECIE,'ARP')] Y [Mes(FECHAOP)=Mes(FSYS) o SI];'Fecha alta incorrecta';NO;FSYS;
FechaOp2        : 'Fecha otrog.' ; 3;2;1;VerificaAcceso('OPFVALOR');;FechaOp2<=FechaOp Y ESHABIL(FECHAOP2,'ARG') Y [ESHABIL(FECHAOP2,'USA') O EQSTR(ESPECIE,'ARP')];'Fecha otorgamiento incorrecta';NO;FSYS;
