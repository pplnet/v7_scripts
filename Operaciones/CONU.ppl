  Fecha1      : 'F.Origen'      ;NO;  ;;;IF(Fila=1,FECHAOP,CUOTASL.FECHA1[Fila])               ;IF(Fila=1,FECHAOP,CUOTASL.FECHA1[Fila])                                      ; 90;;Fecha;SI;;;
