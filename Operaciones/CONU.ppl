  Cantidad3   : 'Iva'           ;NO;  ;[Fila=1 y CUOTASL.CANTIDAD3[Fila]=0]        o [Fila>1];'Afecta Iva'                      ;IF(MODI,CUOTASL.CANTIDAD3[Fila],IF(Fila=1,0       ,CUOTASL.CANTIDAD3[Fila]));IF(MODI,CUOTASL.CANTIDAD3[Fila],IF(Fila=1,0,       CUOTASL.CANTIDAD3[Fila]))    ;120;;Numero;'###,###,###,###,###.##';SI;NO;;;;;
  Cantidad4   : 'WHT'           ;NO;  ;[Fila=1 y CUOTASL.CANTIDAD4[Fila]=0]        o [Fila>1];'Afecta WHT'                      ;IF(MODI,CUOTASL.CANTIDAD4[Fila],IF(Fila=1,0       ,CUOTASL.CANTIDAD4[Fila]));IF(MODI,CUOTASL.CANTIDAD4[Fila],IF(Fila=1,0,       CUOTASL.CANTIDAD4[Fila]))    ;120;;Numero;'###,###,###,###,###.##';SI;NO;;;;;
  NrOperacion1: 'Referencia'    ;NO;  ;                                                      ;                                  ;NROPERACION                                                                 ;NROPERACION                                                                                ;100;;String;SI;
  Radio1      : 'Concepto'      ;NO;  ;;;IF(Fila=1,0,CUOTASL.RADIO1[Fila])               ;IF(Fila=1,0,CUOTASL.RADIO1[Fila]); 90;;Combo;'Alta CONU|PICO|PICD|Capitaliz.|Precan';NO;;;
  
CONDICIONES:
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB') o EqStr(BuscarCampo('Clientes','HabilitaICL','Codigo',Cliente1),'SI');'El Cliente No esta Habilitado';NO
Precio1>0 o MB1>0;'Se ingreso tasa 0.';SI
Spread>0 o MB2>0;'Se ingreso Spread 0.';SI

SQL
"Update "~DBO~".CUOTAS Set NrOperacion1='"~NROPERACION~"' where NrOperacion = '"~NROPERACION~"' and NrCuota=1 ";EqStr(ABM,'A')
"Update "~DBO~".ICLTERMSHEET Set Utilizado = Utilizado + "~FStr(CANTIDAD,1,2)~" where Codigo = '"~TERMSHEET~"' ";EqStr(ABM,'A') y NoVacio(TERMSHEET)
"Update "~DBO~".ICLTERMSHEET Set Utilizado = Utilizado - "~FStr(CANTIDAD,1,2)~" where Codigo = '"~TERMSHEET~"' ";EqStr(ABM,'D') y NoVacio(TERMSHEET)

