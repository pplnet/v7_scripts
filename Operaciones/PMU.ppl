CAMPOS:2;;11
FechaOp           : 'Fecha Op.'      ; 3;2;1;RB1=0 y RB2=0 y VerificaAcceso('OPFVALOR');;FechaOp <= FSys y FechaOp >= Habiles(FSys,-num(var('CHKFVLPMO')),'ARG') y ESHABIL(FECHAOP,TABLAFERIADOS1);'Fecha incorrecta';NO;FSYS;
Especie           : 'Especie'        ; 1;1;1;RB1=0 y RB2=0; ;NoVacio(ESPECIE) y DesciendeDeEspecie(ESPECIE,'MONEDA') y EsTerminal(ESPECIE, Especie) y Incluido(ESPECIE,Var('LISESPMO'));'Debe Ingresar una Moneda Valida';NO;;IF(MODI,ESPECIE,OPREF.ESPECIE);;Var('LISESPMO')
Cliente1          : 'Cliente'        ; 2;1;1;RB1=0 y RB2=0; ;NOVACIO(CLIENTE1) Y NOT EQSTR(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE1),'BAN') ;'Tipo de Cliente no valido';NO;;;;;;;;"Status = 'HAB' and Sector <> 'BAN' "
Cantidad          :                  ; 3;1;1;RB1=0 y RB2=0; ;CANTIDAD>0;'La Cantidad debe ser positiva';NO;
Precio1           : 'Tasa (%)'       ; 4;1;1;RB1=0 y RB2=0; ;[RB2=0 y PRECIO1>=0] o [RB2=1 y PRECIO1>=0];'La Tasa debe ser '~IF(RB2=0,' mayor o igual que cero',' igual a cero');NO;
DiasAnio          : 'Base|360|365'   ; 5;1;1;RB1=0;  ;;;;IF(RB2=1 y Eqstr(VEHICULO1,var('VEHICULODE')),BuscarCampo('OPERACIONES','DiasAnio','NrOperacion',NROPERACION3),1);IF(RB2=1 y Eqstr(VEHICULO1,var('VEHICULODE')),BuscarCampo('OPERACIONES','DiasAnio','NrOperacion',NROPERACION3),1);
RB8             : 'Prestamo ON|NO|SI'; 1;2;1;  ; ;;;;0
ContraEspecie2    : 'Especie ON'     ; 2;2;1;RB8=1;RB8=1;[RB8=0 y Vacio(CONTRAESPECIE2)] o [RB8=1 y NoVacio(CONTRAESPECIE2) y DesciendeDeEspecie(CONTRAESPECIE2,'ON')];'La especie debe ser una ON';NO;IF(RB8=0,'',CONTRAESPECIE2);;;;;;;"Status = 'HAB' and Codigo In ("~Pipe2Comillas(Descendientes('ESPECIES','ON'))~")"
Plazo             :                  ; 4;2;1;RB1=0 y RB2=0; ;PLAZO>0;'El plazo debe ser mayor que cero';NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP;
FechaVto          : 'Fecha Vto.'     ; 5;2;1;RB1=0 y RB2=0; ;ESHABIL(FECHAVTO,TABLAFERIADOS1) Y [ESHABIL(FECHAVTO,'USA') O NOT EQSTR(ESPECIE,'USD')];'No es un dia habil';NO;HABILES(FECHAOP,1,TABLAFERIADOS1,NO);FECHAOP+PLAZO
MB1               : 'Liquidacion|Com.|Liq.'; 6;2;1;RB1=0;NOVACIO(OPERACIONREF);;;;0;
TotalIntereses    : 'Interes'        ; 6;1;1;NO;  ;;;;;CANTIDAD*PRECIO1*PLAZO/If(DIASANIO=0,36000,36500);
TotalBrutoCli1    : 'Monto'          ; 7;1;1;NO;  ;;;;;CANTIDAD+TOTALINTERESES;

Cuotas1           : 'Cuotas'         ; 7;2;1;NO;NO;Cuotas1>0;'La cantidad de cuotas debe ser positiva';NO;1
Mercado           : 'Merc.Especie'   ; 9;2;1;RB1=0;  ;NOVACIO(MERCADO);'Debe indicar mercado';NO;;if(MODI,MERCADO,BuscarCampo('ESPECIES','MercadoDef','Codigo',ESPECIE));;;;;;"Observaciones like '%M%' "
Mercado2          : 'Merc.Moneda'    ; 9;2;1;NO;NO;;;;MERCADO;MERCADO;;;;;;"Observaciones like '%M%' "
Vehiculo1         : 'Vehiculo '      ; 8;1;1;RB1=0 y Eqstr(ABM,'A');;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;if(Eqstr(ABM,'A'),VAR('VEHICULODE'),Vehiculo1)
Book1             : 'Book'           ; 9;1;1;RB1=0;;NoVacio(BOOK1) ;'Debe ingresar un Book';NO;BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');;;;;;"Estado  = 'HAB' and Vehiculo = '"~VEHICULO1~"' and "~"(TiposOperacion = '' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') " 
Operador          :                  ;10;1;1;NO;  ;;;;USUARIOACTIVO;
RB1               : 'Con Gar.2412'   ;10;2;1;NO;NO;;;;0;
RB2               : 'Gar.2412'       ;10;2;1;NO;NO;;;;0;

NrOperacion2      : 'Op.Fondeo'      ;11;1;1;RB1=0 y RB2=0;RB2=0;[RB2=0 y NOVACIO(NROPERACION2) Y EQSTR(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',NrOperacion2),'IMM')] o Vacio(NROPERACION2);'La operacion debe ser IMM';NO;;;;;;;;" TipoOp ='IMM' and (NrOperacion2 = ' ' or NrOperacion2 is Null) and Vehiculo1= '"~VEHICULO1~"' and Especie ='"~ESPECIE~"' AND Book1 = '"~BOOK1~"' "
NrOperacion3      : 'Prest.Asoc.'    ;11;1;1;[Eqstr(VEHICULO1,var('VEHICULODE')) y RB2=1];[Eqstr(VEHICULO1,var('VEHICULODE')) y RB2=1] o [Eqstr(VEHICULO1,'INGCURA') y RB1=1];[NOVACIO(NROPERACION3) y Eqstr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',NROPERACION3),'PMU') y [RB2=1 o RB1=1]] o Vacio(NROPERACION3); 'La operacion debe ser PMU';NO;;;;;;;;" TipoOp ='PMU' and Cliente1='"~CLIENTE1~"' and Especie ='"~ESPECIE~"' and Cantidad = "~Fstr(CANTIDAD,0,0)~" and Plazo = "~PLAZO~" and Cuotas1 = "~CUOTAS1~" and FechaOp = '"~IdxDate(FECHAOP)~"' and Vehiculo1= 'INGCURA' and (NrOperacion3 = ' ' or NrOperacion3 is Null) and (RB1='0' or RB1=' ' or RB1 is Null) "
Precio2           : 'Spread'         ;11;2;1;NO;  ;PRECIO2>=0;'Spread debe ser mayor o igual a 0';NO;;if(Eqstr(ABM,'A'),PRECIO1-BuscarCampo('OPERACIONES','Precio1','NrOperacion',NROPERACION2),PRECIO2)

TipoCambio        : 'Tipo Cambio'    ;11;2;1;RB1=0 y NOT EQSTR(ESPECIE,'ARP');NO;TIPOCAMBIO>=VPRE1*0.9 y TIPOCAMBIO<=VPRE1*1.1;'Debe ingresar el Tipo de Cambio dentro del rango';SI;1;IF(EQSTR(ESPECIE,'ARP'),1,IF(MODI,TIPOCAMBIO,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')))
VPRE1             : 'T.C.default'    ;12;2;1;NO;NO;;;;1;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP');
FechaVto2         : 'FechaVto IMM'   ;13;2;1;NO;NO;[RB2=0 y NOVACIO(NROPERACION2)] o Vacio(NROPERACION2);;;;IF(NoVacio(NROPERACION2),BuscarCampo('OPERACIONES','FechaVto','NrOperacion',NROPERACION2),0)

VTXT19            : 'Ascend_Especie' ;12;1;1;NO;NO;;;;;Ascendientes('ESPECIES',ESPECIE)
CuentaContable1   : 'Forma Cobro'    ;12;1;1;RB1=0;NO;SI o [NOVACIO(CUENTACONTABLE1) y Query("Select Count(*) from "~DBO~".FORMASPAGO Where CuentaContable='"~CUENTACONTABLE1~"' and Vehiculo='"~VEHICULO1~"' and Mercado='"~MERCADO ~"' and Especie in ("~Pipe2Comillas(VTXT19)~") ")>0];'Debe ingresar una forma de Cobro valida';NO;;FormaPago(ESPECIE,MERCADO ,'COB',TIPOOP,VEHICULO1);
CuentaContable2   : 'Forma Pago '    ;12;1;1;RB1=0;NO;SI o [NOVACIO(CUENTACONTABLE2) y Query("Select Count(*) from "~DBO~".FORMASPAGO Where CuentaContable='"~CUENTACONTABLE2~"' and Vehiculo='"~VEHICULO1~"' and Mercado='"~MERCADO2~"' and Especie in ("~Pipe2Comillas(VTXT19)~") ")>0];'Debe Ingresar una Forma de Pago valida' ;NO;;FormaPago(ESPECIE,MERCADO2,'PAG',TIPOOP,VEHICULO1);

TasaInteresesCupon: 'Tasa Punitoria' ;13;1;1;RB1=0;  ;TasaInteresesCupon>=0;'La tasa punitoria debe ser positiva';NO;;IF(RB2=1 y Eqstr(VEHICULO1,var('VEHICULODE')),BuscarCampo('OPERACIONES','TasaInteresesCupon','NrOperacion',NROPERACION3),0);
EsAforado         : 'Sindicado'      ;14;1;1;RB1=0;;

MB3              : 'Tasa WHT|Normal|Acrecentada'  ;12;2;1;RB1=0;EqStr(VEHICULO1,'INGCURA');MB3>=0 o not EqStr(VEHICULO1,'INGCURA');'Debe especificar el tipo de tasa';NO;;1
RB9: 'Comision|No|Up-Front|Due-Front';13;2;1;RB1=0 y RB2<>1        ;;;;;;IF(RB2=1,2,0)
RB10: 'Valor|Fijo|Porcentaje'        ;14;2;1;RB1=0 y RB9=2 y RB2<>1;;;;;;IF(RB2=1,1,0)
TotalComisiones   : 'Comision'       ;15;2;1;RB1=0 y [RB9=1 o [RB9=2 y RB10=0]];;;;;;IF(RB9=2 y RB10=1,CANTIDAD*PORCOMISION*PLAZO/If(DIASANIO=0,36000,36500),TOTALCOMISIONES)
PorComision       : 'Porcentaje'     ;16;2;1;RB1=0 y RB9=2 y RB10=1;;PORCOMISION>0 o not[RB1=0 y RB9=2 y RB10=1];'Ingrese el porcentaje';NO;;IF(RB9=2 y RB10=1,PORCOMISION,0)

