CAMPOS:3;;10
FechaOp         : 'Fecha Op.'     ;3;2;1;VerificaAcceso('OPFVALOR');;FechaOp <= FSys y FechaOp >= Habiles(FSys,-4,'ARG') Y ESHABIL(FECHAOP,'ARG') Y Mes(FECHAOP)=Mes(FSYS);'Fecha incorrecta';NO;FSYS;
OperacionRef    : 'Op.Ref.'       ;1;2; ;  ;  ;NOT NOVACIO(OPERACIONREF) O EQSTR(OPREF.TIPOOP,'MMPF')];'La operacion de referencia no es un Plazo Fijo';NO;;IF(MODI,OPERACIONREF,Query("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'MMPF' and Cliente1='"~CLIENTE1~"' and Especie='"~ESPECIE~"' and (RB6 = '0' or RB6 is NULL) and FechaVto = '"~IdxDate(FECHAOP)~"'"));;SQLSet("Select NrOperacion from "~DBO~".OPERACIONES where TipoOp = 'MMPF' and Cliente1='"~CLIENTE1~"' and Especie='"~ESPECIE~"' and (RB6 = '0' or RB6 is NULL) and FechaVto = '"~IdxDate(FECHAOP)~"' ");NO;
Especie         : 'Especie'       ;1;1; ;  ;  ;NOVACIO(ESPECIE)  Y Incluido(ESPECIE,'ARP|USD');'Debe ingresar ARP o USD';NO;;IF(MODI,ESPECIE,OPREF.ESPECIE);;'ARP|USD|';NO
Cliente1        : 'Cliente'       ;2;1; ;  ;  ;NOVACIO(CLIENTE1) Y [DESCIENDEDECLIENTE(CLIENTE1,'BEXTER') O DESCIENDEDECLIENTE(CLIENTE1,'EMPRESAS') O DESCIENDEDECLIENTE(CLIENTE1,'VINCULADOS') O DESCIENDEDECLIENTE(CLIENTE1,'CLIENTES') O EqStr(BuscarCampo('Clientes','Vinculado','Codigo',CLIENTE1),'SI')];'Debe ingresar un Cliente que sea un Banco Exterior, una Empresa, un Cliente o un Vinculado';NO;;IF(MODI,CLIENTE1,OPREF.CLIENTE1);;;;;;" (Jerarquia like '"~VAR('JERBANCOEX')~'%'~"' or Jerarquia like '"~VAR('JERCLIEMP')~'%'~"'  or Jerarquia like '"~VAR('JERVINCULA')~'%'~"' or Jerarquia like '"~VAR('JERCLIENTE')~'%'~"') or Vinculado='SI' and Status ='HAB'"
Cantidad        :                 ;3;1; ;  ;  ;CANTIDAD>0;'La Cantidad de ser positiva';NO;;IF(MODI,CANTIDAD,OPREF.CANTIDAD)
Precio2         : 'Tasa (%)'      ;4;1; ;  ;  ;PRECIO2>=0;'La Tasa debe ser positiva';NO;;IF(MODI,PRECIO2,OPREF.PRECIO2)
Plazo           :                 ;4;2; ;  ;  ;PLAZO>=Var('PLMINPF');'El plazo debe ser mayor o igual a '~Var('PLMINPF')~' dias';NO;IF(ESHABIL(FECHAOP+Var('PLMINPF'),TABLAFERIADOS1) Y [ESHABIL(FECHAOP+Var('PLMINPF'),'USA') O EQSTR(ESPECIE,'ARP')],Var('PLMINPF'),IF(EQSTR(ESPECIE,'ARP'),HABILES(FECHAOP+Var('PLMINPF'),1,TABLAFERIADOS1),HABILES(FECHAOP+Var('PLMINPF'),1,'USA'))-FECHAOP);FECHAVTO-FECHAOP;
FechaVto        : 'Fecha Vto.'    ;5;2; ;  ;  ;ESHABIL(FECHAVTO,TABLAFERIADOS1) Y [ESHABIL(FECHAVTO,'USA') O NOT EQSTR(ESPECIE,'USD')];'No es un dia habil';NO;FECHAOP+PLAZO;FECHAOP+PLAZO;
MB1             : 'Liquidacion|Com.|Liq.';6;2; ;  ;NOVACIO(OPERACIONREF);;;;0;IF(MODI,MB1,OPREF.MB1)
TotalIntereses  : 'Interes'       ;5;1; ;NO;  ;;;;;CANTIDAD*PRECIO2*PLAZO/If(DIASANIO=0,36000,36500);
TotalGanancias  : 'Ret.Ganan.'    ;6;1; ;NO;NO;;;;;TOTALINTERESES*PRECIO3/100;
TotalBrutoCli1  : 'Monto'         ;7;1; ;NO;  ;;;;;CANTIDAD+TOTALINTERESES-TOTALGANANCIAS;
Operador        : 'Gestor'        ;8;1; ;NO;  ;;;;;IF(INSTANCIA=3,Query("Select Responsable from "~DBO~".CLIENTES where Codigo ='"~CLIENTE1~"'"),USUARIOACTIVO);

Book1           : 'Book'          ;9;1; ;  ;  ;Incluido(BOOK1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') "));'Book Invalido.';NO;BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');;;;;;" Estado  = 'HAB' and Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";

VTXT10          : 'Vehiculo'      ;9;1; ;NO;NO;;;;;if(VACIO(BuscarCampo('BOOKS','Vehiculo','Codigo',BOOK1)),'',BuscarCampo('BOOKS','Vehiculo','Codigo',BOOK1));

Vehiculo1       : 'Vehiculo '     ;10;1; ;  ;  ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')
RB9             : 'Grossing up|Con|Sin'  ;10;2;;Eqstr(VTXT15, 'NOR');Eqstr(VTXT15, 'NOR');Not Eqstr(VTXT15, 'NOR') O RB9 >= 0;'Debe Indicar Si es Con o Sin Grossing Up';NO;-1;
Vtxt2           : 'Operador'      ;8;2; ;NO;  ;;;;;if(Vacio(USRINPUT),USUARIOACTIVO,USRINPUT);;;;;'##########'

CB5             : 'Transferible'  ;7;2; ;  ;  ;;;;0;IF(MODI,CB5,OPREF.CB5)
VCAN9           : 'Grossing up'   ;;;;NO;NO;;;;;IF(Eqstr(VTXT15, 'NOR') Y RB9 = 0, 100 - BuscarCampo('PAISES','Ganancias','Codigo', VTXT16), 100);
Precio3         : '% Ret.Gan.'    ;1;1;2;NO;NO;;;;;IF(Eqstr(VTXT15, 'INS'),Var('RETINSC'),IF(Eqstr(VTXT15, 'NOI'),Var('RETNOINSC'),IF(Eqstr(VTXT15, 'NOR'),BuscarCampo('PAISES','Ganancias','Codigo', VTXT16)/VCAN9*100, 0)));
Mercado         : 'Merc.Especie'  ;2;1;2;;;NOVACIO(MERCADO);'Debe indicar mercado';NO;;MercadoDef(ESPECIE);;;;;;" Observaciones like '%M%' "
Mercado2        : 'Merc.Moneda'   ;2;1;2;NO;NO;;;;;MercadoDef(CONTRAESPECIE);;;;;;" Observaciones like  '%M%' "
Corporate       : 'Corporate'     ;3;1;2;NO;  ;;;;;If(INSTANCIA=3,1,0)
RB4             : 'Financ.Inter.' ;4;1;2;NO;  ;;;;;If(INSTANCIA=5,1,0)
RB6             : 'Estado|Pend|Renov.|Cancel.';4;2;2;NO;;;;;0
Precio4         : 'Tasa base (%)' ;6;1;2;NO;SI;;;;;TASADIA('TRANSF',ESPECIE,FECHAOP,PLAZO,1);
RB5             : 'Tipo T.base|Transferencia|Call';7;1;2;NO;NO;;;;;0
DiasAnio        : 'Base|360|365'  ;9;2;1;SI;SI;;;;1
Precio1         : 'Tasa 365'      ;7;1;2;NO;DIASANIO=0;;;;;if(DIASANIO=0,(PRECIO2*365)/360,PRECIO2)

*Se deja el original previo a sacar el mercado vista a vehiculos
*Cuenta1         : 'Cta.Esp.Veh.:'   ;9;1;2;FW=1; ;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1)       y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o NOT NOVACIO(CUENTA1); ;;CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB');CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB');

Cuenta1         : 'Cta.Esp.Veh.:'   ;9;1;2;FW=1; ;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1)       y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o NOT NOVACIO(CUENTA1); ;;CUENTACLIENTE(VEHICULO1,ESPECIE,,IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO)),MERCADO),TIPOOP,'HAB');CUENTACLIENTE(VEHICULO1,ESPECIE,,IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),IF(EQSTR(ESPECIE,VAR('MONEEXTR')),VAR('MERSWIFT'),MERCADO)),MERCADO),TIPOOP,'HAB');
Cuenta2         : 'Cta.Mon.Veh.:'   ;9;2;2;NO;NO;;;;;CUENTA1;
Cuenta3         : 'Cta.Esp.Clie. :' ;10;1;2;FW=1; ;[CLIENTECUENTA(CLIENTE1,CUENTA3)  y ESPECIECUENTA(ESPECIE,CUENTA3)       y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA3))] o NOT NOVACIO(CUENTA3); ;;CUENTACLIENTE(CLIENTE1,ESPECIE,,MERCADO,TIPOOP,'HAB') ;CUENTACLIENTE(CLIENTE1,ESPECIE, ,MERCADO,TIPOOP,'HAB');
Cuenta4         : 'Cta.Mon.Clie. :' ;10;2;2;NO;NO;;;;;CUENTA3;

TablaFeriados1  : 'Feriados'        ;11;1;2; ;  ;NoVacio(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;'ARG';;;Var('LISFERIADO')

Cartera         : 'Cartera|Trading|Investment|Comerc';1;1;1;NO;NO;;;;0
ContraEspecie   : 'ContraEspecie'   ; ; ; ;NO;NO;;;;;ESPECIE
VTXT15          : 'Insc.Ganancia'   ;;;;NO;NO;;;;GANANCIAS(CLIENTE1);GANANCIAS(CLIENTE1);
VTXT16          : 'Pais'            ;;;;NO;NO;;;;;BuscarCampo('Clientes','PaisDir','Codigo',CLIENTE1);

CONDICIONES:
PRECIO4>0;'La Tasa base NO puede ser Negativa o Cero';NO
Not FECHAOP<FSYS o EV;'Es una Operacion FechaValor';SI;SI;FSYS;'FVALOR'
PRECIO2<=PRECIO4*(1+VAR('RTASA1')/100) Y PRECIO2>=PRECIO4*(1-VAR('RTASA1')/100);'Tasa Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RTASA1')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RTASA1')/100),1,7);SI;SI;Fsys;'RANGOTASA';
[Eqstr(Especie,Opref.Especie)] o [Not NoVacio(OperacionRef)];'No coincide la especie con la operacion de referencia';NO
[Eqstr(Cliente1,Opref.Cliente1)] o [Not NoVacio(OperacionRef)];'No coincide el cliente con la operacion de referencia';NO
[FechaOp=Opref.FechaVto] o [Not NoVacio(OperacionRef)];'La operacion de referencia no ha vencido aun';NO

Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado));'Ingreso un Mercado de Especie' ;NO 
SI o Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado2)) ;'Ingreso un Mercado de Titulos para el Mercado de Moneda';NO 

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Gestor, Vehiculo o no esta Habilitado ';NO


SQL:NOVACIO(OPERACIONREF)
"Update "~DBO~".OPERACIONES set RB6 = '1' where NrOperacion = '"~OperacionRef~"'"

MOVIMIENTOS
FechaOp  ;Cliente1 ;Especie ;;;;MERCADO;Vehiculo1;1;      -Cantidad;;'Concert.Plazo Fijo '~Especie;SI;NO;1;NOVACIO(CLIENTE1);;Cuenta3;;1;'MM';;;;;;Book1
FechaVto ;Cliente1 ;Especie ;;;;MERCADO;Vehiculo1;1; TotalBrutoCli1;;'Vto.Plazo Fijo '~Especie;SI;NO;2;NOVACIO(CLIENTE1);;Cuenta3;;2;'MM';;;;;;Book1

DEVENGADOS
FechaOp ;FechaVto-1;Plazo <= VAR('PLAZOLINEA');NO;SI;'ARG';SI;NO;'INTLEN';-TotalIntereses;140;VTXT10;VTXT10;;;;;;;;Especie;;;;;;Book1;;;;;Especie;0;
FechaOp ;FechaVto-1;Plazo  > VAR('PLAZOLINEA');NO;SI;'ARG';SI;NO;'INTLEN';-TotalIntereses;140;VTXT10;VTXT10;;;;;;;;Especie;;;;;;Book1;;;;;Especie;1;CANTIDAD;PRECIO2;IF(Eqstr(DIASANIO,'0'),360,365)


BITS
1;1
3;0
7;0
10;0
30;0
70;0

INSTANCIA1
POSTEDICION
FW=2;'ANULO';NrOperacion1=NROPERACION
SQL
"UPDATE "~DBO~".INSTANCIASOP SET Mensaje = '"~OBSERVAC~"' Where NrOperacion = '"~NROPERACION~"' and NrInstancia = "~FSTR(INSTANCIA,2)

BITS
1;0;FW=1 o FW=2
8;1;FW=1 y Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ") = 1
7;1;FW=1 y Query(" Select 1 From "~DBO~".EXCEPCIONES Where NrOperacion = '"~NROPERACION~"' And Tipo = 'FVALOR' ") = 0
30;1;FW=2


INSTANCIA8
CAMPOS:0
FechaOp        : 'Fecha Op.'      ;2;2;1;NO
Especie        : 'Especie'        ;1;1; ;NO
Cliente1       : 'Cliente'        ;2;1; ;NO
Cantidad       : 'Cantidad'       ; ; ; ;NO
Precio1        : 'Precio'         ; ; ; ;NO
Plazo          : 'Plazo'          ;3;2; ;NO
FechaVto       : 'Fecha Liq.'     ;4;2; ;NO
TotalIntereses : 'Intereses'      ;5;1; ;NO
TotalBrutoCli1 : 'Monto'          ;6;1; ;NO
Vehiculo1      :                  ;7;1; ;NO
Operador       :                  ;8;1; ;NO
Observaciones:  ;;;2

BITS
8;0;FW=1 o FW=2
1;1;FW=2
7;1;FW=1


INSTANCIA7
BITS
7;0;FW=2
30;1;FW=2


INSTANCIA10
BITS
10;0;FW=2 y Query(" Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~NROPERACION~"' ") <> 1
30;1;FW=2 y Query(" Select 1 From "~DBO~".MOVEJECUTADOS Where NrOperacion = '"~NROPERACION~"' ") <> 1

INSTANCIA70
BITS
1;1;FW=2 y [Query("Select COUNT(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~NROPERACION~"'  and NrSaldo = 1 ") = 0]
70;0;FW=2 y [Query("Select COUNT(*) from "~DBO~".MOVEJECUTADOS where NrOperacion = '"~NROPERACION~"'  and NrSaldo = 1 ") = 0]


