CAMPOS:1;;35
Especie          : 'Mon. Compra'            ; 1;1;;Not EV;;NoVacio(ESPECIE) y EqStr(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'MON') y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Moneda Valida';NO;'USD';;;;;;;"Status = 'HAB' and Tipo in ('MON')"
ContraEspecie    : 'Mon. Venta'             ; 1;2;;Not EV;;NoVacio(CONTRAESPECIE) y EqStr(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'MON') y EsTerminal(CONTRAESPECIE, Especie);'Debe Ingresar una Moneda Valida';NO;;;;;;;;"Status = 'HAB' and Tipo in ('MON')"
MB1              : '|Compra|Venta'          ; 2;2;;NO;NO;;;;0;
Cliente1         : 'Cliente'                ; 2;1;;Not EV;;NoVacio(CLIENTE1) y EsTerminal(CLIENTE1,Cliente);'Debe ingresar un Cliente Valido';NO;;;;;;;;"Status = 'HAB'"

Cantidad         : 'Imp. Compra'            ; 3;1; ;Not EV Y MB1=0;;CANTIDAD>0 o MB1=1      ;'El Importe comprado debe ser Positivo';NO;;IIF(MB1=0 THEN CANTIDAD  ELSE  IIF(PRECIO1=0 THEN 0 ELSE IIF(CB5=1 THEN TOTALBRUTOCLI1/PRECIO1 ELSE TOTALBRUTOCLI1*PRECIO1 ENDIF) ENDIF) ENDIF);
Precio1          : 'Tipo Cambio'            ; 4;1; ;Not EV;  ;PRECIO1>0 o [INSTANCIA>1 y PRECIO1=0];'El Tipo de Cambio debe ser Positivo';NO;0;IIF(SI THEN PRECIO1 ELSE IIF(EqStr(CAMPOMODIFICADO,'PRECIO1') o EqStr(CAMPOMODIFICADO,'CANTIDAD') THEN PRECIO1 ELSE IIF(CB5=1  THEN TOTALBRUTOCLI1/CANTIDAD ELSE CANTIDAD/TOTALBRUTOCLI1 ENDIF) ENDIF) ENDIF);;;;;'###,###.##########'
Precio4          : 'Tipo Cambio INV'        ; 2;2; ;NO;NO;;;;0;IIF(CB5=1 THEN PRECIO1 ELSE 1/PRECIO1 ENDIF);;;;;'###,###.##########'
TotalBrutoCli1   : 'Imp. Venta'             ; 5;1; ;Not EV Y MB1=1;;TOTALBRUTOCLI1>0 o MB1=0;'El Importe vendido debe ser Positivo' ;NO;;IIF(SI THEN IIF(MB1=1 THEN TOTALBRUTOCLI1 ELSE IIF(PRECIO1=0 THEN 0 ELSE IIF(CB5=1 THEN CANTIDAD*PRECIO1 ELSE CANTIDAD/PRECIO1 ENDIF) ENDIF) ENDIF) ELSE IIF(EqStr(CAMPOMODIFICADO,'TOTALBRUTOCLI1') THEN TOTALBRUTOCLI1 ELSE CANTIDAD*PRECIO4 ENDIF) ENDIF);

FechaOp          : 'Fecha Op.'              ; 3;2; ;Not EV Y VerificaAcceso('OPFVALOR');  ;FECHAOP <= FSYS y EsHabil(FECHAOP,'ARG');'Fecha de Operacion Feriado o Incorrecta';NO;FSYS;
Plazo            : 'Plazo'                  ; 4;2; ;Not EV;;PLAZO>0;'El Plazo debe ser mayor que Cero (0) ';NO;FECHAPAGO-FECHAOP;FECHAPAGO-FECHAOP
Puesto           : 'Puesto'                 ; 5;2; ;Not EV;  ;;;;1;
FechaVto         : 'Fecha Vto.'             ; 6;2; ;NO    ;  ;ESHABIL(FECHAVTO ,TABLAFERIADOS1);'No es un Dia Habil';NO;FinDeMes(FECHAOP,NO,TABLAFERIADOS1);HABILES(FECHAOP,IF(PUESTO=1, PLAZO, PLAZO+1),TABLAFERIADOS1,NO)
FechaPago        : 'Fecha Pago.'            ; 7;2; ;Not EV;  ;ESHABIL(FECHAPAGO,TABLAFERIADOS1);'No es un Dia Habil';NO;FinDeMes(FECHAOP,NO,TABLAFERIADOS1);HABILES(FECHAOP,PLAZO,TABLAFERIADOS1,NO)
MercadoRB    : 'Mercado|Local|Internacional'; 8;2; ;NO;NO;;;;0;
FormaLiquidacion1: 'Liquidacion|STD|DVP|RVP'; 9;2; ;Not EV;;FORMALIQUIDACION1>=0;'Forma de Liquidacion Invalida';NO;;IIF(MODI THEN FORMALIQUIDACION1 ENDIF)
TablaFeriados1   : 'Feriados'               ;10;2; ;Not EV;;NoVacio(TABLAFERIADOS1);'Se debe indicar feriados a utilizar';NO;IIF(MERCADORB=0 THEN 'ARG' ELSE 'USA' ENDIF);IIF(MODI THEN TABLAFERIADOS1 ELSE IIF(MERCADORB=0 THEN 'ARG' ELSE 'USA' ENDIF) ENDIF);
RB10          : 'Tipo|Delivery|Non Delivery'; 6;1; ;NO;NO;;;;0;
Corredor         : 'Corredor'               ; 7;1; ;Not EV;;;;
Comision         : 'Comision (%o)'          ; 8;1; ;Not EV Y NoVacio(CORREDOR);;;;;;IIF(Vacio(CORREDOR) THEN 0 ELSE IIF(EqStr(CAMPOMODIFICADO,'COMISION') THEN COMISION ELSE IIF(EqStr(CAMPOMODIFICADO,'TOTALCOMISIONES') THEN TOTALCOMISIONES*100/TOTALBRUTOCLI1 ELSE PORCOMISION ENDIF) ENDIF) ENDIF);;;;;'###,###.######';;SI
TotalComisiones  : 'Importe Com.'           ; 9;1; ;Not EV;;;;;;TOTALNETOCLI3*COMISION/100;
Vehiculo1        : 'Vehiculo '              ;11;1; ;Not EV;;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE');
Book1            : 'Book'                   ;12;1; ;;;Incluido(BOOK1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') "));'Book Invalido.';NO;BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');;;;;;" Estado  = 'HAB' and Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
Operador         : 'Operador'               ;11;2; ;NO;;;;;;USUARIOACTIVO;
ConceptoBCRA     : 'Conc. BCRA'             ;13;2; ;;Not Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE1),'BAN');Vacio(CONCEPTOBCRA) o [MB1=0 y EqStr(BuscarCampo('CONCEPTOSBCRA','Alias1','Codigo',ConceptoBCRA),'COMPRA')] o [MB1=1 y EqStr(BuscarCampo('CONCEPTOSBCRA','Alias1','Codigo',ConceptoBCRA),'VENTA')];IIF(MB1=0 THEN 'Debe Ingresar un Concepto BCRA de Compra' ELSE  'Debe Ingresar un Concepto BCRA de Venta' ENDIF);NO;;;;;;;;"('"~MB1~"' = '0' and Alias1 = 'COMPRA') or ('"~MB1~"' = '1' and Alias1 = 'VENTA')";

Mercado4         : 'M. Negociac.'     ;13;1; ;  ;;NOVACIO(MERCADO4);'Debe ingresar Mercado Negociacion Moneda';NO;VAR('MERCADOFX');;;;;;;"TipoNegocio Like '%FM%' and EsNegociacion = 'SI' "
Mercado          : 'Merc.M.E.Com.'    ;14;1;;Not EV;;NOVACIO(MERCADO);'Debe indicar Mercado de Especie';NO;MercadoDef(ESPECIE);MercadoDef(ESPECIE);;;;;;" Observaciones Like '%M%' "
Cuenta1          : 'Cta.Esp.Veh.'     ;15;1;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o VACIO(CUENTA1);;;CUENTACLIENTE(VEHICULO1,ESPECIE,,IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),VAR('MERSWIFT')),MERCADO),TIPOOP,'HAB');IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,ESPECIE,,IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),VAR('MERSWIFT')),MERCADO),TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~ IF(INCLUIDO(MERCADO,VAR('MERNOVEHI')),IF(EQSTR(ESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),VAR('MERSWIFT')),MERCADO)~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ";

*Se deja el original previo a sacarle el mercado vista a vehículos. CAL 14/11/2022
*Cuenta1          : 'Cta.Esp.Veh.'     ;14;1;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1) y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o VACIO(CUENTA1);;;CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB');IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~Mercado~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ";


Mercado2         : 'Merc.M.E.Pago'    ;14;2;;Not EV;;NOVACIO(MERCADO2);'Debe indicar Mercado de Moneda';NO;MercadoDef(CONTRAESPECIE);MercadoDef(CONTRAESPECIE);;;;;;" Observaciones Like '%M%' "
Cuenta2          : 'Cta.Mon.Veh.'     ;15;2;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))] o NOT NOVACIO(CUENTA2);;;CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),VAR('MERSWIFT')),MERCADO2),TIPOOP,'HAB');IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),VAR('MERSWIFT')),MERCADO2),TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~ IF(INCLUIDO(MERCADO2,VAR('MERNOVEHI')),IF(EQSTR(CONTRAESPECIE,VAR('MONELOCA')),VAR('MERCBCRA'),VAR('MERSWIFT')),MERCADO2) ~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') ";

*Se deja el original previo a sacarle el mercado vista a vehículos. CAL 14/11/2022
*Cuenta2          : 'Cta.Mon.Veh.'     ;14;2;;Not EV;;[CLIENTECUENTA(VEHICULO1,CUENTA2) y ESPECIECUENTA(CONTRAESPECIE,CUENTA2) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA2))] o NOT NOVACIO(CUENTA2);;;CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB');IF(NoVacio(BOOK1), CUENTACLIENTE(VEHICULO1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~Mercado2~"' and Cliente='"~VEHICULO1~"' AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') ";

Cuenta3          : 'Cta.Esp.Cli.'     ;16;1;;Not EV;;[CLIENTECUENTA(CLIENTE1,CUENTA3) y ESPECIECUENTA(ESPECIE,CUENTA3) y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA3))] o NOT NOVACIO(CUENTA3);;;CUENTACLIENTE(CLIENTE1,ESPECIE,,MERCADO,TIPOOP,'HAB');IF(NoVacio(BOOK1), CUENTACLIENTE(CLIENTE1,ESPECIE, ,MERCADO,TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~Mercado~"' and Cliente='"~CLIENTE1~"' AND (Especies Like '%"~ESPECIE~"%' OR Especies Like '%MONEDA%') ";
Cuenta4          : 'Cta.Mon.Cli.'     ;16;2;;Not EV;;[CLIENTECUENTA(CLIENTE1,CUENTA4) y ESPECIECUENTA(CONTRAESPECIE,CUENTA4) y EqStr(MERCADO2,BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA4))] o NOT NOVACIO(CUENTA4);;;CUENTACLIENTE(CLIENTE1,CONTRAESPECIE,,MERCADO2,TIPOOP,'HAB');IF(NoVacio(BOOK1), CUENTACLIENTE(CLIENTE1,CONTRAESPECIE, ,MERCADO2,TIPOOP,'HAB'));;;;;;" Estado='HAB' and Mercado='"~Mercado2~"' and Cliente='"~CLIENTE1~"' AND (Especies Like '%"~CONTRAESPECIE~"%' OR Especies Like '%MONEDA%') ";

RB9              : 'Tipo Com:|Agredido|Agresor';8;1;;NO;NO;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), -1)
VCAN21           : 'ValorComis'     ;16;1;2;NO;NO;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), IF(RB9<>-1 y EqStr(BuscarCampo('COMISIONESCORREDOR','Agresor','Corredor',CORREDOR),'AMB'),ValorComCorredor(CORREDOR,ESPECIE,TIPOOP,'AMB'),ValorComCorredor(CORREDOR,ESPECIE,TIPOOP,VTXT7)));;;;;'###,###.######'
VTXT7            : 'Val.Agred/Agres';16;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), IF(RB9=1,'AGE',IF(RB9=0,'AGI','AMB')))
PorComision      : 'ValorComis'     ; 1;1;2;NO;  ;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), VCAN21);;;;;'###,###.######'
CB5              : 'Cotiz.Directa'  ; 1;2;2;NO;  ;;;;;IIF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'DIR') THEN 1 ELSE 0 ENDIF)
Cotizacion1      : 'Cotiz.Especie'  ; 2;1;2;NO;  ;;;;;COTIZACION(ESPECIE,,,,FECHAOP,1)
TipoCambio2      : 'Cot.Inv.Esp'    ; 2;2;2;NO;NO;;;;;1/COTIZACION1
CB6              : 'Especie/USD'    ; 2;2;2;NO;NO;;;;;IIF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='USD' "),'INV') THEN 0 ELSE 1 ENDIF)
Cotizacion2      : 'Cotiz.M.Pago'   ; 3;1;2;NO;  ;;;;;COTIZACION(CONTRAESPECIE,,,,FECHAOP,1)
TipoCambio3      : 'Cot.Inv.CEsp'   ; 3;2;2;NO;NO;;;;;1/COTIZACION2
CB7              : 'CEspecie/USD'   ; 3;2;2;NO;NO;;;;;IIF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='USD' "),'INV') THEN 0 ELSE 1 ENDIF)
TotalBrutoCli2   : 'T.USD Eq.Esp.'  ; 4;1;2;NO;  ;;;;;IF(Incluido(ESPECIE,'USD|USB'),CANTIDAD,IF(Incluido(CONTRAESPECIE,'USD|USB'),TOTALBRUTOCLI1,CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD')))
TipoCambio       : 'Precio Mdo.'    ; 4;2;2;NO;  ;;;;;IIF(CB5=1 THEN COTIZACION1/COTIZACION2 ELSE COTIZACION2/COTIZACION1 ENDIF)
Precio3          : 'Precio Venc'    ; 5;1;2;NO;  ;;;;PRECIO1;PRECIO1;
TotalNetoCli3    : 'Total ARP Eq.'  ; 5;2;2;NO;  ;;;;Cotizacion('USD',,,,FECHAOP,1)*TOTALBRUTOCLI2;Cotizacion('USD',,,,FECHAOP,1)*TOTALBRUTOCLI2

PaseCB           : 'Pase'           ; 6;1;2;NO;PASECB=1;
OperacionRef     : 'Referencia'     ; 6;2;2;NO;PASECB=1;

VTXT10           : 'Controlante'    ; 9;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~CLIENTE1~"' "))
VTXT11           : 'Controlante'    ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),IF(VACIO(VTXT10),CLIENTE1,CLIENTE1))
TotalAux1        : 'T.USD Eq.CEsp.' ; 8;1;2;NO;  ;;;;;IF(NoVacio(BOOK1), IF(Incluido(CONTRAESPECIE,'USD|USB|ULI'),TOTALBRUTOCLI1,IF(Incluido(ESPECIE,'USD|USB|ULI'),CANTIDAD,TOTALBRUTOCLI1*if(CB7=1,COTIZACION2,1/COTIZACION2))))
VTXT15           : 'Esp.RiskWeight' ; 8;2;2;NO;  ;;;;;IF(NoVacio(BOOK1), IF(BuscarCampo('ESPECIES','Valor3','Codigo',ESPECIE)>=BuscarCampo('ESPECIES','Valor3','Codigo',CONTRAESPECIE),ESPECIE,CONTRAESPECIE))
VTXT16           : 'For.Liq.RiskW.' ; 9;1;2;NO;  ;;;;;IF(NoVacio(BOOK1), IF(FORMALIQUIDACION1=1,'DVP','STD'))
VPRE4            : 'Max Plazo RW'   ; 9;2;2;NO;  ;;;;;IF(NoVacio(BOOK1), Query("Select Max(Plazo) from "~DBO~".RISKWEIGHT where Especie = '"~VTXT15~"' and TipoOp = '"~TIPOOP~"' and FormaLiquidacion = '"~VTXT16~"'"))
VPRE10           : 'Plazo 2'        ; 3;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(PLAZO<=365,PLAZO,IF(NOT ESHABIL(FECHAOP+365,TABLAFERIADOS1),IF(FECHAPAGO=HABILES(FECHAOP+365,1,TABLAFERIADOS1),365,PLAZO),PLAZO)));
VPRE5            : 'Plazo RW'       ;10;1;2;NO;  ;;;;;IF(NoVacio(BOOK1), if(VPRE10>VPRE4,VPRE4,VPRE10))
PorCaucion       : 'RiskWeighting'  ;10;2;2;NO;  ;;;;;IF(NoVacio(BOOK1), Query("Select Factor from "~DBO~".RISKWEIGHT where Especie = '"~VTXT15~"' and TipoOp = '"~TIPOOP~"' and FormaLiquidacion = '"~VTXT16~"' and Plazo >= "~VPRE5~" and Fecha <= '"~IdxDate(FECHAOP)~"' order by Fecha desc, Plazo"))
TotalAux3        : 'PreSettlement'  ;11;1;2;NO;  ;;;;;IF(NoVacio(BOOK1), IF(Incluido(ESPECIE,'USD|USB|ULI'),CANTIDAD,IF(Incluido(CONTRAESPECIE,'USD|USB|ULI'),TOTALBRUTOCLI1,CANTIDAD*COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD')))*if(PORCAUCION=0,Var('PORPRESMON')/100,PORCAUCION/100))
TotalBrutoCli3   : 'Total.PreSett.' ;11;2;2;NO;  ;;;;;IF(NoVacio(BOOK1), LIMCONSUMIDO(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)+TOTALAUX3)
VCAN7            : 'Sett.FVto'      ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1))
VCAN8            : 'Sett.FPago'     ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1))
VCAN9            : 'T.Sett.FVto'    ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMSUMADO(VTXT11,'SETTLEMENT',FECHAVTO ,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2)
VCAN10           : 'T.Sett.FPago'   ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMSUMADO(VTXT11,'SETTLEMENT',FECHAPAGO,VEHICULO1,,,NROPERACION)+TOTALAUX1)
MinDerechoBolsa  : 'Exc Presett'         ;8;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF([VACIO(CLIENTE1)] o LimOperativo(VTXT11,'PRESETTLEM','USD',VEHICULO1) >= TOTALAUX3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION), 0, (LimOperativo(VTXT11,'PRESETTLEM','USD',VEHICULO1) - (TOTALAUX3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)))));
MinDerechoMercado: 'Exc Settlem F.Pago'  ;9;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF([VACIO(CLIENTE1)] o [FORMALIQUIDACION1=1] o VCAN8 >= VCAN10, 0, VCAN10 - VCAN8));
MinArancel       : 'Exc Settlem F.Vto'   ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF([VACIO(CLIENTE1)] o [FORMALIQUIDACION1=1] o PUESTO=1 o VCAN7 >= VCAN9, 0, VCAN9 - VCAN7));
VCAN17           : 'Sett.FVto GE'   ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) y NoVacio(VTXT10), LimOperativo(VTXT10,'SETTLEMENT','USD',VEHICULO1),0)
VCAN18           : 'Sett.FPago GE'  ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) y NoVacio(VTXT10), LimOperativo(VTXT10,'SETTLEMENT','USD',VEHICULO1),0)
VCAN19           : 'T.Sett.FVto GE' ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) y NoVacio(VTXT10), LIMSUMADO(VTXT10,'SETTLEMENT',FECHAVTO ,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2,0)
VCAN20           : 'T.Sett.FPago GE';10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) y NoVacio(VTXT10), LIMSUMADO(VTXT10,'SETTLEMENT',FECHAPAGO,VEHICULO1,,,NROPERACION)+TOTALAUX1,0)

NroAltaMAE       : 'NroAltaMAE'     ;13;1;2;NO;NoVacio(NroAltaMAE);
RB5:'Cross-Limit|Commited|Uncomited';17;1;2;NO;NO;;;;1;1;

TotalAux5        : 'Cot.USD/ARP'    ;15;1;2;;;;;;;IF(NoVacio(BOOK1), COTIZACIONC('USD',,,,FECHAOP,1,SI,'ARP'));;;;;'####.########'
PorDerechoBolsa  : 'C.Esp ARP'        ;16;1;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORDERECHOBOLSA, TOTALBRUTOCLI2*TOTALAUX5/CANTIDAD));;;;;'###,###.########'
PorImpuestoBolsa : 'C.Esp USD'        ;17;1;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORIMPUESTOBOLSA, if(CB6=0,CANTIDAD/TOTALBRUTOCLI2,TOTALBRUTOCLI2/CANTIDAD)));;;;;'###,###.########'
InteresesCorr    : 'C.CE USD'         ;16;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, INTERESESCORR, if(CB7=0,TOTALBRUTOCLI1/TOTALBRUTOCLI2,TOTALBRUTOCLI2/TOTALBRUTOCLI1)));;;;;'###,###.########'
PorDerechoMercado: 'C.CE ARP'         ;17;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORDERECHOMERCADO, TOTALBRUTOCLI2*TOTALAUX5/TOTALBRUTOCLI1));;;;;'###,###.########'
PorArancel       : 'Esp Vto.Forward'  ;14;1;2;NO;NO;;;;;PORDERECHOBOLSA
PorArancel2      : 'CEspVto.Forward'  ;14;2;2;NO;NO;;;;;PORDERECHOMERCADO

VTXT19            : 'WF MAE reducido' ;1;3;2;NO;NO;;;;IF(EqStr(BuscarCampo('VARIABLES','Valor','Codigo','WFMAEREDU'),'SI'),'SI','NO');;;;;'XX';

CONDICIONES:

[NoVacio(NroAltaMAE)] O [Not EqStr(MERCADO,'SWIFT')] o [Not Incluido(ESPECIE,Var('ESPBILLETE'))];'No se admite Mercado SWIFT para Especie Billete';NO
[NoVacio(NroAltaMAE)] O PASECB <> 1 o EV                ;'Una operacion relacionada no se puede modificar'    ;NO
[NoVacio(NroAltaMAE)] O Not EqStr(ESPECIE,'ARP')        ;'La Moneda de Compra debe ser Moneda Extranjera'     ;NO
[NoVacio(NroAltaMAE)] O Not EqStr(CONTRAESPECIE,'ARP')  ;'La Moneda de Pago debe ser Moneda Extranjera'       ;NO
[NoVacio(NroAltaMAE)] O Not EqStr(CONTRAESPECIE,ESPECIE);'Las Monedas de Compra y de Pago deben ser Distintas';NO
[NoVacio(NroAltaMAE)] O Not EqStr(CLIENTE1,VEHICULO1)   ;'Debe Ingresar un Cliente Valido'                    ;NO
[NoVacio(NroAltaMAE)] O Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO

Not FECHAOP<FSYS                ;'Es una Operacion FechaValor'                        ;SI;SI;FSYS;'FVALOR'
[PRECIO1<=TIPOCAMBIO*(1+VAR('FXDESPRE1') /100) Y PRECIO1>=TIPOCAMBIO*(1-VAR('FXDESPRE1') /100)] o [INSTANCIA>1 y PRECIO1=0];'Tipo de Cambio fuera de rango. De '~FStr(TipoCambio*(1-VAR('FXDESPRE1')/100),1,7)~' a '~FStr(TipoCambio*(1+VAR('FXDESPRE1')/100),1,7);SI;SI;FSYS;'RANGOPRECI'

[NoVacio(NroAltaMAE)] O Query("Select 1 from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' ")>0;'No Existe la relacion '~ESPECIE~'/'~CONTRAESPECIE~' en Tabla MODOESPECIES';NO
[NoVacio(NroAltaMAE)] O Query("Select 1 from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~ESPECIE~"' ")>0;'No Existe la relacion '~CONTRAESPECIE~'/'~ESPECIE~' en Tabla MODOESPECIES';NO
[NoVacio(NroAltaMAE)] O Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1);'No se pueden hacer arbitrajes para cliente No Financieros';NO

Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

VACIO(VTXT11) o ExisteLimite('PRESETTLEM',VTXT11,'USD',Vehiculo1)                                                                                ; 'Presettlement Cliente no asignado'   ;SI;SI;FSYS;'PRESETNOAS'
VACIO(VTXT11) o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1) >= TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion); 'Presettlement Cliente excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'PRESETEXCE'

Vacio(VTXT10) o PaseCB=1 o ExisteLimite('PRESETTLEM',VTXT10,'USD',Vehiculo1)                                                                                ; 'Presettlement no asignado'   ;SI;SI;FSYS;'PRESETNOAS'
Vacio(VTXT10) o PaseCB=1 o LimOperativo(VTXT10,'PRESETTLEM','USD',Vehiculo1) >= TotalAux3+LimConsumido(VTXT10,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion); 'Presettlement excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT10,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(VTXT10,'PRESETTLEM','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'PRESETEXCE'

SI o [NOT NOVACIO(CLIENTE1)] o Not ExisteLimite('PRESETTLEM',VTXT11,'USD',Vehiculo1) o Tenor('PRESETTLEM',VTXT11,'USD',Vehiculo1)>=VPRE10; 'Presettlement Tenor excedido';SI;SI;FSYS;'PRESETTENO'
SI o [NOT NOVACIO(CLIENTE1)] o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,1) >= TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,1)                   ; 'Presettlement 1 a 30 excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,1)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,1),1,0)~'.-'       ;SI;SI;FSYS;'PRESETEXCE'
SI o [NOT NOVACIO(CLIENTE1)] o VPRE10 < 31 o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,31) >= TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,31)   ; 'Presettlement 31 a 90 excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,31)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,31),1,0)~'.-'    ;SI;SI;FSYS;'PRESETEXCE'
SI o [NOT NOVACIO(CLIENTE1)] o VPRE10 < 91 o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,91) >= TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,91)   ; 'Presettlement 91 a 180 excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,91)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,91),1,0)~'.-'   ;SI;SI;FSYS;'PRESETEXCE'
SI o [NOT NOVACIO(CLIENTE1)] o VPRE10 < 181 o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,181) >= TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,181); 'Presettlement 181 a 365 excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,181)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,181),1,0)~'.-';SI;SI;FSYS;'PRESETEXCE'
SI o [NOT NOVACIO(CLIENTE1)] o VPRE10 < 366 o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,366) >= TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,366); 'Presettlement 366 a 730 excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion,,,,,,,,,366)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1,,,,,,,,,,366),1,0)~'.-';SI;SI;FSYS;'PRESETEXCE'

VACIO(VTXT11) o PaseCB=1 o FormaLiquidacion1=1 o ExisteLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1)                                                                                ; 'Settlement Cliente no asignado'                                              ;SI;SI;FSYS;'SETTLENOAS'
VACIO(VTXT11) o PaseCB=1 o FormaLiquidacion1=1 o Not ExisteLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1) o VtoLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1) >= FechaPago              ; 'Settlement Cliente '~FechaPago~' vencido'                                    ;SI;SI;FSYS;'SETTLEVENC'
VACIO(VTXT11) o PaseCB=1 o FormaLiquidacion1=1 o VCAN8 >= VCAN10                                                                                                                  ; 'Settlement Cliente '~FechaPago~' excedido en U$D '~PYC(VCAN10-VCAN8,1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'
VACIO(VTXT11) o PaseCB=1 o FormaLiquidacion1=1 o Puesto=1 o Not ExisteLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1) o VtoLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1) >= FechaVto    ; 'Settlement Cliente '~FechaVto~' vencido'                                     ;SI;SI;FSYS;'SETTLEVENC'
VACIO(VTXT11) o PaseCB=1 o FormaLiquidacion1=1 o Puesto=1 o VCAN7 >= VCAN9                                                                                                        ; 'Settlement Cliente '~FechaVto~' excedido en U$D '~PYC(VCAN9 -VCAN7,1,0)~'.-' ;SI;SI;FSYS;'SETTLEEXCE'

Vacio(VTXT10) o PaseCB=1 o FormaLiquidacion1=1 o ExisteLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1)                                                                                ; 'Settlement Controlante '~VTXT10~' no asignado'                                               ;SI;SI;FSYS;'SETTLENOAS'
Vacio(VTXT10) o PaseCB=1 o FormaLiquidacion1=1 o Not ExisteLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1) o VtoLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1) >= FechaPago              ; 'Settlement Controlante '~VTXT10~' '~FechaPago~' vencido'                                     ;SI;SI;FSYS;'SETTLEVENC'
Vacio(VTXT10) o PaseCB=1 o FormaLiquidacion1=1 o VCAN18 >= VCAN20                                                                                                                 ; 'Settlement Controlante '~VTXT10~' '~FechaPago~' excedido en U$D '~PYC(VCAN20-VCAN18,1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'
Vacio(VTXT10) o PaseCB=1 o FormaLiquidacion1=1 o Puesto=1 o Not ExisteLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1) o VtoLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1) >= FechaVto    ; 'Settlement Controlante '~VTXT10~' '~FechaVto~' vencido'                                      ;SI;SI;FSYS;'SETTLEVENC'
Vacio(VTXT10) o PaseCB=1 o FormaLiquidacion1=1 o Puesto=1 o VCAN17 >= VCAN19                                                                                                      ; 'Settlement Controlante '~VTXT10~' '~FechaVto~' excedido en U$D '~PYC(VCAN19 -VCAN17,1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR,'HAB' );'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO
BookValido(VAR('BOOKCONTRA'), TIPOOP, CONTRAESPECIE, Vehiculo1, OPERADOR, 'HAB');'El Book de Contraespecie '~VAR('BOOKCONTRA')~' es Invalido.';NO

MOVIMIENTOS:
FechaVto ;Cliente1;Especie      ;;;;MERCADO ;Vehiculo1;1;-Cantidad       ;;'Arb.Termino '~Especie~'/'~ContraEspecie;SI;NO;1;;;Cuenta3;;1;'FX';;;;;;Book1;Vehiculo1
FechaPago;Cliente1;ContraEspecie;;;;MERCADO2;Vehiculo1;1; TotalBrutoCli1 ;;'Arb.Termino '~Especie~'/'~ContraEspecie;SI;NO;2;;;Cuenta4;;2;'FX';;;;;;Book1;Vehiculo1
FechaOp  ;Corredor;Contraespecie;;;;Mercado2;Vehiculo1;9;TotalComisiones ;;'Arb.Termino de '~Especie;SI;SI; ;NOVACIO(CORREDOR)  ;;   ;;3;'FX';;;;;;Book1;Vehiculo1

POSICION:
FechaOp  ;Vehiculo1;Especie      ;;FechaVto;;Vehiculo1;;;;;IF(RB10=0,41,42); Cantidad ;PorDerechoBolsa;;;Book1;
FechaVto ;Vehiculo1;Especie      ;;FechaVto;;Vehiculo1;;;;;IF(RB10=0,41,42);-Cantidad ;PorDerechoBolsa;;;Book1;

FechaVto ;Vehiculo1;Especie      ;;        ;;Vehiculo1;;;;;31;  Cantidad ;PorArancel     ;;;Book1;;;RB10=0 y CB8=1;
FechaVto ;Vehiculo1;Especie      ;;        ;;Vehiculo1;;;;;51;  Cantidad ;PorArancel     ;;;Book1;;;RB10=0 y CB8=1;

FechaVto ;Vehiculo1;Especie      ;;        ;;Vehiculo1;;;;;31;  Cantidad ;COTIZACIONC(ESPECIE,,,,FECHAVTO-1,1,SI,'ARP');;;Book1;;;RB10=0 y CB8=0;
FechaVto ;Vehiculo1;Especie      ;;        ;;Vehiculo1;;;;;51;  Cantidad ;COTIZACIONC(ESPECIE,,,,FECHAVTO-1,1,SI,'ARP');;;Book1;;;RB10=0 y CB8=0;


FechaOp  ;Vehiculo1;ContraEspecie;;FechaVto;;Vehiculo1;;;;;IF(RB10=0,41,42);-TotalBrutoCli1;PorDerechoMercado;;;Book1;
FechaPago;Vehiculo1;ContraEspecie;;FechaVto;;Vehiculo1;;;;;IF(RB10=0,41,42); TotalBrutoCli1;PorDerechoMercado;;;Book1;

FechaPago;Vehiculo1;ContraEspecie;;        ;;Vehiculo1;;;;; 31;-TotalBrutoCli1;PorArancel2      ;;;Book1;;;RB10=0 y CB8=1;
FechaPago;Vehiculo1;ContraEspecie;;        ;;Vehiculo1;;;;; 51;-TotalBrutoCli1;PorArancel2      ;;;Book1;;;RB10=0 y CB8=1;

FechaPago;Vehiculo1;ContraEspecie;;        ;;Vehiculo1;;;;; 31;-TotalBrutoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAVTO-1,1,SI,'ARP');;;Book1;;;RB10=0 y CB8=0;
FechaPago;Vehiculo1;ContraEspecie;;        ;;Vehiculo1;;;;; 51;-TotalBrutoCli1;COTIZACIONC(CONTRAESPECIE,,,,FECHAVTO-1,1,SI,'ARP');;;Book1;;;RB10=0 y CB8=0;


LIMITES:
FechaOp  ;VTXT11;'SETTLEMENT';ContraEspecie;FechaVto ; TotalBrutoCli2;TipoOp~' '~Especie;PaseCB=0            y FormaLiquidacion1<>1;Vehiculo1;
FechaOp  ;VTXT11;'SETTLEMENT';ContraEspecie;FechaPago;      TotalAux1;TipoOp~' '~Especie;PaseCB=0 y Puesto=0 y FormaLiquidacion1<>1;Vehiculo1;

FechaOp  ;VTXT10;'SETTLEMENT';ContraEspecie;FechaVto ; TotalBrutoCli2;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y PaseCB=0            y FormaLiquidacion1<>1;Vehiculo1;
FechaOp  ;VTXT10;'SETTLEMENT';ContraEspecie;FechaPago;      TotalAux1;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y PaseCB=0 y Puesto=0 y FormaLiquidacion1<>1;Vehiculo1;

FechaOp  ;VTXT11;'PRESETTLEM';'USD'        ;         ;      TotalAux3;TipoOp~' '~Especie;PaseCB=0                                             ;Vehiculo1;
FechaVto ;VTXT11;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie;PaseCB=0 y FormaLiquidacion1<>1 y FechaVto<=FechaPago;Vehiculo1;
FechaPago;VTXT11;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie;PaseCB=0 y FormaLiquidacion1<>1 y FechaVto>FechaPago ;Vehiculo1;

FechaOp  ;VTXT10;'PRESETTLEM';'USD'        ;         ;      TotalAux3;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y PaseCB=0                                             ;Vehiculo1;
FechaVto ;VTXT10;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y PaseCB=0 y FormaLiquidacion1<>1 y FechaVto<=FechaPago;Vehiculo1;
FechaPago;VTXT10;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y PaseCB=0 y FormaLiquidacion1<>1 y FechaVto>FechaPago ;Vehiculo1;


@INSTFXCV
