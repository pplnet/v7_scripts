CAMPOS:1;;35
Especie          : 'Moneda'         ; 1;1;;Not EV;  ;NoVacio(ESPECIE) y EqStr(BuscarCampo('ESPECIES','Tipo','Codigo',ESPECIE),'MON') y EsTerminal(ESPECIE, Especie);'Debe Ingresar una Moneda Valida';NO;'USD';;;;;;;"Status = 'HAB' and Tipo in ('MON')";
VCAN1            : 'LockRate'       ; 1;1; ;NO;NO;;;;;IIF(SI THEN 0 ELSE BuscarCampo('ESPECIES','Factor','Codigo',ESPECIE) ENDIF);
ContraEspecie    : 'Mon. Pago'      ; 1;2; ;NO;  ;;;;;'ARP';
Cliente1         : 'Cliente'        ; 2;1; ;Not EV Y PASECB=0;  ;EsTerminal(CLIENTE1,Cliente) y NoVacio(CLIENTE1) ;'Debe Ingresar un Cliente Valido';NO;;IIF(CB5=1 THEN CLIENTE1 ELSE OPREF.CLIENTE1 ENDIF);;;;;;"Status = 'HAB'"
Cantidad         : 'Importe'        ; 3;1; ;Not EV;  ;CANTIDAD>0;'EL Importe debe ser Positivo';NO;OPREF.CANTIDAD;IIF(CB5=1 THEN CANTIDAD ELSE OPREF.CANTIDAD ENDIF);
Precio1          : 'Tipo Cambio'    ; 4;1; ;Not EV;;PRECIO1>0 o [INSTANCIA>1 y PRECIO1=0];'El Tipo de Cambio debe ser Positivo';NO;0;IIF(CB5=1 THEN PRECIO1 ELSE IIF(VCAN1<>0 THEN IIF(EqStr(CampoModificado,'PRECIO2') THEN 1/(VCAN1/PRECIO2) ELSE PRECIO1 ENDIF) ELSE IIF(Not EqStr(CampoModificado,'TOTALBRUTOCLI1') THEN PRECIO1 ELSE TOTALBRUTOCLI1/CANTIDAD ENDIF) ENDIF) ENDIF);;;;;'###,###.##########';
Precio2          : 'Euro/USD'       ; 9;2;2;VCAN1<>0 Y Not EV;VCAN1<>0;[VCAN1<>0 Y PRECIO2>0] O PRECIO2>=0 ;'El Tipo de Cambio EURO/USD debe ser Positivo';NO;COTIZACION('EUR',,,,FECHAOP,1);IIF(VCAN1<>0 THEN IIF(EqStr(CampoModificado,'PRECIO1') THEN VCAN1/(1/PRECIO1) ELSE COTIZACION('EUR',,,,FECHAOP,1) ENDIF) ENDIF);
TotalBrutoCli1   : 'Monto'          ; 5;1;1;Not EV;;;;;0;IIF(EqStr(CampoModificado,'TOTALBRUTOCLI1') THEN TOTALBRUTOCLI1 ELSE CANTIDAD*PRECIO1 ENDIF);

TotalNetoCli3    : 'Equiv.Euro'     ; 2;2;1;NO;VCAN1<>0;;;;;CANTIDAD/VCAN1;
FechaOp          : 'Fecha Op.'      ; 3;2; ;VerificaAcceso('OPFVALOR') Y Not EV;;FECHAOP <= FSYS y EsHabil(FECHAOP,'ARG');'Fecha de Operacion Feriado o Incorrecta';NO;FSYS;IIF(CB5=1 THEN FECHAOP ELSE OPREF.FECHAOP ENDIF)
FechaVto         : 'F.Liq.Mon.'     ; 4;2; ;VALORRB1=4 Y PUESTO=0 Y Not EV;;EsHabil(FECHAVTO ,TABLAFERIADOS1);'No es un Dia Habil';NO;;IIF(VACIO(OPERACIONREF) THEN IIF(VALORRB1=4 THEN IIF(PUESTO=1 THEN FECHAPAGO ELSE FECHAVTO ENDIF) ELSE HABILES(FECHAOP,VALORRB1+IIF(PUESTO=1 THEN 0 ELSE 1 ENDIF),TABLAFERIADOS1) ENDIF) ELSE OPREF.FECHAVTO ENDIF);
FechaPago        : 'F.Liq.Mon.Pago' ; 5;2; ;Not EV Y VALORRB1=4;;EsHabil(FECHAPAGO,TABLAFERIADOS1);'No es un Dia Habil';NO;;IIF(VALORRB1=4 THEN FECHAPAGO ELSE HABILES(FECHAOP,VALORRB1,TABLAFERIADOS1) ENDIF);
Plazo            : 'Plazo'          ; 5;2; ;NO;NO;;;;FECHAPAGO-FECHAOP;FECHAPAGO-FECHAOP;
ValorRB1         : 'Valor|Hoy|Normal|24hs|48hs'; 6;2;;Not EV;;;;;0;IF(DifDias(FECHAPAGO,FECHAOP,TABLAFERIADOS1) >= 4, 4, DifDias(FECHAPAGO,FECHAOP,TABLAFERIADOS1))
Puesto           : 'Puesto'                 ; 7;2;;Not EV;;;;;1;
FormaLiquidacion1: 'Liquidacion|STD|DVP|RVP'; 8;2;;PUESTO=1 Y Not EV;PUESTO=1;FORMALIQUIDACION1>=0;'Forma de Liquidacion Invalida';NO;;IIF(PUESTO=0 THEN 0 ELSE IIF(MODI THEN FORMALIQUIDACION1 ELSE FORMALIQUIDACION1 ENDIF) ENDIF);
TablaFeriados1   : 'Feriados'       ; 9;2; ;Not EV;  ;NoVacio(TABLAFERIADOS1) o EV;'Se debe indicar feriados a utilizar';NO;IIF(HABILES(FECHAOP,3,'ARG')=HABILES(FECHAOP,3,'USA') THEN 'ARG' ELSE 'ARG' ENDIF);IIF(MODI THEN TABLAFERIADOS1 ELSE IIF(HABILES(FECHAOP,3,'ARG')=HABILES(FECHAOP,3,'USA') THEN 'ARG' ELSE 'ARG' ENDIF) ENDIF);
Corredor         : 'Corredor'       ; 7;1; ;Not EV;  ;;
Comision         : 'Comision (%o)'  ; 9;1; ;Not EV Y NoVacio(CORREDOR);;;;;;IIF(Vacio(CORREDOR) THEN 0 ELSE IIF(EqStr(CAMPOMODIFICADO,'COMISION') THEN COMISION ELSE IIF(EqStr(CAMPOMODIFICADO,'TOTALCOMISIONES') THEN TOTALCOMISIONES*100/TOTALBRUTOCLI1 ELSE PORCOMISION ENDIF) ENDIF) ENDIF);;;;;'###,###.######';;SI
TotalComisiones  : 'Importe Com.'   ;10;1; ;Not EV;;;;;;TOTALBRUTOCLI1*COMISION/100;
Vehiculo1        : 'Vehiculo '      ;11;1; ;Not EV;;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE');
Book1            : 'Book'           ;12;1; ;      ;;Incluido(BOOK1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') "));'Book Invalido.';NO;BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');;;;;;" Estado  = 'HAB' and Vehiculo='"~VEHICULO1~"' AND (TiposOperacion='' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
Operador         : 'Operador'       ;10;2; ;NO;;;;;;USUARIOACTIVO;
** 19-05-23 AA se visualiza sin importar el Cliente
**ConceptoBCRA     : 'Conc. BCRA'     ;11;2; ;;Not Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE1),'BAN');[Vacio(CONCEPTOBCRA) y Eqstr(BuscarCampo('CLIENTES','Sector','Codigo',CLIENTE1),'BAN')] o [NoVacio(CONCEPTOBCRA) y EqStr(BuscarCampo('CONCEPTOSBCRA','Alias1','Codigo',ConceptoBCRA),'COMPRA')];'Debe Ingresar un Concepto valido de compra';NO;VAR('CONBCRAC');;;;;;;"Alias1 = 'COMPRA' ";
ConceptoBCRA     : 'Conc. BCRA'     ;11;2; ;;;Vacio(CONCEPTOBCRA) o [NoVacio(CONCEPTOBCRA) y EqStr(BuscarCampo('CONCEPTOSBCRA','Alias1','Codigo',ConceptoBCRA),'COMPRA')];'Debe Ingresar un Concepto valido de compra';NO;VAR('CONBCRAC');;;;;;;"Alias1 = 'COMPRA' ";
**Plaza1           : 'Instr.Compra:'  ;12;2; ;Not EV;RB3<>1 y NoVacio(CLIENTE1) y Not[Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)];SI O RB3=1 o [RB3<>1 y EqStr(PLAZA1,'01') y Incluido(ESPECIE,Var('ESPBILLETE'))] o [RB3<>1 y NoVacio(PLAZA1) y Not[Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)] y Not Incluido(ESPECIE,Var('ESPBILLETE'))] o [RB3<>1 y Vacio(PLAZA1) y Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1) y Not Incluido(ESPECIE,Var('ESPBILLETE'))];'Debe Ingresar un Instrumento Valido de Compra';NO;IIF(Incluido(ESPECIE,Var('ESPBILLETE')) THEN '01' ELSE PLAZA1 ENDIF);IIF(Incluido(ESPECIE,Var('ESPBILLETE')) THEN '01' ELSE PLAZA1 ENDIF);;;;;"!!"; 
Plaza1           : 'Instr.Compra:'  ;12;2; ;Not EV;RB3<>1;SI O RB3=1 o [RB3<>1 y EqStr(PLAZA1,'01') y Incluido(ESPECIE,Var('ESPBILLETE'))] o [RB3<>1 y NoVacio(PLAZA1) y Not[Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)] y Not Incluido(ESPECIE,Var('ESPBILLETE'))] o [RB3<>1 y Vacio(PLAZA1) y Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1) y Not Incluido(ESPECIE,Var('ESPBILLETE'))];'Debe Ingresar un Instrumento Valido de Compra';NO;IIF(Incluido(ESPECIE,Var('ESPBILLETE')) THEN '01' ELSE '02' ENDIF);IIF(Incluido(ESPECIE,Var('ESPBILLETE')) THEN '01' ELSE '02' ENDIF);;;;;"!!"; 

CB8              : 'M.Cierre Pmo'   ;13;2; ;Not EV;NO;;;;0
RB2              : 'Circ.3619'      ;13;1; ;Not EV Y [Incluido(CONCEPTOBCRA,'101|102')];[incluido(CONCEPTOBCRA,'101|102')];RB2=0 o [Incluido(CONCEPTOBCRA,'101|102')];'La Operacion no puede ser Circular 3619';NO;0;IIF(Incluido(CONCEPTOBCRA,'101|102') THEN RB2 ELSE 0 ENDIF);

CodErrorMAE      : 'Nr.Oficializ:'  ;8;1;;Not EV;NO Y Incluido(CONCEPTOBCRA,Var('CONIMPOR')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1);SI O [Vacio(CODERRORMAE) y [Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1) o Not Incluido(CONCEPTOBCRA,Var('CONIMPOR'))]] o [NoVacio(CODERRORMAE) y Incluido(CONCEPTOBCRA,Var('CONIMPOR')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)]                                                             ;'Debe ingresar el Nr.Oficializacion';NO;;IIF(Not [Incluido(CONCEPTOBCRA,Var('CONIMPOR'))      y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)] THEN '' ELSE CODERRORMAE ENDIF);;;;;"XXXXXXXXXXXXXXXX"; 
Observac2        : 'Pagador:'       ;8;2;;Not EV;NO Y Not Incluido(CONCEPTOBCRA,Var('CONIMSINB')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1);SI O [Vacio(OBSERVAC2)   y [Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1) o Incluido(CONCEPTOBCRA,Var('CONIMSINB'))]]    o [NoVacio(OBSERVAC2)   y Not Incluido(CONCEPTOBCRA,Var('CONIMSINB')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)]                                                             ;'Debe ingresar el Pagador'          ;NO;;IIF(Not [Not Incluido(CONCEPTOBCRA,Var('CONIMSINB')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)] THEN '' ELSE OBSERVAC2   ENDIF);
CodErrorCV       : 'Pais Pagador:'  ;9;2;;Not EV;NO Y Not Incluido(PLAZA1,Var('INSSINPAIS')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)     ;SI O [Vacio(CODERRORCV)  y [Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1) o Incluido(PLAZA1,Var('INSSINPAIS'))]]         o [NoVacio(CODERRORCV)  y Not Incluido(PLAZA1,Var('INSSINPAIS'))      y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1) y NoVacio(BuscarCampo('PAISES','Codigo','Alias',CODERRORCV))];'El codigo de pais no es valido'    ;NO;;IIF(Not [Not Incluido(CONCEPTOBCRA,Var('CONIMSINB')) y Not Incluido(Ascendientes('CLIENTES',CLIENTE1),var('JERCLIFIN'),1)] THEN '' ELSE IIF(NoVacio(CODERRORCV) THEN  (copy(SQLSet("Select P.Alias from "~DBO~".PAISES P, "~DBO~".CORRESPONSALES R, "~DBO~".CUENTAS C where C.Codigo='"~CUENTA1~"' and R.Codigo=C.Corresponsal and P.Codigo=R.Pais"),1,3)) ELSE '' ENDIF) ENDIF);

TotalBrutoCli2   : 'Total USD Eq.'  ; 1;1;2;NO;;;;;;CANTIDAD*COTIZACION2
NrTrans1         : 'Mulc'           ; 1;2;2;;;;;;;;;;;;;"TipoTr2 in('DENOP','RENOP','TRNOP') and CB10='1' ";
RB9              : 'Tipo Com:|Agredido|Agresor';8;1;;NO;NO;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), -1)
VCAN25           : 'ValorComis'     ;16;1;2;NO;;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), IF(RB9<>-1 y EqStr(BuscarCampo('COMISIONESCORREDOR','Agresor','Corredor',CORREDOR),'AMB'),ValorComCorredor(CORREDOR,ESPECIE,TIPOOP,'AMB'),ValorComCorredor(CORREDOR,ESPECIE,TIPOOP,VTXT7)));;;;;'###,###.######'
VTXT7            : 'Val.Agred/Agres';16;2;2;NO;;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), IF(RB9=1,'AGE',IF(RB9=0,'AGI','AMB')))
PorComision      : 'ValorComis'     ; 2;1;2;NO;;;;;;IF(NoVacio(BOOK1) O Vacio(NroAltaMAE), VCAN25);;;;;'###,###.######'
Arbitraje        : 'Arbitraje'      ; 4;1;2;NO;ARBITRAJE=1;;;;0
PaseCB           : 'Pase'           ; 5;1;2;NO;PASECB=1   ;;;;0
OperacionRef     : 'ArbitRef'       ; 2;2;1;EqStr(BuscarCampo('VEHICULOS','Alias2','Codigo',VEHICULO1),'DIVIARB');EqStr(BuscarCampo('VEHICULOS','Alias2','Codigo',VEHICULO1),'DIVIARB');Vacio(OPERACIONREF) O EqStr(ABM,'E') O [EqStr(ABM,'A') y EqStr(BuscarCampo('OPERACIONES','TipoOp','NrOperacion',OPERACIONREF),'FXV') y Vacio(BuscarCampo('OPERACIONES','TipoOp','OperacionRef',OPERACIONREF))];'Operacion Referencia de Arbitraje INCORRECTA !!!';NO;   ;;;;;;;"TipoOp='FXV' and (OperacionRef Is Null or OperacionRef='')";
Cotizacion1      : 'Cotizacion'     ; 7;1;2;NO;NO;;;;COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP');COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP');
TipoCambio       : 'Precio Mer.'    ; 7;1;2;NO;  ;;;;;IIF(Incluido(ESPECIE,'USD|USB|GBP|EUR') O SI THEN COTIZACION1 ELSE 1/COTIZACION1 ENDIF);
CB5              : 'Oferta MAE'     ; 8;1;2;NO;SI;;;;0
NroAltaMAE       : 'NroAltaMAE'     ; 9;1;2;NO;NoVacio(NroAltaMAE);

VTXT10           : 'Controlante Lim'; 9;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~CLIENTE1~"' "))
VTXT11           : 'Cliente Lim'    ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1),IF(VACIO(VTXT10),CLIENTE1,CLIENTE1))
NrSisExterno     : 'Nr.Ticket'      ;10;2;2;NO;Corporate=1 o RB3=1;;;;;;;;;;'XXXXXXXXXXXXXXXXXX'
RuedaContinua    : 'Orig.en Arbit.' ;11;1;2;NO;RB3=1 y RUEDACONTINUA=1;
NrAltaCV         : 'Nr.Arbitraje.'  ;11;2;2;NO;RB3=1 y RUEDACONTINUA=1;;;;;;;;;;'XXXXXXXX'

VCAN9            : 'T.Sett.FPago'   ;9 ;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMSUMADO(VTXT11,'SETTLEMENT',FECHAPAGO,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2);;;;;'###,###,###,###.##'
VCAN10           : 'T.Sett.FVto'    ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMSUMADO(VTXT11,'SETTLEMENT',FECHAVTO ,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2);;;;;'###,###,###,###.##'
VCAN11           : 'T.Sett.FPago GE';9 ;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) y NoVacio(VTXT10), LIMSUMADO(VTXT10,'SETTLEMENT',FECHAPAGO,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2,0);;;;;'###,###,###,###.##'
VCAN12           : 'T.Sett.FVto GE' ;10;2;2;NO;NO;;;;;IF(NoVacio(BOOK1) y NoVacio(VTXT10), LIMSUMADO(VTXT10,'SETTLEMENT',FECHAVTO ,VEHICULO1,,,NROPERACION)+TOTALBRUTOCLI2,0);;;;;'###,###,###,###.##'
VTXT15           : 'Esp.RiskWeight' ; 1;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), ESPECIE)
VTXT16           : 'For.Liq.RiskW.' ; 2;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(FORMALIQUIDACION1=1,'DVP','STD'))
VPRE4            : 'Max Plazo RW'   ; 3;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), Query("Select Max(Plazo) from "~DBO~".RISKWEIGHT where Especie = '"~VTXT15~"' and TipoOp = '"~TIPOOP~"' and FormaLiquidacion = '"~VTXT16~"'"))
VPRE5            : 'Plazo RW'       ; 4;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), if(PLAZO>VPRE4,VPRE4,PLAZO))
PorCaucion       : 'RiskWeighting'  ; 5;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), Query("Select Factor from "~DBO~".RISKWEIGHT where Especie = '"~VTXT15~"' and TipoOp = '"~TIPOOP~"' and FormaLiquidacion = '"~VTXT16~"' and Plazo >= "~Fstr(VPRE5, 0, 8)~" and Fecha <= '"~IdxDate(FECHAOP)~"' order by Fecha desc, Plazo"))
TotalAux3        : 'PreSettlement'  ; 6;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(Incluido(ESPECIE,'USD|USB|ULI'),CANTIDAD,TOTALBRUTOCLI1*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'USD'))*if(PORCAUCION=0,Var('PORPRESMON')/100,PORCAUCION/100))
TotalBrutoCli3   : 'Total PreSettl.'; 7;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), LIMCONSUMIDO(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)+TOTALAUX3)
MinDerechoBolsa  : 'Exc Presett'         ;11;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o [VALORRB1=0 y PUESTO=1] o LimOperativo(VTXT11,'PRESETTLEM','USD',VEHICULO1) > TOTALAUX3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION), 0, (LimOperativo(VTXT11,'PRESETTLEM','USD',VEHICULO1) - (TOTALAUX3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,VEHICULO1,,,NROPERACION)))));;;;;'###,###,###,###.##'
MinDerechoMercado: 'Exc Settlem F.Pago'  ;12;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o FORMALIQUIDACION1=1 o [VALORRB1=0 y PUESTO=1 Y FORMALIQUIDACION1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) >= VCAN9, 0, LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) - VCAN9));;;;;'###,###,###,###.##'
MinArancel       : 'Exc Settlem F.Vto'   ;13;2;2;NO;NO;;;;;IF(NoVacio(BOOK1), IF(CB8 = 1 o PUESTO=1 o FORMALIQUIDACION1=1 o [VALORRB1=0 y PUESTO=1 Y FORMALIQUIDACION1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) >= VCAN10, 0, LimOperativo(VTXT11,'SETTLEMENT','USD',VEHICULO1) - VCAN10));;;;;'###,###,###,###.##'

RB5:'Cross-Limit|Commited|Uncomited';16;1;2;NO;NO;;;;1;1;
CB6              : 'Cot.Esp/ContDirecta'  ;4;2;2;NO;NO;;;;;IF(eqstr(QUERY(" Select Modo from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' "),'INV'),0,1)
Precio4          : 'Cotizacion'     ;1;1;2;NO;NO;;;;;IF(CB6=1,COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP'),COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP')/COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'ARP'))

Cotizacion2      : 'CotizEsp-USD'   ;13;1;2;NO;;;;;;IF(NoVacio(BOOK1), COTIZACIONC(ESPECIE,,,,FECHAOP,1,SI,'USD'));;;;;'###,###.########'
PorDerechoBolsa  : 'C.Esp ARP'      ;14;1;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORDERECHOBOLSA, PRECIO1));;;;;'###,###.########'
PorImpuestoBolsa : 'C.Esp USD'      ;15;1;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORIMPUESTOBOLSA, if(EqStr(Modo(ESPECIE, 'USD'),'INV'), 1/COTIZACION2, COTIZACION2)));;;;;'###,###.########'
InteresesCorr    : 'C.CE USD'       ;14;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, INTERESESCORR, if(EqStr(Modo(CONTRAESPECIE,'USD'),'INV'),PRECIO1/COTIZACION2,COTIZACION2/PRECIO1)));;;;;'###,###.########'
PorDerechoMercado: 'C.CE ARP'       ;15;2;2;;;;;;;IF(NoVacio(BOOK1), IF(MODI, PORDERECHOMERCADO, 1));;;;;'###,###.########'

VTXT27    : 'Book'            ;18;1;2;NO;SI;;;;;BOOK1;;;;;'##########';
VCAN17    : 'Book Asig.'      ;19;1;2;NO;SI;;;;;IF(NoVacio(BOOK1),LIMASIGNADO(VEHICULO1,'BOOK','USD',VEHICULO1,,BOOK1))
VFEC17    : 'Vto L.Book'      ;18;2;2;NO;SI;;;;;IF(NoVacio(BOOK1),VTOLIMITE('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1))
VCAN27    : 'Total Book'      ;19;2;2;NO;SI;;;;;IF(NoVacio(BOOK1),LIMTOTALIZADO3(VEHICULO1,'BOOK',0,VEHICULO1,,BOOK1,NROPERACION,,,,,,,,,,'USD'))

VTXT19            : 'WF MAE reducido' ;1;3;2;NO;NO;;;;;IF(EqStr(BuscarCampo('VARIABLES','Valor','Codigo','WFMAEREDU'),'SI'),'SI','NO');;;;;'XX';

@CTASFX

@PRPOSI

CONDICIONES:
[NoVacio(NroAltaMAE)] O [Not EqStr(MERCADO,'SWIFT')] o [Not Incluido(ESPECIE,Var('ESPBILLETE'))];'No se admite Mercado SWIFT para Especie Billete';NO
[NoVacio(NroAltaMAE)] O [PASECB <> 1 Y ARBITRAJE <> 1] o EV;'Una operacion relacionada no se puede modificar';NO
[NoVacio(NroAltaMAE)] O Not EqStr(ESPECIE,'ARP')           ;'La Moneda de Compra debe ser Moneda Extranjera' ;NO
[NoVacio(NroAltaMAE)] O Not EqStr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not FECHAOP<FSYS o EV;'Es una Operacion FechaValor';SI;SI;FSYS;'FVALOR'

[NoVacio(NroAltaMAE)] O [PRECIO1<=PRECIO4*(1+VAR('FXDESPRE1')/100) Y PRECIO1>=PRECIO4*(1-VAR('FXDESPRE1')/100)] o [INSTANCIA>1 y PRECIO1=0];'Tipo de Cambio fuera de rango. De '~FStr(PRECIO4*(1-VAR('FXDESPRE1')/100),1,7)~' a '~FStr(PRECIO4*(1+VAR('FXDESPRE1')/100),1,7);SI;SI;FSYS;'RANGOPRECI'
[NoVacio(NroAltaMAE)] O [PRECIO1<=PRECIO4*(1+VAR('FXDESPRE2')/100) Y PRECIO1>=PRECIO4*(1-VAR('FXDESPRE2')/100)] o [INSTANCIA>1 y PRECIO1=0];'Tipo de Cambio Invalido. De '~FStr(PRECIO4*(1-VAR('FXDESPRE2')/100),1,7)~' a '~FStr(PRECIO4*(1+VAR('FXDESPRE2')/100),1,7);NO;

SI o [NoVacio(NroAltaMAE)] O TotalBrutoCli2<=VCAN2;'Excedio Limite del Operador';SI;SI;FSYS;'LIMOPEEXCE'
Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

[NoVacio(NroAltaMAE)] O Query("Select 1 from "~DBO~".MODOESPECIES where Especie1='"~ESPECIE~"' and Especie2='"~CONTRAESPECIE~"' ")>0;'No Existe la relacion '~ESPECIE~'/'~CONTRAESPECIE~' en Tabla MODOESPECIES';NO
[NoVacio(NroAltaMAE)] O Query("Select 1 from "~DBO~".MODOESPECIES where Especie1='"~CONTRAESPECIE~"' and Especie2='"~ESPECIE~"' ")>0;'No Existe la relacion '~CONTRAESPECIE~'/'~ESPECIE~' en Tabla MODOESPECIES';NO

BookValido(BOOK1, TIPOOP, ESPECIE, VEHICULO1, OPERADOR, 'HAB' );'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO
BookValido(VAR('BOOKCONTRA'), TIPOOP, CONTRAESPECIE, VEHICULO1, OPERADOR, 'HAB');'El Book de Contraespecie '~VAR('BOOKCONTRA')~' es Invalido.';NO

VACIO(OPERACIONREF) O Not EqStr(BuscarCampo('OPERACIONES','Especie','NrOperacion',OPERACIONREF),ESPECIE);'En los Arbitrajes la Especie de la Compra debe ser distinta a la Especie de la Venta ';NO

Vacio(VTXT11) o Arbitraje=1 o PaseCB=1 o CB8=1 o [ValorRB1=0 y Puesto=1] o ExisteLimite('PRESETTLEM',VTXT11,'USD',Vehiculo1)                                                                               ; 'Presettlement Cliente no asignado'   ;SI;SI;FSYS;'PRESETNOAS'
Vacio(VTXT11) o Arbitraje=1 o PaseCB=1 o CB8=1 o [ValorRB1=0 y Puesto=1] o LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1) > TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion); 'Presettlement Cliente excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT11,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(VTXT11,'PRESETTLEM','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'PRESETEXCE'

Vacio(VTXT10) o Arbitraje=1 o PaseCB=1 o CB8=1 o [ValorRB1=0 y Puesto=1] o ExisteLimite('PRESETTLEM',VTXT10,'USD',Vehiculo1)                                                                               ; 'Presettlement Controlante '~VTXT10~' no asignado'   ;SI;SI;FSYS;'PRESCONOAS'
Vacio(VTXT10) o Arbitraje=1 o PaseCB=1 o CB8=1 o [ValorRB1=0 y Puesto=1] o LimOperativo(VTXT10,'PRESETTLEM','USD',Vehiculo1) > TotalAux3+LimConsumido(VTXT10,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion); 'Presettlement Controlante '~VTXT10~' excedido en U$D '~PYC(TotalAux3+LimConsumido(VTXT10,'PRESETTLEM','USD',-1,Vehiculo1,,,NrOperacion)-LimOperativo(VTXT10,'PRESETTLEM','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'PRESCOEXCE'

Vacio(VTXT11) o Arbitraje=1 o PaseCB=1 o CB8=1            o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o ExisteLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1)                                                                ; 'Settlement Cliente no asignado'                                                                                         ;SI;SI;FSYS;'SETTLENOAS'
Vacio(VTXT11) o Arbitraje=1 o PaseCB=1 o CB8=1            o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o Not ExisteLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1) o VtoLimite('SETTLEMENT',VTXT11,'USD',Vehiculo1) >= FechaOp; 'Settlement Cliente '~FechaOp~' vencido'                                                                                 ;SI;SI;FSYS;'SETTLEVENC'
Vacio(VTXT11) o Arbitraje=1 o PaseCB=1 o CB8=1            o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',Vehiculo1) >= VCAN9                                                       ; 'Settlement Cliente '~FechaPago~' excedido en U$D '~PYC(VCAN9-LimOperativo(VTXT11,'SETTLEMENT','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'
Vacio(VTXT11) o Arbitraje=1 o PaseCB=1 o CB8=1 o Puesto=1 o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o LimOperativo(VTXT11,'SETTLEMENT','USD',Vehiculo1) >= VCAN10                                                      ; 'Settlement Cliente '~FechaVto~' excedido en U$D '~PYC(VCAN10-LimOperativo(VTXT11,'SETTLEMENT','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

Vacio(VTXT10) o Arbitraje=1 o PaseCB=1 o CB8=1            o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o ExisteLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1)                                                                ; 'Settlement Controlante '~VTXT10~' no asignado'                                                                                          ;SI;SI;FSYS;'SETTCONOAS'
Vacio(VTXT10) o Arbitraje=1 o PaseCB=1 o CB8=1            o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o Not ExisteLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1) o VtoLimite('SETTLEMENT',VTXT10,'USD',Vehiculo1) >= FechaOp; 'Settlement Controlante '~VTXT10~' '~FechaOp~' vencido'                                                                                  ;SI;SI;FSYS;'SETTCOVENC'
Vacio(VTXT10) o Arbitraje=1 o PaseCB=1 o CB8=1            o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o LimOperativo(VTXT10,'SETTLEMENT','USD',Vehiculo1) >= VCAN11                                                      ; 'Settlement Controlante '~VTXT10~' '~FechaPago~' excedido en U$D '~PYC(VCAN11-LimOperativo(VTXT10,'SETTLEMENT','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'SETTCOEXCE'
Vacio(VTXT10) o Arbitraje=1 o PaseCB=1 o CB8=1 o Puesto=1 o FormaLiquidacion1=1 o [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1] o LimOperativo(VTXT10,'SETTLEMENT','USD',Vehiculo1) >= VCAN12                                                      ; 'Settlement Controlante '~VTXT10~' '~FechaVto~' excedido en U$D '~PYC(VCAN12-LimOperativo(VTXT10,'SETTLEMENT','USD',Vehiculo1),1,0)~'.- ';SI;SI;FSYS;'SETTCOEXCE'

Vacio(BOOK1) o Arbitraje=1 o PaseCB = 1 o CB8=1 o ExisteLimite('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1)                        ; 'Limite Book '~BOOK1~' no asignado'                                               ;SI;SI;FSYS   ;'LBOOKNOAS'
Vacio(BOOK1) o Arbitraje=1 o PaseCB = 1 o CB8=1 o NOT ExisteLimite('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1) o VFEC17 >= FechaOp; 'Limite Book '~BOOK1~' vencido el '~FECHA(VFEC17)                                 ;SI;SI;FSYS   ;'LBOOKVENC'
Vacio(BOOK1) o Arbitraje=1 o PaseCB = 1 o CB8=1 o NOT LimCancelado('BOOK',VEHICULO1,'USD',VEHICULO1,,BOOK1)                    ; 'Limite Book '~BOOK1~' Cacnelado'                                                 ;SI;SI;FSYS   ;'LBOOKCANC'
Vacio(BOOK1) o Arbitraje=1 o PaseCB = 1 o CB8=1 o VCAN17 >= VCAN27 + TOTALBRUTOCLI2                                            ; 'Limite Book '~BOOK1~' excedido en U$D '~PYC(VCAN27 + TOTALBRUTOCLI2 - VCAN17,0,2);SI;SI;FECHAOP;'LBOOKEXCE'

SQL:EqStr(ABM,'E')
"Delete from "~DBO~".EXCEPCIONES where NrOperacion = '"~NrOperacion~"' "

MOVIMIENTOS:
FechaVto ;Cliente1;Especie      ;;;;MERCADO ;Vehiculo1;1;-Cantidad       ;;'Compra de '~Especie;SI;CB9=1;1;Custodia=0 y CB10=0;;Cuenta3;;1;'FX';;;;;;Book1;Vehiculo1
FechaPago;Cliente1;ContraEspecie;;;;MERCADO2;Vehiculo1;1; TotalBrutoCli1 ;;'Compra de '~Especie;SI;CB9=1;2;Custodia=0         ;;Cuenta4;;2;'FX';;;;;;Book1;Vehiculo1
FechaOp  ;Corredor;Contraespecie;;;;MERCADO2;Vehiculo1;9; TotalComisiones;;'Compra de '~Especie;SI;SI   ; ;NOVACIO(CORREDOR)  ;;       ;;3;'FX';;;;;;Book1;Vehiculo1

POSICION:
FechaOp  ;Vehiculo1;Especie      ;;;;Vehiculo1;;;;; 31; Cantidad      ;VPRE3 ;;;Book1;
FechaVto ;Vehiculo1;Especie      ;;;;Vehiculo1;;;;; 51; Cantidad      ;VPRE3 ;;;Book1;

FechaOp  ;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;; 31; -TotalBrutoCli1;1;;;VAR('BOOKCONTRA');;
FechaVto ;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;; 51; -TotalBrutoCli1;1;;;VAR('BOOKCONTRA');;

LIMITES:
FechaOp     ;VTXT11;'SETTLEMENT';ContraEspecie;FechaPago; TotalBrutoCli2;TipoOp~' '~Especie      ;NoVacio(VTXT11) y Arbitraje=0 y PaseCB=0 y CB8=0            y FormaLiquidacion1 <> 1 Y Not [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1];Vehiculo1;
FechaOp     ;VTXT11;'SETTLEMENT';ContraEspecie;FechaVto ; TotalBrutoCli2;TipoOp~' '~Especie      ;NoVacio(VTXT11) y Arbitraje=0 y PaseCB=0 y CB8=0 y Puesto=0 y FormaLiquidacion1 <> 1 Y Not [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1];Vehiculo1;

FechaOp     ;VTXT10;'SETTLEMENT';ContraEspecie;FechaPago; TotalBrutoCli2;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y Arbitraje=0 y PaseCB=0 y CB8=0            y FormaLiquidacion1 <> 1 Y Not [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1];Vehiculo1;
FechaOp     ;VTXT10;'SETTLEMENT';ContraEspecie;FechaVto ; TotalBrutoCli2;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y Arbitraje=0 y PaseCB=0 y CB8=0 y Puesto=0 y FormaLiquidacion1 <> 1 Y Not [ValorRB1=0 y Puesto=1 Y FormaLiquidacion1=1];Vehiculo1;

FechaOp     ;VTXT11;'PRESETTLEM';'USD'        ;         ;      TotalAux3;TipoOp~' '~Especie      ;NoVacio(VTXT11) y Arbitraje=0 y PaseCB=0 y CB8=0 y Not [ValorRB1=0 y Puesto=1]                      ;Vehiculo1;
FechaPago   ;VTXT11;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie      ;NoVacio(VTXT11) y Arbitraje=0 y PaseCB=0 y CB8=0 y Not [ValorRB1=0 y Puesto=1] y FechaVto<=FechaPago;Vehiculo1;
FechaVto    ;VTXT11;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie      ;NoVacio(VTXT11) y Arbitraje=0 y PaseCB=0 y CB8=0 y Not [ValorRB1=0 y Puesto=1] y FechaVto>FechaPago ;Vehiculo1;

FechaOp     ;VTXT10;'PRESETTLEM';'USD'        ;         ;      TotalAux3;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y Arbitraje=0 y PaseCB=0 y CB8=0 y Not [ValorRB1=0 y Puesto=1]                      ;Vehiculo1;
FechaPago   ;VTXT10;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y Arbitraje=0 y PaseCB=0 y CB8=0 y Not [ValorRB1=0 y Puesto=1] y FechaVto<=FechaPago;Vehiculo1;
FechaVto    ;VTXT10;'PRESETTLEM';'USD'        ;         ;     -TotalAux3;TipoOp~' '~Especie~' GE';NoVacio(VTXT10) y Arbitraje=0 y PaseCB=0 y CB8=0 y Not [ValorRB1=0 y Puesto=1] y FechaVto>FechaPago ;Vehiculo1;

FechaOp     ;VEHICULO1;'BOOK'   ;ESPECIE      ;         ;       CANTIDAD;TipoOp~' '~Especie      ;NoVacio(BOOK1) y PASECB=0;Vehiculo1;;BOOK1

POSTEDICION:
Eqstr(ABM,'A') y RB2=1 Y NO;'FXBCRA';NrOperacion1=NROPERACION
Eqstr(ABM,'D') y RB2=1 Y NO;'ANFXBC';NrOperacion1=NROPERACION

@INSTFXCV

