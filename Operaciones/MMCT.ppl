CONDICIONES:

Not FECHAOP<FSYS o EV;'Es una Operacion FechaValor';SI;SI;FSYS;'FVALOR'

PRECIO1 >= 0;'La tasa debe ser mayor a cero';NO
[PRECIO4>0 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'La Tasa de Transferencia NO puede ser Negativa o Cero';NO;;;;;

[PRECIO4<=PRECIO2*(1+VAR('RTASA2')/100) Y PRECIO4>=PRECIO2*(1-VAR('RTASA2')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia Fuera de Rango: '~FSTR((PRECIO2*(1-VAR('RTASA2')/100)),1,7)~' y '~FSTR((PRECIO2*(1+VAR('RTASA2')/100)),1,7);NO;;;;;
[PRECIO4<=PRECIO2*(1+VAR('RTASA1')/100) Y PRECIO4>=PRECIO2*(1-VAR('RTASA1')/100) Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia Fuera de Rango: '~FSTR((PRECIO2*(1-VAR('RTASA1')/100)),1,7)~' y '~FSTR((PRECIO2*(1+VAR('RTASA1')/100)),1,7);SI;SI;Fsys;'RANGOTRANS';;

PRECIO1<=PRECIO4*(1+VAR('RTASA2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RTASA2')/100);'Tasa Fuera de Rango: '~FSTR((PRECIO4*(1-VAR('RTASA2')/100)),1,7)~' y '~FSTR((PRECIO4*(1+VAR('RTASA2')/100)),1,7);NO           
PRECIO1<=PRECIO4*(1+VAR('RTASA1')/100) Y PRECIO1>=PRECIO4*(1-VAR('RTASA1')/100);'Tasa Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RTASA1')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RTASA1')/100),1,7)    ;SI;SI;Fsys;'RANGOTASA'

[PRECIO1<=PRECIO4 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Spread Negativo: '~FSTR(PRECIO1-PRECIO4,0,7);SI;SI;FSys;'SPREADNEG';;
[PRECIO4 = PRECIO2 Y EqStr(VAR('CONTROLATT'),'SI')] O EqStr(VAR('CONTROLATT'),'NO');'Tasa Transferencia: '~FSTR(PRECIO2,0,7)~'. Tasa Transferencia Modificada: '~FSTR(PRECIO4,0,7)~'. ';SI;SI;FSys;'TASATMOD';;

IF(EqStr(VAR('CTRLSECTOR'),'SI'),NOVACIO(SECTOR1)) O EqStr(VAR('CTRLSECTOR'),'NO') ;'El usuario no tiene sector asignado';NO

Not EqStr('DES',BuscarCampo('ESPECIES','Status','Codigo',ESPECIE));'La Especie esta deshabilitada';NO

[Eqstr(Especie,Opref.Especie)] o [Not NoVacio(OperacionRef)];'No coincide la especie con la operacion de referencia';NO
[Eqstr(Cliente1,Opref.Cliente1)] o [Not NoVacio(OperacionRef)];'No coincide el cliente con la operacion de referencia';NO
[FechaOp=Opref.FechaVto] o [Not NoVacio(OperacionRef)];'La operacion de referencia no ha vencido aun';NO
NOT EQSTR (VEHICULO1,CLIENTE1);'El Cliente no puede ser el Vehiculo';NO


Not EqStr('DES',BuscarCampo('CLIENTES','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO

Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado))  ;'Ingreso un Mercado de Titulos para el Mercado de Especie' ;NO 
Incluido('M',BuscarCampo('MERCADOS', 'Observaciones', 'Codigo', Mercado2)) ;'Ingreso un Mercado de Titulos para el Mercado de Moneda';NO 

SI o Vacio(Query("Select Valor from "~DBO~".VARIABLES Where Codigo='TRADOVNGT' "));pipe2coma(Query("Select Valor from "~DBO~".VARIABLES Where Codigo='TRADOVNGT' "))~' tienen todavia posiciones en Overnight.';SI


BookValido(BOOK1, TIPOOP, ESPECIE, Vehiculo1, OPERADOR, 'HAB' );'El Book de seleccionado no corresponde a la Especie, Tipo de Operacion, Operador, Vehiculo o no esta Habilitado ';NO

