FechaOp;Vehiculo1;Especie;;;;Vehiculo1;;;;;130;Cantidad;Precio1*if(Eqstr(ContraEspecie,VAR('MONEEXTR')),1,CotizacionC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VAR('MONEEXTR')));;;BOOK1;;'SEC';PaseCB=0;Cupon1

FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;122;-TotalNetoCli1;CotizacionC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VTXT40);;;VTXT19;;'FXS';Not Incluido(ContraEspecie,VTXT40~"|"~VAR('MONEEXTR'));
FechaOp;Vehiculo1;ContraEspecie;;;;Vehiculo1;;;;;132;-TotalNetoCli1;CotizacionC(CONTRAESPECIE,,,,FECHAOP-1,1,SI,VAR('MONEEXTR'));;;VTXT19;;'FXS';Not Incluido(ContraEspecie,VTXT40~"|"~VAR('MONEEXTR'));

POSICION2
FechaOp;Vehiculo1;Book1;'SEC';Especie;Cupon1;1;ContraEspecie;Cantidad;Precio6;IF(RB8=0, TotalIntereses, TotalImpuesto1);IF(RB8=0, '8', '1');
