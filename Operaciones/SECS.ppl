VCAN23       : 'Cant.Consumido'                ;;;;;NO;;;;TOTALNETOCLI1;TOTALNETOCLI1;;
@CUENTAS

CONDICIONES
ESHABIL(FECHAOP,'ARG');'La Fecha de Origen no es dia Habil en Argentina';SI;SI;FSYS;'ORIGINH'
EsHabil(FECHAVTO,'ARG') ;'La Fecha de Liquidacion de Titulos NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'LIQTIINH'
EsHabil(FECHAPAGO,'ARG');'La Fecha de Liquidacion de Moneda NO ES HABIL EN ARGENTINA';SI;SI;FSYS;'LIQMONINH'
[DESCIENDEDECLIENTE(CLIENTE1,'BANCOS') O DESCIENDEDECLIENTE(CLIENTE1,'EMPRESAS')];'El Cliente debe ser una Entidad Bancaria o una Empresa';NO
Vacio(Cliente1) o Eqstr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
Eqstr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie No esta Habilitada';NO
Eqstr(BuscarCampo('Especies','Status','Codigo',ContraEspecie),'HAB');'La ContraEspecie No esta Habilitada';NO
PRECIO1<=PRECIO4*(1+VAR('RPRECIO') /100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO') /100);'Tipo de Cambio FUERA DE RANGO: '~FSTR(PRECIO4*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO')/100),1,7)  ;SI;SI;FSYS;'RANGOPRECIO'
PRECIO1<=PRECIO4*(1+VAR('RPRECIO2')/100) Y PRECIO1>=PRECIO4*(1-VAR('RPRECIO2')/100);'Tipo de Cambio Fuera de Rango: '~FSTR(PRECIO4*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PRECIO4*(1+VAR('RPRECIO2')/100),1,7);SI;SI;FSYS;'RANGOPRECIO2'

SI O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO2')/100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO2')/100)];'COTIZACION CONTABLE Fuera de Rango: '~FSTR(VCAN12*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO2')/100),1,7);SI
SI O [Eqstr(COTIZAEN(ESPECIE),CONTRAESPECIE) O PlazoRenovPredeter<=VCAN12*(1+VAR('RPRECIO') /100) Y PlazoRenovPredeter>=VCAN12*(1-VAR('RPRECIO') /100)];'COTIZACION CONTABLE FUERA DE RANGO: '~FSTR(VCAN12*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(VCAN12*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOCOTCON'

Not Eqstr('DES',BuscarCampo('Clientes','Status','Codigo',CLIENTE1));'El Cliente esta deshabilitado';NO
Not Eqstr('CLIOBS',BuscarCampo('Clientes','Alias7','Codigo',CLIENTE1));'El Cliente esta Observado';SI;SI;FSYS;'CLIOBS'
SI O [RB12<>0 O Vacio(Corredor) O [PORCOMCOR1>=VAR('RCOMCOR1') y PORCOMCOR1<=VAR('RCOMCOR2')]];'El % Comision Corredor EXCEDE Los Limites: Min.'~VAR('RCOMCOR1')~' Max.'~VAR('RCOMCOR2');NO
SI O [RB13<>0 O Eqstr(Mercado,'OTC')  o [PORCOMMER1>=VAR('RCOMMER1') y PORCOMMER1<=VAR('RCOMMER2')]];'El % Comision Mercado EXCEDE Los Limites: Min.'~VAR('RCOMMER1')~' Max.'~VAR('RCOMMER2');NO

SI O [Vacio(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO2')/100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION CORREDOR Fuera de Rango: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Vacio(CORREDOR) O [TCCOMCOR1<=TIPOCAMBIO2*(1+VAR('RPRECIO') /100) Y TCCOMCOR1>=TIPOCAMBIO2*(1-VAR('RPRECIO') /100)]];'Cambio  COMISION CORREDOR  FUERA DE RANGO: '~FSTR(TIPOCAMBIO2*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(TIPOCAMBIO2*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'
SI O [Eqstr(MERCADO,'OTC') O [TCCOMMER1<=PORAFORO*(1+VAR('RPRECIO2')/100) Y TCCOMMER1>=PORAFORO*(1-VAR('RPRECIO2')/100)]];'Cambio COMISION MERCADO Fuera de Rango: '~FSTR(PORAFORO*(1-VAR('RPRECIO2')/100),1,7)~' y '~FSTR(PORAFORO*(1+VAR('RPRECIO2')/100),1,7);NO
SI O [Eqstr(MERCADO,'OTC') O [TCCOMMER1<=PORAFORO*(1+VAR('RPRECIO') /100) Y TCCOMMER1>=PORAFORO*(1-VAR('RPRECIO') /100)]];'Cambio  COMISION MERCADO FUERA DE RANGO: '~FSTR(PORAFORO*(1-VAR('RPRECIO')/100),1,7)~' y '~FSTR(PORAFORO*(1+VAR('RPRECIO')/100),1,7);SI;SI;FSYS;'RANGOPRECIO'

NOT Eqstr (VEHICULO1,CLIENTE1);'El Cliente y el Vehiculo deben ser distintos';NO
ESTERMINAL(VEHICULO1,VEHICULO);'El Vehiculo debe ser Terminal';NO
ESTERMINAL(CLIENTE1,CLIENTE);'El Cliente debe ser Terminal';NO

[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o ExisteLimite('SETTLEMENT',Cliente1,VTXT6);'Settlement no asignado';SI;SI;FSYS;'SETTLENOAS'
[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o Not ExisteLimite('SETTLEMENT',Cliente1,VTXT6) o VtoLimite('SETTLEMENT',Cliente1,VTXT6) >= FechaOp; 'Settlement vencido el '~FECHA(VtoLimite('SETTLEMENT',Cliente1,VTXT6));SI;SI;FSYS;'SETTLEVENC'
[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o Not LimCancelado('SETTLEMENT',Cliente1,VTXT6); 'Settlement cancelado';SI;SI;FSYS;'SETTLECANC'
[NOT NoVacio(CLIENTE1)] o [FormaLiquidacion1=1] o [FechaPago>FechaVto] o LimAsignado(Cliente1,'SETTLEMENT',VTXT6) >= VCAN9; 'Settlement excedido '~PYC(VCAN9-LimAsignado(Cliente1,'SETTLEMENT',VTXT6),1,0)~'.-';SI;SI;FSYS;'SETTLEEXCE'

FECHAOP2=Fsys;'La Fecha de Concertacion no coincide con la de Sistema';SI;SI;FSYS;'CONCFVALOR'
FECHAOP =Fsys;'La Fecha de Origen no coincide con la de Sistema';SI;SI;FSYS;'ORIGFVALOR'
Vacio(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR)) O  VERIFICAPERFIL(BuscarCampo('USUARIOS','Perfil','Codigo',OPERADOR),'TO'~TIPOOP);'Operador no habilitado para ingresar Operaciones del Tipo '~TIPOOP;NO
@CONDCUPON
%%ifdef BFSA
    *LIMITES
    @COLITIBFSA
    *Cantidad Completada Ordenes
    @ORCCTNC
