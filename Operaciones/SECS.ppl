%%endif    
FechaVto;Vehiculo1;Book1;'SEC';Especie;Cupon1;3;ContraEspecie;Cantidad;Precio6;IF(RB8=0, TotalIntereses, TotalImpuesto1);IF(RB8=0, '8', '1');CB15=1 Y Eqstr(BuscarCampo('ESPECIES', 'Issuer', 'Codigo', Especie), Vehiculo1)

POSTEDICION
*@POSTERENT
INCLUIDO(ABM,'A') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=0;Check1=1
INCLUIDO(ABM,'D') y CB13=1 y CB14=1;'ACTSPE';NrOperacion1=NROPERACION5;Entero1=CUOTAS1;Cantidad1=CANTIDAD;Radio1=1;Check1=1
%%ifdef BFSA
    SI;'DETRIE';TipoOp = TIPOOP;Especie1=CONTRAESPECIE;Cantidad1=TOTALNETOCLI1;Book1=BOOK1;NrOperacion=NROPERACION;Fecha1=FechaOp
    *Actualiza Ejecuciones cuando se da de alta la operación
    NoVacio(NRORDEN) Y Not EqStr(ABM,'D');'ACTEJE';Radio1=0;NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1=CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=TOTALNETOCLI1
    *Actualiza ejecuciones cuando se da de baja la operación. NOTA: El campo cantidad se invierte el signo en el evento
    NoVacio(NRORDEN) Y EqStr(ABM,'D') ;'ACTEJE';Radio1=1;NrOrden=NRORDEN;NrOperacion1=NROPERACION;TipoOp1=TIPOOP;Cliente1 = CLIENTE1;Fecha1=FECHAOP;Fecha2=FECHAVTO;Cantidad1=TOTALNETOCLI1
%%endif
 

