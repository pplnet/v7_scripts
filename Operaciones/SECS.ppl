FechaPago;Vehiculo1;ContraEspecie3;;;;;Vehiculo1;50;-ImpComMer1;;'Comision Mercado'     ;SI;SI;;PaseCB=0 Y FechaPago>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;100;
FechaPago;Vehiculo1;ContraEspecie2;;;;;Vehiculo1;50;-ImpComCor1;;'Comision Corredor'    ;SI;SI;;PaseCB=0 Y FechaPago>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;110;
FechaPago;Vehiculo1;ContraEspecie3;;;;;Vehiculo1;50;-TotalIva  ;;'IVA comision Mercado' ;SI;SI;;PaseCB=0 Y FechaPago>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;120;
FechaPago;Vehiculo1;ContraEspecie2;;;;;Vehiculo1;50;-TotalIva2 ;;'IVA comision Corredor';SI;SI;;PaseCB=0 Y FechaPago>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;130;

