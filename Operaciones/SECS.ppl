SI O Incluido(ContraEspecie,VTXT40~"|"~VAR('MONEEXTR')) o NoVacio(VTXT18);'El Vehiculo no tiene Book Default para Monedas';NO
SI O Incluido(ContraEspecie,VTXT40~"|"~VAR('MONEEXTR')) o NoVacio(VTXT19);'El Book default '~VTXT18~' no es valido';NO
SI O Incluido(ContraEspecie,VTXT40~"|"~VAR('MONEEXTR')) o Eqstr(VTXT20,Vehiculo1);'El Book default '~VTXT18~' corresponde a otro vehiculo';NO

EDICION
Eqstr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULMODI'));'No se puede modificar, Operador: '~Operador

BAJA
Eqstr(Operador, UsuarioActivo) o Incluido(UsuarioActivo, Var('ULBAJA'));'No se puede dar de baja, Operador: '~Operador

SQL
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('COTORNOAS','COTORVENC','COTOREXCE','SETTLENOAS','SETTLEVENC','SETTLECANC') ";Eqstr(ABM,'E')
"Delete "~DBO~".EXCEPCIONES Where NrOperacion='"~NROPERACION~"' and Tipo IN ('SETTLEEXCE','CONTNOAS','CONTVENC','CONTCANC','CONTEXCE')";Eqstr(ABM,'E')


MOVIMIENTOS
FechaVto ;Cliente1;Especie;;;;;Vehiculo1;1;-Cantidad;;'Compra de Titulo';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta1;;1;;;Cupon1;;;;;;;;;;;700
FechaPago;Cliente1;ContraEspecie ;;;;;Vehiculo1;1;TotalNetoCli1;;'Compra Imp. Liquidar';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;2;
FechaVto ;Vehiculo1;Especie;;;;;;10;Cantidad ;;'Compra de Titulo';;SI;;PaseCB=0 Y CB15=1;;Cuenta1;;6;;;Cupon1;;;;Book1;
FechaOp2 ;Vehiculo1;Especie;;;;;Vehiculo1;2;Cantidad ;;'Compra de Titulo';;SI;;PaseCB=0;;Cuenta1;;7;;;Cupon1;;;;Book1;
FechaVto ;Vehiculo1;Especie;;;;;;3;Cantidad ;;'Compra de Titulo';;SI;;PaseCB=0;;Cuenta1;;8;;;Cupon1;;;;Book1

FechaPago;Cliente1;ContraEspecie3;;;;;Vehiculo1;1;ImpComMer1;;'Comision Mercado';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;20;
FechaPago;IF(VACIO(Corredor), Cliente1, Corredor);ContraEspecie2;;;;;Vehiculo1;1;ImpComCor1;;'Comision Corredor';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;30;
FechaPago;Cliente1;ContraEspecie3;;;;;Vehiculo1;1;TotalIva  ;;'IVA comision Mercado';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;40;
FechaPago;IF(VACIO(Corredor), Cliente1, Corredor);ContraEspecie2;;;;;Vehiculo1;1;TotalIva2  ;;'IVA comision Corredor';SI; Incluido(Vehiculo1,Var('VLIQUIDAA'));;PaseCB=0;;Cuenta2;;50;


FechaPago ;Vehiculo1;ContraEspecie;;;;;Vehiculo1;50;-TotalNetoCli1;;' Compra de Titulo '~ESPECIE;SI;SI;;Eqstr(BuscarCampo('CUENTAS','TipoCuenta','Codigo', Cuenta2), 'CUS') Y FechaPago>=Fecha(Var('FECHAMIGRA'));;Cuenta2;;10;;;;;;;;;;;;;;
