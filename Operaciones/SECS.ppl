    Habiles(FechaVto,1,TablaFeriados1) ;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto y Incluido(Vehiculo1,Var('VLIQUIDAA'))
    FechaVto;Cliente1;'SETCRE'  ;VTXT6;;-VCAN8;TipoOp~' '~Especie;RB15=1 Y PaseCB=0 y FormaLiquidacion1 <> 1 y FechaPago<=FechaVto y Not Incluido(Vehiculo1,Var('VLIQUIDAA')) y Not Eqstr(BuscarCampo('CLIENTES','Alias10','Codigo',CLIENTE1),'LIMITELIQ');    
