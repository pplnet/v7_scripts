Cuotas2          : 'Cortes'         ;8;1; ;NO;NO;;;;1
NrOperacion2      :'CorteCup'       ;13;2;2;NO;NO;

VTXT10: 'Controlante' ; 9;2;2;NO;NO;;;;;QUERY("SELECT Controlante FROM "~DBO~".GRUPOSECONOMICOS WHERE Cliente= '"~CLIENTE1~"' ")
VTXT11: 'Controlante' ;10;2;2;NO;NO;;;;;IF(VACIO(VTXT10),CLIENTE1,CLIENTE1)
VCAN10: 'Afect.DueFrom'          ; 7;2;2;NO;INCLUIDO(TIPOOP,'TICO|TIPO');;;;;IF(EQSTR(VTXT13,'USD'),CANTIDAD*PRECIO3, CANTIDAD*PRECIO3/COTIZACION('USD',,,,FECHAOP,1));

VTXT12         : 'NrMAE'          ;2;1; ;NO;NO;;;;;BuscarCampo('CLIENTES','NrMAE','Codigo',CLIENTE1)
 
CONDICIONES:

EV o PRECIO1<=TIPOCAMBIO2*(1+VAR('RTASA2')/100) Y PRECIO1>=TIPOCAMBIO2*(1-VAR('RTASA2')/100);'Tasa Fuera de Rango: '~FSTR((TIPOCAMBIO2*(1-VAR('RTASA2')/100)),1,7)~' y '~FSTR((TIPOCAMBIO2*(1+VAR('RTASA2')/100)),1,7);NO
EV o PRECIO1<=TIPOCAMBIO2*(1+VAR('RTASA1') /100) Y PRECIO1>=TIPOCAMBIO2*(1-VAR('RTASA1') /100);'Tasa Fuera de Rango: '~FSTR((TIPOCAMBIO2*(1-VAR('RTASA1') /100)),1,7)~' y '~FSTR((TIPOCAMBIO2*(1+VAR('RTASA1') /100)),1,7);SI;SI;FSYS;'RANGOTAS1'

EqStr(BuscarCampo('Especies','Status','Codigo',Especie),'HAB');'La Especie no esta Habilitada';NO
EqStr(BuscarCampo('Clientes','Status','Codigo',CLIENTE1),'HAB');'El Cliente no esta Habilitado';NO
Not Eqstr(CLIENTE1, VEHICULO1);'El Cliente no puede ser el Vehiculo';NO;

EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA1),'HAB');'La Cuenta No esta Habilitada';NO
Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA1),'CUS');'La Cuenta debe ser una Cuenta de Custodia';NO

Vacio(Cuenta4) o EqStr(BuscarCampo('Cuentas','Estado','Codigo',CUENTA4),'HAB');'La Cuenta Monetaria no esta Habilitada';NO
Vacio(Cuenta4) o Incluido(BuscarCampo('Cuentas','Tipocuenta','Codigo',CUENTA4),'CC|CA|OTR|CAJ|VIS|');'La Cuenta Monetaria debe ser una CC o CA o OTR o CAJ o VIS';NO
Vacio(Cuenta4) o EqStr(BuscarCampo('Cuentas','Cliente','Codigo',CUENTA4),CLIENTE1) o Vacio(BuscarCampo('Cuentas','Cliente','Codigo',CUENTA4));'La Cuenta Monetaria debe pertenecer al Cliente Titular';SI

Precio1 > 0;'La cotizacion del Fondo debe ser mayor a cero';NO
Cantidad > 0;'La cantidad debe ser mayor a cero';NO

FechaOp > Fecha(Var('FECHAVALOR'));'La Fecha Valor No Debe Superar el '~Var('FECHAVALOR');NO
DifDias(FechaOp,Fsys,'ARG',SI)<=1;'Fecha Valor Mayor a un Dia: '~Fecha(FechaOp);SI;SI;FSYS;'FECHAVAL'
DifDias(FechaOp,Fsys,'ARG',SI)<=Var('FVALORMAX');'Fecha Valor No Puede Superar '~Var('FVALORMAX')~' Dias';NO;

[VCAN1=0 y Not Incluido(Mercado3,VAR('MERCAACMC'))] o [VCAN1=1];'No Puede Liquidar por ArgenClear un Cliente ';NO

DESCIENDEDEESPECIE(ESPECIE,'PRIVA ') o NoVacio(BuscarCampo('AGENDACUPONES','Especie','Especie',ESPECIE));'Falta Actualizar la Agenda para este Titulo';SI

FechaOp=FSYS;'Operacion Ingresada con Fecha Valor';SI;SI;FSYS;'FVALOR'

VACIO(CLIENTE1) o Not Incluido(TIPOOP, 'TICO|TIPO') o ExisteLimite('DFROM',Cliente1,'USD',Vehiculo1)                                                                          ; 'Due From Cliente no asignado';SI;SI;FSYS;'DFROMNOAS'
VACIO(CLIENTE1) o Not Incluido(TIPOOP, 'TICO|TIPO') o LimAsignado(Cliente1,'DFROM','USD',Vehiculo1) >= VCAN10+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion); 'Due From Cliente excedido en U$D '~PYC(VCAN10+LimConsumido(Cliente1,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimAsignado(Cliente1,'DFROM','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'DFROMEXCE'
*VACIO(CLIENTE1) o Not Incluido(TIPOOP, 'TICO|TIPO') o BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1) >= FechaOp                                                           ; 'Review date Cliente vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',CLIENTE1));SI;SI;FSYS;'RDATEVENC'
VACIO(CLIENTE1) o Not Incluido(TIPOOP, 'TICO|TIPO') o VtoLimite('DFROM',Cliente1,'USD') >= FechaOp                                                           ; 'Review date Cliente vencida el '~Fecha(VtoLimite('DFROM',Cliente1,'USD'));SI;SI;FSYS;'RDATEVENC'

Vacio(VTXT10) o Not Incluido(TIPOOP, 'TICO|TIPO') o ExisteLimite('DFROM',VTXT10,'USD',Vehiculo1)                                                                        ; 'Due From Controlante '~VTXT10~' no asignado';SI;SI;FSYS;'DFROMNOAS'
Vacio(VTXT10) o Not Incluido(TIPOOP, 'TICO|TIPO') o LimAsignado(VTXT10,'DFROM','USD',Vehiculo1) >= VCAN10+LimConsumido(VTXT10,'DFROM','USD',-1,Vehiculo1,,,NrOperacion); 'Due From Controlante '~VTXT10~' excedido en U$D '~PYC(VCAN10+LimConsumido(VTXT10,'DFROM','USD',-1,Vehiculo1,,,NrOperacion)-LimAsignado(VTXT10,'DFROM','USD',Vehiculo1),1,0)~'.-';SI;SI;FSYS;'DFROMEXCE'
*Vacio(VTXT10) o Not Incluido(TIPOOP, 'TICO|TIPO') o BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT10) >= FechaOp                                                         ; 'Review date Controlante '~VTXT10~' vencida el '~Fecha(BuscarCampo('CLIENTES','Fecha1','Codigo',VTXT10));SI;SI;FSYS;'RDATEVENC'
Vacio(VTXT10) o Not Incluido(TIPOOP, 'TICO|TIPO') o VtoLimite('DFROM',VTXT10,'USD') >= FechaOp                                                         ; 'Review date Controlante '~VTXT10~' vencida el '~Fecha(VtoLimite('DFROM',VTXT10,'USD'));SI;SI;FSYS;'RDATEVENC'
 
MOVIMIENTOS
FechaOp ;Cliente1;Especie      ;;;;Mercado  ;Vehiculo1;1;  TotalBrutoCli1;;'Alta de Pmo. Otorgado de '~Especie;;NO;1;;;Cuenta1;;1;'TI';;Cupon1;;;;; ;
FechaVto;Cliente1;Especie      ;;;;Mercado  ;Vehiculo1;1; -Cantidad;;'Vencimiento de Pmo. Otorgado de '~Especie;;NO;2;;;Cuenta1;;2;'TI';;Cupon1;;;;; ;
FechaVto;Cliente1;ContraEspecie;;;;Mercado2 ;Vehiculo1;1; -TotalBrutoCli3;;'Interes de Pmo. Otorgado de '~Especie;;NO;3;CB8=1;;Cuenta4;;2;'TI';

 
POSICION
FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+2+101;-TotalBrutoCli1;Precio4;;;Book1;;'T';;Cupon1;
FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+6+101;-TotalBrutoCli1;Precio4;;;Book1;;'T';;Cupon1;

FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+2+201;-TotalBrutoCli1;Precio4;;;Book1;;'T';;Cupon1;
FechaOp ;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+6+201;-TotalBrutoCli1;Precio4;;;Book1;;'T';;Cupon1;

FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+2+101;Cantidad;Precio4;;;Book1;;'T';;Cupon1;
FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+6+101;Cantidad;Precio4;;;Book1;;'T';;Cupon1;

FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+2+201;Cantidad;Precio4;;;Book1;;'T';;Cupon1;
FechaVto;Vehiculo1;Especie;;;;Vehiculo1;;;IF(EqStr(MERCADO,'AC'),'CV',MERCADO);;CARTERA+6+201;Cantidad;Precio4;;;Book1;;'T';;Cupon1;

 

LIMITES
Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);Cliente1;'DFROM';'USD';; CANTIDAD*PRECIO3*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'USD');TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;
Habiles(FechaVto,1,TablaFeriados1)                                   ;Cliente1;'DFROM';'USD';;-CANTIDAD*PRECIO3*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'USD');TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;
Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);VTXT10  ;'DFROM';'USD';; CANTIDAD*PRECIO3*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'USD');TipoOp~' '~Especie;NoVacio(VTXT10);Vehiculo1;
Habiles(FechaVto,1,TablaFeriados1)                                   ;VTXT10  ;'DFROM';'USD';;-CANTIDAD*PRECIO3*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'USD');TipoOp~' '~Especie;NoVacio(VTXT10);Vehiculo1;

Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);Cliente1;'DFVN' ;ContraEspecie;;                  CANTIDAD*PRECIO3;TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;
Habiles(FechaVto,1,TablaFeriados1)                                   ;Cliente1;'DFVN' ;ContraEspecie;;                 -CANTIDAD*PRECIO3;TipoOp~' '~Especie;NoVacio(CLIENTE1);Vehiculo1;
Habiles(FechaOp,IF(NOVACIO(OPERACIONREF) Y MB1=0,1,0),TablaFeriados1);VTXT10  ;'DFVN' ;ContraEspecie;;                  CANTIDAD*PRECIO3;TipoOp~' '~Especie;NoVacio(VTXT10);Vehiculo1;
Habiles(FechaVto,1,TablaFeriados1)                                   ;VTXT10  ;'DFVN' ;ContraEspecie;;                 -CANTIDAD*PRECIO3;TipoOp~' '~Especie;NoVacio(VTXT10);Vehiculo1;


FechaOp                                                              ;Cliente1;'BCRAN';'ARP'  ;; CANTIDAD*PRECIO3*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP');TipoOp~' '~Especie;NoVacio(CLIENTE1) y EqStr(Vehiculo1,VAR('VEHICULODE'));Vehiculo1;
Habiles(FechaVto,1,TablaFeriados1)                                   ;Cliente1;'BCRAN';'ARP'  ;;-CANTIDAD*PRECIO3*COTIZACIONC(CONTRAESPECIE,,,,FECHAOP,1,SI,'ARP');TipoOp~' '~Especie;NoVacio(CLIENTE1) y EqStr(Vehiculo1,VAR('VEHICULODE'));Vehiculo1;


DEVENGADOS
**Se debe generar devengados para todos los dias, la conta decide que dia se contabiliza
FechaOp ;FechaVto-1;;SI;NO;'ARG';SI;SI;'TIDEV';TotalIntereses;140;Vehiculo1;Vehiculo1;;;;;;;;Especie;;;;;;Book1;OPERADOR;;;Cupon1;Especie;0;;;


POSTEDICION
NoVacio(CLIENTE1) y EqStr(Vehiculo1,VAR('VEHICULODE'));'CALASI';NrOperacion1=NROPERACION;Fecha1=FechaOp;Radio1=0;Check1=1
NoVacio(CLIENTE1);'LIMPMO';NrOperacion1=NROPERACION;Fecha1=FECHAOP;Check1=1

@INSTOPEPRE
