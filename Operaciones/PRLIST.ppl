Plazo2          : 'Plazo2'          ; ;; ;  ;  ;
Cuotas1          : 'Cuotas'         ;;;;;;;;;;
Cantidad: 'Cantidad'

LISTA:SI; CUOTAS1;

Cantidad1   : 'Cantidad'     ;;;;'La cantidad debe ser positiva';CANTIDAD;CANTIDAD;110;;NUMERO;'###,###,###,###.##'
Precio1     : 'Precio'       ;;;;'El precio debe ser positivo';CANTIDAD;CANTIDAD;100;;NUMERO;'###,###.########'

** versión anterior
**NrSecuencia: 'NrSecuencia'  ;EQSTR(ABM,'A');;Vacio(EJECOL.NRSECUENCIA[Fila]) O EqStr(EJECOL.NRSECUENCIA[Fila],'                    ') O [NoVacio(EJECOL.NRSECUENCIA[Fila]) Y EsNumero(EJECOL.NRSECUENCIA[Fila]) Y EJECOL.NRSECUENCIA[Fila]>0 Y Longitud(EJECOL.NRSECUENCIA[Fila])<=20];'El Nro. de Secuencia debe ser numerico, positivo y no debe superar los 20 digitos';;;80;;STRING;
**NrSecuencia: 'NrSecuencia'  ;EQSTR(ABM,'A');;CUOTAS1=0 o [NoVacio(EJECOL.NRSECUENCIA[Fila]) Y EsNumero(EJECOL.NRSECUENCIA[Fila]) Y EJECOL.NRSECUENCIA[Fila]>0 Y Longitud(EJECOL.NRSECUENCIA[Fila])<=20];'El Nro. de Secuencia debe ser numerico, positivo y no debe superar los 20 digitos';;;80;;STRING;

*Prueba cris
Cantidad2  : 'CantXPrec'    ;EQSTR(ABM,'A');NO;;;;CUOTASL.CANTIDAD1[Fila]*CUOTASL.PRECIO1[Fila];110;NO;NUMERO;'###,###,###,###.##'

BITS
1;1
10;0

INSTANCIA1
