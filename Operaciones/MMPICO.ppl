CAMPOS:3;;10
FechaOp         : 'Fecha Op.'    ; 3;2;1;VerificaAcceso('OPFVALOR');;FechaOp<=FSys y FechaOp>=Habiles(FSys,-5,'ARG') Y ESHABIL(FECHAOP,'ARG') Y [ESHABIL(FECHAOP,'USA') O EQSTR(ESPECIE,'ARP')] Y [Mes(FECHAOP)=Mes(FSYS) o SI];'Fecha incorrecta';NO;FSYS;
OperacionRef    : 'Op.Ref.'      ; 2;2; ;  ;  ;NOT NOVACIO(OPERACIONREF) O EQSTR(OPREF.TIPOOP,'MMPICO')];'La operacion de referencia no es Pmo.intercompany';NO;
Especie         : 'Especie'      ; 1;1; ;  ;  ;NOVACIO(ESPECIE)  Y Incluido(ESPECIE,'ARP|USD|USB');'Debe ingresar ARP o USD o USB';NO;;IF(MODI,ESPECIE,OPREF.ESPECIE);;'ARP|USD|USB|';NO
Cliente1        : 'Cliente'      ; 2;1; ;  ;  ;NOVACIO(CLIENTE1) Y DESCIENDEDECLIENTE(CLIENTE1,'VINCULADOS');'Debe ingresar un Cliente que sea vinculado';NO;;IF(MODI,CLIENTE1,OPREF.CLIENTE1);
Cantidad        :                ; 3;1; ;  ;  ;CANTIDAD>0;'La Cantidad de ser positiva';NO;
Precio1         : 'Tasa (%)'     ; 4;1; ;  ;  ;PRECIO1>0;'La Tasa no es mayor que cero';SI;
Precio4         : 'Tasa base (%)'; 5;1; ;  ;  ;PRECIO4>0;'La tasa base no es mayor que cero';SI;
Plazo           :                ; 5;2; ;  ;  ;PLAZO>0;'El plazo debe ser mayor que cero';NO;FECHAVTO-FECHAOP;FECHAVTO-FECHAOP;
FechaVto        : 'Fecha Vto.'   ; 6;2; ;  ;  ;ESHABIL(FECHAVTO,'NACION') Y ESHABIL(FECHAVTO,'USA');'No es un dia habil';NO;HABILES(FECHAOP,1,'NACION');FECHAOP+PLAZO;
MB1     : 'Liquidación|Com.|Liq.'; 7;2; ;  ;NOVACIO(OPERACIONREF);;;;0;
TotalIntereses  : 'Interés'      ; 6;1; ;NO;  ;;;;;CANTIDAD*PRECIO1*PLAZO/36000;
TotalRetenciones: 'WHT'          ; 7;1; ;NO;  
TotalBrutoCli1  : 'Monto'        ; 8;1; ;NO;  ;;;;;CANTIDAD+TOTALINTERESES-TOTALRETENCIONES;
TotalIVA        : 'I.V.A.'       ; 9;1; ;NO;  ;;;;;TOTALINTERESES*PORIMPUESTO/100;
PrecioMer       : 'Tasa Refer.'  ; 9;2; ;NO;  ; 
Operador        :                ;10;1; ;NO;  ;;;;USUARIOACTIVO;
NrOperacion2    : 'Pmo.Relac.'   ;10;2; ;NO;MB2=1;
MB2             : 'Origen|C.M.|C.B.';11;1; ;NO;  ;;;;0;
RB2             : 'Leasing'      ;11;2; ;NO;NO;;;;0;
RB4             : 'Sales'        ;12;1; ;  ;  ;
RB1             : 'No Liq'       ;12;2; ;  ;NO;;;;0;
MB4             : 'Mercado ME|Inter|Local';13;2; ;Not EqStr(ESPECIE,'ARP');Not EqStr(ESPECIE,'ARP');;;;IF(EqStr(ESPECIE,'ARP'),1,0);IF(EqStr(ESPECIE,'ARP'),1,MB4);
Book1           : 'Book'         ;14;1; ;  ;  ;Incluido(BOOK1, SQLSet(" Select Codigo From "~DBO~".BOOKS Where Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion='' or TiposOperacion is NULL or TiposOperacion like '%"~TIPOOP~"|%') "));'Book Invalido.';NO;BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');BookDefault2(VEHICULO1,TIPOOP,'',ESPECIE,'','','','','HAB');;;;;;" Estado  = 'HAB' and Vehiculo = '"~VEHICULO1~"' AND (TiposOperacion = '' OR TiposOperacion Is Null OR TiposOperacion Like '%"~TIPOOP~"|%') ";
Vehiculo1       : 'Vehiculo '    ;15;1; ;  ;  ;NoVacio(VEHICULO1);'Debe Ingresar el Vehiculo';NO;VAR('VEHICULODE')

Precio3         : '% WHT'        ;1;1;2;  ;  ;
PorImpuesto     : '% IVA'        ;1;2;2;  ;  ;PORIMPUESTO>=0;'El porcentaje de IVA no puede ser negativo';NO;IF(MB2=0,0,VAR('IVA'));IF(MODI,PORIMPUESTO,IF(MB2=0,0,VAR('IVA')))
FechaPrecan     : 'Fecha Precan' ;2;1;2;NO;FECHAPRECAN>0;
Mercado         : 'Merc.Especie'  ;2;1;2;;;NOVACIO(MERCADO);'Debe indicar mercado';NO;;MercadoDef(ESPECIE);;;;;;" Observaciones like '%M%' "

Cuenta1         : 'Cta.Esp.Veh.:'   ;9;1;2;FW=1; ;[CLIENTECUENTA(VEHICULO1,CUENTA1) y ESPECIECUENTA(ESPECIE,CUENTA1)       y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA1))] o NOT NOVACIO(CUENTA1); ;;CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB');CUENTACLIENTE(VEHICULO1,ESPECIE,,MERCADO,TIPOOP,'HAB');
Cuenta2         : 'Cta.Mon.Veh.:'   ;9;2;2;NO;NO;;;;;CUENTA1;
Cuenta3         : 'Cta.Esp.Clie. :' ;10;1;2;FW=1; ;[CLIENTECUENTA(CLIENTE1,CUENTA3)  y ESPECIECUENTA(ESPECIE,CUENTA3)       y EqStr(MERCADO, BuscarCampo('CUENTAS','Mercado','Codigo',CUENTA3))] o NOT NOVACIO(CUENTA3); ;;CUENTACLIENTE(CLIENTE1,ESPECIE,,MERCADO,TIPOOP,'HAB') ;CUENTACLIENTE(CLIENTE1,ESPECIE, ,MERCADO,TIPOOP,'HAB');
Cuenta4         : 'Cta.Mon.Clie. :' ;10;2;2;NO;NO;;;;;CUENTA3;

CONDICIONES:
Vacio(Cliente1) o EqStr(BuscarCampo('Clientes','Status','Codigo',Cliente1),'HAB');'El Cliente No esta Habilitado';NO
PRECIO1>=0;'La Tasa NO puede ser negativa';NO
PRECIO4>=0;'La Tasa base NO puede ser negativa';NO
[Eqstr(Especie,Opref.Especie)]   o [Not NoVacio(OperacionRef)];'No coincide la especie con la operacion de referencia';NO
[Eqstr(Cliente1,Opref.Cliente1)] o [Not NoVacio(OperacionRef)];'No coincide el cliente con la operacion de referencia';NO
[FechaOp=Opref.FechaVto]         o [Not NoVacio(OperacionRef)];'La operacion de referencia no ha vencido aun';NO

MOVIMIENTOS
FechaOp  ;Cliente1 ;Especie ;;;;       ;VEHICULO1;1;                       -Cantidad;;'Alta Pmo. Intercompany'      ;SI;NO;1;                 ;;CUENTA1;;1;'MM';
FechaVto ;Cliente1 ;Especie ;;;;       ;VEHICULO1;1;                        Cantidad;;'Vto. Pmo. Intercompany'      ;SI;NO;2;                 ;;CUENTA1;;2;'MM';
FechaVto ;Cliente1 ;Especie ;;;;       ;VEHICULO1;1; TotalIntereses-TotalRetenciones;;'Ints. Vto. Pmo. Intercompany';SI;NO;3;                 ;;CUENTA1;;3;'MM';

FechaOp ;Vehiculo1;Especie;;;;;Vehiculo1;4;       Cantidad;;'Alta Pmo. Intercompany';SI;SI;
FechaVto;Vehiculo1;Especie;;;;;Vehiculo1;4;      -Cantidad;;'Vto. Pmo. Intercompany';SI;SI;

